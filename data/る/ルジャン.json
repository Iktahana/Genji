        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "家鴨料理のツール・ダルジャンでゆっくりした晩餐をとった後、新吉とリサとは直ぐ前のセーヌ河の河岸に沿って河下へ歩き出した。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "家鴨料理ツール・ダルジャン　家鴨の番号数二万――八。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツール・ダルジャンの酒倉は世界の食通の一度は見学すべき博物館になっている。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この祈祷をここですれば大僧正から百日間のアンジュルジャンスを与えるとある。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀子も貧乏ゆえに、あっちで喰われこっちで喰われ、身を削いで親や妹たちのために糧を稼ぐ女の一人なので、青年八百屋が彼女のために、何となしにジャン・バルジャンを読ませようとしたのも、意識したとしないにかかわらず、どこか理窟に合わないこともなさそうであった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "老いたジャン・※ルジャンが、コーセットをマリヤスに与えた時の心持を。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ラディックのスネアと、ジルジャンの一八か二〇インチ、それにハイハットぐらいは買おうと思ってさ」　服部は、慶一の嫌みには気づかなかったように、すましていう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラディックのスネアに、ジルジャンのシンバル！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ま、ジルジャンはむりだろうけど」「そういうことは、早くいってほしいよ」　ここから見て右側にあたる、プールサイドのグラウンドよりが今夜の「ステージ」で、いまはギターアンプやドラムを必要としない、知子と郁子のフォーク・デュオが〈サムタイム・ラヴィン〉を歌っている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "郁達夫の物語は、わたしたちにジャンバルジャンを思い出させ、レマルクの「凱旋門」の主人公ラヴィックが人間らしくまた医者らしい咄嗟の行動で往来の負傷者を救ったことからパリを逃れなければならなかった情景を思い起させる。",
              "citation": {
                "source": "それらの国々でも",
                "author": "――新しい国際性を求めて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この社会の正義というものについて大きい疑問を呈出したのがユーゴーの「レ・ミゼラブル」であり、その主人公ジャン・バルジャンの飢えである。",
              "citation": {
                "source": "動物愛護デー",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは恰度、ヴィクトル・ユーゴーがその小説「レ・ミゼラブル」のなかで主人公ジャン・ヴァルジャンという傀儡を操って、ブルジョア社会の道徳を解剖し暴露したのに似ている。",
              "citation": {
                "source": "現代小説展望",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして主人公のジャン・ヴァルジャンもゼッド・ラッシャーも、作者の頭脳的傀儡であって、人間としての生きた心臓はごく僅かしか持たない。",
              "citation": {
                "source": "現代小説展望",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の名をジャン・ヴァルジャンと言う。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャン・ヴァルジャンは片田舎の愚昧なる一青年であった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳者は今ジャン・ヴァルジャンの心の径路をもって、作者ユーゴーの意志によるものとするのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳者も今ここにジャン・ヴァルジャンを導いた作者の意図が何であったかを説くべきであろう。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里のトウダルジャン、あそこはうまいですな。",
              "citation": {
                "source": "踊る地平線",
                "author": "黄と白の群像",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャンパルジャンの劇、父様の事が妙に思出されるので涙がこぼれた。",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはモン・ブランの麓、アルジャンティエールから六時間ほどのぼったところにあるラ・トゥルという危険な氷河で、マァヘッドのアルプス案内記にも、ガイドを要すと特に注意しているのに、阿曽はホテルからザイルとピッケルを借りただけで、案内も連れずに出かけたのである。",
              "citation": {
                "source": "白雪姫",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿曽がシャモニーからアルジャンティエールのグラッソンネというホテルへ移ってきたのは、八月ももう末で、山の天候が変りやすい時季だった。",
              "citation": {
                "source": "白雪姫",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、アルジャンティエールという氷河がホテルのすぐ前まで雪崩れさがっていて、氷河見物といえば、その辺をブラブラすることにきまっていたから、ザイルも大袈裟なと苦笑したが、それ以上のことは考えもしなかったのである。",
              "citation": {
                "source": "白雪姫",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ジャンバルジャンですよ。",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだってジャンバルジャンを読んだのだろう。",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、先生の選挙演説にビクトルユーゴーもジャンバルジャンも出てきやしなかったな。",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "三高氏はそもそも選挙演説のヘキ頭から、自分がジャンバルジャンであることを語っているのです。",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その誰かとは、ジャンバルジャン。",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち、マドレーヌ市長の前身たるジャンバルジャン。",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャンバルジャンのように、脱獄者かも知れません。",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
