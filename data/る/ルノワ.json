        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "また開いた山百合の幾つかの隙間にルノワアルばりの裸形の女を、ちやうど朝鮮の李王家の美術館に在る葡萄の蔓の間に唐子を染付けた水差の模様のやうにあひしらはうかと思つたが、それは失敗した。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑木山がまつかに燃え、海面は鮮碧、まことにルノワアルの油絵のやうに華美で且つ温純です。",
              "citation": {
                "source": "伊豆伊東",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾百と云ふ蔵幅は大抵モネ、ピサロオ、セザンヌ、シスレエ、ドガア、ルノワアル等近代名家の作家の作品で満ちて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルノワアルの絵を八千フランで買つた事もある。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルノワアル翁は既に其新作｜許りをジユラン・リユイルの店の数室に陳べて居るが、何よりも先づ老いて益精力の壮なのに驚く。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に仏蘭西の富は年毎に増して行くし、学問芸術に就いてはロダンの彫刻、マスネエの音楽、ポアンカレエの科学、ルノワアル、モネ、セザンヌ、ゴツホ、ゴオガン、マチス等の絵画、※ルハアレンの詩、ベルグソンの哲学、キユウリイ夫妻のラジウム発見に至るまで常に世界文明の先頭に立つて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代の諸｜大家の人物画を集めた参考室の中に一八八〇年代のルノワアルの婦人像が一枚目に附く。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月二十六日（月曜）　マールイ・テアトルで、スミルノワの引退興行があった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノワ、まだ奇麗で、声もすみ、立派であった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノワのところへ行く、五つと幾月かの女の子、音楽と踊をやって居る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は黄繻子の頭巻きで、下から黒い髪の束をこぼし、家の外羽目に打ちつけてあるＴ・Ａ・スミルノワ、黒で書いた白エナメルの表札を見上げていた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンテツス・ド・ノワイユを、ルノワアルを、梅蘭芳を、梅原｜龍三郎を連想する花、牡丹。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎Les Lapin　半分に切った酒樽の中で、ルノワアルとルグリは、毛皮で温かく足をくるんだまま、牝牛のように食う。",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルノワアルとルグリは、一緒に、早速食い始める。",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「生かさぬ一発、狂わぬ一発」　いっとき、ルノワアルはびっくりして、口を休める。",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "米ヲ作ルノワ　僕達デソレヲ取ルノワ　鬼ダ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔、僕のところでジュオルジュ・リヴ※ヱールのルノワール・ヱ・セザミーの中の SUR LA TERRASSE をみてゐて、「僕はかういふ顏の婦人が好きなのだ。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
