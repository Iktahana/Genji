        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この時のサロンにバスチャン・ルパアジュの有名な「ジャンヌ・ダルク」が出品され、マリアに甚大な感動を与えた。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジャンヌ・ダルク」以来彼女が傾倒し師事していた当時の大家ルパアジュが加筆したような噂がつたえられた。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのルパアジュは三十六歳で、そのときはもう病床で生と死との境にあった。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし、気の毒なバスチャン・ルパアジュは外出する。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バスチャン・ルパアジュの目はそれを見てうれしそうに見張った。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　十月二十日「天気がすぐれてよいのにかかわらず、バスチャン・ルパアジュは森へ行かないでここへ来る。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "バスチャン・ルパアジュはそれから四十日経った十二月十日に死んだ。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
