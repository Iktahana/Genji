          "literary": [
            {
              "text": "同盟罷工ハ工場閉鎖ト共ニ此ノ立法ニ至ルヘキ過程ノ階級鬪爭時代ノ一時的現象ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但双方和談ヲ以テ更ニ期ヲ延ルハ勝手タルヘキ事。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいら川ヨリ越中国立山ノ信濃堂ナトイフ所見ユ、山伝ヒニ立山マテ五里許リモアルヘキナリ、是ヨリ越後越中信濃三国界マテノ中モ国境分明ナラス。",
              "citation": {
                "source": "後立山は鹿島槍ヶ岳に非ざる乎",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
