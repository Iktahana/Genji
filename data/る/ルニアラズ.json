          "literary": [
            {
              "text": "敢テ今次ノ朝鮮太子ト日本皇女トノ結合ヲ以テ日鮮ノ融合ガ試ミラルルニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月十一日（火曜）〔発信〕第六十二信〔受信〕電報　フツカトモ　ナンラ　メンカイヲコトワツテイルニアラズ　ネンノタメニ」アサ九ジハン　ケンジ　白いきちんとした背広、紳士、そり跡蒼きやせ面。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "是故ラニ埋メタルニアラズ、遺物ノ上新ニ土ノ生ジタルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その詩は、忙裏　山｜我ヲ看ル閑中　我山ヲ看ル相看レド相似ルニアラズ忙ハ総テ閑ニ及バズ　という戴文公の詩であった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
