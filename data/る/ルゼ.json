        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ずっと後に従妹のエルゼ・アインシュタインを迎えて幸福な家庭を作っているという事である。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他、私は貴女が男装して男の前でズボンを脱いでみせる芸当と、フォルベルゼエルの寄席の衣裳の綺羅を棄てた手踊と。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "デイアボロス、ベリアル、ベルゼブル、悪鬼の首、この世の君、この世の神、訴うるもの、試むる者、悪しき者、人殺、虚偽の父、亡す者、敵、大なる竜、古き蛇、等である。",
              "citation": {
                "source": "誰",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "處が此アルゼリヤ國の中でブリダアといふ市府の人は分ても怠惰ることが好き、道樂をして日を送ることが好きといふ次第である。",
              "citation": {
                "source": "怠惰屋の弟子入り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕アンデルゼンのおはなしやなんかもっと読みたいなあ。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（アンデルゼンの猫を知ってゐますか。",
              "citation": {
                "source": "猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗闇で毛を逆立てゝパチパチ火花を出すアンデルゼンの猫を。",
              "citation": {
                "source": "猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "などと忙しく説明し乍ら女は馴染みのタンゴ楽手のアルゼンチン人や友達の遊び女達の出入する度に挨拶の代りに舌を出したりした。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここの家はどう云う理由か、エビス・ビールを看板にしているが、私はずっと前に、矢張りその界隈にあるハムブルグ酒場で、大変美味しいピルゼンのビールを飲んだことがあった。",
              "citation": {
                "source": "ああ華族様だよ　と私は嘘を吐くのであった",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "中村は、なじみの男刈りにした肥っちょの娘と、独逸麦酒をしこたま飲んだあとで、アルゼンチン・タンゴを怪しげな身振りで踊っていた。",
              "citation": {
                "source": "シルクハット",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "即興詩人（森鴎外訳）も面白い、クラシツクのよさが、アンデルゼンのよさが、鴎外のよさが私を興奮せしめる。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学になってからも物語りであることをやめなかった（アンデルゼンやソログーブのことを憶い出して下さい）。",
              "citation": {
                "source": "童話における物語性の喪失",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "Revistra Geografica Americana――アルゼンチン地理学協会の雑誌だ。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "南緯二十度から二十七度辺にまでかけ、アルゼンチン、パラグァイ、ボリヴィアの三か国にわたり、密林あり、沼沢あり、平原ありという、いわゆる庭園魔境の名のグラン・チャコ。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは、フォルモサの密林の北をながれて、ながらくパラグァイ、アルゼンチン両国の境界争いの場所だったことは、諸君も知っておることだろう。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って、国際法でいう先占の事実というやつが、パラグァイ、アルゼンチンのどっちにもない訳である。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "その先占を、一九三二年の夏の終りごろに、いよいよアルゼンチン政府が決行することになった。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "パタゴニア人に保護区政策をとれと、アルゼンチン政府と喧嘩をした……」　「知ってますとも。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかには現にもう現われている種族があるといって……、アルゼンチン人の大部分である雑種児の血と、いま同国の南部、パタゴニア地方で、絶滅に瀕しつつあるパタゴニア人の血とを比べたのだ。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、アルゼンチン人にはある化石素が、パタゴニア人にはない。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで三上は、それをアルゼンチン政府攻撃に利用して、パタゴニア人の減少は自然的な原因ではなく、冷酷なアルゼンチン政府が保護区をつくらずに、むしろ滅んでしまうのを願わしく思っているのだろう。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんな訳で、三上はアルゼンチン政府にたいへん憎まれておりました。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、たぶんアルゼンチンのどこかに秘密囚となっているのだろう――と、私はそう考えて南米へまいりまして、これでも、手を尽してどんなに探しましたでしょう」　額を支えた手で、卓子がかすかに揺れている。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルゼンチン各所監獄を転々とした末に、政治犯四名とともに「蕨の切り株」へ連れてこられて機関銃弾で追われながら沼地へと追いやられた。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "｜Revistra Geografica Americana――アルゼンチン地理学協会の雑誌だ。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
