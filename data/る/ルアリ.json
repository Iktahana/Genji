          "literary": [
            {
              "text": "奇巌怪石岸ニ聳チ、一切前景ヲ遮ルアリ、両人即チ池ヲ巡リ、更ニ森林ノ奥ニ迷フ。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "如此ニシテ二十年前ノ肥田沃土ハ今ヤ化シテ黄茅白葦満目惨憺ノ荒野ト為レ［リ→ルアリ］。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "其頃和蘭舶中国海より玄海ニ出ルアリ。",
              "citation": {
                "source": "手紙",
                "author": "慶応元年九月七日　坂本権平、乙女、おやべあて",
                "note": "青空文庫"
              }
            },
            {
              "text": "南郭子纂ノ言ヘルアリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ワガ部内年穀ノ登ルアリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "『本草綱目啓蒙』栗の条下に「江州ニ一毬ニ七顆アルアリ、ハコグリト云毬ノ形四稜ニシテ闊シ」と書いてある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「人民ノ中産ヲ失エルアリ営養ヲ失エルアリ或ハ業ニ離レ飢テ食ナク病テ薬ナキアリ――今ヤ化シテ黄茅白葦満目惨憺ノ荒野ト為レルアリ」　正造は一つ仕事に打ちこみだすと、時も場所も周囲の事情一切を忘れてしまう癖があった。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "近日、先帝ノ動座ヲ謳ヒ、山陰一円、騒乱ノ聞エ頻々タルアリ。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
