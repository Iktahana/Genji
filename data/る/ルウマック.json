          "literary": [
            {
              "text": "すばしこく、音もさせずに――そら、首を低く下げている……何かの後を追っているのだ……あれは、ルウマックか？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　デヤドラは、むかしのあなたの飼犬のいるところに、おいでなされます……ルウマックが、沈みもせぬ虧けもせぬ月に吠えておるところに。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノール　（呼ぶ）ルウマック！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            }
