        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "其の学校は、ホテル・ド・ルウロオプの中にあつた。",
              "citation": {
                "source": "子供の保護",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども私は、ホテル・ド・ルウロオプで見たあの綺麗な絵が汚れると云ふやうな事は許すことが出来なかつた。",
              "citation": {
                "source": "子供の保護",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の話は私はそれを本当と思へなかつた程、私がホテル・ド・ルウロオプで見た事とはまるで違つてゐた。",
              "citation": {
                "source": "子供の保護",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "』私はホテル・ド・ルウロオプで、子供達が、ミルクや、ココアや米や、フアリナや、白いパンや、チヨコレエトや、それから肉類をすらも食べてゐたのを見たのだ。",
              "citation": {
                "source": "子供の保護",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテル・ド・ルウロオプで子供等が受けてゐる保護と、クロンヴエルスキイ・プロスペクトの学校で子供達の受けてゐるものとの間の差別にはほかにどんな説明がつくのだらうか？",
              "citation": {
                "source": "子供の保護",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の時私はそれをホテル・ド・ルウロオプで掛りの医者の態度と其の旧式な考へとに帰した。",
              "citation": {
                "source": "死んだ魂",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
