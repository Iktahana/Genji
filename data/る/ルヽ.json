        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "最早十一時をや過ぎけん、モハビツト、カルヽ街通ひの鉄道馬車の軌道も雪に埋もれ、ブランデンブルゲル門の畔の瓦斯燈は寂しき光を放ちたり。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "獨逸の人カルヽ・ロオベルト・エヅワルト・フオン・ハルトマンなり。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "最早十一時をや過ぎけん、モハビツト、カルヽ街通ひの鐵道馬車の軌道も雪に埋もれ、ブランデンブルゲル門の畔の瓦斯燈は寂しき光を放ちたり。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ明示シタル所以ハ此限度ヨリ免カルヽ目的ヲ以テスル外國ノ財産ヲ禁スルヲ明カニシタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "都市ハ其發達ヨリ結果セル利益ヲ單ナル占有者ニ奪ハルヽ能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來臺灣ノ幾十倍ナル大領土ヲ南北滿州及ビ極東西比利亞ニ取得スベキ運命ニ於テ、同一ナル罪惡ヲ國家國民ノ責任ニ嫁セラルヽコトハ日本ノ國際的威嚴信用ヲ汚辱シ、土地ノ國際的分配ノ公正ノ爲メニ特ニ日本ノ享有セル領土擴張ノ生活權利ヲ損傷シ、如何ナル大帝國建設モ百年ノ壽ヲ全ウスル能ハザルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "前ニモ言ヒシコトナレド、本邦ヲ始メ支那泰西ニ至ル迄、古代ノ物ハ如何程金銀ヲ惜マヌトテモ、多ク獲可キモノナラネバ、極メテ之ヲ愛護保存ス可キコトニテ、若シ放擲シ置ケバ尽ク外人ニ奪ヒ去ラルヽニ至ラン。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "況テ宝器什物ノ有ル可キ様無ケレバ、必ズ曝サネバナラヌト云フコトモ無ケレド、午熱烈シキ比快キ風ノ吹キ入ルヽ小楼ニ、独リ古キ櫃ドモ取出デヽ、手ニ触ルヽ物ヲ列ラネ曝ス程面白キコトハ有ラジ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "此思付を大藩にもすこむる同意して、使者を内※下サルヽ事両度。",
              "citation": {
                "source": "手紙",
                "author": "文久三年六月二十九日　坂本乙女あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "此通義ハ人民ニ於テハ甚ダ貴重ニシテ、暴政ヲ行ハントスル者ノ恐ルヽ所ナリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャルヽ・ペローといへば「サンドリヨン」とか「青髯」とか「眠りの森の少女」といふやうな名高い童話を残してゐますが、私はまつたくそれらの代表作と同様に、「赤頭巾」を愛読しました。",
              "citation": {
                "source": "文学のふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "（７）便ノ助辭ハ文中多ク直ニノ意ヲアラハセドモ、元來、便ノ字ハ或ハ「遂ニ」ノ意ヲアラハス助辭ニ用ヒラルヽ事モアリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ此識ト才トノ由テ別ルヽ所ハ、何レノ處ニ有リヤ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "又物ノ目睫ニ觸ルヽ時、忽チ目ヲ塞グハ少シモ思慮ヲ假ラザルガ如シ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "澤田卓爾氏來り獨逸人レオナルド、フランツ作小説「カルヽとアンナ」英譯本貸與。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「丁未秋日枕山詞伯ノ訪ハルヽヲ喜ブ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "因テ免ルヽコトヲ得タリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗣子罪アリ籍ヲ削ラルヽニク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗子城邑ヲ納メラルヽモシカモ朝廷更ニ駿遠参三国ヲ賜ヒ、先祀ヲ奉ゼシム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "宣光鑾輅ニ後ルヽコト十日ニシテ乃京師ヲ発ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫ノ羽族ノ序ヲ逐ヒ影ヲ聯ネテ飲啄相離ルヽコトナキガ如クナルコト能ハズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ニ於テ人類ハ石時代ヨリ、青銅時代ニ移リ、青銅時代ヨリ鐵時代ニ移リタルモノナリトノ説廣ク世ニ行ハルヽニ至レリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青銅ハ二種ノ金屬ヲ混ジテ造ラルヽモノ、决シテ天然ニ産スルニ非ズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐵器石器混交シテ發見サルヽ事有ルモ、又ハ鐵器ノ存在スル地ヨリ深キ所ニ於テ石器ノ發見サルヽ事有ルモ、誰カ是等ノ石器ヲ以テ移住民ノ祖先ノ遺シタル物トナサンヤ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ甲ノ人民金屬器ヲ使用スル時、乙ノ人民尚ホ石器ノ用ヲ廢セザル事有リ、甲ノ地方ニハ石器ノ行ハルヽ時、乙ノ地方ニハ既ニ金屬器ノ行ハルヽ事有リ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "貝塚ハ石器時代人民ガ食余ノ貝殼ヲ捨テタル所、竪穴ハ石器時代人民ガ住居セシ跡ナル事、是等ノ中ヨリ發見サルヽ遺物ニ由リテ推知スルヲ得ベシ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
