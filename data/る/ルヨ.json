        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自分ノ身体ヲ可愛ガルヨウニ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラ身体ヲ大事ニスルヨウニクレグレモ願イマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "的言イアテルヨリハ、ワガ思念開陳ノ体系、筋ミチ立チテ在リ、アラワナル矛盾モナシ、一応ノ首肯ニ価スレバ、我事オワレリ、白扇サットヒライテ、スネノ蚊、追イ払ウ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "所詮ハ筏ノ上ノ組ンヅホツレツデアル、ヨロメキ、ヨロメキ、君モ、私モ、ソレカラ、マタ、林氏、寝ル間モ烈シク一様ニ押シ流サレテ居ルヨウダ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト　モウシマス　ト、サカナタチ　ハ、サモサモ　バカ　ニ　スルヨウニ、ワラッテ　オヨギ　モ　シラナイデ　ウミ　ニ　クルナンテ、キミ　ハ　オオバカサンダ　ト　イッテ　アイテ　ニ　シテ　クレマセンノデ、ヤマキチ　ハ　コンド　ハ　ナミ　ニ　ムカッテ、ボク　ヲ　オヨガセテ　クダサイ　ト　タノミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山ハ絵ノ具ヲドッシリ付ケテ、山ガ地上カラ空ヘモレアガッテイルヨウニカイテミタイモノダト思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ山ハ私ガ実際ニ感ジルヨリモアマリ平面ノヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「山ハ絵ノ具ヲドッシリ付ケテ、山ガ地上カラ空ヘモレアガッテイルヨウニカイテミタイ」‥‥山が地上から空にもれあがる‥‥それはすばらしい自然への肉迫を表現した言葉だ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツテクルヨ、ランランラン　こう私は小田原の妻子へ打電するように弟に頼んだが、船が出ると船員が私の前に「電報がまいっております。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハモーダメニナッテシマッタ、毎日訳モナク号泣シテ居ルヨウナ次第ダ、ソレダカラ新聞雑誌ヘモ少シモ書カヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツ、ヰルヨ」「エ、ドコニ」「ホラ、アソコニ」　ズーツト　下ノ　ハウノ　アル　マチノ　ホソイ　ミチノ　上ニ　キラキラト　ヒカル　モノガ　アリマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ　ナホスニハ、イタチサンニ　オモヒキリ　オナラヲ　サセルヨリ　シカタハ　アリマセン」　ヤレヤレ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "右は教授パウル・ミルヨウコフ氏が嘗て市俄高大學の聘に應じて講演し、後同大學から出版された講演草稿『露西亞と其の危機』中、教授自らの屬する國民――露西亞人の性格を論じた條に引用した、一外國旅行家の記述の一節である。",
              "citation": {
                "source": "我が最近の興味",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ヲ口舌ノ鬪爭ニ慣習セシムルハ其天性ヲ殘賊スルコト之ヲ戰場ニ用ユルヨリモ甚シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ國家ノ生産的利益ノ方面ヨリ見ルモ、幼童ニシテ殘賊スルヨリモ其ノ天賦ヲ完全ニ啓發スベキ教育ヲ施シタル後ノ勞働ガ幾百倍ノ利益ナルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸ク中世史ノ革命ヲ學ビツツアル未開後進ナル彼ニ對スルニハ現代的再建ヲ想像スルヨリモ、反動ノ襲來又ハ眞乎ノ建國者ニヨリテ「ピーター」大帝ノ再現ヲモ打算外ニ置ク能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代ニ至テ世界列強ガ戰爭ヲ開始セントスルトキ悉ク自他ヲ欺ク舊道徳的名分ヲ掲ゲ、又ハ之ヲ自己防衞ノ口實ニ求ムルハ國家生活ノ權利ヲ半解スルヨリ來ル卑怯ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英人ヲ直譯スル輩ハ「レニン」ヲ宣傳スルヨリモ百倍ノ有害ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此レ徃年露西亞ノ滿洲ニ進出シタルヨリモ支那ノ一大危機。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國ノ恩惠ノ下ニ青島ニ租借地ヲ得ルヨリモ、英國其者ノ香港ヲ奪ヒテ日本ノ海軍根據地トセヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "山東苦力トシテ輸出セザルベカラザルホドニ人口漲溢セル支那ノ貧弱ナル一角ニ沒頭スルヨリモ、支那其ノ者ヨリ廣大ニシテ豐饒ナル英國ノ濠洲ヲ併合セヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オヽ、頼モシキ思想ノ持主ヨ、新日本ノ後継者ハ立派ニ新シイ騎士道ヲ樹立セナケレバナランノダ、女学生ト附キ合ツテ Girl-shy（助平心）ヲ起スヨウナ習慣ハ少年ノウチカラ彼女等トノ交遊ニヨツテ振リ棄テルヨウニシナケレバナランノダ。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「その小間使の名前はテルヨさんといふんですがね、主人はとてもこのテルヨさんの上に神経過敏なんだよ。",
              "citation": {
                "source": "天狗洞食客記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "うつかり客がテルヨさんにながしめでも送らうものなら、忽ち木剣を振りあげてお面を喰はさうと、応待中主人は隈なく監視の眼を光らせてゐるわけなんだから――。",
              "citation": {
                "source": "天狗洞食客記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちよいとテルヨさんの方へ挨拶の眼を向けたといふだけでも、忽ち御免蒙るわと来るんだからまあ大概の人は落第するのが常例ですよ、何しろそのテルヨさんといふのが全く夢のやうな、物語にでも出て来さうな美人なんだから誰だつてうつかり見惚れてしまふのさ。",
              "citation": {
                "source": "天狗洞食客記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「この私でさへ、あの師匠のところへ訪れて何が一番辛いと云へば、勿論テルヨさんを気にしまいと堪へるのが念力中の念力でね……はつはつは！",
              "citation": {
                "source": "天狗洞食客記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの者はテルヨさんに向つてほんの一つの笑顔を示したところを発見されて破門を宣告されるか、でなければ彼等は日増に種々様々なる珍奇な試問や訓練なるものが重ねられるのに辟易して、脱走せずには居られないのであるさうだつた。",
              "citation": {
                "source": "天狗洞食客記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
