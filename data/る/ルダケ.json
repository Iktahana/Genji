        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "諸君ハ、工場ヤ、銀行ヤ、病院ヲ守ッテイルダケデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "満洲ハタダ大資本家大地主ヲ太ラセルダケダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウゾコノ大馬鹿者ノ最期ヲ、アナタノ筆デ、デキルダケ大キク世間ニ発表シテ下サイ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、モンコチヤンノアタマニデキルダケカツカウヨクカブサリマシタカラ、ソレハソレハヨクニアフヨウニナリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ハアノ揚巻ノ顔ヲ見テルダケデモイクラカ痛ミヲ忘レルンダ」予ハ婆サンニ窘メラレテ一層｜依怙地ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハコルセットヨリ柔イ布デ頤ヲ吊ルダケデアルカラ、コルセットホド窮屈デハナイガ、首ヲ動カセナイコトハ同ジデ、天井ヲ睨ンダマヽデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハ支度ダケハ甲斐々々シイガ、離レタトコロカラ見テイルダケデ、ロクニ何モシテクレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「医者ガ内診スルミタイダ」「馬鹿ネ」「舌ヲ使ワズニ接吻シロナンテ、随分無理ナ註文ダナ」「接吻ジャナイモノ、タヾ唇デ触ラセルダケダモノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家庭ノ費用ハ出来ルダケ切リ詰メテ女中イジメヲシ、残リハ全部自分ノ懐ヘ取リ込ムラシイ、ミンナニ窮屈ナ思イヲサセテ自分ダケドンナ贅沢ヲシテルカ知レタモンジャナイト、婆サンハ云ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新シイ隠居所ヲ作ルト称シテ、予ノ寝室ヤ書斎ヲ出来ルダケ婆サンノ寝室カラ遠クニ切リ離シ、婆サン専用ノ便所ヲ彼女ノ寝室ノ隣ニ設ケル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテワザト上下ノ歯齦ヲ強ク噛ミ合ワセ、顔ノ寸法ヲ出来ルダケ縮メテ見セタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ心理ハ君ニハ分ルマイ」「分ラナイワネ」「ツマリ、僕ガ醜悪デアレバアルダケ、君ガ途方モナク美シク見エルッテコトサ」予ノ言葉ヲ上ノ空デ聞イテ彼女ハアダリンヲ取リニ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨デ庭ニハ出ラレナイガ、廊下ヲ散歩スルダケデモ容易デナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウソノ緊迫シタ雰囲気ニ包マレルダケデモ死ニハシナイカナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤリ損ッタッテ死ニハシナイヨ」「死ニハシナイデモ、気絶シテ今ニモ死ニソウニオナリニナッタリシタラ、ソレヲ見テルダケデモイヤダワ」「コンナ思イヲシテ生キテルクライナラ死ンダッテイヽサ」予ハ殊更ニ悲壮ラシク云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ爺サンハ発狂シテルノデハナイカト、思ワレルダケデモ極マリガ悪イ）予ハコヽマデ思イ詰メテ、コヽニ一ツノ可能ナ方法ガアルカモ知レナイコトニ気ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツマリ、ソレゾレ違ッタ思ワクガアルラシイガ、妻ガデキルダケ堕落スルヨウニ意図シ、ソレニ向ッテ一生懸命ニナッテイル点デハ四人トモ一致シテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……アナタノ今ノ良人ノコト、及ビ弘君ノコトハ、御依頼ガナクトモ親戚ノ一人トシテ、親子ノ性質ヲ最モ良ク理解シテイル友人トシテ、及バズナガラ出来ルダケノ事ハスル積リデスカラ、決シテ心配シナイデ下サイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サエ生ヤセバオマエハ何モ考エルコトモ悩ムコトモナク、タダ私ノ命令二従ッテイルダケデ生キラレルノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
