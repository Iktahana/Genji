        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこで「ナールホド」といふことにＡの方ではなつてしまふ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト屋根ヤブレルホドノ大｜喝采、ソレモ一瞬ノチニハ跡ナク消エル喝采、ソレガ、ホシクテ、ホシクテ、一万円、二万円、モットタクサン投資シタ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト飛ビアガルホドノアツキ握手。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナルホド、ソレモ一理窟。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とお教えになれば、子路は恐れ入って、ナルホド学問をすれば、学問を必要としないほど善い者もますます善くなる。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ヒバリハ　スガタガ　ミエナク　ナルホド　タカク　ノボツタ　トキ　ウツクシイ　コヱデ　ウタヒハジメマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドレ　ドコニ」「ソラ、ソラ、ソコニ」　ナルホド、ミルト　ナタネノ　ミキニ　マダ　ヒラカナイ　ツボミガ　ヒトツ　ノコツテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナルホド、イママデ　キヅカズニ　ヰタガ、カナヅチハ　クワヲ　ツクル　コトガ　デキルノダナ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤ、ナルホド、コノ　ウチモ　ヤツパリ　カナヅチガ　ツクルノダナ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　トシヨリト　ワカレテ　ナホモ　アルイテ　イキマスト、ナルホド　アノ　トシヨリガ　イツタトホリ、ハタケハ　タイハウノ　ワヤ　ウマノ　アシデ　スツカリ　アラサレテ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガ　オホキク　ナル　シヨウコデス」　ミルト　ナルホド、ナガイ　ミミガ　フタツ、ニヨツキリ　ハエテ　ヰマス。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルホド　マルイ　トコロヲ　ミルト　ケイキキユウノニ　チガヒ　アリマセン。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮人臺灣人ガ其ノ故郷ニアリテ未ダ取得スル時期ニ達セザル國民權ヲ此ノ領土ニ於テ三年後ニ取得シ得ベキ理由ハ、既ニ移住シ居住スルホドノ者ハ大體ニ於テ優秀ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "山東苦力トシテ輸出セザルベカラザルホドニ人口漲溢セル支那ノ貧弱ナル一角ニ沒頭スルヨリモ、支那其ノ者ヨリ廣大ニシテ豐饒ナル英國ノ濠洲ヲ併合セヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ナナ……ナル……ナルホド……如何にも御尤も千万……よくわかりました。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だいその最後の一点というのは……」「ハイ……それはこの絵巻物を使って呉一郎に暗示を与えた人間……」「アッ……ナルホドね。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……フーム……ナルホド……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……或は科学的の知識が幼稚なために、土葬した屍体の腐り加減を標準にして計劃したのかも知れないが……何にしても恐ろしい忍耐力だね」「あんまり寒いから火を焚いて室を暖めたせいじゃないでしょうか」「……ア……ナルホド。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "＋……＋……ナルホド。",
              "citation": {
                "source": "「生活」＋「戦争」＋「競技」÷０＝能",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トテモ際どい芸当をやったもんでさあ……」「ナアルホドネエ……張り込んでいる刑事がこの男を調べている隙を見て非常線を突破したわけですな」「どうもそうらしいんです。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "懇意な家でしたから……」「ハハア……ナルホドネエ……じゃアもうそこいら中に非常線が張ってあるんですね」「エエ。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の魚血を手足に塗りこくって暴れ込むんよ……久し振りにナ……」「……ウム……ナルホド……ウーム……」「……ナ……高が守ッ子の云う事を聞いて、云いがかりをつけるよりも、その方が洒落とらせんかい」「ウン。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ナルホド……それは困りましたな……エエトそれではどう致したら……」「ハイ。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルホド……」　というような下男たちの囁きが聞こえましたので、そのまま浴槽のなかに首まで沈みながら、お湯が冷たくなるまで我慢しておりました時の情のう御座いましたこと……あとでふるえながら夜具の中にちぢこまって、夜通し寝もやらずに泣いて泣いて泣き明かした事でございました。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今月ノ君ノ写真ハコノ前ノ君ニクラベルト見チガエルホド大キクナツタ、余モコノトホリ元気ダ、余ハ今年ノ夏ヲミシガントイフ湖ノソバデオクル。",
              "citation": {
                "source": "断唱",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ一時間ノチ、左舷前方ニトツゼン大海魔アラワレ、海中ヨリ径一メートルホドノ丸イ頭ヲモタゲ、ミルミル五十メートルホドモ頸ヲノバシタ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルホドと思って引退がって帰りました。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルホドと感心してまた引退がったが少し腹が立ちました。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルホド、イタリアかなァと思ってよく眺めました。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
