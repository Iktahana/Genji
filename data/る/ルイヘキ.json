          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "中世の城跡を訪れると、当時の激しい戦を物語る堅固な塁壁が今も一部残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "敵軍の猛攻を凌ぐために、村の周囲には急ごしらえの土塁と塁壁が築かれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "長い年月の風雨にさらされ、かつての威容を誇った塁壁も今は草木に覆われ崩れかけている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "加うるに南軍は北軍の騎兵の馳突に備うる為に塹濠を掘り、塁壁を作りて営と為すを常としければ、軍兵休息の暇少く、往々｜虚しく人力を耗すの憾ありて、士卒｜困罷退屈の情あり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸から折れて一丁も行かない中に、目指す石の塁壁にぶつかる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "塁壁の崩れか、所々に※々たる石塊の山が積まれている。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "細川の陣は塁壁堅固の上に銃兵多いから、之を討てば味方に死傷が多かろう。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度人間世界の境の石でゞもあるやうに、境の塁壁でゞもあるやうに、その岩の列が立つてゐる。",
              "citation": {
                "source": "うづしほ",
                "author": "A DESCENT INTO THE MAELSTROM",
                "note": "青空文庫"
              }
            },
            {
              "text": "この牢獄のような塁壁が私たちの領土の限界になっていたのだった。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            },
            {
              "text": "田圃には、連夜切りあげられた氷板が、長い距離に亘つて正しく積み並べられて、恰も氷の塁壁を築いた如き観を呈する。",
              "citation": {
                "source": "諏訪湖畔冬の生活",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒い塊りが敵塁の下まで来たから、もう塁壁を攀じ上るだろうと思ううち、たちまち長い蛇の頭はぽつりと二三寸切れてなくなった。",
              "citation": {
                "source": "趣味の遺伝",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなると、熊城の作り上げた人間の塁壁が、第一どうなってしまうのであろう。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来十年一日のごとしと云うのは賞める時の言葉なんだがな」「千里の江陵一日に還るなんと云う句もあるじゃないか」「一百里程塁壁の間さ」「そりゃ西郷隆盛だ」「そうか、どうもおかしいと思ったよ」　甲野さんは返事を見合せて口を緘じた。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "前方の未知の山脈は目眩がするほど高く、見るだに恐ろしい巨人の塁壁の如く聳え、奇怪な規則性が双眼鏡なしでもぎょっとするほど明瞭に見て取れた。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの石と石、白黒の石のあいだにさえも不思議な、微妙な、あるいは鉄線のように強い、あるいは金線のように美しい、または糸のように弱い、一方その形もあるいは塁壁のように堅固な、または木柵のような脆さを思わせるなど種種様様の味と感じを与える。",
              "citation": {
                "source": "独り碁",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "篠つくばかりの矢だまのなかを、まるで武者押（練兵）でもするもののように面もふらず前進し、やがて指揮者が刀をひと振りするとみるや、脱兎の如く敵の塁壁へと取り付いた。",
              "citation": {
                "source": "石ころ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その昔、いかなる王侯が居を構えていたものか、規模広大な山城であるが、山嶂の塁壁望楼はすべて風化し、わずかに麓門や一道の石階などが、修理されてあるかに見える。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――との謎を解くならば、挑めども応ぜず、ただ塁壁を堅くして、少しも出て来ない仲達は、あたかも羞恥を深く蔵して、ひたすら外気を恐れ、家の内でばかり嬌を誇っている婦人のごときものであると揶揄しているものとしか考えられない。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "）灣の背後に一山の聳ゆるありて、その嶺には古壘壁を見る。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸から折れて一丁も行かない中に、目指す石の壘壁にぶつかる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "壘壁の崩れか、所々に※々たる石塊の山が積まれてゐる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "今だに封建時代に生きつゝあるかのやうな人を壘壁の一部に見つけるといふことも、かうした城塞の跡に來て見る旅の心を深くさせた。",
              "citation": {
                "source": "山陰土産",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "壘壁及び塹濠の防備。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "第十二歌　アカイア軍の壘壁後年に到りて破滅すること。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "――かなたトロイアとアカイア二軍戰鬪をつづく、はたまた塹濠と其上高き壘壁はアカイア勢を末長く守るに耐へず――壘壁は高くも立ちて其めぐり、　5塹濠廣く※らして中に多くの輕舟と夥多の戰利安らかに保たんために築かれき。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に地を震るポセードーン三叉の鋒を手にとりて、眞先に進み、アカイアの軍勢堅く据えたりしその木石の根底を、波浪に流し壘壁を拂へる後に、澎湃のヘレースポントス大波の　30岸悉く平げてまた一面の沙としつ、かくて再びもろ／＼の川をその前美しく、流れ馴れたる川床に再び戻り歸らしむ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘクト，ル及び豪勇のプウリダマスの率ゐたる第一隊は兵の數最も多く勇すぐれ、壘壁破り船の前戰ふ念も他に優る。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵は牛皮を張りし楯高くかざして堅牢の壘壁めがけ叫喚の聲かしましく攻め來る。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "140こなた二將はそのはじめ壘壁の中聲あげて、舟防ぐべく堅甲のアカイア軍勢勵ましき。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して彼ら身につけし耀く武具を剥ぎとれる、　195其｜間にかなたヘクト，ルとプーリダモスに續きたる――トロイア壯士、其數も最も多く、其勇氣最もすぐれ、壘壁を破りて船を焚かんずる思念最も強きもの、濠のへ立ちてためらへり。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくの如くにアカイアの陣門並に壘壁を、力をこめて打ち碎き、敵をはげしく破るとも、同じき道を整然と舟より歸り得べからず。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "255神の徴とわが威力信じて頼む＊トローエス、アカイア勢の壘壁を勇み進んで碎かんず、即ち塔の＊笠石を崩し、胸壁押し倒し、アカイア軍がそのはじめ塔の固めに地の中に、据えし支への巨材をば槓杆用ひこぢ扛げて、　260はづしてかくてアカイアの壘壁碎きおほせんず。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルペードーン更に又その剛強の腕のして、胸壁つかみ、もみ碎き引けば壘壁土崩れ上部あらはに露出して侵し入るべき口開く。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
