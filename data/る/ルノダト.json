        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソコデ　ミンナハ、カゲト　イフ　モノハ　タイヤウガ　ツクルノダト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "往年ノ軽微ナ脳溢血ノ痕跡ガマダ残ッテイ、脳中枢ニ僅カナ変化ガアルノデ、ソレガ脚ニ影響シテイルノダトモ云イ、又レントゲンデ検ベテミルト頸椎ト腰椎トガ曲ッテイルカラデアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜ノ遅イ急行デ京都ヘ行キ、祇園会ヲ見物スルノダト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ暑イノニ御苦労ナコトダガ、春久ガ御祭ヲ撮影スルノダト云ッテ昨日カラ行ッテイルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ自分ノ喉ガ鳴ッテイルノダトハ思エナイデ、自分ノ体以外ノトコロカラ鳴ッテ来ルヨウニ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ハ一向恐クナイ、ダガ、予ハ今コノ瞬間ニ死ニ直面シテイルノダト思ウト、―――死ガコノ刹那ニ予ノ眼前ニ迫ッテイルノダト思ウト、―――ソウ思ウソノコトガ恐イ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハ今日ハ花見小路ノオ茶屋ヘ電話シテ、コノ夏春久ト一緒ノ時ニ友達ニナッタ祇園ノ藝者ヲ二三人招キ、晝食ヲ共ニシテカラ京極ノＳ・Ｙ・京映ヘ行キ、夜ハキャバレヘ引ッ張ッテ行ッテ皆デ踊ルノダト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ白イ美シイ皮膚ニ包マレタ一個ノ女体ガ、マルデ死骸ノヨウニ僕ノ動カスママニ動キナガラ、実ハ生キテ何モカモ意識シテイルノダト思ウヲ日記ニ書カナイ方ガヨイノデハアルマイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
