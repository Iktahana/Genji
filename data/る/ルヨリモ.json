        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私ノ山ハ私ガ実際ニ感ジルヨリモアマリ平面ノヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ヲ口舌ノ鬪爭ニ慣習セシムルハ其天性ヲ殘賊スルコト之ヲ戰場ニ用ユルヨリモ甚シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ國家ノ生産的利益ノ方面ヨリ見ルモ、幼童ニシテ殘賊スルヨリモ其ノ天賦ヲ完全ニ啓發スベキ教育ヲ施シタル後ノ勞働ガ幾百倍ノ利益ナルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸ク中世史ノ革命ヲ學ビツツアル未開後進ナル彼ニ對スルニハ現代的再建ヲ想像スルヨリモ、反動ノ襲來又ハ眞乎ノ建國者ニヨリテ「ピーター」大帝ノ再現ヲモ打算外ニ置ク能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英人ヲ直譯スル輩ハ「レニン」ヲ宣傳スルヨリモ百倍ノ有害ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此レ徃年露西亞ノ滿洲ニ進出シタルヨリモ支那ノ一大危機。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國ノ恩惠ノ下ニ青島ニ租借地ヲ得ルヨリモ、英國其者ノ香港ヲ奪ヒテ日本ノ海軍根據地トセヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "山東苦力トシテ輸出セザルベカラザルホドニ人口漲溢セル支那ノ貧弱ナル一角ニ沒頭スルヨリモ、支那其ノ者ヨリ廣大ニシテ豐饒ナル英國ノ濠洲ヲ併合セヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ僕ガ木村デアッタトシテ、ドッチニヨケイ惹キ付ケラレルカトイエバ、ソレハ、年ハ取ッテイルケレドモ母ノ方デアルヨリモ、僕自身ハドンナツモリナノダロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
