        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "貧富ヲ無視シタル劃一的平等ヲ考フルコトハ誠ニ社會萬能説ニ出發スルモノニシテ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ眞個父兄的愛情ヲ以テ、斯ル短時日間ニ此ノ道義的使命ヲ果タシ、以テ異民族ヲ利得ノ目的トセル白人ノ所謂植民政策ナルモノニ鐵槌一下セザル可カラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米ノ傭兵ト獨逸ノ徴兵トノ優劣ハ實戰ニヨリテ立證セラレタルモノニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ亦ラジオヲ以テ長年ノ趣味トスルモノニシテ、予ガ組立テタル愛機『スーパーヘテロダイン』ヲ携エテ今回｜此途ニノボレリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "マモナクヨコハマジヤツクトイウワルモノニツカマツタ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "平民自身モマタ奴隷タルベクコノ世ニ生レ出デタルモノニシテ、人格ト権利ヲ没却セラレテモ、之ヲ甘ンジテ屈従スルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "古語に『自ラ求メザルモノニ向ツテハ哀楽ソノ前ニ施スべカラズ』というのがございます、世にこの求めざるの心ほど強いものはございません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "石黒氏ノ近業ハソノ名ノ示スガ如ク往昔郷閭ノ私塾ナリシ有隣舎ノ沿革ヲ調査シソレガ師弟ノ伝ヲ述ベタルモノニシテコレスナハチ拙稿『下谷叢話』ノ記述スル所トホボソノ事ヲ同ジクスルモノ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈故ヲ忘レザルノ最ナルモノニ非ズヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時代ノ人民ハ「ゼウス」神ガとねりこノ木ヨリ造リ出ダセルモノニシテ、青銅ノ家ニ住ヒ、青銅ノ武器ヲ以テ爭鬪シ、青銅ノ農具ヲ以テ耕作セリト云フ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "假令同一人民ニシテ青銅器ト鐵器トヲ用ヰタル事有リトスルモ、鐵器ノ用ハ常ニ青銅器ノ用ニ後ルト定マリタルモノニハアラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じく小野蘭山口授の『本草｜訳説』（内題は『本草綱目訳説』）には「恕菴［牧野いう、松岡恕菴］先生秘説（蘭品）ニハ山海経ノ薫草ヲ和ニ麝香草ト称ルモノニ充ツ未的切ナラズ麝香草ハ生ニテ動揺スレバ香気アリ乾セバ香気ナシ漢名麝草（王氏彙宛）」と出ている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……師範學校ノ功用ハ既ニ東京ニ設立セルモノニ於テ、其實驗ヲ表セリ。",
              "citation": {
                "source": "黒板は何処から来たのか",
                "author": "小倉金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "朕ト爾等国民トノ間ノ紐帯ハ、終始相互ノ信頼ト敬愛トニ依リテ結バレ、単ナル神話ト伝説トニ依リテ生ゼルモノニ非ズ。",
              "citation": {
                "source": "「人間宣言」のうちそと",
                "author": "前田多門",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
