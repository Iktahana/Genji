        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私は一度充分に眠るともっと楽になるだろうと思って、医師に相談してルミナールを二錠呑ませました。",
              "citation": {
                "source": "臨終まで",
                "author": "梶井久",
                "note": "青空文庫"
              }
            },
            {
              "text": "「石炭王」をよんだつづきでゼルミナールよみはじめました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルミナール〇・一ヲ三分服シテ眠ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルミナールハ予ニハサッパリ効果ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシヤッパリ寝ラレナイノデルミナールノ注射ヲシテ貰オウトシタガ、寝過ギルト困ルト思ッテ止メタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテルミナール一錠トカドロノックス半錠トヲ、ストーブノ上ニカカッテイタ湯沸シノ湯ニ水ヲ割リ微温湯ヲ作ッテ飲マシタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫が、―――カドロノックスかルミナールかイソミタールか、何か睡眠剤だったのだろう、―――水と一緒にタブレットを噛み砕いたものを口うつしに飲ましたが、頭の痛みを忘れたいので私は素直にそれを飲んだ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鎮静と安眠のためルミナールを用いることにする。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先刻夕食後注射したルミナールが利いて来たのだとみえる。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五時半、夕食前三十分に今日もルミナールを射す。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、その鼾さえも、今のはニセの鼾ではないかと凝い得る場合がないではない）児玉さんの許可を得て、明日からルミナールを日に二回、午前中に一回と、午後に一回と用いることにする。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、黙って病人の腕へルミナールを射そうとする。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
