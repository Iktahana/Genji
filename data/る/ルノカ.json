        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ドウ　シタノデセウ」「マダ　ネンネシテルノカシラ」「ワタシタチガ　モウ　オメメヲ　ヒライタ　コトヲ　シラナイノカシラ」「モウ　ハルガ　キテルノヲ　シラナイノカシラ」　ソコデ　花タチハ　マダ　ヒラカナイ　ツボミヲ　オコシニ　カカリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　被告ハ清三ニ恨ミガアルノカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナホモ杳カナ穹窿ヲ犇イテヰルノカ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ西洋デハ、大工ノ子ノ生レタ年ヲ、年号ノ初メニスルノカ」「左様でございます」「基督トイウ人ハ、ソンナニ豪イ大工デアッタノカ」「大工さんの子としてお生れになりましたけれども、基督様は救世主でございました、神様の一人子でございました」「神様ノ一人子トハ？",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女モ訥升ガ好キナノデハアロウガ、或ハ治兵衛ノ団子ノ方ニヨリ興味ガアルノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イ／＼人生モコレデイヨ／＼終ルノカナト、イクラカホットシタクライダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バレリーナナンテ、足ノコトヲ考エルト見ラレタモンジャナイワ」「レペシンスカヤモソンナ足ヲシテルノカネ」「勿論ヨ、アタシダッテ練習中ハ靴カラタラ／＼血ヲ出シタコトガ何度モアッタワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ風デ何楽シミニ生キテルノカト、人モ思ウダロウシ、自分デモ思ウコトガアルガ、幸イト云ッテイヽノカドウカ、不思議ナコトニ食慾ト睡眠ト便通トハ至ッテ満足ニ行ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモコヽハ開ケラレルノヨ」予ノ入浴ハ午後九時過ギニ決マッテイルカラ、ト云ウ意味ナノカ、予ヲ信用シテイルカラト云ウノカ、見タケレバ見セタゲルカラ這入ッテラッシャイト云ウノカ、老イボレ爺サンノ存在ナンカ全然問題ニシテナイト云ウノカ、何ノタメニワザ／＼ソンナコトヲ断ルノカ分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「浄吉ハ今日ハイルノヨ、今夜庭デバーベキューヲスルト云ッテ騒イデルノ」「誰カ来ルノカ」「春久サント甘利サント、辻堂カラモ誰カ来ルラシイワ」陸子ハアレ以来当分来ル筈ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階ニハ泊リ客ノタメノ室モアルガ、ドコデ彼等ハ涼ンデイルノカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子モ一緒ニ出テ行ッタノカ、ソレトモ流石ニバツガ悪イノデ一人デ二階ニ引ッ込ンデイルノカ、一向姿ヲ現ワサナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一体浄吉ハ君ノコトヲドウ思ッテイルノカネ」「ソレハアタシガ聞キタイクライヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ実際ニドンナ仕事ヲシテイルノカハヨク知ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近イウチニ部長ニナレルラシイガサラリーヤボーナスハ今ドノクライ貰ッテイルノカ、予ニハ分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「来ルノカネ彼氏」「エヽ」ソウ云ッテ、颯子ガチラリト顔ヲ出シタガ、直グニバタント強イ音ヲ立テ、締メ切ッテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "喉デスルノカ、鼻ノ奥デスルノカ、何処デスルノカハッキリ分ラナイガ、何処カソノ辺ヲ通リ過ギル時ニピイピイト鳴ルノラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレカラ何処ヘ出カケヨウトスルノカ、何処ノ部屋ヲ歩イテイルノカヨク分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治ノ中期、二十七八年頃ノ或ル天気ノイヽ日ニ、母ガ我ガ家ノ門前ヲ歩イテ行キ、幼童ノ予ヲ往来デ見カケタコトガアルノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「又ソンナモノニ寝ルノカイ」「何デモイヽカラオ爺チャンハ黙ッテオ休ミナサイ」「籐椅子ナンゾジャ風邪ヲ引クヨ」「風邪ヲ引カナイヨウニ毛布ヲ沢山持ッテ来サセルノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノ爺サン、本気デコンナニ泣イテルノカ知ラ、何ヲタクランデルカ知レタモンジャナイ」ト用心シナガラ、ウワベハ驚イタ風ヲシテ空ットボケテ這入ッテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヽ、直キナオルヨ、………早ク二階ヘ行ッテオ寝、………」予ハソウ云ッタ積リダッタガ、「早ク二階ヘ」アタリカラハ妙ナ濁声ニナッテ何ヲ云ッテルノカ自分デモ分ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ノキャバレノ帰リガ遅カッタノデ寝足リナイノカ、話シカケラレルノガウルサイノデ寝タ振リヲシテイルノカ、ドッチダカ分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ僕ノ嫉妬カラソンナ風ニ気ガ廻ルノカト思ッテ、ソノ考エヲ努メテ打チ消シテイタノデアルガ、ヤハリソウデハナサソウデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "平衡感覚ヲツカサドル神経ハドコヲ通ッテイルノカ知レナイガ、イツモ後頭部ノトコロ、チョウド脊髄ノ真上ノトコロニ空洞ガ生ジタヨウナ感ジガシ、ソコヲ中心ニ体ガ一方ヘ傾クノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドノクライアルノカト云ッテモナカナカ教エテクレナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
