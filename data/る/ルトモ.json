        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "而テ支那保全主義ヲ堅持スル日本ハ彼トノ衝突ニ於テ、其ノ支那經略ノ根據地香港ノ有害ナルコトハ、日露戰爭ニ於ケル旅順浦鹽斯徳ノ根據地ニ優ルトモ劣ラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルリンの未決監獄は、アルトモアブ街に、おそろしげな赤錆色の高壁をめぐらして建っていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "このアルトモアブ街の未決監獄からのかえり、伸子はすぐ下宿へもどらず素子と二人、ながいこと西日のさすティーア・ガルテンの自然林の間を散歩した。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日、使ニ来リシ犬ハ、最モ愛スベキ忠犬ナレバ、ヨクイタハリ、カヘルトモ、留マルトモ、犬ノ意志ニ任セテサシツカヘナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ刀剣ノ利鋭ナルコト、コレヲ以テ欧羅巴ノ刀剣ヲ両断スルトモ疵痕ヲ止ムルナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "大兵ヲ送テ我州民ヲ殺害スルトモ、空論ヲ述テ其罪ヲ遁レントスル為メナリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三句ミダレドモは古点ミダルトモであったのを仙覚はミダレドモと訓んだ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しどうしても四段に活用せしめることが出来ないと一歩を譲って、下二段に活用せしめるとしたら、古訓どおりにミダルトモと訓んでも毫も鑑賞に差支はなく、前にあった人麿の、「ささなみの志賀の大わだヨドムトモ」（巻一・三一）の歌の場合と同じく、現在の光景でもトモと用い得るのである。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "声調の上からいえばミダルトモでもサヤゲドモよりも優さっている。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "バスががたがたとビルトモア裏の終点に下り、町が視界に入ってくるにつれ、彼の頭はひどくぐらぐらした。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "往年ノ軽微ナ脳溢血ノ痕跡ガマダ残ッテイ、脳中枢ニ僅カナ変化ガアルノデ、ソレガ脚ニ影響シテイルノダトモ云イ、又レントゲンデ検ベテミルト頸椎ト腰椎トガ曲ッテイルカラデアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ頸椎ヤ腰椎ヲ矯正スルニハ寝台ヲ斜面ニシタ上ニ寝テ首ヲ上方ニ吊リ上ゲタリ、腰ニギプスデコルセットヲ作リ、当分ソレヲ篏メル必要ガアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ知ッテイルヲ容易ニ口ニ出サナイノガ常デアルガ、悪イコトニハソレヲ女ノ嗜ミデアルトモ思ッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――下民ハ虐ゲ得ルトモ、上天ハ欺キ難シ――と。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
