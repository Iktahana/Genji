        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノスケッチニ取ルベキトコロノアルモノガアルデショウカ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「喧嘩口論、悪人成敗、命ノヤリトリ、白刄クグリ、ヨロズ退屈凌ギトナルベキ荒事ナラバ何ナリトモ御相談ニ応ズベク候間、遠慮ノウ当館ヘ申出デ可然候。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "転々、アヤマラザレバ、コノナニヲ作ルベキ。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "一百萬圓以上ノ富ハ國有タルベキガ故ニ、工夫ハ多クノ賃金ヲ要セズ商家ハ廣キ買客ヲ欲セズト思考スル者ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "露西亞ニ民有論ノ起ルハ正當ナルト共ニ、愛蘭ノ貴族領ガ國有タルベキモ可能ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ日本ガ小農法ノ國情ナルニ考ヘテ之ヲ自作農ノ所有權ニ移シ以テ土地民有制ヲ取ルコトモ、日本トシテノ物質生活ヨリ築カルベキ幾多ノ理論ヲ有ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ改造サルベキ社會組織亦人性ヲ無視シタル此等兩極ノ學究的臆説ヲ誘導サルル能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國有地タルベキ土地。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "壹千萬圓以上ノ生産業ガ國營タルベキ爲ニ起ル疑惑ハ事業家ノ奮鬪心ヲ挫折セシムベシト云フコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人ノ企テザル國家的缺陷タルベキ工業ノ經營。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來一大戰等ヲ覺悟スルナラバ特ニ非常時ニ安泰ナルベキ改造ヲ要ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐵道ノ國有タルベキ者ト民有タルベキ者ト、亦實ニ私人生産業限度ノ原則及ビ大資本ノ國家統一ノ原則ノ下ニ律セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "永久的ニ認メラルベキ勞働者ノ特權ニ非ザルト共ニ、一躍此ノ改造組織ヲ確定シタル國家ニ取リテハ斷然禁止スベキ者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ改造後ノ勞働者ハ眞個其ノ自由ヲ保持シテ些ノ損傷ナカルベキハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家的生産ニ雇傭セラルル勞働者ハ此ノ利益配當ニ代ハルベキ半期毎ノ給付ヲ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家生産ノ勞働者ニ利益配當ヲ用ヒザル所以ハ、國家ハ全生産ノ永遠的經營ヲ本旨トスルガ故ニ、全國家ノ生産的活動ノ爲ニ或省ニハ殊更ニ投賣ヲ行ハシメテ損失ヲ顧ミザルコトアル如ク、或ル省ヲ犧牲トシテ或省ノ對外競爭ヲ專ラナラシムルコトモアルベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "體刑ヲ課スル所以ハ國家ノ兒童ヲ保護スルニ最モ嚴勵ナルベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本婦人ノ人格ハ歐米ノ如ク男子ノ職業ヲ爭ヒテ認メラルベキ將來ヲ假想スルノ要ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レ教育スベキ國家ノ窮乏セルト、教育セラルベキ國民ニ餘裕ナカリシヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ最モ急進的ナル羅馬字採用ヲ決行スルトキ、幾分文字ノ不便ハ免ルベキモ言語ノ組織其者ガ思想ノ配列表現ニ於テ悉ク心理的法則ニ背反セルコトハ、英語ヲ譯シ漢文ヲ讀ムニ凡テ日本文ガ顛倒シテ配列セラレタルヲ發見スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ不用ナルベキ各地ノ中學女學校舍ハ或ハ此レヲ取リ毀チ、又ハ大學豫備校ノ校舍又ハ單科大學ノ校舍トナスヲ得。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮其者ノ歴史ガ示ス如ク、又清國ガ此レヲ屬國トセンガ爲ニ起リタル日清戰爭、及ビ滿洲ニ來タレル露西亞ガ其ヲ侵略セントセシガタメニ破レタル日露戰爭ニ示ス如ク、其ノ亡國タルベキ内外呼應ノ原因ハ統治者ガ日本タラザル時ハ露支兩國ノ焉レカナリシハ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ツアール」ガ侵略シ來レルト「レニン」ガ幾多ノ謬妄ヲ附帶セル社會革命説ヲ奉ジテ殺到シ來ルベキト、日本ガ國防上朝鮮ニ據リテ戰フコトハ國家ノ國際的權利ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ露西亞ノ脅威ハ過渡時代ノ「レニン」ニ非ズシテ「レニン」無キ後眞ニ再建セラルベキ十年後ノ將來ニ存ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本皇室ト朝鮮王室トノ結合ハ實ニ日鮮人ノ終ニ一民族タルベキ大本ヲ具體化シタル者ニシテ、泣ク／＼匈奴ニ皇女ヲ降嫁セシメタル政略的ノ者ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ國際間ニ於ケル民族ノ老幼ヲモ壓迫シ虐遇セザルベキ人道主義ガ則チ民族主義ノ終局理想タルベキ者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
