        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "但シ此ノ場合ニ於テ國家ハ別途其ノ父ニ對シテ賠償ヲ命ジ、從ハザルモノハ勞働ヲ課シテ賠償ニ充テシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ現時ノ對鮮策ナルモノハ甚ダシク英國ノ植民政策ヲ摸倣シタルガ故ニ、根本精神ヨリシテ日韓合併ノ天道ニ反スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "何トナレバ右ノ九人ノ人間ガ死ンダ事件ノ裏面ニ潜ム恐ロシイ爆弾売買ノ真相ヲオ話シ出来ルモノハ、私一人シカ居リマセンカラ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二読会において延期派の小沢武雄君の発議により、前記の原案に「但シ修正ヲ終リタルモノハ本文期限内ト雖モ之ヲ施行スルコトヲ得」という但書を追加せられ、結局本案に付き採決の結果は、延期を可とする者百二十三、断行を可とする者六十一で、延期派の大勝利に帰した。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが真実に子供たちの運命を予言しうるものとすれば（実験の結果によれば――と当代の心理学者が権威をもって発表する）コノ指数ニ満タザルモノハトウテイ社会有用ノ人間タルコトヲ得ズ。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカル未知電波ノウチノアルモノハ、時ニ雑音トイウ名ノモトニワレワレニ知ラレテイル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「千二ヨ、タズネルモノハ、コノサキニアル。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "必ズ幾百幾十年、某帝ノ世ニ造リ何人ノ作ニ係ル等ハ、决シテ臆断ス可キニ非ラズ（確証有ルモノハ此例ニ非ズ）。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ文士才人ヲシテ長ク魂銷シ腸摧ケシムルモノハ特リ馬嵬ト青塚トニ在リ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ニ列スルモノハ古貨幣ナリ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ皆、祈ルコトヲ知リタレドモ、祈ルコトヲ職業トスルモノハ一人モコレ有ラザリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍人ノ経歴アルモノハ、只一人ノミコレ有リキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然ナルモノハ巧思ヲ以テ得ベカラズ、歳月ヲ以テ到ルベカラズ……」　そこで思い出したように、パッと枚数を飛ばしてから、「英雄、医卜ニ隠ル固ニ故有リ矣。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "曰く「居住者ナキ人家ニ入ルモノハ厳罰ニ処ス」。",
              "citation": {
                "source": "北支物情",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫡子タルト庶子タルトヲ問ハス、生存セル丁年未満ノ七子ヲ有スル父及母ニシテ十フラン以下ノ人頭動産税ヲ課セラルルモノハ、此ノ課税ヲ免除セラルルモノトス』「そらね、なるほど、九フラン五十サンチームの税金を納めるので、つまり十フラン以下だ。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、帝国軍人ニ俘虜ナルモノハ存在セズ。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "西方ニ走ルモノハ谷川ノ奥富士山ニ通亘シテ越後国境ヲナス。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚｜為念、従者ラジック・シャアナルモノハ殿下御看護ニ際シ感染本日午後一時三十分死去水葬ノ趣唯今イキトス号船長ヨリノ無電ニ接ス。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ欲スルモノハ進ンデ植物タルコトヲ希望セヨ！",
              "citation": {
                "source": "のんしやらん記録",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワレ知ル、五慾ノ楽シミヲ貪ルモノハ、必ズ、久シカラズシテ命終ルコトヲ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "快楽、虚栄、又アラユル欲望ニ惑溺シテサメザルモノハ、必ズ、命七日ニ終ラン――　ほんとうに仏陀はそう仰っしゃったのかしら？",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――我ヲ生ムモノハ父母、我ヲ知ルモノハ鮑叔ナリ――と管仲がいっているのを見て、ふたりの信をうらやまぬものはないが」「自分には、玄徳という実在のお人があるから、古人の交わりも、うらやむに足りません」「ははあ。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヨソ将タルモノハ、当ニ剛柔ヲ以テ相済ウベク、イタズラニソノ勇ヲノミ恃ムベカラズ。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――客兵倍ニシテ主兵半バナルモノハ、主兵ナオヨク客兵ニ勝ツ――と。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――勝チヲ天下ニ制スルモノハ法ヲ用ウルコト明ラカナルニ依ル――と。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "別所三人ノ頸、安土へ進上、御敵タルモノハ、悉ク御存分ニ属シ、御威光ナカナカアゲテ数フベカラズ。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
