        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その本は「ポオルとヴィルジニイ」であった。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はそれに背中を向け、部屋の隅の暗い電燈の下に坐って、ポケットから「ポオルとヴィルジニイ」を取出した。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見ていると、次第に、今度は、また腹が立って来そうなので、彼は女に構わずに「ポオルとヴィルジニイ」を読出した。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "パウルと※ルジニイのやうにして話した。",
              "citation": {
                "source": "磯清水",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの町の灯の下で、「ポオルとヴィルジニイ」を読んだ日もあった。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ポオルとヴィルジニイなんて、可愛らしい小説じゃあないの――。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "橙色のような小さい赤い本で、マノン・レスコオだの、ポオルとヴィルジニイだの、カルメン、若きウェルテルの悲しみ、など読み耽りました。",
              "citation": {
                "source": "文学的自叙伝",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの町の灯の下で、ポオルとヴィルジニイを読んだ日もあった。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ａ　ごらん、ヴィルジニイ。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、その大きな松の木かげに、お前たちを、ポオルとヴィルジニイのように残したまんま、或る日、ひとり先きに、その村を立ち去った。",
              "citation": {
                "source": "麦藁帽子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、その大きな松の木かげに、お前たちを、ポオルとヴイルジニイのやうに殘したまんま、或る日、ひとり先きに、その村を立ち去つた。",
              "citation": {
                "source": "麥藁帽子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋では「ロミオとジユリエット」「トリスタンとイソルデ」「ペレアスとメリザンド」「ポオルとヴィルジニイ」などがあり、日本では「お染久松」「お半長右衛門」「お国と五平」等々……。",
              "citation": {
                "source": "標題のつけ方",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
