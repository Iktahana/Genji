        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕ハモーダメニナッテシマッタ、毎日訳モナク号泣シテ居ルヨウナ次第ダ、ソレダカラ新聞雑誌ヘモ少シモ書カヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト軈テ二階カラ人ガ降リテ来ルヨウナノデ、ソット様子ヲ窺ウトソレハ道子デシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………ト、清琴ノ声デ唄ッテイルノガ聞エテ来ルヨウナ、モウ死ンデイル筈ダガ、死ンデモ聞エテ来ルヨウナ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在ノ予ハソウ云ウ性慾的楽シミト食慾ノ楽シミトデ生キテイルヨウナモノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコノ女ハ枕サガシダト分ッテモ、却テソノタメニ興味ヲ惹カレテ、枕サガシヲ承知ノ上デ関係ヲ結ブ、ソノ誘惑ニ抗シカネルヨウナ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "心ナシカ、イツモヨリ念入リニ流シテクレルヨウナ気ガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫眼石カ」「エヽソウ、ソレモ小サイノジャ駄目、男ガ篏メルヨウナ大キイノガ欲シイノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホラ、アノ声ヲ聞イテルト、『肩｜刺セ裾刺セ、肩刺セ裾刺セ』ト云ッテルヨウニ聞エルデゴザイマショ、モウアノ声ガ聞エ出シタラ秋ナンデゴザイマスヨ」ソウ云ワレルト、気ノセイカ寝間着ノ白地ノ単衣ノ筒袖ヲ肌寒イ風ガ冷エ／″＼ト通リ抜ケルヨウナ気ガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレニ颯子ハ普通ノ個人ノ家庭ニアルヨウナ狭インジャイヤダ、少クトモ縦二十メートル、幅十五六メートル欲シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ニソレヲ見セルノガ目的デプールヲ作ルヨウナモノナンダ」「ソレデモソレハイヽコトデゴザイマスワネ、自分ノ家ニプールガ出来タラ経チャンダッテ喜ブデショウシ、………」陸子ガ云ウト婆サンガ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「経助ノコトナンゾ考エテヤルヨウナマヽジャナインダカラネ、学校ノ宿題ダッテアルバイトノ学生ニ任セッキリナンダカラ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナ馬鹿々々シイ真似ガ出来ルト云ウノガ、モウ気狂イニナリカケテル證拠ヨ」声ノ調子ニ、頭カラ水ヲ浴ビセルヨウナ皮肉ナモノガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ、佛ヲ冒涜スルヨウナ気狂イジミタ考案ノ実現ニ、ソノ人ハ喜ンデ手ヲ藉スデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ何トナク、妻ト敏子トノ間ニ暗黙ノ示シ合ワセガアルヨウナ気ガシテナラナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、心臓ガ弱ッテイルヨウナノデ、結局来テ貰ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ガコノ日記帳ヲ盗ミ読ミシテイルヲ書イタラ今後酔ウヲ証拠立テルヨウナモノデアルカラ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜ハ僕ハ、妻ニ妨ゲラレルヲ行ウニハ、僕ノ胸、腕、頬、頸、脚ナドヲ手デ探ルヨウナ動作ヲシタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今マデノヨウナ譫語ジミタ云イ方デハナクテ、底力ノアル、訴エルヨウナ、叫ブヨウナ声デ呼ンダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
