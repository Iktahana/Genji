          "literary": [
            {
              "text": "……曰く……　――余ノ調査研究セルトコロニ依レバ、既ニ往昔ヨリコノ種ノ犯罪ガ行ワレツツアリシ事実ヲ認ムルヲ得ベシ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカルトコロニ、イツマデモイルベカラズ。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカルトコロニイルベカラズ云々というあの拙い文章の脅迫状ね。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時ハ何処ノ国籍ニ属スルヤ全ク不明ナリシガ只今マデ数日間観察セルトコロニヨレバ○国人ナルモノノ如シ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次に曰く、三、丈が二尺グライノ花瓶、口ニ拇指ヲ置キテ指ヲ中ニサシ入レテ花瓶ノ内側ヲサグリ、中指ガアタルトコロニ、小サク５０９８ト墨書シアリ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ、本願ト同様ナル着想ハ、本願出願以前ニ、帝国領土内ニ於テ存在シ、且｜遍ク知ラレタルトコロニシテ、例エバ奈良唐招提寺金堂ニ保管セラレアル千手観音立像ハ、四十臂ヲ有ス。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "金椎ノ談ニヨレバ、救世主ハ大工ノ子ニシテ――耶蘇ノ教フルトコロニヨレバ、娼婦、税吏、異邦人、姦淫セル女等ガ却ツテ、驕慢ナル権者、偽者ナル智者、学者ヨリ光栄アル壇上ニ置カルルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザウサン　サルサン村山籌子　アルトコロニ　タイヘン　オギヤウギノヨイ　ザウサンガアリマシタ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "水ガ口ヨリ鼻腔ニ及ビ、完全ニ窒息スルトコロニテ止ム。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
