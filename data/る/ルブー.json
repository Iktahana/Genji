        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "シカンダールブール砦を立てた時梵種一人とヅサード族の娘一人を牲にした。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "あと二日たてばフランスのシェルブール港にはいる予定だった。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "○食堂ではガルブーシャ〔ます〕ばかり二日つづけてくってる。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルアーブルとシェルブール（ノルマンディ）に亙る百五十キロのところに、そして、中心たるカーンで大激戦。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕　十四年八月以来、五年目、十四年八月二十二日に喀血して休む、六月二十五日（日曜）　北フランス膠着のよし　しかしコタンタン半島の遮断に成功したのだそうだし、シェルブールが西南で包囲されたと云えば、動いている。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○シェルブール撤収。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞かせてあげようか、お父さんは、二十人ばかりの友人に守られて、シェルブールの兵器庫の役人の家にいるんです。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕には分らない……」「電報を打った所の名をよくごらん、そらシェルブールとあるだろう。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "、なるほど、分る……シェルブールだ、それから？",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年は兵器庫のあるシェルブールへ向う汽車に乗った。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "不思議な一枚の写真　シェルブールの停車場には、父を預けておいた兵器庫の役人のフロベルヴァルが、十二三歳になる娘のシャルロットを連れて少年を迎いに出ていた。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰宅の後枕上マルセルブーランヂヱーの小説マルグリツトを読む。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アダム・ナリン氏は未だ帰って居りませぬがその父のソェナム・ノルブーという方が私を綺麗な仏堂に導いてくれました。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝは古へはアクワアルブーレエと稱せられた處である。",
              "citation": {
                "source": "温泉雜記",
                "author": "濱田耕作",
                "note": "青空文庫"
              }
            },
            {
              "text": "また五人の上院議員、ヴィブレー侯爵、タラリュ侯爵、エルブーヴィル侯爵、ダンブレー子爵、ヴァランティノア公爵らは、客間の貴族的な趣を増さしていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャール十世はシェルブールへの旅行中、丸いテーブルを四角に切らした、そして崩壊しかけた王政よりも乱れかけた儀礼の方にいっそう心を痛めてるらしかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュ・ブルールとソーヴァルとがその名前をあげてるし、ルブーフ師もそれをあげてる。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルブーは17世紀中葉のフランス皇女の教育について次のように述べている。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "いままた、ファルステルブーの沖のモークレッペン島のあたりに住んでいる水鳥たちが、三角やら、長い曲線やら、クサビ型やら、半円やら、さまざまの妙な形をして飛んできました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "７　三つの段々　つぎの日に、ガンのむれは、スモーランドのアルブー地方をとおって、北へ旅行しようと思いました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "16　カラス土のかめ　スモーランドの西南のはしに、スンネルブーという地方があります。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "スンネルブー地方が、ハルランドと接するところには、砂だらけの荒れ地がひろがっています。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから夏のあいだは、スンネルブー地方の農場にちらばって、卵や、草木の実や、小鳥などをたべて生きています。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなふうにして、ふたりは、スンネルブー地方のヒースの生えている、あの荒れ地まで、オヤユビくんのあとをたどっていくことができたのでした。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
