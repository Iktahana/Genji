        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ケサノコノ走リ書モマタ、純粋ノ主観的表白ニアラザルコトハ、皆様承知。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒトノ後ヲ尾行シタリ隣室ヘハイツテ散々俺ノ悪口ヲ言ツタリ、俺ノ生活ヲ覗イタリスルコトハ、今後絶対ニヤメテクレ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧富ヲ無視シタル劃一的平等ヲ考フルコトハ誠ニ社會萬能説ニ出發スルモノニシテ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ小地主ト小作人ノ存在スルコトハ神意トモ云フベク、且ツ社會ノ存立及發達ノ爲メニ必然的ニ經由シツツアル過程ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レニ反シテ、此ノ私有地限度超過ヲ徴集スルコトハ近代的所有權思想ノ變更ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ大地主ノ土地ヲ徴集スルコトハ最高ノ所有者タル國家ノ權利ニシテ國有ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ動カスベカラザル原理ハ、都市ノ住宅地ト異ナリテ農業者ノ土地ハ資本ト等シク其經濟生活ノ基本タルヲ以テ、資本ガ限度以内ニ於テ各人ノ所有權ヲ認メラルル如ク、土地亦其限度内ニ於テ確實ナル所有權ヲ設定サルルコトハ國民的人權ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "人類ヲ公共的動物トノミ考フル革命論ノ偏向セルコトハ、私利的欲望ヲ經濟生活ノ動機ナリト立論スル舊派經濟學ト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時ノ大資本ガ私人ノ利益ノ爲ニ私人ノ經營ニ委セラルルコトハ、人命ヲ殺活シ得ベキ軍隊ガ大名ノ利益ノ爲ニ大名ニ私用セラルルコトト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民膏血ノ貯金又ハ事業ノ運命ヲ決スベキ預金等ガ銀行ノ破産ニヨリテ消散スルコトハ國民生活ノ一大不安ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "自己ノ私利ヲ目的トスル資本制度ニ依頼シテ晏如タルコトハ、今日及ビ今後日本ノ國際的危機ノ忍ブ能ハサル所ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ、勞働的株主ヲ併存セシムルコトハ内容的根本的ニ常ニ該事業ヲ健確ニ支持スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ其ノ女ガ他家ニ嫁シテ餘力アル者ト雖モ、其老親ノ扶養ヲ夫ノ資産勞働ニ依頼セシムルコトハ、父母ノ屈從不安ヲ招キ更ニ婦人ヲシテ夫ノ前ニ其ノ人格的尊重ヲ傷クルニ至ラシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民教育ニ於テ英語ヲ全廢スベキハ勿論、特殊ノ必要ナル專攻者ヲ除キテ全國ヨリ英語ヲ驅逐スルコトハ、國家改造ガ國民精神ノ復活的躍動タル根本義ニ於テ特ニ急務ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ最モ急進的ナル羅馬字採用ヲ決行スルトキ、幾分文字ノ不便ハ免ルベキモ言語ノ組織其者ガ思想ノ配列表現ニ於テ悉ク心理的法則ニ背反セルコトハ、英語ヲ譯シ漢文ヲ讀ムニ凡テ日本文ガ顛倒シテ配列セラレタルヲ發見スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "言語ノ統一ナクシテ大領土ヲ有スルコトハ只瓦解ニ至ルマデノ槿花一朝ノ榮ノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ中學程度ノ男生徒ニ制服トシテ靴洋服ヲ強制スルコトハ實ニ門戸閉鎖ノ有力ナル一理由ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "男子ノ姦通罪ヲ罰スルコトハ第一ニ一夫一婦タル國民道徳ノ大本ヲ明カニスルガタメナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ガ純潔ヲ維持スル如ク男子ガ其ノ童貞ヲ完ウシテ結婚スルコトハ双方ノ道義的責務ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "未決監ニアル被告ヲ豫備囚徒トシテ待遇シツツアルコトハ純然タル封建ノ遺風ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ガ平等ニ國家的保障ヲ得ルコトハ益々國民ノ自由ヲ伸張シテ其ノ差別的能力ヲ發揮セシムル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "醫學ニ萬能ノ藥品ナキニ係ラズ政治學ニ參政權ヲ神權視スルコトハ歐米ノ迷信ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "單ナル地圖上ノ彩色ヲ擴張スルコトハ兒戲ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ傭兵ト徴兵トノ強弱ヲ論ズルコトハ無用ナル詮議ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ義務ニセヨ、父母妻子ノ負擔アル男子ヨリ其ノ勞働ヲ奪ヒテ何等ノ賠償ヲナサザルコトハ國家ノ權利ヲ濫用スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ積極的發展ノ爲メニ戰フコトノ單ナル我利私欲ニ非ザルコトハ、他ノ民族ガ積極的覺醒ノ爲メニ占有者又ハ侵略者ヲ排除セントスル現状打破ノ自己的行動ガ正義視セラルル如ク正義ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "自利ガ罪惡ニ非ザルコトハ自滅ガ道徳ニ非ザルト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒユース」ガ勞働者出身ナリトモ、「レニン」ガ社會主義者ノ尊敬スベキ同志ナリトモ、國際的對立ヨリ見テ彼等ガ〔大地主〕タルコトハ、昔時魚賣タリシ大倉喜八、貧書生タリシ加藤高明ガ無産階級ヨリ見テ富豪タルト同シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國ガ早ク已ニ支那ヲ財政的准保護國トセルコトハ説明ノ要ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "假令平家全滅ノ前ノ隆盛ノ如キニセヨ、英國ガ今次ノ大戰ニ於テ本國ヲ脅威セシ獨逸ト、印度ヲ脅威セシ露國トニ恐怖ナキニ至レルコトハ、支那ニ於テ二國ガ亦同樣ナル脅威ヲ滿蒙ト青島ヨリ加ヘタル恐怖ヲ除去シタル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
