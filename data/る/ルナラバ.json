        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "モシ、君ガ充分ノ親切心ト忍耐力トヲ保有シテイルナラバ、君ノ今日ノ用事ヲコノ紙片ニ書キシタタメテ欲シイ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "以来、十春秋、日夜転輾、鞭影キミヲ尅シ、九狂一拝ノ精進、師ノ御懸念一掃ノオ仕事シテ居ラレルナラバ、私、何ヲ言オウ、声高ク、「アリガトウ」ト明朗、粛然ノ謝辞ノミ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來一大戰等ヲ覺悟スルナラバ特ニ非常時ニ安泰ナルベキ改造ヲ要ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家組織ガ下掲ノ如ク母トシテ又妻トシテノ婦人ノ生活ヲ保證シ、婦人ガ男子ト平等ノ國民教育ヲ受クルナラバ、其ノ妻トシテノ勞働母トシテノ勞働ガ人格的尊敬ヲ以テ認識セラルルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ニ禮式作用ガ必須課目ナラバ男子ニモ男子ノ其レガ然ルベク、茶ノ湯生花ガ然ルナラバ男子ニ謠曲ヲ課セザレバ不可。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "主權國民ガ西比利亞ニ於テ露語ヲ語リ濠洲ニ於テ英語ヲ語ル顛倒事ヲナス能ハザルナラバ、日本領土内ニ一律ナル公語ヲ決定シ彼等ガ日本人ト語ルトキノ彼等ノ公語タラシメザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ此ノ立法ガ男子ノ道念ニヨリテ行ハレザルナラバ忌ムベキ婦人勞働トナリ婦人參政權運動トナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本國民ガ全亞細亞ノ盟主タル大使命アルナラバ、人倫ノ大本ヲ嚴守勵行スル立法ハ實ニ一日ヲ忘ルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ノ亡國史ヲ知リ露國ノ脅威ニ戰慄シタル危機ヲ顧ルナラバ、愛蘭土獨立問題ヲ朝鮮ニ直譯シテ論及スルノ理ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ノ信仰ガ強固ニシテ犧牲ヲ甘ンズル事例ヲ擧ゲテ對抗スルナラバ宗教ノ低級ナル者ニ於テ斯ル例ノ他ニ無數ナル者ヲ擧グ可ク、更ニ斯ク頑迷移サザル者多キガ故ニ殺スベシト云フ囘教ノ信仰ニヨリテ答ヘザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那ヲ併呑シ朝鮮ヲ領有セントシタル「ツアール」ノ利己ガ當時ノ状態ニ於テ不義ナリシ如ク、廣漠不毛ノ西比利亞ヲ獨占シテ他ノ利己ヲ無視セントスルナラバ「レニン」政府現在ノ状態亦正義ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ノ無産階級ガ組織的結合ヲナシテ力ノ解決ヲ準備シ又ハ流血ニ訴ヘテ不正義ナル現状ヲ打破スルコトガ彼等ニ主張セラルルナラバ、國際的無産者タル日本ガ力ノ組織的結合タル陸海軍ヲ充實シ、更ニ戰爭開始ニ訴ヘテ國際的劃定線ノ不正義ヲ匡スコト亦無條件ニ是認セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ今ノ軍閥ト財閥ノ日本ガ此ノ要求ヲ掲グルナラバ獨逸ノ轍ヲ踏ムベキハ天日ヲ指ス如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "假令英國ガ彼等ノ所謂自治ヲ許容シテ「ヂヨンブル、ソーサイテイ」ノ組合ヲ脱セシメザラント計ルトキモ、彼ニシテ全然沒交渉ナル獨立ヲ欲シテ蹶起スルナラバ固ヨリ然ルベキハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "外力ノ援助ナクシテ植民米人ガ戰フベキ武力ヲ有セザリシ如ク、一切ノ武器ヲ奪ハレシ印度獨立軍ニ對シテ恣ニ鎭壓軍ヲ輸送セシムルナラバ其ノ獨立ハ永久ニ期待スベカラザル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊惰ナ階級ノ贅沢ナル生活ヲ連想サレルナラバ、ソハ、別荘卜云フ言葉ガ悪イノデアル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
