        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヴォルテール、ルソオの受難を知るや。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルソオの懺悔録であった。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルソオが、やはり細君の以前の事で、苦汁を嘗めた箇所に突き当り、たまらなくなって来た。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間は、十六歳と二十歳までの間にその人格がつくられると、ルソオだか誰だか言っていたそうだが、或いは、そんなものかも知れない。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルソオの懺悔録のいやらしさは、その懺悔録の相手の、（誰か、まえに書いたかな？",
              "citation": {
                "source": "思案の敗北",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーガスチンのそれと思い合わせるならば、ルソオの汚さは、一層明瞭である。",
              "citation": {
                "source": "思案の敗北",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルソオも、オーガスチンも、ともに、やさしい人である。",
              "citation": {
                "source": "思案の敗北",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜ、ルソオの懺悔録が、オーガスチンのそれより世人に広く読まれているか、また読まれて当然であるか。",
              "citation": {
                "source": "思案の敗北",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばルソオなどという人はおそらく、ああいう絵より外の絵は描けなかった人だろうと思うが。",
              "citation": {
                "source": "二科会展覧会雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――とにかく形式はルソオのようなところはあっても味はまるでちがうと思う。",
              "citation": {
                "source": "二科会展覧会雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、ルソオの『懺悔録』を読んで居ります。",
              "citation": {
                "source": "俗天使",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "モデルを家に呼んで、大きいトルソオに取りかかった様子でありました。",
              "citation": {
                "source": "兄たち",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャン・ジャック・ルソオ――「恒久平和の企図」　エミイル・ヴェルハアレン――「黎明」（この戯曲に於て、ベルギイの詩人は人類社会の甦生の希望を述べている。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて連れ立ちて、其人の家の戸口までおくり行くに、街の上はいふもさらなり、「コルソオ」の大道さへ物寂しう見えぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "走るさまは、「コルソオ」の競馬にも似ずや。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ちヰア、バブヰノ、イル、コルソオ、ヰア、リペツタなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "イル、コルソオの兩角をなしたるは、同じ式に建てたる兩｜伽藍なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "我はほと／＼興を失ひて、「トルソオ」をも「アンチノウス」をも打ち棄てゝ、家路に向はんとせしとき、忽ち羽つきたる※を戴き、長靴の拍車を鳴して、輕らかに廊を歩みゆく人あり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝にはポヽロの廣こうぢに出でゝ、競馬の準備を觀、夕にはコルソオの大道をゆきかへりて、店々の窓に曝せる假粧の衣類を閲しつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "）コルソオの街を灑掃する役夫は夙に業を始めつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "今やコルソオの競馬始らんとするなれば、兵士は人を攘はんことに力を竭せり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日は人の波打ちしコルソオの大道には、往き交ふ人｜疎にして、白衣に藍色の縁取りしを衣たる懲役人の一群、霰の如く散りぼひたる石膏の丸を掃き居たり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "コルソオの大道にて戲謔能く人の頤を解きしは誰ぞ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "羅馬及ミラノにては大街をコルソオと曰ひ、パレルモにてはカツサロと曰ひ、拿破里にてはトレドと曰ふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "コルソオの大路は長しと雖、繁華なるトレドの街と異なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "こはヱネチアの心胸と稱すべき處にして、國の性命は此に存ずといふなるに、その所謂繁華は羅馬のコルソオに孰與ぞ、又拿破里の市に孰與ぞ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルソオのように、自然に帰れなどと云ったって、太古と現在との中間の記憶は有力な事実だから、それを抹殺してしまうことは出来ない。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間が最初そんな風に離れ離れに生活していて、それから人工的に社会を作った、国家を作ったと云う思想は、ルソオのContrat socialあたりの思想で、今になってまだそんな事を信じているものは、先ず無いね。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間が最初そんな風に離れ離れに生活していて、それから人工的に社会を作った、国家を作ったと云う思想は、ルソオの Contrat social あたりの思想で、今になってまだそんな事を信じているものは、先ず無いね。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
