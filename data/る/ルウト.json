          "literary": [
            {
              "text": "カヴァ酒を飲み、アロウ・ルウトの料理を喰う。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "右肩印はエジプトのルクソルにて、左裾の印はシリヤのベエルウトにて、彫らしめしものなり、とあった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "フルウトの歌口と火焔の端とは可なり距離があつて同日の談でない。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "奧さまにもお孃さまにも、それからオウガスタさんにも、テオドラさんにも、ブルウトン・ブロクルハーストさまにもよろしくね。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘエ・ド・ルウトの墓地の二本の水松は特にウウル県の格別の保護を受けてゐる。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
