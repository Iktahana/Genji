          "literary": [
            {
              "text": "昔おえらいルナチャルスキイとなん申します方が、――生活とは何ぞや？",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルナチャルスキイならずとも、生活とは何ぞや？",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "緊張せる生活はその自然的な補いとして創造、争闘の緊張、翹望を持つ――女達が風呂に出はらった後の昼間の女給部屋で、ルナチャルスキイの「実証美学の基礎」を読んでいると、こんな事が書いてあった。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔おえらいルナチャルスキイとなん申します方が、云ってござる。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルナチャルスキイならずとも、生活とは何ぞや！",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女達が風呂に出はらった後の夕暮れの女給部屋で、ルナチャルスキイの、実証美学の基礎を読んでいると、こんな事が書いてあった。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
