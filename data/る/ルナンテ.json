        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ト　モウシマス　ト、サカナタチ　ハ、サモサモ　バカ　ニ　スルヨウニ、ワラッテ　オヨギ　モ　シラナイデ　ウミ　ニ　クルナンテ、キミ　ハ　オオバカサンダ　ト　イッテ　アイテ　ニ　シテ　クレマセンノデ、ヤマキチ　ハ　コンド　ハ　ナミ　ニ　ムカッテ、ボク　ヲ　オヨガセテ　クダサイ　ト　タノミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ナミ　ハ、ヤマ　ノ　コドモ　ガ　ウミ　ニ　クルナンテ　ナマイキダ　ト　オコッテ、ヤマキチ　ヲ　ヒトマキ　マイテ　イワ　ノ　ウエ　ヘ　タタキツケマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナツテ、人参サンハ　ジヤガイモサント、ケンクワヲシテヰルコトヲ思ヒ出シマシタガ、シカタナク、何度モ、ソノコトヲ話ニジヤガイモサンノオ家ノ入口マデ行ツテハ、「エエ、イマイマシイ、ボクノハウカラ、口ヲキイテヤルナンテコトハナイ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ッテ尿量ガ多ク、夜中ニ二回カ三回ハ起キルガ、ソノタメニ寝ソビレテ眼ガ冴エルナンテコトハ一度モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ成立シタバカリデナク、母ノ忰デアル予ガ孫ノ嫁ノ魅力ニ溺レ、彼女ニペッティングヲ許シテ貰イ、ソノ代償ニ三百萬圓ヲ投ジテ猫眼石ヲ買ッテヤルナンテ事件ガアッタラ、母ハ驚イテ気絶スルダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エヽソウヨ」「ソンナ石ガ何百萬圓モスルンデスカ」「ソンナ石トハ失礼ネ、コレガ三百萬圓ヨ」「オ爺チャンニ三百萬圓出サセルナンテ、叔母サンハ凄腕ダナア」「チョット菊太郎サン、オ願イダカラソノ『叔母サン』ハ止シテ頂戴。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ山オクデ、一生ヲ終ルナンテ、馬鹿クサイト思ワンカ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫ケラガ組合作ルナンテ、生意気ナ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
