        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "達者ニ在ッテハ何ゾ必ズシモ其｜遽カニ至ルヲ驚カン哉。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラ磯ニ浪ノヨルヲ見テヨメル大海ノ磯モトドロニヨスル波ワレテクダケテサケテ散ルカモ　一言の説明も不要かと存じます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "高邁ノ精神ヲ喚起シ兄ガ天稟ノ才能ヲ完成スルハ君ガ天ト人トヨリ賦与サレタル天職ナルヲ自覚サレヨ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルヲ、最悪ノ猿ト雖モ、最善ノ人間ヨリ悪ヲ行フ所｜尠ク、マタ猿ハ阿諛ヲ知ラヌナリ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルヲ、猿ノ赤キ雙頬ハ羞恥ノ花火ヲ揚ゲシ故ナリ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "敬ニシテ礼ニ中ラザルヲ野トイヒ、勇ニシテ礼ニ中ラザルヲ逆トイフ　とか、信ヲ好ンデ学ヲ好マザレバソノ蔽ヤ賊、直ヲ好ンデ学ヲ好マザレバソノ蔽ヤ絞　などというのも、結局は、個人としての子路に対してよりも、いわば塾頭格としての子路に向っての叱言である場合が多かった。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日｜昧爽、櫛沐ニ方リ、打門ノ声甚ダ急ナルヲ聞キ、楼欄ニ憑ツテ之ヲ観ルニ、客アリ。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アノ　サルヲ　キラウ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ダメダ　ダメダ、キミラノ　ウデデハ　サルヲ　トリニガシテ　シマフ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビヨウキノ　サルヲ　キツテモ　シカタナイト　イフノデ、五人ノ　サムライハ、ソノ　サルヲ　ツレテ　ユキマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、マイニチ　イツテモ　イツテモ　ヒロイ　ノハラデ　タベモノガ　ナイノデ　サルヲ　コロシテ　タベナクテハ　ナラナク　ナリマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　五ニンノ　サムライハ　サルヲ　キラナクテ　ヨカツタ　コトヲ、メニ　ナミダヲ　タメテ　ヨロコビマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ、者裏ニ向ッテ、一隻眼ヲ著得セバ、スナワチ、前百丈（野狐ノコト）風流五百生ヲカチ得タルヲ知リ得ン。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ヲ殺スハ、国家ノ大禁ニシテ、人ヲ殺ス者ヲ罰スルハ、政府ノ公権ニ候処、古来ヨリ父兄ノ為ニ、讐ヲ復スルヲ以テ、子弟ノ義務トナスノ古習アリ。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "天ノ命、二十世紀ノ第一年ヲ以テ此ノ法案ヲ起草セシメタルヲ拜謝ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本改造法案ノ起草者ハ當然ニ革命的大帝國建設ノ一實行者タラザルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ餘儀ナキ明日ヲ憂ヒ彼ノ凄慘タル隣邦ヲ悲シム者、如何ゾ直譯社會主義者流ノ巾幗的平和論ニ安ンズルヲ得ベキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ國體ハ三段ノ進化ヲナセルヲ以テ天皇ノ意義又三段ノ進化ヲナセリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "審議院ハ一囘ヲ限リトシテ衆議院ノ決議ヲ拒否スルヲ得。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "二院制ノ一院制ヨリ過誤少ナキ所以ハ輿論ガ甚ダ多クノ場合ニ於テ感情的雷同的瞬間的ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "歐洲ノ中世史ニ於ケル騎士ガ婦人ヲ崇拜シ其眷顧ヲ全ウスルヲ士ノ禮トセルニ反シ、日本中世史ノ武士ハ婦人ノ人格ヲ彼ト同一程度ニ尊重シツツ婦人ノ側ヨリ男子ヲ崇拜シ男子ノ眷顧ヲ全ウスルヲ婦道トスル禮ニ發達シ來レリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ限度ヲ破ル目的ヲ以テ財産ヲ血族其他ニ贈與シ又ハ何等カノ手段ニヨリテ他ニ所有セシムルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "限度ヲ設ケテ壹百萬圓以下ノ私有財産ヲ認ムルハ、一切ノ其レヲ許サヾランコトヲ終局ノ目的トスル諸種ノ社會革命説ト社會及人性ノ理解ヲ根本ヨリ異ニスルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ明示シタル所以ハ此限度ヨリ免カルヽ目的ヲ以テスル外國ノ財産ヲ禁スルヲ明カニシタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ納付ヲ拒ム目的ヲ以テ現行法律ニ保護ヲ求ムルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "無償ヲ以テ徴集スル所以ハ、現時大資本家大地主等ノ富ハ其實社會共同ノ進歩ト共同ノ生産ニヨル富が惡制度ノ爲メ彼等少數者ニ停滯シ蓄積セラレタル者ニ係ハルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "理由ノ第二ハ、公債ヲ以テ悉ク此等ヲ賠償スル時ハ、彼等ハ公債ニ變形シタル依然タル巨富ヲ以テ國家ノ經濟的統一ヲ毀損シ得ベキ力ヲ有スルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
