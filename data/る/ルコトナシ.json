          "literary": [
            {
              "text": "湛々タル露アリ陽ニ非ザレバ晞ズ厭々トシテ夜飲ス酔ハズンバ帰ルコトナシ　明らかに貧しい生活なのにもかかわらず、まことに融々たる裕かさが家中に溢れている。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三枝ヲ折ルモ大樹ハ損傷サルルコトナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "憲法には司法権の独立が保障してあり、また明文をもって臣民の権利を保障して、「日本臣民ハ法律ニ依ルニ非ズシテ逮捕監禁審問処罰ヲ受クルコトナシ」と規定してある。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノ中ニハ可也信用ノ置カレルノモアリ、又可也怪シイモノモアルガ、此點ニ就テハ一切私見ヲ加ヘルコトナシニ、其儘ヲ採録シタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "大丸の符牒　（イエトモヲコルコトナシ）とか聞いておりました。",
              "citation": {
                "source": "大丸呉服店",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "「福音書ノ何レノ部分ニモ耶蘇ノ面貌ヲ記載シタルコトナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ猶ホ、コノ信神渡航者ノ一行ニハ、一人ノ貴族モナク、イハユル英雄モ豪傑モ、一人モ有ルコトナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "加之斯ク其施行ヲ禁ジ、王ハ自カラ之ヲ忘却シテ意ヲ用ユルコトナシ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ是ニ繼デ思慮ノ能力ヲ練熟スルコトナシト。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
