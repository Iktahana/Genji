          "literary": [
            {
              "text": "ルシァン・ルルゥ……ロワイエ・コラール街八番地。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルシァン・ルルゥはフェルナンド・セグレェという娘と二人で、二月のはじめから通りにむいた四階に住んでいる。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関番に聞くと、娘はいるが、ルルゥはまだ帰らないといった。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑事が張込みをしていると、夜の十時ごろになってルルゥが帰って来た。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
