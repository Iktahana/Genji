        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "神ノ御名ニ於イテ、君ハ非常ニ気品高キ紳士デアルコトヲ認メル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍、独裁官田中ハ、諸君ヲ山東ニマデヨコサシメタル田中ハ諸君ノ階級ノ最悪ノ敵デアルコトヲ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ山東侵略ノ命令ニ服スルコトヲ止メヨ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ權利ト此ノ義務トハ一切ノ條件ニ依リテ干犯サルルコトヲ許サズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ納付ヲ拒ム目的ヲ以テ血族其他ニ贈與シ又ハ其他ノ手段ニヨリテ所有セシムルコトヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "既ニ都市ノ私有地ヲ許サザルガ故ニ、設定セラレタル地上權ヨリ利得ヲ計ルコトヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ガ國家自ラノ義務ト權能トヲ無視スルコトヲ畏ルベシトナス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "機械其他ノ設備ヲ資本トシテ鑛山其者ノ價格ガ資本ナルコトヲ忘レントスル誤解ヲ防グ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ將來益々國民ノ大多數ヲシテ數十萬數萬ノ私有財産ヲ有セシムルコトヲ國策ノ基本トスルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺産相續ノ正義ヲ規定スルニ見ルモ、合理的改造案ガ必ズ近代的個人主義ノ要求ヲ一基調トスルコトヲ知ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本建國ノ精神ハ内外人ニヨリテ正義ヲ二ニセザルコトヲ誇リトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只獨逸ガ最後ニ破レタルガ故ニ徴兵制ノ價値ヲ疑フハ非常ナル妄斷ナルコトヲ注意ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ彼等ノ殆ド凡テハ今ノ大學教育ナル高等職業紹介所ニ入ルコトヲ以テ一種ノ特權階級ノ如ク考ヘ、心裏實ニ徴兵忌避ノ私ヲ包藏シテ其ノ猶豫ヲ求ムル者ナラザルハナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只獨逸ノ社會主義ニ此ノ國際的理解ナク、且ツ中世組織ノ「カイゼル」政府ニ支配セラレタルガ爲ニ、英領分配ノ合理的要求ガ中世的組織ノ破滅ニ殉ジテ不義ノ名ヲ頒チタルコトヲ注意スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ講和會議ニ於テ英國ノ保護ヲ蒙リテ獨逸ノ利權ヲ繼承スルコトヲ認容セラレタルトキ相賀シテ「國難去レリ」ト云ヘリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「心細イコトヲ云ハナイデ欲イヨ、だつでい――僕トイフ息子ノアルコトヲ忘レタンデスカ？",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“U. S. R. S. Flanklyn”フランクリン号ナル、レシービングシツプデアル、大概港ノ中ニ碇ヲ降シテヰルノデ危険ノ憂ヒハナイガ、僕ニハヤハリ水雷艇ノ方ガ面白イ、君ノ冒険心ガ健ヤカニ成長スルコトヲ望ンデヰル。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "民法親族編第七百七十一条に、子カ婚姻ヲ為スニハ其家ニ在ル父母ノ同意ヲ得ルコトヲ要ス但男ハ満三十年女ハ満二十五年ニ達シタル後ハ此限ニ在ラスとあり。",
              "citation": {
                "source": "女大学評論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "また刑法第二条には「法律ニ正条ナキ者ハ何等ノ所為ト雖モ之ヲ罰スルコトヲ得ズ」との明文があるのである。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二読会において延期派の小沢武雄君の発議により、前記の原案に「但シ修正ヲ終リタルモノハ本文期限内ト雖モ之ヲ施行スルコトヲ得」という但書を追加せられ、結局本案に付き採決の結果は、延期を可とする者百二十三、断行を可とする者六十一で、延期派の大勝利に帰した。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが真実に子供たちの運命を予言しうるものとすれば（実験の結果によれば――と当代の心理学者が権威をもって発表する）コノ指数ニ満タザルモノハトウテイ社会有用ノ人間タルコトヲ得ズ。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "正当防衛ハ不正ノ侵害ニ対スルコトヲ必要トスル。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ不正トハ其ノ侵害ガ法律上許容セラレヌモノデアルコトヲ意味スル。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "防衛ノ程度ヲ超エタル行為ハ情状ニ因リソノ刑ヲ減軽又ハ免除スルコトヲ得。",
              "citation": {
                "source": "黄昏の告白",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手「貴局ト通信ガ出来ルコトヲ甚ダシク喜ブモノナリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑品倉庫ナルコトヲ知リ得タリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "材料ノ不足ニヨリテ意ノ如キ波長ノモノヲ作ルコトヲ得ザルコトヲ発見シタルトキハ絶望ノ泪ニ暮レタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
