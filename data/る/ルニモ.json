          "literary": [
            {
              "text": "又固ヨリ無産階級ノ復讐的騷亂ヲ是非スルニモ非ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ私ハ近ゴロ原稿ヲ書クニモ手紙ヲシタタメルニモヒラガナトイウモノヲ使ツタコトガナイ、ソレハナゼカトイウニ、我々仰臥シタママデモノヲ書クモノニトツテハ些細ナ力ノ消費モ大キナ問題トナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "日曜デアルニモ拘ラズ、浄吉ガ午後羽田カラ立ツ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハナルベク木村ト二人キリニナル機会ヲ作ラヌヨウニシ、イツモホトンド郁子ト三人デ茶ノ間デ話シ、映画ヲ見ルニモ必ズ母ヲ誘ッテ出カケル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新井白石の「藩翰譜」は、――信雄大イニ悦ビ、徳川殿ニ、コノ由ヲ告ゲ申サルルニモ及バズ、十一月十一日、筑前守トノ仲直リノ見参、事終リヌ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
