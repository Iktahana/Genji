        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "時ニ女子ヲシテ優美纎麗ノママニ發達シタル強健ヲ得セシムルニハ丹田ノ根本ヲ整フル以外一ノ途ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸ク中世史ノ革命ヲ學ビツツアル未開後進ナル彼ニ對スルニハ現代的再建ヲ想像スルヨリモ、反動ノ襲來又ハ眞乎ノ建國者ニヨリテ「ピーター」大帝ノ再現ヲモ打算外ニ置ク能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時有名ノフランキリンガ云ヘルニハ、我身ハ居ニ常処ナシ、自由ノ存スル所即チ我居ナリトノ語アリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "十歳許ノ小兒ハ英ノ小兒ヨリ一層敏捷ナレドモ、唯高キ能力ヲ發達スルニハ英兒ト均シク教授ス可ラザルナリ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ總テノ點ニ於テ同樣ナルニハアラズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ頸椎ヤ腰椎ヲ矯正スルニハ寝台ヲ斜面ニシタ上ニ寝テ首ヲ上方ニ吊リ上ゲタリ、腰ニギプスデコルセットヲ作リ、当分ソレヲ篏メル必要ガアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "早速今日カラ戴キニ上リマシタンデ、チョットオ礼ヲ申シ上ゲタイト存ジマシテ」「ナーニソンナコト、一々断ルニハ及バン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯様ナ場合、浴衣ヲ借リルクライハイヽガ、階下ノ客間ナリ応接間ナリ茶ノ間ナリ、今ハ婆サンモ留守デアルカラ至ルトコロガ空イテイルノニ、二階ヘ上ルニハ及ブマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出発以来四日間、近頃ニナク活動シ、ソノ間ニ面倒ナ日記ヲツケタリシタノデ、予自身休養ノ必要ガアルニハアッタガ、今日一日ダケ佐々木ニモ暇ヲ与エル約束ガシテアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ今日マデハソレヲ確カメル機会ガナカッタガ、今日彼女ガ映画ヲ見ニ出カケタ間ニ茶ノ間ヲ捜シテ、容易ニ探リアテルニハ、早クモ僕ニ嗅ギツカレルヲスル女デアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウシタラコレ以上情慾ヲ駆リ立テルナシニ、彼ラヲコレ以上接触サセルニハドウイウ方法ガ残ッテイルカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ攻ムルニハ、塀越シノ槍コソ利アラントテ、十文字、鑰槍ナド打捨テサセ、皆、長柄ノ素槍ヲ持テトテ諸手ニ配ル。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "痩せ型で背が高く、これを「曹瞞伝」の描くところに従っていえば、――佻易ニシテ威ナク、音楽ヲ好ミ、倡優、側に在リ、被服｜軽絹、常ニ手巾細物ヲ入レタル小嚢ヲ懸ケ、人ト語ルニハ戯弄多ク、歓ンデ大笑スルトキハ、頭ヲ几ニ没スルマデニ至リ、膳ノ肴ヲ吹キ飛バスガ如キ態ヲナス。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
