          "literary": [
            {
              "text": "如何ニ早ク已ニ此ノ大本ガ腐爛シ盡シタルカヲ見ン。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "スナワチ、高山山巓ニ於テ、米国ノ放送ヲ如何ナル程度ニ受信シ得ラルルカヲ試ミンガタメナリキ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "總テ蜘蛛ノ類ニハ此類ノ作用殊ニ著シク、或ハ陷穽ヲ作リ他蟲ノ陷ルカヲ窺ヒ、或ハ壁虎ノ如ク、待伏ノ室ヲ作リ、其近邊ニ徘徊スル他蟲ヲ捕ルガ如キ、種々ノ巧ヲナセリ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ明日ノコトヲ考エルト、イッソ今直グヤリ直シテ貰ッテ伸ルカ反ルカヲ一挙ニ決シテシマイタクモアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モデルニスル颯子ニモ、浄吉ニモ、婆サンニモ、誰ヲモデルニシテイルカヲ悟ラセヌヨウニスルコトハ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ厄介ナノハ、立像ヲ製作スル彫刻家ニハモデルガ何者デアルカヲ知ラセナイ訳ニ行カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮リニ友人ガアッタトシテ、ソノ友人ガ優秀ナ技術ヲ具エテイタトシテモ、予ガ何ノ目的デ左様ナ製作ヲ依頼スルカヲ知ッタトシタラ、果シテ快クソレニ応ジテクレルデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ最初、予ガ何ノ目的デ颯子ノ足ノ裏ヲ拓本ニ取ルカヲ、彼女ニハ秘スル積リデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ハ、郁子ガ何ヲ欲シテイルカヲ知ッテイルカノゴトクデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ノ目的ハ、コレラヲ僕ノ日記帳ニ貼付シテオクハ希有ノニヨッテ彼女ヲ極度ニ辱カシメ、彼女ガドコマデシラヲ切ッテイラレルカヲ試シテヤリタイノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
