        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "此等ノ中ニハ可也信用ノ置カレルノモアリ、又可也怪シイモノモアルガ、此點ニ就テハ一切私見ヲ加ヘルコトナシニ、其儘ヲ採録シタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンガアヽ仰ッシャルノモ無理ナイワ」ト颯子ガ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンハ早起キナンダカラ、ソレカラ彼ノ所ヘ行クワ」「寝込ミニ蹈ン込ンデ眼ヲ覚マサセルノモ可哀ソウダナ」「ナアニ寝ナイデ待ッテルデショウヨ」「コイツハヤラレタ」夜九時半入浴、十時就寝。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ今日ノヨウニ、九月中ニコンナコトガアルノモ珍シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ御老人ノコトデスカラソノ御辛抱ガ辛イト仰ッシャルノモ無理ハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様ノ顔ハ見ルノモ癪ダカラ、附イテ来ルナラ別ノ箱ニ乗レト云ッテヤル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ガ間借リシテイルノモ百万遍ノ近所デ田中門前町デアルカラ、コノ方ハ関田町ニ一層近イ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
