        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マントルピイスには、下手な木彫が一つぽつんと置かれている。",
              "citation": {
                "source": "故郷",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベアトリチエとの淨き戀、戰爭の間の苦、逐客となりてアルピイ山を踰えし旅の憂さ、異郷の鬼となりし哀さ、皆我詩中のものとなりぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "眸を放ちて遠く望めば、雪を戴けるアルピイの山脈氷もて削り成せるが如し。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルピイおろしの寒威は、恰も好し、我が沸きかへる血を鎭むるならん。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "遙に地平線に接してはアルピイの山脈の蒼靄に似たるあり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "北には暗黒なるアルピイの山聳え、南には稍※低き藍色のアペンニノ横はりて、此間を填むるものは、唯だ緑なる郊原のみ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は肌の粟を生ずる心地しつゝ、纔に口を開きて、さてはベルナルドオなりしよ、圖らざりき、おん身と伊太利の北のはてなる、アルピイ山の麓にて相見んとはと答へつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝は此地を指してアルピイ山の麓といへり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "われはまことのアルピイの巓に登りて世界の四極を見たり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下の行詰りになった壁をおすと、薄暗い寝室で、ランプがついていて、マントルピイスの上が白く光るので、近よってみると、人骨がばらばらにおいてあるのでした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬車の葬式６・21（夕）　巴里の辻々にある円太郎馬車が廃められて、自動車が代るやうになつた時、その会社員を始め、乗りつけのお客さん達が、サン・シユルピイスのお寺で乗合馬車の葬式を行つた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "闇の女おお方ハルピイアイが糞の中で育てた子だろう。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "轡を並べて遠乗をして、美しい谷間から、遥にアルピイの青い山を望んだこともある。",
              "citation": {
                "source": "世界漫遊",
                "author": "ダウィット　Jacob Julius David",
                "note": "青空文庫"
              }
            },
            {
              "text": "眸を放ちて遠く望めば、雪を戴けるアルピイの山脈｜氷もて削り成せるが如し』かういふいい文章がある。",
              "citation": {
                "source": "ヴエスヴイオ山",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
