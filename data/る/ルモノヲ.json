          "literary": [
            {
              "text": "然ルニ大西郷等革命精神ノ體現者世ヲ去ルト共ニ單ニ附隨的ニ行動シタル伊藤博文等ハ、進ミタル我ヲ解セズシテ後レタル彼等ノ貴族的中世的特權ノ殘存セルモノヲ模倣シテ輸入シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ノ形式的又特殊的課目ヲ廢止シ小學、高等小學、中學校ニ重複スルモノヲ廢シテ一貫ノ順序ヲ正シクス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツヅイテ刺スヨウナ痛ミヲオボエマシタノデハット思ッテ目ヲ開クト要之助ガ悪鬼ノヨウナ相ヲシテ白イ光ルモノヲモッテ私ニ馬乗リニナッテイマス。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多数町村ノ［破壊→頽廃］セルモノヲ恢復スル其五ナリ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ、彼ニ従フトコロノモノモ、屈強ナル壮年男子ニ限リタレドモ、コノ信神渡航者ノ一行ニハ、オヨソ信仰ヲ共ニスル限リ、老幼男女ノアラユルモノヲ抱容スルコトヲ許サレタリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモ、彼等ノ一人モ意気精神ノ阻喪スルモノヲ見ザリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "○「コロボックル」ト「エスキモー」トノ一致ノ點中殊ニ趣味有ルモノヲ擧グレバ次ノ如シ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其夜蛇ノ霊童子トナリ伝雅ノ夢ニ入テ告グ、経文ノ功徳ニヨリテ天ニ生ズル事ヲ得タリ、今ヨリ世ニ疱瘡ヲ患フルモノヲ守護スヘシ、此上ノ芳志ニ我為ニー社ヲ造営シテ与ヘヨトミテ夢覚メタリ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハモウ一度彼女ノ衣類ヲ全部、何カテ何マデ彼女ガ身ニ纏ッテイルモノヲ悉ク剥ギ取リ、素ッ裸ニシテ仰向カセ、螢光燈トフローアスタンドノ白日ノ下ニ横タエタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯縁熏発シテ幸ヒニ信輩ノ熊野ニ詣ルモノヲ乗セタルガ為メニ、更ニ転生シテ第四生ニハ柴燈ヲ燃ヤスノ人身トナルコトヲ得タリ。",
              "citation": {
                "source": "覚海上人天狗になる事",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多数町村ノ頽廃セルモノヲ恢復スル其五ナリ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "イカニ況ンヤ人タルモノヲヤ。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "豆ヲ煮ルニ豆ノ※ヲ燃ク豆ハ釜中ニ在リ泣ク本コレ同根ヨリ生ズルモノヲ相ヒ煎ルコトノ何ンゾ太ダシク急ナル　詩は、五言四絶、わずか二十字にすぎないが、同胞相剋の悲泣とうらみを訴えて人の胸を打たずにおかない。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
