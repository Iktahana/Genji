        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "と御冗談めかしておつしやいましたけれども、或いは、御陽気に見えながらその御胸中には深い御憂悶を人知れず蔵して居られたのでもございませうか、その辺の事は私どもには推量も及ばぬところでございまして、ナンニモ、スルコトガナイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ安寧秩序ヲ保持スルコトガ國家ノ唯一任務ナリトセバ、國民ノ死活榮辱ヲ日夜ニ亘リ終生ヲ通ジテ脅威シツツアル此等ヲ處分セズシテハ國家ナキニ同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ノ無産階級ガ組織的結合ヲナシテ力ノ解決ヲ準備シ又ハ流血ニ訴ヘテ不正義ナル現状ヲ打破スルコトガ彼等ニ主張セラルルナラバ、國際的無産者タル日本ガ力ノ組織的結合タル陸海軍ヲ充實シ、更ニ戰爭開始ニ訴ヘテ國際的劃定線ノ不正義ヲ匡スコト亦無條件ニ是認セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラガナトカタカナハ相前後シテ生レタラシイガ、前者ハ毛筆ト和紙ニ対シ適合性ヲ持ツテイタタメ今日マデ愛用サレタニ反シ後者ハ適合性ヲ持タナカツタタメ、一千年ノ間カエリミラレルコトガナカツタ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "毛筆ニ乏シク、和紙ガ皆無ニチカイ今日ノ我々ノ実生活（趣味生活ハ問題外）ノドコヲ探シテモモハヤヒラガナニ未練ヲノコス理由ヲ発見スルコトガデキナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ理由ハマダ自分デモハツキリワカラナイガ、オソラクヒラガナヲ構成スル線ガアマリニ不規則ナタメ、一定ノ法則ニ従ツテ様式化スルコトガ困難ナセイダロウト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ探求シ、分析シ、整頓シ、再現スルコトニヨッテ、ワレワレハ自然界ノ新シキ神秘ニ触レルコトガ出来ルノデハナイカト思ウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒコートウノコージハオモイノホカハヤクデキアガルコトガワカッタタブン三シユウカンノノチトオモワレル。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "七――即チ毎月十二円又ハ二十円ヲ払込メバ一年後ニハ「泰平郷」分譲地域内ノ欲スル場所ニ於テ、九坪乃至十五坪ノ平家木造建一棟ヲ仮ニ所有スルコトガ出来、爾後十年間払込ヲ継続シサヘスレバ、既ニ十分利用シツヽアル該家屋卜共ニ、敷地百坪乃至二百坪トヲ併セテ、ソノ完全ナ法的名義人トナリ得ル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヘルサンハアワテテ木ニノボラウトシマシタノデ、ツルツルツルツルトスベツテドウシテモノボルコトガデキマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウシテモ、ボンコチヤンヲミツケルコトガデキマセンデシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ電車ニノラウトシマシタケレド、イツパイノマンイン電車デ、ドウシテモノルコトガデキマセン。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「十方三世ノ諸仏、ナラビニ本師釈迦牟尼仏、本来ノ願望ハ遂ゲザレドモ、父母、朋友、信者ノタメ、イマイチド生レ変ッテ仏法ノ恩ヲ報ズルコトガデキマスヨウニ」――この手が岩角から離れたときが今生の命の終りと、朦朧と偈をとなえていると、テンバが精気の霊薬だというコカの葉を智海の口もとにさしつける。",
              "citation": {
                "source": "新西遊記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "タローサンハ　モシモ　トチウデ、コマルコトガデキ、タラト、バスケツトノナカヘ　デンシヨバトヲイレテキマシタノデ、テガミヲツケテ、ハナシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "九十ニナッテモ子ヲ産ンデミセルト云ウ久原房之助ノヨウナ精力ハナク、既ニ全ク無能力者デハアルガ、ダカラト云ッテイロ／＼ノ変形的間接的方法デ性ノ魅力ヲ感ジルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ヨリモ足ガ白クテ、華奢デアルコトガ必要ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレラノ婦人達ハ実際ニハ善良ナ婦人ナノカモ知レナイガ、モシ本当ニ悪人デアリ、ソレト同棲―――ハ出来ナイマデモ、セメテ身近ニ住ミ、接近スルコトガ出来タラドンナニ幸福デアロウカト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪ケレバ悪イホド怜悧デアルコトガ必須条件デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ一ツ気ニナルコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二日以来、予ハ彼女トタッタ二人差向イデ食事スルコトガ出来ルノデアル）六時、佐々木ガ庭ノ散歩ヲ促シニ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔ハ見ルコトガ出来ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ数年来、予ハ白眼ガシバ／＼充血スルコトガアリ、普通ノ時デモ赤味ガ強クナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガドウシタンダ」「アタシモ覚エテナインダケレド、鉾田トハ仕事ノ関係カラ近頃懇意ニオナリニナッテ、時々オ目ニカヽルコトガアルンデスッテ」「ダカラサ、ソレガドウシタト云ウノサ」「イヽエネ、ソノ油谷サンガ先週ノ日曜ニ御近所マデ参リマシタカラッテ、御夫婦デ鉾田ノトコロヘオ寄リニナッタンデスッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前ニモ度々コンナツメタサノ経験ヲシタコトガアルガ、ソシテ大体真冬ノ寒中ニソウナルコトガ多イノダガ、必ズシモ冬トハ限ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "傍ニ邪魔者ガイルコトハイルガ、何カ月ブリカデ颯子ト席ヲ並ベルコトガ出来タコト、颯子ノ服装ガ今日ハ妙ニ挑発的ニ見エルコト、ナドガ原因カモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノミナラズ、モデルガ誰デアルカト云ウコトヲ彫リ手ニ知ラセズニ彫ラセルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カクテ予ハソノ颯子菩薩ノ像ノ下ニ、頭ノ上ニ宝冠ヲ戴イテ胸ニ瓔珞ヲカケ、天衣ヲ風ニヒルガエシタ颯子ノ石像ノ下ニ永久ニ眠ルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテ奈良ノ寺々グライハ見テ置イタ方ガイヽシ、殊ニ今度ハ予ノ菩提所ヲ定メルニツイテモ、必ズ参考ニナルコトガアロウ、ト、ソウ云ッテヤッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシシバ／＼失敗シ、足ノ甲ヤ足ノ裏ヲタオルデ拭イタリ、塗リ直シタリスルコトガ、又タマラナク楽シカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同一ノ空間ニハ複数ノ物体ガ同時ニ存在スルコトガ可能ダッタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
