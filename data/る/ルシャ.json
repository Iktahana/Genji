        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "また近頃エールシャイアのある地に航空隊の練習場を設けかかった。",
              "citation": {
                "source": "戦争と気象学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「駅逓馬車」による永い旅路の門出の場面などでも、こうした映画の中で見ていると、いつの間にか見ている自分が百年前のワルシャウの人になってしまう。",
              "citation": {
                "source": "映画雑感６",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋画をかいている友人は、ペルシャでないか、と私に聞いた。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、「ユダヤ人は、長くペルシャに住んでいた間に、新らしい宗教組織を知るようになった。",
              "citation": {
                "source": "誰",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペルシャの人たちは、其名をザラツストラ、或いはゾロアスターという偉大な教祖の説を信じていた。",
              "citation": {
                "source": "誰",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるだけの酒をのんで、人の子よ、憎悪を消せ消せ消せ、ってね、むかしペルシャのね、まあよそう、悲しみ疲れたるハートに希望を持ち来すは、ただ微醺をもたらす玉杯なれ、ってね。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "衣裳屋のショーウインドウのマネキン人形はまだ消えない朝の電燈の下で今年の秋の流行はペルシャ野羊であることを使嗾して居る。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ライラック花模様がペルシャの鷹狩の若衆に絡んで光沢の波に漂っている。",
              "citation": {
                "source": "バットクラス",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "プルシャンブリューでは無論なしコバルトでも濃い過ぎるし、こんな空色は書きにくいと小山はつぶやきながら行った。",
              "citation": {
                "source": "小春",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "河岸に沿うて二、三町先のマルシャル橋の南詰の角に物理教室がある。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルシャル橋や王宮橋から毎日のように眺め見下ろしたスプレーの濁り水に浮ぶ波紋を後年映画「ベルリン」の一場面で見せられたときには、往年の記憶が実になまなましく甦って来るのを感じたのであった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど早期の開戦はないだろうと踏み、ペルシャ湾沖から紅海に入ってスエズ運河を抜けるコースに、土壇場の変更は加えませんでした。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "二日前にインドを発って、ペルシャ湾沖にかかっていた船を、ではどう進めるのか。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の海運業界には、ペルシャ湾奧への航行禁止を申し合わる動きもありましたが、紅海からスエズ運河を抜けるのは危険ではないとの船長の判断があり、最終的には予定通り進むと決めました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "スタンフォード大学の大学院でＣＡＤ（コンピューターを使って設計をやろうという、怠け者のアイデアだ）を博士論文のテーマにしようとしていたアンディ・ベクトルシャイムは、研究に使う適当な機械がこの世に存在しないことにはたと気づいて、サンのワークステーションの原型となるマシンを自作する。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "Gt はゲゼルシャフト、ドイツ語で会社という意味だ。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "五年ほど遡る、余がワルシャワに長期滞在したときのこと。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワルシャワ帝国歌劇団のプリマドンナ、うむ。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "――アイルシャイアーの株はどのくらいですか？",
              "citation": {
                "source": "株式仲買店々員",
                "author": "コナンドイル　Arthur Conan Doyle",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今夜これから、北ワルシャムに行く汽車があるかね？",
              "citation": {
                "source": "暗号舞踏人の謎",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちが北ワルシャムに着いて下車して、我々の行先を云うや否や、駅長が我々の前に走って来た。",
              "citation": {
                "source": "暗号舞踏人の謎",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今夜の北ウォールシャム行きの汽車は？",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々が北ウォールシャムで下車し、行き先を言うやいなや、駅長が我々の前に走ってきた。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝は、長袖のチェックのネルシャツ、わきにポケットのついたズボン、登山帽、登山靴、それにリュックサックまでかついで、まさに登山そのままだし、高橋路子先生も、すねのところまでのスラックスに、スニーカーというかっこうだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "麾下数万の軍勢を見渡しながら、百年後にはこの中の一人も生残っていないであろうことを考えて涕泣したというペルシャの王様のように、この少年は、今や、自己の周囲の凡てに「限られたるもののしるし」を認めて胸をさされるのであった。",
              "citation": {
                "source": "狼疾記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "抒情詩においては、和歌の形式がいまの思想を容るるに足らざるをおもい、また詩が到底アルシャイスムを脱しがたく、国民文学として立つゆえんにあらざるをいったので、款を新詩社とあららぎ派とに通じて国風新興を夢みた。",
              "citation": {
                "source": "なかじきり",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "前にアルシャイスムとして排した詩、いまの思想を容るるに足らずとして排した歌を、何故になお作り試みるか。",
              "citation": {
                "source": "なかじきり",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
