        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『ソルト・レイク・シティからサンクト・ペテルブルクまで追いかけたが、いつも逃げおおせたな。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊１　祖国の子　一八一二年より満四十年間にわたり、ペテルブルクで発行されていた文学・政治・歴史の綜合雑誌。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年はハイデルベルクで迎へた正月を、今年はマールブルクで迎へました。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は去年の秋マールブルクに来て、この二人に逢ひ、その講義に出たり、ゼミナールに加はつたりしてゐます。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイデッゲルが新しくマールブルクへ来たのは私には嬉しいことでした。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　マールブルクの冬はなかなかよく冷えます。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "かようにして私は、カントからヘーゲルに至るドイツ古典哲学を初め、バーデン学派やマールブルク学派の新カント哲学、マイノングの対象論、ブレンターノの心理学、ロッツェの論理学、等々、いろいろのものを読んでみることに心がけた。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし私が当時彼らの精神的雰囲気を作っていたヘルデルリンを初め、ニーチェ、キェルケゴール、ドストイェフスキーなどに深い共感をもって読みふけるようになったのは、マールブルク大学に移って、ハイデッゲル教授について学ぶようになってからのことである。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤスペルスの哲学の面白さを教えられたのも、やはりマールブルクへ行ってからのことである。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二　私の書斎には今マールブルクの町を描いた小さいエッチングが懸っている。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイデルベルクで一年余を過した私は、マールブルクへ行った。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイデルベルクで知り合った誰彼に別れて、私はマールブルクへ行った。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "マールブルクで知った人々には、大谷大学の鈴木弘氏、立正大学の守屋貫教氏、九州大学の四宮兼之氏、今は文部省にいる長屋喜一君があり、山下徳治君が来た。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃マールブルクへ行った人々は、哲学の方面ではニコライ・ハルトマンとハイデッゲル、宗教学の方面ではオットーを目差していた。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、ちょうど私がマールブルクへ行った学期に、ハイデッゲル教授はフライブルクからマールブルクへ招聘されたので、私は主として氏に就いて学ぶためにハイデルベルクから転学したのであった。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "マールブルクに落着くと、私はすぐハイデッゲル教授を訪ねた。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "レーヴィット氏は、後にマールブルク大学の講師となったが、ユダヤ人であるというので危険を感じ、日本に来て東北大学で教えていたが、ロックフェラー財団の援助によって、日米間の緊張を予感しつつこの春アメリカへ渡ってしまった。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "考えてみると、マールブルクにいた間は、意識してやったことではないが、これまで私の最も多くキリスト教的著作を繙いた時であった。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "マールブルクでは私はほとんど純粋にハイデッゲル教授の影響を受け容れたといってよいであろう。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "マールブルクにいる間、そしてその後もときどき文通によって、私の読書を指導してくれたのはレーヴィット氏であった。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三　マールブルクはドイツの田舎の小さい大学町の一つの典型である。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "マールブルクにフランス語の会話を教える婦人があるということを聞いて、パリへ出る準備のために、一か月ばかり通った。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はマールブルクからパリへ行くことに決めた。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "マールブルクに帰ってきて、レーヴィット氏にその話をすると、この博識なドクトルはジードについていろいろ話してくれた。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "マールブルクにおけるキェルケゴール、ニーチェ、ドストイェフスキー、バルト、アウグスティヌス、等々の読書が今は活きてくるように感じた。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "マールブルクからパリへ、永らく考え慣れたドイツ哲学の土地を離れて出て来たのも、未知のものに対する憧れからであった。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしマールブルク以来私の経験したいわゆる不安の哲学とか不安の文学とかが数年後には日本においても流行するようになった。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は氏の講義を聴くためにマールブルクへ行ったのである。",
              "citation": {
                "source": "ハイデッゲル教授の想い出",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "マールブルクに着いてから間もなく私は誰の紹介状も持たずにハイデッゲル氏を訪問した。",
              "citation": {
                "source": "ハイデッゲル教授の想い出",
                "author": "三木清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
