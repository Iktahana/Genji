        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ギョオテ、シルレルの詩抄半ばじゆしてキョオニヒが通俗の文学史を繙き、あるはルウヴル、ドレスデンの画堂の写真絵、繰りひろげて、テエヌが美術論の訳書をあさりぬ。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれ、ルウヴルの屋根の上、望の色の天のおく、ちろりちろりとひとつ星。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウヴル宮の屋根の上、なさけの星も傾いた。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウヴル美術館へ絵を研究にゆくにさえ、「いつも人に附添われて、馬車を待ち、家族その他を待たねばならない。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウヴル宮殿の古い建物やチュレリイ公園の石垣が対岸に見える河の畔まで行くと、水の流れも何となく霞んで見え、岸に立つマロニエの並木も芽ぐんで来ていた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨日は巴里の好事家が大勢寄つて二月の中頃までルウヴル博物館の傍で公開する装飾美術展覧会を訪うたが、二百五十室もあるので到底一箇月掛かつても観｜尽せるもので無かつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウヴルの美術館でリユブラン夫人の描いた自画像の前に立つても其抱いて居る娘が、自分の六歳になる娘の七瀬に似て居るので思はず目が潤む。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本服を少しく変へて作つたロオヴは、グラン・ブル※アルの「サダヤツコ」と云ふ名の店や、巴里の三越と云つてよい大きなマガザンのルウヴルの三階などに陳べられて居るので、然まで珍しくも無いであらうが、白｜足袋を穿いて草履で歩く足附が野蛮に見えるらしい。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウヴルの博物館にある伊太利の絵と彫刻とを見た丈でも自分は然う云ふ事が想像される。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里のルウヴル博物館は旧い王宮｜丈に壮麗であるが、始めから倫敦の様に博物館として建てられたので無い為に不充分な所が多い様である。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "之に加へて巴里のルウヴル及びリユクサンブルの二大博物館を観れば欧洲の絵画の古今に亘る精粋を概観し得たと云つて好いであらう。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が優麗なルウヴル宮やトロカデロの劇場を映すのに対して、之は堅実な国会の大建築を伴つて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分等はそれからルウヴル行の市街電車に乗つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯この蒸暑い日に其処ではどんなに涼しさが得られるか知れないと云ふ気がしたのと、ルウヴルが終点であるから降りるのに心配がないと思ふからでもあつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分等は電車から降りてルウヴル宮に沿うたセエヌの河岸のマロニエの樹下道を歩いてトユイルリイ公園へ入つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分等はルウヴル宮の横の橋を渡つて北｜岸で見物する事にしたが、待つて居るのに丁度程よい場所がない。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分等はまたルウヴル宮の橋の袂の人込に交つて空を仰いで居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウヴル宮の大きいのとオペラの図抜けた屋根とが何時も乍ら磁石の役をして自分などにも彼処此処が何の所在と云ふ事が点頭かれるのである。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里のルウヴル宮やリユクサンブルの美術館のやうな所があつたら半年でも得られる知識を、木下さんは東京と奈良と京都とで恐らく十年も費して居られるであらう。",
              "citation": {
                "source": "隣の家",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄暮ルウヴル宮の正面も、中庭にある桃色の凱旋門もやはらかに紫がかつて暮れてゆく。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウヴルの美術館でリユブラン夫人の描いた自畫像の前に立つても其抱いて居る娘が、自分の六歳になる娘の七瀬に似て居るので思はず目が潤む。",
              "citation": {
                "source": "巴里にて",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本服を少しく變へて作つたロオヴは、グラン・ブル※アルの「サダヤツコ」と云ふ名の店や、巴里の三越と云つてよい大きなマガザンのルウヴルの三階などに陳べられて居るので、然まで珍しくも無いであらうが、白足袋を穿いて草履で歩く足附が野蠻に見えるらしい。",
              "citation": {
                "source": "巴里にて",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウヴルの博物館にある伊太利の繪と彫刻とを見た丈でも自分は然う云ふ事が想像される。",
              "citation": {
                "source": "巴里の旅窓より",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分等はそれからルウヴル行の市街電車に乘つた。",
              "citation": {
                "source": "巴里の獨立祭",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯この蒸暑い日に其處ではどんなに涼しさが得られるか知れないと云ふ氣がしたのと、ルウヴルが終點であるから降りるのに心配がないと思ふからでもあつた。",
              "citation": {
                "source": "巴里の獨立祭",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分等はルウヴル宮の横の橋を渡つて北岸で見物する事にしたが、待つて居るのに丁度程よい場所がない。",
              "citation": {
                "source": "巴里の獨立祭",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには幸ひルュニェ・ボオのメエゾン・ド・ルウヴル（創作の家）がある。",
              "citation": {
                "source": "巴里で観たイプセン劇",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうすつかり病氣の重くなつてゐたベルゴットが或る日ルウヴルに和蘭派のフェルメエルの繪を見に出かける。",
              "citation": {
                "source": "（きのふプルウストの……）",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
