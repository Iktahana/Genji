          "literary": [
            {
              "text": "ユルリユルリと鉄の管壁を攀じのぼっていった。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ルリユ爺さん」の舞台が、装置衣裳を含めて、恐らく、新劇中の新劇であつたことも注意すべきである。",
              "citation": {
                "source": "翻訳劇と翻案劇",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じく築地座で、近頃、評判のよかつた演し物は、里見、久保田両氏のものをはじめ、例へば、二十六番館、おふくろ、晩秋、赭毛、南の風、ルリユ爺さん、等何れも、上演に際し、従来の新劇に見られない苦心と注意を、「白」の上に払つた結果である、と僕は信じてゐる。",
              "citation": {
                "source": "演劇本質論の整理",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
