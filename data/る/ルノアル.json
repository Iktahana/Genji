        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それかと言ってルノアルふうの風景小品にもルノアルの甘みは出ていない。",
              "citation": {
                "source": "昭和二年の二科会と美術院",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時までに見た中村氏の絵を頭においていた自分は、話のついでに「ルノアルがお好きですか」と聞いてみた。",
              "citation": {
                "source": "中村彝氏の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたら、「ルノアルも好きだが、レンブラントが一番面白いようです」と言われたようであった。",
              "citation": {
                "source": "中村彝氏の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人の絵は、どこかしらルノアルとモネエと両方を想い出させるようなところのある絵だと思う。",
              "citation": {
                "source": "二科会展覧会雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルノアルなどは、ちょっと見ると気楽に描いているようだが、また恐ろしく神経を使っているようにも思われるのだが、横井氏のはそれともちがう。",
              "citation": {
                "source": "二科会展覧会雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京の医者の子であったが、若い頃フランスに渡り、ルノアルという巨匠に師事して洋画を学び、帰朝して日本の画壇に於いて、かなりの地位を得る事が出来た。",
              "citation": {
                "source": "花火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいドレスが手にはいったものですから、ひとつ、ルノアルのリイズのようなポオズをさせてみたいと思っているのです。",
              "citation": {
                "source": "リイズ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれはね、ルノアルの二十七八歳頃の傑作なのですよ。",
              "citation": {
                "source": "リイズ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルノアル自身のエポックを劃したとも言われているんです。",
              "citation": {
                "source": "リイズ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕だって、もう二十八歳ですからね、ひとつ、ルノアルと戦ってみようと思っているんですよ。",
              "citation": {
                "source": "リイズ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正十三年二月、渋柿）　　　　　　　＊　ルノアルの絵の好きな男がいた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その女は、他人の眼からは、どうにも美人とは思われないような女であったが、どこかしら、ルノアルの描くあるタイプの女に似たところはあったのだそうである。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "俳句をやらない人には、到底解することのできない自然界や人間界の美しさがあるであろうと思うが、このことと、このルノアルの女の話とは少し関係があるように思われる。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「猿蓑」や「炭俵」がナンセンスであり、セザンヌやルノアルの絵がナンセンスであり、ドビュシーやラベールの音楽がナンセンスであると同じような意味において立派なナンセンス芸術であるように思われる。",
              "citation": {
                "source": "映画雑感（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "マネ、モネ、ピサロ、ルノアル、ドガ、シスレー、ギョーマン、バジールなどが集って、印象派の運動がおこっていた。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルノアルの描く少年のようなアンゲネームな香気がまわりにふりまかれた。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カニューは、ルノアルの別荘のある美しい村である。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "セザンヌやルノアルの風景の半分はオリーブの色調で満たされているといっていいかも知れない。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば研究所でまだ石膏の首の調子さえ描き得ないにかかわらず、ルノアル翁晩年の作を直ちに模そうと考え、あるいは直ちにピカソの立体をモデルに当てはめようと考える。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ピカソやドランやルノアルが、如何に写実がうまいか、如何に写実で苦しんだかという事を考えまいとする傾向のあるものである。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルノアルの描く女性は何と愛らしいだろう。",
              "citation": {
                "source": "わからないこと",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ルノアルの言葉」や Histoire de l'art の中の画などを見、自分が絵画を見ることでどれ丈、益されて居るかと思う。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁にはルノアルやセザンヌの複製などもかかっている。",
              "citation": {
                "source": "或恋愛小説",
                "author": "――或は「恋愛は至上なり」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "少くとも水水しい耳隠しのかげに薄赤い頬を光らせた少女の銀座通りを歩み出したのは確かにルノアルの生まれた後、――つひ近頃の出来事である。",
              "citation": {
                "source": "僻見",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "美術院の展覧会に出た二枚のルノアルはいづれもこのゴオガンに勝つてゐる。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルノアルは、――少くとも僕の見たルノアルはかう云ふ点ではゴオガンよりも古典的作家に近いのかも知れない。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、いつか優美を極めたルノアルに興味を感じ出した。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に又ルノアルを軽蔑する当時の愛好者の傾向につむじを曲げたこともない訣ではなかつた。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
