        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ルイーズさんをあづまやに立たせるんですつて。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "房子　　あなたはさうおつしやるけれど……此の時、ルイーズ、大声にて笑ひながら走り来る。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　だつて、きりがないんですもの。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（笑ふ）ルイーズ　　（留雄の方を見て）まだ鯉と遊んでるの、あの方。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　あしたから見ていらつしやい。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　あしたから白川さんにポーズして頂くの。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　いいえ、さうぢやないの。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズさんが来て下すつてよかつた。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ルイーズも去らうとするのを止めて）いいえ、あなたはどうぞそのまま。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　（遠ざかりながら、房子に）あなた、いらつしやいよ。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（先に立つて歩き出す）ルイーズ　　あたし、喉がかわいた。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一場ルイーズのアトリエ。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　かまはないわ。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　何んとでもおつしやい。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　なんですつて。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　モデルは理窟を云はないのね。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　（筆を止めずに）それがどうしたの。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　（筆を止めて）愛するつて、どんなに。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　（絵具を溶きながら）それならば、あなた、何処人だからと云ふ問題ぢやなくなるわ。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　さあ、それはどうですかね。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　西洋の男が日本の女に惹きつけられる理由は、男として、そんなに名誉にならないつて或る人が云つてますね。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　日本の男が西洋の女を好かない理由。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　（笑ひながら）まあ、さうでせうね。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　好きらしくないわね。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　駄目よ。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　あたしは、さうは思はないわ。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　厚ぼつたくつて寒いよりは、軽いだけましだわ。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　長く着てゐられないから同じよ。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "）ルイーズ　　然し、西洋の女が日本の男と結婚するのは考へものね。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイーズ　　ある人の書いた本に、それもなかなか日本をよく見てゐる人なのよ、その本にね、西洋に来てゐる日本の青年はみんな行儀がよくつて、物わかりが早く、控へ目で、親切で、辛抱強い。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
