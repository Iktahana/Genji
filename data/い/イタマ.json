        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "淋しい田舎の古い家の台所の板間で、袖無を着て寒竹の子の皮をむいているかと思うと、その次には遠い西国のある学校の前の菓子屋の二階で、同郷の学友と人生を論じている。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピアノが台の下の小滑車で少しばかり歩き出しており、花瓶台の上の花瓶が板間にころがり落ちたのが不思議に砕けないでちゃんとしていた。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この道場というは四｜間と五間の板間で、その以前豊吉も小学校から帰り路、この家の少年を餓鬼大将として荒れ回ったところである。",
              "citation": {
                "source": "河霧",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして黒光りのする台所の板間で、薄暗い石油ランプの燈下で一つ一つ皮を剥いでいる。",
              "citation": {
                "source": "郷土的味覚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく風が通るから」　と言って、小君は板間に上敷をひろげて寝た。",
              "citation": {
                "source": "源氏物語",
                "author": "空蝉",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の端に入るまで月をながめ見ん閨の板間もしるしありやと　こんな返しを伝えさせている時、この家の大尼君が、さっきから笛の音を聞いていて、心の惹かれるままに出て来た。",
              "citation": {
                "source": "源氏物語",
                "author": "手習",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋も段々に末になって伝馬町の牢屋でも板間の下で※が鳴いた。",
              "citation": {
                "source": "黄八丈の小袖",
                "author": "岡本椅堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "応接間の入口は低い板間で、突当りの高い所に蒲団が敷いてある。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "板間ではあるが無論靴で出入をする。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯槽の方はこれぐらいにして板間を見渡すと、いるわいるわ絵にもならないアダムがずらりと並んで各勝手次第な姿勢で、勝手次第なところを洗っている。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も一寸々々一緒に行かぬではなかつたが、怎してか大抵一人先に歸つて來るので、父の仕事場にしてある店先の板間に、竹屑やら鉋屑の中に腹匍になつては、汗を流しながら讀本を復習たり、手習をしたりしたものだ。",
              "citation": {
                "source": "二筋の血",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も一寸々々一緒に行かぬではなかつたが、怎してか大抵一人先に帰つて来るので、父の仕事場にしてある店先の板間に、竹屑やら鉋屑の中に腹匍になつては、汗を流しながら読本を復習たり、手習をしたりしたものだ。",
              "citation": {
                "source": "二筋の血",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｆが来るといふので特にその時はあらゆる数々を批瀝して、蔵前の板間を打ち払つて飾りたてたのである。",
              "citation": {
                "source": "熱い風",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "広い板間、立て働くように出来た流許、それからいかにも新世帯らしい粗末な道具しかお雪の目に入らなかった。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "踊のひときりがまだついてゐなかつたので三人は光つた広い板間の控へに坐つて次のを待つた。",
              "citation": {
                "source": "父",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁のない堂内の、透けた閑寂さの中に立った柱の細みも、背後の森の青さに射し洗われ板間に映るように美しかった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と姉は云ふと、花道の尽きた明るい処まで出て下駄場の方へ拡つた板間へ三重子を下ろして遊ばせた。",
              "citation": {
                "source": "悲しめる顔",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とお光は言つたが、平三はそれを聞かぬものの如く黙つて、如何にも鹿爪らしく母の立つて居る前の上り段の板間に横向に坐つて丁寧に頭を下げ、「帰りました、御機嫌｜能う。",
              "citation": {
                "source": "厄年",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とお光は広間の板間に薄縁を敷きながら、仏壇に拝して仏間から出て来た平三に言つた。",
              "citation": {
                "source": "厄年",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "余が不思議そうにしていたので、女は室の外の板間に出て、其処の中障子を明けて見せた。",
              "citation": {
                "source": "くだもの",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、この時、梯子段下の板間で一時に起る物音、人声。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "三つの足跡",
                "note": "青空文庫"
              }
            },
            {
              "text": "上は板間合はず、四壁はあばらに、雪降り積りて消ゆる事なし。",
              "citation": {
                "source": "学生と先哲",
                "author": "――予言僧日蓮――",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄暗い楽屋の板間で突然アルマンの手に縋る男がある。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "上半身をズーッと下げて、下の板間に敷いた紙にサラサラサラサラ音を立てながら素早い手付きで髪を梳いて居る姿、湯上りの輝いた顔を涼風に吹かせて凝り固った様にして居る様子等は、皆重三に自分とはまるで異った美くしいものだと思わせた。",
              "citation": {
                "source": "お久美さんと其の周囲",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "次いで、すゞやかな聲が、それに受けこたへて、物音も立てずに、板間をわたつて行つた。",
              "citation": {
                "source": "死者の書　續篇（草稿）",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関の板間に晨は伏目に首を振りながら微笑んで立つて居た。",
              "citation": {
                "source": "帰つてから",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "菅原や　むねの板間の　あはぬ限りは」は、古代にある野焼き歌の類型が、象徴的に感じられる所から、神祇の御作と言ふことになつた訣であらう。",
              "citation": {
                "source": "副詞表情の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "八畳半・六畳・四畳半に板間と言ふのだから、決して広くはないが、家族の少かつた移住当時は、さして手狭にも感じなかつたらうし、新しく建てた家なり、大工も名誉の者だつたと言ふから、さのみ陋屋と言ふでもなかつたであらう。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "糟谷は役所着のままで東京へいくつもりであるから、洋服をぬごうともせず、子どもを抱いたまま老人と対座した。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "こまかき雨ははら／＼と音して草村がくれ鳴こほろぎのふしをも乱さず、風｜一しきり颯と降くるは、あの葉にばかり懸るかといたまし。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
