        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夫ガ病人ニナッテシマッタノダカラ残念デタマラナイノダガ、君ノ手紙ヲ見テ西洋ヘ往タヨウナ気ニナッテ愉快デタマラヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "イッタイ予ニハ Pederasty ノ趣味ハナイノダガ、最近不思議ニ歌舞伎俳優ノ若イ女形ニ性的魅力ヲ感ズルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジ辻堂ノ中デ五六丁離レタ所ニオ誂エ向キノ家屋ガ一軒売リ物ニ出タノデ、何トカシテソレヲ買イタイノダガ、ソレニハ金ガ二三百萬足リナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿道ノ故障ハ今朝ハ一応良クナッタノデ、行ッテ行カレナイコトハナイノダガ、夜ノ外出ナド飛ンデモアリマセント云ッテ、佐々木ガ承知シナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前ニモ度々コンナツメタサノ経験ヲシタコトガアルガ、ソシテ大体真冬ノ寒中ニソウナルコトガ多イノダガ、必ズシモ冬トハ限ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハオ爺チャンノ墓地捜シノオ供ヲシテモ詰マラナイカラ、アタシハ御免蒙リタイ、コレカラ四条通リヘ出カケテ「キリハタ」ヤ高島屋デ買物ヲシ、午後ハ高雄方面ヘ紅葉見物ニ行キタイノダガ一人ボッチデハ仕様ガナイ、誰カ案内ヲシテクレナイカシラト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長崎人ノ木村モハナイノダガ、今日ハ始メカラ晩ノ食事ヲトモニスル底意ガアッタノデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
