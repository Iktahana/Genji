  {
    "uuid": "6470d21a-8c5d-528e-9767-3a442d517709",
    "entry": "色取り",
    "reading": {
      "primary": "いろどり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
