          "standard": [],
          "literary": [
            {
              "text": "大陸を移遷する間にどこでも理解せられなかった心持ちが、日本に来たって初めて心からな同感を見いだしたというようなことも、ないとは限らない。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
