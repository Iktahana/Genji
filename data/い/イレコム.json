    "definitions": [
      {
        "index": 1,
        "gloss": "to push into",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古いカメラのフィルムを現像に出すために、慎重に本体に「入れ込んだ」。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供がおもちゃのブロックを、決まった形の穴に「入れ込もう」と頑張っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "郵便ポストに請求書の書類を「入れ込んだ」。これで支払い手続きは完了だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "さらに入れ込むうちに、首まで泥まみれになっている日本語処理のクソッタレ仕事をマシンに預けられるのではないかと期待し始めた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "パーソナルコンピューターに入れ込めば入れ込むほど、タイプライターを真似た現在のマシンの在り方が骨身に染み付いて、これ以外の可能性が見えなくなるということだろう。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "伽話にある「舌切雀」の葛籠にいかなるものが潜在してあるかは、もらう人の与かるところでないようなものの、その根本を質せばもらう人が入れ込むのである。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国人は袖口へハンケチを丸めて入れ込む風あり。",
              "citation": {
                "source": "洋服論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまで幾つかの例において、牛痘を経過した人たちの腕に人痘試料を入れ込む前に、試料の状態について私の行った注意を述べた。",
              "citation": {
                "source": "イングランドの西部の諸州とくにグルスターシャーで見つかった病気で、牛痘の名で知られているウシ天然痘の原因および効果についての研究",
                "author": "AN INQUIRY INTO THE CAUSES AND EFFECTS OF THE VARIOLAE VACCINAE, A DISEASE DISCOVERED IN SOME OF THE WESTERN COUNTIES OF ENGLAND, PARTICULARLY GLOUCESTERSHIRE, AND KNOWN BY THE NAME OF THE COW POX.",
                "note": "青空文庫"
              }
            },
            {
              "text": "藁草履を引摺って、勢の無さは埃も得立てず、地の底に滅入込むようにして、正面から辿って来て、ここへ休もうとしたらしかったが、目ももう疎くて、近寄るまで、心着かなんだろう。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて黒羽町に入込むと、なるほど、遊廓と背中合せに、木賃宿に毛の生えたような宿屋が一軒、簷先には△△屋と記してある。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "これあらば赤城家へ入込むに便あり造化至造妙と莞爾と頷き、袂に納めて後をも見ず比企が谷の森を過ぎ、大町通って小町を越し、坐禅川を打渡って――急ぎ候ほどに、雪の下にぞ着きにける。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――こんなのが、此の頃、のさ／＼と都へ入込む。",
              "citation": {
                "source": "一席話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "書斎に籠っていても春は分明に人の心の扉を排いて入込むほどになった。",
              "citation": {
                "source": "野道",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、ほんとうの戦地まで入込むことを許可されないので、大抵は朝鮮か大連あたりから引返して来たらしいが、いずれもそれを売り物にして花々しく開演したが、どこでも日清戦争当時ほどの好成績を挙げ得られなかったようである。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」麺麭９・16（夕）　地中海へ日本の艦隊が出征するにつけて、西伯利の奥深く日本の陸軍が入込むにつけて、何よりも困るのは日本人に附き物の食糧品の輸送である。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソッと入込む息抜き場所に。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前が言う通り、桜井がこの節は毎日のように乃公の留守を附狙って入込むという証拠には、どうだ二人で出逢をしているところを乃公に見せてはくれまいか。",
              "citation": {
                "source": "旧主人",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、元より兄や姉に聞くことも、はばかられ、また聞いて見たところで、京阪地方の人達が入込む、温泉の旅館町では、判りそうにも思われなかった。",
              "citation": {
                "source": "仙人掌の花",
                "author": "山本禾太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "神と人との共同と交渉との任に當る象徴は徹底的であり、表現の入込むべき空隙を殘さない。",
              "citation": {
                "source": "時と永遠",
                "author": "波多野精一",
                "note": "青空文庫"
              }
            },
            {
              "text": "粗生生産物がその価格の主要部分として入込むすべての貨物は下落するであろう。",
              "citation": {
                "source": "経済学及び課税の諸原理",
                "author": "PRINCIPLES OF POLITICAL ECONOMY AND TAXATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "火事場泥棒の如きかかる輩は芸者を口説くにも容貌や芸なぞは二の次にして金まはりのよささうな女にねらひをつけ、年上であらうと何であらうと構はず、此方からちやほやと機嫌を取つて入込むが常なり。",
              "citation": {
                "source": "桑中喜語",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "お雪は毎夜路地へ入込む数知れぬ男に応接する身でありながら、どういう訳で初めてわたくしと逢った日の事を忘れずにいるのか、それがわたくしには有り得べからざる事のように考えられた。",
              "citation": {
                "source": "※東綺譚",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もスバリ、赤沢共に、信州細野入より黒部山へ入込む向寄の箇所とは受け取れぬ、細野入からは反て五竜、唐松、白馬の方へ入込むのが順であるが、当時細野入から黒部山へ入込む者があるという風聞があったので、見廻りの役人は唯だ風聞の儘そう書いたものと大ざっぱに解釈してよかろうと思う。",
              "citation": {
                "source": "後立山は鹿島槍ヶ岳に非ざる乎",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは知らなかった、――外の事なら知らん顔もするが、『疾風』がこの辺へ入込むようじゃ放っちゃおけねえ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "八人芸の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "手っ取り早く言えば、小永井家に入込む工夫も何もつかぬうち、肝腎の生き証拠の老女加世は死体になってしまったのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "殺され半蔵",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to be enthusiastic (about)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
