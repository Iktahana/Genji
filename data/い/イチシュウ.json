        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "殿川屋敷と言ふのは、壱州での豪家のあつた処である。",
              "citation": {
                "source": "河童の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々、首を擡げて見やると、壱州らしい海神の頭飾の島が、段々｜寄生貝になり、鵜の鳥になりして、やつと其国らしい姿に整うて来た。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "出稼ぎに来て、近海で獲つた魚類は、皆壱州の三つ浦――郷野浦・勝本と此蘆辺――で捌いて、金に換へる。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "此金白礁といふ岩は、壱州の廻りに幾つもある。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "其先ぶれが、あの少年となり、蘆辺浦の風景となり、東京戻りの壱州人とのとり違へとなり、此中婆さんとなつて、私の心に来てゐるのだ、と言ふ気がして、此港の町の狭い家並みに、見る物すべてに憑しい心が湧いた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "壱州の先覚者の中には、こんな伝へを材料にして、応神天皇壱岐誕生説を組み立てよう、とさへした人がある。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "壱州の民は、対岸の九国・中国から来た者の末が多い事は知れる。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "壱州に行はれた後世の占ひは、陰陽師配下の唱門師等の伝へたものであつた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "海部なども、二部落あるが、片方の八幡蜑と言ふのは、極の近代移住したものらしく、壱州東海岸一帯の海の外潜くことは免されて居なかつた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡良の小崎蜑と言ふのは、筑前志賀島から来たと言ふ伝へがあつて、壱州を囲む海全体に権利を持つてゐた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "壱州の民は、わりの班田を受ける事の出来るのと出来ないのとの二種の群居に分れてゐた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "壱州では、町方町人でない村方百姓の中、浦に沿ふ村では、わりを受けながら、漁業をも兼ねてゐた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "かと思ふと、東岸の村には、又神が入れ替つて、同様な話が伝はり、其一里と隔らぬ西の村には、神が歴史上の人物ではなく、家の祖先に替つて、壱州移住第一夜の事実を、今もとり行ふのだ、と言うてゐる。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "処が、壱州に来た陰陽師の徒は、みさきを傭ふのに、簡単な方便があつた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は、もっぱら壱州において聞き込みたる迷信を述ぶるつもりである。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "壱州の民家には、必ず神棚と仏壇と荒神とを設けておく。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "壱州には狐がおらぬから、狐つきはないわけだ。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "筑山・壱州に応接して、午後四時、長崎に入港す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリは壱州のフレと同じ語であることは疑いあるまい。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "釜山なども對州の人が眞先に行つてそれから壹州の人間が行つて開いた相だ。",
              "citation": {
                "source": "對州嚴原港にて",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "對州も一寸覗いただけでもう壹州へ渡るのだ、仕方が無い。",
              "citation": {
                "source": "對州嚴原港にて",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "壹州と言つて一國だが北の勝本から南の郷の浦まで僅に四里、馬車は八臺あるが人力車は郷の浦に四臺きりださうだ。",
              "citation": {
                "source": "壹岐國勝本にて",
                "author": "長塚節",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
