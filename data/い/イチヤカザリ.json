        "examples": {
          "standard": [
            {
              "text": "正月の一夜飾りは松や竹を玄関に立てる伝統だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大晦日の夜に一夜飾りを準備して、新年を迎える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "昔は一夜飾りを急いで用意する家庭が多かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "さればいずれの歳の市にも、ダラダラの大晦日まで続いたところが、門松だけは二十九日までに遅くとも立ててしまい、一夜飾りはせぬものと老人の注意を、誰しも正直に守って疑わず、どういうわけと念を押すなぞは決しておくびにも出さない。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
