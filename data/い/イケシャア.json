          "literary": [
            {
              "text": "イケシャアシャアとしたお嬢さんだ。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "イケシャアシャアとしていられちゃア。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "イケシャア／＼と、世間なみの仁義も知らない奴らじゃないか」　ゴリラもサルトルも返事がない。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "痛くもカユくもないという生涯ムザンの酷薄なるものに、ジッとこらえていられるのは、拙者、つまり蛙、イケシャアシャアね。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、いかに自分だけはキショクが良くても、今日この事をよしとしていて、明日それと真反対のあの事をよしとして、イケシャアシャアとしている権利は無い。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
