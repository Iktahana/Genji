        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「マダ何カ喰ッテモイヽナ」「冗談ジャナイ、ソレデ足リナインデスカ」「足リナイコトハナインダガ、コヽヘ来ルト関西ノモノガ恋シクナルンダ」「グジノ一ト塩ガアリマスゼ」ト浄吉ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マア考エテオクコトニシヨウ」「今日御返事ガイタヾケナインデスカ」「コノトコロイロ／＼ト出銭ガ多クッテネ」ブツ／＼云イナガラ二人ハ出テ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャン、マダオ休ミニナラナインデスカ」「今寝ルトコロダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今オ気持ガオ悪イヨウナコトハゴザイマセンカ」「気持ハドウモアリマセンガネ、血壓ガ高インデスカ」「二百ホドゴザイマス」彼女ガコンナ風ニ云ウ時ハ大概二百以上ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佛印アタリハ宝石ノ値ガ安インデスカラ、佛印デ二百萬圓ダッタラ日本ヘ持ッテ来レバ倍以上ニナルデショウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラコリーハ止メルヨウニオ爺チャンカラ仰ッシャッテヨ、アタシモソレトナク云ウンダケレド、アタシガ云ッタンジャ颯子ハ聴イテクレナインデスカラト、婆サンハ訴エルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヘー、颯子ガ伺ッテハ悪インデスカ」「颯子バカリジャナイ、陸子ナンゾ見舞ニ来ヤガッタラ承知シナイゾ」「ソリャ分ッテマスヨ、イクラ痛イト仰ッシャッテモ手ノコトダカラ心配ハナイ、オ前サンハ遠慮シナサイッテ、コナイダモ陸子ヲ追イ返シタンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ時、僕ハ本気デ注射ヲスルノガ馬鹿気テイルノデ、カンフルヲ射ス真似ヲシテ、ヴィタミンヲ射シテヤル※ニシテイルノダガ、木村ガ気ガ付イテ、「先生、コレデイインデスカ」ト小声デ聞イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
