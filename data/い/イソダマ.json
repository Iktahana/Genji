        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この巻貝を漁夫はイソダマと呼んでいた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺もお裾分けで（――なんて言うと、塩漬け死体が思い出される）そのイソダマを食ってみたが、なかなかうまかった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "このイソダマみたいに艱難辛苦して、あげくの果てに簡単にバラされるなんてのは、いやだねえ。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "イソダマを岩から俺はむしり取って、海のなかに放り投げた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "イソダマみたいにチャイチイ（小さな）志奈子が一心に砂浜を駈けてくる。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
