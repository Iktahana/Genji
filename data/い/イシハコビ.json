          "literary": [
            {
              "text": "石運びだの、大工だの、屋根葺などの住む狭くて汚い裏町を、山伏は、布施を乞うて軒から軒へとあるいて行った。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "きさまらに思いやりがあるなら、人夫に手伝って、思いやりを見せてやれ」　と、終日、土かつぎや石運びにこき使って、たそがれ、追ッ放して帰したという。",
              "citation": {
                "source": "私本太平記",
                "author": "黒白帖",
                "note": "青空文庫"
              }
            }
