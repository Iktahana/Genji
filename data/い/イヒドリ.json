        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "兼次の家でも茶の葉が強くなつて、もう一日捨てゝおいたらとてもよりつからぬといふので隣近所と「イヒドリ」をして兎にも角にも一日に摘みあげる手筈をした。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヒドリ」といふのは手間の交換でそつちからこつちへ一日仕事に來ればこつちからも一日仕事に行くことである。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            }
          ]
        }
