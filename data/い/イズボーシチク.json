        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "米川さん、メーエルホリドへ行きがけに、イズボーシチク〔辻馬車〕、タクシと衝突した。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "イズボーシチクにのって、パッサージでＹもう二枚シーツを買って、ステーションへ来たのが二時少し前。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "イズボーシチクなくて、自分停車場まで歩いた。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "メーターない taxi ばかり故イズボーシチクにのってノアイユ〔ホテルの名〕へ行く。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "イズボーシチクの若者コーリャ赤衛兵がのって、小銭にかえてくれるというのをしきりにまってるが来ない。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
