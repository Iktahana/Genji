[
  {
    "uuid": "b31ff3c1-23d2-57e0-9da4-ff1c9a2a794f",
    "entry": "至り",
    "reading": {
      "primary": "いたり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
