          "literary": [
            {
              "text": "颯子ノ方モ二人キリダト変ニ言葉ガゾンザイニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンハドウオ思イニナル？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワア、ワア、ワア」気ガ狂ッタラ狂ッタデイヽ、モウドウナッタッテ構ウモンカ、予ハソウ思ッタガ、困ッタコトニ、ソウ思ッタ瞬間ニ急ニハット自省心ガ湧キ、気狂イニナルノガ恐クナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「気狂イノ真似ナンカシテルト今ニホントノ気狂イニナルワヨ」予ノ耳元ヘ口ヲ寄セテ、ヘンニ落チツイタ、冷笑ヲ含ンダ低イ声デ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『キミ、ニゲル、ハイニナル。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミハ、ハイニナルノガ、コワクナイノカ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
