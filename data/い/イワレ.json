  {
    "uuid": "2366dcfb-41c0-5dcc-ac70-a65ca1451888",
    "entry": "イワレ",
    "reading": {
      "primary": "いわれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アノイワレハ可愛ラシイモノデス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根は苔でおおわれていて、黄色い花やイワレンゲが咲いています。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コウイウ国ガラデアツテミレバ、タマタマ私ガ少シクライ畠チガイノコトニ口出シヲシタトコロデメツタニ苦情ヲイワレル筋合イハナイハズデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ果シテソレガ雑音ナドトイワレルニ十分ナ屑電波ダトスルコトハ早計ニ過ギルト思ワレル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "深イ注意ヲモッテカカル人間ニ対シ適当ナ電波的保護ヲ急グノデナケレバ、世ノ中ニハ「手ニオエナイ神経病者」トイワレルモノガ年ト共ニ激増スルデアロウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉体を拒否するイワレは何もない。",
              "citation": {
                "source": "三十歳",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、そういう風に言ってみないと、生きているイワレがないみたいだから、そんな風に言ってみるので、私は屋根裏で小説を書くとき、人によまれて、オモチャになればよいとすらも、考えていなかった。",
              "citation": {
                "source": "私は誰？",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "念和尚は俗名相馬四郎義元と云い、奥州相馬の棟梁だったというから、この巻物を伝えるような何かのイワレがあるのかも知れない。",
              "citation": {
                "source": "安吾武者修業",
                "author": "馬庭念流訪問記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのイワレは、キティ颱風を無事通過した窓が満月の突風ぐらいでヒックリ返る筈がないということだ。",
              "citation": {
                "source": "安吾巷談",
                "author": "湯の町エレジー",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が精神病院へ入院したとき小林秀雄が鮒佐の佃煮なんかをブラ下げて見舞いにきてくれたが、小林が私を見舞ってくれるようなイワレ、インネンは毛頭ないのである。",
              "citation": {
                "source": "安吾巷談",
                "author": "熱海復興",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が二百万だしますから、岩矢天狗に、札束叩きつけてやってよ」「あなたから、お金をもらうイワレはありませんよ」「イワレはなくったって、お金が払えなかったら、どうするのよ」「なんとかします。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私からお金をもらうイワレがないって云うけど、私と結婚しましょうよ」　大鹿はビックリして目をあげた。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのイワレは車の中で説明するよ。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "三時間待って、熱海へついたら、帰られる記代子さんとすれちがったのです」　こだわるイワレがあろうとは思われないから、放二は思った通りのことを言った。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽いイワレがあってのことだ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "放二の給料は年齢のわりに多かったし、長平から貰う手当もあるので、靴や靴下が買えないほど窮迫するイワレがなかった。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたとぼくのオツキアイの上で、ぼくの一存で、あなたの生死が左右できるようなイワレがあったでしょうか。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "かりにも一人の生死にかかわることであれば、ぼくも責任をもちたいとは思いますが、イワレなく責任をもつわけにはいきません。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
