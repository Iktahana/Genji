        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "チームメンバーの雰囲気が良く、毎日オフィスに行くのが居心地の良い時間になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "旅行先のホテルは豪華さよりも、清潔で居心地の良い空間を重視して選ぶことが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "猫が膝の上で丸くなっていると、不思議と心が落ち着いて居心地の良い気持ちになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "残念ですが、トリガーセンは見つかりませんでしたと言わざるを得ません」　モード嬢が居心地の良い隅っこから見上げ、そこでジュリアン医師といい仲になっていた。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも居心地の良いのはここではないか、という彼の予測は的中した。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "直線ではなく、妙に湾曲していたり段がついたりした、居心地の良いカウンターだ。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "南に面してて、外にはバルコニーがあって、なかなか快適ですよ」　後藤の言うとおり、八畳ほどの広さの、居心地の良い明るい部屋だった。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「居心地の良い部屋ですね」　椅子にすわったまま日比谷は言った。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "居心地の良い店の奥へいき、ヨシオは店員がイアリングの箱を包んでくれるのを待った。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな居心地の良い邸宅からすんなり出て行けない。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "いごこちのいい部屋があるんだ。",
              "citation": {
                "source": "夜光人間",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "見まわすと、なかなか、いごこちのいい部屋です。",
              "citation": {
                "source": "仮面の恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
