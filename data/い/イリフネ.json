    "definitions": [
      {
        "index": 1,
        "gloss": "incoming ship",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "港に近づく入り船の汽笛が聞こえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "新しい乗客を乗せた入り船が、ゆっくりと桟橋に接岸した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "港に入り船が次々と到着する朝の風景は活気に満ちている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "出船入り船帆影も繁き石の巻からそのお城下までへは、陸前浜街道を一本道に原ノ町口へ抜けて丁度十三里――まさかと思ったのに、およそ退屈男程気まぐれな風来坊も稀でした。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩竈の町は遠い昔から色の港で、出船入り船を迎うる女郎山の古い名が今も残っている。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで秀吉は、行長の艦隊に命じて湖水に入り船から城を攻撃させたのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "寫すのは弟がやつてくれることにして、二人で行つてみると、いりふねばしのまん中でもう途方にくれてしまつた。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "「入舟町へかえります。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」入舟町の露路、髪結さんの二階の一室を、さちよは借りていた。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その橋を越せば、入舟町である。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「入舟町へかへります。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」入舟町の露路、髪結さんの二階の一室を、さちよは借りてゐた。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "入舟町の方から渡って行く中ノ橋あたりは、まだ朝濛靄が深く、人通りも少かった。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝の入舟町だそうですよ」「じゃ、ぞうさはねえ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "笛の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "涼みがてらに、くくっちまおうよ」　実際、もうぞうさはあるまいと思われたものでしたから、いううちに右門は立ち上がったもので――荒い弁慶じまの越後上布に、雪駄へ華奢な素足をのせながら、どうみてもいきな旗本のお次男坊というようないでたちで、ほんとうにぶらりぶらりと涼みがてらに入舟町さしてやって参りました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "笛の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝入舟町｜甚七店　束巻師　源五兵衛　　　　謹上　墨痕あざやかに書かれてあったのは、右のような不思議きわまりない幾文字かでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "何を訴えた訴状であるか、直訴の的はどこにあるか、なぞを解くならまず第一番に訴人が住まいの入舟町へはせつけて、そこから先に手を染めるのが事の順序であろうと思われたのに、奇怪にも目ざした道はまがうかたなく数寄屋橋のあのお番所なのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝入舟町｜甚七店束巻き師源五兵衛と所名まえがはっきりけえてあるんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "てっとりばやく入舟町へいって洗いたてりゃ、たちまちぱんぱんとらちがあくじゃねえんですか！",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月二十一日願い主　芝入舟町甚七店束巻き師　源五兵衛家出人お係りさま御中　というのが一通。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月二十二日願い主　芝入舟町甚七店束巻き師　源五兵衛家出人お係りさま御中　というのが一通。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月二十三日願い主　芝入舟町甚七店束巻き師　源五兵衛家出人お係りさま御中　というのがその第三通めでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちが旅から帰ると入舟と言って、お酒をつけて晩餐をし、祖母や、母や、姉や、親戚の伯母や、従姉たちも集まって、私たちの旅の話を聴くのであった。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠州朝日奈村の地主で、造り酒屋の長男でしたが、青雲の志を抱いて明治十四年、二十八才の時、私のお母さん登波と一緒に上京し、芝の入舟町に五ツ間ばかりのお家を百円で買って住み、明治大学の前身、明治法律学校で法律を勉強して公証人になったのでした。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "一帯清流曲幾回、千涯秋影入舟来、風光自与故山異、黄葉林間瓦壁堆。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "関東土木倶楽部の一方の旗頭、鶴見組野毛山の清吉の身内で入舟網之助というのがこの賭場を預っている。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間に顏の良い御用聞で、入舟町の佐太郎といふのが、丸屋の勇三を擧げてしまひました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "狼の牙",
                "note": "青空文庫"
              }
            },
            {
              "text": "本人に言はせると――妙に氣になることがあつて、もう一度下總屋へ行つて見ると、丁度お光が行方不知になつて大騷動して居るところだつたさうで」「その本人は何處に居るんだ」「入舟町の佐太郎親分が擧げて、昌平橋の辻番に預けてありますよ」「行つて見よう」　平次は四つ目から直ぐ昌平橋へ引返しました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "狼の牙",
                "note": "青空文庫"
              }
            },
            {
              "text": "其處には良い男のやくざ者｜轟三次が、腰繩をうたれて、入舟町の佐太郎に見張られて居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "狼の牙",
                "note": "青空文庫"
              }
            },
            {
              "text": "入舟などのあるたびに、恥も忘れて近よってくるのが常の習いであったらしい。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "築地入舟町八丁目、番地は一寸不明で御座いますが一番地ではなかつたかと思ふ位で御座います。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚入舟町の方は近所で澤山外國人の家があつた由。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋を渡る前と渡つたあとの二つの交番のどちらで聞いても、現在の入舟町には五丁目までで八丁目はないといふのである。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
