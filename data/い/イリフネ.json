[
  {
    "uuid": "d5ee6914-7239-57ce-9a4b-c9c782f9b8aa",
    "entry": "入り船",
    "reading": {
      "primary": "いりふね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
