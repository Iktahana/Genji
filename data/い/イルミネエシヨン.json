          "literary": [
            {
              "text": "黒猫がゆく、屋根の廂の日光のイルミネエシヨン。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "』男が丘の上へ登りきつて了ふと、今まで目にも見えなかつた沖の小舟が、黒胡麻のやうにチラ／＼、チラ／＼、遥かに一列綴られてゆく、千も万も、幽かに幽かに、――生活むきが立たねば、夜も遅くまで、泣いて烏賊つる、その舟の火の、やゝありて、イルミネエシヨン。",
              "citation": {
                "source": "畑の祭",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで太陽に仕掛けたイルミネエシヨンのやうなものさ。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
