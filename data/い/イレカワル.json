        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "来週のシフト、田中さんと入れ替わってもらうことは可能でしょうか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「今日の会議、都合が悪くて出られないんだ。誰か僕の席と入れ替わってくれる人いない？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "朝のラッシュアワーを避けるため、勤務時間を1時間早めて入れ替わることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
