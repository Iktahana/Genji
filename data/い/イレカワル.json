[
  {
    "uuid": "881abf97-947a-5659-9663-3127e219f586",
    "entry": "入れ替わる",
    "reading": {
      "primary": "いれかわる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
