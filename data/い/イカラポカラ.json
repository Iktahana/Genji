          "literary": [
            {
              "text": "もう一つの異名はイカラポカラという。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて仙台にいた時、早春郊外を散歩していたら、一緒に行った男の子が「これはイカラポカラという」と教えてくれた。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "長いトゲがやたらに出ているのが如何にもイカラポカラという感じで、面白いことをいうものだなと思った。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
