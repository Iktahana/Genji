          "literary": [
            {
              "text": "タケノコタチハ　トホクヘ　イキタガツテ　シヨウガ　ナイノデ、オカアサンノ　タケガ、「ソンナニ　トホクヘ　イツチヤ　イケナイヨ、ヤブノ　ソトニ　デルト　ウマノ　アシニ　フマレルカラ」ト　シカツテ　ヲリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしが子供のころ、イツチヤイツチヤ、イツチヤナ、とか唱へながら角力をした、女力者の見世ものがあつたが、どうして一三八〇年位も前の、この二女力士のすさまじさに競べやうもない。",
              "citation": {
                "source": "春宵戲語",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンウリノオヂイサン　モウ　ドコカヘイツチヤツテル。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            }
          ]
        }
