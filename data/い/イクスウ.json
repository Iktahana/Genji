        "examples": {
          "standard": [
            {
              "text": "養鶏場の鶏舎では、毎年多くの育雛が行われ、ひなが孵化している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "育雛に失敗すると、多くのひなを失うことになり、経営に大きな打撃を受ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "育雛の成功率を高めるために、温度管理と湿度管理が極めて重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "かつ去勢した雄鶏は母鶏の代用として能く雛鳥を親切に撫育するから外国では盛に育雛用にも使われる。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
