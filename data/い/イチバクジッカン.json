        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "一暴十寒では成果を上げることはできない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "継続的な努力を避けてはいけない、一暴十寒の愚を犯してはならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "学習は一暴十寒ではなく毎日の積み重ねが大事だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 2,
        "gloss": "strenuous efforts, unless sustained, are to no avail",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
