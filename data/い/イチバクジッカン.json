        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "一暴十寒に陥らないよう定期的に復習する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "一暴十寒では健康を保つことができない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "運動も一暴十寒では効果が出ないから継続が重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
