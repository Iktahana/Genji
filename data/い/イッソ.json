  {
    "uuid": "500d4495-1d60-5c02-9e37-cf43cad4488f",
    "entry": "イッソ",
    "reading": {
      "primary": "いっそ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そげな事あドウデモよかバッテン、イッソ死ぬなら俺へ形見ば遣らんか』　大惣は寝たまま天井をジイッと見した。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は仕方ナク床ニ戻ッタノデスガ、ドウ考エテモ余リニ無札ナ仕打デハアリ、私が今更ソンナ事ヲイエタワケデハナイノデスガ、道子ガ人妻トシテ余リニヒドイ乱行ヲシテ居ルノヲ見テ、モウ堪エラレヌ、イッソ道子ヲ殺シテ自分モ自殺シヨウト決心シタノデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだかイッソ憐れっぽくなったよ」「憎まれる方がまだいいや。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もその代りとして重野安繹先生が来られたのであるが、やはり水本の方を慕うが上に、東京の見物もしたいという希望もあるので、薩藩人を始め、他の藩々の人もイッソ水本の教授せらるる昌平学校へ行こうということになった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "名の下の日附はヴェルヌイユの「ロッジ」、もしくはガムベェの「エルミタージュ」へ行った日をしめしているのだと思われるが、「ビュイッソン未亡人、午前十時十五分」とあるもののほか、ほとんどが午前零時、午前三時、午前四時となっている。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "クゥシェ、エオン、コロム、バブレェ、ビュイッソン、ジェローム、パスカル、マルシャンディユ……ランドリュの手帳にある名に該当するものは、八人ともみな失踪中の女性の名だということになる。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "イッソ私は、私をよく識ってくれている日本植物研究者のマキシモヴィッチ氏の許に行かんと企て、これを露国の同氏に紹介した。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イッソの事と思つたことが、何度あつたずら。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イッソの事、強盜にでもなつて、早いとこ、パッパッと我が身の勝負をつけてしまうか。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナニワタクシドモガ嫌イナラ、イッソ別居サセテ戴キマショウヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ明日ノコトヲ考エルト、イッソ今直グヤリ直シテ貰ッテ伸ルカ反ルカヲ一挙ニ決シテシマイタクモアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「頸動脈ノ傍ヲ突クナンテ危イコッテスヨ、アタシハ始メカラ不賛成ダッタンデス、明日モイッソオ止メニナッタラ」ト、婆サンハ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ春以来気ニナッテイタノダガ、イッソコノ際京都行キヲ決行シヨウカト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
