        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この文ではいっそが重要な役割を果たしている。",
              "source": "幻辞"
            },
            {
              "text": "いっその意味を正しく理解することが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "彼はいっそという言葉をよく使う。",
              "source": "幻辞"
            },
            {
              "text": "文脈からいっその意味が推測される。",
              "source": "幻辞"
            },
            {
              "text": "いっそは日本語の表現の中で一般的である。",
              "source": "幻辞"
            },
            {
              "text": "この例文ではいっそがどのように使われているか注目しよう。",
              "source": "幻辞"
            },
            {
              "text": "いっその使い方は様々な場面で見られる。",
              "source": "幻辞"
            },
            {
              "text": "著者はいっそという表現を好んで使う。",
              "source": "幻辞"
            },
            {
              "text": "日常会話ではいっそがよく聞かれる。",
              "source": "幻辞"
            },
            {
              "text": "いっその定義を知ることで、文章の理解が深まる。",
              "source": "幻辞"
            },
            {
              "text": "複数の意味を持ついっその用法に注意が必要だ。",
              "source": "幻辞"
            },
            {
              "text": "いっそという語彙は初級者にとって習得が必要だ。",
              "source": "幻辞"
            },
            {
              "text": "文法的にいっその位置が重要な役割を持つ。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に見ると、いっその使用法は変化している。",
              "source": "幻辞"
            },
            {
              "text": "いっそをテーマにした文学作品が多く出版されている。",
              "source": "幻辞"
            },
            {
              "text": "辞書ではいっその複数の意味が記載されている。",
              "source": "幻辞"
            },
            {
              "text": "いっそという表現は、文化的な背景を反映している。",
              "source": "幻辞"
            },
            {
              "text": "翻訳時にいっその言語間での対応が課題となる。",
              "source": "幻辞"
            },
            {
              "text": "いっその使用頻度は、年代によって異なることがある。",
              "source": "幻辞"
            },
            {
              "text": "学習者がいっそを習得するには、実践が重要である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "出来のいい子は、出来のいい子で可愛いし、出来の悪い子は、いっそう又かなしく可愛い。",
              "citation": {
                "source": "自作を語る",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "円の面積を算出する公式も、鶴亀算の応用問題の式も、甚だ心もとなくいっそ代数でやればできるのだが、などと青息吐息の態とやや似ている。",
              "citation": {
                "source": "答案落第",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "八十八夜を記念しようという、なんの意味もない決心を笑いながら固めて、二人、浅草へ呑みに出かけることになったのであるが、その夜、私はいっそく飛びに馬場へ離れがたない親狎の念を抱くにいたった。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな暑い日にはいっそドテラでも着てみたら、どうかしら。",
              "citation": {
                "source": "炎天汗談",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがために物語はいっそう古雅な詩的な興趣を帯びている。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "有難しとボーイに礼は云うて早速頂戴するに半分ばかりにして胸つかえたれば勿体なけれど残りは窓から外へ投げ出してまた横になれば室内ようやく暗く人々の苦にせし夕日も消えて甲板を下り来る人多くなり、窮屈さはいっそう甚だしけれど吾一人にもあらねば致し方もなし。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから前垂のようなものを着けていたような気もするがこれはいっそう覚束ない。",
              "citation": {
                "source": "高浜さんと私",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっそう親切なのになると瀕死の人にいやがらせを言う。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何も急く旅でもなしいっそ人力で五十三次も面白かろうと、トウトウそれと極ってからかれこれ一月の果を車の上、両親の膝の上にかわるがわる載せられて面白いやら可笑しいやらの旅をした事がある。",
              "citation": {
                "source": "車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故にこそ、いっそう、恥かしくかなしいものなのであろう。",
              "citation": {
                "source": "音に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっそのこと……）「おまい、寝られないのかい？",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚いたのは当人ばかりではない、その時余の顔に全く血のけがなくなったのを見て、いっそう気を落としたとこれはあとで話した。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この娘を東国へ旅人の手に托けて送ったときの気持に戻って、いっそ、この娘を思い捨てるか。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっそこの川へ身を投げて死にとうございます」　またさめざめと泣き続けます。",
              "citation": {
                "source": "鯉魚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして女人の身、いっそう都合が悪いのです。",
              "citation": {
                "source": "鯉魚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはいっそ、そっとこのままにしておいて時の捌きを待つよりしかたがないと、思い諦めて、楽しいようなはかないような逢瀬を続けています。",
              "citation": {
                "source": "鯉魚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっそやるなら、ここまで踏み入ることです。",
              "citation": {
                "source": "巴里のむす子へ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代の日本人が語感の強い語を喜ぶとすれば、いっそ日本語を捨てて英語やドイツ語ばかり用いたらいいということにまでなってしまいそうである。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱海はもう桜もあるまいからいっそ箱根の方がいいだろうということになった。",
              "citation": {
                "source": "箱根熱海バス紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし東京にあの風が吹かなかったら、もし東京の街の泥と塵がなかったら、そして電車の数を増すか、あるいはいっその事に全部無くしてしまったら、それだけでも東京市民の顔は幾分か柔らかく快いものになりはしまいかと思われる。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この現象はトーキーでなく無声映画でも利用されうるであろうが、しかしトーキーだといっそう有効に応用されうるわけである。",
              "citation": {
                "source": "耳と目",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "虱がわいたとかで、つむりをくりくりとバリカンで刈ってしもうた頭つきが、いたずらそうに見えていっそう親の目にかわゆい。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "出口がせまいので少しからだを横にようやく通る窮屈さをいっそう興がって、ふたりは笑い叫ぶ。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっそ早く学校へ行ってしまいたくなった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕だっていっそ気違いになってしまったらと思った位だから、母を慰めるほどの気力はない。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お絹が涙で眼を光らして、Ｔ「隣り村へお嫁に　行くぐらいなら」　と言って、Ｔ「いっそ天狗様に　喰われて　死んだ方が倖せです」　と言う。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「不味いものを食うくらいならいっそ、くたばった方がいい」　これは、美味のないとき、膳の上の食品を罵倒する敬蔵の云い草だが、ひょっとすると、それが辛辣な事実で父娘の身の上の現実ともなりかねない今日この頃では、敬蔵もうっかり自分の言葉癖は出しにくかった。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――こんな体……こんな私……いっそなくなってしまえばいい……。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　　　　　　六「あれに連れて行て貰うよりゃ、いっそうら等二人で行く方が安気でえいわい。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒気はいっそうひどかった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
