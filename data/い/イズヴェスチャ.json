        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "○イズヴェスチャにエフィモフが Фокусы　польской　дефензивы〔ポーランド保安隊のペテン〕という題で、「СССР より農民群の逃亡」という題で書いたポーランド新聞を諷して居る。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "モスクワから一日おくれに到着する「イズヴェスチャ」が老教授の膝の上にあった。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "革命後十一年目――生活……学士院――「イズヴェスチャ」第六面にСССР学士院で会員候補氏名が発表された。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月十七日、労農ソヴエトはペテルブルグ・イズヴェスチャー紙に、先帝ニコライ・アレクサンドロウィッチとその家族がエカテリネンブルグで処刑されたという公報を出した。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
