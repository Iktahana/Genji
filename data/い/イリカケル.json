[
  {
    "uuid": "77d5c9d9-f285-57b3-a50a-aaa4c21ee8bd",
    "entry": "入り掛ける",
    "reading": {
      "primary": "いりかける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
