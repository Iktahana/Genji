      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to be about to enter (a bath, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お風呂に入り掛けたところで、タイミング悪く電話が鳴った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は会議室に入り掛けたが、中の険悪な雰囲気を察して足を止めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "トンネルに入り掛けると、急に辺りが暗くなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "小さな落葉松林を背負いながら、夕日なんぞに赫いている木の十字架が、町の方からその水車の道へはいりかけると、すぐ、五六軒の、ごみごみした、薄汚ない民家の間から見えてくるのも、いかにも村の教会らしく、その感じもいいのである。",
              "citation": {
                "source": "木の十字架",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "がお義理に、依田のあとから場内にはいりかけると、千代次は僕の袖を引張って、依田を先に通し人波を距ててから、よく御存じなんですかと聞く。",
              "citation": {
                "source": "慾",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "良一がそこにはいりかけると、軒燈の光がうすくさしてる石の門柱のうしろに、背のひょろ長い青年が、帽子はかぶらず、外套の上から腕組をしてつっ立っていた。",
              "citation": {
                "source": "椎の木",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "木山が控室の方にはいりかけると、そこでお茶を飲んでいた数人の中から、塚本夫人がつと立って来て、彼の腕を捉えた。",
              "citation": {
                "source": "怒りの虫",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、近所の奥さんらしいひとが店にはいりかけると、その足元へ砂利を投げつけた。",
              "citation": {
                "source": "庶民生活",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、やがて、起ち上つて、奥にはいりかける。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は彼女にその話をさせるために連出したのだったが、そして会話の調子でなおそれを求めてはいたが、公園にはいりかける頃から、もう聞かない方がよいかも知れないという気持が起ってきた。",
              "citation": {
                "source": "或る男の手記",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、馬子は、目にはいりかけるあせをふきながらいいました。",
              "citation": {
                "source": "道の上で見た話",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "いづれに我を嫁入らすべき方様に、入らぬものいりかけるでもないと。",
              "citation": {
                "source": "葛のうら葉",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして家にはいりかける時、二人ともそれぞれ、無言のまま頭で会釈をした。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし家へはいりかけると、ふいに後戻りして、停車場へ行き、列車到着の正確な時間を調べた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてクリストフの室にはいりかけると、自分の素足の蹠に、いつもの滑かな冷たい床板の感触ではなしに、柔らかにつぶれる生暖かい塵を感じた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そこで、実は、自分からもいちど、御賢慮をうながすわけですが」　と、信雄が、いよいよ本題にはいりかけると、家康は、ニッと、片頬で皮肉な笑みをうかべた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが谷地の池水を距ててＡ―丘の後へ入りかける夕陽を眺めているときででもあると（湊の生れた家もこの辺の地勢に似た都会の一隅にあった。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この宿の堆朱の机の前に座って、片手を小長火鉢の紫檀の縁に翳しながら、晩秋から冬に入りかける河面を丸窓から眺めて、私は大かた半日同じ姿勢で為すことなく暮した。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、もう一つ、いつもちやうど睡りに入りかける時に見てゐるやうでもあるし、現に醒めてゐる場合の妄想のやうな気もするのであるが、こんなのがある。",
              "citation": {
                "source": "大凶の籤",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アグーシャがやっと立って内へ入りかけると、たかっていた集団農場員たちはガヤガヤてんでの間でしゃべり出した。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャクルトンはスコットの第一回南極探検に同伴し、壊血病であわや死籍に入りかけるほどの苦楚をなめたうえ、六年後、再度、南極大陸に迫って、八十八度二十三分まで行った。",
              "citation": {
                "source": "南極記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "……えらそうに言うようでお耳ざわりでしょうから、打ちあけて話しますが、じつは昨日、あの日の時刻に駕籠を出し、それから四半刻おくれて死物狂いに追いかけて見ましたが、駕籠が一ツ橋の門内へ入りかけるころには、あたしは、ようやく三崎稲荷の近く。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "氷献上",
                "note": "青空文庫"
              }
            },
            {
              "text": "ええ、その辺のところは、ご信用をねがって……それで、早速ですが」　と本題に入りかけると、太田夫人は横からひったくって、「石田さん、このとおり、さっぱり頭のない男やで、なにをいうとるのか、わからんでしょう。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "山本が無造作に這入りかけるので「這入つても構わんのかい」と三藏は一寸躊躇する。",
              "citation": {
                "source": "俳諧師",
                "author": "高濱虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（その声に、二、三人が振向くが、これも無視して、稲の中にバラバラと入りかける）やい、待てと言ったら待たねえか！",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（三人田へ入りかける）段六　（仙太郎の肩を笑ってこずきながら）仙太公、今あ、えら、いばったぞう！",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（その声に、二、三人が振向くが、これも無視して、稲の中にバラバラと入りかける）やい、待てといったら待たねえか！",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（三人田へ入りかける）段六　（仙太郎の肩を笑ってこづきながら）仙太公、いまあ、えら、いばったぞう！",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中の間へ這入りかけるとお梅が神様を拝みに行くのとバタと出会した。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｏはしかめ面をしながら、小さな入口から這入りかけると、「帯を解くんだ。",
              "citation": {
                "source": "或る少女の死まで",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな無法な人間をあつしは見た事もない――玄關側から、木戸を押して、奧庭へ入りかけると、いきなり、コラツピカリと來るぢやありませんか。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "迷子札",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな無法な人間をあっしは見た事もない――玄関側から、木戸を押して、奥庭へ入りかけると、いきなり、コラッピカリと来るじゃありませんか。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "迷子札",
                "note": "青空文庫"
              }
            },
            {
              "text": "湾内に入りかけると、津軽半島に相対した松前方面へつらなる丘の上に、トラピスト男子修道院の赤｜煉瓦の建物がみえる。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
