          "literary": [
            {
              "text": "さて、今度のイーハトブの旅行中で、私は大へんめづらしいものを見ました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に烈しかったのは、イーハトブの首都のマリオです。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イーハトブ日日新聞だ。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イーハトブさんが向ふの空で、又笑ってゐますよ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあいゝさ、お前もしっかり支度をして次の噴火にはあのイーハトブの位になれ。",
