          "literary": [
            {
              "text": "イロイロナモノガ私ノ心ヲオドラセマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイロイロナ構図デ頭ガイッパイニナッテイルノデスガ、ナニシロマダカクダケノ腕ガナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イロイロナ　ゴチソウガ　デマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカヤ　アヲヤ　キイロヤ　ムラサキヤ、イロイロナ　フウセンダマハ　ホホヲ　スリヨセナガラ　カゼノ　フク　ハウヘ　ナビイテ　ヰマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテイロイロナ意味ニ取レル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真ハ全裸体ノ正面ト背面、各部分ノ詳細図、イロイロナ形状ニ四肢ヲ歪曲サセ彎屈サセ、折ッタリ伸バシタリシテ最モ蠱惑的ナル角度カラ撮ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
