[
  {
    "uuid": "fa40f7cb-f12b-5ef0-8670-e2c7fa0ea80a",
    "entry": "生ける",
    "reading": {
      "primary": "いける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
        "動詞-他動詞"
      ],
      "ctype": "一段",
      "inflections": null,
      "ctype_source": "pos-derived",
