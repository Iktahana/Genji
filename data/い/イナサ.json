      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "手足をわなわなさして見ておったかれの母は、力のこもった決心のある声をひそめて、あなた殺してしまいなさい。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺してしまいなさい。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、「民やはあのまた薬を持ってきて、それから縫掛けの袷を今日中に仕上げてしまいなさい……。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は民さんがそう云いなさいと云う。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬屋の支払いに就いて、私がお母さまにこっそり相談したら、お母さまは、片手でお顔を覆いなさって、しばらくじっとしていらっしゃったが、やがてお顔を挙げて淋しそうにお笑いになり、考えたって仕様が無いわね、何年かかるかわからないけど、毎月すこしずつでもかえして行きましょうよ、とおっしゃった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうでしょう」　私がそう言って笑ったら、上原さんは、「これだから、いやさ」　と口をまげて、にが笑いなさった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "妹が私のほうに話しに来ても、「おまえは、きょうは大事な役なのだから、お父さんの傍に附いていなさい」と言って追いやった。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い時の女遊びは、女を買うのではなく、自分の男を見せびらかしに行くんだから、自惚れこそは最大の敵と思っていなさい。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "無闇な指図の他は、お逆らいでも何でも許してあげますから、男らしく、もっとはっきり言いなさい。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、王さまは、勘違いなさって居られるだけなんだ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しは見習いなさいよ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "風の音がこわかったら、しばらく耳をふさいでいなさい。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポローニヤス、少しは恥ずかしく思いなさい。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "本気に疑って、くるしんでいなさるのは此のエルシノア王城で、ハムレットさま、あなたぐらいのものなのよ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人にものを教えようと思ったり、男の頭を押えようとしないで、ただ、静かに、生れる子供の事を考えていなさい、という意味だ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（立ち上り、二重廻しを着る）（あさ）（おどおど部屋にはいり、清蔵の傍に寄り、清蔵が二重廻しを着るのにちょっと手伝い、おだやかに）清蔵さん、早くお嫁をもらいなさい。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "母があたしにいつまでも、母の傍にいなさい、と言ったら、あたしは一生もう母の傍にいるつもりです。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたは柳生十兵衛のつもりでいなさい。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前は病室へ行って、母の足でもさすっていなさい。",
              "citation": {
                "source": "故郷",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠浅の浜べで潮の引いた時、砂の上にきれいなさざ波のような模様が現われる事があります。",
              "citation": {
                "source": "夏の小半日",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "……さあさあ一きり露台へ出ようか、で、塀の上から、揃ってもの干へ出たとお思いなさい。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "過日もね、お前、まったくはお前、一軒かけ離れて、あすこへ行くのは荷なんだけれども、ちとポカと来たし、佳い魚がなくッて困るッて言いなさる、廻ってお上げ、とお前さんが口を利くから、チョッ蔦ちゃんの言うこッた。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥満のお三どんが、ぶっちょう面をしゃあがって、旦那様とか、先生とかお言いなさい、御近所へ聞えます、と吐しただろうじゃねえか。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "嚊々を貸せとも言いなさりゃしめえ、早い話が。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「お疑いなさるは御勝手さ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうおっしゃれば、あの掏られた、と言いなさる洋服を着た方も、おかしな御仁でござりますよ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「奥さんに、奥さんに、お願いなさいよ、」　　　　　　　四十三「何を、奥さんに頼めだい、黙れ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに土地馴れないのに、臆病な妓ですから、早瀬さんがこうやって留守にしていなさいます、今頃は、どんなに心細がって、戸に附着いて、土間に立って、帰りを待っているか知れません、私あそれを思うと……」　と空色の、瞼を染めて、浅く圧えた襦袢の袖口。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり私が居た時分のように、お玄関の書生さんにしてお貰いなさいよ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二「芭蕉の葉煎じたを立続けて飲ましって、効験の無い事はあるまいが、疾く快うなろうと思いなさる慾で、焦らっしゃるに因ってなおようない、気長に養生さっしゃるが何より薬じゃ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
