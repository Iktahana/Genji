        "examples": {
          "standard": [
            {
              "text": "今晩のおかずは、いんげん豆と豚肉の甘辛い胡麻和えにしよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "畑で収穫したいんげん豆をさっと茹でると、鮮やかな緑色が食欲をそそる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "いんげん豆をたっぷり入れたミネストローネは、栄養満点で冬の朝食にぴったりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "彼女は籠の上に腰をかけ、黄色いたまねぎや小さな薄赤い蕪菁や青いいんげん豆や真赤な林檎などの山を前にし、売ろうともしないで林檎をかじっていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
