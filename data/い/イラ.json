    },
    "definitions": [
      {
        "index": 1,
        "gloss": "scarbreast tuskfin (Choerodon azurio)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "釣りの獲物として、伊良という魚を狙う愛好家もいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "魚屋の店主が、珍しい伊良が入荷したと教えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この伊良、刺身にすると絶品らしいよ」と、ベテラン漁師が言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "成程どんどん湧いていら、伊良子ヶ崎までたっぷりだ。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……海が凪いだら船を出して、伊良子ヶ崎の海鼠で飲もう、何でも五日六日は逗留というつもりで。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "十九「泣いてばかりいますから、気の荒いお船頭が、こんな泣虫を買うほどなら、伊良子崎の海鼠を蒲団で、弥島の烏賊を遊ぶって、どの船からも投出される。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鷹ひとつ見つけてうれし伊良古崎　　　　芭蕉　これだなと私は思った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰るさ、私は伊良湖岬に杉浦明平を訪ねた。",
              "citation": {
                "source": "夏秋表",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊良湖の鼻と神島と相対してゐる形もよく見える。",
              "citation": {
                "source": "知多の野間で",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "『鷹一つ見つけてうれし伊良湖岬』この句が杜国に逢つた喜悦を詠じたものだと言ふのは、それは何うだか知れないけれども、兎に角、こゝから伊良湖岬の絶端まで、翁の足跡が及んでゐることを考へると、私は言ふに言はれないなつかしさを感ぜずにはゐられなかつた。",
              "citation": {
                "source": "伊良湖岬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "畠から伊良湖岬までは、全く荒凉とした二里半の話である。",
              "citation": {
                "source": "伊良湖岬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊良湖の村に入る一里ほど手前あたりまで行くと、その小さな山脈は漸く尽きて、その隙間から、太平洋の怒濤が地を撼すやうにきこえて来た。",
              "citation": {
                "source": "伊良湖岬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は万葉集にある伊良湖ヶ島の歌を思ひ出さずにはゐられなかつた。",
              "citation": {
                "source": "伊良湖岬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊良湖の村、それは半ば松の中に埋れたさびしいさびしい村であつた。",
              "citation": {
                "source": "伊良湖岬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし今行く旅客は、最早その伊良湖の孤村を見ることは出来ないであらう。",
              "citation": {
                "source": "伊良湖岬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　伊良湖岬は、天下の絶勝と言つても、決して溢美ではなかつた。",
              "citation": {
                "source": "伊良湖岬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは伊良湖が持つた一部の比較を求めれば、それに匹敵するに足るほどのものはないことはないかも知れないけれども、しかもその大きなシインには――？",
              "citation": {
                "source": "伊良湖岬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊良湖に行つたものは、誰でも神島に渡つて見たくなるであらう。",
              "citation": {
                "source": "伊良湖岬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "衣ヶ浦から見ると、越戸の大山が最も高く、伊良湖はその脈から切れて、全く海中の一孤島のやうになつて見えてゐた。",
              "citation": {
                "source": "伊良湖岬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "知多半島の師崎と渥美半島の伊良湖岬とは、相対して、衣ヶ浦の門戸を成してゐるやうな形になつてゐるけれども、こゝらあたりから見ると、それはかなりに離れて、丸で関係がないものか何ぞのやうに見えた。",
              "citation": {
                "source": "伊良湖岬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝに来ると、伊良湖は余程形を変へて見えた。",
              "citation": {
                "source": "伊良湖岬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその向うには、かれ等の此夏やつて来てゐる伊良湖の鼻の長く海中に突き出してゐるのがはつきりと手に取るやうに指さゝれた。",
              "citation": {
                "source": "島からの帰途",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "早々出発、伊良湖崎へ、――二里。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊良湖明神はありがたかつた、閑静なのが何よりだ、御手洗は汲上井戸だがわるくなかつた、磯丸霊神社とあるのもうれしかつた、芭蕉句碑もあつた、例の句――鷹一つが刻んであつた。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊良湖から日出、堀切、小塩津、和地と歩いた、豌豆の外に花を作つている、金盞花が多かつた、養鶏も盛んである。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊良湖の荒磯で貝穀を拾ひ若布を拾うたことは忘れられない。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なあに、伊良湖の方へ行くんだがね、新居よりほかに行く途はないかね」　私は風に吹かれて思ふやうにならない地図を皺くちやにしながら、捜りを入れるやうに頭の上から言葉を投げた。",
              "citation": {
                "source": "伊良湖の旅",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊良湖なら新居へ行かずに、この先の浜へ着けりや好いだ」「そりや好い。",
              "citation": {
                "source": "伊良湖の旅",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "「伊良湖十三里と云つてね、この先の浜伝ひに行きせえすりや、嫌でも行つちまうだ。",
              "citation": {
                "source": "伊良湖の旅",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊良湖の十三里、まだ私達の行く先は遠いといふやうな感じが胸に起つて来た。",
              "citation": {
                "source": "伊良湖の旅",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤羽根へ出て「裏浜」を廻り、伊良湖村まで行くには八九里あると宿の番頭が来て話した。",
              "citation": {
                "source": "伊良湖の旅",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊良湖の裏浜は最う一里程で尽きるのだ。",
              "citation": {
                "source": "伊良湖の旅",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "……２恋人よ、その哀しげな歌をやめてよ、おまへの魂がいらいらするので、そんな歌をうたひだすのだ。",
              "citation": {
                "source": "寒い夜の自我像",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
