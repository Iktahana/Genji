[
  {
    "uuid": "18dc2550-c50a-582e-a8e5-e0d6f64cbc68",
    "entry": "伊良",
    "reading": {
      "primary": "いら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
