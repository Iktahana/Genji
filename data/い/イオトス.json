[
  {
    "uuid": "44b02c69-bd3a-521d-b63a-de1ca5db0565",
    "entry": "射落とす",
    "reading": {
      "primary": "いおとす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
