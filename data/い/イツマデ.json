    "definitions": [
      {
        "index": 1,
        "gloss": "how long?",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「いつまでゲームを続けるつもり？明日は朝早くから部活があるんでしょ」と母親が呆れたように言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "締め切りが過ぎているのに、あの担当者はいつまで修正案を待たせるつもりなのだろうか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "いつまでも過去の失敗を引きずっていても仕方がないから、気持ちを切り替えて次のプロジェクトに臨もう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「いつまでこの雨は降り続くのかしら」と、彼女は窓ガラスを伝う水滴をぼんやりと見つめながら呟いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "私の方は急を要する場合だし何時まで待つてもゐられないから、三田村の「あんな奴と共同で云々」のそのあんな奴に、私は私の最初の計画通り相談することに肚をきめる。",
              "citation": {
                "source": "夏の夜の話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは好いが君、君その指の繃帯は如何した」「一寸ナイフで切りましたから……」「Ｓ子は今内にゐませんから夕方いらつしやい……」　さう言つて二人は別れたが、彼にはその従兄の言葉が何時までも問題になつた。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――郷土望景詩――昨日にまさる戀しさの昨日にまさる戀しさの湧きくる如く高まるを忍びてこらへ何時までか惱みに生くるものならむ。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車はゴーツといつて、青い青い雪の原を、何時までも停まらず走り続けました。",
              "citation": {
                "source": "夜汽車の食堂",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もどの画家でも相当な人ならばある程度まではそういう事を考えぬ人は無いかもしれないが、しかしそう考えるばかりで何時までも同じ谷間の径路を往復しながら対岸の自然を眺めているのでは到底駄目であろう。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして何時までも安心したりおさまったりする事なしに、何時までも迷って煩悶して進んで行く事を祈るものである。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "永遠といふものの力が自分のからだを外にしても斯うして空と地上とに何時までもある。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　「石松の奴が今に帰るかと思って……」　「そうかい……妾もね、あんな親不孝な伜だけれど、今夜の様に何時までも帰りが遅いと、つい心配になってね」　「おばさん、まあお這入ンなさいよ」　「有難う。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそいつは、その後、そして何時までも、人々から「恐怖」と呼ばれてゐた。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は退院と云ふ明るい氣持もすつかり失つて、カアテンの締まつてゐたその窓を何時までもぢつと眺めてゐた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "舟の別れんとする時、女は僕に向て何時までも「私の事を忘れんで居て下さいましナ」と繰返して言つた。",
              "citation": {
                "source": "少年の悲哀",
                "author": "國木田獨歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛙が何時までも蛙であると同じ意味の運命。",
              "citation": {
                "source": "酒中日記",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "植木屋さんも何時まであんな物置小屋みたような所にも居られんで移転なりどうなりするだろう。",
              "citation": {
                "source": "竹の木戸",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "満足な家には一度だって住まないで何時でもこんな物置か――」「何を何時までべらべら喋舌てるんだい」と磯は矢張お源の方は向ないで、手荒く煙管を撃いて言った。",
              "citation": {
                "source": "竹の木戸",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の狩太村の農場は、戸数が六十八九戸、……約七十戸といふところですが、それが何時まで経つても掘立小屋以上の家にならないで、二年経つても三年経つても、依然として掘立小屋なんですね。",
              "citation": {
                "source": "私有農場から共産農団へ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全戸皆がこんな掘立小屋で、何時まで経つても或ひは藁葺だとか瓦葺だとか、家らしい家にならないし、全く嫌になつて終つたんですな。",
              "citation": {
                "source": "私有農場から共産農団へ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一口に言へば、何時まで経つてもその日のことに追はれてゐて、そんな運びに至らないのです。",
              "citation": {
                "source": "私有農場から共産農団へ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小作料やら、納税やら、肥料代やら、さういつた生活費に追はれてゐて、何時まで経つても水呑百姓から脱することが出来ないのです。",
              "citation": {
                "source": "私有農場から共産農団へ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯う華やか立つた一家の中で何時までもくすぶり返つてゐるのは母一人だつた。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "力三は遊び疲れて、死んだやうに眠ては居るが、何時眼をさまして腹が痛いと云ひ出すかも知れないと云ふ事まで気をまはして、何時までも暗い中で眼をぱちくりさせて居た。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は何時までも入口に立つてぶつ／＼云つて居た。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何時までも兄の所の荷厄介になつて、世間から後指をさゝれて、一生涯面白い眼も見ずに暮すんだらう。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、敢て出て来たといふのは、――つまり何時までさうして弟の傍に、東京に生活（？",
              "citation": {
                "source": "亡弟",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "其から煩ひついて、何時まで經つても治らなかつたから、何もいはないで其の内をさがつた。",
              "citation": {
                "source": "怪談女の輪",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "忘れないで、何時までも、何時までも、」　と言い言い抜き取った草の葉をキリキリと白歯で噛んだ。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この土手へ出ちゃ、何時までもこうしていますのに、唯いては、谷戸口の番人のようでおかしゅうござんすから、いつかッからはじめたんですわ。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か心配でもあるのかと夫人が聞いたら、あまり楽しくて嬉しいので、いつまでこの家に住み、いつまでこんな幸福が続くかと思い、それがまた心配になって来たと言った。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、いつまで経っても、出世できない様子です。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "修業という事は、天才に到る方法ではなくて、若い頃の天稟のものを、いつまでも持ち堪へる為にこそ、必要なのです。",
              "citation": {
                "source": "炎天汗談",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある程度の高さを、いつまでも変らずに持ちつづけている芸術家はよほどの奴です。",
              "citation": {
                "source": "炎天汗談",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
