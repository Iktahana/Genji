        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "映画のクライマックスシーンで、主人公の過去の回想シーンがインサートされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "監督は、この部分にキャラクターの表情を強調するクローズアップのインサートを求めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "編集者によると、そのテイクは本編にインサートするには少し短すぎたらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
