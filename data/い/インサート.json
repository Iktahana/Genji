        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このボールペンのインクカートリッジは、スムーズなインサートが可能です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、プレゼンテーションに新しいスライドをインサートした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ソフトウェアがクラッシュしたので、システムログにエラー情報をインサートする必要があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "雨の夜、ハミルトンが自宅で自分の８ミリを映写してみせる場面が再現され、ハミルトンの撮った８ミリが五十フィートぜんぶ、インサートされていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "８ミリ・フィルムのインサートのあと、ビル・ハミルトンがアランに会う以前へと、時間はフラッシュ・バックした。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンディエーゴでのアランとダフネの出会いが語られ、ダフネが撮影したアランの波乗りのフィルムのすべてが、インサートされた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
