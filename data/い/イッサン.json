[
  {
    "uuid": "78e76516-77e3-502b-825a-2b09a61f16f5",
    "entry": "一山",
    "reading": {
      "primary": "いっさん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "whole temple complex",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その一山全体が、国宝に指定されている古い寺院群だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "春には、一山に咲き誇る桜を見に多くの観光客が訪れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "険しい山道を登り、ようやく目的の一山にたどり着いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "一山、二山、とやるね。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一山は約三百億粒だとかいふ話だが、誰もそれをいちいち算へた事も無い。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓦屋根の覆いを冠った朱塗の大鳥居には、良恕法親王の筆と知られた、名高い「三国第一山」の額が架かってある。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして多くは、その前年または前々年と比べても、同一山において、十日内外の遅速があるのに過ぎないというのであるから、先ず大概の見当はつくであろう。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝は蔓って、谷に亘り、葉は茂って峰を蔽い、根はただ一山を絡って居たろう。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて二人は一山の落ち葉燃え尽くるまで、つきぬ心を語りて黎明近くなりて西の空遠く帰りぬ。",
              "citation": {
                "source": "星",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶めし餡掛、一品料理、一番高い中空の赤行燈は、牛鍋の看板で、一山三銭二銭に鬻ぐ。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "青麦につづく紺青の、水平線上｜雪一山。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝は蔓つて、谷に亙り、葉は茂つて峰を蔽ひ、根はたゞ一山を絡つて居たらう。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そして、いろいろな本を一山ブドリに渡しました。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "折から一室處より姑の聲として、婦に云うて曰く、風靜に露白く、水青く、月清し、一山の松の聲蕭々たり。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったく、一山の仏たち、大な石地蔵も凄いように活きていらるる。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "前棒の親仁が、「この一山の、見さっせえ、残らず栃の木の大木でゃ。",
              "citation": {
                "source": "栃の実",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういうものか、はい、御維新前まで、越前の中で、此処一山は、加賀領でござったよ――お前様、なつかしかんべい。",
              "citation": {
                "source": "栃の実",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その風采や、さながら一山の大導師、一体の聖者のごとく見えたのであった。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処の店の隅にも転がっているような一山｜百文式の我楽多玩具、それが私には甚く嬉しいんです。",
              "citation": {
                "source": "我楽多玩具",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃は少しばかり人形を貰い集めていますけれど、これは道楽の余業で、ほんとうの道楽は一山百文式の我楽多玩具にあること勿論です。",
              "citation": {
                "source": "我楽多玩具",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "賽児墓に祭りて、回るさの路、一山の麓を経たりしに、たま／＼豪雨の後にして土崩れ石｜露われたり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の師の慈慧が僧正に任ぜられたので、宮中に参って御礼を申上げるに際し、一山の僧侶、翼従甚だ盛んに、それこそ威儀を厳荘にし、飾り立てて錬り行った。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅は小鯵の色の好いのが一山あるのに目を附けて、値を聞いて見た。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜来の春雨猶止まずして一山風静かに、窓前の柳松翠色更に新たなるを覚え、空廊に響く滴水の音、濡羽をふるふ鶯の声に和して、艶だちたる幽奥の姿誠に心地よく候。",
              "citation": {
                "source": "渋民村より",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "）灣の背後に一山の聳ゆるありて、その嶺には古壘壁を見る。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "一山に寺々を構えた、その一谷を町口へ出はずれの窮路、陋巷といった細小路で、むれるような湿気のかびの一杯に臭う中に、芬と白檀の薫が立った。",
              "citation": {
                "source": "夫人利生記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "関東一円、奥州まで、愚僧が一山へも立処に響いた。",
              "citation": {
                "source": "妖魔の辻占",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と雨垂に笠も被らないで、一山ずつ十銭の附木札にして、喚いている。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "数は少いが、これも一山ずつにして、どの店にも夥多しい。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわゆる一山｜飛で一山来るとも云うべき景にて、眼｜忙しく心ひまなく、句も詩もなきも口惜しく、淀の川下りの弥次よりは遥かに劣れるも、さすがに弥次よりは高き情をもてる故なるべしとは負惜みなり。",
              "citation": {
                "source": "突貫紀行",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他の曲にはなかなか複雑な仕組みのものもあったが、たとえば大小の弦楽器が多くは大小の曲線の曲線的運動で現わされ真鍮管楽器が短い直線の自身に直角な衝動的運動で現わされたり、太鼓の音が画面をいっさんに駆け抜ける扇形の放射線で現わされたりする場合が多いようである。",
              "citation": {
                "source": "踊る線条",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山道のトロッコにうっかり乗った子供が遠くまではこばれた後に車から降ろされただ一人取り残されて急に心細くなり、夢中になって家路をさしていっさんに駆け出す。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニはいっさんに丘を走って下りました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
