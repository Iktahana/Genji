        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コノール　もし琴手フェリムがもう一度生れて来たら……デュアック　フェリムは訊くでございましょう、あの王の都市、うつくしい市のイメーン・マカは何処にある？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コルマックとファガスとレッド・ブランチ党の三分の一の人たちは女王メーブに味方しました、女王は全軍を集めてあなたを滅し、あなたの誇りであったイメーン・マカを滅したとおり、ウラァをも滅そうとしております。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノール　イメーン・マカの都は過去の夢であろうか？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　美しい市イメーン・マカは消え去った夢でございます。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "うつくしい市イメーン・マカは何処にあります？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            }
          ]
        }
