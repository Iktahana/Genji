          "literary": [
            {
              "text": "要するに、名妓何々のイミタシオンを買ってしまう。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "和洋の令嬢と芸妓、乙姫のイミタシオンたちがわれわれを直に取り巻いてくれる。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃面白いことには絵画材料店に静物用の壷とバック用のインド更紗の安いイミタシオンと、果実を並べる台等を売っていることである。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            }
          ]
        }
