        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今年私ハ、小サイタライノオ風呂ニ二三日ゴトニ入リマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうことを知ってはいても、私などは育ちが下根で、ぬけぬけとそうはやりきれずに、つい女々しく、イヤミッたらしく言い訳に及んでしまうテイタラクであるから、まことに敵が憎く、また口惜しいのだが、偉い奴だと思わずにもいられぬ。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "執念深く覚えてゐるのはサルトルぐらゐのものだぜ、と云つて、あとはクダをまいてしまふ、といふテイタラクである。",
              "citation": {
                "source": "余はベンメイす",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと目が行くと、慌てて目をそらし、そしらぬ顔をするといふテイタラクで、さういふ時、窓へ目をそらし、窓から見た京都の山々のクッキリと目にしみる切なさは、その山影をだいて死にたいやうであつた。",
              "citation": {
                "source": "再版に際して〔『吹雪物語』〕",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "たかが女房の浮気に、と、私は彼をあわれみながら、私自身は、惚れた女に別れたゞけで、いつとなく、死の翳が身にしみついているというテイタラクである。",
              "citation": {
                "source": "死と影",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "武芸者のようにいかめしく構えた教祖護衛の面々もポカンとしているテイタラクである。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜなら、原因を潜在意識にもとめると、人間の精神は全く必然というものになりおわり、したがって、精神病学上にはまったく人間の意志というものを認めていないようなテイタラクになり易いのですよ。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その三　精神病診断書",
                "note": "青空文庫"
              }
            },
            {
              "text": "執念深く覚えているのはサルトルぐらいのものだぜ、と云って、あとはクダをまいてしまう、というテイタラクである。",
              "citation": {
                "source": "余はベンメイす",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに、絵具をあちこちに置き放す、それを踏みつぶす、着物にまでベタベタくっつくと言うテイタラクで、もうどうしてよいかわかりません。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ざまを見ろと言つたテイタラクさ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彦六　こつちは御覧のやうなテイタラクだ。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう言われただけで、まるっきし顔の色変えちまって、そのテイタラクだ！",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄柏　タイタラハンの木の如し。",
              "citation": {
                "source": "他計甚※（竹島）雜誌",
                "author": "松浦武四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ上京のたびに豪奢きわまる買物をして、大喜び、お気に入りの衣裳や靴ができてくると、喜び極まり第一夜はその衣裳をつけ靴をはいて寝てしまうというテイタラク、まったく定跡のない人物なのである。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "――肺病ミガサツクスフオーンヲ吹イタラ危イ血ガ検温計ノ様ニ　――実ハ不断ニ寿命ガ流レテイルンダヨ。",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダケドアレヲ提ゲテ歩イタラ、僕ガ買ッテヤッタンダト、婆サンガ感ヅキャシナイカナ」「オ婆チャンハアノ時見テイラッシャラナカッタワ、ドン／＼歩イテ先ノ方ヘ行ッテラッシャイマシタワ」ヤッパリソウダッタナト予モ思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………「オ爺チャン、………」コヽマデ書イタラ、不意ニ婆サンガ陸子ヲ連レテ這入ッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君ハトウダンスハシナイノカネ」ッテ聴イタラ、「トウダンスハヤリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見テイタラサゾ面白カッタロウト、予ハアトデ残念ニ思ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」戸ハホンノ僅カ、動クカ動カナイクライニ触レタヾケデアッタガ、早クモ彼女ハ気ヅイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………午後二時過ギ春久来リ、二三時間イタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ予ニソレヲ誇示スルタメニ浴室ヘ招イタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウ云ウ風ノ吹キ廻シカ、アトガ恐シイナ」「イヽ覚悟ダワ、ソノ積リデイタライヽワ」「ジャ、ソレカラ先ニ聞コウジャナイカ」「マア兎ニ角、ネッキングヲナサイ」結局予ノ方ガ誘惑ニ負ケタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナコトヲ云ッテイタラ際限ガナイカラ、予ハ近々ニ婆サンニ無理ニ承諾サセテ壊シ屋ヲ入レヨウト思ッテイタノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御老人ニハヨクアルコトデゴザイマス」「ジャ、君ハ前カラ知ッテタノカ」「ハア、近頃ハ毎朝伺ッテオリマシタ、ピイピイッテ、オ可愛ラシイオ声デ」「婆サンニモコノ声ヲ聞カシテヤロウ」「知ッテラッシャイマスヨ、ソンナコト」「颯子ガ聞イタラ笑ウダロウナ」「若奥様ダッテ御存知ナイコトガアルモンデスカ」五日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ト浄吉トノ結婚ヲ、予ノ妻デサエアンナニ激シク反対シタノデアルカラ、アノ時分マデ母ガ長生キシテイタラ、ドンナニ反対シタコトデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "萬一父ガ生キテイタラ、予モ浄吉モ勘当サレルニ決ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "爪ノ化粧モコノ伝デ、詳細ニ書イタラソノ煩ニ堪エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――ダケド話ハ伺イマシタ、アンタナンカイタラ邪魔ダカラ何処カヘ行ッテラッシャイッテ、追イ出シタノヨ」「ソレデモイヽ、ダガモウ一人邪魔ナ人間ガイル」「ハイ、ハイ、分ットリマス」ソウ云ッテ佐々木モ早速気ヲ利カシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
