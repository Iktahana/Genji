        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "測量の簡素化を狙って開発され、プロファイルトレーサーと名付けられたこの装置の外見は、手押し式の二輪車である。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ母ッチャハネタキリデ、目アナガウントヒッコンデ、ダマッテミテイルト、イキヲスルタビニウゴイテイタフトンガ、ダンダン分ラナイグライニナッテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ調和シテイルト考エル人ガアレバ、ソレハ習慣ニヨツテ感覚ガ麻痺シテイルニスギナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガカタカナノ場合ハソノ成立ノ歴史カライツテモ楷書ノ漢字ノ一部分ヲチヨツト失敬シタマデデアルカラ、コレガ楷書ノ字ト一緒ニ並ンデイルトコロハアタカモ親ト子ガ並ンデイルクライヨク調和スル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ活字式ニ書カレタポスターノ大キナ字ニヒラガナガ混ツテイルトヨクワカル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オムスクのすぐ手前、イルトゥイシュ河、大きい河、白い雪の間に河水は澱った灰汁色だ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、モスクデ　オコツテイルトアタマニワルイ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "地図を見たらそれがイルトゥウィシェ河だった。",
              "citation": {
                "source": "新しきシベリアを横切る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "獨逸語のヴイルトシヤフトリツヘ、アインハイト（Wirtschaftliche Einheit）、英語のエコノミツク、ユニツト（Economic Unit）、即ち『經濟上の單位』を能く有効にしやうと云ふのが目的である。",
              "citation": {
                "source": "教育の目的",
                "author": "新渡戸稻造",
                "note": "青空文庫"
              }
            },
            {
              "text": "平日は労役へ出るので、彼女はそちらへ出向いて行き、時には作業場、時には煉瓦工場、時にはイルトゥイシュ河畔の小屋で会った。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "セミパラチンスク――イルトゥイシ河沿岸。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は東京では、どこ／＼のコーヒーが一寸飲めるといひ、自ら書斎の一隅にコーヒーひきとフイルトレの道具を用意し、「これはこの間フランスから取寄せたコルスレだ」などと、不眠症の客をへき易させる奇癖をもつてゐた。",
              "citation": {
                "source": "田巻安里のコーヒー",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度イルトの命もそのお蔭でとりとめますし、たゞクリスチナさん、かゝりが大變でしてねえ。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　ミナサンモ　ゴランニナルヤウニ　カメサンハ　ミンナ　イマダニ　ハダカデ　クラシテイルト　イフワケデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういう折であったか、心理実験場の話がでて、入れてもらおうではないかということになり、ヴントに申出ると、ヴントは、心理実験場の助手を兼ねていたヴイルト私講師を通じて、客員として入れてやろうということで、しばらく心理実験場へも通った。",
              "citation": {
                "source": "ヴィルヘルム・ヴント",
                "author": "川合貞一",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅イ動脈ダツテアンナニ皮膚ニ埋レテイルト……見ヨ！",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩カズニイルト、今ニ本当ニ歩ケナクナリマスト嚇カサレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イニシテ癌デハナカッタガ、頸骨ノ六番目ト七番目ガ変形シテイルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ代リ、全クソンナ資格ノナイ老人デアルコトヲ自分ミズカラモ認メテイルニ違イナイト、ソウ思ッテ世間ガ安心シテイルトコロガ附ケ目デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コヽニ同程度ニ美シイ、同程度ニ予ノ趣味ニ叶ッタ異性ガ二人イルトスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」答エズニイルト、クスット笑ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "拂暁、午前五時頃ト思ウ、ウト／＼シナガラ聞イテイルト、何処カデ蟋蟀ガピイピイト鳴イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "割下水ノ家ニ住ンデイタ時分、六ツカ七ツノ頃ダッタヾロウ、乳母ニ抱カレテ寝床ニ横ニナッテイルト、蟋蟀ガヨク縁側ノ外デ鳴イテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナピイピイシタ可愛イ声ガ自分ノ体カラ出テイルトハ思エズ、ドウシテモ虫ガ鳴イテイルヨウニ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレハソウト、陸子ガ面白イコトヲ聞イテ来マシタンデ、オ爺チャンニモオ耳ニ入レテ置キタイト思イマシテネ」「アヽソウ」又何カイヤナコトヲ云イニ来ヤガッタト思ッテイルト、「オ爺チャン油谷サンヲ覚エテラッシャルデショウ」「ブラジルヘ行ッタ油谷ノコトカ」「アノ油谷サンノ息子サンヲ御存知？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ニ手ヲ曳カレテ庭ヲ散歩シテイルト、囲イノ中ノ犬舎ニ入レテアル筈ノコリーガドウシタ間違イカ飛ビ出シテ来テ突然予ニ跳リカヽッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ癖他人ガ触ルトツメタクナイ、普通ノ温カイ手ヲシテイルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アタシオ腹ガ減ッテルノヨオ爺チャン、早ク食堂ヘ行キマショウヨ」五子達ハ済ンデイルト云ウノデ三人デテーブルニ就ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ二三回支那ヲ漫遊シタコトガアルガ、支那ノミナラズ、日本ノ何処カヲ旅シタ折ニモ、偶然人ガ野外ニ立ッテ拓本ヲ製作シテイルトコロヲ見タコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
