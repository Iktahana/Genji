          "literary": [
            {
              "text": "口デ言エナイホド喜ビマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "――樹明君近来の口癖はブチコワスゾである、何カヲブチコワサズニハヰラレナイホド、君は悩み苦しみ焦立つてゐる、そこで、私が先づ茶碗をぶちこはす、樹明君喜んで皿を投げつける、ガチヤンガラガラ、どうやら胸がすいたらしい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　花タチハ　ジブンタチノ　スガタヲ　ナガメアヒ、ジブンタチカラ　ナガレデル　ニホヒヲバ　カギアツテ、ジブンタチガ　ミナ　オナジヤウニ　キイロイ　キモノヲ　キテ　ヲリ、ホカノ　木ヤ　クサニ　マケナイホド　ウツクシイノヲ　シツテ　イツソウ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月三十日　月　ドーム・ゲルツェンへ出かけたら今日はウイホドヌイ・デーニ〔休日〕だ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月十五日　水　○ ВОКС へ出かけたら、今日は女監獄はウイホドヌイ〔休日〕で見せないと云う。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分心に思えらく、ウイホドヌイだってそこは働いてるだろうのに！",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ハイツデモアツイソウデスガ、今年ハトクベツニアツクテ、三十五年カラナイホドダサウデス。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪ケレバ悪イホド怜悧デアルコトガ必須条件デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浮腫ハ脛ヨリモ足ノ甲ガ一層甚ダシク、趾ノ根モトニ近イ辺ヲ指デ押シテ見ルト、恐ロシイホド深ク凹ム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キワドケレバキワドイホドヨイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キワドケレバキワドイホドヨイ」、―――「多少疑イヲ抱カセルクライデアッテモヨイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷物ガ沢山持チキレナイホドアリマス、犬ヲツレテイタラ電報ヲ打ツカラ誰カ船マデ受ケ取リニ来テ下サイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
