        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "土地のものはこの男を相応に尊敬して、面と向つてはワシリ・イワノヰツチユさんといふが、蔭で噂をする時は、只ワシリといふ丈である。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づこんな風に称讃するのを、プラトンは聞いてゐて、なる程「記者」諸君といふものは、そんなにえらいものか、就中編輯長ミハイル・イワノヰツチユ君はそんな大人物かと、転た景慕の念に勝へなかつた。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたくしは当新聞の編輯長ミハイル・イワノヰツチユ君に対して、将来永く親交を継続いたさうと存じてをります。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミハイル・イワノヰツチユさん。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドクトル・ウラヂミル・イワノヰツチユ・ソロドフニコフといふものは亡くなるのだ。",
              "citation": {
                "source": "死",
                "author": "アルチバシェッフ・ミハイル・ペトローヴィチ　Artsybashev Mikhail Petrovich",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
