          "literary": [
            {
              "text": "そこから現代のインテリゲンツイアとしてのさまざまな要求を持ちはじめる。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも容易にどうともならぬところに、時代の特殊な色合もあり、インテリゲンツイアの特殊性もあると思はれる。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の出生、過去と現在、自分の才能、卒業後のインテリゲンツイアとしての自分の生活、それらについて思ひをひそめた末に、最近十年間の自分を敢て一擲して、違つた道から新しく踏み出して見ることを考へたのであつた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が歸農したことで困難なインテリゲンツイアの問題が忽ち他人事になつたなどと考へるわけにはいかなかつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の所彼にとつて問題はなほ農村に於けるインテリゲンツイアの問題の面を持つてゐる。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
