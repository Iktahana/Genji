[
  {
    "uuid": "c7ad7eaa-703d-5a54-bd08-2cee5bd90e3a",
    "entry": "鋳込む",
    "reading": {
      "primary": "いこむ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
