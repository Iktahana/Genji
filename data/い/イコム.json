    "definitions": [
      {
        "index": 1,
        "gloss": "to cast in a mold (mould)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "職人は溶けた銅を型に鋳込み、梵鐘の表面に細かな文様を浮かび上がらせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "工場では鉄を鋳込んでエンジン部品を成形する工程が、一日に何百回も繰り返されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "金属を型に鋳込む際は温度管理が難しく、少しでも冷えると気泡が入ってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "さりとて信仰なしに宗教の規範や形式に自身を鋳込むのも空々しかったし、何か学術の研究に没頭するというのも、柄にないことであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼等は、残飯桶の最後の一粒まで洗面器に拾いこむと、それを脇にかかえて、家の方へ雪の丘を馳せ登った。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もがけば、もがくほど喰いこむ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "刹那に、躍り出た仲間は娘を車中へさらいこむ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "短い日に戸をたてる信子は舞いこむ木の葉にも慴えるのだった。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの男はこうと思いこむと事情も顧みないで実行に移る質だ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくはその瞬間彼女を浮気な女だと思いこむことを止そうと思った。",
              "citation": {
                "source": "ひとりすまう",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、彼女が意識的に彼を誘惑したので無いとすれば、そう思いこむことは、そんなに自らをいつわることにならなかった筈と思われる。",
              "citation": {
                "source": "ひとりすまう",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしがそのストーブの下にはいこむと、すっかりからだがかくれてしまうんだ。",
              "citation": {
                "source": "雪だるま",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "はき出したあとで口をあけて空気をすいこむと、これはまた、なんという爽快なことだろう！",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、蟇口をしまいこむなり、そこへ這いつくばって虎杖を喫いだした。",
              "citation": {
                "source": "虎杖採り",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尼になる気持で……などと云うたら口を縫いこむぞといいきかされていた美津子は、いけしゃあしゃあと、わてとあんたは元から許嫁やないのといった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "中毒で人一人殺したのだから、最悪の場合は死刑だとふと思いこむと、順平はもう一心不乱に南無阿弥陀仏、と呟いていた。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "物も言わずに突き膝で箪笥の方へにじり寄り、それをしまいこむその腰のあたりを見ると、安二郎はなぜかおかしいほど狼狽して、しぶしぶ承知した。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな恥かしいところを見られたので自分は嫌われたと思いこむと、豹一はもう紀代子に会う勇気を失ってしまった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥さまが、我慢できなければ、他に就職の途を見つけるとして）と、唇にしみじみ山の気を吸いこむと、どうやら彼女の気持は明るくなったような気がした。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "尼になる気持で……などと言うたら口を縫いこむぞといゝきかされていた美津子は、いけしゃあ／＼と、わてとあんたは元から許嫁やないのといった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "中毒で人一人殺したのだから、最悪の場合は死刑だとふと思いこむと、順平はもう一心不乱に南無阿弥陀仏、南無阿弥陀仏と呟いていた。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて物も言わずに突き膝で箪笥の方へにじり寄り、それを蔵いこむ、その腰のあたりを見ると、安二郎はおかしいほど狼狽した。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "組版にさいしても、たとえば大文字のＶとＡがならんだ場合は、ＡがＶの横腹に喰いこむくらいきつく詰めて組むというように、隣接する二文字のボリュームにおうじた字間距離が厳密にさだめられている。",
              "citation": {
                "source": "本はどのように消えてゆくのか",
                "author": "津野海太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "駝鳥が一つの機能の働きだけを隠すことによって、全体を隠し得たと思いこむのと反対に、私は一つの機能だけを働かすことによって、私の全体を働かしていると信ずることが屡※ある。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮面の男は、右手にピストルをもったまま、左手で受けとってはポケットの中へしまいこむ。",
              "citation": {
                "source": "探偵戯曲　仮面の男",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいじょうぶだよ」　拾いこむようにして娘を乗せると、奇怪な舟は艫音を急がせながら、ぐんぐんと大川を上へのぼりました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこにいるから、舞っておいで」　夕ばえ近い町を、伝六は左へ、名人は右へ、――お奈良茶漬宇治料理とかいたのれんが、吸いこむように右門の姿をかくしました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "やまがら美人影絵",
                "note": "青空文庫"
              }
            },
            {
              "text": "床にたたんでおいてあった、じぶんのソフトケースを開き、ギターをしまいこむ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "くだらないインチキやりやがって」「いっただろう、だまされるほうが悪いんだ」　高志はそういって、深く煙を吸いこむ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
