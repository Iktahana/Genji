          "literary": [
            {
              "text": "「イリアツド」は神々のゴシツプである。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "太古の民は「イリアツド」に彼等の歓びや悲しみや苦しみを感ぜずにはゐなかつたであらう。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間世界夜明けの詩は、ホーマーのイリアツドであるとすると、人類終末の詩は、だれかによつて何等の形で出現するかも知れない。",
              "citation": {
                "source": "今日は無事",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            }
          ]
        }
