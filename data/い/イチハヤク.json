[
  {
    "uuid": "fd8078b4-85c5-5990-8998-01a42c8801af",
    "entry": "いち早く",
    "reading": {
      "primary": "いちはやく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
