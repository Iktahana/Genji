      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "promptly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その情報をいち早く手に入れた企業が競争で優位に立つ。",
              "source": "幻辞"
            },
            {
              "text": "新製品の情報がいち早くメディアに報道された。",
              "source": "幻辞"
            },
            {
              "text": "災害が発生した場合、いち早く避難することが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "市場の変化にいち早く対応できた企業は成功した。",
              "source": "幻辞"
            },
            {
              "text": "彼はいち早くその機会に気付いて、すぐに行動した。",
              "source": "幻辞"
            },
            {
              "text": "新しい法律の施行にいち早く対応した自治体が表彰された。",
              "source": "幻辞"
            },
            {
              "text": "いち早くその事実を報告しなかったため、被害が拡大した。",
              "source": "幻辞"
            },
            {
              "text": "技術革新にいち早く取り組む企業が業界をリードしている。",
              "source": "幻辞"
            },
            {
              "text": "季節の変わり目をいち早く感じるのは、自然愛好家だ。",
              "source": "幻辞"
            },
            {
              "text": "危機状況をいち早く察知できる人は、優れた指導者である。",
              "source": "幻辞"
            },
            {
              "text": "その報告書をいち早く提出した部門が評価を受けた。",
              "source": "幻辞"
            },
            {
              "text": "いち早く決断を下すことが、経営者に求められる資質だ。",
              "source": "幻辞"
            },
            {
              "text": "トレンドをいち早くキャッチした広告代理店が受賞した。",
              "source": "幻辞"
            },
            {
              "text": "問題をいち早く発見して対処することで、大事に至らなかった。",
              "source": "幻辞"
            },
            {
              "text": "新しい学習方法にいち早く対応した教育機関が注目を集めた。",
              "source": "幻辞"
            },
            {
              "text": "業界の動向をいち早く分析することが、戦略立案の鍵となる。",
              "source": "幻辞"
            },
            {
              "text": "その変化にいち早く気付いた投資家は利益を得た。",
              "source": "幻辞"
            },
            {
              "text": "環境問題への対応にいち早く取り組む企業が増えている。",
              "source": "幻辞"
            },
            {
              "text": "いち早く情報を共有することで、チーム全体の効率が向上した。",
              "source": "幻辞"
            },
            {
              "text": "科学の進歩にいち早く適応できる組織が未来を切り拓く。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "棚倉はいち早く逃げる。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この棟にかゝる蔦はいち早くもみぢしよう。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "終戦後の京都にいち早く出来た新しい設備は、キャバレーだ。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」手をたたいて婆を呼べば、婆はいち早く座敷の不首尾に気附いて、ことさらに陽気に笑いながら座敷に駈けつけ、「まあ、お旦那。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本はいち早く科学の暴力を察して、進んで之を学び取り、以て自国を防衛し、国風を混乱せしめる事なく、之の消化に成功し、東洋における最も聡明な独立国家としての面目を発揮する事が出来た。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの人々がその家族を遠い田舎に、いち早く疎開させているのを、うらやましく思いながら、私は金が無いのと、もう一つは気不精から、いつまでも東京の三鷹で愚図々々しているうちに、とうとう爆弾の見舞いを受け、さすがにもう東京にいるのがイヤになって、一家は妻の里へ移転した。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけに、悪口祭の「佐助どんのアバタ面」云々の一言は一層こたえて、佐助の臓腑をえぐり、思わず逃げたのだが、「あ、佐助様、どこへ行かれます」　と楓が追いつくと、さすがに風流男の気取りを、佐助はいち早く取り戻して、怪しげな七五調まじりに、「楓どの、佐助は信州にかくれもなきたわけ者。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、楓はいち早く気づいて、「あッ、佐助様！",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "多治見にいち早く私たちを出迎えてくれて、それから中津川に着くまでの汽車中を分時も宣伝の饒舌を絶たなかった、いささか豸へんの恵那峡人Ｙという、鼻の白くて高い痩せ形の熱狂者が、いつのまにか掻き消すようにいなくなったものである。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "米国はいち早く東洋艦隊を急派して、医療具、薬品等を横浜へはこんで来ました。",
              "citation": {
                "source": "大震火災記",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この答はいち早く決断して言いしにあらず。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「幾階か持ちて行くべき」と鑼のごとく叫びし馭丁は、いち早く登りて梯の上に立てり。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、お父さんのゆだんを見すまして、いち早くにげ出してしまいました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "一、アラジンとふしぎなランプ",
                "note": "青空文庫"
              }
            },
            {
              "text": "新子も、それを幸いに、妹と一しょに二階へ上ると、いち早く寝衣に着かえて、床の上に四肢をのばした。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "欧米の国々がいち早く工業化に乗りだし、植民地を拠点に経済圏を大きく拡大していく中で、文書を効率よく処理する要求はますます強まっていきます。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルチメディアで実際に何ができるか、いち早く形にして見せたこの作品は、関連の会議やイヴェントでしょっちゅう紹介されていたことを記憶しています。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "参考図書の類を作る際は、紙ベースでもいち早くコンピューターの利用が進んだとはいえ、データを電子本の形式に整える際には手間がかかったでしょう。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "エキスパンドブックを読み、ツールキットを使ってみて自分が感じた可能性を、いち早く確信した人がいる。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにそう書くにとどまらず、木津田さんはネットワークによる電子本の流通にいち早く乗り出していったのです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう考えていたリックライダーは、もう一方でコンピューターをネットワークして使うことことで生じる〈共有感覚〉の目覚めにも、いち早く気づいていました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネットワークの黎明期からいち早く情報共有化を実践し、いわば〈インターネットの精神〉を先取りしてきたこの試みは、皮肉にも、鐘と太鼓で情報ハイウェイが囃されるまさにその時期になって切り捨てられました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "エキスパンドブックは、文章を画面で読んでもらうことにいち早く本気で取り組み、頁形式の仕立てやアンチエイリアスといった技術を積み上げてきました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにＢＴＲＯＮの静かなデビューに加えて、二十四時間世話焼きマシンへの模索が始まっている今、ＴＲＯＮがこの課題にもいち早く答えを提出していることをオレは思い出してしまう。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "池田敏雄さんはこうした力学にいち早く気づき、自らの奔放な発想を押し殺すドラマを演じた人だった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの時ボーッと考えていた道筋に、この小道具はいち早く一歩を踏み出したように思えたからだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "アプリケーションの書き手としての立場もあるマイクロソフトとしては、Ｗｉｎｄｏｗｓでやりたいことをいち早くきれいにやってみせたマックにはやはりプログラムを書いてみたい。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "此答はいち早く決斷して言ひしにあらず。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と鑼の如く叫びし馭丁は、いち早く登りて梯の上に立てり。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らはいちはやく水中眼鏡と鉤針を用意する。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本社のいちはやく探知するところによればツェ氏は数日前よりはりがねせい、ねずみとり氏と交際を結びおりしが一昨夜に至りて両氏の間に多少感情の衝突ありたるもののごとし。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
