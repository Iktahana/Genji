        "examples": {
          "standard": [
            {
              "text": "式場では皆で祝い歌を斉唱し、雰囲気が盛り上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子どもたちが祝い歌を元気よく歌う姿は微笑ましい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その祝い歌は、この地域で何世代にも渡って受け継がれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
