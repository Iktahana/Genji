            {
              "text": "小泉八雲　小サイ可愛イママサマ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "サヨナラ、可愛イママサマ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻を愛称して『小サイ可愛イママサマ』と呼んでるヘルンは、同時にいかにまた子煩悩であったかが解る。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　ハジメテ　ミル　セカイガ　イママデト　チガツテ　ピカピカ　ヒカツテ　ヰタカラデ　アリマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナルホド、イママデ　キヅカズニ　ヰタガ、カナヅチハ　クワヲ　ツクル　コトガ　デキルノダナ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　イママデ　ウツカリシテ　ヰタケレド、ワタシノ　セナカノ　カラノ　ナカニハ　カナシミガ　イツパイ　ツマツテ　ヰルデハ　ナイカ」　コノ　カナシミハ　ドウ　シタラ　ヨイデセウ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダ、龍宮城デ千年ノ間、若イママデ暮ラセルカ、阿弥陀様ノ極楽浄土ヘ行カセテモラエルナラ、別デスガネ」と答えました。",
              "citation": {
                "source": "手紙",
                "author": "一八九三年七月二二日付　チェンバレン　宛",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨片ニ関スル無題李箱　ヨクモ血ニ染マラナイデ白イママ　ペンキ塗リノ林檎ヲ鋸デ割ツタラ中味ハ白（木）イママ　神様ダツテペンキ塗リ細工ガお好キ――林檎ガイクラ紅クテモ中味ハ白イママ。",
              "citation": {
                "source": "骨片ニ関スル無題",
                "author": "李箱",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
