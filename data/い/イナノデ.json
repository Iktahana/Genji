          "literary": [
            {
              "text": "負ケズ嫌イナノデ、家ヘ来テカラ勉強シテフランス語ヤ英語モ片言グライハシャベレルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ戒名ハ琢明院遊観日聡居士、婆サンノ戒名ハ静皖院妙光日舜大姉デアルガ、予ハ日蓮宗ガ嫌イナノデ、浄土カ天台ニ変エタイト思ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆ヤハ通イナノデ夕方水ダケ張ッテオイテ帰リ、瓦斯ニ火ヲ付ケルノハワレワレノウチノ誰カナノダガ、今夜ハ時分ヲ見計ラッテ郁子ガ付ケタ）ヘ行ッテ倒レタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
