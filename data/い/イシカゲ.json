          "literary": [
            {
              "text": "そしてさういふ石陰の深みの一つに赤蛙は落ち込んでゐるのだつた。",
              "citation": {
                "source": "赤蛙",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "辛うじて浮いてゐるに過ぎぬやうだが、それが彼の必死の姿であることは、彼の浮いてゐる石陰のすぐ近くには渦巻があつて、絶えずそこへ彼を引きずり込まうとしてゐることからもわかるのだつた。",
              "citation": {
                "source": "赤蛙",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「押開いて来ませ、我や人妻、………」「鮑さだをか石陰子よけん、………」「りらららりるろ、………」そのあとはみんな勝手に、てん／″＼ばら／＼に好きなことを我鳴り散らして、誰も他人の云うことなんぞに耳を傾ける者はなかった。",
              "citation": {
                "source": "少将滋幹の母",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "辺地に近い石かげへ、短い竿で蠅をさした鈎を投げ込んだ。",
              "citation": {
                "source": "ザザ虫の佃煮",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
