[
  {
    "uuid": "2696e89c-64bd-54aa-b6a3-2835c02319cd",
    "entry": "いぶし銀",
    "reading": {
      "primary": "いぶしぎん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
