    "definitions": [
      {
        "index": 1,
        "gloss": "two days before yesterday",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「一昨昨日の出来事なのに、まるで昨日のことのように鮮明に覚えている。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「一昨昨日の会議で決まったことは、もう実行に移されていますか？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「一昨昨日は友人たちと山登りに行ったんだ。すごく楽しかったよ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "丁度一昨昨日の朝、一寸した用事で家から大学校の小使室まで参りましたのですが、ついそのフゥフィーボー博士の講義につり込まれまして昨日まで三日というもの、聴いたり落第したり、考えたりいたしました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨昨日、あの婆さんから、幾らもらったかね？",
              "citation": {
                "source": "街底の熔鉱炉",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "椙田君すぐ怒つてね、制裁を加へる必要があると云つて一昨昨日の晩、神学部の裏で塚本君を擲つたさうです。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨昨日捕えたつくつく法師の死骸であった。",
              "citation": {
                "source": "桜島",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘はさきおととい行くえ不明となった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "石燈籠",
                "note": "青空文庫"
              }
            },
            {
              "text": "「実はさきおとといの午まえに、小柳と二人で浅草へ遊びに行ったんです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "石燈籠",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきおとといからの流連でも、自分が恐れていたほどに金は懸からなかった。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのうもおとといも、さきおとといも、はいり込んでいたというが本当かえ。",
              "citation": {
                "source": "両国の秋",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "って云ってたもの、可哀そうに――「それもそうね、　さきおとといの朝六時にお起しって云って置いたんできっちり六時が鳴ると私の処へ来て肩をゆすりながら、　貴方様、お置き遊ばせ。",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日も、おとといも　又さきおとといも私は部屋から声をきいた。",
              "citation": {
                "source": "五月の空",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シベリア鉄道は、一週のうちきまった日にしか通っていないのだから、さきおとといのように多計代からの手紙だけが一通別に届くということはあり得なかった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきおとといの雨は、つめたかった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきおとといの雨の闇夜、大岡家を飛び出して、二人とも、濡れ鼠の姿で、懐中のあてもなく、ここへ揚がッてしまってからの、続きであった。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの晩きりだって」「どうしても、市の字に会わせろというので、大岡家へ連れて行ったさきおとといの晩からさ。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こらっ、貴様あ、かんかん虫のトム公だな」「さきおととい、調べてもらったばかりだ」「でも一応は、住所年齢を聞くんじゃ。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきおとといの二十九日の夜から、そこは右大臣信長の宿営となり、彼らにとっても、この日本で一番怖い人間が、つい目と鼻のさきに逗留しているからである。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君は、さきおとといの晩、お湯にはいったあとで、北村君のところへ、模型飛行機の設計の相談に行ったんだってね。",
              "citation": {
                "source": "智恵の一太郎",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだのに、さきおとといの晩にかぎって風をひいたのはなぜだろうね」　そういわれて、一太郎君もわけがわからなくなって来ました。",
              "citation": {
                "source": "智恵の一太郎",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきおとといの晩、お湯から出ると大いそぎで服を着た。",
              "citation": {
                "source": "智恵の一太郎",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
