[
  {
    "uuid": "18a24632-8449-524f-8977-47fbe1dc6b12",
    "entry": "愈",
    "reading": {
      "primary": "いよいよ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "more and more",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "試験が近づくにつれて、愈緊張が高まってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の歌声は、聞けば聞くほど愈心を惹きつける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夕焼け空は、時間が経つにつれて愈赤く染まっていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "昨年の秋に、私が或る雜誌に犬のことを書いたら、二、三の知人から大いに面白かつたと褒められて、その作品は、實に粗末なものでしたので、私は愈々恥ぢて、それ以來、犬の話は努めて避けてゐました。",
              "citation": {
                "source": "このごろ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "天は愈よ明るい、氷の海は一層の白を加うると共に、一分の硬味を減じて来た雪になったのである、玉屑累々ともいうべき空に懸れる雪の大路を無形の手で、橇を縦横に掻き廻しはじめたと見え、捏ね返した痕跡が割れ目を生じたころは、雪は一方に堆く盛り上られ、一方では掬われたようにげっそりと凹む。",
              "citation": {
                "source": "奥常念岳の絶巓に立つ記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "愈々どん詰りまで行けゃあ、俺だって虫けらた違うんだからな。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "余り帰りが遅くなるので、秋山の長屋でも、小林の長屋でも、チャンと一緒に食う筈になっている、待ち切れない夕食を愈々待ち切れなくなった、餓鬼たちが騒ぎ出した。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼病を得て処世上正則の進行を妨げらるるに及びては、愈私心的自己の希望を絶対に捨てねばならぬ事になった。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "愈ゆくまいと云う気にはどうしてもなられない。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたたび内をのぞいた　下駄もさきに見た通りでかわらない　愈ほんとうの決心がでて門前を東へ過ぎて吾躰を運転した。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お松も家を出て来る時には、一晩泊るつもりで来たものの、来て見ての様子で見ると、此の上一晩泊ったら、愈別れにくくなると気づいて、おそくも帰ろうとしたのだが、自分が少しもお松を離れないので、帰るしおが無かった。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「三次、愈々年貢の収め時だね」　三次ドキッとなったが、そ知らぬ態で「何ですかい、藪から棒に」と白ばくれる。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "三次が、Ｔ「愈々明日は敵討で御座んすね」　と云われて、流石に嬉しさ包み切れぬ三四郎です。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "平土間の客は愈々騒々しい。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云うんじゃ　ないでしょう」　雪枝も不審そうに、Ｔ「確か昨夜　柏木と仰有ったが」　聞いた半次愈々訳分らぬ。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "半次、愈々不審そうな顔。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　愈々面喰う一同。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「さすれば源兵衛貴様は打ち首」　と言われて源兵衛愈々困り果てる。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「どうせ紙屑屋から掻ッ払ったボロ紙一枚で」　と愈々辛らつだ。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレッ、と左膳愈々驚く。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、団九郎、女の見て居る前で、断然男ッ振りを上げて、　おしまは、愈々、此の日本一の先生が好きになったと言った顔で、頼もしそうに団九郎の顔を惚れ惚れと見上げました。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "愈※だ――と云ふ衝撃が私をぎくりとさせた。",
              "citation": {
                "source": "疑惑",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨年の夏も他の女中から小田原のお婿さんなど嬲られて居たのを自分は知つて居る、あゝ愈々さうだ！",
              "citation": {
                "source": "湯ヶ原より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "お絹の話が出て、お絹は愈々小田原に嫁にゆくことに定まつた一｜條を聞かされた時の僕の心持、僕の運命が定つたやうで、今更何とも言へぬ不快でならなかつた。",
              "citation": {
                "source": "湯ヶ原より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "愈※平地を離れて山路にかゝると、これからが初まりと言つた調子で張飛巡査は何處からか煙管と煙草入を出したがマツチがない。",
              "citation": {
                "source": "湯ヶ原ゆき",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "山深く、里幽に、堂宇廃頽して、愈活けるが如く然る也。",
              "citation": {
                "source": "甲冑堂",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斉の賢人の管仲の書に、悪女怨気を盛るといふ語が有りまするが、醜婦が怨みの心を抱いた人相などは有り難くない者の頂上で、愈※悪い相になりませうが、いくら悪女でも仁心を抱いて居れば必ず見づらいものでは有りませぬ。",
              "citation": {
                "source": "運命は切り開くもの",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいえ、でも、その青蚊帳に写した幻燈のような、ぼやけた思い出が奇妙にも私には年一年と愈々はっきりして参るような気がするのでございます。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「愉快々々、談｜愈々佳境に入って来たぞ、それからッ？",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「愈々以て謎のようだ！",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「愉快々々、談愈々佳境に入って来たぞ、それからッ？",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに彼の精神は、感性の新鮮に泣いたのですし、いよいよ泣かうとしたのです。",
              "citation": {
                "source": "宮沢賢治の詩",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ金性の肉のおとろへ、みやま瀧ながれ、青らみいよいよおとろふ、いのれば銀の血となり、肉やぶれ谷間をはしる。",
              "citation": {
                "source": "偏狂",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
