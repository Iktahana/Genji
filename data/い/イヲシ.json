        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレデ、田舎ノ景色バカリカイテヰルノニアキテ、街ノシヤセイヲシヤウト思ツテ、街ニキマシタガ、田舎者ノ玉ネギサンハ道ニマヨツテシマヒマシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、いきなりキジマツトムハ、キミヲシリマセン、エイエンニ、キミヲキミダト、シラナイソシテ、カレハ、ジンセイヲシリカミトナツテ、ショウテンスル、キミニ、シュクフクアレ、ココロカラ、アリガトウＧ「そのＧと言うのが、Ｍさんと言う人じやない？",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕モ番ニ行ッタケレドモ今年カラ田植エノ手伝イヲシタノデ腰ガ折レソーニ痛カッタ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何モソンナ思イヲシテマデ見ニ来ルコトハナイジャアリマセンカ」ト婆サンガ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤリ損ッタッテ死ニハシナイヨ」「死ニハシナイデモ、気絶シテ今ニモ死ニソウニオナリニナッタリシタラ、ソレヲ見テルダケデモイヤダワ」「コンナ思イヲシテ生キテルクライナラ死ンダッテイヽサ」予ハ殊更ニ悲壮ラシク云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナドト胡麻化スノデハナイガ、余計ナオセッカイヲシテ悪カッタラ詑マリマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
