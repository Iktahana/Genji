          "literary": [
            {
              "text": "此は関家で熊狩に雇って置くアイヌのイコサックルが小屋で、主は久しく留守なのである。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（イコサックルは何を悲観したのか、大正元年の夏多くの熊を射た其鉄砲で自殺した。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月、土人イコサックル我牧塲内の熊害を防ぐ為めに居ると定めて、橋畔に小屋をかける。",
              "citation": {
                "source": "関牧塲創業記事",
                "author": "関寛",
                "note": "青空文庫"
              }
            }
          ]
        }
