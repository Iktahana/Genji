        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "此外に、イヨヽヽ・ウタヽが出てゐる。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすれば、此もイヨヽヽ・ウタヽと訓じてよい訣だ。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "転・倍共にイヨヽヽと註するのは、当然である。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへば、イヨヽヽ・マスヽヽを、ウタヽと言ふ日本語で、其を訳し分けて訓をつけると、全く別の用語例にあるものと見える。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが実は、ウタヽとイヨヽヽとの間には、其ほどの区別はないのである。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "倍の字が、イヨヽヽの意義を持つてゐることは言ふまでもない。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "即、ウタヽとイヨヽヽとがある時期には、一つの意義をめぐる隣接語だつたのである。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
