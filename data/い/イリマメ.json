[
  {
    "uuid": "7b54740f-d650-52e1-9a3b-e6972ece165b",
    "entry": "煎り豆",
    "reading": {
      "primary": "いりまめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "parched or roasted beans (or soybeans)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お茶請けに、香ばしい煎り豆をポリポリとつまんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この煎り豆、昔ながらの味で懐かしいな」祖母は微笑んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は、自家製の煎り豆を友人にプレゼントした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "塩でまぶしたあの煎り豆さ」「なるほどね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "京人形大尽",
                "note": "青空文庫"
              }
            },
            {
              "text": "荻生徂徠　荻生徂徠は煎り豆を噛んで古人を罵るのを快としている。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは彼の煎り豆を噛んだのは倹約の為と信じていたものの、彼の古人を罵ったのは何の為か一向わからなかった。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "荻生徂徠　荻生徂徠は煎り豆を噛んで古人を罵るのを快としてゐる。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは彼の煎り豆を噛んだのは倹約の為と信じてゐたものゝ、彼の古人を罵つたのは何の為か一向わからなかつた。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代尚屡、行はれる歯痛のまじなひで、「此豆に芽の出るまでは、歯の虫封じを約束しました」と言つた風の言ひ方で、煎り豆を土に埋める様な風習も、単に神を所謂｜詭計にかける訣でなかつた。",
              "citation": {
                "source": "「ほ」・「うら」から「ほがひ」へ",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「煎り豆に花の咲くまでは、下界に来るな」と鬼を梵天国に放つた百合若伝説が、稍古い形を見せてゐる。",
              "citation": {
                "source": "「ほ」・「うら」から「ほがひ」へ",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうじき御飯だというのに、また煎り豆を出して食べおるわい。",
              "citation": {
                "source": "風波",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "これじゃ子供に食いつぶされてしまうわ」　彼の孫娘の六斤はちょうど、一掴みの煎り豆を握って真正面から馳け出して来たが、この様子を見て、すぐに河べりの方へ飛んで行き、烏臼木の後ろに蔵れて、小さな蝶々とんぼの頭を伸ばして「死にそこないの糞婆」と囃し立てた。",
              "citation": {
                "source": "風波",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "喰べたくないときにやる弁当の礼で、このあいだは鯖の味噌煮と煎り豆腐と、菜の胡麻よごしだったけれど、あんなにうまい物を喰べたのは生れて初めてで、喰べながら涙が出てしようがなかった。",
              "citation": {
                "source": "へちまの木",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おやおや、おそれいりまめ。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、おそれいりまめ女史は、平気でそれをやった。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
