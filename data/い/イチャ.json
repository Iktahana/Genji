  {
    "uuid": "f963c07e-143e-53c6-b024-0f567f5a72e4",
    "entry": "イチャ",
    "reading": {
      "primary": "いちゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "淋しそうな顔をしているから、ハイチャイ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなに好きでもない女の人には、カクランだの、ハイチャイだの、ばかにしたような綽名をどしどしつけるが、いいひとに対しては、どんな綽名も思いつかず、ただ、竹さんだのマア坊だのという極めて平凡な呼び方しか出来ないのだからね。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミイチャンハアチャンともいうし、チンピラともいうし、また、トッピンシャンともいうんだ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "別れ話だの何だのと言って、またイチャつきたいのでしょう？",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はニイチャの哲学が恐らくは裁判長から暗示を受けているものであることを主張する。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ライチャウスみたいじゃねえか」　ライチャウス・ブラザーズ・ファンの高志が、つまらなそうにいった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「浅井、ライチャウスもってるの？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "張赫宙は朝鮮にハイチャをして東京で文学の峠をのぼりだしたズルズルとすべる文体に警戒し給へ。",
              "citation": {
                "source": "小熊秀雄全集-12",
                "author": "詩集（11）文壇諷刺詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "待っていたようにハイチャイ極め込む。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで吾輩のこの世に於ける用事もハイチャイを告る事になるのだ……と云ったら又、頭のいい痴呆患者が出て来て……そんならイヨイヨ発狂自殺だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニャさんハイチャイだ。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "異性を批判し、玩味し、イヤになったらハイチャイをきめていい権利を、男と同じ程度に振りまわしている。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の通りに白壁のように塗り立てた夫人とクッつき合って、傍若無人に大きな口を開いてノベツに笑っていたが、その間夫人は沼南の肩を叩いたり膝を揺ったりして不行儀を極めているので、衆人の視線は自然と沼南夫妻に集中して高座よりは沼南夫妻のイチャツキの方に気を取られた。",
              "citation": {
                "source": "三十年前の島田沼南",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも、こんな化け物でも、人間のはしくれであってみれば、人前でイチャツクことはできねえと言うのなら、おらア、ドロドロと消えるとしよう。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チャンチンコイチャン！",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "エイチャイピーラの唄＝事務所の茶＝クベルパルトコンフェレンスのトリビューンにもさじのついた茶のコップの写真が出た。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その坊主頭の盲目のおばあさんが、キンボウとヤイチャンを前にならべて、銹た渋いのどで唄の素稽古をする。",
              "citation": {
                "source": "神田附木店",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "お父様のアイチャンキャラ侯は、たつたひとりぽつちのニナール姫が、淋しいだらうと、従兄に当るジウラ王子を蒙古から呼びよせ、そのお相手になさつたのです。",
              "citation": {
                "source": "ラマ塔の秘密",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラマ塔は昔、このお城がラマ仏教のお寺であつたとき、建つた、ずゐぶん古るいものですが、アイチャンキャラ侯の先祖が、これを取つてからのち、或時、外敵にせめられて、一時これを占領されたことがありました。",
              "citation": {
                "source": "ラマ塔の秘密",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイチャンキャラ侯はアルライが広間へはいつてくると、眉をつり上げて雷のやうな声で叱りつけました。",
              "citation": {
                "source": "ラマ塔の秘密",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてね、お姉えチャン美人ねえハイチャ、だって。",
              "citation": {
                "source": "発掘した美女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "水戸の容疑者がヘイチャラな顔をして、アア、帝銀の問題ですか、と笑って云ったというのは、真犯人でなければ、それが当然そうあるべきことなのである。",
              "citation": {
                "source": "切捨御免",
                "author": "――貞操なきジャーナリズム――",
                "note": "青空文庫"
              }
            },
            {
              "text": "怖れをなしたのはサルトルの方で、「あなた、そんなに召しあがっていいのですか」「ヘイチャラよ。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、女の子とイチャつきながら、タイトルはとれないぜ。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレは今夜、さむい夜汽車にゆられて帰るが、同じ時間に女房が男とイチャついていると思うと、なさけねえな、と。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんでも、ヘイチャラなのね。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "落語の中の八さん熊さんにしても、なア、おッかア、あのナマグサ坊主とイチャつくのは、やめてくれねえかなア、と諫めた話はあんまり聞かないが、特に長幼の序が人生の万事を律している特殊な社会で、しかも生れながらに唯一絶対の現人神たる上皇に向って、礼なき言葉が発せられるとは思われない。",
              "citation": {
                "source": "安吾史譚",
                "author": "道鏡童子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ庄内でも鶴岡ではこれをコバイチャというそうな。",
              "citation": {
                "source": "春雪の出羽路の三日",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
