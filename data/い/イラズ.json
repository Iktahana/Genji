        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日本、ネコイラズ、中国黄燐マッチ……」「ふむむ、……それだけ日本語が分りゃ、話が出来るじゃないか。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬屋で猫イラズを買い、天王寺公園にはいり、ガス灯の下のベンチに腰かけていた。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "叢の中にはいり、猫イラズをのんだ。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人が共に非常に可愛がっていた三毛猫が何処かで猫イラズでも喰べたらしく、その朝、外から帰って来ると、黄色い塊を吐いて、やがて死んでしまった。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "増上慢はネコイラズみたいなものだ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその時隠し持つてゐた猫イラズを、追手の眼の前で嚥み、更に御丁寧にも、釣橋の上から身を躍らして、真逆様に谷の激流に身を投げこんだ。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "源は若い男の幽霊ではあるまいかと驚ろいた、若い土工夫は確に猫イラズを嚥みはした、然し彼は次いで渓流の過の中で、鱈腹水をのんだのであつた、そのために却つて腸のなかを洗滌したことになり、岸に流れついて助かつたのだといふ、源はふんと首を傾しげ成程と合点した。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あれは最近大流行を致しておりまする猫イラズで自殺を遂げた芸妓の胃袋の中のものが、硝子の皿の中から燐光を放っているので御座います。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫イラズも何も這入ってやしないよ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナ奴が生命の親様なら、猫イラズは長生の妙薬でしょう。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この肉に女中さんが猫イラズを入れたから、私が鼠の通る道へ置きに行くんだよ。",
              "citation": {
                "source": "どろぼう猫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫イラズを使う位なら貴様がいなくてもいいのだ。",
              "citation": {
                "source": "どろぼう猫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもそのチョンガレの頭蓋骨が掘り出されると、噛み締めた白い歯が自然と開いて、中から使いさしの猫イラズのチューブがコロガリ出たので皆ゾッとさせられた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ中毒でも猫イラズなどよりはダイヤモンドの方が上品な気がする。",
              "citation": {
                "source": "毒と迷信",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなこと言っているとまた猫イラズだよ」　娘さんは笑いだした。",
              "citation": {
                "source": "石ころ路",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京に女中奉公していたとき、猫イラズをのんだという。",
              "citation": {
                "source": "石ころ路",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときの娘の眼にはある閃めきがあり、どっかに猫イラズを前にした時の彼女の姿が感じられた。",
              "citation": {
                "source": "石ころ路",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おむすびヲツクツテ、ネズミイラズニ入レテオキマス。",
              "citation": {
                "source": "母子ホームの子供たち",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "花亭も来た当日から亭主のように納って水イラズの食卓であるが、正二郎はその日から台所へ追ッ払われて、召使いと一しょの食事であった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "食物の中へ猫イラズを仕込んでやるから覚えてろ！",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫イラズにしやうか、瓦斯管を頬ばらうか、いつそ身投げにしてくれやうか。",
              "citation": {
                "source": "金談にからまる詩的要素の神秘性に就て",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで妹の方をかたづける必要があって親戚に当る五十とか六十とかの老人のところへ嫁入りということになり、妹が猫イラズを飲んだ。",
              "citation": {
                "source": "白痴",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "カリカリゴソゴソいう音がほとんど減らなかったところを見ると、猫イラズは大して効かなかったようだ。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫イラズが無駄だったことに半狂乱になったドンブロウスキは、ここを貸出そうという考えをきっぱりと捨て、一週間のうちに昔からの店子ともどもウォルナット街にある見窄らしいがもうちょっと新しい家に引っ越してしまった。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
