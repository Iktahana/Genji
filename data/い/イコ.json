  {
    "uuid": "6a407ca0-2ad3-52ff-8928-93290348695d",
    "entry": "イコ",
    "reading": {
      "primary": "いこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "乙な桜の　アラ　ナントネ粋をきかした　縁むすびスッチョイコラ　スッチョイコラ　私の耳の奧にはまだ歌が響いていた。",
              "citation": {
                "source": "祇園の枝垂桜",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に「観照」と「表現」とは同字義であり、したがってまたそれが「芸術」とイコールである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に「詩」と「主観」とは、言語に於てイコールであることが解るだろう。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由主義と内容主義とは、芸術上の言語に於てイコールである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（自由主義と女性化主義とは、必然にイコールであることに注意せよ。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一雄ハ深イ所デ泳イデモ危イコトハアリマセン。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩は鋼鉄のように硬くなりながらも、イワベンケイ、ミヤマダイコンソウ、ムカゴトラノオなど、黄紫のやさしい花を、点々とその窪洞に填めながら、ギザギザに尖っている輪廓を、無数に空に投げ掛けている。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "フントウ　ヲ　シャス、セイコー　ヲ　イノル、キカンブカフ　一ドー　セーラー　ショクンと電報文みたいに片仮名で書いてあった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "こないだの手紙に、ここの助手さんたちは、油断のならぬところがあって、男のひとたちに片端から辛辣の綽名を呈上していると言ったが、しかし、また塾生のほうだって負けずに、助手さんたち全部を綽名で呼んでいるのだから、まあ、アイコみたいなものだ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一　排日案に対して、フィルムや、化粧や、耳かくしのボイコットが問題になっている。",
              "citation": {
                "source": "鑢屑",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは悪口でなく本当にある現象である、　その次の第百九十四段及び第七十三段に「嘘のサイコロジー」を論じたものなども科学者の参考になる。",
              "citation": {
                "source": "徒然草の鑑賞",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういうことから考えてみると、この絵巻物は、一方では勧善懲悪の教訓を含んでいると同時に、また一方ではおそらく昔の戦乱時代の武将などに共通であったろうと思われる嗜虐的なアブノーマル・サイコロジーに対する適当な刺戟として役立ったものであろうと想像される。",
              "citation": {
                "source": "山中常盤双紙",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年九月三日『東京朝日新聞』）　　　　　　　　　二　　　　　　罪人を発見する器械　近頃サイコメーターすなわち測心器とでも名づくべき器械を作った人がある。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "瞬間の嬉びが永遠に悲しみとなってしまう、チャイコフスキーの狂気音楽がかくまで近代を支配する。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "独逸製のサイコロを買うと、そもまま歔欷くように円筒状の夜の大阪を感じていた。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "オニドモ　ヘイコウジユンジユンニ　タツテ　ニゲマスヤマオクヘ「待つて下さい！",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "白軍の頭領のカルムイコフは、引渡された過激派の捕虜を虐殺して埋没した。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "森の中にはカルムイコフが捕虜を殺したあとを分らなくするために血に染った雪を靴で蹴散らしてあった。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄の繊細な恐ろしい過敏な神経質なものの見かたは、いつもサイコロジカルに滲透してゐた。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ジロジロ仲蔵の定九郎を見て「ヤイコラッ」　「ハイ」と仲蔵。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "大吉、オドオドして居る仲蔵の所へ戻って、　「ヤイコラＴ「仲蔵！",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "英貨のボイコットに周章て来たとは決して言はない。",
              "citation": {
                "source": "英国メーデーの記",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "更にいかなる偶然が降って湧くか――と、章三の眼は人生のサイコロの数を見つめる人間のように血走っていた。",
