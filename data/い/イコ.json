[
  {
    "uuid": "763ddf3a-f791-5ed9-be32-326741ad0d34",
    "entry": "遺孤",
    "reading": {
      "primary": "いこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
