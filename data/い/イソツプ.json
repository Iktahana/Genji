        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イソツプにもない様な滑稽趣味がある。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「事によつたら、イソツプかも知れませんぞ。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この輩は聖書もイソツプも同じ小説で、二百年前に出来たものとでも思つてゐるらしかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛙が口をきくのは、何もイソツプの時代ばかりと限つてゐる訳ではない。",
              "citation": {
                "source": "蛙",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "イソツプの中に次のやうな寓話がある。",
              "citation": {
                "source": "流儀の定め",
                "author": "觀世左近",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
