        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「異議あり！」と検察官が立ち上がり、弁護側の証拠申請に強く反論した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "会議の途中で部長が「異議あり」と手を挙げ、コスト試算のやり直しを求めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "模擬裁判の授業で生徒が「異議あり！」と叫ぶ場面に、教室中が沸いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "正面から異議ありという魯庵を、一葉はきらいな人という自分の感情だけで見ている。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "全体として異議ありません。",
              "citation": {
                "source": "平野義太郎宛書簡",
                "author": "一九三二年二月二十六日",
                "note": "青空文庫"
              }
            },
            {
              "text": "東野ともよくこの寺院について議論をしたらしい塩野は、異議ありそうに笑いながら久慈に云った。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　語り終わるかおわらないうちに、異議あり、異議ありの声が聴者におこり、反響すこぶる大なるものあり、弁明大いに務め、相手の得心をかちうるまでには、意外の務力を要した次第であった。",
              "citation": {
                "source": "茶美生活",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "（「自分でやれ」といふ声がかゝる）皆さん、異議ありませんか。",
              "citation": {
                "source": "犬は鎖に繋ぐべからず",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "紳士諸君は、また玄米御飯で御異議ありませんか。",
              "citation": {
                "source": "花問答",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」（太宰さん、異議ありや？",
              "citation": {
                "source": "メフィスト",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "激しい恋愛だったのよ、フィリップ」　ベリントン大佐が異議ありの仕草をした。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "「妻は名誉と安全を侵害するものに対する保障並びに生活必需品の給与を失うにすぎない」　――異議あり、これが完全に近い言葉とするならば――、最初のものを妻は法律のなかに再び見い出すこともあり、また、夫は妻のために、親戚、場合によっては子供たちという形でそれを残す。",
              "citation": {
                "source": "雨の玉川心中",
                "author": "太宰治との愛と死のノート",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
