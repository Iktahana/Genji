        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こゝろよき南風に帆を張りて、忽ち永代橋、忽ち大橋、忽ち両国橋を過ぎ、柳橋より車に乗りて家に帰りつ、其得たるところを合せ数ふれば壱百三十尾にあまりける。",
              "citation": {
                "source": "鼠頭魚釣り",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――ついては、わたくしめにご官金壱百両ほどをお貸しくださりませ」　徳川もお三代のころ壱百両といえば、四、五年くわえようじで寝ていられるほどの大金なんでしたから、お奉行の目を丸くしたのは当然で――。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺が始末をして遣らうよ」　彼は遊佐が前なる用紙を取りて、蒲「金壱百拾七円……何だ、百拾七円とは」遊「百十七円？",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "九十円だよ」蒲「金壱百拾七円とこの通り書いてある」　かかる事は能く知りながら彼はわざと怪しむなりき。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを三百六十五日の一年に合計すれば、金弐千壱百〇弐円四拾銭の巨額に上るにあらずや。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "関西の軍需品製造の某資本家は、陸軍被告家族一同に対する慰問金として、陸相あて金壱百円也を寄贈した処、当局から早速家族にその旨通知すると、家族達は事件当日首相官邸で殺された某警官の遺族に之を譲ったそうである。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の母校東京専門学校の大学昇格資金に、金壱百円を寄付することが出来たのは、たしかそれから一年後であった。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "易風社はその以前謝礼として壱百円を贈り来りしが発売禁止となるも博文館の如く無法なる談判をなさざる故わが方にても重々気の毒になりいそぎ『荷風集』一巻の原稿をつぐなひとして送りけり。",
              "citation": {
                "source": "書かでもの記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "金壱百弐拾円ほどになれり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "此日兜町仲買片岡商店に依頼し置きたる株券王子製紙会社壱百株。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "猪苗代水電会社壱百株を買ふ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "春陽堂開化一夜草礼金壱百五拾余円を贈来る。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "『帝国文学』の「倫敦塔」『ホトトギス』壱百号の「幻影の盾」などを始めとして多数の作が矢つぎ早に出来た。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏目金之助　　　　　高浜清様　　　　　　○明治三十九年四月三十日（封書）　　啓　　一金参拾八円五拾銭也　　一金壱百四拾八円也　　計壱百八拾六円五拾銭也　右は「吾輩は猫である（十）」及び「坊っちゃん」の原稿料として正に領掌仕候也。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "とあるものが最初で、次は『続日本紀』の桓武天皇の延暦十八年十二月五日に甲斐国人止弥若※、久信耳鷹長等壱百九十人言フ、己等ノ先祖ハ元ト是百済人也、云々。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不昧公去って壱百年、人は逝くが今も茶碗は昔のままである。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本國民一家ノ所有シ得ベキ財産限度ヲ壹百萬圓トス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "限度ヲ設ケテ壹百萬圓以下ノ私有財産ヲ認ムルハ、一切ノ其レヲ許サヾランコトヲ終局ノ目的トスル諸種ノ社會革命説ト社會及人性ノ理解ヲ根本ヨリ異ニスルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "傷病兵慰問　其賣上高を計算して見ると約壹百圓あつた、私共は二百枚の色紙を描いた事が分つて二人で驚きの眼を見合せた。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其二十圓は若い校友達が祝賀運動會の時の賣店で働いた利益で補つてくれて、又壹百圓になる。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "又凡そ太廟宮殿等に侵入し、箭を射、彈を放つものは、三等或は四等の有期徒刑、或は壹千圓以下壹百圓以上の罰金に處すとあるが、其他帝室に關する犯罪でも、多く徒刑或ひは罰金若干と規定してある。",
              "citation": {
                "source": "支那近世の國粹主義",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
