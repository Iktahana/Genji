        "examples": {
          "standard": [
            {
              "text": "水槽のメダカのために、ペットショップで乾燥糸ミミズを買ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "川底の泥の中をよく見ると、赤い糸ミミズがたくさんうごめいていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "熱帯魚の稚魚には、栄養価の高い生き餌として糸ミミズを与えるのが良い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "近所のドブに、否、わが家のドブにすら糸ミミズが豊富であるから、朝晩これを食事に与え、その発育の目ざましさは金魚屋を驚倒せしめた。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボッタというのは糸ミミズである。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
