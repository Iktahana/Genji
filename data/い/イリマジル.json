[
  {
    "uuid": "e0216fcf-7f10-5b8f-8d82-eaf81078ccfc",
    "entry": "入り混じる",
    "reading": {
      "primary": "いりまじる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
