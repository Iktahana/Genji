        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "翌る日犬が又縁側を通ると、猫は畳の表を爪で力一パイバリバリと掻きむしっています。",
              "citation": {
                "source": "どろぼう猫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "人界の営みとはおのずからに異って、すべては山気の一端であり、クソにもイバリにも人間の卑小感は失せきっている。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
