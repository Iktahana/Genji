[
  {
    "uuid": "ff19f6f4-861e-52c2-ba30-cd7f97358256",
    "entry": "射手",
    "reading": {
      "primary": "いて",
      "alternatives": [
        "しゃしゅ"
      ],
      "is_heteronym": false
    },
    "grammar": {
