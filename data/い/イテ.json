      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "archer",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は弓道部のエース射手として、試合で活躍した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "伝説の射手は、一矢で百発百中を誇った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "森の中から現れた射手が、獲物を狙っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "……王の射手エーナール・タンバルスケルヴェはエリック伯をねらって矢を送ると、伯の頭上をかすめて舵柄にぐざと立つ。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっと射手のとこからのろしがあがるためでせう。",
              "citation": {
                "source": "〔「銀河鉄道の夜」初期形一〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また陽州の役に、顏息といへる名譽の射手、敵を射て其の眉に中つ。",
              "citation": {
                "source": "術三則",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "廿一日、戊申、将軍家、三浦三崎に渡御、船中に於て管絃等有り、毎事興を催す、又小笠懸を覧る、常盛、胤長、幸氏以下其射手たりと云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の心にもなき驕慢の擬態もまた、射手への便宜を思っての振舞いであろう。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の父は小笠原流の弓術を学んで、かつて太郎射手を勤めたこともあるというほどの達人であるから、その子の石川も弓をよく引いた。",
              "citation": {
                "source": "妖婆",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "彦次郎左近大夫二人は、一町毎に鉄砲の者十人、射手五六人｜宛伏せて、二人代る代るに殿して退こうとするが、秀吉先手の兵が忽ちに慕い寄るので、鉄砲を放つ暇もない。",
              "citation": {
                "source": "賤ヶ岳合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の日の戦闘を『太平記』なんかで考えてみると、先ず師直は本営を野崎附近に敷き、その周囲には騎兵二万、射手五百人を以て固めて居る。",
              "citation": {
                "source": "四条畷の戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたかもその時、魚銛発射手のムレアドが船首から船尾へやって来て、右舷船首にあたって奇妙な声がすると報告した。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "船員ちゅうの最年長者であり、また最も着実な、あの魚銛発射手でさえも、みんなの騒ぎに加わっているのである。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれを見てではなく、あの魔物を見たからなのだ」というのが、主だった魚銛発射手の一人の注釈であった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "迷信家の魚銛発射手の老人がまず万歳を三唱すると、船員一同は心からこれに合唱したのであった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "「以前は皇帝の印度軍に居た方で、わが東方帝国の生んだ、名誉ある最大の名射手なのです。",
              "citation": {
                "source": "空家の冒険",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は印度では第一の名射手であったが、しかしこのロンドンでも、彼の右に出ずる者は、はなはだ少なかろうと思うな。",
              "citation": {
                "source": "空家の冒険",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "君はあの時僕を妄想者だと思っただろうが、実際僕は、この恐るべき空気銃と、その後には更に畏怖すべき名射手の居ることをよく知っていたので、僕はやはりああせざるを得なかったのだ。",
              "citation": {
                "source": "空家の冒険",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは、小田原の町を、冬ならば山提灯を携えて煙りのやうな息を吐きながら、また夏ならば漸く海からの微風が白みかゝつた雨をかすめて、未だ射手座の星が光つてゐる時刻に、口笛を吹きながら出発した。",
              "citation": {
                "source": "幽霊の出る宮殿",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて射手の向うは知れたこと……。",
              "citation": {
                "source": "平家蟹",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "中でも隊長と覚しき最初の射手のあの若侍が、ぐッと癇にこたえたと見えて、気色ばみながらつかつかと近づいて来ると、俄然、火蓋を切って放ちました。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼長のそばには藤内太郎、藤内次郎という屈竟の射手が付き添うていて、手にあまると見たらばすぐに射倒そうと、弓に矢をつがえて待ち構えていた。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼長は勿論、射手の二人も山門のかげに身を忍ばせていたのであるが、早くも玉藻に覚られたらしい。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼のあたりにこのおそろしい神通力を見せられて、射手の二人も遠光も息をのんで立ちすくんでいた。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロミオ　ても偉い射手ぢゃの！",
              "citation": {
                "source": "ロミオとヂュリエット",
                "author": "ROMEO AND JULIET",
                "note": "青空文庫"
              }
            },
            {
              "text": "測量学の発達している今日、大砲の射手が目標を見て狙わなくとも、他の方法で観測した結果により、目標を見ずともうまく照準をつけることができるわけだった。",
              "citation": {
                "source": "東京要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨はまだ降るだらうかインキ壺をのぞいてニブリ加減をみよう",
              "citation": {
                "source": "（ツツケンドンに）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "空は昨日までの雨に拭はれて、すがすがしく、それは海の方まで続いてゐることが分ります。",
              "citation": {
                "source": "死別の翌日",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その空をみながら、また街の中をみながら、歩いてゆく私はもはや此の世のことを考へず、さりとて死んでいつたもののことも考へてはゐないのです。",
              "citation": {
                "source": "死別の翌日",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "みたばかりの死に茫然として、卑怯にも似た感情を抱いて私は歩いてゐたと告白せねばなりません。",
              "citation": {
                "source": "死別の翌日",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "うつらうつらと僕はする……風もある……松林を透いて空が見えるうつらうつらと僕はする。",
              "citation": {
                "source": "蝉",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝉が鳴いてゐる、蝉が鳴いてゐる蝉が鳴いてゐるほかなんにもない！",
              "citation": {
                "source": "蝉",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へば夏休みも近づかうといふ暑い日に、唱歌教室で先生が、オルガン弾いてアーエーイーすると俺としたことが、笑ひ出さずにやゐられなかつた。",
              "citation": {
                "source": "夏と悲運",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
