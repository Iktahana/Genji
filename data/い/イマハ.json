          "standard": [],
          "literary": [
            {
              "text": "イマハ山中、イマハ浜、イマハ鉄橋、ワタルゾト思ウ間モナクトンネルノ、闇ヲトオッテ広野ハラ、どんどん過ぎて、ああ、過ぎて行く。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "イマハ山中、イマハ浜、――童女があわれな声で、それを歌っているのが、車輪の怒号の奥底から聞えて来るのである。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "イマハ山中、イマハ浜、イマハ鉄橋ワタルゾト思ウマモナク、――その童女の歌が、あわれに聞える。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ　イマハ　マダ　チツポケナ　コイヌダヨ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
