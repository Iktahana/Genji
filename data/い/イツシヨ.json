          "literary": [
            {
              "text": "ミンナデ　イツシヨニ　ニギヤカニ　フキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、ウグヒスタチハ　ミンナデ　イツシヨニ、キカラ　キヘ　ツタハリナガラ、ニギヤカニ　コドモタチノ　ハウヘ　アソビニ　ユキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ナタネノ　ツボミト　イツシヨニ　ソダツタ　テフテフデスカラ、ナタネノ　花タチトハ　タイヘン　ナカヨシデシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ヒトビトハ　ウマヤ　ウシト　イツシヨニ　ハタケニ　デテ　キテ　セツセト　ハタラキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺等も人間とイツシヨに数へると、人間が怒るかも知れんが、チツとも怖くない。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "なに、俺だつて、もと／＼こんな処に居りはしなかつたので、矢張り店屋の軒で、ブラ／＼と呑気に遊んで居たのだが、丁度、今から三年前さ、同じ仲間の奴とイツシヨに十計り、此家に持つて来られたのだ。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼、俺とイツシヨに持つて来られた連中は、今頃、何処にどーして居るだらうと思ふと、さすがに初旅の、心細くないでも無かつた。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の章魚連は、間断なく、部屋中を飛んだり跳ねたり、なに俺も止むを得んから、イツシヨに飛んだり跳ねたりしたさ。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙な事も有る物だと思つてゐる内、何処だか、暗い部屋へ、イツシヨに投げこまれてしまつた。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カアサン　イツシヨニセツセツセ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレナラ　イツシヨニ　ノハラヘ　イツテミヨウ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　フタリハ　イツシヨニ　ワラツテイヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　フタリハ　イツシヨニ　ワラツテ「マア、ポカポカト　アタタカイヒデ　ゴザイマシタワネエ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
