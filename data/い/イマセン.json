        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すると向ふが意外にも「アナタオ湯オハイリゴザイマセンカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ゴザイマセンネエ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者様――アノ鯉幟ノ棹ハ、私ガ酔ッタ勢イデ立テタモノデスガ、ソレガ記者様ノオ眼ニ止マッテ、コンナ不孝ナ恥ヲ晒ソウトハ夢ニモ思イマセンデシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレ迄私ハ心中デハ非常ニ煩悶シテ居リマシタガ、殺ソウトハ思イマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ勿論権利ガアルトハ思イマセンケレ共、余リ乱暴ナ言イ方ナノデ私モ二言三言申シマスト、　「一体アナタハホントニ私ニ可愛ガラレテ居タト思ウノ？",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ソウハ思イマセン、道子ヲ殺セバ清三ハ勿論目ヲサマスニ違イナイト思イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "作中、Ｔ市長ダノ銀座ダノトイウ名詞ガ出テクルガ、コレハ決シテ何処カノ帝都ニアッタ実話ナドヲもでるニシタモノデハゴザイマセン。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……中に、ステパンの会話の力で判断してだろう、片仮名で、「オナツカシキペテロフサマ、ソノゴオカワリモアリマセンカ、ユウベ、マテイタノニキテクダサイマセン、ナゼデスカ、シドイシト、ワタシノココロモシラナイデ。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ嬢サン、提灯ヘローソク入レマス、オ待チナサイ、ソウシテ、今夜ワタシ、アナタノ淋シイノヲ慰メルタメニ、一晩中、器量一パイウタイマス、ワタシ、知ッテル世界ノ国々ノ唄トイウ唄、ミンナ歌イマス、イチバンシマイニ日本ノ、歌イマス……夜ガ明ケテモカマイマセン」　マドロスは、すっかり興奮しきっている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間ノナカデモ、ソンナニ、利口ナ子供ハ、アマリイマセンヨ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハオ魚ヲ食ベルノガ下手デスカラ、オ婆チャンノヨウニ綺麗デハゴザイマセンケレド」颯子ノ鮎ノ残骸ハ成ル程マコトニキタナラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハソンナニ子供ガ好キジャゴザイマセンノ」トカ、「死ノ灰ガ降ルッテ云ウノニ沢山生ンダッテ仕様ガナイジャアリマセンカ」トカ云ッタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトハオ婆チャンノオ役目デ、ワタクシノ係リデハゴザイマセント、云ワンバカリデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時、庭ノ散歩ノ時、「颯子ハイマセンカ」ト、佐々木ニ聞イテ見ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今オ気持ガオ悪イヨウナコトハゴザイマセンカ」「気持ハドウモアリマセンガネ、血壓ガ高インデスカ」「二百ホドゴザイマス」彼女ガコンナ風ニ云ウ時ハ大概二百以上ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウモ不思議デゴザイマスネ、無理ニ力ンデ堅イオ通ジデモナサイマシタカ」「イヽヤ」「何カアッタンジャゴザイマセンカ、ドウモ不思議デゴザイマスネ」佐々木ハ頻リニ首ヲ傾ゲテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドコモオ怪我ハゴザイマセンデシタカ」立チ上ッタ予ノ浴衣ノ裾ヲ拂イナガラ佐々木ガ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「外デハアンマリアンナ真似ハナサイマセン、旦那ガ御覧ニナッテイラッシャル時ニヨクアンナ真似ヲナサルンデス」ト野村ハ云ウガ、ソウダトスレバ、コレモ予ヲ揶揄スル積リナノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナニ詰メテ書キ物ヲナサラナイ方ガヨクハゴザイマセンカ、又痛ミ出スト心配デゴザイマス」予ガ日記ヲツケテイルノヲ見テ佐々木ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスガソウナルト薬デ一時ヲ糊塗ナサルヨリ方法ハゴザイマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノ福島博士ト云ウ人ハ信用ノ置ケル人カネ」「エヽ勿論デゴザイマストモ、アノＰＱ病院ノ整形科ニ勤務シテイラッシャル先生デスカラ間違イハゴザイマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デハコレカライタシマス、別ニ痛クモ何トモゴザイマセンカラ御心配ナク」「心配ハシテオリマセン、ドウゾ御遠慮ナク」「ヨロシュウゴザイマスナ」針ガ頸部ニ射シ込マレルノガ感ジラレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレデ結局墓石ノ形式ハドレニオ決メナサイマスカナ、実ニイロ／＼ト専門家モ及バヌホド御存知デイラッシャイマスノデ、私ナゾハ何トモ申シ上ゲヨウガゴザイマセンガ」「僕自身モドウシテイヽカ分ラナイノデ迷ッテルンデスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――トコロデ何ゾ外ニ御用ハゴザイマセンカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ手紙ノコトハ勿論斯波君ニハ云イマセンカラ安心シテイラッシャイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタクシカマイマセン……恐ロシイ曲デス。",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「先生が御迷惑でなかったら……」「カマイマセン、アナタガ聞キタケレバ……よろしい！",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オ京サンハ、前カラ、金五郎サント出来テイテ、ドウシテモ、ウン、トイイマセン。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
