        "examples": {
          "standard": [
            {
              "text": "興奮した信者が異言を語る様子を見て、初めてその宗教の熱狂を知った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "儀式のクライマックスで、彼女は目を閉じながら異言を語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "多くの人が一斉に異言を語り、会場は異様な緊張感に包まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "異言を語ることも一つの賜物であって、ペンテコステの日以来初代教会において多くその賜物が現われた（使徒行伝二の一―一二、コリント前書一二の一〇、一三の一参照）。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
