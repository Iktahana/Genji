        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一同、どやどやと行きかかる。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "前垂の下で手を揉みながら、手代が立って、五足ばかり行きかかると、（多一、多一、）と呼んだ。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしと幸次郎と善八、この三人が宿屋を出て、六所明神の社をさして行きかかると、今も申す通り、随身門までは右も左も松杉の大きい森、その森を横に見ながら辿って行くと、幸次郎がだしぬけにあっと云う。",
              "citation": {
                "source": "半七捕物帳",
                "author": "二人女房",
                "note": "青空文庫"
              }
            },
            {
              "text": "高田は又行きかかるを、柳は又ひき留める。",
              "citation": {
                "source": "青蛙神",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（弥三郎は向うへ行きかかる。",
              "citation": {
                "source": "人狼",
                "author": "――Were-Wolf――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二人は行きかかる。",
              "citation": {
                "source": "人狼",
                "author": "――Were-Wolf――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　行きかかる小坂部の袂にまた取り付いて、師直は悲しそうな声をあげた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしもきっと拝みにゆく」　翁に別れてふた足三足行きかかると、彼はあとから呼び戻された。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは先へ行くよ」　女を振り捨てて、巳之助はすたすたと行きかかると、お糸は追って来て男の袖をとらえた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "妖狐伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを通りぬけて行きかかると、その子供の群れは一度にばらばらと駈けよって来て、地に映っているおせきの黒い影を踏もうとした。",
              "citation": {
                "source": "影を踏まれた女",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「和尚の居間はどこだね」「こっちですよ」　友吉は先に立って行きかかると、半七もふた足三足ゆき掛けたが、また小戻りして松吉にささやいた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "十五夜御用心",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　ともかく藤助一家の様子を見届けて、もう此の上に詮議の仕様もないと思い切った長三郎は、源蔵を眼でうながして行きかかると、源蔵も早々に煙草入れをしまって立ち上がった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "白蝶怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "痛むからだを我慢して、さらに墓場の方へ行きかかる時、ふと見かえると住職の祐道が法衣すがたで自分のうしろに突っ立っていたので、留吉はすこし慌てながら挨拶すると、祐道はその蒼ざめた顔に笑みを含みながら云った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "白蝶怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをうかうか眺めながら行きかかると、路ばたの理髪店から老人が出て来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "歩兵の髪切り",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから四谷の方へ行こうと思って、麹町四丁目の辺まで行きかかると、あとから直七が追って来ました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "吉良の脇指",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は昂然として、行きかかる。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "お邸の裏手から、山へ這入るところに柿の樹と、桑の畑があったが、梅雨があけてから小作人の一人が山へ行きかかると、そこの一番大きい柿の樹の根方から、赤ん坊の足が一本洗い出されて、蟻と蠅が一パイにたかっているのを発見したので真青になって飛んで帰った。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "小太郎は、女々しい迷いごとと、己の信念の崩れて行きかかるのを叱りながらも、心の顫えるのを、何うすることもできなかった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤットそれを直してまた行きかかると、「オイオイ手を振ってはイカン」とまた叱りつけられる。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うん、そうか」と行きかかる。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と団十郎は、行きかかる小次郎を呼び止めた。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お嬢様……」　行きかかる時、人家の軒から、粛々と進み出た三人の武士。",
              "citation": {
                "source": "紅白縮緬組",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハ」　階子口に行きかかると、山岸が何気なく、「じゃア……」　片手で顎を撫で、通路からはずれて立ち止った。",
              "citation": {
                "source": "乳房",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "須貝　（出て行きかかるが、思い直して）なんだ！",
              "citation": {
                "source": "華々しき一族",
                "author": "森本薫",
                "note": "青空文庫"
              }
            },
            {
              "text": "（行きかかる）昌允　シェーカーは俺の部屋だよ、ああ、此処へ持って来るといい、俺がこしらおう。",
              "citation": {
                "source": "華々しき一族",
                "author": "森本薫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
