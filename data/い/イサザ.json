[
  {
    "uuid": "48b50ac8-5af3-5921-8a03-ce9e039b4ce7",
    "entry": "イサザ",
    "reading": {
      "primary": "イサザ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
