  {
    "uuid": "717cb409-5b20-5a0e-868d-a2ad5c6a8600",
    "entry": "イナガラ",
    "reading": {
      "primary": "いながら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "超人説ケル小心、恐々ノ人ノ子、笑イナガラ厳粛ノコトヲ語レ、ト秀抜真珠ノ哲人、叫ンデ自責、狂死シタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イアイダ、タベモノヲ見タコトモナカッタトコロヘ、ハジメテソウシキノオソナエモノヲミルト、モウ矢モタテモタマラズ、目ガクラクラットシテ、ソレニ小サイ弟ヤ妹ナノデ、死ンダオ母ッチャニワルイトオモイナガラ、スキヲネラッテ、ミンナデムチュウニナッテタベテシマッタンダッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マア考エテオクコトニシヨウ」「今日御返事ガイタヾケナインデスカ」「コノトコロイロ／＼ト出銭ガ多クッテネ」ブツ／＼云イナガラ二人ハ出テ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手ノ痛ミデ眼ガ覚メルコトモタマニハアルガ大概半分ハ寝惚ケテイテ、痛イナト思イナガライツカ寝テシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「手ガ痛イダノ歩ケナイダノト云イナガラ、結構生活ヲ享楽シテイラッシャルジャアリマセンカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イツモ締マリガシテナイト云ッタカラ、ホントカドウカ試シテ見タノサ」云イナガラ予モ浴室ノ方ヘ首ダケ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ一生懸命ニ気ヲ静メヨウ、興奮シテハナラナイト自分デ自分ニ云イ聞カセタガ、オカシナコトニ、ソウ思イナガラ、彼女ノ足ヲシャブルコトハ一向ニ止メナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ヌ、死ヌ、ト思イナガラシャブッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ静ガシャガンデ手伝イナガラ汗ヲ掻ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドコモオ怪我ハゴザイマセンデシタカ」立チ上ッタ予ノ浴衣ノ裾ヲ拂イナガラ佐々木ガ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "痛イナガラ嬉シカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ若奥様マコトニ恐レ入リマシタ、折角オ寝ミノトコロヲオ起シ申シ上ゲタリシマシテ、勿体ナクテ罰ガ当リマス」佐々木ガ頻リニクド／＼ト特別ナ言葉デ礼ヲ云イナガラ五子ト共ニ出テ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハマタ僕ガ足ノ fetishist デアルヲ知ッテイナガラ、イヤ知ッテイルガユエニ、メッタニソノ足ヲ僕ニ見セヨウトシナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村モ口デハソウ云イナガラソノ実腰ヲ上ゲル様子ハナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢ガコンナニ生々シイ色ヲ帯ビテ見エルノハ神経衰弱ガヨホドヒドイ証拠ダナト、夢ノ中デハッキリトソウ思イナガラ、僕ハジーットソノ夢ヲ視ツメテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ世ニモ珍シイ廻リ合セト云ウベキハ、陰険ナ四人ガ互イニ欺キ合イナガラモ力ヲ協セテ一ツノ目的ニ向ッテ進ンデイル※デアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
