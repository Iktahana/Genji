          "literary": [
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ蟋蟀ト聞イタノハ蟋蟀デハナク、予自身ノ呼吸音ダッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ油谷サンノ奥サンガ何ヨリ先ニ眼ニ附イタノハ、颯チャンノ指ニ光ッテイタキャッツ・アイダト云ウンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハフト、芥川龍之介ノ書イタモノノ中ニ、中国ノ婦人ハ耳ノ肉ノ裏側ガ異様ニ色ガ白クテ美シイト云ッテイルノヲ読ンダヲ考エツイタノハ彼女自身ノ知慧デハアルマイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナ阿呆ラシイ」ヲ日記ニ書イタノハ誤リデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ間カラ和服デアクセサリーヲ着ケテイタノハ、コノタメノ用意ダッタノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
