[
  {
    "uuid": "d710befe-3437-5ab4-8705-43224e20e5ea",
    "entry": "祈る",
    "reading": {
      "primary": "いのる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-他動詞"
      ],
