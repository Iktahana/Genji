    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "新聞の写真もイクラカ似とるようだが、ヨシ子では絶対にありませぬ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕を採用するならするでイクラカ前貸しして頂きたいのですが」　と呼びかける勇気も無くしてしまったまま杖に縋ってヒョロヒョロと立ち上った。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の過去はこうして兎にも角にもイクラカずつ明るくなって来る。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その気持はイクラカわかるのう。",
              "citation": {
                "source": "骸骨の黒穂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、そのあとで丁寧に手を洗ったのであったが、それとても平生よりイクラカ念入りに洗った位の事で、左右の掌には何の汚染も残っていなかったように思う。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに金はまだイクラカ残っているがカンジン・カナメの二週間の日限が切れそうになって来た。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はイクラカ薄気味わるく、その白くれないの花を抓み上げてみた。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして半年ばかり経過するうちに、栄養が十分に付いて来て、云う事がイクラカ筋立って来た頃を見計って、なだめつ賺かしつしながら色々と事情を聞き訊してみますと……色情倒錯どころの騒ぎではない。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクラカ憤慨したらしく黒い頬を染めながら……しかし若い奥さんは凹まなかった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐに、もとの私に帰ると同時に、一種の冷たい微笑が湧いて来るのを押え付けながら、トボトボと店を出て行く叔父を見送って、平生よりイクラカ叮嚀に頭を下げただけであった。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋服のサラリーマンよりも労務者にタカルことが多かったが、一見乞食のような服装の老いたる労務者や馬力人夫などが、最もタカラれ、結局その方が確実にイクラカになる理由があってのことだろう。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は心理の表現に、カナリだとか、イクラカだとか、数量的にこだわるタチがあるのだが、持って生れた根性で、どうしても、そうなる。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっちみちお前さんにはイクラカになるのだから、どうでもいいだろうけれどもね」「よかろう。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ハアノ揚巻ノ顔ヲ見テルダケデモイクラカ痛ミヲ忘レルンダ」予ハ婆サンニ窘メラレテ一層｜依怙地ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イ／＼人生モコレデイヨ／＼終ルノカナト、イクラカホットシタクライダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ颯子ヲ愛スルノハ、彼女ニイクラカソンナ幻影ヲ感ズルセイデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテ暑イ間ダケオ止メニナッタラ」「イヤ、コノ頃イクラカ利イテ来タヨウナ気ガスルンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三年前マデハオ爺チャンモマダ足腰ガイクラカ達者グッタカラ、大キナ犬ニ飛ビ着カレテモ心配ナコトハナカッタガ、今日デハ事情ガ違ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日モコノ方法ヲ繰リ返シテ漸クイクラカ冷エ込ミガ減ジル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「颯子ハ伺ッタモノカドウカ、ドウシタライヽデショウッテ云ッテルンデスガ、………」「………」「伺ッタライヽジャナイカ、コンナ時コソオ前サンノ顔ヲ御覧ニナッタラ、イクラカデモ痛ミヲオ忘レニナルヨッテ云ッテヤッタンデスガネ」「馬鹿」イキナリ予ハ怒鳴ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サ、コレデイヽデショ、コレデイヤナラ勝手ニナサイ」「痛イ、痛イ、痛イコトハ本当ナンダヨ」「コレデイクラカ直ッタ筈ヨ」「痛イ、痛イ」「又ソンナ声ヲ出ス！",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "専ラシングレラントセデストデ凌イデ来タガ、自然ソノ時期ガ来タノカ、売薬デモイクラカ利キ目ガアッタノガ不思議ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハイクラカ青イ顔ヲシテイタガ、酔ッタ様子ハ見エナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "外ヲ散歩シテイルトイクラカ不安ガ紛レルケレドモ、ソノ散歩ガダンダン不自由ニナリツツアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
