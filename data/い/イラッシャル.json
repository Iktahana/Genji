        "examples": {
          "standard": [
            {
              "text": "庭で猫が気持ちよさそうに寝ていらっしゃる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女はいつも笑顔で、周りの人を和ませていらっしゃる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "先生は今もあの書斎で論文を書いていらっしゃるのだろうかと、弟子はふと思った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
