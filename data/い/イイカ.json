    },
    "definitions": [
      {
        "index": 1,
        "gloss": "listen!",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "いいか、これが最後の警告だぞであるものだ。",
              "source": "幻辞"
            },
            {
              "text": "いいか、絶対に約束を破るなよであるものだ。",
              "source": "幻辞"
            },
            {
              "text": "いいか、今から言うことをよく聞いてくれ。",
              "source": "幻辞"
            },
            {
              "text": "いいか、お金は大切に使うんだであるものだ。",
              "source": "幻辞"
            },
            {
              "text": "いいか、人を傷つけてはいけないんだである。",
              "source": "幻辞"
            },
            {
              "text": "いいか、宿題は今日中に終わらせるんだぞ。",
              "source": "幻辞"
            },
            {
              "text": "いいか、この道は危ないから歩くなよである。",
              "source": "幻辞"
            },
            {
              "text": "いいか、他人の物を無断で取ってはいけない。",
              "source": "幻辞"
            },
            {
              "text": "いいか、嘘をついたら駄目だであるものだ。",
              "source": "幻辞"
            },
            {
              "text": "いいか、約束した時間に必ず来るんだである。",
              "source": "幻辞"
            },
            {
              "text": "いいか、勉強を疎かにしてはいけないである。",
              "source": "幻辞"
            },
            {
              "text": "いいか、兄弟喧嘩してはいけないんだぞである。",
              "source": "幻辞"
            },
            {
              "text": "いいか、この話は誰にも言うなよであるものだ。",
              "source": "幻辞"
            },
            {
              "text": "いいか、安全運転を心がけるんだであるものだ。",
              "source": "幻辞"
            },
            {
              "text": "いいか、自分の気持ちを大事にしなさいである。",
              "source": "幻辞"
            },
            {
              "text": "いいか、失敗しても諦めるなよであるものだ。",
              "source": "幻辞"
            },
            {
              "text": "いいか、感謝の気持ちを忘れるなであるものだ。",
              "source": "幻辞"
            },
            {
              "text": "いいか、人の話をちゃんと聞きなさいである。",
              "source": "幻辞"
            },
            {
              "text": "いいか、無理をしすぎてはいけないである。",
              "source": "幻辞"
            },
            {
              "text": "いいか、いつも誠実でいるんだぞであるものだ。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "かといつてどう改良したらいいかといふことになると、結局やつぱりこの儘でいいやといふやうなことになつて来て、此の事ならず一切が、実に屁下手く退屈なのが人生である。",
              "citation": {
                "source": "三等車の中（スケッチ）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいかオイ……」と突然三田村はその重さうな頭をハネ上げて続きを始めるのだつた、「俺がついててやるから安心しいろい」「うん、うん」と私は相変らず吊り込まれて承知するのだつた。",
              "citation": {
                "source": "夏の夜の話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいかオイ……あんな奴と共同で仕事をして好いことがないのは分りきつてらあ……いいかオイ、俺が出来るだけは助けてやるからなあオイ」「うんうん」　それから猶暫らく彼は同じやうなことを繰返してゐたが、やがて其処を出ようと云ひだした。",
              "citation": {
                "source": "夏の夜の話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "路次｜角の電柱に懸かつた医者の広告板なのだが、その姓をどう読んでいいか分らなかつた、そのまはりに蛾が沢山、それを照明してゐる電燈のまはりにも、とまつたり飛んだりしてゐる。",
              "citation": {
                "source": "夏の夜の話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから私もも少し具体的に話してみようとしたのだが、彼は「いいかオイ」といつた調子でまるで私の気持にはお構ひないのだ。",
              "citation": {
                "source": "夏の夜の話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、なんと言っていいか。",
              "citation": {
                "source": "多頭蛇哲学",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人生の、最も大事な日といっていいかも知れない。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大隅君は、もう、いいとしだし、頭髪もそろそろ薄くなっているし、てれくさくって、どうしていいかわからない気持なんだろう。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしていいかわからなくなって、天下国家を論じて君を叱ってみたり、また十一時まで朝寝坊してみたり、さまざま工夫しているのだろうが、どうも、あれは昔から、感覚がいいくせに、表現のまずい男だった。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いいから大丈夫だよ。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うから来かかった老婆がすれちがった時、二人は急に立止って、老婆の方から、「ホー、しばらくだったね、もう少しはいいかえ」と聞く。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで手足の指などは自分のからだの一部とは思われないように冷え凍えてこちこちしている代わりに頭の中などはいいかげんにあたたかいものがよい程度に充実しているような気がしている。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "物質と生命をただそのままに祭壇の上に並べ飾って賛美するのもいいかもしれない。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどくがっかりして、しかし結局あきらめて辛抱して待って、さてもういいかと思って催促すると、今度は何とかがどうとかして何とかで工合が悪いからもう二、三日待てという、その何とかが実に尤千万な何とかで疑う余地などは鷹の睫毛ほどもないのだから全く納得させられる外はなかった。",
              "citation": {
                "source": "鷹を貰い損なった話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに東京と国とどっちがいいかと聞いてみたら、おくにのほうがいいと言った。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはどちらがいいか、議論をするとわからなくなるにきまっている。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "邪道、と言つていいかも知れない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "輕蔑してゐる、と言つていいかも知れない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まつたく、これは、いいからなあ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もつといただいてもいいかしら。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "龜は、さらにまた言葉をつづけて、「でも、その貝は、あけて見ないはうがいいかも知れません。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいか、わかつたか。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、とても優しい、いいかたよ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、例へば私の額に、どういふレツテルを貼ればいいか分らないやうな時には、「あれは妙な奴だ、どうも妙な奴だ！",
              "citation": {
                "source": "津輕地方とチエホフ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「武士は食わねど高楊子」主義で突っぱった当時の青年文士は、いいかげんシビレを切らしても、原稿料の催促はしたくなかった。",
              "citation": {
                "source": "紀行文家の群れ",
                "author": "――田山花袋氏――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで俺は、ええっと、どうしたらいいかな。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、紅葉の季節に見直すといいかもしれない。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の祖神の翁は、泣いていいか笑っていいか判らない気持にされながら、かがり火越しに幄舎の方を観る。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
