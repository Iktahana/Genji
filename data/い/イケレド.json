        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私ハ夫ニハスマナイト思ウカモ知レナイケレド、アナタカラ文句ヲ云ワレルハズハナイワ」　ト言イ放ッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの眼もソンナニ光ッタラ面白イケレド。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「巧イ拙イハ分ラナイケレド、顔ヤ姿ノ綺麗サニハ感心スルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "附ケ目ニ乗ジテドウスルト云ウ資格モ実力モナイケレドモ、安心シテ美人ノ傍ニ寄ルコトハ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤッパリ黒人デ、ブレノ・メロホド美男ジャナイケレド、ドコカ感ジガ似テルノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ春久ガ夜間ハ忙シイケレドモ、晝間ハ自由ガ利クト語ッテイタコトガアルノヲ、聞キカジッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "卜宅麻渓七値秋霜餘老樹擁西楼笑吾十日間中課掃葉曝書還※裘荷風ノ書ト漢詩ハサシテ巧ミデハナイケレドモ、彼ノ小説ハ予ノ愛読書ノ一ツデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「君ハドウデモイヽッテ云ウカモ知レナイケレド、浄吉ハコノトコロ旅行バカリシテタジャナイカ」「ソレガ何ナノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣キナガラ予ハ「痛イ、痛イ」ト叫ビ、「痛イケレド楽シイ、コノ上ナク楽シイ、生キテイタ時ヨリ遥カニ楽シイ」ト叫ビ、「モット蹈ンデクレ、モット蹈ンデクレ」ト叫ブ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………僕ハ今年カラ、今日マデ日記ニ記スコトヲ躊躇シテイタヨウナ事柄ヲモアエテ書キ留メル、自分ト妻トノ関係ニツイテハ、アマリ詳細ナヲ恐レテイタカラデアッタガ、今年カラハソレヲ恐レヌハシソウモナイケレドモ、シカシ必ズシモソウトハ限ラナイ理由モアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ夫トシテ、彼女ニ十分ノ義務ヲ果タシ得ナイノハ申シワケガナイケレドモ、ソウカトイッテ、彼女ガソノ不足ヲ補ウタメニ、モシ仮リニ、―――コンナヲ考エテモ、アノ病的ナ慾求ニ幾分ノ制御ヲ加エタ方ガヨイノデハアルマイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノクライマデ行クハデキソウモナイケレドモ、ソウイウ風ニシテ努メテ僕ヲ刺戟シテクレル※ハ、彼女自身ノ幸福ノタメデモアルト思ッテ貰イタイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ佛蘭西人ノ名前ハ思イ出セナイケレドモ、ソウイウ佛蘭西人ガイルハ分ッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ニコウイウエキゾチックノ美ガアルガデキナイデ、他人ニ見ツケ出サレタノハ口惜シイケレドモ、夫トイウモノハ見馴レタ妻ノ見馴レタ姿ヲノミ見タガルモノデ、カエッテ他人ヨリモ迂濶ナノカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
