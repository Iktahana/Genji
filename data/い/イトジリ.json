          "literary": [
            {
              "text": "彼は元通りきちんと坐つて、考への緒口に前の考への糸尻を結びつけた。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに帰って来ておったのだそうだな」若松屋惣七は、茶碗の糸尻をすり合わせるような、いつになく上ずった声だ。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "話の糸尻の結ばれぬ所は、質問で聞きついで頂ければ結構だと思ひます。",
              "citation": {
                "source": "日本芸能の特殊性",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
