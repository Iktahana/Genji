        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "老人は、少女から何事かをきくと、怒り罵る若者たちを制して、こともなく引き上げて行った。",
              "citation": {
                "source": "俊寛",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "背後の方から怒り罵る声が聞こえてきた。",
              "citation": {
                "source": "太虚司法伝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かにつけて怒り罵るのは皆珊瑚のとばっちりであった。",
              "citation": {
                "source": "珊瑚",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と叱咤して、静山は怒り罵るが如き形相を示した。",
              "citation": {
                "source": "剣の四君子",
                "author": "高橋泥舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、逃げまどう味方を味方が怒り罵る叫びでしかなかった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
