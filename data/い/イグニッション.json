        "examples": {
          "standard": [
            {
              "text": "エンジンをかけるため、キーを回してイグニッションを入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "イグニッションが故障して車が全く始動しない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "イグニッションを入れると、ダッシュボードの警告灯がパッと光った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その頃、ようやくフェンダーも直り、イグニションもどうやらきくようになった。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "駐車場で発見されたときには、キーはなかったのに、自宅近くでみつかったときには、キーがイグニションに入ったままだった。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "キーはイグニションに差しこんだままだった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
