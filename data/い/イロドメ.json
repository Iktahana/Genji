        "examples": {
          "standard": [
            {
              "text": "新しく買ったジーンズは、最初に色止めをしてから他の洗濯物と一緒に洗う方が良い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この染料は色止め処理がしっかりしているので、洗濯しても色落ちしにくい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "伝統工芸品の中には、特殊な方法で色止めを行っているものもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "染め物をするときは、工程の最後に必ず色止め剤を使う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "觀松彦色止命九世孫韓背足尼定賜國造。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の長は阿波國那賀郡なるべきが上に、此國には又美馬郡といふもあり、神名帳には此國名方郡に御間都比古神社ありて、栗田氏は即ち觀松彦色止命を祀るとせり。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            }
          ]
        }
