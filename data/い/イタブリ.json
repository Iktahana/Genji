          "literary": [
            {
              "text": "さも憎さげに弁太を睨んだが、「うむ、お前さんは弁太殿か、妹をいたぶりに参られたと見える。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで勢い岡っ引は他に副業を求めるか、ないしは地道の町人をいたぶり、賄賂を取らなければ食って行けなかった。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "売る土がなくなると姉が死んだといって、蔵前の札差しに、来年さらいねんの扶持米を金にして貸せといたぶりに行く。",
              "citation": {
                "source": "お墓のすげかえ",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "時折り俺たちをいたぶりに来る、あの焚木拾いか、それとも盆栽採りか――思わずそんな気がしたので……。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まったく、人をいたぶりなさる。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
