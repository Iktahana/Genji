        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "音ハ耳ヲ聾スルバカリノグオーツトイフ音デ、生來之ニ比較スベキ音ヲ聞イタコトガナイ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「玉ネギノヱカキサンナンテキイタコトガナイ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ春久ガ夜間ハ忙シイケレドモ、晝間ハ自由ガ利クト語ッテイタコトガアルノヲ、聞キカジッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ガ云ウノニ、自分ハ昔ＰＱ病院ニ勤務シテイタコトガアッタガ、昨日午後一時間ノオ暇ヲ戴イテ歯ノ治療ノタメ品川マデ参リマシタラ、ソノ歯科医院デ偶然ＰＱ病院時代ノ福島博士ト云ウ整形外科ノ先生ニ出会ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソンナコトハ聞カナイデモイヽ、マア鱧ヲ食イナサイ」ソンナツモリモナク若イ時分ニ何気ナク見テ置イタコトガ、ドンナ時ニ役ニ立ツカ分ラナイモノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、僕ハアナタ方ニ隠シテイタコトガアリマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐ロシイ曲デス……ワタクシ、コンナ曲ヲ弾イタコトガナイ……土井サン、コノ作者ハドウイウ人デスカ？",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
