        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "最後の場面で自殺したナナが二人の男の手を握って二人の顔を見比べながら涙の中からうれしそうに笑って死んで行くところなどもやはりどうしても女らしいインタープレテーションだと思われておもしろかった。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、例え取材は古くても、性格、気分等のインタープレテーションに、或る程度まで近代的な解剖と敏感さを必要とする新作の劇で、彼等は何処まで女になり切れるだろう。",
              "citation": {
                "source": "気むずかしやの見物",
                "author": "――女形――蛇つかいのお絹・小野小町――",
                "note": "青空文庫"
              }
            },
            {
              "text": "野上さんが、（臼川氏）哲学はプラトーで、文学はギリシア悲劇で、他は皆それのインタープレテーションだと云われた。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども知識、芸術を愛するものは、そのインタープレテーションの種々相にあらわれる箇性の栄光を認め、愛し、美に打れずには居られない。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
