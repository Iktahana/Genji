          "literary": [
            {
              "text": "だけれど今しがたも母様がおいいの通り、こんないいことを知ってるのは、母様と私ばかりで、どうして、みいちゃんだの、吉公だの、それから学校の女の先生なんぞに教えたって分るものか。",
              "citation": {
                "source": "化鳥",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の迷い児が交番で正雄ちゃんだの、みいちゃんだのと申立てるようなもので、これは正に国際的な、そして泪ぐましい海の迷い児である。",
              "citation": {
                "source": "運命のＳＯＳ",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "私より一つ年下のおけいちゃんだが、そのときは何と年上のひとのようであったろう。",
              "citation": {
                "source": "なつかしい仲間",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タツは、しかし、おせいちゃんだって、あんな風になったんだからと思わずにいられなかった。",
              "citation": {
                "source": "工場新聞",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも先生は変わり者のおじいちゃんだもんね、リッテル先生？",
              "citation": {
                "source": "犬酸漿",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
