        "examples": {
          "standard": [
            {
              "text": "その育種家は30年かけてこのバラの品種を完成させ、国内外で高く評価されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "有名な育種家が開発した小麦は、世界中の農地で栽培されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新人の育種家が初めて成功させたイチゴの品種は、市場で高い評判を得た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "でもマンチェスターは園芸家や育種家にとって有名な場所だし、レスブリッジの評判が先立っていたのかも知れない。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
