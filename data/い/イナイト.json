          "literary": [
            {
              "text": "答　ソウハ思イマセン、道子ヲ殺セバ清三ハ勿論目ヲサマスニ違イナイト思イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ代リ、全クソンナ資格ノナイ老人デアルコトヲ自分ミズカラモ認メテイルニ違イナイト、ソウ思ッテ世間ガ安心シテイルトコロガ附ケ目デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フト僕ハ、妻ハホントウニ寝テイルノデハナイ、タシカニ寝タフリヲシテイルノニ違イナイト思ワレテ来タ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "テープノ寸法モ測ッテアッタニ違イナイト思ウガ、ウッカリ丸メテシマッタノデ調ベルハ書カナイデオイテクレ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
