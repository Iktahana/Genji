          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "定年退職後は、夫婦で静かな田舎暮らしを楽しみたいと話している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "田舎暮らしは、想像していたよりも近所付き合いや地域の行事が多くて大変だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "週末は家庭菜園で採れた野菜を料理するのが、私の田舎暮らしの最大の楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "都会の生活に疑問を感じ、家族で田舎暮らしを始めることを決意した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "おそらく田舎暮らし何年間を他人事のやうに昔を思ひ隔てて仕舞つて居たにちがひありません。",
              "citation": {
                "source": "秋の夜がたり",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そればかりでなしに、それは前よりも一層私の田舎暮らしの惨めさを掻き立てるような結果にさえなった。",
              "citation": {
                "source": "三つの挿話",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞ、都会にいたたまれないでこんな田舎暮らしをするようなことになっている僕を不幸だとばかりお考えなさらないで下さい。",
              "citation": {
                "source": "美しい村",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は身軽になって、いままでちっとも見えなかったものが忽ち見え出す……　都会では難しいものに見える愛の方法も、至極簡単なものでいいことを会得させる田舎暮らしよ！",
              "citation": {
                "source": "麦藁帽子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が居なくなったあとは、お前たちの田舎暮らしはどんなに寂しいものになるかを、出来るだけお前たちに知らせたいと云う愚かな考えから。",
              "citation": {
                "source": "麦藁帽子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎暮らしの最悪なことは電報や電話がないことだ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "そもそも狩猟に興味がなく、田舎暮らしが嫌いなようだ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "改心した姿を見てもらい、ベスと一緒に田舎暮らしを始めます」「ちょっと待った。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "エルシが夢見た田舎暮らしは近々実現しそうだ、というのもエルシの気持ちを察してアーノット記者が屋敷を買い、一ヶ月以内に所有すると同時に二人で入居するからだ。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "長く田舎暮らしの質素に甘んじていたので、何の贅食も奢侈も知らない。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎暮しからみたら東京の生活は比較にならないほどいい、と云われる言葉は、都会の空気に代々馴れて、結核なども陽性反応を示す体質になっている人々の放言である。",
              "citation": {
                "source": "若きいのちを",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊庭も、何時までも田舎暮しも出来ないので、苛々してゐるのだらうと、ゆき子は、早々と荷物を送りつけて来てゐる伊庭一家の気持が察しられた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "柄ばかり大きくて、こんな貧弱な男と、青春のない生活をしてゐる田舎暮しを、同情的な眼でも見るのだ。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一国男がこれから先どの位田舎暮しをするのかそれも分りませんから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういたしましょう、田舎暮しでは雑誌がなくなったのだからこういうものも大切です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎暮しで何にも分らず、十五日のことは突然ラジオで承った次第でした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "父方の祖母はずっと田舎暮しで、そこの家の本のあるところが、実に夏休みの間の探険場所であった。",
              "citation": {
                "source": "祖父の書斎",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎暮しには、智慧を問題にはしない。",
              "citation": {
                "source": "信太妻の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "若人たちも、田畠に出ぬと言ふばかりで、家の中での為事は、まだ見参をせずにゐた田舎暮しの時分と、大差はなかつた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "若人たちも、田畠に出ぬと言うばかりで、家の中での為事は、まだ見参をせずにいた田舎暮しの時分と、大差はなかった。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "※　私の書こうとしていた小説の主題は、漸くその日その日を楽しむことが出来るようになったこんな田舎暮しの中では、いよいよ無意味なものに思われて来た。",
              "citation": {
                "source": "美しい村",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "……こういうような考え方は、私の暗い半身にはすこし気に入らないようだったけれども、この頃のこんな田舎暮しのお蔭で、そう言った私の暗い半身は、もう一方の私の明るい半身に徐々に打負かされて行きつつあったのだ。",
              "citation": {
                "source": "美しい村",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、土くさき田舎暮しでは気がかりにもなる。",
              "citation": {
                "source": "津の国人",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "永年の田舎暮しの中では冠婚葬祭を義理と形式でしか考えない几帳面さなのだ。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎暮しはたえられない。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸太郎はずっと田舎暮しだから、そのことを知らないのだろう。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "安子も両親について埼玉へ行ったが、三日で田舎ぐらしに飽いてしまった。",
              "citation": {
                "source": "妖婦",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時は、一も二もなくはねつけたが、現在のやうな生活状態ならば、いつそ簡素な田舎ぐらしに隠遁したやうな気持で悠々自適してゐた方がよかつたなぞと考へた。",
              "citation": {
                "source": "現代詩",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの田舎ぐらしの用意として、財務整理（！",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "論より証拠――若盛りの頭のある男が、草ぶかい田舎ぐらしをしていて、金もなければ地位もなく、未来の望みもないときてるんだからな。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
