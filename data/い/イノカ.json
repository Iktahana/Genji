        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "レイノカオ、マドニアラワル。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウ　シタノデセウ」「マダ　ネンネシテルノカシラ」「ワタシタチガ　モウ　オメメヲ　ヒライタ　コトヲ　シラナイノカシラ」「モウ　ハルガ　キテルノヲ　シラナイノカシラ」　ソコデ　花タチハ　マダ　ヒラカナイ　ツボミヲ　オコシニ　カカリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オギクボ、西オギクボなどといふ小駅を通過して私達は、大きな沼のあるイノカシラといふ処まで半ば駆歩で到達しました。",
              "citation": {
                "source": "蔭ひなた",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アア　オ母サン　オ父サン　早ク夜ガアケナイノカシラ　窪地で死悶えていた女学生の祈りが僕に戻ってくる。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "アア　オ母サン　オ父サン　早ク夜ガアケナイノカシラ窪地で死悶えてゐた女学生の祈りが僕に戻つてくる。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、コツチノ気持ハ第二トシテ、軍人ダケガ、ナゼ当節サウイフ感情ヲ尊重シテヰルカニツイテ考ヘテミルト、「モンテェニュ」デハナイガ、世ノ中ニ軍職グラヰ愉快ナ職ハナイノカモ知レヌ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシガ、ヨクネムレナカツタノヲシラナイノカ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ苦シイ俺ハ遊ブ▽ノすりつぱーハ菓子ト同ジデナイ如何ニ俺ハ泣ケバヨイノカ　　　　　×淋シイ野原ヲ懐ヒ淋シイ雪ノ日ヲ懐ヒ俺ノ皮膚ヲ思ハナイ記憶ニ対シテ俺ハ剛体デアルホントウニ「一緒に歌ひなさいませ」ト云ツテ俺ノ膝ヲ叩イタ筈ノコトニ対シテ▽ハ俺ノ夢デアルすてつき！",
              "citation": {
                "source": "破片ノ景色――",
                "author": "△ハ俺ノ AMOUREUSE デアル",
                "note": "青空文庫"
              }
            },
            {
              "text": "「株ヲ持ッテル筈ジャナイカ、アレヲ売ル訳ニ行カナイノカ」「アレヲ売ッタラ、ソレコソアタシタチ一文ナシニナッチャウワ」「ソウヨホントニ、アレダケハ手ヲツケナイ方ガイヽヨ」ト、婆サンガ助ケ舟ヲ出ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君ハトウダンスハシナイノカネ」ッテ聴イタラ、「トウダンスハヤリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今浴ビテルトコロナノ、チョウドオ晝寝ノ時分ダト思ッテ覗イテ見タノ」「今日ハ日曜ダッタッケナ、浄吉ハイナイノカ」ソレニハ答エナイデ別ナコトヲ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ静ガ部屋ヲ出テ行コウトスル時、「今日ハ春久ハ来テイナイノカネ」ト、何気ナク聞イテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ来ナイノカネ」「エヽ、這入ッテラッシャイ」云ワレタノデ這入ッテ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョットスルト、コンナコトニ涙ガ出ルノハ、イクラ涙脆イニシテモ尋常デナイ、モウ死期ガ近イセイジャナイノカナト云ウ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アンマリ大事ヲ取リ過ギルンダワ、アノクライ血ガ出タッテ、何モソンナニ恐ガラナイデヤッテ下サル訳ニ行カナイノカシラ」ト、佐々木ガヒソ／＼声デ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ノキャバレノ帰リガ遅カッタノデ寝足リナイノカ、話シカケラレルノガウルサイノデ寝タ振リヲシテイルノカ、ドッチダカ分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少クトモ妻ハ、自分デハ意識シテイナイノカモ知レナイガ、自分デハ若イ二人ヲ監督シテイルツモリカモ知レナイガ、実際ハ木村ヲ愛シテイルヨウニ思エテナラナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ敏子ガドウイウ底意デソウイウ、彼女ガ故意ニ二人ヲ置キ去リニシテ、二十分以上モ途中デ時間ヲ費シテ（二十分ヤ三十分デハナイノカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ前ノ所デハナイノカネ」ト云ウト、「ママモ木村サンモサッパリ見エナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタガ僕ニ泣キ言ヲ云ウノハイイ、シカシソノ泣キ言ヲ、―――アナタ自身ハ泣キ言ノ積リデハナイカモ知レナイガ、―――何故僕ニ云ウ代リニ夫ニ向ッテ云ワナイノカ、ソレガアナタニ出来ナイト云ウノハ、世ニモ不幸ナ人ガアレバアルモノダト思ッテアナタノタメニ一掬ノ涙ナキヲ得マセン。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本気デ、コノ問題ニブッツカル気持ガ有ルノカ、無イノカ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミハ、ハイニナルノガ、コワクナイノカ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フルエテルネ、コワイノカ、コワクナイヨ、ナニモシナイヨ、キミニハ、ナニモシナイヨ……、サヨナラ、サヨナラ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "アユは後世のアイノカゼも同様に、海岸に向かってまともに吹いてくる風、すなわち数々の渡海の船を安らかに港入りさせ、またはくさぐさの珍らかなる物を、渚に向かって吹き寄せる風のことであった。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
