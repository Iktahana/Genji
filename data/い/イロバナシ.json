        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "東海さんや、補欠の有沢さんを中心とする惚け話や、森さんや松山さんを囲んでの色話も、盛んなものでした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸人が高座でする毎時きまりきった色話だとか、仮白だとかが、それほど彼の耳を慰めるでも無かった。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "慣れた道じゃが、疲れるのう」「薩摩っ坊め、下らぬごたごた騒ぎをしやがって、彼女との約束が、ふいになってしもうた」「それは、御愁傷様、拙者には又、箱根町に馴染があっての――」「又、色話か」「話は、これに限る。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "のろけをいうほどの色話はないが、緑酒紅燈天晴天下一の色男のような心持になったこともある。",
              "citation": {
                "source": "病牀苦語",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "座を外してはくれまいか」「おやマアさようでございますか」　軽く受けたが不安そうに、「どんな内緒のお話やら」「色話だ。",
              "citation": {
                "source": "善悪両面鼠小僧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の色話はよしましょうよ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "祇園乙の検番の杉本老人は色話にだけ割込んできて、あとは端唄を唸つてゐる。",
              "citation": {
                "source": "古都",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "色話か、自分の腕自慢か、そんなものだ。",
              "citation": {
                "source": "人生三つの愉しみ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "和尚さんは、地蔵さんの縁起について色色話してくれた。",
              "citation": {
                "source": "幼年時代",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
