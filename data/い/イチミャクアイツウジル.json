        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その二人の考え方は一脈相通じるところがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この二つの理論は一脈相通じている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼らの美学は一脈相通じていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "オオヤマネコに感動してまだ幾日もたたぬうちに、一介の野良猫にすぎぬが、その倨傲な風格において、一脈相通じるところのある奴が我が家の内外に出没することになったのは愉快だった。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにもかかわらず、「マカール・チュードラ」を貫いて流れている熱い生活力、不撓な意志、卑劣を侮蔑する強い精神そのものが、おのずからプロレタリアの闘争と一脈相通じるものであった。",
              "citation": {
                "source": "マクシム・ゴーリキイの人及び芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はその身うちに何かしらわたくしの精神と一脈相通じるものを有っていたのであります。",
              "citation": {
                "source": "墓",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "30　人相学と映画学とは一脈相通じる。",
              "citation": {
                "source": "鈍走記（草稿）",
                "author": "竹内浩三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お婆さんの描く土瓶絵、一日に千個も坦々と描き、何もかも忘れて描き、自分も忘れ、描くことも忘れて描くその画境は、誠に一念相続のその法境と、一脈相通じるもののあることを感じます。",
              "citation": {
                "source": "益子の絵土瓶",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それですから、以前のハイカラと昨今のモダンとの間には一脈相通じるところがあります。",
              "citation": {
                "source": "嫁取婿取",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このうちの花房助兵衛は、黒田官兵衛と一脈相通じるものをもっていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
