        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コイヅミヤクモやロテイの書いた物を読まない前から自分も東洋に憧憬れて居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヅミ子に可哀そうだし、ね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ではイヅミと言つております。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "また日向のイヅミノナガ姫と結婚してお生みになつた御子はオホハエの王・ヲハエの王・ハタビの若郎女のお三方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヅミヤのクッキーは、大分有名になったが、一寸煎餅を食うような堅さで、ポリポリ食わなければならない。",
              "citation": {
                "source": "甘話休題",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
