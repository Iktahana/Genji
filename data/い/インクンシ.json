          "literary": [
            {
              "text": "なんという事も無い、ただ、ただ、隠君子の心境を味わってみたいこころからである。",
              "citation": {
                "source": "令嬢アユ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "苔のむしている幹のあたりを、貝十郎は撫でまわしたが、（隠君子、偏屈者、こういう梅のような人間が、一人でもあれば面白いのだが。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "簾打つ風には悲壮の気満ち空の色怪しきまでに青く澄み渡るがまま隠君子ならぬ身もおのずから行雲の影を眺めて無限の興を催すもこの時節である。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "まことの隠君子にちがいない。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
