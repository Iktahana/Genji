        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "和田モ老イマシタカラ　将軍家は老忠臣の和田左衛門尉さまを、それまでも何かとごひいきになさつて居られました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ、ソコラニ　タノシソウニ　オヨイデ　イル　サカナ　ニ　イイマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ　イタクテ　オイオイ　ナイテ　イマスト、タカ　ガ　ムカイ　ニ　キマシタノデ、イソイデ　ヤマ　ヘ　ツレテ　カエッテ　モライマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ヤサシク　オツシヤイマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカアサンハ、ミチコサンハ　イヽ　コダナト　オモイマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシガ　ワルウ　ゴザイマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナハ　イイ　グアイダト　オモツテ　イマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ次ノ瞬間ニ殺サレルト思イマシタ。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガハバカリニ入ッタ後、私ハ床ノ中デイロイロ考エマシタガ、ドウシテモ彼女ニ会ッテ彼女ノ心ヲ飜エサネバナラヌト思イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "之以上グズグズイウナラ私今清三ヲ起シテ来マスヨサア放シテ頂戴」　トイッテ、私ヲフリ切ッテ二階ニ上ッテ行ッテ了イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ソウハ思イマセン、道子ヲ殺セバ清三ハ勿論目ヲサマスニ違イナイト思イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノサワギノ最中蚊帳ノ釣手ガフッツリ切レテ上カラ下リマシタノデ、私ハ一気ニ之ヲハネノケテシマイマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人ノ言葉ヲキクト今マデ死ンダヨウニナッテ居タ奥様ガ何カ云イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月九日さよなら　幸恵より　愛する御両親様　　　　　　　　御前に伊藤元子宛（北海道・名寄）大正十一年五月頃（東京発信）御タヨリヲ下サイマシテ、ホントウニ有難ウゴザイマシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "マコトニウレシウゴザイマシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言いながら、手帳と鉛筆をさしつけると、兵部の娘は、直ちに鉛筆を取って認めました、「海岸ヲ西ノ方ヘ向イテ行ッテシマイマシタ、ソノウチ帰ルデショウ」　それを見ると、金椎の眉根が不安の色に曇り、思わず窓の外から海の方を見ますと、真の闇ながら、空模様が尋常でない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを読むと、「茂チャン帰リマセン、ミドリサンモドコカヘ行ッテシマイマシタ」　　　　　　　　　十六　清澄の茂太郎が、ふと蘆笛の吹奏をやめて、黍畑のあなたを見やった時、せっかく、首をふりかけた表情のない動物が、愕然として恍惚から醒めて、のどを鳴らしはじめました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　モンコチヤンハホントニカナシユウゴザイマシタカラ、ワア、ワアナキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ、オ母サンハモンコチヤンニモ、ワンコチヤンニモ、ニヤンコチヤンニモ、ソレゾレオイシイオ菓子ヲ下サイマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカアサンガ　キテ　オツシヤイマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マア、ポカポカト　アタタカイヒデ　ゴザイマシタワネエ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　フタリハ　イツシヨニ　ワラツテ「マア、ポカポカト　アタタカイヒデ　ゴザイマシタワネエ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オジサンワ　言イマシタ支那ワ　ホントワ俺達ノ敵デワ無イヨシカシ　出征シナンナラン行キタク無イノニ行カンナラン殺シタク無イノニ殺サンナランゾータンノゴトホントノ敵ハ支那ジャナカ殺サンナランノワ　外国ニワ居ランソイデモ出征セニャナラン支那兵ヲ殺サンナランゾータンノゴト。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――家ガ仲ノ町デ、引手茶屋ヲシテイマシタカラ……　――ソレガ、ドウシテ、後ニ、赤坂ダノ、葭町ダノヽ住人ニナリマシタカ？",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダケドアレヲ提ゲテ歩イタラ、僕ガ買ッテヤッタンダト、婆サンガ感ヅキャシナイカナ」「オ婆チャンハアノ時見テイラッシャラナカッタワ、ドン／＼歩イテ先ノ方ヘ行ッテラッシャイマシタワ」ヤッパリソウダッタナト予モ思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御療治ノ最中ニ失礼ダト存ジマシタケレド、先日颯チャンカラオ願イシマシタラ御承知下サイマシタソウデ誠ニ有難ウゴザイマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オイデニナッテイラッシャイマシタガ、モウオ帰リニナッタヨウデゴザイマス」ト、多少曖昧ニ答エテ出テ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハイ、オ帰リニナッタコトヽ存ジテオリマシタラ………」「アヽソウカイ」「………オ二階デ涼ンデイラッシャイマシタンデ、………」コップガ二ツトコカコラノ壜ガ二ツ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ハ直グ脈ヲ取ッテ見テ、「プルスガ九十以上ゴザイマスネ、ドウカナサイマシタンデスカ」「イヽヤ別ニ」「血壓ヲ測ラシテ戴キマショウ」否応ナシニ書斎ノソファニ寝カサレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今朝ホド測リマシタ時ハ上ガ一四五、下ガ八三デ、至極順調デゴザイマシタノニ、ドウシテ急ニコンナニ上ッタンデゴザイマショウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
