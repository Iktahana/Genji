[
  {
    "uuid": "2d05447f-9802-5484-832d-cb706c6af74d",
    "entry": "鯔背",
    "reading": {
      "primary": "いなせ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
