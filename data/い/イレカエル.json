        "examples": {
          "standard": [
            {
              "text": "この重い家具、一人で運ぶのは無理だから、誰かに手伝ってもらって入れ替えよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "展示のレイアウトを変更するため、作品の入れ替え作業を午後から開始します。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「ちょっと、そこにある本棚、動かしてくれない？壁の絵を入れ替えたいんだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
