    "definitions": [
      {
        "index": 1,
        "gloss": "to replace",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この部屋の照明を、もっと明るいLEDに入れ替えたいな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "古いソフトウェアを最新版に入れ替える作業、そろそろ始めないと。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あれ、さっきまであったはずのファイルが消えてる！誰か間違えて入れ替えたのかな？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "彼は独創的な研究によって人間の眼は獣類の眼と入れ替える事が容易で、且つ獣類の中でも豚の眼と兎の眼が最も人間の眼に近似している事を実験的に証明した。",
              "citation": {
                "source": "女人訓戒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また肉の一片を肉を食うた跡へ入れ替える（フレザーの『金椏篇』一板二巻三章）。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "性根入れ替えると一言申さば、主水之介とて同じお旗本につらなる身、ことを荒立てとうはない！",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "真紀子は彼の次に自分の這入る湯を入れ替える間、久慈とテーブルに向き合い流れ落ちる湯の音に、ときどき聞き耳を立てていた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「命もちませんでござります」「ただ脳髄を入れ替えるだけじゃ。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……何んでもないよ、入れ替えるだけじゃ」　医師は当惑したように、長い間の惨酷な所業に、無表情になっている仮面のような顔へ、皺をたたんで沈黙した。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "台所から清が出て来て、食い散らした皿小鉢を食卓ごと引いて行った後で、御米も茶を入れ替えるために、次の間へ立ったから、兄弟は差向いになった。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "江島屋の馬鹿息子へ、あの娘をやるくらいなら、あっしだって馬子を脅かして、同じ鹿毛馬を仕立てさせ砂利を詰めた千両箱を背負わせて、天神下の角でアッという間に入れ替えるぐらいの芸当はやりますよ」　平次は遠慮もなくまくし立てます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "結納の行方",
                "note": "青空文庫"
              }
            },
            {
              "text": "羊は法によって選ばれたものではなし、牛と入れ替えることもできよう。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、伯爵の身体を押入れの箱の中の偽物と入れ替えると見せかけて、暗闇を幸、入れ替えをしなかったのだ。",
              "citation": {
                "source": "猟奇の果",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "来年のことを言うと鬼が笑うよ」「僕は中学生になったら、魂を入れ替える。",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日から魂を入れ替える」「よし。",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の方は繰り合せるから、今月中機嫌好く遊んで、来月から魂を入れ替えるさ」　と父親も改めて快諾を与えた。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おやおや、おかあさんまで、にせものといれかえるつもりだな。",
              "citation": {
                "source": "超人ニコラ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶を入れかえる、といったのを振切って出て、大塚の通りから、珍らしく俥を驕ると、道の順で、これが団子坂から三崎町、笠森の坂を向うへ上って、石屋の角でさ。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "拝見いたしますと、心棒がすっかりすりへっておりますが、と言って、音楽がうまく鳴るように、新しい心棒を入れかえることはできないのでございますから」ということでした。",
              "citation": {
                "source": "ナイチンゲール",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "書斎へかけ込んで手提金庫の中から札の束を掴み出し、鞄の中の株券と入れかえると無言のまま万平の前に突き出した。",
              "citation": {
                "source": "黒白ストーリー",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち校門を這入る時には制帽を冠り、電車に乗る時には鳥打を冠る位の手品は何でもないので、只その都度魂を入れかえるのが面倒臭いだけになる。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "救われれば、どんなに心がけのわるい人間でも、心を入れかえるに違いありません」「わしは、そんなことを信じない。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "硝子屋に至急壊れた窓硝子を入れかえるように命じてあるものらしい。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "たか子のもって来たランターンの電池がきれて私が入れかえるとき極を同方向に入れてしまったためにこのさわぎ。",
              "citation": {
                "source": "日記",
                "author": "一九四七年（昭和二十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "よい頃を見はからって、私とお千代さまを入れかえるために、二組をおつくりになり、その一つをわたくしに下さった、あの立派な衣裳も、結果は、ただ、私を驚かせるに役立つにすぎないのでございます――わたくしの、夜の静寂を破った叫び声、それが、すべての終りであったのでございました。",
              "citation": {
                "source": "両面競牡丹",
                "author": "酒井嘉七",
                "note": "青空文庫"
              }
            },
            {
              "text": "この個人の存在論で用うるところの、「不安と怖れ」の言葉のかわりに、「自分自身を否定の媒介とする」と云う考え方を入れかえる時、個人より集団への飛躍が初めて可能となるのである。",
              "citation": {
                "source": "生きている空間",
                "author": "――映画空間論への序曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんな、あんなあなに取っ憑かれて、悪いことをしたら、すぐに白状して、心を入れかえるのよ。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "五ガロン入の丸缶の内身を、ドラム缶入のディーゼル・オイルとまぜ、別のドラム缶と、交互に入れかえること二十回、長い竹の棒でよくかきまぜた上、二十四時間放置したのを霧ふきで、ふきかけるのである。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "肝心の踊の間じゅう、たまに入れ換ることはあっても殆ど始から終りまで里栄は広い舞台の彼方の端れで何もならず、桃龍が絶えず彼等の目前にあった。",
              "citation": {
                "source": "高台寺",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど、今過ぎて行くカロライナ州の天地が、瞬間、棉の耕地を見せ、忽ち、木造の危うげな小屋と入れ換る有様によく似ている。",
              "citation": {
                "source": "南路",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、その二つを、かわるがわるに入れ換える。",
              "citation": {
                "source": "オフェリヤ殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しづ枝に茶を入れ換えることを命じて置いて、奥さんは純一の顔をじっと見た。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "教えて下さいな」「あの有名な貴族院議員さ」「まあああああ――アアア」　五六人の女が部屋の空気を入れ換えるくらい大きな溜息をした。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
