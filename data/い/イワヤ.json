[
  {
    "uuid": "644ebf3d-777f-55f1-994f-c82d3504f153",
    "entry": "岩屋",
    "reading": {
      "primary": "いわや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
