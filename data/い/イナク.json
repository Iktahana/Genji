          "literary": [
            {
              "text": "久しいイナクティブな生活にもあきた。",
              "citation": {
                "source": "獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕もまた、久しきイナクチヴの生活にあきた。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "地久節チキユウセツハメデタイナクワウゴウサマノオウマレ日ガツカウモ　ヤクバモイハヒマス。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "車内ノ暑サモ思イヤラレルガ、冷房ガヒトシオ厳シイニ違イナク、手ノ痛サノ方ガ心配デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ試ミニ息ヲ吸ッタリ吐イタリシテミルト、ヤッパリ間違イナクピイピイト鳴ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ経助ハイナクナッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
