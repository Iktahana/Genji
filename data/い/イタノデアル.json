          "literary": [
            {
              "text": "コレハ予ガ豫メ左様ニ注文シテ置イタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ今度ノ京都行ヲカネテカラ楽シミニシテイタガ、京都滞在中ニ一日オ暇ヲ戴イテ奈良見物ヲサセテクレト云ッテイタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈図ランヤ彼女ハソノ頃ハイヤヲ走ラシテ伊丹ニ向ッテイタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ僕ノ嫉妬カラソンナ風ニ気ガ廻ルノカト思ッテ、ソノ考エヲ努メテ打チ消シテイタノデアルガ、ヤハリソウデハナサソウデアル。",
              "citation": {
                "source": "鍵",
