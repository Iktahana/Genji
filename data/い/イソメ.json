[
  {
    "uuid": "dca89c87-804f-5456-9544-ad9a352c1df8",
    "entry": "磯蚯蚓",
    "reading": {
      "primary": "いそめ",
      "alternatives": [
        "イソメ"
      ],
      "is_heteronym": false
    },
    "grammar": {
