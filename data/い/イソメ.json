    "definitions": [
      {
        "index": 1,
        "gloss": "eunicid (any worm of family Eunicidae)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "釣り人は、手返しの良い餌として磯蚯蚓を針に付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この堤防では、夜釣りの際に磯蚯蚓がよく釣れると評判だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「今日の釣果は、やっぱり磯蚯蚓のおかげだね！」と、ベテラン釣り師は満足げに語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "潮間帯の岩場を調査していた生物学者は、特殊な環境に適応した磯蚯蚓の群生を発見した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "磯蚯蚓は、海底の堆積物を撹拌することで、海洋生態系の健康維持に貢献している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "磯蚯蚓は、その細長い形状と、磯に生息することから名付けられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "と申しましただけではご不審でござりましょうが、源之丞さまは父も大の気に入りの一の弟子、お気だて、お姿、なにから何までのりりしさに、いつとはのう思いそめましたなれど、憎いほどもつれないおかたさまなのでござります。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "初薪のみにて焚きしときは、むら焼けになることありて、火箸などにてかきまぜたりしが、糠粃を用いそめてより、屍の燃ゆるにつれて、こぼれこみて掩えば、さる憂なしといえり。",
              "citation": {
                "source": "みちの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い扇の、帯にかくれたさきだけが、左の乳首の下あたりに秋の蝶のとまったようにぴったりと……　黒い夜空ににおいそめた明星のように、チラリチラリと、眼をあげるたびに、星のような瞳が輝き、懐しいまたたきを見せる。",
              "citation": {
                "source": "一世お鯉",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "石井氏が綾之助を愛しんだのは、恋ではなかったが、綾之助は世心がつくにしたがって、この人にこそと思いそめたのであった。",
              "citation": {
                "source": "竹本綾之助",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああそうです、お嬢様へ……思いそめしが！",
              "citation": {
                "source": "染吉の朱盆",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「思いそめしが、思いそめしが」「ね、兄貴、話といえば、ざっとこういったものなのさ」　話し終えた岡引の半九郎は、変に皮肉に笑ったものである。",
              "citation": {
                "source": "染吉の朱盆",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女と逢いそめてから、これでまだ四度にしかならぬ。",
              "citation": {
                "source": "別れたる妻に送る手紙",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊はまだ褪わずして狂うものは狂いそめ、小菊、紺菊の類は、園の此処彼処にさま／″＼な色を見せ、紅白の茶山花は枝上地上に咲きこぼれて居る。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼がしらが熱くうるおいそめて、にじみ出して湧いてこぼれて来る涙を拭く気にもなれない。",
              "citation": {
                "source": "アーニイ・パイルの前に立ちて",
                "author": "小林一三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が白々と明けそめて、上野の森の恋の鴉が、まだ漸く夢から覚めたか覚めない時分、早くも感応寺中門前町は、参詣の名に隠れての、恋知り男の雪駄の音で賑わいそめるが、十一｜軒の水茶屋の、いずれの見世に休むにしても、当の金的はかぎ屋のおせんただ一人。",
              "citation": {
                "source": "おせん",
                "author": "邦枝完二",
                "note": "青空文庫"
              }
            },
            {
              "text": "室内のどこやらに、白っぽい気がただよいそめて、今にも牛乳屋の車がガラガラ通りそう、お江戸は今、享保何年かの三月十五日の朝を迎えようとしている。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだこの世に居らっしゃった六日の前のあかつきをもう此の世のかぎりと知れたならばきっと後の世を契ったものをあいそめたその夜の契さえ今は中々うらめしくて彼の物語にある、光源氏の大将の朧月夜の内侍のかみ、弘徽殿のほそどのも私の身の上にひきくらべて一しお哀深う思う。",
              "citation": {
                "source": "「平家物語」ぬきほ（言文一致訳）",
                "author": "宮本百合子訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰が云いそめたのであるか、かかる団結をしばしば‘Order’と呼ぶ、「宗団」の意ではあるが、「秩序」の義をも含む。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "老いそめた女の化粧はなお一点の美くしさを留めながらも、化粧をするという事その事がやがて一つの淋しさを思わしめる。",
              "citation": {
                "source": "俳句はかく解しかく味う",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たのみなき若草｜生ふる冬田かな　　　　太祇　若草といえば、これから先きだんだん茂って春の草になって行くものであるが、それがまだ冬田にちょいちょいと生いそめたところを見ると、その若草はいつまで茂るべき未来があるかを疑わねばならぬのである。",
              "citation": {
                "source": "俳句はかく解しかく味う",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて薔薇も匂いそめ　単純な希いが　たかまり　凝って　光とともに燃ゆるとき　愛するひとよ　御身の命も亦溢れ　われら鍾愛の花の上へ　燦然とふり注ごう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒の味と共に、人間同士の肌合いも覚え、都に知己あり、と思いそめた。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いままで、東京方面から遠征してくる釣り人は、イトメやゴカイ、袋イソメなどを持参しているが、僕のやり方は、そんな高価な餌はいらない。",
              "citation": {
                "source": "那珂川の鱸釣り",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "露伴翁は、餌に袋イソメとイトメを用いたと言う。",
              "citation": {
                "source": "那珂川の鱸釣り",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "餌はアオギスの大好物であるイソメだ。",
              "citation": {
                "source": "青鱚脚立釣",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ口の小さい魚で、砂の穴から頭だけ出しているイソメを素早く食い取る習性を持っているから、鈎合せが早くないといつも釣り損う。",
              "citation": {
                "source": "青鱚脚立釣",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴカイや袋イソメの餌は、一度もやって見た事はなかった。",
              "citation": {
                "source": "河鱸遡上一考",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "涸沼川の平戸橋付近にいくらでもゴカイやイソメを売って居るからやれるのである。",
              "citation": {
                "source": "河鱸遡上一考",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりどの釣場へも東京から二時間位で到着出来るのだから、袋イソメやゴカイを持って行ったなら、てっきりと思う。",
              "citation": {
                "source": "河鱸遡上一考",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "万事がこの通り、生きて居る百科辞典のような博識の学者になったのであるが、これも先年鱸釣に用いる餌の袋イソメが夏の土用中腐り易いので、いろいろ考えた結果、硼酸水に浸けた処、これが妙な作用をして、濃褐色のイソメは忽ち青くなって一尺程も長くなり、鱸が釣れたという話がある。",
              "citation": {
                "source": "釣聖伝",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "餌は今のところ袋イソメが一番効果がある。",
              "citation": {
                "source": "夜の黒鯛",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "餌は袋イソメや赤虫を使うが立秋後にカニ、シャコなども使う。",
              "citation": {
                "source": "夜の黒鯛",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "餌は袋イソメと芝エビの肉を刻んでつけるが、袋イソメの方が断然成績がいい。",
              "citation": {
                "source": "ガラガラ釣",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときどき何かまいているようですね」「砂イソメというのが一番食いがいい。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "餌のイソメは、長さも、八寸から一尺以上もある。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
