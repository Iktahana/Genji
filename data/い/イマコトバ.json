          "literary": [
            {
              "text": "今言葉になってどうとは云えないけれ共、もう少しよく考え読んで見たら必ず分るだろうと思う。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今言葉をかわしたふたりも、仲間の者らといっしょに、衆人に立ち向かわなければならなかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前を産んだお前の親しい民族は、今言葉を慎しむ事を命ぜられているのだ。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
