[
  {
    "uuid": "f8f1b285-65ff-57c0-9aa6-867e8c4772a4",
    "entry": "嫌味",
    "reading": {
      "primary": "いやみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
