        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "―――――――――――――――――――――――――――――――――――――――――――８　月夜のでんしんばしら　　―――――――――――――――――――――――――――――――――――――――――――うろこぐもと鉛色の月光、九月のイーハトヴの鉄道線路の内想です。",
              "citation": {
                "source": "『注文の多い料理店』広告文",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "８　月夜のでんしんばしらうろこぐもと鉛色の月光、九月のイーハトヴの鉄道線路の内想です。",
              "citation": {
                "source": "『注文の多い料理店』新刊案内",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月の二十六日の夜八時ベーリング行の列車に乗つてイーハトヴを発つた人たちが、どんな眼にあつたかきつとどなたも知りたいでせう。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　ぜんたい十二月の二十六日はイーハトヴはひどい吹雪でした。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　列車がイーハトヴの停車場をはなれて荷物が棚や腰掛の下に片附き、席がすつかりきまりますとみんなはまづつくづくと同じ車の人たちの顔つきを見まはしました。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『さあ、まあイーハトヴの冬の着物の上に、ラツコ裏の内外套ね、海狸の中外套ね、黒狐表裏の外外套ね。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしはねイーハトヴのタイチだよ。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イーハトヴのタイチを知らんか。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "『おい、紅茶をおくれ』イーハトヴのタイチが手をのばしました。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "『こいつがイーハトヴのタイチだ。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イーハトヴの冬の着物の上にねラツコ裏の内外套と海狸の中外套と黒狐裏表の外外套を着ようといふんだ。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いゝ、ほんとにいゝ、これではもうイーハトヴの友もなにも及ばないな。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イーハトヴの友も及ばないとしますととても密造酒ではないと存じました。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そしたら瓶詰はみんなイーハトヴの友でしたしはかり売のはたしかに北の輝です。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そしてもうぞろぞろみんなはイーハトヴ密造会社の工場を出たのだ。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
