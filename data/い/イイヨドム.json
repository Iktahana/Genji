    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（間の悪気に言い淀む。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "（疑念を挟むらしき姉の目付を見て言い淀む。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこぞ急用でもあったのかい」「いえ――急用でもなかったんですが」と相手は少々言い淀む。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとで、そっと拭いて置きましたが、なかなか取れそうもありません」「成程、階子段の油は、外から入った者の仕業じゃ無い」「それから――」　お通は言い淀むのです、何んかしらこの女は、重大な鍵を握っているに違いありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "人違い殺人",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを変なところで役に立てはしないかと、ビク／＼して居りましたが――」　平次は言い淀むのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "群盗",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お友達が門のところに待っていますし、土曜日ですから、つい……」　とお母さんが言い淀む。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先生」　と吉岡先生のお顔を拝借して、「今日は久保田先生が三時間目を休んで下さいますから、先生も四時間目を……」　と言い淀む。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "サーちゃんは、話し終ると、ソワソワした声で、「ねえ、先生」　言い淀むのに、「なアに」「ここへ瓶口さん、来なかったかしら」「さあ、僕も今来たところで……」　それを証明するごとくに、注文のコーヒーが来た。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "……けれども……（と云いよどむ）領主　けれども、どうしたと申すのか。",
              "citation": {
                "source": "レモンの花の咲く丘へ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにか云いよどむときの、少年時代からの癖で、そうするとひどく子供っぽい顔になるのです。",
              "citation": {
                "source": "失蝶記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小橋与力が云いよどむのをみて、次高来太はするどく追求した。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と低く答えたまま、暫く重く黙っていてからまた云い澱む風に云った。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ゆうべは、――」私が言い澱むと、「ねむれた？",
              "citation": {
                "source": "秋風記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの……實は貴方が、繪を遊ばすつて事を存じて居りましたものですから、……お恥かしうござんすわね……」　と一寸言淀む。",
              "citation": {
                "source": "淺茅生",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寢臺と、すれ／＼の所へ坐りますと……」　ふと言淀むかして、默つて、美人は背後を振向いた。",
              "citation": {
                "source": "淺茅生",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
