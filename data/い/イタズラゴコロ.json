    },
    "definitions": [
      {
        "index": 1,
        "gloss": "desire to tease",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子どもの素朴ないたずら心は微笑ましい。",
              "source": "幻辞"
            },
            {
              "text": "大人になってもいたずら心は消えない。",
              "source": "幻辞"
            },
            {
              "text": "いたずら心に駆られて悪戯をしてしまった。",
              "source": "幻辞"
            },
            {
              "text": "友人のいたずら心に付き合わされることがしばしばある。",
              "source": "幻辞"
            },
            {
              "text": "いたずら心から誰かをからかってしまう。",
              "source": "幻辞"
            },
            {
              "text": "その少年のいたずら心は親の手に負えない。",
              "source": "幻辞"
            },
            {
              "text": "相手のいたずら心を上手に応じるのが社交術だ。",
              "source": "幻辞"
            },
            {
              "text": "いたずら心があるからこそ楽しい人間関係が築ける。",
              "source": "幻辞"
            },
            {
              "text": "人間誰しもいたずら心を持っているものだ。",
              "source": "幻辞"
            },
            {
              "text": "いたずら心で他人を傷つけてはいけない。",
              "source": "幻辞"
            },
            {
              "text": "兄のいたずら心が弟を悩ませている。",
              "source": "幻辞"
            },
            {
              "text": "いたずら心からボケを言ってしまった。",
              "source": "幻辞"
            },
            {
              "text": "ユーモアはいたずら心と紙一重である。",
              "source": "幻辞"
            },
            {
              "text": "いたずら心に満ちた表情が相手に伝わった。",
              "source": "幻辞"
            },
            {
              "text": "良好な関係にはいたずら心が潤滑油になる。",
              "source": "幻辞"
            },
            {
              "text": "本人に悪気のないいたずら心でも失礼になることもある。",
              "source": "幻辞"
            },
            {
              "text": "子どもたちのいたずら心は無限の創造性を秘めている。",
              "source": "幻辞"
            },
            {
              "text": "いたずら心が悪質に変わることもある。",
              "source": "幻辞"
            },
            {
              "text": "いたずら心で相手の反応を見ることもコミュニケーションだ。",
              "source": "幻辞"
            },
            {
              "text": "教室にいたずら心の波が広がったことがあった。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "沢山の汚名を持つ私を、たちの悪い、いたずら心から、わざと鄭重に名士扱いにして、そうして、蔭で舌を出して互に目まぜ袖引き、くすくす笑っている者たちが、確かに襖のかげに、うようよ居るように思われ、私は頗る落ちつかなかったのである。",
              "citation": {
                "source": "善蔵を思う",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの女のいたずら心が跳ね返って嬉ぶ。",
              "citation": {
                "source": "かの女の朝",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見やると葉子は一時に力を回復したようになって、すぐ跳り出して来るいたずら心のままに、一本の桜の木を楯に倉地をやり過ごしておいて、後ろから静かに近づいて手と手とが触れ合わんばかりに押しならんだ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子は例のいたずら心から古藤を手なずける興味をそそられないでもなかった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は一時のいたずら心から処女の一生を犠牲にしたと云う慚愧と悔恨に閉ざされていた。",
              "citation": {
                "source": "水郷異聞",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたものを眺める目も子供の好奇と、いたずら心地と、大人の世界の滑稽味ではなくなって、段々と苦しい悩みをまじえるようなものに移って行った。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これとそれとを考えあわせれば、十五歳の少年団の列車妨害はただのいたずら心といいきれるだろうか。",
              "citation": {
                "source": "犯人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえ眼があいても、心の悟りが開けきれない限り、彼のいたずら心は遽かに止むべしとは思われません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはたしかにあの女が帰って来たのだな、と思ったから、急にいたずら心が起りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お角の、いたずら心が挑発されて、せっかくのことに、がんりきのために、思いきった濃厚な当てっぷりを見せてやろうと、むらむらしたが、どう考えてもこの場合、相手に選ぶべき役者がない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "といって、江州柏原駅にあらかじめ道庵を入れて運ぶために備えつけられていた長持が無い限り、道庵の呼吸のために安全弁が特設されてあろうはずもないから、いたずら心はいたずら心として、中に納まった道庵は蓋をされる瞬間に、そこは心得て、なんらか空気流入の調節方法を講じて置いたものと見なければならぬ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "胆吹の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると遂にはいたずら心を止めるようになろう。",
              "citation": {
                "source": "丸の内",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの女に、みだらないたずら心のないことは、かの女自身が一番よく知っているのだった。",
              "citation": {
                "source": "あの顔",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "羅はびっくりしてほとんど気絶しそうになったので、いたずら心もなくなって、きちんと居ずまいを直して坐っていると、だんだん変って来て故の着物になった。",
              "citation": {
                "source": "翩翩",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "多計代が、女としての自分を買いかぶって、自分に対する場合だけはいつも例外で、その男にいたずら心や浮気のない深刻なことのように思うとすれば、それはうぬぼれでなくて何だろう。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お絹は悪い計画をする女ではないにかかわらず、男を見るとこういういたずら心が起って、兵馬を口説いてみたり、竜之助の時の留女に出てみたり、がんりきを調戯ったりしていたのが、ここへ来ると駒井能登守を、また相手にする気になってしまいました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "駒井能登守の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりこうして、自分をおもちゃにしてみようといういたずら心なのだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "勿来の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "かほどの問題も、ここでは声をひそめて語るの必要がなく、子供が野火をつけに行くほどの、いたずら心で取扱われる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "口ほどにもなく、あんまり弱腰だものですから、五十嵐もいたずら心が手伝って、つい弱腰をはたと蹴ると、よたとんは、「あっ！",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありふれた湯女とお客の御多分なみに、ほんの、退屈まぎれな、いたずら心でした事を、軽く後悔するように。",
              "citation": {
                "source": "治郎吉格子",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇太子はふといたずら心に、『姫。",
              "citation": {
                "source": "美しい日本の歴史",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なぜあんなふうに、ばらさなくてはいけないんですか」「だって、いまのあなたの女は、私なのよ」　自信といたずら心が同居した魅力が、美枝子のぜんたいにいきわたっていた。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "父のその姿を見たら、私はいたずら心をそそられて、そっとしのび寄ってわっと云って背なかにとりついたら、父は一寸びっくりして、「なんだ、清か。",
              "citation": {
                "source": "桜林",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてただ一時のいたずらごころから髪にさしていた小さな造花を投げてやると、それがあわよく検疫官の肩にあたって足もとにすべり落ちた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
