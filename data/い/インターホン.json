        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "玄関のインターホンが鳴り、宅配便が届いたことを知らせてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "マンションの各部屋にはインターホンが設置されており、来訪者を確認できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「ピンポーン、インターホン鳴ってるよ！」と妹が叫んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "病院の病室では、ナースコールとしてインターホンが使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ウォズニアックは仲間のエレクトロニクスキッズたちと組んで、互いの家を手作りのインターフォンでつなぎ、電子工作に明け暮れて過ごした。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "このスピーカーは、天井付近にある、全館放送／インターフォン用の小さなスピーカーとは独立していて、いちおう、音楽らしい音が出るようになっている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一も起きあがり、はだしのままビニールタイルの床を歩いて、インターフォンのまえにいき、呼出しスウィッチを押した。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もー、またかよー」　きのうとおなじく、インターフォンのスウィッチを押す。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その休憩の終わりごろ、インターフォンのスピーカーから、「滝口はいるか」という声がきこえた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "高志はデッキを止めて、ドアのほうにいき、インターフォンの呼出しボタンを押した。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "学園祭の一カ月後、慶一が外泊から帰って、ＫＷＴＳに借りたレコードを返しにいこうとすると、インターフォンで呼出しがあった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日の夕食後、インターフォンで片桐に呼出しがかかったとき、慶一は、だからいっただろう、どうするんだよ、と焦燥を感じた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "インターフォンにこたえようとしない片桐のかわりに返事をした長田が、奴のほうを見る。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　片桐のベッドはいちばん奥の窓際だが、これだけの声を出したら、いくらなんでも、インターフォンに入っただろう、と慶一は心のなかで目をつぶった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "局にはスタッフが待機していますので、インターフォンで、リクエスト、ご質問、ご意見、なんでも受けつけます」　いつも「ライヴ」だから、いまさら断わる必要もないが、ワラって奴は、ことさらにそういうことをいうのを、いつも楽しみにしているようなところがある。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "早く見つけないと……」　そのとき、インターフォンのスウィッチが入ったノイズがきこえた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "インターフォンは生きていますから、リクエストを受けつけます。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "足早にスピーカーのほうに歩みより、慶一はインターフォンのボタンを押す。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
