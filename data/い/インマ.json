[
  {
    "uuid": "3ebd5f08-566e-5fa7-8c8f-0db054435879",
    "entry": "淫魔",
    "reading": {
      "primary": "いんま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
