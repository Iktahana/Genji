        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "實際このインテイメイトなプルウストの話し方は佛蘭西人の生活や生活感情と云つたものを、これまで僕達が佛蘭西の小説を讀んで親しんでゐたより以上に、よりリアルに、僕達に近づけたので、僕達はさう云つた生活のデイテイルに限りのない親しさを感じる一方、またこれまでにない拒絶の感情をもうけとるのだ。",
              "citation": {
                "source": "「親近」と「拒絶」",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "變テツもないデイテイルを、無意味に捻つて見せたにとどまつてゐる。",
              "citation": {
                "source": "『戰旗』『文藝戰線』七月號創作評",
                "author": "-------------------------------------------------------",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガヤノ人タチハ、ソレヲキイテイルウチニ、一人一人ミンナモライ泣キヲシテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ昨年ノ暮空襲デクライ外ヘ出タトキ、左ノ眼ガイヤニ暗イ感ジガシタシ、マタ室ニイテモ変デ、左ノマツ毛に目ヤニデモツイテイルノデハナイカト気ニシタ事ガアッタガ、ソノコロカラ悪カッタラシイ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――アノ小鳥タチハ、ナゼイツモ、コッチ側バカリ向イテイル、デスカ？",
              "citation": {
                "source": "夏の日の夢",
                "author": "THE DREAM OF A SUMMER DAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　丁度、主客の話題が、なくなつた青年の追懐から、その日常生活のデイテイルに及んで、更に又、もとの追懐へ戻らうとしてゐた時である。",
              "citation": {
                "source": "手巾",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンノ下ノ小犬ノコトハオ母サンニ言ワナイデ下サイ九月三日午後七時半　ナイテイルカラカクシテモワカッテシマウト思イマス　小犬のことは、そのほかにも数通あった。",
              "citation": {
                "source": "アンゴウ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏目金之助　　　　　高浜清様　　　　　　○明治三十九年十二月十六日（葉書）　只今頗ル艶ナ所ヲカイテイル。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ中デハ海綿ニ濡レタお湯ガ沸イテイル。",
              "citation": {
                "source": "内科",
                "author": "――自家用福音――　――或ハ　エリエリラマサバクタニ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ颯子ガ不自然ナ方法デ生マナイヨウニシテルノデハナイカ、ドウモソウラシイト云ウ疑イヲ、婆サンハ抱イテイルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ去年ノ日記帳ヲ繰ッテ見ルト、コノ出来事ノ記載ガ詳細ヲ缺イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハ夜モ晝モ廊下ヲ曲ッタ茶ノ間ノ方ニ引ッ込ンデイテ、殆ド一日テレビヤラジオヲ聞イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "入浴ノ助手ヲスル時、彼女ハブリュウデエッフェル塔ノ模様ノ附イタポロシャツヲ着テ、膝ノトコロマデノトレアドルパンツヲ穿イテイルノガ、素晴ラシクスッキリト意気ニ見エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ寝タフリヲシナガラ、颯子ノガウンノ端カラ覗イテイル支那履ノ小サク尖ッタ尖端ヲ見テイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "牡丹ノ刺繍ノ履ガ覗イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ時間ニ外ノ廊下ヲウロツイテイルノハ予モオカシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯様ナ場合、浴衣ヲ借リルクライハイヽガ、階下ノ客間ナリ応接間ナリ茶ノ間ナリ、今ハ婆サンモ留守デアルカラ至ルトコロガ空イテイルノニ、二階ヘ上ルニハ及ブマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何デモ三井化学アタリカラ樹脂原料ヲ買イ入レテ写真フィルム、ポリエチレン被膜、ポリエチレン成型品、バケツダノ、マヨネーズノチューブダノト云ッタ類ヲ製造スル会社デアルト聞イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "拂暁、午前五時頃ト思ウ、ウト／＼シナガラ聞イテイルト、何処カデ蟋蟀ガピイピイト鳴イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド確ニピイピイト鳴イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナピイピイシタ可愛イ声ガ自分ノ体カラ出テイルトハ思エズ、ドウシテモ虫ガ鳴イテイルヨウニ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "息ヲ強クスルト音モ強クナリ、マルデ笛デモ吹イテイルヨウニピイピイト鳴ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレカラ何処ヘ出カケヨウトスルノカ、何処ノ部屋ヲ歩イテイルノカヨク分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯ノ間カラ莨入レト煙管ノ袋ヲ取リ出シテ一服吸ッタ様子デアルカラ、茶ノ間ニ坐ッテイタヨウデモアルガ、イツノ間ニカ門外ヘ出タラシク、素足ニ吾妻下駄ヲ穿イテ歩イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "袵ニモブルーノ裏ガチラツイテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何カ鉄板ノヨウナ重味ノアルモノガ足ノ裏ヘペッタリ貼リ着イテイル感ジデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "覚メテ見タラ汗ヲビッショリ掻イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナニ寝ツキノヨカッタ予モ、コノトコロ痛苦ノタメニ寝ツカレズ、各種ノ睡眠剤ヲ用イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
