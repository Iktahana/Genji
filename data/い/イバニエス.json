        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "道玄坂の古本屋で、イバニエスのメイ・フラワア号を買う。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "神田の古本屋でイバニエスを売る。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この詩はイバニエス氏の詩なんです。",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうです西班牙の神秘派の詩人、若くて生きているイバニエス氏の詩なんです。",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてイバニエス氏は詩の所々を、いつもこんなように……にして、ぼかして了う癖を持っているのです。",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ併しちょっと待って下さい、その前に私はもう一つだけ、イバニエス氏の極わめて科学的の詩を、ご紹介して置きたいのですから。",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "作家イバニエスの故国においてにしろ、そういう要素が活躍したのですから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
