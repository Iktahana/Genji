        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "と言う質問は、ヴァイオリンは楽器であるかという質問に同じく、馬鹿馬鹿しくとぼけて聞える。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この感情の本質は涙ぐましく、甘くスイートな気分に充ちてヴァイオリンのようにメロディアスのものである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨年の晩秋、ヨオゼフ・シゲテイといふブダペスト生れのヴアイオリンの名手が日本へやつて來て、日比谷の公會堂で三度ほど演奏會をひらいたが、三度が三度ともたいへんな不人氣であつた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬場はときたま、てかてか黒く光るヴアイオリンケエスを左腕にかかへて持つて歩いてゐることがあるけれども、ケエスの中にはつねに一物もはひつてゐないのである。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の言葉に依れば、彼のケエスそれ自體が現代のサンボルだ、中はうそ寒くからつぽであるといふんだが、そんなときには私は、この男はいつたいヴアイオリンを一度でも手にしたことがあるのだらうかといふ變な疑ひをさへ抱くのである。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私もまたヴアイオリンよりヴアイオリンケエスを氣にする組ゆゑ、馬場の精神や技倆より、彼の風姿や冗談に魅せられたのだといふやうな氣もする。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴアイオリンを手にしたのを見たことがない。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "効能書のない薬品なんて、絃の無いヴァイオリンみたいに、はかなく落ちつかない気が致します。",
              "citation": {
                "source": "正直ノオト",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "食糧を貯蔵しなかった怠け者の蟋蟀が木枯しの夜に死んで行くというのが大団円であったが、擬音の淋しい風音に交じって、かすかなバイオリンの哀音を聞かせるのが割に綺麗に聞きとれるので、これくらいならと思って安心したのであった。",
              "citation": {
                "source": "ラジオ雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "数学が出来ると同じ程度にヴァイオリンが出来る。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の弾くヴァイオリンが一人前のものだという事は定評であるらしい。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばヴァイオリンのＥ線だけによる協奏楽というものが、もしあったとしたら、丁度こんなものではないかという気がした。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "広庭を一つ隔てた母屋の方では、宵の口から、今度暑中休暇で帰省した、牛込桐楊塾の娘たちに、内の小児、甥だの、姪だのが一所になった処へ、また小児同志の客があり、草深の一家も来、ヴァイオリンが聞える、洋琴が鳴る、唱歌を唄う――この人数へ、もう一組。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯が、ぼろぼろに欠け、背中は曲り、ぜんそくに苦しみながらも、小暗い露路で、一生懸命ヴァイオリンを奏している、かの見るかげもない老爺の辻音楽師を、諸君は、笑うことができるであろうか。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶざまでも、私は私のヴァイオリンを続けて奏するより他はないのかも知れぬ。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのような奇妙な、『ヴァイオリンよりは、ケエスが大事式』の、その方面に於ける最もきびしい反省をしてみるのでした。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は太宰治に、ヴァイオリンのようなせつなさを感ずるのは、そのリリシズムに於てであった。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨年の晩秋、ヨオゼフ・シゲティというブダペスト生れのヴァイオリンの名手が日本へやって来て、日比谷の公会堂で三度ほど演奏会をひらいたが、三度が三度ともたいへんな不人気であった。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬場はときたま、てかてか黒く光るヴァイオリンケエスを左腕にかかえて持って歩いていることがあるけれども、ケエスの中にはつねに一物もはいっていないのである。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の言葉に依れば、彼のケエスそれ自体が現代のサンボルだ、中はうそ寒くからっぽであるというんだが、そんなときには私は、この男はいったいヴァイオリンを一度でも手にしたことがあるのだろうかという変な疑いをさえ抱くのである。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私もまたヴァイオリンよりヴァイオリンケエスを気にする組ゆえ、馬場の精神や技倆より、彼の風姿や冗談に魅せられたのだというような気もする。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴァイオリンを手にしたのを見たことがない。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣家の、観音開きの戸口からは、馬貫之の細君が、歯がすえるヴァイオリンのような歌を唄うのがひびいてきた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴァイオリンも二いろ風のように鳴っています。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ヴァイオリンの一番の人がいきなり顔をあげて云いました。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は一度ヴアイオリン彈きのクライスラーが舞臺にあらはれたのを見て、まるで狼が洋服を着て出て來たやうな大變「エトランジエ」の感じを起したことがあるが、こんどの感じもそれで、プルウストが彼の祖父さんや祖母さんをより生き生きと書けば書くほどその同じ「エトランジエ」の姿がくつきりして來る。",
              "citation": {
                "source": "「親近」と「拒絶」",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、家外の吹雪の中に一人のヴァイオリン弾きの老爺の乞食が立ち、やがてそれは寒さのために縮んで主人の室の硝子扉に貼りつくように体を寄せました。",
              "citation": {
                "source": "慈悲",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくヴァイオリン弾きの乞食姿をあわれと思って見て居りましたが、やがて意を決して硝子扉を開けました。",
              "citation": {
                "source": "慈悲",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
