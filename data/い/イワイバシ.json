        "examples": {
          "standard": [
            {
              "text": "元旦の朝食には、新しい門出を祝う意味を込めて、必ず祝い箸を使います。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「おばあちゃん、この祝い箸、すごく立派だね！」子供が目を輝かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "おせち料理をいただく際には、両端が細くなっている特別な祝い箸を用います。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "とどうしたはずみか、祖母の祝箸がぽっきりと折れた。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "お雑煮をたべなくたって名を書いた花飾りのある祝箸でたべていいでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたの名、私の名、新しい筆で大晦日の夜お祝箸の袋の上にかいて、先ずあなたのから食べ初めいたしました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
