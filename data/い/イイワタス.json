    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to announce",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "裁判長は被告人に対し、求刑通り懲役五年の実刑を言い渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "医師から「一週間の絶対安静」を言い渡され、楽しみにしていた旅行を断念せざるを得なかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "監督はベテラン選手を個別に呼び出し、非情な戦力外通告を言い渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "会社から不当な解雇を言い渡されたとして、元社員たちが裁判所に訴えを起こした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「二度とこの家の敷居を跨ぐな」と言い渡され、彼は身一つで実家を追い出された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "審判員は両力士の足が同時に土俵の外に出たと判断し、取り直しを言い渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「まさか」と、信じがたい落選を言い渡された彼女は、絶望の表情でその場に崩れ落ちた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "武家で手にあまる道楽者などがあると、戸障子を釘づけにした暗いひと間をあらかじめ作っておいて、親類一同が立会いで本人に一間住居を言い渡す。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "次は何の誰……」　裁判長がそう判決を言い渡すと、僕等のうしろに立っていた巡査の一人が、さあ行こうと言って一緒にそとへ連れて出た。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "事前に方針を明かすことで抵抗の芽が頭をもたげることを恐れた大内は、機構改革の方針を支配人の渡辺和也にも伏せ、この一件に関しては発表の直前になって言い渡す形をとった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "意外や、衣子がキリキリとマナジリを決し絶縁を言い渡す。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "本日、社告を言い渡す。",
              "citation": {
                "source": "カストリ社事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "言い渡すべき件があるから、この召喚状持参の上、自身出頭のこととある。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくすることによって裁判官は欺かれて、離婚を言い渡す。",
              "citation": {
                "source": "嘘の効用",
                "author": "末弘厳太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お裁きを言い渡すのが先、相談はあと。",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭司は調べた後その人に「あなたは汚れている」と言い渡す。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、即ち君、これは学生の義務というものじゃからね、などと言い渡すのだった。",
              "citation": {
                "source": "勉強記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おのおの太刀は背中に背負え」　陶山義高は、言い渡す。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "このごちそうがけっして食後の卓上演説を必要とするほどりっぱなものではなかったのはもちろんであるが、わたしは食事がすんだところで、いまがちょうど仲間の者に二言三言いいわたす機会だと感じた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは、そのことを、いいわたすために、わざわざ、もどってきたのだ。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "風来の魯智深とやらには、試みにまず、その菜園目付役でもやらせて御覧じあっては」「むむ、衆意同案とあれば」　一山の断により、さっそく首座（僧職）がその旨を、智深にいいわたす。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前がたに云い渡す。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何やかやと捫着しているうちに、徳蔵の声はだんだん大きくなるので、山城屋の主人も我を折って、かれの要求する三百両に対して百両を提供して、この以上はどうしても肯くことはならない、これで不承知ならどうともしろと云い渡すと、徳蔵の方でも我を折って、とうとうそれで納得することになった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "弁天娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間への義理や家内への示しのため、親類会議の真中へ一人息子を呼び出して、「久離切っての勘当」　を云い渡す親達の怒った眼と正反対に涙ぐましい鼻の表現――そこにすっかり現われている千万無量の胸のうちは、その座にいる人々をして道理至極とうなずかせずには措きません。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃあここへ連れて来い」　小六がお延に云い渡すと、大月玄蕃はそそくさとそこに掛けてあった熊谷笠を外し、何か二言三言云い残すが早いか、金井一角と共に風の如く裏口から抜け出してしまった。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど……そうだね、今着ている着物をくれてやって、塩の二升も施しておやり」　於福は、自分一人で云い渡すのは、何だか日吉に対して不気味な気がしたので、ほかの雇人を連れて、一緒に外の陶器蔵へ歩いて行った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一同の者へ云い渡す……」　藤吉郎は、まるで無頓着かのように、大声で云った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「然らば、その間、磔柱に縛りおくぞ」　云い渡すと、郎党たちは、彼を拉して、あらかじめ作っておいた十字架に、彼の手頸足頸を縛りつけた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "光春はすぐ令を下して、「云い渡すことがある。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまは汝の首を斬るも、一匹の蠅をたたくほどな憐愍も感じ得ない」　云い渡すと、すぐ将士に渡して城外で、首を刎ねさせた。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪く思っちゃいけないぜ」　親分が云い渡すと、子分の川手氏は、急には答える言葉も見つからぬ様子で、破れソフトの下から、目をパチパチさせるばかりであった。",
              "citation": {
                "source": "悪魔の紋章",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、若杉裁判長は、罪を憎んで五年の懲役をいい渡すと同時に、執行猶予の恩典を付けることを忘れませんでした。",
              "citation": {
                "source": "若杉裁判長",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "――各※、手足を洗うて、厩の馬に鞍をつけ、先に坂下の門まで出ておるがよい」　いい渡すと、「暫時、失礼を」　と、石舟斎は、自分も身支度のため、館のうちへ入って行った。",
              "citation": {
                "source": "剣の四君子",
                "author": "柳生石舟斎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後の事、捨ておいて、退去してよろしい」　いい渡すと、役人らは馬上へ返って、ふたたび野末へ駈け去った。",
              "citation": {
                "source": "宮本武蔵",
                "author": "水の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その儀につき、一同して参りましたが、武蔵へいい渡す試合の場所、日時、あれは、どういうことに決めますかな」「さよう？",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし向後のこともあるから、その縄目は、ひとりでに解ける時までそうしておく」　いい渡すと小次郎は、何思ったか、小柄でそこの樹の皮を削りだした。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "望みにまかせて剣山へ連れて行ってやる、わざわざ迎えにきてやったのだ、神妙にしろよ」　こういい渡すと左右にいた原士が、バラリッと二人の前へ縄を解いた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "木曾の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
