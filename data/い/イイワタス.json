[
  {
    "uuid": "533304d1-c17d-5a91-8eb0-b9c125dabaaf",
    "entry": "言い渡す",
    "reading": {
      "primary": "いいわたす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
