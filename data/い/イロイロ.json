  {
    "uuid": "b8809715-ee52-5e8b-a4e3-93fa071353c9",
    "entry": "イロイロ",
    "reading": {
      "primary": "いろいろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヤマデハ　ヤマキチ　ノ　ナカヨシ　ノ　イロイロ　ノ、トリ　ヤ　ケモノ　ガ、ヤマキチ　ノ　カエリ　ヲ、タイソウ　ヨロコビマシテ、ウタ　ヲ　ウタウヤラ、オドリ　ヲ　オドルヤラシテ　カンゲイ　シマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イロイロナモノガ私ノ心ヲオドラセマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイロイロナ構図デ頭ガイッパイニナッテイルノデスガ、ナニシロマダカクダケノ腕ガナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デンデン　蟲々　ツノ　出セヤ　ダツタカナア」ト、イロイロ　カンガヘタガ、チツトモ　ソノ　ウタハ　オモヒダセマセンデシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ、イロイロ　サガシタガ、アマリ　ヨイ　キカイガ　ナイノデ、ラツパヲ　カツテ、「コレヲ　サカサマニ　シテ　ミミニ　ツケテ、ラツパノ　シリカラ　キキナサイ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ　イロイロ　カンガヘテカラ、マタ　マエノ　ラツパト　オナジ　ラツパヲ　オクツテ、「コノ　ラツパヲ　ミミニ　ツケルト　ワタシノ　コヱガ　キコエマス。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イロイロナ　ゴチソウガ　デマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカヤ　アヲヤ　キイロヤ　ムラサキヤ、イロイロナ　フウセンダマハ　ホホヲ　スリヨセナガラ　カゼノ　フク　ハウヘ　ナビイテ　ヰマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『……イロイロ……セワニ……ナッタ……』『ウム。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イロイロオセワニナツタコトヲシンシヤス」と書いた。",
              "citation": {
                "source": "海をわたる",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガハバカリニ入ッタ後、私ハ床ノ中デイロイロ考エマシタガ、ドウシテモ彼女ニ会ッテ彼女ノ心ヲ飜エサネバナラヌト思イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アキニ、ナッテ、イロイロ、モノイリガ、シテオクレマシタ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アキニ、ナツテ、イロイロ、モノイリガ、シテ、オクレマシタ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリの方へ、イロイロの事を詳しくかいて、手紙をたのむ。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "隆治さんから十九日に電報が来て、　イロイロノゴハイリヨアリガタクウケマシタゲンキニシユツパツ　とありそれを見たら涙が浮びました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダサウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダソウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「翌日、拝領屋敷ヘ行ッテ、家主ヘ談ジテ金子二十両借リ出シテイロイロ入用ノモノヲ残ラズ拵エテ、十日目ニ出勤シタ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレカラ兄ヘ只ハ済マヌカラ、書附ヲ出セト云ウカラ、ソレモシナカッタ、姉ガイロイロ心配ヲシテ、諸寺諸山ヘ祈祷ナド頼ンダトイウコトヲ聞イタカラ、翌年春、挨拶安心ノタメ隠居シタガ、三十七ノ歳ダ」　三十七にもなるどうらくおやじを檻には入れそこなったが、隠居ということで、兄貴たちもまず安心の体。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　ナニヲキタライイカ、イロイロト　ソウダンシテヰルウチニ、ダンダント　ネムクナツテ　キマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　ナニヲキタライイカ、イロイロト　サウダンシテヰルウチニ、アマリ　ポカポカト　アタタカイモノデスカラ　ダンダント　ネムクナツテキマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテイロイロナ意味ニ取レル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真ハ全裸体ノ正面ト背面、各部分ノ詳細図、イロイロナ形状ニ四肢ヲ歪曲サセ彎屈サセ、折ッタリ伸バシタリシテ最モ蠱惑的ナル角度カラ撮ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデイロイロ不自然ナ、無理ナ方法デ強イテ感情ニ刺戟ヲ与エ、辛ウジテアノ病的ニ絶倫ナ妻ニ対抗シテイル次第ダガ、コンナヲ覚エ、ブランデートイウ妙薬ヲ見ツケ出シタオ蔭デ、目下ノトコロ、僕ハ自分ニモ不思議ナクライ旺盛ナ慾望ニ駈ラレテイル。",
              "citation": {
                "source": "鍵",
