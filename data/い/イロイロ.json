[
  {
    "uuid": "c32cd73f-4fd3-54cc-9df7-c7607404cd94",
    "entry": "色々",
    "reading": {
      "primary": "いろいろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "various",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この店には、色々な種類の土産物が並んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供たちは、色々な遊びに夢中になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "先生は、生徒たちの質問に色々に答えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "週末は、色々な場所を散歩するのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "人によつて色々異ることと思ひますが、私は詩に就いては自分に分るやうにだけは考へますが、それを人に分らせようとするや大変骨が折れます。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々と詩論は毎月の雑誌にも現れてをりますが、此の雑誌に訳載中のアランの論文と、それからこれは直ちに詩論と呼べる限りのものではありませんが、フィードレルの芸術論、まづまづ此の二つが此の数年来に読みました詩論の中で心に残つたものであります。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々あるどころか無数にあつて、空気中のオゾンの量に因ると考へる人だつてないとは云へぬ。",
              "citation": {
                "source": "山羊の言",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の詩を辿り乍ら、この稿を書いてゐる今、色々と心に浮ぶことを、何の反省をも加へずに、唯々書誌してみたいと思ふ。",
              "citation": {
                "source": "海の詩",
                "author": "――人と海――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、色々と分析的な努力をもしてみたが、やはり駄目で、すつかり自信を失つた気持であるやうな場合もあつた。",
              "citation": {
                "source": "詩壇への抱負",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "感情といふ語の内容も色々であらうが、「独り居て怡しむ」底の感情、対人的に発露するに非ざる、そこはかとなき欣怡の情である。",
              "citation": {
                "source": "感情喪失時代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その混乱をなんとか見究めようとして色々に考へても、それは自分で椅子に乗つて自分で椅子を動かさうといふのと同様、努力すれば努力する程拙いこととなるのである。",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん薄暗くなって色々の灯でいろどられてゆく上野広小路の雑沓の様子を見おろしていたのである。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々の事を、はっきりと教えてくれるので、私も私の疑念を放棄せざるを得なかった。",
              "citation": {
                "source": "六月十九日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々の解釈があるのではない。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るにその悲しみ方に色々ある。",
              "citation": {
                "source": "小林秀雄小論",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあ色々でこそ此の世が成立つのだらう……」――そんな客観的な考へで、私は自分が何かに付けて思索する癖のあることを、不幸かも知れないといふ半面の気持に強ひられて、好い加減でうまく胡魔化して置きたかつた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこれには色々な事情があったのである。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年時代になってからも、色々恐ろしい幻覚に悩まされた。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもそれを色々隠して、来客と話さねばならないのである。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "募集した絵をゆっくり一枚一枚点検しながら、不折や虚子や碧梧桐を相手に色々批評したり、また同時に自分の描いておいた絵を見せたりして閑談に耽るのがあの頃の子規の一つの楽しみであったろうということも想像される。",
              "citation": {
                "source": "明治三十二年頃",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "置所から色々の供物を入れた叺を持ってくる。",
              "citation": {
                "source": "祭",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番大きな下の壇へは色々な供物の三宝が並べられる。",
              "citation": {
                "source": "祭",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後この文房具店で同じような色々の皿を見付けて一つ欲しいと思い立ったが、今日まで機会がなかったのである。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々記入する書式の中の宗教という項に神道と書いたら、それはどういう宗教だと聞かれて困った。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘルマンは古典に通じていて、気象の講義にも色々古典の引用が出て来た。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつか、カナダのタール教授が来て氷河に関する話をしたときなど、ペンクは色々とディスクシオンをしながら自分などにはよく分らぬ皮肉らしいことを云って相手を揶揄しながら一座を見渡してにやりとするという風であった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "講義や輪講の外に色々の見学があった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペンクの足の早いのとベーアマンの口の早いのとに悩まされたが、ずいぶん色々とためにはなった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "地理学書でもまた物語でも読んで知っていたアトリオ・デル・カヴルロとかソマムとか、こういう名前も何となく嬉しく、また地質学者から教わる色々の岩石の名前も珍しかったと見えてよく覚えている。",
              "citation": {
                "source": "二つの正月",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "下り坂の茶店で休んだときにそこのお神さんが色々の火山噴出物の標本やラヴァやカメーの細工物などを売付けようとしたが、こしらえもののいかものだけはわが地質学者を欺く訳に行かないのがおかしかった。",
              "citation": {
                "source": "二つの正月",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々の手拭やタオルの洗濯したのがその上に干し並べてある。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々の集会もここであった。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野の動物園の森で一度に鳴き出す色々の鳥類のけたたましい声が聞こえる。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ってこの想い出には色々の思い違いがあることと思う。",
              "citation": {
                "source": "初旅",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
