        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは山に隠れてゐた僧のイルラリオンが聖なる生涯を閲し尽して草庵の中で亡くなつたと云ふのである。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "イルラリオンは草庵に十八年住んでゐた。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前は今からバイシウス長老の所へ往つて、イルラリオンの跡の草庵に住まふやうに願ふが好い。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはイルラリオンのやうな清浄な人の代になるお前だと云ふのではない。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "亡くなつた先住イルラリオンもそこに葬つてある。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
