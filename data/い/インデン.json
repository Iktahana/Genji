        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "〔雪うづまきて日は温き〕雪うづまきて日は温き、　　萱のなかなる荼毘壇に、県議院殿大居士の、　　　　柩はしづとおろされぬ。",
              "citation": {
                "source": "文語詩稿　五十篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "御院殿坂に鳴く蜩の声や邸後を通過する列車の騒音を聞くような心持がする。",
              "citation": {
                "source": "子規の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の御院殿坂を捜して墓地の中を歩いているうちに鉄道線路へ出たがどもう見覚えがない。",
              "citation": {
                "source": "子規自筆の根岸地図",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰りにはやっぱり御院殿の坂が見付かった。",
              "citation": {
                "source": "子規自筆の根岸地図",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、人通りは少し、日向の眞中を憚る處もなく、何しろ、御院殿の方へ眞直だ、とのん氣に歩行き出す。",
              "citation": {
                "source": "松の葉",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」六　戴いたのは新しい夏帽子、着たのは中形の浴衣であるが、屹と改まった様子で、五ツ紋の黒絽の羽織、白足袋、表打の駒下駄、蝙蝠傘を持ったのが、根岸御院殿｜寄のとある横町を入って、五ツ目の冠木門の前に立った。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶯谷を下りて御院殿を傍に見て、かの横町へ入ると中ほどの鴨川の門の前に、二頭立の馬車が一台、幅一杯になって着いていた。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが荼吉尼法は著聞集に、知定院殿が大権坊という奇験の僧によりて修したところ、夢中に狐の生尾を得たり、なんどとある通り、古くから行われていたし、稲荷と荼吉尼は狐によって混雑してしまっていた。",
              "citation": {
                "source": "魔法修行者",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたかもこの日はお二代台徳院殿様、すなわち前将軍｜秀忠公のご忌日に当たるところから、例年のごとく将軍家の増上寺お成りがあるため、お城内も沿道もたいへんな騒ぎでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと口にいったら、芝のあの三縁山へお成りになって、そこに祭られてある台徳院殿さまの御霊屋に、ぺこりとひとつ将軍家がおつむりをお下げになるだけのことですが、下げる頭が少しばかり値段の高い八百万石のおつむりですから、事が穏やかでないのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手の方に柵を控えたのには梅花院殿瘠鶴大居士とあるから大方大名か旗本の墓だろう。",
              "citation": {
                "source": "趣味の遺伝",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "上に云つた如く、霊台院殿信誉自然現成大姉は津軽氏比佐子で、墓は浅草西福寺にある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "養真院殿元活瑞仙大居士は初代瑞仙錦橋である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "芳松院殿縁峰貞操大姉は錦橋の妻｜菱谷氏である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "善勝院殿霧渓瑞翁大居士は二世瑞仙直卿である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "養寿院殿本如瑞仙大居士は三世瑞仙直温である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "保寿院殿浄如貞松大姉は直温の妻にして瑞仙の家第四世の女主啓、窪田氏である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "故考広福院殿道詮徳明劉府君之墓。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸子は既に卒して、法諡を瑤津院殿瓊山妙瑩大禅尼と云ひ、祥雲寺に葬られた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "霧渓の子｜直温の繕写した過去帖には「芳松院殿緑峰貞操大姉、同人（初代瑞仙）妻、佐井氏、実菱谷氏女、嘉永元戊申年十二月六日卒、葬于同寺（嶺松寺）」と書してある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "正面中央には「正宗院湛然妙総禅定尼、」右側面には「瑤津院殿侍女、俗名世代、福山伊沢長安信階女、嘉永四年辛亥十二月十三日死、」左側面には「福山伊沢長安信厚、筑前伊沢道盛信全」と刻してある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その翌年の文化六年に、越前国丸岡の配所で、安永元年から三十七年間、人に手跡や剣術を教えて暮していた夫伊織が、「三月八日｜浚明院殿御追善の為、御慈悲の思召を以て、永の御預御免仰出され」て、江戸へ帰ることになった。",
              "citation": {
                "source": "じいさんばあさん",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時田辺城には松向寺殿｜三斎忠興公御立籠り遊ばされおり候ところ、神君｜上杉景勝を討たせ給うにより、三斎公も随従遊ばされ、跡には泰勝院殿幽斎藤孝公御留守遊ばされ候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "寛永九年十二月九日御先代｜妙解院殿忠利公肥後へ御入国遊ばされ候時、景一も御供いたし候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "十八年三月十七日に妙解院殿卒去遊ばされ、次いで九月二日景一も病死いたし候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙解院殿の御代に至り、寛永十四年冬｜島原攻の御供いたし、翌十五年二月二十七日｜兼田弥一右衛門とともに、御当家｜攻口の一番乗と名告り、海に臨める城壁の上にて陣亡いたし候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "これより二年目、寛永三年九月｜六日主上二条の御城へ行幸遊ばされ妙解院殿へかの名香を御所望｜有之すなわちこれを献ぜらるる、主上｜叡感有りて「たぐひありと誰かはいはむ末※ふ秋より後のしら菊の花」と申す古歌の心にて、白菊と名附けさせ給由承り候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後某は御先代妙解院殿よりも出格の御引立を蒙り、寛永九年｜御国替の砌には、三斎公の御居城｜八代に相詰め候事と相成り、あまつさえ殿御上京の御供にさえ召具せられ候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "某をば妙解院殿御弟君｜中務少輔殿立孝公の御旗本に加えられ御幟を御預けなされ候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
