  {
    "uuid": "c39b7a87-169b-51cd-87eb-ce5c7d3bceee",
    "entry": "イオリ",
    "reading": {
      "primary": "いおり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
