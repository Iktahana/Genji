        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "タキクンノ　オトウサンハ　ソレヲ　キクト、タキクンノ　ハウヲ　キツト　ミテ、「タキ、イジメタリ　シテハ　イケナイヂヤ　ナイカ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　タキクンガ　イフト、「オマエガ　イケナイ！",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ、タキクンノ　カホヲ　ノゾキコミナガラ、「オトナシク　シナキヤ　イケナイヨ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコタチハ　トホクヘ　イキタガツテ　シヨウガ　ナイノデ、オカアサンノ　タケガ、「ソンナニ　トホクヘ　イツチヤ　イケナイヨ、ヤブノ　ソトニ　デルト　ウマノ　アシニ　フマレルカラ」ト　シカツテ　ヲリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは五月なかばの雨の日に市村座へ出かけて「ダンナハイケナイ」の劇を見物したが、それは全くイケナイものであった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ一度はここまで来る筈ですから……チット荒療治ですけど……ホホホ……」「……イ……イケナイ。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "知っているからこそ、君と関係があると云うんじゃないか」「……じゃ……それをスッカリ僕に話して下さい」「……イケナイ……」　正木博士は、こうキッパリと云い切ると、葉巻を横ッチョに啣え直した。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに連れて後から後から福太郎に盃を持って来る者が多かったが、その中でも最前から何くれとなく世話を焼いていた仕繰夫の源次が、特別に執拗く盃を差し付けたので、元来がイケナイ性質の福太郎は逃げるのに困ってしまった。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ取りあえず羽振医学士にぶつかって、コイツはイケナイと気が付いたから、筋書の中から叩き出してしまった訳なんだが、しかし、これから先がどうしていいかわからないので困っているんだ」「まったくで御座いますわねえ、わたくし共でも、見当が付きかねますわ」「ウム。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "流石のドン様ドン様連中も、最早イケナイと覚悟したらしいんだね。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……イケナイイケナイ。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常な重大事件だから……お前が関係しちゃイケナイ問題なんだから絶対に局外中立の態度で、黙って見てなくちゃイケナイ重大事件なんだからね」「わかっててよ。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その喧嘩の話は決して喋舌っちゃイケナイって云ってねあの女、自分がオセッカイのお喋舌のもんですから、イチ子さんにシッカリと口止めをしといてから、わざわざやって来てソッと私に知らしてくれたのよ。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「玲子さん……僕は今のお母さんが初めてこの家に来られた時からこの女はイケナイ人だ……玲子さんのためにならない人だということを看破っていたのです。",
              "citation": {
                "source": "継子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "書いてもみたが皆イケナイ。",
              "citation": {
                "source": "探偵小説漫想",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "必ず自分の井戸から汲んだ水でなければイケナイようである。",
              "citation": {
                "source": "探偵小説漫想",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたをここに捨てて逃げてゆきます」「イケナイ。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "然も一粒撰りの者ばかりで、これ以下の「イケナイ」のは無数だという。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何といふ図々しい頼みをするイケナイ男なんだらう。",
              "citation": {
                "source": "坂道の孤独参昧",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし、串談はとにかく」と三吉は姉の方を見て、「後家さんというものはそんなにイケナイものでしょうか」「後家に成って、何の好い事があらず」　と姉は力を入れた。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がツケツケ言うもんですからネ、『お前はイケナい奴に成った、今まではもっと優しい奴だと思っていた』なんて、吾夫がそう言って笑うんですよ……でも、貴方、今までのような大きな量見でいられると、失敗するのは眼に見えています。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日も魔子は遊びに来るかも知れないが、「魔子ちゃんが来ても魔子ちゃんのパパさんの咄をしてはイケナイよ、」と小さい児供を戒めた。",
              "citation": {
                "source": "最後の大杉",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
