[
  {
    "uuid": "462071a8-45ac-5b79-9777-1b0c8bd65074",
    "entry": "医する",
    "reading": {
      "primary": "いする",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-サ変-特殊",
