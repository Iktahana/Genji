        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イソイデ、オ母ッチャノ方ニ手ヲノバシテヤッテ、ヨナカニコエヲ出スノガオッカナイノデ、ハジメダマッテユスッテイタガ、オ母ッチャハナカナカ目ヲサマサナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "山崎長之輔ノ一座ニ属シ中洲ノ真砂座ニ出テイタガ、ヤヽ老イテカラハ六代目ノ面差ニ似テイタ先代嵐芳三郎ノ相手役トシテ宮戸座ニ出テイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ劇場内ハ冷房シテイタガ、コノ冷房ガ予ニハ禁物ナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五子モ陸子モ予トハ反リガ合ワナイデ喧嘩バカリシテイタガ、ヤハリ声ヲ挙ゲテ泣ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間ホド揉メテイタガ、シマイニオ爺チャン、チョットイラシッテ下サイト、婆サンガ予ヲ呼ビニ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年ノ夏マデハ、予等夫婦ハ同ジ日本間ノ部屋ニ枕ヲナラベテ寝テイタガ、去年日本間ヲ板敷ニシテベッドヲ二台据エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハソレ以前カラモ時々自分ダケ茶ノ間デ寝テイタガ、ベッドニシテカラハ完全ニ別レ／＼ニ寝ルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "月々ノ家計ハ数年前マデ婆サンガ処理シテイタガ、イツカラカ颯子ガ当ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "惚レッポイコトモ惚レッポイガ飽キッポイコトモ飽キッポイノハ親譲リデ、若イ時ノ予ト同様デアルト考エテイタガ、今日デハ左様ニ簡単ニハ云エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モト予ノ一家ハ本所割下水ニ数代前カラ住ンデイタガ、父ノ代ノ時本所カラ日本橋区横山町一丁目ニ移ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハジットソノ顔ヲ見ツメテイタガ、ナイト・テーブルノ抽斗カラ手鏡ヲ出シテソレヲ予ニ突キ付ケテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若イ時カラ女房ナドニ始終意地悪ヲ云イツヾケテ悪党ガッテイタガ、ソノ女房ニ泣カレルト、カラッキシ意気地ガナク負ケテシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「死ンダッテ何ダ」ト思ッテイタガ、死ニソウナ気ハシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ今度ノ京都行ヲカネテカラ楽シミニシテイタガ、京都滞在中ニ一日オ暇ヲ戴イテ奈良見物ヲサセテクレト云ッテイタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ハ茶ノ間デ妻ヤ敏子トシバラク話シテイタガ、三時過ギニ「麗しのサブリナ」ヲ見ニ行クト云ッテ、三人デ出カケタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハイクラカ青イ顔ヲシテイタガ、酔ッタ様子ハ見エナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体妻ハ来客ニ対シテハ不愛想デ、コトニ男ノ客人ニハ会イタガラナイノデアルガ、木村ニダケハ親シムノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………正午過木村カラ学校ヘ電話、「御容態ハイカガデスカ」ト云ウカラ「今朝僕ガ出カケル時マデハ寝テイタガモウ何デモナサソウダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシトニカクオ見舞イニ参リマス」ト云ッテイタガ、午後四時ニ来タ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ワレテ僕ハ直チニ一ツノ着想ヲ思イツイタガ、シカシ、僕ニソウイウ機械ノアルヲ、ドウシテ木村ハ察シタノデアロウカ、ソレガ不思議ダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂場ト離レ屋トヲ廊下デツナゲルノト、ピアノノ床下ニ煉瓦ヲ積ム工事ハアラカタ終ッタガ、電話ノ切リ換エガマダデアルシ、今日ハ赤口デ日ガ悪イカラ二十一日ノ大安マデ待チナサイト昨日郁子ハ云ッテイタガ、敏子ハ構ワズ行ッテシマッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕モマダ寝床ニイタガ、彼ノ声ガスルノデ起キテ茶ノ間ニハイルト、「先生、オーケーデス」ト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（コンナ時ニ先日ノ記憶喪失ガ襲ッテ来ハシナイカトイウ恐怖ガ、チラト脳裡ヲカスメタ）僕ハ関田町ノ家ノ所在ハ分ッテイタガ、中ヘハイルノハ始メテダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サッキノ買イ物包ミハ提ゲテイタガ、僕ノ見テイル前デハソレヲ解カナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………妻ノ外出時間ガ昨日アタリカラ変更サレルノデハナイカト、カネテ僕ハ豫期シテイタガ、果シテソノ通リデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真デ思イツイタガ写真機ガ欲シクハナイデスカ、「パテエ・ベビイ」ハイカガ？",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
