        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "がもう一学期半辛抱すれば、華やかな東京に出られるのだからと強いて独り慰め、鼓舞していた。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月十日から一学期の本試験がはじまっている。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "定性分析のコースを一学期やらせてもらったくらいのものであった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度一学期の試験が済んでその採点も終りあとは三十一日に成績を発表して通信簿を渡すだけ、私の方から云へばまあさうです、農場の仕事だってその日の午前で麦の運搬も終り、まあ一段落といふそのひるすぎでした。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "古着屋の娘は一学期出たきりで、ずっと学校を休んで薄暗い奥の部屋でねているのだが、父親が町内の有力者で、学務委員もしていた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし一学期もすまぬ間に、彼は自ら進んで退学届を出した。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あいつはたかが点取虫だ」　一学期の試験の前日、豹一は新世界の第一朝日劇場へ出掛けた。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――二学期はわりに良く出来たんですが、一学期の点が悪いんです。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の二人は一学期の点をそのままつけた。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、リード大学以外どこへも行きたくないと言っていたが、結局は一学期間しか通わなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は大学には一学期間顔を出しただけで、その後インドを二年間放浪。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それゆえ彼は第一学期の試験が来るまで、じっと自分の家にいて養生をしながら過ごそうと思いついたのだ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘇枋咲くと、樗そよぐと、霜置くとあはれ、一学期二学期よとあはれ、日の照ると、雨ふると、風ふくと、寝ると起きると、制帽かむる。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "この一学期のあいだに、高志はかなり背が伸びた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一学期とおんなしだ」　そうこたえる高志の声には、推測の響きはない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "塾の寄宿舎に入っていたから、舎費｜即ち食糧費としては月二円で済み、予備門の授業料といえば月｜僅に二十五銭（尤も一学期分｜宛前納することにはなっていたが）それに書物は大抵学校で貸し与えたから、格別その方には金も要らなかった。",
              "citation": {
                "source": "私の経過した学生時代",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局一年と一学期辛抱した後、このほど思い切って、好きなヴァイオリンの試験を受けて、新音楽協会の練習所員となった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "下読などはほとんどやらずに、一学期から一学期へ辛うじて綱渡りをしていた。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "何日しか四箇月が過ぎて、七月の末は一学期末の試験。",
              "citation": {
                "source": "二筋の血",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "一学期も終ろうとする頃までには捨吉は大分自分の新しい周囲に慣れて来た。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "一学期の間の成績から押して見ると、いかなる学課も人に劣るまいとするような気象の勝った生徒ではないらしかった。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして要するに、一学期間はみんな仮入学を許して、九月からほんとうの生徒になるんだからというので、僕は入学を許されることとなった。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争がはじまつてケラア先生の帰国の噂も立消えとなり、太郎は八才で学生鞄をさげたところ、第一学期の成績から、操行点一つが乙で、卒業までもそれは取り返しがつかなかつた。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、一学期の通知簿には、私の操行点は後にも先にもたった一度、「乙」に下っていた。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は一学期の試験からもう首席だった。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "三年の一学期は憂鬱に始められた。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一学期くりあげの卒業です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この学校に一学期しかいなかった心持にこんなことも作用したと思う。",
              "citation": {
                "source": "青春",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "目白の女子大にいたのは、ほんの一学期であったが、ここで知った網野菊子さんは、今も私の誠意ある友達の一人である。",
              "citation": {
                "source": "なつかしい仲間",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
