    "definitions": [
      {
        "index": 1,
        "gloss": "nest (of boxes)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この宝箱の中には、さらに小さな金貨の袋が入れ子になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "お土産に買ったマトリョーシカ人形は、一番大きいものでも5つの入れ子だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "限られたスペースを有効活用するため、入れ子の収納ケースを購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その備品であるベッドとロッカーをぜんぶ使い、入れ子のようにして、この丸太小屋がつくってある。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　大小の行李が入れ子になることで、下宿にいても彼は行李の数からの圧迫を忘れていたという。",
              "citation": {
                "source": "風",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "この町は曲物細工も甚だよく、地方色の鮮なものとしては、「浜弁当」と呼ぶ入れ子のある蓋の深い曲物で、楕円形をしたものがあります。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "行李の中には珍らしくも入れ子が四つ重ねてあります。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "入れ子には更に仕切りをして薬の類を分けますから、これが重宝な行李であるのは言うを俟ちません。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "容器同士は入れ子で、それぞれ十センチメートルずつ短く、端部で保持される。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "容器というか缶が正しく入れ子になっていることを確認して、各｜缶底から導火線を八本引き上げた。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "内缶は十センチ長い外缶にはいるから、全て入れ子に出来て、最上の二個だけが三番目より十センチ突き出て、あとの缶は見えない。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "この竹籠ものちには長方形の、いくつも入れ子のあるよい格好のものになっていたが、五十年前にわたしなど見ていたのは、ただ農家の桑摘みや落葉掻きに、つかっていた目籠もおなじであった。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして見ると、彼の豊に対する愛情は、亡き妻に対し、見えない神に対し、また豊の陰にいれこになっている未見の子孫達に対する愛情とすっかり混り合っているのである。",
              "citation": {
                "source": "風に乗って来るコロポックル",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛鍋屋と同じ、いれこみの座敷の一隅に、俺たちは陣どった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁側をへて障子で仕切られたそのほぼ正方形のスペースは、部屋ぜんたいのおなじく正方形の広がりの奥に、“いれこ”となっていた。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンス、鏡台、トランク、下駄箱の上には、可憐に小さい靴が三足、つまりその押入れこそ、鴉声のシンデレラ姫の、秘密の楽屋であったわけである。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵士はうやまひあつし竹刀とりお前にとうと聲｜徹り撃つ激しくうちあふ竹刀眼には入れこの畏こさに面も小手もわかず營庭にて三聯隊の兵全部凹形に整列し、隊歌を合唱す。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵士はうやまひあつし竹刀とりお前にとうと声｜徹り撃つ激しくうちあふ竹刀眼には入れこの畏こさに面も小手もわかず営庭にて三聯隊の兵全部凹形に整列し、隊歌を合唱す。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はたして藤さんが入れたのだとは断言できぬけれど、しかしほかのものがどう間違ったってこんな物を自分の抽斗へ入れこむわけがない。",
              "citation": {
                "source": "千鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと一しよに、ほかの二人は、へんな薬の草を口へ一ぱい入れこんで、ふう／＼と、あたり一面へ、薄荷のやうなきついにほひのする烟をはき出します。",
              "citation": {
                "source": "蛇つかひ",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ケリムは、かう言はれて、しぶ／＼とその蛇をびんの中へ入れこみました。",
              "citation": {
                "source": "蛇つかひ",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "だれか悪いやつがゐて、或商人を殺して、血のついたナイフをこの人の荷物の中へ入れこんだのだ、そのために、罪もないこの人が犯人にされてしまつたのだと言ひますと、マカールは、「はゝァん。",
              "citation": {
                "source": "ざんげ",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かりに、ほかのやつが、人の荷物の中へ入れこんだものとしても、その本人がつかまらなけやァだめぢやないか。",
              "citation": {
                "source": "ざんげ",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの商人を殺して、ナイフをおまいの袋の中へ入れこんだのは、このおれだよ。",
              "citation": {
                "source": "ざんげ",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "じいつと、頭を下げたなり聞いてゐますと、二人は、今晩、この倉から時計をとり出して、すべての英国船の石炭庫へ入れこむ計画をしてゐるのです。",
              "citation": {
                "source": "勇士ウ※ルター（実話）",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウルターをドイツの士官とおもひこんで、丁寧に迎へ入れ、ウ※ルターの命ずるまゝに、すべての荷物を、大火薬庫の中へ入れこみました。",
              "citation": {
                "source": "勇士ウ※ルター（実話）",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "立つたまゝ食べるのはおつくうなので、お山をひぢかけいすにしてしまつて、その上へ、どつかとこしをかけて、穴の中へ足を入れこみました。",
              "citation": {
                "source": "乞食の子",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――ただいま尾州家より家老をもって内々のお申し入れこれあり、品川宿の一条に対する詮索詮議は爾今無用にされたしとのことに候条、そのほう吟味中ならば手控えいたすべく、右伝達いたし候。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "この大高城兵糧入れこそ、家康の出世絵巻中の第一景である。",
              "citation": {
                "source": "桶狭間合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の努力、自分の熱心、そういうものが、とりも直さず真心からの愛と一致し、その具体的な表現であるとさえ感じて（その経験と摂取において、自分の目に入れこになっている眼を感じて）、信じて生活してゆけることは、何と貴重なよろこびでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、ブランカは自分の人生をすっかり入れこにした心で暮しているのに、そんな風に思える時があるというのは、よほど、やりかたに下手な未熟なところがあるのだね、と云われれば、其は全く一言もないわ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この、きっちりと入れこになって、沖へ出た感じ、何に譬えたら表現されるでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つの戸は内部に入れこになっている一つ以上の世帯を意味している。",
              "citation": {
                "source": "モスクワの辻馬車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
