        "examples": {
          "standard": [
            {
              "text": "亡き祖父の意を酌んで、私たちは古い実家を壊さずに保存することに決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "部長は部下たちの不満げな様子からその意を酌み、急遽ミーティングの場を設けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "言葉には出さなかったが、彼女は私の沈黙から意を酌んで、そっと席を外してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかもしばしば不幸なる誤解があって、人がその真意を酌むことをえない場合がいかにも多かった。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
