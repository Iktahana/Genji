        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『天照皇太神宮』や『稲荷大明神』や『イヱスキリスト』などのお札売はチ※ッと忌ま／＼しさうに舌打をして帰つてしまふのであつた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヱスの道徳は其平々坦々たるところに無量の深味あるが故に尊きなれ。",
              "citation": {
                "source": "実行的道徳",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "容易く知り得べからざるものを容易く人間に施したるは、イヱスのイヱスたる所以なりと云ふべし。",
              "citation": {
                "source": "実行的道徳",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヱスは敢て人間をして悉く人生を観察せしむることを命ぜず。",
              "citation": {
                "source": "実行的道徳",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヱスの奥義は幼児の如くになることにあり。",
              "citation": {
                "source": "実行的道徳",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヱスにありて福なるものは、有つところ多きものより、有つところ少なきものにあり。",
              "citation": {
                "source": "実行的道徳",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナザレのイヱスは真理を説きたるにあらず、真理にして真理を発顕したる者なり。",
              "citation": {
                "source": "最後の勝利者は誰ぞ",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヱス様の聖書を読んでは、一々、胸をさゝれる思ひがする。",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
