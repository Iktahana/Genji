        "examples": {
          "standard": [
            {
              "text": "日本の鉱物学者は、**生野鉱**の新種発見に成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "博物館には、希少な**生野鉱**の美しい標本が展示されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "**生野鉱**は、その独特の結晶構造から研究者の間で関心を集めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "丹波、丹後の方から出て来る要所で、おそらく生野鉱山の開発と密接な関係があったらしい。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "生野鉱山においでになりました山口青邨先生をお迎へしての句会は、夜でございますので帰る汽車がございません。",
              "citation": {
                "source": "椿子物語",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "５　しょうねんたんていだんのたったひとりのしょうじょだんいん、宮田ユウ子ちゃんは、ルビーでできた赤いカブトムシをもって、じぶんのうちのせっこうざいくのこうばにはいって、なにかやっていました。",
              "citation": {
                "source": "赤いカブトムシ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
