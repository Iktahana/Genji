  {
    "uuid": "6a7ebdec-fb24-5014-8a9a-d952bf3552f8",
    "entry": "イモノ",
    "reading": {
      "primary": "いもの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アノイワレハ可愛ラシイモノデス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "早ク見タイモノデス』という焼津の手紙でも解るように、妻と同伴することなしには、どんな旅行も楽しくないほど、夫人を熱愛していたからだった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍家も流石に御不興気のお顔をなされ、何もおつしやらず、さつさと御判をたまはり、相州ハ、マダ、死ニタクナイモノト見エル。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山ハ絵ノ具ヲドッシリ付ケテ、山ガ地上カラ空ヘモレアガッテイルヨウニカイテミタイモノダト思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイバチといふ魚を買つた、十銭、うまくていやみがなかつた（ナマクサイモノを食べたのは、何日目だつたかな）、そしてうどん玉二つ、五銭、これもおいしかつた、今晩は近来の御馳走だつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カイモノノツゴウデトウキョウヘカエルアススグユク　　　キョウコ」　と読まれた。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "云ウマデモナク最近ノ不況ハドシ／＼失業者ヲ街頭ニ投ゲ出シテ居リ、ソレハ全く見ルニ忍ビナイモノサエアルノデス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、ヒラガナトイウモノハ、元来毛筆ナラビニ和紙トイウモノトトモニ育ツテキタモノデ、ソレラヲ離レテハホトンド生命ノナイモノト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "永イ習慣ノ力トイウモノハバカバカシク強イモノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ニハ清三ガ道子ノ夫ダトイウ事ダケデ、清三ノ存在ガ呪ワシイモノダッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、可能ナラバ霊魂第十号ニモウ一度会イ、彼及ビ彼ノ背後ニアル心霊科学ト握手シ、同ジ目的ニ向ッテ協力シタイモノダ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノ中ニハ可也信用ノ置カレルノモアリ、又可也怪シイモノモアルガ、此點ニ就テハ一切私見ヲ加ヘルコトナシニ、其儘ヲ採録シタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生はなほこれらの史料を過信することを戒められ、兎モ角モ人間ノ眼デ見タ證據程當テニナラナイモノハナイトイフ、心理學上ノ事實ハ、吾々ノ忘レテナラナイ誡デアル。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "『モノスとダイモノス』も気に入ったようだ。",
              "citation": {
                "source": "九州の学生とともに",
                "author": "WITH KYUSHU STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "借金スルノハツライモノ鍋釜マデモミンナ取ラレテスツテンテンと、途方もない自暴を飛ばしたのもある。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "今となって、こういう行を平気で行い、出来ヌト云ウコトハナイモノダ――とホザくところはただののらくら者ではあり得ない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナゼトイヘバ、アヒルサンハ赤イモノナラ、ドンナモノデモ大キラヒダカラデス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナゼトイヘバ、オネコサンハ赤イモノナラ、ドンナモノデモ大スキダカラデス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　ナニヲキタライイカ、イロイロト　サウダンシテヰルウチニ、アマリ　ポカポカト　アタタカイモノデスカラ　ダンダント　ネムクナツテキマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お客をもてなすに、ツマラナイモノデスガ、とか、お口にあいませんでしょうが、とかと、妙に卑屈なことを言う。",
              "citation": {
                "source": "敬語論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々はあまり濁りなく安定しすぎていることで、この善意をコシラエモノ、マガイモノだと思うかも知れないが、善意は濁りがないに越したことはない。",
              "citation": {
                "source": "『異邦人』に就て",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "また田村西湖口義の『本草綱目｜記聞』薯蕷の条下に「ナガイモト云ハヤマイモノ人作ヲ経タルモノナリ」と書いてあるが、これは無論事実を誤っている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "久保とはその後會つていないのですが、前に偶然に一本杉に會つた時に、久保が荻窪の防空壕を引きはらつて、赤羽にあるイモノ工場の工員寮に住んでいる事を聞かされていたのです。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな仕事でもよければだよ」　そして、自分のイモノ工場なら、庶務の方に頼んでやろうと言うのです。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「と言つても、君にやイモノの仕事は、出來んだろうから、事務の方か設計だとか、どうせ、月給は安いぞ」と言つてニヤニヤしているのです。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治時代には総じて文化的優質の品物類は外来のもの、いはゆるハクライモノに限つて、内国製は出来なかつた。",
              "citation": {
                "source": "東京の風俗",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウマイモノが食べられない。",
              "citation": {
                "source": "現代の詐術",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本が亡びてもウマイモノがたべたい。",
              "citation": {
                "source": "現代の詐術",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「医者ガ内診スルミタイダ」「馬鹿ネ」「舌ヲ使ワズニ接吻シロナンテ、随分無理ナ註文ダナ」「接吻ジャナイモノ、タヾ唇デ触ラセルダケダモノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟻走感ト云ウノニ似テイルガ、アンナ生ヤサシイモノデハナク、モット強ク激シイ痛ミデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
