    },
    "definitions": [
      {
        "index": 1,
        "gloss": "necromancer (esp. a blind female in northeastern Honshu)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "降霊術者はいたこを使って亡き親と交わした。",
              "source": "幻辞"
            },
            {
              "text": "昭和時代にはいたこと呼ばれる占い師がいた。",
              "source": "幻辞"
            },
            {
              "text": "いたこは目が見えない人が多かったと言われている。",
              "source": "幻辞"
            },
            {
              "text": "日本文化史ではいたこの役割は重要な位置にある。",
              "source": "幻辞"
            },
            {
              "text": "青森県ではいたこの伝統が長く続いている。",
              "source": "幻辞"
            },
            {
              "text": "いたこは独特の降霊儀式を行う民間療法家だ。",
              "source": "幻辞"
            },
            {
              "text": "民俗学の研究ではいたこについて詳しく論じられている。",
              "source": "幻辞"
            },
            {
              "text": "昔の農村ではいたこが精神的な相談相手だった。",
              "source": "幻辞"
            },
            {
              "text": "いたこの装いや儀式は地域によって異なる。",
              "source": "幻辞"
            },
            {
              "text": "文献ではいたこの実績について議論がある。",
              "source": "幻辞"
            },
            {
              "text": "いたこという職業は現在ほぼ消滅している。",
              "source": "幻辞"
            },
            {
              "text": "演劇作品にはいたこをモデルとしたキャラクターが登場する。",
              "source": "幻辞"
            },
            {
              "text": "民間信仰の中でいたこはスピリチュアルな役割を果たしていた。",
              "source": "幻辞"
            },
            {
              "text": "人類学的な視点からいたこを研究する学者がいる。",
              "source": "幻辞"
            },
            {
              "text": "いたこという存在は日本の精神文化を反映している。",
              "source": "幻辞"
            },
            {
              "text": "神話学ではいたこと古代の巫女の関連性が論じられている。",
              "source": "幻辞"
            },
            {
              "text": "いたことしての活動は一種の社会的責任を伴っていた。",
              "source": "幻辞"
            },
            {
              "text": "文化的遺産としていたこについて記録する必要があろう。",
              "source": "幻辞"
            },
            {
              "text": "いたこの衣装は博物館で保存されている例がある。",
              "source": "幻辞"
            },
            {
              "text": "近代化に伴ってはいたこのような伝統職業が失われた。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "私は悲劇をみて泣いたことはない悲劇に遭遇したことのある自分を発見したゞけであつた。",
              "citation": {
                "source": "（最も純粋に意地悪い奴）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "四里の道を歩いたこととて、足は脹れぼツたい。",
              "citation": {
                "source": "深夜の峠にて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "退屈だし寒いので、火でも起こさうと隣りの部屋を開けると、驚いたことにはそこはもうチヤンと机や本箱が配置されてをり、火鉢には火が起こつてゐて、薬鑵も掛かつてゐる。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　鰆つて俺、聞いたことはあるけれど食つたことはないんだ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に老の近づいたことを知った彼は、自分の残されてる短かい時間に、なおまだ書かねばならない大事の事が、あまりに多くありすぎるのを考えて愁然とし、『人生は短かすぎる』と幾度も言って嘆息した。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "病弱を美しいと思い描いたことがなかったか。",
              "citation": {
                "source": "緒方氏を殺した者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "友情と金銭とのあいだには、このうえなく微妙な相互作用がたえずはたらいているものらしく、彼の豊潤の状態が私にとっていくぶん魅力になっていたことも争われない。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はあいつが音楽について論じているのをついぞ聞いたことがない。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな逆説めいたことを口走って、サイダアを一瓶、頭から僕にぶっかけて、きゃっきゃっと気ちがいみたいに笑った。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、その人とは、口をきいたこともなかつたが、それでも、校長の官舍と、私の下宿とは、つい近くだつたので、登校の途中、ちらと微笑をかはすことがあつて、この人は、その、校長追放の騷ぎの中で、氣の毒であつた。",
              "citation": {
                "source": "校長三代",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから私は何を云つたかよくは覚えてゐないが、兎も角新しき男に皮肉めいたことを喋舌つたことを覚えてゐる。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして最初から聞いた者がやはり自分と同じ訝しさを抱いたことを知つた時、彼等は妥協の笑ひに顔を見合せた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "インタープリテーションでなく、まづは詩であるためには、苦しいと云へば苦しい、長い道を歩いたことであつた。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今以てそれは不思議といへば、一度町内の子供が全部揃つて、忠臣蔵の真似をして練り歩いたことがある。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の書いたことが何うもまどろつこくなつて起き上つた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「マイがマイセルフに……」、――「彼はオスカアワイルドの如き軽薄子にして、詭弁を弄するのみ……」――私は私の書いたことに或批評家がそんな冷い言葉を掛けさうな気がした。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつか前に他の論文で書いたことだが、芥川龍之介の悲劇は、彼が自ら「詩人」たることをイデーしながら、結局気質的に詩人たり得なかつたことの宿命にあつた。",
              "citation": {
                "source": "小説家の俳句",
                "author": "俳人としての芥川龍之介と室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、蕪村の如き昔の詩人が、季節季節の事物に対して、こうした鋭敏な感覚を持っていたことは、今日のイマジズムの詩人以上で、全く驚嘆する外はない。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは彼の単なる詩人的エキゾチシズムと見るよりは、彼の生活していた江戸時代の文化情操が、町人的卑俗主義に堕していたことで、蕪村の貴族主義と容れなかった上に、彼自身が京都に住んでいたためと思われる。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ芭蕉が、蕪村に比して理知的な頭脳をもち、哲人としての風貌を具えていたことの実証である。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "から鮭も空也の痩も寒の内　雲水に似た旅人芭蕉も、時には一定の住所に庵を構えて、冬の囲炉裏を囲みながら、侘しく暮していたこともある。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がその詩を読んで驚いたことには、それが川路柳虹君の詩そつくりの模倣であつた。",
              "citation": {
                "source": "詩の翻訳について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはとにかくシュミット教授についてただ一つ可笑しかった事は、先生が英国の数理物理学の大家 Love のことをローフェと発音していたことである。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネルンストの「物理化学」もひやかしに一、二度聴いたことがあったが、西洋人にしては脊の低いずんぐりした体格で、それが高い聴講席をふり仰ぎながら活溌に手を振り身体を動かし頸を曲げてゼスチュアの賑やかな講義をして見せた。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅行の目的は、もしも運がよかったら鯨を捕る光景が見られるというのと、もう一つは、自分の先祖のうちに一人室戸岬の東寺の住職になった人があるのでその墓参りをして来るようにという父からの命をうけていたことである。",
              "citation": {
                "source": "初旅",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "梟が撞木に止まってまじまじ尤もらしい顔をしていたこともあった。",
              "citation": {
                "source": "鷹を貰い損なった話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後子規の所で出会ってその直感の的中していたことを知ったのである。",
              "citation": {
                "source": "高浜さんと私",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ覚えているのは、丑尾さんが着古した袖無のちゃんちゃんを着て、頭を小ちゃなおちごに結っていたことと、それから、その日の小春の日影が実にうららかに暖かくのどかであったということだけである。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これについては前に書いたことがあるから略する。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度二十五周年記念号を出すので何か書くようとの懇篤な御すすめがありましたので何かと考えてみましたが右様の次第でありますからほとんど何も申上げる材料はないのでありますが、せっかくの御すすめでありますから、ただほんの少しばかり思い付いたことを申上げたいと思います。",
              "citation": {
                "source": "書簡（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
