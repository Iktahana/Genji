  {
    "uuid": "56685a83-aabb-55a6-8f9c-79c4666d133e",
    "entry": "イタコ",
    "reading": {
      "primary": "いたこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月八日◯去ル五日ニ気ガ附イタコトデアルガ、イツノ間ニカ左眼ガワルクナッテイルノダ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "音ハ耳ヲ聾スルバカリノグオーツトイフ音デ、生來之ニ比較スベキ音ヲ聞イタコトガナイ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、巫女のことをイタコという。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "「玉ネギノヱカキサンナンテキイタコトガナイ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしてその連珠を佩ぶるの遺風は、今も奥羽地方の女巫イタコ、琉球の女巫ノロクモイ、あるいは北海道アイヌの婦女の首飾などに保存せられているのである。",
              "citation": {
                "source": "八坂瓊之曲玉考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ春久ガ夜間ハ忙シイケレドモ、晝間ハ自由ガ利クト語ッテイタコトガアルノヲ、聞キカジッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ガ云ウノニ、自分ハ昔ＰＱ病院ニ勤務シテイタコトガアッタガ、昨日午後一時間ノオ暇ヲ戴イテ歯ノ治療ノタメ品川マデ参リマシタラ、ソノ歯科医院デ偶然ＰＱ病院時代ノ福島博士ト云ウ整形外科ノ先生ニ出会ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "境内ノ幽邃ナコトハ真ニ五子ノ言ニ背カズ、前ニモ二三度杖ヲ曳イタコトハアルガ、コレデモ大都会ノ市内カト驚クバカリ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今又チョット新タニ思イツイタコトモアルンデ、マアモウ二三日考エサシテ貰イマショウカナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソンナコトハ聞カナイデモイヽ、マア鱧ヲ食イナサイ」ソンナツモリモナク若イ時分ニ何気ナク見テ置イタコトガ、ドンナ時ニ役ニ立ツカ分ラナイモノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、僕ハアナタ方ニ隠シテイタコトガアリマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐ロシイ曲デス……ワタクシ、コンナ曲ヲ弾イタコトガナイ……土井サン、コノ作者ハドウイウ人デスカ？",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワカは仙台領以北でオカミといい、南部領ではモリコともまたイタコともいう巫女のことであるが、関東以南のイチコ・梓神子・大弓などいう婦人と違うことは、弓や幣束の代りに木に刻んだ二つの人形を手に持つことで、その人形を奥郡ではオシラガミ、阿武隈水域ではシンメサマというのである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "南部のイタコなどの経文と称して読み上げるものは、長者の姫と名馬との恋物語、後に二つの霊魂は天上に昇り、再びこの土に降って蚕の神になったという、神怪を極めた由来記であるが、現在普通のオシラ神はその影響を受けて、馬と美女との頭にそのいわゆる桑の木人形を彫刻している。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "八戸のイタコなどの記憶する雀燕の歌物語は、まだ仔細には聴取っていないが、主として鳥類のかつて人であった時の事を説くというから、恐らく以前これを以てオシラ遊びの経文とした時代があって、それが木像の形の上に影響したのではないかと思っている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタコの歌語りが大きな印象を、彼等に残したことは想像に余りがある。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥州の田舎に今も多く住む盲目の巫女、土地によってはゴゼといい、ワカといい、またはモリコともオカミサンともいう者を、南部と津軽の各郡ではイタコという。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちこれを雀の場合に当てていうと、イタカまたはイタコの如くよく物いうクラだからイタクラと、これを名づけた人がかつてあるということに帰着する。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "数年前に私の家のオシラ様を遊ばせに、奥州の八戸から来てくれた石橋おさだというイタコは、何がすきかと聴いたら煙草だと即座に答えた。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥州でオシラサマという木の二本の切れを持って、神の言葉を伝えるのは小児でなく、イタコまたはモリコと称する盲目の婦人であるが、この二つの間には共通点があるのみならず、小枝の鉤になったベロベロの神、一名カギボトケというものも元は同じ目的に使われた。",
              "citation": {
                "source": "こども風土記",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "後に東北のイタコの数珠や、アイヌの頸飾りなどを見るようになって、ジュズとは呼びながらも我々の真似ていたのは、もっと古風な、また国風なものだったことに心づいたことである。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "九日にはまた小湊に出かけて、新たにいろいろの見聞を添えた他に、座頭イタコの物言いや山家人の酔態、村の女の杓子舞の歌を手記するなど、心ある観察が多かった。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタコまたはモリコと称する東北の巫女たちは、教えられずして早くよりこの法則あることを知っていた。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月十六日のおまつりには、付近から、オシラサマをあそばせるイタコが非常にたくさん集まり、他の地方のオシラサマとはまるで違ったものになっている。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "東北地方では、イタコという巫女がオシラサマを手にもってまわしながら語る「オシラサマ祭文」というのは、馬と人間が結婚した話であって、一方が馬オシラ、一方が姫オシラといって、この二本のオシラサマを持って物語する。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "青森県の金木町付近の川倉の地蔵祭の日など、夜通しイタコがオシラ祭文を語ったり、仏の口寄せをしたりしているが、これはもうオシラサマの末期というわけであろう。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
