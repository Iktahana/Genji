        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "又今戸八幡デ旋風ニ遭ヒ、身體ガ浮イタトイフ老婆ノ實驗談ヲ聞イタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　シバラクシテ　モウ　ウマク　ヤケタラウト　オモツテ　オマンヂウヲ　オイタトコロヘ　カヘツテキテミルト　オマンヂウハ　一ツモ　アリマセン。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "老イタト云ッテモ三十ソコ／＼デナオ美シカッタガ、見タトコロ年増女ト云ウ感ジデ、トテモ男性トハ思エナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコレ以上生キナガラエテイタトコロデ格別ノコトモナイノダカラ、モシ今ノ世ニオ伝ノヨウナ女ガ現ワレタラ、ムシロソノ女ノ手ニカヽッテ殺サレタ方ガ幸福カモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ薬ガ利イタト見セカケテ寝タフリヲスル積リダッタガ、ツイ本当ニ寝テシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンニ聞イタト見エテ、ヤガテ佐々木マデ心配ソウニ庭ヘ出テ来テ警告シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本日颯子同伴帰京ノ積リデイタトコロ、子供達ノ学校モ始マルノデ、豫定ヲ早メテ明二十四日皆々引キ揚ゲルコトニスルカラ、明日一緒ニ帰リマショウ、モウ一日オ延バシナサイト婆サンガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ノ喜ビヲ買ワンガタメニ負傷ヲシテモ惜シイトハ思ワナイ、ソノ負傷ガ原因デ死ヲ招イタトシテモ、ムシロ望ムトコロデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮リニ友人ガアッタトシテ、ソノ友人ガ優秀ナ技術ヲ具エテイタトシテモ、予ガ何ノ目的デ左様ナ製作ヲ依頼スルカヲ知ッタトシタラ、果シテ快クソレニ応ジテクレルデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "外ニ一萬圓ヲ投ジテ故桑野鉄城氏ガ所有シテイタト云ウ紫斑文ノアル端渓ノ硯一面、金デ縁ヲ取ッタ白唐紙ノ大型ノ色紙二十枚。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ彼女ハ、モシ僕ガ日記帳ヲ故意ニ彼女ノ眼ニ触レヤスイ所ニ置ケバ、「コレハ私ニ読マセルタメニ書イタ日記ダ」ト思イ、書イテアルヲ聞イテモ、オ前ハ「人ノ書イタモノヲ盗ミ読ミナドイタシマセン」ト答エルニキマッテイルカラ、聞イタトコロデ仕方ガナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカシナヲ自分ノ日記ニ書イテイルカドウカ知ラナイガ、書イテイタトシテモ僕ガソレヲ読マナイデ（アルイハ読マナイフリヲシテ）イルヲ認メサセルタメニ敏子ヲ使ッタ？",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………従来僕ガ妻ノ貞節ヲ信ジテ疑ワナカッタ一ツノ理由ハ、彼女ガドンナ場合ニモ僕トノ情交ヲ拒マナイガ明ラカデアル時ニモ、ソノ夜夫カラ挑マレテ怯ム色ヲ見セタガアッテ夜ニ及ンデマタアッタトシテモ、―――ソウイウ日ガ数日続イタトシテモ平気ナ体質ナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
