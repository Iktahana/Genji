[
  {
    "uuid": "57d57571-33ce-54ac-a248-0e7714ced89d",
    "entry": "一手",
    "reading": {
      "primary": "いって",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
