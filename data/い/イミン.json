  {
    "uuid": "e9c580c2-12ab-568c-b747-03250be8d8d0",
    "entry": "遺民",
    "reading": {
      "primary": "いみん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
