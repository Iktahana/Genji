        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "たゞ早く町の割栗石の鋪道に固いイギリス製の靴の踵を踏み立てゝ西へ東へ歩き廻りたい願いだけがつき上げて来た。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリス製の靴が沢山在るそうです。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　わたしは、自分の部屋へ戻ると、デスクの引出しから、この間買ったばかりの、イギリス製のナイフを取出して、その切れ味をためしてみた。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "でもちんは、もつとすばしつこくミスのイギリス製の、じようぶなスカートをくはへました。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、事実は然らずというわけで、さかんにイギリス製の軍需品がはいってくる。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリス製の靴一足を買う金で、日本製の靴と帽子と服まで買える。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりも、当国逗留中は、イギリス製のウィスキーを思う存分呑ませてくれればそれでよろしい。",
              "citation": {
                "source": "独本土上陸作戦",
                "author": "――金博士シリーズ・３――",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろイギリス製ウィスキーとも、間もなくお別れだからな。",
              "citation": {
                "source": "独本土上陸作戦",
                "author": "――金博士シリーズ・３――",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱりイギリス製のウィスキーだけありますねえ。",
              "citation": {
                "source": "毒瓦斯発明官",
                "author": "――金博士シリーズ・５――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が、よく似合うリネンの白い洋服をつけ、桃色のリボンで頭をまき、イギリス製のしゃれたサンダルをはいていることに伸子は満足していた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きい窓をもった国際列車の車室のなかでは座席の隅の外套かけで質素なイギリス製の茶色外套が夜から朝へ、朝から昼へと無言に揺れ、その下で、伸子は眠りつづけて来たのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうでなければ如何に今日でも、イギリス製の飛行機が支那軍用機となり得る筈はなく、アメリカの自動車が日本の都市交通を支配し得る理由も判るまい。",
              "citation": {
                "source": "日本文化の特殊性",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "持合せておりますのは、ありきたりのロシヤ製の剃刀でございますが、ごぜん様のお顔をあたりますには、イギリス製でなければ叶いません。",
              "citation": {
                "source": "かもじの美術家",
                "author": "TUPEJNYJ HUDOZHNIK",
                "note": "青空文庫"
              }
            },
            {
              "text": "按吉はどこでどうして手に入れたかイギリス製の六十五円もする梵語辞典を持っていた。",
              "citation": {
                "source": "勉強記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリス製だったと思います。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダイヤモンドやルビーをちりばめた、ヨーロッパのある国の王冠、みごとなダイヤでふちかざりをした、イギリス製の置時計、サファイアをちりばめた黄金の手箱などから、日本のまがたま、中国の白玉の美しいさいくものなど、まるで、きらめく星にかこまれたようなちんれつ室でした。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
