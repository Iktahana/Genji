    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to stay long",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "週末は友人の家に入り浸って、ゲーム三昧だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの人はいつも図書館に入り浸って、本を読んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は昔から、趣味の模型作りに入り浸っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夏休みは、実家に入り浸ってのんびり過ごした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは、新しいゲームソフトに夢中で、部屋に入り浸っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "限りなき彼の幸福は時々刻々に倍加して、彼はいよいよ深く、その涯しなき楽園に入り浸ることが出来るのである。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮前のお広さん処は、始終諸君が入り浸る其｜賭博の巣なのである。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は吾家に入り浸る博徒の親分を睨んだ。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓮花の世界に入り浸る心持ちは、どうも仏教的な理想と切り離し難いようである。",
              "citation": {
                "source": "巨椋池の蓮",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か弱味を握っている忠太郎をバラして、水熊に恩を着せ、それをキッカケに入り浸る寸法と見てとった。",
              "citation": {
                "source": "瞼の母　二幕六場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あれもなか／＼の良い男で、近頃は三崎町の茶屋へ入り浸ると聽きましたが――」「あれはまことに始末の惡い男でな。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美少年國",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それでどうしたというのだ」「水茶屋に入り浸ると見せかけて、よそながら越前屋を見張りましたよ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お吉お雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が入り浸るカフェでは、そのミリオン・サイズの宝刀を求め、夜な夜な……」　云々といった、あまりに卑俗、下品極まりないものまであった（むろん、首藤がその文面を喜々として読み、真相を確かめようと、男が現れる温泉に押し掛けたことは言うまでもあるまい）。",
              "citation": {
                "source": "湯けむり",
                "author": "澤西祐典",
                "note": "青空文庫"
              }
            },
            {
              "text": "だってメアリが病人の寝室に入り浸る筋合いはないもの。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "センターの図書館にはコンピューター関係の書籍や雑誌がそろっており、土曜日と日曜日はここに入りびたるようになった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして毎日入りびたるように早月家に出入りして、ことに親佐の気に入るようになった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而してどつちから引き寄せるともなく勃凸はおんつぁんの部屋に入りびたるやうになつた。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめの間こそ、おんつぁんに怒鳴りつけられるまゝに、すご／＼と野幌に帰つたが、段々図々しくなつて、いつ学校の方をやめるともなく又おんつぁんの店に入りびたるやうになつた。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御用を怠って遊里に入りびたる奴、それが武士の手本になるか。",
              "citation": {
                "source": "鳥辺山心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで色々魂胆をしぼったあげく、始終台所に眼を光らしている前の市長を逐い出して、片っ方の眼のつぶれた豪傑を市長に、又は、部下の風紀取締になると公言して待合に入りびたる今業平を電気局長に引っぱり込んだ。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "不真面目は勉強をせぬとか、カフエエに入りびたるとかいふことばかりでない。",
              "citation": {
                "source": "日本に生れた以上は",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのことが焦りとなって、一カク千金、彼のような小心なケレンのない好人物が賭場へ入りびたるようになったらしい。",
              "citation": {
                "source": "日月様",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが結婚後追々と酒をはじめ、酒の相手の町人どもが奥へ入りびたるようになり、親類の者が当主をだまして遊ぶ金をかりる。",
              "citation": {
                "source": "安吾史譚",
                "author": "勝夢酔",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬鹿めが中間部屋にばかり入りびたる、といって外聞悪がるのである。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "ねずみ",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼈四郎はこの店に入浸るようになった。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃の書生は今の青年がオペラやキネマへ入浸ると同様に盛んに寄席へ通ったもので、寄席芸人の物真似は書生の課外レスンの一つであった。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "從つて、物堅い家に育つた若者の服裝をして、酒場に入浸るよりも下宿に閉ぢ籠つて居る日の方が多いかくいふ先生の如きは、最初彼にとつて幻滅の感を抱かせたに違ひない。",
              "citation": {
                "source": "貝殼追放",
                "author": "先生の忠告",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした性格の争いは、結婚以来のことだが、とりわけ波風が立ちだしたのは、上院議員のモーリス・ベラールがバルトウ氏の家庭に入浸るようになってからのことである。",
              "citation": {
                "source": "悪の花束",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to be immersed (in water) for a long time",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長年水に入り浸っていた木材は、すっかり腐食していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "漬物が十分に水に入り浸るように、重しを乗せる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "泥水に入り浸っていた靴は、洗ってもなかなか汚れが落ちない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この植物は、常に水に入り浸る環境を好む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "地下室は、大雨で水に入り浸ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
