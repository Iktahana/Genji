[
  {
    "uuid": "a25e74fa-b02c-5339-9b7d-9e4fd90ce140",
    "entry": "入り浸る",
    "reading": {
      "primary": "いりびたる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-自動詞"
      ],
      "ctype": "五段-ラ行",
      "inflections": null,
      "ctype_source": "pos-derived",
