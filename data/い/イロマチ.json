[
  {
    "uuid": "5feecf66-36aa-59d0-b3b2-0742828dfa88",
    "entry": "色町",
    "reading": {
      "primary": "いろまち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
