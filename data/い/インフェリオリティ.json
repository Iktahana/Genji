        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その彼に私はインフェリオリティ・コンプレックスを感じる。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "恥かしいと思うのは、インフェリオリティー・コンプレックスだ。",
              "citation": {
                "source": "怒りの虫",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆がよってたかって、笑い者にするらしく、内向的な、そして正直で御人好しの兄は、たちまちインフェリオリティー・コンプレックスにかかったわけ。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "横柄な態度はいわゆるインフェリオリティー・コンプレックスの現われで、むしろ憐れむべきものである。",
              "citation": {
                "source": "非名誉教授の弁",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに対抗するために肩書きを用いるなどは、同じくインフェリオリティー・コンプレックスの現われであるかも知れない。",
              "citation": {
                "source": "非名誉教授の弁",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは彼のインフェリオリティ・コンプレックスおよび彼の行為の多くを説明する。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
