        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "先生の厳しい顔色を見て、生徒たちは静かになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "プレゼンが終わった後、彼の顔色に安堵が見えた。",
              "citation": {
