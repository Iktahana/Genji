    "definitions": [
      {
        "index": 1,
        "gloss": "colour",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は鮮やかな色の服がよく似合う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "部屋の壁を明るい色に塗り替えたら、雰囲気ががらりと変わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "どの色にしようか迷ったけど、結局青いペンを選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この花は毎年、春になると美しい色の花を咲かせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その時だ、その壺が花を開く、その花は、夜の部屋にみる、三色菫だ。",
              "citation": {
                "source": "疲れやつれた美しい顔",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処へやつて来た此の鉄色がかつた栗色の肌の牧野信一は、部屋に這入るなり進みもしないで坐つた。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧野さんの作品には明るい風景が出て来るし、陽に透いた桜の葉のやうな色や又赤い色があるが、その赤はうでた小海老の赤である。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "人によつて色々異ることと思ひますが、私は詩に就いては自分に分るやうにだけは考へますが、それを人に分らせようとするや大変骨が折れます。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々と詩論は毎月の雑誌にも現れてをりますが、此の雑誌に訳載中のアランの論文と、それからこれは直ちに詩論と呼べる限りのものではありませんが、フィードレルの芸術論、まづまづ此の二つが此の数年来に読みました詩論の中で心に残つたものであります。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "主調色は青であり、あけぼのの空色であり、彼自身の讃ふべき語を以てすれば、「鋼青」である。",
              "citation": {
                "source": "宮沢賢治全集",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "真昼の光はあつても少しくであり、それもやがて暮れるとしてのことのやうであり、此処では、紅の花も、やがて萎れて黝ずんだ色になるとしてのことである。",
              "citation": {
                "source": "宮沢賢治全集",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々あるどころか無数にあつて、空気中のオゾンの量に因ると考へる人だつてないとは云へぬ。",
              "citation": {
                "source": "山羊の言",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の詩を辿り乍ら、この稿を書いてゐる今、色々と心に浮ぶことを、何の反省をも加へずに、唯々書誌してみたいと思ふ。",
              "citation": {
                "source": "海の詩",
                "author": "――人と海――",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しその海の上にも星変り、月変つて、――と茲で、私の目は漸く海を去つて、なんだか海と空との中間の奥といつた感じの方角に、過ぎ逝ける諸世紀が、黒光りする中世の武具の色をして、堵をなして潜んでゐるやうに感じられる。",
              "citation": {
                "source": "海の詩",
                "author": "――人と海――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ尾ばな藤ばかますでに色あせ、手にも料紙はおもたくさげられ、夏はやおとろへ、山頂は風に光る。",
              "citation": {
                "source": "山頂",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、色々と分析的な努力をもしてみたが、やはり駄目で、すつかり自信を失つた気持であるやうな場合もあつた。",
              "citation": {
                "source": "詩壇への抱負",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の習慣として、手紙は読んで了へば、大概棄てるし、殊に訃報は直ちに破くのであるが、此度も私は読み終るや破かうとしたが、ハツと思つて思ひとゞまり、薄墨色のインクで印刷された端書をもう一度マジ／＼と見直した。",
              "citation": {
                "source": "逝ける辻野君",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして何時もかはらぬ韻律が、私の色んな物思ひをいつしらず整頓してくれるのであつた。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "感情といふ語の内容も色々であらうが、「独り居て怡しむ」底の感情、対人的に発露するに非ざる、そこはかとなき欣怡の情である。",
              "citation": {
                "source": "感情喪失時代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、人の顔色を見るやうな能力はみるみる発達する一方、瞑想だの理念だのは、さなきだに濃厚ではないのが、発展の余地を持たなくなり、益々衰へてゆくのである。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その混乱をなんとか見究めようとして色々に考へても、それは自分で椅子に乗つて自分で椅子を動かさうといふのと同様、努力すれば努力する程拙いこととなるのである。",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も此の外観は真の詩からなつてをり、彼はそれを、全ての本物の芸術家の如く、天才の一撃で以てその暗い色と蒼白い色とを強調することに依つて獲得してゐる。",
              "citation": {
                "source": "トリスタン・コルビエールを紹介す",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその暗い色と蒼白い色との衝突が、彼の詩の魅力と異様性とをなす所のものである。",
              "citation": {
                "source": "トリスタン・コルビエールを紹介す",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "良いお天気で、幅二間程の、下高井戸駅通りは秋の日をうけて黄色く乾いてゐる。",
              "citation": {
                "source": "その一週間",
                "author": "――不真面目なわが心……",
                "note": "青空文庫"
              }
            },
            {
              "text": "此処の景色を私は好きである、坂は段々勾配を増し、酔つて夕陽に照らされてスタコラゆけば、まるで我が身か、我が身が運ぶ箱か分らず、多分今飲んだビールを運ぶ容器であるに相違なからう。",
              "citation": {
                "source": "その一週間",
                "author": "――不真面目なわが心……",
                "note": "青空文庫"
              }
            },
            {
              "text": "こつちはイライラするけれど、彼方は親切に何やかと訊ねなさるから、牧代（姉娘）はどうしたか、生れた子供は丈夫かと訊ねなさつて……」とニコニコしながら呼吸をつきながら、仰向き勝なその顔の、アザヤかな色の唇がさういふのである。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭には沢山の花が咲いてゐたが、何の花であつたか、その色合ひだけしか覚えてをらぬ。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういへば、ニコニコの底に、なんだかひどく悲しさうな色があつたのだが、また、何か云ひたげで遂に云はずじまひであつたが、人の悪口を云つてはならぬものとばかりに、相変らずの気持であつたのだらうと、幾分不憫でもあつた。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "教会の附近の黄色い土塀つづきの、夕方はしづかり下りて来る彼処へ、ではまた落付いたな、あゝあゝと、僕は思ふのだつた。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろお世話になりました　　いろいろお世話になりましたねえ　　いろいろお世話になりましたさよなら、さよなら！",
              "citation": {
                "source": "別離",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああふるさとの永日に少女子どものなつかしさたとしへもなきなつかしさやさしく指を眼にあててももいろの秋の夕日をすかしみるわが身の春は土にうもれて空しく草木の根をひたせる涙。",
              "citation": {
                "source": "秋日行語",
                "author": "〔菊もうららに〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ舟にのりて行かば、くるほしきなみの亂れもここちよく、ちのみごの夜びえする、あやしきこゑもきかであるべきに、ふるとせひとにかくれて、わがはぐくみしいろぐさのはや涸れぬとぞ、けふきけば薄葉に涙しをるる、よしゑやし、悲しきものはあだがたき、君ならなくに、はやも我が世をのがれいでばや。",
              "citation": {
                "source": "浮名",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我等利根川の岸邊に立てば、さらさらと洋紙は水にすべり落ち、いろあかき魚のひとむれ、しねりつつ友が手に泳ぐを見たり。",
              "citation": {
                "source": "利根川の岸邊より",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、その空さへもうすくもり、かみつけの山に雪くれば、魚らひそかに針をのみ、ま芝は霜にいろづけど、ひとり岸邊に針を垂れ、來らむとする冬を待つ。",
              "citation": {
                "source": "冬を待つひと",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
