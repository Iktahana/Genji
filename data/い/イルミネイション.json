          "literary": [
            {
              "text": "玄関ホールからの光と、トゥリーのイルミネイションだけが、サロンを照らす。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "俄かな宵闇に広告塔のイルミネイションや店頭の明りばかり目立ち、通行人の影は薄墨色だ。",
              "citation": {
                "source": "沈丁花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーベントグリューンが消える頃、丘のあちこちに建てられたホテルには一斉にイルミネイションが輝り初める、そして村の楽隊の Berner-Marsch が大通りの坂道を城の方へ動いて行く時分には、村中の男女は手に手に赤地に白十字の国旗を染めた提灯をかざして、光の一団となって、静かに湖の方へ下りてゆく。",
              "citation": {
                "source": "続スウィス日記（千九百二十三年稿）",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　彼が東京のイルミネイションを見なくなってから二週間以上にもなっていた。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
