        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "明日は仕事があるため、そのパーティーには行けません。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "急な用事で実家に帰れなくなり、残念ながら行けません。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "大雪で電車が止まってしまい、会場に行けません。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
