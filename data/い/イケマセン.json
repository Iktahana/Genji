        "examples": {
          "standard": [
            {
              "text": "この計画は最初からいけませんね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「もうこの状況では、どうしようもいけません」と彼は諦め顔で言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "準備不足で、今回はどうにもいけません。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "must not do",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
