          "literary": [
            {
              "text": "無病健全な人でも毎日流動物ばかり多量に飲むとそれがため胃の筋肉の力を弱くしてアトニー症という胃筋無力の病気を起す。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに不消化物を沢山食べてはいけませんが折々は固いものを少しずつ食べると胃筋の働きを助けます。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
