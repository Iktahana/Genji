        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "入レナイドコロカ、机ノ上ニデモアッタカ、ナイフヲイツノ間ニカ抜イテ、蒼白ニナッテフルエナガラ、突然私ニ斬リツケタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月八日◯去ル五日ニ気ガ附イタコトデアルガ、イツノ間ニカ左眼ガワルクナッテイルノダ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "向匱＝向津（ムカヒツ）・五御魂＝厳御魂（イツノミタマ）・速狭騰＝天疎（ハヤサカリ＝アマサカル）此だけ共通で、神の性が本書では姫、一書では向匱男とあるから男神なのであらう。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "セータアノポケツトカラ　イツノマニカ　キヤラメルガ　トビダシテ　ミチノウエマデニゲテヰタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "今デモ本心ハ善良ナノデアロウガ、イツノマニカ偽悪趣味ヲ覚エ、ソレヲ自慢ニスルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若奥様トシテノ事務モ相当忙シイ筈デアルガ、何デモ引キ受ケテ極メテ手早ク、イツノ間ニカテキパキト片附ケテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯ノ間カラ莨入レト煙管ノ袋ヲ取リ出シテ一服吸ッタ様子デアルカラ、茶ノ間ニ坐ッテイタヨウデモアルガ、イツノ間ニカ門外ヘ出タラシク、素足ニ吾妻下駄ヲ穿イテ歩イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト颯チャンノ石ダッテ餘程ノモノデショウネ」「ソンナモノヲ誰ガイツノ間ニ買ッテオヤリニナッタンデショウ」ト、コヽデ又婆サンガ一言シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガコノ家ヲ訪ウノハコレデ二回目デアルト云ウガ、最初ニ訪ウタノハイツノコトデアッタカ殆ド記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョット食堂ヘ行ッテ来タイノ」イツノ間ニカ颯子ガ眼ヲ覚マシタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………自分ノ頭脳ガ日ニ日ニ駄目ニナリツツアルニノミ熱中シテイタラ、イツノマニカ淫慾以外ノスベテノヲ五分ト考エツヅケル根気ガナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイツヲ、アイツノ子ヲ、アイツノ孫ヲ、オレト同ジ目ニ合ワセテクレ、アイツノ一家ガ栄エテイテハ、オレハ死ニ切レヌ。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでお斬りになつた劒の名はアメノヲハバリといい、またの名はイツノヲハバリともいいます。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
