[
  {
    "uuid": "aea8527f-d80e-58fa-8e1a-5a86ee095a87",
    "entry": "糸威",
    "reading": {
      "primary": "いとおどし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
