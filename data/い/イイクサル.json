        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君の家なんぞもアイスクリームの器械を買って家で拵らえると好きなものが出来るぜ」大原「だけども家の先生たちに何が出来るものか」と聴く人のありとも知らず、門外にては「アレ、あんな事を言いくさる」と憤る人あり。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "番頭めがなにか隣の先生と二人会をやらせるなどと言いくさる。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界が金儲けに気を腐らせるとともに世界に拡まったもので吉原の女郎屋が江戸に立つとともに日本に拡まったものじゃ、あれは公娼制度の悪結果じゃ』と言いくさるのさ、議論にはとても勝てぬと思ったものですから、籠伏せにしてやりましてん。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ次には、タマゴなんて味わったことないって言いくさるんだろ！",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "『……おれは泳げないと言いくさる……』おまえは泳げないのだったな。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
