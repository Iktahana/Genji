        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノホカニモ水死人、サマザマノスガタデ考エテイルソウデス、白イ浴衣着タ叔父サンガ、フトコロニ石ヲ一杯イレテ、ヤハリ海ノ底、砂地ヘドッカトアグラカイテ威張ッテイタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ　フトコロニ　コヒツジヲ　イレテ、「シカタガ　ナイカラ、コノ　コヒツジハ　オレガ　ソダテテ　ヤラウ」ト　ヒトリゴトヲ　イヒナガラ　ヤツテ　ユクウチ　トツプリ　ヒガ　クレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウトウヲ、イレテオキマス、ヘンジヲクダサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニヨリモ、カラダヲ、タイセツニ、イノル、フウトウ、イレテオキマス、ヘンジクダサイ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノチノショウコニ、ワガ足ノ傷グチカラ、破片ヲヌキダシ、コノ缶ニイレテオク。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハ大ヘンヨロコンデ、ボンコチヤンノリボンヲ前ヨリモモツトモツトキレイナノニトリカヘテ、キレイナ桃色ノ箱ニイレテ、空色ノリボンデソノ箱ヲシバリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タローサンハ　モシモ　トチウデ、コマルコトガデキ、タラト、バスケツトノナカヘ　デンシヨバトヲイレテキマシタノデ、テガミヲツケテ、ハナシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
