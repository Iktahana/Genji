  {
    "uuid": "bf449357-779c-569a-9bcd-11f3248824e4",
    "entry": "胃癌",
    "reading": {
      "primary": "いがん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "病気は胃癌だといわれて、家じゅう泣きの涙でいた。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "※の胃癌であることが確かめられた日に、Ｏ氏とＩ氏とが、夜分打ち連れて笹村を訪ねた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｏ―先生はあんなに若くて胃癌で斃れてしまつた。",
              "citation": {
                "source": "和解",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "胃癌だとか糖尿病だとか、おしまいはきまってる。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人は胃癌であった、残る一人は胃潰瘍であった。",
              "citation": {
                "source": "変な音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "胃癌の人は死ぬのは諦めさえすれば何でもないと云って美しく死んだ。",
              "citation": {
                "source": "変な音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人は胃癌であつた、殘る一人は胃潰瘍であつた。",
              "citation": {
                "source": "變な音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "胃癌の人は死ぬのは諦めさへすれば何でもないと云つて美しく死んだ。",
              "citation": {
                "source": "變な音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし推するに茶山は食道癌若くは胃癌に罹つて歿したのであらう。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年の冬だっけが、そんなパテントの権利も、巨万の財産も海員｜擁済会に寄附して、胃癌で死んじゃったが、惜しい人間だったよ。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり胃癌だったのかい」　弟は私の肩に縋り付いたまま青白い顔を痙攣らせて私を仰いだ。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺の家は代々胃癌で死ぬけに、俺も死ぬかも知れぬ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがどうした天道様の配り合わせか、間もなくその又木が四十五歳を一期として胃癌で死んだ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際は床の上で胃癌の為めに死んだＢ市長の事を、公園で刺客にやられたのだと吹聴したのは確かに此の私であった。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "胃癌とか、中風とかいう病気のことをきくと、もう免れっこはないように思う。",
              "citation": {
                "source": "雑文一束",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は医者から胃癌の宣告を受けたのだ。",
              "citation": {
                "source": "雲の裂け目",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "父を一日も永く生かしてやりたいと願う時、父は胃癌に罹っている。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの「仙人」だけは世間並みにだんだん年をとり、最後に胃癌になつてしまつた。",
              "citation": {
                "source": "仙人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "また土居藪鶯氏は、氏の郷里の宇和島の郡長となり、それを罷めて、同地の電気会社の社長となって熱心に努力していたが、惜いかな胃癌にかかって先年亡くなった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "胃潰瘍とか胃癌とかいう病気は刺撃性の物を好む人に多いと申ます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お光が大河に嫁して三年目の春五月、胃癌で患っていた容一郎は土蔵の（この土蔵は容太郎とお信の恋の廃墟であった）二階で縊死したのだ。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの家では、御老母［自注28］が胃ガンで秋まで保証出来ぬとのことです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗ては純粋に「内科的」と考えられた病気たとえば胃ガンに外科的治療が行われるようになった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
