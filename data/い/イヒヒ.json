    "definitions": [
      {
        "index": 1,
        "gloss": "hee-hee",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は怪しいいひひという笑い方をしていた。",
              "source": "幻辞"
            },
            {
              "text": "いひひと笑う姿は不気味だったが、本人は悪意がなかった。",
              "source": "幻辞"
            },
            {
              "text": "そのいひひという笑い声が廊下に響き渡った。",
              "source": "幻辞"
            },
            {
              "text": "営業マンのいひひという不適切な笑いが取引を失った。",
              "source": "幻辞"
            },
            {
              "text": "いひひという態度は交渉の場では避けるべきである。",
              "source": "幻辞"
            },
            {
              "text": "心理学では『いひひ』という笑いが示す心理状態の研究がある。",
              "source": "幻辞"
            },
            {
              "text": "いひひという音声パターンは言語学的に興味深い。",
              "source": "幻辞"
            },
            {
              "text": "言語学の授業で『いひひ』という擬音表現が分析される。",
              "source": "幻辞"
            },
            {
              "text": "日本語教育でいひひという笑いの表現が文脈に応じた使い分けの例として示される。",
              "source": "幻辞"
            },
            {
              "text": "小説で『いひひ』という笑いの表現は怪しさや不気味さを醸し出す。",
              "source": "幻辞"
            },
            {
              "text": "いひひという擬音語は文学的な雰囲気を作る。",
              "source": "幻辞"
            },
            {
              "text": "精神医学でいひひという不適切な笑いが心理的不調の兆候かもしれない。",
              "source": "幻辞"
            },
            {
              "text": "いひひという笑いのパターンは神経学的評価の一部に含まれる場合がある。",
              "source": "幻辞"
            },
            {
              "text": "映画の悪役はしばしばいひひという笑いで不気味さを強調される。",
              "source": "幻辞"
            },
            {
              "text": "いひひという表現は日本の怪談文学に頻出する。",
              "source": "幻辞"
            },
            {
              "text": "心理状態を示す擬音語として『いひひ』は他に類がない。",
              "source": "幻辞"
            },
            {
              "text": "社会的規範からの逸脱を表現する場合、いひひが使われることが多い。",
              "source": "幻辞"
            },
            {
              "text": "舞台表現ではいひひという笑いが演技の一つの技法として活用される。",
              "source": "幻辞"
            },
            {
              "text": "文学史の中で『いひひ』という表現の使用頻度の変化が時代背景を反映している。",
              "source": "幻辞"
            },
            {
              "text": "マンガやアニメではいひひという笑い声が効果的な視覚的表現を補完する。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "あれはいずれ発表するよ、いひひひ」「一件は何日ぐらい動いていましたか」「あはっ、いずれ発表する、だがね熊本君。",
              "citation": {
                "source": "生きている腸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いひひひひ」　変な笑いに異状を示しながら、袂の中から取出したのは大きな蝦蟇。",
              "citation": {
                "source": "備前天一坊",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "いひひひひ」「やややッ、お助け……ううーン」　あやしい人影は、へたへたと草むらの中にくずれるように倒れ、気を失ってしまった。",
              "citation": {
                "source": "骸骨館",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さて」と部屋の中に再び起こったいひひ笑いの終わるのを待って、弁者は更に一倍の尊厳さえ帯びた調子で、どっしりとことばを続けた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "全くのところ、わしはあえて平然とくり返すが、あいつはわしの髪を取って引きずりますので」あたりのいひひ笑いを聞きつけて、さらにもったいらしい表情を加えながら彼は念を押した。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "音によって多少発生年代を異にしたもののようで、キ→イ（「築墻」がツイガキ、「少キ人」がチヒサイヒト、「先立ち」がサイダチとなった類）ギ→イ（「序」がツイデ、「花ヤギ給へる」が「ハナヤイタマヘル」など）、ミ→ム（「かみさし」がカムザシ、「涙」がナンダ、「摘みたる」がツンダルの類。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "チーフメートは何でもかまわず、ボーイ長の左半身全体に、イヒチオールを塗りまくった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "チーフメートは、限りなき嫌悪の情を含みながら、ボーイ長をめちゃくちゃに、イヒチオールで塗りまくることを、（面倒臭いあまりに、そうするのではない）というふうにセーラーたちに見せたかった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒川は、イヒチオールを塗りまくる間に、口をきくことは、それほど仕事の能率を妨げないし、また、それ以上仕事を、きたなくも困難にもしないと考えた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はボーイ長の胸部にイヒチオールを塗布しながらいった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくして、イヒチオールはそれが、その本来塗らるべきところであろうと、または、傷をなして赤い肉の出たところであろうと、出血しているところであろうと、おかまいなしに塗りたくられた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ら親味な情からでもなく人間的な気持ちからでもなく、安井――水夫見習い――は、その全半身にただ気やすめだけのイヒチオールを塗布された。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、負傷後、イヒチオールを二、三回塗布され、足のガーゼを二、三度自分で取り換えただけであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、その馬鹿先生の曰く、（作者は、この作品の蔭でイヒヒヒヒと笑っている）事ここに到っては、自分もペンを持つ手がふるえるくらい可笑しく馬鹿らしい思いがしてくる。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのイヒヒヒヒと笑っているのは、その先生自身だろう。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの作品の読者が、例えば五千人いたとしても、イヒヒヒヒなどという卑穢な言葉を感じたものはおそらく、その「高尚」な教授一人をのぞいては、まず無いだろうと私には考えられる。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）この頃、馬鹿教授たちがいやにのこのこ出て来て、例えば、直線上に二点を置き、それが作者と読者だとするならば、教授は、その同一線上の、しかも二点の中間に割り込み、いきなり、イヒヒヒヒである。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなことまでは、さすがに私も言いたくないが、私は作品を書きながら、死ぬる思いの苦しき努力の覚えはあっても、イヒヒヒヒの記憶だけは、いまだ一度も無い、いや、それは当然すぎるほど当然のことではないか。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "百年二百年或いは三百年前の、謂わばレッテルつきの文豪の仕事ならば、文句もなく三拝九拝し、大いに宣伝これ努めていても、君のすぐ隣にいる作家の作品を、イヒヒヒヒとしか解することが出来ないとは、折角の君の文学の勉強も、疑わしいと言うより他はない。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬鹿なエッセイばかり書きやがって、この頃、君も、またあのイヒヒヒヒの先生も、あまり語学の勉強をしていないようじゃないか。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋のお歌だけは、あまり御上手でないと、あの鴨の長明入道さまもおつしやいましたが、忍ビテイヒワタル人アリキなどとお歌の端にはお書き込みになつて居られるものの、それこそまるで絵そらごと、長明入道さまの言ひ方に従へば、ウソでございます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "前髪に蝶結びのリボンを巻いた踊子の意気姿、かの女はもとよりショウト・スカウト、ハイヒール、流行色の粧いが艶やかだ。",
              "citation": {
                "source": "東京ロマンティック恋愛記",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『セイユウカイハツイニカイサンカイヒウンドウヲステテカンブカイハ、ウンヌン。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヒヒ、イヒヒヒ、」「これ、悪戯をするでないよ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あごがとがって、皺だらけの顔で一日中ヒイヒイ泣いているんだ。",
              "citation": {
                "source": "貨幣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして「失礼でございませうが、私は日本の酒は飲めないんで……」と言つて、「イヒヽヽヽ」と追従笑ひをした。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばドイツの「ウェッターロイヒテン」は稲妻と物理的にはほとんど同じ現象であってもそれは決して稲田の闇を走らない。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もみじを隔てて、遥にこう、雲の中で吹き澄ますといった音色で、オヒャラー、オヒャ、ヒューイ、ヒヒャ、ユウリ、オヒャラアイ、ヒュウヤ、ヒュールイ、ヒョウルイヒ、と蒼空へ響いて、幽に耳に留りました。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで吉が今｜身体を妙にひねってシャッとかける、身のむきを元に返して、ヒョッと見るというと、丁度｜昨日と同じ位の暗さになっている時、東の方に昨日と同じように葭のようなものがヒョイヒョイと見える。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤ、と言って船頭がそっちの方をジッと見る、表の間に坐っていたお客も、船頭がオヤと言ってあっちの方を見るので、その方を見ると、薄暗くなっている水の中からヒョイヒョイと、昨日と同じように竹が出たり引込んだりしまする。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
