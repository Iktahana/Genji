    "definitions": [
      {
        "index": 1,
        "gloss": "housefly (Musca domestica)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夏の食卓に家蠅が数匹飛び回り、食欲を減退させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「ああ、また家蠅が！」と、彼は煩わしそうにハエたたきを手に取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "家蠅は雑菌を運ぶ害虫として、衛生管理上重要な防除対象である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "窓に止まった家蠅が、細かく足を擦り合わせる様子をじっと見ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古い果物の周りには、すぐに家蠅が集まってくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "研究室では、特定の遺伝子を操作した家蠅の行動パターンを観察している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「大体を申しますと、この蠅の多くは、家蠅ではなくて、刺蠅というやつです。",
              "citation": {
                "source": "蠅",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはぺちゃんこになった乾枯びた家蠅の死骸だった。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の家蠅は色々の細菌をはこんで廻るが（すくなくとも三十種類の病菌が蠅によって伝播される結果、北米合衆国で一年に七万五千人の死者を生ずる由。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "其一つは家蠅で、他の一つは音だ。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "家蠅は馬肥で繁殖するものである。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎の者などは御歌所といえばえらい歌人の集り、御歌所長といえば天下第一の歌よみのように考え、従ってその人の歌と聞けば読まぬ内からはや善きものと定め居るなどありうちのことにて生も昔はその仲間の一人に候いき。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "どちらかといえばえらい人の顔立ちではないが、普通の人のだらしなさはなく、ありのままの顔立ちがありのまま以上に、時々横眼でじろりとやる憂鬱さを見せ、それがちょっと応えて来て、ものを書く人の強さを見せているほかは、変ったところが見えない顔貌であった。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "昆虫とくにイエバエがこの病気を広めていないとは考えられない。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "イエバエを毒殺するために部屋にカシア（強壮剤、殺虫剤）の抽出液を置いたところ、１度ならず彼のパンとバターにその味があったそうである。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノミ、シラミ、ナンキンムシ、イエバエ、蚊、マダニ、はすべて数年のあいだに重要な病気の伝染媒介者の場所を占めるようになった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
