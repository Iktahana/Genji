  {
    "uuid": "74492bbc-be4d-5cb2-ae58-b0c3fb1e03b8",
    "entry": "壱与",
    "reading": {
      "primary": "いよ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "復立卑彌呼宗女壹與年十三爲王。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "壹與遣倭大夫率善中郎將掖邪狗等二十人。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "壹與　　本傳には邪馬臺を邪馬壹と誤りたれば此の壹與も臺與の誤りなるべし。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "女王死して後國中また亂れしが、其宗女壹與なる一小女を擁立するに及んで國亂定りぬ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れども正始八年に此王は女王卑彌呼と戰つて勝利を得たれば、女王の嗣者壹與の代に及んでも、依然として九州の南部に據りて、暴威を逞しうせしに相違なし。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れば倭女王卑彌呼及其嗣者壹與は崇神天皇と同時代の人たりしなり。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "と見ゆれば、火國造は肥後國の一部を賜はり、阿蘇國造は肥後國の阿蘇郡を賜はりしに聞ゆれども、崇神天皇の頃九州の北部殊に肥後は卑彌呼女王の本地にして、其沒後に至りても尚ほ壹與の領土なれば、瑞籬朝御世に此處に國造を置かれしこと事實と思はれず。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "卑彌呼死して國また亂れしが、十三歳の少女壹與を奉戴するに及んで、國亂遂に定りぬ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚ほ之に卑彌呼及壹與を加ふるときは十四名の多きに及ぶ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "那珂氏は之に説明を與へて此ノ風俗ハ、イカナル原因ヨリ生ジタルカハ知ルベカラザレドモ、卑彌呼壹與等ガ、國人ニ畏服セラレタルハ、其ノ英略アルガ爲ノミニハアラデ、此ノ風俗アリシニモ由レルナルベシ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "又卑彌呼の嗣者壹與が十三歳にして女王となりしは、必しも之を卑彌呼の宗女たりし門閥上の關係にのみ因れるものと見るべからず。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "壹與が十三歳にして王統を繼ぎしも、必ず此宗教的理由に因るものと解せらる。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "卑彌呼、壹與等が九州北半の大君主と仰がれしも、全く此の理由によるものにて、必しも之を以て此等女王の資性勇武なりしのみに歸すべからず。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに其後女王の宗女壹與を奉戴するに及んで、國中の混亂一時に治れり。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "復立卑彌呼宗女壹與年十三爲王、國中遂定。",
              "citation": {
                "source": "魏志倭人傳",
                "author": "陳壽",
                "note": "青空文庫"
              }
            },
            {
              "text": "政等以檄告喩壹與、壹與遣倭大夫率善中郎將掖邪狗等二十人、送政等還、因詣臺、獻上男女生口三十人、貢白珠五千孔・青大勾珠二枚・異文雜錦二十匹。",
              "citation": {
                "source": "魏志倭人傳",
                "author": "陳壽",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
