[
  {
    "uuid": "8e4a7e03-47ad-5989-824a-54839fb2e15f",
    "entry": "伊予",
    "reading": {
      "primary": "いよ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
