[
  {
    "uuid": "6f534288-c603-5ad2-a096-935ca6d6968a",
    "entry": "今に",
    "reading": {
      "primary": "いまに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
