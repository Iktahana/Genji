        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スルト、ツボミタチノ　アタマノ　ウエデ　ダレカガ、「ヒバリデス、ヨ」ト　フトイ　コヱデ　イヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　マタ　サツキノ　フトイ　コヱデ、「ワタシハ　ウマデス、チツトモ　オソロシイ　モノヂヤ　アリマセン」ト　イヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　ヲバサン、コノ　セカイハ　ナント　イフ　ウツクシイ　ヨイ　トコロデセウ」ト　花ノ　ヒトツガ　イヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヤ　ミナサン」ト　ソノ　トキ　ウマノ　ヲバサンガ　イヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アラ　ドウ　シタノデシヨ、アナタノ　オベベハ　マツシロヨ」ト　オドロイタ　花ノ　ヒトツガ　イヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　フエフキハ　イヒマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　マタ　イヒマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシタチニハ　ナンニモ　キコエヤシナイ」ト　ホカノ　タケノコタチハ　イヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　モウ　ナントモ　イハレヌ　ヨイ　コエデス」ト　ソノ　タケノコハ　イヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ソコヘ　ヨコブヱヲ　モツタ　ヒトガ　チカヨツテ　キテ、「オヤ、オマヘハ　マヒゴノ　タケノコダネ」ト　イヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　モウ　イキテ　ヰラレマセン」ト　ソノ　デンデンムシハ　オトモダチニ　イヒマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　オトモダチノ　デンデンムシハ　イヒマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ソノ　オトモダチモ　イヒマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ　キイタ　コノ　マヅシイ　ヲトコノ　ヒトハ、「ヨシ、ソレデハ　ジブンモ　センサウノ　アル　トコロヘ　イツテ、リツパナ　テガラヲ　タテ　タイシヨウニ　ナラウ」ト　ヒトリゴトヲ　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシタチハ　コレカラ　ドウ　シタラ　ヨイデセウ」ト　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲンキヲ　ダシテ、フミアラサレタ　ハタケヲ　タガヤシ、ムギノ　タネヲ　マキマシヨウ」ト　ヲトコハ　ヒトビトニ　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　イヒマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヤウサンハ　クルマニ　ノツテ　ムチヲ　フリアゲ、「シーツ」ト　イヒマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンドモ　ナンドモ　オレイヲ　イヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ミナサン」ト　モルモツトハ、シンパイサウニ　シテ　ヰル　ミンナノ　カホヲ　ミマハシテ　イヒマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　オサムラヒニ　バケル　トキダヨ」　オカアサンノ　タヌキハ　ガツカリシテ　イヒマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サムラヒハ　ゲタヲ　カツテ、コドモタヌキノ　バケタ　ゲタヲ　オモテニ　ダシテ　ヤリ、オアシヲ　ヒトツ　ヤツテ、「ヤ、ゴクラウダツタノウ」ト　イヒマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレハ　ナンノ　カゲダラウ」ト　ヒトリガ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポストノ　ウエニ　トマツテ　ヰタ　スズメガ、「アレハ　ワタシノ　カゲダワ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソウレ　ゴラン、オマエサンノ　カゲデ　ナイ　シヨウコニ、オマエサンガ　トンデモ、アノ　カゲハ　ウゴカナイデハ　ナイカ」ト　ポストハ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ポストノ　ウシロニ　タツテ　ヰタ　ガイトウガ　カラ　カラト　ワラツテ、「ポストノ　カゲナラ、ポストノ　ウシロニ　コロガツテ　ヰル　ソノ　ブカツカウナノガ　サウヨ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アレハ　コノ　ワシノ　カゲサ」ト　ガイトウガ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガイトウノ　カゲナラ、ガイトウノ　ウシロニ　アル　ソノ　ヒヨロヒヨロシタノガ　サウダヨ」ト　ケイキキユウハ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　トクイサウニ、「アレハ　ワタシノ　カゲダ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
