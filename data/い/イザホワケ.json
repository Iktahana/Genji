        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この天皇、葛城のソツ彦の女の石の姫の命（皇后）と結婚してお生みになつた御子は、オホエノイザホワケの命・スミノエノナカツの王・タヂヒノミヅハワケの命・ヲアサヅマワクゴノスクネの命のお四方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この中、イザホワケの命は天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　御子のイザホワケの王（履中天皇）、大和のイハレの若櫻の宮においでになつて、天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "顯宗天皇　イザホワケの天皇の御子、イチノベノオシハの王の御子のヲケノイハスワケの命（顯宗天皇）、河内の國の飛鳥の宮においで遊ばされて、八年天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
