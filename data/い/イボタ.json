[
  {
    "uuid": "ae3faba8-b8e4-5b1c-bc1e-40ce4d0ca5f8",
    "entry": "疣取",
    "reading": {
      "primary": "いぼた",
      "alternatives": [
        "イボタ"
      ],
      "is_heteronym": false
    },
    "grammar": {
