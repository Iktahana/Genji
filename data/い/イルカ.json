  {
    "uuid": "8112eb57-0a5a-53f3-ad08-d38b0d8f4bcb",
    "entry": "イルカ",
    "reading": {
      "primary": "いるか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ふざけんぼうのイルカは、トンボ返りをうっていました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ビョウキシテ、コマッテ、イルカラ、三円クメンシテ、オクッテクダサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――スグコイカネイルカ　蒼ぶくれのした電報用紙が、ヒラヒラと私の頭に浮かんで来るのは妙だ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――スグコイカネイルカ　蒼ぶくれのした電報用紙が、ヒラヒラ私の頭に浮かんで来る。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "注（１）イルカの頭のような格好をした木の塊で、中が空洞になっている。",
              "citation": {
                "source": "死生に関するいくつかの断想",
                "author": "BITS OF LIFE AND DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアこれは一寸耳をこちらへ出して、ソコイラノ評論ヲ評論ト云イ得ルトハ思ッテ居リマセンガ、私ニハホントノ評論ヤソノ骨格ガワカッテイルカラケンソンスルノデス。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "百姓なら逃げるでしょう、近ごろはやりの分離派教徒なら逃げるでしょう――他人の思想の奴隷なら――なぜってそんな連中は、海軍少尉補のドゥイルカみたいに、ただ指の先をちょっと見せさえすれば、なんでも好きなものを、一生涯信じさせることができるんですからな。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イルカ、イルカ」　この者の姿を見ると、頭はがっそうで、まさに河童に類しているが、身に黒の法衣のかけらと覚しいものを纏うているところ、寒山拾得の出来損いと見られないこともない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イルカ、イルカ」　河童が海豚を呼んでいる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "イルカと言い、河童と言い、天狗小僧と言い、筍八段というのは自称他称が混乱していて、どれをどれとも分らないが、この二人のもの、黒白を持たせてはたしかに人間業とは思われないひらめきを見せる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある期節において、海上にたくさんのイルカが群れをなして、五智の方へ押し寄せて来ることがある。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "その地方にてはイルカの五智参りと唱え、かの魚が如来様へ参詣に来るのであると申している。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、無数のイルカ魚（英語ポーパス）の列を成し、船にそいて進むを見る。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "イルカ、群れをなして波間に飛ぶを見る。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "猩々、猿、手長猿、尾長猿から始まり最後はイルカ、サカマタ、ウニコール、スナメリ等であつた樣に思ふ。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは虹の光りの湖であり、わたしは、つかのま、イルカのようにそのなかで生きた。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンノ下ノ小犬ノコトハオ母サンニ言ワナイデ下サイ九月三日午後七時半　ナイテイルカラカクシテモワカッテシマウト思イマス　小犬のことは、そのほかにも数通あった。",
              "citation": {
                "source": "アンゴウ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一、私は戦争中、イルカとクジラの肉には散々悩まされた記憶が忘れがたいのだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビフテキだのコロッケだのと云うのが、みんなクジラだのイルカの肉だ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとうの狂信者ならいつでも自分の好きな相手を殺せますよ」　坊さんが返事をする間のないうちに、陽気な出張販売人の一隊がイルカの群のように部屋になだれこんできた。",
              "citation": {
                "source": "手早い奴",
                "author": "THE QUICK ONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワトーの画にありそうな羊飼いがギターをかかえた姿を半ば見せている黒ずんだカンバスや、キューピッドがイルカに乗つている月並な模様入りの青いタイルを見せられるだけでも、苦痛であつた。",
              "citation": {
                "source": "ブラウン神父の醜聞",
                "author": "THE SCANDAL OF FATHER BROWN",
                "note": "青空文庫"
              }
            },
            {
              "text": "いうほどワニに似てもいなかったが、イルカぐらいのことは、たしかにあった。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "久美子は着ているものをみな脱ぎ捨て、イルカのように湖水に飛びこんだ。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "船橋から、ふと左舷の方を見ると船に間近いところを、船と同じ方向に向ってイルカの大群が、素敵な速力で宙を切って泳いでいる。",
              "citation": {
                "source": "鯨を釣る",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おや、大きなイルカが捕れたぜ」　平次はからかひ乍ら、八五郎の髷節から網を外してやりましたが、フト氣がついた樣子で、「おや、爺さん、この投網が、ひどく損じて居るぢやないか、まだ新しいやうだが、網石の鉛が隨分少くなつて居るが」　平次は投網の裾をあげて、おもりの鉛の不足したのを勘定して居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "綾の鼓",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに最後のイルカ飛。",
              "citation": {
                "source": "春泥",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "往年ノ軽微ナ脳溢血ノ痕跡ガマダ残ッテイ、脳中枢ニ僅カナ変化ガアルノデ、ソレガ脚ニ影響シテイルノダトモ云イ、又レントゲンデ検ベテミルト頸椎ト腰椎トガ曲ッテイルカラデアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
