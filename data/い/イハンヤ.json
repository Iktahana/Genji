          "literary": [
            {
              "text": "イハンヤ、ラファエルニオイテヲヤ……未ダカツテ……ジョットーヨリ純正偉大ナル宗教画家ハナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤ二公ハ学徳兼テ優レルヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤワガ江戸ノ大ナルヤ、文章ノ淵藪ニシテ、牛耳ヲ執リ盟主トナル者騒壇ニ角立スルヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤ二十年ノ久シキヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤソノ師ニオイテヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤ諸孤皆予ニ就イテ学ブ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
