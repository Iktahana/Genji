        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コレデ、イタチサヘ　ヨンデ　クレバ、ミンナ　オキヤクガ　ソロフ　ワケデスガ、サテ、イタチハ　ドウ　シマセウ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナハ　イタチハ　ケツシテ　ワルモノデハ　ナイ　コトヲ　シツテ　ヲリマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、イタチダケヲ　ヨバナイト　イタチハ　キツト　オコルニ　チガヒ　アリマセン。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　イタチハ　ヤツテ　イキマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ヤツパリ　イタチハ　ヨブンヂヤ　ナカツタト　オモヒマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "古名としては、『新撰字鏡』には、アハクサ、イタチハゼ、『本草和名』と『和名抄』とには、イタチハゼ一名イタチグサとある。",
              "citation": {
                "source": "連翹の花",
                "author": "新村出",
                "note": "青空文庫"
              }
            },
            {
              "text": "後世は専らレンギョウと字音語にばかり呼ぶが、折々はイタチハゼの古名を拾ひあげた雅人がないではない。",
              "citation": {
                "source": "連翹の花",
                "author": "新村出",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタチハゼといふ名なども、元来何となく俳趣を帯びてゐるが、蔓生のにはタニワタシといふのもあり、又シダレレンギョウなど呼ばれるのもある。",
              "citation": {
                "source": "連翹の花",
                "author": "新村出",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
