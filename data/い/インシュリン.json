          "literary": [
            {
              "text": "たとえばインシュリンの研究なんか……」　なぞと引っ冠せて来るから肝を潰してしまう。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「インシュリンのことでしたね、あの薬はあなたの方では手に這入りませんか」「まるで、あてがないのです」　彼は歪んだ声で悲しそうに応えた。",
              "citation": {
                "source": "秋日記",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大原の買いにはいったのはインシュリンという薬だそうだ。",
              "citation": {
                "source": "謎の咬傷",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「水野君、君は、インシュリンが何の薬だか知っているか？",
              "citation": {
                "source": "謎の咬傷",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓさんという元からの看護婦が池袋の堀の内にいて殆ど毎日来てくれ、寿江のインシュリンの注射をしてくれる。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃インシュリンの注射液は輸入統制をうけて居り、重い傷のために必要で病院でも代用品です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "インシュリンもないのだし。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "インシュリンや電気ショック療法のなかった一昔前の精神病院では温浴療法というものをやったそうであるし、ヌル湯の湯治場では、精神病に卓効ありとあるのが多い。",
              "citation": {
                "source": "温浴",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間が狂うと、電気ショックやインシュリンショックをやる。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その三　精神病診断書",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜ気が狂うかハッキリ分らないが、電気やインシュリンでショックを与えるとある種のものは正常に返るというようなことを心得ている。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その三　精神病診断書",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、そうやると一時正常に返ることがあるようだから、電気やインシュリンでショックの療法をやる。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その三　精神病診断書",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は電気やインシュリンショックはやらなかったが、持続睡眠法というのをやりました。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その三　精神病診断書",
                "note": "青空文庫"
              }
            },
            {
              "text": "近ごろの精神病院では電気やインシュリンでショック療法というのをやる。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ気分わるし、インシュリンのせゐか。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "松林・矢野口は宝塚へ戻り、僕、一時半頃か、宿へ帰り、インシュリン打ち、アドは二にして就床。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時、香取へ戻り、インシュリン打、アド三服み、就床。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十時半頃、女房にインシュリン打たしむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "インシュリンを打たせ、アド三。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて、十一時すぎ、インシュリン打たせ、アドも今夜は四にする。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "インシュリン打ち、レスアマへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "岡本医院へ寄る、インシュリンは朝打つと疲れるといふ話をすると、先生、そりゃさうだよと言ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "インシュリンを打ち、レスアマへ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日、インシュリンの他、水島に言はれてから、ＶＢ１を注射してゐるが、いゝやうだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の賣藥ファンは、專ら服みぐすりなので、注射は痛いから、嫌ひだつたので、注射藥といふものは、インシュリン以外買ひ溜めしなかつた。",
              "citation": {
                "source": "賣藥ファン",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "インシュリンは、糖尿病患者だから、要心のために買つて置いたのである。",
              "citation": {
                "source": "賣藥ファン",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
