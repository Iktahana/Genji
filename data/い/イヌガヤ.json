          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭の片隅に、ひっそりと植えられた犬榧の木が、秋になると小さな実をつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この地域では、古くから犬榧の木は、その生命力の強さから縁起が良いとされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "登山道脇で見かけた、珍しい犬榧の葉の形に興味を引かれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "針葉喬木は姫小松、黒檜、羅漢柏、犬榧などが多い。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぎ、もみ、つが、ひのきがや、いぬがや、あかまつ、くろまつ、やくたねごよう、こなら、かしは、かしはなら、くぬぎきり、つるまんりよう。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、負けたって犬がやられるだけで、自分に怪我はない。",
              "citation": {
                "source": "戦争について",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その下へはもう尨犬がやつて來てゐる。",
              "citation": {
                "source": "太郎と街",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳の垂れた尻尾を下げた瞳の碧い毛唐の犬がやつて来てから、地犬々々と俺の同類を白痴にするが、憚りながら神州の倭魂を伝へた純粋のお犬様だ。",
              "citation": {
                "source": "犬物語",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階では犬がやかましく吠えてゐる。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、丁度、犬がやるように、火鉢の中に頭を突き込んで、灰をべろべろ嘗めて居たのである。",
              "citation": {
                "source": "犬神",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜なかに、犬がやたらに吠えてかけまはつた……。",
              "citation": {
                "source": "エミリアンの旅",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ははあ、大きな犬がやって来たな」　件の大犬は、ほとんど駒井の見ている窓下まで近づいて来た時に、駒井はその犬の首に何物かが巻きついていることを知るとともに、その犬がどこかで見たことのある……と思った瞬間に叫びました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、大きな赤犬がやってきて、年ちゃんの顔をべろりとなめました。",
              "citation": {
                "source": "小さな年ちゃん",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、偶然にも、ある日、敏ちゃんのうちのお勝手もとへ、その顔だけ白い犬がやってきてのぞきました。",
              "citation": {
                "source": "母犬",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "肌ぬぎで何かたべてゐる村人のところへは黒犬がやつて来てゐて、ねだつてゐる。",
              "citation": {
                "source": "巣鴨菊",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで犬がやっと自分の名前の四つの字を拾い出してつづることしかできないのに、わたしはとうとう本を読むことを覚えた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩に、森の方で犬のなき声がしたり、昼間でも、犬がやかましくほえて、あたりがなんとなく騒がしく感ぜられると、犬ころしが、やってきたのでないかしらん、そして、クロが、つかまったのでないかしらんと、胸がどきどきしました。",
              "citation": {
                "source": "青い石とメダル",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの子は、昨日、いつものように、停留場に立って新聞を売っていますと、どこかの大きな犬がやってきて、ふいに、子供に向かってほえついたので、どんなに、子供はびっくりしたでしょう。",
              "citation": {
                "source": "ある夜の星たちの話",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、犬がやってきて、哀れな山吹の枝を一｜本かみ切ってしまいました。",
              "citation": {
                "source": "親木と若木",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "日が経つにつれて、檻に入れられたり綱につながれたりして他の犬がやつてきた。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            },
            {
              "text": "バックはここの狼のような犬がやるような喧嘩は見たことがなかつた、それで初めての経験で、一生忘れない教訓を得た。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            },
            {
              "text": "そればかりではない、ちょうど向うから一疋の犬がやって来た、白と黒の斑毛で、駄犬の代表者といったふうなごくつまらない犬だったが、またひどく臆病で、疑いぶかい性分だったのだろう。",
              "citation": {
                "source": "竹柏記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この洞窟に入り込んでから初めて、僕の犬がやって来なかったんだ！",
              "citation": {
                "source": "千里眼の村",
                "author": "クリスマス・ストーリー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
