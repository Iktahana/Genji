    "definitions": [
      {
        "index": 1,
        "gloss": "Japanese plum-yew (Cephalotaxus harringtonia)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
