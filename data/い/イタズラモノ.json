    },
    "definitions": [
      {
        "index": 1,
        "gloss": "mischief-maker",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その子はいたずら者として学年中に知られている。",
              "source": "幻辞"
            },
            {
              "text": "いたずら者の彼が成長して責任ある立場になった。",
              "source": "幻辞"
            },
            {
              "text": "いたずら者のグループは何かと問題を起こす。",
              "source": "幻辞"
            },
            {
              "text": "いたずら者の性質は変わらないものだと言われた。",
              "source": "幻辞"
            },
            {
              "text": "あのいたずら者も今は真面目なサラリーマンらしい。",
              "source": "幻辞"
            },
            {
              "text": "いたずら者であっても信頼できる友人もいる。",
              "source": "幻辞"
            },
            {
              "text": "その映画のいたずら者のキャラが楽しい。",
              "source": "幻辞"
            },
            {
              "text": "町のいたずら者として有名になってしまった。",
              "source": "幻辞"
            },
            {
              "text": "いたずら者の行動には一定のパターンがある。",
              "source": "幻辞"
            },
            {
              "text": "いたずら者としての評判に悩んでいるのだろう。",
              "source": "幻辞"
            },
            {
              "text": "小学生のいたずら者たちが何かを企んでいる。",
              "source": "幻辞"
            },
            {
              "text": "いたずら者でもときには真面目な一面を見せる。",
              "source": "幻辞"
            },
            {
              "text": "そのいたずら者も結婚して落ち着いたらしい。",
              "source": "幻辞"
            },
            {
              "text": "いたずら者の兄が頼りになることもある。",
              "source": "幻辞"
            },
            {
              "text": "近所ではそのいたずら者が話題だ。",
              "source": "幻辞"
            },
            {
              "text": "いたずら者の行動を止めるのは困難である。",
              "source": "幻辞"
            },
            {
              "text": "児童文学ではいたずら者が活躍することが多い。",
              "source": "幻辞"
            },
            {
              "text": "いたずら者の想像力は実は豊かなのだ。",
              "source": "幻辞"
            },
            {
              "text": "祖父はいたずら者だったと家族が話す。",
              "source": "幻辞"
            },
            {
              "text": "いたずら者と呼ばれるのは今では誇りだ。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "たとえば友だちの名をかたってパリへ出かけるいたずら者が、自分の引き立て役に純ドイツ型の椋鳥を連れて行く、その椋鳥のタイプとか、パリ遊覧自動車の運転手とか案内者とか、ベデカと首っ引きで、シャンゼリゼーをシャンセライズと発音する英国老人とかいうのがそれである。",
              "citation": {
                "source": "映画雑感（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ははあん、この女はやはり俺をすっかり虜にした気で得意なんだが、おぬいさんに少々プライドを傷けられているな……ひとつやってやるかな」　渡瀬の胸の中でいたずら者がむずむずし始めた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年「パリの男はいたずら者だな、外国のおんなを自動車に乗せて走ろうなんて」紳士「まだ攻撃かい――そりゃいたずら者の時もあるさ、だけど今夜の場合なんかまったく物好きの深切ですよ。",
              "citation": {
                "source": "オペラの帰途",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "念のために衾や蒲団を振ってみたが、いたずら者はどこにも忍んでいなかった。",
              "citation": {
                "source": "鼠",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "随分いたずら者が多うございますからね」「そうかも知れねえ」と、半七は笑った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鷹のゆくえ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどく息を切って、何かいたずら者にでも出っ食わしたのかえ」「え。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年はいたずら者で、そんなら一番あの婆さんをおどかしてやろうと思って、そっとかの亀の眼に朱を塗って置いた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたずら者の学生二人も、僕も、やはりそれを食わされたのであるが、今までのところではいずれも別条がない。",
              "citation": {
                "source": "山椒魚",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪片は暮れ残った光の迷子のように、ちかちかした印象を見る人の目に与えながら、いたずら者らしくさんざん飛び回った元気にも似ず、降りたまった積雪の上に落ちるや否や、寒い薄紫の死を死んでしまう。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子はいたずら者らしい笑いを口のあたりに浮かべていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「田川法学｜博士」　葉子はまたふといたずら者らしくこんなことを思っていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子はいたずら者らしくそっと足音を盗んで、忍び忍び近づいて、いきなり岡と肩をすり合わせるようにして立った。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子はいたずら者らしく腹の中でくすくす笑いながら、木村の顔を好意をこめた目つきでながめ続けた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子はいたずら者らしくひとり笑いをしながら立て膝をしてみたが、それには自分ながら気がひけたので、右足を左の腿の上に積み乗せるようにしてその足先をとんびにしてすわってみた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "またうまうまといたずら者の運命にしてやられたのだ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとに残った田川夫人がその貴婦人たちの前でどんな顔をして当惑したか、それを葉子は目に見るように想像しながらいたずら者らしくほくそ笑んだ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反して与次郎のごときは露悪党の領袖だけに、たびたびぼくに迷惑をかけて、始末におえぬいたずら者だが、悪気がない。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮りにいたずら者があって、屍体のそばに百人ばかりの名刺と十種ばかりの兇器とをばらまいておいたら、君たちは一たいどれを『有力な証拠品』と見なすつもりだい。",
              "citation": {
                "source": "犠牲者",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼠花火はいたずら者が人を嚇してよろこぶのである。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはお化け花火とも云って、鬼火のような青い火がただトロトロと燃えて落ちるだけであるが、いたずら者は暗い板塀や土蔵の白壁のかげにかくれて、蚊に食われながらその鬼火を燃やして、臆病者の通りかかるのを待っているのであった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらはかつて酒に酔った勢いで、夜ふけに尼の堂を襲いに行ったいたずら者の仲間であった。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "和郎もそのいたずら者を見つけたら、教えてくりゃれ」と、婆は睨むような白い眼をして言った。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「また天狗のいたずら者が来おったそうな」　内では翁の笑う声がきこえた。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたずら者の大鴉もきょうは少し様子が違うと思ったのか、紅い柿の実を遠く眺めているばかりで迂闊に近寄って来なかった。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "亀さんは実際「行儀の悪い」子供であったろうし、また随分いたずらものでもあったらしい。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔は「五月蠅」と書いて「うるさい」と読み、昼寝の顔をせせるいたずらもの、ないしは臭いものへの道しるべと考えられていた。",
              "citation": {
                "source": "蛆の効用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔は五月蠅と書いてうるさいと読み昼寝の顔をせせるいたずらものないしは臭いものへの道しるべと考えられていた。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "三｜疋は年も同じなら大きさも大てい同じ、どれも負けず劣らず生意気で、いたずらものでした。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "藩侯の宝物蔵にあったという、由緒づきの大な遠目金を台つきで廻転させるのであるから、いたずらものを威嚇するのは十分だが、慌しく映るものは――天女が――縞蛇に――化鳥に――　またたちまち……「やあ、轆轤首の女だ、運五郎。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどいめに会わされんように、あいつには気をつけて、いっしょにあそばんように、とな」　よい子供たちは、この話を聞くと、女の子も男の子も、みんな、いたずらもののキューピッドに気をつけました。",
              "citation": {
                "source": "いたずらっ子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
