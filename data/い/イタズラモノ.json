  {
    "uuid": "2006eddd-0979-5c5d-afab-de3cdd723367",
    "entry": "悪戯者",
    "reading": {
      "primary": "いたずらもの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
