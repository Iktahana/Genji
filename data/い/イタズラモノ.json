    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そうして彼の、かねてからの文芸愛好の情に油をそそいで燃えあがらせた悪戯者として、あの一枚の幻燈の画片を云々するよりは、むしろ、日本の当時の青年たちの間に沸騰していた文芸熱を挙げたほうが、もっと近道なのではあるまいかとさえ私には思われる。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいはまた、佳人薄命、懐玉有罪、など言って、私をして、いたく赤面させ、狼狽させて私に大酒のませる悪戯者まで出て来た。",
              "citation": {
                "source": "懶惰の歌留多",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る時など小学校随一の悪戯者が校門近くの道路に陥穽を掘つて友達をいぢめやうとしたのを学校の垣根の蔭で眺めた私はそれをさへ先生や友達に知らせる気持になれない。",
              "citation": {
                "source": "小学生のとき与へられた教訓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そつと悪戯者の背後に駈け寄つて陥穽の上を板片で覆つて土をかぶせてカモフラージしてゐる彼を力一杯押した。",
              "citation": {
                "source": "小学生のとき与へられた教訓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "左右を※して、叱りもしない、滝太郎の涼しやかな目は極めて優しく、口許にも愛嬌があって、柔和な、大人しやかな、気高い、可懐しいものであったから、南無三仕損じたか、逃後れて間拍子を失った悪戯者。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　小夜子にもちょっと悪戯者らしいところがあった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "仁右衛門は悪戯者らしくよろけながら近寄ってわっといって乗りかかるように妻を抱きすくめた。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほれ見ろやい、末ちやんこんな絵本が出て来たぞ」「それや私んだよ、力三、何処へ行つたかと思つて居たよ、おくれよ」「何、やつけえ」　と云つて力三は悪戯者らしくそれを見せびらかしながらひねくつて居る。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "焜炉の中の光が薄れ切つてしまつた頃、而して店の中に兎に角蝋燭の火が分配され終つた頃、悪戯者らしく家中の電灯がぽつかりと点つた。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪戯者の児守さへ、けふは下から真面目顔、ふたつ並べたその鼻の孔に、眇眼に、まだ歯も生えぬただ揉みくちやの泣面のべそかき小僧が口の中蒸気｜噴きつけ、驀進、パテー会社の映画の中の汽車はゆくゆく、――空飛ぶ鳥のわしとそなたは何処までも。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえ汝は贅沢だつたよ、牢屋に居ながら三度三度、スープに洋食を三品宛、それに果実は欠かしつこなし、あまり辛気なので食べ残しの水蜜桃で真紅な自画像をぬたくりつけてひどく叱られたつけな、あの挿話は誰に聞かしたつて腹を擁えるだろう、この悪戯者はその翌日看守長から鹿爪らしく呼び出された、それはかうだ。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で最も親しかったのはすぐ前の医者の宅にいる彼と同年輩ぐらいの悪戯者であった。",
              "citation": {
                "source": "硝子戸の中",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、その厳粛な顔をした悪戯者が、だいたいどういう具合に人間神経の排列を変形させてゆくものだろうか、ここにちょうど恰好な例があるのだがね」と、その奇矯な推論から、独断に見える衣を脱がせようとして、彼はまず例証を挙げた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその喇叭を人の耳のそばで不意に吹き立てて大勢を嚇かしてあるく悪戯者もある。",
              "citation": {
                "source": "倫敦の一夜",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一つ、これらの悪戯者に脅かされたのは彼のタキシーである。",
              "citation": {
                "source": "倫敦の一夜",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん調べてみると、まったく彼の仕業ではなく、そのほかにも同じような悪戯者があるらしいのです。",
              "citation": {
                "source": "深見夫人の死",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの小僧はふだんから悪戯者だけに、持っている松明を叩きつけて、一生懸命に逃げ出してあぶない所を助かったそうだ。",
              "citation": {
                "source": "人狼",
                "author": "――Were-Wolf――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「権の野郎に相違ない」　人騒がせの悪戯者は権太郎に決められてしまった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "半鐘の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら悪戯者でも身体が二つない以上、今度の事件を権太郎になすり付けることは出来なかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "半鐘の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し人間ときまれば又それを取り押える方法もあると、町役人どもは自身番に集まって、その悪戯者を狩り出す相談をしていると、ここへ又新しい不思議な報告が来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "半鐘の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "与次郎は愛すべき悪戯者である。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "向後もこの愛すべき悪戯者のために、自分の運命を握られていそうに思う。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "象はこの悪戯者が背に這ひ上つたと気がつくと、鼻を揮りまはして、大暴れに暴れ出すが、chacanas はそんな事には少しも驚かない、象が怒れば怒るほど、しつかり背に噛りついて離れない、そして鋭い爪でもつて、段々ふかく食ひ込んで往くのだ。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼠の外貌がこの悪戯者に似てゐるのは、飛んだ幸福で、名もない、ちんちくりんな野鼠までが長い口髯を捻りながら、象を脅かす事が出来るのだ。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」悪戯者の延若は鴈治郎の困るのが面白さに一膝前へ乗り出して来た。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見た悪戯者の実川延若は、黙つてはゐなかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この悪戯者の考へでは女に対する仕打は笑ふか、忘れるかしてさへゐればそれでいいので、涙を零すなどは贅沢な沙汰に過ぎなかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手が誰であらうと頓着なく、よしどんな害心をもつてゐる悪戯者に出会さうとも、同じやうな心安さで挨拶せずにはおかない、この鳥の慇懃さを見て、世間の人々、わけても農民達は「彼奴、俺を見て、ぺこぺこお辞儀をしてくさる。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪戯者どもはそれを面白がっていたが、後には諢名をつけて孫痴といった。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
