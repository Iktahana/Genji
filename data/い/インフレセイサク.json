        "examples": {
          "standard": [
            {
              "text": "一部の経済学者は、政府の積極的な財政出動はインフレ政策に繋がると指摘している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "歴史的に見ると、過度な金融緩和はインフレ政策として批判されることがあるね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "デフレ脱却のためには、ある程度のインフレ政策も容認すべきだとの意見もあるよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "して見ればインフレ政策にも増税策にも終局的には反対し得ない計算になるのである。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
