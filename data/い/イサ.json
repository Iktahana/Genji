    "definitions": [
      {
        "index": 1,
        "gloss": "I don't know",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "いさか気になることがある。",
              "source": "幻辞"
            },
            {
              "text": "いさ少し疲れているようだ。",
              "source": "幻辞"
            },
            {
              "text": "その話はいさなり興味深い。",
              "source": "幻辞"
            },
            {
              "text": "いさばかり待ってもらえますか。",
              "source": "幻辞"
            },
            {
              "text": "いさも知り合いではない人物だ。",
              "source": "幻辞"
            },
            {
              "text": "いさを支援しようと思う。",
              "source": "幻辞"
            },
            {
              "text": "いさばかり異なる意見もある。",
              "source": "幻辞"
            },
            {
              "text": "いさな遅れをしてしまった。",
              "source": "幻辞"
            },
            {
              "text": "いさほど悪いことではない。",
              "source": "幻辞"
            },
            {
              "text": "いさなる努力も必要だ。",
              "source": "幻辞"
            },
            {
              "text": "いさばかり前進できた。",
              "source": "幻辞"
            },
            {
              "text": "その計画はいさばかり支持されている。",
              "source": "幻辞"
            },
            {
              "text": "いさなりとも言えない状況だ。",
              "source": "幻辞"
            },
            {
              "text": "いさな変化が見られた。",
              "source": "幻辞"
            },
            {
              "text": "いさばかり改善されたようだ。",
              "source": "幻辞"
            },
            {
              "text": "いさなりとも思える出来事もある。",
              "source": "幻辞"
            },
            {
              "text": "いさばかり努力してきた。",
              "source": "幻辞"
            },
            {
              "text": "その意見はいさか異なっている。",
              "source": "幻辞"
            },
            {
              "text": "いさなる改革が必要だ。",
              "source": "幻辞"
            },
            {
              "text": "いさばかり時間がかかった。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "〔青びかる天弧のはてに〕宮沢賢治青びかる天弧のはてにきらゝかに町はうかびて六月のたつきのみちはいまやはた尽きはてにけりいさゝかの書籍とセロを思ふまゝ〔以下空白〕",
              "citation": {
                "source": "〔青びかる天弧のはてに〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "講述する耕作法その物は、かいさ詰らぬものであるが、農学士は心理的には、甚だ発達してゐて、聴いてる方では、耕作法としては何が何やら分らぬ乍ら、なんだか好いことを教へて呉れつゝあるやうに思はれてならないといふ場合である。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "駄目です』などと夫人にからかわれ、『あ、どうしよう、私この鼻』など言って悄気返り、『真ッぴら、真ッぴら』と、今おぼえたばかりの日本語を面白がって使ったりして、夫人や女中たちを大笑いさせたりしているのだが、その後で、『しかし、よく思うて下さい。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は前から、室生君と共に氏を訪ねる約束になつてゐたので、この突然の訪問に對し、いささか恐縮して丁寧に禮を返した。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分はいささか不安を感じた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分はいささか不審に思つた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいささかでも便乗みたいな事は、てれくさくて、とても、ダメなのです。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、気を取り直して、「ついさっき。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、私の傍には厳然と、いささかも威儀を崩さず小坂氏が控えているのだ。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おじいさまは槍の、――」と言いかけて、自慢話になるのを避けるみたいに口ごもった。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何せ、お嫁さんのおじいさんは、槍の名人だそうですからね、大隅君だって油断は出来ません。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君が見ないさきに僕が拝見するのは失礼だと思ったから、ほんのちらと瞥見したばかりだが、でも、桜の花のような印象を受けた。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「どうだって、いいさ。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――夫婦喧嘩は珍しくない、妻君は酷いヒステリーに罹つてゐる、娘だつて午後五時以後は何んな理由があらうと外出させて貰へないさうだと、校長の家の近所にゐる生徒が聞いて来てゐた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「福岡の小母さんは別嬪だけれど、足の指が、右だか左だか一本ないさうな……」　何時ぞや、父がそんなことを言つてたのをフト思ひ出した。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶯の鳴くやちいさき口開けて　単純な印象を捉えた、純写生的の句のように思われる。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮森といふ人は、語学者として名声の高い人であるが、読売新聞の一文を読んで、いささか人格的に軽侮を感じた。",
              "citation": {
                "source": "詩の翻訳について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "下樣の繩暖簾とはことかはりて、醉うても聞き苦しきいさかひはなけれど、苟めの物語も高聲になり、默してやみなんことも笑ひさざめき、座中自ら春を生ずる自らはよけれど、他人の閑を破るはにくし。",
              "citation": {
                "source": "花あやめ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大変に御馳走があって二の膳付の豊富な晩食を食わされたのでいささか嚢中の懸念があったではないかと思う。",
              "citation": {
                "source": "初旅",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう云う風であるから自然｜細君といさかう事もあるそうだ。",
              "citation": {
                "source": "根岸庵を訪う記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "京に入りて息子とかの宿に行くまでの途中いさゝか覚束なく思わるゝは他人のいらぬ心配かは知らず。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校で習うことは、誰でも習いさえすれば覚えることであり、一とわたりは言葉で云い現わすことの出来るような理窟の筋道の通ったことばかりであったが、亀さんの鳥や魚の世界に関する知識は全く直観的なものであって、とうてい教わることの出来ない種類のものであった。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その向いに坐った目の赤いじいさんと相撲の話をしている。",
              "citation": {
                "source": "高知がえり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六日　涼しいさえさえした朝だ。",
              "citation": {
                "source": "窮理日記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる三君への同時の奉仕、しかも、いささかの不自然、こだはりの片鱗だに無し。",
              "citation": {
                "source": "先生三人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お爺さんは岩の上に大あぐらをかき、瓢のお酒を飮みながら、頬の瘤を撫で、「なあに、こはい事なんか無いさ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、冷たくてもいいさ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分がひとに深切を施すのは、たいへんの美徳で、さうして内心いささか報恩などを期待してゐるくせに、ひとの深切には、いやもうひどい警戒で、あいつと對等の附合ひになつてはかなはぬなどと考へてゐるんだから、げつそりしますよ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたの家の泉水よりは少し廣いさ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どだい、男らしくないぢやないか、と子供でも、また大人でも、いやしくも正義にあこがれてゐる人間ならば、誰でもこれに就いてはいささか不快の情を覺えるのではあるまいか。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
