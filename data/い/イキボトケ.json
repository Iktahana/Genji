        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "貧しい人々に私財を投げ打って施しをするあの僧侶は、村人たちから生き仏のように慕われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "あれほど酷い仕打ちを受けたのに相手を許すなんて、君はまるで生き仏だな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "戦争孤児を何十人も引き取って育て上げた彼女は、その献身的な姿から生き仏と称賛されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
