    "definitions": [
      {
        "index": 1,
        "gloss": "living Buddha",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長年、恵まれない子供たちのために尽くした彼女は、地域ではまるで生き仏のように慕われていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "山奥の隠遁僧は、その慈悲深い行いから生き仏と称され、多くの信者が教えを請いに訪れていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "災害現場で率先して救助活動を行ったボランティアリーダーは、被災者たちの間では生き仏と讃えられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "あの祖母の温和な人柄と、どんな困難にも動じない強さは、まさに生き仏のようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "かつて村を飢饉から救った老賢者は、人々から生き仏として崇拝されたという伝説が残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あんなに献身的に働けるなんて、本当に生き仏みたいだね。」と、彼女は同僚に語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "まこと本場の悪人は、不思議や、生き神、生き仏、良心あって、しっかりもの。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――花御堂の灌仏会、お釈迦さまも裸になって、善男善女が浮かれだして、赤い信女がこっそり寺の庫裡へ消えて、数珠と杯を両手の生き仏から怪しい引導を渡されるのもこの月にしばしば聞くうわさの一つです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "陰にこもって日参をしてみたが、生き仏さまにはとうからもう女人地蔵がついているんだ、それもこの背中の名まえどおり六人もそろってね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたのような生き仏は、色情のことはなんにもお考えになりますまいな」「久しく修業を積んでいますから、心は地に落ちたる絮の如くでござる」と、僧は答えた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "閲微草堂筆記（清）",
                "note": "青空文庫"
              }
            },
            {
              "text": "濃尾の震災に瓦の中から掘り出された生き仏はドンが鳴っても念仏を唱えるだろう。",
              "citation": {
                "source": "趣味の遺伝",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "生き仏さま、おう、蓮芯の賓石よ、南無――と、寺中が総出のさわぎだった。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "｜生き仏さま、｜おう、蓮芯の賓石よ、南無――と、寺中が総出のさわぎだった。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "御存命中は黒谷の生き仏様とあがめられていらっしゃいましたからね。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎にも角にもここでは、徳川時代の最も代表的な生き仏の話も皆様に聴いて頂こうかと思うのです」　奇談クラブの例の会場で、話し手の伊丹健一は、こんな調子で始めました。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "お竹大日如来",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈良の興福寺の衆徒と、その衆徒が、当代の生き仏と仰いでいる、笠置の解脱上人とであった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは」　と、裴如海は、生き仏のようにすうと椅子を立ち、いんぎんに、頭をさげる。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "護持院隆光という精力的な妖僧は、彼女の眼に、生き仏に見えた。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙はやまびととも訓ずるが、「いろは字類抄」にはいきぼとけとも訓んでゐる。",
              "citation": {
                "source": "ほうとする話",
                "author": "祭りの発生　その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきぼとけの方が上皇で、山の神人の方が、山村の山の神であり、山人でもある村人であつた。",
              "citation": {
                "source": "ほうとする話",
                "author": "祭りの発生　その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばあさんは、「あなたは　いきぼとけさまだ。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この　たけうの　まちから　十りばかり　はなれた、しばたこの　ほとりの　よしざき　と　いう　まちに　大きな　おてらを　たて、この　あたりの　ひとたちから、いきぼとけと　いわれて　いました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいえ、旦那は生仏でござんす。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘゲタレにしたり生仏にしたり致さば、閻魔様が面喰らおうぞ。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその老僧から、飯山の古い城主の中には若くて政治的生涯を離れ、僧侶の服を纏い、一生仏教の伝道に身を委ねた人のあったことを聞いた。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「生仏――」かう言つてその人も話した。",
              "citation": {
                "source": "ある僧の奇蹟",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何うしてそんなことが、あの生仏さまにあるものですか。",
              "citation": {
                "source": "ある僧の奇蹟",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして昨夜はかうして私達と此処に一緒においでになつた――生仏さまは、少しもそんなことは御存じなかつた。",
              "citation": {
                "source": "ある僧の奇蹟",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「は」　主水正は、かしこまって、「そのほか、慈眼大師の銅製誕生仏、釈尊苦行のお木像、同じく入涅槃像、いずれも、稀代の名作にござりまする」「うけたまわっております。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時｜喧伝された奥州佐久間の孝女お竹なる者が生仏として霊験をあらわすという談を前篇四冊後篇三冊に編んだもので、三馬としては当て込みを狙ったちょっと得意の作であった。",
              "citation": {
                "source": "仇討たれ戯作",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏教を崇ぶ市民達はその仏教の教主たるところの喇嘛その人を生仏として尊信し、その喇嘛の在す宮殿を神聖｜不可侵場所とした。",
              "citation": {
                "source": "喇嘛の行衛",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから勿論市民達は神聖侵かす可からざる宮殿内で生仏たるところの喇嘛が行衛不明になったなどとは夢にも信ずることは出来なかった。",
              "citation": {
                "source": "喇嘛の行衛",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生仏さまの血脈が、身分が定まってしまったのだから、信徒の人々には一大事で浅間しき末世とさえおもわれたのだ。",
              "citation": {
                "source": "九条武子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥州の田植ゑ人に歌謡を与へたのは、平家物語を初めて弾いた生仏と言ふ盲人だと言ふのが、「菅菰抄」以来の説ですが、其菅菰抄には、今一説あつて、某大寺の住僧が、奥の人々のあぢきないたつきを憐んで田植ゑに唄を与へたのだといふ伝へもあつたやうです。",
              "citation": {
                "source": "東北民謡の旅から",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、その毒水禅師というのが、修行者の間には悪辣なる大羅漢だが、一般の善男善女の前には生仏と渇仰される生仏だから、仏の一種に相違あるまい、その仏を迷わせて地獄に堕したのが、今のあの手弱女だ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その金は、天竜寺の和尚とやらの手許の金であったというではないか、生仏を地獄に落したほどの女が、人の恋愛の糧を盗み得ないと誰が言う。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
