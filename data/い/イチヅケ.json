    "definitions": [
      {
        "index": 1,
        "gloss": "placement",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "センサーの正確な『位置付け』は、計測精度を確保する上で不可欠です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "新しいマーケティング戦略では、高級品市場における自社のプレミアムな『位置付け』を強化することに焦点を当てています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "マネージャーは、新入社員のプロジェクトチーム内での最適な『位置付け』をまだ模索している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この哲学的議論では、個人の権利と集団的幸福の『位置付け』、すなわちどちらを優先すべきかという問題が根本にある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「ねえ、この絵、壁のどこに『位置付け』るのが一番おしゃれかな？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "展示のキュレーターは、統一された物語を語るために、各遺物の『位置付け』を慎重に検討した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "かかる高次の必然性たる意味必然性は、一の現實的な全體が形作られ、各々の歴史的なものがその部分として、それのうちにそれぞれ位置付けられることによつて生ずる。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶對的な全體のうちに於て一義的に位置付けられるといふことは、時間的な事物が永遠化される所以でこそあつても、事物の時間化される所以ではあり得ないであらう。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "程度で言うと、その美しさの位置付けはどうなのだと言っても、なかなかそれが答えられない。",
              "citation": {
                "source": "私の作陶体験は先人をかく観る",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、自らの唱えるＣ＆Ｃの主役ともなりかねない存在として、パーソナルコンピューターを位置づけるのである。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "本丸の学校新聞はそれとして、「自分の考えを人に知ってもらうための私たちの広場だ」と位置づけられたこのミニコミ紙は『しかし』と名付けられていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした販売者と消費者との関係を脱し、「われ、ひとと共に繁栄せん」とする会旨を現実化したものとして、ヤマギシでは供給者と活用者の関係を位置づける。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "理論的な研究を放棄し、兵器の開発に全力を傾けた物理学者たちを、ブッシュは「偉大なチーム」と位置づけた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士論文にこれまでの研究成果をまとめるにあたって、ケイはフレックスを組み込んで使うマシンの姿を想定し、目指すべきシステムを支える一つの要素として開発した言語を位置づけなおそうと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "同誌のエディトリアル・ディレクター、アーサー・サルスバーグは、アルテアを紹介した号の「ホームコンピューターがやってきた」と題した巻頭言で、アルテア作りを同誌が読者に提案する〈プロジェクト〉と位置づけている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに情報処理と電子デバイス、新日本電気グループという三つの開発主体の連絡・調整機関として、いずれの組織にも属さない特別プロジェクトとの位置づけで、パーソナルコンピュータ販売推進本部とパーソナルコンピュータ企画室が設けられた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "オフィスコンピューターの小型化をさらに推し進め、これをビジネス用パーソナルコンピューターと位置づけようという提案には、かつてシステム１００の開発の中心となった浜田自身が深くかかわっていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ５２００をパーソナルターミナル、システム１００の小型版をパーソナルコンピューターと位置づけるという情報処理の方針は、八月に開かれたトップの顔をそろえる会議に正式に諮られた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "この事件をきっかけにＮＣＲを追われたワトソンは、ＣＴＲの経営を任されるや作表機を主力商品として位置づけ、セールスマンに多額の手数料をはずむＮＣＲ流の販売戦略を展開して同社を急成長させた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界標準機ＩＢＭ ＰＣの誕生　ＩＢＭにとっては最下位に位置づけられるマシンをになう、エントリーシステムズ部門の研究所長を務めていたウイリアム・ロウは、一九八〇年七月、トップの顔をそろえた全社経営委員会でパーソナルコンピューター市場に参入する必要性を訴えるチャンスを得た。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "検討の結果、委員会は進行状況に合格点を与え、プロジェクトには独立事業単位（ＩＢＵ）と呼ばれる組織的な位置づけが与えられた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "当初ＰＣ―８００１を超える本格的な八ビット機として想定された新日本電気のマシンは、電子デバイスとの長い押し合いを経て大幅にスケールダウンし、低価格と手軽さを売り物にした入門機と位置づけられた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "独立した遊撃隊が育てたパーソナルコンピューターを、コンピューター事業全体の枠の中にどう取り込み、包括的な企業戦略の中でどう位置づけるのか。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "この１―２―３の開発にあたって、ロータスはＲＯＭベーシックではなく、標準ＯＳとして位置づけられたＰＣ―ＤＯＳ上でアセンブラーを使ってプログラムを書く道を選んだ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＢＰＣはオフィスコンピューターの下位に位置づけるべきか。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それともパーソナルコンピューターの上位に位置づけなおすべきなのか。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＩＢＭ ＰＣと同様８０８８を採用したこの機種を、三菱電機はＣＰ／Ｍマシンと位置づけていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソフトウエアは、コンピューター技術の脇役と位置づけるには余るほどの大きな役割を演じはじめていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＩＢＭ ＰＣの大成功を見せつけられた端末装置事業部は、前年の七月にパーソナルターミナルとして発表していたＮ５２００を、パーソナルコンピューターと位置づけなおそうと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本電気オリジナルのμＣＯＭ―１６００を採用したシステム20／15は、日本語ワードプロセッサーの機能を備え、上位機との互換性を持ちながら机の上に収まる超小型サイズを売り物とするオフィスコンピューターと位置づけなおされた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがオフィスコンピューターとして位置づけなおしたことで、システム20／15におけるベーシックの重みはほとんど失われることになった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "送り届けられたすべてのパーツを分類した写真で特集の最後の見開きを飾ったあと、渡部は一ページ用意した総合評価欄で、「八ビットマシンの限界がＰＣ―８８０１だとすればＰＣ―９８０１は一六ビットのマシンのスタートラインを確かに通過した存在である」と位置づけた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイニーベーシックのプロジェクトのような共棲を目指す試みに支えられて、共有を前提としたソフトウエアが書かれれば、自らをメーカーと位置づける側はユーザーの窮状につけ込むような不当な値段はつけられなくなるだろう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "独立性を高めはしたものの、日本電気がこのマシンをあくまで大型の端末と位置づけている点が、松田には残念でならなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌一九八二（昭和五十七）年五月になって、日本電気はあらたに「一六ビットパーソナルコンピューター」と位置づけなおしたＮ５２００の新機種を発表した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＰＣ―９８０１と名付けられた新機種は、８０８６を採用した完全な一六ビット機で、ＧＤＣを採用し、従来の八ビット機用のベーシックプログラムをそのまま利用できるマシンと位置づけられていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
