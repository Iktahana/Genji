[
  {
    "uuid": "574b44ad-6a3f-53e2-a45d-307ecb9b8f3e",
    "entry": "射抜く",
    "reading": {
      "primary": "いぬく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-カ行",
        "動詞-他動詞"
      ],
      "ctype": "五段-カ行",
      "inflections": null,
      "ctype_source": "pos-derived",
