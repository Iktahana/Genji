        "examples": {
          "standard": [
            {
              "text": "その大先輩の経験には、誰もが一目も二目も置いている",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼の提案力に対して、一目も二目も置かざるを得ない",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その業績を見れば、専門家も一目も二目も置くだろう",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "与次郎が寺のことはいちばんよく知っていて、いちばんよく働くから、貫主も一目も二目も置くことがあります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "大友瀬左衞門もこの女には一目も二目も置く」　八五郎の説明は、それで大方盡きました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "群盗",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時、名立たる大藩といえども、会津といえども、彦根といえども、これには一目も二目も置く。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君には一目も二目も置く」「好い方ばかりが人生じゃありませんからね」「御高説の通りだ。",
              "citation": {
                "source": "嫁取婿取",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
