        "examples": {
          "standard": [
            {
              "text": "虫歯を削った深い部分に、自分の歯の色に合わせたセラミック製のインレーを隙間なく詰め直して、全ての治療を終えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歯科検診で先生から「昔入れた銀色のインレーが浮いて外れかかっているので、新しいものを作り直しましょう」と提案された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "金属アレルギーのリスクを心配し、健康保険外の自由診療ではあるがゴールドのインレーを入れることに家族と相談して決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
