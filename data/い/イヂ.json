        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "つまりその、言語のメタフイヂツクな暗號。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛んで火に焼かれる虫の心理は、おそらく彼等が恋愛の高潮に達した時や、音楽の魅力が絶頂に高まつた時やの、あのやるせない心の焦躁、何物かの認識できない、或るメタフイヂツクな実在の世界に、身も心も投げ捨ててしまひたいと思ふ時のそれと、殆んどよく類似したものであらう。",
              "citation": {
                "source": "月の詩情",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりその、言語のメタフイヂツクな暗号。",
              "citation": {
                "source": "散文詩集『田舎の時計　他十二篇』",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "偶々快活で、自分の仕事を尊敬することを知つてゐる者がゐると、ヘンな所でイヂメられたりする。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "餘白が澤山あるからといつて、一册下すつたものだが、用意の深い方だから、他見然るべからざるペイヂには剪刀が入つてゐる。",
              "citation": {
                "source": "火の用心の事",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬へば古のフイヂアスならではえ作るまじきユノの姿にも似たるなるべし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は急いで町へ出てガレイヂで一台傭つた。",
              "citation": {
                "source": "老苦",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "フイヂアス、パラヂオ、ゲエテエ等が時では無い。",
              "citation": {
                "source": "市街を散歩する人の心持",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "・あなたとフリイヂヤとそしてわたくしと（或る女友に）・さえづりつつのぼりつつ雲雀の青空　朝月が、いちはやくひよ鳥が・酔へばさみしがる木の芽草の芽　三月二十五日　日本晴。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "――元来独乙のアイヂアリズムは観念の科学であつて、其観念なるものが又大いに感情的分子を含んでゐる。",
              "citation": {
                "source": "点頭録",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイヂアリズムが論議の援助を受けて、主観客観の一致を発見したが最後、こゝに外界と内界の墻壁を破壊して、凡てを吸収し尽さなければ已まない事になる。",
              "citation": {
                "source": "点頭録",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイヂアリズムから思ひも寄らない物質主義が現はれてくる。",
              "citation": {
                "source": "点頭録",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンノ　オトウサンハ　ソレヲ　キクト、タキクンノ　ハウヲ　キツト　ミテ、「タキ、イジメタリ　シテハ　イケナイヂヤ　ナイカ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イキテンノ」「サウ、デモ　ドウモ　シヤ　シナイカラ　ダイヂヨウブ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "机の上に原稿用紙が拡げられて、その何枚かが滝野のイヂケた文字で埋つてゐた。",
              "citation": {
                "source": "蝉",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "不自然だ、イヂけた感じがする、第一正当な発音が出来ない。",
              "citation": {
                "source": "秋・二日の話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬堀から走水のキヤンプ・ビレイヂまで約三哩、横須賀からのバスが通つてゐるが、わたしは海のふちを歩いた。",
              "citation": {
                "source": "或るハイカーの記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、何れ位ゐ金を呉れたのか気に懸つたが、努めて白々しい態度を取つてゐると、だんだんに心がイヂけて来るやうな不快を覚えた。",
              "citation": {
                "source": "熱海へ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かにつけて私はイヂの汚ないやうなことばかり覺えて居ります。",
              "citation": {
                "source": "幼き日",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウィリアム・ホルレルバッハ、シイ・ウェステンブロオク少年、エヌ・ウェステンブロオク、バン・フルインク、ジョス・シリングロップ、アール・メルレンブローク、ヘンリイ・コルテ、イー・ケル、ウィリアム・オスターヘイヂ、ヘンリイ・コオト、イサドラ・フリイベルグ孃、ヘンリイ・フリイベルグ少年。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し警官とても何も彼等をイヂめる積りでは無論ない、雨中を蓑笠で行く百姓の姿も憐れなら、上官の命令で夫れを警護して行く巡査も気の毒である。",
              "citation": {
                "source": "筆のしづく",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し強い口調で何か言葉をかけられでもしたら、誰にでもベコベコ頭を下げて了ひさうなイヂケタ気持になつてゐるのだ。",
              "citation": {
                "source": "イボタの虫",
                "author": "中戸川吉二",
                "note": "青空文庫"
              }
            },
            {
              "text": "一のペイヂをそつと切る。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界は恐るべき歴史の第一ペイヂを書きだした。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チュウリップとフリイヂヤの匂いが、緑色の春の陽差しに溶けこんで、金網を張った小いさな窓から、爽かに流れこんできた。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、オーセに扮したのは、かのデプレ夫人であり、ソルヴエイヂが、クリスチヤアヌ・ロオレエといふ無類の美少女であつたことは忘れ難く、ペエア役のアンリ・ロオジェも一と通りあの大役をこなしてゐたやうに思ふ。",
              "citation": {
                "source": "巴里で観たイプセン劇",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど今夜差配の女房さんに聞きやァ、何でも私が大変に継子イヂメでもするやうに、近所で噂をしてゐるとサ。",
              "citation": {
                "source": "小むすめ",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "相原夫人は、やがて終らうとするソルヴェイヂの歌のメロディーに、半ば耳を傾けながら、深草乃里の長い述懐の最後に、――奥さま、どうぞ……と呼びかけられ、力を、光を、と、喘ぐやうに訴へられる声を、一方で、しかと聞いた。",
              "citation": {
                "source": "緑の星",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　イヂノワルイ　オサルサンガ、「ザウサンハ　タイヘン　オギヤウギガヨイトイッテ　ミンナガホメルケレドモ、バウシヲトルノニ　テデトラナイデ、ハナデトルデハナイカ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
