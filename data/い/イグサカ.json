          "standard": [
            {
              "text": "この湿地帯にはイグサ科の植物が多く生息している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "イグサ科の植物は花がとても小さくて見落としやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "大学でイグサ科を専門に研究する学者の講演を聴いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "呉其濬の『植物名実図考』に載っている呉茱萸の図は蓋しトウダイグサ科のヤマヒハツ（Antidesma）属の一種を描いた者でこれは勿論本当の呉茱萸では無い。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この Yucca という属名は元来トウダイグサ科の Manihot（すなわちその肉根から Tapioca, Cassava, Macaroni が製せられる）に対する Yucca という土名であるのだが、それを昔 Gerarde という学者が今の植物と間違えたのであるといわれる。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
