          "literary": [
            {
              "text": "「ええ、御免下さいまし、甚だ推参なわけで、飛んだ失礼でございまするが、手前通りがかりのもので、」といい出る。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "みな尻込みして、私、といい出るものもない。",
              "citation": {
                "source": "キャラコさん",
                "author": "社交室",
                "note": "青空文庫"
              }
            },
            {
              "text": "さまざまに訴えられるけれども、イエスは口を緘して一語をも発し給わず、人々のやっきになって言い出でる証言は、どれも皆一致しない。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            }
          ]
        }
