[
  {
    "uuid": "3ce0ca67-9dcd-59ff-8a88-5231edc695ec",
    "entry": "言い逃れ",
    "reading": {
      "primary": "いいのがれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
