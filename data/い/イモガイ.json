        "examples": {
          "standard": [
            {
              "text": "芋貝に触れて毒針を刺された釣り人が、海岸近くの診療所に担ぎ込まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ダイビング中に砂の上の芋貝を拾いそうになったとき、ガイドが素早く制止してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "芋貝の毒は強力な神経毒で、軽症でも手のしびれが数時間続くことがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "しいて周囲から作られた人工の端厳美と、みずからの人間性とを、たとえば、牡丹と雑草のツルを一つ鉢にしたように、その身へ絡み合せて、常住の権威の座で、しばしば狂いもがいている人と見れば、むしろ憐れで、何もおかしいことはない。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
