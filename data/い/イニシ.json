        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "遠い「往にし」の時代、この地には栄華を極めた都があったという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "詩人は、失われた友を偲び、「往にし」の日々を懐かしむ歌を詠んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "古文書には、「往にし」の合戦の様子が生々しく記されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あの「往にし」の時代、この辺りはどんな様子だったんだろうね？」と祖父は昔を懐かしんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "哲人も往往にして詩を作る。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あな古鏡、往にし世に、額白かりし上※の戀のうらみに世をすてし今はのきはのかたみとや、横さにかかる薄雲の曇れる影も故づきて、頼もしき哉、祭壇の清き姿をうち湛ふ。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "神はをみなを召しまして、いづくは知らず往にしかど、大御心のふかければ、殘る名のみは消しませね。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "神はをとめを召しまして、いづくは知らず往にしかど、大御心のふかければ、殘る名のみは消しませね。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "大羽子よ、いかにと見れば愁ひある眼ざししめり、『天津日も盲ひたるらし、往にし世の姿を、花の欄干を、などやさながら、まのあたり映し出さぬ。",
              "citation": {
                "source": "春鳥集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ああ、なべての樹のなかに今の日いやしめる往にし代のさま。",
              "citation": {
                "source": "春鳥集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "○武蔵野の小岫が雉立ち別れ往にし宵より夫ろに逢はなふよ　〔巻十四・三三七五〕　東歌「岫」は和名鈔に山穴似袖云々といっているが、小山に洞などがあって雉子の住む処を聯想せしめる。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔譯〕遠方に歩を試むる者、往往にして正路を舍て、捷徑にに入る、嗤ふ可きなり。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "また問ひたまはく、「何とかも」と問ひたまへば、答へたまはく「時時往往にして、取らむとすれども得ず。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "……で、宮将軍へ付くか足利へ寄るか、とまたもや武士みな去就の迷いを右往左往にしておりますので、それを嗤ったのかもしれませぬ」「ふーむ」「かたがた、こよいのご談合は、機微むずかしいところです。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、まあこのおしまひの手合なんぞは、云つてることに何の意味もないにしてからがチヨイト頭を捻ること言換れば位置にお構ひなしに移動の万能範囲を拡げることが、いとも優秀なことのやうに思はれることは現時の流行感冒である。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて、窓ぐらいにしてもらいたい。",
              "citation": {
                "source": "多頭蛇哲学",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分では絶えず工夫して進んでいるつもりでも、はたからはまず、現状維持くらいにしか見えないものです。",
              "citation": {
                "source": "炎天汗談",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、いくら俺が耕二程言はれないにしろ、祖母さんにはかなはない！",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "いにしへの日には鉛筆もて欄干にさへ記せし名なり。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはとにかく、これが僕を人嫌いにし、非社交的の人間にしたことの、一つの最も大きな原因だった。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸いにして、石楠花を見る目的は、十分に遂げられた。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は従来の風景論者のように、火山ばかりを抽き出して、他の山岳から離隔して、それを特色とすることを好まない、またこの頃の一部の若い人たちのように、日本アルプスからとかく、火山を継子扱いにして扉の外に突き出すことにも、与みされない。",
              "citation": {
                "source": "日本山岳景の特色",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺がよしんば死なないにした処で、――今度の事――で監獄に打ち込まれるとしたらどうだ！",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "坑夫だって人間である以上、早仕舞いにして上りたいのは、他の連中と些も違いはなかった。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、それは全く、全然同じとは云えないにしても、全然違ってもいなかった。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "蚕や蛇が外皮を脱ぎ捨てるのに相当するほど目立った外見上の変化はないにしても、もっと内部の器官や系統に行われている変化がやはり一種の律動的｜弛張をしないという証拠はよもやあるまいと思われる。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし個人的には、たとえそれは自覚されないにしても、何かしら自ずから一定の標準をもっていて、それに当嵌めて口調の善し悪しを区別している事だけは否定し難い事実である。",
              "citation": {
                "source": "歌の口調",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥や鼠や猫の死骸が、道ばたや縁の下にころがっていると、またたく間に蛆が繁殖して腐肉の最後の一｜片まできれいにしゃぶりつくして白骨と羽毛のみを残す。",
              "citation": {
                "source": "蛆の効用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "年寄の歩みはたどたどしいにしても翁は次いで三日も歩んだ麓の幅を計ることはできなかった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう山焼けの火はたばこの吸殻のくらいにしか見えません。",
              "citation": {
                "source": "よだかの星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "万一殺されないにしてももう縛られると私どもは覚悟しました。",
              "citation": {
                "source": "二人の役人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて児童が誤った、また全然誤っていないにしても浅薄な解釈しか出来ないことになる。",
              "citation": {
                "source": "研究的態度の養成",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "寿命で死ぬは致方ないにしても、長く煩って居る間に、あア見舞ってやりたかった、一目逢いたかった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "かように或る言語を形づくる音単位は、それぞれ一をもって他に代え難い独自の用い場所を有する一定数のものに限られ、しかも、これらは互いにしっかりと組合って一つの組織体または体系をなし、それ以外のものを排除しているのである。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
