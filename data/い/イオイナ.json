        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "）処へ、智慧、愛、想像の女神イオイナ光のように現われる。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イオイナ　実は、心配して様子をそっと見に来たのです。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イオイナの使者、一片の花弁のように軽く、女神の傍に降る。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イオイナ　まあ美しいこと。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イオイナ　おお、嬉しいことの二つ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イオイナ　そうだろう。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（使者去る）イオイナ　――神々は、私が余り人間の味方をすると云って憤られる。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "互にその成功を競いしが、女神は偶然アイオイナカムイの妹に逢い、女の習慣として、喋々相語りて、多くの時間を空費し、男神の既に其業を終りしを見て、大に驚きて、俄に急きしが故に、西海岸は、東海岸に比して、甚しく粗悪険阻なりと。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
