[
  {
    "uuid": "18e474e9-27e7-563d-8772-e40f013c7d90",
    "entry": "凍てる",
    "reading": {
      "primary": "いてる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
