        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "料亭の看板メニューの活け造りは、見た目も鮮やかだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この活け造りは、生きた真鯛を使用している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "活け造りを食べるなら、この店が一番新鮮だと評判だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
