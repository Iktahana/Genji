        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "キエテ　イツタ　ホシハ、イツマデ　タツテモ　カヘツテ　キマセンデシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イツテ　ミヨウ」「ウン」　二ツノ　ホシハ　タカイ　タカイ　ソラカラ　コガラシノ　フク　マチノ　ナカヘ　オリテ　イツタノデシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムラカラ　ムラヘ　コジキヲ　シナガラ、ニホンノ　アシデ　テクテク　アルイテ　イツタノデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　トシヨリト　ワカレテ　ナホモ　アルイテ　イキマスト、ナルホド　アノ　トシヨリガ　イツタトホリ、ハタケハ　タイハウノ　ワヤ　ウマノ　アシデ　スツカリ　アラサレテ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウサギノ　ハイツタ　カゴヲ　モツテ　ヲリマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツイテ　イツタ　テフテフ新美南吉　マチカドデ　フウセンウリノ　ヂイサンガ　フウセンヲ　ウツテ　ヰマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソチライツタツタカリエコマダカヘラヌ　返事がすぐに来た。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "コイヌ村山籌子マアイツタイドコカラコンナニタクサンヤツテキタノカシラ。",
              "citation": {
                "source": "コイヌ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアイツタイドコカラコンナニタクサンヤツテキタノカシラ。",
              "citation": {
                "source": "コイヌ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三オ友達　ノ　オ猫サン　ガハサミ　デ　切リナサイ　トイツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンハイクラオコツテヰテモオ家ノ中ニヰルカライイヤウナモノノ、クライ夜道ヲ一人デトンデイツタボンコチヤンハ、モウ、ケツシテ、オ家ヘカヘツテコラレナイデセウ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマリクルシイノデ、ボンコチヤンハオイシヤサマノイツタヤウニ、ビヨウキガナホルノナラ、モンコチヤンノオ家ヘカヘリタイトイヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンヂウハ　ドコヘイツタノデセウ？",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「イツタイ　ナニゴトガ　オコツタンダラウ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタ　メガサメテミルト、オホソウヂハ　モウドコヘイツタカ　カゲモカタチモアリマセンデシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノマヒゴノヤウスノヘンテコリンナコトトイツタラ※　水ノ中ニムヤミト長クツカツテヰタトミヘテ、アタマノ毛ハ一本、一本、サカダチ、カホモカラダモマツサヲ、クチビルハムラサキ色。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊〔見聞録〕須富田村疋田七五三太夫所蔵古文書写香我美郡香宗我部、東西大堺之事、西ハ本山大多寺限リ、小路ヲ引テカノスヘヲ下ヘ、前浜御イツタノ宮ノ左ノ柱限、東ハ槙山之奥ボウジノ峠カギリ、里ハ槙寺尾下ヘ手猪（限カ）、山ハ花ノ木ヒロイ石塚限也。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
