        "examples": {
          "standard": [
            {
              "text": "隣の席に座ったインドネシア人の学生と話していると、バリ島の文化や祭りのことを生き生きと教えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "工場の新しい同僚はインドネシア人で、日本語が堪能なうえに仕事も丁寧で周囲から信頼されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "旅先のワルンで出会ったインドネシア人の店主は、拙い英語でも笑顔で丁寧に道案内してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "重治の最後のようすが知れたのは、娘にしても老生にしても非常な満足であり、マリハツ・シロウというひとの親切は、謝するにあまりあるのであるけれども、老生が強くうたれたのは、未知のインドネシア人の重治にたいするたとえようもなき深い情誼についてであった。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくして、プアサ（インドネシア人の正月）の休みに、ブル島へ母や妹に逢いに行って帰って来ますと、村上さんが、「おい四郎、お前は小さなプラウでブル島まで行ってきたのだそうだな、えらいことをやるな！",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
