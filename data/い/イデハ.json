        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ソウレ　ゴラン、オマエサンノ　カゲデ　ナイ　シヨウコニ、オマエサンガ　トンデモ、アノ　カゲハ　ウゴカナイデハ　ナイカ」ト　ポストハ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "道理で好く正月の休みになどなると、勲章やサーベルなどをぶらさげた小さい僕を伴れて箱根や熱海へ赴き、大いに酩酊して「仰イデハ三山ノ雪ヲ吐キ」などゝいふうたをうたつた。",
              "citation": {
                "source": "自烈亭",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハ君ヲ愛シテハ居ナイゾ、君モ道子ヲ愛シテハ居ナイデハナイカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出羽は古くはイデハと呼ばれたのが、後にデハとなったのである。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イデハの名義に就ては『地理志料』に按、神学類聚抄引風土記　本州上古貢鷲之羽用為箭羽　故名出羽国。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イデハという地名の地元は何処であったかといえば、それは疑もなく式内社伊※波神社の所在地である庄内平野であろう。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イデハのイデは南洋系語のデハヅレの意であるウチ又はイチの転訛したもので、ハはナニハ（難波）のハと同じく平野を意味するチアム語であると思う。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此のデハヅレは勿論越後方面からいうデハヅレであって、イチハがイツハとなりイデハとなったのであろう。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩ヤ肘ヤ膝頭ガ僂麻質ノヨウニ痛ムノハ前カラノコトデレスリーノセイデハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫉妬ガ醸ス激シイ情熱、妻ノ全裸体ヲ思ウ存分見ルノナカッタ法悦境ニ浸リツツアルノヲ思ッテ、自分ノ幸福ヲ感謝シナイデハイラレナイガ、同時ニマタ、コンナ幸福ガイツマデツヅクハズハナイ、イツカハ報復ガ来ルノデアル、自分ハ刻々ニ命ヲ削リツツアルノデアル、トイウ豫感モシテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、アレハスイセイデハナイ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
