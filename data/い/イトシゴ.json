        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "どんなにわがままを言っても、末っ子は親にとっての愛し子だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は戦乱の中、たった一人の愛し子を必死で守り抜いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "「行ってまいります、お父さん」「おお、気をつけて行けよ、私の愛し子よ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "愛し子よ、めでよ、足音、息の緒のすこやけき揺り。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "皮肉以上の解答を、真実人生を愛し子を愛する母は求めている。",
              "citation": {
                "source": "是は現実的な感想",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあお入り、愛し子よ！",
              "citation": {
                "source": "勇子",
                "author": "一つの追憶",
                "note": "青空文庫"
              }
            },
            {
              "text": "啻に出産老病の一事のみならず、人間の子にして父母を親しみ父母を慕い、父母にして子を愛し子を親しむは、天性の約束なるに、女子が他家に嫁したればとて、実の父母を第二にして専ら舅姑の方を親愛し尊敬して孝行せよとは、畢竟出来ぬ事を強うるものと言う可し。",
              "citation": {
                "source": "女大学評論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その感謝の心は『日の子』を書いて自分を彼れの愛し子、隱し子であると言つた時吾が心は言ひ知れぬ歡びに溢れてしまつた。",
              "citation": {
                "source": "太陽の子",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞かせてよければ、愛し子が心のうちでは夢にまで恋いこがれているであろう母親のことである。",
              "citation": {
                "source": "ある完全犯罪人の手記",
                "author": "酒井嘉七",
                "note": "青空文庫"
              }
            },
            {
              "text": "生活の惨苦に沈む世の親たちが愛し子を殺す心の切なさが今こそ、しみじみとわが心に迫る。",
              "citation": {
                "source": "親馬鹿入堂記",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはよいが、体をこわしてはなるまいが」と、慈円は愛し子を諭すようにいった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……すると近日、愛し子の顔を見られるのじゃな」「ただ愉しみはそれのみでございまする」「さもこそ」　義貞はふと、とろんとした眼に物を忘れて、「うれしかろ」　と、かさねて言った。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした中で、縁につながる尼御前が、わが身ばかり、愛し子との対面を、よろこんでもおられぬと申すのじゃな。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女十四歳、むずかしいとしごろだ。",
              "citation": {
                "source": "おごそかな渇き",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は型のくずれたソフト帽をやにわに頭から取って、そのさきを左手で握って、右手でぐいとしごいた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然に冥通を得た翁の、僅にあずまと離れた空間の隔りに在る二人のいとし子に冥通の懸橋をさし懸けられぬいわれはなかった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いとし子を茲には置きてわが帰る　　母国ありとは思ほへなくに。",
              "citation": {
                "source": "オペラの辻",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「全世界を恋人とし、いとし子として、この温かき胸に抱かん。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、さう云ふ社会的事実に対しては殊にうといとし子には、一人の煽動者に対して、大共和国の政府がとつたあらゆる無恥な卑劣な迫害手段は不思議な程であつた。",
              "citation": {
                "source": "乞食の名誉",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "その猿は、きっと、怒の形相ものすごく、じっと、半四郎を睨みつけていたのでございますまいか――無残に、殺された、我がいとし子の小猿の無念を思いながら。",
              "citation": {
                "source": "京鹿子娘道成寺",
                "author": "酒井嘉七",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し此の知識がもつと広まつてゐたら吾々が今その死を悼んでゐるあの子供は、死なずに済んで、今猶そのお母さんのいとし子でゐる事が出来てゐたらうと思ひます。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『みゆるしたまへ、父の王、汝がいとし子の魂の花咲きくゆりぬる功徳のゆゑ、明日より後のたゝかひに王が馬蹄は十｜国の土を隈なく印しなむ。",
              "citation": {
                "source": "騎士と姫",
                "author": "末吉安持",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女に凄じい熱情を注いだ男たちが次々に死に、左大臣の一家一門が菅丞相の祟りに依って一人々々｜斃れ、最後にいとし子の敦忠までが取られて行ったのを見ては、彼女もそゞろに無常の風が身に沁みたであろう。",
              "citation": {
                "source": "少将滋幹の母",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーワーワー」　と、泣く時、夫人は失われたいとし子の思い出に堪えられなかったに相違ありません。",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "わりなきことを言ひいでて恨むよしなき佳き人よ汝がいとし子の秋ごろも裁つ手をしばしやめよかし、絹を二つに裂かんときこほろぎの音をしばし聴けそのかそけさを胸に知れつれなき人とならじかし。",
              "citation": {
                "source": "我が一九二二年",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "いとし子の声を、なんで聞違えるものか。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "抵抗すれば、間接ながら、我がいとし子を死ねとばかり、責めさいなむも同然だ。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「茂ちゃん、母さまはね……」　倭文子は、いとし子を抱きしめて、泣きじゃくりながらささやいた。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "いとし子を抱た女の身で、これが堪え得ることであろうか。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその傍らに書き遺した短冊には、のちの世の道もまよはじいとし子を我が身にそへて行くすゑの空三　秀吉は即日、一書を封じて、早馬に託した。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
