        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "インノセンスの自由は私からたえて久しい幸福であります。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "予はインノセンスと呼ばれて、君の知しめすが如く、何もえしらぬ。",
              "citation": {
                "source": "法王の祈祷",
                "author": "RECIT DU PAPE INNOCENT 3",
                "note": "青空文庫"
              }
            },
            {
              "text": "願はくはインノセンスの治下に新しき幼児の戮殺あらしむる勿れ。",
              "citation": {
                "source": "法王の祈祷",
                "author": "RECIT DU PAPE INNOCENT 3",
                "note": "青空文庫"
              }
            },
            {
              "text": "われも亦インノセンスといふ。",
              "citation": {
                "source": "法王の祈祷",
                "author": "RECIT DU PAPE INNOCENT 3",
                "note": "青空文庫"
              }
            },
            {
              "text": "而してわれ、インノセンスには、すべて、わからぬ、わからぬ。",
              "citation": {
                "source": "法王の祈祷",
                "author": "RECIT DU PAPE INNOCENT 3",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
