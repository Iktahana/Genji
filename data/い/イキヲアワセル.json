        "examples": {
          "standard": [
            {
              "text": "柔道の試合前、二人の選手は正眼で向き合い、息を合わせるように静かに呼吸を整えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "相撲の立ち合いで、力士たちは何度もまわしを直しながら息を合わせようとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "剣道部の朝稽古で、師範は「相手と息を合わせてから打ち込め」と繰り返し指導した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それは古くから言われているように「息を合わせる」のであって、悟性の判断に待つのではない。",
              "citation": {
                "source": "文楽座の人形芝居",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
