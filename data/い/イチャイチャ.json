        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おいちゃいちゃの巴御前、兄が留守したとても、あんまり京弥とおいちゃいちゃをしてはいかんぞよ。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとで菊路とおいちゃいちゃ遊ばしませい。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "お人形さまたち、いちゃいちゃとやって来おったのう。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれアその、女にいちゃいちゃするのが、むしずの走るほど大きれえでなあ。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　おらァ、女にいちゃいちゃするのが、大嫌えだ。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなにいちゃいちゃしたければ芝居なんぞ見に行きゃアしないわ。",
              "citation": {
                "source": "つゆのあとさき",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
