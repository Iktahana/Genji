        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "頭が痛い痛いと言っていましたけど。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "あ、痛い痛いと、左の手を握って、何ですか――印を結んだとかいいますように、中指を一本押立てていらっしゃるんです。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣くたって一体お父さんたちは、まだ僕の近くに居るだらうか、あゝ痛い痛い。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣くたって一体お父さんたちは、まだ僕の近くに居るだろうか、ああ痛い痛い。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "痛い痛いと脛を撫でつつ漸くそこに達し、拝殿にも上らず、直ちにその後の丘の上に駆け上ると、ここぞ海抜三千三百三十三尺、高さからいえば富士山の三分の一位のものであるが、人跡余り到らぬ常州第一の深山八溝山の絶頂である。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、熱い熱い、痛い痛い。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "倒れて、そのまま、痛い痛いとのた打ちまわった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺田は夜通し撫ぜてやったが、痛みは消えず、しまいには油汗をタラタラ流して、痛い痛いと転げ廻った。",
              "citation": {
                "source": "競馬",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつては豊満な脂肪で柔かった肩も今は痛々しいくらい痩せて、寺田は気の遠くなるほど悲しかったが、一代ももう寺田に肩を噛まれながら昔の喜びはなく、痛い痛いと泣く声にも情痴の響きはなかった。",
              "citation": {
                "source": "競馬",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は『痛い痛い』とたいそうに言って、『こんな傷までもつけられた私は社会へ出られない。",
              "citation": {
                "source": "源氏物語",
                "author": "帚木",
                "note": "青空文庫"
              }
            },
            {
              "text": "貞世だって苦しんでいるんだ、こんな事で……痛い痛い痛い……つやはいるのか（葉子は思いきって目を開いた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "心配そうな顔をして、……うそだあの顔が何が心配そうな顔なものか……みんな他人だ……なんの縁故もない人たちだ……みんなのんきな顔をして何事もせずにただ見ているんだ……この悩みの百分の一でも知ったら……あ、痛い痛い痛い！",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「痛い痛い痛い……痛い」　葉子が前後を忘れわれを忘れて、魂をしぼり出すようにこううめく悲しげな叫び声は、大雨のあとの晴れやかな夏の朝の空気をかき乱して、惨ましく聞こえ続けた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小屋の中では佐藤の長女が隅の方に丸まって痛い痛いといいながらまだ泣きつづけていた。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手品師は、両手で右の眼を押へて、痛い痛い、と言つて泣きました。",
              "citation": {
                "source": "小熊秀雄全集-14",
                "author": "童話集",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者は直ぐに両手でそこを押えて、「痛い痛い」と金切声を揚げたので近まりに居た高弟諸氏がドッと笑い崩れた。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとその晩おそくワンワンワンとはげしく犬が吠える声と一緒に、「痛い痛い。",
              "citation": {
                "source": "犬と人形",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがその次に顔の繃帯を取ろうとしますと、似せ紅矢は無暗に痛い痛いと金切声をふり絞って、どうしても繃帯に触らせませぬ。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何のために、満たされざる心のために、辛い辛い捨てられた心のために、痛い痛い刺戟のために……。",
              "citation": {
                "source": "ある僧の奇蹟",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はよく風をひくと風にあたるのが痛い痛いと言って笑われて居た。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
