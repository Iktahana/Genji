        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "近くに※釣の火が見え出し、沖に烏賊釣りの船の灯が冷涼しく煌めき出した。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときどき思ひ出したやうに、仲間の漁師達と烏賊釣りにでかけることがありました。",
              "citation": {
                "source": "小熊秀雄全集-14",
                "author": "童話集",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あれは烏賊釣り舟だ。",
              "citation": {
                "source": "夏ちかきころ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「…………」「烏賊釣り舟が綺麗になつて来たぞ――おい、一寸起きて見ろよ。",
              "citation": {
                "source": "夏ちかきころ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「烏賊釣り舟も、あんな風に出そらうと仲々綺麗なものだね。",
              "citation": {
                "source": "ラガド大学参観記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "花やかな色で隈どつた船が二艘、大分離れて、碇を卸してゐるのは、烏賊釣りに来てゐる天草の家船だ、と教へてくれた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "可愛い男は百尋たつ沖で烏賊を取るやら眠るやら烏賊釣りは潮時がありますので、星を時計の代りにして、釣れる時釣れる時のあひまに小舟の上で眠るのです。",
              "citation": {
                "source": "相川おけさ",
                "author": "村松おけさ、佐渡牛などのこと",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初、彼等の作物が、如何にすさまじいものであつたか、本集の末にある「いかつり」の連作などを見れば、あまりはつきり訣り過ぎるであらう。",
              "citation": {
                "source": "鵠が音",
                "author": "追ひ書き",
                "note": "青空文庫"
              }
            },
            {
              "text": "随身像は　しとゞにぬれたりいかつりあまたゐる烏賊つりの舟は　ひそみ居り。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "いか釣り小舟随身門能州一ノ宮気多の大門に、門まぶり様とて、随身像を斎けり。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "タコ道具にはカニ餌をつける丸い仕かけとイカ釣りの大きな羽根板がある。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏賊つり船の灯が見え始めた。",
              "citation": {
                "source": "みちのく",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の人達が、夜になつて、それぞれ元気に艪拍子をあはせて、えつさ／＼と沖の方に烏賊つりにでかけました。",
              "citation": {
                "source": "小熊秀雄全集-14",
                "author": "童話集",
                "note": "青空文庫"
              }
            },
            {
              "text": "とくに春秋の烏賊つりの盛んな頃は、無数の釣船が海峡に浮ぶのだが、その一つ一つにともしたカンテラの光りが、波の上に点々として、目のとゞくかぎり海峡一面に蛍火が浮んでゐるやうだ。",
              "citation": {
                "source": "函館八景",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
