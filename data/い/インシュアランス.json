          "literary": [
            {
              "text": "御自分が隆治さんについて云っていらっしったと同じインシュアランスをおもちになるのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮、自分へインシュアランスかけて母へしゃっかんのこと話した方がよかろう、その提案をかいた。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月十五日（火曜）　巣鴨、こんど行ったとき借金話を出さないのは賛成だ、と笑っている、インシュアランスのこと、ああそういうわけか。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            }
          ]
        }
