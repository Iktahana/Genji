        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イレンタル先生はとても優秀なドイツ人で、友人も熱心と聞いています。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰が見ても、もはやフィリックス・グライドではなく、独人のエル・マックス・イレンタル先生だった。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのなかに独人のエル・イレンタル先生がいた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "独人のイレンタル先生が答えた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "イレンタル先生が感謝した。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　サン・マザ港はいいところでありました、とイレンタル先生がクリントン艦長に告げたのは少しあとだった。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "不作法なエズラ・スタントンとマックス・イレンタル先生が同一人物だと知ったら。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
