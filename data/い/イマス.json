        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "帝、明日の午の刻、東の宮へ在す予定なり。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "将軍は自ら戦地へ在し、兵士たちを鼓舞した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "高僧が遠路はるばる都へ在したとの報せがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
