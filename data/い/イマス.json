[
  {
    "uuid": "94d7ff0d-5c7e-56a1-9e01-b87936c0e905",
    "entry": "在す",
    "reading": {
      "primary": "います",
      "alternatives": [
        "ます"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
