        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to be",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "神は天に在す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "姫君は奥の間に静かに在した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "御仏の慈悲は、遍く衆生の上に在すなり。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "或ひは存在するに到りさうであるか？",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術といふものは、生活と平行して、絶対にそれ自体存在するものである。",
              "citation": {
                "source": "近頃芸術の不振を論ず",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまたここに彼の芸術に対する私の思想上の異議が存在するのであつた。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに作者の幻想の不思議が存在する。",
              "citation": {
                "source": "一つの約束",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大隅君は、結婚式の日まで一週間、私の家に滞在する事になっているのだ。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは名辞以前の世界、即ち「面白いから面白い境」でその面白さが明確であることと同時に存在する所のものである。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、問題が紛糾するのは何時も、宛然芸術の格構せる非芸術といふものが存在するからである。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに「在るか無いか」と考へる以上、その考へることは存在する。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当の、本当の悲劇は物質を基調として初めて存在する。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、「尠くとも私のためには、一切が私のために存在するのだから。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「天の一方に」は、「天一方望美人」というような漢詩から、解釈の聯想を引き出して来る人があるけれども、むしろ漠然たる心象の幻覚として、天の一方に何物かの幻像が実在するという風に解するのが、句の構想を大きくする見方であろう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら Real といふ言葉は外国語の意味に於いては、単なる「現実」を指すのでなく、もつと深奥な哲学的の意味、即ち或る「真実のもの」「確実なもの」、架空の幻影や仮象でなくして、正に「実在するもの」といふやうな意味を持つてゐる。",
              "citation": {
                "source": "詩の翻訳について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "珈琲店　醉月　　醉月の如き珈琲店は、行くところの侘しき場末に實在すべし。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「時」が問題になるところにはそこに変化が問題になる四元世界の一つの軸としてのみ時間は存在する。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう種類の、学校では教わることの出来ない知識が存在するということ、そういう知識が貴重なものだということを、この亀さんに教わったのである。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "他人の軽微な苦痛を己が享楽の小杯に盛ろうとする不思議な心理がいかなる善良な人々の心の奥にも潜在することを教えてくれたようである。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、その時は、地球の表面に存在するもの悉くに、其の持主の名札が貼られ、一坪の青草原さへ殘つてなかつた。",
              "citation": {
                "source": "諸君の位置",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "岳神の父親が滞在すると聞き付けて、配下の土民たちはところところの産物を父の祖神に差上げて呉れと持って来た。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さび」とは、Ｏ、上品、地味のつくる三角形と、Ｐ、意気、渋味のつくる三角形とを両端面に有する三角が三角※の形で現勢的に存在する点にある。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "リズムについていえば、伴奏器楽がリズムを明示し、唄はそれによってリズム性を保有するのであるが、わが国の音楽では多くの場合において唄のリズムと伴奏器楽のリズムとが一致せず、両者間に多少の変位が存在するのである。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "民族的存在の解釈としての「いき」の研究は、「いき」の民族的特殊性を明らかにするに当って、たまたま西洋芸術の形式のうちにも「いき」が存在するというような発見によって惑わされてはならぬ。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "問題は畢竟、意識現象としての「いき」が西洋文化のうちに存在するか否かに帰着する。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "――記憶も、去るにあらずや……湧き起る歓喜のためには　人の情けも、小さきものとみゆるにあらずやああ、神様、これがすべてでございます、　尽すなく尽さるるなく、心のままにうたへる心こそ　これがすべてでございます！",
              "citation": {
                "source": "夏は青い空に……",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、いまするどく鋭刃を合せ、手はしろがねとなり、われの額きずつき、劍術は青らみつひにらじうむとなる。",
              "citation": {
                "source": "決鬪",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "却々瀟洒な不平だよ、高級でいらつしやいますね。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんど、まとめて一本にしたのを機会に、感想をお書きなさい、その他の作品にも、ふれて書いてくれたら結構に思います、というのが編輯者、辻森さんの言いつけである。",
              "citation": {
                "source": "自作を語る",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし私たち日本人、殊に男が何か仕事に打ち込んだ場合、たいていこの宗五郎のようになってしまいます。",
              "citation": {
                "source": "政治家と家庭",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しつけのよい家庭を維持しながら、よい仕事も出来るという政治家もあってよいと思います。",
              "citation": {
                "source": "政治家と家庭",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、兄は、それが出来るかも知れない極めて少数のひとの一人だと思います。",
              "citation": {
                "source": "政治家と家庭",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私もいれてもらいます。",
              "citation": {
                "source": "多頭蛇哲学",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
