          "literary": [
            {
              "text": "極めて開放的で、無雑作に黒と赤との板枠をはめた座席の上の空間には細い四本の柱が立っているきりであった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには、トタンを張った板枠の上に置かれたストーブへ、頭を押付けるようにして、三四郎の妻の比露子が倒れていた。",
              "citation": {
                "source": "寒の夜晴れ",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            }
          ]
        }
