          "literary": [
            {
              "text": "其日からもう、若人たちの糸縒りは初まつた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其日からもう、若人たちの糸縒りは初まった。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "青柳の糸縒りかくる春しもぞ乱れて花のほころびにける　　（春上、貫之）の歌がそれを証する。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "糸縒る神クロト汝達知れりや。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "――附属物の彫金、染革、塗師、かざり師、糸縒などの諸職のなかで、元成は、下絵描きをやっていた。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "塗師も彫師も糸縒も染革仕事も、一さい合財、この間の註文仕事は、みな見合せだよ。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
