        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君チャンノオ母ッチャハネタキリデ、目アナガウントヒッコンデ、ダマッテミテイルト、イキヲスルタビニウゴイテイタフトンガ、ダンダン分ラナイグライニナッテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　ソノ間道子ハ黙ッテキイテイタノカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハ予テ世間ニ於テ人間ノ美ト醜トニヨル差別待遇ノ甚ダシイノニ大ナル軽蔑ヲ抱イテイタ」とヒルミ夫人はその論文に記している。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰ッテミタラ足ニ　ビルガ　三匹ツイテイタ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "割下水ノ家ニ住ンデイタ時分、六ツカ七ツノ頃ダッタヾロウ、乳母ニ抱カレテ寝床ニ横ニナッテイルト、蟋蟀ガヨク縁側ノ外デ鳴イテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏子ガ「大阪ヨ」ト素ッ破抜イタ時、僕ハ鳩尾ノ辺ガピクント凹ンダヨウナ気ガシタガ、イツマデモソノ感ジガ続イテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカシナヲ自分ノ日記ニ書イテイルカドウカ知ラナイガ、書イテイタトシテモ僕ガソレヲ読マナイデ（アルイハ読マナイフリヲシテ）イルヲ認メサセルタメニ敏子ヲ使ッタ？",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
