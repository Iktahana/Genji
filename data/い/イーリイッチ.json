          "literary": [
            {
              "text": "「今晩は、ニコライ・イーリイッチ！",
              "citation": {
                "source": "小波瀾",
                "author": "ЖИТЕЙСКАЯ　МЕЛОЧЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ママは女でしょう、ところが女ってものは、ニコライ・イーリイッチ、しょっちゅうどこかしら痛いんですよ。",
              "citation": {
                "source": "小波瀾",
                "author": "ЖИТЕЙСКАЯ　МЕЛОЧЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そこでと」と、少年の瘠せた肩に手を掛けて、ニコライ・イーリイッチは始めた、「どうだね、元気かい？",
              "citation": {
                "source": "小波瀾",
                "author": "ЖИТЕЙСКАЯ　МЕЛОЧЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "憤らないでね、ニコライ・イーリイッチ。",
              "citation": {
                "source": "小波瀾",
                "author": "ЖИТЕЙСКАЯ　МЕЛОЧЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ニコライ・イーリイッチ」と彼は鋭くささやいた、「シッ。",
              "citation": {
                "source": "小波瀾",
                "author": "ЖИТЕЙСКАЯ　МЕЛОЧЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」「ニコライ・イーリイッチ！",
              "citation": {
