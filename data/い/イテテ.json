        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ミチコサンハ、オバサンノ　ソバニ　ヨツテ、「アカチヤン　ダイテテ　アゲマセウカ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その方が早えや」「アイテテ……又やりやがったな……畜生ッ……こうだぞ……」　って云ううちに、……ギャーッて云う声が室中にビリビリする位響いて来たの。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うわッ、アイテテテ……」　異様な風体の男は、顔をしかめて、三尺も上に飛びあがったように思われた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アイテテ、アイテテ」　よたとんは非常に痛そうな面をしてもがく。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アイテテテ……」　と身体の立つところをエイッと当身。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛作は棒をポトリと落して足の爪先で立って背のびしながら、「イテテテテ……」　見ている者にはてんでワケが分らない。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "飛燕流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻介の左手でチョイとヒジをつままれて、爪先で延び上って、「イテテテテ……」　チョイと十手で脾腹をつかれると、ギュウとノビてしまった。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "飛燕流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくすると、草むらのなかから、「ウーン……ア痛、アイテテテテ」　と腰をさすりながら起きあがった燕作が、夢のような顔をしてのこのこでてきた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "萱原の中に寝たために萱の葉で尻を切り、それで今でもイテテテと啼いて、そういう処を飛びまわるのだという笑話であって、殺されたのではないが切ったという条はなお残っている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と思っただけで、それがもう膀胱のほうにキュッとひびきやがって、「イテテ……」とネをあげざるをえないざまだった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
