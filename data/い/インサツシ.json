  {
    "uuid": "ac490879-7d41-573d-bf40-c05fd452a5ba",
    "entry": "印刷史",
    "reading": {
      "primary": "いんさつし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
