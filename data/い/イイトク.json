[
  {
    "uuid": "5945c817-4d1a-5bcb-9b36-1adb746c3729",
    "entry": "言い解く",
    "reading": {
      "primary": "いいとく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "五段-カ行",
      "inflections": null,
