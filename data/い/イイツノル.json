[
  {
    "uuid": "e984f6ed-7350-5bd0-ad3a-7336be26e039",
    "entry": "言い募る",
    "reading": {
      "primary": "いいつのる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
