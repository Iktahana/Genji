          "literary": [
            {
              "text": "大分酔って一時帰宅。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "又有楽座へ帰って、「大久保」をくさりやり、麻雀二回やって一時帰宅。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、多和・大庭を連れて食ひ歩く、一時帰宅。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "京極鋭五と読売の吉本明光と来り、新宿のまるやへ行き、カツレツとトーストなど、一時帰宅。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ十時十分、十一時帰宅、食事。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰りに大辻のしるこやへ寄り、栗ぜんざいとざうにを食って十一時帰宅。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
