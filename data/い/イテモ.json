        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一日、一日、カク手ガ氾濫シテ来テ、何ヲ書イテモ、ドンナニ行儀ワルク書イテモ、ドンナニ甘ッタレテ書イテモ、ソレガ、ソンナニ悪イ文章デナシ、ヒトトオリ、マトマリ、ドウニカ小説、佳品、トシテノ体ヲ為シテイル様、コレハ危イ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ前タチ、デンデンムシノ　ウタ　シラナイカ」ト、オソバノ　モノニ　キイテモ、「シリマセン」ト　イツテ　クビヲ　カシゲテ　ヰマス。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々ハ今マデニオイテモ行書ノ活字ダノ草書ノ活字ダノトイウモノヲ持タナカツタガ、ソノタメニイササカノ不便モ感ジテハイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ昨年ノ暮空襲デクライ外ヘ出タトキ、左ノ眼ガイヤニ暗イ感ジガシタシ、マタ室ニイテモ変デ、左ノマツ毛に目ヤニデモツイテイルノデハナイカト気ニシタ事ガアッタガ、ソノコロカラ悪カッタラシイ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ジヤガイモ、ジヤガイモガ、マチヲアルイテモイイデスカ。",
              "citation": {
                "source": "ワタシハ　ジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクル朝、ボンコチヤンハ、ボーイサンニ「バウシノオ父サン」ノオ家ヲキイテ、トコロトバンチヲカイテモラヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何シロ出張旅行ガ多イシ、東京ニイテモ宴会ガ多クテ夜ガオソイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「僕ニモ分ラン、僕ハアンマリ浄吉ノコトヲ考エナイヨウニシテイル」「アタシモソウナノ、聞イテモ彼ハ面倒臭ガッテホントノコトヲ云ッテクレナイノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "残念ナコトニ予ノ方ヲ見テモクレナカッタシ、口ヲ利イテモクレナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ウ男ナノデアルガ、イタイケナ子供ガ突然現レテ、コンナ優シイ言葉ヲカケラレルト、モウ溜ラナイ、拭イテモ拭イテモ眼鏡ガ濡レテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテ奈良ノ寺々グライハ見テ置イタ方ガイヽシ、殊ニ今度ハ予ノ菩提所ヲ定メルニツイテモ、必ズ参考ニナルコトガアロウ、ト、ソウ云ッテヤッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "椅子ニ掛ケテイテモ予ハ眼ガ晦ンデ倒レソウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ彼女ハ、モシ僕ガ日記帳ヲ故意ニ彼女ノ眼ニ触レヤスイ所ニ置ケバ、「コレハ私ニ読マセルタメニ書イタ日記ダ」ト思イ、書イテアルヲ聞イテモ、オ前ハ「人ノ書イタモノヲ盗ミ読ミナドイタシマセン」ト答エルニキマッテイルカラ、聞イタトコロデ仕方ガナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
