          "literary": [
            {
              "text": "イリアムナ湖のところを指して、「ここのイギギクを中心にして、周囲の沼沢地方を、方々釣って歩くのだ」と説明してくれた。",
              "citation": {
                "source": "アラスカ通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "きいてみると、アンカレージで水上機をやとって、イギギクまで飛び、そこを根拠地にして、方々の沼へ着水して釣り歩くのだそうである。",
              "citation": {
                "source": "アラスカ通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
