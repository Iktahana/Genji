        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "パラケルススによって化学および薬学の研究への大きな刺戟が与えられ、彼は新しいイアトロ化学者の最初であった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボレリは有名な著書「動物の運動」（ローマ、1680-1681）の著者であり筋肉の作用の研究に生理学と数学の深い知識を持ち込んで事実上に機械学派すなわちイアトロ機械学派を創設した。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "医学は理論、学派および体系、たとえばイアトロ力学、イアトロ化学、体液学、シュタールのアニミズム、ファン・ヘルモントおよび追随者の生気論学説、によって文字通り荒廃していた。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "死後にも名が残るように自分の墓に「イアトロニケス――医師どもの征服者」と書かせた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "こようにしてイアトロ化学やイアトロ化学者とという言葉が使われるようになった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "同様に消化は機械的な過程でありイアトロ化学者が考えているように発酵過程ではないとボレリは言った。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "このようにして南ヨーロッパでは北ヨーロッパのイアトロ化学者に対応するものとしてイアトロ物理学者、イアトロ機械主義者、イアトロ数学者の学派が次第に作られ彼らの考えは広く受け入れられた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "イアトロ機械主義の学説はバリヴィの教えで頂点に達し決定的な変換点となった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "理論に関してバリヴィは本格的なイアトロ機械主義者であり実際この学派の学説を完璧なところまで押し進めた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "パラケルススか、ファン・ヘルモントか、イアトロ化学者か、イアトロ物理学者か？",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしイアトロ化学者やイアトロ物理学者は発見へ強い熱意を持っていたが慎重でなかった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "イアトロ物理学およびイアトロ化学にたいして別方向の反応があった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "物理学が医学へ重要な貢献をすることを知っていて、したがってイアトロ機械主義の傾向をもっていた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はイアトロ機械主義の単なる理論家であるだけではなく言葉の深い意味における偉大な医師であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし彼はイアトロ機械主義者ではなかった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "17世紀は機械論の時代で有名な医師たちの多くはイアトロ機械論者であった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "パラケルスス、イアトロ化学、イアトロ物理学　自然科学は大きく進歩していた。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "17世紀のファン・ヘルモントなどイアトロ化学者（＊イアトロは医学、医療を意味する）は彼を先駆者とみなした。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "イアトロ物理学者すなわちイアトロ機械論者の欠点は彼らが性急過ぎたことであった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
