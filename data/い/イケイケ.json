[
  {
    "uuid": "b5b324c6-7e34-5fc2-80c6-b43b93ac4bdc",
    "entry": "行け行け",
    "reading": {
      "primary": "いけいけ",
      "alternatives": [
        "イケイケ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
