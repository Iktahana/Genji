[
  {
    "uuid": "51ea09d3-becc-5512-9774-fa8898fb8331",
    "entry": "幾ばく",
    "reading": {
      "primary": "いくばく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
