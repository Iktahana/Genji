    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「永ぃてさ、天の邪鬼ぁいっつも小便、垂れ通しさ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おりゃの米子どもいっつもお話し申してあんす。",
              "citation": {
                "source": "山地の稜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "楢夫などぁいっつも一人して湯さ入るもな。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっつも何だりかだりって人だますぢゃぃ。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとその若い人が怒ってね、『引っ張るなったら、先刻たがらいで処さ来るづどいっつも引っ張らが。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはいっつもこの界隈を根城にして、通りかかりの人々から合力を受けている見知越の男である。",
              "citation": {
                "source": "日蔭の街",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "みいっつ、みっつ、くるくる、くーるり、まーた出ろ。",
              "citation": {
                "source": "お月様の唄",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いっつも銹だらけだ！",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "父ちゃんの指はいっつも銹だらけだ！",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "だれかのいったことをくりかえす……ぼくんちにある花は、いっつもむこうからしゃべりかけてくるのに……』20　さて、王子くんが、さばくを、岩山を、雪の上をこえて、ながながとあゆんでいくと、ようやく１本の道に行きついた。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんでも自分達のことば警察へいっつけたり、兵糧ば出さなかったり、壮士に仇をする者がいたら、村の者皆殺しにすると！",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネコ　――　チェシアネコが　――　にやにや、　チェシアネコは　いっつも　そうなんだ。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "エスプレッソと固ゆで卵なのよ、いっつも。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
