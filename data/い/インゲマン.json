        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私はソレーという町に詩人インゲマンの家庭を訪問しました。",
              "citation": {
                "source": "聖アンデルセン",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレーはスラゲルセから二哩離れた、湖沼と森とに囲まれた田園詩的な町で、インゲマンはそこの学園の先生をしていたのです。",
              "citation": {
                "source": "聖アンデルセン",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はスラゲルセの学校生活を退く直前にもソレーへ行って、インゲマンの許を訪れたことがあるのです。",
              "citation": {
                "source": "聖アンデルセン",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思い立つと私は矢も楯もたまらず、インゲマンの許へ走りました。",
              "citation": {
                "source": "聖アンデルセン",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "インゲマンは私の不意の訪問を驚くと共にまた喜んでくれて、親切に心から款待してくれました。",
              "citation": {
                "source": "聖アンデルセン",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "インゲマンという人はそういう人なのです。",
              "citation": {
                "source": "聖アンデルセン",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
