        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "貴重品は、誰にも見つからないように、この部屋の奥に隠滅しておこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "追っ手から逃れるため、森の奥深くに身を隠滅した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その秘密の計画は、公にならないよう、徹底的に隠滅されるべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供の頃、宝物を隠滅するために、庭の木の下に埋めたっけ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
