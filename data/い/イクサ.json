[
  {
    "uuid": "6129690d-7144-5cfb-88af-79472a3f42e9",
    "entry": "戦",
    "reading": {
      "primary": "いくさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
