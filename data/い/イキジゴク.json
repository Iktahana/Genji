    "definitions": [
      {
        "index": 1,
        "gloss": "hell on earth",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "度重なる自然災害と干ばつに見舞われ、その地域はまさに生き地獄と化していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "パワハラ上司のもとでの日々は、私にとって生き地獄そのものだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「こんな過酷な労働環境、いつまで耐えなきゃいけないんだ…ここは生き地獄だよ！」と、彼は同僚に漏らした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "慢性的な激痛に苦しみ、満足に眠ることもできない日々は、彼にとって生き地獄だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "戦争によって国土が荒廃し、食料も水もない状況は、生存者たちにとってまさに生き地獄だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「もう、ここにはいられない。まるで生き地獄だ。」と、彼女は涙ながらに訴えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "うすべり一枚ない板の間に、人ばなれした十八人が、寝るでもなく起きるでもなく、虫のようにごろごろしているありさまは、ほんとうに生き地獄のようでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "左刺しの匕首",
                "note": "青空文庫"
              }
            },
            {
              "text": "その作業の危険さと骨の折れる事といったら、それこそこの世の生き地獄と云っても形容が足りないだろう。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度、惚れたおまえさんを、穽穴に追い落して、生き地獄の苦しみに逢わせようとまで、憎み切るには、随分、手間ひまがかかったよ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "――この三人の生活は、この館へ帰って来て、共棲みをするようになって以来、生き地獄の度を烈しくして来た。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "至る処に転がって居る死骸は云う迄もなく、目も鼻も区別できぬまでに火傷した患者の雑然として限りなき横臥の列を見、その苦悶の呻きを聞いては真に生き地獄に来たのであった。",
              "citation": {
                "source": "原子力の管理",
                "author": "仁科芳雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の行手にどの様な生き地獄が存在したか。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "無数の人間や、現世の人生は強欲に金を求めるまさに生き地獄です。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "輪※と轉生地獄の鬼がまはす車のやうに冬の日はごろごろとさびしくまはつて輪※の小鳥は砂原のかげに死んでしまつた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰も、ごぞんじ無いのだ、と私は苦しさを胸一つにおさめて、けれども、その事実を知ってしまってからは、なおのこと妹が可哀そうで、いろいろ奇怪な空想も浮んで、私自身、胸がうずくような、甘酸っぱい、それは、いやな切ない思いで、あのような苦しみは、年ごろの女のひとでなければ、わからない、生地獄でございます。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "死中の生地獄の極楽求むるな、貪るな酔を、酒を！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "じつに、凄惨といおうか生地獄といおうか、聴くだに慄っとするような死の海の光景も、いまは藻海のとおい過去のことになっている。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "水を求めて狂ひまはる瀕死者の叫びは生地獄でした。",
              "citation": {
                "source": "書簡",
                "author": "家族・親族宛",
                "note": "青空文庫"
              }
            },
            {
              "text": "進み進んで林蔵の一団、生地獄の宿を横に睨み、宿の郊外まで辿りついた。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "地獄へ、ねえ、生地獄へ！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……妾のやられた生地獄へ！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "澄江を生地獄へ送り出した後の、嘉門の豪奢な主家の部屋には、逸見多四郎が端座していた。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "想う女を生地獄へ送った。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは恐ろしい生地獄！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さようさようその生地獄へ！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生地獄１　と、その時まで黙々として、要介たちに従いて来ていた源女が、恐ろしそうな声で魘れるように云った。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「生地獄はそこだ、谷の底だ！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの人も生地獄へ追いやられた！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……が、それは仕方ないとして、生地獄の光景を見ようではないか」「それがよろしゅうございます」「源女殿もおいでなされ」「妾は厭でござります」　恐ろしかった過去のことを、その場へ臨むことによって、ふたたび強く思い出すことを、恐れるという心持から、そう源女は震えながら云った。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐ろしい主人に、井上嘉門殿に、いやいやいや、殿じゃアねえ、鬼だ魔物だ、その魔物の嘉門めに、この生地獄へ放り込まれた、生き返る望みのねえ亡者なのさ。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生地獄の光景を見ようとして、谷の下口まで行きかけると、番人によって遮られ、しかも鉄砲を向けられた。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「生地獄の人達を救い出せ！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬大尽井上嘉門の領地の、あの生地獄へ落された澄江が、どうしてこんな所に来ているかというに、あの夜暴民たちはその生地獄の上の、断崖へ押しよせて行き、生地獄にいる人々を助けようとして、幾筋となく綱を下ろした。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この生地獄の修羅の場で、たった一つだけ餓鬼どもから、仏とも阿弥陀とも思われて、その来迎を待ちわびられる一人の不思議な老人があった。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつ迄もツベコベ吐かすなら貴様も生地獄へ墜落して○○の餌食にして了うぞ！",
              "citation": {
                "source": "物凄き人喰い花の怪",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "地獄の沿道には三途の川、剣の山、死出の山、老の阪、賽河原などがあり、地獄には叫喚地獄、難産地獄、無間地獄、妄語地獄、殺生地獄、八万地獄、お糸地獄、清七地獄等々があって、微苦笑させられるが、それらの地獄の名にも似ず、環境の美くしさにはまた驚かされる。",
              "citation": {
                "source": "雲仙岳",
                "author": "菊池幽芳",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
