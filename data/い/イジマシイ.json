        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "妹が一生懸命に折り紙で作ってくれたプレゼントがいじましくて、思わず目が潤んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "子どもたちが小さな手でお菓子を仲良く分け合う姿がいじましくて、しばらく見守ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「あの子のいじましい頑張りを見ていると、どうしても応援せずにはいられない」と監督は静かに言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
