        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "南極へ着いたものは自分がペンギン鳥と踊つてゐる心になり、シヤムに行けば象の鼻をねじり倒した画は自分の活動と思ひ、クルツプやモスコウ、イルクツク、ニユーヨークなどは、ほんとに腕に力が入つた。",
              "citation": {
                "source": "喜びと悲しみの熱涙",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "イルクツクあたりは勿論、ロシアまでも知れるだらう。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "イルクツクではお前方の評判ばかりしてゐる。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月下旬、莫斯科を立って、イルクツクで東清鉄道の客車に乗換え、莫斯科を立って十日目にチタを過ぎた。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イルクツクで乗換えた汽車の中に支那人のボオイが居たのが嬉しかった。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イルクツクから一駅毎に支那人を多く見た。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
