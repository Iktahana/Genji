        "examples": {
          "standard": [
            {
              "text": "水辺の土手に、可愛らしい黄色い花をつけた犬芥子（いぬがらし）がたくさん咲いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供の頃、野原で摘んだ犬芥子の花で、冠を作って遊んだ記憶がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この時期、道端に自生する犬芥子は、春の訪れを告げる野草の一つだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "犬芥、苦痛にほほゑむ尼僧、隱れたる殉教者の光。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬芥、「約百の涙」、紫苑、どんなに血の滴れる心よりも、おまへたちの方がわたしは好だ。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
