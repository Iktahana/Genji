        "examples": {
          "standard": [
            {
              "text": "博物館の展示でイグアノドンの骨格標本を間近で見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供の頃、イグアノドンが描かれた図鑑ばかり眺めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "イグアノドンは、かつて繁栄した草食恐竜の一種だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "以前に、『イグアノドンの唄』という大人のための童話を書いたことがあるが、その中の主人公の一人、すなわち南アフリカ喜望峰の一角に突如として出現した一億年前の化石魚シーラカンスなども、もちろんその一つである。",
              "citation": {
                "source": "異魚",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イグアノドンなんていうのもいたんだよ。",
              "citation": {
                "source": "イグアノドンの唄",
                "author": "――大人のための童話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが始りで、いろいろな経緯の末、けっきょくチャレンジャー教授を首班とする探検隊が、この失われた世界に出かけ、ステゴザウルスやイグアノドンの生きた姿を見ることになるわけである。",
              "citation": {
                "source": "イグアノドンの唄",
                "author": "――大人のための童話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "イグアノドンの唄『ロスト・ワールド』の話の中で、一番子供たちに人気のあったのは、大きいくせにおとなしいイグアノドンであった。",
              "citation": {
                "source": "イグアノドンの唄",
                "author": "――大人のための童話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "イグアノドンが、子供たちの間で如何に人気があったかは、次の唄でも十分うかがうことが出来る。",
              "citation": {
                "source": "イグアノドンの唄",
                "author": "――大人のための童話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "イグアノドンの背中に　ゴリラが乗ってった　乗ってったゴリラの背中に　お猿が乗ってった　乗ってったお猿の背中に　鼠が乗ってった　乗ってった鼠の背中に　蚊とんぼが乗ってった　乗ってった蚊とんぼの頭の上を　艦載機が飛んでった　飛んでった　このイグアノドンの唄を作ったのは、下の男の子である。",
              "citation": {
                "source": "イグアノドンの唄",
                "author": "――大人のための童話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の国の敗戦も、自分の身体の栄養低下も、実感としては何も知らなかった子供たちは、カインの末裔の土地で、「イグアノドンの唄」をうたって、至極｜御機嫌であった。",
              "citation": {
                "source": "イグアノドンの唄",
                "author": "――大人のための童話――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
