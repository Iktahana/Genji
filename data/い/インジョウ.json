[
  {
    "uuid": "8c060c9c-7e9a-5718-9120-5c54ef29644d",
    "entry": "淫情",
    "reading": {
      "primary": "いんじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "而もなほありあまる愛着と未練と淫情と臆病とに後髪を絶えず曳かれつつ蹌踉として進むに進めぬ惨めさ。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集のはじめに",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのおやじの淫情に燃え走る油目に見すくめられながら、へやの片すみに、三十そこそこの、ひとふぜいもふたふぜいもある、美人ぶりなかなかによろしい中年増がふるえおののいていたのを見つけると、我を忘れて、きょうだいが武者ぶりつきながら、おろおろと叫びました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの婦女は恣にその淫情を解放して意気揚々いささかの羞る色だもなし。",
              "citation": {
                "source": "江戸芸術論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
