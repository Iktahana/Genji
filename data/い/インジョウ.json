  {
    "uuid": "f4061bbe-8eb3-572f-b709-829ab4ac4ddd",
    "entry": "飲場",
    "reading": {
      "primary": "いんじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ところどころに急設された水飲場の水道栓から溢れる水が、あたりの砂にしみている。",
              "citation": {
                "source": "インターナショナルとともに",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "森さんの旧邸は今元の裏が表口になっていて、古めかしい四角なランプを入れた時代のように四角い門燈が立っている竹垣の中にアトリエが見えて、竹垣の外には団子坂を登って一息入れる人夫のために公共水飲場がある。",
              "citation": {
                "source": "歴史の落穂",
                "author": "――鴎外・漱石・荷風の婦人観にふれて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人が我国へ来て、柄杓が泉水飲場に鎖で取りつけられ、寒暖計が壁にねじでとめられ、靴拭いが階段に固着してあり、あらゆる旅館の内部では石鹸やタオルを盗むことを阻止する方法が講じてあるのを見たら、定めし面白がることであろう。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "人に眼だたぬ廊下の隅がその時の私の居場所であり飮場所であつた。",
              "citation": {
                "source": "梅雨紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月の或る日、ゴオドはこの女から仕立物を頼まれて、その仕事をしに、酒飮場の後ろの室へ來ていた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
