        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "中途から退席して表へ出で入り口を見ると「満員御礼」とはり札がしてあった。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の出で入りにそを見るが悲しくて。",
              "citation": {
                "source": "禮嚴法師歌集",
                "author": "與謝野禮嚴",
                "note": "青空文庫"
              }
            },
            {
              "text": "所以に幽と顯と六に出で入りて、日と月と目を洗ふに彰れたまひ、海水に浮き沈みて、神と祇と身を滌ぐに呈れたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この美しく大いなる太陽こそは、その十二の家を出で入りて四季を作りなす。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
