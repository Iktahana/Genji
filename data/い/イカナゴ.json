        "examples": {
          "standard": [
            {
              "text": "祖母が毎年春になると、大量の玉筋魚を醤油と生姜でじっくり煮込んで釘煮を作ってくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "瀬戸内海では春の訪れとともに玉筋魚の漁が解禁され、港は活気に包まれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "網にかかった小さな玉筋魚の群れが、朝日に照らされて銀色にキラキラと輝いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "あたたかな砂浜には人が多ぜいいかなごを漁る網を曳いて居た。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "至るところ、てんぐさが干してある、わかめがほしてある、いかなごが干してある。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかなご、まて貝、がどう、そんなものを煮て貰ってたべた。",
              "citation": {
                "source": "田舎がえり",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかなごにまづ箸おろし母恋し五月十二日　紀州和歌浦、望海楼。",
              "citation": {
                "source": "六百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
