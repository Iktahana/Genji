          "literary": [
            {
              "text": "医学入門自序の印文に此二字が見えてゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "友川三郎兵衛矩兼血判嫡男　長一郎矩道代筆印次男　三次郎矩行　　印文久二年五月十四日　又、別紙奉書の※紙には美事なお家様の文字が黒々と認めてあった。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝋印文書で、大きな取引がされますか」「ええ、よくしますよ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "篤と――」　程普は、炬火のそばへ、玉璽を持って行って、それに彫ってある篆字の印文を読んで聞かせた。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "印文を見てから辞退したのか」「見ておりました。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
