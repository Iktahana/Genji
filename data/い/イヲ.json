          "literary": [
            {
              "text": "」『スズサン、リヨウジカンケイサツニコウリユウセラル、ドナタカスグゴライセイヲコウ――ハナカワヤ』「おや、すゞがあげられた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼信紙をとつて、彼は先づ、「シケイヲセンコクサレタ」と書いた。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで妙に氣が頽れて些とも氣が引ツ立たぬ處へ寂とした家の裡から、ギコ／＼、バイヲリンを引ツ擦る響が起る。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "返事は無くツて、バイヲリンの音がバツタリ止む。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところへ上手でもないバイヲリンをギコ／＼彈られるんだから耐らんね。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に俺が思索に耽ツてゐる時にバイヲリンを彈いたりなんかして………」「それは濟みませんでしたのね。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「私は貴方に無理にお願をしてバイヲリンの稽古までして、家庭を賑にしやうと心掛けてゐるやうな譯ぢやございませんか。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「其のバイヲリンがまた俺の耳觸になるんだ。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "（中略）私ノ町ノ知的素養ノイクブンナリトモアル青年デモ、自分トイウモノニツイテ思イヲメグラス人ハ少ナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツボミタチハ　マダ　コノ　セカイヲ　ミタ　コトガ　アリマセン。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホントウニ　ソウデスヨ、ワタシモ　ハヤク　ボウヤニ　コノ　ヨイ　セカイヲ　ミセテ　ヤリタクテ　タマリマセン」ト　ウマハ　コタヘマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、オテテデ　ミチコサンノ　ネクタイヲ　ツカミマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンダン　ミミガ　トホク　ナツタノデ、ミヤコニ　ヰル　ムスコノ　トコロヘ、「ミミガ　トホク　ナツタカラ、ヨク　キコエル　キカイヲ　カツテ　オクツテ　クレ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンドモ　ナンドモ　オレイヲ　イヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ彼女ガ自由ガキカズタダ苦シミモダエテ居ル間、アラユル呪イヲ浴セテヤリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田ハ決シテ卑怯ナフルマイヲ致シマセン。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月十一日（火曜）〔発信〕第六十二信〔受信〕電報　フツカトモ　ナンラ　メンカイヲコトワツテイルニアラズ　ネンノタメニ」アサ九ジハン　ケンジ　白いきちんとした背広、紳士、そり跡蒼きやせ面。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ショウワユウゲキタイヲ、オソレルナ……コウフクヲトリケシ……ゼンソクリョクデ、ニゲヨ……」「畜生ッ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            }
          ]
        }
