        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "イズベスチヤ紙は、政府高官の談話として、次期国防予算の大幅な増額を報じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "旧ソ連時代、政府機関紙であったイズベスチヤは、共産党機関紙のプラウダと並ぶ二大紙として君臨していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「昔はよく、プラウダには真実がなく、イズベスチヤにはニュースがないなんて皮肉を言ったものだよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "外交官たちは、イズベスチヤに掲載された短い論評から、ソ連の対外政策の微妙な変化を察知しようと腐心した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "イズベスチヤの電子版を確認すると、大統領令の施行に関する詳細な解説記事がトップページを飾っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ロシア情勢の専門家は、イズベスチヤが報じた停戦条件の内容について「極めて慎重な観測気球ではないか」と分析した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "掃除女が室の片づけを終るのを待って、素子は窓に向ったデスクの前に、「プラウダ」と「イズヴェスチヤ」とをもって納った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき「イズヴェスチヤ」の一面をよんでいた素子はすぐに返事をしなかった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コーリヤの見ているイズヴェスチヤの第一面には大見出しで、「パジシャフ・アマヌル・ハンのモスクワ到着」という記事が写真つきで出ていた。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ラップ」の機関誌『十月』やまた、『文学新聞』『成長』『イズヴェスチヤ』などに、その文学ウダールニクの手記、記録がのるようになった。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソ連政府の機関紙イズヴェスチヤの幹部記者。",
              "citation": {
                "source": "「ザイルの三人」訳者あとがき",
                "author": "妹尾韶夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
