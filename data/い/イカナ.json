    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "御度量のひろい将軍家に於いては、もちろん、御計画の頓挫をいつまでも無念がつていらつしやるやうな事は無く、あの、大かたり者の陳和卿に対してもいささかもお怒りなさらず、医王山ホド、ウマクイカナカツタヤウデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ唄っておみやすな」　そして芸者は、テナモンヤナイカナイカ、道頓堀よ――と唄った。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ワタシノ　カナシミヲ　コラヘテ　イカナキヤ　ナラナイ」　ソシテ、コノ　デンデンムシハ　モウ、ナゲクノヲ　ヤメタノデ　アリマス。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この良助を捕まえては、まだかまだかと言う日増しの催促じゃが、今度の事件ばっかりはイカナ俺も手に立たぬ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり掃溜から出たお話で……」「……やはり掃溜から……イカナ事……」　松倉十内は唖然となった。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "……私が〈危険、警戒ヲ要ス〉という信号をすると、〈イカナル危険ナリヤ、場所ハイズコナリヤ〉という返事が来ます。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "信号手",
                "note": "青空文庫"
              }
            },
            {
              "text": "那珂氏は之に説明を與へて此ノ風俗ハ、イカナル原因ヨリ生ジタルカハ知ルベカラザレドモ、卑彌呼壹與等ガ、國人ニ畏服セラレタルハ、其ノ英略アルガ爲ノミニハアラデ、此ノ風俗アリシニモ由レルナルベシ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「此御歌イカナル御懽有テヨマセ給フトハシラネド、垂水ノ上トシモヨマセ給ヘルハ、若帝ヨリ此処ヲ封戸ニ加へ賜ハリテ悦バセ給ヘル歟。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダケドアレヲ提ゲテ歩イタラ、僕ガ買ッテヤッタンダト、婆サンガ感ヅキャシナイカナ」「オ婆チャンハアノ時見テイラッシャラナカッタワ、ドン／＼歩イテ先ノ方ヘ行ッテラッシャイマシタワ」ヤッパリソウダッタナト予モ思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日己ハ死ヌンジャナイカナ」ト、日ニ二三度ハ考エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシガ飲マセタゲルンダカライヽジャナイノ」「皿ナンカニ載セナイデ、君ノ手デ摘マンデ入レテクレナイカナ」「ジャ、チョット手ヲ洗ッテ来ルワネ」又浴室ヘ這入ッテ出テ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「水ガ零レルヨ、ツイデノコトニ口移シニシテクレナイカナ」「駄目々々、図ニ乗ッチャ駄目」パット予ノ口ノ中ヘ二錠、素早ク放リ込ンデ器用ニ水ヲ注ギ入レタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンニハソレガ相当ヨ」「セメテコウシテル間、シャワーヲ止メテ貰エナイカナ」「止メル訳ニ行カナイ、触ラレタ傍カラ直グト綺麗ニ流シチャワナイト気味ガ悪イ」予ハタヾ水ヲ呑マサレタ気ガシタヾケダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "習慣ニナルトイケナイカラ今夜モ二錠ヨ」「口移シニシテクレナイカナ」「ソノ顔ヲ考エテモノヲ仰ッシャイ」ソレデモ手デ摘マンデ入レテクレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドルシンモイヽガ、コウ汗ヲ掻イチャ遣リ切レナイ、何カ外ノ薬ハナイカナ」午後五時杉田氏来診。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヲ何トカ口説キ落ス法ハナイカナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽ己ハ実際気ガ狂ッタンジャナイカナ、コレガ気狂イト云ウモンジャナイカナ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウソノ緊迫シタ雰囲気ニ包マレルダケデモ死ニハシナイカナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度僕ハ、彼女ガイカナル反応ヲ示スカト思ッテアノ性慾点ヲ接吻シテヤッタガ、誤ッテ眼鏡ヲ彼女ノ腹ノ上ニ落シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イカナル父親モ、自分ノ娘ヲファナチックニ愛スル奴ハイナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）ニ習ヒ、現今山頭ニ在ツテ務職ニ任ズ、奇縁不可思不可測ナリ、唯願ハクハ三世ノ勃駄十界ノ索多及ビ吾ガ大師、吾ニ我ガ前生ヲ示告セヨ、イカナレバ此クノ如ク得難キノ人身ヲ得、遇ヒ難キノ密法ニ逢ヒタル乎ト、五体ヲ地ニ擲チ、目ニ血涙ヲ流シ、身ノ所在ヲ忘レ、誠ヲ盡シテ命根尚絶エントスルニ至ル。",
              "citation": {
                "source": "覚海上人天狗になる事",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍ヲ見給フコト、神ノ如ク、戦フヤ果断、守ルヤ森厳、度量ハ江海ノ如ク、オン眼ハ常ニ和ミ給ヒ、イカナル困難ノ時ニアリトモ、徒ラニ狂躁ノ御唇ヲヒラキ給ヘル例シアルコトヲ知ラズ　家中の者の筆記なので、幾ぶん贔屓目があるとしても、その片鱗は窺うことができよう。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "この儀来婆の儀来はギライカナイ、すなわち『おもろ草紙』のニライカナイの転訛であった。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばニライカナイという言葉と、ニルヤカナヤという言葉とは、二つともかなり数多く「おもろ」の中に現われて、どちらが前の形かということを決するには骨が折れる。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでアマミキョは天に祷って、鷲をニライカナイに遣わして求めさせたら、三百日目に三つの穂を咬えて還って来た云々と『御規式之次第』にはあり、奄美大島の方では鶴がその稲穂を持って来たことになっていて、伊勢の神宮の周辺にあったという言い伝えともやや接近している。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "或いはまたオボツカクラの君真物（キンマモン）が天神であるに対して、儀来河内すなわちニライカナイの君真物を海神だというのも、しばしば引用せられる箇条であった。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初に問題になるのは、沖縄諸島のニライカナイ、もしくはニルヤカナヤと、本州の記録の常世郷と、二つの全く別々のものと思われるまでに、縁遠くなってしまった理由｜如何。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを要するにニライカナイという言葉が古くなって、めったに神歌祭文の外では聴かれなくなってから、何か我々の心に残るぼんやりとした概念を、表示するような単語の需要が生じ、それが思い思いであった故に、だんだんと分化したらしいのである。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
