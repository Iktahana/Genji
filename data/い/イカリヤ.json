          "literary": [
            {
              "text": "（３）イカリヤ村とは、カベーが描き出した共産主義的理想郷の名稱。",
              "citation": {
                "source": "共産黨宣言",
                "author": "カール・マルクス",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故、カベーの「イカリヤ物語」よりはモリスの「無可有郷だより」が、モリスよりは更にエドガア・ポオの「アルンハイムの地所」の方が、一層彼を惹きつけるのでした。",
              "citation": {
                "source": "パノラマ島綺譚",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
