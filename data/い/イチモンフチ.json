        "examples": {
          "standard": [
            {
              "text": "彼は一文不知で、自分の名前すら漢字で書くことができなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "昔の村では、農民の多くが一文不知という状況だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "時代が進むにつれて、一文不知の人口は大幅に減少した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "かような触角が若し才智や、学識であるのなら、自分はどんなトライフルな描写の反復をも、一文不知の人々のために労を惜まぬであろう。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリストのいうように「嬰児」の如くになり、法然の説く如くに、「一文不知の尼入道」となり、趙州の如くに「無」となるときにのみ、われわれは宇宙と一つに帰し、立命することができるのである。",
              "citation": {
                "source": "学生と読書",
                "author": "――いかに書を読むべきか――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一文不知の愚鈍の身になして。",
              "citation": {
                "source": "法然行伝",
                "author": "中里介山",
                "note": "青空文庫"
              }
            },
            {
              "text": "この世の多くの優れた作品が、一文不知の名もなき工人たちによって作られている事実を、どうすることも出来ぬ。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど一文不知の者にかえって信心の精髄が宿るのと同じなのです。",
              "citation": {
                "source": "美の国と民藝",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
