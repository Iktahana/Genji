          "literary": [
            {
              "text": "）大将「止まれ、やめぃ。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "（第一おら、下座だちゅうはずぁあんまい、ふん、お椀のふぢぁ欠げでる、油煙はばやばや、さがなの眼玉は白くてぎろぎろ、誰っても盃よごさないえい糞面白ぐもなぃ）とうとう小吉がぷっと座を立ちました。",
              "citation": {
                "source": "とっこべとら子",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おみやげをとっこべとらこに取られなぃようにアッハッハッハ」　お客さまの中の一人がだらりと振り向いて返事しました。",
              "citation": {
                "source": "とっこべとら子",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "崇られまぃが」「心配するな。",
              "citation": {
                "source": "とっこべとら子",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方になって小十郎はばっかぃ沢へこえる峯になった処へ去年の夏こさえた笹小屋へ泊ろうと思ってそこへのぼって行った。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この前のもまだあのまましまってあるし今日ぁまんついいます」「旦那さん、そう言わなぃでどうか買って呉んなさぃ。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "安くてもいいます」「なんぼ安くても要らなぃます」主人は落ち着きはらってきせるをたんたんとてのひらへたたくのだ、あの豪気な山の中の主の小十郎はこう言われるたびにもうまるで心配そうに顔をしかめた。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうが何ぼでもいいはんて買って呉なぃ」小十郎はそう言いながら改めておじぎさえしたもんだ。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小十郎はまっ青なつるつるした空を見あげてそれから孫たちの方を向いて「行って来るじゃぃ」と言った。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ききましたから却って手を大きく振って、「ふん、一向さっぱりさみしぐなぃんぢゃ。",
              "citation": {
                "source": "葡萄水",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あだりまぃのごとだんぢゃ。",
              "citation": {
                "source": "葡萄水",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見っけらへなぃば、すっこすっこど葡ん萄酒呑む。",
              "citation": {
                "source": "葡萄水",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "此処まで来なぃがべ。",
              "citation": {
                "source": "葡萄水",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一昨日、みぃぞれ降ったれば　すゞらんの実ぃ、みんな赤ぐなて、　雪の支度のしろうさぎぁ、　きいらりきいらど歯ぁみがぐ。",
              "citation": {
                "source": "葡萄水",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おゝい、みんな無礼講だぞ、そもそもだ、濁密の害悪は国家も保証する、税務署も保証すると、ううぃ。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、云はなぃかこん畜生、貴さん収税だらう。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「誰だ、時間にならなぃに教室へはいってるのは。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「叱らえでもおら知らなぃよ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生も何があるのかと思ったらしく、ちょっとうしろを振り向いて見ましたが、なあになんでもないという風でまたこっちを向いて「右ぃおいっ」と号令をかけました。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「笛鳴らなぃに教室さはいってたぞ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "うなの兄※も風野又三郎、うなぃのお父さんも風野又三郎、うなぃの叔父さんも風野又三郎だな。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いいなぁ、おらも風になるたぃなぁ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「汝ぃの叔父さんどごまで行く。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "耕一はあたりがきぃんと鳴るように思ったくらい怒ってしまいました。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かけるときはきぃっとかけるんだ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「北極の話聞かせなぃが。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おらの方だて毎日学校さ来るのひでじゃぃ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
