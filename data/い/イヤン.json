[
  {
    "uuid": "a3ee052b-9ae0-5a2d-8e62-8cbf7faa4bea",
    "entry": "いやん",
    "reading": {
      "primary": "いやん",
      "alternatives": [
        "イヤン",
        "いやーん",
        "イヤーン"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "感動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "oh",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「いやん、そんなところをくすぐらないでよ」と彼女は笑いながら身をよじった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「いやん、もう、急に声をかけないでよね」と彼女は胸に手を当てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「いやん、こんなにかわいいプレゼントをもらえるなんて思わなかった」と目を丸くした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "どんな身の毛のよだつような男にしろ、嫉妬をあれほど妬かれるとあとに心が残るものさ」　若い芸妓たちは「姐さんの時代ののんきな話を聴いていると、私たちきょう日の働き方が熟々がつがつにおもえて、いやんなっちゃう」と云った。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえの顔を見りゃ、だれだっていやんなっちまわあ！",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その前からおまえは一通りならないやんちゃ坊だった。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、他吉の痛々しく痩せ衰えた顔を見ると、すぐ笑いやんだ。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "うはははは……」　笑いやんで、五代は、「――帰れ」　と、言った。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやんなつちやふわ。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしあらためて枝雀の語り口を脳味噌で噛みしめてみると、箱根の山を越えて東を見渡してみるのがいやんなる。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "食いやんで面色潤沢で威神あり。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前がたの頼もしいことは、主からもかねて承わっていやんした。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "荊妻と豚児どもですよ」　といって高々と笑いかけたが、ふと笑いやんで、険しい目で葉子をちらっと見た。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんまりかあんまりでないか……とにかく名言には相違ありますまい、ハヽヽヽヽ」　木部はまたうつろに笑ったが、また痛い所にでも触れたように突然笑いやんだ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなにがたがたと震えずに、もそっとこっちへ来い」「い、い、いやんなっちまうなあ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "笛の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いやんなっちまうな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "笛の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「…………」「いやんなっちまうな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "明月一夜騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとうに、いやんなっちまうな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "村正騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "級長　いやんなっちゃうね。",
              "citation": {
                "source": "新学期行進曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやんなっちゃうな」「まあそう云わずにいらっしゃい、今に何とかなるだろうから」　時刻が移るにつれ、人の数は殖えた。",
              "citation": {
                "source": "三鞭酒",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやんなって来たのかい私が。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "到頭俺が、いやんなったのか？",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いいのよ、あんな奴」「――誰なの」「元、下で働いていた男――今もういないんだけどね――いやんなっちゃう――おや、あなた、解くの」　不自然なところのある快活さで、志野はまた髪をいじり始めた。",
              "citation": {
                "source": "氷蔵の二階",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――さいやんかね、だっさ、さいやんかねえ、おんだぶってぶって、おんだ、らったんだりらああおお……タゴールの詩だそうだけれど、意味も判らずに、折にふれては私はつまらない時に唄う。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "手帳へそれらを箇条書きにしていると、きっと口を結ぶようにしてそれを見ていた窪川いね子が、急に、「ねえ、私もう、いやんなっちゃった」と云った。",
              "citation": {
                "source": "一九三二年の春",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨でも降ると、靴をはきながら、ああいやんなっちゃうな、とか、ちっとくさくさしたことがあって帰って来ると、ああァあんなところはもう明日っからやめちゃいたいとかね。",
              "citation": {
                "source": "聟",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからよ、ね、わかったでしょう」　それを思い出して笑えたのだったが、笑いやんでみると、サイには、あんな風に自分を見ないで云ったとよ子の云いかたにも何か特別なものがこもっていたようで、妙な気がした。",
              "citation": {
                "source": "三月の第四日曜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いやんなつちやふねえ。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "テデスコ先生が来ない時はその手下の軍医が診察に来るのですが、私はこの軍医さんが大嫌い、非常に手荒く私を裸にしては診察するのでいやんなっちまいました。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いやんなっちまう」こんな事を云ってしまつの悪い二本の不細工な手を卓子の上にパタッとなげつけた。",
              "citation": {
                "source": "つぼみ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
