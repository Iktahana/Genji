          "literary": [
            {
              "text": "言葉のもつイメェジといふものは妙なものだ。",
              "citation": {
                "source": "標題のつけ方",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてそれは、「人」に対する鋭い洞察と深い同情とをもち、具体的なイメェジを作るゆたかな想像力を具えているもの、一くちにいうと詩人的な資質をもつもの、にして始めてなし得られる。",
              "citation": {
                "source": "歴史の学に於ける「人」の回復",
                "author": "津田左右吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてこういうしごとをした後において、始めて生活の過程の正しいイメェジを具体的な姿で思い浮かべることができるのである。",
              "citation": {
                "source": "歴史の学に於ける「人」の回復",
                "author": "津田左右吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼を吸収し、彼を無に帰してしまうそのイメェジが、彼にはひとつの生活の必要のようにさえ感じられた。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
