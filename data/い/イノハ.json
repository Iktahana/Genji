        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今アナタノ顔ヲ見ナイノハ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今アナタノ顔見ナイノハ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ私ガ一番タマラナイノハ清三ガ道子ノ夫ダトイウ事デス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "左様ナ一度トカ一糎トカ僅少ノ幾何学的問題ニ一生ヲ棒ニフル者ガ少クナイノハ実ニ嗤ウベキコトデアル。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「イツモ青イノハ、何故デスカ？",
              "citation": {
                "source": "夏の日の夢",
                "author": "THE DREAM OF A SUMMER DAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ茅屋ヲ訪ルル客人ノウチ目立ツテ軍人諸君ガ多イノハ不思議ナ現象デアル。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ガ婆サンニオ覚エノ悪イノハ、コンナ場合、婆サンヲ無視シテ予ノ気持ヲ迎エヨウトスルカラナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔ハ随分熱烈ナ仲ダッタ時代モアルノニ、飽キッポイノハ親譲リカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "惚レッポイコトモ惚レッポイガ飽キッポイコトモ飽キッポイノハ親譲リデ、若イ時ノ予ト同様デアルト考エテイタガ、今日デハ左様ニ簡単ニハ云エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガオカシイノハ、母ダケガ若キ日ノ姿ヲシテイテ、予ハ現在ノ老人ノマヽデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "重イノハ脹脛ヤ踝ノ上アタリモヒドイガ、足ノ裏ガ一番ヒドイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "短時間内ニ血壓ノ変動ガカヨウニ激シイノハヨロシクナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ニ布団綿ヲチギッテ大キイノハ六七センチ、小サイノハ二センチグライノ丸ニ圓メ、紅絹ノ裂デ包ンデタンポヲ作ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "連レ添ウテ二十何年ニモナリ、嫁入リ前ノ娘サエアル身デアリナガラ、寝床ニハイッテモイマダニタダ黙々ト事ヲ行ウダケデ、ツイゾシンミリトシタ睦言ヲ取リ交ソウトシナイノハ、ソレデモ夫婦トイエルデアロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ夫トシテ、彼女ニ十分ノ義務ヲ果タシ得ナイノハ申シワケガナイケレドモ、ソウカトイッテ、彼女ガソノ不足ヲ補ウタメニ、モシ仮リニ、―――コンナヲ考エテモ、アノ病的ナ慾求ニ幾分ノ制御ヲ加エタ方ガヨイノデハアルマイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ妻ニ注意シタイノハ、云ウマデモナイダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダシ現在ノトコロデハ、記憶喪失トイッテモ思イ出セナイノハ主トシテ人名ヤ地名デアッテ、事柄ヲ忘レテイルノデハナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イノハナというのも似たような場処で、やはり目隠しの竹を栽えていたのだが、交通機関が改まって今は必要もなく、不便ばかり多いのでおいおいにこれを伐り去り、一つの田舎の風物の特徴が消えかかっている。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
