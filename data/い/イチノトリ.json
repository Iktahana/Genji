        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "一の酉の日は酉の市が開催される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "一の酉に浅草神社を訪れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "一の酉の夜は多くの人出で賑わう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "何でも一の酉の晩であつたらしい。",
              "citation": {
                "source": "開業醫",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうじき一の酉が来る。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月ばかりたって丁度一の酉の来る時分、慶三は商用でこの近所まで来た処から、その時の好奇心でそっと以前の妾宅の前を通って見た。",
              "citation": {
                "source": "夏すがた",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "お糸が手紙を寄越したのは一の酉の前時分であつた。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "お糸が手紙を寄越したのは一の酉の前時分であった。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一の酉が済んで七五三の祝い日ごろに成ると、大拡の木の葉が吹き落され、毎日こがらしが吹きすさむ。",
              "citation": {
                "source": "こがらし",
                "author": "――南駅余情――",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　その年の一の酉は十一月一日で、私は別に信仰心も興味もないので、お酉さまへは行かなかった。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間の一の酉の晩に、小柳雅子の後援会の連中が、小柳雅子が中華へ行くというんでその送別会を開いとったですがね。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一日が一の酉で、十三日が二の酉で、――）二十四日の晩に私は「惚太郎」でお座敷の仕事の帰りだという美佐子と会った。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
