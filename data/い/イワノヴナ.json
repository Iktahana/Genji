        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いかにして、ピータア・セミョノヴィッチが、マリイ・イワノヴナと結婚したか、それだけで充分です。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ターニャ・イワノヴナはレーニングラードのマリンスキー劇場の第一舞踊手と結婚した。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "美男の良人につかまって数番の初等トウダンスと両脚を床の上で一直線に展くことをおそわった時　ターニャ・イワノヴナは自分の姙娠したことを知った。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ターニャ・イワノヴナは　人工流産の手術を受けた。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "四ヵ月目に、二十二歳のターニャ・イワノヴナが髪の毛と食慾と永久に健康な子宮を失って家に帰った時、彼女は更に一つのものを自分が失ったのを知った。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の良人はもうタマーラ・イワノヴナの良人ではなかった。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "帽子を手に持ったなり、小腰を屈めさえしたのである――リザベタ・イワノヴナは彼が何でも話す女友だちなのに。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしその貴族的な御衣裳が気にならないなら……」「まあまあ、僕の衣裳なんぞどうだっていいじゃありませんか、リザベタ・イワノヴナさん。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたがどんなに誇らしい情熱で、天職に身を任せていらっしゃるか、それをわたしが知っているからいいようなものの……」「どうか『天職』はぜひよして下さい、リザベタ・イワノヴナさん。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "――こういう風に物事を眺めるというのは、取りもなおさず、物事を充分詳しく眺めることになりはしませんの」「あなたにはそうおっしゃるだけの権利がある、リザベタ・イワノヴナさん。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ありがとう、リザベタ・イワノヴナさん。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は片付けられてしまったのですから」　秋になる頃、トニオ・クレエゲルはリザベタ・イワノヴナに言った。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "トニオ・クレエゲルは北国に静坐して、彼の女友リザベタ・イワノヴナに約束の通り手紙を書いた。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
