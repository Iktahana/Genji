        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君チャンノオ母ッチャハ、ナンデ今フユデナイカト云ッテ、泣イテバカリ居タノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトニヨルト、我国ニハ「シロウトハクロウトヲ支配ス」トイウ法則ガアルノデハナイカト思ウガマダ調ベテモミナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラガナノ活字ガイカニ醜イカトイウコトハ初号クライノ活字ヲ見タラダレニモワカルダロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "と言うのは、この十年前、一八九九年に、ワイカト号 Waikato という船が、丁度ワラタ号が失踪した通りで遭難し、航路を外れて長く行方不明だったことがある。",
              "citation": {
                "source": "沈黙の水平線",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ昨年ノ暮空襲デクライ外ヘ出タトキ、左ノ眼ガイヤニ暗イ感ジガシタシ、マタ室ニイテモ変デ、左ノマツ毛に目ヤニデモツイテイルノデハナイカト気ニシタ事ガアッタガ、ソノコロカラ悪カッタラシイ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ探求シ、分析シ、整頓シ、再現スルコトニヨッテ、ワレワレハ自然界ノ新シキ神秘ニ触レルコトガ出来ルノデハナイカト思ウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、毎日、ダレカヌツテクレソウナ人ガ通ラナイカトミテヰルノデス。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デモネエ、ワタクシ　スコシ　ハデスギヤシナイカト　オモフノデスケレド。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメコオバサンハ　オホキナ　アクビヲ　カミコロシナガラ、「デモネエ、ワタクシ　スコシ　ハデスギヤシナイカト　オモフノデスケレド。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンガ　オツムノナカデ　クルクルマハツテ　パチント　コワレタノヂヤナイカト　オモツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘弥ノ助六デハ物足リナイガ、訥升ガ揚巻ヲスルト云ウノデ、ソレガドンナニ美シイカト思イ、助六ヨリモ揚巻ノ方ニ惹カレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハコレモワザトデハナイカト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ恐ラクソウデハナイカト、心中デハ思ッテイルノダガ、ソンナコトハナイダロウト、婆サンノ前デハ否定シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼底出血ノ恐レハナイカト、検査シテ貰ッタコトガアルガ、眼底ノ血壓ニモ格別ノコトハナク、予ノ年齢トシテハ相当デアルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "直グヨチ／＼シテ倒レソウニナルノデ、縁側カラ落チヤシナイカト心配デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手ノ痺レハ肘カラ肩ノ辺ニマデ及ビ、コノマヽ半身不随ニナリハシナイカト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――コヽイラガ婆サンノ心ヅカイカト思ウト、胸ガ一杯ニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆デ相談ノ結果、コウケチガ附イタ以上、誠ニ残念デアルケレドモ、兎ニ角コノ注射ハ一ト先ズ打チ切リニシタ方ガヨクハナイカト云ウコトニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ爺サンハ発狂シテルノデハナイカト、思ワレルダケデモ極マリガ悪イ）予ハコヽマデ思イ詰メテ、コヽニ一ツノ可能ナ方法ガアルカモ知レナイコトニ気ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ、現ニソノ報復ノ前触レデハアルマイカト思ワレル現象ガ、精神ト肉体トノ両方面ニ、スデニ二三ニトドマラズ発生シツツアルノヲ感ジル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（コンナ時ニ先日ノ記憶喪失ガ襲ッテ来ハシナイカトイウ恐怖ガ、チラト脳裡ヲカスメタ）僕ハ関田町ノ家ノ所在ハ分ッテイタガ、中ヘハイルノハ始メテダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………妻ノ外出時間ガ昨日アタリカラ変更サレルノデハナイカト、カネテ僕ハ豫期シテイタガ、果シテソノ通リデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
