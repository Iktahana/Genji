        "examples": {
          "standard": [
            {
              "text": "欧州主要リーグの移籍ウィンドウが閉まり、各クラブの最終的な補強布陣が出揃った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「今回の移籍ウィンドウで、彼がビッグクラブへステップアップするのはほぼ間違いないだろう」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬の移籍ウィンドウは期間が短いため、チームの欠点を即座に埋められる即戦力の獲得が最優先される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "クラブの深刻な財政難により、今夏の移籍ウィンドウでの大型補強は見送られる方針だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "移籍ウィンドウの最終日には、締切時間ギリギリまで土壇場の契約交渉が繰り広げられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「移籍ウィンドウが開くたびに、お気に入りの選手が引き抜かれないかハラハラしてしまうよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "移籍ウィンドウ外での選手登録は、無所属のフリーエージェントを除き、原則として認められていない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
