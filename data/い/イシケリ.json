      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "form of hopscotch in which the player kicks a stone through the course",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "公園では、子供たちが元気いっぱいに石蹴りをして遊んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "雨上がりの路地に、懐かしい石蹴りの升目がくっきりと残っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「ねぇ、この石、石蹴りにちょうどいいんじゃない？」と、娘が手のひらの小石を見せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "幼い頃、友達と日が暮れるまで石蹴りに熱中した記憶が蘇る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "単なる子供の遊びと思われがちな石蹴りだが、バランス感覚や集中力を養うのに役立つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "校庭の片隅で、新しい石蹴りのコースが作られ、子供たちが歓声を上げていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "週末は家族で近くの広場へ行き、チョークで石蹴りの場所を作って遊ぶのが恒例だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "向う岸は倉庫と倉庫の間の空地に、紅殻色で塗った柵の中に小さい稲荷と鳥居が見え、子供が石蹴りしている。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "天気のいい日で、お腹の空かない奴は、弁天山付近に集まって石蹴りなぞをして遊んでいる。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校が終ると、いつも数名連れ立って帰ってくる私達に、ときどきその緒方という少年は何処までも一しょにくっついてきて、自分の家へは帰ろうともせずに、夕方遅くまで私達と石蹴りやベイごまなどをして遊んでいた。",
              "citation": {
                "source": "幼年時代",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく見ればそこにも流行というものがあって、石蹴り、めんこ、剣玉、べい独楽というふうに、あるものははやりあるものはすたれ、子供の喜ぶおもちゃの類までが時につれて移り変わりつつある。",
              "citation": {
                "source": "嵐",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "飴屋は後で死際の人間の心持に逆っても悪いから貰ったようなものの、こんな石蹴りの大きいのなんか、子供へやるより外に仕様があるまいと、そのまま飴箱の中へ投りこんだものさ」「アッ」　隣の室からは、押し付けられたような驚きの声。",
              "citation": {
                "source": "呪の金剛石",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "のぞいて見ると、十歳を頭と思われるくらいの男の子が五六人、いずれも背中に乳呑児を結びつけて、子守を仰せつかりながら、桜の木の下で石蹴りなんぞをして、遊んでいるところであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "メンコ、根ッ木、ブランコ、縄飛び、ラムネの玉遊び、コマ、凧、石蹴り、石鉄砲、竹馬、金輪廻し、吹矢、当て物、隠れンぼ、かるた、十六ムサシ、といったような類である。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちよんがくれにも、めかくしにも、をか鬼にも、石蹴りにもあきたお国さんは前髪をかきあげて汗ばんだ額に風をあてながら「こんだなにして遊びませう」といふ。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらが早いときはひとりで石蹴りや縄とびをしてもうかもうかと待つてゐる。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代りに、鉄の輪回しや剣玉は流行と同時にさっそくお仲間いり、剣の方へ玉を載せるのはちょっと手練を要するので、通学の途中にも歩きながら一心不乱、だが、これらの流行も束の間、そのうち石蹴りやまり投げに移って、追い追い新式の遊戯に逐われ、以上の玩具もすべてブリキやゴム、セルロイドの製品といれ代った。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば石蹴りなどは私などの全く知らなかった遊びだが、東京でいうチンチンモガモガ、関西でいう足ケンケンの上手な児なら、誰でもこれに参加せずにはいない。",
              "citation": {
                "source": "こども風土記",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると引潮の中に、膝のあたりまではいつた新太郎ちやんが、何か棒のやうなものを、水の中へさしこんで、ちやうど石けりの線をひく時のやうな恰好で、ゆるゆると後退りしてゐる姿が小さく見えた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "37　石けりの子供　火星兵が、人間狩をはじめる。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "下町の、とある横町の道ばたで、女の子が五、六人、チョークで白い輪をかいて、楽しそうに石けりをしていた。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の子たちは、石けりに夢中になっていた。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らが通っていった後には、チョークでかいた石けりの白い輪はあった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "石けりの石も、そのままそこにあった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人ともひじょうにうれしそうで、姉のほうが、石けりのまねをすると、弟もそのまねをするし、姉が飛び上がって、なわ飛びのまねをすると、幼い弟も、それと同じかっこうをしたのであります。",
              "citation": {
                "source": "汽車は走る",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "孝ちゃんと、勇ちゃんと、年ちゃんは、石けりをしていたし、みつ子さんとよし子さんは、なわとびをしていました。",
              "citation": {
                "source": "引かれていく牛",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちはその広場で石けりや力くらべをやつて遊んでゐたのです。",
              "citation": {
                "source": "亜剌比亜人エルアフイ",
                "author": "犬養健",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは勝手にコルク倒しをしたり、石けりをしたりしてゐたのです。",
              "citation": {
                "source": "亜剌比亜人エルアフイ",
                "author": "犬養健",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
