          "literary": [
            {
              "text": "タッタ今二千円をイタブッて出て行ったばっかりのところなんだが……どうも彼奴の呉れっぷりが美事なんでね。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "因縁を附けてイタブリにかかる気配であった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名な学者の貝原益軒に従えば、イチジクとは元来イヌビワすなわちイタブ Ficus erecta Thunb. の名であるが、それが移って無花果の名になったといわれる。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれは今、目の先きに多量に生産され並べたてられている小説類に目をくたびれさせることをしばらくやめて、志賀小説ならびに志賀を、もうすこし調べ捜し、イタブリゆすってみる責任がある。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
