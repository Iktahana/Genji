[
  {
    "uuid": "ea845b99-1367-5622-b6be-1e58713a09ac",
    "entry": "鳶尾",
    "reading": {
      "primary": "いちはつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
