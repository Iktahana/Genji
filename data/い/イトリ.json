        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "かしこなるが我が懷かしき穢きイトリの小都會なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "イトリに入りて灰色に汚れたる家々の壁を仰ぎ見よ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "車のイトリに入らんとするとき、同じく乘れる一客は、これフラア・ヂヤヲロの故郷なりと叫びぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "イトリの狹隘を過ぐる時、われはフエデリゴが上を憶ひ起しつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時から又外へ出てヴァイトリンガ河岸への径を開きにかかる。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "※高等女学校のスチユデント、　腰にはバンドの輝きて、　右手に持つはテキストブツク、　左手にシルクアンブレラア、　髪にはバツタアフライ、ホワイトリボン……」　自分は亦此処にも日本らしいからぬメロデイを聞いておやおやと思つたのある。",
              "citation": {
                "source": "市街を散歩する人の心持",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな「髪結新三」的情調へあんなべらぼうなバツタアフライ、ホワイトリボンが這入つて来てたまるものか。",
              "citation": {
                "source": "市街を散歩する人の心持",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デイトリヒシュタイン公ダンネベルグ、アマルティ公領司令官セレナ、ああ、フライベルヒの法官レヴェズ……」とグッと唾を嚥み込んで、濁った眼を法水に向けた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は字名をイトリツクの羊飼ひと称ばれて、帰納法或は経験哲学に反するシステムを説き、論を進めるに事物の解剖と観察の分類を事と選んだ。",
              "citation": {
                "source": "嘆きの谷で拾つた懐疑の花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんしろ海のあちらじゃ女の子の男装が流行ってる時代なんだし、岸田氏を取巻く女達などは、ま、言って見れば日本のデイトリッヒやガルボなんだからね。",
              "citation": {
                "source": "花束の虫",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイチェの願ったごとく「善悪の彼方の岸」に出ずることは、けっして善悪の感じを薄くして消すことによって達せられるのではなく、かえってその対立をますます峻しくし、その特質をドイトリッヒに発揮せしめて後に、両者を含むより高き原理で包摂することによって成就するのである。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドイトリッヒにいわば、人間のあらゆる要求をばことごとく悪しと見ることも可能なのである。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "）〔欄外に〕　Ｙの眼鏡、出来たが、かけると心持わるい由、ロシアでは、インク、メガネ、スイトリ紙、写真の道具、化粧品までわるし。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デイトリッヒとボアイエとが演じた「沙漠の花園」はフランスのカソリック精神と人間の情熱とアフリカの沙漠とを結びつけた平凡な一つの作品であった。",
              "citation": {
                "source": "イタリー芸術に在る一つの問題",
                "author": "――所謂「脱出」への疑問――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（私の最も大に驚いた事には、ザイトリツツもその内面生活の上にかうした変化を経験したのだ。",
              "citation": {
                "source": "ニイチエ雑観",
                "author": "超人の如く潔き没落を憧憬するニイチエの日本精神に就て",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこでは易々と日本風にやつて行けるからだ――つまり、それをやるのに必要な二三の条件があそこにあるんだよ」　アレヴイイのニイチエ伝によれば、ニイチエは右の手紙の書かれたより少し以前に、独逸を去るに先立つて、彼の旧友ザイトリツツ男爵をミユンヘンに訪ねた。",
              "citation": {
                "source": "ニイチエ雑観",
                "author": "超人の如く潔き没落を憧憬するニイチエの日本精神に就て",
                "note": "青空文庫"
              }
            },
            {
              "text": "リユシヤン・ギイトリイでも、カチヤロフでもよろしい。",
              "citation": {
                "source": "俳優志望者メンタルテスト",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時の役割は、ピエールに当代一の名優リュシアン・ギイトリイ、マルトに同名にして才色兼備のマルト・ブランデスが扮した。",
              "citation": {
                "source": "ジュウル・ルナアル",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近わが国にも紹介されたフランス映画の「とらんぷ譚」といふのは、サシヤ・ギイトリイといふ俳優がはじめから終ひまで一人で喋りつゞける風変りなトオキイであるが、この映画の面白さは、フランス俳優のさういふ教養と技術を土台として仕組まれたものと解するのが適当である。",
              "citation": {
                "source": "演劇統制の重点",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはもとより粗雜な、荒削りの、純然たる本能的共産主義ではあつたが、それでもその主張はよく急所に當つて、勞働階級の間に有力となり、フランスのカベー、ドイツのワイトリングのやうな、空想的共産主義を産出してゐた。",
              "citation": {
                "source": "共産黨宣言",
                "author": "カール・マルクス",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルュシヤン・ギイトリイなんていふ役者はなかなか威張つてるやうですね。",
              "citation": {
                "source": "仏蘭西役者の裏表",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは実際に見ないと結局水かけ論になりますが、例へば、仏国当代の名優リュシャン・ギイトリイは、息子サシャの書いた脚本なら何んでも演つてゐます。",
              "citation": {
                "source": "演劇一般講話",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはやつぱり、リュシャン・ギイトリイが偉いからに相違ないのであります。",
              "citation": {
                "source": "演劇一般講話",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "『パストゥール』の一作によつて、「真面目な劇」を試みはしたが、そして、名優を父に有つ果報を実証はしたが、生来の駄々ツ子サシャ・ギイトリイは、やはり「きはどい洒落」と「おどけた感傷」の作家である。",
              "citation": {
                "source": "仏国現代の劇作家",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時の役割は、ピエールに当代一の名優リュシヤン・ギイトリイ、マルトに同名にして才色兼備のマルト・ブランデスが扮した。",
              "citation": {
                "source": "劇作家としてのルナアル",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "否、それよりも、シェイクスピイヤ、カルデロン、モリエエル、ミュッセの作品でさへも、それぞれ、クレイグ、ラインハルト、コポオ、ギイトリイの手によつて演ぜられる時、誰がこれを「古典劇」であるが故に、「われわれの生活に縁の遠いもの」と断言し得よう。",
              "citation": {
                "source": "新劇のために",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナトオル・フランスのクランクビルの如きは、半分以上ギイトリイが筆を入れたと伝へられてゐる。",
              "citation": {
                "source": "批評家・作家・劇場人",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後、アルフォンス・ドオデエの家に出入し、また、リュシャン・ギイトリイ、エドモン・ロスタン、トリスタン・ベルナアルなどと交を結ぶ。",
              "citation": {
                "source": "「葡萄畑の葡萄作り」後記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "シイトリイ村長に選挙さる。",
              "citation": {
                "source": "「葡萄畑の葡萄作り」後記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後、アルフォンス・ドオデエの家に出入りし、また、リュシヤン・ギイトリイ、エドモン・ロスタン、トリスタン・ベルナアルなどと交りを結ぶ。",
              "citation": {
                "source": "「ぶどう畑のぶどう作り」後記",
                "author": "岸田国士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
