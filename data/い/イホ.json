        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "口デ言エナイホド喜ビマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "チュアン　イエン　ペイフォン　ツイイエンジュン　ハン　コアンフイパイ　ファニャン　ワンアルツイホン　ゾアン　イ　コン　ウエイ「畜生！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ネネムもマミミも何とも返事をしませんでしたが男はふいっとマミミをお菓子の籠の中へ入れて、「おお、ホイホイ、おお、ホイホイ。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それというのは、あのネネムが八つの飢饉の年、お菓子の籠に入れられて、「おおホイホイ、おおホイホイ。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホイホイ背後から追い追い立て、約二里ばかり進めば、八溝川の上流、過般の出水の為に橋が落ちている。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "」紅中ならカンになっており、リンシャンカイホウ（同じパイが四枚の時、もう一度ツモってそれで上る上り方）のチャンスがある。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しじみ売りは「スズメガイホー」と呼び歩いた。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "葡萄園を葭簀で圍ツて氷店にして、氷をかく臺もあればサイホンの瓶も三四本見えた。",
              "citation": {
                "source": "昔の女",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "――では京弥、菊路のところへ参ろうぞ」　ピカリピカリと眉間傷を光らせて、そのままエイホウホウと乗物を打たせました。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "エイホウ」　景気のよい小者どもの掛け声に交じって、「寄れッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくして、「アカイホン」と、女が独り言のように言った。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――樹明君近来の口癖はブチコワスゾである、何カヲブチコワサズニハヰラレナイホド、君は悩み苦しみ焦立つてゐる、そこで、私が先づ茶碗をぶちこはす、樹明君喜んで皿を投げつける、ガチヤンガラガラ、どうやら胸がすいたらしい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　花タチハ　ジブンタチノ　スガタヲ　ナガメアヒ、ジブンタチカラ　ナガレデル　ニホヒヲバ　カギアツテ、ジブンタチガ　ミナ　オナジヤウニ　キイロイ　キモノヲ　キテ　ヲリ、ホカノ　木ヤ　クサニ　マケナイホド　ウツクシイノヲ　シツテ　イツソウ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車の中で炭を焚いて死に損なったり、貨車へ乗って、カンテラを点けて用を足そうとすると、そのカンテラが揺ぶれてすぐ消えてしまったり、サイホンを呑むと二三滴口へ這入るだけであとはすぐ氷の棒に変化したり、すべてが探険と同様であった。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　これで皆が思はず笑つたので、流石に長野も恥かしくなつたと見えて、顏を眞赤にしたが、今度は自分の袂を曳いて、「陸軍ケイホウのケイホウは怎う書きませう。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と竹山が云ふので、「陸軍ケイホウです。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と答へると、「ケイホウは刑罰の刑に法律の法だぜ。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　これで皆が思はず笑つたので、流石に長野も恥かしくなつたと見えて、顔を真赤にしたが、今度は自分の袂を曳いて、「陸軍ケイホウのケイホウは怎う書きませう。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……プッ……プップッ……どうもヒドイホコリだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お八重の婿どん誰かいナア　阿呆鴉か梟かア　お宮の森のくら闇で　ホ――イホ――イと啼いている。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳河のたつたひとつの遊女屋に薊が生え、住む人もないがらんどうの三階からきりきりと繰り下ぐる氷水の硝子杯、お代りに、ラムネに、サイホン、こほろぎも欄干に。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「メークイホー、デーデホー、パーレーホッホ、パーレーホ。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
