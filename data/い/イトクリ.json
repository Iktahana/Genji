          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖母は縁側に座り、慣れた手つきで蚕の繭から糸繰りの作業を続けていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "工場見学では、昔ながらの機械を使った糸繰りの工程を間近で見学することができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "祭りの準備で、提灯を吊るすための長い紐を糸繰りで巻き取っていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼女は糸繰りの歌を口ずさみながら、リズムよく糸を紡いでいった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "祖母の紡いだ糸を紡錘竹からもう一ぺん四角な糸繰り枠に巻き取って「かせ」に作り、それを紺屋に渡して染めさせたのを手機に移して織るのであった。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "糸繰り車の音も水車の音ももはや聞えず。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "駄菓子、草鞋、糸繰りの道具、膏薬、貝殻にはいった目薬、そのほか村で使うたいていの物を売っている小さな店が一軒きりしかなかったのである。",
              "citation": {
                "source": "おじいさんのランプ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "野の角に背を後ろに日和ぼっこをして、ブンブン糸繰り車をくっている猫背の婆さんもあった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　夕食のあと片づけを済ませてから、お高が糸繰りの仕事をひろげると間もなく父に呼ばれた。",
              "citation": {
                "source": "日本婦道記",
                "author": "糸車",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論｜養蚕とか地機とか糸繰りとか、若干農村に縁のある内職も探し得たであろうが、何にしても労働が土と関係が薄くなるようでは、村に居住しても次第に異分子をもって目せられる結果は免れ得なかったのである。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "川上はいくども千ちゃんのことを説明して、そのゆくえをたずねたが、怪物は知らないとくりかえすばかりであった。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なつかしき父上のために、ばんざい三唱、おとうさんのよくなられたことを、電報で知らせて下さるブルック先生まことに頼もしきかぎり、電報を見て屋根部屋へかけあがり、わたしたちによくして下さる神さまにお礼を申さんとせしも、ただ大声で、うれしいとくり返し泣きましたのみ。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯様からだをつかったせいか、其晩から万作が腕は非常に痛み出して、少し熱さえ出て渇を覚ゆると見え、頻りに焼酎が飲みたい飲みたいとくりかえしていう。",
              "citation": {
                "source": "漁師の娘",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリストフには出発の権利がないとくり返し聞かされたし、それは彼女の信じたがってるところだった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "男でさえも、汝は自由でないとくり返し言われるときには、もう自由でなくなって禽獣に等しくなる。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は余りの失策に、河野に対しても面目なく、馬鹿馬鹿しい、馬鹿馬鹿しいとくり返すばかりで、それから先は真犯人のせんさくをする余裕もなく、うやむやの内に自分の部屋へ引下りました。",
              "citation": {
                "source": "湖畔亭事件",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　和太郎さんの年とったおかあさんは、ぶいぶいと糸くり車をまわしては、かた目で柱時計を見あげ見あげ、夜おそくまで待っていました。",
              "citation": {
                "source": "和太郎さんと牛",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「このところ糸くり車。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペチカのタイルに一寸面白いものがあり、木を刻った昔の橇、糸くり道具の部分品など、農民芸術として興味あった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣りの二階は女給の宿で赤い着物がブラ下り、その下は窓の毀れた物置きで、その一隅に糸くり車のブン／＼廻る工場があつた。",
              "citation": {
                "source": "古都",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この子に糸くりをやめさせることができないものでございますから。",
              "citation": {
                "source": "三人の糸くり女",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "この子は年がら年じゅう、糸くりをしたがっておりますが、わたくしどもは貧乏で、アサを手にいれることができないのでございます。",
              "citation": {
                "source": "三人の糸くり女",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あたしは糸くりの音をきくのが大すきです。",
              "citation": {
                "source": "三人の糸くり女",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしのところには、アサがたくさんありますから、すきなだけ糸くりをさせてやりましょう。",
              "citation": {
                "source": "三人の糸くり女",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の子は、この三人の糸くり女をかくしておいて、お妃さまのくるたびに、つむぎあがったより糸をたくさん見せました。",
              "citation": {
                "source": "三人の糸くり女",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかげで、花よめはあのいやな糸くりをしないでもいいことになりました。",
              "citation": {
                "source": "三人の糸くり女",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は前庭の日なたで繭を※ながら、実際グレートヘンのように糸繰車を廻していることがある。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「その時分だっけな、一度ちょっと夢のように逢ったのは――」「いんね、十七でいまの家へ一度縁づいたけれど、姑さんが余り非道で、厳しゅうて、身体に生疵が絶えんほどでね、とても辛抱がならいで、また糸繰の方へ遁げていた時でしたわ。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "市中繁華な町の倉と倉との間、または荷船の込合う堀割近くにある閑地には、今も昔と変りなく折々｜紺屋の干場または元結の糸繰場なぞになっている処がある。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『今之れと云つて何もさして居りませんが、父親の使をしたり、私の糸繰る手伝をしたりさしてをります。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "室町末の人々に謡い飽かれた歌が、この尾張あたりへ伝って来て、農家の娘の糸繰歌などに訛ってよく謡われている。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
