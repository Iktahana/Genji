          "literary": [
            {
              "text": "彼ハアット云ッテ倒レ机ノハシデ頭ヲヒドク打チ、倒レルト同時ニ血ヲハイタヨウデシタガ、ソノママ昏倒シテシマッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「墨汁ヲ吹イタヨウニ、砲煙ガ波浪ノ上ヲ匐ッテ動キダシタ」　何にも動かぬ。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯ノ間カラ莨入レト煙管ノ袋ヲ取リ出シテ一服吸ッタ様子デアルカラ、茶ノ間ニ坐ッテイタヨウデモアルガ、イツノ間ニカ門外ヘ出タラシク、素足ニ吾妻下駄ヲ穿イテ歩イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………僕ハ今年カラ、今日マデ日記ニ記スコトヲ躊躇シテイタヨウナ事柄ヲモアエテ書キ留メル、自分ト妻トノ関係ニツイテハ、アマリ詳細ナヲ恐レテイタカラデアッタガ、今年カラハソレヲ恐レヌハシソウモナイケレドモ、シカシ必ズシモソウトハ限ラナイ理由モアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先刻僕ラガ郁子ヲ自動車カラ抱キオロシタ時ハ玄関ニウロウロシテイタヨウデアッタガ、僕ラト入レ違イニ黙ッテ関田町ヘ帰ッテシマッタラシイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「玉井君、友田ガ三菱ノ幹部ト話シテ居ルノヲ聞イタヨ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
