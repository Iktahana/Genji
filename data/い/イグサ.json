    "definitions": [
      {
        "index": 1,
        "gloss": "soft rush (Juncus effusus var. decipiens)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "い草は畳の原材料として昔から使われている。",
              "source": "幻辞"
            },
            {
              "text": "い草の香りは夏の涼しさを感じさせてくれる。",
              "source": "幻辞"
            },
            {
              "text": "この地方で栽培されるい草は品質が高い。",
              "source": "幻辞"
            },
            {
              "text": "い草を編んで趣のある工芸品が作られる。",
              "source": "幻辞"
            },
            {
              "text": "い草の製品は湿度調整に役立つ特性がある。",
              "source": "幻辞"
            },
            {
              "text": "農業振興策によってい草の栽培は減少している。",
              "source": "幻辞"
            },
            {
              "text": "い草の収穫は夏場の重要な農作業だ。",
              "source": "幻辞"
            },
            {
              "text": "い草を使った座布団は清涼感があり好まれている。",
              "source": "幻辞"
            },
            {
              "text": "い草から出る良い香りはストレスを軽減する。",
              "source": "幻辞"
            },
            {
              "text": "い草の繊維は丈夫で長持ちする特徴がある。",
              "source": "幻辞"
            },
            {
              "text": "い草を乾燥させる過程は職人の経験が重要だ。",
              "source": "幻辞"
            },
            {
              "text": "い草製品は天然素材として人気がある。",
              "source": "幻辞"
            },
            {
              "text": "い草の栽培には大量の水が必要とされる。",
              "source": "幻辞"
            },
            {
              "text": "い草の畳は和室の雰囲気を引き出す。",
              "source": "幻辞"
            },
            {
              "text": "化学繊維の台頭でい草の需要は減った。",
              "source": "幻辞"
            },
            {
              "text": "い草を使ったカーペットは断熱効果がある。",
              "source": "幻辞"
            },
            {
              "text": "い草の青い色は時間とともに褐色に変わる。",
              "source": "幻辞"
            },
            {
              "text": "い草の編み方によって風合いが異なってくる。",
              "source": "幻辞"
            },
            {
              "text": "い草のバッグは夏のファッションに合わせやすい。",
              "source": "幻辞"
            },
            {
              "text": "い草の文化は日本の伝統工芸として価値がある。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "かの、君が幼な時汽車で通りかゝつた小山の裾の、春雨に打たれてゐたどす黒い草の葉などを、また窓の下で打返してゐた海の波などを……　　　　　　　※　実生活は論理的にやるべきだ！",
              "citation": {
                "source": "Me Voila",
                "author": "―― a Cobayashi",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまらない草花がみんな「いきもの」だという事をこれほど明白に見せつけられたのは初めてであった。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば郊外を歩いていて道ばたの名もない草の花を見る時や、あるいは遠くの杉の木のこずえの神秘的な色彩を見ている時に、わずかの瞬間だけではあるが、このえびの幻影を認める事ができる。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "林の奧の、やや廣い草原に、異形の物が十數人、と言ふのか、十數匹と言ふのか、とにかく、まぎれもない虎の皮のふんどしをした、あの、赤い巨大の生き物が、圓陣を作つて坐り、月下の宴のさいちゆうである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにが悲しいつたつてこれほど悲しいことはない草の根の匂ひが静かに鼻にくる、畑の土が石といつしよに私を見てゐる。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "湿つた野原の黒い土、短い草の上を　　夜風は吹いて、　死んだつていいよう、死んだつていいよう、と、　　うつくしい魂は涕くのであつた。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は青い草と花があって、完全に山と裾野の美を示している。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一ヶ月前位に、農民たちは腹までも川の水に浸つて、三角洲に生えた丈の長い草を苅りに、川を渡つて行つたのを私は見てゐたから。",
              "citation": {
                "source": "氷雨",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人鵜照君の年賀状観の変遷史をここに御紹介して読者の御参考あるいはお笑い草に資するのである。",
              "citation": {
                "source": "年賀状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "展覽會などで本職の畫家の描いた繪を見ると、美しい草木や景色や建築物やが惜氣もなく材料に使はれて居る。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつの間にか宮の裏へ拔けると、可也廣い草原に高く聳えた松林があつて、其處にさつきの女學生が隊を立てゝ集つて居た。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "沼森平といふものもなかなか広い草っ原だ。",
              "citation": {
                "source": "沼森",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニは、頂の天気輪の柱の下に来て、どかどかするからだを、つめたい草に投げました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "腰をおろしたみじかい草。",
              "citation": {
                "source": "台川",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その水へ半分顔を浸して泳ぎながら横目で海岸の方を見ますと、泥岩の向うのはずれは高い草の崖になって木もゆれ雲もまっ白に光りました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのすぐ下の青い草の崖の上に、まさしく一人のカアキイ色の将校と大きな茶いろの馬の頭とが出て来ました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「上さ行って好い草食え。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　けれども牛は、美しい草を見る度に、頭を下げて、舌をべらりと廻して喰べました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "風が出て来て刈られない草は一面に波を立てます。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　せいの高い草を分けて、どんどん牛が走りました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまわりがまっ蒼になって、ぐるぐる廻り、とうとう達二は、深い草の中に倒れてしまいました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "知らない草穂が静かにゆらぎ、少し強い風が来る時は、どこかで何かが合図をしてでもいるように、一面の草が、それ来たっとみなからだを伏せて避けました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚だ杜撰なディレッタントの囈語のようなものであるが、一科学者の立場から見た元禄の文豪の一つの側面観として、多少の参考ないしはお笑い草ともならば大幸である。",
              "citation": {
                "source": "西鶴と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "まつくらの地面をたたきつける、今夜は雨や風のはげしい晩だ、つめたい草の葉つぱの上でも、ほつと息をすひこむ蛙、ぎよ、ぎよ、ぎよ、ぎよ、と鳴く蛙。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "くぢら浪海岸にて孤独田舎の白つぽい道ばたで、つかれた馬のこころが、ひからびた日向の草をみつめてゐる、ななめに、しのしのとほそくもえる、ふるへるさびしい草をみつめる。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そこで彼は馬から、黒い草のなかへ、跳び下りて、　その熱くなつてゐる繩を斷ち切つた。",
              "citation": {
                "source": "旗手クリストフ・リルケ抄",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "「不味いものを食うくらいならいっそ、くたばった方がいい」　これは、美味のないとき、膳の上の食品を罵倒する敬蔵の云い草だが、ひょっとすると、それが辛辣な事実で父娘の身の上の現実ともなりかねない今日この頃では、敬蔵もうっかり自分の言葉癖は出しにくかった。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、それに深く疲れる時いつも頭を休めに行つたのは、家から寂しい草原の小徑を五六町｜辿る海岸の砂丘の上へであつた。",
              "citation": {
                "source": "處女作の思ひ出",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、向うの草原にも、こちらの丘にも、処々、青い草がちら／＼しだした。",
              "citation": {
                "source": "雪のシベリア",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "道理はあるが、あの徳の言い草が本気でない。",
              "citation": {
                "source": "二老人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
