        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私ガココニ書イテオキタイコトハ、日本ノ活字カラヒラガナヲナクシタホウガヨイトイウ私見デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダ、活字ダケヲカタカナニスレバヨイトイウノダ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「出勤ガシタイト兄ヘ云ッタラ、手前ガ手段デ、勤道具、衣服モ出来ルナラ、勝手ニシロ、オレハ、イカイコト手前ニハイリ上ゲタ故、今度ハ構ワヌトイッタ故、ソノ時ハオレガホホノ下ニハレ物ガ出テイテ寝テ居タガ、少シモ苦労ヲカケマイトイウ書附ヲ出シテ、檻ヲ出デ――」　出たな！",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年ノ秋、書斎ノスタンドヲ螢光燈ニ改メタノモ、実ハイツカハコウイウ機会ガ来ルデアロウヲ理由ニ螢光燈ニ変エタノダッタガ、―――事実読書ノタメトイウヨリモ僕ハ、イツカハ螢光燈ノ明リノ下ニ妻ノ全裸体ヲ曝シテ見タイトイウ慾望ニ燃エテイタノダッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハタダ手デ触ッテミテソノ形状ヲ想像シ、相当素晴ラシイ肉体ノ持主デアロウト考エテイタノデアッテ、ソレユエニコソ白光ノ下ニ曝シテ見タイトイウ念願ヲ抱イタワケデアッタガ、サテソノ結果ハ僕ノ期待ヲ裏切ラナカッタノミナラズ、ムシロハルカニソレ以上デアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「現像ノ面倒ガナイトイウ長所ハアルケレドモ、フラッシュヲ用イルノガ手数デアルシ、ヤハリ普通ノ機械ノ方ガ撮リヨイネ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………木村ハ試験デ忙シイトイウノニ、僕以上ニ熱心デアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不便ヤ苦痛ハナイトイウモノノ、何トナク気味ガ悪イガアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハソノ器具ヲ、夫以外ノ男性ニ試ミテミタイトイウ好奇心ニ、果シテイツマデ抗シ得タデアロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チキュウノニンゲン、アレＲスイセイトイウ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
