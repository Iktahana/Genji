[
  {
    "uuid": "21b65f00-274a-54c0-90d6-d2c380acec97",
    "entry": "いたずら好き",
    "reading": {
      "primary": "いたずらずき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "mischievous",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その子どもはいたずら好きで有名だ。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きな性格は直らないと母が言う。",
              "source": "幻辞"
            },
            {
              "text": "兄はいたずら好きで下の子にちょっかいをかける。",
              "source": "幻辞"
            },
            {
              "text": "映画のキャラクターはいたずら好きな猫だ。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きな友人との付き合いは楽しいが疲れる。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きな夫のせいで生活が落ち着かない。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きな猿はサバンナの動物園の人気者だ。",
              "source": "幻辞"
            },
            {
              "text": "小さいころからいたずら好きな性質は変わらない。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きなティーンエイジャーの時期を乗り越えた。",
              "source": "幻辞"
            },
            {
              "text": "その俳優のいたずら好きなキャラが人気らしい。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きな遊びをして友情を深める子どもたち。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きな同僚に迷惑をしている。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きな彼のおかげで会社は活気がある。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きながらもチームメートに信頼されている。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きな姉に翻弄される毎日である。",
              "source": "幻辞"
            },
            {
              "text": "そのいたずら好きな鳥は食べ物を隠す習性がある。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きな妹の行動は予測不可能だ。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きなペットの世話も大変である。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きな祖父は孫たちに囲まれて楽しそうだ。",
              "source": "幻辞"
            },
            {
              "text": "いたずら好きな性格のくせに本番では真剣だ。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "同時にいたずら好きの天分をも発揮して、ガス管内に空気を押し込み、先生の祈祷が始まると燈火が自然に消えるという趣向を案出し実行した。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたずら好きの学生達は彼に「杏仁水」という渾名を奉っていた。",
              "citation": {
                "source": "さまよえるユダヤ人の手記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらいたずら好きの学生たちでも、さすがに見ず知らずの女達に対してあんな悪いたずらをする筈がない。",
              "citation": {
                "source": "山椒魚",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたずら好きなその心は、嘉永ごろの浦賀にでもあればありそうなこの旅籠屋に足を休めるのを恐ろしくおもしろく思った。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが倉地を冷淡にさせるのだ」――そう心の中には思いながらも、葉子の心にはどうしてもそのいう事を聞かぬいたずら好きな小悪魔がいるようだった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしいたずら好きの神様があって、この若い中尉を、第四エンジン室に引張っていって、そこに働いている東洋人カラモを見せてやったらどんな顔をするであろうか。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お兼　あの子はいたずら好きでなまけるからだよ。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「恋文なんて出したおぼえはないし、いたずら好きの妹さんが、わたしたちの名を勝手に使うのは遺憾だと書いてありました。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等も流石に時々は、クイックシルヴァがこんなにさとりが早くなくて、それに巻きついた蛇が始終身をよじっているあの不思議にいたずら好きな杖も打ちゃってしまえばいいのにと思いました。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "麦田様は、面白い方ですから、大久保の奥様も、およろこびになるでしょうし、旅は大勢のほうが、笑うことが多くて、ようございます」「それは、そうだな」　若松屋惣七は、何か考えこんでいて、急にいたずら好きな口調を帯びてきた歌子の声に気がつかなかった。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "川をお渡りになるときに、風はいつもいたずら好きにあなた様のくろがみをなびかせて参ります。",
              "citation": {
                "source": "玉章",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "スコットの細君が少しいたずら好きで、「あの真似をしてくれ」とウォーナーに頼むと「よし」といって、毛布を腰に巻いてスコットランドの男のする短いスカートみたいにして、歌をうたう無邪気な男であった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたずら好きの首藤がこさえた日頃の怨みつらみもあってか、いつしか首藤は太田一派から目の敵にされ……「これやからよそ者は好かんちゃ、偉そうにしくさってから」　話し合いの終わり近く、太田はそう吐き捨てた。",
              "citation": {
                "source": "湯けむり",
                "author": "澤西祐典",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、たちまち彼の体は暇でいたずら好きの者共に囲まれてしまったのである。",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に鼬はたちの悪いいたずら好きで、人が道を歩いていると、ひょいと向うへとびだして来て、立ちあがって、交通整理でもするように、右手をあげて右をさし示したり、左手で左のほうをさしたりする。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、いたずら好きの梅吉と云う藝者がにじり出して、「三平さんなら、妾にだってかけられるわ。",
              "citation": {
                "source": "幇間",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か仔細があるんですか」時平の顔にいたずら好きな子供がするような、意地悪な微笑が浮かんだのを、平中は世にも恨めしそうに横眼で見たが、「いや、そんなことはございませんが、………」と、強いて苦しそうな愛想笑いを洩らして云った。",
              "citation": {
                "source": "少将滋幹の母",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と真顔になって、菊子がそれを尋ねたので、ナオミはいよいよ図に乗りながらいたずら好きの眼を光らして、「ええ、飼っておりますの、菊子さんは猿がお好き？",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたずらずきの子どもたちは、顔をみあわせながら、目と目で、神さまをつかまえようよ、とそうだんしました。",
              "citation": {
                "source": "子どものすきな神さま",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう余興係には、いたずらずきの次郎がまっさきにひきうけねばならぬはずだが、次郎はなぜかいぜんとして沈欝な顔をしているので、他の人々もしいてすすめなかった。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはいたずらずきの者が書いた人さわがせの手紙ではないのでしょうか」　太刀川は、思っているままを、原大佐にいった。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カニ怪人にばけたやつは、とほうもないいたずらずきなんだ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
