        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この淵の主である蟠竜が白堊を嫌ったという伝説がある。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "榎本子等回天蟠竜千代田三艦を以て迎へ戦ふ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」武揚等の艦隊中蟠竜回天の二艦が機関を毀つた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の頃向島の白髭に蟠竜軒という尼寺がございまして、それに美惠比丘尼という人が有りまして、能く人の未来の吉凶禍福を示しますので、これに帰依する信者も多分にございます。",
              "citation": {
                "source": "粟田口霑笛竹（澤紫ゆかりの咲分）",
                "author": "粟田口霑笛竹（澤紫ゆかりの咲分）",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟠竜というのはこんなのだろう。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
