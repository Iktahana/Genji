        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "新聞で見るとソビエトの五か年計画の一つとしてハバロフスクに百三十キロの大放送局を建設し、イルクーツク以東に二十キロ以上の放送局を五十か所作るということである。",
              "citation": {
                "source": "北氷洋の氷の割れる音",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハバロフスク附近を午後八時に出発してやって来たとすると、方向も進路も、従って時刻も勘定が合います」「ふうん。",
              "citation": {
                "source": "空襲下の日本",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しからば彼の覚醒したことが、東京とニューヨークとハバロフスクの三都へ、電波でもって伝えられていなければならぬはずだった。",
              "citation": {
                "source": "千年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはハバロフスク大学の考古学主任教授のチタです」「えっ、主任教授！",
              "citation": {
                "source": "千年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸外国の日本向け日本語放送は、「ヴォイス・オブ・アメリカ」にせよ、ハバロフスク中継のモスクワ放送にせよ、短波受信機でなくても中波程度の受信機で割合容易に聴けるが、世界の動きに特に関心をもつ人々以外は一般に余り注意されていない現状である。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "革命時代の若き党員がハバロフスクへ潜行運動に出かける。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬橇でハバロフスクへ行こうとする、御者きかない。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハバロフスクの手前を走ってる。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一面白く雪が積り、黒く樹木の見える信州の山は、自分にハバロフスク辺の鉄道沿線の風景を思い出させた。",
              "citation": {
                "source": "一九三二年の春",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮本とまたハバロフスクの雪のふる山の間をシベリア鉄道で何日も乗って行って見たい心持がしきりにした。",
              "citation": {
                "source": "一九三二年の春",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハバロフスクへ潜行運動にベザイスが、絵を描いた貨車にのっかって行く。",
              "citation": {
                "source": "新しきシベリアを横切る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハバロフスクの手前を走っている。",
              "citation": {
                "source": "新しきシベリアを横切る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "判明しているのは九月十九日、ハバロフスク発、浦塩に帰着し、浦塩より東支鉄道にて九月二十一日、ハルピンに来てから後のことだけで、九月二十二日には、北満ホテルに催された福岡県人主催の歓迎会に臨んだ。",
              "citation": {
                "source": "叛骨・中野正剛",
                "author": "――主観的な覚え書き",
                "note": "青空文庫"
              }
            },
            {
              "text": "向こうへ行って、バロフ所長と話しましょう」　大男が不機嫌な顔をして、どんよりした目でポニーから降りて、ルペラ男爵が近づくと重々しく敬礼した。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "原油埋蔵は充分あり、引き合うと見ております」「ここは金に覆われた砂漠ですよ、バロフ所長」「いいことを聞きました、男爵。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "バロフ所長が言った。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
