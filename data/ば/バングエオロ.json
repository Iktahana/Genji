          "literary": [
            {
              "text": "彼はニヤサ湖から、タンガニイカ湖へ進み、モエロ湖やバングエオロ湖まで探りました。",
              "citation": {
                "source": "アフリカのスタンレー",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、彼はなほ探検の旅を続け、モエロ湖やバングエオロ湖などの附近一帯を調査しました。",
              "citation": {
                "source": "アフリカのスタンレー",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのためにはまづ、バングエオロ湖附近にまで探査を進める予定でした。",
              "citation": {
                "source": "アフリカのスタンレー",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "バングエオロ湖に注いでゐるチャンベジ河のほとりで、森の中に珍らしい花が咲き乱れてゐるのに出逢ひました。",
              "citation": {
                "source": "アフリカのスタンレー",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月二十九日の夕方、一行はバングエオロ湖南岸のチタンボといふ部落に着きました。",
              "citation": {
                "source": "アフリカのスタンレー",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
