        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヨワン・バッティスタ・シロオテは、ロオマンの人であって、もともと名門の出であった。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "建坊、キバッテ、エヽ写真、ツクッテヤ。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "寅二郎は、船上に吊ってあるバッテイラを指して、手真似であれで連れて行けと頼んだが、きかれなかった。",
              "citation": {
                "source": "船医の立場",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "このバッテリーの呼吸がうまく合わないと、生命がけのファインプレイが出来ないのだ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そげな事あドウデモよかバッテン、イッソ死ぬなら俺へ形見ば遣らんか』　大惣は寝たまま天井をジイッと見した。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ぬる迄可愛がろうとしたバッテン天婦羅が天井へ行かんちうて逃げた……なんて聞けば聞く程馬鹿らしいけに俺がそうっとアクビしたところがそいつが寝ている篠崎に伝染って、これもそうっとアクビしたけに、俺あ良い事したと思うた。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "意気筋では、よくは存じませぬが、江戸前の「ツンケン型」、上方式の「京人形型」、「オキャーセ型」、「アキマヘン型」、「バッテン型」なぞいうのが、その地方地方のこうした社会の気前を代表しているのだそうであります。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもの通り新高さんと妾のバッテリでシボレーに乗って、博多から折尾へ行く途中十時半チョット前と思う頃、香椎の踏切にかかったの。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "マイバンユリオコシテイルウチニ、君チャンニハオ母ッチャノカラダガダンダンホネバッテユクノガ分ルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "的もないのに盲滅法に歩きとばして脚の疲れた儘に、とある倉庫の空地をみつけて、つい小半日もへタバッテいる間に偶然この女を見付けた訳だ。",
              "citation": {
                "source": "苦力頭の表情",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "バッテル氏によるに、ルアゴンでは畑に雨の必要があると、酋長に願って空に弓を射て貰う。",
              "citation": {
                "source": "奴隷根性論",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "――が、幸いにも、飯田橋華かなりし頃の比露子夫人の朋輩であったと言う、先程のあのモダンガールを探し出す事の出来た僕は、計らずも彼女の口から、上杉逸二と比露子夫人とがそのかみのバッテリーであった事、そして又、夫人は案外にもあれでなかなかの好色家である事等を知る事が出来た。",
              "citation": {
                "source": "花束の虫",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の労働への進出については、僕にして見れば相当に感激もしているしほめたくもあるのだが、今あんまり口を極めて賞賛してしまうと、直ぐ二三ヶ月してから（そんなこともないだろうが）すっかりヘタバッテしまうようなことになるとすると、君はその時、余計恥ずかしい思いをしなければならないから、今は余りホメないよ。",
              "citation": {
                "source": "新しき夫の愛",
                "author": "――　牢獄の夫より妻への愛の手紙　――",
                "note": "青空文庫"
              }
            },
            {
              "text": "多計代という名をかく前、本文の終りの一行たっぷりが、上から下までバッテンバッテンのつづきでうめられてあった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、手紙のおしまいの行がどうしてバッテンつづきで終っているのか、不審だった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "バッテンは、ＫＩＳＳを意味するバッテンであったらしい、と。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなにどっさりの、おしまいは墨さえかすれたがむしゃらなバッテンバッテン――。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子は足かけ五年留守居していた母が兄上様と宛名にかいていたこころもちを思いやり、同時に、そのどっさりのバッテンに親愛を感じた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ポツダム宣言の趣旨に立脚して……その次」　行を目で追って、「ここだ」　重吉は、もっているペンで大きいバッテンをつけて見せた。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがおわるとフリーバッティングをやる、それも投球するものは先生である。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ハ、コンゲツ一パイメッタニ雨モフラズ、カゼモナクテ、マイニチマイニチヤケルホドアツクテ、ワタシハモウスコシデ、クタバッテシマフトコロデシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に甲府城の勤番支配であった駒井能登守、後にバッテーラで石川島から乗り出した駒井甚三郎であります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "安房の国の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの時に、吉田寅次郎の二の舞だといって、横浜沖の外国船へ向けてバッテーラを漕ぎ出させて行ったはずの駒井甚三郎が、こうして房州の西端、洲崎の浜に立っていることは意外であります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "安房の国の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで傍にいる清吉と呼ばれた男も、あの時バッテーラの艪を押していた男であります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "安房の国の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "白雲が右のバッテイラ型と称した小舟の傍で言いました、「ねえ、もう袋の鼠だよ、こっちのものだよ、そう思って聞いて見給え、あの問題の楽器はイカモノだな、笛でなし、鼓でなし、尺八でなし、琴でもなし、三味線でもなし、何か毛唐のイカモノの響きだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁船の中を押しわけて、万石浦方面から飛ぶが如くにバッテイラが漕ぎつけられて来るのは、その舳先のカンテラの進行だけでもよくわかる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵部の娘らしいのが面を蔽うて寝ている――「田山先生」と、お松が一番先に出て、このバッテイラを迎えると、当然、保護して来たと思われる田山白雲らしい姿も、声もないのが、やや異常に感じさせました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
