        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは梢から風呂の中へ落ちた蔕のない青いは手桶の水へぽたりと落ちて、水のとばちりが少しおつぎの足へ掛つた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてばちりと筆を擱く音がしてそれからかたりと硯箱の蓋を落す音がした。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "水面ゆふべとなればちりかかる柳の花粉のうすあかり、そのかげに透く水面こそけふも Ongo の眼つきすれ。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "水面ゆふべとなればちりかかる柳の花粉のうすあかり、そのかげに透く水面こそけふも ＊Ongo の眼つきすれ。",
              "citation": {
                "source": "思ひ出",
                "author": "抒情小曲集",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたに迄とんだとばちりで御免下さい。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "当人同士は、けろりとけんかも忘れ、睦じく抱っこ寝んねしている間に、傍のおみささんは娘の手を引っぱって逃げ歩き、とばちりを受けて私まで（たれにもいいこそしないが）一晩中まんじりともしなかったとは！",
              "citation": {
                "source": "田舎風なヒューモレスク",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとばちりをうけて素子が、よけいに長く苦しんでいなければならないのではないかと思えて。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな事情で、おせきは浩平との口争いのとばちりを母へ持って行って、とうとう別居を強要し、お常も「一人で暢気にしていた方がいい……」などと言って別れたのであったが、それ以来も浩平が相変らずちょくちょく母のところから自分の知らぬ出費を借り出しているらしかったのだ。",
              "citation": {
                "source": "米",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "間抜けども」　間抜けは自分であった、と、この男も感じていたので、その飛ばちりを、怒号と罵倒とで、部下たちにぶっつけた。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "あおりを食って、金五郎は、顔中、飛ばちりをかぶった。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
