        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "仲間は水を持つて來て、彼の顏に水を浴せ、彼に飮ませた、かくてドクトル・バールトは助かつた。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "音楽批評家のテオフィル・グージャールと、スイスのある大学の私任教授でドイツ人であるバールト博士とだった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はこのバールトに、ある晩｜麦酒店で出会ってそれから知り合いになったのだった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "バールト教授は、何時ごろこの片がつくかを考え、国民文庫の原稿のために始めていた仕事をその日のうちに終えられるくらいに、家に帰れるかどうかと考えていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "バールトはクリストフを青葉｜棚の下へ引っ張っていって、ビールを命じた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "バールトはビールを一本｜空にしながら、ちょっと沈黙のあとに言った。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "バールトは小声で言った。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "バールトがあとからついて来た。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
