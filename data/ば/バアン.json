        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ロバァト・バアンズ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファーガスンは来るべき偉大なものを予告し、バアンズは其の偉大なものを成しとげ、私は唯其の糟粕を嘗めたに過ぎぬ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "スコットランドの三人のロバァトの中、偉大なるバアンズは別として、ファーガスンと私とは余りに良く似ていた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "白人は愚か、土人さえ稀なマルケサスの裏海岸に自分で小舎を作り、唯一人（海と空と椰子樹の間に全く唯一人）一冊のバアンズと一冊のシェイクスピアを友として住んでいる（そして少しの悔もなく其の地に骨を埋めようとしている）亜米利加人もいた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お国自慢10・19（夕）　米国の戦時通信記者として名高いゼエムス・バアンス氏が、今度の戦争の当初、白耳義にゐた折の事、ある日ブラツセルの市街を｜いてゐると、前方から独逸の自動車が一｜輛風を切つて飛んで来た。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一刹那バアンス氏の頭には、「奴さん、てつきり独探だな。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　バアンス氏は胸をわく／＼させながら、この自動車の駈けつ競に見惚れてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とバアンス氏は直ぐ現場に駆けつけてみた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "擦り創一つ負はなかつた白耳義の運転手は、にこにこもので其辺の群集を見廻してゐたが、ふとバアンス氏の亜米利加式の顔が目につくと、いきなり帽子を脱いで頭の上で揮りまはした。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼奴めが……」とバアンス氏は、それからといふもの、会ふ人｜毎にお国自慢をしてにこ／＼してゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スヰンバアンといへば英国の名高い詩人だが、その愛読者の一人に、何とかして一度この詩人と握手して、その心持を一生の自慢にしたいと思つてゐた男があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちよいと伺ひますが、あなたはスヰンバアン先生ぢやありませんか。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは学校の図書館の本で英吉利の詩人バアンズの評伝中に引いてある一節であった。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い麦の香を嗅ぐようなバアンズの接吻の歌も、自分の国の評判な俳優が見せてくれる濡幕にも勝って一層身に近い親しみを覚えさせた。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "）「顏はそれほどの美人といふほどのこともないけど、ヘツプバアン見たいな口つきで、何か不敵な魅力を持つてゐるぢやないの。",
              "citation": {
                "source": "痴日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "キーツ、シエレイ、バアンズ、テニソン――種類は夥しい、求める人の好みに依る。",
              "citation": {
                "source": "日本橋",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と訊くと、「まあ見たまえ」と、ワイルドの『デ・プロフンディス』や、Ｋさんの大好きなスウィンバアンやアーサア・シモンズの詩集の下から引出して、僕の手に渡してくれた。",
              "citation": {
                "source": "聖書",
                "author": "生田春月",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ソレヲ聞カナケレバアンナニ憤慨ハシナカッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五時頃バアンボオム中尉は更めてルウフア搜査のために出動した。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六世紀の和蘭古画の中にあるケンタン・マツシスの「サロメ」の濃厚な色彩の調子が、英国近代のバアン・ジヨオンスやロセツチの作と似｜通ふ所のあるのを珍らしいと思つて出口で其絵葉書を買つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、一人のスウインバアンさへ出れば――と云ふよりも更に大力量の一人の「片歌の道守り」さへ出れば……　日本の過去の詩の中には緑いろのものが何か動いてゐる。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "｜山の手をぶらぶら歩きしていた十六歳のジョンソンはふと或る門の前に止った一台のオウバアンを認めた。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "素通り出来ないような型の車を道端に乗りすてたミスター・ウィリアムズの不幸でジョンソンはそのオウバアンに乗っかった。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、オウバアン一台を盗む意志はないのだし、事実盗んだのではないし、ジョンソンは既に何十人かの先輩の例にならって一寸｜娯楽ドライヴに借りたんです、と肩を上げたり下げたりするだけだ。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四は豚肉冷製寄物（ジャボン　デコレ　ア　ラ　ジェリー　バアンド　フルツ　アッソルチ）にしてハムを寄せしもの。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、その世界的な群衆は、赤いタバアンをまきつけた印度人の巡査が相図をすると、ちゃんと馬車の路を譲ってくれる。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちにもバアンス夫人の一家と、妻のあそび友達ミス・ノリスとが早くから見送りに来ている。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハツパとかいふ、えれえ音のするもんだちうが……」「あゝ、ハツパね、火薬でバアンとやるんでせう。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "月明の夜に焼酎をあふつて、歌ひ舞ふ素朴な生活はわたくしをしてバアンズの詩に見るスコットランド人のそれを想はせた。",
              "citation": {
                "source": "八月の霧島",
                "author": "吉田絃二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "根元の方にも日の光は漏れて、幹は黒々と、葉は淡きバアントシーナを塗ったように、琥珀色に透明して、極めて美しい。",
              "citation": {
                "source": "白峰の麓",
                "author": "大下藤次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
