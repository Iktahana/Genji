        "examples": {
          "standard": [
            {
              "text": "壊れた古い冷蔵庫がキッチンの隅で場所塞ぎになっていて、新しい家電を置くスペースがない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「こんな大きなソファ、狭い部屋には場所塞ぎなだけじゃないか」と母に文句を言われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "廊下に山積みにされた段ボール箱は、避難経路の場所塞ぎになるので早急に片付けてください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "餌もいらねば、場所塞ぎにもならず、いつもかくしにおさまっていて、おっことしたとて――壊れもせずさ。",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            }
          ]
        }
