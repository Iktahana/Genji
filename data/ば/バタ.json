        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "妻子を振り捨てて、奮然学問のしなおしをやってみようかしら、そんならばたしかに人をおどろかすにたるな。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "井戸ばたの流し場に手水をすました自分も、鶏に興がる子どもたちの声に引かされて、覚えず彼らの後ろに立った。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分も声を掛けなかった、三人も菓子とも思わなかったか、やがてばたばた足音がするから顔を出してみると、奈々子があとになって三人が手を振ってかける後ろ姿が目にとまった。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つの乳牛に消化不良なのがあって、今井獣医の来たのは井戸ばたに夕日の影の薄いころであった。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "燈火の周圍にむらがる蛾のやうに、ある花やかにしてふしぎなる情緒の幻像にあざむかれ、そが見えざる實在の本質に觸れようとして、むなしくかすてらの脆い翼をばたばたさせる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その笛の音こそはプラトオのエロス――靈魂の實在にあこがれる羽ばたき――である。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "月夜重たいおほきな羽をばたばたしてああ　なんといふ弱弱しい心臟の所有者だ。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝のつめたい臥床の中で私のたましひは羽ばたきをするこの雨戸の隙間からみればよもの景色はあかるくかがやいてゐるやうですされどもしののめきたるまへ私の臥床にしのびこむひとつの憂愁けぶれる木木の梢をこえ遠い田舍の自然からよびあげる鷄のこゑですとをてくう、とをるもう、とをるもう。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは鶉のやうに羽ばたきながらさうして丈の高い野茨の上を飛びまはつたああ　雲よ　船よ　どこに彼女は航海の碇をすてたかふしぎな情熱になやみながらわたしは沈默の墓地をたづねあるいたそれはこの草叢の風に吹かれてゐるしづかに　錆びついた　戀愛鳥の木乃伊であつた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "意志と無明觀念もしくは心像の世界に就いてだまつて道ばたの草を食つてるみじめな　因果の　宿命の　蒼ざめた馬の影です。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒼ざめた馬冬の曇天の　凍りついた天氣の下でそんなに憂鬱な自然の中でだまつて道ばたの草を食つてるみじめな　しよんぼりした　宿命の　因果の　蒼ざめた馬の影ですわたしは影の方へうごいて行き馬の影はわたしを眺めてゐるやうす。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い牡鷄わたしは田舍の鷄ですまづしい農家の庭に羽ばたきし垣根をこえてわたしは乾からびた小蟲をついばむ。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ　この冬の日の陽ざしのかげにさびしく乾地の草をついばむわたしは白つぽい病氣の牡鷄あはれな　かなしい　羽ばたきをする生物です。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さびしい花やかな燈火の奧にふしぎな性の悶えをかんじて重たい翼をばたばたさせるかすてらのやうな蛾をみるあはれな　孤獨の　あこがれきつたいのちをみる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "づしり、づしり、ばたり、ばたり　ざつく、ざつく、ざつく、ざつく。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "づしり、づしり、ばたり、ばたり　お一、二、お一、二。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "づしり、づしり、づたり、づたり　づしり、どたり、ばたり、ばたり。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "騷擾重たい大きな翼をばたばたしてああなんといふ弱弱しい心臟の所有者だ花瓦斯のやうな明るい月夜に白くながれてゆく生物の群をみよそのしづかな方角をみよこの生物のもつひとつの切なる感情をみよ明るい花瓦斯のやうな月夜にああなんといふ悲しげな　いぢらしい蝶類の騷擾だ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒い蝙蝠わたしの憂鬱は羽ばたきながらひらひらと部屋中を飛んでゐるのです。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたらしい座敷のなかで　蝶が翼をひろげてゐる白い　あつぼつたい　紙のやうな翼をふるはしてゐる黒い蝙蝠わたしの憂鬱は羽ばたきながらひらひらと部屋中を飛んでゐるのです。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "月夜重たいおほきな翅をばたばたしてああ　なんといふ弱弱しい心臟の所有者だ。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネネムは泣いてどなって森の中をうろうろうろうろはせ歩きましたがとうとう疲れてばたっと倒れてしまいました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おやおやとおもっているうちに上からばたっと行李の蓋が落ちてきました。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "土神はいかにも嬉しさうににやにやにやにや笑って寝そべったまゝそれを見てゐましたが間もなく木樵がすっかり逆上せて疲れてばたっと水の中に倒れてしまひますと、ゆっくりと立ちあがりました。",
              "citation": {
                "source": "土神と狐",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬屋のうしろのほうで何か戸がばたっと倒れ、馬はぶるっと鼻を鳴らしました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "土神はいかにも嬉しそうににやにやにやにや笑って寝そべったままそれを見ていましたが間もなく木樵がすっかり逆上せて疲れてばたっと水の中に倒れてしまいますと、ゆっくりと立ちあがりました。",
              "citation": {
                "source": "土神ときつね",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして硝子にはげしく頭をぶっつけてばたっと下へ落ちました。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬屋のうしろの方で何かの戸がばたっと倒れ馬はぶるるっと鼻を鳴らしました。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう種類のではたとえばたっつけ袴のカルサンというのがインドへんから来ているかと思うと、イタリアにも類似の名が出て来たりするのである。",
              "citation": {
                "source": "比較言語学における統計的研究法の可能性について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "文字で書けばたったこれだけの事である。",
              "citation": {
                "source": "映画雑感（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
