        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "婆羅門教は、ヒンドゥー教の源流となる古代インドの宗教思想だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大学で東洋哲学を専攻し、特に婆羅門教の思想に深く傾倒した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "婆羅門教の教えは、後のインド哲学や宗教に大きな影響を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
