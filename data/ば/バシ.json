          "literary": [
            {
              "text": "「馬歯今朝八十盈、回首志業一無成」と云ひ、又「臥痾恨欠拝新正、無奈衰躬負我情」と云つてゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年、馬歯｜蚤くも桑年に垂んとして初めておくびの出るを覚えたり。",
              "citation": {
                "source": "桑中喜語",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしはその時｜馬歯三十二歳であった。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは水馬歯を刻んで、それへ該里の酒を滴らせる。",
              "citation": {
                "source": "雪",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "其形は狭き牀机の如く、竹の大釘数十を植ゑ、少しくマングハ（馬歯把）に似たり。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
