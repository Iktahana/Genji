        "examples": {
          "standard": [
            {
              "text": "彼女のバースデーには、サプライズパーティーを計画して盛大に祝った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今年のバースデープレゼントは何がいいか、ずっと考えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「やったー！明日は私のバースデーだよ！早くプレゼント開けたいな。」と子供が跳ねて喜んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "素敵だった」「ハッピー・バースデー」「とても、とても」　Ｚランプの支柱から、ぼくは受話器をはずした。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、アマンドより一寸寄れといふ電話あり、レスアマへ寄ったら、バースデーケーキ一と、大皿にチキンなど盛りたるものをよこしたから大荷物。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "バースデーケーキを切って食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
