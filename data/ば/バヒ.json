  {
    "uuid": "b3b0d6a9-ea81-517c-9aca-741165c837d7",
    "entry": "場費",
    "reading": {
      "primary": "ばひ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その他に、工場費――九十六圓、男五人、女十人の出面賃。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "義雄が音樂倶樂部の入場費を自家から強奪したのはその日で、――渠が不愉快な心持ちで戻つて來た時、お鳥が同倶樂部へ伴はれて行く用意を濟まして、義雄の机に横ずわりにもたれ、むろ咲きのにほひ菫を頻りに鼻に當ててゐた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "原料代を回収することが出来れば、工場費も燃料も職人の給料も、全然見る必要がないという見解であった。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（勿論手数料も会場費も取らず、売り上げの総ては作家に進呈した。",
              "citation": {
                "source": "ヒウザン会とパンの会",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさか、役場費からでもあるまいと思って睨むと、やはりそうではない。",
              "citation": {
                "source": "瘤",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "役場費の八・一〇三という数字は吏員の給料や臨時手当である。",
              "citation": {
                "source": "瘤",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからわしはポスターでも、会場費でも何でも提供している。",
              "citation": {
                "source": "白い道",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "場所は、会場費を安くあげるため、サンフランシスコの黒人ゲットーのなかにあったフィルモア・オーディトリアムだった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に北海道に着して、仮りに札幌区外の山鼻の畑の内に一戸を築き、最も粗暴なる生活を取り、且つ此迄慣れざるの鎌と鍬とを取り、菜大根豆芋｜等を手作して喰料を補い、一銭にても牧塲費に貯えん事を日夜勤むるのみ。",
              "citation": {
                "source": "関牧塲創業記事",
                "author": "関寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "又一は入営兵の留主中たるも、先ず牧塲の無事に維持あるを謝すると、尚本年は無事に経過あらん事を祈ると共に、最も衣喰を初め仮令僅少にても節約を守り、物品金員を貯えて牧塲費に当てて、又一が無事に帰るの後には、更に幾分かの助けたらん事を日夜怠らざるなり。",
              "citation": {
                "source": "関牧塲創業記事",
                "author": "関寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
