          "literary": [
            {
              "text": "「バアバラ、」彼女は、呼鈴に應じて來た女中に向つて云つた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バアバラ、バタ付きのパンをもすこし貰へないの？",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　バアバラは、出て行つたが、すぐ歸つて來た。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私たちはこれで間に合せて置かねばならないんでせう、バアバラ。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
