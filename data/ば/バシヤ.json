        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "フルイ　バシヤ新美南吉　ムラヤクバノ　マヘノ　ヒロツパニ　フルボケタ　バシヤガ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コドモタチハ　コノ　バシヤノ　ソバデ　ヨク　アソビマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カクレンボノ　トキ、コノ　バシヤノ　ナカニ　カクレル　コガ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オニゴツコノ　トキハ　コノ　バシヤハ　ヤスミバト　ナリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナデ　バシヤヲ　ヒロツパヂユウ　ヒツパリマハス　コトモ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "バシヤハ　キリキリト、キシリナガラ　ヒツパラレテ　イクノデ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル　ヒ、ムラヤクバカラ　デテ　キタ　ソンチヨウサンガ　バシヤヲ　ゴランニ　ナリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コドモタチヤ、コノ　バシヤハネ、オマエタチガ　マダ　ウマレナカツタ　ジブン、マダ　ジドウシヤト　イフ　モノガ　ナカツタ　トキ、ムラカラ　マチノ　テイシヤバマデ　マイニチ　カヨツタ　モノダヨ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、オマエタチノ　オトウサンヤ　オカアサンタチハ　ヨク　コノ　バシヤノ　ゴオンヲ　ウケタノサ」　ソシテ　ソンチヨウサンハ　イヒツヅケマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トコロデ、ミレバ　モウ　コノ　バシヤモ　ズヰブン　フルボケテ　シマツタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、コハレナイ　ウチニ、ムカシ、コノ　バシヤガ　マイニチ　カヨツタ　カイドウスヂヲ　ミセテ　ヤツテ、ソレカラ　モヤシテ　シマツタ　ハウガ　ヨイト　オモフ」　コドモタチハ　ミナ　サンセイイタシマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　バシヤニ　フトイ　ツナヲ　ツケ、コドモタチハ　ソレヲ　エンヤ　エンヤト　ヒイテ　ユキマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "バシヤハ、キリクルト　ナリナガラ、カイドウヲ　ヒツパラレテ、イキマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カイドウニ　ソツタ　イエイエノ　ヒトタチハ、ムカシ　ジブンタチノ　ノツタ　バシヤガ　コドモタチニ　ヒカレテ　イクノヲ　ミルト、シゴトヲ　ヤメテ　オモテニ　デテ、バシヤヲ　ミオクルノデ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "余程此方の方まで来ても、それでもまだ船頭はバシヤバシヤ水をこいで船を押した。",
              "citation": {
                "source": "ある日の印旛沼",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "武は容赦なくグイと頭を引こませる、鱒どのも飛んだ粗相をしたと気がついて、食ひついた処をはなす其途端にバシヤリと音して、鱒は舟の中の擒となり升た。",
              "citation": {
                "source": "鼻で鱒を釣つた話（実事）",
                "author": "若松賎子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその水際のところでいきなりシャツをはぎとると、バシヤバシヤツと水洗ひをして、それを日に焼けた石の上に乾した。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　女の子は笑ひながら、バシヤバシヤ水をはね飛ばして行きます。",
              "citation": {
                "source": "プールと犬",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オウチカラ　　　バシヤガ　オムカヘニキテヰマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　オバシヤニノッテ、オウチヘ　カヘッテ　キマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
