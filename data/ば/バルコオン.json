        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして一同はロビーから六階の高い食堂へ移り変って、夕日に漲る海面を下にしたバルコオンで食事の支度を待つのだった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルコオンの欄干のところで、真紀子と千鶴子は皆から少し離れた位置に立ち、裾に微風のそよぐ忍び声で何事か話していた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事がすんでからそれぞれ、バルコオンよりの部屋へ移り椅子を変えた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルコオンの梯子は白い脊骨のように突き出ていた。",
              "citation": {
                "source": "花園の思想",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は急いでバルコオンを降りていった。",
              "citation": {
                "source": "花園の思想",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はバルコオンで、へんに胸がおかしくなった。",
              "citation": {
                "source": "花園の思想",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルコオンが濡れてゐる。",
              "citation": {
                "source": "寢たらぬ日記",
                "author": "湘南サナトリウムの病院にて",
                "note": "青空文庫"
              }
            },
            {
              "text": "來れば、第一にバルコオンへ連れて行かうと思ふ。",
              "citation": {
                "source": "寢たらぬ日記",
                "author": "湘南サナトリウムの病院にて",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
