    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "慶次郎は、いかにもその鷹やなにかが楊の木に嘴を引っぱられて、逆になって木の中に吸い込まれるのを見たいらしく、上の方ばかり向いて歩きましたし、私もやはりその通りでしたから、二人はたびたび石につまづいて、倒れそうになったり又いきなりバチャンと川原の中のたまり水にふみ込んだりもしました。",
              "citation": {
                "source": "鳥をとるやなぎ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶次郎はそれを両手で起して、川へバチャンと投げました。",
              "citation": {
                "source": "鳥をとるやなぎ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブン蛙とベン蛙がくるりと外の方を向いて逃げようとしましたが、カン蛙がピタリと両方共とりついてしまひましたので二疋のふんばった足がぷるぷるっとけいれんし、そのつぎにはたうとう「ポトン、バチャン。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ下の北上川の淵で、鱒か何かのはねる音が、バチャンと聞えただけでした。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブン蛙とベン蛙がくるりと外の方を向いて逃げようとしましたが、カン蛙がピタリと両方共とりついてしまいましたので二疋のふんばった足がぷるぷるっとけいれんし、そのつぎにはとうとう「ポトン、バチャン。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ下の北上川の淵で、鱒か何かのはねる音が、バチャンと聞えただけでした。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たらいが、バチャンといいました。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "どす黒い河の水が、バチャンバチャンと石垣を洗っていた。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎はこの頃はダッチャン（父さん）、アアチャン、オバチャン、みんないるので大満悦です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きいということが云えず、アッコオバチャンと云い、コの音の出しようをクの間のように喉音で出します。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎はカゼがなおって遊びに来て、「アッコオバチャン、おぽんぽが痛くなくなったらアボチャン、トシマエンヘツレテッテヤルヨ」と大いに慰めてくれました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッコオバチャン送りにゆくかときいたら行くと云ったということで両親ついて来た。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アボチンからも、アッコオバチャンのオジチャンに「よろしくって云ってね」の由。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな心配をして、お七夜さわぎをして、夜番をするのだからアッコオバチャンだって気もたつわ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（筆者註、アッコオバチャンは口だけ達者で困りますヨ！",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにいじらしいことには、小さい小さいのし紙を胸に下げて、そこに「アッコオバチャン」「ヤスコ」と書いた一寸ほどのもんぺをはいたコケシ人形が現れました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたらね、太郎はよほど感ずる処があったとみえて、次の日みんなの居るとき、真面目くさって「アッコオバチャン、今年の夏も病気するといいね、みんなが水瓜を持って来てくれるから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずっと私は其処に坐って、アッコオバチャンらしく、例えまざった御飯にしろ美味しいようにみんなによそってやっていたのよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎はアッコオバチャン！",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "おやと思っていると「アッコオバチャン、解除ですって！",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "温泉岳の熱湯ぜめといって、噴火口の熱湯へ縄にくゝってバチャンと落してひきあげ、また、落し、また、ひきあげる。",
              "citation": {
                "source": "二合五勺に関する愛国的考察",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "たった三四尺の流れを飛ぶのに全然足が上らず、引きずるようにバチャンと水中に落ちる驚きと絶望。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "たつた三四尺の流れを飛ぶのに全然足が上らず、引きずるやうにバチャンと水中に落ちる驚きと絶望。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　空に声を残して、折枝の肉塊が鞠の様にクルクル廻転しながら、バチャンと水煙を立てた。",
              "citation": {
                "source": "地獄風景",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
