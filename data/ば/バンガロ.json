        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ノラの棲むフランスタウンの瀟洒なバンガロウも白粉を落さなくてはならなかった。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "あすこら辺のちよつと高みに、バンガロオ風の家でも建てられたら、どんなにいいか知ら？",
              "citation": {
                "source": "夢",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "事務所は椰子林の中を切り拓いて建てた、草葺きのバンガロー風のもので、柱は脚立のように高く、床へは階段で上った。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "空地の真中から、草葺きのバンガローが切り拓かれた四方へ大ランプの灯の光を投げている。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋人は東洋暖地へ来てやっとバンガローのベランダ造りを思いついたようである。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "元町へ抜けて、バンガロオへ寄って、そこで十二時になるのを待った。",
              "citation": {
                "source": "ああ華族様だよ　と私は嘘を吐くのであった",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時にバンガロオを追い出されて、私達はさて、大方寝てしまった元町通りを、真直に徒歩で大丸谷へ向った。",
              "citation": {
                "source": "ああ華族様だよ　と私は嘘を吐くのであった",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論この建物もバンガロー以上であつた。",
              "citation": {
                "source": "芭蕉と歯朶",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンガロー風で、正面と横とに広い階段がついてゐる。",
              "citation": {
                "source": "日本ライン",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンガロー風で、正面と横とに広い階段がついている。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "瀟洒たるバンガロー風の家だ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時敬太郎は、果しのない広野を埋め尽す勢で何百万本という護謨の樹が茂っている真中に、一階建のバンガローを拵えて、その中に栽培監督者としての自分が朝夕起臥する様を想像してやまなかった。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はバンガローの床をわざと裸にして、その上に大きな虎の皮を敷くつもりであった。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "碧い海に沿った、遠くに緑の半島が霞み、近くには赤い屋根のバンガロオが、処々に、点在する白楊の並木路を、曲りまわって行きました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "この日、両将は木留の本営に居たのであったが、急を聞いて部下三四百を率い、馳せ来って、吉次越の絶頂の凹んだ処に木と草とで忽ち速成のバンガローを造って、悠々と尻を落ちつけて、指揮したと云う。",
              "citation": {
                "source": "田原坂合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな事が評議、研究されているうちに、間もなく正午過ぎになると、又々異様なものが、このバンガローの中から次から次に発見されて、係官たちを面喰らわせた。",
              "citation": {
                "source": "Ｓ岬西洋婦人絞殺事件",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反してお庭の隅の常春藤に蔽われたバンガロー風の小舎には燈火がアカアカと灯って、しきりに人影が動いている。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ところで、このガラドウは、そんな類ひの所業が寧ろ仕事であつて、今では、山を越えた隣り町に住む私の叔父の屋敷つゞきの桃林の中にバンガロウ式の館を建てゝ、美しい妾を囲つてゐる。",
              "citation": {
                "source": "バラルダ物語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「東京の郊外に早速――ヴエランダつきのバンガロウを借りるとしよう。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはこの四月頃のことで、二人は、フォニックス市北二丁目の小さなバンガロウにいました。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "地方民で暇も多いのだろう、アリゾナ名物のカウボウイやなどが、わんわん詰めかけて来て、恐怖に口を開けて、小さなバンガロウを取り巻いている騒ぎ。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "今までのように、朝起きると窓を開けて、櫟林を眺めたり、バンガロの美しい娘さんのピアノを聞いたりと云う風な、そんな訳にはゆきませんでしたが、夕方窓を開けると、低い街の灯がキラキラして、秋らしい街の風景が、まことに眼に凉しく、大都会に住んでいるほこらしさが胸に来ました。",
              "citation": {
                "source": "清修館挿話",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "古ぼけて、いまにも朽ちてしまひさうなバンガロ風の板敷の廣間で、女達は辨當をひらいた。",
              "citation": {
                "source": "ボルネオ　ダイヤ",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の屋敷はご料林の麓、酒井男爵の別墅から半町｜距った林の中にあった、それは瀟洒たるバンガロー式の小窓の多い建物で外見は寧ろ貧しかったが内部の装飾の燦然さは眼を驚かすばかりであると町の人達は云っていた。",
              "citation": {
                "source": "温室の恋",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンガローの横手まで歩いて行くと広い後庭の中央に可成り大きな温室が夕陽に硝子屋根を反射させて秋霧の中に横倒わっていた。",
              "citation": {
                "source": "温室の恋",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名な、カリフォルニア・バンガローはもちろん、堂々としたギリシァ風の柱廊を張り出した二階建、ムーア式の華麗なアーチで装った家。",
              "citation": {
                "source": "南路",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
