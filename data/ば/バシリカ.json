        "examples": {
          "standard": [
            {
              "text": "イタリアの広場に面して建つ古いバシリカは、その壮麗な建築様式で訪れる人々を魅了している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "教科書に載っていた初期キリスト教時代のバシリカを実際に目にして、その歴史の重みに感動した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "礼拝堂の奥には、バシリカ特有の美しいモザイク画が鮮やかな色彩を保ったまま残されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それが、バシリカ風の僧院建築などによく使われる石灰石なんだが、当然永い年月の間に風化されているだろうからね。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名なバシリカ合唱団もモーツァルトの『アヴェ・ヴェルム』とハイドンの『天地創造』の一節を入れている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
