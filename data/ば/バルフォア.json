        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「サモア史」の完結で、愈々、「デイヴィッド・バルフォア」に専念できる。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（尤も、割に良く読まれているというから不思議だが）「デイヴィッド・バルフォア」こそは「マァスタア・オヴ・バラントレエ」以来の作品となり得よう。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月××日「デイヴィッド・バルフォア」漸く快調。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月××日「デイヴィッド・バルフォア」漸く仕上。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デイヴィッド・バルフォア」に就いては、大体満足。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デイヴィッド・バルフォア」の校正刷、未だに送って来ない。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃彼のことを戯れにデイヴィ（バルフォア）と呼ぶことにしている。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カトリオーナ」（デイヴィッド・バルフォアの改題）の方が不評で、あんな作品の方が売れるなどとは、皮肉だが、兎に角余り絶望しないで二番芽生を待つことにしよう。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルフォアは世界大破滅の荒涼たる光景を描いてほぼ次のごとく述べている。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわんや、この恐るべきバルフォアの自殺的真理をばいかにして奉ずることができよう。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "前首相バルフォアの如きは二、三種の哲学書を著している。",
              "citation": {
                "source": "教育の目的",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に英國では、この問題が尤も憂慮せられて、バルフォア（Balfour）やラクーペリ（Lacouperie）の如き學者は、前後してロンドンの『タイムス』紙上に、英國の外務省が支那政府に交渉して、この碑を英國博物館に引き取るべしといふ希望を披瀝した（39）。",
              "citation": {
                "source": "大秦景教流行中國碑に就いて",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
