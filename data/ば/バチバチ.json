    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこらの豆屋で、豆をばちばちと焼く匂が、雨を蒸して、暖かく顔を包む。",
              "citation": {
                "source": "妖術",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……俎の上に目の下およそ一尺の鮮鱗、ばちばち飜るのに、襷も掛けない。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "霧　昨宵は夜中枕の上で、ばちばち云う響を聞いた。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばちばちと音立てて、赤褐色の火焔が昇ったが、低く這ってすぐ無くなってしまった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "引き上げる時に、ばちばちっとはねるのは、鮒や鯉や鮠だ。",
              "citation": {
                "source": "霧の中",
                "author": "――「正夫の世界」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですからその手をたたく音は溌々と霰の降り乱れるごとく、戦場における鉄砲がばちばち響いて居るようなふうに聞えて居る。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらはまぶたをばちばち動かすだけで、わたしたちがしつっこく検査するままに任せていた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあいだにも――だいぶ小歇みにはなって来たが――ばちばちと、小銃の音はきこえてくる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばちばちと、枯れ草を焼く火や、萱の吐く黒い煙が、その剣をくるむ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、藺を敷いた床に人も見えず、ただ大きな炉の中に、ばちばちと松薪が燃え、その煙は、一つの窓からむうっと外へ吐き出されてくる。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "西の丸あたりも北曲輪にも炎は見え、附近の木々までばちばちと火の音をはぜて真っ赤な棒と化しかけている。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
