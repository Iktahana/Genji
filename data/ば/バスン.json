        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "百合　おなぶり遊ばすんでございますものを。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのね、母様がおなくなり遊ばしたのを、御近所に居ながら鳴物もいかがな訳だって、お嬢様が御遠慮を遊ばすんでございますよ。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……気に入りゃ、かっぱらって嬶にするし、いやになりゃポイポイ売ッとばすんだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひゅうひゅうひゅう、ひゅひゅう、降らすんだよ、飛ばすんだよ、なにをぐずぐずしているの。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "砕いちまへ、砕いちまへ、はね飛ばすんだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "砕いちまえ、砕いちまえ、はね飛ばすんだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひゆうひゆうひゆう、ひゆひゆう、降らすんだよ、飛ばすんだよ、なにをぐづぐづしてゐるの。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧券で買い占めて置いて、新券になったら、読みもしないで、べつの古本屋へ売り飛ばすんだ」「なるほど、一万円で買うて三割引で売っても七千円の新券がはいるわけだな」「しかし、とてもそれだけの本は持って帰れないから、結局よしたよ。",
              "citation": {
                "source": "郷愁",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「だつて、何の企謀を遊ばすんではなし、主のある方だと云つて、たゞ夜半忍んでお逢ひなさいます、其のあの、垣根の隙間を密とお知らせだけの玉章なんですわ。",
              "citation": {
                "source": "艶書",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――御免蒙る――」「それでも、おなぶり遊ばすんですもの、私は辛うございます。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとうに中洲からお運び遊ばすんじゃあ、間に橋｜一個、お大抵ではございませんよ。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "二「ははははは、旨くやりましたね、（ほんとうに中洲からお運び遊ばすんじゃあ間に橋一個、お大抵ではございません。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも、単に本線との連結点の軌条を布設し、そこに以前のように転轍器を装置しさせすればすんだのだ。",
              "citation": {
                "source": "臨時急行列車の紛失",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっしゃ無筆だから、先生も師匠も和尚もねえが、だんなはそうはいかねえ、物がお違いあそばすんだからね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血の降るへや",
                "note": "青空文庫"
              }
            },
            {
              "text": "二丁たアだれとだれが乗るんですかい」「きさまとお公卿さまがお召しあそばすんだよ」「…………※」「何を考えているんだい。",
              "citation": {
                "source": "右門捕物帖",
                "author": "へび使い小町",
                "note": "青空文庫"
              }
            },
            {
              "text": "お上御用でお乗りあそばすんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうの伝六様は品がお違いあそばすんだッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "袈裟切り太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "おひざもと育ちの八丁堀衆は、わざがお違いあそばすんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "子持ちすずり",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょいとひとなぞ遠まわしに店をひろげると、たちまちこのとおり、ものがおわかりあそばすんだからな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら尾州様がご三家のご連枝だからって、江戸へ来りゃ江戸の風がお吹きあそばすんだッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "この十手が啖呵をおきりあそばすんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきはうまいことこちらのかわいいあにいに一杯食わせたようだが、今度の相手はちっと役者がお違いあそばすんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬をつり出すためのえさですかい」「おいらが召し上がるんだよ、いただきいただき武鑑を繰って、ここと眼がついたら風に乗ってお出ましあそばすんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「買うては引き合はん、どうせ、直ぐ賣り飛ばすんぢやから。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            },
            {
              "text": "お妾さんを沢山いつも貯金みたいに貯めといて、競馬のときになると売り飛ばすんだって。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は不思議なかおをして、「おひな様でございますか、何に遊ばすんでございます」「何故もって来て呉れないのか、私は死んでしまうから」　こわいきびしい調子で云ったので女は気味をわるがって西の対へ使に行って間もなく美くしいひなを持って来た。",
              "citation": {
                "source": "錦木",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「へえ若い御夫婦って――　どこへお家を御建て遊ばすんでございます？",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "登るんだ、レークサイドへとばすんだ」　というのです。",
              "citation": {
                "source": "死者の権利",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
