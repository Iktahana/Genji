          "literary": [
            {
              "text": "なかで気のきいたせんせいたちが、バタパンご持参で、やってきていましたが、それをそばの人にわけようとはしませんでした。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ああ、また始まったね」と、その監視人は言い、バタパンを蜜の壺に浸した。",
              "citation": {
                "source": "審判",
                "author": "DER PROZESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「赤羽君、このバタパンを食って見給え。",
              "citation": {
                "source": "凡人伝",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてクレエテルヤアン氏は、コオヒイを――コオヒイとバタパンを求めた。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬車を降りると、コオヒイとバタパンを取り寄せたが、大いに呆れた顔をしていた。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前におれのバタパンを半分やろう。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
