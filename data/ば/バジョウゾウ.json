        "examples": {
          "standard": [
            {
              "text": "仙台の青葉山公園には、伊達政宗公が勇ましく馬にまたがった有名な馬上像が建っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "広場の中心にある馬上像は、この街を救った英雄を記念して百年前から設置されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夕日に照らされた馬上像のシルエットが、街の歴史を物語るかのように荘厳に浮かび上がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "後世、伝承された“尊氏馬上像”はこのときの彼の奮戦像であるという。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "著名な尊氏の馬上像はほぼ彼の実写にちかいのであるまいか。",
              "citation": {
                "source": "随筆　私本太平記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
