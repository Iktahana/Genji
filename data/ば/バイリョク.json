        "examples": {
          "standard": [
            {
              "text": "車のブレーキには、ドライバーの踏力を倍力する装置が組み込まれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この電動工具は、内部のギアで倍力を発生させ、硬い材料も簡単に切断できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "重い扉を開けるには、倍力機構を備えたハンドルがあると楽だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そのうちに、客の一人が、武蔵の流儀について訊ね出し、二刀をつかうには、人一倍力量がなければなりますまいが、私のような力のない者にも、御流儀の修行ができましょうかと訊いた。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
