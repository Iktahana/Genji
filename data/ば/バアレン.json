          "literary": [
            {
              "text": "それから一哩程先に北に寄つてゐるアンバアレン群島があります。",
              "citation": {
                "source": "うづしほ",
                "author": "A DESCENT INTO THE MAELSTROM",
                "note": "青空文庫"
              }
            },
            {
              "text": "北海道のように、バアレンで、広く、裏の方へ入ると、シュロが二本、原始的に生えて居る崖の下に、一面町の人家の灯が見える。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その経糸に十六世紀ロンドンの汚物、野蛮性を習性として持ち、その緯糸に「タンバアレン」の光彩や「ヴィナスとアドニス」の技巧に熱狂的な愛着を持つ、そういう頭脳の織物というものは、いったいどんな種類のものだったであろう。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
