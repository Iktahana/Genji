        "examples": {
          "standard": [
            {
              "text": "その研究は、固有のバイアス（偏見）があるとして批判された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "意思決定をする際には、自分自身のバイアスを認識することが重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "メディア報道には、明確な政治的バイアスが見られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "心から　トバイアス・グレグソン「グレグソンは、スコットランド・ヤード随一の切れ者だ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "第六章　トバイアス・グレグソンの手前披露　翌日の新聞各紙は『ブリクストン事件』と銘打ち、その話題で持ちきりだった。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで凡人なら新聞広告を出して情報を待ったり、知り合いが何か申し出てくるまで待つところですが、このトバイアス・グレグソンはちょっと違います。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらの意図にそってバイアスをかけるために、すべての歌詞をじぶんで訳している。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "神助の凪に艦泊てて月落ちかかるバイヤス灣、椰子の葉蔭に枕ぎて夢むは誰ぞ海南島。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャップばかりを問題にするとは少々滑稽だと、僕自身もおかしく思ったのだが、今度もニップ、ニッピーズを時々耳にして、バイヤス氏の随筆を思い出した。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
