        "examples": {
          "standard": [
            {
              "text": "お風呂から出たらバスローブで体を包み込む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "高級なバスローブは肌触りが柔らかく心地よい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "バスローブを着てリラックスの時間を過ごす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "姉の赤ちやんのバスローブを縫ひかけてゐますのもお休みにして、おひるからお邪魔に上らうかと存じます。",
              "citation": {
                "source": "火の点いた煙草",
                "author": "一名――煙草蒐集家の奇禍",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ最後ニバスローブヲ着セテクレテ、予ヲ寝室ヘ押シ込ンデカラ、自分ハ廊下ヘ出テ行ッテシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」要は妻が這入ったあとの風呂へ漬かって、湯上りの肌へバスローブを引っかけながら十分ばかりで戻って来たが、美佐子はその時もぼんやり空を見張ったまま機械的に爪をこすっていた。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
