          "literary": [
            {
              "text": "ここでは、12のクレープ・スゼット、13のバヴァロアの二種。",
              "citation": {
                "source": "富士屋ホテル",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "小松で理髪し、ホテ・グリで滝村と食事、トマトクリーム、フィレソール、鶏の煮たの、アスパラガス、コーヒー、苺のバヴァロア、八時帰宅。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュとミニツステーキ、バヴァロア。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆これを平げて、バヴァロア、デミタッセ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
