[
  {
    "uuid": "4f9015fe-ef1b-575c-abee-304f7db3e31d",
    "entry": "盤石",
    "reading": {
      "primary": "ばんじゃく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
