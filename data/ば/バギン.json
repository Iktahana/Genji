          "literary": [
            {
              "text": "台場築造はなかなかの難工事であるので、人足の手間賃も普通より高く、一日一朱という定めで、かのお台場銀を払い渡された。",
              "citation": {
                "source": "半七捕物帳",
                "author": "吉良の脇指",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのお台場銀を眺めているうちに、半七はふと何事をか思いついた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "吉良の脇指",
                "note": "青空文庫"
              }
            },
            {
              "text": "工塲銀行皆業を休みたり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            }
          ]
        }
