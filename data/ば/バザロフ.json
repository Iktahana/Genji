        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "バザロフなんて、甘いものさ。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「父と子」のバザロフといふ息子の立場も、彼れの思想的や、独在的な面白さよりも父と子を距てる「時」の激しい特殊な流れの方に、このごろ私は余計眼を向けて考へさせられるやうになつてゐる。",
              "citation": {
                "source": "時",
                "author": "鷹野つぎ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニコライ親爺にかうした愚痴をこぼさしたのは、あのバザロフといつた虚無主義者の新人であつた。",
              "citation": {
                "source": "喜光寺",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "バザロフとはまるで違ってはいるけれども……。",
              "citation": {
                "source": "『田舎教師』について",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "又『親々と子供』のバザロフなどもその一人である。",
              "citation": {
                "source": "ペチヨリンとゲザ",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オルガさんは、いつかバザロフのお話をなすったですね。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのツルゲネーフのバザロフの。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、バザロフはボルシェビーキじゃありませんよ。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗て読んだ書物の中のさまざまの人物までが次々に私を訪れた……　バザロフ！",
              "citation": {
                "source": "愛は、力は土より",
                "author": "中沢臨川",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由主義の思潮は、ツルゲネーフにバザロフを描かせた。",
              "citation": {
                "source": "現代小説展望",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "フローベルがボヴァリー夫人を書き、ツルゲネーフがバザロフを書き、イプセンがノラを書き、ブールジェーがロベール・グレルーを書いて、文学的ばかりでなく、社会的にも問題をひき起したのは、何も特殊な深遠な思想を披瀝したからではない。",
              "citation": {
                "source": "傍人の言",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツルゲネーフに於けるバザロフ然り。",
              "citation": {
                "source": "性格を求む",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "哲学的には範疇組織が文学の生きた側面だが、それと同様に、それに対応して、ハムレットやドン・キホーテ、バザロフやカルメン其の他等々の性格の創造が、文学的に云って文学的表象の価値だ。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "文芸作品の主人公にもかかる形の貴族の典型は極めて多い（例えばトゥルゲーネフのバザロフ、スタンダールのジュリアン・ソレルなどがそのやや近代的なタイプだ）。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい、バザロフ君、もう、観念して白状しろよ。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
