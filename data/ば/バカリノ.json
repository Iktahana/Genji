          "literary": [
            {
              "text": "ソシテ　シツカリト　カナヅチヲ　ニギリシメテ、コウババカリノ　マチヘ　マツスグ　アルイテ　ユキマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ君チャンヤ弟ヤ妹バカリノコサレテシマッタ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "音ハ耳ヲ聾スルバカリノグオーツトイフ音デ、生來之ニ比較スベキ音ヲ聞イタコトガナイ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「昨日ノ朝、妙ナ船ニ会イマシタ、三本｜帆檣ノ二千｜噸バカリノ奴デス。",
              "citation": {
                "source": "流血船西へ行く",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "信長公ノ御時ニサヘ、従ハザル諸所ヲ、カク僅カバカリノ間ニ、根来寺、雑賀、熊野山中、高野領ニマデ亘リテ、悉ク打チナビケ給フ、果断、決断ノ程、ヨク勘弁シテ見ルベシ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
