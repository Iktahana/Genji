        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」などと、まことに下手なほめ方をして外套を脱ぎ、もともと、もう礼儀も何も不要な身内の家なのですから、のこのこ上り込んで炉傍に大あぐらをかき、「ばばちゃは、寝たか。",
              "citation": {
                "source": "嘘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ばばちゃは、寝て夢でも見るのが、一ばんの楽しみだべ。",
              "citation": {
                "source": "嘘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいいちには、圭吾自身のため、またお前のため、またばばちゃのため、それから、お前たちの祖先、子孫のため、何としても、こんどのおれの願い一つだけは、聞きいれてくれねばいけねえ。",
              "citation": {
                "source": "嘘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、だいいちに圭吾のため、お前のため、ばばちゃのため、祖先、子孫のためだ。",
              "citation": {
                "source": "嘘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "些細なようなことで感心したのは、風呂を立ててもらうのに例えば四十一度にしてくれと頼めばちゃんと四十一度にしてくれる。",
              "citation": {
                "source": "家庭の人へ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "影が痣になって、巴が一つ片頬に映るように陰気に沁み込む、と思うと、ばちゃり……内端に湯が動いた。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "爪さぐりに、例の上がり場へ……で、念のために戸口に寄ると、息が絶えそうに寂寞しながら、ばちゃんと音がした。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばちゃん、……ちゃぶりと微かに湯が動く。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくして、境が、飛び上がるように起き直ったのは、すぐ窓の外に、ざぶり、ばちゃばちゃばちゃ、ばちゃ、ちゃッと、けたたましく池の水の掻き攪さるる音を聞いたからであった。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ばちゃばちゃばちゃ、ちゃッ。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "たかだか堰でめだかを極めるか、古川の浅い処で、ばちゃばちゃと鮒を遣るだ。",
              "citation": {
                "source": "海異記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "びしゃりびしゃり、ばちゃばちゃと、舷で黒いものが縺れて泳ぐ。",
              "citation": {
                "source": "半島一奇抄",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "糸七の気早く足へ掛けたバケツの水は、南瓜にしぶいて、ばちゃばちゃ鳴るのに、障子一重、そこのお京は、気息もしない。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬の蹄の底の砂利をふむ音と水のばちゃばちゃはねる音とが遠くの遠くの夢の中からでも来るやうに、こっち岸の水の音を越えてやって来ました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬の蹄の底の砂利をふむ音と水のばちゃばちゃはねる音とが遠くの遠くの夢の中からでも来るように、こっち岸の水の音を越えてやって来ました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小十郎が谷をばちゃばちゃ渉って一つの岩にのぼったらいきなりすぐ前の木に大きな熊が猫のようにせなかを円くしてよじ登っているのを見た。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それ訊いて、どないするちゅうネや」　さからっていると、もう炬燵のなかに、はいっていた君枝が、むっくり起き上って、「三味線もったはるおばちゃんやったら、乗らはった、乗らはった」　と、言った。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「此間のおばちゃん、うちへ来やはるのん？",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、おばちゃん」　君枝は飴でおぼえていた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
