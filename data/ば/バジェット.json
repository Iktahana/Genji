        "examples": {
          "standard": [
            {
              "text": "「今回のプロジェクトはバジェットが限られているから、広告費を大幅に削る必要がある」と上司が言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "バジェット旅行を楽しむコツは、格安航空券を利用して、宿泊費を抑えることにある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "制作費数億円という巨大バジェットを投じた映画だけあって、CGのクオリティは圧倒的だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そのスペースの奥にバジェットで借りたフォードのセダンが停めてあった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーケットに隣接して、エイヴィスやバジェットのオフィスがあるのを確認して、ぼくはステーション・ワゴンをマーケットの駐車場に入れた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
