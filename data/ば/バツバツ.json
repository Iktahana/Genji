          "literary": [
            {
              "text": "交代した書記の一人が朗読最中、苦しまぎれトッサの智慧で「我々はバツバツ主義の」というやいわぬに、　中止！",
              "citation": {
                "source": "文芸時評",
                "author": "――「ナップ」第三回大会にふれて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "と叫んで、とっさにバツバツと五、六歩、舞台袖の所まで飛退る喜造、突き出した抜身越しにすかして見る。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
