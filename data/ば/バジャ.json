        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ボート・デッキの上まで波が躍り上って、間を置いて、バジャバジャ、ザアッとそれが滝のように流れていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "川崎は身体を空でゆすりながら、雫をバジャバジャ甲板に落した。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "叢の葉に、今迄堪えていたような小便が、勢よくバジャバジャと当る音がした。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "――若い女でも、出口にそのまま蹲んで、バジャバジャと用を達した。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィクトリア公園の池でほっぺたのこけた顔色わるい子供達は玩具がないから脚で水をバジャバジャ蹴ったり、棒切れで仲間に水をはねかしたりした。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽笛を鳴らし、外輪をバジャバジャいわせ、湯気や煙を出し燈火を輝かして汽船は勢よく過ぎて行く。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
