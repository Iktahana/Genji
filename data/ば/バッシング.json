        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その政治家は、国民からのバッシングに晒された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はネットでのバッシングに耐えられず、SNSを閉鎖した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "過度なバッシングは、人権侵害につながる可能性がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "潮風がベトつくし、ねむくなるし、おまけにマック・セネットのバッシング・ガールみたいなのが横行濶歩して、マック・セネットのバッシング・ボーイみたいなのと、ふざけ廻るし、とにかく宜しくないです。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇　バッシング・ガールにはおどろいた。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "読みも読んだりバッシング！",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "所が、どうやら、バッシング・ガールという言葉が出来てしまったらしい。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
