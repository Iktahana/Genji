        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「バーカ、あんな音楽をかけると思ってんのか。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「バーカ、起床放送やるんだぞ――レコードがいるに決まってるだろうが！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちがう」「じゃ、ウサギ跳びか」「バーカ、ちがうよ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "トモ子は、慶一にぺこりと頭をさげてから、高志にむかって舌を出し、またバッグをふりまわしたが、こんどは高志もこころえていて、ひじでブロックし、バーカ、と笑う。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「バーカ」「ちがった？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしかじゃなかったから、おまえに、バーカっていわれたら、教えてくだせえまし、になってたとこだぜ」　と、また笑う。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "――バーカーヤーロー。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩人クーパーの生れたバーカムステッドという小さい村を通るといかにも古い家々が太い材木の骨を壁の上に露出して、屋根瓦は苔で青くなって居り、前庭にはダフォディルや、名前は知らないが紫の美しい草花などが咲き出していた。",
              "citation": {
                "source": "シェイクスピアの郷里",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八二九年には、ガラスの研究の結果について、バーカー記念講義をなし、翌年に研究を終って報告を出した。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "バーカー教授はその「支那及宗教」なる書に於て、この碑文に見えたる唐人の名は、皆實際史上の人物たることを證言せり。",
              "citation": {
                "source": "弘法大師と景教との關係",
                "author": "イー、エー、ゴルドン",
                "note": "青空文庫"
              }
            },
            {
              "text": "半分以上は商業施設となっており、レストランが置かれており、バーカウンターが併設される形である。",
              "citation": {
                "source": "鉄道模型の夜",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バーカ団長は寝ている。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "近くの広場にテントを張って、今日二回公演する予定だ」「バーカ団長を起こしに行け」　ウィルキンソンが命令した。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "ど派手な服を着た大男が階段に立っており、レスブリッジが直感的に認めて対面したのがバーカ氏、大日本帝国サーカスの団長、屋根に掲げた大広告によれば、欧州国の様々な首都を何回も公演している。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "バーカ団長がレスブリッジを胡散臭そうに見て、ぞんざいに要件を尋ねた。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどい事故ですか」第二十七章　ババ　バーカ団長は知らないという。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご親切にしていただいてありがとうございます」　バーカ団長がひどい葉巻を吸いながら言った。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "詳しいことはこのビラをご覧あれ」　バーカ氏が大げさに喋りまくったが、女はさも聞き飽きたかのように微笑んでいた。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "たぶん珍芸以外の何物でもないのだろうが、旅芸人の団長が一座の悪口を言うわけはないし、バーカ氏もその例に漏れない。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "けが人は僕の友人でして、様子を見に来ました」　女が怪訝そうにバーカ団長を振り返り、完璧な英語で言った。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かお手伝いしましょうか」　バーカ団長がぶっきらぼうに言った。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまバーカ団長にお世話になっています」「会わせてください。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーシを追い出してちょうだい」　バーカ団長があけっぴろげに愚痴った。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "ババが中に消えると、バーカ団長が葉巻を投げ捨て、ぶっきらぼうに言うことに、朝飯前に仕事があるから、医者が来るまでここにいるつもりなら、お前は自分で楽しみを見つけたらええ。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "さもなきゃバーカ団長が大騒ぎしないし、豪華な専用幌馬車も与えない。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時点でバーカ団長が登場し、最敬礼して言うことに、皆さん方は失望するかもしれないが、状況を勘案してどうか大目に見ていただきたい。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "態度や言葉が余りにも激しかったので、バーカ団長がキレて、場内が興奮してきた。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "何人か若い男がやじり始めるや、すぐさま、バーカ団長がお静かにと頼んだ。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "警部は今やバーカ団長側に立って戦った。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "団長、武器を持ってないか」　バーカ団長が首を激しく振った。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
