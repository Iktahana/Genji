          "literary": [
            {
              "text": "ホテ・グリで一人、フィレソールとシャムピニオンのオムレツでバタライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテ・グリへ一人で行き、大急ぎで、サリズベリ・ステーキとバタライスに、スチュウ・コーン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあと、タンシチュウ、マッシュドポテト、バタライスと行き、雨やんだ中をタクシー帰宅。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サントリーハイボール二、チキン・キエフスキーのバタライス添。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "リゾールパイから、タンシチュウ、マッシュポテト、バタライスを食ひ、サントリーハイボールを又二三杯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "チキンクリーム、バタライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "平目のグラタン、チキンの挽肉のスフレ（スフレと言ってたのが、かまぼこみたいになってしまった）、チキンのフリッターにバタライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンシチュウ、バタライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペルメニーと、タンシチュウ、バタライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サントリータンサン、チーズトースト、伊藤にお任せの、ビーフ・ミニツステーキ風、バタライス、マッシュポテト添。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
