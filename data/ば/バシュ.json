        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "疲れきったようなバシュバシュという音がきこえる。",
              "citation": {
                "source": "人を殺す犬",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃、ルバシュカを着た、頭に禿のある豆蔓のやうに脊丈のひよろ／＼した中年の彫塑家が編輯してゐた。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルバシュカは三日にあげず「奧さん、五十錢貸して貰へませんか」と人の手前も憚らないほど、その男も貧乏だつた。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもそのルバシュカは、長い腕を遠くから持つて來て環を描きながらゴールデンバットだけは燻してゐた。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は堪りかねて、さりげなくルバシュカに近寄つて行き、彼の吐き出すバットの煙を鼻の穴を膨らまして吸ひ取つては渇を癒した。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルバシュカが晝食の折階下へ降りた間を見計つて、彼は、編輯室に鼠のやうにする／＼と走つて行つて、敏捷くルバシュカのバットの吸さしを盜んだ。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルバシュカは爪楊枝を使ひながら座に戻ると煙草盆を覗いて、「怪つたいだなあ、吸さしがみんななくなる、誰かさらへるのかな。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の良いルバシュカは別に圭一郎を疑ぐる風もなかつたが、圭一郎は言ひあらはし難い淺間しさ、賤劣の性の疚しさを覺えて、耳まで火のやうに眞赤になり、背筋や腋の下にぢり／＼と膏汗が流れた。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "數日の後、ルバシュカは無心が度重なるといふので、二人の子供と臨月の妻とを抱へてゐる身の上で馘首になり、圭一郎は後釜へ据ゑられた。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当の「マリア・バシュキルツェフの日記」はここにあります。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは、「マリア・バシュキルツェフの日記」に目をとおしながら、一人の女としてのマリアは全然理解しなかった。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、ここで要約しながらもほんものの、「マリア・バシュキルツェフの日記」を紹介したいと思う。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリア・バシュキルツェフは一八六〇年の秋、南ロシアのポルトヴァで生れた。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロシア風にいえば、彼女はマリア・コンスタンチノヴァ・バシュキルツェヴァと呼ぶのが本当である。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてマリア・バシュキルツェフの千五百頁にわたる日記は、次の一頁から始められた。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マリア・バシュキルツェフの日記はここで終っている。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローザ・ボヌールの「馬市」の絵だの、「出あい」という作品を残して二十四歳の生涯を終ったマリア・バシュキルツェフ。",
              "citation": {
                "source": "ケーテ・コルヴィッツの画業",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウオバシュ街に帽子店を営っていた細君が死んだ後、その商売を小金に換えて、傍目には呑気に、が、本人は些か無聊を持て余し気味で、ぶらぶら日を送っていたアンドルウ・ヘルグラインだった。",
              "citation": {
                "source": "斧を持った夫人の像",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　五月二十九日　〔市ヶ谷刑務所の顕治宛　目白より（封書）〕　五月二十九日　小雨　　第十五信　きのう、二十五枚ほど「マリア・バシュキルツェフの日記」について書き終って、それを届けて、国男寿江と落合って、市ヶ谷へ行って夜具をとって来ました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリア・バシュキルツェフの日記の面白さは、一つの特徴ある個性が境遇の封鎖を破って、どうにかして人間らしく人間の中に生きようとした、その真摯な格闘にあるのである。",
              "citation": {
                "source": "まえがき（『真実に生きた女性たち』）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月二十八日（金曜）「マリア・バシュキルツェフの日記」二十五枚『新女苑』五月二十九日（土曜）〔発信〕第十五信を出す。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとは師範学校の学生で職業的な泥棒であり、ひどい肺病になっているバシュキンは新顔のゴーリキイに向って雄弁に吹き込んだ。",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーリキイは屡々泥棒のバシュキンやけいず買いのトルーソフなどとカザンカ川を越えて野原へ、灌木の茂みの中に入ってゆき、いかがわしい彼等の商売のこと、更にもっと頻繁に、生活の複雑さについて、人間の関係の不思議な縺れ合いについて、何よりも多く女について話しながら、飲んだり食べたりした。",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニャ　こんなに蒸暑い日だというのに、わが大先生は外套を召して、オーバシューズをはいて、コウモリを持って、手袋まではめてござる。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギーユミノー、フォア、バシュリューの三個師団はそこに殺到し、ほとんどレイユの全軍団がそこに使用されて、そして失敗した。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "バシューさんの話では、この前の週に騒動があったとさ、あのー……何とか言った……そう、ポントアーズにさ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の人たち、たとえばバシュキルツェフにとっては中心的な経験であって著述の性格を決定するものであった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "女将には息子がいて、「バシュの乗務ヒン」なのだという。",
              "citation": {
                "source": "盗聴者",
                "author": "Ａ. ブラックウッド　A. Blackwood",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
