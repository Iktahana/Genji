        "examples": {
          "standard": [
            {
              "text": "「バイオハザード」は、世界中で人気のサバイバルホラーゲームシリーズだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はホラーゲームが好きで、新作の「バイオハザード」を予約して発売を楽しみにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "映画版「バイオハザード」は、ゲームとは異なるストーリー展開でファンを驚かせた。",
              "citation": {
                "source": "Illusions AI",
