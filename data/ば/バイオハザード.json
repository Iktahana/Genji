        "examples": {
          "standard": [
            {
              "text": "実験室では、バイオハザードの危険があるため、厳重な安全管理が求められる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "廃棄物にはバイオハザードマークが貼られ、適切に処理された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "未知のウイルスが発生し、緊急でバイオハザード対策チームが派遣された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
