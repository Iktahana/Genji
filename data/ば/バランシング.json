          "standard": [
            {
              "text": "チーム全体のパフォーマンスを向上させるために、メンバー間のタスクバランシングが重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しいビジネスモデルでは、収益とコストのバランシングが課題となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は片足立ちで体のバランシングを試みた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "これらと聯関して舶用のタービン・ロートルのダイナミカル・バランシングの問題に興味を引かれた。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらのバランシングに関する各種多様の研究は皆三菱研究所で行ったものである。",
              "citation": {
