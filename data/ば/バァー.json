          "literary": [
            {
              "text": "バァーンとシンバルを叩いたような感じである。",
              "citation": {
                "source": "闇の絵巻",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "級長の、大きいがさつな娘が、強いカムバァーランド訛りで怒鳴りながらやつて來た――「ヘレン・バーンズ、あんた、行つて抽斗の中を片づけて、お仕事をたゝまなけれや、私、スキャチャード先生に云ひつけて、見に來ていたゞくわよ！",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（それらの声をかき消すように機関のエキゾーストと、バァーと鳴りひびく汽笛。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
