          "literary": [
            {
              "text": "バカレーエフの持家なんで……」「ああそれはヴォズネセンスキイ通りだ」とラズーミヒンがさえぎった。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "バカレーエフの家もこの男が教えてくれたので……」「レベジャートニコフ？",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中がサモワールを持って、台所から廊下を通って行くのを、僕ちゃんと見たんだから……とにかく、僕は拝顔の栄を得なかったよ……」　かっきり九時に、ラズーミヒンはバカレーエフの下宿を訪ねた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは早くもバカレーエフの下宿近くまで来ていた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はもうバカレーエフの下宿の入り口まで来ていた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきほどバカレーエフの家の玄関口まで行き着いた時、ふと心の迷いが起こったのである。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はルージンより先に行きつこうと、バカレーエフの下宿へ急いだ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはラズーミヒンが世話をした例のバカレーエフの持家の中の貸間である。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
