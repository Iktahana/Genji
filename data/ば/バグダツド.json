          "literary": [
            {
              "text": "菓子屋のドロツプやゼリビンズは點描派の畫布の樣だし、洋酒瓶の竝んだ棚はバグダツドの祭の樣だ。",
              "citation": {
                "source": "太郎と街",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の日の夕暮れ、バグダツドの一つの井戸は、町の女達の水汲みで一頻り賑つてゐました。",
              "citation": {
                "source": "三つの指環",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "（談話）※　　　　　　　一　バグダツドの或モスク（寺院）の前です。",
              "citation": {
                "source": "三つの指環",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　バグダツドの市場の噴き井の上には大きい無花果が葉を拡げてゐます。",
              "citation": {
                "source": "三つの指環",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "商人　「バグダツドの町に住んでゐるものは誰でもわたしの家を知つてゐます。",
              "citation": {
                "source": "三つの指環",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
