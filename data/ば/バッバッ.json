        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その内も手を休めず、ばっばっと赤い団扇、火が散るばかり、これは鮮明。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも夜行のときで汽車が野原を走っていると、ときでもない列車が向こうからも火を吐き笛を吹いてばっばっやってくる。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩くごとにかわいている地面から、バッバッとほこりが舞い上がって、裾をまみれさせた。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから右手を空に振り、「臨、兵、闘、者、皆、陳、烈、在、前」――バッバッと九字を切ったのである。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙太ザッと横に払って兵藤を一、二歩飛びさがらせて置いて、返す刀を構えもせず、ツツと吉村の方へ付け入るなり、くさび形にバッバッバッと斬り込んで行く。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と叫んで、とっさにバッバッと五、六歩、舞台袖のところまで飛退る喜造、突出した抜身越しにすかして見る）喜造　おう、やっこ、待てっ！",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙太ザッと横に払って兵藤を一、二歩飛びさがらせておいて、返す刀を構えもせず、ツツと吉村の方へつけ入るなり、くさび形にバッバッバッと斬り込んで行く。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
