        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "芝原広く、梅樹雅趣を帯びて、春はさこそと思われる。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "水枯れし小川の岸に幾株の老梅並び樹てり、柿の実、星のごとくこの梅樹の際より現わる。",
              "citation": {
                "source": "小春",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅樹千章、雪裡今に春を占む。",
              "citation": {
                "source": "常磐の山水",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の前方平坦なる園の中央は、枯れた梅樹の伐除かれた後朽廃した四阿の残っている外には何物もない。",
              "citation": {
                "source": "百花園",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅樹が主として渓流に沿うた地に在る所を以て観れば、梅の特性はこんな土地を好む者と見て差支えは無かろう。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その藤村が今では大磯の土に親んで、記念の梅樹の下にその魂を寄せている。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "薫々たる微風が梅樹の林をしのんでくる。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかし山縣有朋氏の何かであつたと聞いたが、梅樹の下であいさつしたとき、何か中華の美人畫を想ひ出したことである。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
