        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その頃の友人の中には George Darwin も居たが、違った方面の友では Arthur Balfour すなわち後の首相バルフォーア卿と親交を結んだ。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これより先、一八六九年にロンドンで彼の学友アーサー・バルフォーアの二人の姉妹エリーノア（Eleanor）とイヴリン（Evelyn）とに紹介され、その後しばしば出遭う機会があった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八七一年の五月にイヴリン・バルフォーアと婚約し、七月十九日に結婚式を挙げた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてアーサー・バルフォーアの近頃求めた No. 4 Carlton Gardens に落着いた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "病後の冬休みにはイタリアへ転地し、フロレンス近くのバルフォーア家の別荘に落着いた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーサー・バルフォーアは手紙で彼を激励した。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "義兄弟のバルフォーア、当時のアイルランド政務総監がターリングへ遊びに来た時は護衛の警官が十二人もついて来たりした。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "上にも述べた通り、至極怪しい獣でインドにも産すれば（バルフォールの『印度事彙』二）いよいよ仏典の飛狸はコルゴと考定さる。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "エジプト人はその肉を乾かし水に和し飲んで下痢を止むとあるから（『大英百科全書』巻三、リンドレイの『植物界』第三板三六一頁、バルフォールの『印度事彙』第三板一巻、二二および二七六頁）、猴麪包の功遥かに存否曖昧の猴酒に優る。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "南方先生｜件の名歌を訳するに苦しみ、かれこれ思い廻らす内、また見付かったから犬寺の話に再追加するは、インドのマーラッタ王サホは五十年という長い間在位して、一七四八年にわれ掛かる処を救うた愛犬を埋めた場所という（バルフォールの『印度事彙』三版三巻四九〇頁）。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルフォールの印度百科全書三版四七八頁）　支那には春秋時代呉王闔閭の女藤王がすてきな疳癪持ちで、王が食ひ殘した魚をくれたと怒つて自殺した。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルフォールの『印度事彙』三板三巻）。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルフォールの『印度事彙』に人あり孕んだ牝虎を十七疋まで銃殺し剖いて見ると必ず腹に四児を持っていた。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "記録によると、ボーア戦争に反対していたロイド・ジョージが庶民院で英国のコミニュケを全部合わせればボーア国家に住むボーア人の総数以上に彼らを殺すことを主張していると発表した時、アーサー・バルフォーはすっくと立ち上がり「下衆！",
              "citation": {
                "source": "ナショナリズムについての覚書",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
