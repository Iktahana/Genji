    "definitions": [
      {
        "index": 1,
        "gloss": "scattered",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "強風で書類が薔薇薔薇になり、拾い集めるのに苦労した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "事件後、容疑者たちは薔薇薔薇になって逃走した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の話は論点が薔薇薔薇で、何を言いたいのかさっぱり分からなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "鼠色の印象（暴風雨前の富士山及び白峰山脈）　汽車の中は、蒸されるように混んだ、肘と肘と触れ、背と背と合された人々が、駅ごとに二、三人ずつ減る、はてはバラバラになって、最後の停車場から、大きな、粗い圏を地平線に描いて散った、そうして思い思いの方向へと往った。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドドーン、ドドーン、ドーン、バラバラ、ドワーン　小林の頭上に、丁度、彼自身の頭と同じ程の太さの、滅茶苦茶に角の多い尖った、岩片が墜ちて来た。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "かちゃんと落っこってバラバラに毀れた。",
              "citation": {
                "source": "御返事（石原純君へ）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなに雪片がくっつき合っているのはつまり寒気がさほどひどくなくて雪片が温まっているからなので、ごくごく寒い摂氏零度以下二十余度にもなるともはや雪片に湿り気がなく従ってみんなバラバラに粉のようになってしまう。",
              "citation": {
                "source": "雪の話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処動くな」　叫ぶと共に五名バラバラと桟敷より駈けて舞台へ飛び上った。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上のカットバック追い追い急激に物凄きスピードとなり、結局――　＝五郎蔵の家の表　バラバラと半次の一行、飛び込んで行く。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "＝五郎蔵の家の表　大吉と半次格子戸をガラリと開くと、　バラバラと五六人の通行人急ぎ、　走り去る。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然、バラバラと現れた五郎蔵一味が駕籠を囲んだ。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一同バラバラとお光を囲む。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一同バラバラと四散する、或る者は半次の家の中へ隠れる。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでゐて一度バラバラとやつて見なくては氣が濟まないのだ。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、何か、バラバラと脚にふれるものがあった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　彼の友達の中津が、まッさきに、侵入して掠奪した家は、十王殿に、バラバラの空骸となって残っていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い、闇黒の新しい天井から、つゞけて、礫や砂がバラバラッバラバラッと落ちて来た。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "担架に移す時、バラバラ落ちそうになった。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでいて一度バラバラとやってみなくては気が済まないのだ。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "満州問題、五・一五事件、バラバラ・ミステリーなどの騒然たる雑音はわれわれの耳を聾していたのである。",
              "citation": {
                "source": "北氷洋の氷の割れる音",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもわれわれはまだかの有名なバラバラ事件の解決以上の興味を刺激されることもなくて実にのんきにぼんやりしていたのである。",
              "citation": {
                "source": "北氷洋の氷の割れる音",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　小猿が、バラバラ、その辺から出て来て、草原｜一杯もちゃもちゃはせ廻り、間もなく四つの長い列をつくりました。",
              "citation": {
                "source": "さるのこしかけ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　小猿が、バラバラ、その辺から出て来て、草原一杯もちゃもちゃはせ廻り、間もなく四つの長い列をつくりました。",
              "citation": {
                "source": "さるのこしかけ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでこの原稿はバラバラになって職工の手に渡る。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの……蔵元屋の……アノ博多小町……」　そんなヒソヒソ話が急に途切れて皆、一時にバラバラと逃出しそうな身構えになった。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後桂はついに西国立志編を一冊買い求めたが、その本というは粗末至極な洋綴で、一度読みおわらないうちにすでにバラバラになりそうな代物ゆえ、彼はこれを丈夫な麻糸で綴じなおした。",
              "citation": {
                "source": "非凡なる凡人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいはまたあたり一面にわかに薄暗くなりだして、瞬く間に物のあいろも見えなくなり、樺の木立ちも、降り積ッたままでまた日の眼に逢わぬ雪のように、白くおぼろに霞む――と小雨が忍びやかに、怪し気に、私語するようにバラバラと降ッて通ッた。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの三つのもののどれか一つ欠けても他の二つはバラバラになります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "風が吹いて草の露がバラバラとこぼれます。",
              "citation": {
                "source": "貝の火",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
