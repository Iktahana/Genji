[
  {
    "uuid": "5a305d37-2a83-5b8a-a3a1-05551c0e2bf9",
    "entry": "薔薇薔薇",
    "reading": {
      "primary": "バラバラ",
      "alternatives": [
        "ばらばら"
      ],
      "is_heteronym": false
    },
    "grammar": {
