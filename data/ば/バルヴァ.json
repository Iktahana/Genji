        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「私は仙界のバルヴァというもの、むかしエマルは私に愛を与えました。",
              "citation": {
                "source": "約束",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "エマルは彼の側に来て「それはいけません」と言って、バルヴァの方に振りむいた。",
              "citation": {
                "source": "約束",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日から一年経ってまた此処に来て下さい」　そう言われてバルヴァは微笑した、そしてその一年の猶予をあたえて立ち去った。",
              "citation": {
                "source": "約束",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルヴァが再び訪ねて来てエマルを連れて行った日のたそがれ時、ケリルは草の露を瞼になすりつけ、榛やロワンの樹のほそ枝でより曲げられた杖を造った、そして蘆の笛をふく盲目の乞食になって、月の昇ろうとする頃出て行った。",
              "citation": {
                "source": "約束",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケリルがバルヴァとエマルのところまで来ると、バルヴァが言った。",
              "citation": {
                "source": "約束",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "若者はケリルが今までに見た美しい人たちの中の誰よりも美しかった、バルヴァよりも美しく、キイヴァンよりも美しかった。",
              "citation": {
                "source": "約束",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
