        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は幼い頃から馬事公苑に通い詰め、馬の世話から乗馬技術まであらゆることを学んできた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "日本の馬事文化を保存するために、伝統的な馬具の製作技術を継承する活動が続けられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "週末に開催される馬事イベントでは、ポニーの試乗会や馬術ショーが行われる予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「ついでに三上の伝馬事件も告発するつもりである」ことを、彼は告げた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "通例は森を避けて、猪鼻から、岡見、御岳、飛龍山、唐松、猿山などという部落づたいに龍巻村へ向うのが順当なのであるが、私は既に塚田村で遠回りをしたばかりでなく驢馬事件のために思わぬ道草を喰ってしまった後であるから是非ともこの森を踏み越えなければ途中で日暮に出遇う怖れがあるのだ。",
              "citation": {
                "source": "ゼーロン",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩年に夫としていたのは、彼の相馬事件――子爵相馬家のお家騒動で、腹違いの兄弟の家督争いであった。",
              "citation": {
                "source": "明治美人伝",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "今なれバ彼ユニヲンに左馬をのせ候ても宜かるべく、左馬事ハ海軍の事ニハ今ハ不幸者と雖ども、度※戦争致候ものなれバ、随分後にハ頼も敷ものとも相成候べしと楽居候。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年三月八日　高松太郎あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "関係者の中で現在生存している方もあるかも知れまへんので、全部仮名にさして頂きますが、三山という華族さんの家に起った事件でございまして、闇から闇に葬られましたものの、当時之が発表されていましたら、相馬事件以上に問題になったこっちゃろうと思うとります。",
              "citation": {
                "source": "黄鳥の嘆き",
                "author": "――二川家殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはさて、私は一昨日、お両人様と花馬事の一等賞を争いました「生きた花馬車」でございます。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "南風吹かば　――モンテ・カルロの巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺される晩　縁日で菊を買ひ剣花坊　おこの殺しや池田亀太郎事件や相馬事件の血腥い明治風景、「生首正太郎」や「閻魔の彦」や「山田実玄」や徒らに血糊沢山の書生芝居、さうしたものをへんに実感的におもはせて心魅かれる作品である。",
              "citation": {
                "source": "大正東京錦絵",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さようなら」　馬事は動きだした。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔母恨むというとも貴嬢怒るに及ばじ、恨む心は女の心にして、恨む女は愛ずる女なり、ただこの叔母を哀れとおぼさずや。",
              "citation": {
                "source": "おとずれ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その水兵ならばじゃ、何事も別に話は起らんのじゃ、諸君。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "久助君は、つまらなさうに、じやばじやばと音をさせてはいつてゐた。",
              "citation": {
                "source": "耳",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "開けばじつくり人に迫る。",
              "citation": {
                "source": "小町の芍薬",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、喜ばじと欲するも得ざるなり。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さればじゃ、方々様へ御願い申して頂いて来ては、飲んだにも、飲んだにも、大な芭蕉を葉ごとまるで飲んだくらいじゃけれど、少しも……」　とがっくり首を掉って、「験が見えぬじゃて。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さるにても卑怯なの、は、は、は、梅干で朝の茶まいれ、さらばじゃ。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学といえばじつのあることは少しも出来るはずなく、風景や女の人にみとれてくらしています。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「されば……」「いやさ、さればじゃなかろう。",
              "citation": {
                "source": "白金之絵図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらばじゃ」「あッ佐助様。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "待って」「この醜くさ、この恥かしさ、そなたの前にさらすのも、今宵限りじゃ」　さらばじゃと、大袈裟な身振りを残すと、あっという間に佐助は駈けだして、その夜のうちに、鳥居峠の四里の山道を登って、やがて除夜の鐘の音も届かぬ山奥の洞窟の中に身を隠してしまった。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "三町四方に蚤の飛ぶのも聴えるこの耳に、うるそうてならんわい」　と、言いざまに、煙の如く消え去り、さらばじゃという声は、遙か天井より聴えたが、それから毎夜乾の方に星の流れる頃には、必ず現われて、まず蝮蛇の頭をペロペロとくらったあと、鳥人の術の伝授に掛り、三年掛った。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらばじゃ」　と、いう声は、はや遙か嶺の上より聴えて来たが、その時の佐助は、既にその遙かの声が聴きとれるほどの、極意に達していたのである。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも後悔の背を焼かれる、その熱ささましたければ、まずうぬが眼をさまして、顔を洗うまえに、悪事の足を洗うがよかろう」　こじつけの、下手糞な洒落を吐くと、「――さらばじゃ」　東西南北、いずくとも知れず、姿を消してしまった。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらばじゃ」「あッ、先生！",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「楓どの、あの月を見やれ、綺麗な月ではござらぬか」「ほんに、十六夜の月はおぼろに鈴鹿山……」　と、楓がうっとりと歌いかけると、佐助は何思ったか急にそわそわして、「鹿の子まだらのアバタの穴を……」　照らしているのじゃと下の句を言いざまに、さらばじゃとはや駈け出してしまった。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐助よ、さらばじゃ」　どういう風の吹き廻しか、さんざん駄洒落たあと、先生の声はそこで途絶えて、暫らくの別れであった。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほのに汝を嗅ぎゆくここち、QURACIO の酒もおよばじ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "水晶の杯なぞ王侯の品も及ばじな。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（あら、可哀相に、おてんばじゃありません。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「洞斎の兄の身にして見ればじゃ、にい、この妹をつれて、女房が上京するといえばや、当分だけなと、くらしをつける銭金の用意をしていて、一緒に世帯をするものと思うたのが、そのしだら魂胆や。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギョオテ、シルレルの詩抄半ばじゆしてキョオニヒが通俗の文学史を繙き、あるはルウヴル、ドレスデンの画堂の写真絵、繰りひろげて、テエヌが美術論の訳書をあさりぬ。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
