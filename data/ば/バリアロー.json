        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その中の一人は「リリバリアロー（註五八）」を口笛で吹いていた。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "「リリバリアロー」もぴたりと止んだ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、彼等は何か命令されていたのであろう、元のところに静かに坐って、また「リリバリアロー」をやり出した。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "「リリバリアロー」はまた止んだ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "五八　「リリバリアロー」。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "「リアロー、リアロー、リリ・バリアロー」云々という畳句があるのである。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            }
          ]
        }
