          "literary": [
            {
              "text": "モウバツサンが一面、実際の方から、一面さういふ方から、あゝいふ末期を得たことなども、私は深い意味があると思つてゐる。",
              "citation": {
                "source": "脱却の工夫",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウバツサンも矢張さうだ。",
              "citation": {
                "source": "自からを信ぜよ",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "バツサ　バサバサと飛んで　あるく。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワツサリ・バツサリ、右左にゆれました。",
              "citation": {
                "source": "きんまくわ",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ろ袈裟にバツサリ、曲者は餘つ程の手利でせう」「それは大變」　石津右門も驚いた樣子ですが、事件には何の判斷もつきません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "城の繪圖面",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを、お神樂の清吉の野郎が、バツサリ縛つて行つたんだから、腹が立つぢやありませんか」「お前の手落ちだよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "梅吉殺し",
                "note": "青空文庫"
              }
            }
          ]
        }
