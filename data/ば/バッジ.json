        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "社員証として、毎日このバッジを身につけている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "イベントの参加者は、全員が特別なバッジを付けていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は子供の頃から、色々なバッジを集めるのが趣味だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "熊楠バッジ等エジプト学者の書を按ずるに、古エジプト人も古支那と同じく、竜蛇を兇物とばかり見ず善性瑞相ありとした例も多く、神や王者が自分を蛇に比べて、讃頌したのもある。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "『嬉遊笑覧』に言える通り鴨はアヒルだが、カモを鳬と書かず鴨と書き、近くはタヌキから出たタナテ、またよくこの獣を形容したラクーン・ドグなる英語があるに今もバッジャー（※、アナクマに当る）てふ誤訳を踏襲するに斉しく、今となっては如何ともするなし。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "けだしバッジの『埃及人の諸神』一巻二一頁に言えるごとく、狗頭猴のこの種は至って怜悧で、今も土人はこれを諸生物中最も智慧あり、その狡黠を遥かに人間を駕するものとして敬重す。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "バッジいわく、古エジプト人の『死者の書』に六、七の狗頭猴｜旭に向い手を挙げて呼ぶ体を画いたは暁の精を表わし、日が地平より上りおわればこの猴になると附記した。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちのバッジに三ツのＤがある。",
              "citation": {
                "source": "三つの愛のしるし",
                "author": "――自由・平等・独立の火をともす――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由と、独立と、平和とのためのデモクラシー、私たちが日本の独立と自由と平和のために求め闘っている人民的な民主主義のバッジである。",
              "citation": {
                "source": "三つの愛のしるし",
                "author": "――自由・平等・独立の火をともす――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは、すべてバッジを外して行動し、丹念に、各種の技術資料を収集していったそうである。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、すでに三十近かった、ぼく達のキャプテン整調の森さんでさえ、出発の二三日前、あるいかがわしい場処へ、デレゲェション・バッジを落してきたのです。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、バッジを悪所に落した事情をきくと、日頃いじめられているだけに、皆が笑うと一緒に、噴き出したくなるのを、我慢できなかったほど、好い気味だ、とおもいましたが、それから、暫くして、ぼくは、森さんより、もっとひどい失敗をやってしまったのです。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君、もう一度、君達の胸のバッジをみたまえ。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠慮なく、乗せて貰うと、目貫きの通りにドライブしながら、ぼくの胸にさした日の丸のバッジを見詰め、「俺は日本が好きだ。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "その癖、そのときでも、あなたが見えなくなると、バッジの件を考える苦しさよりもあなたを想う甘さに惹かれるのでした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日より、バッジの、「埃及文学史」を少しずつ書きぬき、参考書も加えてまとめる下拵えをし始める。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "バッジの Egyptian literature の中にあると同一のものもあり。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "道は胸に谷間の姫百合の花や、メーデーの赤い花、ズナチョーク〔バッジ〕をつけた人々で一杯だ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな犬のバッジも胸にそのままに、うすい唇には土がついている。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、日本の民主化の一つの表徴であり、現議員の果たした栄誉のバッジですらある。",
              "citation": {
                "source": "「焚書時代」の出現",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ママ薯におとらないナチ・マニアで、この前パリへ来たとき、カーキ色のユニフォームに、ＢＤＭ（ドイツ女子青年団）の〈三叉の物干棒〉のバッジをつけてルロンへ口紅を買いに行って、あっさりお断りをくったというトンチキだが、なんのつもりか鶴のように片足で立って、花束の間からあたしたちのほうを見ていた。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "右肩に大きなバッジをつけている。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しゃれたバッジですね。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "女も、年を取つて来ると、行く末の事を考へるやうになると見えて使ひいゝし、教祖も拾ひもンだと云つてゐる」　伊庭は新しい黒い服を着て、胸にひまはりのバッヂをはめてゐた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸に金色の三日月と日向草を組み合せた紋章を刻んだバッヂをつけてゐた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは車を徐行させてそれを見て通つてゐると、群集の中から二人の若い娘が出て來て、眞鍮の薄つぺらな小さい小劍型のバッヂを買つてくれとさし出した。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつを、めいめい、男はバッヂにしてシャツへつける。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "内部には係の者数名が、青年たち自らの手によつて撰びとられた、バッヂとブローチを、めいめいの胸につけてやる。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "係りの者が、いぶかつて、「あんたは、なんだね」「わしも、バッヂをもらふ資格がある」「しかし……」「年の制限はないはずだ」「青年といふことになつてゐますから……」「あゝ、心はいつまでも青年だ、早くつけてくれ」「どうしませう？",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見送りながら、伊賀倉は、バッヂを一つ取りあげて、自分の胸につける。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バッヂがないでしょう。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "辞表を受理した人事部長に、バッヂを返還しろと言われて、返したのです」「私、下北沢であなたを見かけたのよ。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
