        "examples": {
          "standard": [
            {
              "text": "二次会の席で、部長の独身時代の暴露話が飛び出し、会場は大爆笑に包まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "有名タレントの暴露話を期待して集まった視聴者たちは、放送の内容に釘付けになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "親友だと思っていた相手に、自分の暴露話を周囲に言いふらされて深く傷ついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "さっきの暴露話を考えれば考えるほど、こんがらかった。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペイン氏の甥であるあなたは、ある発見を巡って口論し、成果を横取りしたそうですね」　この暴露話は気になったが、いらいらしてきた。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            }
          ]
        }
