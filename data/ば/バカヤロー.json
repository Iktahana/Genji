        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「バカヤロー」　といって、慶一は開け放した戸口から部室に入った。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バカヤロー、でかい声だすな。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バカヤロー、恐くねえぞ！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえ、じぶんがすごくかわいい顔してるの、知ってるか」　高志の唐突なことばに、慶一は歯ブラシを吐きだし、「バカヤロー」　と、吹きだしながらいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この大バカヤロー！",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バカヤロー、腹うって、死んじまえ！",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バカヤロー、なにすんだよ」「ここは通路だぞ」　と警官のようなことをいって、大男が片手で慶一をかかえこんだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯ブラシを吐き出し、カメラにむかって、「バカヤロー」という口のかっこうをつくってみせる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんどん仕事がはかどるぜ」「バカヤロー」「えっ、なんだって、きたないことばは使わない方がいいよ」「だってそうじゃねえか。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "利口な人間からバカヤローを見ると……やっぱり皮肉がやりたくなる。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "電話で「バカヤロー」と怒鳴るというウソ、人にそんなことを云うだけ　横田をやめさせろと云いつつ横田には内密で、成人教育をやらせる。",
              "citation": {
                "source": "一九二七年春より",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリスの笑い話に、小説の第一行目から人の注意を惹くために「侯爵夫人はコン畜生のバカヤローと怒鳴った」と書けばマチガイなし、というのがある。",
              "citation": {
                "source": "敬語論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日トンパチ屋で会ふと向うから話しかけて文学の話を始めたから、バカヤロー、私は怒鳴つて帰つてきた。",
              "citation": {
                "source": "ぐうたら戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「信長はいくつだ」「十五です」「バカヤローの評判が大そう高いな」「噂ではそうですが、鋭敏豪胆ことのほかの大器のように見うけられます」「あれぐらい評判のわるい子供は珍しいな。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "落ち目の家をついだのは、いま評判のバカヤローであった。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに信長がバカヤローでも人に会う時は加減もしようから、誰に気兼ねもない時のバカヤローぶりを見物しようというコンタンであった。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは道三が大バカヤローの聟に見切りをつけて、バカの領地は遠からず道三の手中に帰するだろうと考えたのである。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "、無理なことをしたがる小僧だ」　道三は苦笑したが、さすがにバカヤローのやることは、バカヤローらしく快いと小気味よく思った。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オレのすぐ後が不二男の順であったが、まさか突然姿が掻き消えたわけではあるまい」「坂の途中で小便の様子だから通り越して来たんですよ」「バカヤロー。",
              "citation": {
                "source": "山の神殺人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "滋養の物を三度三度食べさせて、毎日欠かさず風呂へ入れて――」「ふやかすツモリかい」「バカヤローめ。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "人はなぜ催眠薬をのむか、といえば、このバカヤロー、ねむるためにきまッてらい、と叱られるだろうが、当今は乱世だから、看板通りにいかない。",
              "citation": {
                "source": "安吾巷談",
                "author": "麻薬・自殺・宗教",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり一つ、ぶんなぐって、「バカヤロー、兄貴はヒルネができなくって、怒っているぞ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつだって、そうしてもらッてるじゃないか」「いつも、そうで、わるかったな」「だまって、ついてくるがいいや」「バカヤロー。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、おそるおそる、「家内が姙娠八ヶ月で」　と云いかけると、「バカヤローめ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "天下の横綱になれるかも知れねえ」　そこで夜逃げ同然村をでて、東京へ行き、親方にたのんだところが、「このバカヤロー。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十四　ロッテナム美人術",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄弟子は二人ながらバカヤローだから、こッちへ順が廻るかも知れねえと考えている。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は久五郎を面罵して、「キサマはなんというマヌケのバカヤローだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はチョッコリ仲間にはいって貰いてもんだが」「バカヤロー。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "飛燕流開祖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
