          "literary": [
            {
              "text": "籠は、バスケットが訛って、バイスケと呼ばれている。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンは、同僚がバイスケ一杯満たす間に、かならず、三杯、入れた。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "武器は、雁爪、スコップ、六尺棒、バイスケ、素手、など。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "早くから、棚板やバイスケを積んで、金五郎の来るのを待っていたのだった。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "痛うも、痒うもねえとじゃ」「人間と思うちょらん」　大籠、モッコ、ロープ、バイスケ、などの置いてある、石炭でよごれた岸壁附近で、沖仲仕たちは、三々五々、しきりと、評定をする。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、歌え」　バイスケに見立てた朱塗の盆を持って、金五郎は催促する。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
