  {
    "uuid": "003e8c82-e680-5ffa-b4ee-38578ef09dd0",
    "entry": "蕃人",
    "reading": {
      "primary": "ばんじん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "例えば山出しの批評も時には三越意匠部の人の参考になるかもしれず、生蕃人の東京観も取りようでは深刻な文明批評とも聞える事があるかもしれない。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "台湾の蕃人に対しては、日本帝国主義のやり口は一層ひどかったのだ。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "強制的に蕃人の作ったものを徴発したのだ。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "潭水湖の電気事業工事のために、一日十五六時間働かして僅かに七銭か八銭しか賃銀を与えず、蕃人に労働を強要したのだ。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその電気事業のために、蕃人の家屋や耕作地を没収しようとしたのだ。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蕃人の生活は極端に脅かされた。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、 蕃人たちは昨年十月立ち上った。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、日本帝国主義は軍隊をさしむけ、飛行機、山砲、照明砲、爆弾等の精鋭な武器で蕃人たちを殺戮しようとした。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その蕃人征伐に使われたのも兵士たちだ。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "満洲や台湾の苦力や蕃人を動物を使うように酷使して、しこたま儲けてきた金で、資本家は、ダラ幹や、社会民主主義者どもにおこぼれをやるだろう。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その状南海諸島の蕃人にも似たるべし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを一種の不運とか奇禍とか言ってしまえばそれ迄であるが、マラリアに罹かったとか、蕃人に狙撃されたとか、水牛に襲われたとかいうのではなくして、彼が毒蛇のために生命を奪われたということが、何かの因縁であるように私の魂をおびやかした。",
              "citation": {
                "source": "深見夫人の死",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「裸頭跣足」は言ふ迄もなく、帽子も被らず、履も穿かない主義で、一口にいふと、日本人を生蕃人にしようとするのだ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "生蕃人を日本人にしようとするよりも、この方が寧そ近道かも知れない。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "『人類学雑誌』に、パプア人やヤミ蕃人が、以前出産の際母の腹を剖いて子を取り出したが、後に他所の女の山羊が、腹を剖かずに安全するを見て、その法を廃したと見えた。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚吉とヒョロ子は無茶病院に這入って、院長の無茶先生に会いますと、先生は髭もあたまも野蕃人のように長くのばして、素っ裸体で体操をしていましたが、二人の姿を見るとニコニコして裸体のまま出て来て、「ヤア、よく来たよく来た。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれのうちは貴様みたような生蕃人や、そんな片輪者なぞを泊めるようなうちじゃない。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ生蕃人の腰巻見たようなカアテンがブラ下って、その蔭に十五銭位の草花の鉢が置いてあれば、間違いない、文化住宅と云ってよろしい。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにこんな生蕃人見たいな爺に向つて、何を云つたつて仕方がないと思つたから、不精無精に道具を片附けて「チエツ！",
              "citation": {
                "source": "清一の写生旅行",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたかもこれは、ある地方に住む蕃人等が細く鋭い漁具の鎗を用意して、流水の中に動く魚を突きさす前に、先づ西瓜の類を坂にころがし、それを突きさす修業を積むの類であらうか。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私は思わず呻いたが、妖怪だと思ったその蕃人の、一番前にいた一匹が藪地からヒラリと飛び上がって喬木の幹へ抱き付きスルスルと梢へ昇るのを見て、それが妖怪でも蕃人でもなく思いもよらない類人猿の有尾人種であることを知った。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間も兇暴の有尾人種は蕃人特有の狡猾さをもって一歩一歩私達に近寄って来た。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は蕃人の襲撃や猛獣毒蛇の難を避けて長い日数を費したあげく、ようやく奥地までやって来たが有尾人種の影も見えない。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私娼、傀儡師、金剛砂売り、ふたなり、侏儒、吐蕃人、――そういう人々の群れであって、先頭に立って歩いているのは、鬼火の姥と範覚とであった。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに続いて踊り出したのは、韃靼服を着た吐蕃人で、わからない西域の蛮音で、吐蕃歌をうたって踊り出した。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――農民は野蕃人のような生活を強いられている。",
              "citation": {
                "source": "文芸時評",
                "author": "――「ナップ」第三回大会にふれて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "此は台湾の蕃人も持つてゐる信仰である。",
              "citation": {
                "source": "鬼の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "臺灣土民の中にも、阿里山蕃人は、神話の上に此樂土の名を傳へて居る。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            }
          ]
        }
