        "examples": {
          "standard": [
            {
              "text": "野球の試合では、キャッチャーの後ろにバックストップがあり、ワイルドピッチから観客を守る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このテニスコートには、ボールが外に出ないように高いバックストップが設置されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "バックストップのおかげで、ファールボールが客席に飛び込む危険性が軽減された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 2,
        "gloss": "protection at the rear",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
