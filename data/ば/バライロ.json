[
  {
    "uuid": "f8c8454a-22ce-55e9-91d9-130b25d2bd21",
    "entry": "バラ色",
    "reading": {
      "primary": "バラいろ",
      "alternatives": [
        "ばらいろ"
      ],
      "is_heteronym": true
    },
    "grammar": {
