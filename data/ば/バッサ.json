        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　と鰭をばっさり。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗髪の潰島田、ばっさりしてややほつれたのに横櫛で、金脚五分珠の簪をわずかに見ゆるまで挿込んだ、目の涼しい、眉の間に雲のない、年紀はまだ若いのに、白粉気なしの口紅ばかり、小肥して痩せてはおらぬが、幼い時から、踊が自慢の姿である。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "乾くと漕ぎづらいから、自分の前の処にある柄杓を取って潮を汲んで、身を妙にねじって、ばっさりと艪の臍の処に掛けました。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ま、ま、まさかに出ていったところをばっさりとつじ切りなさるんじゃござんすまいね」「江戸っ子にも似合わねえやつだな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "笛の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃ、みんなばっさりやられているんだな」「いいえ、それがちっとおかしいんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "きさまはこっちへ向いて死ね、おれもそっちへ向いて死のうと、相談してばっさりやられたわけでもあるめえからね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、分けまえは人数の多いより少ないほうがよけい取れるに決まっているんだからな、四人より三人で分けようと、金を受け取りにいったやつのけえりを待ちうけておって、まずひとり、ばっさり仲間をばらしたのよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも気づかず、一升ぶらさげて帰ってきたところを、ばっさり同じ一刀切りでばらされたのが、酒屋のほうからこっちを向いてのめっているあの浪人者さ」「ほんとうですかい」「知恵蔵が違うんだ、知恵蔵のできぐあいがな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "返り討ちになるにしても、一度はばっさりやる気になるんだからな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "生首の進物",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひょっとすると、ばっさりやって乗り逃げしたかもしれねえんだからね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いいえね、女が、女が、おくにめがね」「おくにがどうしたんだよ」「仁王門の前でばっさり――」「切り口は！",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえたちがこわがったその相手は、どこのだれだ」「ちくしょうめ、とうとうばっさりやりやがったんですかい。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "寮が壊される」「えっ、そうなのかさ」「ああ、ヘッケルもジャッケルもばっさりさ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを横合いからだしぬけにばっさりとやられてしまっちゃあ、わたくしの役目が立ちません。",
              "citation": {
                "source": "半七捕物帳",
                "author": "あま酒売",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいつはわたくしと違って、うしろ袈裟にばっさりやられてしまいました。",
              "citation": {
                "source": "兜",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その竹藪ががさりと云うかと思うと、何者か突然あらわれて小僧の持っている提灯をばっさりと切り落とした。",
              "citation": {
                "source": "半七捕物帳",
                "author": "青山の仇討",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺された郡兵衛は悪銭身に着かずで、持ち逃げの金はみんな道楽に使ってしまい、今では本郷辺の旗本屋敷の若党に住み込んでいて、その日は千駄ヶ谷辺の知りびとのところへ尋ねて行く途中、子供のみやげに柿を買っている処を、おのれ盗賊とばっさりやられたのですが、全く盗賊に相違ないのですから仕方がありません。",
              "citation": {
                "source": "半七捕物帳",
                "author": "青山の仇討",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あいつも亦ばっさりやられてしまった日にゃあ玉無しだ」　幸次郎を出してやった後、半七は又しばらく考えていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "新カチカチ山",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋敷の方でも面倒だと思って、一旦は幾らか握らせて帰して、あとから尾けて行ってばっさり……。",
              "citation": {
                "source": "半七捕物帳",
                "author": "新カチカチ山",
                "note": "青空文庫"
              }
            },
            {
              "text": "火事を逃がれても、夫婦が殺されちゃあなんにもならねえ」「浪士が斬り込んだのじゃあありますめえね」「おれも一旦はそう思ったが、侍ならば刀でばっさりやるだろう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "蟹のお角",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばっさりと垣にかかる袷の頃は、さまでに心を動かす縁ともならぬと油断する翌朝またばさりと落ちる。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのとおり、上洛して三月もたつかたたないうちに、ばっさり殺られてしまいましたよ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なるほど」　と、三五郎は、障子の方へ笠をやって、じっと眺めながら「血で御座ろうな」「左様、無残にも、頭から、ばっさり浴びせかけたと見えまする」「御下役を一人、その辻堂まで、拝借を御願い致したい」「かしこまりまして御座る。",
              "citation": {
                "source": "大岡越前の独立",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "（やにわにばっさり斬りつける）合爾合姫　（深傷を押さえてよろめきながら、夢みるような顔。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばっさりと倒れた髪。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからばっさり網を打ちに行くんだが、ま、そこの御用帳をおろして来い」　文次は壁にかかっている帳面を指さした。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "離れればばっさりだ。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを、ばっさりと唐竹割りというが、そのままに斬って下げた。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "お城普請やお屋敷なんぞを造らえる時に、秘密の抜け穴や秘密仕掛けの部屋をこっそり造らえて、愈々出来上がってしまうと外への秘密が洩れちゃならねえというんで、工作人夫を生き埋めにしたり、バッサリ首を刎ねたりするってことを聞いておりますんでね。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "めくらはお出入り按摩、若い奴も同じお出入りの小間物屋だそうでござんすが、こちらへお伺いしたからには、何もかも話せばいいのに、うっかり申しあげたら、御殿様にバッサリやられそうな気がしたんで、怕い怕いの一心から、ひた隠しに隠してひた逃げに逃げて帰ったんだそうですがね。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
