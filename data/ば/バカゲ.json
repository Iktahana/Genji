          "literary": [
            {
              "text": "そして、それには、なまじいに、心理の筋道を考え、計算をとゝのえてやるよりも、いっそデタラメなバカゲきったことをやらかして、偶然に賭ける方がたのしみだと思っただけだ。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "成行の程は判らないが、どうせバカゲタ結末にきまっている。",
              "citation": {
                "source": "お魚女史",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人にとって現代風俗が怪しくてバカゲて見えるのは当然だ。",
              "citation": {
                "source": "親が捨てられる世相",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな恐ろしい、不合理な、バカゲた事はない。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "稻子の方はバカゲている。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなバカゲタこと……自分の指環を詰めてきたのに、持ってかれてしまって！",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
