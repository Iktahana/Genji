        "examples": {
          "standard": [
            {
              "text": "ユーザーから報告された動作不良に対し、開発チームは速やかにバグ修正のパッチを配布した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "今回のソフトウェア更新の主な目的は、セキュリティの向上と細かなバグ修正だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "バグ修正のためにシステムを一時停止させたが、作業は予定通り30分で終了した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "『ＰＣＣ』には同様のバグ修正に関する手紙が、何通も寄せられてきていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリソンとアルブレヒトは何通も寄せられたバグ修正の手紙を前にして、タイニーベーシックの手作りプロジェクトにかなりの数の読者がついてきてくれたことを実感させられた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ＤＤＪ』の創刊号には、これまで『ＰＣＣ』に掲載してきたタイニーベーシックの自作に関する記事が再録され、テキサスの二人組による拡張版の、バグ修正済みソースコードリストが載せられた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
