        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "緊急搬送された患者のバイタルは、安定していることを確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "看護師は定期的に、入院患者のバイタルをチェックしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長時間のフライトでは、乗務員が乗客のバイタルに異常がないか注意を払う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
