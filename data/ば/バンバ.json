        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "draft horse",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この農場では、昔ながらに輓馬を使って畑を耕している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "祭りでは、重い荷物を乗せた荷車を輓馬が力強く引いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "輓馬の迫力あるレースは、多くの観客を魅了した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "運送店の前にはもう二台の馬力があって、脚をつまだてるようにしょんぼりと立つ輓馬の鬣は、幾本かの鞭を下げたように雨によれて、その先きから水滴が絶えず落ちていた。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "亡くなったカプルンツェフ老人は輓馬を五対も持っていて、町じゅうに荷馬車を出していましたが、婆さんもその稼業を継いで、馭者の取締りにかけては故人に劣らぬ腕前でした。",
              "citation": {
                "source": "女房ども",
                "author": "БАБЫ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしていかめしい目鼻だちをした農夫は、休めるので有がたがる輓馬を停めて、畝間に肥料も見あたらないのにお前さんは何をしているのか、と訊き、すこしばかり切り屑か、何でもよい少量のごみ芥類、あるいは灰や漆喰でもよいからほどこせ、とすすめる。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、五月晴れの麗らかに晴れた青空の下を、馬にも乗らぬ娘二人に案内されて、四頭の逞しい馬のいる馬小屋を見て――そのうち栗毛の馬だけは、今父親が乗って行って留守でしたが、もちろんこれらは、農耕用の輓馬ではありません。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "このなかでいちばんばかで、めちゃくちゃで、まるでなっていないようなのが、いちばんえらいとね。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「妙なばんばが出て来て、妙なじんまをずいて、ずいてずきすえた」これを翻訳すると「変な老婆が登場して、変な老爺をしかり飛ばした」というのである。",
              "citation": {
                "source": "生ける人形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このなかでいちばんばかで、めちやくちやで、まるでなつてゐないやうなのが、いちばんえらいとね。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは鼠色の軽装にばんばらの蓬髪を長く靡かせていた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "脅かすような父の顔も、歎くような母の顔も、怨むようなオッタヴィアナの顔も見る見る変って、眼に逼る難儀を救ってくれと、恥も忘れて叫ばんばかりにゆがめた口を開いている。",
              "citation": {
                "source": "クララの出家",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらあらかしこなぞと若々しい止め文句を使う年寄りのばんばあが、どこの世界にあるんですかい。",
              "citation": {
                "source": "右門捕物帖",
                "author": "因縁の女夫雛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんか、おれのこと、ばんばん撮ってなかった？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "○時に広瀬のばんばさんハ、もふしにハすまいかと存候。",
              "citation": {
                "source": "手紙",
                "author": "慶応元年九月九日　池内蔵太家族あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、扉が一杯に開ききられたとき、その薄明りの中から、法水は自分の眼に、眩み転ばんばかりの激動をうけたのだった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おりこうさんとてもがむしゃら、おりこうさん、いきなりばんばら藪へとびこむと、眼玉がポンポンひんむけた。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは仕事でばかりでなく、いつでも、またどんな場合でもいちばんばかげたことだ。",
              "citation": {
                "source": "審判",
                "author": "DER PROZESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここはどこなんだ」　あなたは頭の中で球体に叫ばんばかりに思念を送り続ける。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミは、それでも日本人か」　ヤブから棒に、日本人かときかれても、今さら、返事のしようがないから黙っていると、男は、今日の新聞を、ばんばんと叩きながら突き出して、「ここを見ろ。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "叫ばんばかりの気持で、私は祖母の袂を掴んでいましたが、ともかくその何代目かの主人の勘気に触れて、美しい腰元は責め殺されてしまいました。",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても十年以来、たえずせんぐんばんばのあいだを往来あそばし、あしたに一塁をぬきゆうべに一城を｜ほふられるおはたらきをなされながら、そのおいそがしいさなかにあってなおおくがたのおんおもかげを慕いつゞけていらしったのでござりましょうか。",
              "citation": {
                "source": "盲目物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俗に「ばんば」といわれる処だが、まわりは武家の小屋敷ばかりで町家はない。",
              "citation": {
                "source": "ひとでなし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小猿の前には、若い女が、これもまた、転ばんばかりの迅さで、見得もなく、駈けて行くのが見える。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おお」　燈りを見たので、門の辺りにさっきから佇んでいた常磐は、柴垣の外を転ばんばかり駈け巡って、「伯母さま！",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
