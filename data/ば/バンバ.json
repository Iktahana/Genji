[
  {
    "uuid": "f1875c0b-6c74-5f09-b133-c31b3b387a30",
    "entry": "輓馬",
    "reading": {
      "primary": "ばんば",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
