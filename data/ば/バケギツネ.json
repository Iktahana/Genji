        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それゆえ少しも魔物を恐れない、――たとえ化け狐であれ、化け狸であれ、その外何の化けであれ。",
              "citation": {
                "source": "ろくろ首",
                "author": "ROKURO-KUBI",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも中には花嵐オソメが化け狐にたぶらかされて石を運んだテンマツまで事こまかに覚えているというヒマ人もいくたりか居ってそれは三月十五日の夜、周信が失踪した日に当っていた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "町内の衆だつて、賀奈女の容貌と愛嬌と踊には感心し乍ら、腹の中ぢや化け狐だと思つてゐる。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "佛喜三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "町内の衆だって、賀奈女の容貌と愛嬌と踊には感心しながら、腹の中じゃ化け狐だと思っている。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "仏喜三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その化け狐の賀奈女が、毎日ぬけぬけと昼湯へ入って、年寄りの喜三郎を馬鹿にしたように、眼の前で大肌脱ぎになって化粧しているんだ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "仏喜三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
