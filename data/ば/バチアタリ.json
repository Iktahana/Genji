    "definitions": [
      {
        "index": 1,
        "gloss": "damned",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "そんな「罰当たり」なことをすると、本当に良くないことが起きるかもしれないよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "神社の賽銭箱からお金を盗むなんて、本当にか罰当たりな奴だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "食べ物を粗末にするのは罰当たりだと、子供の頃から厳しく教育された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それに対するスタンガスンの返事は聞き取れなかったのですが、相手はみだりに罰当たりなことを言い出して、雇われ秘書に過ぎない、指図できる立場にないことを連れに思い知らせました。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "旭遊廓は今の中村に移転したのだが、その当座、遊郭を飯の種として居た人たちは、この先どうなることかと蒼くなつたけど、観音様の御利益は、『刀刃段々壊』で、だん／＼よくなつたなどゝいふのは罰当たりな駄洒落かも知れない。",
              "citation": {
                "source": "名古屋スケツチ",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなに立派に聞こえたんなら、なぜ自分で行かないんだい、この罰当たり」「おや、僕が冗談を言うと思ってるんだね」「へん、それくらいのことはしかねないからさ、信心のことときたら」「きっとだから……」「うるさい」「よしよし、強情っぱり、勝手にするがいい。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリゴリイはフョードル・パーヴロヴィッチが少しも身にしみて感じないばかりか、いつもの癖で、罰当たりなことを言いだしたのを見て顔をしかめた。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ばかこけ、この罰当たりめが！",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "奴は赤っ恥と罰当たりだ」　小屋の横から泡立つ琥珀色の液体が噴出して流れてきたが、たちまち砂に吸い込まれてしまった。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いい態だ、いい態だ、罰当たりめ、こうなるのが己にはふさわしいんだ」「正さん、――正さん」　お紋はその有様を冷やかに見ていたが、やがて宥めるような調子で側へ寄った。",
              "citation": {
                "source": "お美津簪",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬鹿野郎、ばちあたり。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら血筋はつながっていなくとも、義理の甥をくびり殺すとは、ばちあたりでござります」「じゃ、おばあさん、何もかも見ていたのかい」「見ていたどころか、わたしの目の前で殺したんでございますよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちきしょう、このばちあたりめが、とうとうみつけたぞ。",
              "citation": {
                "source": "赤ずきんちゃん",
                "author": "ROTKAPPCHEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんてえばちあたりのいたずらをするんだ。",
              "citation": {
                "source": "こわいことを知りたくて旅にでかけた男の話",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "このばちあたりのけだものが、ねているあいだに、こいつのおなかんなかへつめてやるんだから。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、このばちあたりめ。",
              "citation": {
                "source": "ラプンツェル",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして、ばちあたりの魔法使いは、むごたらしく焼け死んでしまったのです。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そんなことはだめだって云ったでしょう、どうしておまえはそう懲りないの、女親だと思ってばかにするのもほどにしておくれ、かあさんがこんなに心配しているのがわからないのかい、ばちあたりな子だよ。",
              "citation": {
                "source": "ばちあたり",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僭上だよ、無礼だよ、罰当り！",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "両手にうけて捧げ参らす――罰当り……頬を、唇を、と思ったのが、面を合すと、仏師の若き妻の面でない――幼い時を、そのままに、夢にも忘れまじき、なき母の面影であった。",
              "citation": {
                "source": "夫人利生記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の罰当りな悪だくみそれ自身が、病勢を募らせる有力なる原因だったことは云う迄もない。",
              "citation": {
                "source": "勝敗",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉弥の病気はそうひどくないにしても、罰当り、業さらしという敵愾心は、妻も僕も同じことであった。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ破れカブレの罰当り仕事だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "野郎……元ッカラ本職だったかも知んねッテ皆、左様云ってッケンド……いつも仕事をブッタクリやがった癖に挨拶もしねえで消えちまった罰当りだあ。",
              "citation": {
                "source": "老巡査",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私どもは娑婆のアブク銭を掴んで喰う罰当りで御座います。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、これからまた清友亭へでも出掛けると仕様かな……」「罰当り奴！",
              "citation": {
                "source": "父の百ヶ日前後",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――夢の話をしてるのや、……お狐さまのことを、悪う云ふと、この罰当りめ、承知せんぞ」　老人は、急に威丈高になつた。",
              "citation": {
                "source": "大凶の籤",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――さア、お狐さま、どうど、お願ひ致しまつせ、……さア、早よ、お取り下さりませ、……や、いつもあんたが悪口云ふよつてに、罰当りな話やなア、見なはれ、お狐さまが、あつち向いて、知らん顔してはるわ」　老人の云ふ通りであつた。",
              "citation": {
                "source": "大凶の籤",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――この罰当りめ、この罰当りめ、こら、大凶云ふのは来年だけのことやあらへん、お前の一生が大凶やがな、……うちのおみくじにけちをつけやがつて！",
              "citation": {
                "source": "大凶の籤",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんちふ阿房どもぢやらう、その罰当りの独逸人どもあ！",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "「土竜の畜生が死んだら太鼓の皮にでも売るだあね、罰当り馬も太鼓にでもなつたら浮ばれるづらあな。",
              "citation": {
                "source": "夜見の巻",
                "author": "「吾が昆虫採集記」の一節",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖父と同様寄宿舎に来させまいする魂胆を感附いた父は、「俺でも悪いといふのか、われも俺の子ぢやないか、親を恥づかしう思ふか、罰当りめ！",
              "citation": {
                "source": "途上",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると父は「この罰当りめが」と叱りつけた。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
