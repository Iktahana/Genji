        "examples": {
          "standard": [
            {
              "text": "駅前の一等地でイベントを開催するとなると、莫大な場所代を支払わなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "路上で商売を始める前に、管理組合に場所代として手数料を納める必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "予算が限られているので、できるだけ場所代の安いレンタルスペースを探している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "すると、どこからともなく一人の女が切符をもって場所代を取りにくる。",
              "citation": {
                "source": "踊る地平線",
                "author": "テムズに聴く",
                "note": "青空文庫"
              }
            },
            {
              "text": "サイドメンの給料、場所代、広告費、税金、保険などを払ったのこりからキャッシュがギャランティの七万五〇〇〇ドルをとり、さらにそののこりの五〇パーセントが、キャッシュにいく。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
