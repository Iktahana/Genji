        "examples": {
          "standard": [
            {
              "text": "層を重ねて焼かれたバウムクーヘンは、木の年輪のようで美しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お祝いの席には、切り株の形をした大きなバウムクーヘンが用意された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ドイツ菓子専門店のバウムクーヘンは、上品な甘さでとても人気がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "戦前のジャーマン・ベーカリーは、独特のバームクーヘンや、ミートパイなど、他の店に無いものが揃っていた。",
              "citation": {
                "source": "甘話休題",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、此の店独特のバームクーヘンにしてからが、近頃では、土曜と水曜だけというようなことになって、わざわざそれを狙って行く人を失望させている。",
              "citation": {
                "source": "甘話休題",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在、バームクーヘンは、他にだって売っている。",
              "citation": {
                "source": "甘話休題",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
