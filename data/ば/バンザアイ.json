          "literary": [
            {
              "text": "イツテラツシヤイ、バンザイ、パパ、バンザアイ　私は微笑した。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の後援会の成績はあまり良くないけれど、それでも草庵だけは結べさうなので、いよ／＼川棚温泉に落ちつくことになつた、緑平老の諒解を得たから、一日も早く土地を借りてバラツクを建てなければならない、フレイ、フレイ、サントウカ、バンザアイ！",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後また街へ、だいぶ飲んだ、――まづＳ店で、それからＷ店で、さらにＮ店で、そしてＴ店で、――今日は一升近く呷つたらう、酔うた、久しぶりにいゝ気持になつた、それでもおとなしく戻つて来てすぐ寝た――善哉々々、山頭火バンザアイ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はまさしく転身一路だ、私もこんどはどうやらしんじつ落ちつけるらしい、バンザアイ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンス・ホールを三つも総上げにするなんて……白鷹君でなくちゃ出来ない芸当だぜ」「……白鷹君バンザアイ……」　と一人が筒抜けの大きな声を出したが、その男が朦朧たる酔眼を瞭って、両手を高く揚げながら立ち上ろうとすると、真先に私のいるのに気が付いたと見えて、ビックリしたらしく尻餅を突いた。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「浦和中学バンザアイ」「久保井先生バンザアイ」　もう汽車は見えなくなった、生徒はぞろりぞろりと力なく停車場をでた。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バンザアイ、浦中万歳」　総兵衛はありったけの声で叫んだ。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バンザアイ」　天地をゆるがすばかりに群集は叫んだ、この叫びがおわらぬうちにすぐにふしぎな喝采が起こった。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぷうぷうぽうぽう」「バンザアイ」　こうなってくると黙々隊は急に活気づいてきた。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあふしぎだ」「波があの大きな岩をこえて、船を砂浜へ運んでくれたのだ」「バンザアイ」　一同は思わずさけんだ。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「少年連盟バンザアイ」　いかだは川の右岸にそうてなめらかにすすんだ。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親はもううつとりと幸福さうな表情になつて、我が子の顔を眺め、「ほら、バンザイ、バンザアイ、やつてごらん。",
              "citation": {
                "source": "盂蘭盆",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女一同　　バンザアイ。",
              "citation": {
                "source": "富士はおまけ（ラヂオ・ドラマ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の教師　　バンザアイ。",
              "citation": {
                "source": "富士はおまけ（ラヂオ・ドラマ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の教師　　バンバンザアイ。",
              "citation": {
                "source": "富士はおまけ（ラヂオ・ドラマ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女一同　　バンバンザアイ。",
              "citation": {
                "source": "富士はおまけ（ラヂオ・ドラマ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジロ楽園バンザアイ……」　彼は両手を上げて、殺人鬼を祝福した。",
              "citation": {
                "source": "地獄風景",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
