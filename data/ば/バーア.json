          "literary": [
            {
              "text": "「バーア、廣ちやんこれ何あに」すると廣は泣き止んで、額を籠の格子にピツタリ付けた。",
              "citation": {
                "source": "犯罪",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バーゆうちゃん、バーア、行って来るえ。",
              "citation": {
                "source": "御身",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バーア、ゆうちゃんゆうちゃん、バーア、行って来るえ、バーア。",
              "citation": {
                "source": "御身",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがごく大体の気質の分け方ですが、カムの中にもマンカム（地名）もあればバーアもありツァルンもある。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            }
          ]
