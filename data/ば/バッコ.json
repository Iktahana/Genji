[
  {
    "uuid": "b85f7fa6-d60d-5227-b19f-e35885d8b38d",
    "entry": "跋扈",
    "reading": {
      "primary": "ばっこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
