        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "プレゼンテーションの準備はバッチリだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の今日のメイクはバッチリ決まっているね！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しいカメラの設定がバッチリ決まって、最高の写真が撮れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "でも、あたしのぶんなんて、あるのかしら」「もう、バッチリ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちゃんと撮れたのかよ」「バッチリ！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれの歌、もうバッチリ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "抜き合わせる間もなかったが、バッチリ柄頭で受け止めた。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "詰まっていた物が取れたようだ」　死骸の側へ寄って行き、死骸の袖で刀を拭い、バッチリ鞘へ納めてしまった。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてラケットと靴を持った両手をホンの一寸たたいたと思ったら、バッチリと生あたたかい手錠をかけてしまった。",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "バッチリ噛み切る歯音がした。",
              "citation": {
                "source": "銅銭会事変",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "取引き仲間にトバッチリをかけると、あとでたたられる。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長五　詰らねえトバッチリを喰うもんだ。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このトバッチリを喰って、皇帝の父君、すなわち第十一世維新王は十七歳の時に廃位されて南印度洋の孤島レユニオン島へ流謫され、今もって街頭でヴァイオリンの流し弾きをして、ようやく露命をつないでいるという惨状なんです。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "長五　つまらねえトバッチリを喰うもんだ。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
