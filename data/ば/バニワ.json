        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三　宿場の空虚な場庭へ一人の農婦が馳けつけた。",
              "citation": {
                "source": "蠅",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "農婦はうろうろと場庭を廻ると、饅頭屋の横からまた呼んだ。",
              "citation": {
                "source": "蠅",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　宿場の場庭へ、母親に手を曳かれた男の子が指を銜えて這入って来た。",
              "citation": {
                "source": "蠅",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして二｜間ほど離れた場庭の中から馬を見ながら、「こりゃッ、こりゃッ。",
              "citation": {
                "source": "蠅",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "農婦は場庭の床几から立ち上ると、彼の傍へよって来た。",
              "citation": {
                "source": "蠅",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　若者と娘は場庭の中へ入ってきた。",
              "citation": {
                "source": "蠅",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "場庭の草園では、霧の中で焚火が火の子を爆いて燃えていた。",
              "citation": {
                "source": "日輪",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
