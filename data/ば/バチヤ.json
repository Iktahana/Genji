          "literary": [
            {
              "text": "忽ち夜の暗闇の中に劇しい水煙が立つて、一人の兵士が小川の中にバチヤンと落ち込んでしまつた。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、右手でバチヤバチヤ水を叩いた。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主婦のお利代は、盥を門口に持出して、先刻からバチヤ／＼と洗濯の音をさしてゐる。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
