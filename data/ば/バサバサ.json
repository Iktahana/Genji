    "definitions": [
      {
        "index": 1,
        "gloss": "rustling",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "風が吹くたびに、落ち葉が地面でばさばさと音を立てる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "乾燥した草が、足元でばさばさと擦れる音がした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古い新聞紙が風に煽られ、ばさばさと舞い上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "わたしぁ、べらぼうめ、そんな苦情は、おれのとこへ持って来たって仕方がねえや、ばさばさのマントを着て脚と口との途方もなく細い大将へやれって、斯う云ってやりましたがね、はっは。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤茶けた、澤のない、ばさばさ髪、高い頬骨、肩掛をはづした女の顏は見違へる程痩せてゐた。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちっとばかりの土産物を持って半七老人の家をたずねると、老人は湯から今帰ったところだと云って、縁側の蒲莚のうえに大あぐらで団扇をばさばさ遣っていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに水平線の上のむくむくした雲の向うから鉛いろの空のこっちから口のむくれた三｜疋の大きな白犬に横っちょにまたがって黄いろの髪をばさばささせ大きな口をあけたり立てたりし歯をがちがち鳴らす恐ろしいばけものがだんだんせり出して昇って来ました。",
              "citation": {
                "source": "サガレンと八月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬はもりもりかひばをたべてそのたてがみは茶色でばさばさしその眼は大きくて眼の中にはさまざまのをかしな器械が見えて大へんに気の毒に思はれました。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トその壁の上を窓から覗いて、風にも雨にも、ばさばさと髪を揺って、団扇の骨ばかりな顔を出す……隣の空地の棕櫚の樹が、その夜は妙に寂として気勢も聞えぬ。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "背には綿の厚い、ふっくりした、竪縞のちゃんちゃんを着た、鬱金木綿の裏が見えて襟脚が雪のよう、艶気のない、赤熊のような、ばさばさした、余るほどあるのを天神に結って、浅黄の角絞の手絡を弛う大きくかけたが、病気であろう、弱々とした後姿。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お聞き、」と涙声で、枕も上らぬ寝床の上の露草の、がッくりとして仰向けの淋い素顔に紅を含んだ、白い頬に、蒼みのさした、うつくしい、妹の、ばさばさした天神髷の崩れたのに、浅黄の手絡が解けかかって、透通るように真白で細い頸を、膝の上に抱いて、抱占めながら、頬摺していった。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　その眼は闇のなかでおかしく青く光り、ばさばさの髪を渦巻かせ口をびくびくしながら、東の方へかけて行きました。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして日あたりのいい南向きのかれ芝の上に、いきなり獲物を投げだして、ばさばさの赤い髪毛を指でかきまわしながら、肩を円くしてごろりと寝ころびました。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同時に、林の中は俄かにばさばさ羽の音がしたり、嘴のカチカチ鳴る音、低くごろごろつぶやく音などで、一杯になりました。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、茶色のばさばさの髪の巨きな赤い顔が、こっちを見あげて、手を延ばしているのです。",
              "citation": {
                "source": "さるのこしかけ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思えばさばさばして別の事もなく普通の月日に戻り、毎日三時のお茶うけも待遠しいくらい待兼ねて頂きます。",
              "citation": {
                "source": "愛",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一筋の木目も無いばさばさした淡黄色いくぬぎの切り口には、わずかに汗の様な、うるおいが滲んで居るばかりであったけれど、ところどころに交る女松の木地などには、たらたらと赤黄色い脂が流れて居るのであった。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "芥溜を探したか、皿から浚ったか、笹ッ葉一束、棒切の尖へ独楽なわで引括った間に合せの小道具を、さあ来い、と云う身で構えて、駆寄ると、若い妓の島田の上へ突着けた、ばさばさばッさり。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「笹や、笹々笹や笹、笹を買わんせ煤竹を――」　大高うまい、と今呼ばれた、件の（鼬みめよし）が、笹をわざと、島田の上で、ばさばさと振りながら、足踏をして唱出した。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっちからも、こっちからも、ばさばさと遁出すわ、二疋ずつの、まるでもって蟷螂が草の中から飛ぶようじゃ。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして日あたりのいゝ南向きのかれ芝の上に、いきなり獲物を投げだして、ばさばさの赤い髪毛を指でかきまはしながら、肩を円くしてごろりと寝ころびました。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくたつと日が変にくらくなり、こまかな灰がばさばさばさばさ降って来て、森はいちめんにまっ白になりました。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "灰は風の吹くたびに木からばさばさ落ちて、まるでけむりか吹雪のようでした。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　その眼は闇のなかでをかしく青く光り、ばさばさの髪を渦巻かせ口をびくびくしながら、東の方へかけて行きました。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "初の烏　御前様、あれ……紳士　（杖をもって、その裾を圧う）ばさばさ騒ぐな。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三羽の烏、ばさばさと寄り、頭を、手を、足を、ふんふんとかぐ。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……籠に、あの、ばさばさ群った葉の中に、鯰のような、小鮒のような、頭の大な茸がびちびち跳ねていそうなのが、温泉の町の方へずッと入った。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓外、庭ノ黒土ヲバサバサ這イズリマワッテイル醜キ秋ノ蝶ヲ見ル。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "バサバサと凍った雪を踏んで、月光のなかを、彼は美しい想念に涵りながら歩いた。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝶子は白粉気もなく、髪もバサバサで、着物はくたびれていた。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "楢雄はやつて来て、寿枝の顔に、薄く白粉の粉が吹きだしてゐることよりも、髪の毛がバサバサと乾いてゐることの方を見て寿枝を千日前へ連れて行つて映画を見せたりした。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪の毛は油気もなく、バサバサと乾いていた。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "社長の妻君のバサバサした髪の毛の聯想で、母親のことが頭に泛んだからである。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
