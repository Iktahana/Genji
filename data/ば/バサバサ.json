          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長い髪を美容師がばさばさと切り落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は、不要な書類をばさばさとゴミ箱に捨てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "社長は会議で、これまでの慣習をばさばさと切り捨てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
