  {
    "uuid": "05c78d99-dac7-505e-8875-8708aed526d7",
    "entry": "バケ",
    "reading": {
      "primary": "ばけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
