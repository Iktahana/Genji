        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "マラソンランナーは、コーチの伴走を受けてペースを維持した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "自転車で伴走しながら、友人のウォーキングに付き合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は視覚障害を持つ友人の伴走者として、大会に参加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そのすぐうしろに右頬を斬られ大きなガーゼをあてて、ばんそうこうで十字にとめた田口巡査がついていく。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ゆびの　あちこちに　ばんそうこうを　はっていると　ともだちが　ふたりして　ばんごはんに　やってきました。",
              "citation": {
                "source": "つりびとジェレミーさんのはなし",
                "author": "THE TALE OF MR. JEREMY FISHER",
                "note": "青空文庫"
              }
