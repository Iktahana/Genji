  {
    "uuid": "e5f3f4f0-8247-540c-8c10-3d9f185e200b",
    "entry": "絆創",
    "reading": {
      "primary": "ばんそう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
