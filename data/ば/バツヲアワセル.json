        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "アリバイ工作のために、彼と口裏を合わせてばつを合わせることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "嘘がバレそうになり、咄嗟に支離滅裂な言い訳をして何とかばつを合わせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "証言に矛盾が出ないよう、事前に細かい設定まで決めてばつを合わせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "結局その場のばつを合わせるために、そうかといって聞いておけば、それですむような事柄なのだ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母までが端近に出て来てみんなの話にばつを合わせる。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな話題が出ても、いつでもそれに巧くばつを合わせることが出来た。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
