        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それで妙に氣が頽れて些とも氣が引ツ立たぬ處へ寂とした家の裡から、ギコ／＼、バイヲリンを引ツ擦る響が起る。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "返事は無くツて、バイヲリンの音がバツタリ止む。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところへ上手でもないバイヲリンをギコ／＼彈られるんだから耐らんね。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に俺が思索に耽ツてゐる時にバイヲリンを彈いたりなんかして………」「それは濟みませんでしたのね。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「私は貴方に無理にお願をしてバイヲリンの稽古までして、家庭を賑にしやうと心掛けてゐるやうな譯ぢやございませんか。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「其のバイヲリンがまた俺の耳觸になるんだ。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
