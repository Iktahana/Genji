[
  {
    "uuid": "3ba9ec9f-9fdf-5531-85f7-9a44c02f4d28",
    "entry": "博奕打ち",
    "reading": {
      "primary": "ばくちうち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
