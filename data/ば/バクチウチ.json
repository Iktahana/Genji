    },
    "definitions": [
      {
        "index": 1,
        "gloss": "professional gambler",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔ながらの博奕打ちは、勝負師としての誇りを持っていることが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの博奕打ちは、一度座ったら夜通し勝負を続けることで知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "映画では、クールな博奕打ちが主人公として描かれることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、妓は二月ばかり経つと疳つりの半という博奕打ちに落籍されてしまった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "博奕打ちに負けたと思うのである。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "引っ捕えてみるとそれは、その界隈で持てあまし者の博奕打ちであった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "博奕打ちは盗んだ米を町へ売りに行く途中、久し振りに身体を使ってクタビレたので、チョットのつもりで休んだのが、思わず寝過ごしたのであった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなことではいつになったら母親を迎えに行けるだろうかと、情けない想いをしながら相変らず通っていたが、妓は相手もあろうに「疳つりの半」という博奕打ちに落籍されてしまった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "博奕打ちに負けたと思うと、血が狂暴に燃えた。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、博奕打ちに特有の商人コートに草履ばきという服装の男を見ると、いきなりドンと突き当り、相手が彼の痩せた体をなめて掛ってくると、鼻血が出るまで撲り合った。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして、お客様が二人はいって来たんだ」　無頼漢でも博奕打ちでも、さすがに客商売の辰蔵は客に対して苦い顔をしているわけにも行かなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鷹のゆくえ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はむしろ博奕打ちとして世間から認められていた。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "次郎左衛門はもう博奕打ちとしては世間に立てなくなったのである。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "次郎左衛門は果たして博奕打ちをやめた。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "八橋があるとき彼の商売を訊くと、彼は野州佐野の博奕打ちで、三、四十人の子分を持っていると自慢らしく答えた。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "博奕打ちに喧嘩は付き物である。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "博奕打ちをやめたのも八橋の意見に基づいたのである。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "このお初は鰍沢の吉五郎という博奕打ちの妾でした。",
              "citation": {
                "source": "子供役者の死",
                "author": "岡本椅堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さもなけりゃあ博奕打ちだ」　清水山が魔所と恐れられているのを幸いに、一団の賊がそこを隠れ家にしているのか。",
              "citation": {
                "source": "半七捕物帳",
                "author": "柳原堤の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは博奕打ちの仲間がそこに入り込んで、ひそかに賭場を開いているのか。",
              "citation": {
                "source": "半七捕物帳",
                "author": "柳原堤の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥坊にしろ、博奕打ちにしろ、相手が大勢で袋叩きにでもされるか、あるい後日の難儀を恐れて、その口をふさぐために息の根を止められるようなことが無いとも限らない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "柳原堤の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おきんは兄貴と二人で暮していたんですが、その兄貴の寅松というのは博奕打ちの道楽者でしてね。",
              "citation": {
                "source": "半七捕物帳",
                "author": "春の雪解",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪い博奕打ちがいか物の賽を使うように、まかないがこの男の弁当箱には秘密の印を附けているなぞと云うものがある。",
              "citation": {
                "source": "食堂",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから今もなお役者、相撲取、博奕打ち、相場師、泥棒、芸妓、など一寸さきの気にかかる商売をするものに迷信家が多いようであります。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "尊徳の両親は酒飲みでも或は又｜博奕打ちでも好い。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に丹前を二枚重ねた、博奕打ちらしい男などは新聞一つ読もうともせず、ゆっくり蜜柑ばかり食いつづけていた。",
              "citation": {
                "source": "冬",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はとうとう控室へはいり、博奕打ちらしい男にお時宜をした上、僕の場合を相談した。",
              "citation": {
                "source": "冬",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時にまた博奕打ちらしい男も二三人の面会人と一しょに看守のあとについて行ってしまった。",
              "citation": {
                "source": "冬",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その方は、うち見るところ、ただの博奕打ちや、小泥棒ではない。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへきのうのように鬼どもがぞろぞろと博奕打ちにやって来た。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず博奕打ちかな」「えっへっへ、お眼がお高い、へへへへへ」　酒杯を中に笑い合っているところへ、「ここだろう」「ここだ、ここだ」「ここへはいったらしいぞ」　と表に当たって、にわかに人の立ち騒ぐ声。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "丹三が、折助部屋に集まっている小博奕打ちをまとめて跡を追う。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夜中にこいつを新墓から折り取ってきて祭っておきゃ、さいころの目が思うとおりに出るとかいうんで、昔からばくちうちがよくやる縁起物だよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
