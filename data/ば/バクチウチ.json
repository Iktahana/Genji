  {
    "uuid": "08d41d8e-a71e-5559-9e4e-12a6bb0190bf",
    "entry": "バクチウチ",
    "reading": {
      "primary": "ばくちうち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
