[
  {
    "uuid": "fbdf8524-5f29-5d17-b4d8-5d5003ff40e0",
    "entry": "バンギ",
    "reading": {
      "primary": "バンギ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "Bangui (Central African Republic)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "バンギは、中央アフリカ共和国の首都であり、国の中心的な都市だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "国連の平和維持活動部隊が、バンギの治安維持に貢献している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はバンギの大学で、現地の文化や歴史について研究している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それでもそのおかげでいろいろの植物を見たが、上の黒森では初めてオホナンバンギセルを採って、これを写生してきた。",
              "citation": {
                "source": "若き日の思い出",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンドの背後には巨大なパネルスクリーンが備え付けられ、白黒の昔の恐怖映画にカラフルなオリジナルのアニメーションがちぐはぐに編集されているという実験映画じみたアバンギャルドなフィルムが上映されている。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだからバンギ（肥前平島）と謂ったり、ヨサイギモン（下甑島）と謂ったり、ヨウマアサマ（伊豆新島）と謂ったりする。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
      "synonyms": [],
      "antonyms": [],
      "related": [
        "中央アフリカ",
        "首都"
      ]
    },
