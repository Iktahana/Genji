        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自分はさっそく新しい水をバケツに二はいくみ入れてやった。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は手に引つ越しの荷物をさげ、古ぼけた家具の類や、きたないバケツや、箒、炭取りの類をかかへ込んで、冬のぬかるみの街を歩き※つた。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが私のかみさんであり、その後からやくざな男が、バケツや荷をいつぱい抱へて、痩犬のやうについて行つた。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は手に引つ越しの荷物をさげ、古ぼけた家具の類や、きたないバケツや、箒、炭取りの類をかかへ込んで、冬のぬかるみの街を歩き廻つた。",
              "citation": {
                "source": "散文詩集『田舎の時計　他十二篇』",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "審判員がこぼれただけの水を補給しようとして、バケツを持つて追つかけて、打ちあけるのだが全部は入らないといふ風だつた。",
              "citation": {
                "source": "運動会の風景",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供は、そこで、おふくろが、どつかから貰ひ水してあるバケツに飛びつく。",
              "citation": {
                "source": "井戸の底に埃の溜つた話",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、それだけの作業、バケツを持っておりて、すべらぬようにもらさぬように、のぼって来る、それだけの作業を、夏の土用よりも熱い思いで汗をたらし、罐場を一足出るとすぐに、凍った便所の作業に移らねばならなかった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "波田は、その熱湯を汚物の壺の中へ注ぐやいなや、彼は棒もバケツもそこへ打ち捨てて置いて、サイドから、汚物の飛び出すスカッパーの活動の状態をながめに行く。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人で火の傍に駈け戻り、バケツでお池の水を汲んでかけていると、お座敷の廊下のほうから、お母さまの、ああっ、という叫びが聞えた。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、垣根の下の、用水の水を、リレー式にバケツで運んで、二、三分のあいだに消しとめて下さった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "細民街のぼろアパアト、黄塵白日、子らの喧噪、バケツの水もたちまちぬるむ炎熱、そのアパアトに、気の毒なヘロインが、堪へがたい焦躁に、身も世もあらず、もだえ、のたうちまはつてゐるのである。",
              "citation": {
                "source": "音について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴を讀め、鶴を讀めと激しい語句をいつばい刷り込んだ五寸平方ほどのビラを、糊のたつぷりはひつたバケツと一緒に兩手で抱へ、わかい天才は街の隅々まで駈けずり廻つた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴を読め、鶴を読めと激しい語句をいっぱい刷り込んだ五寸平方ほどのビラを、糊のたっぷりはいったバケツと一緒に両手で抱え、わかい天才は街の隅々まで駈けずり廻った。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "バケツに投げ入れられた二十本程の水仙の絵である。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "バケツで水を運んだり、監督の椅子を持って歩いたり、さまざまの労役をするのである。",
              "citation": {
                "source": "花燭",
                "author": "燭をともして昼を継がむ。",
                "note": "青空文庫"
              }
            },
            {
              "text": "バケツぐらいでは間に合いません。",
              "citation": {
                "source": "黄村先生言行録",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "水を汲みおわって、バケツを右の手に持って、そうしてよろよろと歩きだす。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "案のじょう買い物らしく、青扇は箒をいっぽん肩に担いで、マダムは、くさぐさの買いものをつめたバケツを重たそうに右手にさげていた。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　庭で遊んでいた七つの長女が、お勝手口のバケツで足を洗いながら、無心に私にたずねます。",
              "citation": {
                "source": "おさん",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "細民街のぼろアパアト、黄塵白日、子らの喧噪、バケツの水もたちまちぬるむ炎熱、そのアパアトに、気の毒なヘロインが、堪えがたい焦躁に、身も世もあらず、もだえ、のたうちまわっているのである。",
              "citation": {
                "source": "音に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨董屋は、今朝、戦線へ出動した山東兵が、雨傘を持ったり、石油罐の一方をくり抜いて太い針金を通したバケツをさげていた、と笑っていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒い土のような人間が、その下にころがっている頭蓋から脳味噌をバケツに掻き取っていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度、彼女は二階の縁側の拭き掃除が終って、汚れ水の入ったバケツを提げて立ったまゝ屋根ごしに近所の大きな屋敷で樹を植え換えているのを見入っているところだった。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もどしたものを母親が小さな玩具のバケツへ始末してゐた。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのバケツの色彩が妙に眼について今でも想出される。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "バケツ一つだけで弥生町門外の井戸まで汲みに行ってはぶっかけているのであった。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もどしたものを母親が小さな玩具のバケツへ始末していた、そのバケツの色彩が妙に眼について今でも想い出される。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ばけつ持つてお出で」井戸替への職人の親方はさう云つて、ずらりと顔を並べてゐる子供達の中で、特にお涌をめざして、それ等のさかなの中の小さい幾つかを呉れた。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ばけつ持ってお出で」井戸替えの職人の親方はそう云って、ずらりと顔を並べている子供達の中で、特にお涌をめざして、それ等のさかなの中の小さい幾つかを呉れた。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "火の玉め、悠々落着いて井戸端へまわって出て、近所隣から我れさきに持ち出した、ばけつを一箇、一杯｜汲み込んで提げたは可いが、汝が家の燃えるのに、そいつを消そうとするんじゃないんで。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
