          "literary": [
            {
              "text": "之レヲ途方モナキ一夫一婦制ニ對スル反逆ト考フルハ、恰モ政治的特權者ニ向ツテ叫バレタル政治ノ自由ヲ平等ナル國民間ニ脱線セシメテ、相犯サザル各自ノ自由ヲ蹂躙スルコトモ等シク政治ノ自由ナリト云フ低能者ノ昏迷ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "天道宣布ノ爲メニ選バレタル日本國民ハ將ニ天譴ニ亡ビントスル英國ノ二ノ舞ヲ爲サザルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ択バレタル霊魂ノ持主ハ、不運デモアッタガ、又、捉エラレルニ適シタホドノ脆弱性ト不安定トヲ持ッテイタ気ノ毒ナ人デアッタ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
