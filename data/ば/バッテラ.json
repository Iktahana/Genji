        "examples": {
          "standard": [
            {
              "text": "大阪名物のバッテラを初めて食べたが、とても美味しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お土産に有名店のバッテラを買って帰ろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "酢飯と〆鯖のハーモニーが絶妙なバッテラは、お茶漬けにしても美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
