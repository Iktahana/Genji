        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――バカヤロウ、アレハ、カンゴクジャナイカ！",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "冗談じゃねえよ」「じぶんで寮長にいえよ」「ちぇ、あのバカヤロ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バカヤロー」　といって、慶一は開け放した戸口から部室に入った。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バカヤロー、でかい声だすな。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バカヤロー、恐くねえぞ！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえ、じぶんがすごくかわいい顔してるの、知ってるか」　高志の唐突なことばに、慶一は歯ブラシを吐きだし、「バカヤロー」　と、吹きだしながらいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうはさせまいと、慶一は、「ゲストに失礼じゃないか」「バカヤロ、なんのために、こんなデカいエサをつくったと思ってんだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この大バカヤロー！",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バカヤロー、腹うって、死んじまえ！",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バカヤロー、なにすんだよ」「ここは通路だぞ」　と警官のようなことをいって、大男が片手で慶一をかかえこんだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯ブラシを吐き出し、カメラにむかって、「バカヤロー」という口のかっこうをつくってみせる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "五分でも、二時間でも、おんなじ――」「バカヤロ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "よい一日だつたがよくない一夜だつた、私は誰にともなく（いや自分自身に向いて）バカヤロウ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕早くＹさん来訪、めづらしく単身である、電話で呉郎さんを呼び出して、Ｆ屋へ行く、飲む、踊る、ワヤだつた、バカヤロウ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「タムラブンリンミタ　バカヤロウ」　幾度読み返してみても同じ事なので、馬越氏はお婆さんのやうな顔を歪めてにやつと笑つた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バカヤロウ――ワガハイの靴のことも考へないで、そんなにはやくかくれては、ボクは転びさうではないか。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "バカヤロ、バカヤロ、お芙美さん！",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（なにをバカヤロウ、何を売ろうと、ひとのことだ。",
              "citation": {
                "source": "一坪館",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんどん仕事がはかどるぜ」「バカヤロー」「えっ、なんだって、きたないことばは使わない方がいいよ」「だってそうじゃねえか。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "利口な人間からバカヤローを見ると……やっぱり皮肉がやりたくなる。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国語が達者な人でもフッと腹がたって悪態をつく時は、思わず「バカヤロウ」と云うわよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "電話で「バカヤロー」と怒鳴るというウソ、人にそんなことを云うだけ　横田をやめさせろと云いつつ横田には内密で、成人教育をやらせる。",
              "citation": {
                "source": "一九二七年春より",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリスの笑い話に、小説の第一行目から人の注意を惹くために「侯爵夫人はコン畜生のバカヤローと怒鳴った」と書けばマチガイなし、というのがある。",
              "citation": {
                "source": "敬語論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日トンパチ屋で会ふと向うから話しかけて文学の話を始めたから、バカヤロー、私は怒鳴つて帰つてきた。",
              "citation": {
                "source": "ぐうたら戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「信長はいくつだ」「十五です」「バカヤローの評判が大そう高いな」「噂ではそうですが、鋭敏豪胆ことのほかの大器のように見うけられます」「あれぐらい評判のわるい子供は珍しいな。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "百人が百人ながら大バカヤロウのロクデナシと云ってるな。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "落ち目の家をついだのは、いま評判のバカヤローであった。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに信長がバカヤローでも人に会う時は加減もしようから、誰に気兼ねもない時のバカヤローぶりを見物しようというコンタンであった。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
