          "literary": [
            {
              "text": "船頭はフオスカリだの、ムシユコだの、バルバルコだのと昔の主人の貴族の名を呼びつつ其邸を指点して教へた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちの１人はヴェルス皇帝の伯父であるマルクス・キヴィラ・バルバルス、もう１人はマルクス・アウレリウスの養子であるクラウディウス・セヴェルスであった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいですか」サイバーロボットの開発主任である六本の腕を持ったバルバル星人が言った。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
