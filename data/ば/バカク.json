[
  {
    "uuid": "3ff336b6-8fd9-5b46-a94e-ca178938d630",
    "entry": "馬革",
    "reading": {
      "primary": "ばかく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
