        "examples": {
          "standard": [
            {
              "text": "昨晩からまぶたが赤く腫れて痛むので眼科へ行ったら、麦粒腫だと診断された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "麦粒腫はいわゆる「ものもらい」のことで、決して目をこすってはいけない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "抗生物質の点眼薬を使い始めて数日で、麦粒腫の腫れはすっかり引いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "木瓜の枝のまわりに、若芽が一ぱい子供の毛糸のシャツのようにふく／＼と暖かそうにかぶさり、而もその編目の間には美しい稚児の麦粒腫のような可憐な蕾が沢山潜んでいます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
