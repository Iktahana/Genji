          "literary": [
            {
              "text": "頭のいい連中の中には、バターパンを持っていった者もあるけど、もちろん、となりの人にわけてやったりはしないよ。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車が停まると自分は、お湯だのバターパンだの飲料水だのと言って、停車場じゅうを駈け廻らなければなるまい。",
              "citation": {
                "source": "富籤",
                "author": "ВЫИГРЫШНЫЙ　БИЛЕТ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、とちゅうで食べるように、バターパンとおかしももたせてやりました。",
              "citation": {
                "source": "森のなかの三人の小人",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、さっさと暖炉のそばにこしかけて、バターパンとおかしを食べはじめました。",
              "citation": {
                "source": "森のなかの三人の小人",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「コーヒーとバターパンを下さい。",
              "citation": {
                "source": "老人と鳩",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
