        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ローマにおける彼の若い同時代者バリヴィは医学者がヒポクラテスの方法に戻るように、哲学的な理論を読まないように、彼が「破滅的な熱望」と呼んだ体系作りをしないように、絶えず呼びかけた。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "第20章図１　Franz de le 〔Boe:〕 [Sylvius], 1614-1672　シルヴィウス21　バリヴィ（1668-1707）　これまで見たように北ヨーロッパの科学者は化学に誇りを持った。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "イアトロ機械主義の学説はバリヴィの教えで頂点に達し決定的な変換点となった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリヴィはラウザ（シチリア島）の貧乏な環境で1668年９月８日の明け方に生まれた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "同郷のイエズス会士が２人を金持ちの医師バリヴィに紹介し２人は養子となり財産が遺された。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリヴィはナポリの大学で勉強した後にイタリア各地を旅行し1692年にローマに到着し、その後ここに長いあいだ滞在することになった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリヴィはボローニャで講義を聴いたので彼を知っていた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルピギは年をとり病気であったので４０歳若いバリヴィと親しい関係を結ぶことはなかった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし1694年７月に卒中で倒れたときにマルピギはバリヴィに往診をしてもらった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリヴィはまだ若かったが臨床家としてかなり評価されていたことを示している。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリヴィは死体解剖を行い明瞭・簡潔な言葉で病気および剖検の結果についての効果的な報告を書いた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリヴィはローマを去ってレッチェに戻るつもりであったが法王インノケンティウス12世はしばらく留まるように希望し間もなく空席ができたので残りの生涯をローマで過ごすことになった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "競争試験が行われバリヴィは13人の候補者のうちの最高であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "このようにしてバリヴィは40歳になる前に若くして死ぬまでローマに留まった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "理論に関してバリヴィは本格的なイアトロ機械主義者であり実際この学派の学説を完璧なところまで押し進めた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリヴィの臨床家としての働きを見ると驚かされる。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしバリヴィは科学者であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリヴィの仕事には深い穴が開いていた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリヴィ自身はこの断裂に気がついていた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "第21章図１　Giorgio Baglivi, 1668-1707　バリヴィ22　シデナム（1624-1689）　バリヴィがナポリでまだ学生であったころシデナムは死去しウェストミンスターの聖ジェームズ教会に埋められた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリヴィを尊敬する人たちはバリヴィを「イタリアのシデナム」と呼んだ。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい学問が実際の場面すなわちベッドサイドで臨床にほとんど役立たないことはバリヴィの行動にはっきりと示された。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "17世紀にイアトロ物理学者の学派はバリヴィにおいて頂点に達した。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "イアトロ物理学は因果関係に関してバリヴィが必要とするものを与えた。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし病人を治療するにあたってバリヴィはヒポクラテスの学説すなわちまったく別の学説に基づく原理に従ったと包み隠さずに白状した。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう1人は17世紀の指導的なイアトロ機械学者であったバリヴィであった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリヴィはスイスの医師マンジェに依頼されて「医学臨床文庫」にタラント病についての短い報告を書いたが、これでは満足せずに1695年にこの主題についての学術論文を書いた(14)。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリヴィは次のように書いている。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
