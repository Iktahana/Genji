    "definitions": [
      {
        "index": 1,
        "gloss": "subsidiary burial mound (Kofun period)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古墳の主軸の近くには、陪塚と思われる小さな塚がいくつか見つかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "考古学者は、陪塚の発掘調査から古代の埋葬習慣に関する手がかりを得た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この地域では、巨大な前方後円墳とその周囲に点在する陪塚が特徴的だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "此地形が主墳の周圍に陪塚を造るをゆるさぬ。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "お穴樣の探檢",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの御陵のごときは、二重に堀をめぐらし、その周圍には陪塚といつて臣下の人だちの墓がたくさん竝んでをります。",
              "citation": {
                "source": "博物館",
                "author": "濱田青陵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
