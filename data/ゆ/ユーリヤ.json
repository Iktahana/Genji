        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あたしがこの部屋へ来たいって言ったのは、そんなことのためじゃないわよ」「嘘を言ってますね、リーズ、ユーリヤ（下女）がはいって来て、このかたのいらっしゃったことを知らせたじゃないの。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "母さん、後生だから、御自分で行って、ユーリヤをせき立ててちょうだい。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユーリヤは水を持って駆けこんで来た。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユーリヤ、大急ぎで氷のかけらを穴蔵から出して、別のうがい茶碗に水を入れておいで、さあ、あれも行ってしまったから、わたし用事にとりかかってよ。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほら、もうユーリヤが氷を持って来たわ！",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユーリヤ、駆け出してそう言っておいで。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
