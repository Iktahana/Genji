        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "冬場は台所の湯沸かし器がないと、冷たい水で皿洗いをするのが辛い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "古いアパートの湯沸かし器が急に壊れて、お湯が出なくなってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ガス会社の人を呼んで、新しいタイプの湯沸かし器を取り付けてもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "自分のお茶は自分の湯沸かし器で作るのさ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし私めを殴られるおつもりなら、老人ながらこの湯沸かし器で対抗します。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "スライトは依然として湯沸かし器を持ち、攻撃に備えたが、もう警戒する必要は無い。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも紅茶の滓が溜っているピクニック用の湯沸器。",
              "citation": {
                "source": "ある心の風景",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その解剖台上に投げ出された、黒い、凹字型の木枕に近く、映画面の左手に当ってギラギラと眼も眩むほど輝いておりますのは背の高い円筒形、ニッケル鍍金の湯沸器で御座います。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯沸器の湯気もほのかにもの思ふらし。",
              "citation": {
                "source": "芥川龍之介歌集",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳を押しあてれば、湯沸器がふつふつ音をたてているのが聞こえるでしょう」　まさに警部補の言った通りだった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　それから一分の後には、コーリヤは、大きな、だきついてやりたいほどなつかしい、おなじみの湯わかし器が、ちん／＼いつてゐるそばに、すわつてゐました。",
              "citation": {
                "source": "そり（童話）",
                "author": "オイゲン・チリコフ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
