    "definitions": [
      {
        "index": 1,
        "gloss": "women's waistcloth",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔の女性は、入浴時に湯巻きを身につけていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "時代劇で、湯巻き姿の女優を見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "湯巻きは、日本の伝統的な衣類の一つだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "友禅の長｜襦袢のこともあったが、売出されたばかりの、ごく薄手の上等の英ネルの赤いのを胴にした半じゅばんへ水色っぽい友禅ちりめんの袖をつけて、袷仕立にした腰巻き――塵よけともいうが、白や、水浅黄のゴリゴリした浜ちりめんの、湯巻きのこともある。",
              "citation": {
                "source": "鬼眼鏡と鉄屑ぶとり",
                "author": "続旧聞日本橋・その三",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫式部日記に、ゆまきすがた、といへるは、豈腰にまとふに布のみを以てしたる裸美人ならむや。",
              "citation": {
                "source": "当世女装一斑",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "長吉はねずみちりめん無垢の上衣、緋ぢりめん無垢の下着、白の浜｜縮緬のゆまき、緋鹿の子のじゅばんを着ている。",
              "citation": {
                "source": "西川小りん",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "garment worn by nobles when bathing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "平安時代の貴族は、湯巻きを着用して入浴したと記録されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "湯巻きは、当時の身分の高い人々の入浴習慣を物語る品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "美術館で、当時の湯巻きを再現した展示を見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
