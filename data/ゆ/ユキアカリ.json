    "definitions": [
      {
        "index": 1,
        "gloss": "brightness of snow",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "満月の夜、雪あかりで庭がほんのりと明るかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "部屋の明かりを消すと、窓の外からの雪あかりが幻想的だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "雪あかりに照らされた夜道は、昼間とは違う静けさがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "日がとつぷり暮れても道は雪あかりで明るいのだ。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言って、雪あかりに、またその、人間の手に変えられてしまった自分の手をしげしげと見つめました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の狐は、町の灯を目あてに、雪あかりの野原をよちよちやって行きました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧病の薬いただく雪あかり。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "逡巡をする五助に入交って作平、突然手を懸けると、誰が忘れたか戸締がないので、硝子窓をあけて跨いで入ると、雪あかりの上、月がさすので、明かに見えた真鍮の大薬鑵。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぎょっと致しましたが、そこはやはり旅馴れた出家で厶りますゆえ、雪あかりにすかしてよくよく女を見直すと、これがどうで厶りましょう。",
              "citation": {
                "source": "十万石の怪談",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　取りのけて雪あかりをたよりながら見ながめるや同時に、名人も伝六も、伊豆守の面前であるのを忘れたほどに、声をそろえておもわずあッと叫びました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "千柿の鍔",
                "note": "青空文庫"
              }
            },
            {
              "text": "水明かりと雪あかりを頼りにして、大勢の人影は白いゆうぐれの中をさまよっていた。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "油が盡きたら雪あかりでも事は濟む。",
              "citation": {
                "source": "俳諧師",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "試作四句その手が、をんなになつてゐる肉体雪ふる処女の手がテーブルのうへに咲いては落ちる椿の情熱をひらふ雪あかりわれとわが死相をゑがく　　　ぐうたら手記□飲みすぎ食べすぎもよくないが、饒舌りすぎはもつとよくない。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・暮れて雪あかりの、寝床をたづねてあるく・木の葉が雪をおとせばみそさゞい・雪でもふりだしさうな、唇の赤いこと・春の雪ふるヲンナはまことにうつくしい・春比佐良画がくところの娘さんたち・からたちにふりつもる雪もしづかな家　　　追加一句　みんな洋服で私一人が法衣で雪がふるふる　三月九日　愚郎居。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・火燵まで入れてもろうて猫がおさきに　　　（愚郎居）・雪あかりの日あかりの池がある畑がある　三月十日比古君の厄介になる。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪あかりで自分を見詰める。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで入口の雪あかりの閃きを、白い女の形と思い違いしたのかもしれないと思った。",
              "citation": {
                "source": "雪女",
                "author": "YUKI-ONNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからは雪あかりをたよりにしてゆっくり歩いた。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（十二月×日）さいはての駅に下り立ち雪あかりさびしき町にあゆみ入りにき　雪が降っている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さいはての驛に降り立ち雪あかり、淋しき町に歩ゆみ入りにき」さいはての驛の前は道が泥々してゐて、雪の頃のすがれたやうな風景を眼の裏に思ひ出す事もできた。",
              "citation": {
                "source": "摩周湖紀行",
                "author": "――北海道の旅より――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくすると、ほのかな雪あかりで、暗い部屋のなかがおぼろ氣にみえて來る。",
              "citation": {
                "source": "美しい犬",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "淫売婦と飯屋　十二月×日さいはての駅に下り立ち雪あかりさびしき町にあゆみ入りにき　雪のシラシラ降っている夕方、私は此啄木の歌をふっと思い浮べながら、郷愁を感じた。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の雪空は、暗い低さで、積った雪あかりに、やっと、道は見えていたが、急な曲り角になると、田圃の中へ、飛び込みそうになっては、危く身を躱して、走らなくてはならなかった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほのかな雪あかりに、手さぐりの横穴が黒い口をひらいた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ雪あかりで僅かに周囲が見える。",
              "citation": {
                "source": "山と雪の日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "段々つもって雪あかりになって来る、夜の雪空の色、きつい武蔵線のスパーク、柔かい櫟の梢の重いひろがり。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "道端に竹と材木が林の如く立っているのに心付き、その陰に立寄ると、ここは雪も吹込まず風も来ず、雪あかりに照された道路も遮られて見えない別天地である。",
              "citation": {
                "source": "雪の日",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "道端に竹と材木が林の如く立つてゐるのに心付き、その陰に立寄ると、こゝは雪も吹込まず風も来ず、雪あかりに照された道路も遮られて見えない別天地である。",
              "citation": {
                "source": "雪の日",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は無言のまゝラッセルしあいながら、おぼろな雪あかりをたよりに午前三時半頃野口着、駐在所に届けて大町へ、警察署へたちよってから対山館へ着いたのが四時過ぎであった。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は無言のままラッセルしあいながら、おぼろな雪あかりをたよりに午前三時半ごろ野口着、駐在所に届けて大町へ、警察署に立ちよってから対山館へ着いたのが四時過ぎであった。",
              "citation": {
                "source": "針の木のいけにえ",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "明るい雪あかりは白い浴槽のふちに輝き、短く湯気のたっている湯がほんのり赤い伸子の体の上におこす波だちの上にきらめき、ナターシャの糊のきつい白前掛の膝に流れている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしていながらときどき、雪あかりをいっぱいうけて湯の中に横たわっている伸子の暖かそうな肌色の体に目をやり、また外を見ている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごみのない澄んだ雪あかりと白いプラトークや看護服のなかで、ナターシャのすもも色の若い頬っぺたは、びっくりするほどの生活力にあふれている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
