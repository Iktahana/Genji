[
  {
    "uuid": "115fd400-1907-5c4e-b909-b7ccede0a6c8",
    "entry": "揺り起こす",
    "reading": {
      "primary": "ゆりおこす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行"
      ],
      "ctype": "五段-サ行",
      "inflections": null,
