        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "豊かな文化遺産が、この街の誇りだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は豊かな感性を持っており、芸術的な才能がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "内面が豊かな人は、他人の痛みに寄り添える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "open (mind)",
        "register": "standard",
