        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "木には果実が豊かに実っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女の顔色は豊かで、健康そのものだった。",
