        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "湯が野ではすこしユツクリした。",
              "citation": {
                "source": "伊豆の旅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "其内ユツクリ話して聞かせやう。",
              "citation": {
                "source": "青年実業家",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "常の湯村はたゞ鷹揚に、「何有、喰べる位の事なら何時まで居ても好い、ユツクリ勤口を探すさ。",
              "citation": {
                "source": "茗荷畠",
                "author": "眞山青果",
                "note": "青空文庫"
              }
            },
            {
              "text": "りき　まあ、よからず、ユツクリあすんで行け。",
              "citation": {
                "source": "ぼたもち",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユツクリ食べて下さい。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（食物をスプーンや箸で美緒の口へ持つて行つて養つてやりながら）美緒　（食物をユツクリ噛みながら）私はさうは思はないわ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんしろ僕が行つても、伊佐子とはユツクリ話しも出来ないんですからね。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "横になつてユツクリなすつて！",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりや金は欲しいけど、それは姉さんの病気が治つてからユツクリ分配すりやいゝんですよ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが何処へ向つて行くと言ふ訳でもなくブラリブラリとユツクリ歩く。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりや、伊佐子さんと赤井が二人きりでユツクリ出来るのは、あれが最後だつたかもわからないけど、俺だつて赤井と話すのは最後かも知れない。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○通りを此方へ向つて、ひどくのけぞる様な格好でユツクリ歩いて来る人の姿。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも世間がかうザワザワしてゐたんぢや、これでユツクリ遊んでも居られないや。",
              "citation": {
                "source": "疵だらけのお秋（四幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "轟　とにかく近い内にユツクリ話すから――（表へ消える）（短い問）（二人の去つたのとは別の方角から酒徳利を下げて戻つて来るお雪）雪　……ただ今。",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "津村　ぢや（留吉に）明日でも又ユツクリ話すから――。",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥の間からアサが取り乱した姿でふてくされてユツクリ出る。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
