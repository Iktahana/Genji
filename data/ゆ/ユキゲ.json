[
  {
    "uuid": "63f48f47-1242-5c99-b1eb-6f569373a520",
    "entry": "雪解",
    "reading": {
      "primary": "ゆきげ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
