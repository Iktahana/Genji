        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この小説は、彼の作家人生における雄編と評されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その映画監督の最新作は、まさに雄編と呼ぶべき作品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は生涯をかけて、一冊の雄編を書き上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そして“Line Composed a few miles above Tintern Abbey”の雄編に移った。",
              "citation": {
                "source": "小春",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "秘書に書かせればいい」　秘書の高橋光威氏に話して、原敬の名で、中央新聞の横井時雄編集長に紹介状を書いてもらった。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンテが雄篇にも猶我心を充たすに足らざるところあり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはその筈で、隨分下等社會の勞働者や、山の中の無教育ものが雄篇大作の主人公にならんとは限らぬからである。",
              "citation": {
                "source": "「額の男」を讀む",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "現にタイフーンのごときまた、舟火事（名前を忘れたり）のごときは単にタイフーンを写し、単に舟火事を写したものとして立派な雄篇である。",
              "citation": {
                "source": "コンラッドの描きたる自然について",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "テニソンの『アイジルス』は優麗都雅の点において古今の雄篇たるのみならず性格の描写においても十九世紀の人間を古代の舞台に躍らせるようなかきぶりであるから、かかる短篇を草するには大に参考すべき長詩であるはいうまでもない。",
              "citation": {
                "source": "薤露行",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「蒔かれし種」というような、ああいう力強い雄篇は、定評ある探偵作家にも、容易なことでは作れますまい。",
              "citation": {
                "source": "御存与太話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "微力其任に堪へずと雖も、当代の人目を聳動したる雄篇｜鉅作は問ふを待たず、治く江湖に散佚せる万顆の零玉細珠を集め、一も遺漏無からんことを期せり。",
              "citation": {
                "source": "「鏡花全集」目録開口",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "『吠※』詩篇の如き、希臘詩聖ホメロスの二大雄篇の如き、北欧の『エッダ』神歌の如きは、其性質に於て、稍々前者に近く、日本古代の神話の如きは、其趣に於て、聊か後者に近かる可し。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "平素その心を失はずば半生｜世路の辛苦は万巻の書を読破するにもまさりて真に深く人生に触れたる雄篇大作をなす基ともなりぬべし。",
              "citation": {
                "source": "小説作法",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は来学年の講義を作らなければ大雄篇をかくか大読書をやる積りだが講義という奴は一と苦労です。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "文學上の雄篇大作に對する場合も同樣である。",
              "citation": {
                "source": "「イーリアス」例言",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "この雄篇をヘンデルはわずかに二十四日間で仕上げた。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "第十二章　レーモン・スボン弁護　この章は『随想録』中最大の雄篇で、初版『随想録』においてはその四分の一を、一五八八年版においてはその六分の一を占めている。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
