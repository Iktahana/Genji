        "examples": {
          "standard": [
            {
              "text": "弓弭に弦をしっかりと固定し、的を狙った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "破損した弓弭を修理するため、彼は専門の職人を訪ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この弓は、弓弭の部分に独特の装飾が施されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "この時代には、内政も漸く整ひ、人民に対し、初めて弓弭の調、手末の調を課せられてゐる。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "弓弭の清水を掬んで、弓かけ松の下に立って眺める。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "弓弭の清水を掬んで、弓かけ松の下に立つて眺める。",
              "citation": {
                "source": "熊の足跡",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸で、鳶と喧嘩をして負けたくやしさ、くやしまぎれに物をもゆはず、飛びをりてきて、いきなり強くこつんと一つ突衝きました。",
              "citation": {
                "source": "ちるちる・みちる",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            }
          ]
        }
