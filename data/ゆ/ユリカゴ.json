        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "赤ちゃんがゆりかごの中で、すやすやと眠っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この曲は、幼い頃に母が私に歌ってくれたゆりかごの歌だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔は木製のゆりかごが、どこの家にもあったという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "マイクロソフトワークスの統合するパーソナルコンピューターの生と死　揺り籠から伸びた人生のもう一方の端には、墓石がぶら下がっている。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "唱は炉端の天井から揺り籠をぶらさげて鵞鳥の容体を注意してゐた。",
              "citation": {
                "source": "剥製",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢山の洗濯物が部屋の天井からぶら下り、赤坊の揺り籠が隅においてある。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、むかしあの猛々しいライオンが、おおらかな気持ちで、羊をだいてやったように、彼はよく子供を膝にのせ、何時間もぶっつづけに足で揺り籠をゆすったものだった。",
              "citation": {
                "source": "スリーピー・ホローの伝説",
                "author": "故ディードリッヒ・ニッカボッカーの遺稿より",
                "note": "青空文庫"
              }
            },
            {
              "text": "この子がまだゆりかごの中にいたころ、そのそばで『この子はフランス国の玉座の上で死ぬだろう！",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやいや、それどころか、ほんの小さなドングリを、ゆりかごにしていたこともありました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、贈り物として、子供のゆりかごの上におかれ、子供の胸の上におかれる。",
              "citation": {
                "source": "家じゅうの人たちの言ったこと",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "もういっぽうは、男の子がひろって、いまに赤ん坊でも生れたら、ゆりかごに使うんだ、と言いながら、持っていってしまいました。",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとに家に残るのは、眼の見えない婆さんか、ゆりかごの中の赤ん坊か、日向で金の眼を細くしてゐる猫ばかりである。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう片方は若者がすばやくひろって、「子供ができたときに、ゆりかごの代わりになる。",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "THE LITTLE MATCH-SELLER",
                "note": "青空文庫"
              }
            },
            {
              "text": "おやゆび姫は女の人にゆりかごをもらいました。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            },
            {
              "text": "きれいにみがかれたクルミのからの上に、スミレの花びらをシーツ、バラの花びらをしきぶとんにしたきれいなゆりかごです。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々を二十四時間取り巻く環境の背後にネットワークを仕掛け、電脳社会の内に人を包み込むことで、ゆりかごから墓場までの世話焼きを目指す。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九六〇年代後半、世界をおおった学生反乱の源流を生み、カウンターカルチャーの巨大なゆりかごとして機能した西海岸のはみ出し者たちの中には、コンピューターを管理と支配の象徴としてとらえる意識が根を張っていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜなら、ふるさとは我々のゆりかごではあるけれども、大人の仕事は、決してふるさとへ帰ることではないから。",
              "citation": {
                "source": "文学のふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この昏冥には、行くものが帰るものであり、帰るものが行くものであるという、「西田さんの渦流」（深田康算先生はそう呼んでいられたが）は恰好のゆりかごとなり、青年達をそれに吸い込んで行くのである。",
              "citation": {
                "source": "地方の青年についての報告",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなねしずまってしまいましたが、乳母だけは、子どもべやのゆりかごのそばにすわって、まだ目をさましていました。",
              "citation": {
                "source": "にいさんと妹",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、小さなまくらをふるってふくらませますと、また赤ちゃんをゆりかごのなかにねかして、かわいらしいかけぶとんをかけてやりました。",
              "citation": {
                "source": "にいさんと妹",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆりかごで　すやすやねているよ　すると、カモはお妃さまのすがたになって、あがっていきました。",
              "citation": {
                "source": "森のなかの三人の小人",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "もぐもぐハンカも　そのあたりのものは　せきたんいれの　うらに　おいておくことにして、　こんどは　ゆりかごを　とってきました。",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんだなと　とりかごは　せきたんいれの　うらから　もとに　もどされましたが　――　もぐもぐハンカは　ゆりかごと　ルシンダの　ふくを　あれこれ　せしめました。",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            },
            {
              "text": "前　お茶に　来たとき　あの子　お気に入りの　よそいきの　ぼうしを　ネコの　ゆりかごに　したのよ。",
              "citation": {
                "source": "ちょびひげサミュエルのはなし",
                "author": "まきまきパンのまき",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一つの例が、赤児を乗せてあやすゆりかごです。",
              "citation": {
                "source": "言語と文化史",
                "author": "――アイヌ文化の探究にあたりて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちアイヌのゆりかご、アイヌ語でシンタと称するこのゆりかごは、アイヌの観念においては舟であったことがわかるのであります。",
              "citation": {
                "source": "言語と文化史",
                "author": "――アイヌ文化の探究にあたりて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "このゆりかごが叙事詩の中では更に空想化されて、空飛ぶ乗物、文字どおりの航空船になり、神々がこれに乗って大空を自由に往来するように述べられており、樺太の叙事詩ではそれを特にサランペポンチピ（絹製の小舟）と申しておりますので、いよいよそれに対するアイヌの考え方というものがはっきりしてまいります。",
              "citation": {
                "source": "言語と文化史",
                "author": "――アイヌ文化の探究にあたりて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその橇台は先ほど申したシンタ、すなわちゆりかごと同じ形のものであって、しかもアイヌはそれをやはり舟と考えていたのであります。",
              "citation": {
                "source": "言語と文化史",
                "author": "――アイヌ文化の探究にあたりて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆりかごうたねんねや、ねんねや、おねんねや、ぼうやがお父さんひつじ守り。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆりかごから棺おけまで。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも段ボールのゆりかごはまだ作ったことはないが、棺おけなら戦時中にやったこともあり、戦後も一昨年（三十三年）、ある坊さんの生き葬式用に作ってみたことがある。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆりかごから飛び出、ベッドから飛び出、母親の腕の中からも、まるでコオロギのように飛び出てしまうのです。",
              "citation": {
                "source": "コロロッチョ",
                "author": "GRILLINO",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
