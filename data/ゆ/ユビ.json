[
  {
    "uuid": "3b5170da-2dfb-5ef8-be4d-f92c0d6790ba",
    "entry": "指",
    "reading": {
      "primary": "ゆび",
      "alternatives": [
        "および",
        "おゆび"
      ],
      "is_heteronym": false
    },
    "grammar": {
