          "literary": [
            {
              "text": "ユージット一　一家の危機は過ぎた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾は、ユージットになろうと思うのでございます。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾はユージットになろうと思うのでございます。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユージットと申しますのは猶太の美しい娘の名でございます。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ユージットになろうと申しますのは、妾の方から進んで、あの荘田勝平の妻になろうと云うことでございます。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その少女の名こそ、今申し上げたユージットなのでございます。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「妾はユージットのように、戦って見たいと思うのです。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユージットは、操を犠牲にしましたが、それは相手が、勇猛無比なホロフェルネス、操を捨てゝかからなければ、油断をしなかったからです。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
