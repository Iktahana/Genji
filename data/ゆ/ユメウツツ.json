[
  {
    "uuid": "c2c3e6c6-92d5-51e9-94c5-ef806de30b34",
    "entry": "夢うつつ",
    "reading": {
      "primary": "ゆめうつつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
