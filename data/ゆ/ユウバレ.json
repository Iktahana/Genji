    "definitions": [
      {
        "index": 1,
        "gloss": "clearing up in the evening",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
