        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夢を叶えるために、単身でＵＳＡへ渡り、ハリウッドでのオーディションに挑戦した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "観客席のファンたちは、星条旗を振りながら「ＵＳＡ！」と大きな声援を送った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ＵＳＡの独立記念日を祝う花火が、夜空を色鮮やかに彩り、街中がお祭り騒ぎになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ヤードバーズ〈フォー・ユア・ラヴ〉、アウトサイダーズ〈タイム・ウォント・レット・ミー〉、ナシュヴィル・ティーンズ〈タバコ・ロード〉、ビーチボーイズ〈アミューズメント・パークス・ＵＳＡ〉、それに、ナンシー・シナトラやレズリー・ゴーアなんてものまである。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｇ・Ｈ・Ｗ――ＮＹＣ・ＵＳＡ。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "★『ザ・コンピュータ』（ソフトバンク）一九九〇年六月号、「ＫＥＹＭＡＮ ＵＳＡ　次世代のコンセプターが考えている明日」所収のアラン・ケイへのインタビュー。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "同書はソフトバンクが刊行していた『ザ・コンピュータ』誌の連載企画、「ＫＥＹＭＡＮ ＵＳＡ」をもとにしている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロッパ、アメリカでも、歴史の回転がはげしく感じられているらしく、ドス・パソスはアメリカ「ＵＳＡ」という題の小説を書いている由。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
