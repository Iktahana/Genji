        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "九月九日（日曜）　元禄、安政の大地震のときにも、スイトン、ゆであずき類大繁昌であったらしい。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "梨西瓜、ゆであずき、リンゴ等往来に並んで居る。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゆであずきいけない？",
              "citation": {
                "source": "少年の日二景",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、お粥にゆで小豆を散らして、鹽で風味をつけたものであつた。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、お粥にゆで小豆を散らして、塩で風味をつけたものであった。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しまいに掌、足のうら、唇のまわりだけのこして、全身がゆで小豆の中におっこちた人形のようになった。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆで小豆ぐらいは充分にあります。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
