[
  {
    "uuid": "66cd6e89-394a-5019-b82d-b0dfa36705ea",
    "entry": "湯温",
    "reading": {
      "primary": "ゆおん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
