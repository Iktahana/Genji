[
  {
    "uuid": "76db7862-4977-51cc-8715-adfc935840e0",
    "entry": "雄略",
    "reading": {
      "primary": "ゆうりゃく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
