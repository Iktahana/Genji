    "definitions": [
      {
        "index": 1,
        "gloss": "Shinto ritual in which a shaman or priest soaks bamboo grass in boiling water and sprinkles the water on worshippers (originally a form of divination, later a purification ceremony, now primarily used to pray for good health)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "湯立て神事では、神職が湯を清めに用いる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "健康を祈願して、氏子たちが湯立ての儀式に参加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "湯立ての神事で撒かれた湯は、無病息災のご利益があるとされる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "夜に入って、「湯立」という儀式があった。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何をやろうか」「湯立の舞」「おっと、合点」　ことばと一緒に、また野趣のある諸※の楽器が、一だん調子をそろえて囃しました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯立の仮面をつけたひとりの男が、笹を持って踊りぬきます。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三峰神社の神楽殿では、今、湯立の舞の鈴と笛が太鼓につれて古雅な調べを合せておりましたが、三人はそれを杉木立の横にながめて、社家の玄関へ、頼む――と静かにおとずれます。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきは湯立神楽の静かな鈴楽でしたが、今は序破急な大太鼓のとどろきに鎌倉舞の笛｜囃子がいとおかしげに交じって、楽天的な神代の明るさが山にあふれるかと思われるようです。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ここから、もう何里ぐらい歩いたらいいの」「さア、私もこんな奥へ来たのは初めてで、よく見当はつきませんが、川島郷から湯立船戸、ザッと四、五里も歩いたら、穴吹口へ着きましょうか」「そこが、あの山の麓かね？",
              "citation": {
                "source": "鳴門秘帖",
                "author": "木曾の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "江の島見物の旅人たちが、なにがしかの賽銭を神楽料として献げるたびに、この社家にいる一人の若い巫女が、白の綸子の小袖に緋の袴をつけて、舞楽殿で湯立舞の一節を舞うのであった。",
              "citation": {
                "source": "牢獄の花嫁",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
