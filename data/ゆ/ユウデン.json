    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「冥土より郵電報があるのなら　早く安着申し送らん」（２）　そして、喉をりっぱにかき切った。",
              "citation": {
                "source": "死生に関するいくつかの断想",
                "author": "BITS OF LIFE AND DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばモスクワの郵電省の一部に特別なラジオ学校見たいなものがあって、直接産業別の労働組合と連絡をとって、定期に専門講演を放送してモスクワ以外の工場都市の労働者教育に貢献している。",
              "citation": {
                "source": "ソヴェト同盟の芝居・キネマ・ラジオ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵電省は自身の五ヵ年計画で数千の「ラジオ中心」を集団農場へ新設しつつある。",
              "citation": {
                "source": "ソヴェト同盟の芝居・キネマ・ラジオ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵電省ではその批判を取上げて、プログラムを面白く、だがどこまでも建設のみちにあるソヴェト同盟のプロレタリアートのものらしくこしらえようと努力している。",
              "citation": {
                "source": "ソヴェト同盟の芝居・キネマ・ラジオ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "美しい郵電省の先に、少年図書販売店がある。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝は、いつもと違って郵電省の立派な入口に、幾条もの赤旗が飾られている。",
              "citation": {
                "source": "ソヴェト同盟の三月八日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "町の角に立派な出来たての郵電省がある。",
              "citation": {
                "source": "勝利したプロレタリアのメーデー",
                "author": "――モスクワの五月一日――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
