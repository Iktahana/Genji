        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日本ノ講和委員ハ何ガ故ニ英米ト日本トガ國民精神ノ根本、國家組織ノ信念ヨリ異ニスル所以ヲ指摘シテ、日本國民本有ノ國家有機體的信仰ヲ彼等ニ訓ユルコトナカリシカ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ユルコトヲ得ザルモノ三十六年……　そこで一座は笑いながら、三十六年も大げさだが、これら女護の島の女人たちの多くが、性の悩みに堪えきれないでいることだけは明らかな事実で、その関を突破さえすれば、洪水のように流れ出して来るのだという。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "加之斯ク其施行ヲ禁ジ、王ハ自カラ之ヲ忘却シテ意ヲ用ユルコトナシ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "余モマタ家慈ニ向ツテ頻ニ阿爺ニ見ユルコト何ノ日ニアルヤヲ問フ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛騨では元はユルコ今はイリゴ、越中でもイルコ又はエリゴ、越後ではイルコ・イリゴ又はイリマイと謂つて居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛騨では元はユルコ今はイリゴ、越中でもイルコまたはエリゴ、越後ではイルコ・イリゴまたはイリマイといっている。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエガヤロウトスルアラユルコトヲ私ハ妨害スル。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
