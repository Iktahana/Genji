        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祭りの夜店に、色とりどりの弓張りがぶら下がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "旅館の主人が、客を迎えに弓張りを持って出てきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の人は、夜道を歩く際に弓張りを提げていたそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
