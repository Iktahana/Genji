          "literary": [
            {
              "text": "」「お湯どころか、米を洗う水さえなくって困っとるんだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯どころの秋ねもごろの日のあたりかも。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "山峡の湯どころの秋、出て見れば下の小橋を、杖つきて渡る子もあり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯どころのうしろの山の、秋山の、その柔かき草山の、このもかのもにさわさわと音する薄、穂薄の、今日来て見れば、揺りかがやけり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜩が二つ啼きまた一つがこもごもに湯どころの秋　ねもごろの日のあたりかも。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "山峡の湯どころの秋。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯どころのうしろの山の秋山のその柔かき草山のこのもかのもにさわさわと音する薄、穂薄の、今日来て見れば、揺りかがやけり。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "友に近状を述べて、――嬉野はうれしいところです、湯どころ茶どころ、孤独の旅人が草鞋をぬぐによいところです、私も出来ることなら、こんなところに落ちつきたいと思ひます、云々。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
