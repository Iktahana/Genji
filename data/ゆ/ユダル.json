        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夏の盛りで、アスファルトが茹だるほど暑い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "湿気が多く、まるで茹だるような空気が街を覆っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、じっとしているだけで汗が噴き出し、体が茹だるのを感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
