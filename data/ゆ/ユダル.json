    "definitions": [
      {
        "index": 1,
        "gloss": "to boil",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お湯が沸騰して、鍋の中が茹だってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "暑さで体が茹だるような日だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "火加減が強すぎて、スープが激しく茹だっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "場内は蒸暑さに茹だるようであった。",
              "citation": {
                "source": "二科展院展急行瞥見記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だるい、ものうい、眠い、真夜中のうだるような暑さの中に、それと似てもつかない渦巻が起った。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし東京市民が申し合せをして私宅の風呂をことごとく撤廃し、大臣でも職工でも皆同じ大浴場の湯気にうだるようにしたら、存外｜六ヶしい世の中の色々の大問題がヤスヤス解決される端緒にもなりはしまいか。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（滝沢英輔　宛）　うだる暑さに閉口。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は味が落ちていないのを喜びながら、この暑さにフーフーうだるのを物ともせず三杯もお代りした。",
              "citation": {
                "source": "大阪発見",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちくしょうめ、おれに断わりもなく、江戸の娘っ子がうだるほど来ていやあがらあ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときどき犬は、このうだるような暑気のもよおす物憂さにたえかねてでありましょう、のどの奥からキューンと妙な音が出るほどの、大きなあくびをするのでありました。",
              "citation": {
                "source": "夢がたり",
                "author": "TO, CHEVO NE BYLO",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭をたたかれたので悟ったと云うだるまの朗らかな心持。",
              "citation": {
                "source": "日記",
                "author": "一九二四年（大正十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "日中のうだるやうな汽車の長旅は、からだこそぐつたり疲れたけれど、沿線の風物にひとつひとつ心が躍り、わりに退屈はしなかつた。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分へと向つてきた嫌悪の気持が、彼女の肉体を一そうだるくした。",
              "citation": {
                "source": "水と砂",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうだるまの一人がこの店にもいた。",
              "citation": {
                "source": "禅僧",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "うだるような暑気に耐えながら、玉受けの穴から機械的に玉を送りこんでいると、徴用されて、名古屋のボール・ベアリングの工場で玉を磨いていた、情けない夏の間の記憶が、指先によみがえってくる。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、盛夏のうだるような暑さの中では、冬ほどうなぎは美味ではないけれど、食いたいとの欲求がふつふつと湧き起こって来る。",
              "citation": {
                "source": "鰻の話",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから内部は、うだるように暑いままだ。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "三当旗一　うだるような暑い午後だった。",
              "citation": {
                "source": "新潮記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "盆地のうだるような暑さに比べると気温もかなり低い。",
              "citation": {
                "source": "新潮記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから逢坂山を経、山科をこえ、やがて洛中の屋根が一ト目に見えだすと、ものめずらしげに、うだるような汗もわすれて、どよめきあった。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "――まだ白河会津までは何百里」「うだるなア」「いっそ物の具など、捨ててしまいたいが、裸で戦もなるまいし……」「ははは」　騎馬と騎馬の上で、笑い合う声までが、干乾びて、埃に咽せそうになる。",
              "citation": {
                "source": "大谷刑部",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の肉体は盛り出した暑さに茹るにつれ、心はひたすら、あのうねる樹幹の鬱蒼の下に粗い歯朶の清涼な葉が針立っている幻影に浸り入っていた。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからかそら豆を茹る青い匂がした。",
              "citation": {
                "source": "みちのく",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらは丘の辺りにポツンと立つた一軒家で、吹く風を遮るものも無いのに「畳が茹る」ほどの暑さです。",
              "citation": {
                "source": "〔婦人手紙範例文〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "水口が露路につづく狭い台所だが、眼の不自由な老人が一人暮しをしていただけあって、庖丁の掛け場所、笊の置きどころまで、仕勝手よく考えてあって、菜を茹るにも居まわりで用の足りる便利さといったらなかった。",
              "citation": {
                "source": "虹の橋",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は七月も過ぎて八月の五日……茹るような暑さです。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　市街地へ向って　さっきも、我々はこの陸地の気候を灼熱した亜熱帯的の太陽が頭上に輝いていると言ったが、まったくそれは西班牙か伊太利のごとき南欧諸国七月初め頃の、茹るような暑熱であった。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
