        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日本人は神経質だし、建築が一つの火の玉にも落付かせておかなく出来ているし、なかなかもってビジネス・アズ・ユージュアルとは行きそうもないことね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビジネス・アズ・ユージュアルということをもうすこし違った云い方で表現すると、段々毎日の生活が、アンユージュアル・イズ・ユージュアル（非常が常住）ということになって来て、そこではじめて悠々さが出来るのね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこにモスクワより合理的な生活の新様式があるのだが、このユージュ君のプランは、面白い。",
              "citation": {
                "source": "子供・子供・子供のモスクワ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユージュ君は託児所について特別関心をはらっている。",
              "citation": {
                "source": "子供・子供・子供のモスクワ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、それからユージュ君にはもう一つ望みがある。",
              "citation": {
                "source": "子供・子供・子供のモスクワ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガラ」の漫談に、「文藝春秋」に菊池氏が書いてゐた、戦時も、ビヂネス・アス・ユージュアル説を入れる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
