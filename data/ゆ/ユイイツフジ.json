        "examples": {
          "standard": [
            {
              "text": "彼は会社にとって唯一不二の才能を持つエンジニアだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "この絵画は世界に一つしかない唯一不二の傑作であると鑑定された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "あなたは私にとって唯一不二のパートナーです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "――○――　人が、物を観る時に、唯一不二な心に成って、その対象に対すると云う事は大切でございましょう。",
              "citation": {
                "source": "Ｃ先生への手紙",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯一不二の言葉ばかり使つてないにしろ、白痴脅しの言葉は並んでゐない。",
              "citation": {
                "source": "雑筆",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そもそも天上皇帝とは、この天地を造らせ給うた、唯一不二の大御神じゃ。",
              "citation": {
                "source": "邪宗門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はかねがね、羈旅漂泊の旅情歌を、恋歌に次いでは、最も短歌らしい短歌として愛誦するものであるが、実はこの両者は、単なる上べの名目を異にするのみで、その実体は唯一不二の本性に根ざしてゐると見るべきだらう。",
              "citation": {
                "source": "万葉集の恋歌に就て",
                "author": "三好達治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
