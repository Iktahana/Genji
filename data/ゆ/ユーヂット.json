          "literary": [
            {
              "text": "ユーヂット一　一家の危機は過ぎた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾は、ユーヂットにならうと思ふのでございます。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾はユーヂットにならうと思ふのでございます。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユーヂットと申しますのは猶太の美しい娘の名でございます。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ユーヂットにならうと申しますのは、妾の方から進んで、あの荘田勝平の妻にならうと云ふことでございます。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その少女の名こそ、今申し上げたユーヂットなのでございます。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「妾はユーヂットのやうに、戦つて見たいと思ふのです。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユーヂットは、操を犠牲にしましたが、それは相手が、勇猛無比なホロフェルネス、操を捨てゝかからなければ、油断をしなかつたからです。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
