        "examples": {
          "standard": [
            {
              "text": "明日の朝は有楽町線に乗って、飯田橋のオフィスへ向かう予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "人身事故の影響で、有楽町線の全線で運転が見合わせられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "豊洲から和光市まで、有楽町線の急行を利用すればかなり時間を短縮できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "有楽町線に乗って小竹向原で下車する。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "小竹向原からだらしない酔漢でひしめいた有楽町線に乗る。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "有楽町線に乗って小竹向原で下車し、小走りでへ急ぐ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
