[
  {
    "uuid": "6e6c1d50-71f2-5c5c-941d-6552ff5ba3bf",
    "entry": "雪催い",
    "reading": {
      "primary": "ゆきもよい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
