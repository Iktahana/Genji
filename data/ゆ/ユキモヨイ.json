    },
    "definitions": [
      {
        "index": 1,
        "gloss": "threatening to snow",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "空はどんよりと曇り、雪催いの気配が漂っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "雪催いの天気だったので、急いで洗濯物を取り込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "雪催いの空を見上げながら、春の訪れを待っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "それは雪催いの寒い日で、わたしは受付の火鉢へ無遠慮に手をかざして、奥へ呼び込まれるのを待っていると、やがて二階の編集局へ呼び上げられて、関氏自身が大勢に紹介してくれた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "小川町から駿河台下に通う電車通り、空はドンヨリとして、どちらかと云うと雪催いの鬱陶しさだったが、今宵は十五日で職人の休日でもあれば、五十稲荷の縁日でもあり、割合に人通りがあった。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいま、東北の或る田舎を旅をしているのだが、この地方では、三月の半ば過ぎていると言うのに、まだ空は雪催いだ。",
              "citation": {
                "source": "月見草",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "季節は極月にはいったばかり、月も星もない闇の夜で雪催いの秩父｜颪がビューッと横なぐりに吹いて来るごとに、思わず身顫いが出ようという一年中での寒い盛り。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丑満時であったから、将軍お膝元の大江戸もひっそりとして物寂しく、二十日余りの晩い月が雪催いの空に懸かっているばかり往来には犬さえ歩いていない。",
              "citation": {
                "source": "紅白縮緬組",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "田部さんがリュックを背負って帰って行かれた七日の夕方も、そんな雪催いだった。",
              "citation": {
                "source": "雉子日記",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪催いの曇った空に、教会堂のとがった三｜角形の屋根は、黒く描き出されていました。",
              "citation": {
                "source": "青い星の国へ",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪催いの寒い風が、ピューッと河から吹き上がった。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪もよいの風は鋭く頬を削った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪もよいの空ではあるが、日差しに張りのある初春の或る朝であった。",
              "citation": {
                "source": "酋長",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……霜日和が雪もよい空となり寒い風が吹きだした、いよ／＼冬ごもりである。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうは雪もよいの、なんだか忌に底びえのする日であったが、老人はさのみに恐れないような顔をしていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "吉良の脇指",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪もよいの寒む風が頬に痛いようである。",
              "citation": {
                "source": "神楽坂",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十日、平常のとおり「おばさん、時間ちゃんとね」「大丈夫だよ」「あしたよろしくね」　二十一日、雪もよいの寒い風の日　六時半ごろから子供をあつめる。",
              "citation": {
                "source": "「乳房」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪もよいの空と云ってもよい程であった。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月二十三日（金曜）曇　非常に寒い日、さほど風はないのだけれども、空はすっかり雪もよいで、どんどん火鉢に火をたいても指の先がしんしんとつめたくかじかむ。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日――それも雪もよいの、底冷がする日の事でございましたが、今出川の大納言様の御屋形から、御帰りになる御車の中で、急に大熱が御発しになり、御帰館遊ばした時分には、もうただ「あた、あた」と仰有るばかり、あまつさえ御身のうちは、一面に気味悪く紫立って、御褥の白綾も焦げるかと思う御気色になりました。",
              "citation": {
                "source": "邪宗門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一たび武石峠へ　雪もよいの空、それに元日のお雑煮おそく、十一時すぎにやっと宿を出た。",
              "citation": {
                "source": "雪の武石峠",
                "author": "別所梅之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもこの雪もよいの寒空に自分から進んで、山岡までも引っぱって出かけて来ておいて、まさかそのようなことまでも、口へ出してはいいかねて黙って歩いた。",
              "citation": {
                "source": "転機",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "北はローンの渓の源遠く、フルカの峯は屹えずやと、のび上る空は雪もよいの重く濁って、フィーシュ、ベルワルトと流れに沿うて、グリムゼルの尼寺へも、まだ二日路はあると云う。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯上りのソーファにぐったりとよりかかって、窓をあけて南をながめると、外は夕闇ながら雪もよいか、ここは仄白く靄がたちこめて、山はいずこ、今はなつかしい二つの峰も仰ぐことは出来なかった。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして雪もよいの陰鬱な天気。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "久太夫の竹光は、雪もよいの低い雲の下で、旋風の風道にしたがって生き物のように高く低く舞い遊んでいたが、濠を越え、吹上の御苑のあるあたりで、ふっと見えなくなってしまった。",
              "citation": {
                "source": "ボニン島物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "○　雪もよいの寒い日になると、今でも大久保の家の庭に、一羽黒い山鳩の来た日を思出すのである。",
              "citation": {
                "source": "雪の日",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪もよいの冬の日、暮方ちかくなる時の、つかれて沈みきった寂しい心持。",
              "citation": {
                "source": "雪の日",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそのむかし牛込の庭に山鳩のさまよって来た時のような、寒い雪もよいの空は、今になっても、毎年冬になれば折々わたくしが寐ている部屋の硝子窓を灰色にくもらせる事がある。",
              "citation": {
                "source": "雪の日",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "底冷のする雪もよいの夜であった。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "私には家内なんかありませんがね」「二号でも三号でもいいですが、ともかく、すぐ来てください」　雲の低く垂れた雪もよいの朝がけ、白川が聖路加へ行ってみると、ハンドルのかたちに、胸に丸い皮下溢血の血斑をつけた二宮の細君の香世子が、窮屈そうに屍室の寝棺におさまって、眼をつぶっていた。",
              "citation": {
                "source": "雲の小径",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "番所の窓から雪もよいの暗い海の色をながめていたが、「腹を切るのに三日もいらぬ。",
              "citation": {
                "source": "奥の海",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪もよいの空は、さつま芋を分けて食べた頃から模様が変わって、いまでは降るような星空になっている。",
              "citation": {
                "source": "酒徒漂泊",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
