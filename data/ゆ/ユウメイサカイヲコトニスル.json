          "standard": [
            {
              "text": "昨夜、長年連れ添った愛妻が静かに息を引き取り、ついに幽明境を異にすることとなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "多くの戦友たちが次々と戦死し、自分一人だけが生き残って彼らと幽明境を異にするのは忍びない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "人間、六十七十になると若い時分の朋輩は多く幽明境を異にする。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
