[
  {
    "uuid": "bd4f1543-269e-50ea-b92e-438dd7db5629",
    "entry": "行き当たる",
    "reading": {
      "primary": "ゆきあたる",
      "alternatives": [
        "いきあたる"
      ],
      "is_heteronym": false
    },
    "grammar": {
