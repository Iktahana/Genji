        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大学もそんなユウトピアの中にあります。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局、滅亡する運命の人類の為、ユウトピアを作ろうと犠牲になることは無意味である。",
              "citation": {
                "source": "さようなら",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "況んや近代のユウトピアなどは――ウイルヤム・ジェエムスの戦慄したことは何びとの記憶にも残っているであろう。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウトピア　完全なるユウトピアの生れない所以は大体下の通りである。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "――人間性そのものを変えないとすれば、完全なるユウトピアの生まれる筈はない。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間性そのものを変えるとすれば、完全なるユウトピアと思ったものも忽ち不完全に感ぜられてしまう。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの古代のパンの神に似たアナトオル・フランスのユウトピア（「白い石の上で」）さへ仏陀の夢みた寂光土ではない。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジヤパン」の著者マツクフアレエンの伝へた日本の女は、殆んどユウトピアの女である。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "況や近代のユウトピアなどは――ウイルヤム・ジエエムスの戦慄したことは何びとの記憶にも残つてゐるであらう。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "――人間性そのものを変へないとすれば、完全なるユウトピアの生まれる筈はない。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間性そのものを変へるとすれば、完全なるユウトピアと思つたものも忽ち又不完全に感ぜられてしまふ。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」さも可笑しさうに笑ひ續けたが、軈て靜に葉卷の煙を吹きながら、「其れだから要するに日本人は幸福なユウトピアの民なんですよ。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人はユウトピアの國民だ。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
