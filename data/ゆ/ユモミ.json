          "literary": [
            {
              "text": "それに続いて聞えて来る湯揉みの音、湯揉みの唄。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして例の湯揉みの唄を唄う。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにつれて湯揉みの音が起り、唄が聞えて来る。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇湯揉みやはじまる湯長さんの音頭音頭はづまにや湯が揉めぬ　　　◇賽の河原ですまぬと思たが石の地蔵さま撫ぜてみた　　　◇氷谷かよ夏でも寒い岩の中から風がわく　私は草津温泉を立つて、吾妻川本流の水源地、上信国境の鳥居峠にむかつた。",
              "citation": {
                "source": "大利根八十里を溯る",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに續いて聞えて來る湯揉みの音、湯揉みの唄。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして例の湯揉みの唄を唄ふ。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにつれて湯揉みの音が起り、唄が聞えて來る。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯もみなよりは長くはいった。",
              "citation": {
                "source": "獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "草津温泉には名物の『湯もみ』がある。",
              "citation": {
                "source": "大利根八十里を溯る",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            }
