        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "園内の渓谷に渡した釣り橋を渡って行くとき向こうから来た浴衣姿の青年の片手にさげていたのも、どうもやはり「千曲川のスケッチ」らしい。",
              "citation": {
                "source": "あひると猿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことにありあり思い出されるのは同じ縁側に黙って腰をかけていた、当時はまだうら若い浴衣姿の、今はとくの昔になき妻の事どもである。",
              "citation": {
                "source": "庭の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ仕事着に着替へぬ、よれよれの浴衣姿の石岡のお上さんは、うさん臭さうな顏をして駿介を見た。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お増は、お今などに世話をしてもらった風呂から上ると、ばさばさした浴衣姿で、縁側の岐阜提灯の灯影に、団扇づかいをしながらせいせいしたような顔をしていた。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "町には電気がついて、避暑客の浴衣姿が涼しげに見えた。",
              "citation": {
                "source": "或売笑婦の話",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は其處におつぎの浴衣姿が凝然として居るのを見て筵から離れることは仕なかつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "閾に近いランプの光が浴衣姿の女を美しく見せた。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂からあがつて、座敷へ戻つて行くと、くみ子も、別な風呂へ案内されたのか、浴衣姿で、鏡臺の前に坐つてゐた。",
              "citation": {
                "source": "多摩川",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――さえは暑いさかりに戻つてきたのだけれど、晝日中は色のあせた日傘をさして浴衣姿でこの河沿ひの廣い河原で呆んやり水の流れをみてゐた。",
              "citation": {
                "source": "うき草",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸浪は洗いざらしの浴衣姿というだらしの無い風をしていたのだった。",
              "citation": {
                "source": "省線電車の射撃手",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "国彦中尉は浴衣姿となり、正坊を抱いてニコニコしながら座敷へはいってきた。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、再び浴衣姿になって――畳の上に座っています――これが真の日本です。",
              "citation": {
                "source": "手紙",
                "author": "一八九三年七月二二日付　チェンバレン　宛",
                "note": "青空文庫"
              }
            },
            {
              "text": "わきに国男が白い浴衣姿でしゃがんで、黒豆という名の黒い善良な犬が尻尾をふっている。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふりかえって見ると、銀モールの太い紐をかけた潰し島田に白博多の帯をしめた浴衣姿の芸者がいて、男はその芸者屋の主人という風体である。",
              "citation": {
                "source": "電車の見えない電車通り",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関で私が書生に訳を話していると、簾の奥から浴衣姿の年とった奥さんが、「まアおばん様、あぶなかったのし」と国言葉で云いながら出て来て、祖母を扶けて座敷へ上げて呉れた。",
              "citation": {
                "source": "突堤",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おでこから頸のまわりへ真白く汗しらずを塗られた浴衣姿の小さい男の子が手に赤い豆提灯をぶら下げたまま、婆さんにおんぶされて涼んでいる姿など、いかにも下町のこの辺らしい。",
              "citation": {
                "source": "築地河岸",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子たちが休んでいる河岸を通り過ぎる時には、白く塗られた甲板に並んでこっちを物珍しそうに眺めている浴衣姿や開襟シャツの船客たちの目鼻立ちまで手にとるように見える程、イルミネーションは明るかった。",
              "citation": {
                "source": "築地河岸",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その男に招ばれて、女が向うの座敷にいっている時、ちょうど上の木屋町の床で、四、五軒離れたところから、二人とも今湯を上がったばかりの浴衣姿で、その男の傍に女が来て坐っているところを遠見に見たことがあった。",
              "citation": {
                "source": "黒髪",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それじゃ」「失礼」　駒下駄の音も次第に幽になって、浴衣姿の白いＭ君は吸わるゝ様に靄の中に消えた。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（此の時、宇治少佐、浴衣姿にて現る）少佐　　もう片づいたか。",
              "citation": {
                "source": "動員挿話（二幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと至は、四阿を抜けて白い浴衣姿の李子夫人が丘を下りるのを見た。",
              "citation": {
                "source": "垂水",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "これから海に行くつもりか、浴衣姿に皮のバンドをしめ、聴心器だけを懐中にねぢ込んでゐる。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また演者の生活や好みの一断片がチラと不用意に覗かれる、夏の夕風にひるがえった青簾の中の浴衣姿の佳人のごとく。",
              "citation": {
                "source": "我が圓朝研究",
                "author": "「怪談牡丹燈籠」「江島屋騒動」「怪談乳房榎」「文七元結」「真景累ヶ淵」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉に化粧をほどこした女性が、浴衣姿で銭湯から出て来た。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お母さんに買っていただいたのよ」　椅子から立ち上がった彼女は、浴衣姿の自分をヨシオに見せた。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあと奥の部屋へいき、やがてあらわれたときは浴衣姿だった。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中で直子は浴衣姿になった。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
