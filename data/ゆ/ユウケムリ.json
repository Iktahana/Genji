        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "浦に着きしころは日落ちて夕煙村を罩め浦を包みつ。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の赤い煙突は朝夕煙を吐いた。",
              "citation": {
                "source": "赤い煙突",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の子なほかの山に住むといふ見れば朝夕煙たつかな　明治の末年故上田敏先生が大陸の象徴詩を移植しようとして訳詩の業を起され、当時の明星が毎号之を発表してそのめざましい新声を伝へたことがある。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ひいづるをり焚く柴の夕煙。",
              "citation": {
                "source": "短歌本質成立の時代",
                "author": "万葉集以後の歌風の見わたし",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふる郷を、別れ路に生ふる葛の葉の　秋はくれども、帰る世もなし（増鏡）思ひ出づるをりたく柴の　夕煙。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "後鳥羽院の「思ひ出づるをりたく柴の夕煙。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "われは　親なし母の、三十七年忌におのれ二歳といふ年に、みまかり給へりしなりけりはふ児にて　わかれまつりし身のうさは、面だに　母を知らぬなりけり……よしや今はよくもあしくも己が心のむきにこそと、綴ぢたる物をもかたへにうちやりて夕煙　今日はけふのみたてゝおけ。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "目をあぐれば、遠き山々静かに夕日を浴び、麓の方は夕煙諸処に立ち上る。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒崎、出雲村の方は夕煙が霞のようになって、宿に迷う初瀬詣りの笠が、水の中の海月のように浮動する。",
              "citation": {
                "source": "大菩薩峠",
                "author": "壬生と島原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして休息ついでに早目な晩の兵站に夕煙を揚げはじめた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この日も雪は梨の花と散りまがい、見れば、江岸の枯れ芦の叢から、一ト筋の夕煙が揚っている。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大台所から吐かれる夕煙が寺内にたち籠め始めた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどここで日いっぱいに暮れ、軒傾いた屋並びに夕煙がこめている。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "先へ越えて、彼処で待てば――」　贄川、洗馬も過ぎて、麓の宿場までかかると、すでに陽はかげって、夕煙の這う往来に、軒ごとの燈火が、春の晩ながら、なんともいえない山国の佗しさを瞬いている。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "“お嗽ひ水”と称する清水や、“笠懸けの森”という伝説の地や、また帝が、山村の夕煙を見て、詠まれたとなす、よそにのみ思ひぞやりし思ひきやたみの竈をかくて見むとは　と、「増鏡」の“久米のさら山の巻”に見えるのはこの地などと、かぎりもない。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして先駆の兵から、「龍泉どのが、お迎えに見えておられます」　と、聞いた正成は、「お、お」　と、正季へほほえみかけ、そこからは馬上の姿を並べて、もうついそこの、桜井ノ宿の夕煙を望みながら共に駒をうたせていた。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
