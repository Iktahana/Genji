    "definitions": [
      {
        "index": 1,
        "gloss": "evening tide",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夕潮が満ちてくる時間になり、漁師たちは船を出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は浜辺で、夕潮の音を聞きながら物思いにふけっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夕潮が引いた後には、貝殻がたくさん残されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "きょうの夕潮までにはまだ半刻あまりの間があることは誰も知っていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "童甲　あいにくに夕潮が一杯じゃ。",
              "citation": {
                "source": "平家蟹",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　別荘へ帰る道の断崖の下には暗い夕潮が白く砕けていた。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああこの文字の永劫に消えじとあらばわが戀の足らましを、若し夕潮の頭もたげて寄せもせば。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕潮に泳ぐ、私だけ残つて。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつしよに夕潮を浴びる、海はひろ／″＼としてよいなあと思ふ、波に乗つて波のまに／＼泳ぐのはうれしい、波のリズム、それが私のリズムとなつてゆれる。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕潮が寄せて来たんだ」「困つたな」「いつその事、崖へ上らうか」、「さうですね」　二人は暫く躊躇してゐたが、思ひ切つて私が先きに立つて、岩角を登り初めた。",
              "citation": {
                "source": "伊良湖の旅",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕潮が猪牙船の横っぱらをザブンザブンとゆすっていた。",
              "citation": {
                "source": "牢屋の原",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――と云う友だちの話を聞いた時には、新蔵もやはり背中が寒くなって、夕潮の色だの、橋杭の形だの、それからその下に漂っている女隠居の姿だの――そんな物が一度に眼の前へ、浮んで来たような気がしたそうです。",
              "citation": {
                "source": "妖婆",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸ひに朝夕潮あびのゆきかへりにこの畠径をぬける近所の子供らにももがれず、此の頃はむしろに敷きかへて先づ健在。",
              "citation": {
                "source": "瓢作り",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "磯回のすゑの圓石はかくれてぞ吸ふ、飽き足らひ耀き倦める夕潮を、石の額は物うげの瑪瑙のおもひ、かくてこそ暫時を深く照らしぬれ。",
              "citation": {
                "source": "有明集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "更科日記に、夕潮たゞ満ちに満ちて、今宵宿らんもチユウゲンに、潮満ち来ればこゝをも過ぎじと、ある限り走りまどひ過ぎぬ。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時啄木を教へたのは同郷の和貝彦太郎氏、夕潮と号した新詩社の同人で当時は上京して麹町番町の与謝野先生のお宅の書生格の食客をしてゐた人で、啄木とは時々顔を合してよく知つてゐた様子である。",
              "citation": {
                "source": "新詩社と石川啄木",
                "author": "――一つのおぼえ書き――",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふわけで、自分がこれから記さうとする新詩社に於ける啄木の事どもも、前記の和貝夕潮や、また好んで啄木を語つた生田長江先生や一ころの生田春月（この人はゴシップ屋であつた）などの談話にもとづいた記憶伝聞が多いのであるが、これとてもあまり正確だといふ自信もない。",
              "citation": {
                "source": "新詩社と石川啄木",
                "author": "――一つのおぼえ書き――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからしばらくして第二の『夕潮』が出た。",
              "citation": {
                "source": "明治詩壇の回顧",
                "author": "三木露風",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母の代　とほく思ほゆるなり今ははた遠き思ひの　ふるさとの家は荒れつゝ、兄の子とよむ神無月夕潮は　すでにあげたり。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "隅田川は夕潮でいっぱいだった。",
              "citation": {
                "source": "柳橋物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――傾く月の道見えて、明けぬ暮れぬとゆく道の、末はいつくと遠江、浜名の橋の夕潮に、引く人もなき捨て小舟。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第三部",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついたちふつかの月ゆゑ、夕汐騒のかすけさ。",
              "citation": {
                "source": "第二海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕汐の高い、靄のしめっぽい宵など、どっち河岸を通っても、どの家の二階の灯も艶かしく、川水に照りそい流れていた。",
              "citation": {
                "source": "朱絃舎浜子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕汐があげてきた時、向島の寮からぶらりと出て、言問の渡しを待つ間に、渡船の出た向岸の竹屋のあたりから、待乳山にかかる夕陽の薄れに、淺草寺の五重の塔もながめ、富士もながめ、吉原の灯もおもつた人々は、水にゆられてゆく大川との親しみを、日に一度は川を渡らなければといふふうに、多分に持つてゐたのだ。",
              "citation": {
                "source": "河風",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "車に揺られて、十九日の欠月を横目に見ながら、夕汐白く漫々たる釧路川に架した長い長い幣舞橋を渡り、輪島屋と云う宿に往った。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "車に搖られて、十九日の缺月を横目に見ながら、夕汐白く漫々たる釧路川に架した長い長い幣舞橋を渡り、輪島屋と云ふ宿に往つた。",
              "citation": {
                "source": "熊の足跡",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは大川口から真面に日本橋区の岸へと吹き付けて来る風を避けようがためで、されば水死人の屍が風と夕汐とに流れ寄るのはきまって中洲の方の岸である。",
              "citation": {
                "source": "夏の町",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は本所深川辺の堀割を散歩する折｜夕汐の水が低い岸から往来まで溢れかかって、荷船や肥料船の笘が貧家の屋根よりもかえって高く見える間からふと彼方に巍然として聳ゆる寺院の屋根を望み見る時、しばしば黙阿弥劇中の背景を想い起すのである。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　残暑の夕日が一しきり夏の盛よりも烈しく、ひろ／″＼した河面一帯に燃え立ち、殊更に大学の艇庫の真白なペンキ塗の板目に反映してゐたが、忽ち燈の光の消えて行くやうにあたりは全体に薄暗く灰色に変色して来て、満ち来る夕汐の上を滑つて行く荷船の帆のみが真白く際立つた。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　残暑の夕日が一しきり夏の盛よりも烈しく、ひろびろした河面一帯に燃え立ち、殊更に大学の艇庫の真白なペンキ塗の板目に反映していたが、忽ち燈の光の消えて行くようにあたりは全体に薄暗く灰色に変色して来て、満ち来る夕汐の上を滑って行く荷船の帆のみが真白く際立った。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "佃島では例年の通り狼烟の稽古の始まる頃とて、夕涼かたがたそれをば見物に出掛ける屋根船｜猪牙舟は秋の木葉の散る如く河面に漂っていると、夕風と夕汐のこの刻限を計って千石積の大船はまた幾艘となく沖の方から波を蹴ってこの港口へと進んで来る。",
              "citation": {
                "source": "散柳窓夕栄",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "亘りたるリオ群島は屏風なす鰐の居る夕汐みちぬ椰子の浜扇風機まはり熱風吹き起る五月三十日　朝、新嘉坡入港。",
              "citation": {
                "source": "五百五十句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
