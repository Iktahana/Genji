        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その五号船はごく古いもので、エンジンを発動させると凄いような排気音を放ち、船ぜんたいをばらばらにするかと思うほど揺りたてる。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いなずまは白く、青く、ひらめき、走り、雷鳴は建物ぜんたいを震撼させ、揺りたてるように思えた。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩の崩れる音と、地盤を揺りたてる震動の恐ろしさは、形容しようのないものであった。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩を掴んで揺りたてるようにして、五分ばかりかかった後やっと眼をさました。",
              "citation": {
                "source": "黒襟飾組の魔手",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
