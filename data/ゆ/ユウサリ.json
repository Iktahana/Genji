          "literary": [
            {
              "text": "はかなきかなや夕さりを、　　なほふかぶかと物おもひ、街をうづめて行きまどふ、　　みのらぬ村の家長たち。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕さりにい行き到れば。",
              "citation": {
                "source": "長塚節歌集　上",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "うみ苧集（三）白帆かぎろひの夕さりくれば。",
              "citation": {
                "source": "長塚節歌集　上",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "日もおちず夕さりごとに。",
              "citation": {
                "source": "長塚節歌集　上",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "覚めて桶の中に坐りて背を日向に曝らし、夕さりくれば又其桶の中に衾もなく安寝し、瞑想幽思、ひとり孤境の閑寂を楽んで何の求むる所なく、烟霞をこそ喰はね、その生活淡々として実に神仙に似たり。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉井勇氏の戯曲「一本腕と一本足」を見出したが、氏の近詠、物部川夕さりくれば水たぎつ音さらさらと聴え初めけり――と声を立てながら無断引用を為し、遥かに朝臣の盃の夢の健かを望みながら、意を尽し得なかつた禿筆を擱く。",
              "citation": {
                "source": "月評",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
