        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "加特力教のユウカリストの大会があつて六十万人の信者が諸国から入込んで居る維納へ、其れとは知らずに着いた風来の自分達は宿の無いのに困つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸にはユウカリ樹が並んで、赤土の崖下に恋人達が昼寝していた。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うのユウカリプスの蔭には、眞白い夏服をきた黒ん坊が三人、何か高い聲で議論をしてゐる。",
              "citation": {
                "source": "CARTE POSTALE",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「去年は、あっちのユウカリの樹のそばへつないでおいたのですがね、今年はこんなところへ逃げ出して来ている……ほら、ご覧なさい。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "謝肉祭の支那服　――地中海避寒地の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あわれ、ユウカリ樹の下に、たをやの髪を手にまきて、若かき恋の別れを告げし、曙も、今は、浮刻の如く、空にうつらふ。",
              "citation": {
                "source": "かの日の歌【二】",
                "author": "漢那浪笛",
                "note": "青空文庫"
              }
            },
            {
              "text": "シルエットになっているユウカリプタスの並木の向こうに、牧草が月明かりに濡れていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
