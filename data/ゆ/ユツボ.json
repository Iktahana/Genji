        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "背後には、血しほしたたる拳あげ、霞める街の大時計睨みつめたる山門の仁王の赤き幻想……その裏をちやるめらのゆく……四十一年十二月　　浴室水落つ、たたと………浴室の真白き湯壺大理石の苦悩に湯気ぞたちのぼる。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝湯――殊に温泉――は何ともいへない心持だ、湯壺にぢとしてゐる時は無何有郷の遊び人だ、不可得、無所得、ぼうばくとしてナムカラタンノウトラヤヤ……。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝の湯壺もよかつた、しづかで、あつくて、どん／＼湯が流れて溢れてゐた、その中へ飛び込む、手足を伸ばす、これこそ、優遊自適だつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねむれないので夜ふけてまた入浴、誰もゐない薄暗い湯壺にずんぶりひたつて水音に心を澄ます、……内湯のありがたさ、山の湯のありがたさである、……よくねむれた。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯壺は花崗石を畳み上げて、十五畳敷位の広さに仕切つてある。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは人の居ないのを見済しては十五畳の湯壺を泳ぎ巡つて喜こんで居た。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "温泉へ行くと、うらなり君が時々蒼い顔をして湯壺のなかに※れて居る。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "温泉へ着いて、三階から、浴衣のなりで湯壺へ下りて見たら、又うらなり君に逢つた。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは会議や何かでいざと極まると、咽喉が塞がつて饒舌れない男だが、平常は随分弁ずる方だから、色々湯壺のなかでうらなり君に話しかけて見た。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も風呂の数は沢山あるのだから、同じ汽車で就いても、同じ湯壺で逢ふとは極まつて居ない。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯壺は花崗石を畳み上げて、十五｜畳敷ぐらいの広さに仕切ってある。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは人の居ないのを見済しては十五畳の湯壺を泳ぎ巡って喜んでいた。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "温泉へ行くと、うらなり君が時々｜蒼い顔をして湯壺のなかに膨れている。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "温泉へ着いて、三階から、浴衣のなりで湯壺へ下りてみたら、またうらなり君に逢った。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは会議や何かでいざと極まると、咽喉が塞がって饒舌れない男だが、平常は随分弁ずる方だから、いろいろ湯壺のなかでうらなり君に話しかけてみた。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも風呂の数はたくさんあるのだから、同じ汽車で着いても、同じ湯壺で逢うとは極まっていない。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯壺は去年まで小屋掛のようなるものにて、その側まで下駄はきてゆき、男女ともに入ることなりしが、今の混堂立ちて体裁も大に整いたりという。",
              "citation": {
                "source": "みちの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "うるさきは男女皆湯壺の周囲に臥して、手拭を身に纏い、湯を汲みてその上に灌ぐことなり。",
              "citation": {
                "source": "みちの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒸気が立ち籠めて、好くは見えないが、湯壺の側に蹲っている人の姿が女らしかった。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな声を出して、「姉さん、姉さん」と湯壺の中から呼んで見た。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "不思議に思ったのは、宿へ着いた時の取次も、晩食の給仕も、湯壺への案内も、床を敷く面倒も、ことごとくこの小女一人で弁じている。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い帯を色気なく結んで、古風な紙燭をつけて、廊下のような、梯子段のような所をぐるぐる廻わらされた時、同じ帯の同じ紙燭で、同じ廊下とも階段ともつかぬ所を、何度も降りて、湯壺へ連れて行かれた時は、すでに自分ながら、カンヴァスの中を往来しているような気がした。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "浴衣のまま、風呂場へ下りて、五分ばかり偶然と湯壺のなかで顔を浮かしていた。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯壺は地の下にあるのだから、入湯と云う点から云えば、余は三層楼上に起臥する訳になる。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "手拭を下げて、湯壺へ下る。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、静かな春の夜に、雨さえ興を添える、山里の湯壺の中で、魂まで春の温泉に浮かしながら、遠くの三味を無責任に聞くのははなはだ嬉しい。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "意外な廊下を曲ったり、思いも寄らない階子段を降りたりして、目的の湯壺を眼の前に見出した彼は、実際一人で自分の座敷へ帰れるだろうかと疑った。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ寒い」　津田はざぶんと音を立てて湯壺の中へ飛び込んだ。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は湯つぼのなかに永く靜かに夢のやうな死を考へて浸つてゐるのであつた。",
              "citation": {
                "source": "三十三の死",
                "author": "素木しづ子",
                "note": "青空文庫"
              }
            },
            {
              "text": "兩手の指が強く硝子窓の棧にふれながら、漸く湯つぼのへりにたどりついた時、母親のくんで流すお湯は、彼女の足の裏をおびえるやうに、そして快く流れたのであつた。",
              "citation": {
                "source": "三十三の死",
                "author": "素木しづ子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
