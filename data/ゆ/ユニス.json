        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "荒療治　（山本勝治氏）　ある港町の沖仲仕達を組織化しようとしてゐる一人のコンミユニストが、大事な仕事を前にして自分の固い決意の弛緩をふと意識する。",
              "citation": {
                "source": "『戰旗』『文藝戰線』七月號創作評",
                "author": "-------------------------------------------------------",
                "note": "青空文庫"
              }
            },
            {
              "text": "青野季吉氏はつい二年前に、「コンミユニストの文学観はたしかにまだ組織されてゐない、……プロレタリアの文学観の建設は今日、世界の共同の仕事なのである。",
              "citation": {
                "source": "諸家の芸術価値理論の批判",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時代にかの偉大なアラビア人の天文学者イブン・ユニス（Ibn Junis）が活動していてこの人はガリレオより六〇〇年余の昔既に時間の測定に振子を使った。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは勿論コムミユニスト治下のロシアにあつた話である。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕も亦、――僕は或は便宜上のコムミユニストか何かに変るかも知れない。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユニス・テイツチエンズはずつと新しい。",
              "citation": {
                "source": "パステルの龍",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜなら、あるコンミユニストよりハイカラなインペリアリストがゐるから。",
              "citation": {
                "source": "『ハイカラ』といふこと",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "と言ふとコムミユニストですかさあ！",
              "citation": {
                "source": "山之口貘詩集",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
