        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――ユトリオ張りの油絵が一枚、なげしに朱い槍一本、六角型の窓の向うには、水の止まっている大きな噴水があった。",
              "citation": {
                "source": "魚の序文",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁のモジリアニも、ユトリオもディフィも、おそろしく退屈な色に褪めてしまって、私は、与一が毎朝出掛けて行くと、一日中呆んやり庭で暮らした。",
              "citation": {
                "source": "清貧の書",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハガル、ユトリオ、ラゴリオ等々の絵画はレンズとフィルムの見かた、電気の情趣を受け入れている。",
              "citation": {
                "source": "芸術の人間学的考察",
                "author": "中井正一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
