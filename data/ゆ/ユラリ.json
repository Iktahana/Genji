        "examples": {
          "standard": [
            {
              "text": "休日の午後、ハンモックでゆらりとした時間を過ごす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "温泉に浸かって、ゆらりとした気分でリラックスした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はソファに深く座り、ゆらりとした表情で窓の外を眺めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
