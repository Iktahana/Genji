    "definitions": [
      {
        "index": 1,
        "gloss": "swaying (only once, in a large, slow motion)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "急ブレーキで、バスが大きくゆらりと揺れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は疲れからか、ゆらりと立ち上がって壁にもたれかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "風にあおられ、大きな旗がゆらりと翻った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」　龜の甲羅に浦島が腰をおろしたとみるみる龜の脊中はひろがつて疊二枚くらゐ敷けるくらゐの大きさになり、ゆらりと動いて海にはひる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆらりゆらりと、柳が揺れてゐる、時々校庭を通り過ぎるのは小使か何かで、とまれ生徒ではない。",
              "citation": {
                "source": "夏",
                "author": "〔私が貧乏で〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "人形がゆらりゆらり御叩頭をしたり、挙げた両手をぶらぶらさせながら、緩やかに廻転しながら下りて行くのは、ちょっと滑稽な感じのするものである。",
              "citation": {
                "source": "雑記（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "連れて翔けこしむらすゞめ、　　たまゆらりうと羽はりて、沈むや宙をたちまちに、　　　　りうと羽はり去りにけり。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "卯の花や威し毛ゆらり女武者。",
              "citation": {
                "source": "甲冑堂",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "心細く感じながらも、ひとりでそっと床から脱け出しまして、てらてら黒光りのする欅普請の長い廊下をこわごわお厠のほうへ、足の裏だけは、いやに冷や冷やして居りましたけれど、なにさま眠くって、まるで深い霧のなかをゆらりゆらり泳いでいるような気持ち、そのときです。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ていると、池のいちばんむこうのはしまでひろがっていって、そこの小松のかげが、ゆらりゆらりとゆれました。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その木の一番高い枝にとまりからだ中銀いろで大きく頬をふくらせ今の講義のやすみのひまを水銀のやうな月光をあびてゆらりゆらりとゐねむりしてゐるのはたしかに梟のおぢいさんでした。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その木の一番高い枝にとまりからだ中銀いろで大きく頬をふくらせ今の講義のやすみのひまを水銀のような月光をあびてゆらりゆらりといねむりしているのはたしかに梟のおじいさんでした。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "頓て本艦の間際になつたが、海は盤水を動かすがごとく、二千七百｜餘噸の巨艦ゆらり／＼と高く、低く、我が端艇は秋の木の葉のごとく波浪に跳つて、迚も左舷々梯に寄着く事が出來ない。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯と寄る浪がしら、雪なす獅子の毛の如く、別荘の二階を包んで、真蒼に光る、と見る、とこの小舟は揺上って、松の梢に、ゆらりと乗るや、尾張を越して富士山が向うに見えて、六蔵｜素天辺に仰天した。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "須臾して妻はや馬に乘りてゆらりと手綱を掻繰るに、帚は燃したり、婢の乘るべきものなし。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　亀の甲羅に浦島が腰をおろしたとみるみる亀の背中はひろがつて畳二枚くらゐ敷けるくらゐの大きさになり、ゆらりと動いて海にはひる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆらりと一揺れ大きく船がよろめいた。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見てゐると、池のいちばん向かふのはしまで、ひろがつていつて、そこの小松の影がゆらりゆらりとゆれました。",
              "citation": {
                "source": "疣",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "淡い緑の稲田の海に、ゆらりと浮いている。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "卓子の隅を座取って、身体を斜に、袴をゆらりと踏開いて腰を落しつける。",
              "citation": {
                "source": "朱日記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は波の動くがままに、右にゆらり左にゆらり無力に漂う、あの、「群集」の中の一人に過ぎないのではなかろうか。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の腕くらいの太さの枝にゆらり、一瞬、藤の花、やっぱりだめだと望を捨てた。",
              "citation": {
                "source": "狂言の神",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁と棹をつく、ゆらりと漕出す。",
              "citation": {
                "source": "彌次行",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "長刀かつぎてゆらりと出づれば、手に抗つ敵の有りとも見えず。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五　波濤、波濤、波濤、　渺たる海豹島の遠景、　暁天、　たちまち、　幕面を斜めに切って映ったロップ、　大汽船の鉄欄、　半側だけ見える巨大な通風筒、　と、ゆらりと、葉巻を啣えて出て来た支那服の北原白秋、　その顔が大きく微笑すると、微笑しつつ、いよいよ大きく、更にいよいよ大きく幕面いっぱいになる。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　東の空が白く燃え、ユラリユラリと揺れはじめました。",
              "citation": {
                "source": "いてふの実",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　東の空が白くもえ、ユラリユラリとゆれはじめました。",
              "citation": {
                "source": "いちょうの実",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "若樹の櫻が時ならぬ雪の衣を着て、雪の重みに堪へかねて、ユラリユラリと搖れるのだ、ユラリユラリと動くのだ。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "若樹の桜が時ならぬ雪の衣を着て、雪の重みに堪へかねて、ユラリユラリと揺れるのだ、ユラリユラリと動くのだ。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "その卵白色とエナメル黒のダンダラの長い長い抛物線型に伸びた触角は、宇宙間に彷徨している超時間的、超空間的の無限の波動を、自由自在の敏感さで受容れるところの……そうして受入れつつユラリユラリと桐の葉蔭で旋回しているところの……変幻極まりない鋭敏な、小さい、生きた、アンテナそのものであった。",
              "citation": {
                "source": "髪切虫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭の上の電気時計はタッタ今午後の十時をまわったばかり……横啣えをした葉巻からは、紫色の煙がユラリユラリ……何の事はない、糞勉強のヘッポコ教授が、居残りで研究をしている恰好だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてチョウド窓枠の処まで来ると、框に爪先をかけながら、又もとの垂直に返って、そのまま前後左右にユラリユラリと中心を取っていたが、やがて薄汚れた窓｜硝子の中を、影絵のようにスッと通り抜けると、真暗い廊下の空間へ一歩踏み出した。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "理窟を考えよう考えようとしたが、自分の両足の下の藍色の絨緞と、その上に散乱した料理や皿の平面が、前後左右にユラリユラリと傾きまわるばっかりで、どうしても考えを纏めることが出来なかった。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
