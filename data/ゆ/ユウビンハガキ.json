        "examples": {
          "standard": [
            {
              "text": "旅先から家族に、美しい景色の郵便はがきを送った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "懸賞に応募するため、郵便はがきに必要事項を記入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は、手描きのイラストが入った郵便はがきを集めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "やがて、一太郎君がニコニコしながら、もってきたのは、郵便はがきを縦に半分に切ったほどの、白い画用紙だったのです。",
              "citation": {
                "source": "智恵の一太郎",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
