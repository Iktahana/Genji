        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "又｜佛蘭西なる諸作家バルザツク、ユウゴオ、ゾラ、ドオデエの徒は、或は人情派の界を超えて、人間派に入れりともいふべからむが、これとてもまた近世の作家なり。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヰクトル・ユウゴオあたりの大きな魂がその国の思潮を支配すれば好いのであるが、何うも積極的方面が十分でないのを私は思はずにゐられない。",
              "citation": {
                "source": "真剣の強味",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウゴオなどにもある。",
              "citation": {
                "source": "生滅の心理",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウィリアム・ブラック、アンソニイ・ホオプなどのものもそこにあれば、ビクトル・ユウゴオやユウセン・シュウのものなどもそこにあった。",
              "citation": {
                "source": "日本橋附近",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウゴオが壮大なる史景を咏じて、台閣の風ある雄健の筆を振ひ、史乗逸話の上に叙情詩めいたる豊麗を与へたると並びて、ルコント・ドゥ・リイルは、伝説に、史蹟に、内部の精神を求めぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィクトル・ユウゴオ譬喩　　　　　　ポオル・ヴェルレエヌ主は讃むべき哉、無明の闇や、憎多き今の世にありて、われを信徒となし給ひぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏蘭西の詩はユウゴオに絵画の色を帯び、ルコント・ドゥ・リイルに彫塑の形を具へ、ヴェルレエヌに至りて音楽の声を伝へ、而して又更に陰影の匂なつかしきを捉へむとす。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳者良心　　　　　　ヴィクトル・ユウゴオ革衣纏へる児等を引具して髪おどろ色蒼ざめて、降る雨を、エホバよりカインは離り迷ひいで、夕闇の落つるがまゝに愁然と、大原の山の麓にたどりつきぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウゴオの趣味は典雅ならず、性情奔放にして狂※激浪の如くなれど、温藉静冽の気｜自からその詩を貫きたり。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィクトル・ユウゴオ　譬喩　　　　　　ポオル・ヴェルレエヌ主は讃むべき哉、無明の闇や、憎多き今の世にありて、われを信徒となし給ひぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏訳詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳者　良心　　　　　　ヴィクトル・ユウゴオ革衣纏へる児等を引具して髪おどろ色蒼ざめて、降る雨を、エホバよりカインは離り迷ひいで、夕闇の落つるがまゝに愁然と、大原の山の麓にたどりつきぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏訳詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウゴオの趣味は典雅ならず、性情奔放にして狂※激浪の如くなれど、温藉静冽の気自からその詩を貫きたり。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏訳詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウゴオが壯大なる史景を咏じて、臺閣の風ある雄健の筆を振ひ、史乘逸話の上に敍情詩めいたる豐麗を與へたると並びて、ルコント・ドゥ・リイルは、傳説に、史蹟に、内部の精神を求めぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "※クトル・ユウゴオポオル・※ルレエヌ譬喩主は讚むべき哉、無明の闇や、憎多き今の世にありて、われを信徒となし給ひぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "佛蘭西の詩はユウゴオに繪畫の色を帶び、ルコント・ドゥ・リイルに彫塑の形を具へ、※ルレエヌに至りて音樂の聲を傳へ、而して又更に陰影の匂なつかしきを捉へむとす。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "譯者※クトル・ユウゴオ良心革衣纏へる兒等を引具して髮おどろ色蒼ざめて、降る雨を、エホバよりカインは離り迷ひいで、夕闇の落つるがまゝに愁然と、大原の山の麓にたどりつきぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウゴオの趣味は典雅ならず、性情奔放にして狂※激浪の如くなれど、温藉靜冽の氣自から其詩を貫きたり。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "リユウ・デ・ゼコルの通りへ出て大学前の伊太利亜料理で午餐を済ませた後、地下電車に乗つてユウゴオの旧宅をプラス・デ・※スチル街に訪うた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウゴオを記念する小博物館として大抵の遺作、遺品、故人の著作に挿んだ絵の下絵、著作の広告に用ひた絵、其他故人に関係ある雑多の物が陳列されて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "故人の大理石像の前に「シエキスピアの家より」としてユウゴオの今年の誕生日に英国から贈つて来た花環が青｜枯れた儘捧げられて居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウゴオの手沢の存する一卓の上に故人の用ひた鵞筆と銅のインキ壺を始め、友人であつたラマルチン、アレキサンダア・ヂユウマ、ヂヨウヂ・サン三人の筆や墨壺が載せてあつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウゴオの描いた絵の多いのに驚いた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其等のユウゴオの「夢の華」が毫も不自然で無い許か、空想の天地に自適して如何にも楽し相である偉人の心境が流露して居る様に思はれた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一所の本屋の主人である、肥太つた体へこてこてと着込んだ婆さんが僕をつかまへて「新しいロスタンの脚本なんかよりユウゴオ物をお読みなさい」などと勧めるのを観ると、身内の筋が悉く弛んですつと胸が開く様な暢達な気持を覚える。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "案内者が名と小伝とを高らかに云つて呉れる中で、僕の耳にはルツソオ、ヴオルテエル、ユウゴオなどの文学者の名が強く響く。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四年前反対派の大騒ぎがあつて改葬されたゾラの棺はユウゴオと同じ龕の中に向合せに据ゑられて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二月二十七日）芝居の後　ユウゴオの百十回の誕生日（二月廿六日）の晩、文豪の遺作「楽める王」がコメデイ・フランセエズで演ぜられ、ムネ・シユリイのサン・ンの茶坊主ツリブレ、フヌウのフランソア一世と云ふ、仏蘭西現代の劇壇で全く申分の無い役割であつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜の観客には学者、芸術家、政治家が多数を占め、中には其若盛の日からユウゴオの讃美者であつたらしい白髪の貴婦人｜連も交つて居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
