        "examples": {
          "standard": [
            {
              "text": "小型セスナをチャーターして、グランドキャニオンの遊覧飛行を満喫した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ヘリコプターによる夜景の遊覧飛行は、プロポーズの定番スポットになっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "気球に乗ってサバンナの上空をゆったりと進む遊覧飛行に参加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」　夜間の遊覧飛行イルミネェーションで作られたファンタジツクな科学の尻尾、――妻にたいする愛を結びつけて、……。",
              "citation": {
                "source": "戦争のファンタジイ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからルゾン号が入港したときには、ルゾン号を見ようという群衆が、波止場にも、ビルの屋上にも、また遊覧飛行機の上にも、いっぱいみちみちていて、さかんに旗をふったり、ハンカチをふったり、すばらしい歓迎ぶりであった。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十年前、やがて月世界へ遊覧飛行ができるようになるよと予言する人があったら、その人はみんなから、ほら吹きだと思われたことであろう。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
