        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "またその唄の下に高い問答のやうな調子が長く續く所のあるのは、濱邊の聲高の生活が靜かな夕波の曲節を崩すのによく似て居るのである。",
              "citation": {
                "source": "海郷風物記",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モロコシ畑の夕日に群れて飛ぶあきつ赤し、熊谷の小畑に手紙出す、夕波の絵かきそへて。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "心ごゝろの春去りて色こと／″＼く褪めはてつ夕波寒く風たてば行衞や迷ふ花の魂名殘の薫りいつしかに水面遠く消えて行く。",
              "citation": {
                "source": "天地有情",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼雲入りて星出で、夕日は波にしづみけり、わが日わが世のあとひとつ夕波騷ぎ風あれて嗚呼老びとの影いづこ。",
              "citation": {
                "source": "天地有情",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "見よ夕波のたゆたひて、知らずや、かしこ掻曇る夜の一天、葉越にもゆる金星のものすさまじき憎しみの眼をもて瞰むかの邦を。",
              "citation": {
                "source": "エロディヤッド",
                "author": "HERODIADE",
                "note": "青空文庫"
              }
            },
            {
              "text": "阮の三兄弟も、それぞれ小舟にもどり、やがて呉用をのせて、夕波の江を漕ぎ渡って、家路についた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「夕波くらく啼く千鳥」ではじまるあの『草枕』がよほど気に入っていたらしく、もう藤村詩集をはなれて二十年以上になるが、妙にあの詩は今でもうろ憶えながら大半はおぼえている。",
              "citation": {
                "source": "詩人への註文",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○思ひ深い日もあわたゞしくすんで、夕波の高いひゞきを聞きながら、また夜の闇の迫るを感じてゐることです。",
              "citation": {
                "source": "島の便り",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "日の昏れぐれに　あはれげもなしひとすぢに　干瀬をこえ来る夕波の　ほの白ければ、あはれと言ふも干瀬海の色　いちじるしく変りたり。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "宵早くい寝て　明くるまでいねず夕波を聞きゐつゝ　ひと時眠りたり。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕凪ぎ　音となりてつたふも夕波のとゞろにつたふ家のうちに、今宵かそけく　霊まつるなり日の昏れの　おほ門はいまださゝずして、常世の祖を　待ちごころなるうからどちよろこび集ふ日のなくて　ありへしことの、さびしかりけりさかりゐて、あはれと思ふ。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕波一刻一　商売だ。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どぶり、どぶり、と耳の下で夕波が撚れる。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてただ二人きりで、赤い夕波の映えを面に対い合って、「隠岐どの」　と、何か道誉は、あらたまった。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "淡海のみゆふなみちどりながなけば心もしぬにいにしへ思ほゆ（人麿）　何と美しい一行の詩だろう。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
