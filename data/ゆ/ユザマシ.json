        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "急須で淹れたお茶を湯冷ましに移し、少し冷ます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は美しい陶器の湯冷ましをコレクションしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "湯冷ましを使うと、お茶の旨みを引き出すことができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
