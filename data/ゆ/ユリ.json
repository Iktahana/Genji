  {
    "uuid": "e57266c6-d5ed-54e8-b891-28eb4112cc00",
    "entry": "揺り",
    "reading": {
      "primary": "ゆり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
