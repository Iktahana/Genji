        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あの花の盃の中からぎらぎら光ってすきとおる蒸気が丁度水へ砂糖を溶したときのようにユラユラユラユラ空へ昇って行くでしょう。",
              "citation": {
                "source": "チュウリップの幻術",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユラユラユラユラと揺れ動く。",
              "citation": {
                "source": "怪しの館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「怖くはないかな、村正だ」　春陽にぶつかって刀身から、ユラユラユラユラと陽炎が立つ。",
              "citation": {
                "source": "首頂戴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがそいつは風船が、弁才坊の真上まで、ユラユラユラユラとやって来た時、ハッキリ了解することが出来た。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "白衣、高足駄、垂らした髪、ユラユラユラユラと歩いて行く。",
              "citation": {
                "source": "前記天満焼",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右衛門のひっさげていた大鉞で、それがこの時頭上に高く、ユラユラユラと上がったからである。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
