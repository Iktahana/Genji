        "examples": {
          "standard": [
            {
              "text": "北海道の雪まつりは、世界中から観光客が訪れる有名なイベントだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "札幌の雪まつりでは、巨大な雪像が街を彩る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "家族で初めて雪まつりに行き、その迫力に圧倒された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "……俺ちが畑は窪地の日かげ、薄暗い三角｜畑のゆきまつり、夜が明けても、日が暮れても、陰気な畑。",
              "citation": {
                "source": "畑の祭",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
