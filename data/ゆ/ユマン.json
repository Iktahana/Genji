          "literary": [
            {
              "text": "日本のは大抵古人の心に、今人の心と共通する、云はばヒユマンな閃きを捉へた、手つ取り早い作品ばかりである。",
              "citation": {
                "source": "澄江堂雑記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "初期の諸作は、「大抵、古人の心に今人の心と共通する、云はばヒユマンな閃きを捉へた、手つ取り早い作品」だつた。",
              "citation": {
                "source": "芥川龍之介論",
                "author": "――藝術家としての彼を論ず――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は、「シユマンのユウモレスク。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何という者どもだ、コルビエール、ユマン、カジミール・ペリエ、そういうのが大臣だって。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "このようにして彼の研究は結核が人間からウサギに感染させることができるとしたフランス人ヴィユマンの1865年における研究の素晴らしい実証であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
