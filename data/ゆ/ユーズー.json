          "standard": [],
          "literary": [
            {
              "text": "即ち文学からも戯作性は拒否せられ、全然ユーズーのきかない深刻空虚な献身性が文学の支柱となり、学問同様文学も亦ねころんで読めないやうなところに尊厳ができたり、ユーモアを解さぬところにマヂメさができたり、神聖奇怪な化け物となつてしまつたのである。",
              "citation": {
                "source": "娯楽奉仕の心構へ",
                "author": "――酔つてクダまく職人が心構へを説くこと――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は国民酒場へ行列したが、小さなジョッキ二つのめば充分に酩酊し、余分の券はみんな私にユーズーしたほど、酒についても無難な人物であった。",
              "citation": {
                "source": "日月様",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "支倉がまた輪をかけた能なしで、アチラの事情に即応して主人の手落ちを自分の一存で修正し主人の熱望する通商条約をまとめるだけのユーズーがきかなかった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハハ、どうもユーズーがきかねえもんだ。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
