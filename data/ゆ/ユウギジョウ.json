        "examples": {
          "standard": [
            {
              "text": "商店街の裏手にある薄暗いスマートボールの遊技場には、常連客が静かに座っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "警察は未成年者が夜遅くまで遊技場に出入りしていないか、見回りを強化している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "かつて賑わっていた駅前のパチンコ遊技場が、先月末でついに閉店した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "あるいは遊技場みたいなところに入ったのか。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
