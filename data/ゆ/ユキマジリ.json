        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "雨が雪混じりになり、急に寒くなってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "雪混じりの冷たい風が、頬を撫でていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "遠くの山肌は、雪混じりでまだら模様になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "荒れた海峡は雪混じりで蒸気船の客はとても少なかった。",
              "citation": {
                "source": "千里眼の村",
                "author": "クリスマス・ストーリー",
                "note": "青空文庫"
              }
            },
            {
              "text": "この辺だっけと、今度は、雪まじりに鳥の羽より焼屑が堆い処を見着けて、お手向にね、壜の口からお酒を一雫と思いましたが、待てよと私あ考えた、正覚坊じゃアあるめえし、鴛鴦が酒を飲むやら、飲ねえやら。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "積んだ薪の小口さえ、雪まじりに見える角の炭屋の路地を入ると、幽にそれかと思う足あとが、心ばかり飛々に凹んでいるので、まず顔を見合せながら進んで門口へ行くと、内は寂としていた。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "朧月夜にしくものぞ無き、という歌なんどは宜いが、雪まじり雨の降る夜の露営つづきは如何に強い武人であり優しい歌人であり侘の味知りの茶人である氏郷でも、木の下風は寒くして頬に知らるる雪ぞ降りけるなどは感心し無かったろう。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその晩博奕に負けてぼんやり帰ってくると、雪まじりの雨のなかに一人の男が倒れているのを見つけたので、初めは介抱してやるつもりで立ち寄ったが、かれの胴巻の重そうなのを知って、長作は急に気が変った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "化け銀杏",
                "note": "青空文庫"
              }
            },
            {
              "text": "――北の国ではモウ雪まじりのビショ／＼雨が降っている頃だ。",
              "citation": {
                "source": "独房",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪まじりに土のあらわれた街道は次第に白く変わっていた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "うどん屋の天幕の裾から、小雪まじりの冷い風が吹きぬけて来る。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペットは時々頭を窓邊に向けて、はげしい吹雪にほえたててみたけれども、窓を叩く雪まじりの風は少しも靜まらない。",
              "citation": {
                "source": "美しい犬",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "粉雪まじりの師走の風が電線にうなっていた、町はもう寝しずまって、風呂屋から流れてくる下水の湯気がどぶ板のすきまから、もやもやといてついた地面をはっていた。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、手紙の最後に書きとめられてあるこの歌を、わづかに夫の耳にはひるほどの声で口吟んだ――君知るやこゝにをみなあり二年のおもひにやせて死にはてむとす三　安藤弥生が麹町下六番町の幾島の家を訪ねたのは、粉雪まじりの雨の降るある日の午後であつた。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪まじりの寒い風は、はげしく吹きつけました。",
              "citation": {
                "source": "一本のかきの木",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "街頭へ身をさらし、雪まじりの風の吹く中で、バイオリンを弾き、悲痛の唄をうたって、道ゆく人の足を止めようとしました。",
              "citation": {
                "source": "風はささやく",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪まじりの北風の吹きつける窓の下で、弟は父親のそばでわらじを造ったり、なわをなったりしているであろう。",
              "citation": {
                "source": "波荒くとも",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえから、毎日新聞を送ってもらってありがたいが、このごろ、私が目がわるくなって、つづけて読めないし、それに、こちらは毎日みぞれや、雪まじりの風がきびしく吹いています。",
              "citation": {
                "source": "母の心",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、雪まじりの風の吹く、寒い寒い晩のことです。",
              "citation": {
                "source": "一粒の真珠",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚きあわてたガイヤアルが、その凶徴を指さしながら、「フ、フ、フ、フ……」と披露する間もあらせず、細かい吹雪まじりの突風が横なぐりに吹きつけ始めた。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから会社のタグ・ボートでユーコン河を百浬ほどのぼり、ここがクエンスローだと追いおろされたところは、菅がチョビチョビと生えた雪まじりの沼地で、骨ばかりになった雑木林と斜にかしいだ半｜潰れの木骨小屋が霧の中からぼんやりとあらわれだしている。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあたりは群れたり散ったりする人影と、甲高い罵りごえや喚きなどでわきたち、雪まじりの風に煽られて、火を焚く煙や白い温かそうな湯気が、空へまき上ったり横へ靡いたりしていた。",
              "citation": {
                "source": "柳橋物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれはよく覚えておる、粉雪まじりの風のなかで、双肌ぬぎになった彼の、筋肉のこりこりした逞しい上半身、日にやけた、髭だらけの顔、それから、炉端で炙り焼にした猪の肉を、歯でかじり取って喰べていた姿を、おれはいまでも、ありありと思いうかべることができる」　――私はあの肉は喰べませんでした。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "――折々には、雪まじりの寒風が吹いて来た。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "その巨人の氷の殿堂が、粉雪まじりの寒風の中に、厳然として立っている姿は、人界を遠く離れた土地だけに、物｜凄まじい景色である。",
              "citation": {
                "source": "永久凍土地帯",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って非常に寒く、雪まじりの強い風をまともに受けて走る時などは、いくら防寒の支度をよくして、毛布にくるまっていても、一、二時間もすれば、骨の髄まで冷え込んでしまう。",
              "citation": {
                "source": "ケリイさんのこと",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪まじりの氷片が砂礫のようにとび、面もあげられない。",
              "citation": {
                "source": "樹氷の科学",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "關東地方はといふと、武藏入間、金子郷あたりで、雪まじりの雨や雹が降つたとある。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
