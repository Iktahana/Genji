          "literary": [
            {
              "text": "寝室の窓から、彼が来たことを見ていた三十すぎのユーブカをつけた女は戸口へ廻って内から掛金をはずした。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ユーブカをつけた女は、頸を垂れ、急に改った、つつましやかな、悲しげな表情を浮べて十字を切った。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユーブカをつけた女は、次の室から、爺さんの百姓服を持ってきた。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "外套、ユーブカ〔スカート〕これに準じすべての着物だぶだぶなり。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○車中レストラン、обед 七ゾロチ　○ポーランドの百姓も、やっぱり赤や水色のユーブカをつけて、白いプラトーチクをかぶって居る。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな仕立台に向って、伯母のタマーラが田舎住居にしては白い、丸いおでこをふせて黒絹のユーブカへ飾紐をつけている。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "両手をつかまえられて元気よく円くふりまわされて逃げるに逃げられないかみさんのユーブカの中から、おかしい落しものがはじまった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
