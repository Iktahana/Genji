            {
              "text": "Ye（ユィー）【人称代名詞】［古］［Thou の複数、主格］汝等（は）。",
              "citation": {
                "source": "熟語本位英和中辞典",
                "author": "Y",
                "note": "青空文庫"
              }
            },
            {
              "text": "Yean（ユィーン）【自他動】（羊や山羊が）仔を産む。",
              "citation": {
                "source": "熟語本位英和中辞典",
                "author": "Y",
                "note": "青空文庫"
              }
            },
            {
              "text": "Yean'ling（ユィーンリング）【名】（lamb or kid）羊の仔、山羊の仔。",
              "citation": {
                "source": "熟語本位英和中辞典",
                "author": "Y",
                "note": "青空文庫"
              }
            },
            {
              "text": "Y※ar'ling（ユィーヤリング）【名】（牛馬などの）二歳児。",
              "citation": {
                "source": "熟語本位英和中辞典",
                "author": "Y",
                "note": "青空文庫"
              }
            },
            {
              "text": "Year'ly（ユィーヤリィ）【形】年々の、年一回の（試験など）。",
              "citation": {
                "source": "熟語本位英和中辞典",
                "author": "Y",
                "note": "青空文庫"
              }
            },
            {
              "text": "Yeast（ユィースト）【名】（麹の醗酵したる）酵母（もと）。",
              "citation": {
                "source": "熟語本位英和中辞典",
                "author": "Y",
                "note": "青空文庫"
              }
            }
          ]
