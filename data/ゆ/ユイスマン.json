        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『テイークの「蒼海万里の夢」だのユイスマンスの「さかさ物語」だのアイヒベルクの「学生ロマンティスト」だのゲーテの「ウェルテルの悲嘆」だのを読みたいのですか？",
              "citation": {
                "source": "浪漫趣味者として",
                "author": "―― Ibi omnis effusus labor ! ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランスあたりでも、ユイスマンスあたりに行つて自然主義の文体が一変したと言はれてゐる。",
              "citation": {
                "source": "雨の日に",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユイスマンスのやうに。",
              "citation": {
                "source": "自然",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユイスマンが『En Route』から猶奥深く入つて行つたのもそれである。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他ユイスマンスにしろ、ドストイエフスキーにしろ、ゾラにしろ、すべて恐ろしく痛苦を嘗めた。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウパツサンにもそれを認めることが出来るし、ユイスマンスにも、トルストイにも、フロオベルにもそれを認めることが出来る。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "メイテルリンクや、イブセンや、ハウプトマンなどが、いくらか足を踏み入れてはゐるが、寧ろさういふ作家の作にしての象徴よりも、モウパツサンや、トルストイやユイスマンスの心としての象徴の方に深い価値があると私は思ふ。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "メイテルリンクの運命観、自然観、それもトルストイや、フロオベルやユイスマンスの考へたものに比すれば、非常に若々しさにすぎる。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "男と女の違ひこそあれユイスマンスの『途上』をそのまゝそこに見出したやうな心持さへした。",
              "citation": {
                "source": "早春",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからユイスマンスの『ラ、カテトラル』を猛烈な表象主義の作だと言つたが、この猛烈の二字はユイスマンスを知らない証拠である。",
              "citation": {
                "source": "エンジンの響",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八八九年四月四日　ユイスマンス作「ヴアタアル姉妹」。",
              "citation": {
                "source": "懐疑的宣言",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユイスマンスの後を享け、アカデミイ・ゴンクウル会員に選ばる。",
              "citation": {
                "source": "「葡萄畑の葡萄作り」後記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユイスマンスの後をうけ、アカデミイ・ゴンクウル会員に選ばる。",
              "citation": {
                "source": "「ぶどう畑のぶどう作り」後記",
                "author": "岸田国士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユイスマン的なネオロギスム（新語趣味）やアルシアイスム（古語趣味）までが揃つてゐる。",
              "citation": {
                "source": "三島由紀夫",
                "author": "ナルシシスムの運命",
                "note": "青空文庫"
              }
            },
            {
              "text": "この兩主義の推移といふことは例を擧げて見れば、ユイスマンスの一生の經路がこれをよく語つてゐる。",
              "citation": {
                "source": "「有明集」前後",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムウアは英國に歸つてから、大に評論の筆を執り、自然主義や象徴主義を論じ、マラルメの散文詩を飜譯したり、ランボオの才を稱へたり、ヒユイスマンスの文をステンドグラスのやうだなどと云つて紹介した。",
              "citation": {
                "source": "ジヨオジ・ムウア",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "このころからマクス・ブロートとの交友が深まり、ユイスマン、フローベールなどをいっしょに読んだり、遠足に出かけたりするようになった。",
              "citation": {
                "source": "「世界文学大系58　カフカ」年譜",
                "author": "原田義人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
