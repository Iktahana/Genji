          "literary": [
            {
              "text": "「ユルティム・フォーシュルヴァンと申します。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼は実際、既に死んではいたがユルティムという弟を持っていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "名をユルティム・フォーシュルヴァンと言っていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "修道女らは少しもユルティムという名前を使わず、ジャン・ヴァルジャンをいつもも一人のフォーヴァンと呼んでいた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
