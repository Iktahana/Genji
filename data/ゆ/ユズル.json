    "definitions": [
      {
        "index": 1,
        "gloss": "to hand over",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は経営の座を息子に譲ることを決意した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "自分の知識と経験を、喜んで若い人たちに譲りたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "父は定年を機に、家業を私に譲ることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "詩が中途にして小説に席を譲るといふことは、常に余りに実利的心情を意味するものである。",
              "citation": {
                "source": "よもやまの話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "強いていおうならば北斗南面して看るという唐ようの古語にでも表現を譲るより仕方はあるまい。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの種類を列挙するのは本文の範囲以外になるから、これは他日に譲るとして、ここには専ら骨董趣味という点から見て二つの極端に位する二種の科学者を対照して見ようと思う。",
              "citation": {
                "source": "科学上の骨董趣味と温故知新",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この理想が実現せられるとして、教案を立てる際に材料と分布をどうするかという問に対しては、具体的の話は後日に譲ると云って、話頭を試験制度の問題に転じている。",
              "citation": {
                "source": "アインシュタインの教育観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこれらの点の紹介は他の機会に譲ることにしたい。",
              "citation": {
                "source": "アインシュタインの教育観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、予定の紙数の制限に近づいたので、別の機会に譲る。",
              "citation": {
                "source": "明治の戦争文学",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　幹太郎は、悪党に対して純なものの正しさを譲るまいと心がけながら云った。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの所説の哲学史的の意義については他の哲学書に譲るほかはない。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "結語　科学と文学という題のもとに考察さるべき項目はなお多数であろうが、まずこのへんで擱筆して余は他の機会に譲ることとする。",
              "citation": {
                "source": "科学と文学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば自分の祖母にやさしい言葉をかけるとか、乗合馬車で座席を譲るとかいうくらいな事でもいいが、とにかく何かしないではおかないようにするがいい」という一節がある。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの読後の感想についてはしるしたい事がいろいろあるが、この稿とは融合しない性質のものだから、それは別の機会に譲る事にした。",
              "citation": {
                "source": "笑い",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらについてはなお述べ尽くさないところもあるが、紙面の制限のためにこれまでにとどめて余事は後日に譲ることとする。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「にて」はこの場合総合の過程を読者に譲ることによって俳諧の要訣を悉しているであろう。",
              "citation": {
                "source": "俳諧の本質的概論",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七　向うへ対手に廻しては、三味線の長刀、扇子の小太刀、立向う敵手の無い、芳町育ちの、一歩を譲るまい、後を取るまい、稲葉家のお孝が、清葉ばかりを当の敵に、引くまい、退くまい、と気を揉んで、負けじとするだけ、かねてこなたが弱身なのであった。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "譲るべき途であると云ふ徹底的見地からするのと、譲るのが自己の利益だと云ふ利己的立場からするのと、意味がちがつて居ても、結果が屡同一に帰着する。",
              "citation": {
                "source": "計画",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば巨万の財産を挙げて娘の所有となし、姉の下枝に我を娶わせ後日家を譲るよう、叔母はくれぐれ遺言せしが、我等の年紀の少かりければ、得三は旧のまま一家を支配して、己が随意にぞ振舞いける。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と唐突に襖を開け、貴婦人、令嬢、列席の大一座、燈火の光、衣服の文、光彩｜燦爛たる中へ、着流に白縮緬のへこおびという無雑作なる扮装にて、目まじろきもせで悠然と通る、白髪天窓の老紳士、これは御前と一同が座を譲るこそ道理なれ。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして自分の財産を全部譲るっていう遺言状を昨日書いてよ。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この世に生きてたって仕様のない人間だからね……」「……………」「構わないから、その薬を頒けておくれよ……僕の財産の全部は内縁の妻伊奈子に譲る……っていう遺言書を書いといたら文句はないだろう……」　彼女はみるみる唇の色まで白くした。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "前言う通りこの解説は、少し後の章に譲ることにし、此処では深く触れることを避けておくが、すくなくとも表面の理由としては、丁度今言った通俗の解説が、逆に裏返されたところに事情している。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから加之と云って、皇太后の御上を云い、「猶子の恩を蒙りて、兼ねて長秋の監たり、嘗薬の事、相譲るに人無し」といい、「暫く彼の仙院の塵を継いで、偏へに此の后中も苦しかったろうが歌も苦しい。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "室の入口の両隅に寄せてあった五脚の低い椅子を夫人と女中が茶テーブルの周りに持って来る間に景子達はガルスワーシーの左側へ椅子を寄せて陽射しを自分達の顔から新来の印度女達の面上へ譲る。",
              "citation": {
                "source": "ガルスワーシーの家",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "総領の新太郎は道楽者で、長女のおとくは埼玉へ嫁いだから、両親は職人の善作というのを次女の千代の婿養子にして、暖簾を譲る肚を決め、祝言を済ませたところ、千代に男があったことを善作は知り、さまざま揉めた揚句、善作は相模屋を去ってしまった――。",
              "citation": {
                "source": "妖婦",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も覊旅歌としてはなほ『白南風』と『多磨』の期間に「白良」以外「伊豆の初夏」、「音・光・風」、「雪冠」、「渓流唱」、「水戸唱」、「河童早春賦」等の創作があつたが、これらは編輯の都合上次の集に譲ることにした。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルプスの崇厳、或は之を欠かん、然れども富嶽の優美、何ぞ大に譲るところあらん。",
              "citation": {
                "source": "富嶽の詩神を思ふ",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "確実なる年表その他は後日に譲ることにする。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラウペパの方は又ラウペパで、始めは、実力上の第一人者たるマターファに譲るつもりでいた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ勝家の甥の佐久間盛政に譲る事を断って、勝家の養子柴田伊賀守に渡すことを条件としたに過ぎない。",
              "citation": {
                "source": "賤ヶ岳合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀吉即ち、上州に於ける真田領地の中沼田を入れて、三分の二を北条に譲ることにさせ、残りの三分の一を名胡桃城と共に真田領とした。",
              "citation": {
                "source": "真田幸村",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉たちがすわるにせまいといえば、身を片寄せてゆずる、彼の母は彼を熟視して、奈々ちゃんは顔構えからしっかりしていますねいという。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to give up (e.g. one's seat)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "満員電車ではお年寄りに席を譲るのがマナーだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は困っている人を見て、自分の番を譲った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「すみません、急いでいるので先を譲っていただけませんか？」と声をかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "to yield",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "交通渋滞で、後続車に道を譲るために路肩に寄った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "会議では、他の人の意見を尊重し、時には自分の主張を譲ることも必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は常に自分の利益よりも他者を優先し、道を譲る人だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 4,
        "gloss": "to sell",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "私はコレクションの一部を、他の収集家に譲ることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は長年大切にしていたカメラを友人に譲った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「もしよかったら、この本を譲るよ」と、読書好きの友人が言ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 5,
        "gloss": "to postpone",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の体調が優れないので、今日の打ち合わせは明日に譲ることにしよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今回は君にその役目を譲るよ、また次の機会に頑張るから。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "納期が厳しいので、この仕事は他のチームに譲るしかなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
