[
  {
    "uuid": "aee0262c-22af-5fae-b2fa-80f3f417e1e5",
    "entry": "強請り",
    "reading": {
      "primary": "ゆすり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
