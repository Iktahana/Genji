          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "有事の際には、避難経路を速やかに確認することが重要です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "政府は、有事への備えとして、食料や水の備蓄を増やす計画だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「備えあれば憂いなし」という言葉通り、有事の備えは万全にしておくべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "何といってもいったん有事の際に、実際に夫子の役に立ち得るのはおれなのだ。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "有事の日に使用すべき切り札だ。",
              "citation": {
                "source": "Ｍ侯爵と写真師",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "八万騎旗本が本来の面目使命は、一朝有事の際に、上将軍家のお旗本を守り固めるのがその本務です。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを訓練して、一旦有事のときに使うときは、その偉力は実に素晴らしいものである。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "平生同志として御交際を願っておいて、有事の秋に仲間はずれにされるなど、心外千万でござる。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわゆるマジノ延長線は紙上計画に止まり大体有事の日、工事に取りかかる考えであったが、開戦後は労働力の不足等の関係で大して工事を施されていなかった。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "第五章　戦争参加兵力の増加と国軍編制（軍制）第一節　兵役　火器の使用に依って新しい戦術が生まれて来た文芸復興の時代は小邦連立の状態であり、平常から軍隊を養う事は困難で有事の場合兵隊を傭って来る有様であったが、国家の力が増大するにつれ自ら常備の傭兵軍を保有する事となった。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "有事の場合必要に応じてその配置の統制も出来る。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "有事の日は、日本陸軍の主力は満州国を基地として作戦する事自明であるが、その厖大な作戦資材、特に弾薬、爆薬、燃料等は満州国で補給し得るようにせねばならない。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来暗殺等之所業、全以府藩県正籍に列候者には不可有事に候。",
              "citation": {
                "source": "津下四郎左衛門",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「公方様益御安泰に被為在、難有事に御坐候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨年頃に（も今年）今日有事ハ相分り申候故ニ、存意書を認候て家兄ニも出し、親類共ニも相談致しくれ候。",
              "citation": {
                "source": "手紙",
                "author": "文久三年八月十九日　川原塚茂太郎あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "万一有事のとき、ナイルの水源を閉塞するためにかくれている。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "故国一朝有事の際の、破天荒な電撃――。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾人は東方における有事の日、その鉄道は、わが辺境を掩護するため、軍事上決してこれを軽忽に付すべからざるを警告せんと欲す。",
              "citation": {
                "source": "新疆所感",
                "author": "日野強",
                "note": "青空文庫"
              }
            },
            {
              "text": "想うに、男子侮辱に報ゆるに侮辱を以てするは理の当然なりと雖も、苟も陛下の股肱として、一朝有事の秋、云々という式に、その腕力沙汰の如きを一方で吹聴し、一方で申訳的に「反省」してみせるというやり方が、そう珍らしくはなかつた。",
              "citation": {
                "source": "いわゆる「反省」は我々を救うか",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "有事の時に至り、十に八九は履行せらるゝものなり。",
              "citation": {
                "source": "遺訓",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　凡作事、須要有事天之心。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤原定家の日記「明月記」嘉禄元年三月十二日条に、南京下人説云、奈良北山濫僧長吏法師（非其病、容儀優美法師）仮例人姿、発艶言、掠‐取尋常家々女子、已及三人之間、漸有事聞、欲焼‐払其住所之間、欲迯去。",
              "citation": {
                "source": "濫僧考補遺",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一朝有事、錦旗｜翻えらば、よろしく大義親を滅し、京師に馳せつけ、禁裏を守護し、誓って誤りあるべからず、扶桑は神国、皇統は連綿、万民拝すべきは一｜方に在す、帝を置いてあるべからざるなり、子々孫々に伝うべき一条」　こういう、意味の文章であった。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代の西洋藝術はとかく「有事」に執し異常に走る傾きが見えるのではないか。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとよりこれは「有事」の対辞ではない。",
              "citation": {
                "source": "改めて民藝について",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "有事弟子服其労、有酒食先生饌、曾以是為孝乎。",
              "citation": {
                "source": "謀叛論（草稿）",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴殿も知悉されている如く、護衛をその姿のまま保ち多くの餌にて養う要なく、いざ有事の際には大いに用い得る為なり。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "その句はこうだった：「貴殿も知悉されている如く、護衛をその姿のまま保ち多くの餌にて養う要なく、いざ有事の際には大いに用い得る為なり。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "有事の際｜咄嗟の間にその国民の安寧秩序を保全する能力は、日本を措いて抑々何処に求むべきであろう。",
              "citation": {
                "source": "三たび東方の平和を論ず",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            },
            {
              "text": "剣道精神と申すものは、かかる有事の秋にこそ、発揚すべきもの。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "王女はこういうじゆうじざいな魔法の力をもっているのです。",
              "citation": {
                "source": "ぶくぶく長々火の目小僧",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "とみ　　ひゆうじこつけ……！",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年は一人かなしく、松茸のじゆうじゆう焼けるのを見てゐる。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
