  {
    "uuid": "e14e6d15-c807-5659-b5cc-2af91974ec75",
    "entry": "ユトリ",
    "reading": {
      "primary": "ゆとり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "壁をみるとユトリロの風景の複製と、誰のだか知れない裸かの女三人が浅瀬でボートに乗移らうとしてゐる絵とが掛かつてゐる。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも、キザだね」「ユトリロ」　私は、ほとんど無意識にそれを言った。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近十年間のあいつの絵は、へんに俗っぽくて、みな駄目」「ユトリロだけじゃないんでしょう？",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "句作の余裕――句材があってもそれを句として発表するだけの心のユトリがありません。",
              "citation": {
                "source": "雑信（二）",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "（十一月四日）−−−−−−−−−−−−−−−−−−−−−−−−−−大観とユトリロ　横山大観氏の「海と山に因んだ」二十点の個人展を見た。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は大観の「海に因んだ作品」をみてゐて、ふつと仏蘭西の画家ユトリロを想ひ起した。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "大観とユトリロとどんな連絡があるだらう。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "今から数年ももつと前であつたらう、福島コレクションでみた展覧会で見たユトリロは、その作品の制作方法の精神的段階が、あまりに日本的であつたので、私は吃驚りしたことがある。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "大観の「海」はユトリロの風景とその方法の上に共通点がたしかにある。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユトリロのその絵といふのは河を隔てて見える三階建程の建物で、コンミニストの本部を描いたものだといふ。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユトリロはコンミニストの本部を描いたことを、大観が海山の風景を描き、その売上げを聖戦の資に献じたといふこととをいまここに論じようといふのではない。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "不思議なことには、ユトリロの油絵の方法と、大観の日本画の方法とがまことに良く似てゐたといふことを、問題として採りあげてみたいと思ふのである。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の洋画家の粗雑な油絵の具の扱ひ方の乱暴極まるものを許り見馴れてゐる私にとつては、ユトリロがおツユたつぷりで、それを根気よく重ねてゐる、柔らかい作品をみて、これこそ真個うの油絵で、日本の洋画家は油絵を描くどころか、油絵といふ材料を満足に使ひこなせてゐないのだと痛感したものであつた。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "腋の下の縫い目などに十分のユトリと巧妙味を見せているところだの、上衣に並んだ十個の鉄釦と、ズボンのふくらみとの釣合いに五分の隙もないところなぞを見ただけでも、たしかに外国仕立で、しかもこの種類の服装を扱い慣れた専門家の手にかけたものと判断しなければならぬ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもザックバランの対等の資格で割り込んで行って、睨み合い同志の情をつくさせ、義をつくさせて、相互の気分にユトリを作らせ、お互い同志が自分の馬鹿にウスウス気付いたところを見計らってワッと笑わせて、万事ＯＫの博多二輪加にして行く手腕に至っては、制電の機、無縫の術、トテモ人間｜業とは思えなかった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "暮しのユトリは考えのユトリをも与えているのです。",
              "citation": {
                "source": "「我らの誌上相談」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、暮しのユトリと云ったところで、中流家庭の小さい安定などというものは今日ドシドシ崩れ、プロレタリアの陣営に加わって来ている。",
              "citation": {
                "source": "「我らの誌上相談」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ユトリオ張りの油絵が一枚、なげしに朱い槍一本、六角型の窓の向うには、水の止まっている大きな噴水があった。",
              "citation": {
                "source": "魚の序文",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁のモジリアニも、ユトリオもディフィも、おそろしく退屈な色に褪めてしまって、私は、与一が毎朝出掛けて行くと、一日中呆んやり庭で暮らした。",
              "citation": {
                "source": "清貧の書",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは童心的で、そして技巧がないようではあるがそれが完全な絵にまで、そして充分の芸術にまで到着して、今ではルオーとかユトリロとかいう格にまで並んでいる。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるでちがうけれども、ここにユトリロの書いた雪ばれの絵のハガキがあります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユトリロとしては心情的な作品ね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月七日　〔巣鴨拘置所の顕治宛　駒込林町より（ユトリロ筆「雪のエグリーズ」の絵はがき）〕　十一月七日。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "マチスやユトリロの名画は、日ごろは特定の個人に秘蔵されていて、盗まれ横領にあった騒ぎではじめてわれわれ人民の耳目にふれて来る。",
              "citation": {
                "source": "国宝",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日も靄が深く、ルツァーンの町をはなれると、いくらか明るいと思ったが、ロートゼー Rotsee やツークの湖水 Zuger See も、まっ白な中に、水をちらりとながめたばかり、ツューリッヒも同じようで、ユトリベルグ Uetlibberg, 862m. の展望台も、登って見る気にはならなかった。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "日はユトリベルクの上に沈んで、向う岸にうねうね並ぶ丘の上には、ほんのりと紅みを帯びた夕雲が、折り重なって湖水の水をのぞき込む。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵馬もこのごろは、世間を見ているから、それとなく粋を通すというような、ユトリが出来たのかも知れません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は私で、こんなユトリロ好みの風景のうちに新鮮な喜びを見出している。",
              "citation": {
                "source": "旅の絵",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
