        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何れも決しておいしいものでは無いが、シヒナやユリヌカに比べると、カシラはまだそれでも上等の部であつた。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "イロヌカ　米の碎けを石見の邑智郡の一部でイロヌカといふのはユリヌカであつた。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ユリヌカと謂つて居る土地も此地方には多い。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれも決しておいしいものではないが、シイナやユリヌカに比べると、カシラはまだそれでも上等の部であった。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "イロヌカ　米の砕けを石見の邑智郡の一部でイロヌカというのはユリヌカであった。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "またユリヌカといっている土地もこの地方には多い。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
