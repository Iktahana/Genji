        "examples": {
          "standard": [
            {
              "text": "孵化器の中には、たくさんの有精卵が並べられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この鶏が産んだ卵は、有精卵なのでヒヨコが生まれる可能性がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "スーパーで売られている卵は、ほとんどが無精卵で有精卵は少ない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ヤマギシの卵は有精卵であり、殻は固く黄味にははりがある。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして生産された有精卵、食肉、牛乳、野菜などを、実顕地外での常識でいう「消費者」に「販売」することを、ヤマギシでは「活用者」に「供給」するという。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
