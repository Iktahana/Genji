  {
    "uuid": "f981055e-7463-5ced-b0a6-41e860cc21dc",
    "entry": "ユ",
    "reading": {
      "primary": "ゆ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
