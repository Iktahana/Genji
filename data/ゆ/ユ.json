    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すもゝ実るみなみ独逸のたかき国の中にありといふミユンヘンの町　その語句に於て着想に於て、その題目に於て、何等の巧みも新しみもあるのではない。",
              "citation": {
                "source": "歌の潤い",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば「中」チウ→チュー、「いう」イウ→ユー、「嬉しう」ウレシウ→ウレシュー。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ユ」も「ヨ」も今と同じであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポール・ヴァレリーの『ユーパリノスあるいは建築家』のうちで、メガラ生れの建築家ユーパリノスは次のようにいっている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼がこの文章の形式を選んだのは、一つには彼の肉体が病弱で、体系を有する大論文を書くに適しなかつた為もあらうが、実にはこの形式の表現が、彼のユニイクな直覚的の詩想や哲学と適応して居り、それが唯一最善の方法であつたからである。",
              "citation": {
                "source": "ニイチェに就いての雑感",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」※クトル・ユウゴウの言葉そのものが、その中にひそんでゐる。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚この詩集を書いた當時、私はシヨーペンハウエルに惑溺してゐたので、あの意志否定の哲學に本質してゐる、厭世的な無爲のアンニユイ、小乘佛教的な寂滅爲樂の厭世感が、自から詩の情想の底に漂つてゐる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああマルセーユ、マルセーユ、マルセーユ……。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがしかし、我等の時代のインテリゼンスは、その蕭條たる廢跡の中に、過渡期のユニイクな文化を眺め、津津として盡きない興味をおぼえるのである。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれを特に意識して、自家の藝術や詩の特色としたものが、西洋の所謂シユル・レアリズム（超現實派）である。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "貸家札　　これも前と同じく、夢の潛在意識を書いたシユル・レアリズム風の作品である。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし事情が許されるならば、女を抱き乍らシヨパンのアンプロンプチユを聴くことも自由である。",
              "citation": {
                "source": "ラヂオ漫談",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、この兄弟よ、ぷうしきんの徒よ、爾は愛するユダである。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばユーゴーやジューマの浪漫派小説は、専ら広い人生社会を書いているのに、定評はこれを主観派のものに見ている。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば前の例において、西行の歌やユーゴーの小説やが、外界の自然や、社会を題材としたものであるにかかわらず、それの批判が、いつも主観的と評するのは、表現の態度が感情的で、作家の情緒や道徳感やで、世界を情味ぶかく見ているからである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏蘭西革命当時の狂児でなくとも、あのマルセーユの歌を聴いて狂熱し、街路に突進しないものがどこにあろうか。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして各々の主観的文学者は、各々の特殊な観念から、各自の「夢」と「ユートピア」とを構想し、それぞれの善き世界を造ろうと考えている。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚当時からのことをいろいろ回想してみると、妻に対しての気のどくな心持ち、しゅうとしゅうとめに対して面目ない心持ち、いちいち自分をくるしめるのである。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはせっかくのご出陣ですが、じつはそのちょっと東京へいってくるつもりで……はなはだ残念だが……」「いやそりゃ残念ですな、日帰りですか」「今夜は帰れません」「それじゃきょうじゅうに東京へいけばえい。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "病気は胃癌だといわれて、家じゅう泣きの涙でいた。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互にしばらく黙している内にも、予は我に返って考えるとなく考えた、この問題については最少し聞いておかねばならぬ、こう思ついたので様子を測って、ただ今のお話について最少し伺っておきたいと思いますが、話をしても宜しゅうございますか。",
              "citation": {
                "source": "竹乃里人",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうする詮も知らずに着物をあたためてはあてがい、あたためてはあてがってるのみ、家じゅう皆立って手にすることがなくうろうろしてる。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「坂部さんが、坂部さんが」　という声は、家じゅうに息を殺させた。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "村一番の忌森で村じゅうから羨ましがられて居る。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "かわいがったのを恩に着せるではないが、もとを云えば他人だけれど、乳呑児の時から、民子はしょっちゅう家へきて居て今の政夫と二つの乳房を一つ宛含ませて居た位、お増がきてからもあの通りで、二つのものは一つ宛四つのものは二つ宛、着物を拵えてもあれに一枚これに一枚と少しも分け隔てをせないできた。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は冬で鰈のしゅんだ。",
              "citation": {
                "source": "かれいの贈物",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間は年が年じゅう、朝から晩まで、しかめ面して働いてばかりいられるものではない。",
              "citation": {
                "source": "祇園の枝垂桜",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその岸側でなく、平坦地にあるものは、浸蝕力を逞しゅうすることが出来ないで、雪堤となって、一定の高さに達すると風に吹き落されてしまうのである。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロッパス（石炭運び）は、石炭庫の中で、頭じゅうをこぶだらけにするのを、どうしても免れるわけには行かなかった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブリッジにいたコーターマスターの小倉が、何かわからぬことを、からだじゅうで怒鳴りながら、物すごい勢いでブリッジから飛びおりて来て、サロンデッキを艫の方へかけて行って、そのタラップをまた飛びおりた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
