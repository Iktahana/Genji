    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "したがつてその輸入者である詩人といふ連中は、日本の文學者の中でいちばん氣質的に西洋臭く、身體の中からバタの臭ひがするやうなハイカラ人種に限られてゐる。",
              "citation": {
                "source": "詩に告別した室生犀星君へ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "警戒兵としての経験からくるある直感で、ワーシカは、すぐ、労働組合の労働者ではなく、密輸入者の橇であると神経に感じた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "密輸入者の背後には、その商品を提供する哈爾賓のブルジョアが控えているばかりではなかった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月に入って、密輸入者はどうしたのか、ふッと一人も発見されなくなった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "密輸入者はどうしたんだろう。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "密輸入者が国外へ持ちだしたルーブル紙幣を金貨に換える換え場がなくなったのだ。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥坊か、密輸入者か故買者か。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの二倍も真珠が隠されていたとは、実に喰いついても飽き足りなき老耄密輸入者レッド！",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――こんな風にして、密輸入者レッド老人とワイトマン税関吏の追いかけごっこを書いてゆくと、何処まで行ってもキリがない。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "話対手の年寄達もいるし、彼女達を聴手とすれば、祖母は最新知識の輸入者となれた。",
              "citation": {
                "source": "祖母のために",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時の文筆家は、実際に新興ブルジョアジーが最も必要とした文明開化の輸入者、供給者、啓蒙者であった。",
              "citation": {
                "source": "文学における今日の日本的なるもの",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "このローマン主義の輸入者はドイツ生れのスタッフェルト A. W. Staffeldt で、一時はエー※ル以來の大抒情詩人と言はれましたが、間もなく、その感化を受けたエーレンシュレーゲル 〔Oehlenschla:ger〕 にすつかり壓倒されて了ひました。",
              "citation": {
                "source": "スカンヂナヴィア文學概觀",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前はおれたちを何だと思ってるんだい」「さあ、何だろうなあ……盗賊か、海賊か、密輸入者か、むほん人か……」「はははは、あたったよ、実は海賊なんだよ。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにおいて、彼らは急にわが国にはわが国独特の目標がなければならぬということを高調するに至りましたけれども、元来単なる模倣者、輸入者たるにすぎざりし彼らには遺憾ながら創造力がとぼしい。",
              "citation": {
                "source": "役人の頭",
                "author": "末弘厳太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄の平生密輸入者たちに黄老爺と呼ばれていた話、又｜湘譚の或｜商人から三千元を強奪した話、又｜腿に弾丸を受けた樊阿七と言う副頭目を肩に蘆林譚を泳ぎ越した話、又｜岳州の或山道に十二人の歩兵を射倒した話、――譚は殆ど黄六一を崇拝しているのかと思う位、熱心にそんなことを話しつづけた。",
              "citation": {
                "source": "湖南の扇",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、「ベンボー提督屋」の先の方の側で野良仕事をしていた人たちの中には、見慣れない男が何人も街道にいるのを見て、それを密輸入者だと思って逃げ出したことがあるのを、思い出す者もあったし、また、少くとも一人は、キット入江と言っているところに小さな帆船を一艘見たことがあった。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　設楽神楽の輸入者早川さんの調査によつて訣つたのですが、こゝには元、三日三夜に亘る神楽があつたので、現在の花祭りは其一部分であると言はれてゐるのです。",
              "citation": {
                "source": "山の霜月舞",
                "author": "――花祭り解説――",
                "note": "青空文庫"
              }
            },
            {
              "text": "福沢という人は別にこれという哲学的の著書のあるわけでもなく、何ら哲学的思索の形跡は認められないけれども、しかし西洋文明の輸入者として、また広く当時社会の先覚者として思想界に大きな影響を及ぼした人であるからには、哲学史の上から見てもけっして看過することのできない人物であると思う。",
              "citation": {
                "source": "明治哲学界の回顧",
                "author": "序論",
                "note": "青空文庫"
              }
            },
            {
              "text": "密猟者は密輸入者とともに、きわめて盗賊に近いものである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "密猟者は森林中に住み、密輸入者は山中もしくは海上に住む。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして密輸入者らを火あぶりにし貨幣｜贋造者らを釜揚げにする時代において、カルタ札の上に描かれたそれらの復讐ほど、世に痛むべきものは存しない。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "商業国たるイギリスでは、ドーヴァーの海岸で密輸入者を一人捕えると、それを実例として首吊りにし、実例として首吊台にさらしておく。",
              "citation": {
                "source": "死刑囚最後の日",
                "author": "LE DERNIER JOUR D'UN CONDAMNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝石の密輸入者は、しばしば肉を割いてその中へ隠し、上から繃帯をして、税関の眼をゴマ化すことがあるそうだ。",
              "citation": {
                "source": "呪の金剛石",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局悪い酒を高く飲ませて密輸入者の腹を肥す丈けのことですよ。",
              "citation": {
                "source": "社長秘書",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
