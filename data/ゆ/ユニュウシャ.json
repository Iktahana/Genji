  {
    "uuid": "dfc4ce14-2bab-5869-85d4-3b6f61ee5543",
    "entry": "輸入者",
    "reading": {
      "primary": "ゆにゅうしゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
