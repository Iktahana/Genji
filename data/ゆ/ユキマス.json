          "literary": [
            {
              "text": "アルヒ　アサカラ　ヨイテンキヤマヘ　ユキマス　シバカリニ　このお爺さんの楽しみは、お天気のよい日、腰に一瓢をさげて、剣山にのぼり、たきぎを拾ひ集める事である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルヒ　アサカラ　ヨイテンキヤマヘ　ユキマス　シバカリニ　このお爺さんの樂しみは、お天氣のよい日、腰に一瓢をさげて、劍山にのぼり、たきぎを拾ひ集める事である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "交番ニユキマスト、カワイラシイ女ノ子ノオマワリサンガヰテ、帳面ヲシラベテクレマシタガ、サツパリ玉ネギサンノスンデヰル村トイフノガ分リマセンデシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナミハ　ジヤブリ、サラ、サラ、ト　ジロウノ　ハダカノアシニ　カカツテハ　ヒイテユキマス。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　マイニチノヤウニ　カメコオバサンハ　マルコオバサンノ　トコロヘ　サウダンニ　ユキマス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピイ……トフヱヲ　ナラシテ、シロイ　ケムリヲ　　　　ダシタリ、クロイ　ケムリヲハイタリ、テッキヨウヲ　ワタッテ、トンネルヲ　ヌケテ、マタトンネルヘ　ハイッテ、ドンドン　ハシッテ　ユキマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンシンバシラヤ、ハタケヤ、モリヤ、イナカヤヤ、ケシキガ　ドンドンウシロヘ　ハシッテユキマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            }
