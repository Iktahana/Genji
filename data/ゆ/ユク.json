  {
    "uuid": "1f24e408-2d05-5210-a418-3b05666add7f",
    "entry": "ユク",
    "reading": {
      "primary": "ゆく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "老イヌレバ年ノ暮ユクタビゴトニ我身ヒトツト思ホユル哉　その頃もう、こんな和歌さへおつくりになつて居られたくらゐで、お生れつきとは言へ、私たちには、ただ不思議と申し上げるより他に術がございませんでした。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵ヲ、カイテユク気ナイカ。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "老イヌレバ年ノ暮ユクタビゴトニ我身ヒトツト思ホユル哉　その頃もう、こんな和歌さえおつくりになって居られたくらいで、お生れつきとは言え、私たちには、ただ不思議と申し上げるより他に術はありませんでした。",
              "citation": {
                "source": "鉄面皮",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとそれが消えたと思ふと、すぐ耳のわきに若々しい話聲がして、振り返つて見る間もなく、二人の學生服の青年が背中にリユクサツクを負つて、輕くはずむやうな足取りで通り越して行つた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "リユクサツクを背負つた學生や、さういふキビキビした若い聲は久しぶりなだけに一層だつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして今朝がたのリユクサツクの學生を思ひ出した。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツゴウワルシ　アスユク――としてあった。",
              "citation": {
                "source": "勝敗",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニ・ウエンユク（悪楡）よ去れ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "影北原白秋山嶽ノ上ヲユク雲ノ軽サ、水ニウツル山嶽ノカゲノ重サ。",
              "citation": {
                "source": "影",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツユクサの新芽は今年始めて試みたが、大に推奬するに足りるものである。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スコシ　ユクト、オカノ　上ニ　ダイクガ　オホゼイデ　大キナ　ウチヲ　タテヽ　ヰマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、カネガ　ナツテ　キヨウシツノ　マエニ　ナラビニ　ユクト、ミツルクンハ　マダ　ナイテ　ヰマス。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「フーン、ツマンナイネ、ア、シロイ　ハツパガ　トンデ　ユク」「アレハ　ハツパヂヤ　ナイコト、テフテフヨ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ　フトコロニ　コヒツジヲ　イレテ、「シカタガ　ナイカラ、コノ　コヒツジハ　オレガ　ソダテテ　ヤラウ」ト　ヒトリゴトヲ　イヒナガラ　ヤツテ　ユクウチ　トツプリ　ヒガ　クレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸友人諸門人と倶に北宋本太平御覧、我国伝ふる所の千金方、医心方等に就いて、その引く所の文を摘出し、自ら古本草経のルコンストリユクシヨンを試た。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カイモノノツゴウデトウキョウヘカエルアススグユク　　　キョウコ」　と読まれた。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて六十年間人に見られず犯されずば、ユクハ（ペルシア名）となり全形をどんな人また畜にも変じ得と。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでそこいらが何となくクスグッタクなる、コソバユクなる。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼は質物になりさうもないのではねのけたバンドつきの冬の古服を手早く身にまとひ、甲斐々々しくリユク・サツクを背中につけた。",
              "citation": {
                "source": "鶴がゐた家",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「――遠クニ見ユル村の屋根、近クニ見ユル町の軒、森ヤ林ヤ田ヤ畑、後ヘ／＼ト飛ンデユク――廻リ灯籠ノ絵ノヤウニ、変ル景色ノ面白サ、見トレテソレト知ラヌ間ニ、早クモスギル幾十里――」「何だか面白くねえな。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "洛陽城東、桃李ノ花、飛ビ来リ飛ビ去リテ誰ガ家ニカ落ツ、行ユク落花ニ逢ヒテ長ク歎息ス――まつたくわたしはそんな詩のおもひで、少しばかりの酒にたちまち酔つた。",
              "citation": {
                "source": "書斎を棄てゝ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ母ッチャハワザワザ三町モアルイドニ、四ドモ五ドモ水ヲクムニユクノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "マイバンユリオコシテイルウチニ、君チャンニハオ母ッチャノカラダガダンダンホネバッテユクノガ分ルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビンボウ人ッテ、ミンナコウヤッテ、オ父ッチャガ死ニ、オ母ッチャモ死ニ、ジブンモ死ナサレテユクモノダナンテ、何ントイウコトダロウ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして官報で及落が発表される少し前に、山田の伯父から、「サカエゴウカクシユクス」という電報を受取った。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この石段はどこであらう、その近くに居たと思はれるリユクサンブル絵画館のそれでもあらうか。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "しめやかにリユクサンブルの夕風が旅の心を吹きし思ひ出　フランスを思ひ出した歌の一つ。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫妻の巴里の宿は近代画を収めて居るリユクサンブル博物館の辺にあつたやうで、そこへは夏の日の長い巴里では夕食後に行つても尚明るく、夕風がしめやかに旅の心を吹いたのであらう。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンガ、キュウシュウヘ、ユクノデ、ワタシハ、オマエノトコロヘ、ユクカモシレマセン、タノシミニ、マッテイナサイ――母よりの手紙。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
