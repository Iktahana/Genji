        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのときうしろからいきなり、「わん、わん、ぐわあ。",
              "citation": {
                "source": "注文の多い料理店",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さつきから線路の左がはで、ぐわあん、ぐわあんとうなつてゐたでんしんばしらの列が大威張りで一ぺんに北のはうへ歩きだしました。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍歌はただのぐわあんぐわあんといふうなりに変つてしまひました。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "野鴨が一羽ぐわあと鳴いて飛び立ち、続いてまた一羽また一羽と、間もなく沼の全表面の上には鳥の大群が空中に啼き叫びながら輸を描いて飛び※った。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "此は二つながら一つで、愛称のぐわあは心理的に言ふのであつて、小観念を表す方は、差等観を出してゐるのである。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　「ぐわあ」と「がま」と首里の巫女「大阿武志良礼」は代々｜久高氏の女性を出す、極めて古い為来りであつた。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "がまは後代普通にぐわあ（小）となつた語である。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "日琉共に、愛玩の意を持つた子・ぐわあがある場合には、「何子」「何ぐわあ」と言つた形で、正語序の「小何」「子何」に当る意義を示す。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "琉球の方で言ふと、犬ぐわあ（犬小）が「小犬」であり、橋小が「小橋」であることを通例としてゐる。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "小は、く・ぐ（＜こ・ご）であるから、ぐわあと音韻上関係がありさうに見えるが、此は、別の語である。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐわあは之と別に成り立つた語で、古くはがまであつたらしい。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "露の音すら耳だつ暁方の静寂を破って、ふいに、ぐわあん！",
              "citation": {
                "source": "山浦清麿",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐわあん――と地盤の壊れるような音がして、白い水のはねあがった光が闇をまっ二つに割った。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「…………」　果たして、ぐわあん！",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　駒脚を止めて見廻したとたんに、ぐわあん！",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
