          "literary": [
            {
              "text": "一年の三分の二が過ぎて、王さまの娘はいちどに三人の男の子を産み、そこへグラーニャ・オーイ(*2)がたずねてきて、娘に手と足を生やし、こう言った。",
              "citation": {
                "source": "木のウィリアム",
                "author": "WILLIAM OF THE TREE",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘はグラーニャ・オーイが言ったことをすっかり話した。",
              "citation": {
                "source": "木のウィリアム",
                "author": "WILLIAM OF THE TREE",
                "note": "青空文庫"
              }
            },
            {
              "text": "原注によれば、グラーニャ・オーイはおそらく「処女グラーニャ」の意。",
              "citation": {
                "source": "木のウィリアム",
                "author": "WILLIAM OF THE TREE",
                "note": "青空文庫"
              }
            }
          ]
