          "literary": [
            {
              "text": "アレクサンドル・グリゴーリッチ、この男に見せてやってくれたまえ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから庭番とも、ザミョートフ氏――ほら、あのアレクサンドル・グリゴーリッチ、つまりここの警察の事務官とも、それから最後にパーシェンカとも知り合いになった――これなんかは全く僕の功労に対する月桂冠だね。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、ザミョートフはここにおりません――お気の毒さま、さよう、われわれはアレクサンドル・グリゴーリッチを失いましたよ！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
