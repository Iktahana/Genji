[
  {
    "uuid": "3ebf37e3-2a7d-5d72-adbb-b05ef36d6aa8",
    "entry": "グビグビ",
    "reading": {
      "primary": "グビグビ",
      "alternatives": [
        "ぐびぐび",
        "グビリグビリ",
        "ぐびりぐびり"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "副詞-と"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "in loud gulps (esp. of alcohol)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "暑い夏の日、彼は冷たいビールをジョッキでグビグビと飲んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "運動の後は喉が渇き、水をグビグビと一気に飲み干した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは牛乳をグビグビと勢いよく飲んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」と、彼は土器の水呑みでグビグビやりながら語をついだ。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "久助はグビグビと咽喉を鳴らした。",
              "citation": {
                "source": "忠僕",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は喉をグビグビ云わせながら家へ帰った。",
              "citation": {
                "source": "罠に掛った人",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か言おうとして咽喉をグビグビさせたけれど、幸いに、ちょうどその時に合図の花火が揚りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "お銀様の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うん」　うなずいてグビグビと一気にあおって、「サ、お前たちも大きいものでどんどんおやり」　ホホー、これは面白い。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "また新しい悲しさ腹立たしさに全身を煮え返らせながら、グビグビグビと今松は湯呑の酒を咽喉へ流し込んだ。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "――一升ビンとチヨコを持つてグビグビ飲んでゐる。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱燗を頼んでグビグビやりながら、隅の方を見ると、一人の洋服青年が、こちらに顔を向けて、ニヤニヤ笑っていた。",
              "citation": {
                "source": "猟奇の果",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしはもう、喉をグビグビ云わせながら、嬉しさに夢中になって、その髪の毛を握りしめ、グイと持上げようとした。",
              "citation": {
                "source": "白髪鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "女が立ち去った途端、少佐が部屋を横切り、ブランデー瓶を取り出し、手酌でグビグビ飲んだ。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "宅助の仲間根性が、喉をグビグビさせて怨んでいるのに、三人は朝酒の酔いを顔に発して、さいつおさえつ話の興に入っている。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
      "synonyms": [
        "ごくごく"
      ],
      "antonyms": [],
