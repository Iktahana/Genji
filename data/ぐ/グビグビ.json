  {
    "uuid": "53f2e1dd-1591-55d2-891c-43c7b3b9c75b",
    "entry": "ぐびぐび",
    "reading": {
      "primary": "ぐびぐび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして手酌で續けさまにぐびぐび飮んだ。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「来たのう、なん人じゃ……」　ちらりとふりかえって、呑みかけていた盃を、うまそうにぐびぐびと呑み干すと、しずかに益次郎は、かたわらの刀を引きよせた。",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳利をこっちへ貸してくれ」　たぐりよせるように抱えこむと、立てつづけに小次郎は、ぐびぐびあおった。",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃ、あっしも飲みますぜ」　たまっていた唾涎をのみ下すように、そこの杯洗でぐびぐびとあおってしまいました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "青眉の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず第一には、御店で舐めた酒と、長火鉢の傍でぐびぐびやった酒とは、この番頭にとって同じ経験であります。",
              "citation": {
                "source": "創作家の態度",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はお重を書斎の外に立たしておいて、自分で自分の腕を抓った後「お重、今兄さんはここを抓ったが、お前の腕もそこが痛かったろう」と尋ねたり、または室の中で茶碗の茶を自分一人で飲んでおきながら、「お重お前の咽喉は今何か飲む時のようにぐびぐび鳴りやしないか」と聞いたりしたそうである。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "嬰児は無心に手の中でぐびぐびと動いていた。",
              "citation": {
                "source": "鍛冶の母",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もし、もし」　女はぐびぐびと肩を動かした。",
              "citation": {
                "source": "魔王物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな真似のような事をしておらずに、大盃でぐびぐびと引かけたらよかろう、というのである。",
              "citation": {
                "source": "俳句はかく解しかく味う",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、ちゃんと覚えていたのが、〈毒〉の印のあるびんをぐびぐび飲むと、おそかれ早かれほぼまちがいなく毒に当たるよ、というもの。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうおり、彼の眼は優しい色をたたえて細まるし、言葉には、なんだか上顎と鼻にかかったような響が加わるし、同時にまた喉の奥で、軽くぐびぐびいうような音が、それに伴うのであった。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴下がガブリエレ・エックホオフを占有すべく決心せられた時、おそらく貴下の食道筋肉は、あたかも美味なスウプか珍貴な料理かに面した時のごとく、ぐびぐびと動き出したことだろうと思われます。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "食台のところへ行って、シャンパンを開けて、ぐびぐび勝手に飲んだ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "あと半時間は招待客が来ないので、コプリは手酌でソーダ割ブランデーをぐびぐび飲み、新品の葉巻を吸った。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "同紙がまた問うたのは、傲慢な立法議員たちが自分たちだけ専用給水を受けているのじゃないか、平民が給水制限されているのに、立法議員たちがいつものようにコーヒーやお茶、ウイスキーや水をぐびぐび飲んでいるんじゃないか。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラハミはしばらく座ってぼんやり演奏を眺めながら、ぐびぐび飲んだ。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐびぐびと酒杯をかさねて、「武士は、こちとらの柄にゃ向かない。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "曹操は、杯をもつと、ぐびぐび飲んでいた。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
