        "examples": {
          "standard": [
            {
              "text": "ソラマメは偶数羽状複葉を持ち、葉の先端が巻きひげになっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "植物図鑑には偶数羽状複葉の特徴として、頂小葉を持たない点が挙げられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "その樹木の葉は偶数羽状複葉で、左右対称に小葉が並んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "葉は短柄を有して枝に互生し、偶数羽状複葉で長さおよそ一尺ばかり、小葉は三ないし対をなし披針形で全辺、葉質硬く平滑で光沢がある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
