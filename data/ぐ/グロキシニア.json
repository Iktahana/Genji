          "standard": [
            {
              "text": "温室には色とりどりのグロキシニアが咲き誇っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "母は毎年、美しいグロキシニアを育てるのを楽しみにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "グロキシニアの花びらはベルのような形をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "発作の後の悲しみが又犇々と迫る、深い恐怖に顫へ乍らグロキシニアと冷たい鏡を片よせて、私はまた新らしく顫へ初めた素つ裸の感覚から眼を凝らし、耳を聳て、まるで匍ひつくばつた生蕃の児のやうに生々と暗い闇の核心を凝視めた。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
