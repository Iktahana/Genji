          "literary": [
            {
              "text": "すると、頭が、あれで、どんなふうになるのかねえ、手や足がピキピキと引きつるようなカゲンになって、さ、三度四度とそれにかけられると、どんなシブトイ人間でも、そりゃもう、グナグナになってしまうんだ。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいこもちみたいなグナグナな、あんた、バックボンとか言ったな、あちらさんの前でもこちらさんの前でも、ただもうペコペコこいてるだけで、へえ、ひっこしのねえ段ではないんだから。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいつが又、ほかの事ではシャンとしているが、こんだ向う側一辺倒と言う奴で、そっちい向いたとなるとペコペコもグナグナも無い、ナメクジが塩うかぶったと同じだからねえ。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            }
          ]
        }
