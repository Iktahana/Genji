          "literary": [
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サア、飲マセチャウ、二錠グライデイヽカ知ラ」左ノ手ニ小皿ヲ持チ、右手デアダリンノ容器カラ二錠ヲ皿ノ上ニ落スト、次ニ浴室カラコップニ水ヲ運ンデ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンノ一分間グライデ、ソレカラアトハ朦朧トナッテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ十分間グライデ冷エテシマウノデ、枕元ニ熱湯ヲ運ンデ置イテタオルヲ熱シ直シテハ包ム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間グライデ直グ帰ル」「オ婆チャンモ御一緒？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
