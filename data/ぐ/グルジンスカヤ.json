          "literary": [
            {
              "text": "がグルジンスカヤ・ダローガ〔グルジア軍用道路〕は惜しかった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "チフリスへはコーカサス山脈を横断するグルジンスカヤ山道を自動車で十時間余ドライブして行く筈であった。",
              "citation": {
                "source": "石油の都バクーへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コーカサスの雄大な美を知りたいと思えば、このグルジンスカヤ山道をおいてはない。",
              "citation": {
                "source": "石油の都バクーへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、このリージン氏が明朝自分たちもグルジンスカヤ山道をチフリスへ行くから一つ仲間にならないかと申し出た。",
              "citation": {
                "source": "石油の都バクーへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
