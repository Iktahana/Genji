        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……ブ――――ン……　少女浅田シノのグザグザになった後頭部が、黒い液体をドクドクと吐き出しながらうつむいて……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……傾いだ原因はまだ判然りませんが、船底の銅版と、木板の境い目二尺に五尺ばかりグザグザに遣られただけなんです。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "左の肩と、腕と、アバラの骨がグザグザになっていたんですってさあ。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちかえりましたが大したこわれかたね、グザグザね、国男に話したら、キット大きな音がしたんだろうと云っていました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はここに思い至ると、今までのすべてがグザグザに壊れてしまうように思われた。",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
