        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どつちも、彼女の手に渡る前に、もう何人もの人手を通つて來たらしい、綴もグヅグヅになつてゐるやうな本であつたが、それでも彼女が讀んだあとといふものはよくわかるのだつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてグヅグヅの間に一｜年二年と經過して今日となツた。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だねこの子は、何をグヅグヅしてるんだ。",
              "citation": {
                "source": "小むすめ",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "グヅグヅ　シテヰルト、マタ　オユニイレラレルゾ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何をグヅグヅしとる、早く、はいんなさいと云はんか。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
