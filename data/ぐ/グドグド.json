          "literary": [
            {
              "text": "目はさめていると姉に思わせるために、頭を枕につけていながらも、口のうちでぐどぐどいうている。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆきかへり、やをら、電気車鉛だつ体をとどめてぐどぐどとかたみに語り、鬱憂の唸重げにまた軋る、熱く垂れたるひた赤き満員の札。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月二十三日（木曜）　○面会許可を貰いに行ったら、大下という代理（加藤やすみ）十日すぎにしろという、ぐどぐどと云ってことわる。",
              "citation": {
                "source": "日記",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
