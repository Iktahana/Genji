    "definitions": [
      {
        "index": 1,
        "gloss": "tediously",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はグダグダと言い訳を並べ続け、会議が一時間以上延びてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「もうグダグダ言わないで、さっさと決めよう」と彼女はテーブルをこぶしで叩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "締め切りが翌朝に迫っているのに、チームはグダグダと議論を続けて一向に結論が出なかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "切られてグダグダに膝を突いたところを、「許してやろうぞ！",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "張り詰めていた精神がこの時一時に弛んだと見えて、紫錦は気絶してグダグダと倒れた。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が一年の間にためて出来たが、まわりの方は、何だかグダグダしているという感じだ。",
              "citation": {
                "source": "日記",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "死骸のようにグダグダにされて、裏木戸から外へ抛り出されるのだ。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　愛一郎の服の襟をつかんで揺すりながら、グダグダ言っていたが、愛一郎は、はねかえそうともしないので、張合いがぬけたのか、カオルは草むらに足を投げだして、煙草をすいだした。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車が停るとＭさんは、醉つてグダグダになつている僕を肩にかつぐようにして車から引き出し、暗い露路の奧へ奧へと、角を二つばかり曲つて行き、或る家の戸をドンドン叩くと、内から女の聲がして、やがて狹いドア（――たしか、西洋式のドアでした）が内から開きました。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "lazily",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "連休中はグダグダと家でゴロゴロして、気づけば五日間が何もしないまま終わっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "二日酔いの翌朝、彼はベッドでグダグダしたまま昼過ぎまで起き上がることができなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「休日くらいグダグダさせてよ」と彼は妻の小言に半目で答えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "(boiling) to a pulp",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鍋に入れた大根がグダグダに煮えて、箸でつつくだけで崩れてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "長時間煮込みすぎた牛すじがグダグダになり、もはや原形をとどめていなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「野菜はグダグダになるくらい煮るのが好きなの、やわらかくておいしいから」とおばあちゃんが笑った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
    ],
