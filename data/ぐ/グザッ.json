        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "我々の戦術は向うのブルジョワジーのジグザッグな戦術に適確に適応して行かなければならない。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓ字型のジッグザッグ道路で、鋸の歯のような猛烈なスイッチバックの中を襞の向うへ走り去る。",
              "citation": {
                "source": "白妖",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここから上は広い谷なので大きくジッグザッグを刻みながら登れる。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてははてしがない――と見た不知火剣士の一人、つぎの間から壁越しに、ここらに源三郎がいると思うあたりへ、グザッ！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "とっさに引き抜かないと、すぐ肉がしまって容易に抜けなくなるもので、喬之助、グザッ！",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身に数千本の針を突き立てられたような刺戟、それは恰も、胃袋の辺に大穴が明いて、心臓へグザッと突入したような思いだった。",
              "citation": {
                "source": "電気風呂の怪死事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいて無言のまま横にはらってきた鬼のような左近将監の刀を、グザッと脇腹へうけて、けなげにも刀をかまえたまま、どうとばかりに、そこへ突っぷしてしまいました。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
