        "examples": {
          "standard": [
            {
              "text": "友人のグラフィックデザイナーに、ウェブサイトのロゴ作成を依頼した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女はフリーランスのグラフィックデザイナーとして、様々なプロジェクトに携わっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "良いグラフィックデザイナーは、クライアントの意図を正確に形にできる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "『ドクター・ドブズ・ジャーナル』というおかしな名前をでっち上げたのは、『ＰＣＣ』のデザイン関係の作業を一手に引き受けていたグラフィックデザイナーのリック・バカリンスキーだった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "とくに一九七〇年代以降、写植オフセット印刷がさかんになるにつれて、組版は鉛活字の物理的制約からぬけだし、グラフィック・デザイナーたちのあいだで「詰め貼り」や「詰め打ち」の手法が一般的なものになった。",
              "citation": {
                "source": "本はどのように消えてゆくのか",
                "author": "津野海太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
