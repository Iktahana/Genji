        "examples": {
          "standard": [
            {
              "text": "国境付近での他国の軍事演習に反応し、政府は即座に軍備増強を決定した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "軍備増強は国民を守るための方策だが、それがかえって周辺国の警戒を招くこともある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "最新のレーダーシステムを導入し、離島防衛のための軍備増強を段階的に進める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "さらに四年後には再軍備増強計画は倍加されて三千億になるといわれております。",
              "citation": {
                "source": "浅沼稲次郎の三つの代表的演説",
                "author": "浅沼稲次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
