          "literary": [
            {
              "text": "ただ困ったことになったと言うのは、一年もたたぬうちから、グィリノの郵便局へ通い出した。",
              "citation": {
                "source": "追放されて",
                "author": "В　ССЫЛКЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "『グィリノへ行くんだ。",
              "citation": {
                "source": "追放されて",
                "author": "В　ССЫЛКЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "』その時からというもの、まず一週に一度位はグィリノへ行って、ロシヤから金は来てやしないか問い合せるようになった。",
              "citation": {
                "source": "追放されて",
                "author": "В　ССЫЛКЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "日曜には欠かさずグィリノの教会へ二人で出掛ける。",
              "citation": {
                "source": "追放されて",
                "author": "В　ССЫЛКЕ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
