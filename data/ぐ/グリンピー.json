        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あの時分の餡はいも餡、かぼちや餡、うづら豆、グリンピース等であつた。",
              "citation": {
                "source": "ともしい日の記念",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリンピースを餡に入れた蒸饅頭。",
              "citation": {
                "source": "ともしい日の記念",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリンピースや蚕豆が、この島の名物の一つと聞いていたが、さすがにその評判に違わず、白い蝶形花冠が、旅人の目をなぐさめる。",
              "citation": {
                "source": "天草の春",
                "author": "長谷健",
                "note": "青空文庫"
              }
            },
            {
              "text": "後リンゴ二個みかん二個グリンピース一袋ガム五枚残っています。",
              "citation": {
                "source": "遺愛集",
                "author": "島秋人",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニューグランドへ行き那波氏の馳走になる、グリンピー・スープ、肉とスパゲティ、チキン・トリビルうまし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィルピカタとグリンピース、コンビネーション・サラダ食って出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブーフアラモド、グリンピースのポタアジュ、マカロニ・ナポリタン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野着、日劇の地下理髪へ行くと、ケンモホロゝな口のきゝ方で、満員と言はれ、腹を立てゝヤング迄行って理髪し、ローマイヤで、グリンピースのスープと、豚のゼリーを食ひ、日劇へ引返して、順に本読みした。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローマイヤレストランへ行ってみる、グリンピースのスープ、ぬるくてまずし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタージュ、ビールピカタ、グリンピースに、アプルパイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
