        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "愚僧がこの寺の住職を務めさせていただきます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「愚僧の知識では、その疑問にお答えできません」と僧侶は答えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "愚僧は日夜、修行に励んでおります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
