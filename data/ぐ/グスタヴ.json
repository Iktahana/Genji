          "literary": [
            {
              "text": "グスタヴ・ドオレの画は勿論、ユウジァン・スウもドクタア・クロリイも、これを小説にした。",
              "citation": {
                "source": "さまよえる猶太人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「グスタフス・アドルフス（＊スウェーデン王グスタヴ２世。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはグスタヴ王がニュルンベルクへ進撃する少し前のことであり発疹チフスは両軍にたいしてしかるべき復讐を行った。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "1632年６月にスウェーデン王グスタヴはニュルンベルクを包囲した。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
          ]
        }
