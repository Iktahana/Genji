        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "熟れすぎたバナナは、ぐちゃぐちゃで甘かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "何日も雨に濡れて、新聞紙はぐちゃぐちゃになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "フルーツサラダは長時間放置され、ぐちゃぐちゃになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "見ると、一人の変に鼻の尖った、洋服を着てわらじをはいた人が、鉄砲でもない槍でもない、おかしな光る長いものを、せなかにしょって、手にはステッキみたいな鉄槌をもって、ぼくらの魚を、ぐちゃぐちゃ掻きまわしているのだ。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山男はどうもその支那人のぐちゃぐちゃした赤い眼が、とかげのようでへんに怖くてしかたありませんでした。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　画かきはにわかにまじめになって、赤だの白だのぐちゃぐちゃついた汚ない絵の具｜箱をかついで、さっさと林の中にはいりました。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "白の麻服のせなかも汗でぐちゃぐちゃ、草にはけむりのやうな穂が出てゐました。",
              "citation": {
                "source": "革トランク",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人は丁度、五百歩ばかり離れたぐちゃぐちゃの谷地の中に住んでゐる土神で一人はいつも野原の南の方からやって来る茶いろの狐だったのです。",
              "citation": {
                "source": "土神と狐",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてぐちゃぐちゃ大股にそっちへ歩いて行って倒れてゐる木樵のからだを向ふの草はらの方へぽんと投げ出しました。",
              "citation": {
                "source": "土神と狐",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "土神はいきなり狐を地べたに投げつけてぐちゃぐちゃ四五へん踏みつけました。",
              "citation": {
                "source": "土神と狐",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると一人の変に鼻のとがった、洋服を着てわらじをはいた人が、手にはステッキみたいなものをもって、みんなの魚をぐちゃぐちゃかきまわしているのでした。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人は丁度、五百歩ばかり離れたぐちゃぐちゃの谷地の中に住んでいる土神で一人はいつも野原の南の方からやって来る茶いろの狐だったのです。",
              "citation": {
                "source": "土神ときつね",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてぐちゃぐちゃ大股にそっちへ歩いて行って倒れている木樵のからだを向うの草はらの方へぽんと投げ出しました。",
              "citation": {
                "source": "土神ときつね",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、一人の変に鼻の尖った、洋服を着てわらぢをはいた人が、鉄砲でもない槍でもない、をかしな光る長いものを、せなかにしょって、手にはステッキみたいな鉄槌をもって、ぼくらの魚を、ぐちゃぐちゃ掻きまはしてゐるのだ。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おぬいは一度のばしたその襷を、ぐちゃぐちゃに丸めて、それを柱にあてがって顔を伏せると、誰のためにとも、誰にともなく祈りたい気持でいっぱいになった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "行き止まりから数ヤード手前の土があちこち踏みつけられて一面の泥になっており、滝壺の縁にある枝や草も千切れてぐちゃぐちゃだった。",
              "citation": {
                "source": "最後の事件",
                "author": "THE FINAL PROBLEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝ゃこれ嫌いでなかんべさ」といいながら懐から折木に包んだ大福を取出して、その一つをぐちゃぐちゃに押しつぶして息気のつまるほど妻の口にあてがっていた。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのゴサン竹の傍に菖も咲けば著莪も咲く、その辺はなんだかしめっぽい処で薄暗いような感じがしている処であったが、そのしめっぽい処に菖や著莪がぐちゃぐちゃと咲いているということが、今に頭の中に深く刻み込まれておるのはどういうわけかわからん。",
              "citation": {
                "source": "初夢",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　手桶を提げて井戸に通う路は、柿の落葉で埋まった日もあり、霜溶のぐちゃぐちゃで下駄の鼻緒を切らした日もあり、夷講の朝は初雪を踏んで通いました。",
              "citation": {
                "source": "旧主人",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "○坊や　たべるの　たべゆの　○カキクケコ云えず　かあちゃんをターチャん　○いもの煮えたの御存じない　いものとぐちゃぐちゃいい、ジョジョンジナイ　ジョジョンジナイと云う。",
              "citation": {
                "source": "一九二七年春より",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私は、その紙幣と半紙とをぐちゃぐちゃにひッつかんで袂の中にねじ込んだ。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "宅に入ると、助手が運んでくれた荷物は、ぐちゃぐちゃに壊れている。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月十七日（火曜）　今日も道はぐちゃぐちゃ　モヤどうかして脚が（左）痛く、顔を洗ってきたらびっこを引いて居る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "人に踏まれることのない柵の中では、水分と日光のぬくもりで、ぐちゃぐちゃにゆるんだ地面を貫いてもう青草が見える。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐちゃぐちゃになっている書物や帳面を日に乾さねばならぬと思ったり、何と何とが焼け失せたか検べてみなければならぬと思ったりしたが、このまま塵屑にしてしまいたい気もした。",
              "citation": {
                "source": "入江のほとり",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "みみが　ながくて、　かみに　わらが　ぐちゃぐちゃ　からまってる。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の肩の辺から、枕の方へかけて、未だ彼女がいくらか、物を食べられる時に嘔吐したらしい汚物が、黒い血痕と共にグチャグチャに散ばっていた。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一つが、またぞろ、緑屋の屋根へ落ち、御叮嚀に、屋根から天井まで打ち抜き、菓子を並べてある箱の上まで、落ちて来て、硝子板と菓子とを、グチャグチャに、一緒くたにしちまったのである。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一行二日分の握飯は風呂敷に包んで若い方の剛力が背負って来たのだが、この男元来の無精者、雨が降っても蔽いもしなかったものと見え、グチャグチャに崩れた上に、雨に濡れてベトベトになっている。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯を食べるのにサラサラグチャグチャは不可ないという。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥のグチャグチャいう音と豚のゲーゲー啼く声に送られながら、彼は祭司長の家へと乗りつけた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブランカが、紺絣の筒袖着て、兵児帯しめて、メリケンコのグチャグチャしたの（名もつけ難し）をたべて、財布に五十二銭もって、そして斯くも光彩陸離なのを、どうぞどうぞ扇をあげて下さい。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝なんぞは心のある飯が出来て生米のような処もあるし、といってグチャグチャしてお粥のようでもあるし、さすがの僕も閉口して食べられません。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
