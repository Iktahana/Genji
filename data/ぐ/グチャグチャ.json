        "examples": {
          "standard": [
            {
              "text": "彼の筆跡は、ぐちゃぐちゃで読めないほどだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "パーティーの後、部屋はぐちゃぐちゃだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その画家の技法はぐちゃぐちゃで、絵の具があちこちにこすれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
