        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鹿島の神が群鹿をつかひて、惡鬼と戰はしめ給ふと聞きつる高天原、如何なる處にかと、要石を過ぎて半里ばかりゆけば、赤土と砂とまじりて、一望木立なき高原なりけり。",
              "citation": {
                "source": "鹿島詣",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "その群鹿の中に取囲まれて、人と獣とが全く友となって一味になって、悠遊寛歩する前代人の快感を想像する。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "有人奏曰、野上群鹿、無数甚多。",
              "citation": {
                "source": "奥羽地方のシシ踊りと鹿供養",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
