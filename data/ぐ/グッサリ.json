        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして弓につがえて、ひょうと放しますと、こんどこそ矢はぐっさりむかでのみけんにささりました。",
              "citation": {
                "source": "田原藤太",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "後で聞けば、硫黄でえぶし立てられた獣物の、恐る恐る穴の口元へ首を出した処をば、清五郎が待構えて一打ちに打下す鳶口、それが紛れ当りに運好くも、狐の眉間へと、ぐっさり突刺って、奴さん、ころりと文句も云わず、悲鳴と共にくたばって仕舞ったとの事。",
              "citation": {
                "source": "狐",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "額に、長い鉄のキリがぐっさりと突き刺さっていた。",
              "citation": {
                "source": "処刑の話",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
