        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イサックが悲しげに彼に握手して、　――メラ、君に贈る親愛、古いスグヤムグラの誓をもって！",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テスコかグヤトーンでも出てくるんだろうと思っていたら、黒いボディに、白いピックガードがついたフェンダーが出てきたのだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "テスコやグヤじゃなくて、フェンダーだよ」「うん、その話はきいたけど、それは、たまたまそうなっただけだろう」「たまたまって、たまたま人を殺したら、牢屋に入らなくていいわけ？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤングヤングヤングヤング」　ってね。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタピースグヤーと云って田圃に出て行って、蛙を捕って来て、その皮を剥いで、市場に持って行って売る。",
              "citation": {
                "source": "奥間巡査",
                "author": "池宮城積宝",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤリングヤネックレスヲシテナイトコロガ気ガ利イテルネ」「オ爺チャンナカ／＼分ルノネ」颯子ノ後カラオ静ガ草履ノ箱ヲ持ッテ這入ッテ来、草履ヲ取リ出シテ彼女ノ前ニ揃エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ明日ノコトヲ考エルト、イッソ今直グヤリ直シテ貰ッテ伸ルカ反ルカヲ一挙ニ決シテシマイタクモアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハ、アノイヤリングヤレースノ手袋ガ、和服デ着ケテイタ時ノヨウニハ似合ッテイナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はどこへ行っても、フルイ、ドーグヤ〔古道具屋〕と呼ばれる古物商の店に、陶器、金属及漆塗の細工、籠、刀剣、刀剣具その他あらゆる種類の古物が並べてあるのを見る。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "またカグヨ姫と結婚して生んだ子は、オホカグヤマトミの神、次にミトシの神の二神です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "次にニハツヒの神、次にアスハの神、次にハヒキの神、次にカグヤマトミの神、次にハヤマトの神、次にニハノタカツヒの神、次にオホツチの神、またの名はツチノミオヤの神の九神です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "またオホツツキタリネの王の女のカグヤ姫の命と結婚してお生みになつた御子はヲナベの王お一方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
