        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一軒ではエラリイ・クイインの「エヂプト十字架の祕密」と「ロオマ劇場事件」と「支那オレンヂの祕密」の邦譯三册を、一軒ではアガサ・クリスチイの「ハゼルムウアの殺人事件」とカアメン・エデイングトンの「撮影所殺人事件」の二原書を買ひ求めた。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」大将「ベルギ戦役マイナス十五里進軍の際スレンジングトンの街道で拾ったよ。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "この男こそ、かの有名なる偽造者にして強盗犯人たるベディッグトン以外の何者でもなかりしなり。",
              "citation": {
                "source": "株式仲買店々員",
                "author": "コナンドイル　Arthur Conan Doyle",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブレッシングトンの坂下ですが……」　非常にありがたいことには、例の人力車が私たちを待ち構えてはいたけれども、二十ヤードほどもさきにいてくれた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幻の人力車",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろあなたは、つまらない一つの現象のために、あまりに奪われ過ぎていますからな」　ちょうどその時、私たちはブレッシングトンの坂下の木蔭を進んで行った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幻の人力車",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケニングトンまで二銭宛だ。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてケニングトンに着た。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "クレオパトラやマクベス夫人に扮して名を売つた英吉利の女優ラングトリ夫人が、まだ若盛りの頃ある宴会で、その頃ちやうど倫敦を訪れて来た阿弗利加の或る王様と一緒になつた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ國内物價ノ暴騰ヲ防グト同時ニ、貿易上ノ利益ヲ國庫ニ收得スルヲ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八九一年オックスフォード板、コドリングトンの『ゼ・メラネシアンス』に、癩人島の俗譚に十の雛もてる牝鶏が雛をつれて食を求め、ギギンボ（自然薯の一種）を見付けるとその薯根｜起ち出て一雛を食うた。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他のブラマ、オーピングトン、アンダラシャン、ブリモースロック、ミルカ、コーチン、レグホンの類は鶏でない。",
              "citation": {
                "source": "探偵小説の真使命",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベンさんとは、その頃写真や手紙を屡々往復したが、一度作業服を着た私が温室の扉の前で犬と一処に写した写真を送つたら、「私のデイツク・ホイツテイングトンよ。",
              "citation": {
                "source": "悪筆",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "またこの作は、アイルランドの劇詩人ジョン・ミリングトン・シングに影響して、その作「｜海への騎者」を喚起せしめたと言はれてゐるが、それは事實であらう。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "「氷島の漁夫」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでなお津田先生に質して見ると、同先生は、この語は自分がオランダ語のブュルゲルリーク・レグト(Burgerlyk regt)の訳語として新たに作ったものであると答えられた。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでなお津田先生に質して見ると、同先生は、この語は自分がオランダ語のブュルゲルリーク・レグト（Burgerlyk regt）の訳語として新たに作ったものであると答えられた。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "無産者の教師が学校をやめたらスグト食えなくなる。",
              "citation": {
                "source": "ふもれすく",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "○レミントン〔レミングトン型タイプライター〕の会社があった。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラングトンから、水母から、貝殻から、甲足類から、彼等は人間を目的にしないでやつて来た。",
              "citation": {
                "source": "釣れない時",
                "author": "君は何を考へるか",
                "note": "青空文庫"
              }
            },
            {
              "text": "スグトツテキテオアゲシマスカラ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして握手しながらサンキウ／＼、グトバイ／＼と云つて出て行くこの老婦人を門の外迄見送つて行つた私は、意外に車が待つて居らぬのを不思議に思うて問ふた。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国にありては千八百八十八年（明治二十一年）Burlington Fine Arts Club（バアリングトン美術倶楽部）において浮世絵板物展覧会の挙ありしより同好者の団体組織せられぬ。",
              "citation": {
                "source": "江戸芸術論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "千八百九十七年（明治三十年）英国 South Kensington Museum（南ケンシングトン美術館）の役員 Edward F. Strange の簡易なる History of Japanese Wood-Engraving（『日本板画史』）出版せらる。",
              "citation": {
                "source": "江戸芸術論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八九二年に、トーマス・レヴィングトンがやって来たところである。",
              "citation": {
                "source": "地底獣国",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "レヴィングトンが、なぜここから引返したか、その理由をはじめて了解した。",
              "citation": {
                "source": "地底獣国",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "只今では大ロンドン市の一部となっているが、その頃はまだロンドンの片田舎に過ぎなかったニューイングトン・ブットが、始じめて呱々の声をあげた所で、それは一七九一年九月二十二日のことであった。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェームスは一七八六年にマーガレット・ハスウエルという一七六四年生れの女と結婚し、その後間もなくロンドンに出て来て、前記のニューイングトンに住むことになった。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "年表一七九一年　　九月二十二日　ロンドン郊外ニューイングトン・ブットに生る。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナイト Knight.ナフサリン Naphthalene.ニニューイングトン・ブット（地）Newington Buttes.ニコル（人）Nicol. ジョン・プリングル・ニコル。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "―の「化学叢話」 Conversations on Chemistry.マスケリー（人）Masquerier.マグラース（人）Magrath.マレット（人）Mallet.マルガース（人） Margath.マコーレー（人）Macauley. トーマス・バビングトン。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "『広羣芳譜』に『風土記』を引て記する所に拠れば俗九月九日ヲ尚ンデ之レヲ上九ト謂フ、茱萸ハ此日ニ到テ気烈ニシテ熟シテ色赤ク其房ヲ折テ以テ頭ニ挿ムベシ悪気ヲ辟テ冬ヲ禦グト云フ（漢文）とある。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
