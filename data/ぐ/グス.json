[
  {
    "uuid": "210fb71c-fcec-5c4e-9499-c47d2816bb94",
    "entry": "具す",
    "reading": {
      "primary": "ぐす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行"
      ],
