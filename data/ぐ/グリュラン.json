          "literary": [
            {
              "text": "彼らはグリュランと呼ばるるチーズ製造人を雇います。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリュランは日に三度組合の牛乳を受け取り、その量を合札に誌します。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄は何度もそのグリュランのおもしろい有様をくり返しまして、それがその男のための逃れ場所であることを、直接にぶしつけに説かないで自然にわからせようと願っているかのようでありました。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
