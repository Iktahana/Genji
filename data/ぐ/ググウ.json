        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」ゴーシュはねどこへどっかり倒れてすぐぐうぐうねむってしまいました。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐぐうっと、三人のからだは、うしろへ吹きとばされるように感じた。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "金属のすれあう音がして、怪塔はぐぐっ、ぐぐうっと動きはじめました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐぐうつと腹の底迄酒が沁みると、胸に込み上て來る醉と共に、何か心にたまつて居る事を、殘らず吐出してしまひ度くなつた。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
