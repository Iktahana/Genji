      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼は大胆不敵になり、無謀にもただ一人、門を乗り越えて敵の大軍中に跳び降りた。",
              "citation": {
                "source": "日清戦争異聞（原田重吉の夢）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論僕を、海軍中尉の服を着てゐた僕を、十年前の教へ子だと氣附かれる筈もない。",
              "citation": {
                "source": "猫又先生",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は、現役の陸軍中佐でございますが、ちっともふとらず、おかしなことには、いつまで経っても五尺一寸です。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "田山花袋の「一兵卒」は、作者の従軍中の観察と体験とからなったものである。",
              "citation": {
                "source": "明治の戦争文学",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "英雄としての尊氏は要するに大したものでなく、頼朝、信長、秀吉、家康等の五將軍中で、或は末席に地位するものかも知れない。",
              "citation": {
                "source": "足利尊氏",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから一つの特徴としては、王の軍中に随行して、時々の戦の模様や王の事蹟を即興的に歌った詩人（Scalds）の歌がところどころにはさまれている事である。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪代はお悦の娘で――主人は折から旅行中の、ある陸軍中佐の夫人だという。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "平安の俘となるや、燕の軍中歓呼して地を動かす。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "索引を調べると、彼女の小伝は、ユダヤ教のラビと深海魚関連の論文を書いた海軍中佐の間に挟まれていた。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "二週目あたりに飲み水が尽き、内地進軍中のニール将軍の縦隊に連絡が取れるか否かが問題となった。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アーサ・シャルパンティエイ、海軍中尉ですな。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふらふらとこっちへやって来たら、和服の陸軍中将も興に乗って、ふらふらとついて来たから、一緒にここへ這入ったまでさ」「なにが陸軍中将じゃ。",
              "citation": {
                "source": "山県有朋の靴",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍人だね」「うん所天は陸軍中尉さ。",
              "citation": {
                "source": "琴のそら音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」此役正方は軍中に病んだ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸軍中将に任ぜられ、第六師団長に補せられさせ給ひて、十二月二十三日東京を発し、二十八日熊本に着かせ給ふ。",
              "citation": {
                "source": "能久親王年譜",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその後に引移って来た藤岡さんという方の奥さんが、五年目の明治二十四年にインフルエンザでなくなり、またそのあとへ来た陸軍中佐の方が明治二十七年の日清戦争で戦死し、その次に来た松沢という人が株の失敗で自殺したのは事実でございます。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸軍中将山県有朋は、陛下に供奉して西下して居たが、西南の急変を知るや、直ちに奏して東京大阪広島の各鎮台兵に出動を命じた。",
              "citation": {
                "source": "田原坂合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "先に、千早の攻囲軍中にあつて、護良親王の令旨を戴いて、東国へ帰つてゐた新田義貞は、義兵を起して鎌倉に攻め入り、北條氏一族を討滅した。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やつぱり乃公は陸軍中将だつたな。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄手をあれほどに駆け悩ました左衛門尉の首を挙ぐるさえあるに、諸家の軍勢に先だって一番乗りの大功をわが軍中に収むるとは、何という光栄であろうと、忠直卿は思った。",
              "citation": {
                "source": "忠直卿行状記",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "さるは、かの地に留学の日、陸軍中佐なる人の娘と相愛して、末の契も堅く、月下の小舟に比翼の櫂を操り、スプレイの流を指して、この水の終に涸るる日はあらんとも、我が恋の※の消ゆる時あらせじ、と互の誓詞に詐はあらざりけるを、帰りて母君に請ふことありしに、いと太う驚かれて、こは由々しき家の大事ぞや。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただしエリスの『古英国稗史賦品彙』二版一巻六二頁に、古ブリトン王アーサーの父アサー陣中で竜ごとき尾ある彗星を見、術士より自分が王たるべき瑞兆と聞き、二の金竜を造らせ、一をウィンチェスターの伽藍に納め、今一を毎に軍中に携えた。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって軍中白馬を忌む。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて、陸軍中将押上森蔵氏に通信して、鉄砲の始めは必ずしも一地方に限らにゃならぬほど込み入った物でなしと論じたついでに、日本と南米と昔一向交通なかったのに、すこぶる相似た分銅とボーラズが各自創製使用されたがその好き比例じゃと述べたが、氏はこれを『歴史地理』へ抄載した。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "前項に引いた、英国の『ジョー・ミラー滑稽集』にいわく、行軍中の軍曹に犬が大口開いて飛びかかると、やにわに槍先を喉に突き通して殺した。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂ズールーの戰爭は、明治十二年の事にて、ナポレオン三世の唯一子、廿三歳にて此軍中蠻民に襲はれ犬死せり。",
              "citation": {
                "source": "秘魯國に漂著せる日本人",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸軍中将か何かの未亡人の独り子で、学校の成績は中位、持ち物や髪の結い方等も質素だから、大勢の中に居ると一寸探し出し難い位である。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは退職の陸軍中佐か二等大尉、乃至は百人ぐらいの農奴を持っている地主といった、まあ一口に言えば、中流どころの紳士と呼ばれるような独身者がよく乗りまわしている型の馬車で。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
