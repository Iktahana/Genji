[
  {
    "uuid": "e81e293b-50f4-5089-9268-6643dff7b72c",
    "entry": "軍中",
    "reading": {
      "primary": "ぐんちゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
