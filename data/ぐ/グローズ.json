          "literary": [
            {
              "text": "」「クライミングローズフワバー。",
              "citation": {
                "source": "めくら草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月十五日（土曜）　第二芸術座でイワン・グローズヌイ〔イヴァン雷帝〕の死を見る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "このボリスより第二のイワン・グローズヌイ〔「イワン雷帝」〕のボリスの方が効果的だった。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜二人でルビヤンカ〔地名〕のイワン・グローズのたてた古い小さいいい寺の内を一寸見物し、ミャソニーツカヤ〔街路名〕を散歩し、茶をのみ、いろいろ面白い話をきいた。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
