          "literary": [
            {
              "text": "インドへ行く途中の、ボストンの建築家グリノウ氏は私に、日本の横材を刺接法の設計は、非常にこみ入っている。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリノウ氏は、日本人が手斧を使用する方法に感心し、このような仕事がもっと米国で行われるといいのだといっていた。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々と一緒にいるグリノウ氏は、これはヴェニスの謝肉祭の光景に匹敵するといった。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々はグリノウ氏も招いた。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
