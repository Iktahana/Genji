[
  {
    "uuid": "594ae5ae-26c7-554d-976e-cf4ca9447f7d",
    "entry": "グル",
    "reading": {
      "primary": "グル",
      "alternatives": [
        "ぐる"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
