        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "手水つかうというが一騒、御膳たべるというが一混難、ようやく八時過ぐる頃に全く朝の事が済んだのである。",
              "citation": {
                "source": "浅草詣",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "危き橋をようように這いわたりて終に下り着くに滝のしぶき一面に雨の如く足もとより逆に吹きあぐるさますさまじく恐ろしく暫くも彳みかねつ。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "やや十二時すぐる頃｜帰て来ると。",
              "citation": {
                "source": "牛舎の日記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "火気の満たる室にて頸やいたからん、振あぐる鎚に手首や痛からん」　女は破れ窓の障子を開らきて外面を見わたせば、向ひの軒ばに月のぼりて、此処にさし入る影はいと白く、霜や添ひ来し身内もふるへて、寒気は肌に針さすやうなるを、しばし何事も打わすれたる如く眺め入て、ほと長くつく息、月かげに煙をゑがきぬ。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "乳まいらせん」と懐あくれば、笑みてさぐるも憎くからず、「勿躰なや、この子といふ可愛きもあり。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "母が心の何方に走れりとも知らで、乳に倦きれば乳房に顔を寄せたるまゝ思ふ事なく寐入し児の、頬は薄絹の紅さしたるやうにて、何事を語らんとや、折々曲ぐる口元の愛らしさ、肥えたる腮の二重なるなど、かかる人さへある身にて、我れは二タ心を持ちて済むべきや。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "物ぐるほしけれど箱庭に作りたる石一つ水の面にそと取落せば、さゞ波すこし分れて、これにぞ月のかげ漂ひぬ。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "故人がよみつる歌の事などさま／″＼胸に迫りて、ほと／＼涙もこぼれつべく、ゆかしさのいと堪へがたければ、閨の戸おして大空を打見あぐるに、月には横雲少しかゝりて、見わたす岡の若葉のかげ暗う、過ぎゆきけんかげも見えぬなん、いと口惜しうもゆかしうも唯身にしみて打ながめられき。",
              "citation": {
                "source": "すゞろごと",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いつも暁よりなきいでゝ夕ぐれまでは御軒のものなるを、いかにしてさは聞き給ひけん、物ぐるほしくもおはしますかな」といよ／＼笑ふに、「さにはあるまじ。",
              "citation": {
                "source": "すゞろごと",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして変位があまり大に過ぐるときは下品の感を起させる。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "無極氏は、「我々がふだん苦にしていることなどはみんなつまらないことばかりなのだ」といって感慨を押え切れないように、立って部屋の内をぐるぐる歩き出した。",
              "citation": {
                "source": "小唄のレコード",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "群集は大きな感情をもつたひとつの浪のやうなものだどこへでも流れてゆくひとつのさかんな意志と愛慾とのぐるうぷだ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "岬をめぐるみづのうへみな泳ぎ手はならびゆく。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女よそのごむのごとき乳房をもてあまりに強くわが胸を壓するなかれまた魚のごときゆびさきもてあまりに狡猾にわが背中をばくすぐるなかれ女よああそのかぐはしき吐息もてあまりにちかくわが顏をみつむるなかれ女よそのたはむれをやめよいつもかくするゆゑに女よ　汝はかなし。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "われここを渡りて荒寥たる情緒の過ぐるを知れり往くものは荷物を積み車に馬を曳きたりあわただしき自轉車かなわれこの長き橋を渡るときに薄暮の飢ゑたる感情は苦しくせり。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこへでも流れてゆくひとつのさかんな意志と愛欲とのぐるうぷだ。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "土人のおそろしい兇器のやうにいろいろな呪文がそこらいつぱいにかかつてしまつた景色はもうろうとして暗くなるしへんてこなる砂風がぐるぐるとうづをまいてる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんもりとした森の木立のなかでいちめんに白い蝶類が飛んでゐる　むらがる　むらがりて飛びめぐる　てふ　てふ　てふ　てふ　てふ　てふ　てふ　これはただ蝶が飛んでゐるばかりではない――ね。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして都會の狹い露路裏に、稻荷の鳥居をくぐる藝者等は、彼等の弗箱である客や旦那等が、もつと足繁く通ふやうに乞うてるのである。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四ツ角を曲る時は、いつも三遍宛ぐるぐる廻つた。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さんたくるす　さんたくるす　遊樂至上のうみのうへ、岬をめぐる浪のうたかた、浪とほれば鳥禽の眼にも見えず、況んや白日の幽靈は、いと遙かなる地平にかげをけちゆくごとし。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊園地にて遊園地の午後なりき樂隊は空に轟き※轉木馬の目まぐるしく艶めく紅のごむ風船群集の上を飛び行けり。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四ツ角を曲る時は、いつも三遍宛ぐるぐる回った。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は道が岩山をぐるっとめぐってついてあるのを了解した。",
              "citation": {
                "source": "猿ヶ島",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤え赤え煙こあ、もくらもくらと蛇体みたいに天さのぼっての、ふくれた、ゆららと流れた、のっそらと大浪うった、ぐるっぐるっと渦まえた、間もなくし、火の手あ、ののののと荒けなくなり、地ひびきたてたて山ばのぼり始めたずおん。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お濠をぐるっとめぐって、参謀本部のとこから、日比谷へ出て、それから新橋駅へ出て、赤羽は、その裏じゃないか。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もがきあがいて捜しあてた言葉は、「江の島の海は、殺風景であった」私はぐるっと海へ背をむけた。",
              "citation": {
                "source": "狂言の神",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士は実に得意になってかかとで一つのびあがり手で円くぐるっと環を描きました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると目がぐるぐるっとして、ご機嫌のいいおキレさままでがまるで黒い土の球のように見えそれからシュウとはしごのてっぺんから下へ落ちました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "部下の判事や検事たちが、その両側からぐるっと環になってならびました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
