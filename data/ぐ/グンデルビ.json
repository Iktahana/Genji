          "literary": [
            {
              "text": "丸の内の「グンデルビ上海」の類である。",
              "citation": {
                "source": "錯覚数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海上ビルデングと左から右へ書いてあるのを君は逆にグンデルビ上海と読んで、『上海には海上ビルデングに能く似た建物があるね。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "上海のグンデルビと一億万円に日本中を引っ張り廻されるんじゃ何んなに丈夫な生命でも別状なしでは済むまいと言うのさ。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「相変らずグンデルビ上海をやっているね」　と団さんが笑った。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "相変らずグンデルビ上海式だね」　と団さんが揚げ足を取った。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
