          "literary": [
            {
              "text": "」と云ふトルストイの芸術論が如何に偏してゐても、其処には深いグルンドがある。",
              "citation": {
                "source": "善くならうとする祈り",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「真の芸術は宗教的感情を表現したものである」というトルストイの芸術論がいかに偏していても、そこには深いグルンドがある。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アダムとイブの過失から人類の運命が狂い出したという聖書の原罪の思想には深いグルンドがある。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "グルンドラヴィーネに会ったら一たまりもない。",
              "citation": {
                "source": "春の槍から帰って",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "グルンドトリッグの国民高等学校・リングビイ農業学校・丁抹国立農民博物館・ＳＥＴＯ。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがそこにグルンドウィヒという偉い教育家が生れ、デンマークをいつまでもこういう憐れな国にしていてはならない、何とかしなければならぬというところから、この人の発案で、国民高等学校というのを拵え、農家の子弟や商店の徒弟を冬の暇な時に集めて、少しばかりの学問を授ける。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "グルンドヴィグ、キルケガアルド、ヤアコップ・ビョオメ、アンゲルス・シレジウス、それからギョオテのファウストなどがある。",
              "citation": {
                "source": "冬の王",
                "author": "ハンス・ランド　Hans Land",
                "note": "青空文庫"
              }
            }
          ]
        }
