[
  {
    "uuid": "552e15d2-f20a-5f10-becc-4abbd6454e15",
    "entry": "軍律",
    "reading": {
      "primary": "ぐんりつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "martial law",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "占領地では厳しい軍律が敷かれ、夜間の外出は一切禁止された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は軍律を破って敵陣に深入りした罪を問われ、軍法会議にかけられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "軍律に背く行為は、たとえ英雄であっても厳しく処罰されるのが軍隊の掟だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "勿論軍律を犯したというでもないから、将校方は何の沙汰をもせられなかったのであろう。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "實に其軍律の嚴然たるは今更ながら感嘆の他は無いのである。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれは軍律上少しく変則ではあるがこれから食事を始める。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからあともよく軍律を守って国家のためにつくしてくれ」兵卒一同「いいえ、だめであります。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　という具合になり、君は軍律もクソもあるものか、とばかりに列から抜けて、僕のほうに走り寄り、「お待たせしまスた。",
              "citation": {
                "source": "未帰還の友に",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍律を厳守することでも、新兵を苛めることでも、田舎に帰って威張ることでも、すべてにおいて、原田重吉は模範的軍人だった。",
              "citation": {
                "source": "日清戦争異聞（原田重吉の夢）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まずしい身なりをしていても、さすがに人品骨柄いやしからず、こいつただものでない、などというのは、あれは講談で、第二国民兵の服装をしているからには、まさしくそのとおり第二国民兵であって、そこが軍律の有難いところで、いやしくも上官に向って高ぶる心を起させない。",
              "citation": {
                "source": "鉄面皮",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論軍律を犯したといふでもないから、将校方は何の沙汰をもせられなかつたのであらう。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋島勢が信綱の命に反して先駆したのではなくて、軍目付自ら軍律に反した始末なのである。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "此事は前人が墨子を論ずるに當つて誰も指摘して居らぬが、孫子が女兵を調練して軍律を用ゐんとした談と共に、周秦の間の世相に就いて或種の考を抱かせる。",
              "citation": {
                "source": "墨子",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "強犯されて一首を吟むも、万国無類の風流かも知れぬが、昔は何国も軍律｜不行届かくのごとく、国史に載らねど、押勝の娘も、多数兵士に汚された事実があったのを、妙光女の五百人に二倍して、千人に云々と作ったのであろう。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういわれれば、下るよりほかない軍律だった。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か軍律に背いた事があつて、死刑にされたのだといふ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ぢや、軍律をお読みになつた事がありますか。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私は軍律に従つてるんですからね。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "余ら皆軍律に馴れねば驚き恐れて棚を飛び下り一列を作りたり。",
              "citation": {
                "source": "従軍紀事",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍律の裁判には、法学士なかるべからず。",
              "citation": {
                "source": "学問の独立",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍律の厳しさを思はせ、私は、ひそかに感謝の念にうたれた。",
              "citation": {
                "source": "北支物情",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、私は、こゝでも、内心、不便なことだとは思ひながら、一方軍律の厳として犯し難きを頼もしく感じ、衛兵に一礼して、堀内氏と共にもと来た道を引つ返した。",
              "citation": {
                "source": "北支物情",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう兵隊も軍律も土足にかけろ。",
              "citation": {
                "source": "決闘",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪しい奴がしのびこんだというのは……」　だが、きびしい軍律の中で生活してきた「火の玉」少尉にとっては、たとえ傍に何事があろうと、気球が予定の時刻に上昇しないことについて甚だ不満であった。",
              "citation": {
                "source": "空中漂流一週間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、手綱と鞭と馭者と車掌とが、一緒になって、放置しておけば、動物の中には理性を賦与されているものもいるという議論に非常に都合のよくなる目論を、禁止するところのあの軍律を、読み聞かせた★のだ。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "手綱と鞭と馭者と車掌とが……軍律を読み聞かせた　　馭者と車掌とが手綱を曳き鞭で打って馬に先へ歩ませたことである。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたが知りたがっていられるドーリトル隊の処刑にしても、陸軍省の一部にいくらか反対があったようですが、軍事裁判長はそういうものを考慮せずに、軍令第四号……『空襲軍律』のほうを重く見た。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "……助命したり捕虜にするということは軍律にはなく、従って敗北者は逃げる以外に助かる方法はない。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍律に依って、こんな……。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに親露派なるもの之に反対して、訂約者たる外部大臣の邸内に爆弾を投ずるなど日本派排斥の声高きに至り、林公使は韓廷が親露派に対する処分手ぬきを詰り、又日韓議定書の遂行を妨ぐるものは、日本の軍律によつて処刑する事としたるも、依然として我に反抗するもの多く国王の如きも我に信頼する様子なしと曰ふ。",
              "citation": {
                "source": "文明の強売",
                "author": "大石誠之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
