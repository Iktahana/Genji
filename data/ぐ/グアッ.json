          "literary": [
            {
              "text": "けれども……）いや、ざっと、ウォーミングアップ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「グアッ」　そいつは怒りの叫び声をあげて、穴に入っていった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "長いもののためのウォーミングアップとして。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなこと書いている、これも一種のウォーミングアップかもしれないからどうぞあしからず。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が「お蝶夫人」をうたい終って楽屋へ帰ろうとすると、パヴロヴァが舞台裏で私のオペラの終るのを待ちながら、横木につかまって足をあげたりさげたり、一生懸命ウオーミングアップをしています。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども私が息をつめて急降下爆撃を見つめてゐたら、突然耳もとでグアッと風圧が渦巻き起り、そのときはもう飛行機が頭上を掠めて通りすぎた時であり、同時に突き刺すやうな機銃の音が四方を走つたあとであつた。",
              "citation": {
                "source": "続戦争と一人の女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "お臍の下と顎の下で大地がゆら／＼ゆれてグアッといふ風の音にひつくりかへされるやうな気がした、砂をかぶつたのはそれからだ。",
              "citation": {
                "source": "続戦争と一人の女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり、グアッと、メリケン。",
              "citation": {
                "source": "カストリ社事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸松の「笑の王国」二の替りを一寸のぞき、東宝劇場へ、少女歌劇「ビッグアップル」つまらなさに呆れる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
