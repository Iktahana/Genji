        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お恥ずかしい限りの愚書ではございますが、お手隙の際にでもご覧ください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "私のような未熟者の愚書を出版していただけるとは、夢のようです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "愚書に目を通していただいた先生から、厳しいながらも愛のある言葉をいただいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
