    "definitions": [
      {
        "index": 1,
        "gloss": "stupid book",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "世の中には読むに値しない愚書が溢れているが、これはその筆頭だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "時間の無駄だと言われながらも、彼は好んで怪しげな愚書を買い漁った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "中身のない薄っぺらな議論を繰り返す、ただの愚書に過ぎない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "かくのごとく我儘であるくせにまた甚だしく臆病な彼は、自分で断然年賀端書を廃して悠然｜炬燵にあたりながら彼の好む愚書濫読に耽るだけの勇気もないので、表面だけは大人しく人並に毎年この年中行事を遂行して来た。",
              "citation": {
                "source": "年賀状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "天下の愚書でも売れる本はいつでも在庫品があり、売れない本はめったにない。",
              "citation": {
                "source": "読書の今昔",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "単純なる自分は愚書の世に溢れて居る原因を、専らここに在る如くに解して居たのである。",
              "citation": {
                "source": "予が出版事業",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "河向いから池までの熊笹を切開いた路はぐしょぐしょに水浸しになって歩きにくかった。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "霧の中を降って来たそうで、みんなぐしょぐしょにぬれていた。",
              "citation": {
                "source": "小爆発二件",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "はげしい風と雨にぐしょぬれになりながら二人はやっと学校へ来ました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがぼくの手にさわったらぐしょぐしょにぬれているのが知れた。",
              "citation": {
                "source": "火事とポチ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗吉は――煙草は喫まないが――その火鉢の傍へ引籠ろうとして、靴を返しながら、爪尖を見れば、ぐしょ濡の土間に、ちらちらとまた紅の褄が流れる。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……親子は顔を見合わせたそうですが、助け上げると、ぐしょ濡れの坊主です。",
              "citation": {
                "source": "半島一奇抄",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝汗でぐしょぐしょになるのです。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "腐れた肺が呼吸に鳴るのか――ぐしょ濡れで裾から雫が垂れるから、骨を絞る響であろう――傘の古骨が風に軋むように、啾々と不気味に聞こえる。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "汗でぐしょぐしょになるほど握りしめていた掌中のナイフを、力一ぱいマットに投げ捨て、脱兎の如く部屋から飛び出た。",
              "citation": {
                "source": "古典風",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おじいさんのくつ屋は、はじめはいやだと言いましたけれども、モルジアナが金貨を一枚そっとその手ににぎらせましたら、すぐしょうちしました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "三、アリ・ババと四十人のどろぼう",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の夕立が往来の人を追っ払ってしまったらしく、ぐしょ濡れになった菰張りの小屋の前には一人も立っている者はなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お照の父",
                "note": "青空文庫"
              }
            },
            {
              "text": "気持ち悪げに泣き叫ぶ赤坊の股の下はよくぐしょ濡れになっていた。",
              "citation": {
                "source": "小さき者へ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨の音と、ツイ縁側のさきを流れている渓川の音とに耳を澄ましているところへぐしょ濡れになって十二と八歳の兄と妹とが帰って来た。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲のいい友達を一人失くした哀しみを抱きながら、雨蛙はぐしょ濡れになって、無花果の上葉から下葉へと飛び下りました。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪も着物もぐしょ濡れになっているのを見ると、きのうのシャワーが降ってくる前か、あるいは降っている最中かに、そこで変死を遂げたらしいんです。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨と風と、その音を聞きながら半七は寝床のなかで又考えていると、表の戸を叩いて亀吉がぐしょ湿れの姿ではいって来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "歩兵の髪切り",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの辺は兇行のあった月曜日の晩には、非常にぐしょぐしょだったに違いない。",
              "citation": {
                "source": "白銀の失踪",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その詰襟の黒ぽい洋服は汗と埃りに、ぐしょぐしょになって、而も余り大きくもない体格を引きずるように持て余まして、底のあいた編上靴で埃をまきたてながらよろめいて行った。",
              "citation": {
                "source": "放浪の宿",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車の酔がまだおさまらぬところへ、頭から雨にぐしょ濡れになったので、駅に戻った時、ますます気持がわるくなってきた。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "傘をさして雨の中に立っていると、着物の裾は泥だらけになるし、肝腎の新聞は濡れてぐしょぐしょになるし、従ってそれは容易に破れたりくっついたりした。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "垣根は、茂った葉で、一度跨ぐと、裾がぐしょぐしょになった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "one's writings",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
