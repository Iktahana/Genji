      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "山崎はチラっとこんな念におそわれて少し不快を感じたが、万事につけて村上の心もちを呑込んでいる山崎はそんなことくらいを深くとがめる気にはならないですぐあっさり忘れて、その日は夕方まで敏子を中心に面白く話し合った。",
              "citation": {
                "source": "かれいの贈物",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "春夜のただよふ靄の中でわたしはあなたの思ひをかぐあなたの思ひは愛にめざめてぱつちりとひらいた黒い瞳は夢におどろきみしらぬ歡樂をあやしむやうだ。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、電車が濠端を走つてゐる時思ひ定めた、「でもまた観ないでしまふんだらうな」とそのすぐあとでは思ふのだつた。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔父さんは、すぐあとで来る筈だが、でも、あいつは、昔からケチで、頼みにも何もなりゃしねえ。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪が消えたら、すぐあたしは、田圃に出て、（読むのをやめて、手紙を膝の上に置き、こわばった微笑を浮べて母のほうを見て）ここまで書いたのだけど、もうあたしは、この手紙が最後で鈴木さんとは、おわかれになるかも知れないわ。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "「黒きマント」は脚から足のぐあいが少し変である。",
              "citation": {
                "source": "昭和二年の二科会と美術院",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし「勇敢」では少しぐあいが悪い。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "波頭が砂浜をはい上がって引いたすぐあとの湿った細砂の表面を足で踏むと、その周囲二三尺ほどの所が急にすうとかわくが、そのまま立ち止まっていると、すぐにまた湿って来ます。",
              "citation": {
                "source": "夏の小半日",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで思い出したのは、関東大震災のすぐあとで小田原の被害を見て歩いたとき、とある海岸の小祠で、珍しく倒れないでちゃんとして直立している一対の石燈籠を発見して、どうも不思議だと思ってよく調べてみたら、台石から火袋を貫いて笠石まで達する鉄の大きな心棒がはいっていた。",
              "citation": {
                "source": "静岡地震被害見学記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "下谷のある町の金貸しの婆さんの二階に間借りして、うら若い妻と七輪で飯を焚いて暮している光景のすぐあとには、幼い児と並んで生々しい土饅頭の前にぬかずく淋しい後姿を見出す。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "存外すいて居る車に乘込んだが、すぐあとから小團體がやつて來て完全に車内の空間を充填してしまつた。",
              "citation": {
                "source": "伊香保",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　世にある人でも、歌人でも、こゝまでは變りはあるまい、が、情ない事には、すぐあとへ、「あゝ、嘸ぞお腹がいゝだらう。",
              "citation": {
                "source": "遺稿",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大騒ぎのすぐあと、七日目に嫁御がお産じゃ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪のすぐあとへは惜しいほど、黒塗の吾妻下駄で、軒かげに斜に立った。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへば、本町の風呂屋ぢや、湯が沸いた、湯がわいた、と此のぐあひなり。",
              "citation": {
                "source": "寸情風土記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝さしておいて、謡を教えさしたッて一廉の役には立つのに、お金子だといや直ぐあれなんだもの。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐあとに、わしがついて守って行きますから、心配せず、大浪をかぶってもあわてず、馬の首から手を離したりせぬように。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓のそとの樹の枝のゆれぐあいで、風がひどいなと思っているうちに、雨が横なぐりに降って来ました。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとはこんなぐあいに繁華であったのであろうが、いまは、たいへんさびれてしまった。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これから、すぐあいつを捜しに行かなければなりません。",
              "citation": {
                "source": "誰も知らぬ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（と検事は、はじめて白い歯を出して微笑み、芸術家の肩をそっと叩いて、）そうで無ければ、私は今すぐあなたを、未決檻に送るつもりでいたのですよ。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「つまり島の形が、こんなぐあいに、」と言って両手で島の形を作って見せて、「こんなぐあいになっていて、汽船がここを走っているので、島が二つあるように見えたのでしょう。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、すぐあとから、又、「市三！",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かねて四郎と二人で用意しておいた――すなわち田溝で捕えておいたどじょうを鉤につけて、家を西へ出るとすぐある田のここかしこにまきました。",
              "citation": {
                "source": "あの時分",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "亀井戸の金糸堀のあたりから木下川辺へかけて、水田と立木と茅屋とが趣をなしているぐあいは武蔵野の一領分である。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなぐあいですから、ツェねずみはだんだんきらわれて、たれもあんまり相手にしなくなりました。",
              "citation": {
                "source": "ツェねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、シグナルさんもあんまりだわ、あたしが言えないでお返事もできないのを、すぐあんなに怒っておしまいになるなんて。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「どこへ行くか」「第五十聯隊　聯隊｜本部」　歩哨はスナイドル式の銃剣を、向こうの胸に斜めにつきつけたまま、その眼の光りようや顎のかたち、それから上着の袖の模様や靴のぐあい、いちいち詳しく調べます。",
              "citation": {
                "source": "ありときのこ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんど出て来たら、すぐあっしに知らせるんだよ」「しいッ。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかにも、山のすぐあっちには広い海のある場所らしく、たっぷり、惜しげない、雨のふり工合がいい心持であった。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
