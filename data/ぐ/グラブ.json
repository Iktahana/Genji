        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "港では、グラブが大きな積荷を次々と船から陸へ移していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "建設現場で、グラブを使って土砂をすくい上げていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "重機メーカーは、様々な種類のグラブを開発している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」と、敏ちゃんは、ポン、ポンとグラブをたたいていました。",
              "citation": {
                "source": "日の当たる門",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、こんどは、勇ちゃんの強く投げ出したボールは、敏ちゃんのグラブの中に、ボーンといって、うまくおさまりました。",
              "citation": {
                "source": "日の当たる門",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラグナグ島行きが出るまでには、まだ一月はあると聞いて、私は、そこから五リーグばかりのところにある、グラブダブドリブという島を訪ねることにしました。",
              "citation": {
                "source": "ガリバー旅行記",
                "author": "GULLIVER'S TRAVELS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、この『グラブダブドリブ』という名前は、『魔法使の島』という意味なのでした。",
              "citation": {
                "source": "ガリバー旅行記",
                "author": "GULLIVER'S TRAVELS",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよ／＼出発の日が来たので、私はグラブダブドリブの酋長と別れて、連れの紳士と一しょに、マルドナーダーへ帰りました。",
              "citation": {
                "source": "ガリバー旅行記",
                "author": "GULLIVER'S TRAVELS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちようど野球のグラブのように肉が厚い。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンクスは緑のパンツ、富田六｜段は洗い清めた柔道着に黒帯姿、審判のアメリカ人がモンクスのグラブを富田六段にさわらして、グラブの中になんにもはいっていないことをしめす。",
              "citation": {
                "source": "柔道と拳闘の転がり試合",
                "author": "富田常雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓというそのころ有名なボクサーが同級生で、学校を休んで拳闘のグラブをもってやってきて、この草原で拳闘の練習をしたこともあるが、私は当時から胃が弱くて、胃をやられると一ぺんにノビてしまうので、拳闘はやらなかった。",
              "citation": {
                "source": "風と光と二十の私と",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "グラブ、そして、シールドをおろしたヘルメット。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘルメットを右のミラーにかけ、皮のグラブを右手に握っている。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホームランをキャッチしてしまった外野手が、高だかとグラヴをさしあげる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「たぶん、だいじょうぶだと思うけれど……」　グラヴのなかは空だった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "猛烈なライナーが飛んできたら、考えるまえに、グラヴを出すじゃん」　こんどは、高志がなにもこたえず、また缶に手を伸ばした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いて入るはアグラヴェン、逞ましき腕の、寛き袖を洩れて、赭き頸の、かたく衣の襟に括られて、色さえ変るほど肉づける男である。",
              "citation": {
                "source": "薤露行",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰りはマスカルチア、グラヴィナなどの村を過ぎた。",
              "citation": {
                "source": "エトナ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "１）　ジュネエヴのプレヴォ氏は、本書の飜訳で、綿工業の開始された小州グラヴィについて若干の報告を行っている。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "海軍省に提出したショオマレェ中佐の「海難報告書」によれば、離船完了の七月五日、午前七時現在で、筏には百四十五名（アルマン・グラヴィエルの「亜弗利加沖難破の真相」では百四十七名）の人員が乗っていた。",
              "citation": {
                "source": "海難記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "姫鱒は大将がグラヴオネの河で釣りあげた自慢のもの、それを、あんた、賞牌はどっかへすててしまう。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "タラノ音頭　――コルシカ島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポアリエ街とグラヴィリエ街とに防寨が作られた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "運転席のグラヴ・コンパートメントには懐中電灯があった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＬＡでも、クリスマスに真夏みたいなときはあるけれど、まったく人工的な感触があって、気候でさえすべては造りものの嘘、という気持ちが抜けないんだ」　ぼくは、フォードのグラヴ・コンパートメントを開いた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "臭いは消してあるのだが、たとえばいまのようにグラヴ・コンパートメントを開くと、その一瞬、いまでもかすかに兎の臭いがした。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「読書をしようか」　グラヴ・コンパートメントから双眼鏡を出して、ぼくは彼女に言った。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が」「キャッチ・ボールを」「してください」「雨は降らないかな」「だいじょうぶよ」「グラヴは？",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「二時くらいかな」「そうね」「ここで会おう」　という約束をした日の夜、洋介はグラヴを捜してみた。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "大人用のグラヴもひとつ見つかった。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊撃手が使うグラヴだった。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「グラヴ」　洋介が答えた。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「グローブではなくて、グラヴ」「そうですか、ではグラヴ」「素晴らしいのを買ってきた」「野球をするの？",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "恵理子はトート・バッグからグラヴとボールを取り出した。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
