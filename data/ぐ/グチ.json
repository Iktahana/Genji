      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "idle complaint",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "残業続きの彼女は、帰宅後に夫に仕事の愚痴をこぼすのが唯一の発散方法だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「また上司の愚痴？」と友人に言われ、自分でも言い過ぎだと気づいて苦笑した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "同僚と居酒屋で愚痴を言い合ううちに、いつの間にか気持ちがずいぶん楽になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "」とやがてだんだん愚痴になる。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆あなたのためです』と、さすがにヘルンも夫人に愚痴をこぼしている。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つ牛込の瀬川さんを訪れて、私の愚痴を聞いてもらおうかと思った。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "愚痴つぽい観察が不可ないんだ。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "誠実たること――即ち愚痴つぽくないためには、敬虔なる感情を持し得るの必要、或は絶えず意識的なる自己葛藤が必要であらう。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し利巧な見ばえのするやうな人間は、これはまたヒステリイ、疑ひと卑屈に蟲食はれてしまつてゐます……かういふ手合ひは愚痴を言ふ、人を憎む、病的に讒謗を逞しうする。",
              "citation": {
                "source": "津輕地方とチエホフ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上は自分が今日までに感じた随筆難のありのままの記録で、云わば甚だ他愛のない「筆禍事件」の報告と愚痴のいたずら書に過ぎないが、こんなことまで書くようになるのもやはり随筆難の一つであるかもしれないのである。",
              "citation": {
                "source": "随筆難",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして時々心細い愚痴っぽい事を言っては余と美代を困らせる。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何程愚痴を云うても返ることではない、予は国へ帰った。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "またしても、おしかの愚痴が繰り返された。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おしかは愚痴をこぼしたが、親の云いつけに従わぬからと云って、息子を放って置く訳にも行かなかった。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "債鬼のために、先祖伝来の田地を取られた時にも、おしかはもう愚痴をこぼさなかった。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "全體旅をしながら何物をも見ず、見ても何等の感興も起さず、起しても其を折角の同伴者と語り合て更に興を増すこともしないなら、初めから其人は旅の面白みを知らないのだ、など自分は獨り腹の中で愚痴つて居ると『あれは何でしよう、そら彼の山の頂邊の三｜角の家のやうなもの。",
              "citation": {
                "source": "湯ヶ原ゆき",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたしはよくよく子供に運がない」　おまきはいつも愚痴をこぼしていたが、それでも末っ子の七之助だけは無事に家に残っていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかみさんがお盆に来て愚痴を云っていたよ」　女房に笑われて、庄太は頭をかいていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鬼娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "私にはそれが自負の言葉だとはどうしても思われなくて、かえってくすぐったさに悩む余りの愚痴のようにも聞きなされる。",
              "citation": {
                "source": "相対性原理側面観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また筆者の愚痴な感想の中にも不可避的にその時代の流行思想のにおいがただよっていなければならない。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、あの時、印刷所のおかみさんと千葉県が、も少し私に優しく、そうして静かに意見してくれたら、私はふっつりと詩｜三昧を思い切り、まじめな印刷工にかえっていまごろはかなりの印刷所のおやじになっていたのではなかろうかと、老いの愚痴でございましょうが、しきりにそう考えられてならないのでございます。",
              "citation": {
                "source": "男女同権",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」歩きながら、思わず愚痴が出た。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども其心配はたゞ普通の親が其子の上を憂るのとは異って居たのです、それで父が『折角男に生れたのなら男らしくなれ、女のような男は育て甲斐がない』と愚痴めいた小言を言う、其言葉の中にも僕の怪しい運命の穂先が見えて居たのですが、少年の僕には未だ気が着きませんでした。",
              "citation": {
                "source": "運命論者",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "物置さえあれば何のこともないのに」と老母が漸と口を利たと思ったら物置の愚痴。",
              "citation": {
                "source": "竹の木戸",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "細君は珍しいおとなしい女で、口喧ましい夫にかしずく様はむしろ人の同情をひくくらいで、ついぞ近所なぞで愚痴をこぼした事もない。",
              "citation": {
                "source": "イタリア人",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで何事につけても滅多に心の裏を見せた事のない気丈者が、急におせつかいな愚痴つぽい機嫌買ひになつて、好き嫌ひが段々はげしくなつた。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロシアの田舎の別荘の、矢来の彼方に見る雪は、うんざりする程永遠で、雪の降る日は高貴の夫人も、ちつとは愚痴でもあらうと思はれ……雪が降るとこのわたくしには、人生がかなしくもうつくしいものに――憂愁にみちたものに、思へるのであつた。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、いつの世の中でも、世人全部満足だという世の中は歴史を見てもあった例がないのですし、また、多数の人の共存する世の中は、みんなの連帯責任ですから、私たち個人個人が常に不平で愚痴ばかりこぼしていては決して良くはならないでしょう。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人夫妻の方ではその翌日の仕事が駄目になりまして、その不満がお客に向うと、「あのお客達は長尻で困る」などと愚痴をこぼし、終いには訪問されるのを嫌うようになります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは人間の福祉幸福を望んで造りなされたために、もちろん便利、迅速、知識的でありますが、しかしその内部には、人間の欲望、煩悩、愚痴等が働きかけて、禍福相半ばするものであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「若い衆の愚痴より年よりの愚痴じゃ、聞く人も煩さかろ、措かっしゃれ、ほほほ。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "『春枝は大分愚痴が出ます。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "清水寺のすぐちかくに赤い毛氈を敷いた縁台を二つならべて置いてある小さな甘酒屋で知り合った。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "moha (ignorance, folly)",
