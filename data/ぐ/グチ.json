  {
    "uuid": "3bd4ce5b-d48c-5d37-af72-64ed150a6685",
    "entry": "グチ",
    "reading": {
      "primary": "ぐち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼女の肩の辺から、枕の方へかけて、未だ彼女がいくらか、物を食べられる時に嘔吐したらしい汚物が、黒い血痕と共にグチャグチャに散ばっていた。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一つが、またぞろ、緑屋の屋根へ落ち、御叮嚀に、屋根から天井まで打ち抜き、菓子を並べてある箱の上まで、落ちて来て、硝子板と菓子とを、グチャグチャに、一緒くたにしちまったのである。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一行二日分の握飯は風呂敷に包んで若い方の剛力が背負って来たのだが、この男元来の無精者、雨が降っても蔽いもしなかったものと見え、グチャグチャに崩れた上に、雨に濡れてベトベトになっている。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ユグチュユモトの村へ出張して呉れ給へ。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君、ユグチュユモトへ行ってくれ給へ。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして次の朝早く署長はユグチュユモトの村へ向った。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっとふりかへって見るとユグチュユモトの村は平和にきれいに横たはりそのずうっと向ふには河が銀の帯になって流れその岸にはハーナムキヤの町の赤い煙突も見えた。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒と茶の二足のローファーと、ウィングチップまでもってる奴に、あんなイヤミはむだだった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう、きつくてダメだ」　高志は、ソファの足もとにおいたペイパーバッグから、黒いウィングチップを出して、きちんと左右そろえて床におき、立ちあがって洗面所にむかった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんですか、きみたち、そのかっこうは」　寒そうに両腕をかかえこんで入ってきたワラが、はだしの高志と、ぬれたズボンにウィングチップを履いた慶一を見とがめた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒いウィングチップの。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝酒、何といふうまさだらう、いゝ機嫌で、昧々さんをひつぱりだして散歩する、そして宇平居へおしかけて昼酒、また散歩、塩風呂にはいり二丘居を訪ね、筑紫亭でみつぐり会の句会、フグチリでさん／″＼飲んで饒舌つた、句会は遠慮のない親しみふかいものだつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯を食べるのにサラサラグチャグチャは不可ないという。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "フエヲ　一ポン　モツテ　イエイエノ　トグチニ　タツテ、ヒロ　ヒロ　ヒート　カナシイ　オトヲ　フルハセ、一セン　二センヲ　モラツテ　タビヲ　シマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥のグチャグチャいう音と豚のゲーゲー啼く声に送られながら、彼は祭司長の家へと乗りつけた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、年の経つた今では、令息清蔵君が私と一緒に、村の小学校で夜学などに精を出され、米三さんのお父さんは至極丈夫で、グチヤ／＼した目をしながらも、一生懸命に農事に精励されてをります。",
              "citation": {
                "source": "田舎からの手紙",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "その途中でＢ・Ｋ・Ｖの人々に会い、お互いに天候の悪いのをグチる。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もッともイボンヌという娘がいるから、せめてものなぐさめだが、いればいるでまた別の苦労がふえるもんだから――いやはやとんでもないグチをこぼし始めたが――まったくイヤじゃありませんか！",
              "citation": {
                "source": "だだをこねる",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "あーら不思議、林檎はグチャリとなるかと思いの外、一陣の赤白い霧となって四方に飛び散り跡片もなくなった！",
              "citation": {
                "source": "人間灰",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノチノショウコニ、ワガ足ノ傷グチカラ、破片ヲヌキダシ、コノ缶ニイレテオク。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二）コノ品物ハスグチャントシマッテクレ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いうまでもなく、中山陵は、ヤングチャイナ建設の偉人孫逸仙を祀った陵である。",
              "citation": {
                "source": "支那の思出",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と私は道々考えた、が、（これは私が孫中山の霊に対し、心からなる黙祷を捧げたのを、孫中山をヤングチャイナ建設の父と仰ぐ守衛を喜ばせ、それで私に敬意を表したに相違ない。",
              "citation": {
                "source": "支那の思出",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このほか、ソラグチ（大木の根に穴があるもの）、ツルベ（これは岩穴でクマが釣桶のように上からはいってゆくようなもの）――まあざっとこんなふうになりますが、しかしこれは主題とは違った余談であります。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "或はグチとタンカの交ったようなものでもあります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
