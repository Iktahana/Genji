        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "われわれはグラティアたち〔美・優雅・喜びの象徴である姉妹の三女神〕をもパルカたち〔運命をつかさどる三女神〕をも信仰するのではなく流行を崇拝するのだ。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "訪問会の修道女の間では、訪れて来る者は「アヴェ・マリア」と言い、訪れを受ける者は「グラティア・プレナ」と言う（訳者注　両者合して、めでたしマリアよ恵まるる者よ云々の祈祷）。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "グラティアやムーサに奉仕しているようでいて、その実彼らが崇拝していたのはパルナッソスの神々のイメージに過ぎなかったのです。",
              "citation": {
                "source": "夕映えのむこうの国",
                "author": "時代を超えた童話",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
