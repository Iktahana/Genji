        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ユフダチ　ヤムノヲ　マツウチニツカレガ　デタカ　オヂイサンイツカ　グツスリ　ネムリマスオヤマハ　ハレテ　クモモナクアカルイ　ツキヨニ　ナリマシタ　この月は、春の下弦の月である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "水には落下の性を姿に現したプリムノという仙女と、流暢の性を現したカンリロエという仙女と、清浄を現したアカステという仙女と、飛沫を現したプレキサウレという仙女とが巣付いている。",
              "citation": {
                "source": "噴水物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "街の傍に棄てられて、今は界の石となりたる、古き柱頭も、わがためには、神聖なる記念なり、わがためには、めでたき音色に心を惱ますメムノンが塔なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうだ一米突先の人生が見えるか君の眼玉はいつもコペルニクス的に転廻してゐる和製ウナムノ、反対のための反対者、萩原朔太郎。",
              "citation": {
                "source": "小熊秀雄全集-12",
                "author": "詩集（11）文壇諷刺詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地問題ニ於テ英語ノ直譯ヤ「レニン」ノ崇拜ハ佳人ノ醜婦ヲ羨ムノ類。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしワリスの『巫来群島記』（一八八三年板、一三三頁）に、スマトラに多い体長く痩せ、尾甚だ長いセムノビテクス属の猴二種は、随分大胆で土人を糸瓜とも念わず、しかるに予が近づき瞰めると一、二分間予を凝視した後逃げ去るのが面白い。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "第５図　ハヌマン猴　ハヌマン猴、学名セムノピテクス・エンテルス（第五図）はインドに産し、幼時灰茶色で脊より腰へ掛けて暗茶色の一条あり、長ずるに随い黒毛を混じ石板色となる。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "千七百七十年代、亜米利加騒乱ノ時ニ、亜人ハ自由ノ為メニ戦フト云ヒ、我ニ自由ヲ与フル歟、否ザレバ死ヲ与ヘヨト唱ヘシモ、英国ノ暴政ニ苦シムノ余、民ヲ塗炭ニ救ヒ、一国ヲ不覊独立ノ自由ニセント死ヲ以テ誓ヒシコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "水ニ影ヲ沈ムノ心無シ”のとおりなのである。",
              "citation": {
                "source": "探偵小説と犯罪事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは此等の文書に共通な執拗性の一例と見るべきであるが、唯五年とのみ云はずして「五年フクラムノ年」と記したるは何の意か。",
              "citation": {
                "source": "天津教古文書の批判",
                "author": "狩野亨吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "レーニニズムノ旗高ク　五ヵ年計画ヲ四年デ！",
              "citation": {
                "source": "子供・子供・子供のモスクワ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "レーニン廟の赤いイルミネーションは、メーデーの夜、一時過ぎてもまだ絶えないモスクワの群集を照らしながら、レーニズムノ旗高ク五ヵ年計画ヲ四ヵ年デ！",
              "citation": {
                "source": "勝利したプロレタリアのメーデー",
                "author": "――モスクワの五月一日――",
                "note": "青空文庫"
              }
            },
            {
              "text": "当人自ラ哀シムノ心無クシテ一類之ヲ哀シム。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "輕々しく誓約を立つれば、守りてかへつて守らざるよりも大いなる惡に陷ることあり〔ギリシア人の大將〕アガメムノン。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンガ一字ヨムカヨマナイウチニ――オバアサンハ、ムツカシイ字ヲヨムトキハ一字ヨムノニトテモ時間ガカカルノデス――マドノソトデ、ハリサケルヤウナオホキナオトガ、キコエマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "曙の女神アウロラの薄くれないとメムノンの暁の歌とともに、人間のこの世界における朝の仕事は何であるべきだろうか？",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての詩人と英雄とはメムノンとおなじく｜曙の女神の子であり、日の出にその音楽をかなで出すのである。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔エジプトのテエベという町にメムノンという神様の石像があって、毎朝朝日が石像の額に当ると鼻唄のようなものを唄い出す。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "海上ではホーメロスの詩に見えて居る希臘軍の將帥のアガメムノーン、近世ではコロムブスの傳記、ラ・ベルイスの傳記、乃至カピテン・クツクの傳記に見えるやうな近代航海探檢者のやうなものでなくてはなりませぬ。",
              "citation": {
                "source": "金剛智三藏と將軍米准那",
                "author": "榊亮三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アポローンの祭司其女クリュセーイスの贖を求めてアガメムノーンに辱めらる。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "アガメムノーンとアキリュウスとの爭。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "アガメムノーン祭司の女を返し、其代償として先にアキリュウスの獲たるブリイセーイスを奪ふ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "アガメムノーンただ獨り怫然として悦ばず、不法に祭司追ひ攘ひ、更に罵辱を浴せ曰ふ、　25『老翁！",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "我を怒らすこと勿れ、今平穩に去らまくば』29　アガメムノーンの領土、首府はミケーナイ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "』其時答へて權勢のアガメムノーン彼に曰ふ、　130『汝、英武のアキリュウス、汝誠に勇なるも、我を欺くこと勿れ、凌ぐを得せじ説きも得じ、汝に戰利保つため我わが戰利失ふを甘んずべしと思へるや？",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "アガメムノーン、衆の王、その時答へて彼に曰ふ、『逃げよ、心の向くが儘、とく去れ何ぞためらふや？",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペーレーデース引き續きアガメムノーンにいきどほり。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "アガメムノーン其言に答へて即ち彼に曰ふ、　285『叟よ、汝の曰ふところ皆悉く理に當る、さはれ此者一切の衆を凌ぎて上に立ち、治めて御して衆人に令を下すを冀ふ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
