        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "婦人ヲ口舌ノ鬪爭ニ慣習セシムルハ其天性ヲ殘賊スルコト之ヲ戰場ニ用ユルヨリモ甚シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "限度ヲ設ケテ壹百萬圓以下ノ私有財産ヲ認ムルハ、一切ノ其レヲ許サヾランコトヲ終局ノ目的トスル諸種ノ社會革命説ト社會及人性ノ理解ヲ根本ヨリ異ニスルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實男子又ハ養男子ニ貧困ナル老親ヲ扶養セシムルハ歐米ノ贋的個人主義ト雲泥ノ差アル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母ノ愛ノ百千分ノ一ニ足ラザル長子ノ愛情利害ニ一切弟妹ノ運命ヲ盲從セシムルハ沒人情ノ極。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ノ理由ハ在郷軍人團ナル好適ノ機關ナク、今ノ植民政策的頭腦ノ總督府等ニ此ノ大任ニ當ラシムルハ明白ニ不正不義ヲ殘シテ改造ノ精神ヲ傷クルノミナラズ、或ハ意外ノ變ヲ招クベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代ニ至テ世界列強ガ戰爭ヲ開始セントスルトキ悉ク自他ヲ欺ク舊道徳的名分ヲ掲ゲ、又ハ之ヲ自己防衞ノ口實ニ求ムルハ國家生活ノ權利ヲ半解スルヨリ來ル卑怯ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルヲ極メテ完全ニシテ精美ナル物ヲ求ムルハ、好古ノ主意ヲ失フ者トス。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
