          "literary": [
            {
              "text": "口をムグムグやりながら坂をあがって。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人は、上顎にも下顎にも一本も歯がないと見えて、口をムグムグやるたびに、皺だらけの頬がじつに奇妙な動きかたをする。",
              "citation": {
                "source": "キャラコさん",
                "author": "馬と老人",
                "note": "青空文庫"
              }
            }
          ]
        }
