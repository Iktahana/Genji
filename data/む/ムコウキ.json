        "examples": {
          "standard": [
            {
              "text": "彼の向こう気が、チームを勝利に導いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は向こう気が強く、決して諦めない性格だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "若者の向こう気は、時に無謀な行動につながることもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「あいつは末っ子のあまったれで、いくじなしのくせに向っ気が強くって、へんにこすっからいとこがあっていやなやつだ、ゆだんのならないおっちょこちょいだ、おれはあいつの顔を見るといつもぼんのくぼが痒くなったものだ、いまから云っておくが、あいつはろくなやつにはならないぞ」　長姉の（土方へ嫁した）よねは云う。",
              "citation": {
                "source": "末っ子",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "向っ気の強い代りにはわかりも早く、諄いところなどは薬ほどもない人だったのに、「……どうかしているんだわ」酒の燗を直しながら、おせんは苛いらしい気持でそう呟いた。",
              "citation": {
                "source": "柳橋物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男まさりで向っ気が強く、幾人かの女房たちをてきぱきと指図しながら、子供たちの死躰の始末から、残っている五郎吉夫婦と長次の面倒をみ、さらに湯茶のことまでぬかりなくやってのけていた。",
              "citation": {
                "source": "赤ひげ診療譚",
                "author": "鶯ばか",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
