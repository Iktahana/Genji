          "literary": [
            {
              "text": "伏テ望ムラクハ陛下深仁深慈臣ガ［狂→至］愚ヲ憐レミテ少シク乙夜ノ覧ヲ垂レ給ハンコトヲ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏テ望ムラクハ聖明矜察ヲ垂レ給ハンコトヲ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "恨ムラクハイマダコレヲ刻スルニ及バズシテ瞑スト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏テ望ムラクハ陛下深仁深慈、臣ガ狂愚ヲ憐レミテ、少シク乙夜ノ覧ヲ垂レ給ワン事ヲ」　正造はここで「狂愚」の「狂」に縦線を引いて傍に「至」と書き入れ、捺印して次へ移った。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏テ望ムラクハ、聖明矜察ヲ垂レ給ワン事ヲ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏シテ望ムラクハ、丞相ノ謀リ遠キヲ慮リテ、早ク良図ヲ施シテ怠リヲ欲スルコトナカランコトヲ。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
