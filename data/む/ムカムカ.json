        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼のあまりにも無責任な発言を思い出すたびに、腹が立ってムカムカしてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "約束をすっぽかされた上に謝罪の一言もないなんて、本当にムカムカする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "嫌味を言われてムカムカしたが、ここで言い返しては同じ土俵に立つことになると我慢した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
