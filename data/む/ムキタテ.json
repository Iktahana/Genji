        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "浜には今年流行の背中の下まで割れた海水着の娘や腰だけ覆って全裸の青年達が浪に抱きつき叩かれ倒され、遠くから見る西洋人の肌は剥き立てのバナナのようにういういしい――小田島は突然顔を赫らめた。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――わけても晩は、電燈のあかりの中にさらされた身体が、芸人でありながらも余りにあざやかで、あまりに惨いものの美しさを剥き立てていた。",
              "citation": {
                "source": "ヒッポドロム",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "むきたての玉子のやうな、蒼味がかつたすべすべした肌で、うつぶせになつて眠つてゐる。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "むきたて玉子のやうな、ぽつてりした躯を、眞新しいタオルで悠々と拭きたてて上つて行くと、房江がぷつと笑つた。",
              "citation": {
                "source": "暗い花",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "富士男さま、とめないでください、わたしはやつらをなぐり殺してやる」　とモコウは白い歯をむきたてて憤怒した。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "森をぬけると視野はかつぜんと開けて、砂浜の先に、たけりくるった黒い海が、白いきばをむきたてて、なぎさをかんでいる。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、人参、大根、葱、トマトをすすめ、それから莢をむきたての豌豆をハンケチへ入れて見せ、それからまた、籠に入れた鳥類を見せる。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
