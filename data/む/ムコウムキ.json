[
  {
    "uuid": "5ff35843-faa5-5abf-a7b4-9a4971846065",
    "entry": "向こう向き",
    "reading": {
      "primary": "むこうむき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
