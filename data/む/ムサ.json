[
  {
    "uuid": "e505d01c-7bcb-5f4f-857d-bb90defcff9a",
    "entry": "無作",
    "reading": {
      "primary": "むさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
