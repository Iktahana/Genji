  {
    "uuid": "65868f0e-3f8b-5608-9f44-ea8797fe3cf7",
    "entry": "ムサ",
    "reading": {
      "primary": "むさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それはナムサダルマプフンダリカサスートラというものである。",
              "citation": {
                "source": "手紙　四",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カップに入れてブーケ・ジャムサンドウィッチを下さい、岬の灯台。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」特務曹長「なるほど、ハムサンドウィッチですな。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九四八（昭和二十三）年に東京大学理学部物理学科を卒業し、入社後は衛星通信の研究に携わった関本は、一九六四年からアメリカの衛星通信サービス会社コムサットに出向した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "家へ帰るにゃ金はなし、とどのつまりはカムサツカ行きか、土方部屋のタコよ。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、コールドビーフやハムサラダでビールを一杯飲むのもいい。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "無いといふものを無理に出せとも云はれず、ましてまんざら識らない顔でもないんですから、わたしも素直に承知して、ビール廿一杯とハムサラダ三枚の勘定を貸して遣ることにすると、みんなも喜んで出て行きました。",
              "citation": {
                "source": "赤い杭",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり私の方ぢやあビール廿一杯とハムサラダ三枚の勘定の代りに、家の焼けるのを助かつたと思やあ好いんですから、差引きをすりやあ有難いわけだと云つてゐるんですよ。",
              "citation": {
                "source": "赤い杭",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムサッカだろう」「あっ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエちょいと……昨夜はカムサッカねえ……とか何とか……」「馬鹿にするな」「そこで感心するのは今のマクラ魚です。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚いて崖から転がり落ちると、女も続いてムササビのように飛び降りる。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど北の方の千島、カムサツカ、北海道の山奥あたりから引き上げて来る熊の皮屋から皮を仕入れて、あと月の半ばに東京へ着いたんです……。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ユキ子は、更に私の妻に向つて、「二人で、あたし達に内緒で、野球を見て、帰りにムサシノ館に廻るつもりだつたんですつてさ。",
              "citation": {
                "source": "競馬の日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "春になり仕事が無くなると、カムサツカへ出稼ぎに出た。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "（函館の労働組合は蟹工船、カムサツカ行の漁夫のなかに組織者を入れることに死物狂いになっていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "サロンには、「会社のオッかない人、船長、監督、それにカムサツカで警備の任に当る駆逐艦の御大、水上警察の署長さん、海員組合の折鞄」がいた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな事は絶対にあるべき筈がないが、負けるようなことがあったら、睾丸をブラ下げた日本男児は腹でも切って、カムサツカの海の中にブチ落ちることだ。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それに、我カムサツカの漁業は蟹罐詰ばかりでなく、鮭、鱒と共に、国際的に云ってだ、他の国とは比らべもならない優秀な地位を保っており、又日本国内の行き詰った人口問題、食糧問題に対して、重大な使命を持っているのだ。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムサツカの海は、よくも来やがった、と待ちかまえていたように見えた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでボカされたカムサツカの沿線が、するすると八ツ目｜鰻のように延びて見えた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムサツカの夜明けは二時頃なので、漁夫達はすっかり身支度をし、股までのゴム靴をはいたまま、折箱の中に入って、ゴロ寝をした。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それがカムサツカの「突風」の前ブレだった。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで右舷に見えていたカムサツカが、分らないうちに左舷になっていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、「こんな事に一々ビク、ビクしていたら、このカムサツカまでワザワザ来て仕事なんか出来るかい」――そう浅川の云ったことが、無線係から洩れた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムサツカの連峰が絵葉書で見るスイッツルの山々のように、くっきりと輝いていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の朝、川崎船は半分水船になったまま、カムサツカの岸に打ち上げられていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、それにしては、この遠いカムサツカで、しかも陸も踏めずに死ぬのは淋し過ぎる。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁夫達がワッと事を起して、此奴をカムサツカの海へたたき落すようなことでもないかな、そんな事を考えていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カムサツカで死にたくないな……」「…………」「中積船、函館ば出たとよ。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
