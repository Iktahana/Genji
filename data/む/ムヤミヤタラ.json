  {
    "uuid": "8ce267a2-d8b4-5907-9e50-45462f1cc4b3",
    "entry": "無闇矢鱈",
    "reading": {
      "primary": "むやみやたら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
      "ctype": null,
