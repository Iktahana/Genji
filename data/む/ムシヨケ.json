        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "キャンプに行くなら、強力な虫除けスプレーを持って行ったほうがいい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "窓際にハーブの香りの虫除けを置いて、蚊の侵入を防いでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この虫除け、服の上からでも使えるタイプかな？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "虫除けの網戸を開けて戸をノックした。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これをなあお子供衆のお腰に下げておおきやすと奇体に虫除けになりますそうでなあ方々からくれくれ言やはりますので皆あげてしまいましてなあもうこれだけより残っとりませんけれど――どうぞお持ちやして」　これは尼君がつれづれの手細工であった。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちはやふる卯月八日は吉日よかみさげ虫を成敗ぞする　家の中へこの歌を貼っておくと、虫除けや悪病よけになるとこの地方ではいい伝えている。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「順番といいながら、おめえは、女にばかり先へ汲んでやるじゃないか」「わしも女子は好きだから」「この坊主、極道者だ」「えらそうにいうな、お前たちだって、甘茶や虫除けが貰いたくて来るんじゃあるまい、わしには、分っている、お釈迦さまへ掌をあわせに来るのが半分で、お通さんの顔を拝みにくる奴が半分。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "丙太は、躍って来て、「行ったよっ」「お通さん、いたか」「いた、きょうはな、おばば、お通姉さんは美麗な帯をして、花祭りしていた」「甘茶と、虫除けの歌を、もろうて来たか」「ううん」「なぜもろうて来ぬのだ」「お通姉さんが、そんな物はいいから、はやくおばばに知らせに、家へ帰れというたんや」「何を知らせに？",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "御覧遊ばせ、あれ、あのやうに生きた奴を一匹針で壁にとめて、虫よけの蠱ひが致してございますから。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この紅、土用と寒の丑の日に刷かすをよしとして、当日は小間物やが店先に「本日うし」と筆太に記されたビラの掲げらるるを例とするが、寒中の丑の日に刷いたは、切り傷、皮膚のあれによろしく、土用なるは毒けし、虫よけに用いる。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "忘れず寿江子のおいてゆく服の中へ虫よけのホドジンを入れさせなければ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "寿江子神経質ね、毛布なんかに虫よけが入れてある、その匂いでゼンソクおこすのよ、ですから戸棚にしまってある布団にはねかされないの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "では大事に洗ってよく虫よけいれて、休ませてやりましょうね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを虫よけ入れて、開成山へ送っておきましょう、覚えていらして下さい。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日、南京虫よけの薬をまいた。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "南京虫よけ薬がプンプン匂って、頭がいたくなるような中で、Ｙと大いにプラーヴィ・ウクローンに対するスターリンのやりかたを論じ、Ｙは自分をいろいろな言葉で罵った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸棚の前で、女中は印度の詩人の室に撒く南京虫よけ薬を噴霧器に移した。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また筑前にて、柱に「今年より卯月八日は吉日ぞ髪長虫を成敗ぞする」の歌をさかさまに張りつけおきたるを見たが、これは九州に限らず、虫よけのマジナイとしていずれの国にも行われておる。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　　では、この、毛織物に特効ある虫よけ香錠……。",
              "citation": {
                "source": "運を主義にまかす男",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫よけの粉と、新しい羊皮の靴のにおいがしていた。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはり散らばっている型紙、あい変らずの虫よけ粉の臭い、すみっこの欠けた例の肖像画。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "メダレの用途は土臼を巻く粘土の中に入れ、または除雪用のコイスキに塗って雪の凍み付くを防ぎ、あるいは皮膚の水虫よけに塗ったりしたが、別に食用としては豆腐の製造にこれを利用したそうである。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
