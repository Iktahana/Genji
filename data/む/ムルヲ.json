          "literary": [
            {
              "text": "此ノ限度ヲ破ル目的ヲ以テ財産ヲ血族其他ニ贈與シ又ハ何等カノ手段ニヨリテ他ニ所有セシムルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ納付ヲ拒ム目的ヲ以テ現行法律ニ保護ヲ求ムルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此限度ヲ破ル目的ヲ以テ血族其他ニ贈與シ又ハ其他ノ手段ニヨリテ所有セシムルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "都市ハ其ノ借地料ノ莫大ナル收入ヲ以テ市ノ經濟ヲ遺憾ナカラシムルヲ得。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮臺灣樺太等ノ改造ハ此ノ三大原則ヲ決定スルニ止メ、漸ヲ追ヒテ其ノ餘ヲ施行シ、十年乃至二十年後ニ於テ日本人ト同一ナル生活權利ノ各條ヲ得セシムルヲ方針トス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "……曰く……　――余ノ調査研究セルトコロニ依レバ、既ニ往昔ヨリコノ種ノ犯罪ガ行ワレツツアリシ事実ヲ認ムルヲ得ベシ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ今ヤ柳北ト二子ハ皆青天白日ノ人トナルヲ得テ、高橋子モ亦筆墨ノ勲ヲ奏シテ快ク本社ニ凱旋シ、以テ本日ノ賀筵ニ盍簪相娯ムヲ得レバ、吾徒復タ何ゾ汝ヲ怨ミ汝ヲ責ムルヲ為サンヤ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女王ゑりざべすノ治世ニ於テ、英国教会ノ制度礼儀ニ一大改革ヲ施スベキヲ主張スル一宗派起リ、教会ヲ清ムルヲ旨義トスルヨリ、コノ宗徒ハ自ラ称シテ『清教徒』トイヘリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "楼上ニハ常ニ二隊ヲ置キ階下ニハ一隊ヲ留ムルヲ例トス。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "往往｜駒ノ尾ニ跟キ乳ヲ索ムルヲ見ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
