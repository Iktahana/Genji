        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖父は昔、冬の間に手作業で麦扱きをしていたと話してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "麦扱きは、収穫後の大切な作業の一つだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "農家の庭先では、子供たちが麦扱きの手伝いをしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "此方からも麦扱きを借りたり、饂飩粉を挽いてもらったり、豌豆や里芋を売ってもらったりした。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は余の不相変ぼんやりして麦扱きをして居るのを見て、正気だと鑑定をつけたと見え、来て見て安心したと云った。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "周囲の草場の一部は草が刈り込まれ、そこが麦こきの仕事場になっていて、刈り集められた麦の束が積んであり、その傍には荒むしろが三四枚ひろげられ、その上に牛くさの千歯が据えてある。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（麦こきの仕度が出来て、一息入れるために笠をとる）青年　なに、東京へチョット寄って、今夜中に横須賀へ出なくちゃならんもんだから。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（殆んど福々しいと言える位に柔和な笑顔）青年　どうも――百姓　……（前歯の抜けてしまった大口をパクパク開けて笑いながら、麦こきを続ける）……こんで、暗くなってから家さ戻ったりすると、孫共あ、火じろのわきから俺の方ジロリジロリ見て「おばあ、チョックラ向う向いて見な」などと言いやす。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "話をしながらも麦こきの手は休めない）……だまくらかされて、ちったあ実もならすか……青年　……お百姓も大変だな……百姓　大変な事なんぞ無えよ。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年　……（なんの気もなくポツリポツリと語りながら、休まず急がず麦こき進んで行く相手の横顔を見守っている）百姓　……やれ、どっこいしょと、……ほう、少し風が出て来た。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（チュン、チュンと思い切りよく手ばなをかんで、再び麦こき）青年　……（クスクス笑いながら）……じゃ、僕が唄えば、小母さんも唄ってくれますか？",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "百姓　ううん、いや……（何か考えているらしいが、麦こきの手は休めない）……（気を変えて）船の人が、だども、山へ登ると言うなあ――？",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "百姓　……（フッと麦こきの手を停めて、青年の方を見る）……そうかえ。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（歯の無い口の中を飴玉を彼方へやったり、此方へやったりしながら、やっぱり腰に両手をかった姿で、無表情な顔のまま、再び麦こきにかかった青年の姿に目をやっている）……ふむ……おふくろさんに逢いたからず？",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年　……（チラッと百姓の方を見るが、直ぐはにかんだような微笑を浮べて麦こきの上にかがみ込む）百姓　……いとしげに。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "百姓　……（しかし、これはその笑いに乗って行こうとせず、単純な自然な動作で、黙ってトコトコと寄って来て、青年と入れ代って麦こきにかかる）青年　……そうだ、飯を食っちまっとくか。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女　……（麦こきの手をチョット休めて、微笑）栃沢リキづら？",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女　……（微笑しつつ麦こき）青年　……だけど、そんな、誰にもどうにも出来ない事を、あのお婆さんに。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一言も言わなくても、代って麦こきをする気であることが解り、若い女は麦こきの手を止めて、わきに寄って、立って見る。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（淡々として言い放って又、麦こきにかかる）中年　どうも、へえ……その……（百姓の言葉や態度の中には、何一つ烈しい所は無いが、もうこうなれば、却ってその淡々とした中に抗弁しがたい物が有るらしい。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをよく知っているので、ホッとすると同時に、言葉のつぎ穂を失って、頭を掻きながら、ボンヤリ百姓の麦こきの手元を見守っている）ふう……。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふむ……（首を振り振り、麦こき）へえ、まだ湯はわかねえかや？",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間も麦こきの手は休めない。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
