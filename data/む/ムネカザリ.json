        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖母から譲り受けた真珠の胸飾りを、特別な日のドレスに合わせてつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "スーツの襟元にさりげなく輝く金色の胸飾りが、彼の個性を引き立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "職人が手作業で仕上げた繊細な胸飾りは、芸術品のような美しさだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それから一方では、安河の河上から固い岩をはこんで来て、それを鉄床にして、八咫の鏡というりっぱな鏡を作らせ、八尺の曲玉というりっぱな玉で胸飾りを作らせました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "女五　でも、胸にはあんな美しい胸飾りをつけている。",
              "citation": {
                "source": "世評（一幕二場）",
                "author": "A morality",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、あんなに立派な胸飾りや、ダイヤモンドの耳輪なんかをさせて置いたんだわ。",
              "citation": {
                "source": "世評（一幕二場）",
                "author": "A morality",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「マーメイド・タバンの酌婦には、お前から俺の言葉を伝えておいてくれ――玉虫を見つけたら旅先から届けるからに、俺の君に寄する複雑な愛の徴として胸飾りにしてくれ――と。",
              "citation": {
                "source": "吊籠と月光と",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "外套の襟から窺はれる露はな胸に、粋な誕生石の胸飾りが見えた。",
              "citation": {
                "source": "ダイアナの馬",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで銭湯のような感じで、紅葉の胸飾りをしたお上りさんたちもいる。",
              "citation": {
                "source": "貸家探し",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリヴォフ夫人は、それまで胸飾りのテュードル薔薇（六弁の薔薇）を弄っていた手を卓上に合わせて、法水に挑み掛るような凝視を送りはじめた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "真紅の衣裳に胸飾り、槍を提げた怪美童を一杯に描いた看板が小屋の正面に懸かっている。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤いフリージア帽を頭に載せ、しゃんとからだを伸ばし、眼つき鋭く、胸飾りも引立ち、彼女は両方の耳で代るがわる聴き耳を立てる。",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、海の旅にあきた誰れかれの眼に、きまつて妖しく映るのは、地平線のうへに、次ぎから次ぎへと湧きでる、あの星ともいへぬ星、ひとつひとつが胸飾りのやうに鮮明な、エメラルドの星のまたたきである。",
              "citation": {
                "source": "緑の星",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「結構さ」　鏡の前に立って、白い胸飾りのついた紺のワンピースの腕をあげ、ほそい真珠のネックレースを頸のうしろでとめている伸子を見ながら、素子は、ついこの間気に入って買った皮外套に揃いの帽子をかぶり、まだすっていたタバコを灰皿の上でもみ消した。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人の若い陪席判事は、特別にその後ろの席を与えられてるばら色の帽子のきれいな婦人を相手に、胸飾りをいじりながらほとんど愉快げに話をしていた。",
              "citation": {
                "source": "死刑囚最後の日",
                "author": "LE DERNIER JOUR D'UN CONDAMNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "法衣と胸飾りとを私は見てとった。",
              "citation": {
                "source": "死刑囚最後の日",
                "author": "LE DERNIER JOUR D'UN CONDAMNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもそのシャツの高級感は製麺業者がシャツの胸飾りに小さな鎖でつながった二つのピンを無造作に付けていて、しかもそのピンのいずれにも大きなダイヤモンドが嵌め込まれていたので、一段と引き立っていた。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "仁王立ちの黒人青年が、ルンペンみたいなカーキ服を着て、その胸に例の大宝石「エジプトの星」を、まるで功一級の勲章のように得意然と光らかせているかと思うと、膝の上に頬杖をついた金髪娘が、日本娘の袂の長い着物を着て、両の手首と足首とに、ダイヤの胸飾り、真珠の首飾りを、手かせ足かせの形ではめてすましている。",
              "citation": {
                "source": "黒蜥蜴",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇后には、珠の冠や胸飾りを、帝には座右の符冊典籍までを、車の上から惜しげなく捨てられた。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "でもそれだけじゃダメだから、ゴールドの花つきのお気に入りのケープね、あとダイヤモンドのむねかざりね、ねぇ、これってふつうは手に入らないものなのよ。",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻は、シンガーミシンを踏むことが巧であつた、青丸には、いつもあたらしい布地に、美しい色糸でさ／″＼まな図案の胸飾をした、涎掛を、つくつてゐる。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻は、シンガーミシンを踏むことが巧であつた、青丸には、いつもあたらしい布地に、美しい色糸でさま／″＼な図案の胸飾をした、涎掛を、つくつてゐる。",
              "citation": {
                "source": "泥鰌",
                "author": "小熊秀雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "猶太人がよく、その形をカフス釦や｜襟布止めに用いているけれども、そのダビデの楯（）の六｜稜形が、クリヴォフの胸飾では、テュードル薔薇に六弁の形となって現われているのだ」「だが、君の論旨はすこぶる曖昧だな」と検事は不承げな顔で異議を唱えた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人｜紫紺の薄手な盛衣を着て白い胸飾をした、細りと瀟洒なひどく姿の好い女が折折踊場に出ては相手を求めずに単独で踊の群を縫ひながら縦横に駈け廻る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "月の光がけざやかに老女の上に降りそそいだので、わたしは一人の小造りで素朴な婦人の姿を隈なく見ることが出來た、身なりはいかにも古風な趣味で、小ざつぱりとした髮被ひと胸飾を着け、銀のやうな髮毛が雪白の帽子の下から覗いてゐた。",
              "citation": {
                "source": "クリスマス・イーヴ",
                "author": "アーヴィング",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他に首飾環、胸飾環、瓔珞、耳瑜、耳飾塔、腕輪、指環等の粧飾品で、大変金の掛って居るものが沢山有るですけれども、それらはみな娘の父母がその女子に与えますので、式場に用うる衣服、帯、下着、履の類だけを花聟の父、母から贈って来るです。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてそれは胸飾にはめられて、ルイ十六世に伝えられ、ルイ十六世が断頭台上の露と消えた後は、ブルボン王室の驚くべき宝石の全蒐集と共に、何者とも知れぬ手に盗まれて、しばらく行方も知れずになって居りました。",
              "citation": {
                "source": "呪の金剛石",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "……見せびらかす為にですよ」蠍の胸飾「だがね、君、ここのマネキンがそんな目に合ったとすれば、番頭が気づかない筈はないじゃないか。",
              "citation": {
                "source": "妖虫",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
