[
  {
    "uuid": "9b2c0d43-a83a-597b-bcee-b9d0bbd6a2d4",
    "entry": "無主",
    "reading": {
      "primary": "むしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-の形容詞",
