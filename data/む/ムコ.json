[
  {
    "uuid": "0d716087-8fae-5b66-99fb-12ba6aa33473",
    "entry": "婿",
    "reading": {
      "primary": "むこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
