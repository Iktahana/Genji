          "literary": [
            {
              "text": "皆ガ飲ムノデ予モアイスクリームヲ注文シタガ、婆サンニ止メラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウデスカ、少シハイヽ方デスカ」「イヽドコロカ、マス／＼悪クナル一方ダ」「ダッテ、髯ナンカ剃ッテサッパリシテルジャアリマセンカ」予ハ実ノトコロ、手ガ痛ムノデ剃刀ヲ使ウノモ不自由ナンダガ、ソレヲ怺エテ今朝剃ッタバカリデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ彼女ハ（コンナヲ彼女ハ最モ忌ムノデアル）腺病質デシカモ心臓ガ弱イニモカカワラズ、アノ方ハ病的ニ強イ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハソレヲ考エルト不安デモアリ、彼女ニ罪深イヲ好ムノデアル、―――ヲ刺戟シテ、ソレニヨッテ自分ヲ刺戟シヨウトスル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体妻ハ来客ニ対シテハ不愛想デ、コトニ男ノ客人ニハ会イタガラナイノデアルガ、木村ニダケハ親シムノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
