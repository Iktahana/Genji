    "definitions": [
      {
        "index": 1,
        "gloss": "to itch",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "花粉のせいで、鼻の奥がずっとムズムズしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "足の裏がムズムズして、靴下を脱いで掻きむしりたくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "髪の毛が首筋に当たって、ムズムズして落ち着かない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "暗い、暑い、息詰る、臭い、ムズムズする、悪ガスと、黴菌に充ちた、水夫室だった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどその時に頭山先生は、腹の中でサナダ虫を湧かして、下剤を飲んでいたので、そいつが利いたと見えて待っているうちに尻の穴がムズムズして来た。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに又、頭山先生のお尻の穴がムズムズして来たので、又手を突込んで引っぱると、今度は二寸ばかりの奴が切れ離れて来たヤツを、やはり眼の前の火鉢の縁へ、前の一片と並べておいた。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "道路はその山の根方をグルリとまわって行くのであるが、その山を越えて一直線に行けば三分の一ぐらいの道程に過ぎない……と聞いた二人の心に又しても曲る事を好まぬ黒田武士の葉隠れ魂……もしくは玄洋社魂みたいなものがムズムズして来た。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その涙も、一分も経たない内に収まってしまうと、かの女は、姉に露骨にいってしまった晴々した幸福の方が、ムズムズ強くなった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々だれかの神経が少しさめると、そこにはその神経を待っていた多くの不快な刺激が、それをムズムズとくすぐるのだった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "波田はもうムズムズしていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間が『書生気質』や『妹と背鏡』や『小説神髄』を感嘆する幼稚さを呆れると同時に、文学上の野心が俄にムズムズして来た。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると不思議や、青眼先生の直ぐうしろに寝ていた一ツの首が、白い眼を開いて月の光りを見ながら、唇をムズムズと動かし始めましたが、やがて不意に――「嘘｜吐き」　と云いました。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "などと呟きながら私は、上向きの儘釈然としてゐると、またとろとろとする甘い睡さがムズムズと砂から伝はつて私の五体に滲み込みました。",
              "citation": {
                "source": "晩春の健康",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "沁々した愛情と感謝と宮本百合子-------------------------------------------------------【テキスト中に現れる記号について】：ルビ（例）真個：入力者注　主に外字の説明や、傍点の位置の指定（例）しんがムズムズしているようです。",
              "citation": {
                "source": "沁々した愛情と感謝と",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだかしんがムズムズしているようです。",
              "citation": {
                "source": "沁々した愛情と感謝と",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ああこの腕がムズムズする！",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の女も一度だか私の髪を埋めた事が有った事を思い出すとあんなものの手で埋められたのかと思うと髪の根元がムズムズする様だ。",
              "citation": {
                "source": "秋毛",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は神は信じないで、眉間がムズムズすれば必らず死ぬなどという馬鹿げたことを信じきっているのだ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に二郎氏のポケットの中の指がムズムズと動いた。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その小さい、紅い唇をムズムズと動かしながら、ソッと眼を見開いて、ちょうどその真横に立っている私の顔を見ると、パチリパチリと大きく二三度｜瞬をした。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時に解剖台上の少女の唇が、微かにムズムズと動き出しました。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時に呉一郎の唇がムズムズと動いた。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "呉一郎はそのまま、矢張りマジマジとした眼付きで正木博士の顔を見ていたが、間もなく唇をムズムズと動かした。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頬の赤い色がスーと消え失せて、唇をムズムズと動かした。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……とにかく義足の指の先あたりが、ムズムズして痒くてたまらなくなるんです。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "美妙斎の食指のムズムズしないわけはない。",
              "citation": {
                "source": "田沢稲船",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜中に酔っぱらいが引っぱって来られ、廊下の隅に眠っていた自分は鼻の穴がムズムズするような埃りをかぶって目を醒した。",
              "citation": {
                "source": "刻々",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "久し振りで部屋に落付いて見ると気持がまことによかったけれ共何だか身内がムズムズする様でたまらなかった。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸のあたりや膝を見て居ると、今にもムズムズに動き出して来るようにそう思われた。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "”と云って鼻汁をすすり上げて、しびれて居ると云う足をムズムズとさせた。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒いような、引きしまったような心持のかげに、淫蕩的な熱情がムズムズして居るような心持がする。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ寒い表面――薄氷のはった水の表には、まだ冬の寒さがただよって居ても、その底には、あったかいながれがあるように、――底の方からムズムズ、ムズムズと暖かさがしみ出して来る。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
