        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "良いアイディアが浮かんだので、早く試したくてムズムズしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は試合に出たくて、ベンチで体がムズムズしているようだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "秘密を知ってしまった彼女は、誰かに話したくてムズムズしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
