        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "水　満洲の水は悪いというので、軍隊が基地点へゆき着くと、軍医部では直ぐにそこらの井戸の水を検査して「飲ムベシ」とか「飲ムベカラズ」とか云う札を立てることになっていた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、その札に曰く「人馬飲ムベカラズ」　人間は勿論、馬にも飲ませるなと云うのである。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも満洲の水も「人馬飲ムベカラズ」ばかりではない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇第二条　脳髄局ヨリ反射交感シ来ラザル事ハ、仮令自身ニ行イタル事ト雖モ、事実ト認ムベカラズ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "記憶ニモ止ムベカラズ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――××支庁長は「小作人勝タシムベカラズ。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヨソ将タルモノハ、当ニ剛柔ヲ以テ相済ウベク、イタズラニソノ勇ヲノミ恃ムベカラズ。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
