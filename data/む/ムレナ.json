          "literary": [
            {
              "text": "「アア、チツトモ、オチツイテネムレナカツタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ヨツピテグツスリネコンダノニ、マダネタイデスガ、メガサメテシマツテネムレナイノデ、ホンヲヒロゲテヨミマセウトシマストキウニ、マドノスグソトデ、パタパタトハシリマハルオトガシマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシガ、ヨクネムレナカツタノヲシラナイノカ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ココヂヤアネムレナイ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら復讐をあそばしても、レピドゥスはサルウィディエヌスに、ムレナはレピドゥスに、カエピオはムレナに、エグナティウスはカエピオにつづいて謀を企てました。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
