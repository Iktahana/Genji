        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "汽車が徐行しかかつたと思つた時、「ムツシユウ、もう此処がアムステルダムですか。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、アンリ四世のお城を一と廻りして、ホテル・ド・ラ・フランスの前まで来ると、ぱつたり、ムツシユウ・ロベエルに遇つた。",
              "citation": {
                "source": "アンリエツトの転地療養日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムツシユウ・ロベエルは、詩を書いてらつしやるだけあつて、美しい「微笑みの谷」の眺めを、眼に見えるやうに説明なさる、言葉ははつきり覚えてないけれど、冬の眠りから醒めようとする自然が、微笑みをもつてわれわれを迎へてくれる、明るい、懐かしい谷の名だといふお話。",
              "citation": {
                "source": "アンリエツトの転地療養日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "とみ　　ムツシユウ・真壁たい、きまつとるぢやなツか。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "さと　　ムツシユウ・三谷……。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "やす　　さうさう、今朝、八号に行つたりや、そんムツシユウ・三谷のこツで、みんな大騒ぎだつた。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしや、今ん男と別れたら、また八号にでんごろごろしとつて、代りのムツシユウ・フランセばつかまゆツたい。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "さと　　（そこへ立ちすくんだまま返事が出来ずにゐる）とみ　　ムツシユウ・真壁、をらんばい。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムツシユウ・エ・ラ・アベク・マダム・ウシヤマ。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "やす　　ムツシユウ・真壁が日本に戻るて云ふけん、慌て出したツだらう。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたが、ムツシユウ・真壁と二年間一緒に暮したのも、商売気を離れてのこと、僕があんたの姿をカメラに納めて置きたいと希ふのも、これや、写真師岡なにがしとしてぢやなかです。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "岡　　ムツシユウ・真壁には金がある。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕にはないばツてんが、僕には、ムツシユウ・真壁にはなかものがある。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたは、ムツシユウ・真壁と、さういふ風に平気で別れられるぢやなかですか。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "よね　　ムツシユウのバガアジ・アポルテ・アン・オオ。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "島内　　（もぢもぢしてゐる）やす　　よかばな、ムツシユウ・島内、わしが番しとつてあげるけん。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "とみ　　金田のハゲちやん、善うなかな、毎晩ムツシユウ・島内ば引張り出やあち……。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "よね　　それがくさい、此ん前、米ば積み出す時、ムツシユウ・真壁の握らせ方が足らんだつたけんたい。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "よね　　あんた、ムツシユウに用のあんなら、弁護士に頼んだ方がよかでせう。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "よね　　わしから、ムツシユウ・真壁によう話して見てあげまツしゆう。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "やす　　ムツシユウ・真壁の腹きやあた顔、はじめて見た。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "岡　　ムツシユウ・三谷の奥さんなんか、びつくりしなはつたらう。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "とみ　　島内さん、ムツシユウ・三谷があんたに一寸げな……。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前がそんつもりでをればよかばツてん、ムツシユウ・シヨオドロンにして見れば、代りの女はいくらでんあツとだるけんね。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日もシヨオロンの浜で、しみじみ己へ云うたつなるばツてん、ムツシユウ・真壁が此処えをる間は、どうしてん発たんわけにや行かんて、そぎやん、自分できめとツと……。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "よね　　ううん、ムツシユウしやが、をらんぎりや、自分ぢや、此処えをろごたるて、そぎやん云ふとつた。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "よね　　さあさあ、そぎやん泣やあとつたてちや、どぎやんもなりやせんとだるけん、これからのこつば考へて、気ば太うもつこツたい、ムツシユウのことなんぞ、早う忘れてしまうた方が悧巧もんばい。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（間）そんなら、ムツシユウしやが、をらんぎりや、国に戻ツとば見合せてもよかて云ふとかい。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうすれば、ムツシユウは先へ発つてしまふし、あとは、こつちのしゆうごたるごツたもん……。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "――こつちは女だるけん、ロオラさんの味方にもなるばツてん、日本人としちや、ムツシユウ・真壁の肩を持つて……。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
