          "literary": [
            {
              "text": "ギャルソンのステファンが、「ヴォアラー・ムシウ」と言って小卓にのせて行く朝食は一日じゅうの大なる楽しみであったことを思い出す。",
              "citation": {
                "source": "コーヒー哲学序説",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "食いしんぼうのレコード保有者でも少し風変わりなのは、パリのムシウ・シエールである。",
              "citation": {
                "source": "記録狂時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴルの中、クロク・ムシウといふ、パンの間にチーズやハムを入れて焼いた、薄いサンドウィッチのやうなものがオツで、とてもうまかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
