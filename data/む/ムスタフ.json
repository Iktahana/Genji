        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "このムスタフには、おかみさんと、アラジンと呼ぶたった一人の息子とがありました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "一、アラジンとふしぎなランプ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、お父さんのムスタフは、せめて仕立屋にでもしようと思いました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "一、アラジンとふしぎなランプ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ムスタフは、なげきました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "一、アラジンとふしぎなランプ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お父さんの名はムスタフと言って、仕立屋でした。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "一、アラジンとふしぎなランプ",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母さんは、いつもムスタフが腰かけていた、長いすを教えてやりました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "一、アラジンとふしぎなランプ",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故ならグヂェラートのスルタン・バハドゥルはトルコの将軍ムスタファの援軍を得ていたからである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスタファはヨーロッパ風の戦術を心得、砲兵士官として有名であったが、ヂウの危機の知らせによって、紅海から二隻八百名を率いてかけつけたのであった。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
