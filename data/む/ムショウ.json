        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "達麿忌である、廓然無聖、冷暖自知。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭の中は常に活動して、廓然無聖などと乙な理窟を考え込んでいる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その例の手段を執ろうと思ってそこへ廓然無聖と坐り込んだ訳です。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
