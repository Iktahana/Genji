      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to be offended",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の無礼な態度に、私は思わずムッと来た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "暑い部屋に入ると、ムッと熱気が顔に押し寄せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "不意に彼の顔がムッと変わり、険しい表情になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "なりひらが左膳に、Ｔ「左膳は女に縁が無い喃」　と言われて左膳少々ムッとした。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "受付はそれを受取り急いで二階に上って去ったが間もなく降りて来て「どうぞ此方へ」と案内した、導かれて二階へ上ると、煖炉を熾に燃いていたので、ムッとする程｜温かい。",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "受付はそれを受取り急いで二階に上って去ったが間もなく降りて来て「どうぞ此方へ」と案内した、導かれて二階へ上ると、煖炉を熾に燃いていたので、ムッとする程温かい。",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜はふけ月さえぬれど、そよ吹く風さえなければムッとして蒸し熱き晩なり。",
              "citation": {
                "source": "置土産",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "やあ、朱塗の木棍は、白い膚を虐みつつ、烏賊の※れが臭を放って、また打つとともにムッと鼻をついた。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥の座敷は香木の香がみちみちてムッとする程あたたかかった。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムッとした紀昌を導いて、老隱者は、其處から二百歩ばかり離れた絶壁の上迄連れて來る。",
              "citation": {
                "source": "名人傳",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムッとした紀昌を導いて、老隠者は、そこから二百歩ばかり離れた絶壁の上まで連れて来る。",
              "citation": {
                "source": "名人伝",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして内心不平であれば遠慮なくムッとした色を見せ、残念であれば差し構い無しに怨めしい色をほのめかしているのであります。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "座敷は両側とも雨戸を閉めて、蚊帳が一パイに釣ってあるので、化物屋敷のように暗い上に、黴臭いような、小便臭いような臭気が、足を踏み込むと同時にムッとした。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　結婚――そんな言葉を聞いただけでも、私の胸には甘くて熱い煙りがムッと渦を巻いた。",
              "citation": {
                "source": "或る日の運動",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　如何程父が恐ろし気な顔付きをしても、普段が甘いものでＨは馬耳東風に聞き反らすばかりでなく、反つてムッとして矢庭に父の背中に飛びかゝり、その頭をポカリと擲つたりするのであつた。",
              "citation": {
                "source": "余の倅に就いて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬とは言え珍らしい小春日和で、列車内はスチームの熱気でムッとする程の暖さだった。",
              "citation": {
                "source": "花束の虫",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると母もムッとして、それが自分の生れつきであること、五十年来の習慣であること、今さらそれを非難されても仕方のないことなどを、すねた言葉でブツブツと返答した。",
              "citation": {
                "source": "私の母",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　何しろ社交上の礼儀も何も弁えない駈出しの書生ッぽで、ドンナ名士でも突然訪問して面会出来るものと思い、また訪問者には面会するのが当然で、謝絶するナゾとは以ての外の無礼と考えていたから、何の用かと訊かれてムッとした。",
              "citation": {
                "source": "鴎外博士の追憶",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年は、手軽く外されたために、ムッとして黙ったらしかったが、然し、答そのものは、手答があるので、彼は暫くしてから、口を開いた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、よく考えると、自分のような乞食同様な百姓を、こんな長者の内の婿にするはずはない、これはきっとこの年寄の気が狂っているのか、それでなければ笑談に言っているのだと思いましたから、正直な三郎次は少しムッとして、「子供だと思って私をなぶるのはよして下さい。",
              "citation": {
                "source": "三人兄弟",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷房のきいたレコード屋から出ると、外はムッとする。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな連中がバラック町を横行して、ムッとする位新しい東京気分を作りつつあるので、東京市はまるで生れかわって、古い江戸ッ子は絶滅したかとは思われる位である。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "風の工合で煙が波とすれずれになびいて、ムッとする石炭の匂いを送った。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "トモのハッチに近く、蟹の脳味噌の匂いがムッとくる。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "便所臭い、漬物樽の積まさっている物置を、コックが開けると、薄暗い、ムッとする中から、いきなり横ッ面でもなぐられるように、怒鳴られた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、彼の心の底にわだかまっているムッとした気持が、それでちっとも晴れなく思われた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹の生ッ臭い匂いがムレて、ムッと鼻に来た。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "乳臭い子供の匂いや、妻のムッとくる膚の臭いを探がした。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは別に威張ったことではないが、「平」漁夫にはムッときた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "――真暗な家の中からは、馬糞や藁の腐った匂いがムッと来た。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はムッとしていたらしい。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "その家の主人と言うのは、五十がらみの体の大きなアバタ面の農夫ですが、一行を迎えると、臆病そうに幾度か頭を下げながら穢いムッとする様な杉皮｜葺の豚舎へ案内しました。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
