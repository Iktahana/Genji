    "entry": "ムッと",
    "reading": {
      "primary": "ムッと",
      "alternatives": [
        "むっと",
        "むーっと",
        "むうっと"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-サ変",
        "動詞-自動詞",
