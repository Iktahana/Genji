        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「文字ノ害タル、人間ノ頭脳ヲ犯シ、精神ヲ痲痺セシムルニ至ッテ、スナワチ極マル。",
              "citation": {
                "source": "文字禍",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由契約トセル所以ハ國民ノ自由ヲ凡テニ通セル原則トシテ國家ノ干渉ヲ背理ト認ムルニ依ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "時ニ女子ヲシテ優美纎麗ノママニ發達シタル強健ヲ得セシムルニハ丹田ノ根本ヲ整フル以外一ノ途ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現今ノ武器ノ前ニ立チテ此等ニ尚武的價値ヲ求ムルニ及バズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "爲メニ遂ニ國家ノ法律ヲ抂ゲテ自國民ヲ保護シ彼等ノ財産ヲ奪ハントスル非違ヲ頻出シ不仁ノ名ヲ國家ニ冠セシムルニ至ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三ノ理由ハ三年間ノ日月ハ日本ノ整然タル改造組織ヲ傳聞セシムルニ十分ナルガ爲メニ、日本大多數國民ノ歡喜ヲ傳ヘテ彼等ノ大多數國民亦速ニ其ノ福利惠澤ニ浴センコトヲ欲スルニ至ルベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コーラン」ト共ニ劒ヲ示シテ殺スベシト云フ信仰ト殺ス勿レト云フ信仰トヲ兩立セシムルニ、liberty ナル「アルフアベット」七個ニ依頼セントスルガ如キ淺薄ナル信念ニテ何ノ信仰ゾ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "千載ノ下猶多情ノ人ヲシテ、冷風淡月ノ夕、香ヲ焚キ花ヲ奠シ、遠ク青塚ヲ望ンデ、其艶魂ヲ吊セシムルニ至ル亦宜ナリ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士ハ魏志文ヲ引クニ、伊都國ヨリ邪馬臺マデノ行程ヲバ略カレタレドモ、コレラノ行程ハ、國々ノ位置ヲ求ムルニ必要ナル者ナレバ、多少ノ誤謬ハ免レズトモ、全クハ棄ツベキ者ニアラズ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　「時事ニ関スル事項ヲ掲載スル新聞紙ハ管轄地方官庁ニ保証トシテ左ノ金額ヲ納ムルニ非サレハ発行スルコトヲ得ス、云々」（新聞紙法第十二条）。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "竟ニ俗諺ニモ日本人ハ摸傚ニ長ズ、發明思索ハ長ズル所ニ非ズト謂ハシムルニ至ル。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生ヲシテ診セシムルニ一劑ニシテ癒ユ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔妙齢固ヨリ好容儀有リ／更ニ見ル嶄然トシテ頭角奇ナリ／三日逢ハザレバ人刮目ス／百年何ゾ愧ヂン豹ノ皮ヲ留ムルニ／新秋風月扁舟ノ夢／故里煙花艶体ノ詩／聞説ク東帰期近キニ在リト／天辺岳色朝曦ニ映ズ〕　江戸下谷に生れた枕山の風采は春濤の言うが如く丹羽村の人々の目には「好容儀」であったに相違ない。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、オヨソ戦ニ勝ツハソノ極理兵ヲシテ欣ンデ死ナシムルニ有　と、いう語だった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵法ノ極ハ、兵ヲシテ、歓ンデ死ナシムルニアリ　孫子のいっている用兵の極致にまで到っていない恨みがある。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ攻ムルニハ、塀越シノ槍コソ利アラントテ、十文字、鑰槍ナド打捨テサセ、皆、長柄ノ素槍ヲ持テトテ諸手ニ配ル。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "人を使うことで、思いあたる話は、呉子が武候に与えた兵法の虎の巻にある一項で、「ソレ兵法ノ神髄ハ兵ヲシテ死ヲ楽シマシムルニアリ」　といったことば。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
