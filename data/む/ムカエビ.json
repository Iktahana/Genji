      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "迎火を焚いて誰待つ絽の羽織十八　ただ驚ろかれたのは身体の変化である。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜はこの母の魂を迎へるために夕暮の門に出て迎火をした。",
              "citation": {
                "source": "谷合の碧い空",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "みぞ萩の花さく溝の草むらに寄せて迎火たく子等のをり　蝦夷菊は畑の花、それを野原に移した様な松虫草がある。",
              "citation": {
                "source": "秋草と虫の音",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて魂むかえの夕べは家々の門に迎火の光り淋しく、法衣着た人々の棚経に忙しきも何やらん意味ありげだ。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "苧殻のかわりに麦からで手軽に迎火を焚いて、それでも盆だけに墓地も家内も可なり賑合い、緋の袈裟をかけた坊さんや、仕着せの浴衣単衣で藪入に行く奉公男女の影や、断続して来る物貰いや、盆らしい気もちを見せて通る。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たちはお迎火を焚いて馴れぬ手に珠数をつまぐる。",
              "citation": {
                "source": "八月の星座",
                "author": "吉田絃二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "盂蘭盆の燈籠や果敢ない迎火の烟も見られる。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通な顔をして、門口のお迎火を跨いで入って来てくださればそれでいいのですわ」「迎火を跨いで、それからどうします？",
              "citation": {
                "source": "生霊",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いえね、迎火を跨いで入って来るものがあると、どんな恰好をしていても、それが新仏さまの成変りだといってお斎をあげて帰すのがここの風なんです。",
              "citation": {
                "source": "生霊",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたし、傍にいてうまくやりますから」五　三十郎がお迎火の煙を押跨ぐようにして土間へ入って行くと、竈の前に踞んでいた皺くちゃのお婆さんが火吹竹を持ったままヨチヨチとよちり出て来た。",
              "citation": {
                "source": "生霊",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "お盆てものはお迎火を焚いて仏様をお迎えするときなのよ。",
              "citation": {
                "source": "圓太郎馬車",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしはふだんよりやゝ早めに勤めから帰り、迎火を焚いた。",
              "citation": {
                "source": "萩",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供と、妹と、大きい女中と小さい女中、楽屋惣出でもそれだけの、迎火を焚いたときはさびしかつたが、十五日の晩、送り火を焚くときには、突然のお客さまがあつたりしてにぎやかだつた。",
              "citation": {
                "source": "萩",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「遺稿」では「迎火」とする。",
              "citation": {
                "source": "藤野古白句集",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ」「府下一家一炬を出して施火せよ街衢に冥界の霊を迎火せよ送火せよ」　急ぎ役徒は、戸毎に汗をふきながら告知した。",
              "citation": {
                "source": "仙台の夏",
                "author": "石川善助",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖霊もござるか今の風の音　　　　桃妖　迎火でも焚いている場合かと思われる。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "迎火の消えて人来るけはひかな　　　　子規風が吹く仏来給ふけはひあり　　　　虚子　子規居士のは必ずしも仏でなしに、迎火の消えた闇の門を、向うから人の来るけはいがする、という意味かも知れぬ。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "『鳴雪俳句集』などには出ていないが、鳴雪翁にも「迎火に魂や来る道の鴫飛んで」という句があるよしを、何かで見たおぼえがある。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
