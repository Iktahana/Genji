  {
    "uuid": "45f7e27b-98fb-5ec0-9369-b287a9a398bb",
    "entry": "迎火",
    "reading": {
      "primary": "むかえび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
