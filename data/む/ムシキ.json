        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "茶碗蒸しを作るために、大きな蒸し器にお湯を沸かす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "最近は電子レンジで手軽に使える蒸し器も人気がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "竹製の蒸し器を使うと、木の香りがほのかに移って料理が美味しくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "夕方、樹明さんに招かれて、学校の宿直室で十一銭のお辨当をよばれる、特に鶏卵が二つ添へてある、飯盒を貰つて戻る、御飯蒸器では（飯釜を持たないから）どうも御飯の出来栄がよろしくないので。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中湯田温泉に浸る、飯蒸器を買ふ、温泉はよいかな、そして飯蒸器はありがたいかな（こんな器具でも手持のそれとの間にはいろ／＼改良された個所がある、日進月歩といへば大袈裟だらうけれど、時々刻々進んでゆきつゝある時代を感じないではゐられない）。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒸器、黒釉の薬煎や蓋物、または大きな水甕など、買わないわけにはゆかない。",
              "citation": {
                "source": "全羅紀行",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "○彰化市にて籃蒸（竹の蒸器）を注文する　とにかく大した力のものだ。",
              "citation": {
                "source": "台湾の民藝について",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
