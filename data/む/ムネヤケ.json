        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "脂っこいものを食べすぎると、すぐに胸焼けがする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昨夜の食事は胃に重く、朝まで胸焼けが治らなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「ああ、胸焼けがひどい。胃薬を飲もう。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その間からお酒に胸焼けのしている皮がはみだすのを、招き猫のような手附きで話をしながら、時々その手で、衣紋を押上げるのだった。",
              "citation": {
                "source": "鬼眼鏡と鉄屑ぶとり",
                "author": "続旧聞日本橋・その三",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝台に寝ていても、胸焼けと焼けつくような口の中の妙な味のために、寝つくことができない。",
              "citation": {
                "source": "かき",
                "author": "УСТРИЦЫ",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼は食堂で、むねやけ飯を食った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ジヤガ芋の胸やけが、未だなほらないからお午は抜かう。",
              "citation": {
                "source": "村のストア派",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "※　ボリース・チモフェーイチは夜の床に就くまえの腹ふさげに、松露をオートミールにあしらってすこし食べたが、ほどなく胸やけがして来た。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代り後で少々胸やけ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の終り、母上と古川家叔母達四人と、清月へ天ぷら食ひに案内する、うまくはないが安い、そして後で胸やける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月僕の行く前、二月を宝塚ショウで開け、而も特別出演に江戸川・藤山・エンタツ・アチャコと揃へた他、何と悦ちゃんを定めたといふのだから、もう三月は行かぬと断言した、おかげで食事の暇なく、座へ帰り、すしをつまみ、あと胸やける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "清月で天ぷら、胸やける、油がいけないのだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔風のつまり天金・橋善のこってりしたのは好みに合はず、つまりは関西風の天ぷらなのだが、多く食へば必ず胸やけるのであるが、こゝのは油がいゝのか、ちっともそれがなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も日によって――油が煮つまるせいか、胸やけあり。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "これについで、清月など、胸やけの代りに安いといふ組。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕食、仕方がない、胸やけ食堂でカツとめし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
