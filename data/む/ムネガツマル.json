        "examples": {
          "standard": [
            {
              "text": "恩師の葬儀で、教え子たちが涙ながらに弔辞を読む姿に胸が詰まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "被災地から届いた感謝のメッセージを読み、ボランティアたちは胸が詰まる思いだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "あまりに美しい夕焼け空を見て、言葉を失い、ただただ胸が詰まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "胸が詰まるだけだ」委員Ｎ「長官に申します。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの家族を抱えて、職のないことは胸が詰まる思いである。",
              "citation": {
                "source": "泡盛物語",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから頭を引っ込めると、病室の、鈍い空気が顔を撲って胸が詰まるような気がした。",
              "citation": {
                "source": "みれん",
                "author": "シュニッツレル　Arthur Schnitzler",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
