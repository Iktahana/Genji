[
  {
    "uuid": "80054f9e-6319-5b4c-b479-54ba2b7900a3",
    "entry": "無道",
    "reading": {
      "primary": "むどう",
      "alternatives": [
        "ぶどう",
        "ぶとう"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "inhuman",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "罪のない人々を虐殺するとは、まさに非道かつ無道な振る舞いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "無道な暴君の支配に耐えかねた農民たちが、ついに一斉蜂起した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "そんな無道な要求を押し通そうとするなら、我々にも考えがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ゲーブルの役の博徒の親分が二人も人を殺すのにそれが観客にはそれほどに悪逆無道の行為とは思われないような仕組みになっている。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と言葉を切つて、淋し相に首項垂れて居る日出雄少年の項に手を掛け『それに就けても、惡む可きは海賊船の振舞、かゝる惡逆無道の船は、早晩木葉微塵にして呉れん。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "其鋭利なる三尖衝角は空に閃く電光の如く賊船の右舷に霹靂萬雷の響あり、極惡無道の海蛇丸は遂に水煙を揚げて海底に沒し去つた。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎狼や梟に取囲まれたる犠牲の、生きたる心地は無き娘も、酷薄無道のこの談話を聞きたる心はいかならむ。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「支那も昔は聖賢の教ありつる国」で、孔孟の生れた中華であったが、今は暴逆無道の野蛮国であるから、よろしく膺懲すべしという歌が流行った。",
              "citation": {
                "source": "日清戦争異聞（原田重吉の夢）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとい徳に反対する主義――例せば悪魔主義や本能主義――のようなものであっても、本質はやはり、別のユニックな正義を信ずるところの、同じ倫理線の上に立っているので、この本質の点から言うならば、世に無道徳的なるいかなる主義もないわけである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「無道徳」と「反道徳」とを区別せよ。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "無道徳というのは、全然倫理的観念の外におり、善悪の何れにも没交渉なものを言う。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に反道徳と道徳（通俗的道義観念）とは、同一線上で絶えず衝突するけれども、無道徳は別の並行線に属しており、全然倫理的問題とは没交渉で、どこにも交切する機縁がない。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで将門は明かな勝利を得て、府の日記へ、下総介が無道に押寄せて合戦しかけた事と、これを追退けてしまつたことをば明白に記録して置いて、悠然と自領へ引取つた。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "純粋の美しさは、いつも無意味で、無道徳だ。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、この鼻のさきに突きつけられた、どうしようもないほど私に似ている残虐無道のポンチ画。",
              "citation": {
                "source": "めくら草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何が不孝じゃ、不義に陥ろうとしているところを、陥らせまいと思うて諌めておるのじゃ、其処許のような無道人に阿諛を云われて、人の道を踏はずそうとしているところを、はずさせまいとするに何が不孝じゃ」「もう、よし、云うな」　不快な顔をして坐っていた元親は、急に立ちあがって奥の間へ入ってしまった。",
              "citation": {
                "source": "八人みさきの話",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "役人の無道を咎むる者無きを泰平の御代とばし思ひ居るか。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "かほどの無道の磔刑を、怨み悪む者一人も無しとばし思ひ居るか。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "只晴賢と戦争するについて、主君の為に晴賢の無道を討つという看板を掲げ、名分を正したに過ぎない。",
              "citation": {
                "source": "厳島合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "無道の人は宜しく早く掃除くべし。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「悪逆無道の親殺を討ちとりにまいった者じゃ、道家孫八郎の伜孫太郎でござる」　それは背の高い眼の鋭い男であった。",
              "citation": {
                "source": "赤い土の壺",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆道三の臣で悪逆無道の義竜を殺しに来たところであった。",
              "citation": {
                "source": "赤い土の壺",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾は刑場に往くのをこばんで無実であることを言いはったが、心では九幽十八獄にもこんな無道理なことはないと思うて、悲しみと怒りで泣き叫ぼうとしたところで、仲間の呼ぶ声が聞えてきた。",
              "citation": {
                "source": "続黄梁",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "盗人にも三分の理ありとか、虎はかく人畜を残害するもののそれは「柿食いに来るは烏の道理｜哉」で、食肉獣の悲しさ他の動物を生食せずば自分の命が立ち往かぬからやむを得ぬ事だ、既に故ハクスレーも人が獣を何の必要なしに残殺するは不道徳を免れぬが虎や熊が牛馬を害したって不道徳でなくて無道徳だと言われたと憶える。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "わりあいに小さな悪事から、私は大またぎにエラガバルス（２）だってやれないような大悪無道へ跳びこんだ。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（ああ、われこそは心｜頑に、情なく邪慳無道であったずれ。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那でも兵器の神威を説いたもので、越王泰阿の剣を揮えば敵の三軍破れて流血千里といい、湛盧の剣は呉王の無道を悪んで去って楚に往ったといい、漢高祖が白蛇を斬った剣は晋の時自ら庫の屋を穿って火災を遁れ飛び去った由（『淵鑑類函』二二三）。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "その訴訟のうちに、いかに大切な宝であるとしても、人間ひとりの命を一枚の皿と取換えようとするのは、あまりに無道の詮議であるというような意味を権次は洩した。",
              "citation": {
                "source": "番町皿屋敷",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ言いたいことはたくさんあるが、こんな無道人に対して論は無益とあきらめて、自分は自分として取るべき途を取るよりほかない。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊にこれは直接に自分の身の上に降りかかる大事件であるので、かれは無道の父に対するよりも、更に強い不満を感じた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
