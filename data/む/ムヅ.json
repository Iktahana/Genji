        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ワタシハ　モウ　一ツキアマリ　カタナヲ　ヌカナイノデ、ウデガ　ムヅムヅスル。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オマヘハ　ドウダ、ウデガ　ムヅムヅシテルンダラウ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "四肢を延ばして上向けになると、またトロトロとする甘い睡さのやうなものがムヅムヅと砂の中から滲み出て――さつきと全く同じ気持に返つて居りました。",
              "citation": {
                "source": "砂浜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうすると頬のあたりがムヅ痒くなつて、危く涙がこぼれさうな気がした。",
              "citation": {
                "source": "熱海へ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳の中がムヅムヅと擽つたくつて擽つたくつて……いやはや、癇癪玉が破裂しました！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "能く世間にある徳行の君子なんて云う学者が、ムヅ／＼してシント考えて、他人の為ることを悪い／＼と心の中で思て不平を呑で居る者があるが、私は人の言行を見て不平もなければ心配もない、一緒に戯れて洒蛙々々として居るから却て面白い。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはさておき、私のうちの一脈は、開戰と同時に皆がムヅムヅムヅとして來たやうだつた。",
              "citation": {
                "source": "日本橋あたり",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうなると、頭だけが借用物のやうで、そんなのを見るたびに、背中へ羽蟲が飛んではいつたやうにムヅムヅする。",
              "citation": {
                "source": "私の顏",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "廻りのものやおしょさん夫婦は種々骨を折ってしゃべるが、かんじんの少年客はムヅとしている。",
              "citation": {
                "source": "明治座今昔",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も気ムヅかしやの作家達の或る者によると、批評というものは甚だツマらぬ怪しからぬ無益なもので、特に時評に至ってはなっていないということだ。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ラジオがその政治的な本質、政治的な使命、を自覚しているかいないかという判定は甚だムヅかしいわけだ。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこまで夫を自覚してよいか、どの程度に自覚を止めておくべきか、という例の兼ね合いが、ムヅかしいのである。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度命令によって人を殺した者が殺人の責任者となり得るかどうか、ということと同じにムヅかしいのである。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそれにムヅ痒ゆいやうな誘引力を感じた。",
              "citation": {
                "source": "受驗生の手記",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "野にあつて腕のムヅ痒さに堪へぬ者共を幕府が召し集めて、最も好むところの腕立てに任せる役目」云々とある。",
              "citation": {
                "source": "中里介山の『大菩薩峠』",
                "author": "三田村鳶魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じことを、もっとムヅカシイ、わかりにくい言葉で言う技術を持っていれば、さらによい。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時自分の心はムヅ痒いやうな苦しいやうな快感を覺える。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思想の胎兒を流産するの寂しさも、行きたい方に行かずにムヅ／＼するの腹立しさも、金持の人は恐らくは（此意味に於いては）知るまい。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅程は小アジアのラヤッツォから上陸し、アルメニアの方へ迂曲してバグダード、バスラを経由、ペルシア湾をオルムヅまで航海し、そこからイラン高原を突切ってバルクに出で、峻嶮な山越しにカシュガル、ヤルカンド、コータンと昔のシナ・インド交通路を伝って行く。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとはインドの西海岸沿いにペルシアのオルムヅまで航海するのであるが、ここでマルコ・ポーロはインド洋の西方沿岸についてソコトラやザンジバルやマダガスカルの島々のことを伝聞している。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくして九月末にポルトガル艦隊はオルムヅに現われた。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "で彼はオルムヅの摂政に書を送り、アルブケルケの有害な戦争遂行を不愉快に思うこと、オルムヅの貿易船の安全を保障することなどを伝えた。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
