[
  {
    "uuid": "558befa3-a94d-50df-ba64-a2b676422aab",
    "entry": "無闇",
    "reading": {
      "primary": "むやみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "thoughtless",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "無闇な約束は後で自分の首を絞めることになるから、慎重に返事をするべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "その場の感情に任せた無闇な発言が、長年の友人関係を壊してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "無闇な批判を繰り返すよりも、建設的な意見を出すことが求められている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "無闇に井戸を掘って熱泉を噴出させたために規則正しい大湯の週期的噴泉に著しい異状を来したというので県庁の命令で附近の新しい噴泉井戸を埋めることになった。",
              "citation": {
                "source": "箱根熱海バス紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さめて見たら枕が無闇に固くて首筋が痺れていたそうである。",
              "citation": {
                "source": "夢判断",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは新しい研究という事はいくらも出来るが、しかしそれをするには現在の知識の終点を究めた後でなければ、手が出せないという事をよく呑み込まさないと、従来の知識を無視して無闇に突飛な事を考えるような傾向を生ずる恐れがある。",
              "citation": {
                "source": "研究的態度の養成",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが一日ベルリンのフィルハーモニーで公開の弾劾演説をやって無闇な悪口を並べた。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "またその試験というのが人工的に無闇に程度を高く捻じり上げたもので、それに手の届くように鞭撻された受験者はやっと数時間だけは持ちこたえていても、後ではすっかり忘れて再び取りかえす事はない。",
              "citation": {
                "source": "アインシュタインの教育観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "無闇に読みもしない書物を並べ立て、用もない孫引きの文献を並べるような事も好まなかった。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人には無闇に本を読んでも駄目だと云ってはいたが、実によく読書し、また人の論文でもよく目を通した。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれに比べると外の多くの騒がしい絵は、云わば腹のへっているのに無闇に大きな声を出しているような気のするものである。",
              "citation": {
                "source": "ある日の経験",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「元来人類の眼はかなり遠距離の物体を見るように進化して出来ているものであるが、近年のように書籍や新聞雑誌などが無闇に沢山になっては一通りでも眼を通すのはなかなか大抵の事でない。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その度ごとに本屋の書架から手頃らしいと思われる註釈本を物色しては買って来て読みかけるのであるが、第一本文が無闇に六かしい上にその註釈なるものが、どれも大抵は何となく黴臭い雰囲気の中を手捜りで連れて行かれるような感じのするものであった。",
              "citation": {
                "source": "変った話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "小初が無闇に泳ぎ抜くのは、小初が興奮しているからである。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小初は無闇やたらに泳ぎ出した。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう憂鬱に襲われたときには無闇に煙草を吹かしてこの憂鬱を追払うように努力する。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また金なぞ持っていたとて仕方がないとパッパと使い散らすものがあると同時に、今更銭を受取ってどうなるものかと物を売らなくなったので、物価だけ無闇に高価くなったけれども銭は殆んど通用しなくなった。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（阿難少時｜緘黙、再び激昂の調子になり）その刹那、血塗った蓮華が何処よりともなくばらばらと飛んで来て、わたしの身心に纏い付き、そしてわたしは無闇にここへ運ばれて来た。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は陸を参ろうと存じましてございましたが、ついこの年者と申すものは、無闇と気ばかり急きたがるもので、一時も早く如来様が拝みたさに、こんな不了簡を起しまして。",
              "citation": {
                "source": "取舵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも私は書物を買うことが好で、「お前は役にも立たぬ書物を無闇に買うので困る」と、毎々両親から叱られている矢先である。",
              "citation": {
                "source": "一日一筆",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「無闇に吠えて困るんです。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "お酒を飲むと、無闇に悪巫山戯をして……。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "市郎は何処を何う歩いたか、半は夢中で無闇に進んで行った。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "お葉は唯無闇に行手を急いだ。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も権次が無闇に振廻す松明の火に恐れて、彼は忽ち逃げ去った。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　斯う云いながら、巡査は無闇に松明を振廻すと、火の光は偶中りに岩蔭へ落ちて、燦たる金色の星の如きものが暗に浮んだ。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し、その倶楽部は恐しいと云っても決して見境もなく無闇矢鱈と恐ろしい事を企てるのではなくて、ただ倶楽部で決められた則をやぶった者に対してだけ少しの容赦もなくその法外にきびしい制裁を下すと云うのであって、彼等倶楽部員は皆、極端なる、「不正を悪くむ紳士方」であるのです。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "電灯を捻ねって、「ここのところは形が違ってら、こう直せよ」　逸作が消しパンで無雑作に画の線を消しにかかると、息子はその手に取り付いて、「あ、あ、だめだよ、だめだよ、お父さんみたいにそう無闇に消しちゃ」　消させぬと言う、消すと言う。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人たちだつてまへから知つてゐたに違ひない、と無闇に人を疑つた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "無闇な指図の他は、お逆らいでも何でも許してあげますから、男らしく、もっとはっきり言いなさい。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "無闇に字面を飾り、ことさらに漢字を避けたり、不要の風景の描写をしたり、みだりに花の名を記したりする事は厳に慎しみ、ただ実直に、印象の正確を期する事一つに努力してみて下さい。",
              "citation": {
                "source": "芸術ぎらい",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その仙台平なるものの思い出を大事にして、無闇に外に出して粗末にされたくないエゴイズムも在るようだ。",
              "citation": {
                "source": "善蔵を思う",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこにはむやみと生硬の漢語や、俗悪で不自然な言葉のアクセントや、中学生じみた幼稚な興奮や、およそさうした類の低能な感傷的表情を、むやみと鼓張した態度で一本調子に並べたてられて居た。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "excessive",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
