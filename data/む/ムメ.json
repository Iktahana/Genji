    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（フラムメリオンの如き天文学者は明かにこの事を断定している）。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この結果に拠れば、広い室で演説する場合ならば、一時間につき一四四ないし二八八キログラムメートルの仕事をする。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "其歌は古の恢復せられたるエルザレム（ジエルザレムメ、リベラアタ）の調にあらず、大統領の族絶えて、獅子の翼の外人に縛せられてより、ヱネチアの民はその歌謠の上の國粹をさへ失ひつるなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して曰ふ、トラゲヂーの出来事は人物が其力量識見徳行の他に超抜するにも係はらず、不幸の末路に終へしむる所の衝突を有し、コムメヂーの出来事は素志を全うし幸福嬉楽の境に赴かしむる所の衝突を有すと。",
              "citation": {
                "source": "罪過論",
                "author": "石橋忍月",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の演劇に寄せる近郷近在の人気は、遠く西方の国のかのオルベルアムメルゴウ村の聖劇にあつまる世界各国の讚美の声の有様を眼のあたりに見るが如き概があつた。",
              "citation": {
                "source": "バラルダ物語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に胴体である、再び左右のシムメトリーを保つ美しい半球の乳房である。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしさう云ふ最後の日までは、やはり先の切れた尾を振りながら、あの洒落者のブラムメルのやうに、悠々と泳いでゐようと思ふ。",
              "citation": {
                "source": "動物園",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一三〇四年ラストラ（フィレンツェの北二マイルの村）の戰ひ敗れて血に塗れしをいへるならむ、或ひは曰く、事成らずして恥づる意と七〇―七二〔第一の〕一人一黨となりて後最初の〔ロムバルディア人〕バルトロムメオ・デルラ・スカーラ（一三〇四年三月死）。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エムメにて百合となる」とはエムメの文字をゑがきて百合の形を成しゐたる意〔印象を〕鷲全體の形を。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "但しエドワードとロバート・ブルースとの爭ひは一三〇〇年より後の事なれば異説あり〔渇〕領土の慾一二四―一二六〔スパニアの王〕カスティール王フェルナンド四世（一二九五年より一三一二年まで王たり）〔ボエムメの王〕ヴェンチェスラウス四世（淨、七・一〇〇―一〇二並びに註參照）やボエムメはボヘミア。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "天上の聖徒をChiesa trion-fante（凱旋の寺院）といふに對す五五―五七是故に彼はその未だ死なざるさきに、人の世より天に來ることを許さる〔エジプト〕昔ヘブライ人がエジプトに奴隷たりし事あるに因みて人の世をエジプトといへり（淨、二・四六―八註參照）〔イエルサレムメ〕天堂。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "帽子は薄餅も同じことで、そんなものはチムメルマンの店で買えます。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "囘教徒の來朝は唐の高宗の永徽二年（西暦六五一）以來白衣大食（オムメヤ王家）黒衣大食（アバァス王家）の使者が屡※長安に來貢した外、肅宗の時、安史の亂に、大食より援兵が來て、東西の二京恢復に預つて力あつた。",
              "citation": {
                "source": "創建清眞寺碑",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "この三つの氷河の裾は、シュワルツ・メョンヒの直下に、深い深いゴージを刻んで、トゥリュムメル・バッハ 〔Tru:mmel-Bach〕 の瀑布となる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆さんは英吉利生れだから、イングリッシュとホームメードが鼻について、気障でやりきれない。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間ばかり散歩しているうち、また大降りになった、ホテルは私一人で少々｜寥し過ぎるくらいだ、晩餐のあとで主人にいろいろ聞いて見たが、彼の云うところによると、御客がよく行くのは先ず此の辺では、町の東に当って湖水の沢山集まったモント・ゼーからカムメルゼーをぬけて、トラウンゼーに行くんだそうな。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいくたびとなく、シュピーツベルクの上に立った、刈草の香のこもる牧には、まばらに白く、キュムメルが咲きのこって、森かげに、からころと、ツィーゲングロッケの響くのも、もの寂しい。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る場合には物理学の根本原則さえが、この操作の制約を受けて初めてその形態を与えられる（例えばマクスウェル電磁方程式のシムメトリ形式から、相対性理論の手続き上の成立動機が生じた如き）。",
              "citation": {
                "source": "科学論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そういうパセティックな考えすらも（それはたぶんジムメルあたりの考えであったろう）、いまの自分にはなんとなく快い、なごやかな感じで同意せられる。",
              "citation": {
                "source": "大和路・信濃路",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "模様の類は紙を四つ折又は八つ折にして置いて切りぬいてから紙をひらくと其処にシムメトリイが出来るわけである。",
              "citation": {
                "source": "智恵子の紙絵",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがこの「森の酒場」の陽気な行事である通りに、博士も亦大いなる壺に水を満し其れにしたたかキュムメルを加へて妙なる青白き液体となし、酒場の娘クララの青春を讃へ乍ら我が魂を呑むが如くに呑みほす途端に、位置に多少の錯覧を起して何のためらう所もなくザッと全身に浴びて了ふのであつた。",
              "citation": {
                "source": "霓博士の廃頽",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反して「マミムメモ」と「バビブベボ」は一度も使用せられず、また「パピプペポ」もピが「トッピャッピ」に一度だけ特例的に使われているにすぎない。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "清音中でこれに相当する唇音はマミムメモあるのみであるから、マ行に濁撥音記号をつけるのが理窟には合っているだろう。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いまになってそんな本読むなんて、そんなシニスム、下等だわ」　なにが問題になっているのだろうと思ってタイトルをのぞいてみたら、〈ハムメルライト著、ピストルと自動拳銃射法〉と書いてあった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "例を申しますなれば、エドワアド・ウイムバアは最初の英吉利人、ハンス・ジムメルマンは最初の墺太利人、アブ・アッサンは最初の土耳古人でございました。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校教師デリツク、フアン、ブムメルがぽつ／＼と読む文句を、かれ等はまあどんなにか真面目に聞いて居ましたらう。",
              "citation": {
                "source": "新浦島",
                "author": "RIP VAN WINKLE. EINE NACHGELASSENE SCHRIFT VON DIETRICH KNICKERBOCKER.",
                "note": "青空文庫"
              }
            },
            {
              "text": "リツプはあの広い顔の、頤の二重になつた、綺麗な、長い烟管から、空論の代りに烟りを吹く、賢いニコラス、ベツタアか、又は古びた新聞の話を聞かする、教員のブムメルは居らぬかと、見廻はしても、遂に見当りませなんだ。",
              "citation": {
                "source": "新浦島",
                "author": "RIP VAN WINKLE. EINE NACHGELASSENE SCHRIFT VON DIETRICH KNICKERBOCKER.",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
