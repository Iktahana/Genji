        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "從テ何等カ不穩矯激ナル者ノ伏在セルカニ感ジテ草案者ニ質問照會スル等ノナカラムコトヲ望ム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち強盗でも何人でも深夜他人の家に忍びこんだ者が妻を殺さんとしている場合は明かに刑法第三十六条のいわゆる急迫不正の侵害であるし、これに向って発砲することはすなわち、『已ムコトヲ得ザルニ出デタル行為』と認めてよろしかろうと思う。",
              "citation": {
                "source": "黄昏の告白",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ聞くところによれば、大川氏の携えていたピストルはなんらの許可を得ずしてもっていたものとのことであるから銃砲火薬類取締規則に触れることは別問題である」参照　刑法第三十六条――急迫不正ノ侵害ニ対シ自己又ハ他人ノ権利ヲ防衛スル為メ已ムコトヲ得ザルニ出デタル行為ハコレヲ罰セズ。",
              "citation": {
                "source": "黄昏の告白",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月十二日◯昨夜モ敵三回来襲ス、薄雪アリ冷雨時ニ落チ冷エ込ムコト甚シ、遠方ニ男女ノ警防団員ノ声ス、皇土ヲ護ル当代ノ人々ナリ、感涙ヲ禁ジ得ズ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "遂ニ熄ムコトノナイ軋轢ニ　タチクラム濛気ノ中ヲ　荊棘ヲ※ツテ　起チナホル身ヲ震ハスオレダ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ、コノ信念ハ外ニ於テハ国家ニ不忠、内ニ於テハ国教ニ不信ナリトノ理由ヲ以テ、彼等ハ自国ニ住ムコトヲ極度ニ圧迫セラレタルヲ以テ、故国ヲ逃レテ和蘭ノ地ニ来リ、更ニ北米ノ天地ヲ求メタルモノナリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "（６）怡然自樂ノ怡モ樂シムコトナレド、同ジ譯語ヲ用フル事能ハザレバ、少々區別シ、「怡」ノ尤近キハ調和ノ和或ハ調ナレドモ、コレヲ如何ト思ヒ、心やすらげに見ゆト譯シタリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗣子紳六郎男、其伝ヲ携ヘ来リテ之ニ序セムコトヲ需ム。",
              "citation": {
                "source": "西周伝",
                "author": "序",
                "note": "青空文庫"
              }
            },
            {
              "text": "母｜妊ムコト十三月ニシテ産ム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "直ニ賢兄ノ伝ニ至ルヤ手ノ舞ヒ足ノ蹈ムコト跛者ノ忽ニシテ立ツガ如シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔吾ガ俗奇ヲ好ムコト何ゾ此ニ至レルカ／小草大花殆ンド弟兄ナリ／昨日官家俄カニ令ヲ下シ／其ノ尤アル者ヲ罪シ価太ダ軽シ／富家失望シテ諸ヲ市ニ売リ／花戸色｜沮ヒテ品評ヲ厭フ〕云々。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔南坊北巷望ムコト隣リノ如シ／我往キ君来ル数武ノ塵／何ゾ幸ヒナルヤ門庭接近ヲ成シ／恰モ宜シ詩酒精神ヲ闘ハスニ／柳橋妓ニ命ズルハ少年ノ興／駒野禅ニ参ズルハ前世ノ因／廿歳旧游游ビテ未ダ了ヘズ／又台麓酔吟ノ人ト為ル〕　昆渓が下谷に来ると間もなく毅堂が下谷を去った。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余｜乃携ル所ノ巨玉巵ヲ出シ自ラ酌ムコト三タビニシテ、コレヲ属シ即チ辞シテ去ラントス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ニハ実力ガナイ代リニ、美女ヲ美男ニ嗾ケテ、家庭ニ紛紜ヲ起サセテ、ソレヲ楽シムコトハ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナコトヲ今知ッタノカ、君ミタイナ利口ナ人ガ」「ダケド、ドウ云ウ気持カラソンナコトヲ考エルノ」「自分デ恋ノ冒険ヲ楽シムコトガ出来ナクナッタ腹癒セニ、セメテ他人ニ冒険サセテ、ソレヲ見テ楽シム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何度モ／＼ヤリ直シヲシテ倦ムコトヲ知ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サエ生ヤセバオマエハ何モ考エルコトモ悩ムコトモナク、タダ私ノ命令二従ッテイルダケデ生キラレルノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "マクは、ムコトに相當する。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっともわが国では、同様式のものを時代によって「妻問」と「婿取」（ムコトリ）とに呼び分けている。",
              "citation": {
                "source": "女性史研究の立場から",
                "author": "高群逸枝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
