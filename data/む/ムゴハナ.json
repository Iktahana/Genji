        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ことにチエンロッカーと彼女らとの関係は惨鼻をきわめた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、それから何十年経った後のことだったろうか、はからずも流島のさい実家に送った文書が嵯峨家から発見されて、ようやく惨鼻を極めた流島史が陽の目を見ることになった。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "老弱男女三万人、一人残らず死んだのは惨鼻の極と云うべきか壮烈の限りと云うべきか、世界的有名な宗教戦は四郎の運命と終始して、起り且つ亡びたのでございます。",
              "citation": {
                "source": "天草四郎の妖術",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "警官として斯ういう場面に慣れている筈の私でさえ正視に耐えない程、惨鼻を極めた屍体だったのだ。",
              "citation": {
                "source": "双面獣",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "またしても言うが、お千代の最後は惨鼻の極だった。",
              "citation": {
                "source": "電気看板の神経",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "警察医吉田弥三郎氏の鑑定によれば、決闘は本月十八日より、二十一日払暁の間に、行われたものと見られ、無人の孤島のため知る人もなく、今日まで四日間、放棄せられしものと判明、屍体は惨鼻を極めている。",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "業火の海に、惨鼻な血が、五月雨ほど流された。",
              "citation": {
                "source": "田崎草雲とその子",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "洲股川の濁流｜逆まく闇夜、さしもの城方の野武士勢も、初めて味わったほどな惨鼻な戦争をした。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "譎詐や権謀や、あらゆる醜い争闘は、むしろ、血の巷よりは陰険でそして惨鼻だ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人は、戰爭は慘鼻だといふ。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "東櫻島村黒神小學校に隣れる神社の石華表は其上方の一部のみを灰の上に露はせり、この附近の人家は何れも全く浮石と灰の下に埋沒し、熱の爲めに蒸し燒と爲れる状實に慘鼻を極めたり。",
              "citation": {
                "source": "櫻島噴火の概況",
                "author": "石川成章",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
