          "literary": [
            {
              "text": "「ハンムンムンムンムン・ムムネの市まで、もうどれ位ありましょうか。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンムンムンムンムン・ムムネ市の入口までは、丁度この足さきから六ノット六チェーンあるよ。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしはムムネ市の刑事だ。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は今度はじめてムムネの市に出る処です。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてそれから十五分でネネムはムムネの市までもう三チェーンの所まで来ました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "依って今日より七日間当ムムネ市の街路の掃除を命ずる。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばけもの世界のハンムンムンムンムン・ムムネ市の盛んなことは、今日とて少しも変りません。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
