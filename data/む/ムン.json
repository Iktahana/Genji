    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「だつて先生は、はやく読むんですもの……」　お祖母ちやんは黙つて笑ひさうにしてゐた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダウンと書いてダン、と読むんぢやい。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "で結局僕は僕の心の虫をいつくしむんだ。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして現実は、過去の習慣と、伝統と、それから本能とだけの重圧で、息もつけないほど、むんむんしている。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれたちじゃとても太刀打ちができねえから、やっぱりストキに頼むんだね」「じゃあ、今夜要求条件をこしらえて、それに全部で連印して、それを船長に提出しようじゃないか」波田がいった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "マストのテッペンから海へ飛び込むんだ！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれで行きゃ、こちとらだって、いつでもこんなに苦労しなくても済むんだが」「そうさ、力の強いのが勝つんだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴族は、寝ながら飲むんでしょう？",
              "citation": {
                "source": "朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母さまは私の手もとをじっと見つめて、「あなたの靴下をあむんでしょう？",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「たったいまお帰りになりましたが、大勢さんで、これから西荻のチドリのおばさんのところへ行って夜明しで飲むんだ、とかおっしゃっていましたよ」　私よりも年が若くて、落ちついて、上品で、親切そうな、これがあの、おステさんとかいうあのひとと大あつあつの人なのかしら。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "祝宴に列席していた村人たちは、何か不吉なものを感じたが、それでも、めいめい気持を引きたて、狭い家の中で、むんむん蒸し暑いのも怺え、陽気に歌をうたい、手を拍った。",
              "citation": {
                "source": "走れメロス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "先王の幽霊が毎晩あらわれて、かたきをとっておくれって頼むんだそうですよ、ハムレットさま、あなたに。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分、あるだろうと思うけど、君もいろんなものを読むんだね。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、何だ、それで家を畳むんじゃねえ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）とおっしゃって、とそれまでも望むんじゃないのです。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分で自分を酒で殺しちゃ、厭じゃありませんか、まあ、」　と一際｜低声で、「ちょいと、いかな事ても小待合へなんぞ倒込むんですって。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が頼むんだから助けると思って肯いて頂戴、ねえ……それじゃ、あんまり貴下薄情よ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小使と私と二人口でさえ、今の月謝の収入じゃ苦しい処へ、貴女方親子を背負い込むんだ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴下は安東村の貞造の馬小屋へでも引込むんだ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は我慢をするけれどね、お浜が可哀そうだから、号外屋でも何んでもいい、他の商売にしておくれって、三ちゃん、お前に頼むんだよ。",
              "citation": {
                "source": "海異記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつ煩っても、ごまかして薬をのんだ事のない人が、その癖、あの、……今度ばかりは、掻巻に凭懸っていて、お猪口を頂いて飲むんだわ。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）って俯向くんです、……枕にこぼれて束ね切れないの、私はね、櫛を抜いて密と解かしたのよ……雲脂なんかちっとも無いの、するする綺麗ですわ、そして煩ってから余計に殖えたようよ……髪ばかり長くなって、段々命が縮むんだわねえ。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "涼むんならこういうときじゃないか。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、橋板が、きしむんだ。",
              "citation": {
                "source": "海の使者",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう時は花道を歌で引込むんです、柄にはありませんがね。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの沼は、真中が渦を巻いて底知れず水を巻込むんですって、爺さんに聞いています……」　と、銑吉の袂の端を確と取った。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「それじゃ、私たち差出た事は、叱言なしに済むんだね。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……「ひどい墨だな、あやしい茶人だと、これを鳥の子に包むんだ。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
