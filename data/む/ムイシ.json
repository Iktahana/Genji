[
  {
    "uuid": "dc8090c2-9495-58bc-a36f-cf34c38b4431",
    "entry": "無意志",
    "reading": {
      "primary": "むいし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-の形容詞"
      ],
