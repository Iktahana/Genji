        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから次に一切の無節制と放縱を。",
              "citation": {
                "source": "室生犀星に與ふ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実感織田作之助　文子は十七の歳から温泉小町といわれたが、「日本の男はみんな嘘つきで無節操だ。",
              "citation": {
                "source": "実感",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし手首の柔らかいということは無節操でもなければ卑屈な盲従でもない。",
              "citation": {
                "source": "「手首」の問題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "雙方に相當の主張は有るが、攻掠侵伐の爭亂が不節用の奢侈、無節度の生活に本づく場合の多いことも疑ふことの出來ない道理で、墨子の時代の君民皆放縱であつたに對し、墨子が節用を強調したのも確に一面の眞理を含んでゐる。",
              "citation": {
                "source": "墨子",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い時分は無節制に恋愛関係をお作りになったものだからね。",
              "citation": {
                "source": "源氏物語",
                "author": "常夏",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさか殺そうとまで計画しなかったけれども、そんなに義理人情を弁えない兄夫婦であるならば、その無節操な嫂に対して敢えて不倫を行ったところで、自分の良心に恥ずべきところは些もない筈だと考えて、窃に機会を待つことにした。",
              "citation": {
                "source": "勝敗",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "育って来た環境も環境だったが、彼には何か無節制な怠けものの血が流れているらしく、そうした家庭生活の息苦しさも感じないわけに行かなかった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある種の歌が怪しく空虚に見えたり虚飾に見えたりするのは、主として観照の態度、物に対つての精神の据ゑ方、感じ方が先づあやふやな上に、不純な小主観を交へ過ぎたり、不謙譲だつたり、身構へしたり、才情の放恣、無節度と云ふ点から来る。",
              "citation": {
                "source": "雀の卵",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "終りに臨んで君が延岡に赴任されたら、其地の淑女にして、君子の好逑となるべき資格あるものを択んで一日も早く円満なる家庭をかたぢ作つて、かの不貞無節なる御転婆を事実の上に於て慚死せしめん事を希望します。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "終りに臨んで君が延岡に赴任されたら、その地の淑女にして、君子の好逑となるべき資格あるものを択んで一日も早く円満なる家庭をかたち作って、かの不貞無節なるお転婆を事実の上において慚死せしめん事を希望します。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥満人新居格氏よ、身をもつて思想上では無節操と自由とを混同することをもつて一生を終れ、あなたは真の貧者の求めてゐる自由の思想に対しては撫でるか引つ掻くかの二つより選んだためしがない。",
              "citation": {
                "source": "小熊秀雄全集-12",
                "author": "詩集（11）文壇諷刺詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂本等の銃声が聞えはじめてからは、同勢が殆無節制の状態に陥り掛かる。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はふたたび無節制になって、間もなくその行為のすべての記憶を酒にまぎらしてしまった。",
              "citation": {
                "source": "黒猫",
                "author": "THE BLACK CAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "無良心、無節操なる暴力とか策略とか言うものを平気で、巧みに行ない得る男性が勝者となり、支配者となりまして、そんな事の出来ない善人たちが、劣敗者、弱者となり下って行く証拠が、日常到る処に眼に余るほど満ち満ちているのであります。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "無気力、無節操なぞいう亡国的人民の資格をすっかり備えていることになるのである。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「矛盾でもなんでも為方がない、その矛盾、その無節操、これが事実だから為方がない、事実！",
              "citation": {
                "source": "蒲団",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "つゞいてデカダンや、無節操や、小反抗や、似非不道徳をわざとやつて歩いた時代があつた。",
              "citation": {
                "source": "娟々細々",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも誰もかの女の心の変遷を、無操持を、場合によつては無節操を咎めるものはなかつた。",
              "citation": {
                "source": "百合子",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "善いもわるいもなければ節操も無節操もなかつた。",
              "citation": {
                "source": "百合子",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際、驚くべき無節制さをもって、街路を横断している。",
              "citation": {
                "source": "大阪を歩く",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻としては辰子は無節操で、放縱で、我儘で淫奔で、彼のやうな臆病な小心な良人を軈て自滅さす種類の女であつたが、普通の女としてみたとき彼女は善良で快活で子供のやうに無邪氣であつた。",
              "citation": {
                "source": "悲しみの代價",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここの理窟が十分にわからないものだから映画ジャーナリストたちはいたずらに会社のプロパガンダにあやつられてともすれば引き抜かれた監督俳優を不徳義、無節操呼ばわりをする。",
              "citation": {
                "source": "映画界手近の問題",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "利己、貪慾、無節制の一袋を、此処ら辺からばら撒くのだ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼奴は白痴で無節操でロマンチックの生地無しだ！",
              "citation": {
                "source": "西班牙の恋",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フーシェは大革命の当時からナポレオン時代を通じて活躍した男ですが、彼の特長は全くの無節操無徳義であり白昼公然の裏切りであり、しかも実行力にとんでいて人心の帰趨を観るに敏であった男であります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルザックがこの人間をその無節操の力のおどろくべき点から描いている由、それからツワイクの興味は目ざまされたのだそうです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏切ったが、自分のために、ツワイクの云い方ですればバクチの情熱のために冷血なので、自分が安穏にはした金で飼われるのが目的ではなく、同じ無節操の標本であるナポレオン時代の外務大臣タレイランが享楽を窮局の目的としたのとは又違う姿がよく描かれています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、真木に無節操な批評が加えられるとなると、ついに我慢がならなかった。",
              "citation": {
                "source": "我に叛く",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊97　沈黙した精神を、あらゆる汚穢と非礼と、無節度との混沌の中から洗い上げて立ち上がらせること。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "決して表面には立たず、裏面に隠れて策謀を事とし、変貌に変貌を重ね、裏切りに裏切りを重ね、ロベスピエールを陥れ、ナポレオンに悲鳴をあげさせた、この冷血で無節操で無性格な男は、常に疑惧と嫌悪との対象となり得る。",
              "citation": {
                "source": "砂漠の情熱",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
