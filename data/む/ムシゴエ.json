        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしそれでゐて何か或る頑丈な逞しい姿勢の影に、微かな虫声に似た優しいセンチメントを感じさせる。",
              "citation": {
                "source": "小説家の俳句",
                "author": "俳人としての芥川龍之介と室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月十九日――「朝、空曇り風死す、冷霧寒露、虫声しげし、天地の心なお目さめぬがごとし」同二十一日――「秋天｜拭うがごとし、木葉火のごとくかがやく」十月十九日――「月明らかに林影黒し」同二十五日――「朝は霧深く、午後は晴る、夜に入りて雲の絶間の月さゆ。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつのまにやら道をまちがへてゐたが、――それがかへつてよかつた――山また山、青葉に青葉、分け入るといつた感じだつた、蛙声、水声、虫声、鳥声、そして栗の花、萱の花、茨の花、十薬の花、うつぎの花、――しづかな、しめやかな道だつた。",
              "citation": {
                "source": "行乞記",
                "author": "伊佐行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "欽明寺峠は峠としては何でもないが何しろ長い、秋草、虫声がよかつた、萩の老木は口惜しいほど欲しかつた。",
              "citation": {
                "source": "行乞記",
                "author": "広島・尾道",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねむれない、ねむれない、雨声を聴く、虫声に耳傾ける、そしてとろ／＼とすれば、何といふ夢だ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜中に眼が覚めて、雨声虫声の階調を傾聴した。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜明けの虫声はしみじみとしたものだ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "早起、――虫声、鶏声、そして鐘声。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝湯、あざやかな天地、虫声むせぶが如く、秋風流るゝやうに吹く。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "防空訓練第二日、砲声虫声。",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "電燈料新聞代が払へないので困る、気の毒でならない、飲みさへしなければ……かうした迷惑は起らないのに、……虫声が何ともいへない、寝床に横つていつまでも耳を傾ける。",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫の声、それを村園や郊外の庭に聴く時、たしかに幽寂の感をひくが、それが一つならず、二つならず、無数の秋虫一度にみだれ咽んで、いわゆる「虫声満地」とか「虫声如雨」とかいう境に至ると、身にしみるような涼しさは掻き消されてしまう憾みがある。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "かう云ふ有様ですから、追々と涼しくなつて来るといつしよに、所謂虫声｜喞々。",
              "citation": {
                "source": "入庵雑記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸中の苦悶未だ全く解けず、行く行く秋草の深き所に到れば、忽ち聴く虫声｜縷の如く耳朶を穿つを。",
              "citation": {
                "source": "一夕観",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬近うして虫声｜急かなる夕なり。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "はかないその日のうれしさを今か今かと涙ながらに待ちながら――　　大正三年九月二十六日こよなく尊き　宝失える　哀れなる姉　　小霧降り虫声わびて　　　　我が心悲しめる　　　　　　夜の最中　　　　　　　　（一）　私は丁度その頃かなりの大病をした後だったので福島の祖母の家へ行って居た。",
              "citation": {
                "source": "悲しめる心",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○墻外虫声切々立ち出でて聞くことならぬ、人の身を、虫もあはれと、鳴きまさるらん。",
              "citation": {
                "source": "鉄窓の歌",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "○虫声うきふしの、旅寝の身さへ、忘れけり。",
              "citation": {
                "source": "鉄窓の歌",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に入りて帰船すれば、一天片雲なく、満月檣頭にかかり、虫声露光、あたかもわが三五の明月を望むがごとく、壮快極まりなく、吟情勃然として動く。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "目下春期にして、椿花桃花を見ると同時に藤花蕣花を見、昼間蝉吟を聞きて、夜中虫声を聴くもまた奇ならずや。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "未秋ならざるに此夜虫声を聞く。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫声喞々既に秋の如し。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "唖に生じ虫声漸く多し。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "階砌は掃うに人なければ青苔雨なきも亦滑かに、虫声更に昼夜をわかつ事なし。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は、ほの暗い行燈と虫声の繁い屋敷うちに、児太郎は端然と寂しく坐っていた。",
              "citation": {
                "source": "お小姓児太郎",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "人払いした客殿の灯の外は、夜寒の虫声だけだった。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ふと、筆を措いて、夜を想うと、浅間山麓のこの高原には、夏じゅうあんなにまで見えた避暑人の燈も全く消え、ただ雨のような虫声の闇と、落葉の音があるだけだった。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
