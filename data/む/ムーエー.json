        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――つぎには、レオン・ムーエーというやはり流行児で、文学方面から代議士となり、政治上の野心によって文学に従事していて、年若く、頭は禿げ、髯を生やさず、蒼白い怒りっぽい顔つき、長い鼻、丸い眼、鳥のような格好の頭をしていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュリアンはエマニュエルを知っており、グージャールはムーエーを知っていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムーエーはそれを冷やかな丁寧さで迎え、エマニュエルは嘲り気味の無遠慮さで迎えた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
