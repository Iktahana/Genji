[
  {
    "uuid": "34375101-a79d-53b8-9204-0f702aa1a31b",
    "entry": "無法",
    "reading": {
      "primary": "むほう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "lawlessness",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "法律も警察も機能していないその地域は、まさに無法の極みと言える状態だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "権力を笠に着て無法な振る舞いを繰り返す独裁者に、民衆の不満が爆発した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "自然界には弱肉強食という無法の掟が支配しており、感傷が入り込む余地はない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "実際弱虫の泣虫にはちがいなかったが、それでも曲った事や無法な事に負かされるのは大嫌いであった。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに実際そこを海岸と呼ぶことは、無法なことではなかったのです。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "無理、無法にやられている！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから鉄砲打ちが何か云ったら、『なんだ、柏の木の皮もまぜておいた癖に、一俵二｜両だなんて、あんまり無法なことを云うな。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから鉄砲打ちが何か云ったら、『なんだ、柏の木の皮もまぜておいた癖に、一俵二両だなんて、あんまり無法なことを云うな。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "伐墓という語は支那には古い言葉で、昔から無法者が貴人などの墓を掘った。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかりをつけずに無法にやって来るものもないではない。",
              "citation": {
                "source": "夜の隅田川",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "無法にもポチの背後から、風のごとく襲いかかり、ポチの寒しげな睾丸をねらった。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが權官に某といふ無法者が居て、雲飛の石のことを聞き、是非に百兩で買ひたいものだと申込んだ。",
              "citation": {
                "source": "石清虚",
                "author": "國木田獨歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "衆人はその無法なるに愕けり。",
              "citation": {
                "source": "取舵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト向直つて、元二の顏をじろりと見るやうにして招き、と云ふ形で蹲んだが、何故か無法に憎かつた。",
              "citation": {
                "source": "二た面",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもあんまり無法なことはこれから気を付けるやうに云ふから今度はゆるして呉れ。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「難有え、と無法に大きな声をするにぞ、主人は叱りて、「馬鹿め、人が聞かあ。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「無法を働く悪人｜等、天の御罰を知らないか。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "かばかり堅固なる囲の内よりそもいかにして脱け出でけん、なお人形の後より声を発して無法なる婚姻を禁めしも、汝なるか。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな無法な奴等だから、それこそ、谷底へでも投り出されてみたが可い、丁も半もあったものか。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……無法な事を仕出して、諸君が萩原夫婦を追うて、鐘を撞く約束を怠って、万一、地が泥海になったらどうする！",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――深更に無理を言ってお酌をしてもらうのさえ、間違っている処へ、こんな馬鹿な、無法な、没常識な、お願いと言っちゃあないけれど、頼むから、後生だから、お澄さん、姐さんの力で、私が居る……この朝だけ、その鷭｜撃を留めさしてはもらえないだろうか。",
              "citation": {
                "source": "鷭狩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄さんが彼女を愛しているから、なぞと云うのはまことに理不尽千万な、この上もなく無法な理屈だ。",
              "citation": {
                "source": "勝敗",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とおふくろは、上づツた聲で、無法に悦しがり、「一日でも可いから何うかして其様なことにしたいもんだ………何と謂われても管はない、私はのんきになりたいね。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして反動から、より頑強な心を持った、神経の太々しい、大胆無法な勇気をもった、真の英雄的なものに憧憬している。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「無法松の一生」とかいうのと、「重慶から来た男」とかいう映画である。",
              "citation": {
                "source": "芸術ぎらい",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、「無法松」はたいへんつまらなかった。",
              "citation": {
                "source": "芸術ぎらい",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「無法松」という映画に対する不満である。",
              "citation": {
                "source": "芸術ぎらい",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "不行跡よりして痳疾を得、暴飮よりして心臟異常を來し、無法の擧動よりして筋骨を挫折するを致せるが如きは、招いて得た疾病である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "伐墓といふ語は支那には古い言葉で、昔から無法者が貴人などの墓を掘つた。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "早くいッて見れば空漠として広い虚空の中に草の蔓は何故無法に自由自在に勝手に這い回らないのだろう。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "へへへへへ、」「一体高過ぎる、無法だよ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "波の峰が来た時にはからだが持ち上げられると同時に、波の進むほうに押されるが、谷を通る時は反対に引きもどされます。",
              "citation": {
                "source": "夏の小半日",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "できあがったものは形式上普通の詩や小説と全く同じであるから読むほうではそういうつもりで読み、またそういうものとしての論理や性格やの統一を要求しているのに、内容にはどうしてもどこかに分裂があり齟齬があるのを免れ難いからである。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "outrageous",
