        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "空気はムンムンして、人々は天ぷらの油煙を吸い込んでいた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京の空気を下の関までそっくり運ぼうとでもするように車室内の空気はムンムン沈澱していた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝苦しい、麹室のようなムンムンする、プロレタリアの群居街でも、すっかりシーンと眠っていた。",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのムンムンする蒸し暑い、プラタナスの散歩道を、私は歩いていた。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハンムンムンムンムン・ムムネの市まで、もうどれ位ありましょうか。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンムンムンムンムン・ムムネ市の入口までは、丁度この足さきから六ノット六チェーンあるよ。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばけもの世界のハンムンムンムンムン・ムムネ市の盛んなことは、今日とて少しも変りません。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "クルグックの婆さんも女の子マッチョ、ウンノック、ムンムックたちも赤や黄や藍の更紗の冠りで並んでいた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを目標にしてタマラナイ異臭がムンムンと蒸れかえる中を手探りして行くと、そのうちにヤット眼が慣れて来た。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の事はない、竜宮みてえな金ピカずくめの戸棚や、椅子、テーブル、花束や花輪で埋まった部屋なんで、ムンムンする香水の匂いで息が詰りそうな中にタッタ一人突立っている見窄らしいあっしの姿が、向うの壁一パイに篏め込んで在る大鏡に映ったのを見た時にゃ、思わずポケットへ手を当てましたよ。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の中がムンムンと暑いので、汗みどろになってしまいましたが、何しろ太刀山みたいな強力に押えられているんでゲスから子供に捕まったバッタみてえなもんで……ウッカリすると手足が※げそうになるんです。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "スチームのムンムンする室に居るよりも、窓からスーッと飛び出して、冷たい風の中を舞いまわった方がいいと思った。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "中には四五日前の通りに味噌桶が行列して、黴臭い味噌の臭気がムンムンする程籠もっていた。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムンムンと蒸れかえる瓦斯仕掛の大暖炉の蘊気と一緒に、早くも彼女の濃厚な化粧と、旺盛な肌の匂いが漂い初めていた。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サロンの中は煙草の煙でムンムンしていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は胸の中かムンムンつかえそうになった。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私は二升の米を背負って歩くので、はつか鼠くさい体臭がムンムンして厭な気持ちだった。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "酢っぱい酒の匂いがムンムンして焦々する。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私は二升の米を肩を替えながら脊負って歩くので、はつか鼠くさい体臭がムンムンして厭だった。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして膚と襦袢との間から、懊しい年盛りの女の香気がムンムンと立ちのぼってくるような気がした。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "スチームはムンムンするほど部屋を温めて居り、肘掛椅子は実に柔軟くフカフカしている。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムンムンするわい」　と、巡査部長はストーブの方に近づいた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムンムンする蒸し暑い夜だった。",
              "citation": {
                "source": "科学者と夜店商人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "書くのはこれから）　この前のお手紙で国府津へでもおいでと云って下さったけれども、あすこは夏はムンムンです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
