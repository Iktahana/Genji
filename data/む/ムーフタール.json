        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ジャン・ヴァルジャンはムーフタールの一郭のうちにある種々な入り組んだ小路を歩き回った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中、ムーフタール街の路地で、彼は子供の柩を見た。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "大通りの角までゆくと、ムーフタール街を走り去る馬車がまた見えた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ムーフタール街にあるよ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」十五　ジョンドレット買い物をなす　それから少したって、三時ごろ、クールフェーラックがボシュエと連れ立って、偶然ムーフタール街を通った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリユスは実際、ムーフタール街をジョンドレットが通るのを見て、その様子をうかがっていたのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はムーフタール街を離れた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五分ばかりして彼はそこから出てきて、それからまたムーフタール街に戻ってきた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "大入道がムーフタールの下水道の臭い穹窿の下に閉じ込められていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
