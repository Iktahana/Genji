    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "刈り残された雑木林の下路が、むら消えの雪のように、灰をなすりつけている。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "一双の屏風の絵は、むら消えの雪の小松に丹頂の鶴、雛鶴。",
              "citation": {
                "source": "雛がたり",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "垣のあたりにはむら消えの雪がたまり、今もまた空が曇ってきて小降りに降る雪もある。",
              "citation": {
                "source": "源氏物語",
                "author": "浮舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪のむら消えた砂浜には、けさと同様に女たちがかしこここにいくつかの固い群れになって、石ころのようにこちんと立っている。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とりどりに子らは行く、むら消えの雪を、田を。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪がむら消えをしている。",
              "citation": {
                "source": "帰途",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "むら消えの雪間に咲きこぼれた白山小桜の花が、若草の野に立って歌を謡っている少女の頬のように美しい。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月頃になると雪がむら消えして、玉の膚にも奇怪な竪縞が幾つか現れる。",
              "citation": {
                "source": "望岳都東京",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊の多い北アルプスでは純白な圏谷の雪の上を大きな真黒な熊がのそりのそり歩いていることなどもあり、鹿の多い南アルプスでは、むら消えの雪間に生えた軟い芳草に飽きて、木蔭に甘睡の夢を貪っている鹿の群を驚かすことなどがある。",
              "citation": {
                "source": "山の魅力",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼岸の入りの十八日には、むら消えの雪間に、蕗のとうが、むっくり頭をもたげ、千草の芽は、やわらかい土に、珍らかな若緑を、点々と撒きちらした。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
