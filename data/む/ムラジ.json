[
  {
    "uuid": "7a81e214-f3d2-5c91-b3c6-49623778c06e",
    "entry": "連",
    "reading": {
      "primary": "むらじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
