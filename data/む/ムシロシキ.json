        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ただ吹雪に怪飛んで、亡者のごとく、ふらふらと内へ戻ると、媼巫女は、台所の筵敷に居敷り、出刃庖丁をドギドギと研いでいて、納戸の炉に火が燃えて、破鍋のかかったのが、阿鼻とも焦熱とも凄じい。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "香を焚く箱置きて、地の上に円き筵敷きつ。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "またたく間に、五十畳の広座敷はもちろん、筵敷の上までぎっしりと詰って、身動きもならない有様。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "日高川",
                "note": "青空文庫"
              }
            },
            {
              "text": "焚火のあかりを半顔に受け、莚敷きのゆかの上でなされるこの慇懃な挨拶は、阿賀妻の眼を湿ましていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿片宿は貴人向のものでないだけに粗末な家で、内部は中央が土間になり、左右の床の莚敷の上に客が幾人も阿片を吸ひながら横向きに臥してゐる。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔っているうちこそいい心持で寝ていたが、多少醒めては、川原のまん中へ莚敷では堪るまい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁や床の下から竹の出て来るなどは、田舎家の常ではあるが、其が彼の常用の書斎、莚敷きの土間に出て来たなど言ふのは、此莚敷きの三畳と、共に並んだ二畳間とだけが、火事直後、急拵への仮り屋のまゝを、新建ちへとり込んだものと見られる。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "人さまざまの花莚敷き連ねたるそが中を、夫婦に子供下女丁稚五人連れにて過ぎゆくは、これ近江屋の一群なり。",
              "citation": {
                "source": "心の鬼",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "一段低く、そこと能舞台とのあいだの庭は、すべて、幕囲いと莚敷きに依って清々しい陪観席となっている。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
