        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日焼けした背中の皮が、ぽろぽろと剥れてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "古いペンキが剥れて、下の木目が見えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ゆで卵の殻が綺麗に剥れなくてイライラする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
