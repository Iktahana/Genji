    "definitions": [
      {
        "index": 1,
        "gloss": "(mumbling) incomprehensibly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "寝ている弟が「お菓子食べたい……」とむにゃむにゃ独り言を言っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はまだ眠いのか、問いかけに対してむにゃむにゃと要領を得ない返事をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "酔っ払った父は、何かをむにゃむにゃ言いながら居間で寝入ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「あら、まだ寝てンのね、兄さん起きてよ」　石松、むにゃむにゃ言って起きない。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、小さい太郎は、口をとがらしていいましたが、おばあさんには、かぶと虫だろうががにだろうが、かまわないらしく、ふんふん、むにゃむにゃといって、ふたたび目をひらこうとしませんでした。",
              "citation": {
                "source": "かぶと虫",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　狸はむにゃむにゃ兎の耳をかみながら、「なまねこ、なまねこ、世の中のことはな、みんな山猫さまのおぼしめしのとほりぢゃ。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と云ひながら兎のあとあしをむにゃむにゃ食べました。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "むにゃむにゃむにゃ。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カン蛙は何とも言へないうらめしさうな顔をして、口をむにゃむにゃやりました。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "実はこれは歯を食ひしばるところなのですが、歯がないのですからむにゃむにゃやるより仕方ないのです。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　狸はむにゃむにゃ兎の耳をかみながら、「なまねこ、なまねこ、みんな山猫さまのおぼしめしどおり。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と云いながら兎の手をむにゃむにゃ食べました。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カン蛙はなんとも言えないうらめしそうな顔をして、口をむにゃむにゃやりました。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "実はこれは歯を食いしばるところなのですが、歯がないのですからむにゃむにゃやるより仕方ないのです。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでテジマアは、ナイフをとり上げて皿の上のばけものを、もにゃもにゃもにゃっと切って、ホークに刺して、むにゃむにゃむにゃっと喰ってしまいました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちがう、かぶとむしだ」と小さい太郎は口をとがらしていいましたが、おばあさんには、かぶと虫だろうが蟹だろうが、かまわないらしく、ふんふん、むにゃむにゃといって、ふたたび眼をひらこうとしませんでした。",
              "citation": {
                "source": "小さい太郎の悲しみ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "むにゃむにゃって、目をつむったまま、いってますよ。",
              "citation": {
                "source": "病む子の祭",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "むにゃむにゃのむにゃむにゃさんなのとはなんだい」　お上さんは顔を末造の胸から離して、悔やしそうに笑った。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "口からむにゃむにゃと、驚きやら小言やらが寝言みたいな形で出てしまったのですが、その瞬間、ふと目をうっすら開けて蝋燭の光に照られている彼女の顔を見て、僕はびっくりして息を呑みました。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪魔め、ちょっと僕が油断している間に、九百九十……九百九十五匹かな、九十四匹かな……ううい」　後はガロ爺やの背中でむにゃむにゃいっていたが、それもやがて聞こえなくなった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生などは夏休み中、すこし気にかかることがあって（といってはっと気がつき）ああむにゃむにゃ、えっへん。",
              "citation": {
                "source": "新学期行進曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "六段目でＢが何者かと分れば、除数の十位も分ってあとは……あとは、むにゃむにゃ。",
              "citation": {
                "source": "虫喰い算大会",
                "author": "佐野昌一",
                "note": "青空文庫"
              }
            },
            {
              "text": "慎一は、少年ぽくむにゃむにゃという夢中の表情でこたえた。",
              "citation": {
                "source": "杉垣",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼けてちぢれたひげがむにゃむにゃと動いて、口がぽっかりあいて乱ぐいの歯があらわれたかと思うと猛太は目をぱっちりと開いた。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしあの恐竜をたねに、なんとか金もうけを……うむ、むにゃむにゃむにゃ」「では、張さん。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（は、よく寝とります）　すると岡部は、むにゃむにゃと口をうごかし、（……あ、そうか。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして私はその時、一冊の同人雑誌の片隅から井伏さんの作品を発見して、坐っておられないくらいに興奮し、「こんなのが、いいんです」と言って、兄に読ませたが、兄は浮かぬ顔をして、何だかぼやけた事を（何と言ったのか、いまは記憶に無いけれども）ムニャムニャ言っただけだった。",
              "citation": {
                "source": "『井伏鱒二選集』後記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "乞食、ムニャムニャ言い乍ら、起き上る。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂から上がり、姿見に向かい三人相顧みて、「随分黒くなったなあ」　この夜、吉岡髯将軍ビール二杯呑んだところが早速酔っ払ってしまい、自分から注文した名物の羊羹が来たのも知らずに、鼾声雷のごとくグーグームニャムニャ。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "本来を云えば弥陀なり弥勒なり釈迦なりを頼んで、何かムニャムニャを唱えて、そして自分一人極楽世界へ転居して涼しい顔をしようと云うのは、随分虫のいいことで、世の諺に謂う「雪隠で饅頭を食う」料簡、汚い、けちなことである。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムニャムニャムニャムニャムニャムニャムニャムニャ……窓の外は星だらけだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして間もなく……聖書……燐寸燐寸……ムニャムニャムニャ……と云って首をコックリと前に垂らしました。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムニャムニャと唇を動かしていたが、やがて、こんな謎のような言葉を、切れ切れに吐き出した。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
