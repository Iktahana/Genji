[
  {
    "uuid": "7e11dfc9-769f-5d07-b17d-d0179b23191b",
    "entry": "むにゃむにゃ",
    "reading": {
      "primary": "むにゃむにゃ",
      "alternatives": [
        "ムニャムニャ",
        "もにゃもにゃ",
        "モニャモニャ"
      ],
