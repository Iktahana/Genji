        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "８ミリのホーム・ムーヴィ用の映写機だ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまのようにホーム・ムーヴィーを映写するとき、その壁は充分にスクリーンの代用となった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂浜から一段高くなった草地は、セミ・プロやアマチュアたちのムーヴィ・カメラの砲列だった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェニファーが望遠レンズつきのムーヴィ・カメラを立てているところまで、全力疾走した。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムーヴィ・カメラのファインダー・アイピースを目のなかに埋めこむようにして、僕は絶体絶命の悲鳴をあげた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "８ミリのホーム・ムーヴィは16ミリにブロー・アップされた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔のホーム・ムーヴィを映写すると常にかもし出されるせつなさが、いまスクリーンいっぱいにあった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの日、僕たちが16ミリのムーヴィ・カメラのレンズ越しに見たふたりの波乗りが、オロマナの第57番サーフとともに、そのままスクリーンの上に再現された。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「僕がスティル写真でやっとどうにか撮ることを、ダフネは16ミリのムーヴィで、いとも簡単に流麗に撮っているって」　スティーヴは僕たちの共通の友人だ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "波乗りを専門にスティルやムーヴィで撮るカメラマンで、非常に優秀な感覚と練達した技術を持っている。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アランというサーファーが自分の内部に蓄積している海の体験もたいへんなものだったが、それをムーヴィ・カメラで引き出したダフネの才能にも僕たちは感銘を受けた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夏子を見て、まるでムーヴィ・スターだと言ってハリー中村は喜んだ。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "このとき、『ムーヴィランド・アンド・ＴＶタイム』の編集長ジェームズ・グレゴリとのあいだにおこなわれた一問一答は、『エルヴィスの船出』という一枚のシングル盤にまとめられて発売された。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
