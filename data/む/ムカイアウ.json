[
  {
    "uuid": "762995bf-ccab-5703-9015-d6d3bff68b3f",
    "entry": "向かい合う",
    "reading": {
      "primary": "むかいあう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
