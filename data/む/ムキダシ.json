        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は怒りをむき出しにして、彼を激しく責め立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "敵意をむき出しにした目で睨まれ、思わず後ずさりした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼はライバルへの対抗心をむき出しにして試合に臨んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      }
