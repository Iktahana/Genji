        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎年、初夏になると麦刈りの季節がやってくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "農家の人たちは、早朝から麦刈りに精を出している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "麦刈りが終わると、収穫を祝うお祭りが行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "一週間で授業を始めてみたが、麦刈り養蚕田植えなどがまだすっかり終わらぬので、出席生徒の数は三分の一にも満たなかった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "お春娘一お春娘は麦刈りしてる足のかかとに「どうだ」と聞いた親も親父も天上面してる日和駒下駄はぽつこぽつこだ。",
              "citation": {
                "source": "別後",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "農家は今頃よつぽど忙しい、麦刈り、麦扱ぎ、そして蚕だ、蚕に食はせるためには人間は食う隙がない、そして損だ！",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "このごろ、私は麦刈りに行きます。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　まずこういうやり方で、猫吉｜親方は、いつも馬車の先に立ってあるいて行っては、麦刈り、草刈りをしている男とみると、おなじようなことをいって、おどしました。",
              "citation": {
                "source": "猫吉親方",
                "author": "またの名　長ぐつをはいた猫",
                "note": "青空文庫"
              }
            },
            {
              "text": "九の一　逗子の別荘にては、武男が出発後は、病める身の心細さやるせなく思うほどいよいよ長き日一日のさすがに暮らせば暮らされて、はや一月あまりたちたれば、麦刈り済みて山百合咲くころとなりぬ。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく麦刈りが始まるであろう。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "『麦刈り』だの、『醤油屋の煙突』なんていうの、うまかった」「あぶない、あぶない。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度御相談してからと思っていますうちに、だんだん麦も色づきだしましたし、麦刈りが近づくにつれ、しだいにむつかしくなりそうでしたので、大いそぎ私たちでとりきめました。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、話は麦刈りまでにも一度手術をするということになり、お母さんはまたあらためて手をついて、みんなに挨拶をした。",
              "citation": {
                "source": "大根の葉",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "麦刈れば戦ぐさみどり、畝の間にすでに伸びつる陸稲ならしも。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "農家は今が忙しい真盛りだ、麦刈、麦扱（今は発動機で麦摺だが）、やがてまた苗取、田植。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑の麦刈がはじまつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャロットの野に麦刈る男、麦打つ女の歌にやあらん、谷を渡り水を渡りて、幽かなる音の高き台に他界の声の如く糸と細りて響く時、シャロットの女は傾けたる耳を掩うてまた鏡に向う。",
              "citation": {
                "source": "薤露行",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "百姓達はみんな麦刈に出てしまつて、あたりには誰も人はゐない。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の郷里では、あの癇高い鳴声こそは、蝉がそこらの麦畑の黄熟を逸早く知らせるもので、あの声を聞きつけた農夫達は、何をさしおいても麦刈にとりかからなければならない。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういう仲間の一人が、ある日蝉の声を耳にすると、「またしても麦刈の催促か。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親は麦刈に往っている舅と長男に知らし、それからむこうの谷へ草除りに往っている父親にも知らして大騒ぎをはじめた。",
              "citation": {
                "source": "蟹の怪",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ッチがもう四十の声をきくのに間もない歳であつたにも拘らず、いつも、かう言ひ言ひした――　だが、彼はいつも欠かさず、麦刈の人夫について野良へも出た。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "農家の女の労苦はどれ程でしょう――麦刈――田の草取、それから思えば荒井様の御奉公は楽すぎて、毎日遊んで暮すようなものでした。",
              "citation": {
                "source": "旧主人",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "白髪頭に縁の垂れた黒い帽を被て紅い毛糸のぶくぶくした襯衣に汚れた青黒い天鵞絨の洋袴を穿き、大きな木靴を引ずつて、又してもギタルを弾乍ら「聴きなさい、お前たち、南｜仏蘭西の田舎の麦刈唄を一つ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "召使たちはまた麦刈に取りかゝりましたが、主人はポケットから、ハンカチを取り出し、二つ折りにして、左手の上にひろげ、その掌を地面の上に差し出して、この中に入って来いと、手まねで私に合図をします。",
              "citation": {
                "source": "ガリバー旅行記",
                "author": "GULLIVER'S TRAVELS",
                "note": "青空文庫"
              }
            },
            {
              "text": "（喜びながら火のそばに腰をおろす）女　（麦畑の方へ眼をやって）又、麦刈って――青年　（女の注いで出す茶碗を受けて）すみません。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この辺りの麦刈はすこし遅れていま盛んに刈つてゐるところである。",
              "citation": {
                "source": "麦刈",
                "author": "橋本多佳子",
                "note": "青空文庫"
              }
            },
            {
              "text": "麦刈の女の一人がつと立ち上つて、天を仰ぐやうに身を伸した。",
              "citation": {
                "source": "麦刈",
                "author": "橋本多佳子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の昔の句に麦刈が立ちて遠山恋ひにけりといふのがあるが、この辺りは近くに春日山、高円山などの山々が迫り、その青い色が黄麦の色と照りあつてゐる。",
              "citation": {
                "source": "麦刈",
                "author": "橋本多佳子",
                "note": "青空文庫"
              }
            },
            {
              "text": "老麦刈ひばりは絶えず声与へ",
              "citation": {
                "source": "麦刈",
                "author": "橋本多佳子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
