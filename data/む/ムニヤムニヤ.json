          "literary": [
            {
              "text": "そして頭を屈めた際につむつた眼を、云ふことの出来ない表情で開くと、閉つた口をムニヤムニヤとさせた。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "天下泰平、徃生安楽国、ムニヤムニヤアーメン。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムニヤムニヤと少年が寢言を言ふ聲がする。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムニヤムニヤと少年が寝言を言ふ声がする。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、両親のために、水火も厭はず……ムニヤムニヤ／＼。",
              "citation": {
                "source": "親孝行",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "と唸つたが、直ぐムニヤムニヤムニヤと呟きながら、一層深く布団の中にもぐり込んでしまひました。",
              "citation": {
                "source": "お父さんのお寝坊",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムニヤムニヤムニヤ。",
              "citation": {
                "source": "磯馴松",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女　　ムニヤムニヤムニヤ……。",
              "citation": {
                "source": "かんしやく玉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムニヤムニヤいふ声。",
              "citation": {
                "source": "ガンバハル氏の実験（ラヂオドラマ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとを氣をつけてくれ」「――」　よく目の覺めきらない孫三郎のムニヤムニヤ言ふのを背に聞いた、老支配人の孫六は裏口からそつと外へ出た樣子です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "月の隈",
                "note": "青空文庫"
              }
            },
            {
              "text": "ま、そんなことかも知れませんがね」　辰三はムニヤムニヤと言葉尻を濁すのです。",
              "citation": {
                "source": "錢形平次捕物控",
