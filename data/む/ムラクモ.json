[
  {
    "uuid": "0dc7c6e3-9a01-5220-9bc6-318c2874e44f",
    "entry": "叢雲",
    "reading": {
      "primary": "むらくも",
      "alternatives": [
        "そううん"
      ],
      "is_heteronym": true
