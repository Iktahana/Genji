[
  {
    "uuid": "4304d952-3333-5460-8ef8-7df32d87d071",
    "entry": "結びつく",
    "reading": {
      "primary": "むすびつく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-カ行",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to be related",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日々の地道な努力が、最終的には大きな成功へと結びつくと信じて疑わなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この化学物質が酸素と結びつくことで、目に見えないほど速い速度で酸化が始まる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼のささいな発言は、今回のプロジェクトが抱える核心的な課題に結びついている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それは或る場合、生活意慾と結びつく。",
              "citation": {
                "source": "答案落第",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "高いリアリティとも結びつく。",
              "citation": {
                "source": "答案落第",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛情とさえ結びつく。",
              "citation": {
                "source": "答案落第",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　妻に子供を残されて、逃げ帰られてしまってから、二人はお互にかたく結びつくようになった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "幹太郎は、なぜか、彼の直観に結びつくものを感じた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしいずれも結びつくべき因縁があって、結びついたものであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人生が、このような黒い銃身の光と、じかに結びつくなどは、ふだんはとても考えられぬことであるが、その時の私のうつろな絶望の胸には、とてもリリカルにしみて来たのだ。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "散文（詩でないもの）と詩（韻文）とが、一つの言語で結びつくのは、北と南、善と悪との反対を、同時に考えるような矛盾である。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "犯人とて、指輪と殺人が結びつくなど思いもしない。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "「部屋に、犯人へ結びつく手がかりは何も？",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "積もり積もった生涯の見聞とも結びつくものだ。",
              "citation": {
                "source": "サセックスの吸血鬼",
                "author": "THE ADVENTURE OF THE SUSSEX VAMPIRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "感性に訴へる画家は、往々にアマチュアとして画家仲間から異端と敬遠とをもつて迎へられるが、この種の優れた画家は、画壇では孤立であつても、彼は直接一般人と結びつくことを知つてゐるし、また、大衆はこの種の画家の芸術的真実をよく理解する。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはいったい、どうした子細じゃ」「どうもこうもない、あの人形とぶつぶつさえずっている薄気味のわるいおやじが、さっき八丁堀で取り逃がした当の本人でござんすよ」「えッ※　――そうか、髪の毛と黒ねこがあの京人形に結びつくたあ、いかなおれも、にらみがつかなかったな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "京人形大尽",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に「波羅僧掲諦」というのは、「波羅」は向こうという意味、「僧掲諦」とは到達する、結びつく、いっしょになる、というような意味です。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鵜烏の尻に穴をあけ糸を結び、他の一端を泥鰌の首に結びつくるべし。",
              "citation": {
                "source": "科学者と夜店商人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「常盤樹」にしろさらに「鼠をあわれむ」「炉辺雑興」「労働雑詠」等に到って、この詩人が、小諸の農村生活の日常に結びつくことで、こんなに自然を観る態度が異って来たかとおどろくばかりのものがある。",
              "citation": {
                "source": "藤村の文学にうつる自然",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "允子は、こういう内的情態で、公荘というドイツ語教師と結びつく。",
              "citation": {
                "source": "山本有三氏の境地",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とかしてその重さをはねのけようとする欲求、その生々しい力、そのようなものを互にもっていることがわかりあって、その力をも合わせ集めるつもりで若い一組が結びつくことができたら、現在の農村の生活の中ではすでに大きいプラスの意味をもつことであると思う。",
              "citation": {
                "source": "若き世代への恋愛論",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "抽象的に未来の妻となる女に対する貞操とか、何か宗教的なあるいは生理的な潔癖性からでなしに、人間としての自分が肉体で結びつくまでには、やはり人間的に愛し得る婦人を必要とするたちの青年が決してなくはない。",
              "citation": {
                "source": "若き世代への恋愛論",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし生は死と結びつく事は出来ない。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "資本は資本と結びつく、という原則にしたがって、儲けておいては昨日までの超国家主義のうらがえしで結合する人たちの安心なのである。",
              "citation": {
                "source": "正義の花の環",
                "author": "――一九四八年のメーデー――",
                "note": "青空文庫"
              }
            },
            {
              "text": "支配権力と結びつくように出来ていると云うよりも支配権力と結びついて初めて出来上ったものなのである。",
              "citation": {
                "source": "日本文化の特殊性",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "発達した資本主義的民主主義の国でも、その発展の矛盾の一つのモメントとして、前進性をもたない部分を生じてきているのは自然であり、その影響が、日本のさらによりおくれた部分と結びつくことも想像しやすいことです。",
              "citation": {
                "source": "一九四六年の文壇",
                "author": "――新日本文学会における一般報告――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「突きはなして扱えばまことに発見されるものゝ多い世界」であると評されていることは、作者がもうすこし二人の登場人物を客観的に扱っていたならば、という読者の感想と結びつく性質のものである。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはやはり労働時間の短縮とか生理休暇があるとか、労働条件がよくなることと結びつく。",
              "citation": {
                "source": "婦人の創造力",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一般には、新カント派を通じてカントに還ることによって同時にカント以後のいわゆるドイツ浪漫主義の哲学に結びつくという傾向が濃厚であった。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "無常思想は出世間の思想と結びつく、これに対して彼の思想の特色は在家仏教にある。",
              "citation": {
                "source": "親鸞",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはしかしより高い段階においても観想に結びつく。",
              "citation": {
                "source": "親鸞",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "（男七十銭女三十銭の賃銀）それ故進歩的思索を可能とする婦人は、先ず家庭の男（父・夫・兄・その他）に対する不平等の不満から正義派となり、その正義派的不満を唯物論によって武装せず個人的に観念化することにおいて、微妙に道徳感、宗教的世界観と結びつく。",
              "citation": {
                "source": "婦人作家は何故道徳家か？　そして何故男の美が描けぬか？",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小泉信三氏の『共産主義批判の常識』の序文をみても、どこか安定をさがしている文化的な欲求にむすびつくモメントがはっきりあらわれています。",
              "citation": {
                "source": "新しい抵抗について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
