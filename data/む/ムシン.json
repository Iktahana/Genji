[
  {
    "uuid": "46c0b6af-0126-573e-a591-025310ccefa7",
    "entry": "無心",
    "reading": {
      "primary": "むしん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
