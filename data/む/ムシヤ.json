[
  {
    "uuid": "ee753157-57eb-57b3-a1ce-6b9c2c129229",
    "entry": "虫屋",
    "reading": {
      "primary": "むしや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そんなことを云うと、虫屋さんに憎まれるかも知れませんが、松虫や草雲雀のたぐいは値が高いばかりで、どうも江戸らしくありませんね。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、ともよは、籠をもって、表通りの虫屋へ河鹿を買いに行った。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ぢやねお母さん、あそこへ虫屋が居りますから鈴虫を買つて下さいませんか？",
              "citation": {
                "source": "秋雨の絶間",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」秋の七草に松虫鈴虫くつわ虫などをあしらつて野辺の風情を示して居る虫屋の看板が、さつきから綾子の心を惹いて居た。",
              "citation": {
                "source": "秋雨の絶間",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今ね、帰りがけに丁度虫屋が通りかゝつたから、蛍を買つて来たよ。",
              "citation": {
                "source": "蛍",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、大きい市松模様の虫屋籠を見たり、燈火の上に高く流れる月の光りを照り返すように種々様々な提灯や行燈が揺れている店などを眺めると、彼女は何とも云えぬ興に動かされるのを覚えた。",
              "citation": {
                "source": "午市",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫屋にて邯鄲を買ふ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "――矢っ張それもはじめに趣向して、どしこと虫屋から仕入の、あっぱれ草の中へ伏勢を置いたのはいゝ、いざとなるとその騒ぎだ、驚いて此奴が一匹だって鳴いてみせねえじゃァねえか。",
              "citation": {
                "source": "春泥",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫屋の市松しょうじがほのかな宵暗をしのばせた。",
              "citation": {
                "source": "雷門以北",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫屋の市松しやうじをあなたは感じるだらう。",
              "citation": {
                "source": "夜店ばなし",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあと一ト月、六月になつて出はじめるのが虫屋である。",
              "citation": {
                "source": "夜店ばなし",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "松虫鈴虫が、虫屋の店で、夏の夜の景物詩を奏でて、浴衣の袖を翻した夜の散歩の男女で、通りは埋まっている。",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "三「近習番頭取の土肥半蔵ときたひには、他人の伜の品行まで頭痛にやむニガ虫屋の堅蔵だ。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏は虫屋の店に気をそそられる。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
