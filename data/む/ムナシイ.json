[
  {
    "uuid": "ad7cd651-d153-5b58-a6cb-677c6ff2c236",
    "entry": "虚しい",
    "reading": {
      "primary": "むなしい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "empty",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "どんなに世間的な成功を収めても、心の奥底には常に虚しい感覚が澱のように残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "人っ子一人いないゴーストタウンを独りで歩いていると、何とも言えず虚しい気持ちになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "賑やかだったパーティーが終わった後のガランとした部屋は、余計に虚しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "もとより虚しいことです、ほんとうに手にも取り得ず、わが身を徒らに吹き過ぎる風のようなものです。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここの山々の特徴は、山々の起伏の線の、へんに虚しい、なだらかさに在る。",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しぜん人も馬も重苦しい気持に沈んでしまいそうだったが、しかしふと通り魔が過ぎ去った跡のような虚しい慌しさにせき立てられるのは、こんな日は競走が荒れて大穴が出るからだろうか。",
              "citation": {
                "source": "競馬",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "人生のあらゆる事象の底にはこの目に見えぬ暗い流れが走り、それが生の行手を、前後左右を劃っていて、街の下を流れる下水の如くに、時々ほんのちょっとした隙から微かな虚しい響を聞かせるように三造には思われた。",
              "citation": {
                "source": "狼疾記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊かであるようにと予定したはずの日々が何と乏しく虚しいことか。",
              "citation": {
                "source": "狼疾記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しきりに虚しいものが私の中をくぐり抜け、いくらくぐり抜けても、それはわたしの体を追つて来た。",
              "citation": {
                "source": "ある時刻",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故にこそ、君の現在はつねに虚しいのではないか。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉦や太鼓で探しても源太は寥々として虚しい。",
              "citation": {
                "source": "余裕のことなど",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "主客の対立を先ず許しての上でなければ、主観が客観を構成するという転回的な言葉も実際上は虚しい合言葉に終る外はない。",
              "citation": {
                "source": "範疇としての空間に就いて",
                "author": "――之は一つの習作である――",
                "note": "青空文庫"
              }
            },
            {
              "text": "騒ぎはじめた虫からの信号を、心の壁をこわばらせて閉ざしてしまえば、それでも虫はしばらくのあいだ虚しい叫びを上げ、やがては餓死しよう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの太倉は、橋よりも古い以前に建てられ、ことにこの淺草倉は全國の貢米がはいつてくるのと、庶士の俸祿を渡すところなので、江戸の米の價はといふより、諸國の米の價が、この太倉の虚しいか盈てゐるかによつて高下したのだ。",
              "citation": {
                "source": "花火と大川端",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノボオシビルスクにゐた頃も、時々、かうした虚しい思ひに耽つた。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "青白いスクリインは、バタバタと風に煽られ、そのまえに乱雑に転がったデッキ・チェア、みんな、虚しい風景でした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "私とても、一族を思ひ、身一己を思ふと、洞然とした虚しい心に、すう／＼と、冷い風の通ふ様な気がしてならぬ。",
              "citation": {
                "source": "古代研究　追ひ書き",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は依然として癩患者である自分を意識し救はれない絶望を感ずるよりも、何か虚しい空隙にぶつかつたのである。",
              "citation": {
                "source": "癩を病む青年達",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の不気味な妖しさが衰へて、巨大な虚しい悲しさが闇の全てに漲りはじめてゐる。",
              "citation": {
                "source": "蒼茫夢",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしてそれが、単にこの巨大な風洞のやうな虚しい建物の影を見たからにすぎないといふのは、不思議なことだらうか。",
              "citation": {
                "source": "蒼茫夢",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにか虚しい霧雨のやうな屈託が降りしきつてゐて、それまでは物を言ふ気持も浮かばなかつたし、人々の話も夢の彼方のやうにしか聞えてこないのであつた。",
              "citation": {
                "source": "蒼茫夢",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の感傷に絡み合ふ自らの虚しい感傷が、なんとしてもひたすら面倒くさいものに思はれてゐたから。",
              "citation": {
                "source": "をみな",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたこそ、小さな虚しい盛名に縋りついているんじゃないか。",
              "citation": {
                "source": "三十歳",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "下心を知りあって、そのためにフミキリのつかなくなった私は、よけいに苛々ジリジリと虚しい苦痛の時間を持たねばならなかった。",
              "citation": {
                "source": "三十歳",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂をかむように、虚しいばかり。",
              "citation": {
                "source": "私は誰？",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "考へるといふことさへなければ、なんといふ虚しい平和であらうか。",
              "citation": {
                "source": "古都",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "読者はこの一冊に、私の埒もない虚しい修業の跡を見られるだらう。",
              "citation": {
                "source": "序〔『逃げたい心』〕",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が、ここに、かかる虚しい墓、インチキな墓碑銘を敢て怖れげもなく再版する度胸をもつに至つたのは、ともかく、過去のインチキな悪戦苦闘が今日の私に至るカケガヘのない道であつたことは確かであり、私が今日の私を敢て怖れず世に問ふ限り、過去の私を世に問ふことを怖れるべきでないことを信じ得るやうになつたからだ。",
              "citation": {
                "source": "再版に際して〔『吹雪物語』〕",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "このインチキな虚しい墓に、私の真実の屍体は埋まつてゐない。",
              "citation": {
                "source": "再版に際して〔『吹雪物語』〕",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "シロオテは、いかにもしてその思うところを言いあらわし自分の使命を了解させたいとむなしい苦悶をしているようであった。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四二課　虚栄　虚栄はその字の示すとおり、むなしい栄えをのぞむことです。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "当座の小気味良さも、しかしあとでむなしい淋しさと変った。",
              "citation": {
                "source": "婚期はずれ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、確実にむなしい、路なのだから、と審判という燈台は、この世ならず厳粛に語るだろう。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
