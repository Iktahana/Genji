        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "独裁者は、国民をまるで虫けらのように扱った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "大企業の社長にとって、私のような平社員は虫けら同然だろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「俺を虫けら扱いするな！」と彼は叫び、部屋を飛び出していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
