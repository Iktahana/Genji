          "literary": [
            {
              "text": "涅槃堂、マタ人ノ病ムナシ、何故ニ、コノ如クナルト。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "――王、太子（将軍の世子）ヲ喪ウテ、後宮、マタ子ヲ産ムナシ。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――王（将軍綱吉のこと）先ニ太子（将軍の世子）ヲ喪ウテ、後宮マタ子ヲ産ムナシ。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギュムナシア（gymnasia）と呼ばれた館長すなわち行政官、副館長すなわちギムナスト（gymnast）、および下級者であった。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギュムナシアルク（体育館の長）の地位は名誉あるものだが、この地位のものは非常に金がかかった。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "長官は少年や若者の道徳と行為を監督するために任命され、ギュムナシアルクは若者に害のある教えや行為をする人たちを追い出す権利があった。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            }
          ]
        }
