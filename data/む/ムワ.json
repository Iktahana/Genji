[
  {
    "uuid": "1777f398-2527-5407-b7c1-9f038e8b6bb6",
    "entry": "むわ",
    "reading": {
      "primary": "むわ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
