[
  {
    "uuid": "68e204b7-0d5c-5ef9-86fa-9503f1f4cac7",
    "entry": "麦わら",
    "reading": {
      "primary": "むぎわら",
      "alternatives": [
        "ばっかん"
      ],
      "is_heteronym": true
    },
    "grammar": {
