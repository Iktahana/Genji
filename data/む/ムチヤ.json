        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "筍を食べたが、料理がムチヤクチヤなので、あんまりおいしくなかつた、うまい筍で一杯やりたいものだ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "といふ気分で飲んだ、飲めるだけ飲んだ、ムチヤクチヤだ、しかもムチヤクチヤにはなりきれないのだ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月五日昨日のワヤのつゞき、ムチヤクチヤだ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからがいけなかつた、いつしよに街へ出たのがいけなかつた、私だけは早く帰つたが、残つた二人はムチヤクチヤだつたといふ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月廿七日――三十日ムチヤクチヤだつた、私の自棄的身心をさらけだした。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "街で樹明君に邂逅、同伴して帰庵、飲むうちに、そして歩くうちにムチヤクチヤになつてしまつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるでムチヤクチヤだつた、それはムチヤクチヤだつたけれど、私としては一切を投げだして死生の境を彷徨したものだつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は不死身に近い肉体の持主だが、病的健康とでもいふのだらうか、あんなにムチヤクチヤで、こんなにガンキヨウである。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "福岡市街をムチヤクチヤに歩きまはる、やたらに酒を呷る。",
              "citation": {
                "source": "道中記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコガ　メヲ　サマシテ　ミルト、コレハ　マタ　ドウシタ　コトデセウ、メノ　マエノ　オ花バタケガ　ムチヤクチヤニ　フミニヂラレテ　アリマス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それハ／＼実当時のヘボクレ役人や、あるいハムチヤクチヤをやぢの我国ヒイキ我家ヒイキにて、男子とし（て）の咄にあらず。",
              "citation": {
                "source": "手紙",
                "author": "文久三年六月十六日　池内蔵太の母あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "チユプカは東北カムチヤトカに至りて大陸に連る。",
              "citation": {
                "source": "蝦夷とコロボツクルとの異同を論ず之に潜みて",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝦夷地のむかふ、エトロフや、アラスカや、カムチヤツカの、氷に鎖された地圖の涯にも、おどろくべき歴史があつた。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして更にロシヤの極東制覇を溯つてゆくならば、アラスカ經營、カムチヤツカ統治、沿海州のモンゴリヤ人種打倒と、ヨアン四世がはじめてヴオルガ河を渡つて東漸しはじめた一五三〇年に至る二百餘年の歳月があつた。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムチヤツカやアラスカに根城をおき、ヨーロツパに株主をもつ露米會社は、北氷洋の獵虎、沿海州の黒※の毛皮を當時最も高價に取引された支那の港に賣りこまねばならなかつたし、最も幸便に北太平洋から東支那海にぬけるには、日本本土を仲繼ぎにすることが最上であつたらう。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カムチヤツカにおいて若し漂着の日本人あらば、日本國に對する友誼の表徴として之を其本國に送還すべし。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "このハンガリヤ人はポーランド内亂の際ロシヤ軍の捕虜となつて、一七六九年シベリヤ流刑を宣告され、當時露米會社の政策によつて、カムチヤツカに護送されたが、三年目に一味徒黨をかたらつて、カムチヤツカ長官以下を殺戮し、北極から支那までの脱走に成功した世界的冒險家？",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "露米會社は一七八三年、レザノフの舅シエリコフによつて創立されたが、オホツクからカムチヤツカ、ベーリング海峽をこえてアラスカ北端に至る、つまり北極圈にちかい陸地では人類生存以來の出來事だと謂はれる。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "文化九年八月、北方千島の航路を開拓しつつあつた嘉兵衞の觀世丸は、ガロウニンの同僚リコルヅ少佐の「デイヤナ號」に抑留されてカムチヤツカへ連行された。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二囘の遣日使節レザノフのやうに、アラスカやカムチヤツカの沿岸で捕へた獵虎の皮を剥いで、日本をそのお客さんにしようとした「露米會社」時代とはわけがちがふのである。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "コーフンしてムチヤ言うが、そう簡単に行くもんか。",
              "citation": {
                "source": "ぼたもち",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつは、よその国はみんな泥坊だと決めてかかつたムチヤクチヤ議論だぞ。",
              "citation": {
                "source": "ぼたもち",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムチヤツカの南にある千島列島だ。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
