        "examples": {
          "standard": [
            {
              "text": "二人の運命を固く結び合わす儀式が、古くからのしきたりに従って厳かに執り行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "藁と藁を巧みに結び合わして、正月の玄関を彩る大きな注連飾りを作り上げる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "断片的な証言を結び合わすことで、ようやく事件のパズルが完成に近づいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "忘れんとして躊躇する毛筋の末を引いて、細い縁に、絶えるほどにつながるる今と昔を、面のあたりに結び合わす香である。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "われらが母と仰ぐ、美しく冷やかなおんみは、おのれのうちに生と死を結び合わす。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "』ここで、彼は急にまた『二人の手を結び合わす』と言ったことを思い出して、またもや恥ずかしくなってきた。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし時間を書いてゆかれないのは、先生らしくないことだ）　あくまで鈍感な私は、昨夜のできごとをこの黒板の字に結びあわすことをしないで、ただ先生の命令どおり受影機の前に坐って、スイッチをいれた。",
              "citation": {
                "source": "ある宇宙塵の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "女に生れたということは、パリでブレーク・キンネーアドと、スーザンとを再び結びあわす必然をもたらした。",
              "citation": {
                "source": "『この心の誇り』",
                "author": "――パール・バック著――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
