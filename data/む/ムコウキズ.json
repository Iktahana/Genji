    },
    "definitions": [
      {
        "index": 1,
        "gloss": "scar on one's forehead",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の顔には、幼い頃にできた向こう傷が残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "喧嘩でできた向こう傷は、彼の武勇伝として語り継がれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "向こう傷を隠すことなく、彼は堂々と生きていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "死体は行儀よく顔と顔とをつき合わするようにして並びながら倒れているのに、受けているふたりの傷は向こう傷でなく、うしろからやられたうしろ袈裟とは、いかにも奇怪至極です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "千柿の鍔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬっと姿を現わしたのは、向こう傷のある兇相の武士。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "活き傀儡　巴御殿から出て来たのは、築土新吾と向こう傷のある武士――長崎左源太という武士であった。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上額に向こう傷がある。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "案外娑婆と同じだなあ」向こう傷のあるのがこんな事を云った。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "胆を以て、腕を以て、あの向う傷に物を言わせて、力ずくにこれを押し破ったならば破って破れないことはないが、そのため怪我人を出し、血を見るような事になったら、他の猪勇に逸る旗本なら格別、わが早乙女主水之介には出来ないのです。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうやら向う傷が夜鳴きして参ったようじゃわい。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どのようなお方もいつ切通してならぬとの御院代様御言いつけにござりますゆえ、お通し申すことなりませぬ」「………」　駈け出して小賢しげに納所坊主両三名が遮ったのを、黙々自若として、ずいとさしつけたのは夜鳴きして参ったと言った眉間三寸、三日月形のあの冴えやかな向う傷です。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "両人共さッと身を退いて、気色ばみつつ身構えたのを、「騒ぐでない、江戸に名代の向う傷は先程より武者奮い致しておるわ。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほほう、揃うてお見送りか、夜中大儀々々」　少しあの向う傷の事を考えればよいのに、さッと恐れ気もなく行く手を塞いだのは八九名。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "御庭先でも勿体ない位でござります」　容子ありげな町奴の不審な言葉に、退屈男の向う傷はピカリと光りました。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　折からそよそよと街道は夕風立って、落日前のひと刻の茜色に染められた大空は、この時愈々のどかに冴え渡り、わが退屈男の向う傷も、愈々また凄艶に冴え渡って、いっそもううれしい位です。",
              "citation": {
                "source": "旗本退屈男　第五話",
                "author": "三河に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ぞ物を言いそうな向う傷じゃ。",
              "citation": {
                "source": "旗本退屈男　第五話",
                "author": "三河に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "重々御尤もな仰せなれば、手前一つお力添え致しまして、十年分ごといち時に献納させてお目にかけましょうが、いかがにござりましょう」「ほほう、その方が身のために力を貸すと申すか、眼の配り、向う傷の塩梅、いちだんと胆も据っておりそうじゃ。",
              "citation": {
                "source": "旗本退屈男　第五話",
                "author": "三河に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これこそはまさしく立派なお手判、よく拝見せい」　にんめり笑って、ずいと突き出したのは眉間のあの向う傷です。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この向う傷さえあらば、江戸一円いずこへ参ろうとて、いちいち直参旗本早乙女主水之介とわが名を名乗るに及ばぬ程も、世上名代の立派な手判じゃ。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆるゆるとこの向う傷に物を言わせてつかわそうぞ」　静かに呟きながら、愛用の一刀を音もなく抜き払いました。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、遍路という遍路のすべてが、美しい尼さんや、人の良い老夫婦ばかりではなく、なかには向う傷のある目のすごい大男や、ヘラヘラとした幽霊のような老人、手のない人なぞ、ものすごく気味のわるい遍路も珍しいことではなかった。",
              "citation": {
                "source": "抱茗荷の説",
                "author": "山本禾太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "年は五十に近いのだが、でっぷりと太って、額際に向う傷があって人相が険しい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "駒井能登守の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "がんりきの百ともあるべきものが、飛騨の高山へ来て、辻斬のお化けにおどかされたとあっては、もうこの面は東海道の風にゃ吹かせられねえ――憚りながら、このがんりきの百蔵は、見てくんな、こうして右の片腕が一本足りねえんだぜ、向う傷なんだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "勿来の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸御免なるあの月ノ輪型の向う疵と、諸羽流正眼崩しのあのすさまじい剣脈で行くのです。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "うす暗い蝋燭の火で観客はそれを覚ったかどうだか知らないが、向う疵を負った人形を使っているということは何分にも気が咎めて、冠蔵はどうも気乗りがしなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "人形使い",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に水夫の中でも兄い分の「向う疵の兼」がわざわざ鉄｜梯子を降りて、俺に談判を捻じ込んで来た位だ。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「向う疵の兼」というのは恐ろしい出歯だから一名「出歯兼」ともいう。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この向う疵は承知しても他の奴等が承知出来ねえ。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "船長室の外には、俺のアトから様子を見に来た向う疵の兼が立っていた。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロクな野郎じゃねえ」　と騒ぎまわる連中も居たが、そんな事ではいつでも先に立つ例の向う疵の兼が、この時に限って妙に落付いて、「居るもんけえ。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの顔に向う疵では、間の抜けた丹下左膳だねと笑いながら、すぐ註文の薬品その他を揃える仕度にとりかかった。",
              "citation": {
                "source": "くちなし",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二「なんだ、町人か」　向う疵のある、大柄の浪人は、平次を睨め廻し乍ら、部屋の眞ん中にドツカと坐り込みます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お局お六",
                "note": "青空文庫"
              }
            },
            {
              "text": "「中國浪人｜久留馬登之助、――顏に向う疵のある、三｜白眼の大男、海道筋に響いた無法者でございます」「あ、あれだ」「御存じで？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お局お六",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
