[
  {
    "uuid": "76d00d4b-78b5-59c9-9f69-d603d038d253",
    "entry": "向こう傷",
    "reading": {
      "primary": "むこうきず",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
