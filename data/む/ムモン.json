  {
    "uuid": "ad101808-7cb5-5b09-bee0-f363e11c0562",
    "entry": "無門",
    "reading": {
      "primary": "むもん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大道無門、千差有路、透得此関、乾坤独歩。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝、無門関第一則――趙州狗子。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "無門関第二則、百丈野狐。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "不眠、明方ちかくまで睡れなかつた、無門関を読んだ。",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩も早寝が出来ないので無門関を読む。",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜ふけるまで不眠、無門関第五則「香巌上樹」、初めて読む公案である。",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "無門関、第七則、趙州洗鉢。",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "無門関、第十二則、巌喚主人。",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "猶道未沾唇」（無門関第十則　清悦孤貧頌）――来た来た、来ました来ました、ありがたう、ありがたう、さつそく街へ局へ、そして方々へ、――払へるだけ払ひ、買へるだけ買つた。",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "身心沈静、無門関第十一則十二則。",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は彼女と別れて放浪中、偶然、古本屋で買った、「無門関」を愛誦していた。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "無門｜曰ク、不落因果、ナンノ為ニ野狐ニ堕ツ。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "それかと思うと、その頃｜碧巌を見たり無門関を見たりしていたので、禅定めいた contemplatif な観念になっている時もある。",
              "citation": {
                "source": "カズイスチカ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "悟道７・23（夕）　近頃｜碧巌録とか、無門関とかいつたやうな禅家の書物に、所謂悟道を商売にしない、素人の学者、求道者が飛び込んで往つて新しい解釈を試みようとしてゐるのは面白い現象である。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「手前、近頃考えまするに、善悪不二、大道無門」「そういう講釈は後日、ゆるりと聞こう」　左源太は、怒ったように、さっと、立上った。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "これさえ切れば光風｜霽月、手をとってともに山中を行く、これを切るには不動智をもってすべし』などと一応もっともらしく、その実あいまいな屁理窟をつらね一刀両断に切ったのを、柳生｜三巌という御用剣術家、無門関あたりから引っ張り出し、三学の説をあみ出したそうだの。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕『婦、公、』「大道無門」の甘さよ！",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大道無門」失敗の作なり。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前は一切無門関、勝手に屋敷の中を通る小学校通いの子供の草履ばた／＼で驚いて朝寝の眠をさましたもので、乞食物貰い話客千客万来であったが、今は屋敷中ぐるりと竹の四ツ目籬や、※、萩ドウダンの生牆をめぐらし、外から手をさし入れて明けられる様な形ばかりのものだが、大小六つの門や枝折戸が出入口を固めて居る。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "無門関か碧巌録の公案からでも取材したのかナ。",
              "citation": {
                "source": "安吾巷談",
                "author": "教祖展覧会",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近は又、碧巌、無門関等について日夕坐禅に心掛け、いささか非心非仏の境地をのぞいた。",
              "citation": {
                "source": "盗まれた手紙の話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　大河無門・平木中佐　昼近くになっても、次郎は広間を出なかった。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "名簿には、それぞれの欄に、「大河無門、二十七｜歳、千葉県、小学校代用教員、中学卒」と記入してあり、備考欄には、「青年団生活には直接の経験なきも興味を有す」と何だかあいまいなことが書いてあった。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は、大河無門は、一昨年の春京都大学の哲学科を出ると、すぐ母校である千葉県の中学校に奉職したが、もともと、いわゆる教壇的教育には大した興味も覚えず、もっと実生活にまみれた教育をやって見たいという希望を、たえず持ちつづけていた。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、大河無門は、その一番はいり口のところに、その大きないが栗頭を横たえ、近眼鏡をかけたまま、しずかに眼をつぶっていたのであった。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ一つの例外の顔というのは、大河無門の顔であった。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "次郎の視線は、大河無門の顔にひきつけられたきり、しばらくは動かなかった。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大河無門は、ぼくなんかにはまだとてもうかがえない、ある心の世界をもっているのだ。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして大河無門と荒田老とを見くらべてみる心のゆとりを、いつのまにか、かれにあたえていた。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれの眼に映じた大河無門と荒田老とは、まさに場内の好一対であった。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
