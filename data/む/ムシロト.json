          "literary": [
            {
              "text": "彼女は入口の筵戸を捲き上げた。",
              "citation": {
                "source": "南北",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、一疋の空腹な雀は、小屋の前に降りると小刻みに霜を蹴りつつ、垂れ下った筵戸の隙間から小屋の中へ這入っていった。",
              "citation": {
                "source": "南北",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は入口に下っていた筵戸を引きちぎって、「こんな邪魔物は要らんやろが。",
              "citation": {
                "source": "南北",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "かじかの啼く音が手近に聞こえ、稲葉を渡って来た香ばしい風が、莚戸の裾をゆるがせた。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
