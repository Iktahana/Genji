        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "レストランで、季節の野菜を使ったヘルシーな蒸し物を注文した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ダイエット中の私にとって、油を使わない蒸し物は最適な料理だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "中華料理には、点心など色々な種類の蒸し物がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "三十五日には見事な米饅頭と麦饅頭との蒸し物に茶を添えて近所に配った。",
              "citation": {
                "source": "ゆず湯",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしその専門学者の説明によれば、蒸し物を釜の上に置くときは、その蒸し物が冷ややかなるために、釜中の湯よりのぼる蒸気が急に凝結して消えうするにより、その場所をみたさんために、空気が外より蒸し物の中に流れ込む。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるときは、水蒸気の凝結が減ずるようになり、したがって空気の流入もやみ、ついで水蒸気が下より蒸し物の中に流通し来たり、再び水蒸気は急に凝結して、外より空気の流入を招くに至る。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十三　四十九日の蒸物を、幸さんや安公に配ってもらってから、その翌日母親とお庄とは、谷中へ墓詣りに行った。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十五日には見事な米饅頭と麦饅頭との蒸物に茶を添えて近所に配った。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから牛乳を入れたマッシ、寒天の寄せ物、米利堅粉と玉子を入た蒸物、お芋のフライ、繊に截った煮物、食後のお菓子で茶巾絞りなんぞがよろしゅうございましょう」妻君「そんなに色々なお料理｜方がありますか。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒸物は少し面倒ですがそれへ米利堅粉と玉子とを入れて全体ならカステラ鍋で一時間ほど蒸焼にするのですがただお湯で蒸してもようございます」と平生は安物と軽んぜらるる薩摩芋がお登和嬢のお蔭にて今日は上等料理に出世したり。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "○蒸物は漉したる芋を玉子と摺り交ぜ米利堅粉を加え味をつけて程好き固さとなし、それをカステラ鍋に入れて蒸焼にす。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "道具のない田舎や山の中で手軽に出来るのは手軽なカスタープデンといって牛乳と玉子の蒸物が一番軽便ですね。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "若布と独活をあしらって、こいつア胡麻酢でねがいましょう」「お蒸物は？",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "菊香水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにも家族の不倖と冷たさは筒井の心を悲しがらせ、彼女はさびしく笑い、多く働いてそれを紛らせながら、作るものは温かく品高い蒸物などに皆を喜ばした。",
              "citation": {
                "source": "津の国人",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒸しものの菓子を紙に包んで、ちょっと頂いた処は慇懃で却って恐縮。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
