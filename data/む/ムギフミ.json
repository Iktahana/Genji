        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "寒さが厳しい時期には、麦踏みが霜害から麦を守る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔ながらの農法では、冬の間に家族総出で麦踏みを行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "麦踏みによって、麦の根張りが良くなり、収量が増えると言われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "雪が消えるといつも麦踏みに忙しい。",
              "citation": {
                "source": "山と村",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と聞えるが」　するとすぐそれは聞えなくなって、彼方にいる老百姓が、麦踏みをやめてしまい、こっちを見ているふうである。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……きょう畑で麦踏みをなされながら大声で……麦踏め麦踏め芽を踏め芽を踏めと仰っしゃっていたようですが、あれはいかなる御意でしょうか」「それもすこしそちの勘ちがいであろう。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑に麦踏む頬冠りの人。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日なたぼこりで孫いじりにも飽いた爺の仕事は、啣え煙管の背手で、ヒョイ／＼と野らの麦踏。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "麦踏んで若き我あり人や知る大正十四年一月二十七日　中田みづほ渡欧送別句会。",
              "citation": {
                "source": "五百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "風の日の麦踏｜遂にをらずなりぬ昭和七年二月十三日　荻窪、女子大学句会。",
              "citation": {
                "source": "五百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
