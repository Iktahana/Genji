    "definitions": [
      {
        "index": 1,
        "gloss": "treading on wheat seedlings after planting (for better yield and health)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
