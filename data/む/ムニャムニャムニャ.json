          "literary": [
            {
              "text": "ムニャムニャムニャムニャムニャムニャムニャムニャ……窓の外は星だらけだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして間もなく……聖書……燐寸燐寸……ムニャムニャムニャ……と云って首をコックリと前に垂らしました。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムニャムニャムニャと美味そうに空気を喰って舌なめずりをしている者。",
              "citation": {
                "source": "芝居狂冒険",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩のもの云う」と子供心にも面白くない初同が済んで、「そオれ漢王三尺のげいの剣」という序になると、翁はそれから先の上羽前の下曲の文句の半枚余りを「ムニャムニャムニャ」と一気に飛ばして、「思い続けて行く程に――イヨー。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "参詣人が来ると殊勝な顔をしてムニャムニャムニャと出放題なお経を誦しつつお蝋を上げ、帰ると直ぐ吹消してしまう本然坊主のケロリとした顔は随分人を喰ったもんだが、今度のお堂守さんは御奇特な感心なお方だという評判が信徒の間に聞えた。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしのトランクの中に入っている身のまわり品は、必要とあれば重力打消器を組立てることも出来るし、また必要とあらば、ラジオ送受信機としても組立てられるし、又或る場合には兵器――いやナニムニャムニャムニャ――で、つまりその又或る場合には、喞筒みたいなものにも組立てられるのだ。",
              "citation": {
                "source": "戦時旅行鞄",
                "author": "――金博士シリーズ・６――",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女　　ウム、ウム、ムニャムニャムニャ。",
              "citation": {
                "source": "女人渇仰",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ御著述の方は何ですなムニャムニャムニャ！",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
