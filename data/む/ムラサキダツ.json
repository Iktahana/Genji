          "literary": [
            {
              "text": "あの空が紫立つてほんのり桃色に薄く見えべい。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "瞬間、島の青柳に銀の影が、パツと映して、魚は紫立つたる鱗を、冴えた金色に輝かしつゝ颯と刎ねたのが、飜然と宙を躍つて、船の中へ堂と落ちた。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "神の一声に世のすべての花はその蕾を開いて蝶は美くしい装いをこらいて舞い、雲雀は紫立つ雲の上に神の御力をたたえて歌いますじゃ。",
              "citation": {
                "source": "胚胎（二幕四場）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の間に充滿して居た夕闇は、光りに照されて、紫だつて動きはじめた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の間に充満して居た夕闇は、光りに照されて紫だつて動き初めた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の間に充満して居た夕闇は、光りに照されて、紫だつて動きはじめた。",
