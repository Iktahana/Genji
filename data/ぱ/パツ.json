    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "少し悪口云ふと、歌海の航行に碇も持たず羅針盤も持たないで、行きあたりぱつたりに、航行してゐるやうに見えるのだ。",
              "citation": {
                "source": "『悲しき玩具』を読む",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "春夜のただよふ靄の中でわたしはあなたの思ひをかぐあなたの思ひは愛にめざめてぱつちりとひらいた黒い瞳は夢におどろきみしらぬ歡樂をあやしむやうだ。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "靈智萩原朔太郎ふるへる、微光のよるに、いつぱつ、ぴすとるを撃つ、遠方に、金の山脈、かすかな、黒曜石の發光。",
              "citation": {
                "source": "靈智",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへば散歩に出るにしても、彼は最初からプランを立て、自分の好きな道筋や觀覽物やへ、文句なしに對手を引つぱつて行くにきめてる。",
              "citation": {
                "source": "田端に居た頃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、悲しいかな、私の方が蟻より大きかつたものだから、蟻の足は岩に届かないで、私の臍の近くでつゝぱつてゐるだけだつた。",
              "citation": {
                "source": "運動会の風景",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "四人の川舟船夫たちは、底の浅い川舟の中で大騒ぎしながら、竿や櫂で川底の石をつつぱつたり、水を掻いたりして、対岸の絶壁の淵の方へ川舟をやらうと努力してゐた。",
              "citation": {
                "source": "万福追想",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのひとの際立った不思議な美しさの原因は、もっと厳粛な、崇高といっていいほどのせっぱつまった現実の中にあったのです。",
              "citation": {
                "source": "東京だより",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、せっぱつまって、死ぬ事を考える。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "親が破産しかかって、せっぱつまり、見えすいたつらい嘘をついている時、子供がそれをすっぱ抜けるか。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを読んでくれると、私がさきにもちょっと言って置いたような「親が破産しかかって、せっぱつまり、見えすいたつらい嘘をついている時、子供がそれをすっぱ抜けるか。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "持つてゐた單語のカアドが二三枚ぱつと飛び散つた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はいつでも、せっぱつまって、くるしまぎれに言ってるのです。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしたちだって、いつでも、せっぱつまって言っているのです。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "せっぱつまった言葉が、出るものだ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、私自身は、以前と少しも変らず、やっぱり苦しい、せっぱつまった一日一日を送り迎えしているのであるから、北さん中畑さんが来なくなったのは、なんだか淋しいのである。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "せっぱつまり、旅の仮寝の枕元の一輪を、日本浪曼派と名づけてみた。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしおそらくそんな生温かい享楽のためではなくて、これもまたもっとせっぱつまった生存の権利を主張するために何かを期待して狙っていたに相違ない。",
              "citation": {
                "source": "蜂が団子をこしらえる話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜になると、その向うの八つの窓にはぱつと電氣が點いた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその一隅にある傾斜の急な階段を手探りに登つて、登りついた二階の廊下の扉を開くと電燈のぱつとした、十疊ほどの長い廣間だ。",
              "citation": {
                "source": "阿片の味",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして手をのばして電燈のスヰツチをひねつて、室内がぱつと明るくなると同じ瞬間に、それは忽ち消えてしまつて自分の常態に返る。",
              "citation": {
                "source": "自分の變態心理的經驗",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲が切れたのか、明るい光線がぱつと私達の背後から輝いた。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「『朝に死し、夕べに生るるならひ、ただ水の泡にぞ似たりける……』と云ふのは……」先生の牛の涎のやうな講義の聲はぱつたり止んだ。",
              "citation": {
                "source": "猫又先生",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒絹の手袋した右手に金金具、茶なめし皮のオペラパツクを、左手に派手な透模樣のパラソルを、そして、金紗づくめのけばけばしい着附、束髪に厚化粧、三十三四と見える年頃が、停車中の車内のむしむした、變にダルな空氣をぱつと引き立たせるに十分だつた。",
              "citation": {
                "source": "女盗",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而もその途端に向うも此方を見て、ぱつと視線がぶつかつたのさ……何しろその時、僕ははつと思つたよ。",
              "citation": {
                "source": "Ｓ中尉の話",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手をあげて走りかかれば、ぱつとまた立ちあがりて、おなじ距離五、六尺ばかりのところにとまりたり。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆふ日あざやかにぱつと茜さして、眼もあやに躑躅の花、ただ紅の雪の降積めるかと疑はる。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "のですが、其が、黒目勝な雙の瞳をぱつちりと開けて居る……此の目に、此處で殺されるのだらう、と餘りの事に然う思ひましたから、此方も熟と凝視ました。",
              "citation": {
                "source": "人魚の祠",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見て居るうちに、其の一つが、ぱつと消えるかと思ふと、忽ち、ぽつと、續いて同じ形が顯れます。",
              "citation": {
                "source": "雪靈續記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、其の影が映すと、半ば埋れた私の身體は、ぱつと紫陽花に包まれたやうに、青く、藍に、群青に成りました。",
              "citation": {
                "source": "雪靈續記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "先へ斜に飛んで、其の大屋根の高い棟なる避雷針の尖端に、ぱつと留つて、ちら／＼と青く輝きます。",
              "citation": {
                "source": "雪靈續記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
