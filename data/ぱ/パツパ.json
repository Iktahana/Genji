        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "先生には今以て子供が出来ず、先生は夏はアツパツパーを着て読書をしたり午睡をしたりしてをられる。",
              "citation": {
                "source": "夏",
                "author": "〔私が貧乏で〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗い土間に自轉車をおしこむと、人々は腰の手拭ひを取つてパツパツと裾をはたきながら、ゆがんだ階段をぎしぎしときしませてのぼつて行く。",
              "citation": {
                "source": "黎明",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "色の褪せた、野良仕事用のアツパツパに、島民竝の跣足である。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の服装（殊に夏季の）が一変しつゝあるのに驚く、老女のアツパツパは感心しませんね。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "△どこへいつても、どんなをんなでも（一部の老人と田草取とをのぞけば）アツパツパを着てゐる、簡単服、家庭服として悪くはないが、どうぞヅロース一番せられよ（天声子の語を借る）。",
              "citation": {
                "source": "行乞記",
                "author": "山口",
                "note": "青空文庫"
              }
            },
            {
              "text": "暖かい砂がパツパツとはねあがつて、規律正しい諧調で砂と空気とを蹴つてゆく爪先の感覚が非常に快く思はれました。",
              "citation": {
                "source": "晩春の健康",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "暖い砂がパツパツとはねあがつて、規律正しい諧調で砂と空気とを蹴つてゆく爪先の感覚が非常に快いのを沁々と味ひました。",
              "citation": {
                "source": "砂浜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "道のまんなかを、刺青のある大肌ぬぎで、浴衣の兩裾を抓み廣げて、日和下駄をカラカラ響かせてゐるが、逆らはずに連れて歸る、アツパツパの丸髷の、がつしりした女房の方が、默つてゐて押のきく態度だ。",
              "citation": {
                "source": "夏の夜",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "亜米利加の星条旗が風に翻り、軍艦が波を蹴立て、鉄砲の銃先から、パツパツと白い煙が出るのを、不思議な感動をもつて見つづけた。",
              "citation": {
                "source": "「追憶」による追憶",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "風がない日で、廊下には附添の婆さんなぞの、アツパツパの裾を太股までたくしあげた、けだるい風體でしやがんでゐるのや、バケツをさげて立話してゐるステテコのズボンから毛脛をむきだしたおやぢさんやら、そんな附添人たちの庶民的風體からしてもこの病院の性質がわかる。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　パツパツとその辺を見て、やはり側に転がつてゐる手頃の岩を抱へて、鶴ハシの直ぐ側の岩の下に噛ませる。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（階段の方と室内をパツパツと見て、掌中の物を球台の下に差し込む）正宗さん、頼む！",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ俵屋の身上は主人のものだと思つたか、隨分パツパと撒き散らしたやうですから」「手代の金之助も奉公人なみだらうな」「仲が惡くなかつたやうです、尤も下男の五助は、時々叔父さんに盾をついて、ひどく叱られたりしましたが」　お粂は元氣を取戻して、かなり突つ込んだことまで言つてくれるのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "鬼女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どう付いたんだ」「伊太郎と照吉は無二の仲でしたが、近頃伊太郎が何にかで儲けた樣子で、パツパして居りました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "狐の嫁入",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
