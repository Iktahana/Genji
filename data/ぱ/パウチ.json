          "literary": [
            {
              "text": "そしてそのかたわらにしゃがみ、鞄のアウトサイド・ポケットからパウチを取り出した。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらゆるものが入っているそのパウチから、彼女は部屋の鍵を探し出した。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パウチをわきの下にはさみ、鞄を持ち上げ、彼女はドアを押し開いた。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その廊下を彼女はパウチだけを持って歩いた。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
