          "literary": [
            {
              "text": "アメリカの上院議員パスニー氏は、突然次の如き見解を発表した。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしわれらにして躊躇することあらば、悔いを千載に残すことになろう」　このパスニー氏の声明は、直ちにアメリカ人の一部の与論の支持を受けた。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから始まって、パスニー氏の意見に賛成する者が、世界の方々に現われた。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            }
          ]
        }
