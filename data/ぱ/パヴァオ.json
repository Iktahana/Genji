        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マニュエル・パヴァオが、小さなコントロール台のスイッチをオフにした。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「誰ということはないんだ」　いつもの真面目な口調で、マニュエル・パヴァオが言った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マニュエル・パヴァオは、ふたりを僕たちに紹介してくれた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その作業の実行委員長のような役を引き受けているのが、このマニュエル・パヴァオだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なにしろ私ときたら、小学生の頃はこの汽車に乗って学校にかよったのだから」　計画どおりに線路を敷き、このミカドがそこを走るまでにするには、さらに六か月かかる、とマニュエル・パヴァオは言っていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たちの運動が弱体化したその間隙を埋めるように登場したのが、マニュエル・パヴァオたちの運動だった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マニュエル・パヴァオたちのオフィスにある、あの模型だ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "初老の男たちに混じって、鉄道をよみがえらせたマニュエル・パヴァオやボブ・サントスたちの顔も見えた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
