          "literary": [
            {
              "text": "水をパシヤパシヤさせてゐる水のなかの駒平の手の下は薄赤い肉色だつた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "パシヤパシヤ水が跳ねて、獲物は房一の手の中で強くビクビクと動きやまない。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（妹が出してくれるタオルと塩を受取つて、土間へ降りる）おい……（表のカケヒの方へ出て行き、顔を水で一二度パシヤパシヤやる）利助　……早く買つて来い！",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
