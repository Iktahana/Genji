        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "山じゅうの笹を横なぐりにしてどっと吹き降るので、傘がパラシウトのように風を孕んで、伸子を体ごと吊り上げそうにした。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "明智の背中にも、不二子さんの背中にも、パラシウトの綱がしっかりと結びついていた。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その怪飛行機から、二つのパラシウトが湧き出したのを見ると、騒ぎは一入烈しくなった。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "二つのパラシウトが着陸したのは木更津附近の海岸であった。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
