    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "山は雨のために白く煙り、雉、山鳥があちこちから、ぱつぱつと飛び立つて矢のやうに早く、雨を避けようとして林の中に逃げ込む。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱつぱつと話はする。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼鏡をかけた與田先生は時々英語まじりにワーズワースを論じ、萬葉を論じ、せつかちに言葉の聯想がぱつぱつと火華のやうに散つてゆくとともに、卓上には先生のつばきも相當飛んでいつた。",
              "citation": {
                "source": "婚期",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "友吉はぱつぱつぱつ、ぱぱつ、ぱぱつと喇叭を吹きました。",
              "citation": {
                "source": "私の生ひ立ち",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねぢ鉢巻の男が撃剣のお胴をつけて鳥が戦ひを挑むときのやうにひよんひよん跳ねながらかかつてゆくと駝鳥が腹をたててぱつぱつと蹴とばすのである。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
