[
  {
    "uuid": "5c99cdf1-7199-5013-92fe-a82a2f5dc6d7",
    "entry": "パッ",
    "reading": {
      "primary": "パッ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "感動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "poof",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「え、もう終わり？パッ！て感じだったね。」と彼は驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "まるで魔法のように、パッと花火が夜空に咲いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「パッ」と消えるように、彼は人混みの中に姿を消した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "雪の下からは蒼黯い偃松が、杉菜ほどに小さく見えて、黄花石楠花は、白花石楠花に交って、その間にちらほらしている、一団の霧が槍へ吹っ懸けて、白い烟をパッと立てるので、一時は姿を没したが、又穂先だけ鋭く突き出す。",
              "citation": {
                "source": "槍ヶ岳第三回登山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "天幕が霧の中に、小さくぼんやり見える、四ツ柱に、油紙がぺらぺらとして、田舎の卵塔場のようだ、今まで、あそこに寝ていたのか知ら……この霧と雨の中を、たった紙一枚の下に……火光がパッとさす、霧の水球が、美しい紫陽花色に輝いたかとおもうと、消えた。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度の何とか称する貴族で、デッキパッセンジャーとして、アメリカに哲学を研究に行くと云う、青年に貰った、ゴンドラの形と金色を持った、私の足に合わない靴。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはそれは名状し難い速さで廻っているかと思うと急に花火の開いたようにパッと散乱してそのまた一つ一つの片が廻転しながら縦横に飛び違う。",
              "citation": {
                "source": "赤",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "血の色はますます濃くなって再び真黒になったと思うとまたパッと明るくなって赤いものが廻りはじめる。",
              "citation": {
                "source": "赤",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッションが起らないからねえ」「パッションって何だい」「パッションかい。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッションとやらが起らずに、ほとんど生涯勤めて来た座敷の数々、相手の数々が思い泛べられた。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッシー通りで夫婦｜揃って食料品店で働き抜いた五十五、六の男の自然に枯れた声も秋風のなかにふさわしい。",
              "citation": {
                "source": "巴里の秋",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "見せかけのこの親子連が成功するかしないかと楽屋を見抜いた商売女たちや店の連中、定連のアパッシュまでがひそかに興味をもって明るい電気の下で見まもっていた。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "弛緩の極限を表象するような大きな欠伸をしたときに車が急に止まって前面の空中の黄色いシグナルがパッと赤色に変った。",
              "citation": {
                "source": "初冬の日記から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "パ行音は語頭には用いられない（パット、ポッポト、ポンポンのような擬声語は別である）。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "穏やかで、パッシイヴで、そしてどこか涼しい感じのする人であった。",
              "citation": {
                "source": "中村彝氏の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また夜間ならば糸に触れると点火器の引金が落ち、マグネシウムがパッと燃え上がって、動物は驚いて遁げる間のない中にカメラに写される。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒に醉つてゐた私は、醉人一流のパッションと無計算とで、皆それを買ひたく思ひ、代金先拂ひにして自宅へ屆けさせたのだつた。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その外には、つぎのあたった木綿縞や紅木綿の襦袢や、パッチが入っていた。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し、以上見て来たところのものを西欧の近代の戦争文学と比較するならば、トルストイの「セバストポール」や「戦争と平和」は勿論、ガルシンの「四日間」「兵卒イワノフの手記」「卑怯者」でも、またアンドレエフの「血笑記」でも、モウパッサンのへんぺんたる短篇の戦争を扱ったものでも、やはり遙かに上にある。",
              "citation": {
                "source": "明治の戦争文学",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　しかし、その瞬間、パッと煙が上った。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "将校の銃のさきから、パッと煙が出た。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」俊までが、パッと紅くなった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷間や、向うの傾斜面には、茶色の鬚を持っている男が、こっちでパッと発火の煙が上ると同時に、バタバタ倒れた。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちに散らばっている兵士の銃口から硝煙がパッと上る。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッと硝煙が上った。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "マッチがパッとすられ莨の青いけむりがほのかにながれる。",
              "citation": {
                "source": "秋田街道",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなはだれもパッと顔をほてらせてあつまり手を斜に東の空へのばして「ホッホッホッホッ。",
              "citation": {
                "source": "花椰菜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔をあげて見ますと入口がパッとあいて向ふの山の雪がつんつんと白くかゞやきお父さんがまっ黒に見えながら入って来たのでした。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "にはかにそのいたゞきにパッとけむりか霧のやうな白いぼんやりしたものがあらはれました。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とうとう大烏は、我慢し兼ねて羽をパッと開いて叫びました。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時向うから銀色の光がパッと射して小さな海蛇がやって来ます。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
