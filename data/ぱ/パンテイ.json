        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（一月三十日）　　　　　印税　Jules Sandeau のいとこが Palais Royal のカツフエへ行つてゐると、出版｜書肆のシヤルパンテイエが、バルザツクと印税の相談をしてゐた。",
              "citation": {
                "source": "点心",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "裾まわりに黄色とクリーム色、レモン色の濃淡であっさりとウクライナ風の模様が縫いとりされているパンテイ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "30日の人事不省から呼び戻されたパンテイアの話は長いあいだ想像されていた。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "死者を蘇らせることはエンペドクレスとパンテイア（＊前出）以来、多くの治療者の名前と関係させられている。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからサント＝ブーヴはモンテーニュの神観を、むしろスピノジスム、パンテイスムだと言っている（Sainte-Beuve: Port-Royal, livre ）。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
