        "examples": {
          "standard": [
            {
              "text": "重い荷物を背負って、リュックがパンパンになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "満員のバスは乗客でパンパンだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "食べすぎてお腹がパンパンだ。もう何も入らない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "prostitute (catering to Occupation soldiers in Japan after WWII)",
        "register": "standard",
        "nuance": null,
