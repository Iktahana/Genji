        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "戦後の混乱期には、一部の女性が生活のためパンパンと呼ばれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "歴史の授業で、戦後のパンパンの社会背景について学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "映画は、戦後の東京を舞台に、パンパンと呼ばれた女性たちの厳しい現実を描いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
