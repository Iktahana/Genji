    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "火の手は、七条にも上がりまして、ぱちぱちぱんぱんと燃える音が手に取るように聞こえます。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく喰べてお呉れだったね」　目の前の母親は、飯粒のついた薔薇いろの手をぱんぱんと子供の前で気もちよさそうにはたいた。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那は立上ってうやうやしく神前に額ずき、ぱんぱんと拍手をうって大漁の祈願をこめた。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その朝は、出て行く前に、家ぢゆうのものが牛のまはりを取りまいて、口々に何か云つては、額や鼻面を撫でたり、背や腹をぱんぱん、平手で輕く叩いたりした。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵隊はどんどん祝砲を放しますし、男の子たちはかんしゃく玉をぱんぱんいわせました。",
              "citation": {
                "source": "旅なかま",
                "author": "REJSEKAMMERATEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱちぱちという音のほかに、ぱんぱんと鉄砲をうつような音も聞こえていた。",
              "citation": {
                "source": "火事とポチ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹鉄砲紙の弾丸よし、花火筒につめよ押しこめ、煙硝よ染めとはじけと、ぱんぱんと響け、火花よ飛びちれと、幼な児我は。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたら、いきなりぱんぱんと笑いだしたんで、気が遠くなったんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血の降るへや",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　それを聞くと、右門ははじめてわが意をえたりというように、ぱんぱんと手についた土ほこりをはたきながら、涼しい声でいいました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "てっとりばやく入舟町へいって洗いたてりゃ、たちまちぱんぱんとらちがあくじゃねえんですか！",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱんぱんと早手回しにやってめえりますからね、ちょっくらお待ちなせえよ」　飛び出していったかと思うと、いかさま早い。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "先にたってどんどんはいっていくと、そこの仕上げべやにうずくまりつつ、しきりと焼き人形の仕上げを急いでいる老人と若いのとふたりに、ぱんぱんとあびせました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "「馬鹿者共めがッ」　言いざま、前に居合わした中間二人を、ぱんぱんと取って押えておくと、鋭く京弥に命じました。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱんぱんとひとにらみに藻屑をあばいてお目にかけるから、ついてきな」「ちげえねえ」「おそいや！",
              "citation": {
                "source": "右門捕物帖",
                "author": "左刺しの匕首",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱんぱんとひとにらみに藻屑をあばいてやらあと、たいそうもなくりっぱな口をおききでしたが、ぱんぱんはどこへいったんです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "左刺しの匕首",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、おめえは口軽男だ、うれしくなってぱんぱんまくしたてたらいけねえぜ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "左刺しの匕首",
                "note": "青空文庫"
              }
            },
            {
              "text": "得意のむっつり流で、ぱんぱんとやっておくんなせえまし！",
              "citation": {
                "source": "右門捕物帖",
                "author": "左刺しの匕首",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱんぱんとたちまちかぎつけてめえりますから、お待ちなさいよ……」　いったかと思うと、伝六自慢の一つ芸、能書きにうそはない。",
              "citation": {
                "source": "右門捕物帖",
                "author": "子持ちすずり",
                "note": "青空文庫"
              }
            },
            {
              "text": "――さ、伝六、また少し忙しくなったぜ」　のみならず、ゆうゆうとして蝋色鞘を腰にすると、ぱんぱんひざがしらをはたきながら、おちついて帰りじたくを始めましたものでしたから、どこにどう犯人のめぼしがついたものか、まるでまだ五里霧中の七郎兵衛があわをくって尋ねました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "身代わり花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「…………」「…………」　十手も啖呵もものをいったのではないが、われこそその一の子分と巻き舌でぱんぱんと名のったむっつり右門の名がきいたのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱんぱんと、ひとりでいいこころもちそうに啖呵をおきりのようですが、いってえ何を白状するんですかい」「決まってるんだッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
