        "examples": {
          "standard": [
            {
              "text": "今日のシンポジウムでは、著名な識者たちがパネラーとして登壇した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "今夜の討論番組には、各界の著名人がパネラーとして出演している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "視聴者代表のパネラーが、専門家に対して鋭い質問を投げかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "パネラーの一人一人に「九〇年代前半に隆盛を見る三つの環境を予測せよ」との課題を与えて進められたパネル・ディスカッションは、議論白熱となった（ようだ）。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "はては任天堂がどうしたこうしたとキーワードが飛び交う中で、オレがウイルス頭を抱えてパネラー席でぼんやり考えていたのは、コンピューターの使いこなしにおける『世界観』だった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
