        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女の明るいパーソナリティーは、周囲の人々を惹きつける魅力がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "チームをまとめるためには、リーダーのパーソナリティーが重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の小説は、登場人物のパーソナリティーが細やかに描かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "いよいよ進めばいよいよ哲学者のいわゆるパーソナリティー（わが国で普通にいう人格とは違う）の大を知る。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "パーソナリティーそのものだ。",
              "citation": {
                "source": "カライ博士の臨終",
                "author": "人生の最も厳粛であるべき瞬間に、わたくしがもし笑ひの衝動をおさへることができぬとしたら、いつたいどんな罪に問はれるであらう？",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜというにベルグソンの哲学に於てもＷ・ジェームズの心理学に於ても、問題は元来パーソナリティーにあったのであって、Ｊ・ジョイスやＭ・プルストにパーソナリティーのモラルを求めることは当然で又容易いことではないかと思えるからだ。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの映画のおもしろみはストーリーの猟奇的な探偵趣味よりもむしろウィリアム・パウェルという男とマーナ・ロイという女とこの二人の俳優の特異なパーソナリティの組み合わせと、その二人で代表された特異な夫婦間の情味にかかっているというのが定評となっているようである。",
              "citation": {
                "source": "映画雑感（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちっとも父のパーソナリティも母の気分もない。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「パーソナリティ」の名で知られる誇大宣伝の手法によって。",
              "citation": {
                "source": "詩とマイクロホン",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "(*7) 英国の哲学者、著述家、教師、ラジオパーソナリティ。",
              "citation": {
                "source": "詩とマイクロホン",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "役者の芸なんて、いや／＼役者のパーソナリティなんて、実にもろいものだと、痛感する。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "何たるパースナリティの貧弱さだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞパースナリティに感心するのみ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロッパは、ベーブ・ルースで、つまりパースナリティーだけのよさだと。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "グエン・ヴァードンのパースナリティーに圧倒される。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
