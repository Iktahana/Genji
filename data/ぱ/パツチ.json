        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "』とパツチリとした眼で母君の顏を見上げた。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼はパツチリした二皮瞼で、瞳は邪氣無い希望と悦とに輝いてゐるかと見られた。",
              "citation": {
                "source": "解剖室",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "一體｜皆の長い、パツチリした眼で、表情にも富むでゐた。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼はパツチリ覺めて了つた。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "日曜の朝、「秋」は匂ひも新らしく新聞紙折り、さはやかに衣嚢に入れて歩みゆく、寄せてくづるる波がしら、濡れてつぶやく銀砂の、靴の爪さき、足のさき、パツチパツチと虫も鳴く。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "幽かな音、幽かな色、幽かなささやき……四十三年七月　　種蒔きパツチパツチと鳴く虫の昼のさびしさ、つつましさ、……葱の畑のそこここに銀の懐中時計を閉める音。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "パツチパツチと鳴く虫の昼のさびしさ、しをらしさ、……強い日射のそこここに若いこころの咽ぶ音。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんに一日齷齪と歎き足らひで、権兵衛が青いパツチに縄の帯、及び腰してひとすぢに土の臭を嗅いでゆく午後の光に蒔く種はかなしみの種、性の種、黒稗の種。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "パツチパツチと鳴く虫の昼のさびしさ、なつかしさ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "パツチパツチと鳴く虫の昼のさびしさやるせなさ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "パツチパツチと鳴く虫の昼のさびしさおそろしさ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "パツチパツチと鳴く虫の昼のさびしさ、情なさ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "外面にはふる雪のなにごともなく、水仙のパツチリとして匂へるに薄荷酒青く揺げり。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "有明の月に血を吐くほととぎすの悲歎を曾て見知らぬ私は寧ろキヤベツ畑の雨に啼く郭公を楽しいものに哀れみ、昔ながらの古い前栽の繁みに飛ぶ蛍よりも客待の人力車のかげに仄かに蒼白いお尻のパツチを光らす東京の蛍をこの上なく今の心に親しむ。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　ヲバサン　コンニチハ」「オヤ　テフテフサン　コンニチハ」「アカチヤンノ　オメメハ　アキマシタカ」「ケサ　ヤツト　アキマシタ」　ミルト　オウマノ　アカンボハ　ネワラノ　ナカデ　パツチリ　オメメヲ　アケテ　オトナシク　シテ　ヰマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿母さんの竹代夫人は、その声にこの頃凝つて居る座禅を止めて、パツチリと眼をあけた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "お八重は、深く息を吸つて、パツチリと目を開けて、お定の顔を怪訝相に見てゐたが、『ア、家に居だのでヤなかつたけな。",
              "citation": {
                "source": "天鵞絨",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際藤野さんは、今想うても余り類のない程美しい児だつたので、前髪を眉の辺まで下げた顔が円く、黒味勝の眼がパツチリと明るくて、色は飽迄白く、笑ふ毎に笑窪が出来た。",
              "citation": {
                "source": "二筋の血",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "見付けてさうして抱いて見ると、パツチリ目をあけて笑ひ出した。",
              "citation": {
                "source": "郁雨に與ふ",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "鏡に映つた兒どもの、面には凄いほど眞白に白粉を塗つてあつた、睫のみ黒くパツチリと開いた兩の眼の底から恐怖に竦んだ瞳が生眞面目に震慄いてゐた。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日の午後圓い玉葱の花に黄色い日光が照りつけて、晝の蟲が幽かにパツチパツチと鳴いてゐる時、私はその上の丘の芝生に寢ころびながら初めて自分の身體から沁み出る強い汗の臭を知つた。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "凾過ぎし日は鍼醫の手凾、天鵝絨の紫の凾、柔かに手を觸れて、珍らしくパツチリとひらいた凾、舶來の凾。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
