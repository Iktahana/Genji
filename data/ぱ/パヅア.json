          "literary": [
            {
              "text": "パヅア、トリエステ、フエルララなどにや候はんと、答へもあへず戸を鎖したり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "車は情なくして走り、一｜堆の緑を成せるブレンタの側を過ぎ、垂楊の列と美しき別業とを見、又遠山の黛の如きを望みて、夕暮にパヅアに着きぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は親族と共にパヅアに往きたり、二三日の後ならでは歸り來ざるべしといふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "バーデン（地）Barden.（ドイツ）パヅア（地）Padua.（イタリア）市の名。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
