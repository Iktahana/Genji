        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「アランに初めて会ったのは、タヒチのパペーテでした。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハミルトンがタヒチのパペーテでアランに会ったのは、アランがダフネによって撮影されたあとのことだった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨の午後、パペーテの酒場でアランとビールを飲みながら、僕はこのサーフを撮影した８ミリ・フィルムのことを思い出しました」「アランにお見せになったのでしょう」「はい、見せました。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度だけ、パペーテの町を歩いているアランの姿を、ハミルトンは見かけた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私の船は、タヒチのパペーテを基地にしています。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パペーテの自宅に置いてあるという。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま私が持っているアランの波乗りのフィルムをつなぎ、雨のパペーテも撮って。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パペーテで俺がまず見たら、すぐに航空便で送る」「楽しみに待っていよう」　そんなふうにしか、返事のしようがなかった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "７　アランが使っていた赤いサーフボードは、パペーテのビル・ハミルトンの自宅に置いてあった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨のパペーテから始まった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビル・ハミルトンがパペーテで初めてアランに会うところから、ダフネは静かに語っていった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてパペーテの港からの出航。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
