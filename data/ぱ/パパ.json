        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は、裕福なパパがいて、欲しいものは何でも買ってもらっているらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女はパパに高級ブランドのバッグを買ってもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "若い女性がパパから経済的な援助を受ける問題が社会的に議論されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
