          "literary": [
            {
              "text": "パースレイ　只今花さく。",
              "citation": {
                "source": "きのふけふの草花",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "至つてまづい花だが、古ギリシヤ人はヘルキュレス初めてこれを冠つたとて、極めてこれを尊び、乾からびたパースレイの冠をイスミヤ競技の勝者に授けた。",
              "citation": {
                "source": "きのふけふの草花",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、死骸にこの草の枝を撒いたから、人が死際にあるをパースレイが入用だといつた。",
              "citation": {
                "source": "きのふけふの草花",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "プルタルクス説に、パースレイを負ふた驢馬に会つた軍隊が敗軍の凶兆と心得て大騒ぎしたと。",
              "citation": {
                "source": "きのふけふの草花",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、畑を作るに先づパースレイとヘンルウタをその縁に植た。",
              "citation": {
                "source": "きのふけふの草花",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "因つてまだ実行に取かゝらぬといふ代わりに、やつとパースレイとヘンルウタの段だといつた。",
              "citation": {
                "source": "きのふけふの草花",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
