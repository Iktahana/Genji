        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あのパベルのお母さんを学んでくれ。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "パベルのお母さんが、その子の入獄とともに、その老い行く身を革命運動の中に投じて、あるいは秘密文書の配付に、あるいは同志の破獄の助力に、粉骨砕身して奔走するあたり、僕は幾度か巻を掩うて感涙にむせんだ。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "パベ街までしか行かないで、頭を振って戻っていった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "発作に対しては今まで医師からＰ剤Ｑ剤の服用、酸素吸入、鎮静剤、パパベリンの注射等を受けている。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
