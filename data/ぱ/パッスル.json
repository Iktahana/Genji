          "literary": [
            {
              "text": "阿蘭陀語ではパッスルと申し、イタリヤ語ではコンパスと申すもののことである、と通事のひとりが教えた。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "通詞がないと答へたので、白石がなんのことだと問ふてみると、和蘭語ではパッスルといふもの、ローマの言葉ではコンパスといふものゝことであると言ふ。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
