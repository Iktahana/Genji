        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　とぱちぱちぱちと指を弾いて、「わしども覚えがござります。",
              "citation": {
                "source": "怨霊借用",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは見習い修業もせなならんのに、カメラを持ち出して、ぱちぱちぱち、とやっては、ウサギが穴にはいるように地下室へ潜り込んで、写真を現像しよるんです。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポカーンと擂粉木が団子に中るや否やわー、ぱちぱちぱちと、わめく、手を拍つ、やれやれと云う。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱちぱちぱちと、春太郎も思わず手をたたきました。",
              "citation": {
                "source": "街の子",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱちぱちぱち、ぴちぴちぴち。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱちぱちぱちと、とつぜんはげしい音がきこえた。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱちぱちぱちと、鳴るはお召しか、はあ悲しや、救はせたまへを口の裡。",
              "citation": {
                "source": "したゆく水",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱちぱちぱち、私らは拍手喝采した。",
              "citation": {
                "source": "採峰徘菌愚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　これにはその場一同の手からぱちぱちぱち、キングがこの日初めてほんとにうまいことを言ったもんでね。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちいさい　くろっぱなを　すんすんすん、　めを　ぱちぱちぱち。",
              "citation": {
                "source": "チギウィンクルおばさんのはなし",
                "author": "THE TALE OF MRS. TIGGY-WINKLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "チギウィンクルおばさんは、　はなを　すんすんすん、　めを　ぱちぱちぱち。",
              "citation": {
                "source": "チギウィンクルおばさんのはなし",
                "author": "THE TALE OF MRS. TIGGY-WINKLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "まとめてやれ、まとめてやれ」　本線シグナルつきの電信柱は、物を言おうとしたのでしたが、もうあんまり気が立ってしまってパチパチパチパチ鳴るだけでした。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「パチパチパチパチやっている。",
              "citation": {
                "source": "チュウリップの幻術",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "空が旗のやうにぱたぱた光って翻へり、火花がパチパチパチッと燃えました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずうっとずうっと遠くで騎兵の演習らしいパチパチパチパチ塩のはぜるやうな鉄砲の音が聞えました。",
              "citation": {
                "source": "土神と狐",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "空が旗のようにぱたぱた光って飜り、火花がパチパチパチッと燃えました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずうっとずうっと遠くで騎兵の演習らしいパチパチパチパチ塩のはぜるような鉄砲の音が聞えました。",
              "citation": {
                "source": "土神ときつね",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　まったく籾は、パチパチパチパチ歯にあたり、またまっ白な頭や首にぶっつかる。",
              "citation": {
                "source": "オツベルと象",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると猫はしばらく首をまげて聞いていましたがいきなりパチパチパチッと眼をしたかと思うとぱっと扉の方へ飛びのきました。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "空が旗のようにぱたぱた光って翻えり、火花がパチパチパチッと燃えました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思うと、パチパチパチッとはげしい音がして見る見るまるで煙のように砕けました。",
              "citation": {
                "source": "貝の火",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "豆殻をたくのでパチパチパチ盛んに音がする。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "パチパチパチパチパチパチリッである。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "パチパチパチパチパチパチと、岩燕が群をなして颯と頭上を翔け過ぎた。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パチパチパチパチと音がする。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パチパチパチパチパチ。",
              "citation": {
                "source": "銅銭会事変",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
