  {
    "uuid": "f2dde17a-3190-5359-9838-5661ec351ec2",
    "entry": "パンスケ",
    "reading": {
      "primary": "ぱんすけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "酔客、ヨタモノ、パンスケ、男娼、などなどの怪物が横行していて、常人は足をふみ入れかねる。",
              "citation": {
                "source": "ジャングル頭",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その女というのが、お寺の裏のお尻をヒッパタかれたあのパンスケじゃありませんか。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ゃ、パンスケはキライですよ。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "パンスケ、遊女と云って区別をすることはないものだ。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチノ宿六の野郎もパンスケだっていゝじゃないか、クラシが立たなくちゃアほかに仕方があるめえ、なんて、アン畜生め、いゝ年してパンスケ買いたいに違いないんだから。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "お尻をヒッパタかれたパンスケだと申しますから、あんなに可愛らしくッて、ウブらしいのに、金さえ出しゃ物になる女だな、とこう思いまして、取引してみたら、案の定でさア。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "お寺の裏のお尻をヒッパタかれたパンスケというのは、大工の娘で、ソノ子と云った。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつとはなく、パンスケをやるようになった。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして御近所の人たちはパンスケ、パンスケって、人の顔をジロジロ睨むんですから、こんな意地の悪い人たちのところへお嫁入りなんてできません」「それは、もっともだ。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの野郎、パンスケにふんだくられた三十万円の恨みが忘れかねているんですよ」「どれ、その歯を見せてごらん」　見ると、なるほど、茶色の模様のような筋がある。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私だってパンスケなんかして、生きていたくないわ。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "だけど、パンスケ以外に、生きる道がないわね。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは商売の都合で、野郎どもの面倒をみていますが、あなたは風流の志で、パンスケを養って、かしずかれていらッしゃる。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "汚いアパートに身を落して、パンスケにかしずかれて、結構ですねえ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この汚いパンスケ・アパートへお忍びぐらし、乙な人だなア」　エンゼルの視線は、喋りながらも、ルミ子から、はなれなかった。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、屋敷もちのエンゼルは、たかがパンスケ相手に手が後へまわるようなことはしっこない。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろんなことが、こんがらかるから」「フ、そんなパンスケがこのへんに居るッて話はきいたことがあったが、それがお前か」「強殺だの喧嘩傷害だの、すごい人が話きかせてくれるでしょう。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "邪教の一味は、小娘のパンスケまで、ミコだか狐つきだか分らないが、老成ぶって、得体が知れないのである。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンサーでも女給でもパンスケでもない。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「横須賀の保健所で、いっしょに通訳をしていたことがあるからよ……パンスケがむやみに殖えて始末がつかなくなったので、保健福祉局のウィルソンというのと三人で、『白百合』という、共済組合のようなものをつくってやったことがあるの」「それが、ぼくになんの関係がある？",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "……おせっかいの、パンスケ」　カオルは、愛一郎の手をとって、「まあ、おすわんなさいよ。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "お話ししましょう」「パンスケなんていわれて、腹をたてないのか」「あたし、パンスケよ。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三百五十万ドルという、遺産を身につけていることも知らずに、あんなかっこうでパンスケと相合傘で歩いているというんだ……これが、世の中というものですか」　しゃくったような言いかたが、癇にさわったらしい。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "御橋　闇取引の相談をして、それからケンカをして、それからパンスケ買つて……冗談ですがねそれは、フフ。",
              "citation": {
                "source": "夜の道づれ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
