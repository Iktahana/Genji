          "literary": [
            {
              "text": "パルドン、ムッシュウ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――パルドン（これは失礼）、あたし、マダム・ルイズ・クレパッツ……あなたは……？",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あいや、パルドン〔おゆるし下さい〕、とんだ御心配をかけまして！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "見に入ると、奥の椅子から、パルドンといって背の高いスイス人らしい若いひとが立ちあがった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "コン吉はたちまち上気し、鼻の頭に汗をかいてただ埓もなく、「パルドン、パルドン」の百｜万陀羅。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "合乗り乳母車　――仏蘭西縦断の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日朝の五時に、警官らは不意にパルドンという男の家へ踏み込んだことがある。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
