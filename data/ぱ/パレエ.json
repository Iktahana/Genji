        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "女はあたりを見廻して、食卓の向う側にすわりながら、「シャンブル・セパレエ」と笑談のような調子でいって、渡辺がどんな顔をするかと思うらしく、背伸びをしてのぞいてみた。",
              "citation": {
                "source": "普請中",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々二人はパレエ・ロアイアルの附近の長い、汚い町を、ぶら／＼歩いてゐた。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "角のパレエの大時鐘、七時を打つた――都の上に、金無垢の湖水と見える西の空、雲｜重つてどことなく、雷のけしきの東の空。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋のサロンがグラン・パレエに開かれて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
