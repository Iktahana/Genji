[
  {
    "uuid": "f83fae13-ba05-5fc9-a9e4-f63e3769ac28",
    "entry": "パクつく",
    "reading": {
      "primary": "パクつく",
      "alternatives": [
        "ぱくつく"
      ],
      "is_heteronym": false
    },
    "grammar": {
