        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "また一例を挙げると、三月十六日パレスタインで強風が砂塵を立てているに乗じてトルコの駱駝隊を襲撃し全滅させたという記事もある。",
              "citation": {
                "source": "戦争と気象学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八六四年版、ピエロッチの『パレスタイン風俗口碑記』に、アラブ人が馬を愛重する有様などを尤面白く書いた。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "どちらが本当か知らぬが、先はピエロッチが見たパレスタインのアラブ馬は、アラビア本土のアラブ馬と性も芸も多少｜差うと見える――アラブ人が好む騎戦戯にはその馬叫喚飛棒の間に馳せて進退最も見るべく、十分戦争を解するものに似たり。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月十五日パレスタインの状態　国際連合がパレスタインに二つの国家――ユダヤ国とアラブ国を作る決定してから、英帝国主義者はパレスティンにさわぎをおこしユダヤ人に対してアラビア人をけしかけ、植民地統治が必要であるということを示そうと努力した。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトレーとベヴィンの支配下のパレスタイン。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、日本の新聞までその写真をのせるパレスタインの「欺きの壁」とは一体何だろう？",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＡＮＮＯ――ＥＬＩＺＡＢＥＴＨＡＥ――ＡＮＮＯ――ＶＩＣＴＯＲＩＡＥ――　ロスチャイルドを親方にして民族国家をパレスタインに建設しようとする猶太「ジオニスト運動と英国の根本政策とは一致した」。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パレスタインに英国軍用機駐屯所を持つことは近東及印度に対していい押えだ。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パレスタインで農業をしていた先住アラビア人は多く土地を奪われた。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「パレスタイン労働組合は資本家と争うためではない。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてパレスタイン労働賃金は、　　　　　　不熱練　　　　　　　熱練　　　　　　志．片．　　　　　　志．片．猶太人　……４／２―５／２　　　６／３―８／４アラブ人……１／３―２／１　　　３／１　交通機関の血圧上昇がやや緩和された。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、英国人の｜公平な勝負という標語もボート・レースやポローの競技場埒外では、アフガニスタンやパレスタインまで出ると怪しいもんだという懐疑を公然抱いているのだ。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "独帝の漫遊以来パレスタインに於ける独逸人の活動著しく、到る処のホテルの如きも独逸人の経営に係るもの多し。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "パレスタイン六月の日は容赦なく頭上より照りつけ、古鞍に尻いたく、岩山の上り下り頗る困憊を極む。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "パレスタイン第一の橄欖林あり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "エルサレムよりサマリヤを経て一路エニンに到る迄、常に山上、または峡谷を過ぎて来り、エニンより一歩北すれば忽ち下ガリラヤの野、パレスタイン第一のエズレル平原、またの名エスドレロン平原に下りぬ。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "パレスタインに来りて今日初めて平野を見、黒土の土らしき土を見る。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
