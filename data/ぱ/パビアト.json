          "literary": [
            {
              "text": "しかしパビアトを打つと、とたんに苦痛がぴたりととまるんだね。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "パビアトの数量など、ごまかそうと思えばごまかせるんだ」「あれは気持のいいものかね」「いや。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "手っとり早い療法として、パビアトで鎮めている中に、中毒になってしまったんだ」　それから疫病もずいぶん出した。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドス作戦前後、城介がパビアトを時々使用していたことは知っている。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
