          "standard": [],
          "literary": [
            {
              "text": "年を取つた方は、参謀本部付のノビス工兵大佐で、その副官らしい青年将校は、ルナアト・パリヤアニと呼ぶ猟騎兵中尉です。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "奏楽（中欧作曲家の円舞曲）　ルナアト・パリヤアニ中尉は、その晩、自分の部屋に帰ると、早速、ブレンネル地方の軍用地図をひろげ、条約で仮に決定されたアルプスの分水線に赤い線を書き入れ、コンパスで、重要な地点間の距離を測り、明日の集合地たるメンデル・パスまでの自動車道を選びました。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに引かへて、伊太利代表ノビス大佐は、副官のパリヤアニ中尉を促して、早速、測量班の編成に取り掛らせます。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　副官のパリヤアニ中尉をつかまへて、こんな戯談を云ひました。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリヤアニ中尉は、そこで、運転手の溜場へ行き、「おい、車……。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉を寄せ、唇を固く結んだパリヤアニ中尉の顔でした。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "静粛な混乱の中で、ノビス大佐は、ベツドの上に運ばれ、エリザは、パリヤアニ中尉の部屋へ導かれました。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリヤアニ中尉は、ギクリとしました。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、パリヤアニ中尉は、いきなり椅子から起ち上りました。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "恰度、その時刻に、ブレンネル・ホテルの一室で、窓から空を眺めてゐたのは、パリヤアニ中尉です。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
