        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "と傍から、「わたしも上げる」とか言いながら、パアスを探すお嬢さんがいます。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロオズ・トツパアス、エメラルドなどが皮の袋の中からざらざらと音を立てて出されるのは、穀類の様な気持がする。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の駅駅に点る黄な灯の色をしたトツパアスもあつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ａが、買ったラール、アンティック、ドラパアス、その他の画を見せてあげるからおいで下さいと云ったのだ。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロオズ・トツパアス、エメラルドなどが皮の袋の中からざらざらと音を立てて出されるのは、穀類の樣な氣持がする。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の驛驛に點る黄な灯の色をしたトツパアスもあつた。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "繪畫の藝術にあつては、この點はパアスペクチウイヴによつて定めることが出來る。",
              "citation": {
                "source": "パスカルの言葉",
                "author": "パスカル",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
