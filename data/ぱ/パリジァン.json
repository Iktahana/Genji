          "literary": [
            {
              "text": "四　第一瞥（下）　カッフェ・パリジァンを引き上げたら、もう広い往来にも、人通りが稀になっていた。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "このカッフェはパリジァンなぞより、余程下等な所らしい。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっとパリジァンの意気な所があって、今日のチャプリンとはまた異った味いがあった。",
              "citation": {
                "source": "活動写真",
                "author": "淡島寒月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
