        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "四月二十九日（土曜）「アランディンａｎｄパロミダス」を読む。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "『アラディンとパロミダス』を御返ししメーテルリンクの批評を読んで来る。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この夏休みには「ペリアスとメリサンダ」と「アラディンとパロミダス」の比較をして見ようと思う。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "かえってから丸善に行って、『アンナ・カレニナ』、『生物学ト哲学ノ境』、『ペリアストメリサンダ』、『アラジィン、パロミダス』、『ベラミー』ヲ買ってくる。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月八日（土曜）「ペレアスとメリサンダ」を大抵読む、どうしても「アラディンとパロミダス」とは異って居る。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
