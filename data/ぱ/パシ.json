    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」そこで子分は突つぱしり　四方に氣をくばりめいめいのやつつける仕事を自覺した。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処の弁士の子供が幼稚園の同級にゐて、時々フイルムの切れつぱしを持つて来てみんなを羨しがらせた。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸田露伴にも『枕頭山水』の名作があり、キビキビした筆致で、自然でも、人間でも、片っぱしからきめつけるような犀利な文章を書いている。",
              "citation": {
                "source": "紀行文家の群れ",
                "author": "――田山花袋氏――",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は庭園で焚火をめらめらと燃やして、飛んで來るたくさんの蟲を網や箒で片つぱしからたたき落した。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえとわかれて、たちどころに私は、チョッキのボタンを全部、むしり取ってしまって、それから煙草の吸殻を、かたっぱしから、ぽんぽんコーヒー茶碗にほうりこんでやった。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、人のちからの佳い成果を見たくて、旅行以来一月間、私の持っている本を、片っぱしから読み直した。",
              "citation": {
                "source": "碧眼托鉢",
                "author": "――馬をさへ眺むる雪の朝かな――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを片つぱしから讀んでいつた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを片っぱしから読んでいった。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の能力を計らないで六かしい学問に志していっぱしの騎士になったつもりで武者修行に出かけて、そうしてつまらない問題ととっ組み合って怪物のつもりでただの羊を仕とめてみたり、風車に突きかかって空中に釣り上げられるような目に会ったことはなかったかどうか、そんなことを考えない訳にはゆかなかった。",
              "citation": {
                "source": "雑記帳より（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "市中の目ぼしい建物に片ッぱしから投げ込んであるくために必要な爆弾の数量や人手を考えてみたら、少なくも山の手の貧しい屋敷町の人々の軒並に破裂しでもするような過度の恐慌を惹き起さなくてもすむ事である。",
              "citation": {
                "source": "流言蜚語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ぱし大きさも大きいで、艪が上って、向うへ重くなりそうだに、はや他愛もねえ軽いのよ。",
              "citation": {
                "source": "海異記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "十年もむかしのことですが、この部屋へ来てみると、やっぱし昔のことが、いちいちはっきり思い出されます。",
              "citation": {
                "source": "新樹の言葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの腹掛のドンブリに、古風な財布をいれて、かう懐手して歩くと、いつぱしの、やくざに見えます。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "色白くふっくりふくれた丸ぽちゃの顔、おとがい二重、まつげ長くて、眠っているときの他には、いつもくるくるお道化ものらしく微笑んでいる真黒い目、眼鏡とってぱしぱし瞬きながら嗅ぐようにして雑誌を読んでいる顔、熊の子のように無心に見えて、愛くるしく思いました。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりかたっぱしから喧嘩して通るのである。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "あてにしていた夢が、かたっぱしから全部はずれて、大穴あけて、あの悽惨、焦躁、私はそれを知っている。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつぱし御坂は、いいよ。",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "動物学に於ける自分の造詣の浅薄さが、いかん無く暴露せられたという事が、いかにも心外でならなかったらしく、私がそれから一つきほど経って阿佐ヶ谷の先生のお宅へ立寄ってみたら、先生は已に一ぱしの動物学者になりすましていた。",
              "citation": {
                "source": "黄村先生言行録",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの腹掛のドンブリに、古風な財布をいれて、こう懐手して歩くと、いっぱしの、やくざに見えます。",
              "citation": {
                "source": "おしゃれ童子",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "村のひとたちの言うように、やっぱしただのなまけものじゃったわ。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「紅毛人は、やっぱし、教会だとか慈善だとか云ってけつかって、かげじゃなか／＼大きな商売をやっているね。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一円くれてやっても、やっぱし、シェシェでそこすんだりだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱし、ここにゃ、日本の軍隊がいないせいだな。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日、やっぱし日光丸で着いたんだな。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず、前線から手足まといとなってついてきた他の負傷者達も、そこで、急ぐ退却の犠牲となって、片ッぱしから生埋めにされてしまった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、ええ、やっぱし、（しがうまく云えなかった）郭店の方から、歩いてやって来たんだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺等も、やっぱし、これぐらいな六ツか七ツの時から、仕事をしろ、仕事をしろと、親爺に叱られて育ってきたものだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やっぱし俺は、お払い箱だ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こないだは箱根へとっぱしったが、今度は奥州｜仙台石巻とでもしゃれるんですかい」「両国の新花屋だよ」「新花屋！",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京を遠く離れて、青い海の上をつっぱしっていると、色々に交渉のあった男や女の顔が、一ツ一ツ白い雲の間からもやもやと覗いて来るようだ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
