        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の書いた論文に、他の研究者のパクリが見つかり問題になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "そのデザインは、有名ブランドのパクリだとSNSで炎上した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "音楽業界では、楽曲のパクリ疑惑が時折浮上する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
