        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自分はアンナ・パヴローヴァの踊りを見たのちにも、粂八の鷺娘の印象が決して自分の心に薄らがないのを感ずる。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "注二　ロシア舞踊の問題に関連せるものとしてアンナ・パヴローヴァの舞踊の印象記を左に付加する。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（三七二ページ参照）　アンナ・パヴローヴァの踊りを日本で見ることができるとは、不思議なまわりあわせである。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パヴローヴァは遠いあこがれの一つであった。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでこのパヴローヴァの踊りを見て、また思いがけぬ気持ちに出逢った。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この前来たスミルノーヴァは確かにパヴローヴァよりも拙かった。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしパヴローヴァを見た後にもスミルノーヴァの印象は依然として薄らがない。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに今度は、スミルノーヴァよりもはるかに優れた、別種の芸術を見るつもりでパヴローヴァに対し、そうして案外にも同種の芸術を見いだしたのであった。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々はパヴローヴァ個人の芸と、彼女の踊る舞踊の様式とを、別々に考えなくてはならない。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パヴローヴァは巧妙である。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パヴローヴァの『白鳥』は直線的な下半身と柔軟に曲がる上半身との不思議に美しい舞踊であった。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒々しい『バッカナール』においてパヴローヴァは、我々東洋人の渇望する自然力の全解放を踊った。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分としてはこの最後の踊りに最も深い恍惚を感じた、パヴローヴァとしては特に得意とするところではないであろうが。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしパヴローヴァが、あの休止せる美しい型から次の美しい型へと飛ぶような踊りを得意とするならば、自分は彼女のために取らない。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パヴローヴァの芸は見るたびごとに味の深まって行くのを感じさせたが、しかし結局最初の印象の通りに、舞踊小品と呼ばれるものがこの芸術の本質を示したものであることを知った。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は最初パヴローヴァの『バッカナール』を見て、深い恍惚を感じた。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああいう緊張した、一ぶの隙もない踊りが、あれほど渾然と踊れるということは、パヴローヴァの技がいかに驚嘆すべきものであるかの明白な証拠だと思う。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉体の隅々までも精神に充たされているようなあのパヴローヴァの肉体をもってでなければ、ああいう芸術は造れない。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パヴローヴァの姿態の特徴を十分活用させた意味で、やはり最も優れたものの一つに数えてよかろうと思う。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
