        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "誰もが彼のことをパニオロと呼んでいる。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パニオロとは、ハワイ語でカウボーイのことだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "このあたりでパニオロといえば、サンフォード・カマカニのことだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カウボーイであると同時に、パニオロはミュージシャンでもある。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パニオロの家のテラスで、パニオロや息子たち、そして近くに住むミュージシャンの友人たちが、今夜も音楽を作っている。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パニオロたちの音楽が、夜の風のなかにふっと聞こえる瞬間を言葉で説明するのは、とても難しい。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分たちの音楽を、パニオロたちは、自分たちの島に対する永遠に変わらないラヴ・ソングだ、と言っている。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "道の行きどまりにパニオロの家があった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともと樹が多いところへ、ハワイにある植物の全種類をパニオロが家のまわりに植えたから、うっそうたる熱帯樹林のなかに埋まるようにして、パニオロの家は建っている。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "宣教師の子孫が事情あってアメリカ本土に帰ることになったとき、送別パーティで聴いたパニオロの音楽に感激し、彼にこの家を進呈した。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パニオロの家の、賢い飼犬だ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パニオロといつもの常連たちが全員、テラスにいた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しはずれて、パニオロの奥さん、マティルダが、巨体を椅子に預け、音楽に聴き入っていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンフォード・パニオロ・カマカニの右側には、彼の古くからの友人がふたりいた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼もフォンとおなじく、パニオロの幼な友だちだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダナの隣に、パニオロのひとり娘、セシリア。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "西海岸で仕事をしていたとき、僕たちのボスであるチャンピオン・サーファー、ラリー・デイヴィスと知り合い、パニオロたちの音楽をテープで聞かされて感激した彼は、いまこうしてパニオロの前で仲間に加わり、十二弦ギターを遠慮がちに弾いている。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パニオロとその音楽仲間に自分も加わったかたちで、現代のハワイ音楽を現地録音しようというのだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "先にひとりで来たラインハートは、夜になると毎日、パニオロたちと合奏しては、彼らの音楽に溶けこむ努力を重ねてきた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてパニオロたちは彼を非常に気に入っている。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "音楽を作り出すとき、パニオロたちにはリーダーというものが存在しなくなる。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パニオロのスティール・ギターは神業のようだった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダンがいるといいんだがなあ」　パニオロが言った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンもパニオロやマーカスたちの幼な友だちで、音楽仲間でもある。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンに訊けば、なんの音だかすぐわかるのに」「こんど訊いてみよう」　パニオロの息子たちが演奏を始めた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中からパニオロがスティール・ギターで入って来た。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パニオロ宛てに届いている郵便物を、僕は箱から出した。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
