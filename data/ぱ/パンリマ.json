          "literary": [
            {
              "text": "かれ等は死んでから裏の火の山へ、『勇士の神』パンリマとして祭られることが望だ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "この勇敢な土人たちに、『生きたパンリマ』（勇士）として、あがめられている一人の日本人がある。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きたパンリマ（勇士）が、わしらの生命が欲しいとおっしゃるんだ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            }
          ]
