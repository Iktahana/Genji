        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ドイツ書の装幀なり印刷なりにはドイツ人のあらゆる歴史と切り離す事のできないものがあると同様にフランスの本にはどうしてもパリジアンとパリジェンヌのにおいが浮動している。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、まだパリジアンの香水愛好の高さには及ばないだらう。",
              "citation": {
                "source": "「香水の表情」に就いて",
                "author": "――漫談的無駄話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつものパリジアン・パリジエンヌの明るい朗らかな表惰ではない。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリジアンらしく眼のふちをぼかした女を抱くようにして、大それた、羚羊の角など飾りに付けた杖を得意げに振りながら、クールサールをうろついて、大通りで宝石――輸入品の――を冷やかして、べちゃくちゃ云いながら日を暮してしまう。",
              "citation": {
                "source": "続スウィス日記（千九百二十三年稿）",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
