        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "我等はロツカ・デル・パアパに住める正直なる百姓仲間なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず舞台一面を本物の竹藪にして、虎狩の唐人どもがチャルメラや、銅鑼や鉦を持って出て、何かチイチイパアパア騒ぎ立てて藪の蔭へはいると、そこへ虎の子を曳いて出る。",
              "citation": {
                "source": "虎",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "台詞廻しにも締りが無くて、いたずらにパアパア言うばかりで、家橘の鳩ポッポ、芝翫のパアパア、これらは悪い台詞まわしの見本のように言われていた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも家橘の台詞には一種の強い底力があったが、芝翫のは唯パアパア散るばかりで一向に捉えどころがなかった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "チイチイパアパアが幼稚園の先生ぐれえの事しか知らねえ江戸ッ子一流の世間見ずでゲス。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "パアパアパアパアパアパア――。",
              "citation": {
                "source": "ナンセンス",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに花嫁御の分は亦、並外れて小さいけに取り換えてもアパアパどころじゃない。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "テテツクス・蝉、コモイダス・喜劇役者、カタ・コマス、村から村へ……か、コマゼイン――飲んで騒ぐ……でしたね、それから雲の上――パアパア……何でしたかしら？",
              "citation": {
                "source": "歌へる日まで",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ね、何うしても思ひ出せない、パアパア――何でしたかね？",
              "citation": {
                "source": "歌へる日まで",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "パアパアネフエラスだよ。",
              "citation": {
                "source": "歌へる日まで",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ庭先の鶏舎の朝鮮人の長屋で子供がヤーヤーヤーとないていて、母親が、パアパア何とかとこわいような優しいような声を出して薪をわっています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで大の男がまたチイチイ、パアパアいう。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "パアパアと人に呉れてやったりしたら、ダメだよ。",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
