        "動詞-サ変"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "with a snap",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "壊れかけた古い枝が、パタンと音を立てて折れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は驚いた顔をして、持っていた本をテーブルにパタンと置いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "マグネット式の蓋が、カチッというよりはパタンと閉まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "あとで扉はパタンパタンと数回の振動をしなければすぐには静止の位置に落着かないのであった。",
              "citation": {
                "source": "チューインガム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "入り口をパタンとしめるようなそんなことをするもんかね。",
              "citation": {
                "source": "ツェねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」カイロ団長は何だか変な顔をして口をパタンと閉じました。",
              "citation": {
                "source": "カイロ団長",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "餘の事と學生は振返ツた……其の鼻ツ頭へ、風を煽ツて、扉がパタンと閉る……響は高く其處らへ響渡ツた。",
              "citation": {
                "source": "解剖室",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのいやらしい小おにのしたことか、それとも、すきま風のしたことか、それはわかりませんが、きゅうに窓がパタンとあいて、兵隊さんは、四階から下の道へ、まっさかさまに落ちていったのです。",
              "citation": {
                "source": "すずの兵隊さん",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「開き戸のパタンパタン煽るのを止める、こんなふうな金具はありませんか。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜、電車通を横切らうとすると、何かに躓いて僕はパタンと前へ倒された。",
              "citation": {
                "source": "長崎の鐘",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、清二はすぐにパタンとその本を閉じてしまった。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはパタンと倒れそうになる。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "またパタンと倒れそうになる。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然、パタンとわたしは倒れた。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだのに何かパタンとわたしのなかに滑り墜ちるものがある。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "息子がそいつをパタンと地上に叩きつける姿が見たかったのだ。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、清二はすぐにパタンとその本を閉ぢてしまつた。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホームの雑沓の中に立つてゐると、もう少しで今にもパタンと倒れさうな気がする。",
              "citation": {
                "source": "飢ゑ",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはパタンと倒れさうになる。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "またパタンと倒れさうになる。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "息子がそいつをパタンと地上に叩きつける姿が見たかつたのだ。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は教壇の椅子に腰を下ろして、出席簿を机の上におく、パタンとそれをひらく。",
              "citation": {
                "source": "魔のひととき",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "キーツと止ると、パタンと扉を押す音、自動車の客席は、白い強い明りに、パツと切ツ削いだやうに一部面を見せる。",
              "citation": {
                "source": "夏の夜",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……それは……ドンナ手順……」「それはここに在ります書類を御覧になれば、お解かりになります」　と云ううちに若林博士は、今まで話片手に眼を通していた書類の綴込みをパタンと閉じて、恭しく私の前に押し進めた。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると頭の上の葉の蔭で、土蔵の窓の銅張りの扉がパタンと閉まる音が致しましたから、又ギックリして振り返りますと、今度は土蔵の戸前にガッキリと鍵をかけた音が致しまして、間もなく左手に、巻物をシッカリと掴んだお八代さんが裸足のまま髪を振り乱して離家の方へ走って行きました。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "女たちのクスクス笑う声を夢うつつに聞いている中に自動車がピッタリと止まったので、吾輩は慌てて女たちの膝を跨いで一番先に飛降りて扉をパタンと締めた。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのまま火の出るような眼付きで一同を見まわしていたが、突然にクルリと身を飜すと、入口の扉をパタンと閉めて飛び出して行った。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、若い二人の男はトランクを開けて中を検べるとそれをパタンとフタしてわきへどけ、封印なんかしない。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうやら碑銘を読んでくれる、死人の名が判ったような気がしてきたよ」　と云うと、検事はその頁をパタンと閉じて、嘆息した。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "suddenly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "騒がしかった子供たちが、突然の先生の声にパタンと静かになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "計画は順調に進んでいたが、予期せぬ問題でパタンと止まってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "映画のクライマックスで、突然画面が暗転し、パタンと終わってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
    ],
