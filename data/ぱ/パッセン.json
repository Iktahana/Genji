        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "印度の何とか称する貴族で、デッキパッセンジャーとして、アメリカに哲学を研究に行くと云う、青年に貰った、ゴンドラの形と金色を持った、私の足に合わない靴。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッセン大街道も今日はいきものの影さへないぞ。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッセン大街道も今日はしんとしてるよ。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッセン大街道も今日はいきものの影さえないぞ。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、四等ともいうべきデッキパッセンジャーに印度人五六十名がいる。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "デッキパッセンジャーの印度人たちは、美しい衣を着替えて嬉しそうだ。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その多くはデッキ・パッセンジャーなり。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう、コロンボからこつちへ参りますと、デッキ・パッセンヂァーは一人もをらず、下甲板は、宵の口以外、だれも出てはをりません。",
              "citation": {
                "source": "緑の星",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼近くになってサイドカーをひっぱり出してきたロードレース・クラブの連中は、乗りたがるミーヨに、ショート・コースを使ってパッセンジャーのやりかたを教えはじめた。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
