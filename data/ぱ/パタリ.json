        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "突然の雨に、人々は傘を差す間もなく、パタリと立ち止まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の熱弁は、予期せぬ質問を受けて、パタリと途切れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "渋滞がひどく、車がパタリと動かなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
