[
  {
    "uuid": "2758331f-d9f4-5d14-9ce6-96e0c139f50f",
    "entry": "パタパタ",
    "reading": {
      "primary": "パタパタ",
      "alternatives": [
        "ぱたぱた"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "副詞-と",
