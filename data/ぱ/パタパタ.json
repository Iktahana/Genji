        "名詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "flapping (of a flag, fan, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "風で洗濯物がパタパタと音を立てていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供たちの元気な足音が、廊下をパタパタと響かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「このパソコン、起動が速いから作業がパタパタ進むよ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "」　パタパタパタと眠さうな足音が隣の間でして、障子が開くと、そこに突つ立つて耕二が欠伸一つした。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間も、いかにも大烏を馬鹿にする様に、毒の鉤のついた尾をそちらにパタパタ動かすのです。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとシュエスターが立って行って、頭をパタパタとたたいて向こうむきにすわらせる。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネネムのすぐ前に三本の竿が立ってその上に細長い紐のようなぼろ切れが沢山結び付けられ、風にパタパタパタパタ鳴っていました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お姫さまの白いがいとうは、風に吹かれて、大きな船の帆のように、空にパタパタひるがえりました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イイエ……よく聞いて御覧……ホーラ……ネ……バカタレーッ……バカタレーッ……てね……ね……ホッホッホッホッ」　この笑い声を聞くと赤い鳥は、一寸頭を傾けているようであったが、忽ち思い出したようにパタパタと羽ばたきをした。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "パタパタパタパタ、カアの足音には、特徴がある。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "目に見えるほどの塵一本見のがさず、坐っている客を追いたてて坐蒲団をパタパタはたいたり、そこらじゅう拭きまわったり、ただの綺麗好きとは見えなかった。",
              "citation": {
                "source": "螢",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにまた、碧い包装紙を拡げ、検査された完全紙の層を、としりとしとしと載せ、重ねて、揃えて、整えて、またパタパタと四方から包み、サッサッと糊刷毛で掃き、レッテルを貼り、押し、叩き、次の荷造場へ送る中年おんなの活躍もさることだが、彼女らもまた同じ種の高麗鼠である譏りは徹頭徹尾｜免れない。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に包装され、レッテルを貼られた紙の数連が送られて載る、パタパタパタ、トントンと四方に板を当てる、蓋をする。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "パタパタ、トントン、すうっ、ガラガラガラガラである。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "活惚、活惚……　三味線がハタと止む……　と、くるくると転がつてゐる俺自身が俺にももう恐ろしくて恐ろしくてたまらなくなつた、思はず投げつけられた盗賊猫のやうにぽんと起き直るとその儘パタパタと二階に駈け上つた。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "団扇でパタパタそこらをあおった。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "生き返って台所の窓からパタパタと飛んでいったのか？",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのまま深谷のスリッパがパタパタとドアのほうに動いた。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼんやりそれを眺めてゐると、忽ち花片の渦が一団の胡蝶になつて見霞む野原の奥へ消え去つたり、さうかと思ふと矢庭に眼近かに吹き寄せて、私の鈍重な眼蓋をパタパタと叩きながら見る／＼うちに私のふところを眼がけて、こんこんと降り積つて来た。",
              "citation": {
                "source": "熱い風",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と云つても道子の眼は先のものにばかり輝いてゐるらしく彼の言葉で更に新しい緊張を感じた如くソワソワとして、「さうさう、でもちよいと寄つて見ませう、何かまた……」と、その日銀座に来た目的を決して忘れず、パタパタと草履の音をたてて駆け込むだ。",
              "citation": {
                "source": "凸面鏡",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "みつ子は急に嬉しくなつて、パタパタと足音をたてゝ、母のあとから廊下を駆けて行つた。",
              "citation": {
                "source": "香水の虹",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼんやり致してふるえおるその者共、早う眠らせい」　自らもさッと躍り入ると、パタパタと三人を峰打ち。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "何んしろ見込のある場所を手に入れたくて、手に入れたくてパタパタしてるんだそうだからな、そいつ等は。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "扇の音がパタパタとそこにも、ここにも聞こえる。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、パタパタと足音がした。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの二本の巻軸へな、数行の隠語が現われましてござるよ」持っていた扇をサラサラとひらくと、パタパタと胸をあおぎ出した。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "pitter-patter (of footsteps)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "赤ちゃんの小さな足が、床の上をパタパタと歩くのが可愛らしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "早朝、誰かの足音がパタパタと聞こえてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「雨粒が窓をパタパタと叩く音が心地いいね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "quickly (making progress)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は新しい仕事にすぐに慣れ、パタパタと成果を上げている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この資料、急ぎでまとめて。パタパタでいいから！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "指示されたタスクを、パタパタと片付けていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 4,
        "gloss": "Koopa Paratroopa (enemy in Mario games)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "マリオカートで、空を飛ぶパタパタに注意しながら走った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "スーパーマリオブラザーズで、パタパタを踏みつけて倒すのが楽しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あのステージ、パタパタがたくさん出てきて難しかったんだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
