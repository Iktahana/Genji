          "literary": [
            {
              "text": "白いのは天井裏のパンカアと、海月色に光る切子硝子のシャンデリヤだけだった。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハラムは平生のようにパンカアを引き動かして、妾の身体を乾かしてくれる事もしなかった。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、まるで方面は違うが、一寸物ずきで、パンカアスト夫人の自伝をのぞいた。",
              "citation": {
                "source": "新緑",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
