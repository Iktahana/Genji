  {
    "uuid": "5a33a4f3-71b0-5291-8165-fb99da0046ee",
    "entry": "ぱしゃ",
    "reading": {
      "primary": "ぱしゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その鯉が五分に一度ぐらいは必ず高い音を立ててぱしゃりと水を打つ。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの快活な笑い声へ、ぱしゃッと水を浴せるように、いま結婚の話を持ち出すことを考えると、矢代は二階から降りて行くのもまた怯むのだった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月――日　柱時計を捲く音、ぱしゃッと水音がする。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱしゃりと雪水にうたれて彼は目をさます。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれそのうち、鼻の穴と口とに海水がぱしゃぱしゃあたるようになるだろう。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "舷から、波がしきりにぱしゃんぱしゃんと、しぶきをあげてとびこむ。",
              "citation": {
                "source": "幽霊船の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だって　めのまえで　おおつぶの　あめが　いけに　ぱしゃぱしゃ　ふっているんですから　――「みみずでも　つかまえて、　つりにでも　でかけて、　ばんごはんに　もろこでも　１さらぶん　とるか。",
              "citation": {
                "source": "つりびとジェレミーさんのはなし",
                "author": "THE TALE OF MR. JEREMY FISHER",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ぱしゃッ　水けむりの中に丹波は坐った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「みんな時々失敗しますよ」　男爵が試し刷りを拳でぱしゃと叩いた。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
