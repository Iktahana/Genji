          "literary": [
            {
              "text": "四時半、石田・大庭を連れて新宿中村屋で夕食、ボルシチとパステーチェン、プディング。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "中村屋へ寄り、ボルシチとパステーチェンを食って、紀伊国屋で夢声の「夢諦軒随筆」と木村錦花の「三角の雪」を買ひ、座へ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "アパートの一室で一時間程眠ると、新宿迄行く、中村屋でボルシチとパステーチェン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝで夕食する、ボルシチとパステーチェン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
