          "literary": [
            {
              "text": "と決した栄三郎、ぶつかった鈴川方の一人をパッサリ！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッサリと道土をなでる乱髪の下から、貧乏徳利の枕をのぞかせて……。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、そうだそうだ、お前は腕が利いているから、おいらを、ここで、パッサリとやってくんねえか」　米友は、杖も信玄袋も投げ捨てて、和佐見ヶ原の真中に神将立ちに突立って、喚き出しました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまにもあれ、雨戸をけやぶって老母がおどりだしてきたら、抜き討ちにパッサリと斬りつけんばかりの身がまえです。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
