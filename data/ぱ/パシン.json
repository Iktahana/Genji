          "literary": [
            {
              "text": "」　博士は、目を丸くして、両手を意味なく、ぱしんぱしんと叩いた。",
              "citation": {
                "source": "人造人間戦車の機密",
                "author": "――金博士シリーズ・２――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをみるや、兵曹長は栄螺のような拳固をかためて、手もとに近い敵から、その頬ぺたを、ぱしんぱしんとなぐりつけました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その小手をパシンと斬つた。",
              "citation": {
                "source": "剣術の極意を語る",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "（と、いきなりパシンと壮六の顔をなぐつた音）おしん　あれ、誰か来てえっ！",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
