          "literary": [
            {
              "text": "」「肉がほんとに高いじゃないか、パタゴンさん。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　前にパタゴンさんと言われてそれに答えた女は、いやらしく両手をぱたりとたたいた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはパタゴン婆さんで、彼を追っかけてき、遠くから拳をつき出して見せながら、叫んでるのだった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
