[
  {
    "uuid": "ddebf0d1-7e61-5b09-8a35-558d4788df4e",
    "entry": "パリ祭",
    "reading": {
      "primary": "パリさい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
