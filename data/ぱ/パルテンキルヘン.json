        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ガルミッシ、パルテンキルヘンを過ぎ、ミッテンワルドの国境に近づくに従って、自然の変化と美しさも絶頂に達する。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "登山靴――これはツーグスピッツェの麓なるパルテンキルヘンで買った本場物には相違ないが、酒盃片手に泥靴を撫で廻すことは出来まい。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガーミッシュパルテンキルヘンでは林檎の花盛り。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、私はパルテンキルヘンの靴屋がつくった丈夫な半靴を一足買い、山麓を歩き廻ったからである。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "場所は目的の山、ツーグスピッツェを一目に見るパルテンキルヘン。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "八　山の麓のパルテンキルヘン――「バヴァリアとビヤ」と私は考えながらいった。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月、私はたった一人でパルテンキルヘンを訪れた。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
