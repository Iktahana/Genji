        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "湯槽にからだを沈ませて、ぱちゃぱちゃと湯をはねかえらせて見ても、私の部屋の畳のうえで、ごろごろと寝がえりを打って見ても、私はやはり苦しかった。",
              "citation": {
                "source": "断崖の錯覚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから洋傘直しは缶の水をぱちゃぱちゃこぼしながら戻って来ます。",
              "citation": {
                "source": "チュウリップの幻術",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はその香水を、頭へぱちゃぱちゃ振りかけました。",
              "citation": {
                "source": "注文の多い料理店",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "風野又三郎だって、もうガラスのマントをひらひらさせ大よろこびで髪をぱちゃぱちゃやりながら野はらを飛んであるきながら春が来た、春が来たをうたっているよ。",
              "citation": {
                "source": "イーハトーボ農学校の春",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その気の毒なそらか、すきとほる風か、それともうしろの畑のへりに立って、玉蜀黍のやうな赤髪を、ぱちゃぱちゃした小さなはだしの子どもか誰か、とにかく斯う歌ってゐます。",
              "citation": {
                "source": "葡萄水",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢代はぱちゃぱちゃと湯を浴び頭をシャワの水で冷やして、おもむろに来るべきものを待つ気持ちに立ち還った。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の時からよく川遊びや海遊びはやったが、ぱちゃぱちゃ騒ぎ廻るほかにまるで泳げなかった僕は、実に閉口した。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝ぼけ眼の炊事女が、はだしで水たまりをぱちゃぱちゃいわせながら、木戸をあけに駈けだした。",
              "citation": {
                "source": "可愛い女",
                "author": "DUSHECHKA",
                "note": "青空文庫"
              }
            },
            {
              "text": "パチャパチャパチャパチャ。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "パチャパチャパチヤパチャ。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "耕平は、さっき頬っぺたの光るくらゐご飯を沢山喰べましたので、まったく嬉しがって赤くなって、ふうふう息をつきながら、大きな木鉢へ葡萄のつぶをパチャパチャむしってゐます。",
              "citation": {
                "source": "葡萄水",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "５　爬虫館の鴨田研究室の裡へツカツカと入って行った帆村探偵は、そこに鴨田氏が背後向きになり、ビーカーに入った茶褐色の液体をパチャパチャ掻き廻しているのを発見した。",
              "citation": {
                "source": "爬虫館事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "パチャパチャと酒のしぶきが飛び散った。",
              "citation": {
                "source": "踊る一寸法師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
