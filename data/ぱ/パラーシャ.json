          "literary": [
            {
              "text": "パラーシャは、きっと副知事の奥さまですよって言うんでしょう。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどそこへ、パラーシャという目の黒い娘が小間使の中におったのです。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、ある時食事のあとでアヴドーチャ・ロマーノヴナは、わたしが庭の並木路に一人でいるところをわざわざ捜し出して、目に涙を光らしながら、可哀想なパラーシャを苛めないでくれと要求されたんです。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "パラーシャがまた舞台へ現われた、それも一人きりじゃないんです――手っとり早く言えば、すっかり乱脈が始まったんですよ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
