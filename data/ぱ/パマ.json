        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だが流通大手のシアーズローバックが展開しはじめたシアーズビジネスセンターは、従来のパパママストアー的なショップとははっきりと一線を画し、ＩＢＭ ＰＣやＵＮＩＸの載ったマシンを並べて明確にビジネスを志向していた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "パパママ論で、男を挙げた松田文相は、モダーン生活や小市民生活に対しては極めて同情能力の乏しい人のようであるが、丁度×××や×××型の「豪傑」が常にセンチメンタルであるように、涙脆いという意味では、仲々同情に富んでいる人のようである。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "君がこれから余は恋をするであらうと言つてパパママに宣言したといふ対象は？",
              "citation": {
                "source": "破門",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局パパママというのを採用することにしたが、これはよその国の言葉だから、全然実感がなくてよい。",
              "citation": {
                "source": "砂をかむ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "奴も自信がなくなってしまって、私をママとよんで様子を見たり、パパとよんで、すぐママと云い直してみたりのあげく、ちかごろでは私と女房のどちらに話しかけるにもパパママと二ツつづけて云うようになった。",
              "citation": {
                "source": "砂をかむ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も女房もパパママである。",
              "citation": {
                "source": "砂をかむ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "すこし伸び過ぎたパマの髪を耳のうしろからリボンで結び、額の上にも髪を下げて口紅思ふさま濃く、眉をかいた厚化粧、鳥渡見には二十前後にも見られる明い円顔。",
              "citation": {
                "source": "来訪者",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「音響特性がものすごくいいんだそうだ」「特別注文してスタジオをつくっても、こうはいかないよ」　録音のいっさいに関する最高責任者、グレン・ペパマンがそう言った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラリーのうしろに、雇われた喧嘩屋のような雰囲気を濃厚にただよわせたグレン・ペパマンが、立った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "グレン・ペパマンは局地ゲリラ戦の指揮をとる、冷徹な傭兵の雰囲気をますます濃くしていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "グレン・ペパマンと録音スタッフは、テープを持って先に帰った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パパマンの同じ曲の口上入のレコード（ビクターＪＦ一七）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
