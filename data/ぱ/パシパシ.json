        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は指をぱしぱしと鳴らして、注意を促した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "乾燥した葉っぱが風に吹かれてぱしぱしと音を立てる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "濡れたタオルをぱしぱしと振り回して水気を切った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "色白くふっくりふくれた丸ぽちゃの顔、おとがい二重、まつげ長くて、眠っているときの他には、いつもくるくるお道化ものらしく微笑んでいる真黒い目、眼鏡とってぱしぱし瞬きながら嗅ぐようにして雑誌を読んでいる顔、熊の子のように無心に見えて、愛くるしく思いました。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　眼をぱしぱしで仰向いた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「元氣さうだなア、僕は一週間ほど前に戻つて來たンですよ」工藤は癖でする、眼をぱしぱしとまばたきさせながら、もんの肩を抱くやうにして歩いた。",
              "citation": {
                "source": "秋果",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "目を、ぱしぱしとまたたくと、丸窓の外に、黒い太平洋は、あいかわらず、どっどっと左へ流れていた。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しぱしぱして永くものを見て居られない。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして眼をパシパシとやつてうつむいた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "法事の帰りか何かで、大きい扇子をパシパシいはせながら、威張つて歩いてゐた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔中略〕　チリヨケ目がねで大分注意いたしましたがきょうは目がすこしパシパシ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼をパシパシさせて青年を見る）ほっ！",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサは面喰つて言葉も出ず、眼をパシパシさせてゐる。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まぶしそうに目をパシパシさせる。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "逃げようと思ったんだろう」　何か固いものが肉体にパシパシと当る音がした。",
              "citation": {
                "source": "日の果て",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
