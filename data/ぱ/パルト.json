        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こなた一帶は佛蘭西軍の砲兵陣地、あれなる小高き丘に立てる馬上の人は、これぞ即ち蓋世の英雄ナポレオン・ボナパルト。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは英介氏のむかし馴染みの女友だちがたずねてやってきて、英介氏を郊外の酒場へさそったり、彼女たちのアパルトマンでポーカーを一晩中やったり、英介氏にタキシードを着せてテッフィン（レストラン）に連れだしたりしたからだ。",
              "citation": {
                "source": "職業婦人気質",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "家庭旅宿の留学生臭い生活を離れて格安ホテルに暫らく自由を味ってみたり、エッフェル塔の影が屋根に落ちる静かなアパルトマンに、女中を一人使った手堅い世帯持ちの真似をしてみたり、新吉は巴里を横からも縦からも噛みはじめた。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また高いアパルトマンの間の谷底のような狭い露路について忍び込んで来て、其処をわずかにのぞく空の雲行を眺めながらも唄う。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾つものアパルトマンの窓から、女や男や子供がのぞく、覗かないで窓の中でしんと仕事をしながら聴いていて手だけ窓から出し、小銭を投げてやる者もある。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "四年前の戦に甲も棄て、鎧も脱いで丸裸になって城壁の裏に仕掛けたる、カタパルトを彎いた事がある。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その腹の減つた一人こそ誰あらう、後には仏蘭西皇帝にまでなつたナポレオン・ボナパルトであつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "朱雲の手紙に「獨眼龍ダヨ」と頭註がついてあつたが、自分はたゞ單に、ヲートルローの大戰で誤つて一眼を失つたのだらう位に考へて、敢て其爲めに千古の眞骨頭ナポレオン・ボナパルトの颯爽たる威風が、一毫たりとも損ぜられたものとは信じなんだのである。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "朱雲の手紙に「独眼竜ダヨ」と頭註がついてあつたが、自分はたゞ単に、ヲートルローの大戦で誤つて一眼を失つたのだらう位に考へて、敢て其為めに千古の真骨頭ナポレオン・ボナパルトの颯爽たる威風が、一毫たりとも損ぜられたものとは信じなんだのである。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "忌々しいボナパルトめ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「Trichophycia, Eczema, Marginatum.」　彼は頭を傾け変えるとボナパルトに云った。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、最後にのた打ちながら征服しなければならなかったものは、ナポレオン・ボナパルトであった。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「余はナポレオン・ボナパルトだ。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は何者をも恐れぬぞ、余はナポレオン・ボナパルトだ」　こうしてボナパルトの知られざる夜はいつも長く明けていった。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、新しきナポレオン・ボナパルトは、またこの古い宮殿の寝室の中で、彼の厖大な田虫の輪郭と格闘を続けなければならなかった。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし出来得ることであるならば、彼はこのとき、フランス皇帝ナポレオン・ボナパルトの荘厳な肉体の価値のために、彼の伊太利と腹の田虫とを交換したかも知れなかった。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "余はナポレオン・ボナパルトだ」　彼は足に纏わる絹の夜具を蹴りつけた。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイザは呆然として、皇帝ナポレオン・ボナパルトが射られた獣のように倒れている姿を眺めていた。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「陛下、いかがなさいました」　ボナパルトは自分の傍に蹲み込む妃の体温を身に感じた。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナポレオン・ボナパルトのこの大遠征の規模作戦の雄大さは、彼の全生涯を通じて最も荘厳華麗を極めていた。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この古今｜未曾有の荘厳な大歓迎は、それは丁度、コルシカの平民ナポレオン・ボナパルトの腹の田虫を見た一少女、ハプスブルグの娘、ルイザのその両眼を眩惑せしめんとしている必死の戯れのようであった。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
