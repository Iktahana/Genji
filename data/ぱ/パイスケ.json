        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "店の向って右手に、石で袖をした中に大きな水桶があって、貧乏徳久利が洗ってあり、正面に盛切りの台が拭きこんであって、真白な塩がパイスケに山盛りになって、二ツ三ツの酒樽と横に角樽が飾ってある店だ。",
              "citation": {
                "source": "西洋の唐茄子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしご主人、君もつい十何年かまえは、港橋で真っ黒なパイスケを担いでいた石炭担ぎじゃなかったの」「失敬なことを言うな。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂利場使いのパイスケ二百本｜串が一人前の仕事。",
              "citation": {
                "source": "醤油仏",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにパイスケの縄をこう詰めてしまうから余計に足の調子が取れやしねえ、どれ、直してやるから持っておいで」　と、自分の天秤を肩から投げた。",
              "citation": {
                "source": "醤油仏",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
