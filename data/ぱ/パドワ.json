          "literary": [
            {
              "text": "わたくしは昔、復活祭のころ、イタリア、パドワの古い宿舎にとまって、ステンドグラスの窓をあけたら、梨の花が夜目にもほの白かったことを思い出す。",
              "citation": {
                "source": "山の春",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「町ふるきパドワに入れば梨の花」。",
              "citation": {
                "source": "山の春",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時、朝はやくヴエネチアを立つてパドワに来た。",
              "citation": {
                "source": "接吻",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
