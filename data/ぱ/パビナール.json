        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "主効、慢性｜阿片、モルヒネ、パビナール、パントポン、ナルコポン、スコポラミン、コカイン、ヘロイン、パンオピン、アダリン等中毒。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「パビナールアトロピンを略して、そう言ってたもんです」「パビナールと言うと――」　栄介は海面を眺めながら、やがて言った。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "パビナールもモルヒネも」　加納は針にゴカイをつけた。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうして城介はパビナール中毒になったんだろう？",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「治療としてはアドレナリンの皮下注射、エフェドリンの内服ぐらいなもんですな」「パビナールは？",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしゃ彼が小さな会社にでも勤めていたのかと思っていた」「その地図と名前を書いた時、城介はもうパビナールを使用――」「多分そうだと思うな」　加納は道具をしまいながら答えた。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "切り取る前後の苦痛には、パビナールなどが使用されるのだ。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「城介君はきっとこのオルドス作戦で、パビナールの常用者になったと、わたしはにらんでるがね」　加納は説明した。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとパビナールと、関係があるのかどうか知らないけれどね」　その翌々日、開設要員二百名は、汽車に乗って南下した。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "香港を出発する時、野戦病院の医療品の中から、パビナールが相当量紛失するという事件が起きた。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その帰還の準備中に、パビナールがごっそり抜き取られたのである。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし彼がパビナールを使用している現場を、あるいはその気配も、加納はとらえ得なかった。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "調べて見ると、全部パビナールである。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "パビナールを打っていたのは、やはりお前だったんだな」　加納はやや語気を荒くして言った。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ城介君は帰還要員だし、パビナールの量を漸減するという条件で、入院命令を撤去したんじゃないかとも思うね。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして城介君は薬品取扱いの任から外された」「じゃ彼はもうパビナールの入手は出来なくなったわけだね」「いや。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の太宰に対する不審といふのは、太宰がまたパピナールを用ゐはじめてゐるのではないかといふ疑念であつた。",
              "citation": {
                "source": "或る文学青年像",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただパピナールをまたはじめてゐるらしいといふ事と、家人の言葉と太宰自身の言葉とは万事に非常な相違があつていつに似ぬ不誠実な太宰の態度が腹立しかつたといふだけが殆んど全部であつた。",
              "citation": {
                "source": "或る文学青年像",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "パピナール中毒を再発してゐるといふだけで大たいは判つたが、芥川賞に関する件はどちらからも一向触れなかつた。",
              "citation": {
                "source": "或る文学青年像",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "山岸が太宰の中毒症を心配してゐたし、井伏も太宰が自分のところへ来たと知ると先づ中毒症の話をして、パピナールをやめさせる方法を講じたいと言つた。",
              "citation": {
                "source": "或る文学青年像",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
