        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "）「フレデリツク、シイズ、パアル、ラ、グラアス、ド、ヂヨオ、ロア、ド、ダンマルク、デ、ワンダル、デ、ゴオト。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "パアル・アンチシパションに園遊会を催したのである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "映画の圧倒的好評につれて、第一書房は出版当時はそれぞれ分冊として発売していたパアル・バック夫人の「大地」「母」「息子たち」「分裂せる家」と作者が自分の父母の生涯を描いた二冊の作品とを代表選集として売り出している。",
              "citation": {
                "source": "若い婦人のための書棚",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パアル・バックはアメリカ人である。",
              "citation": {
                "source": "若い婦人のための書棚",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして又私は何のことにでもこまっかくオパアルの様にいろいろに輝いて見て呉れる心をもってますもの。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の女　日向ですかし見るオパアルの様な複雑した輝きと色とをもって居る彼の女は、他人の量り知る事の出来ない程いろんな事を考え、想像する力をもって居た。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の女の心のオパアルはより以上に複雑にこまっかくするどい光をはなして居る。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オパアルのように光るハンドルをもってそうっとあけた。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私の驚くほど奇麗だと思うもの――　月の光の中の雪とオパアルと日向で見る銀器と。",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「髪だってああ云う風に結ってるしさ、　何だか違うじゃないか、　それにあの人はどんな時でも右の小指に小さいオパアルの指環をはめてるねえ。",
              "citation": {
                "source": "蛋白石",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "きつくしめられた帯の上は柔かそうにふくれてズーッとのばして膝の上で組み合わせた手がうす赤い輪廓に色取られて小指のオパアルがつつましく笑んで居た。",
              "citation": {
                "source": "蛋白石",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃、パアル・バックというアメリカ人の女作家（支那生れ）のひとの「母」「大地」など支那を描いた作品をよみました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "パアル・バックの作風その他。",
              "citation": {
                "source": "年譜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月二十九日（金曜）『婦人文芸』へ「パアル・バックの作風その他」を十一枚送る。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルダナパアルの驕奢だ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "パアル・バツクの「大地」に出て来る農夫たちを眼のあたり見る思ひである。",
              "citation": {
                "source": "北支物情",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シャケスパアル引つ込め」といふ始末であつた。",
              "citation": {
                "source": "近代劇論",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
