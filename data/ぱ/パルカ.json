          "literary": [
            {
              "text": "エトルスクス時代の製作で、昔はパラティーノのルパルカルに在った。",
              "citation": {
                "source": "パラティーノ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれはグラティアたち〔美・優雅・喜びの象徴である姉妹の三女神〕をもパルカたち〔運命をつかさどる三女神〕をも信仰するのではなく流行を崇拝するのだ。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピサロは古い権威を利用することの賢明なるを考えて、アタワルパの弟トパルカを王位継承者と定め、彼の手から王冠をさずけた。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
