          "literary": [
            {
              "text": "十「パオリ」に換ふべし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "その價は二「パオリ」なりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "二「パオリ」は言ふに足らざる錢なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼、われは三「パオリ」をも惜まざるべし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　車主は客人も零錢の御用あるべければとて、五「パオリ」の銀貨一枚｜撮み出して我に渡しつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "○肝癪のいろいろ　※十月の百花園　○部屋をかりに行った中野近くの医者、　　　　　パオリ　オランダ人。",
              "citation": {
                "source": "一九二五年より一九二七年一月まで",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊太利らしいパオリという名をつけて。",
              "citation": {
                "source": "一九二五年より一九二七年一月まで",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかに男で、ソビノフ、ラザロ、パオリ、ヤドローカー、女で、オーベ、ルイームス、エドヴィナ、ロソフスキー、レアシュ、ミカイロワ、と書いて来ると際限がない。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
