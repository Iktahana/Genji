          "literary": [
            {
              "text": "遠い昔、ギリシヤのこと、パンアテナイア祭の戦車競技に出陣する勇士とその恋人の物語である。",
              "citation": {
                "source": "パンアテナイア祭の夢",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　若者は、パンアテナイア祭の戦車競技に選ばれた幸福な、そして悲愴なアハヴの心を心としてしまつた。",
              "citation": {
                "source": "パンアテナイア祭の夢",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "若者は、パンアテナイア祭の物語を何んな風に話して娘を悦ばさうか知らと思つてゐた。",
              "citation": {
                "source": "パンアテナイア祭の夢",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭りへ行くのだ、パンアテナイアの祭りへ！",
              "citation": {
                "source": "パンアテナイア祭の夢",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
