        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今日はどういう趣意のパァティなのか、よくもまあこんなに振り撒いたと思うくらい、色とりどりのコンフェッチが、食卓にも床にも雪のように積もり、天井から蜘蛛の巣のように垂れさがった色テープの下で、三角帽や紙の王冠をかぶった乗客が、しどろに踊っている。",
              "citation": {
                "source": "予言",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴代は機嫌のいい子供のように鼻唄をうたいながら更衣室で仕事着に着換え、パァティ・ドレスを抱えてフロントへ出てきた。",
              "citation": {
                "source": "復活祭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "よんどころないパァティなどには、姉の一人が、魔法瓶に蒸溜水を詰めてついて行くので有名だった。",
              "citation": {
                "source": "蝶の絵",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなら、いいパァティにご案内するわ。",
              "citation": {
                "source": "姦（かしまし）",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そないなパァティやったら、服は半礼装でっしゃろ。",
              "citation": {
                "source": "姦（かしまし）",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶会をパァティといったのは、洒落のつもりだったんですけど、解釈はむこうさまの自由でしょう。",
              "citation": {
                "source": "姦（かしまし）",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "しぶしぶ承知したふうにして、「そのパァティ、何時からやらはるのン」と何気ないようすで聞くのよ。",
              "citation": {
                "source": "姦（かしまし）",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は最近翻訳の出たエリオットの「カクテル・パァティー」という戯曲を読みましたか？",
              "citation": {
                "source": "あるニュウ・フェイスへの手紙",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "時たまお菓子を買つて家じうそろつてお茶を飲むとか、隣家のをばさんをお茶に呼ぶとか、さういふのは買食ひの部ではなく、これはパァティみたいなもので、いともかんたんな宴会なのだから、決して買食ひではなかつた。",
              "citation": {
                "source": "買食ひ",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラブというからなにをしているのかと思ったら、療養所の外気室のようなヴェランダのついたコテージの中へ、酒場だの、グリルだの、モンテ・カルロ式の鳩射場などをこしらえて、戦争中、毎日パァティをして遊んでいたというんですから」　ママがまたいった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜はパァティみたいなものがあって、みなそこへ行くんですから」「さようですか。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜のパァティって、赤坂のＫ会館前であるＩＲＣの主催の、日本代表の送別会のことではございませんか。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それできょうのパァティ、お夜食が出るんでしょう」「はい。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今夜のパァティの意味をよくおしえておくほうがいいのじゃないかね。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなものを着て行ったら、現代人が胆をつぶしはしないかと思って」「今夜のパァティは古い方たちばかりなので、タンゴやスウィングを踊ることはないでしょう。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "若いひとはほんのわずかで、全体に禿げ頭や皺や白髪のほうが目だち、ひとくちにいえば非常にクラシックなパァティだった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ママは交通権だのお別れのパァティだのとごまかしていたが、日本代表や商務官のお別れにピストルなんかいるわけはない。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前はこのパァティに招待されたのか」「否。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＩＲＣのグルネルさんあたりから今夜のパァティのことを聞いて、満寿子さんが来ていると思って、誰かのタクシードを借りてそっと見にきたというわけなんだ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だいこん、あなた、生理、どうなの」「今月分は、昨日の朝すみました」「明日、いいパァティがあるそうよ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたもお出なさい」「どんな意味のパァティなの」「パァティに意味なんかないでしょう。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しっかりやってくるんだな」「このごろはむずかしいパァティばかりで骨が折れる。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "九時ごろ寝床へ入ったが、明日のパァティはあたしにとってなにか非常に重大な意味のある催しらしいと思うと、うつらうつらしながら気になってねむれない。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「パァティってどこにあるの」　山チイが悠然とあたしを見おろしながらいった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたはむずかしいひとだから、お誘いしまいと思ったんですけど、これは日本にとって大きなヒストリカル・イヴェントなんですから、お見せするほうがいいと思って来ていただいたのよ」「あっさりやってくれよ、なんなの」「軍艦へお別れに行くパァティなのよ」「なんだ、そんなことか。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "水兵たちはだいたい昨日で艦を退ったが、きょうはわれわれだけで、音楽ゆるす、酒保ゆるす……つまり軍艦のパァティをやっているところだ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうですか、副長、せっかくのご厚意だから、きょうのパァティをダンスで仕上げをするというのは」　ボアイエの副長がゲエテ艦長にいった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "エトルタの光井さんのヴィラでパァティがあったとき、林檎酒に酔っぱらってテラスからおっこちたことがあったね。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご迷惑でありませんでしたら、さっき艦長がおっしゃったコントル・ダンスで、きょうのパァティを終らせたいと思います」　艦長が笑いながらうなずいた。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
