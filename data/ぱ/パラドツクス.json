        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "△型といふものは出来るのが本当、そしてそれを破るのが本当（これはパラドツクスめくが）。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・独居は人を饒舌にする、パラドツクスめいた文句だが。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はパラドツクスを逃避し、また、それを徹底的に遂行しない。",
              "citation": {
                "source": "浪曼的月評",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "かういへば、反対者は、有名なポアンカレのパラドツクスを思ひ浮べるかも知れない。",
              "citation": {
                "source": "文学の本質について（一）",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "聊かパラドツクスを弄すれば、梅花に冷淡なること甚しきが故に、梅花に熱中すること甚しきものなり。",
              "citation": {
                "source": "続野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、此の説は、大きなパラドツクスが含まれてゐる。",
              "citation": {
                "source": "劇作を志す若い人々に",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の如き人生のパラドツクスは主我主義に固執する者が自我の内容を眞正に豐富にすることが出來ないのに似てゐる。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
