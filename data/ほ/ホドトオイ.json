        "examples": {
          "standard": [
            {
              "text": "彼の英語力はネイティブには程遠い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "プロのレベルには程遠いけれど、毎日練習を続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の発言は、真実からは程遠いものだった。",
              "citation": {
                "source": "Illusions AI",
