  {
    "uuid": "a7a23b41-da2c-5a39-adaa-878f51e94622",
    "entry": "ホコ",
    "reading": {
      "primary": "ほこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "稲がもうだいぶ高くなつて、路にそつてる箇所はズツとホコリで殆んど黒くなつてるのが、熱い上に熱くした。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻のほうはとにかく、夫のほうは、たたけばたたくほど、いくらでもホコリの出そうな男なのである。",
              "citation": {
                "source": "桜桃",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "房の頭は、ホコリで白くなっていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しいドンスの支那服でも中津が着ると、ホコリにまみれて汚れているように見える。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホコリと、煙と、燐に汚れていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "内地を出発する前日に、炊事場の隣の入浴場で、汗とホコリを流した。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　製氷所の機械場では、黄ろいホコリをかむった蟇のような靴を、マメだらけの足にひっかけて兵士達が、しびれをきらして、自分達の番を待ち、待っていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "街は、一層きたなく、ホコリッぽかった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この辺の新しき土はホコリッぽくッて歩きにくい。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "（４）　潔癖な夫　硝子窓がちょっと曇っていても気にし、障子のサンにホコリが溜ってやしないかと、指の腹で擦ってみる。",
              "citation": {
                "source": "良人教育十四種",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "われながらなさけねえッたらありゃしねえんだが、五百両なんて大金は、シャチホコ立ちしたってもお目にかかれねえんだから、つい欲に目が眩んで片棒かつぐ気になったのがこの態なんです。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、ホコリかぶってる」「聴かねえほうがいいぞ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまで実験に供してゐた下等動物は、梅毛虫、ヨトウムシ、モンクロシャチホコ等であつたが林泉太郎博士は新らたにインテリゲンチャ虫といふ新種を発見したのであつた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "退之の件の語中の馬勃は牛の小便に対して馬の糞を指したんだが、『本草』に掲げた馬勃は馬糞に似た胆子菌リコベルドン、スクレロデルマ等諸属、邦俗チリタケ、ホコリタケなど呼ぶ物に当る（『本草図譜』三五巻末図見るべし）。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一足｜毎に、そこいら中がギシリギシリと鳴って、頭の上の天井の隙間からポロポロとホコリが落ちて来たのにはイヨイヨ驚いた。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中でも表の八畳が下駄を並べた店らしく、ホコリだらけの棚が天井裏からブラ下がっている。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の袂から額縁の裏まで引っくり返してみたが、出て来たものは袂糞とホコリばかりだ。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒血だらけの引っ掻き傷と、泥と、ホコリに塗みれた素跣足の上に、背縫の開いた囚人服を引っかけて、太い、新しい荒縄をグルグルと胸の上まで巻き立てている彼の姿を見たら、大抵の者が震え上がったであろう。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちの靴の痕跡が、そのまま床に残ったところを見ると、部屋中が薄いホコリに蔽われているらしい。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の中央から南北に区切った西側は、普通の板張で、標本らしいものが一パイに並んだ硝子戸棚の行列が立塞がっているが、反対に東側の半分の床は、薄いホコリを冠った一面のリノリウム張りになっていて、その中央に幅四五尺、長さ二｜間ぐらいに見える大｜卓子が、中程を二つの肘掛廻転椅子に挟まれながら横たわっている。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その大卓子の表面に張詰めてある緑色の羅紗は、やはり薄いホコリを被ったまま、南側の窓からさし込む光線を眩しく反射して、この部屋の厳粛味を一層、高潮させているかのようである。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその前には瀬戸物の赤い達磨の灰落しが一個、やはり灰色のホコリを被ったまま置き放しにしてあるが、それが、その書類に背中を向けながら、毛だらけの腕を頭の上に組んで、大きな口を開きながら、永遠の欠伸を続けているのが、何だか故意と、そうした位置に置いてあるかのようで、妙に私の気にかかるのであった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……プッ……プップッ……どうもヒドイホコリだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "別段に痛い処も痒い処もないが……併し眼と口の中が砂ホコリで一パイになっているらしく、瞼がヒリヒリして歯の間がガリガリするその不愉快さ……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな馬鹿な事がといったって、木乃伊の親方は、総立ちの見物人と、楽屋総出の介抱と、吾輩の泣きの涙の中に、ホコリダラケの板張りの上で息を引取ったのだから仕方がない。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホコリ臭くて息が詰りそうで、何遍も何遍も咳が出そうになるのをジッと我慢しているのがホントに苦しかったわ。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども太郎は生れ付きの柔順さで、正直に母親の遺言を守って、いくら友達に誘われても線路を歩かなかったらしく、毎日毎日国道の泥やホコリで、下駄や足袋を台なしにしていた。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "マッチを擦ってみると、その水の表面にはホコリが一粒も浮いていない。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
