        "examples": {
          "standard": [
            {
              "text": "ラーメンに細ネギをたっぷり乗せて食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この料理には、彩りとして細ネギを散らすと美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は庭で細ネギを育てていて、いつも新鮮なものが食卓に上がる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "うどんが運ばれると、細ネギをごっそりかけ、一息につるつるとすすり、汁まで余さず飲んでしまう。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
