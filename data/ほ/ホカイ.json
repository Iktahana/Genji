  {
    "uuid": "db069998-cdc4-5559-b455-4624a9058f24",
    "entry": "ホカイ",
    "reading": {
      "primary": "ほかい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
