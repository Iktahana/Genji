[
  {
    "uuid": "26fef1b4-bc1a-58e4-8c27-3035b7594c60",
    "entry": "補回",
    "reading": {
      "primary": "ほかい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
