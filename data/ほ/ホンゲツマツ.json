        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この手紙は凡そ本月末か来月初めに着くのでしょうね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "本月末に出来るのを待った方がよさそうです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかがしましょうか、本月末まで待ちましょうか。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "先月末、本月末、とかく月末にはれる。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "このカンの虫は今にきっと又何とか方法を見つけ出してゆくでしょう、本月末のがすらりと通って順調にゆけばまたそこで一つ見当もつきますし。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "※子としても、そんな無分別なことを果してしたものだろうか、本月末には博多に帰って来る約束をしてある。",
              "citation": {
                "source": "柳原※子（白蓮）",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "長州表より次第進発した軍が、いよいよ事容れられずんば、おそくとも本月末、京都を包囲して天下の軍を敵に廻す計画の有ることも知っていられるか？",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長州表より次第に進発した軍が、いよいよ事容れられずんば、おそくとも本月末、京都を包囲して天下の軍を敵に廻す計画のあることを知っていられるか？",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本月末か十二月かにゆくはずです。",
              "citation": {
                "source": "島の便り",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
