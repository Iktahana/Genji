          "literary": [
            {
              "text": "』『怎してツて、ホホヽヽヽヽ。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『畳たゝいて此方の人――これ、此方の人、此方の人ツたら、ホホヽヽヽヽ。",
              "citation": {
                "source": "札幌",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　二度呼んでも返答が無いので、苦笑ひをして歩き出さうとすると、『ホホヽヽ。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』とお柳は蔑む色を見せたが、流石に客の前を憚つて、『ホホヽヽ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ホホヽヽ、今｜午後の三時頃ですよ祖母さん。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホホヽヽヽ、マア好い事聞いた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　そして取つて付けた様にホホヽヽと再笑つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ホホヽヽ、何方も山へ行きたいの？",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホホヽヽ、マア何といふ呆然した顔！",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、弾機でも脱れた様に、『ホホヽヽ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と富江は其｜後から叫んで、そして、面白さうにホホヽヽと笑つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　そして、袂を口にあてて急にホホヽヽと笑ひ出した。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ホホヽヽ、今午後の三時頃ですよ祖母さん。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホホヽヽヽヽ、マア好い事聞いた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　そして取つて附けた樣にホホヽヽと又笑つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホホヽヽまア何といふ呆然した顏！",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、彈機でも外れた樣に『ホホヽヽ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』そして、袂を口にあてゝ急にホホヽヽと笑ひ出した。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『疊たゝいて此方の人――これ、此方の人、此方の人ッたら、ホホヽヽヽヽ。",
              "citation": {
                "source": "札幌",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　二度呼んでも答が無いので、苦笑ひをして歩き出さうとすると、『ホホヽヽ。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　小秀『エ、オホホヽヽヽ』　篠田『今日は直接申込んで見給へ』　小秀『まさか？",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            }
          ]
