        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「悪いけど、急ぎでこの資料をコピーしてくれないか？」「ほいきた、すぐやります！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「今日の飲み会、幹事お願いできる？」「ほいきた！任せておいて」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "子供に肩車をせがまれ、父親は「ほいきたっ」と勢いよく持ち上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "けれど、ほいきたと云ッて降りられもしない。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はそれを遮って、女房のような調子で、「ちょっと蜜を取ってちょうだい」　私は、ほいきたとあわてたような声を出して、手をのばして蜜の容器を取った。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほいきたとその男も立った。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
