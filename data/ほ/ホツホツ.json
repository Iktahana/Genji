[
  {
    "uuid": "14aaa0e9-e5af-5644-ba53-0589f0b995f5",
    "entry": "ほつほつ",
    "reading": {
      "primary": "ほつほつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
