    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その法敵も多く竜の性質形体を帯びた物だった（『エンサイクロペジア・ブリタンニカ』巻三）。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三図は、この法敵とキリストと闘うところだ。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "またそれに次いで大流行だった如安法王の伝というは、九世紀に若僧と掛落した男装の女が大学者となって、ついにレオ四世に嗣いで、ローマ法王となり、全く男と化けて世を欺きいた内、従僕の子を姙みし天罰で、あろう事か街の上に産み落したその場で死に、その子は世界終る時｜出づべき法敵として魔が取り去ったそうだ。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "初め基督生れて正法大に興らんとした際邪鬼輩失業難を憂ひ相謀つて一の法敵を誕生せしめ大に邪道を張るに決し、英國の一富豪に禍を降し、先づ母をして其獨り息子を鬼と罵らしめて眠中其子を殺すと、母は悔ひて縊死し父も悲んで悶死した。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊尸耆利山で法敵に襲われ、石子責めに逢って殺された、目蓮尊者に比べてはこの身の殉教は数にも入らぬ。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度こそ逃がさず追い詰めて、息の根を止めるでございましょう」　狂信者の群を見廻したが、「向こうへ逃げて行くあの男こそ、我々にとっては無二の敵、教法を妨げる法敵でござる。",
              "citation": {
                "source": "前記天満焼",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僧三　法然聖人御入滅後法敵多き浄土門を一身に引き受けて今日の御繁盛をきたしましたのは、まったくお師匠様のお徳でございます。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時お師匠様御近侍の若僧が遊女をめとったとあっては、法敵の攻撃に乗ずる口実ともなります。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那の佛教にとつて、道教は第一の法敵であつた。",
              "citation": {
                "source": "老子化胡經",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "南都の衆徒は源空を法敵として立ち、公家階級もまた「念仏宗の法師｜原」を狂僧と認めて、源空の上足を斬り、その徒を獄に投じ、源空らを流罪に処した。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「梶四郎兵衛は、私の宗旨を嘲り笑った許し難い法敵じゃ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "欄干の死骸",
                "note": "青空文庫"
              }
            },
            {
              "text": "あしたは、綽空一箇を法敵としてこの山は鳴り怒るであろう。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "法敵篇氷柱の下一　冴え返った春先の夜である。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそろしい法敵がほかにはある。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このままに、手をこまねいていたら、叡山や南都の法敵のために、上人のお身も気づかわれます。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「岡崎のごときは、法敵の中核ではない。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "七箇条の誓文と、叡山へ送る一文には、法敵を責めている論争は一つもない。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉水の教壇へ向って、巨弾を放ってきた第二の法敵があらわれた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう状態にある吉水へ、さらにまた、一方から不意な法敵があらわれて、（邪教をつぶせ）と、波瀾のうえに、波瀾をあげてきた一派がある。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――まったく、吉水でも、その法敵でも、夢想もしていなかった社会の裏面から、それは燃えひろがった魔火であった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　布教の前線に立つ人々は、いつも、実社会や反対派の法敵に素面で触れているだけに、「叡山が何だ」「奈良、高雄、みな旧教の蒙をかぶって、象牙の塔に籠っている過去の人間どもばかりではないか」　住蓮も、安楽も、気がつよかった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いよいよ念仏門の滅亡の日も近づいた」　と、人々は暗黙のうちに、叡山天台の独り誇り得る時代が来ることを祝福して、法敵｜吉水へやがて襲うであろうところの暗風黒雨を想像し、「こんどは、ちと烈しいぞ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "徹底的に、念仏は地上から一掃され、彼らのいうところの法敵吉水は、潰滅を予想された。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
