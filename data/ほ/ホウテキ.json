  {
    "uuid": "b224b46d-acf5-53d1-824e-e01de12e0455",
    "entry": "法敵",
    "reading": {
      "primary": "ほうてき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
