  {
    "uuid": "3a3192a8-d6f5-53f6-b5b3-dbf9969e5372",
    "entry": "彫り",
    "reading": {
      "primary": "ほり",
      "alternatives": [
        "えり"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
