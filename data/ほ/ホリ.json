        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "河川の氾濫を防ぐために、新たに広範囲な堀が掘削された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "観光客は、水上バスに乗って、水路となった堀を巡るツアーを楽しんでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この地域では、灌漑用水路として、昔から多くの堀が整備されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
