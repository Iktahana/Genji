        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の顔立ちは彫りが深く、どことなく神秘的な雰囲気を漂わせていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彫りの深い顔立ちの俳優は、スクリーンで存在感を放つことが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供の頃、写真の父の彫りの深い顔を見て、厳格な人だと思っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
