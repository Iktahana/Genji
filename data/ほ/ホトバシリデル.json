        "examples": {
          "standard": [
            {
              "text": "事故現場で水道管が破裂し、泥水が猛烈な勢いで迸しり出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "刃物で切った指から血が迸しり出るのを見て、彼は顔を背けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ダムの放水口から、轟音と共に白い水しぶきが迸しり出ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それに涙の出口が開かれてゐる、あなたが口數を多く利けば、涙が迸しり出るだらう。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
