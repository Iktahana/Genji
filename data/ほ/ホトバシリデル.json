    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その時その永遠なる底の深みから、強過ぎる、焔が迸り出るので、己達は驚いて立ち止まる。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん目が馴れて来ると弾が上がって行く途中の経路を明瞭に認める事が出来る、そして破裂する時に、先ず一方へ閃光のように迸り出る火焔も見え、外被が両分して飛び分れるところも明らかに見る事が出来る。",
              "citation": {
                "source": "雑記（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬中、寒さに閉ぢ籠められてゐた天地の情感が時至つて迸り出るのだが鬱屈の癖がついてゐるかして容易には天地の情感が開き切らない。",
              "citation": {
                "source": "小町の芍薬",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛇口から勢よく迸り出る湯のけむりにも、新しい木の香はしみてゐさうだつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "雷雲のやうに険悪に濁つた血が、迸り出る出口を探し求めてるやうに、脈管を走り廻つている。",
              "citation": {
                "source": "脱殼",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、淡路君は忠実に勤めを果したので、孔雀は王の衣裳を脱ぎ捨ててから、時針の変化で、幡江を遮ったのでした」　法水の、凄まじい推理力から迸り出る力に圧せられて、一座の者は化石したように硬くなってしまった。",
              "citation": {
                "source": "オフェリヤ殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "両手をあげて迸り出る健策の言葉を押し止めた。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ゼゼ……絶対にお断りします」「……………」　私は先刻から一所懸命に我慢していた、あらゆる不愉快な思いが、口を衝いて迸り出るのを止める事が出来なくなった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……と同時に洪水のように迸り出る罵倒の言葉が、口の中で戸惑いし初めた。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを漬ける手伝いしていると、水道の栓から滝のように迸り出る水が流し許に溢れて、庭口の方まで流れて行った。",
              "citation": {
                "source": "ある女の生涯",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしたちの出す聲は隨分無茶で書生流儀のものではあつたが、いくら叫んでも叫び足りなかつたやうに、わたしたちの胸から迸り出るものが、いろ／＼な試みともなつたのである。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏目さんは大抵一時間の談話中には二回か三回、実に好い上品なユーモアを混える人で、それも全く無意識に迸り出るといったような所があった。",
              "citation": {
                "source": "温情の裕かな夏目さん",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒼白い、広い額の下に、深く窪んだ目があつて、その目から時々焔が迸り出る。",
              "citation": {
                "source": "クサンチス",
                "author": "XANTHIS",
                "note": "青空文庫"
              }
            },
            {
              "text": "口を結び、眼を見開き、逆賊の行為を怒られるがように、義博の顔をひたと見詰め、御首級は生き身さながらであり、今にも叱咤の御声が、迸り出るかに拝された。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二三の喉が拡がって迸り出る声が無限に続いた闇の中に消え入って仕舞った後の沈黙は、激情の赴くがままに走った後の眠りを欲するまでに疲労した心の奥までしみ透って、互に目を見合わせて寄り合わずには居られない程の陰鬱と凄惨な気分が漲って居た。",
              "citation": {
                "source": "お久美さんと其の周囲",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには、われ／＼は深い省みと強い感情とをもつて、われ／＼自身の心から、われ／＼自身の肉体から、迸り出るやうに、さういふ人が、啓示をもつて出て来るやうにし向けなければなりません。",
              "citation": {
                "source": "神道の新しい方向",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬の右腹は野球の捕手の胸当のような厚い革で保護されてあるので、私たちは腹綿の迸り出るのを見ないですんだのであるが、一九二八年以前だったら馬は一たまりもなくその場に絶命していた筈である。",
              "citation": {
                "source": "闘牛",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "3840谷合の曲りくねった道を辿って来て、不断の泉の迸り出るこの岩に攀じ登るなんぞが、こう云う道を歩く人には、薬味のように利くのだ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その火が糸のように細く這って行くかと思うと、忽ちまた泉の涌くように迸り出る。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時その永遠なる底の深みから、強過ぎる、※が迸り出るので、己達は驚いて立ち止まる。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きている人間の胸中から真に迸り出る言葉が詩になり得ない事はない。",
              "citation": {
                "source": "自分と詩との関係",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "熔岩の層が如何に硬く、深くとも、貫きさへすれば水は迸り出る――と、レゼー先生は確信してゐられたのでした、それで、莫大な費用を投じて井戸の工事が始められました。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日の感激の迸り出る患者さんの歌を十數首拜見して、更に涙を止め得なかつた。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして住み心地よい北海道、争闘のない世界たらしめたい念願が迸り出るからである。",
              "citation": {
                "source": "北斗帖",
                "author": "違星北斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "相模寅造は立ったままでジロジロと一同を見下していたが、唐突に安亀の方に向き直ると、まるで迸り出るような声で、「俺は、おめえに盃をかえさせ、今では赤の他人なんだから、親分面をしてここへやって来たんじゃねえ。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに言はうと云ふ望は、終に消えず忽にして總の考を壓去つて、此度は思ふ存分、熱切に、夢中の有樣で、言が迸り出る。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに言おうと云う望は、終に消えず忽にして総の考を圧去って、こんどは思う存分、熱切に、夢中の有様で、言が迸り出る。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "」などと言いながら自分で栓をねじって迸り出る水を快さそうに眺めながら手拭を持った手で風呂の中を掻き廻しなどしていた。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、顔中に微笑を湛えながら、彼女は彼の口を迸り出るくぜつやら、アイルランドの苦労話やらに耳を傾けた。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "字を書くことの上手な人はこういう機会に存分に筆を揮って、自分の筆端からほとばしり出る曲折自在な線の美に陶酔する事もあろうが、彼のごとき生来の悪筆ではそれだけの代償はないから、全然お勤めの機械的労働であると思われる上に、自分の悪筆に対する嫌忌の情を多量に買い込まされるのである。",
              "citation": {
                "source": "年賀状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
