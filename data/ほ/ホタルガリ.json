        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供の頃、網を持って蛍狩りに行ったことを覚えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "蛍狩りをする際は、蛍を傷つけないように優しく扱う必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "残念ながら、この辺りではもう蛍狩りできる場所が少なくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
