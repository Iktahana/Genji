        "examples": {
          "standard": [
            {
              "text": "人間の体は、ホメオスタシスの働きによって周囲の気温に関わらず体温を一定に保とうとする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "過度なストレスは自律神経の乱れを招き、ホメオスタシスがうまく機能しなくなる原因となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "健康な体を維持するためには、ホメオスタシスによる生体調節機能が正常であることが不可欠だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "生物の個体は種のホメオスタシスのために生存する。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
