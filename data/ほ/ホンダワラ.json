        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "海岸には、打ち上げられたたくさんの馬尾藻があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "馬尾藻は、食用にもなる海藻の一種です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "潮干狩りに行った時、水中に揺れる馬尾藻を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "すじめ、ざらめ、うがのもく等の馬尾藻科の海草が、覗き眼鏡の底に鬱蒼として林のごとく繁茂して、大きな波のうねりのごとにゆらゆらとゆらめいてうつるのであった。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、あるといえば藻海くらいだろうが、それも過去における魔境に過ぎず……いまはその怪｜馬尾藻も汽船の推進器が切ってしまう。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帆船のころは、無風と環流のためそこを出られなくなり、舵器には馬尾藻がぬるぬると絡みついてしまう。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンダワラ一名神馬草、神功皇后征韓の船中｜秣に事欠き、この海藻を採って馬に飼うた故名づくと（『下学集』下）。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "邦俗ホンダワラてふ藻を神馬草というは、その波に揺れながら枝葉間に諸生物を安住せしむる状を件の神馬王の長毛に比して学僧輩が名づけたのかも知れぬ。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭のまん丸いホンダワラのような楕円形をした……その根元の縊れたところから細い紐で海底に繋がっている。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "橘千蔭は「玉藻は藻の子は白く玉の如くなれば言へり」と言っているが、そうなると、玉のある海藻はまず差当り彼の玉の様な浮嚢を有するホダワラ（ホンダワラ）の一属諸種を指して言ったものと見ねばならぬ。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンダワラは今日ではこのようにいっているけれど、元の名はホダワラであった。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の中で、ホンダワラとおぼしき海藻が燐光を放っているのが見えた。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "海面に見えるのは、日に焼けて黄色くなったホンダワラの切れ端と、船のすぐそばを漂うカツオノエボシだけだ（※カツオノエボシとは電気クラゲのこと。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "この黄色いホンダワラが、昨晩あれほど燐光を放っていたのだ。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗くなる間際、船はホンダワラでできた大きな浮き島に近づいた。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンダワラはゆらゆらとゆるやかな波に揺られて、まるで海が黄色い毛布をかぶって何かと愛し合っているように見える。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで彼は、流れていくホンダワラの黄色い塊を手鉤で引っ掛けた。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、トビウオが舳先から船の左右に跳ね上がり、ホンダワラの黄色い塊が漂っているだけだ。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
