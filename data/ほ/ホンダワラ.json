    "definitions": [
      {
        "index": 1,
        "gloss": "Sargassum fulvellum (species of edible brown alga)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
