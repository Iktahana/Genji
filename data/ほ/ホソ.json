[
  {
    "uuid": "3bce13a4-bb9e-50cb-af41-2d2a5ab866f7",
    "entry": "細",
    "reading": {
      "primary": "ほそ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
