  {
    "uuid": "0f566bd5-c730-5643-b0a4-3ac10302cb2b",
    "entry": "ホソ",
    "reading": {
      "primary": "ほそ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのホソビキのあの脳に昇る匂ひを、覚えてゐる。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "岸近に廻るホソの小魚しか鉤には来らぬであろう。",
              "citation": {
                "source": "蘆声",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ホソイ　メヲ、アタマノ　ウエニ　ソーツト　ダシマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「フーン」小サイ　デンデン蟲ハ、オカアサマデモ　ワカラナイ　フシギナ　トホイ　ソラヲ、ホソイ　メヲ　一パイ　ノバシテ　イツマデモ　ミテ　ヰマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツ、ヰルヨ」「エ、ドコニ」「ホラ、アソコニ」　ズーツト　下ノ　ハウノ　アル　マチノ　ホソイ　ミチノ　上ニ　キラキラト　ヒカル　モノガ　アリマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……どこか隔たった室で話しているらしい男の声が、廊下に面した扉の間からホソボソと沁み込んで来るうちに……　……品夫……　……復讐……　……という二つの言葉が偶然のように相前後してハッキリと響いて来ると、彼女はパッと顔を上げた。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍬や鋸やホソなどを外気にさらさせないためのものであった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　　　＊　人形のうまく出来上ったものには、魂が入るのだといい、江戸川乱歩氏は、「人でなしの恋」を書かれて、人形に恋した男が蔵の中で、人形とホソボソ睦言を囁き、あげくの果は、美しい夫人を残して、その人形と情死するという筋を描かれた。",
              "citation": {
                "source": "人造物語",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルヒ　タラウサンノ　ウチデハ、ナニカ　オホソウドウガ、モチアガリマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト　ホソイ　タケノボウデ　ブタレテヰマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　スルト　ポチハ　ボンヤリシタ　メヲアケテ「ナアニ、アレハ　オホソウヂダヨ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタ　メガサメテミルト、オホソウヂハ　モウドコヘイツタカ　カゲモカタチモアリマセンデシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今余自ラ作ル所ノ者ナホソノ十ノ二、三ヲ記スルコト能ハズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちその一つは Lolium perenne L. で俗に Rye-Grass といい、ホソムギの和名があり、その花には芒がない。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この有芒無芒の点で容易にこのホソムギ、ネズミムギの区別がつく。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その原種は水辺に野生してこれは敢えて食用に利用せられてはいないが（無論利用は出来る）、これから変わって出た上のアザブタデほかのムラサキタデ、アイタデ、ホソバタデ、イトタデなども多く人家に栽えてあって、同じくその葉が食用に供せられる。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔は単にウリと称えまたホソジともいった。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に書いた古名のホソチは蔕落の意で、このマクワウリは満熟すると蔕を離れ自然に落ちるからいうとのことである。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マクワウリ、アマウリ、アジウリなどは無論右ホソチの古名よりは後ちの名称である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで日本人がホソバタイセイと名けた。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この好々爺は、気が向くと、細葉（ホソバ）の垣をめぐらした百姓家の前へ馬をつなぎ、「いい天気じゃのう、ああ咽喉が乾いた、――茶を一杯所望するぞ」　と、屈託のない声をかけながら、軒の低い百姓家の暗い土間の中へのっそりと入ってゆく。",
              "citation": {
                "source": "本所松坂町",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊に蓬莱重きあゆみかな　　　　友静「廊」は「ワタドノ」あるいは「ホソドノ」とでも読むのであろうか。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
