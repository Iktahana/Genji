        "examples": {
          "standard": [
            {
              "text": "ピアニストの細な指先が鍵盤の上を魔法のように滑り、繊細なメロディを紡ぎ出す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "柳の細な枝が水面に影を落とし、春の穏やかな風に吹かれてゆらゆらと揺れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "遠くの空に浮かぶ細な三日月が、都会の喧騒をよそに静かな輝きを放っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
