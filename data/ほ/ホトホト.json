[
  {
    "uuid": "3c052d6a-40f8-5358-85c7-44a91490ca5e",
    "entry": "殆",
    "reading": {
      "primary": "ほとほと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "quite",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あまりのことに、彼はほとほと困り果てていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の無責任な態度には、ほとほと愛想が尽きた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この一年、ほとほと疲れることが多かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "而も骨を折つた結果は、大抵の場合自分は気拙くなり、相手には殆んど役に立たないやうな次第です。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし相手がやはり詩人である場合は、随分容易に話が通じ、又互ひに利するのかも知れませんが、今の所私は、詩論といふものは殆んど無益だと諦め切つてゐる有様です。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとは、殆んど心に残つてをりません。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "草野君は酒を飲んで酔ふと殆んどそのたびに眠る。",
              "citation": {
                "source": "草野心平詩集『母岩』",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういふつもりで付けたのかまだ訊ねてみないが、僕が勝手に想像する所では、無口でそつとしておいて貰ひたい男が、誰でもが多かれ少なかれ感じてはゐても余りに底深い、流れだとして殆んど全く触れないで過ぎる態の非情を、人目にも立たず浚渫してゐるといつた風の心得であらうと思ふ。",
              "citation": {
                "source": "詩集　浚渫船",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが現今の殆んど全ての文芸作品はその手紙に似てゐる。",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは恰度、音楽に鈍感な女の人が、オーケストラを聴いてゐて、フリュートなぞが単独に吹奏される部分でだけ、音そのものの物理的な快味にだけ感じ入るのに似てゐて、私は明治以降の殆んど全ての文学者が、外国文学の作品を読む時も、そんなやうなものであつたと云つても、強ち過言とは思はないのである。",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてこそ、かの成巧者達が、大抵頸の硬い中庸主義者であり、殆んど理論なくカンでばかり体験し、苦労を咬み殺した人達であることが分ります。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "象徴派詩人達は殆んど女のやうな優雅さを持つてゐた。",
              "citation": {
                "source": "トリスタン・コルビエールを紹介す",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でも予想してみてもつまらない」、で、私は遮二無二読み始めたが、殆んど頭には這入つて来なかつた。",
              "citation": {
                "source": "その一週間",
                "author": "――不真面目なわが心……",
                "note": "青空文庫"
              }
            },
            {
              "text": "その庭といふのはその後数回築き直されたにも拘らず、その忠魂塔の台石となつた石だけは殆んどその位置を変へず、そしてその忠魂塔も、私が後に出郷してからも、帰省した時には見掛けたやうに思ふが、七八年前帰省した頃から、それは姿を消した。",
              "citation": {
                "source": "一つの境涯",
                "author": "――世の母びと達に捧ぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は殆んど彼を崇拝した。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼の見識は、殆んど大抵の場合に正鵠だつた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "病人は床に起きあがつて、殆んど例外なしに悲慘である所の、多くの天才の末路について物語つた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分たち詩人の仲間は、すべてが單純な情熱家であり、客觀的な觀照眼を殆んどもたない。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし最近の如く、彼が詩に深い接觸をもち、詩的の實精神に憧憬し、殆んどそれによつて文藝觀の本質に突き入らんとするが如きは、恐らくかつて見なかつた所だらう。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜、折あしく私の所に多數の人の集會があつた爲、殆んど話をすることもできずにしまつた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その泣菫氏の自選詩集には、僕が昔愛讀した詩が殆んど皆オミツトされ、僕の嫌ひだつた詩ばかりがしかも多くの斧鉞を加へて集めてある。",
              "citation": {
                "source": "永遠の詩人",
                "author": "宿命生涯を貫く",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つにはだいたい私がそれまでに殆んど読書らしい読書をしてゐず、術語だの伝統だのまた慣用形象などに就いて知る所殆んど皆無であつたのでその口惜しさに遇つて自己を失つたのでもあつたゞらう。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして芸術史上の折々に於て、殆んど技巧ばかりが芸術の全部かの如き有様を呈した。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在殆んどすべての人はさうなつてしまつた。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "では、短歌、俳句とはどう違ふかと云ふに、その最も大事だと思はれる点は、短歌・俳句よりも、度合的にではあるが、繰返し、あの折句だの畳句だのと呼ばれるものの容れられる余地が、殆んど質的と云つても好い程に詩の方には存してゐる。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて、其処に、紛糾は、凡そ未だ甞て誰も思つてもみなかつた程発生してゐるのであるが、そのことを文献は殆んど語つてゐないといふも過言ではない。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "訝かつても自分に殆んどない要素である故遂に推察出来ず、疑心悪鬼を生じ、芸術家を憎むに到る。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、技巧論といふものは殆んど不可能である。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄が湯から上つて来ると、耕二がボールをグラムに投げ込んではまたボールを手に取つて投げ込む――それを殆んど無意識に繰り返してゐるらしい音が、三畳の間でしてゐた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "耕二は、独楽を廻して置いては、頬を殆んど地｜面につけるやうにして独楽の心棒をみつめてゐた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼食の直ぐ前頃だし田舎道を通るものなんて殆どなかつた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私はもう今では感傷といふものが反撥的にか、殆どなくなつて居る。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "三次ほとほと嫌になった。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
