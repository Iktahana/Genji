  {
    "uuid": "1fbd8543-a411-5a40-b5a7-5008f367f58f",
    "entry": "ホノ",
    "reading": {
      "primary": "ほの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "けれども、母の妹に当たるホノーリア・ウェストファイルという叔母がハロウの近くに住んでおりまして、父もここを訪ねることだけは許してくださいます。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君、いま、ホノルル・カフェにはいないのかい？",
              "citation": {
                "source": "兵士と女優",
                "author": "オン・ワタナベ（渡辺温）",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、ホノルルは夙の昔に辞職しちゃった。",
              "citation": {
                "source": "兵士と女優",
                "author": "オン・ワタナベ（渡辺温）",
                "note": "青空文庫"
              }
            },
            {
              "text": "サムラヒハ　ビツクリシテ　アシモトヲ　ミルト、ゲタノ　ウシロニ　フデノ　ホノヤウナ　シツポガ　チヨロリト　デテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚、その程度によっては、ホノルルなり、サンフランシスコなりに、船が着いたら、下船させてしまうぞ。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホノルル・ブロオドウェイの十仙店で、ぼくは、紅のセエム革表紙のノオトを買いました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホノルルの日本領事館で、官民合同の歓迎会が催されたのち、邦人の方の御好意で、選手一同ハワイの名勝ダイヤモンド・ヘッドからハナウマイヘかけて、見物させて貰いました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "だぼはぜ嬢は、相不変の心臓もので、ぼく達よりも一船前にホノルルを去った野球部のＤさんやＨさんに、生のパインアップルをやけに沢山託づけました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "※二三日前、新聞でオリムピック選手達が、明日ホノルルに寄航するという記事を読み、坂本さんにも会えると思ったら、その晩｜夢をみました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホノルルの日本領事館で、官民合同の歓迎会が催されたのち、邦人の方の御好意で、選手一同ハワイの名勝ダイヤモンド・ヘッドからハナウマイへかけて、見物させて貰いました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "≪二三日前、新聞でオリムピック選手達が、明日ホノルルに寄航するという記事を読み、坂本さんにも会えると思ったら、その晩｜夢をみました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "※二三日前、新聞でオリムピック選手達が、明日ホノルルに寄航するという記事を読み、坂本さんにも会えると思ったら、その晩夢をみました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中央の高い、暗い、円天井から、淡紅色の絹布に包まれた海月型のシャンデリヤが酸漿のように吊り下っていたが、その絹地に柔らげられた、まぼろしのような光線が、部屋中の人形を、さながらに生きたお伽話のようにホノボノと、神秘めかしく照し出しているのであった。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女の寝息とも……牛乳の香気とも……萎れた花の吐息ともつかぬ、なつかしい、甘ったるい匂いが、又もホノボノと黄絹の帷帳の中から迷い出して来た。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頬に一種異様の赤味がホノボノとさし初めました。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その垂幕の間から、隣りの化粧部屋と、その向うの白い浴槽がホノ暗くのぞいている。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "室のまん中には雪洞型の電燈が一個ブラ下って、ホノ黄色い光りを放散していた。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その周囲を、死人色の青黒い、紫がかったお化粧でホノボノと隈取って、ダイヤのエース型の唇を純粋の日本紅で玉虫色に塗り籠めている……」「ハハハ。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は泣きたいような御主人の笑い顔をホノボノと見返されるのでした。",
              "citation": {
                "source": "奥様探偵術",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――見れば、まだ石塔の立っていないために、心持ち窪んで見える奥様のお墓のところから、夜目にもホノボノと、青白い線香の煙が立っているではありませんか。",
              "citation": {
                "source": "幽霊妻",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はあ、待ちに待ったる新軍艦ホノルル号が突如ニューヨーク沖に現れました。",
              "citation": {
                "source": "不沈軍艦の見本",
                "author": "――金博士シリーズ・10――",
                "note": "青空文庫"
              }
