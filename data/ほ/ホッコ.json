[
  {
    "uuid": "907a89d1-0061-5ede-a7f6-5f3ab4e35629",
    "entry": "北湖",
    "reading": {
      "primary": "ほっこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
