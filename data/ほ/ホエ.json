    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "凶暴なその船の太さほどの猛獣のようにほえる。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、夫と顔を見合わせてほほえむだろう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "水夫らは、セキメーツの怒鳴るのと、波浪のほえるのと、スクルーの轟音と、リギンの裂くような音とをゴッチャゴッチャに聞いてしまった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボーイ長までも、ウッカリほほえんだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほえざるという奴さ。",
              "citation": {
                "source": "猿ヶ島",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そう言って彼は、ほえざるの一群を指さした。",
              "citation": {
                "source": "猿ヶ島",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほえざるは、もう啼きやんでいて、島は割合に平静であった。",
              "citation": {
                "source": "猿ヶ島",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "喪主らしい男は、一人だけ粗麻の喪帽をかむり、泣き女はわんわんほえながらあとにつゞいていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "餌がなくて飢えた家畜は、そこら中で悲しげにほえていた。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "尻尾を焼かれた馬が芝生のある傾斜面を、ほえるように嘶き、倒れている人間のあいだを縫って狂的に馳せまわった。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　ほえるような声で主人は叫んだ。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "春先とはいえ、寒い寒い霙まじりの風が広い武蔵野を荒れに荒れて終夜、真っ闇な溝口の町の上をほえ狂った。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "びっくりしてはね起きて見ると、外ではほんとうにひどく風が吹いて、林はまるでほえるよう、あけがた近くの青ぐろいうすあかりが、障子や棚の上のちょうちん箱や、家じゅういっぱいでした。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもまたじっとその鳴ってほえてうなって、かけて行く風をみていますと、今度は胸がどかどかとなってくるのでした。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういうお誂え向きのがありますぜ」　今度は庄太がささやくと、半七はほほえんだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鬼娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「むむ、気が違ったかも知れねえ」と、半七はほほえんだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "「たしかに一軒だと思っています」「それじゃ訳はねえ」と、半七はほほえんだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お照の父",
                "note": "青空文庫"
              }
            },
            {
              "text": "東にむかった社殿に幾種の絵馬が懸けつらねてあって、そのうちにかの白鷹の絵馬も見えたので、二人は近寄って暫く無言で見あげていたが、やがて半七は自分の予覚が適中したようにほほえんだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "正雪の絵馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "生き物と聞いて、彼はすぐに鶴殺しを思いうかべたのであるが、相手はほほえみながら頭をふっていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鷹のゆくえ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なにか、忘れ物でも……」「さあ、どうも大きな忘れ物をして来たらしい」と、半七はほほえんだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鷹のゆくえ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあ、その位のことはするでしょうけれど……」と、女房はほほえんだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鷹のゆくえ",
                "note": "青空文庫"
              }
            },
            {
              "text": "石松、ほほえんで、　「どうでえ姐さん、又俺の勝だ」（Ｆ・Ｏ）Ｓ＝街道　旅姿の森の石松の移動。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなくパリパリ呼子が鳴り汽罐車は一つポーとほえて、汽車は一目散に飛び出しました。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "われまたほほえみてこれに応えざるを得ざりき。",
              "citation": {
                "source": "おとずれ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "二郎はわれを導きてその船室に至り、貴嬢の写真取り出して写真掛けなるわが写真の下にはさみ、われを顧みてほほえみつ、彼女またわれらの中に帰り来たりぬといえり。",
              "citation": {
                "source": "おとずれ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は叔父さんといっしょに山の背を通っていると、たちまちはげしく犬のほえる声を聞いた。",
              "citation": {
                "source": "鹿狩り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と叔父さんの指す方を見ると、朝日輝く山の端を一匹の鹿が勢いよくむこうへ走ってゆく、その後をよほど後れて二匹の犬、ほえながら追っかけて行く。",
              "citation": {
                "source": "鹿狩り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "折り折り遠くでほえる犬の声が聞こえた。",
              "citation": {
                "source": "鹿狩り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いて犬がはげしくほえた。",
              "citation": {
                "source": "鹿狩り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "女星は早くも詩人が庭より立ち上る煙を見つけ、今宵はことのほか寒く、天の河にも霜降りたれば、かの煙たつ庭に下りて、たき火かきたてて語りてんというに、男星ほほえみつ、相抱きて煙たどりて音もなく庭に下りぬ。",
              "citation": {
                "source": "星",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
