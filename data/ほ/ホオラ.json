          "literary": [
            {
              "text": "黒人の犯罪９・30（夕）　イネズ・ミルホオランド・ボアス※ン女史といふと、米国の女権論者のちやき／＼で、加之に数へる程しか無い女流弁護士の一｜人として相応名を売つてゐる女だ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホオラ一円札があるじゃないか。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホオラこれを遣ろうなどと言うて仕舞桶の汚れ水を引っ冠せたりする事も御座います。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "始終その繩を手で曳いて、ホオラホウと追わなければならなかった。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
