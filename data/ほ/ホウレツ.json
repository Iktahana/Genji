[
  {
    "uuid": "b4ec2f80-f868-5889-a99f-ee1c83d7f310",
    "entry": "芳烈",
    "reading": {
      "primary": "ほうれつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
