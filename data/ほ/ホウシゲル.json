          "literary": [
            {
              "text": "初め山に竈門山宝重寺と云ふ寺があつて、山伏が住んでゐた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "折柄社長室には、東宝重役や幹部諸君が集まっておられたので、日本ラジオ悲観論を披露するとともにこの問題は直ちに映画の製作に一致すべき共通点があることを強調した。",
              "citation": {
                "source": "アーニイ・パイルの前に立ちて",
                "author": "小林一三",
                "note": "青空文庫"
              }
            },
            {
              "text": "九時半入浴してると、玉久旅館に、東宝重役連が来てるからと迎への車。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "東宝重役今村氏の招きで食事、おかったるくて話にならぬ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "康有爲の廣藝舟雙楫も、阮元に比べては大に南碑を寶重することに注意して居る。",
              "citation": {
                "source": "北派の書論",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            }
          ]
        }
