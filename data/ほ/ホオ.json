[
  {
    "uuid": "0df5a224-eba8-5ed3-9551-ea90803e39e7",
    "entry": "頬",
    "reading": {
      "primary": "ほお",
      "alternatives": [
        "ほほ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
