      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "cheek (of the face)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女の頬は健康的なバラ色をしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は赤ちゃんの柔らかい頬を優しく撫でた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "寒さで私の頬はすっかり冷たくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "明け放された窓からは初夏の風がサカンに頬や帽子の鍔に吹きつけてゐた。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘルンはそれがたいへん気に入り、『面白いの音』といいながら、頬をふくらして、ボオボオと吹き鳴らしては、また『いかに面白い』といって吹き続けた。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私は、かなしいやら、こわいやら、うれしいやら、はずかしいやら、胸が一ぱいになり、わからなくなってしまいまして、妹の痩せた頬に、私の頬をぴったり押しつけ、ただもう涙が出て来て、そっと妹を抱いてあげました。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒼黒い両頬が桃の実のようにむっつりふくれた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が近づいていって、やあ、と馬場に声をかけたら、菊ちゃんが、あ、と小さく叫んで飛びあがり、ふりむいて私に白い歯を見せて挨拶したが、みるみる豊かな頬をあかくした。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "レンコオトも帽子もなく、天鵞絨のズボンに水色の毛糸のジャケツを着けたきりで、顔は雨に濡れて、月のように青く光った不思議な頬の色であった。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　太宰は右の頬を殴られた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すすめられるままに、ただ阿呆のように、しっかりビイルを飲んで、そうして長押の写真を見て、無礼極まる質問を発して、そうして意気揚々と引上げて来た私の日本一の間抜けた姿を思い、頬が赤くなり、耳が赤くなり、胃腑まで赤くなるような気持であった。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "窮屈さうに、紫檀の卓に頬肘を突いて、今まで其処に自分のゐた庭に、障子の中硝子を透して集中しない視線を遣つてゐた。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから頬は……生え際は……耳は云々。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "校長室で、彼は卓に頬肘を突いて、眠さうな、赤い顔をして先刻から考へてゐた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "頬鬚が品の好い中年の紳士らしくて、全く他人として父が親しめた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "耕二は、独楽を廻して置いては、頬を殆んど地｜面につけるやうにして独楽の心棒をみつめてゐた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "或日父は近頃にない早く、外来患者も病室の方も済まして、表の間の卓に頬肘を突いた儘、縁先の河鹿の鉢をヂツと瞶めてゐた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の顔色が急に変るかと思ふと彼は自分のマントと帽子を左手に持つて、右手で私の頬をポカツと擲りつけた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると涙がジミジミと頬をつたつた。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "踊り終つてヂェラルドは彼女の頬に接唇し、彼女の頭髪に桂をかざしてやつた。",
              "citation": {
                "source": "ヂェラルド・ド・ネルヴァル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯然と二の腕を捲ると、生白い肌が現出れて酒氣を帶びた頬が薄赤い。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『やつちまへ』『疊ん仕舞へ』彌次馬の聲援、畢竟は我が味方と、芳は勇み立つて、無手と對手の襟髮を掴むや、馬手の下駄は宙を飛んで、その頬桁を見舞はんとす。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "淋しい笑を片頬に見せて、消入るような声で何か云っているようであったが凄まじい木枯しが打消してしまって、老婆の「ホー」と云った寒そうな声と、娘の淋しかった笑顔とは何かなしに自分の心にしみ込むようであった。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして顔の血潮をぬぐって見ると頬は紅を帯びて世にも美しい顔ばせに見えた。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "紺碧のナポリの湾から山腹を逆様に撫で上げる風は小豆大の砂粒を交えてわれわれの頬に吹き付けたが、ともかくも火口を俯瞰するところまでは登る事が出来た。",
              "citation": {
                "source": "二つの正月",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "血色のいい頬、その頬が涙で洗われている。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒼白くて頬の落ちた顔に力なけれど一片の烈火瞳底に燃えているように思われる。",
              "citation": {
                "source": "根岸庵を訪う記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すじ向いに座を構えたまうを帽の庇よりうかゞい奉れば、花の御かんばせすこし痩せたまいて時々小声に何をか物語りたまう双頬に薄紅さして面はゆげなり。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これと同じ白衣着けたる連れの男は顔長く頬髯見事なれど歩み方の変なるは義足なるべし。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "刈り株ばかりの冬田の中を紅もめんやうこんもめんで頬かぶりをした若い衆が酒の勢いで縦横に駆け回るのはなかなか威勢がいい、近辺のスパルタ人種の子供らはめいめいに小さな凧を揚げてそれを大凧の尾にからみつかせ、その断片を掠奪しようと争うのである。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "窪んだ眼にまさに没せんとする日が落ちて、頬冠りした手拭の破れから出た一束の白髪が凩に逆立って見える。",
              "citation": {
                "source": "凩",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ほお‥‥‥』と、我知らず答へた時、私は總身の緊張感もほぐれたやうな、またお前の身に迫る次の危急な瞬間も忘れてしまつたやうな、その場合には餘にそぐはない心の弛みを感じて、水島の顏を見返した。",
              "citation": {
                "source": "疑惑",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "繰り返しても繰り返しても飽くを知らぬのは、またこの懐旧談で、浮き世の波にもまれて、眉目のどこかにか苦闘のあとを残すかたがたも、「あの時分」の話になると、われ知らず、青春の血潮が今ひとたびそのほおにのぼり、目もかがやき、声までがつやをもち、やさしや、涙さえ催されます。",
              "citation": {
                "source": "あの時分",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
