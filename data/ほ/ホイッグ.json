        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "代表的な保守家である晩年のエドマンド・バーク（ホイッグの巨頭）がフランス・ブルジョアジーのこの新興形態に対して取った反啓蒙的な反動的態度は有名であるが、リードはバークの完全な同時代者であるばかりではない。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが彼は又旧ホイッグ党党是の無条件な信奉者であり、民衆的な衡平の反対者なのであった。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の英国をつくったホイッグ党の若いひとたちのことを思いだしますね。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
