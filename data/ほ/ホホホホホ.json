          "literary": [
            {
              "text": "ホホホホホホ」　彼女は全くの親切からのようにそういった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホホホホホ、お銚子は？",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホホホホホ、一切合財皆もちろん、――だわね」と唄にしながら、下へ注文を通しにおりて行った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホホホホホ、ね、小倉さん、あなたはご自分が賢くって品行のいい、船のりには珍しい、堅い、善良な、そしても一つあるのよ、人類のためになる人間だと思ってるのね。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホホホホホホ、とうとう、私、あんたを、大ばか者にしてしまったわね。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホホホホホホ」女は全速力の船の、スクルーシャフトが回転してるようだった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、船が着くたんびに、あんたに、ダイヤモンドの指輪を『愛の表象』としてねだることよ、ホホホホホ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のいうことがわかって、ホホホホホホ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "私を産んだ、私の知らない、ほんとの私のおとうさんだわ、ホホホホホホ……私おとうさんに……」　　　　　二一　その夜は全く悪魔につかれた夜であった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホホホホホ」「僕は下船したんだから、当分また厄介になるよ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホホホホホ、大きな声をお出しでない、隣家の児が起きると内儀の内職の邪魔になるわネ。",
              "citation": {
                "source": "貧乏",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアお這入なさいナ、それとも老婆ばかりじゃアお厭かネ、オホホホホホ」「イヤ結構……結構も可笑しい、アハハハハハ。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホホホホホ、これでございますものね。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝物を返せ、さもなくば殺してしまうぞ――って、いま、旦那さまは嚇されてるんじゃない※　ホホホホホホ、お怒りになっちゃあたくし、困りますわ」　こんな冗談から、なにか引きだそうとする部屋付女中の態度も、折竹には不愉快な一つだ。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "したが奥方、とくと胸に手を置いて、もう一度勘考したほうが、お為でありましょうぞ」「ホホホホホ、なんと黄金郷とお言いやるのか……」　女丈夫は、蒼白い頬をキュッと引きしめて、嗤い返した。",
              "citation": {
                "source": "紅毛傾城",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オホホホホホ面白い事ばかりおっしゃって、どこに生きていらっしゃるんです」「静岡に生きてますがね、それがただ生きてるんじゃ無いです。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ホホホホホホ。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホホホホあなた見ていらっしたの……ホホホホホホ。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思うと妾ゃ胸騒ぎがするわいな」「ホホホホホホホ。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アハハハハハハハハハ……」「オホホホホホホホホ……」　という笑い声が、お局じゅうに流れ漂うた。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
