        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "故郷を捨てて長い間あちこちを旅してきたその蓬客は、村外れの古寺で一晩の宿を乞うた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は自らを風の吹くままに生きる蓬客と称し、ギター一本を抱えて全国のライブハウスを巡っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "旅人向けの古びた宿屋には、疲れ果てた蓬客たちが身を寄せ合い、囲炉裏の火で暖をとっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
