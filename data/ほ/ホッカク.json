          "literary": [
            {
              "text": "これは北郭の閑思と題する曹※（晩唐）の詩である。",
              "citation": {
                "source": "閑人詩話",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "北郭といふのは、多分その任地の山城のことであり、山前山後是れ青草と云ふのは、その城郭のある山の前後が、みな野原か田畑になつて居たのであらう。",
              "citation": {
                "source": "閑人詩話",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "岡崎城の北郭から外郭の一帯は松が多い。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
