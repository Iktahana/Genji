        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "然しもはや其処をさへ跳越えて、インテリ自身が、衣食住だけ足りればいゝ人達の人生観、所謂「ホガラカ」を以て、自分を律しようとするやうにさへなつてゐるのである。",
              "citation": {
                "source": "作家と孤独",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホガースやドーミエーからは享楽の影に潜む恐ろしさを味わわされる。",
              "citation": {
                "source": "漫画と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はマルセーユから催眠酒をのまされたような意識を失って近東行の急行列車に乗ると昏々とマホガニイの寝台でフロレンス辺まで吊されていたらしいのだ。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、彼等は、その家についている、窓硝子や、床板をはずして街をホガホガ持ち歩きだした。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「白のニッケル、マホガニー材、蝋色の大理石、これだけあれば、俺はどんな感情でも形に纏めてみせるね。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "友達のフェルナンドが設計して呉れたモダニズムの室内装飾具は素っ気ないマホガニーの荒削りの木地と白真鍮の鋭い角が漂う闇に知らん顔をして冷淡そのものを見るようだ。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マホガニイ、白真鍮、鼠色大理石の材料で成層圏の印象を与へる炉を作り、マントルピースの上には紅木爪が寂しく一枝。",
              "citation": {
                "source": "花は勁し",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼠大理石が銀の肋骨を露出してマホガニーの木理の義足で立っているテーブル。",
              "citation": {
                "source": "バットクラス",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "みるみるうちに中身はくすんだマホガニー色を呈し、ガラス容器の底に褐色粒子の沈殿が現れた。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこではたれでも、マホガニ色に、赤黒くやけます。",
              "citation": {
                "source": "影",
                "author": "SKYGGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらマホガニ色にやけることにはなれても、すずむだけはすずまずにはいられません。",
              "citation": {
                "source": "影",
                "author": "SKYGGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、あたしのからだの中には、コルクがはいっているのよ」「そんなこといや、ぼくだって、マホガニーの木でできているんだよ」と、こまが言いました。",
              "citation": {
                "source": "いいなずけ",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホガラ／＼した秋の暖さが體に通ツて、何んだか生温い湯にでも入ツてゐるやうな心地……、幻から幻へと幻がはてしなく續いて、種々な影が眼前を過ぎる、……只見ると、自分は、ニコライ堂のやうな高い／＼塔の屋根に登ツて躍ツたり跳たりしてゐる。",
              "citation": {
                "source": "昔の女",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏壇のある中の間には、マホガニか何かのと、桐の箪笥とが三棹も並んでいて、三味線箱も隅の方においてあった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "パナマ帽に黒の上衣は脱いで、擁へて、ワイシャツの、片手には鶏の首のついたマホガニーの農民美術のステッキをついてゆく、その子の父の私であつた。",
              "citation": {
                "source": "白帝城",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うは浴室との戸になっていて、その横の壁にマホガニー色の装飾を凝らした鏡附きの古風な化粧台があって、それに相当の空間を置いて、相対した壁に洋銀のダブルベッドが備えつけられ、それには前面と裾とに卵色の薄いカーテンが掛っている。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "パナマ帽に黒の上衣は脱いで、抱えて、ワイシャツの片手には鶏の首のついたマホガニーの農民美術のステッキをついてゆく、その子の父の私であった。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも、すっかりマホガニイの木でこしらえて、銅の釘で打ちつけて、銅の板でくるんだ、丈夫な船でないと、とても向うまでいく間持ちません。",
              "citation": {
                "source": "黄金鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は中洲の川丈座へゆく、万歳オンパレードである、何といふバカらしさ、何といふホガらしさ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "小倉の寝十方花庵を訪ねる、庵主不在、奥様と話しながらよばれる、酒は飲んでも飯は食べない、お嬢さんはホガラカで、しごくよろしい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ノンキだね、ゼイタクだね、ホガらかだね、モツタイないね！",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "花タチハ　キイタ　コトノ　アル　コヱダト　オモツテ　ミルト、ウマヤノ　マドニ　大キナ　ヤサシイ　ウマノ　カホガ　ノゾイテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はまず天下一品に、新しい立派なマホガニーの棺を着ているのだ。",
              "citation": {
                "source": "ペスト王",
                "author": "寓意を含める物語",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭脳明晰……シーク……ホガラカという事になって行くのだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この簡単明瞭なる脳髄局のアンポンタン・ポカン式、反射交感組織にシャッポを脱いで、頭脳明晰……意識ホガラカとなったアンポンタン諸君のアタマならば、最早、二度と再び脳髄のトリックに引っかからないであろう。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一つは正面の壁に架けてある六号型マホガニーの額縁で、中には油絵の裸体美人が一人突立って、両手を頭の上に組んで向う向きに立って草原の涯に浮かむ朝の雲を見ている。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉が一つ割れておりましたので……お届けしようと存じておりましたところで……」　と言ううちに大きなマホガニーの箱をだした。",
              "citation": {
                "source": "ざんげの塔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅行鞄についで、木目白樺で象嵌をほどこしたマホガニイの手箱だの、長靴の型木だの、青い紙に包んだ鶏の丸焼だのが持ちこまれた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
