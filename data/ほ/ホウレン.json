    "definitions": [
      {
        "index": 1,
        "gloss": "imperial carriage",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "天皇陛下を乗せた鳳輦が、沿道の市民の歓声を受けながら進んでいく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歴史絵巻に描かれた鳳輦の華やかさに、思わず目を奪われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祭礼のクライマックスとして、鳳輦が神社へと宮入りする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "今や彼女は俄かに其五彩の鳳輦を進めて、鵬程万里の極、我が日出の宝土に来らざるべからずなれり。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「また別の日に伺候いたしまして」　還幸の鳳輦をはなやかに百官の囲繞して行く光景が、物の響きに想像される時にも、太后は過去の御自身の態度の非を悔いておいでになった。",
              "citation": {
                "source": "源氏物語",
                "author": "乙女",
                "note": "青空文庫"
              }
            },
            {
              "text": "厨子は、木瓜厨子、正念厨子、丸厨子（これは聖天様を入れる）、角厨子、春日厨子、鳳輦形、宮殿形等。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "彫刻修行のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのみぎり、楠公は金剛山の重囲を破って出で、天皇を兵庫の御道筋まで御迎え申し上げたその時の有様を形にしたもので、畏れ多くも鳳輦の方に向い、右手の手綱を叩いて、勢い切った駒の足掻きを留めつつ、やや頭を下げて拝せんとするところで御座います。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "楠公銅像の事",
                "note": "青空文庫"
              }
            },
            {
              "text": "二重橋の外に鳳輦を拝みて万歳を三呼したる後余は復学校の行列に加はらず、芝の某の館の園遊会に参らんとて行く途にて得たるは『日本』第一号なり。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸は鳳輦のガラス窓に的中した。",
              "citation": {
                "source": "随筆「断片」",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "きれいな身なりをして化粧をした朝臣たちをたくさん見たが、緋のお上着を召した端麗な鳳輦の中の御姿になぞらえることのできるような人はだれもない。",
              "citation": {
                "source": "源氏物語",
                "author": "行幸",
                "note": "青空文庫"
              }
            },
            {
              "text": "大原野で鳳輦が停められ、高官たちは天幕の中で食事をしたり、正装を直衣や狩衣に改めたりしているころに、六条院の大臣から酒や菓子の献上品が届いた。",
              "citation": {
                "source": "源氏物語",
                "author": "行幸",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳳輦西に向ひて、西海に浮びたる平氏は、九州四国の波濤の健児を糾合して、鸞旗を擁し征帆をかゝげ、更に三軍を従へて京師に迫るの日なくンばやまず。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝には御祈願のため、すでに加茂へ行幸せられ、そのおりは家茂および一橋慶喜以下の諸有司、それに在京の諸藩士が鳳輦に供奉したことが報じてあり、さらに石清水へも行幸の思し召しがあって、攘夷の首途として男山八幡の神前で将軍に節刀を賜わるであろうとのおうわさも報じてある。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "国事寄人として活動していた侍従中山｜忠光は官位を朝廷に返上し、長州に脱走して毛利真斎と称し、志士を糾合して鳳輦を途中に奪い奉る計画があるというような、そんな風説も伝わったとある。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝にも当日は御気分が進まれなかったが、周囲にある公卿たちをはじめ、長州侯らの懇望に励まされ、かつはこの国の前途に深く心を悩まされるところから、御祈願のため洛外に鳳輦を進められたという。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "石清水行幸のおりにすでにそのうわさのあった前侍従中山忠光を中心とする一派の志士が、今度の大和行幸を機会に鳳輦を途中に擁し奉るというような風説さえ伝えられた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、今度いよいよ御親征を仰せ出され、大坂まで行幸のあるということを誤り伝えて、その月の上旬に上方には騒動が起こったとか、新帝が比叡山へ行幸の途中｜鳳輦を奪い奉ったものがあらわれたとかの類だ。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中に鳳輦を押しとどめるものもあるやの流言もしきりに伝えられる。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はそれらの人たちを相手に、東海道の方に動いて行く鳳輦を想像し、菊の御紋のついた深紅色の錦の御旗の続くさかんな行列を想像し、惣萌黄の股引を着けた諸士に取り巻かれながらそれらの御旗を静かに翻し行く力士らの光景を想像した。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月のはじめには、新帝はすでに東海道の新井駅に御着、途中｜潮見坂というところでしばらく鳳輦を駐めさせられ、初めて大洋を御覧になったという報告が来るようになった。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "主上も鳳輦に乗られ、急いで池のほとりまで出御になり、法皇は南庭に幕を打ち廻して避難なさった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十二巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "葱花鳳輦とは名ばかりであった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第八巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "他に三位中将知盛、頭中将重衡などが鳳輦の御綱に供奉して、ひときわ華やかさを競ったものであった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを持もの二人｜紫ちりめんにて頬をつゝみてむすびたれ、おなじ紅絞などを片襷斎曰、すべて祭礼に用ふる傘矛といへる物は古へ羽葆葢の字を訓り、所謂繖にしてきぬかさとよむ神輿鳳輦を覆ひ奉るべき錦蓋也といへり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂利を噛む車輪のひびきが蹄の音のなかに轆々とまじって、いよいよ鳳輦の近づくことが知られた。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "北の中門の外に、お微行の鳳輦が横づけになっているではないか。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "降るか降らないかのような時雨が道を濡らしていたが、鳳輦が御所を出るころには、冬陽が射し、虹の立ちそうな美しい鹿島立ちになった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い娘、若い男たちは、「一日でも、あんな鳳輦に侍いてみたら」と、雲上の生活に、あこがれと諦めをもって、自分たち庶民の宿命を、その後でさびしく眺め合った。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして鳳輦（みくるま）のすぐあとにつづく近衛の儀仗には、足利高氏、直義の兄弟があたり、さらに赤松円心の千余騎、土居｜得能の二千、結城、長沼、塩冶勢などの数千騎が、果てなくお供にしたがって、沿道は、数万の見物が押しあいへし合い、その盛観と、洛中の人出は、古今｜未曾有なものであったといわれた。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "賢所の神器を、玉体にお添えし、鳳輦へと、お急き立てはしたものの、それをかつぐ駕輿丁の者はいず、ぜひなく、衛府の士が前後を担いまいらせる。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、このうちにあった結城太田ノ大夫判官親光は、なに思ったか、「いや君のお供をして叡山へ行くよりは」　と、急に独り言して、鳳輦のおそばへ走ってゆき、あたりの公卿へこう告げた。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、一時、鳳輦は、　成就護国院　へ入らせられたが、ここも手ぜまやら御不便となって、あくる日すぐまた、　花山院亭　へお移りになった。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "御車でなく、鳳輦だった。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
