[
  {
    "uuid": "53f1b341-1aa5-5a12-a1d7-7d7066d23802",
    "entry": "鳳輦",
    "reading": {
      "primary": "ほうれん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
