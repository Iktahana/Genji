        "examples": {
          "standard": [
            {
              "text": "インド太平洋の沿岸で見られる「ホコサキ」は、その鋭い吻が特徴的なサメだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ダイバーは、珍しい「ホコサキ」の群れに遭遇し、興奮した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「ホコサキ」の生態については、まだ不明な点が多いと専門家は指摘する。",
              "citation": {
                "source": "Illusions AI",
