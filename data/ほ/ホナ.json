    "definitions": [
      {
        "index": 1,
        "gloss": "then",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「じゃあ、そろそろ行くわ」「うん、ほなねー。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「今日のご飯、どうする？」「ほな、ラーメンでも食べに行こうか。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「荷物持つの手伝おうか？」「ありがとう！ほな、これお願い。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "海水旅館赤松の林をこえて、くらきおほなみはとほく光つてゐた、このさびしき越後の海岸、しばしはなにを祈るこころぞ、ひとり夕餉ををはりて、海水旅館の居間に灯を点ず。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎のあぜみちに坐つてゐると、おほなみのやうな土壌の重みが、わたしの心をくらくする、土壌のくさつたにほひが私の皮膚をくろずませる、冬枯れのさびしい自然が私の生活をくるしくする。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれの詩は子供がははおやの白い大きい胸にすがるやうにすなほな極めて懐しいものも其疾患の絶え間絶え間に物語られた。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前はすなほないゝ子供だ。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "実に山がつのかきほなどにこそ此花咲きてふさはしかるべけれ。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとにそうなら嬉しいけど……」　と、君勇はうたうように言って、「ぼんぼんの相手はわてやおへん」「ほな、ぼんぼんに好きな女子はんおすのンどっか」　と、若い妓がすかさずきいた。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして降りて来ると、「お客さんには今わてがよう謝っといたさかい、ほな、お客さんに挨拶だけしてお帰りやす」「おおきに、お母さん、かんにんどっせ」　千枝子はほっとして二階へ挨拶に上って行ったが、客はいつの間にか部屋を変えていた。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「桔梗家へ行けば、鶴雄さんに会える……」　君勇は匂うばかりにはにかみながら、「ほなお受けさせて貰います」　と言った。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほな、きいとくれやすか」　黙っているのを承諾の意味にとったらしい。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなこと知るもんか」「ほな、あんた、鈴子はんが好きやおへんのか」「…………」「好きどすやろ」　じっと鶴雄の顔を覗くようにした。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「好きだ」「ほな、やっぱし……」　思わず言って、君勇はふとうなだれたが、やがてきっと顔を上げると、「坊ン坊ン、あて坊ン坊ン好きどす」「…………」　鶴雄ははっとして君勇の顔を見た。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほな、帰らして貰います」　出て行きかけて、また戻って来ると、「坊ン坊ン、甘いもンお好きどすか」　だしぬけに、そうきいた。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「好きだ」「ほな、あて、あした、べにやの※みつおごらせて貰てもかめしめへんどっか」「※みつ……？",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あしたは勉強だ」「ほな、あさってにしまっさ」「うん」　うなずくと、鈴子はもう無邪気な表情で、いそいそと帰って行った。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほな、何弁を使うたらいいねン……？",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "生ぐさいものを食うと、反吐が出る」「ほな、何を食うんや」「人を食う。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣もそうやが……」「ほな、失業して暇だらけやいうわけか」「さアなア……」「商売は何や……？",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "経験がないと判らん」「ほな、今経験してみるわ」　豹吉はにやりと笑ったかと思うと、いきなり男の背中をどんと突いた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それやったら、一寸だけある」「ほな、返しに行け」「…………」　亀公は何か言いたそうに、唇を尖らせた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の靴のドロとっても一円にしかなれへんけど、掏摸はまるどりやさかいな」「ほな、掏摸になったらええなア」「…………」「兄ちゃん、掏摸になって、わいに兄ちゃんの靴みがかして、二人前の金払ってくれて、ハナヤおごってくれたら、ええなア。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "言うても聴えんのやったな」　と、針助は苦笑すると、お加代に、「――ほな、この子を頼んだぜ」「いやよ」　お加代が言った時は、しかし針助はもう娘を残して一人でスタスタと歩き出していた……。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほな、掴まって、カンゴク行きやナ」「掴まるかどないか、まだ判るけえ！",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "針助はギラギラと燃えていた眼を、急にうっとりと細めて、針の先を見つめていたが、やがて、「ほな、どない言うても、いやか」　次郎はうなずきながら、思わず三郎に寄り添うた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけはかにしとくなはれ、カンゴクだけは……」「ほな、刺青をするか」　針助の声は急に凄んだ。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、そんなことしたくないからわざわざ一人で行って、今もこうして自首をすすめているのじゃないか」「ほな、どうしても自首せエいうのやな」　豹吉の声は急に力が抜けていた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなに、びっくりしたのは、生れてはじめてや」「ほな、千円くれ」「……？",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "見えずなればなほなつかしく、たとへ恐しきものなればとて、かりにもわが優しき姉上の姿に化したる上は、われを捕へてむごからむや。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そないべんちゃら（お世辞）せんでも、他あやん喧嘩したこと黙ってたるわいな」　そして、早く配ってしまわねば叱られるさかいと、駈け出して行くのを、他吉は随いて行って、「ほな、おっさんに夕刊一枚おくれんか」　その気もなく言うと、「やったかて、読めるのんかいな。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほな、なんぞ泣かんならんようなことがあるのんか」「…………」　他吉は黙って、マニラからの手紙を渡した。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに他あやん、あんたその子｜背負ろうて俥ひく気イだっか」「ほな、こいで失礼さしてもらいま。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
