        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あのな、機械の一部がホーステン心理盤だ。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "大部分は単なるホーステン心理盤だが、ぴかぴか光る結晶性ガラス質のアイスランド鉱石プリズムがあって、これが偏光物質で、装置の心臓部だ。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホーステン心理盤はみんな知っていると思う。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はホーステン心理盤の前に座って画面を見つめた。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "本心器はある点ではホーステン心理盤のようであり、言い換えると本人の眼でも、他人の眼でも見ることができる。",
              "citation": {
                "source": "観点",
                "author": "THE POINT OF VIEW",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
