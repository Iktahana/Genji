        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "原木に椎茸の菌を植え付け、榾木にする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "椎茸栽培のために、多くの榾木が並べられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "父は、裏山で集めたクヌギの木で榾木を作っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
