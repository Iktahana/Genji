[
  {
    "uuid": "30dd7468-8e8d-52f0-b36d-6243844f9cdb",
    "entry": "ホック",
    "reading": {
      "primary": "ホック",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "hook (esp. for clothing)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「背中のホックが届かないから、ちょっと止めてくれない？」と妻に頼まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ワンピースのホックが外れかかっていたので、出かける前に針と糸で補修した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "指先がかじかんでしまって、上着の小さなホックをなかなか外すことができない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「これはアメリカ製でホックスキャッチャーと云います。",
              "citation": {
                "source": "茨海小学校",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そらホックをかけて、ヒーボイ、チェッ、またはずれた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のこの焦燥にもかかわらず、ボイラーはクレインからホックに、すこしも引っかかろうとしなかった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "チーフメーツは、自分の声で、ホックをワイアに引っかけようとでもするように、だんだんその声を大きく張り上げた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホックはうまく彼と、向かい合って立ってる波田との間へおりた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤原は、ホックを、彼のからだの重みをもたせて、波田の持っている鉤穴の方へ揺るがした。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、餓鬼にもスコップ持たして河の中、ホックリ返へさせるだに。",
              "citation": {
                "source": "小熊秀雄全集-4",
                "author": "詩集（３）小熊秀雄詩集１",
                "note": "青空文庫"
              }
            },
            {
              "text": "きたない中学校の制服の立て襟のホックをうるさそうにはずしたままにしていた、それが妙な事にはことにはっきりと私の記憶に残っている。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "詰め襟のホックをかけずに着慣れた学校服を脱ぎ捨てて、君は厚衣を羽織る身になった。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜べは急に景気づいて、納屋の中からは大釜や締框がかつぎ出され、ホック船やワク船をつとのようにおおうていた蓆が取りのけられ、旅烏といっしょに集まって来た漁夫たちが、綾を織るように雪の解けた砂浜を行き違って目まぐるしい活気を見せ始める。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、冬服の上着のホックを叮嚀に脱して、山樺の枝を手頃に切つた杖を持つて外に出た。",
              "citation": {
                "source": "葉書",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の手に出来るようなその纏めに最初働いていたお島は、縫あがった毛布にホックや釦をつけたり、穴かがりをしたりすることに敏捷な指頭を慣した。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホックづけや穴かがりが、お島には慣れてくると段々｜間弛っこくて為方がなくなって来た。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホックづけや穴かがりが、お島には慣れてくると段々間弛っこくて為方がなくなって来た。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱちんぱちんとホックの外れる音がすると、着物はだらりと椅子の背にかかっていた。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "私｜売店をさがしてるんですが――　その男は襟ホックをはずしたまんま、手に二つ巻煙草入れをもってぶらついていたのだ。",
              "citation": {
                "source": "新しきシベリアを横切る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "襟は銀被せのぴかぴかしたホックで留めることにいたしましょうね。",
              "citation": {
                "source": "外套",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "重吉は、流し元へ下りて行って、ザブザブ顔を洗って来ると、制服の襟ホックをはずしたまま、今度は一気に二つの手紙を読んだ。",
              "citation": {
                "source": "海流",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "故郷の村からは何里も離れたこの都会の他人の家でも、幾晩かそこに寝おきした今は遠慮もとれた風で勝手にあがって来て、目を醒した若い二人に気軽くやあと云いながら帯剣をはずし、うるさそうに頸や顎をのばして、軍服の襟ホックをはずした。",
              "citation": {
                "source": "その年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　源一は、すぐには答えず、口元をすこし引しめた表情で眼をしばたたくようにしていたが、やがて、「送って行こう」　顎をもち上げて襟ホックをかけた。",
              "citation": {
                "source": "その年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの一回余計の足跡だっても、まだまだ僕の考察だけでは足りないと思うよ」と法水は、最後の駄目を押して、それから、衣裳の背後にあるホックを外して観音開きを開き、体内の機械装置を覗き込んだ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（さう云つたものの下では、人々は冬籠りの面白さを増さすために、戸外に、雪でも、雨でも、はたまた大洪水のやうな災害でもいいから起ることを願ふものだが……）私は祈祷臺と、いつもホックでカバアをとめた、凹んだ天鵞絨の肱かけ椅子との間を行つたり來たりしてゐた。",
              "citation": {
                "source": "プルウスト雜記",
                "author": "神西清に",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホックはめてよ」「アイヨ。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "とはいえ、その冗談は、大盃になみなみと注いだすばらしいホックハイム葡萄酒でいつも威勢をつけられた。",
              "citation": {
                "source": "幽霊花婿",
                "author": "ある旅人の話",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラモンの三度目のわかい妻ベホックは目をさましていて、その日琴の音と黒い眼つきとで彼女に不思議な歓びを与えてくれたアイルランドの青年のことを思いつづけていた。",
              "citation": {
                "source": "剣のうた",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベホックの長い髪がその眼にも顔にも乱れかかって目を見えなくした。",
              "citation": {
                "source": "剣のうた",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベホックは無言で立っていた。",
              "citation": {
                "source": "剣のうた",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "snap fastener",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
