  {
    "uuid": "b2edfd9c-e8e7-54e0-8b34-1eecef5af1a6",
    "entry": "法句",
    "reading": {
      "primary": "ほっく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
