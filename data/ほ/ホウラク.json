        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "地元の祭りでは、神様への法楽として奉納相撲が行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "舞妓さんたちは、お座敷で神楽を舞い、神々への法楽とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「この舞は、神様への感謝と法楽の気持ちを込めて舞います。」と巫女が言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
