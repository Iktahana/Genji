[
  {
    "uuid": "88ac0d90-973a-5c58-a33d-c0cf31941bfc",
    "entry": "崩落",
    "reading": {
      "primary": "ほうらく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
