    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それが友だちと二人で悪漢の銀行破りの現場に虜になって後ろ手に縛られていながら、巧みにナイフを使って火災報知器の導線を短絡させて消防隊を呼び寄せるが、火の手が見えないのでせっかく来た消防が引き上げてしまう。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "靴音がきこえ、やがて彼の監房の前で立ち止まり、落ちていた報知器をあげる音がきこえ、次に二つの眼が小さな覗き窓の向うに光った。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "火災報知器が鳴らされた。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、鎧戸や窓硝子を壊した音は兎に角として、電気仕掛の報知器はシムソンの部屋のあたりで鳴り響いているでしょうに。",
              "citation": {
                "source": "計略二重戦",
                "author": "少年密偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の邸には電気仕掛の報知器がついています。",
              "citation": {
                "source": "計略二重戦",
                "author": "少年密偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "果ては、アワヤ進行中の扉を開けて飛び降りをしそうになったり、夢中で非常報知器へ手をかけそうになったりする。",
              "citation": {
                "source": "恐怖",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天鵞絨の台座に何かが触れると、忽ち鳴り響く非常報知器だった。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
