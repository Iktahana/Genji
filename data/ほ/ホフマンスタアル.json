        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしこれを危険だとして公にしないとすれば、トルストイでもイブセンでも、マアテルリンク、ホフマンスタアルでも、現代的思想の作というものに、一つとして翻訳して好いのは無いのです。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホフマンスタアルのさう云ふ本を幾冊も買ひ求めたが、皆大震災の時失つてしまつた。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはしかし、言ふまでもなくホフマンスタアルの假託であらう。",
              "citation": {
                "source": "春日遲々",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃リリエンクロオン、ホフマンスタアル、デエメル等と交る。",
              "citation": {
                "source": "リルケ年譜",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
