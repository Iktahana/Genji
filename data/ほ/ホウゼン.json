        "examples": {
          "standard": [
            {
              "text": "泰山で行われる封禅は、皇帝が天と地に自らの功績を報告する儀式であった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "歴史上、封禅を執り行った皇帝は数少なく、秦の始皇帝や漢の武帝が有名だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "封禅の儀式は、天下泰平と皇帝の徳を示すための、極めて重要な国家行事と見なされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": []
        }
      }
