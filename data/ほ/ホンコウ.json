  {
    "uuid": "7c6b41fd-1a67-5b9e-b482-a8fc7d7ac6dd",
    "entry": "本項",
    "reading": {
      "primary": "ほんこう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "this clause",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
