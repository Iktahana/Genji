      {
        "index": 1,
        "gloss": "helmeted guinea fowl (Numida meleagris)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
