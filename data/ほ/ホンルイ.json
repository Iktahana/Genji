          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "捕手は本塁を死守し、得点を与えなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は本塁打を放ち、悠々と本塁を踏んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "チームは本塁への返球を素早く行い、ピンチを切り抜けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
