    },
    "definitions": [
      {
        "index": 1,
        "gloss": "tinder",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "雨上がりの森では、乾いた火口を見つけるのが難しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は丁寧に火口を準備し、ゆっくりと火をおこした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この古い綿は、最高の火口になるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "紺碧のナポリの湾から山腹を逆様に撫で上げる風は小豆大の砂粒を交えてわれわれの頬に吹き付けたが、ともかくも火口を俯瞰するところまでは登る事が出来た。",
              "citation": {
                "source": "二つの正月",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の日はポツオリに行って腹立たしくうるさい案内者に悩まされながらセラピスの寺の柱に残る地盤昇降の跡を見、ソルファタラ旧火口の噴煙を調べ、汚い家でスパゲッティの昼食を食って、帰りの電車で、贋銀貨をつかまされた外にはあまり人間味のある記憶が保存されていない。",
              "citation": {
                "source": "二つの正月",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今来た路の方を振り向くと、峡間の底から、大霧は雪を包んで乱舞を始めている、それは噴火口の底から、硫烟が幾筋も縺れ合い、こんぐらかって、騰上するようである。",
              "citation": {
                "source": "槍ヶ岳第三回登山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "大雪田の石の峰を超えて、三角点の下に来た、木曾山脈を西に控えて、その間の高原を、天竜川が白く流れ、仙丈岳は渓谷を隔てて、その頂上の、噴火口と擬いそうな欠けたところが、大屋根の破風のように聳えて、霧を吐く窓になっている。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十四日　蒲田より白水谷を渉り、中尾を経て、割谷に沿い、焼岳（硫黄山）の新旧噴火口を探りて、再び上高地温泉に一泊。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはしかし吉田口の五合目から、富士に向って、左に路を取り、宝永山の火口壁から、その火口底へ下り、大宮方面の大森林に入って、大沢の嶮を越え、小御岳へ出るのが順で、始めて「大願成就」になるのだが、私は故あって、逆に山に向って右廻りをした。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "頂上内院火口の西壁、剣ヶ峰の側からなぎ落されて、直線に突き切ること三里、力任せにたち割った絶壁の斜面に、墜石崩石は、ざっくばらんにほうりだされている。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここから宝永山の噴火口へは、三丁位であろう。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨あがりのすんだ空に、第一噴火口と、第二噴火口の馬の脊道に立って見あげる。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "火口壁は四十度以上の急角度で、胸突八丁よりも峻嶮に、火口底までは直径約一千尺の深さで、頂上内院大火口よりも深いものである。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "頂上からかけて、七合下りまで、銀流しの大雪が、槍ヶ岳の雪渓にちょっと似ているが、八月半ごろまでには大抵溶けて、九合目以上のと、内院火口にへばりついている残雪だけが、万年雪として残るらしい。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶頂の火口は、今こそ休火山ではあるが、烈々と美を噴く熔炉になっている。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "火口は、シャスタに一つ、シャスチナに一つ、その双峰を繋ぎ合わせるところの、プラットフォームにも、一つあるという話であるが、私はそれをよく知らない。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは宝永の噴火口で、雪が実際は消えていないのであるが、火口壁の陰影で、藍色に見えるのである。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し近づいて見ると、その火口壁の雪は、反対に白紙でも貼りつけたように目立って見える。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲は東から西へと引いたように取れると一天は石灰洞のような大口を開けて、見る見るうちに次第にひろがり、碧い初冬の冴え返った空が、冷たい鯖色をした湖水のようになって、金光ちらりと黒砂に燃え落ちる、黒砂の一線、天に向って走るところ、頂上火口の赭禿げた土は、火を翳したように眩ゆくなる。",
              "citation": {
                "source": "雪中富士登山記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "六合目――宝永の新火口壁（いわゆる宝永山）まで来ると、さすがに高嶺の冬だと思われる冷たさが手足の爪先まで沁みて来る。",
              "citation": {
                "source": "雪中富士登山記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "足許を瞰下すと、火口壁の周辺からは、蝋燭の融けてまた凝ったような氷柱が、組紐の如く、何本となく、尖端を鋭くして、舌のように垂れている、火口底は割合に、雪が多くない。",
              "citation": {
                "source": "雪中富士登山記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば三原山の火口に人を呼ぶ死神などもみんな新聞の反古の中から生れたものであることは周知のことである。",
              "citation": {
                "source": "徒然草の鑑賞",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の日のまだ登らないうち立野を立って、かねての願いで、阿蘇山の白煙を目がけて霜を踏み桟橋を渡り、路を間違えたりしてようやく日中時分に絶頂近くまで登り、噴火口に達したのは一時過ぎでもあッただろうか。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "高嶽の絶頂は噴火口から吐き出す水蒸気が凝って白くなっていたがそのほかは満山ほとんど雪を見ないで、ただ枯れ草白く風にそよぎ、焼け土のあるいは赤きあるいは黒きが旧噴火口の名残をかしこここに止めて断崖をなし、その荒涼たる、光景は、筆も口もかなわない、これを描くのはまず君の領分だと思う。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "『その時は日がもうよほど傾いて肥後の平野を立てこめている霧靄が焦げて赤くなってちょうどそこに見える旧噴火口の断崖と同じような色に染まった。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはかねて世界最大の噴火口の旧跡と聞いていたがなるほど、九重嶺の高原が急に頽こんでいて数里にわたる絶壁がこの窪地の西を回っているのが眼下によく見える。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "神棚の燈明をつけるために使う燧金には大きな木の板片が把手についているし、ほくちも多量にあるから点火しやすいが、喫煙用のは小さい鉄片の頭を指先で抓んで打ちつけ、その火花を石に添えたわずかな火口に点じようとするのだから六かしいのである。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "火花は飛んだが、ほくちがしめっているのか、ちっとも燃えあがらないのであった。",
              "citation": {
                "source": "おじいさんのランプ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "（石を切って、ほくちをのぞませ、煙管を横銜えに煙草を、すぱすぱ）気苦労の挙句は休め、安らかに一｜寝入さっせえ。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでマッチはいま、ほくち箱とふるい鉄なべのあいだに坐っていました。",
              "citation": {
                "source": "ひこうかばん",
                "author": "DEN FLYVENDE KOFFERT",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、ほくち箱が、くちをはさみました。",
              "citation": {
                "source": "ひこうかばん",
                "author": "DEN FLYVENDE KOFFERT",
                "note": "青空文庫"
              }
            },
            {
              "text": "・みんな働らく刈田ひろ／″＼として・あぜ豆もそばもめつきり大根ふとつた・たつた一つの、もぎのこされた熟柿をもがう・垣も茶の木で咲いてゐますね・秋もをはりの夜風の虫はとほくちかく　十一月四日終日読書。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カチカチ」「ちぇッ」「カチカチ」　燧を打つ手先が戦いて、ほくちを取落してはひろい上げ、ようやく附木にうつすとパッと消える。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
