[
  {
    "uuid": "7fd1e0a1-cdd0-570f-b1e6-d743f2db6c34",
    "entry": "火口",
    "reading": {
      "primary": "ほくち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
