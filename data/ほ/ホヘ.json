        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しどけなき、なれが頸は虹にしてちからなき、嬰児ごとき腕して絃うたあはせはやきふし、なれの踊れば、海原はなみだぐましき金にして夕陽をたたへ沖つ瀬は、いよとほく、かしこしづかにうるほへる空になん、汝の息絶ゆるとわれはながめぬ。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろはにほへと、一字一字原稿用紙に書き記す。",
              "citation": {
                "source": "雌に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔ゆがみつゝ月は出で〕宮沢賢治ゆがみつゝ月は出でうすぐもは淡くにほへり汽車のおとはかなく恋ごゝろ風のふくらしペンのさやうしなはれ山の稜白くひかれり汽車の音はるけくなみだゆゑ松いとくろしかれ草はさやぎてわが手帳たゞほのかなり",
              "citation": {
                "source": "〔ゆがみつゝ月は出で〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "君自らが音楽家であつたといふ事実をよそにしても、いろはにほへを鍵盤にした最も進んだ詩人の一人であつた。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いとし子を茲には置きてわが帰る　　母国ありとは思ほへなくに。",
              "citation": {
                "source": "オペラの辻",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の体と楽天地のミイラを比較してみて、いろはにほへど散りぬるをと何もかもしゃらくさい気持になった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いで、此上は、茄子の印を結んで掛け、いろはにほへとと祈るならば、などか奇特のなかるべき、などか、ちりぬるをわかンなれ。",
              "citation": {
                "source": "くさびら",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨に悩める、露に※ほへる、いづれ艶なるおもむきならぬは無し。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮はこの早春の夕べにふさわしい客をうれしくお思いになり、折る人のこころに通ふ花なれや色にはいでず下ににほへる　とお言いになると、「見る人にかごと寄せける花の枝を心してこそ折るべかりけれ　私が困ります」　薫も冗談にしてこんなことを申し上げた。",
              "citation": {
                "source": "源氏物語",
                "author": "早蕨",
                "note": "青空文庫"
              }
            },
            {
              "text": "『折りつれば袖こそにほへ梅の花』というように、鶯もかぎつけて来るかもしれませんね」　などと騒いでいる女房もあった。",
              "citation": {
                "source": "源氏物語",
                "author": "宿り木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、はやにほへ、嗟嘆の樅のふたもと。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま寒き夕闇のそこ、星のごと濡れてにほへる天色の露草七つ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "――美し追憶ただ胸の香にこそにほへ。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "おぎろなし、おもほへば、そは眉に立つかげろふのごと。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "白藤藤のはな軒ににほへり、日の暮れて白き藤なみ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "すばやくも手にさばく檜の縄のはらはらに、時の間よ、ゆく水のかぎりなき燈ににほへば、香魚を追ふ鵜の数のつぎつぎと目にうつりて。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "三ひとむら萠えしなづなを朝出て食むや雌の牛、沼の田べりはわづかに降りつぐもののにほへり。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "水あかり黒川の浅夜の冷やき水あかり江につづくらし広き汐騒黒川の葦辺の冷やき水あかり夜汐かまじる暗くにほへり川間橋何か藻くづの青めくは夜釣のさしてにほふならしも安旅籠この晩は少し疲れて苦しかつた。",
              "citation": {
                "source": "海阪",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "山吹のにほへる妹が。",
              "citation": {
                "source": "長塚節歌集　上",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろはにほへとはいつでも同じ順にあらわれてくる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "――落ちて仄白に　香にこそにほへ。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "狂ほへる酒に夢みる情緒と、あたゝかき抱擁に微睡む官能とは、時來るや突如として眼覺め、振盪して微妙なる音樂を節奏し、閃めき來つて恍惚たる繪畫を點綴す。",
              "citation": {
                "source": "女郎買の歌",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "かすかにも囃子はきこえ、笛まじり風もにほへど、父のまたゆるしたまはぬ歌舞伎見をなにとかすべき。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はづかしさの顔をおほへどつゝむにあまるうれしさがこぼれでる――わたしのたもと。",
              "citation": {
                "source": "どんたく",
                "author": "絵入り小唄集",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろはにほへとと同じことを枕の上で繰り返して見たり、一二三四と何べんとなく数えて見たりして、どうかしておれは眠りたいと思った。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いろはにほへとの五つ目か」「ええ？",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "うるほひの少なき枯竹を集めて火を點ずれば、うるほへる枯木枯竹も燃ゆ。",
              "citation": {
                "source": "十和田湖",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓄堂左の小山を指して曰く、『これ太田道灌が攻落して、「小机は先づ手習の初にて、いろはにほへとちり／″＼になる」と咏みたる小机城の跡也』。",
              "citation": {
                "source": "町田村の香雪園",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜜柑の木｜門をおほへる小菴を悲しむ家に友与へんや　相州吉浜の真珠荘は作者の最も親しい友人の一人有賀精君の本拠で、伊豆の吉田の抛書山荘と共に何囘となく行かれ、ここでも沢山の歌がよまれてゐる。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
