    "definitions": [
      {
        "index": 1,
        "gloss": "catching and killing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "狂犬病の疑いがある野犬が市街地に出没したため、住民の安全を優先して捕殺する苦渋の決断が下された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "害獣として指定されているイノシシを捕殺するため、猟友会が山あいの地域に罠を設置した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "かつてこの川では増えすぎた外来魚を捕殺していたが、最近はキャッチ・アンド・リリースが推奨されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "こうして年を経るうちに、百数頭を捕殺した。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "酉陽雑爼（唐）",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも両者の比較価格は、資本の形成と動物の捕殺との両者に投ぜられた現実の労働に比例するであろう。",
              "citation": {
                "source": "経済学及び課税の諸原理",
                "author": "PRINCIPLES OF POLITICAL ECONOMY AND TAXATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "捕殺を禁止しようとするならば、ムジナと訳して書くか、少なくとも狸すなわちここでムジナという獣と、明示する必要があった。",
              "citation": {
                "source": "狸とムジナ",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "（３）（４）叢書『説鈴』（第六冊）に収むる所の張氏の『使琉球紀略』に語言二十余箇を摘録せるを見るに大を倭捕殺（ウフサ）とせり。",
              "citation": {
                "source": "南嶋を思いて",
                "author": "――伊波文学士の『古琉球』に及ぶ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "官民、捕殺ニ力ヲ協スト雖モ、虎爪血ニ飽カズ、惨害日ニ増スノミナリ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
