        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日本人はメリヤスの肌着をホワイトシャーツと同じもののやうに心得てゐるが如くなれどこれ甚しき誤なり。",
              "citation": {
                "source": "洋服論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホワイトシャーツは譬へば婦人の長襦袢の如し。",
              "citation": {
                "source": "洋服論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホワイトシャーツにはカラアをつける。",
              "citation": {
                "source": "洋服論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホワイトシャーツもまたその如し。",
              "citation": {
                "source": "洋服論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "米国人は酷暑の時節には上衣を脱しホワイトシャーツ一枚になつてをる事もあれど、この場合にてもメリヤスの肌着は見えぬやうに注意するなり。",
              "citation": {
                "source": "洋服論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホワイトシャーツの袖口高く巻上げ腕を露出せしむる時にもメリヤスの肌着は見せぬやうにするなり。",
              "citation": {
                "source": "洋服論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "○暑中用ふるホワイトシャーツには胸の所軟く袖口も糊ばらぬものあり。",
              "citation": {
                "source": "洋服論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
