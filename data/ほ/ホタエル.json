        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「こら、子供たち、そんなにほたえるんじゃない！」と先生が注意した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は酒が入ると、いつも陽気にほたえて周りを笑わせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "庭で犬が嬉しそうにほたえ回っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そういうピムキンの声と、　――他人の不仕合わせ見てほたえるでねえ、ピムキン！",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to take advantage of",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
