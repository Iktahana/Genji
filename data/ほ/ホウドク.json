        "examples": {
          "standard": [
            {
              "text": "僧侶がお経を厳かに奉読し、法要が始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "古い巻物に書かれた貴重な文献を、専門家が丁寧に奉読した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「皆さんも、この聖典を心静かに奉読してください。」導師が促した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "頬ひげをあたつてゐると、大詔の奉読、つゞいて、東条首相の謹話があつた。",
              "citation": {
                "source": "真珠",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
