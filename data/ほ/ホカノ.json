        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ナゼナラバ、我輩ハ英語ニ於イテ、聞キトルコトモ、言ウコトモ、ソノホカノコトモ、スベテ赤子ノ如キデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エエ、モウ　スグ、オンモガ　ミラレマス」ト　ホカノ　ツボミガ　コタヘマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　花タチハ　ジブンタチノ　スガタヲ　ナガメアヒ、ジブンタチカラ　ナガレデル　ニホヒヲバ　カギアツテ、ジブンタチガ　ミナ　オナジヤウニ　キイロイ　キモノヲ　キテ　ヲリ、ホカノ　木ヤ　クサニ　マケナイホド　ウツクシイノヲ　シツテ　イツソウ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシタチニハ　ナンニモ　キコエヤシナイ」ト　ホカノ　タケノコタチハ　イヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トウトウ　コノ　タケノコハ　ホカノ　タケノコタチト　ワカレテ、カキネノ　ソトニ　アタマヲ　ダシテ　シマヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモハ　ナカヨシダツタノデスケレド、アンマリ　マンナカノ　ホシガ　サムイ　サムイト　イフノデ　ホカノ　二ツノ　ホシニ　イジメラレタノデシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ、ホカノ　ヒトニハ　トウトイ　モノデ　アツテモ、ジブンニハ　チツトモ　トウトクナイ　コトモ　アルノダ、ト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
