          "literary": [
            {
              "text": "繁青年に話しかけられ、今度の事件に捲き込まれたのも、このホアンプーの河岸なら、この不思議な夜遊神に、突然話しかけられて、不思議な処へ連れて行かれるのも、このホアンプーの河岸だ。",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのホアンプーは俺の宿命だ！",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホアンプーは私の宿命でした。",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
