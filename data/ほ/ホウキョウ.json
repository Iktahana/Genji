        "examples": {
          "standard": [
            {
              "text": "ルネサンス期の絵画に描かれる女性たちは、豊胸でふくよかな体つきをしていることが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼女はドレスを美しく着こなすため、胸元が開いたデザインで豊胸を強調するスタイルを選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "グラビアアイドルとしてデビューした彼女は、その豊胸と愛らしい笑顔でたちまち人気を集めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
