[
  {
    "uuid": "ae6bb6fa-4da5-5bd5-8eba-98ebe7e522fa",
    "entry": "骨なし",
    "reading": {
      "primary": "ほねなし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-の形容詞",
