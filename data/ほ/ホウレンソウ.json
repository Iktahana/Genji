        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新入社員の研修で、まず叩き込まれるのが仕事の基本である報連相だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「報連相を怠ったから、こんな大きなミスに繋がったんだぞ！」と部長が激怒した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "チーム内での報連相を徹底することで、業務の効率が飛躍的に上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ほうれんそうがだんだんとよくなった。",
              "citation": {
                "source": "三八九雑記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほうれんそうはたくさん播いた割合にはよくないが、新菊はよかった。",
              "citation": {
                "source": "雑記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなうつくしいけしきも、この鏡にうつすと、煮くたらしたほうれんそうのように見え、どんなにりっぱなひとたちも、いやなかっこうになるか、どうたいのない、あたまだけで、さかだちするかしました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "胡瓜が六十四銭、南瓜が四十五銭、茄子が五十六銭、トマトが六十二銭、大根が十九銭、里芋が五十八銭、葱が五十二銭、結球白菜は四十一銭、ほうれんそう五十銭、莢碗豆八十八銭、きゃべつは四十一銭。",
              "citation": {
                "source": "食べもの",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
