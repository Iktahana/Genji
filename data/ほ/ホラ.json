  {
    "uuid": "2c18263f-2607-5972-aaa8-e62881986e0b",
    "entry": "ホラ",
    "reading": {
      "primary": "ほら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ホラホラ、これが僕の骨――見てゐるのは僕？",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その先頭ではホラ貝を吹いてゐた。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホラ見ろ、そんな話は、時候外れだらう」とＡは思ふ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その笑ひは恰かも、「わたしはあれが弁慶の頓智だといふことを知つてるのですよ知つてるのですよ、あなた方もでしよ、さうでしよ、ホラホラさうぢやありませんか」と云つてるやうである。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホラ、二人で何か相談してる。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "可愛い顔をしてらあ、ホラ、口ん中に汗が流れ込まあ」　彼は、暫く凭れにかかって、少年を観察していた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホラ電車賃だ」　そこで私は、十銭銀貨一つだけ残して、すっかり捲き上げられた。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあとでいくらでも話はつくじゃないか、ホラ、またわめいた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホラなんか吹かずに、もっとさっぱりと単純な人になりましょう。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "濁酒の面には蝋燭の焔がチラホラとうつつて居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな姿が、チラホラ見えた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "村人の話ではこの鳥は一つのホラ（山あいの木のたくさん繁ったところ）にはただ一羽しかいない。",
              "citation": {
                "source": "交尾",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして他の瑠璃がそのホラへはいって行くと喧嘩をして追い出してしまうと云う。",
              "citation": {
                "source": "交尾",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドッドド　ドドウド　ドドウド　ドドウ、　甘いざくろも吹き飛ばせ　酸っぱいざくろも吹き飛ばせ　ホラね、ざくろの実がばたばた落ちた。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかには一度もマイコンにさわったこともない幹部もいるとかで、事前に手渡された『マイコン操縦法入門』と題するテキストをみながら、実際に社内のマイコンを動かし、予習に取り組む姿がチラホラ目立ち始めている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "アップル※が発表され、数多くのホラ吹きどもが講演者となってパーソナルコンピューターの未来にかける夢を思うままに語り、十代も半ばの小僧が紙テープに記録したソフトウエアを売り、山と詰まれた広告ビラがバタバタとはけていく先駆者達の祭りで、古川は完全に熱に浮かされた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホラ Bur-marigole ――そばッかすの薬。",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホラ Myosotis、ホラ菫……ア、これはネ、お前さんにあげようと思ッて摘んできたのですよ」ト言いながら、黄ろな野草の花の下にあッた、青々とした Bluebottle の、細い草で束ねたのを取りだして「入りませんか？",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "――しかもホラご覧の通り両方とも銀で修繕してあるだろう。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハーフィズもホラティウスと同じ感性を持っている、世の知恵もまたしかりだ！",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨が降り出したのは一時で、ハリ・マーチャと会って――ああ、ホランド並木道が持ち場のやつで――で、ヘンリエッタ街の角で立ち話なんてして、ちょっとして――たぶん二時すぎくらいかな――もう一回りくらいして、ブリクストン通りまで何ともねえか確かめてやろうと思ったんです。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ブリクストン通りにて今朝、飾りのない金の結婚指輪を、居酒屋白鹿亭とホランド並木道の間の道で拾得。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "されどホラチウス・コクレスが戰ひし處には、今｜筏に薪と油とを積みてオスチアに輸るを見る。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ答へて、己れは専門の學をなさずと雖、凡そ宇宙の事は一として我研究の資料ならぬはなし、己れは詩人たらんと心掛くるなりと云へば、彼手を拍ちて喜び、ホラチウスが句を朗誦し、我琴を以てヨヰスの神の龜甲琴に比したり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "後には集りて一瓶の「フアレルノ」（フアレルナに産する葡萄酒）を傾け、ホラチウスが詩を歌はんと云ふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "句々洗錬の足らざるが恨なり、ホラチウスの教を知らずや、唯だ放置せよ、放置してその熟するを待てといへり、おん身の作も亦然なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハツバス・ダアダアは再びホラチウスの教を忘れ給ふなと繰返しつゝも、猶｜慇懃に我手を握りて、詩人よ、懋めよやと云ひぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
