        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ホーホケキョ」「あ、鶯かしら」　雀が二羽｜檜葉を揺すって、転がるように青木の蔭へかくれた。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホーホケキョ」　口笛だ。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホー、ホケッキョ。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度はホーホケキョとやる、（これは自分の名の暗號であつた。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度はホーホケキヨとやる、（これは自分の名の暗号であつた。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホーホケキョ、ホーホケキョ」「オヤ、鶯がやって来たな。",
              "citation": {
                "source": "梅のにおい",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに隠れてまっていてやろう」「ホーホケキョ、ホーホケキョ、ケキョ、ケキョ、ケキョ、ケキョ、ケキョ」　と言ううちに鶯は、斑のいる梅の木のすぐそばにある梅の花のたくさん開いたほそい枝の処へ、ヒョイととまりました。",
              "citation": {
                "source": "梅のにおい",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホーホケキョ、ホーホケキョ」　と鶯は隣のうちの梅の木で鳴いていました。",
              "citation": {
                "source": "梅のにおい",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕がホウヽホケキョとやると、隣の家のほうでもホウヽホケキョとやる。",
              "citation": {
                "source": "嵐",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホウ、ホケキョ――ケキョ。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前も一つやってみないか」　定雄は笑いながら千枝子にそう云って、「ホー、ホケキョ、ホー、ホケキョ」とやるのであった。",
              "citation": {
                "source": "比叡",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭には裏表とも梅の木が多くて、生活の叫びを立てるチヨン／＼のさゝ啼きが、竹藪を出て、ホーホケキヨと戀愛の歌をうたふ頃になると、あの黄色い小鳥は、二羽も三羽もこの閑寂な梅林へ來て遊んだ。",
              "citation": {
                "source": "天滿宮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ごとか平馬に話しかけでもするように、小さな口を開けたかと思うと、ホウホケキョと一声。",
              "citation": {
                "source": "平馬と鶯",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "闇討の相談「ホウホケキョ！",
              "citation": {
                "source": "平馬と鶯",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ホウホケキョと鳴くうぐいすの声と、それよりもっと朗かで優しい少女の微笑とに送られて、平馬は往来へ出た。",
              "citation": {
                "source": "平馬と鶯",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホウホケキョというその啼き声は、はじめはかなり遠くの方でしていたが、それがだんだん近づいてきて、今度はどこか家の近くで大きくはっきりと啼くのが聞えた。",
              "citation": {
                "source": "平馬と鶯",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "筑波おろしの春風のなかに、ホウホケキョと鶯が啼くとき、若侍は公正な微笑を交わして勇ましく立ち合うのだった――。",
              "citation": {
                "source": "平馬と鶯",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホウホケキョー、どこか近くの木で鶯が鳴いている。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまにホウホケキヨなんて鶯みたいに鳴き出すからつて、離れてゐる小学校の先生が憎まれ口をきくのですが、魚は鱗を見ただけでもぞつとする私には、まるでお伽話の世界です。",
              "citation": {
                "source": "谷間からの手紙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホウホケキヨつて鳴くぢやないの、健ちやんのは、それ、烏と間違へてるンんでせう、――そんな大きな鶯つてゐませんよ‥‥」　ふつと、ふじ子は眼をあけて、蚊帳のすみに轉がつてゐるちづ子を自分の方へ抱きよせてやつた。",
              "citation": {
                "source": "濡れた葦",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホーホケキョ　ホーホケキョ　うぐいすは梅の枝にとまって二声三声さえずりました。",
              "citation": {
                "source": "うぐいす",
                "author": "原民喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
