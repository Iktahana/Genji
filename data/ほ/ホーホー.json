        "examples": {
          "standard": [
            {
              "text": "夜の森で、フクロウがほーほーと寂しげに鳴いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ほーほー、いい声だね」と、子供がフクロウの真似をして遊んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "窓の外から聞こえてくるほーほーという鳴き声が、心地よい子守唄になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そろそろ　フクロウが　ほーほー　言い出す　森には、　せめて　うめてくれれば　いいような　ぶきみな　ものが　ごろごろしています。",
              "citation": {
                "source": "きつねめさんのはなし",
                "author": "THE TALE OF MR. TOD",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
