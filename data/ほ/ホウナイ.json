          "literary": [
            {
              "text": "目前の欠乏を救ふ一策としては、町民にして皇居の諸門を衛る法内と謂ふ者四家あり。",
              "citation": {
                "source": "禮嚴法師歌集",
                "author": "與謝野禮嚴",
                "note": "青空文庫"
              }
            },
            {
              "text": "猶かの法内より町家に勧誘し、朝廷より御朱印寺にも命ぜられしかば、白木の箱に献金の札を立て競うて参与所に集るもの、同月十五六日頃に亘り陸続として絶えざりき。",
              "citation": {
                "source": "禮嚴法師歌集",
                "author": "與謝野禮嚴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
