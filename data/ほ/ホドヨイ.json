        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ケーキの甘さは、私にとって程よい甘さだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はどんな状況でも、程よい距離感を保つのが得意だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この部屋の照明は、読書をするのに程よい明るさだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
