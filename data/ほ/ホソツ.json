[
  {
    "uuid": "a5223e01-e05a-5e0d-b806-6c492008893d",
    "entry": "歩卒",
    "reading": {
      "primary": "ほそつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
