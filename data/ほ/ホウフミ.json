          "literary": [
            {
              "text": "和英宝文館　竹原のスタンダード和英大辞典研究社　大和英辞典日英社　斎藤の和英大辞典「ポケット型で役に立つようなのは無い」とありました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "交叉点の一角を占有している千四百余坪に上る空地に、私の計画した東宝文芸会館の構想は、今や青写真の残骸となって、書斎の一隅に永久に眠っている。",
              "citation": {
                "source": "アーニイ・パイルの前に立ちて",
                "author": "小林一三",
                "note": "青空文庫"
              }
            },
            {
              "text": "日劇四階へ、専務のとこへ行く、落成した東宝文芸ビルの移転通知に「日劇ステージショウ及各劇国けい古場」と印刷してあったが、各劇団なんて書かずに、東宝劇団とか古川緑波一座とかして呉れと申し入れる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三時に東宝文芸ビルへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時すぎ着、東宝文芸ビルへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "まっすぐ東宝文芸ビルへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時に梅田映画へ行き、東宝文芸部の大山と会ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "東宝文化ニュース劇場へ入り、トビスの、サッシャ・ギトリー主演「とらんぷ譚」を見る、徳川夢声の声が入ってゐてたのしかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の古文書に小貝川の土手の出來たのは寶文七年だとあるから、低地の水の乾きはじめたのも其頃からであらう。",
              "citation": {
                "source": "筑波ねのほとり",
                "author": "横瀬夜雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
