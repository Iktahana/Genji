[
  {
    "uuid": "14ae490e-e1be-50f8-8db1-abcc8b3f8072",
    "entry": "ほじくる",
    "reading": {
      "primary": "ほじくる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
