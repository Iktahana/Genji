    "definitions": [
      {
        "index": 1,
        "gloss": "humbly presenting something",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "戦没者慰霊碑に花を奉奠し、平和を祈った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は故人の霊前に静かに香を奉奠した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
