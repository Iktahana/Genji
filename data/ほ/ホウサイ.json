        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "近郷ノ人是ヲ耕作神ト呼ビテ、社前ノ土ヲ請持ユキテ田畑ヘホドコセバ、必五穀豊熟スト云、又報賽ニハ其郷土ノ土ヲ持来リ奉納セリ。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この日｜報賽の徒多く岡の上に灯火見え伏鉦の音聞えたり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
