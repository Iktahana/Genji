        "examples": {
          "standard": [
            {
              "text": "このケーキ、一口食べたら、もうほっぺたが落ちそう！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「わー、このお寿司、本当にほっぺたが落ちるくらい美味しいね！」と彼は言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "おばあちゃんの手料理は、いつもほっぺたが落ちるような美味しさだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そしてむしゃむしゃたべるまねをして、ほっぺたがおちるくらい、おいしいぞという顔をしてみせました。",
              "citation": {
                "source": "電気鳩",
                "author": "海野十三",
