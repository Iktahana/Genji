        "examples": {
          "standard": [
            {
              "text": "彼の奔放不羈な性格は同僚からも好かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "奔放不羈に生きることは難しいかもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その画家の奔放不羈な作風は革新的だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "むしろディオニソス的なる、奔放不羈の自由を欲求してゐた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奔放不羈、と先生は私のことを云われたが、それは先生が少年の血気を咎められなかったからである。",
              "citation": {
                "source": "前途なお",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
