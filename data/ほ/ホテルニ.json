          "literary": [
            {
              "text": "アタミホテルニ来遊ノ旨、歓迎ト答ウ。",
              "citation": {
                "source": "父の手帳",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ前ノ所ヘモイズレ一晩ハ厄介ニナルガネ、今日ハ取リ敢エズ京都ホテルニ泊ルヨ」餘計ナオシャベリガ始マラヌウチニト、急イデ車ニ乗ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰途五子同伴たんくまノカウンターニ腰掛ケテ食事シ、二時頃ホテルニ帰ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハマダホテルニ帰ッテイナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "迎賓館に通じる大通りを渡り、四谷見附橋を渡り、最後に赤信号を無視してホテルニューオータニに抜ける小さな横断歩道を小走りに渡ると、北門から上智大学に入った。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜は熱海の延寿旅館へ、「歌ふ弥次喜多」続編を書きに行くのだが、汽車迄に間があるので、帝国ホテルニューグリルへ藤山と行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者へ寄り、ホテルニューグリルで食事。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルニューグリルへ行き、コンソメ、キスのフライと犢のエスカロップを食った、犢の大きさには参った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "憂鬱になり、ホテルニューグリルで、オニオングラタンに、オルドヴル、コールビーフで食事し座へ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "終ると友田純一郎が来てホテルニューグリル。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "終って、ホテルニューグリルへ、樋口と吉本と提携興行の件につき語りつゝ、ミネストロンとハムエグス、メリンゲパイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルニューグリルで、オニグラとミニツステーキをやり、座へ出ると今日も補助椅子がワンサと出てゐる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『アノホテルニスル？",
              "citation": {
                "source": "赤い手帖",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
