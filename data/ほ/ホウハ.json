  {
    "uuid": "3cfe20b9-6b37-5850-9e7c-e7081e3432e6",
    "entry": "方は",
    "reading": {
      "primary": "ほうは",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
