        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "プラツトホオムのざはめきもよそに車室の中は變に暫く鎭まり返つてしまつた。",
              "citation": {
                "source": "女盗",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、さうした間に何分かが過ぎて、やがて速度を弛め出した汽車は米原驛のプラツトホオムに靜に滑り入つた。",
              "citation": {
                "source": "女盗",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は窓をあけて冷たい風に頬吹かせながら、プラツトホオムを急ぎ足に歩いて行く女の姿をぢつと見送つてゐたが、遠くのブリツヂの階段を二つの白い點のやうに撥ね上る白足袋がふと視野から消えた時、　「二人はぐるだつたんだな……」　さうした意識が不意に鋭く頭の中に閃いた。",
              "citation": {
                "source": "女盗",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま庭の草むしっている家人の姿を、われ籐椅子に寝ころんだまま見つめて、純白のホオムドレス、いよいよ看護婦に似て来たな、と可哀そうに思っています。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドイルだって、あの名探偵の名前を、シャロック・ホオムズではなく、もっと真実感を肉薄させるために、「私」という名前にして発表したなら、あんな、なごやかな晩年を享受できたかどうか、疑わしい。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トラホオムかも知れない。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その茶店の床几は、謂わば私のホオムコオトである。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸をどきどきさせて、アンデルセン童話集、グリム物語、ホオムズの冒険などを読み漁った。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "車を下りてプラツトホオムのたたきを歩いて居ると、改札口に若い女が美しい洋装で立つて居る。",
              "citation": {
                "source": "畜生道",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "……つれはまだかと、待合室からプラットホオムを出口の方へ掛った処で、私はハッと思いました。",
              "citation": {
                "source": "甲乙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "支度しに宿へ帰った彼女に約束した時間どおりに、定めのプラットホオムへ行ってみると、葉子の姿が見えないので、彼は淡い失望を感じながらしばらく待ってみた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく新調の外套を着た葉子がせかせかとプラットホオムへ降りて来た。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し前方に、大きな灯のついた家がひとつあってお祖母さんは指をさし、「あれが坂本さんのホオムだよ」と申されました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "郡視学が校長に与へた注意といふは、職員の監督、日々の教案の整理、黒板机腰掛などの器具の修繕、又は学生の間に流行する『トラホオム』の衛生法等、主に児童教育の形式に関した件であつた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "四番の上りは二十分も後れたので、それを待つ旅客は『プラットホオム』の上に群つた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人はその間を辛うじて抜けて、広いプラットホオムに出た。",
              "citation": {
                "source": "蒲団",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "障子は妙にアト・ホオムな感じを抱かせる。",
              "citation": {
                "source": "獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら馴れているからと言っても、そうすぐにアトホオムとは行かない。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人の小説に「ジヨン・サイレンス」と云ふのがあるが、そのサイレンス先生なるものは、云はば心霊学のシヤアロツク・ホオムス氏で、化物屋敷へ探険に行つたり悪霊に憑かれたのを癒してやつたりする、それを一々書き並べたのが一篇の結構になつてゐる訣です。",
              "citation": {
                "source": "近頃の幽霊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は風の寒いプラットホオムへ下り、一度橋を渡った上、省線電車の来るのを待つことにした。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "急いで停車場から飛出した私は、また大急ぎでプラツトホオムヘ飛込みました。",
              "citation": {
                "source": "日記のうち",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは何時のまにかプラツトホオムへ降りて居ました。",
              "citation": {
                "source": "戸の外まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、そこのプラットホオムに四十五六の紳士がいて、僕のいる車室へ乗り込んで来た。",
              "citation": {
                "source": "蝗の大旅行",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
