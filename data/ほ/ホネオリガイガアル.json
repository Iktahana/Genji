        "examples": {
          "standard": [
            {
              "text": "苦労して作った料理が美味しいと言われると、骨折り甲斐がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "難関の試験に合格した時、今までの骨折り甲斐があったと感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "準備に数ヶ月を費やしたプロジェクトが大成功を収め、本当に骨折り甲斐があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、世の言葉に、　――容貌は、吊り合わぬ方が仲がいい――　という話があるから、女としては最高学府を出ていることだし、ことによったら骨折り甲斐があるかも知れない。",
              "citation": {
                "source": "縁談",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
