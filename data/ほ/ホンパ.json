          "literary": [
            {
              "text": "十里廷無河上塵、収容七百万余民、街皆築岳高低屋、路自翻波来去人、管道車中夜欺昼、水晶宮裏夏猶春、日新月盛成其美、天下何都能比倫。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "油皿は蓮葉の一端を翻波式に反らし、それにつけた茎の、またなんとしっかり力をもっていることであろう。",
              "citation": {
                "source": "古器観道楽",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは弥撒書といふよりも、翻波式の平脱鏡。",
              "citation": {
                "source": "希臘十字",
                "author": "高祖保",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
