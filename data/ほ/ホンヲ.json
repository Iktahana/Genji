          "literary": [
            {
              "text": "オヒルノ　ヤスミノ　トキ、ヨシダセンセイニ　イヒツカツテ　タキクンハ、トウサンノ　トコロヘ　ホンヲ　モツテ　イキマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　コハゴハ、ホンヲ　トウサンニ　ワタシマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンダカサムクツテシカタガナイカラ、コノナカデ、ホンヲヨミマセウ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ヨツピテグツスリネコンダノニ、マダネタイデスガ、メガサメテシマツテネムレナイノデ、ホンヲヒロゲテヨミマセウトシマストキウニ、マドノスグソトデ、パタパタトハシリマハルオトガシマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トヒトリデ、ブツブツオコリナガラ、マタホンヲヨミハジメマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
