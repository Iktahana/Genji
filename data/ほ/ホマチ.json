  {
    "uuid": "97334df1-a1f5-501e-b57e-8064c9130e3d",
    "entry": "ホマチ",
    "reading": {
      "primary": "ほまち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
