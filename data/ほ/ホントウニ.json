    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ホントウニ　ソウデスヨ、ワタシモ　ハヤク　ボウヤニ　コノ　ヨイ　セカイヲ　ミセテ　ヤリタクテ　タマリマセン」ト　ウマハ　コタヘマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ　ワカイノニ　オトウサンモ　オカアサンモ　キヨウダイモ　ナク、ホントウニ　ヒトリボツチデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　ウチニ　オバサンハ　スツカリ　ウバグルマノ　ナカヲ　カタヅケテ、「スミマセンデシタ、ホントウニ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポストハ　ウシロヲ　ミルト、ソコニ、ホントウニ　ブカツカウナ　ジブンノ　カゲガ　アリマシタノデ　アカク　ナリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ホントウニ男らしい……」　フラウの眼に、涙が一パイに浮き上りました。",
              "citation": {
                "source": "奥様探偵術",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月九日さよなら　幸恵より　愛する御両親様　　　　　　　　御前に伊藤元子宛（北海道・名寄）大正十一年五月頃（東京発信）御タヨリヲ下サイマシテ、ホントウニ有難ウゴザイマシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントウニ、ヨシヲサンノオ母サンノ言ツタトホリナンデスモノネ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ苦シイ俺ハ遊ブ▽ノすりつぱーハ菓子ト同ジデナイ如何ニ俺ハ泣ケバヨイノカ　　　　　×淋シイ野原ヲ懐ヒ淋シイ雪ノ日ヲ懐ヒ俺ノ皮膚ヲ思ハナイ記憶ニ対シテ俺ハ剛体デアルホントウニ「一緒に歌ひなさいませ」ト云ツテ俺ノ膝ヲ叩イタ筈ノコトニ対シテ▽ハ俺ノ夢デアルすてつき！",
              "citation": {
                "source": "破片ノ景色――",
                "author": "△ハ俺ノ AMOUREUSE デアル",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナカンズクソノ下半身ヲホントウニ残ル隈ナク見ル、下腿部ガヤヤＯ型ニ外側ヘ彎曲シテオリ、遺憾ナガラマッスグトハ云イニクイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フト僕ハ、妻ハホントウニ寝テイルノデハナイ、タシカニ寝タフリヲシテイルノニ違イナイト思ワレテ来タ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ最初ハホントウニ寝テイタラシイガ、途中カラ眼ガ覚メタノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「彼女ノ性質カラ推シテ、果シテホントウニ睡ッテイタノカ寝タフリヲシテイタノカ、ソノ点ハ疑ワシイ」と夫が書いているあの二日間、私は決して「寝タフリヲシテイタ」のではないが、そうかといって完全に意識を失いつづけていたとは云いがたい。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
