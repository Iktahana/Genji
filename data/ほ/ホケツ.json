    "definitions": [
      {
        "index": 1,
        "gloss": "filling a vacancy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "委員会の欠員を補欠で埋めることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は急な病欠者の補欠として、重要なプレゼンを務めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "補欠の弁護士が、直前になって担当を代わることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その年の九月、第二学期はじめに補欠を採る中学校のあるのを聞いて、その少年は編入試験を受けたのでしたが、今度は立派に合格しました。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "抗弁をしようとして御面師は一膝乗り出したのだが、自分もやはり担がれる部の補欠になつてゐるのかと気づくと、舌が吊つて言葉が出せぬらしかつた。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドレゴの補欠を希望する者は出て来なかった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "抗弁をしようとして御面師は一膝乗り出したのだが、自分もやはり担がれる部の補欠になっているのかと気づくと、舌が吊って言葉が出せぬらしかった。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、翌年の秋には、東京中学の五年の二学期の補欠試験に合格している。",
              "citation": {
                "source": "山本有三氏の境地",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "水兵のジャン君が話した、いわゆる Mutins de La Mer Noire（黒海の謀叛人）の首領、共産党の何とかという男は、まだ牢にはいっていたが、僕がフランスを出る数日前に、パリ近郊の下院代議士補欠選挙の候補者として、未曽有の投票数で当選した。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "明朝早くの出帆だから、いま補欠が見つからなけりゃあ、今夜じゅうに一人「上海」しなくちゃならないんだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "しっぷ・あほうい！",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに、四八年に入ってから地方の補欠選挙において地方放送局のある所では、民主的立候補者のために不利な差別的扱いをした例がある。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ分厚い近眼鏡の下から、白い眼でジロリと教室の内部を見廻わしただけで、そのまま自分の椅子に腰を卸すと、彼の補欠をしていた末席の教員を招き寄せて学科の引継を受けた。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "猛之介は、町会議員の補欠がどうこうということで朝飯をしまうと耳の遠い岩本と番傘をさして出て行った。",
              "citation": {
                "source": "昔の火事",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "東海さんや、補欠の有沢さんを中心とする惚け話や、森さんや松山さんを囲んでの色話も、盛んなものでした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした夕食後の一刻を、やはり新人の為、仲間はずれになっている、ＫＯのフォアァの補欠で、銀座ボオイの綽名のある、村川と、一等船客専用のＡ甲板を――Ａデッキを練習以外には使うな、などという規則が守られていたのは、初めの二三日でした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "「行って見ようや」とぼくは村川を誘い、ＫＯの二番の柴山、補欠の河堀とも一緒になって、デッキを降り、食堂に入って行きますと、映画は始まっていて、代表選手の練習を集めた実写物らしく女子選手のダイビングが、空中に美しい弓なりの弧を描いているところでした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "新式の――」と補欠の佐藤が、憎らしく、お節介な口を出すと、皆がどッとふきだしました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "艇を借りるとき、世話を焼いてくれた、親切な南加大学の補欠漕手の上背も、六尺八寸はあり、驚かされたことでした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "補欠の佐藤は戦死したと聞きました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私は商人だからな、政党にはあまり深入りせんようにしている」　こういつもいっていた父が、急に選挙に熱してきたことをふしぎに思った、選挙は補欠選挙であるから、たったひとりの争奪である、だがひとりであるだけに競争がはげしい。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "正ちゃんは　ほけつで　きて　いると、あいての　西校の　せんしゅたちは、ほんとうに　よく　うちました。",
              "citation": {
                "source": "はつゆめ",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "また平子君新発見の補闕記の問題にしたところで、この書がよしや信ずべき古書であるとしても、何分それは日本紀以後のものであり、ことに民間の一私撰である以上、むしろその方が誤りであるとして論ずる事も容易である。",
              "citation": {
                "source": "法隆寺再建非再建論の回顧",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に平子君の補闕記による新発見は、畢竟法隆寺の堂塔を以て推古朝の物なりとする先入観に捉われたもので、単に史料としての日本紀と補闕記との価値を比較したならば、これは到底相撲にならぬものであると謂わねばならぬ。",
              "citation": {
                "source": "法隆寺再建非再建論の回顧",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "法隆寺がかつて一屋無余ともいうべき程の大火災に罹った事は、寺院側の記録にも往々見受けるところで、「法隆寺災に罹るの後衆人寺地を定むる事を得ず」、分散して太子縁故の諸寺の造営に着手したとの事は平子君の引かれた補闕記や、法輪寺の古流記にも立派に認めたところである。",
              "citation": {
                "source": "法隆寺再建非再建論の回顧",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "草創に関しては二つの説があって、「聖徳太子伝暦」及び「太子伝｜補闕記」によると百済開法師、円明師、下氷新物等三人合力して建立したことになっているが、「御井寺勘録寺家財雑物等事」及び「古今目録抄」によれば太子の御子山背大兄王と由義王の創建されしところと伝えられる。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十八年（一九〇五、この小説の時期の前年）五月には同志から推されて東京市衆議院議員補缺選擧の候補にも立つた。",
              "citation": {
                "source": "小説「墓場」に現れたる著者木下氏の思想と平民社一派の消息",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に絶えず補缺を必要とする。",
              "citation": {
                "source": "支那の宦官",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "明の天啓元年（西暦一六二一）に、宦官の補缺三千人を募集した時に、應募者の實數二萬餘人に達した。",
              "citation": {
                "source": "支那の宦官",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "其頃は男子部もさうであつたらうが、女子部では毎年新入生から二三名宛再試驗の上二年に補缺入學を許可する例になつて居た。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
