          "literary": [
            {
              "text": "異教的良心の純粹なる發現に――ホメーヤやソフオクレスの人物が持つてゐる敵愾心の強健と雄大と崇高とに牽付けられて來た。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はホメーヤやソフオクレスやヨブやダ※デや基督や、ポーロや、聖オーガステインや、聖フランシスや、ダンテやゲーテを精神上の祖先に持つことを愧ぢない。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
