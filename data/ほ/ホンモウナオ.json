        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "家族のなかで姿を見せないのは、次男のタダオモウナオと、娘のホンモウナオとの二人だけである。",
              "citation": {
                "source": "霧の蕃社",
                "author": "中村地平",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、これより先討伐隊では彼の妹ホンモウナオを逮捕することができた。",
              "citation": {
                "source": "霧の蕃社",
                "author": "中村地平",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月七日ホンモウナオはマヘボ付近にある森林中でようやく兄に会うことができた。",
              "citation": {
                "source": "霧の蕃社",
                "author": "中村地平",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あした、討伐隊に頼んで米と酒とを貰ってきてくれ……」　ホンモウナオが兄の伝言をもたらした時、討伐隊は色めきたった。",
              "citation": {
                "source": "霧の蕃社",
                "author": "中村地平",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく彼らのするところを静観するよう――」　翌日ホンモウナオは討伐隊に手交された酒と米とをもって、兄のもとへと行った。",
              "citation": {
                "source": "霧の蕃社",
                "author": "中村地平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
