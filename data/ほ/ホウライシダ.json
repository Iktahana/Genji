        "examples": {
          "standard": [
            {
              "text": "蓬莱羊歯は、繊細な葉が美しいシダ植物だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "庭の日陰に蓬莱羊歯を植え、涼しげな空間を作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "蓬莱羊歯は湿った岩場を好んで生育し、庭の日当たりの悪い場所によく見られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "緑なるほうらいしだ（アヂアンツム）生ひ茂りて、深きところは唯だ黒くのみぞ見えたる。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
