          "literary": [
            {
              "text": "擦違うと、干鯣のような匂のする女だ。",
              "citation": {
                "source": "世間師",
                "author": "小栗風葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "青ぐろく引っ吊れている彦兵衛の顔を見ると、同心たちは、おかしくなったのであろう、干鯣を裂きながら、笑って云った。",
              "citation": {
                "source": "鍋島甲斐守",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "干鯣を持ったり、沢庵漬をかじったりして、慰労の酒に、兵たちが、はしゃぎ出した。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たった今、干鯣と酒を手にもって、天下国家を論じていたのかも知れない七人である。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "干鯣か魚屑のにおいだろうか。",
              "citation": {
                "source": "私本太平記",
                "author": "八荒帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
