[
  {
    "uuid": "13b9b64c-413f-5697-9d22-d189e337c730",
    "entry": "本軍",
    "reading": {
      "primary": "ほんぐん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
