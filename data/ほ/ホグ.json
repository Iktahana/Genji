[
  {
    "uuid": "59906267-4a46-5f1c-bc6e-a2d5c79bac4c",
    "entry": "祝ぐ",
    "reading": {
      "primary": "ほぐ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "文語四段-ガ行",
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あなゆかし、ロレンゾか、鐘鳴らし、まめやかに安息の日を祝ぐは、あな楽し、真白なる羽をそろへ鴿のごと歌はまし、わが子らよ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "空の大海に漂いながら絶え間無くうたう雲雀の歌など、地にも天にも春を言祝ぐ喜びの声が充ち充ちているが、若い放浪者の顔付には憂鬱ばかりが巣食っている。",
              "citation": {
                "source": "死の復讐",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれはお前たちを祝ぐぞ！",
              "citation": {
                "source": "老いたる素戔嗚尊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "あしびきの山の木末のほよとりて、かざしつらくは、千年｜祝ぐとぞ（万葉巻十八）家持の歌である。",
              "citation": {
                "source": "ほうとする話",
                "author": "祭りの発生　その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "×跪づき、諸手さし延べ、我れも言祝ぐ、新しき御代の光は国の内外に。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "即、農産を祝ぐ詞と言ふ考へから出たらしい。",
              "citation": {
                "source": "國文學の發生（第一稿）",
                "author": "呪言と敍事詩と",
                "note": "青空文庫"
              }
            },
            {
              "text": "島の宮のも、寿を祝ぐ為の目的から、伝来どほりの名を負せた代用動物だと定めてよい。",
              "citation": {
                "source": "万葉集研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "堅くひき結へた綱の結び目を、命の脱出を防ぐ結び目と見て祝ぐのである。",
              "citation": {
                "source": "日本文学の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の齢の頂上を祝ぐ八十八も旅のうちに過ぎ去って、その後の行蹟はわからない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "胆吹の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは「ことほぎ」（言祝）で、言葉で以て祝ぐの意であります。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホカイビトはすなわち「祝ぐ」人で、その語がただちに乞食を示すの語となっている。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "膳部の折敷には、ちょうど出陣か勝軍を祝ぐ時のように、昆布と栗などが乗っていた。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃ようやく、夜が明けて、海道の松のすがたの一つ一つも鮮やかとなり、東の方、播磨灘の水平線と横たわる黎明の雲のあいだに、真ッ赤な旭日が出陣の足なみを祝ぐようにさし昇っていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえ見たかやお城のにわに今が桔梗のさかり頃――　御城下の田や山で、この頃よくきく歌は、光秀様の善政を謳歌し、明智家の開運を祝ぐ声だった。",
              "citation": {
                "source": "茶漬三略",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
