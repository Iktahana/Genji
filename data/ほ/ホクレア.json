        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「完璧にグッドではないのだけど、アランを知っているという男たちと知り合った」「なるほど」「ホクレア号の航海のために、タヒチから来た男たちだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホクレア号も見たいし」「いつになる？",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アランを知っているのはタヒチから来た男たちだと、カアイラウは言っていた」「そうか、タヒチか」「ふたりいて、そのうちのひとりは、ホクレア号の大航海に参加するナヴィゲーターだそうだ」　後頭部で両手の指を組み合わせたラリーは、上体を反らせて天井を仰ぎ見た。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はハワイからタヒチまで航海するホクレア号の、正式な乗組員のひとりだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホクレア号の航海に関係しているのはピアイラグだけだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホクレア号にサーフボードを積みこむ許可が、今日、出たんだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホクレア号はとても小さく感じられた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホクレア号が湾の上で揺れ続けた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホクレア号の設計図は、そのような絵から作成された。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "星と風だけを頼りに、ホクレア号はすでにこの距離の大航海を、一度だけ成功させている。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠く離れてケッチが一隻ついて来たが、ホクレア号とは無線で交信しあうだけで、いっさいなんの手助けもしなかった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あと一時間とたたないうちに、ホクレア号はタヒチに向けて二度目の航海に出発する。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "レイモンドのようなポリネシアの血を引く人たちにとって、ホクレア号の航海は特別な意味を持っている。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分たちとはいったいなになのか、ハワイとはなになのかを根元的に考えなおし、民族の土台を現代のなかで新たに確認しようという動きに寄り添うように、ホクレア号の第一回の成功は、ハワイ系の人たちに大きな自信と誇りをもたらした。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの勇敢な行動力を現代によみがえらせたホクレア号は、いま重要な象徴になっている。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗組員たちが肉親や友人と抱き合っておたがいの幸運を祈っているあいだ、乗組員を沖のホクレア号にまでつれていくボートが用意された。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボートは沖のホクレア号まで彼らを運んだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗組員はホクレア号に乗り移り、誰もが自分の位置についた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホクレア号の錨が引きあげられた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "思いのほか速いスピードで、ホクレア号は湾の外に出た。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その簡素なありさまは、これからホクレア号が相手にする海の巨大さと力強さに、ふさわしいように感じられた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホクレア号の見えなくなった遠い水平線を、ひとりで見ていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホクレア号の出発を見送りにホノルルへいった日をのぞいて、ほかの日は毎日、フィルムとの格闘だった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカ海軍に」「それがどうした」「ホクレアが、ひっくりかえった」「ＮＯ！",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホクレアが打ちあげた照明弾を、海軍の飛行機が見つけた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
