        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "腥くさきオゾンのにほひ雫する穂麦のしらみ、今裂けし欅の大木燥るがごと疼くいたでに脂黒くしたたるみぎり、油蝉ぢぢと鳴き立つ。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "刈麦の穂麦は伏せて、畝竝にさららと置きぬ。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "穂麦の芳しい匂がした。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "桑の実の木曾路出づれば穂麦かな　けふより美濃路に入る。",
              "citation": {
                "source": "かけはしの記",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "丈高い穂麦の間を歩く時、二人は手を緊く握り合ってつないでいた。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "穂麦に交じつた矢車の花。",
              "citation": {
                "source": "長崎",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "畠には四十に近い女が一人せっせと穂麦を刈り干している。",
              "citation": {
                "source": "誘惑",
                "author": "――或シナリオ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば「さんた・るちや」の前に居並んだ奉教人衆は、風に吹かれる穂麦のやうに、誰からともなく頭を垂れて、悉「ろおれんぞ」のまはりに跪いた。",
              "citation": {
                "source": "奉教人の死",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　同文書院を見に行った時、寄宿舎の二階を歩いていると、廊下のつき当りの窓の外に、青い穂麦の海が見えた。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "奇麗に掃いた禾場に一面の穂麦を敷いて、男は男、女は女と相並んでの差向い、片足踏出し、気合を入れて、一上一下とかわる／″＼打下ろす。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "疾駆われ見てありぬ四月の晨とある農家の厩口より曳出さるる三歳駒を馬のにほひは咽喉をくすぐり愛撫求むる繁き足蹈くうを打つ尾のみだれ美し若者は早鞍置かぬ背にそれよ玉揺わが目の前を脾腹光りてつと駆去りぬ遠嘶のふた声みこゑまだ伸びきらぬ穂麦の末にわれ見送りぬ四月の晨",
              "citation": {
                "source": "詩集夏花",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨に折れて穂麦にせばき径かな　　　　尺艸　雨の降る日に穂麦畑に沿うた径を通る。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "「雨に折れて」というと、雨のために穂麦が折れたもののように聞えるけれども、実際は雨中の径に穂麦の先が折れ伏している、という意味であろうと思う。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "穂麦に雨を点じて、こういう小景を描いているのが面白い。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "折れ伏した穂麦を踏むまじとして、雨に濡れながら径を行く足のうすら寒さまで、この句から窺い得るような気がする。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
