[
  {
    "uuid": "f5ca6b7d-51a4-5863-9b3d-b1fa0f0e92b4",
    "entry": "ほわ",
    "reading": {
      "primary": "ほわ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
