        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「先生、聞いておくんなさるかい、難有え、こりゃ先生だとなほわかりが早い、対手はね、先生なんざ御存じじゃありませんか、歌の師匠ですよ。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（おほわた）來い、來い、まゝ食はしよ。",
              "citation": {
                "source": "五月より",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雜草の種子は纖毛に運ばれて、地面に近い所をおほわたと一所になつて飛びまはつてゐる。",
              "citation": {
                "source": "秋",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝しも山に分け入りて、谷の小蔭に唯一羽、鋭き嘴に萱さきて、巣をあむ振を認めしが、かへりて妹にささやくに、なほわが聲をはばかりぬ。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "六あはれ友よ、わかき日の友よ、今日もまた街にいでて少女らに面染むとも、な嘲みそ、われはなほわれはなほ心をさなく、やはらかき山羊の乳の香のいまも身に失せもあへねば。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "土さけて水わきあがり、いはほわれて谷にまろび入り、なぎさこぐふねは浪にたゞよひ、道ゆく駒は足のたちどをまどはせり。",
              "citation": {
                "source": "方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            },
            {
              "text": "否、寧われはおほわだの波うちぎはに夢みむ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "川崎新兵衞氏は、なほわれら二人を送つて、同じく汽車に乘る。",
              "citation": {
                "source": "十和田湖",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "又「雪降り小女郎」（一五五頁）とは、東京で云ふおほわたこわた（背に白き粉のある小虫の名）のことです。",
              "citation": {
                "source": "十五夜お月さん",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "失明の川を溯りて永遠の獄より脱れし汝等は誰ぞや　四〇―四二誰か汝等を導ける、地獄の溪を常闇となす闌けし夜よりいづるにあたりて誰か汝等の燈火となれる　四三―四五汝等斯くして淵の律法を破れるか、將天上の定新たに變りて汝等罰をうくといへどもなほわが岩に來るをうるか。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「勝手に約束なんかする法ないわ」「いやだあ、約束を守らなきや、なほわるいや。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それぢやね、うらみごと、なほわからないか。",
              "citation": {
                "source": "ある夫婦の歴史",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "元素智恵子は今でもなほわたくしの肉に居てわたくしに笑ふ。",
              "citation": {
                "source": "智恵子抄",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぞうさんがおこるほど、ねずみさんは、おほわらひしました。",
              "citation": {
                "source": "ゾウ　ト　ネズミ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お猫さんは、おほわらひしました。",
              "citation": {
                "source": "二階の窓までのびたチユーリツプ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくせ冷汗の滲みでさうな混乱がなほわけもなく沸き立ちつづけてゐたのだが。",
              "citation": {
                "source": "狼園",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "420滉瀁として靜かなるおほわだつみを昇り來る日輪天に耀きて光大地に觸るる時、トロイア・アカイア兩軍は又原頭に相會す。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "テネドス及びイムブロス、其險要の間にして、おほわだつみの淵の下、廣き洞窟あるところ、大地を震ふポセードーン、驅りし駿馬を留まらしめ、兵車よりして解き離し、アムブローシヤの食物を　35投げ與へつゝ、其脚を黄金の枷、堅牢に解き得ぬ枷に繋ぎとめ、こゝに再び自らの歸り來る迄留らしめ、かくてアカイア陣に行く。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "これよりぞわれは星をちりばめ乳色にひたるおほわたつみのうたに浴しつつ、緑のそらいろを貪りゆけば、其｜吃水蒼ぐもる物思はしげなる水死者の、愁然として下り行く。",
              "citation": {
                "source": "醉ひどれ船",
                "author": "LE BATEAU IVRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "お空の川櫻間中庸お空を流れる白い川ミルクの色の遠い川あれは鷺でせう　白い鳥ほつかりほわりと渡ります笹の葉に吹く風の音さらさら流れる音のやう鷺のお使ひ　二つ星ほつかりほわりと渡ります",
              "citation": {
                "source": "お空の川",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
