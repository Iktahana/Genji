          "literary": [
            {
              "text": "今になつて考へて見るとそれは「法官」であつたのであらう、それを口伝へに「ホーカン」といふたのが「幇間」と間違ふたので、法官と幇間の誤などは非常の大滑稽であつた。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイコモチにばかりかこまれて、半面自分自身のホーカン性によって。",
              "citation": {
                "source": "戦争・平和・曲学阿世",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
