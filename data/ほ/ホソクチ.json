        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さまざまな葡萄酒や甘露酒の罎がいろいろな形や質のジョッキや、水差しや、細口罎などと共に、その食卓の上一面に散らばっている。",
              "citation": {
                "source": "ペスト王",
                "author": "寓意を含める物語",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョッキや、水差しや、籠入りガラス罎などが、ごちゃごちゃに押し合いへし合いしながらまざり、柳細工の細口罎が厚いガラス罎とやけにぶつかる。",
              "citation": {
                "source": "ペスト王",
                "author": "寓意を含める物語",
                "note": "青空文庫"
              }
            },
            {
              "text": "お幸は細口の金の煙管にゆっくり煙草を填めて、ゆっくり鼻から、格好のよい円味を帯びたすぐれた鼻から、紫の閃きのある煙をすうっと吐き出した。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはその連中に任せておいて、手ぬぐい冠りのあだッぽい女は、細口の女煙管とたばこ入を帯の間から取り出して、馬の背に横乗りになったまま、どれ一服という姿に見えます。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大変なことになっちゃったわけだ」　ルビー・クイーンの細口の煙草をのみながら百成は言った。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
