          "standard": [],
          "literary": [
            {
              "text": "ホタホタ灯がつきそめて、駅の前は、桑畑、チラリホラリ、藁屋根が目につく、私はバスケットをさげたまゝ、ぼんやり駅に立ちつくしてしまった。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ホタホタと喜んでいる）デニス　畜生。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
