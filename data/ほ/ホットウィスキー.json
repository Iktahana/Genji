        "examples": {
          "standard": [
            {
              "text": "寒い冬の夜には、シナモンスティックを添えたホットウィスキーが体に染みる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "キャンプの焚き火を囲みながら、熱いお湯で割ったホットウィスキーを味わう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "寝る前に少しだけホットウィスキーを飲むと、リラックスしてよく眠れる気がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "私はホットウイスキーをのんでいたし、多少、私の死と結びつけて考えられたので、いたずら書きをしました。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アダリンとホットウイスキーのみて眠る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
