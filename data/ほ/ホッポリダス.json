        "examples": {
          "standard": [
            {
              "text": "彼は気に入らないものをすぐにほっぽり出す癖がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "部屋の隅にほっぽり出されていた古い雑誌を処分した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "使わないガラクタをクローゼットからほっぽり出して、整理整頓した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ちょうど寒いさかりで、毛糸編物屋のお母さんには仕事がたくさんつかえているし、それをほっぽり出すわけにはいかない。",
              "citation": {
                "source": "大根の葉",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルジョア・地主につらまって、自分らを放っぽり出す正しいプロレタリアート・農民の力を、ついでに〔一字伏字〕そうとかかっているのです。",
              "citation": {
                "source": "「モダン猿蟹合戦」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたが部屋をあけなければ、あなたの荷物を、道ばたへ放っぽり出すから！",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
