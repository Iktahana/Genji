        "examples": {
          "standard": [
            {
              "text": "今年は星回りが良く、何をやってもうまくいく気がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は最近、星回りが悪いのか、トラブル続きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "占い師は、私の今年の星回りが非常に良いと告げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "およそ世の中に、運命が自分の誕生の日の十干十二支（年回り）や、九宮二十八宿（星回り）なんぞによって前定していると信じたり、又は自分の持つ骨格や血色なんぞに因って、前定しているものと信じて、そして自分が幸運でないことを嘆く者ほど、悲しむべき不幸な人はない。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "星廻りや相性のことなども弁じて、独りで呑み込んでいた。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前は三碧木星で、菅原道真や市川左団次なぞと同じ星廻りだから、三十四から四十までの間が一番災難の多い大切な時だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は天神様や何かとおんなじ星廻りだから、文学や芸術事が好きなのだろう」って母は何遍も塾生に話して笑っていましたので、僕はそんな云い草をスッカリ空でおぼえてしまったのです。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "遁れても遁れても覆ひかゝる悲しみには、青白い騎士のやうに凝つと忍苦して「その悪い星廻りを通り越させる」賢こさを有ちつゞけませう。",
              "citation": {
                "source": "〔婦人手紙範例文〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生、へんなことを伺うようですが、先生の星廻りは何んですか？",
              "citation": {
                "source": "わが師への書",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
