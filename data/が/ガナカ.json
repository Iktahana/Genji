        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヒラガナトカタカナハ相前後シテ生レタラシイガ、前者ハ毛筆ト和紙ニ対シ適合性ヲ持ツテイタタメ今日マデ愛用サレタニ反シ後者ハ適合性ヲ持タナカツタタメ、一千年ノ間カエリミラレルコトガナカツタ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "十、世ノ中ニハ、ソノ気ニナルノハワケハナイガ実行ガ面倒ダトイウ問題ト、実行ハ簡単ダガナカナカソノ気ニナレナイ問題トガアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　其ノ日マデ、確カナ証拠ガナカッタノデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年時カラ六十三四ニ達スルマデハ、肛門周囲炎ノ手術デ一週間程度入院シタ以外、病気ラシイ病気ハシタコトガナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンガ行ッテシマッテカラ一人デ静カニ考エテ見ルト、アンナニ怒ラナイデモヨカッタ、颯子ガ婆サンカラ聞イテドンナ風ニ取ッタカト、シキリニ気ニナッテ仕様ガナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ子供ニモ隠シヨウガナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "盛リ上ッテイル部分カラ土蹈マズニ移ル部分ノ、継ギ目ガナカ／＼ムズカシカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ今日マデハソレヲ確カメル機会ガナカッタガ、今日彼女ガ映画ヲ見ニ出カケタ間ニ茶ノ間ヲ捜シテ、容易ニ探リアテルニハ、早クモ僕ニ嗅ギツカレルヲスル女デアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………考エマイトシテモソノ家ノ様子、室内ノ空気、二人ノ寝テイル恰好マデガ浮カンデ来テ仕方ガナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御注文ノ広東犬ハコノ間カラ捜シテイマスガナカナカ見ツカラナイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
