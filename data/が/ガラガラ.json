  {
    "uuid": "f3fb287e-6703-5851-b969-278d4110d235",
    "entry": "がらがら",
    "reading": {
      "primary": "がらがら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
