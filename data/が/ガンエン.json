[
  {
    "uuid": "7fbd5267-250a-5d91-9629-bec9d36edd96",
    "entry": "岩塩",
    "reading": {
      "primary": "がんえん",
      "alternatives": [
        "いわしお"
      ],
      "is_heteronym": false
