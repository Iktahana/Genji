        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "牧士ナドニ反抗サレルヤウデハ奉行ノ威徳ガナイノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と御冗談めかしておつしやいましたけれども、或いは、御陽気に見えながらその御胸中には深い御憂悶を人知れず蔵して居られたのでもございませうか、その辺の事は私どもには推量も及ばぬところでございまして、ナンニモ、スルコトガナイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その第一は、情報のオーガナイズ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "色ヲツケテミタラヨカロウト考エテイマスガ、時間ト金ガナイノデ、コンナモノデ腹イセヲシテイルノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイロイロナ構図デ頭ガイッパイニナッテイルノデスガ、ナニシロマダカクダケノ腕ガナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日暮しのシガナイ稼ぎじゃ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――男は中央から派遣されてきた党のオルガナイザーだった。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "今デハ君チャンモモウ長イコトガナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ私ハ近ゴロ原稿ヲ書クニモ手紙ヲシタタメルニモヒラガナトイウモノヲ使ツタコトガナイ、ソレハナゼカトイウニ、我々仰臥シタママデモノヲ書クモノニトツテハ些細ナ力ノ消費モ大キナ問題トナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コレカラソノ論証ヲシナケレバナラヌガ、アマリ十分ナ紙幅ガナイカラ箇条書ニシゴク簡単ニ書ク。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際今マデ道子ノ為ニ生キテ来タヨウナ私ハ、道子ヲ失ッタ今生キテ居ル甲斐ガナイト思ッタノデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテノ考エ通リニモハヤ仕方ガナイト思ッテ、　「僕ハアナタニハ大変スマナイ事ヲシテ居タンダ、許シテクレ、君ニ謝ラナケレバナラナインダ」　ト云イマスト清三ハ床ノ上ニ起キ上リナガラ、　「何ダ、君ハ大寺君ジャナイカ、今頃人ノ寝室ニハイリコンデ何ヲシヨウトスルンダ」　ト申シマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "音ハ耳ヲ聾スルバカリノグオーツトイフ音デ、生來之ニ比較スベキ音ヲ聞イタコトガナイ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ヲ殺スノハ惜シイガ、シカタガナイ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその作品のなかには、組織工場や未組織工場、オルガナイザーの行動、レポーターの往復、ストライキの裏面、留置場、刑務所、労働者の家庭、そうしたものが如何に多く反覆されてることか。",
              "citation": {
                "source": "現代小説展望",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルガナイザーの行動、ストライキの裏面、労働者の生活、工場の内部、留置場、刑務所、其他種々のことを読者は読ませられる。",
              "citation": {
                "source": "性格を求む",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての個人をオルガナイズしその細胞組織の中に暗い集団の構造を形成せんとするところの、かの新しきロマンティシズムの新しきヴェゲテジーレン（植物化）をもつ。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、シカタガナイノデ、ソノ洋服ヲキテ、小サクナツテ学校ヘユキマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「玉ネギノヱカキサンナンテキイタコトガナイ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　シカタガナイノデ、ユカノウヘニスワリマシタラ、洋服ガドロダラケニナリマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンダカサムクツテシカタガナイカラ、コノナカデ、ホンヲヨミマセウ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オバアサンハ、ベツドノウヘデオコツテヰマシタガ、「モウシカタガナイ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、マスマスオコリマシタガ、シカタガナイノデ、オザシキノアンラクヰスニコシヲカケマシタラ、タウトウキモチガヨクナツテ、マユヲシカメタママネムリコンデシマヒマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノキイのもつ喜悦は、このオルガナイズの情趣の上に在る。",
              "citation": {
                "source": "レンズとフィルム",
                "author": "――それも一つの性格である――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソリダリテの感情とはそれを指す、オルガナイズの情趣ともいわるべきものである。",
              "citation": {
                "source": "レンズとフィルム",
                "author": "――それも一つの性格である――",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノキイのもつ喜悦は、このオルガナイズの情趣の上にある。",
              "citation": {
                "source": "物理的集団的性格",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルガナイズの情趣ともいわるべきものである。",
              "citation": {
                "source": "物理的集団的性格",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがオルガニッシュな構成を目標とするかぎり、関連の情趣はまたオルガナイズの情趣でもある。",
              "citation": {
                "source": "物理的集団的性格",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "情熱の中に秩序を、秩序の中に情熱をもつところのオルガナイズの情趣をその中に見る。",
              "citation": {
                "source": "芸術の人間学的考察",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤウガナイナ、とかすかに呟いて、首をひねりながら、七二銀上ル（四分）指して胸をそらし、両腕を袖口から差しこんで腰に当てて肱をはり、厳然盤をにらむ、が、やゝあつてチラと人々の顔を見廻して、チョッ、舌ツヅミ、何か呟いたが、……タナ、最後のタナだけしか聞きとれない。",
              "citation": {
                "source": "散る日本",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
