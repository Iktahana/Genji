        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "緒方サンニハ、子供サンガアッタネ。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして俄に耳もとでガアッと云ふ声がするからびっくりして眼を醒ましたのだ。",
              "citation": {
                "source": "月夜のけだもの",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガアガアッと云ふその雹の音の向ふから、「ホーォ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガアガアッというその雹の音の向うから、「ホーォ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカオヒマガアッタラ御教示ヲ願イマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガッ……ナ何を……するッ……ガアッ……ムムムムム……」　その時に硝子窓の外から、最前の生蕃小僧が覆面の顔を覗かせる。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年ノ今頃モ修繕シタコトガアッタッケガ、ソノトキハ赤沢常造ノ奴ガイタカラ、半日デ片付イタモノダ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ昨年ノ暮空襲デクライ外ヘ出タトキ、左ノ眼ガイヤニ暗イ感ジガシタシ、マタ室ニイテモ変デ、左ノマツ毛に目ヤニデモツイテイルノデハナイカト気ニシタ事ガアッタガ、ソノコロカラ悪カッタラシイ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ニ「権三と助十」ガアッタガ見残シテ出ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊勢丹ノ特選売場ヘ行ッタラ何カシラ見ツカルダロウ」実ハ外ニ少シ考ガアッタンダガ、ソンナコトハ口ニシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンマーイタリアンファッションノ陳列ガアッテ、有名ナデザイナーノデザインニ依ルイタリー好ミノオートクチュールノ服ガ沢山飾ラレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バレリーナニナロウト思ッテ、バーレッスンヲ一二年受ケタコトガアルノデ、チョットグライ立ツコトハ立テタンデスガ、サア今デモ立テルカ知ラ」ッテ、ソンナ話ヲシタコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若イ時カラソウ云ウ傾向ガアッタトハ思ワナイガ、老年ニ及ンデダン／＼トコンナ工合ニナッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔ノ沢村源之助ノ舞台顔ニハソノ感ジガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学時代ノ予ノ同窓ニ山田湿ト云ウ法学士ガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪ノ市役所ニ勤メテ、疾ウニ故人ニナッタガ、コノ男ノ父ハ古イ弁護士カ代言人デ、明治初年ニ高橋オ伝ノ弁護ヲ勤メタコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云エバ、先日家庭内デコンナイザコザガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "攻撃ノ際ニピュー、ピューット口ヲ鳴ラス癖ガアッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年ノ夏軽井沢ヘ行ッテイタ留守ニ寝室ト浴室ト便所トヲ作リ直サセタコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浴室ヲ改造スル時ニ、チョット悶着ガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロデ昨夜コンナコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ幸イニ一時快方ニ向ッテイタノダガ、昨夜ノ失敗デ又ブリ返シタヨウデアルカラ、当分用心シタ方ガイヽ、シノミンハ餘リ連用スルト副作用ガアルカラ一回四錠ズツ日ニ三回、三日以上ハ続ケナイデ下サイ、毎朝怠ラズ尿ノ検査ヲシ、雑菌ガアッタラ、ウバウルシヲオ飲ミナサイト云ワレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨日ノ日曜日、二十四日ノ午過ギニ、颯子ガ洩ラシタ言葉ガアッタノヲ予ハ忘レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレマデノ間ニソット二階カラ下リテ消エテナクナレバイヽ筈デアッタノニ、彼等ノ方ニモ計算違イガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「仮リニ君ガ―――仮リニダヨ、―――春久トドウ云ウコトガアッタニシタッテ、僕ハソレヲ取リ上ゲル気ハナインダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンガ颯子トノ結婚ニ反対シタ当時、「踊リ子上リナンゾッテ云ウケレド、キット彼女ハ家政ノ切リ盛リナンカモ上手ニヤッテ行キマスヨ、ソウ云ウ才能ノアルコトヲ僕ハ見抜イテルンデス」ト浄吉ハ云ッタガ、アノ時ハ恐ラク当寸法ヲ云ッタノデ、先見ノ明ガアッタ訳デハアルマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、ナカ／＼別レル気ナンカアルマイ、萬一彼女ニ疑ワシイ行為ガアッタトシテモ、見テ見ナイ振リヲスルカモ知レナイ、上手ニ振舞ッテサエクレヽバ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サッキハ上ガ二二三、下ガ一五〇アッタンデゴザイマスヨ」「ソンナコトモタマニハアルデショウナ」「タマニダッテコンナコトガアッチャ大変デゴザイマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トキ／″＼足ノ裏ガ見エタリシテ」ソレハヨカッタガ、ソノアトデ次ノ事件ガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
