        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アリス　ただのガラガラよ――ガラガラヘビじゃなくって、ほら――ただの使い古したガラガラ。",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝起きて、ガラガラヘビがベッドにいたら、危険だよ。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬眠中のガラガラヘビがうようよいる鉱山で働くようなものだ。",
              "citation": {
                "source": "見えざる力",
                "author": "THE INVISIBLE FORCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして海水を抜いて、ガラガラヘビを入れて、入国を阻止します。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
