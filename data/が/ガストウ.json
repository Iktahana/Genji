[
  {
    "uuid": "c15e7cb6-e057-535a-941c-6423fdb81c87",
    "entry": "ガス灯",
    "reading": {
      "primary": "ガスとう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
