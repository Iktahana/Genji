          "literary": [
            {
              "text": "タトエバ我々ノ映画事業ニシテモ、何カ会ダノ組織ダノガデキルタビニ、ズラリト重要ナ椅子ヲ占メラレルノハ、必ズ、全部ガ全部映画ニハ何ノ関係モナイ人バカリデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "［此ノ際ノ um ハ、具體的ニ、心ヲ中心トスル其ノ附近、即チ「心ノ周圍」ヲ考ヘル事ガデキル。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "スデニ倦怠期ヲ通リ過ギテイル時期ニナッテ、私ハ昔ニ倍加スル情熱ヲモッテ妻ヲ溺愛スル※ガデキル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "書キナガラ僕ハ、コノ数時間後ニ経験スル※ガデキルデアロウ悦楽ノ種々相ヲ豫想シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツマリ、ソレゾレ違ッタ思ワクガアルラシイガ、妻ガデキルダケ堕落スルヨウニ意図シ、ソレニ向ッテ一生懸命ニナッテイル点デハ四人トモ一致シテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
