[
  {
    "uuid": "6f16bd5f-c382-560c-a60f-3fbc7b65f4b2",
    "entry": "学派",
    "reading": {
      "primary": "がくは",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
