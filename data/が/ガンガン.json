        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「もう、遠慮せずにガンガン食べていいよ！」と、彼は大皿を勧めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "若手社員が社長に自分の意見をガンガンぶつけている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "店員「いらっしゃいませ！今日はガンガン飲んでいってください！」",
              "citation": {
                "source": "Illusions AI",
