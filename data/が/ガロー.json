        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "事務所は椰子林の中を切り拓いて建てた、草葺きのバンガロー風のもので、柱は脚立のように高く、床へは階段で上った。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "空地の真中から、草葺きのバンガローが切り拓かれた四方へ大ランプの灯の光を投げている。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『サンガロー街――おつかさん、私の家も彼處にあるんですねえ。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋人は東洋暖地へ来てやっとバンガローのベランダ造りを思いついたようである。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論この建物もバンガロー以上であつた。",
              "citation": {
                "source": "芭蕉と歯朶",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンガロー風で、正面と横とに広い階段がついてゐる。",
              "citation": {
                "source": "日本ライン",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンガロー風で、正面と横とに広い階段がついている。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "瀟洒たるバンガロー風の家だ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時敬太郎は、果しのない広野を埋め尽す勢で何百万本という護謨の樹が茂っている真中に、一階建のバンガローを拵えて、その中に栽培監督者としての自分が朝夕起臥する様を想像してやまなかった。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はバンガローの床をわざと裸にして、その上に大きな虎の皮を敷くつもりであった。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この日、両将は木留の本営に居たのであったが、急を聞いて部下三四百を率い、馳せ来って、吉次越の絶頂の凹んだ処に木と草とで忽ち速成のバンガローを造って、悠々と尻を落ちつけて、指揮したと云う。",
              "citation": {
                "source": "田原坂合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな事が評議、研究されているうちに、間もなく正午過ぎになると、又々異様なものが、このバンガローの中から次から次に発見されて、係官たちを面喰らわせた。",
              "citation": {
                "source": "Ｓ岬西洋婦人絞殺事件",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反してお庭の隅の常春藤に蔽われたバンガロー風の小舎には燈火がアカアカと灯って、しきりに人影が動いている。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の屋敷はご料林の麓、酒井男爵の別墅から半町｜距った林の中にあった、それは瀟洒たるバンガロー式の小窓の多い建物で外見は寧ろ貧しかったが内部の装飾の燦然さは眼を驚かすばかりであると町の人達は云っていた。",
              "citation": {
                "source": "温室の恋",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンガローの横手まで歩いて行くと広い後庭の中央に可成り大きな温室が夕陽に硝子屋根を反射させて秋霧の中に横倒わっていた。",
              "citation": {
                "source": "温室の恋",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガローシの底でキシキシいう雪の音を思い出します。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "散歩に出ると、ガローシュ〔オバーシューズ〕の中で足の指がいたく迚も向い風に長くさらされて居られぬ。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○街路の雪、軟かになって、深くガローシを埋める。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日天気がいいので、ガローシなしで□ったところが、足がしめってやり切れず。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴムトレストでガローシの価を上げた。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば男のガローシ 4р72к だったのを 5р15к に、女 4р7к の代 4р60к　○今日カールミン　　　　　　　　　　　――○――　Ｙ七時頃来た。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "春らしい日曜日で人々は乾いた歩道の上をガローシなしでたのしそうに歩いた。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この活動小屋はガローシをはいて入れるからよろしい。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○モスク※ではまだガローシをはいて居る。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガローシ〔オーバー・シューズ〕なしだ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "傘をさして、毛の靴下をはいて、ガローシをはいて、АОМС へ行った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガローシ、毛の靴下何とあったかでいい心持か！",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月十四日　火　晴、よごれきったガローシをはいて（室に居たら曇り故）堂々と出かけたら路はカラカラ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
