          "literary": [
            {
              "text": "ブールガイヤール親方！",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　車大工のブールガイヤール親方は、戸口の所に立っていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "父フリードリッヒはその年のうちにチフスで斃れ、母は六か月の後俳優で素人画家で戯曲も書いたガイヤーという人と再婚した。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸い継父のガイヤーは気立ての良い愛情の豊かな人で、ワグナーはなんの煩いもなくすくすくと成長し、生涯継父に対する感謝の念を持ち続けたと言われている。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "父のガイヤーは絵画を稽古させたがデッサンと粉本とに囚えられるのは我慢が出来なかったらしく、音楽においても同じような課程の修業はワグナーの得手ではなかった。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
