  {
    "uuid": "6514effa-7b4f-5065-a47f-a884881682c0",
    "entry": "ガナ",
    "reading": {
      "primary": "がな",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "牧士ナドニ反抗サレルヤウデハ奉行ノ威徳ガナイノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と御冗談めかしておつしやいましたけれども、或いは、御陽気に見えながらその御胸中には深い御憂悶を人知れず蔵して居られたのでもございませうか、その辺の事は私どもには推量も及ばぬところでございまして、ナンニモ、スルコトガナイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その第一は、情報のオーガナイズ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "色ヲツケテミタラヨカロウト考エテイマスガ、時間ト金ガナイノデ、コンナモノデ腹イセヲシテイルノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイロイロナ構図デ頭ガイッパイニナッテイルノデスガ、ナニシロマダカクダケノ腕ガナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月二日払暁、ロヴェレット南方より、スガナ渓谷にいたる、トレンチノ全線の砲兵が、約二千門といわれる砲列の火蓋を切った……。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、ダンクル軍は、一部をスガナ河谷に、主力をチエッテ・コムニ高原に向け、これはアジアゴ市を目標とした。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮名遣改良の議論もあつて、コイスチヨーワガナワといふやうな事を書かせようとしてゐると、「いやいや、Orthographie はどこの国にもある、矢張コヒステフワガナハの方が宜しからう」と云つた。",
              "citation": {
                "source": "妄想",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿父様がガナツシユですつて？",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガナツシユつてどんな事なの、ねえ、貴方……」　ルイザは生れて初めてのこの仏蘭西語の意味を訊きただした。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さう、ガナツシユつてそんな事なんですの、いい言葉ですわネ。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "女『アノナハーン、アエヅダケァガナハーン、昨日スアレー、彼ノ人アナーハン。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "女『アノナハーン、アェヅダケァガナハーン、昨日スアレー、彼ノ人アナーハン。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他ヤコエノトリ、ネザメドリ、アケツゲドリ、ナガナキドリ、トコヨノトリと種々に異名ある（『重訂本草啓蒙』四四）。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "例せば印度の土蕃が現時も之を行なふ由時々新聞にみえ、ボムパスのサンタルパーガナス口碑集に王が婿の強きを忌んで、畜類を供えても水が湧かぬ涸池の中に乘馬のまゝ婿を立せると流石は勇士で、水が湧いても退かず、馬の膝迄きた、吾が膝まできた、脊迄きたと唄ひ乍ら、彌々水に沒した。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻を打つのを全廃したという（一九〇九年板、ボムパスの『サンタル・パルガナス俚伝』一一三頁）。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日暮しのシガナイ稼ぎじゃ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――男は中央から派遣されてきた党のオルガナイザーだった。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンタチハ、オ母ッチャガ死ヌ四五日モマエカラ、何ンニモタベルモノガナク、目マイガシ、ムネガヒクヒクシ、ペッタリネタキリダッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "今デハ君チャンモモウ長イコトガナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラダガナオッタラ、＊＊＊＊＊＊＊＊＊ニナッテ、＊ヲ＊＊テアルキタイナアッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺どうしたんだと夢中になって、ガナった。",
              "citation": {
                "source": "母たち",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ私ハ近ゴロ原稿ヲ書クニモ手紙ヲシタタメルニモヒラガナトイウモノヲ使ツタコトガナイ、ソレハナゼカトイウニ、我々仰臥シタママデモノヲ書クモノニトツテハ些細ナ力ノ消費モ大キナ問題トナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカルニカタカナトヒラガナトデハ、力ノ消費ガ非常ニ違ウノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ガココニ書イテオキタイコトハ、日本ノ活字カラヒラガナヲナクシタホウガヨイトイウ私見デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コレカラソノ論証ヲシナケレバナラヌガ、アマリ十分ナ紙幅ガナイカラ箇条書ニシゴク簡単ニ書ク。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、ヒラガナノ活字ハソレ自身ガ美シクナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
