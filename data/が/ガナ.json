[
  {
    "uuid": "cc91ec60-8429-5b2e-a421-c0930dece115",
    "entry": "がな",
    "reading": {
      "primary": "がな",
      "alternatives": [
        "がなあ"
      ],
      "is_heteronym": false
    },
    "grammar": {
