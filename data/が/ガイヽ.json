        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「株ヲ持ッテル筈ジャナイカ、アレヲ売ル訳ニ行カナイノカ」「アレヲ売ッタラ、ソレコソアタシタチ一文ナシニナッチャウワ」「ソウヨホントニ、アレダケハ手ヲツケナイ方ガイヽヨ」ト、婆サンガ助ケ舟ヲ出ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "痛イ時ノ方ガ一層感ジル、ト云ッタ方ガイヽカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハ又痛イ目ニ遇ワセテクレル異性ノ方ニヨリ一層魅力ヲ感ジ、惹キツケラレル、ト云ッタ方ガイヽカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシ、オ爺チャンヲ是非一ペンボクシングニ引ッ張ッテ行クワ」「ボクサーニハ美男ハ少イダロウナ」「鼻ガ潰レテル人ガ多イワ」「レスリングトドッチガイヽカナ」「レスリングハ多分ニショウ的デ、ムヤミニ血ダラケニナッタリスルケレド、真剣味ガ乏シイワ」「ボクシングダッテ血ガ出ルンダロウ」「エヽ、ソリャ出ルワヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イズレハ焼イテシマッタ方ガイヽト思ウガ、遺シテ置クノモ悪クハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ数日来アマリ蒸シ暑ク、湿気ガ多イノデ、空気ヲ乾燥サセルタメニモ冷房シタ方ガイヽト、医師ヤ看護婦ガ云ウノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ幸イニ一時快方ニ向ッテイタノダガ、昨夜ノ失敗デ又ブリ返シタヨウデアルカラ、当分用心シタ方ガイヽ、シノミンハ餘リ連用スルト副作用ガアルカラ一回四錠ズツ日ニ三回、三日以上ハ続ケナイデ下サイ、毎朝怠ラズ尿ノ検査ヲシ、雑菌ガアッタラ、ウバウルシヲオ飲ミナサイト云ワレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯ハ軽ク一杯、オ数ハヴァライエティーニ富ンダ方ガイヽト云ウノデ、毎日イロ／＼取リカエテ品数ガ多イ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツデモ来ルガイヽ」「有難ウ存ジマス、オ言葉ニ甘エテコレカラチョク／＼伺イマス、毎日ト云ウ訳ニモ参リマセンガ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ経口剤デアルカラノブロンヨリハ気持ガイヽ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "辻堂ノ子供達モセイ／″＼使ワシテ戴キマスワ」「ソウダトモサ、イクラデモ這入リニ来ルガイヽ」飛ンダトコロデ敵ヲ取ラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レスリーモ颯子ノ寵愛ヲ蒙ムルコトクーパーニ劣ラナイノデアルガ、陸子アタリガ密カニ婆サンニ焚キツケタト見エテ、コリーノヨウナ大キナ犬ハ飼ワナイ方ガイヽト云ウ意見ガ、二三年前カラ家庭内ニポツ／＼擡頭シ始メテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "土曜カラ日曜ニカケテノ方ガ、落チ着イテ子供ニ会エルノデ佐々木ニハ都合ガイヽノダガ、コチラハ颯子ガ何ト云ウカ、聞イテ見ル必要ガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「少シハ痛クッテモコンナコトヲシテイル方ガ気ガ紛レルヨ、痛クテ溜ラナクナッタラ止メル、今ノウチハ仕事シテイル方ガイヽ、アッチヘ行ッテヽクレ給エ」午後一時ヨリ午睡、一時間ホドトロ／＼トスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ腹ノ中ヲ隅カラ隅マデ見抜イテイル彼女デアルカラ、マサカ悪ク取リハシマイト思ウガ、………「ソウダ、ヤッパリ会ッタ方ガイヽカナ、二三日ウチニ機会ヲ窺ッテ何トカ巧ク持チカケテ見タラ、………」今日ノ午後、フト予ハ考エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤッパリＰＱ病院ハ止メタ方ガイヽカナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イツナサルノ」「病院ノ方ハイツデモイラッシャイト云ッテルンダ、ソウ決マッタラ早イ方ガイヽ、明日行ク」「マアオ待チナサイ、アナタハイツモ性急ナンダカラ」婆サンハ出テ行ッタト思ウト、高島易断ノ暦ヲ持ッテ戻ッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「明日ハ先負、明後日ハ佛滅、二十八日ガ大安デ『たいら』デス、二十八日ニオ決メナサイヨ」「暦ナンゾ当テニナルモンカ、佛滅デモ何デモ早イ方ガイヽ」無論婆サンガ反対スルコトヲ承知デ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテ奈良ノ寺々グライハ見テ置イタ方ガイヽシ、殊ニ今度ハ予ノ菩提所ヲ定メルニツイテモ、必ズ参考ニナルコトガアロウ、ト、ソウ云ッテヤッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ノ足ノ裏ヲ佛足石ニ彫ラセ、死後ソノ石ノ下ニ予ノ骨ヲ埋メテ、ソレヲ以テ予ト云ウ人間、卯木督助ノ墓ニ代エルト云ウ案ハ、颯子ニモ知ラセナイ方ガイヽト考エテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ昨日急ニ気ガ変リ、彼女ニ打チ明ケタ方ガイヽト思ウヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハソレニ答エテ云ッタ、彼女ト春久ト仲ガイヽコトハ予ガ知ッテイルバカリデナク、自分デモ公然ト云ッテイルシ、亭主ノ浄吉モ承知デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
