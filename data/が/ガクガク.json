  {
    "uuid": "e8556014-f9df-5201-bc3c-37ce04338c27",
    "entry": "楽学",
    "reading": {
      "primary": "がくがく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
