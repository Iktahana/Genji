          "literary": [
            {
              "text": "外族の村どうしの結婚の末、始終円満に行かず、何人か子を産んで後、ついに出されて戻った妻もあった。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "子から見れば、そうした母のいる外族の村は、言おう様なく懐しかったであろう。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "書物の記載を信じれば、わが国の婚姻史では、母の許へ父が通うて来たと言ふ例話よりは、外族の村から、母が奪はれて来たと見える場合の方が、よほど古みを帯びて居る。",
              "citation": {
                "source": "信太妻の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "外族の村どうしの結婚の末、始終円満に行かず、何人か子を産んで後、つひに出されて戻つた妻もあつた。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "子から見れば、さうした母の居る外族の村は、言はう様なく懐しかつたであらう。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
