  {
    "uuid": "4b9e6d33-fdb9-52fc-ab95-9bae9876c671",
    "entry": "蟹股",
    "reading": {
      "primary": "がにまた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
