          "literary": [
            {
              "text": "――彼女は入口の側柱に凭れかかって編物をしていて、何も見ずにいた。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そしてすぐに入口の側柱に凭れかかって編物をし、何も見ようとしなかった。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕は僕なりに、自分のカヌーに乗って“時”の流れを漕ぎくだりながら、友だちの家の側柱にカヌーをつないでは、中へはいって食事の御相伴にあずかって暮しているよ」「まったくヴェネチヤふうだね」まだ窓の外を眺めながら、ジェム・ベンスンは言った。",
              "citation": {
                "source": "井戸",
                "author": "Ｗ・Ｗ・ジェイコブズ",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヌーをつなぐ側柱があり、食事があり――そして、友だちがあるというのは」　今度はミスタ・カーが、ぶつぶつ言った。",
              "citation": {
                "source": "井戸",
                "author": "Ｗ・Ｗ・ジェイコブズ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
