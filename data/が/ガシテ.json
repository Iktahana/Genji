        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「ダメダ　ダメダ、キミラノ　ウデデハ　サルヲ　トリニガシテ　シマフ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二ツノ　ホシハ、ソノ　ヨルモ、オシダマツテ　アツチコツチト　ナクナツタ　ホシヲ　メデ　サガシテ　ヰマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日、高イ木ノ枝ニ腰カケテ、四方ヲミマワシテ、何カヲサガシテヰル様子デス。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "与惣兵衛は腹をたてて、「ケッコンスルナ　フラチ　カンドウ」　と打ってやると、シヨウチシタ　サガシテミルという電報がきた。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "モハヤ人生ニ疲レタ、トデモ云ウノダロウカ、イツ死ンデモイヽ気ガシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "果シテ戸ニハ締マリガシテナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イツモ締マリガシテナイト云ッタカラ、ホントカドウカ試シテ見タノサ」云イナガラ予モ浴室ノ方ヘ首ダケ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸締マリガシテナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャワーノ音ガシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コヽ締メルワヨ」ト云ウ代リニ、「コヽ開イテルワヨ」ト云ウ声ガシテ、珍シク彼女ガ朗カナ顔ヲ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」二度云ウト、微カナ足音ガシテ寝間着ヲ着タ経助ガ這入ッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現金ナモノデ、コノ程度ナラ墓地ヲ見ツケニ行ケソウナ気ガシテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出発以来四日間、近頃ニナク活動シ、ソノ間ニ面倒ナ日記ヲツケタリシタノデ、予自身休養ノ必要ガアルニハアッタガ、今日一日ダケ佐々木ニモ暇ヲ与エル約束ガシテアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ敏子ハコノ縁談ニハドウモ気乗リガシテイナイラシイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ何トナク、妻ト敏子トノ間ニ暗黙ノ示シ合ワセガアルヨウナ気ガシテナラナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チョット出カケテ来マス」ト、階下デ妻ノ声ガシテ、彼女ト河合女史トガ出テ行ク様子デアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――関門海峡ニハ、タクサンノ外国船ガ入ッテクルコトトナッテ、沖ノ仕事モ増スバカリトナッテ、組デハ、若クテヨイ働キ手ヲサガシテオル。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレガ、オ京ヲ今晩世話シロ、ト、アレホド申シコンデオイタノヲ、知ツテ居ルクセニ、玉井トオ京トヲ、逃ガシテシモウタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
