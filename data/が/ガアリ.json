        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――ナストウリ、モノサシトハサミ、カガミガアリマス、イケニフネ……」大急ぎでそれだけ読んだが、そこで息が切れた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」タツタ一年ノオ留守番モデキヌヤウデハ、重臣ノ甲斐ガアリマセヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ、夢デ見タコトガアリマス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ裏ニハキット墓地ガアリマス。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ニヨリマストアタリノ山々ガ浮キアガッタカト思ワレルクライ空ガ美シイ時ガアリマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "水産翁、轟雷雄先生ガ免職ニナリマシタ裡面ニハ、国家ノタメニナラヌ重大秘密ガアリマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒点ガ見エ、強イ光デ網膜ガヤケタトキノ感ジガアリ、且ツチラチラト電線ノ雑音ミタイナモノガ盛ンニ動クノデアル。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ツウジガアリマスカ」などと少しの日本語が出来る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハハラガタツテシカタガアリマセン。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザウサン　サルサン村山籌子　アルトコロニ　タイヘン　オギヤウギノヨイ　ザウサンガアリマシタ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "八ミミヅクサン　ハイマデモ　メガネ　ガアリマセン。",
              "citation": {
                "source": "ミミヅクサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクル朝、人参サンガ起キタ時ハ　六ジニ少シシカ間ガアリマセンデシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ、おやつガアリマセン。",
              "citation": {
                "source": "母子ホームの子供たち",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "］（猶 an die er gebunden war ノ an ガ落チテヰル版ガアリマス。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ノ行為ニヨッテ害ヲ被ッタ者ガアリトスレバ、モトヨリ彼等ガ不正ナノデアルカラ、従ッテ何等気ノ毒ニ思ヒヤウハナイ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ何カ喰ッテモイヽナ」「冗談ジャナイ、ソレデ足リナインデスカ」「足リナイコトハナインダガ、コヽヘ来ルト関西ノモノガ恋シクナルンダ」「グジノ一ト塩ガアリマスゼ」ト浄吉ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ａハ親切デ正直デ思イ遣リガアリ、Ｂハ不親切デ嘘ツキデ人ヲ欺スコトガ上手ナ女デアルトスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪サニモ限度ガアリ、盗癖、殺人癖等ハ困リモノダケレドモ、ソレモ一概ニハ云エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キットソウニ違イナイヨ、アタシニハチャント分ッテイマス」「アハハハハ、ソンナラ颯子ニ聴イテ御覧ナサイ」「笑ウ人ガアリマスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "数年前カラ予ニハ前立腺（青年時代花柳病ヲ患ッタ頃ニハ摂護腺ト呼ンダモノダガ）肥大症ガアリ、トキ／″＼残尿ガ溜ッタリ、尿ガ出ナクナッテカテーテルデ導尿シタリシタコトガ二三回アル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ数年来、予ハ白眼ガシバ／＼充血スルコトガアリ、普通ノ時デモ赤味ガ強クナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今マデ颯チャンガソンナ石ヲ持ッテタノヲ、オ婆チャンモ見タコトハナイト仰ッシャイマスシ、アタシモ知リマセンケレドモ、イツアンナモノヲ買ッタンデゴザイマショウネ」「………」「ソウ云エバ岸サンガ総理大臣ダッタ時、佛印カ何処カデキャッツ・アイヲ買ッテ問題ニナッタコトガアリマシタッケネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ一度腎臓ノ検査ヲシテ見ル必要ガアリマスナ」ト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士ニハ数年前脳溢血発作ノ時モ数回来診ヲ乞ウタコトガアリ顔見知リデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ヨリソノ後ノ経過ニツキ詳細ナ説明ガアリ、頸椎ヤ腰椎ノレントゲン写真ヲ見テ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ颯子ト同様ニ偽悪趣味ガアリ、男ノ癖ニ泣クナンテ見ットモナイト思ッテイルノダガ、ソノ実案外涙脆クッテ、屁デモナイコトニ訳モナク涙ガ出ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノタビゴトニ暗箱ノ調節ガアリ、可ナリ面倒デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イニ予ノ部屋ニハ別室ノ設ケガアリ、ソコハ八畳ノ畳敷ニナッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "過去ハスベテ幻影デココニ真実ノ存在ガアリ、僕ト妻トガタダ二人ココニ立ッテ相擁シテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして私には「今日モナオ時代オクレナ舊道徳ヲ重ンズル一面ガアリ、或ル場合ニハソレヲ誇リトスル傾向モア」ったのである。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
