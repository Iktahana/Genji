      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十二　信如が何時も田町へ通ふ時、通らでも事は濟めども言はゞ近道の土手々前に、假初の格子門、のぞけば鞍馬の石燈籠に萩の袖垣しをらしう見えて、椽先に卷きたる簾のさまもなつかしう、中がらすの障子のうちには今樣の按察の後室が珠數をつまぐつて、冠つ切りの若紫も立出るやと思はるゝ、その一ツ構へが大黒屋の寮なり。",
              "citation": {
                "source": "たけくらべ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかで山がらすをさはおもふべき。",
              "citation": {
                "source": "すゞろごと",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二　信如が何時も田町へ通ふ時、通らでも事は済めども言はば近道の土手々前に、仮初の格子門、のぞけば鞍馬の石燈籠に萩の袖垣しをらしう見えて、椽先に巻きたる簾のさまもなつかしう、中がらすの障子のうちには今様の按察の後室が珠数をつまぐつて、冠つ切りの若紫も立出るやと思はるる、その一ト搆へが大黒屋の寮なり。",
              "citation": {
                "source": "たけくらべ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "握つた手の感覺　四月十九日の朝、私は書齋の卓に額をうづめながらすすりなきをして居た。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに最近の「忘れちや厭よ」や「あなたと呼べば」等は歌詞に強いアクセントをつけ、その言葉の方の面白味で、専ら聴者を興がらす様に工夫されてる。",
              "citation": {
                "source": "流行歌曲について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ちジヤツク・ウオーキイ等によつて映画で紹介されてゐるやうな、歌詞を本位として簡単な音楽を伴奏的につけ、専ら歌詞の滑稽味やエロチシズムやで、大衆を興がらすやうに出来てる「音楽入西洋万才」が、近い未来に於て日本に現れることを予感させる。",
              "citation": {
                "source": "流行歌曲について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "卵殻もどきの貴公子の微笑と　　　　　遅鈍な子供の白血球とは、　　　　　それな獣を怖がらす。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "氣持を變に浮き立たせる樂音の渦卷、靴の踵と床の擦れ合ふ響、踊りながらする男女の囁き、その間に時時洩れる女達の淫蕩な笑ひ聲。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は自らに腹を立てながらすぐ自動車に乘つた。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」にっと笑って、背後の押入れの襖をあけ、坐りながらするするからだを滑り込ませ、「さあさ、あなたは、お仕事。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」につと笑つて、背後の押入れの襖をあけ、坐りながらするするからだを滑り込ませ、「さあさ、あなたは、お仕事。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっそくブルブルッとふるえあがり、青白く逆上せてしまい唇をきっとかみながらすぐひどく手をまわして、すなわち一ぺん東京まで手をまわして風下にいる軽便鉄道の電信柱に、シグナルとシグナレスの対話がいったいなんだったか、今シグナレスが笑ったことは、どんなことだったかたずねてやりました。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "きちんと膝に手を置いて、そらを見ながらすわっていた。",
              "citation": {
                "source": "ざしき童子のはなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながらすでに妄りに人の居ない座敷の中に出現して、箒の音を発した為に、その音に愕ろいて一寸のぞいて見た子供が気絶をしたとなれば、これは明らかな出現罪である。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの三羽のうみがらすそのなき声は波にまぎれそのはゞたきはひかりに消され　　（燈台はもう空の網でめちゃめちゃだ。",
              "citation": {
                "source": "『春と修羅』補遺",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとうにジョバンニは、夜の軽便鉄道の、小さな黄いろの電燈のならんだ車室に、窓から外を見ながらすわっていたのです。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と叫びながらすすきのかげから飛び出しました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と云ひながらすなほに私たちに貸し、自分は又上流の波の荒いところに集ってゐる子供らの方へ行きました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」貝の火｜兄弟商会の赤鼻の支配人は云ひながらすばやく旅費の袋をさらひ上着の内衣嚢に投げ込んだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘆願隊やがて四時ともなりなんを、　　当主いまだに放たれず、外の面は冬のむらがらす、　　　山の片面のかゞやける。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言いながらすぐポケットの手を馬の鼻づらへのばしましたが、馬が首をのばして舌をべろりと出すと、さっと顔いろを変えてすばやくまた手をポケットへ入れてしまいました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」貝の火兄弟商会の赤鼻の支配人は云いながらすばやく旅費の袋をさらい上着の内衣嚢に投げ込んだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と云いながらすなおに私たちに貸し、自分はまた上流の波の荒いところに集っている子供らの方へ行きました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔くもにつらなるでこぼこがらす〕宮沢賢治くもにつらなるでこぼこがらす杜のかなたを赤き電車のせはしき往来べつ甲めがねのメフェスト",
              "citation": {
                "source": "〔くもにつらなるでこぼこがらす〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、ははあ、河童だと笑いながらすたすたと行っておしまいなさいました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お照の父",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをじっと見詰めていた夫人は一言いい捨て、身を反らしながらすーっと去りました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は思索に思い入りながらすぐ寝てしまった。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」といいながらすっかり小さな白い鬚の医者にばけました。",
              "citation": {
                "source": "ひのきとひなげし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
