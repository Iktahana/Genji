        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "聞きながら、大きいガツテンガツテンを、アクセントをつけてやつてゐた。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "名刺を読むと、しきりにまたガツテンガツテンをしながら私の顔をみて、それからタモトに入れたのであつた。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　ハジメテ　ミル　セカイガ　イママデト　チガツテ　ピカピカ　ヒカツテ　ヰタカラデ　アリマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコタチハ　トホクヘ　イキタガツテ　シヨウガ　ナイノデ、オカアサンノ　タケガ、「ソンナニ　トホクヘ　イツチヤ　イケナイヨ、ヤブノ　ソトニ　デルト　ウマノ　アシニ　フマレルカラ」ト　シカツテ　ヲリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ハンノキノ　シタニ　コロガツテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノ　カゲカラ　コノ　ヤウスヲ　ウカガツテ　ヰタ　オカアサンダヌキハ　タイヘンナ　コトニ　ナツタト、メヲ　マンマルクシテ　オドロキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ポストノ　ウシロニ　タツテ　ヰタ　ガイトウガ　カラ　カラト　ワラツテ、「ポストノ　カゲナラ、ポストノ　ウシロニ　コロガツテ　ヰル　ソノ　ブカツカウナノガ　サウヨ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタガツテ楷書トヒラガナモマタ同様ニ調和シナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタガツテ楷書ノ活字トカタカナノ活字モマタキワメテ調和ガヨイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "書ク文字ト活字ハチガツテアタリマエナノデアルカラ気ニスル必要ハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒褐色ノ煙ノ柱徑一町以上ノモノガ天ニ沖シ、中空以上ハ擴ガツテ雲ノヤウデアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ後急ニ近隣ノ火ノ手ガ強クナリ、今戸八幡ノ方ニモ火ノ手ガ擴ガツテ來タタメ、大川縁ヲ傳ヒ北方ニ、逃ゲル仕度ヲ始メタノデ、後ノ状況ハ見ナカツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ジロウハ　トビアガツテ　オホキナコエデ　ウタツテ　ワラヒダシマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ジヨンハ　タチアガツテ　イヒマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　チビスケハ　チヨツト　カンガヘテ　ヰマシタガ、ヤガテトビアガツテ　イヒマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドロノナカニ　コロガツテヰルト、ナニカ　ウチノナカデサワガシイ　オトガ　シハジメマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　イツモハ　シロヤ　ブチガ　チヨツト　アガツテモ　タイヘンニ　シカラレル　ソノタタミカラ、クモノヤウナ　ホコリガ、イツパイニ　マヒアガツテヰマス。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボク　オキアガツテ　キヤラメルヲ　カゾヘテ　ハコノナカヘシマツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
