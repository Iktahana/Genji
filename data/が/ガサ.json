  {
    "uuid": "0d1ca505-67e0-5867-a7aa-2defd6d45344",
    "entry": "がさ",
    "reading": {
      "primary": "がさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "心臓の動悸が息のつまるほどはげしく、自分で自分の身がささえていられないようになった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "糟谷は土曜と知って目がさめたようにたちあがった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "従て夜もおちついてはねむれない　眠てもすぐさめる　疲れるから眠ることはねむるが一時間もたつともう目がさめる。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "点々として畑中白くなっているその棉に朝日がさしていると目ぶしい様に綺麗だ。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がさっきほんとに情なくなってと言ったら、政夫さんは笑っておしまいなしたけど……」　面白く遊ぼう遊ぼう言うても、話を始めると直ぐにこうなってしまう。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "西側の山路から、がさがさ笹にさわる音がして、薪をつけた馬を引いて頬冠の男が出て来た。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "目の先七八間の所は木の蔭で薄暗いがそれから向うは畑一ぱいに月がさして、蕎麦の花が際立って白い。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人がよくも飽きないものだと台所で女中たちがささやき合った。",
              "citation": {
                "source": "かれいの贈物",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがさうした毒物の麻醉を借りずに、もつと自然的な仕方によつて、夢を自由にコントロールすることができるならば、人生はずつと幸福なものに變るであらう。",
              "citation": {
                "source": "夢",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青猫この美しい都會を愛するのはよいことだこの美しい都會の建築を愛するのはよいことだすべてのやさしい女性をもとめるためにすべての高貴な生活をもとめるためにこの都にきて賑やかな街路を通るのはよいことだ街路にそうて立つ櫻の竝木そこにも無數の雀がさへづつてゐるではないか。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "題のない歌南洋の日にやけた裸か女のやうに夏草の茂つてゐる波止場の向うへ　ふしぎな赤錆びた汽船がはひつてきたふはふはとした雲が白くたちのぼつて船員のすふ煙草のけむりがさびしがつてる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああこの影を曳く景色のなかでわたしの靈魂はむずがゆい恐怖をつかむそれは港からきた船のやうに　遠く亡靈のゐる島島を渡つてきたそれは風でもない　雨でもないそのすべては愛欲のなやみにまつはる暗い恐れださうして蛇つかひの吹く鈍い音色にわたしのくづれてゆく影がさびしく泣いた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このへんてこなる方角をさして行け春の朧げなる柳のかげで　歌も燕もふきながされわたしの俥やさんはいつしんですよ。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "片戀市街を遠くはなれて行つて僕等は山頂の草に坐つた空に風景はふきながされぎぼし　ゆきしだ　わらびの類ほそくさよさよと草地に生えてる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ろ　見ろ　一團の襲撃するところ意志と理性に照らされやくざの祕密はひつぺがされどこでも偶像はたたきわられる。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして洋燈のうす暗い廚子のかげで先祖の死靈がさむしげにふるへてゐる。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからともなく、空の日影がさして来て、宇宙が恐ろしくひっそりしていた。",
              "citation": {
                "source": "日清戦争異聞（原田重吉の夢）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし実際は、一人で自由にいることを愛するところの、私の孤独癖がさせるのである。",
              "citation": {
                "source": "秋と漫歩",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青猫この美しい都會を愛するのはよいことだこの美しい都會の建築を愛するのはよいことだすべてのやさしい娘等をもとめるためにすべての高貴な生活をもとめるためにこの都にきて賑やかな街路を通るはよいことだ街路にそうて立つ櫻の竝木そこにも無數の雀がさへづつてゐるではないか。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳は風にふきながされ燕も　歌も　ひよ鳥も　かすみの中に消えさる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しだいに下界の陸地をはなれ愁ひや雲やに吹きながされて知覺もおよばぬ眞空圈内へまぎれ行かうよ。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふはふはとした雲が白くたちのぼつて船員のすふ煙草のけむりがさびしがつてる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして蛇つかひの吹く鈍い音色にわたしのくづれてゆく影がさびしく泣いた。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども朝の日がさし、新しい風の吹いてくる時、ふたたび魚はその意志を囘復する。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが若し、現實の人生がさうでなければ！",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきから、少しずつズレかかっていた紳士の顔の上の新聞が、この時、ガサッと音をたてて、紳士の横坐りになっている膝の上へ落ちて来た。",
              "citation": {
                "source": "香水紳士",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "闇の中に冷雨にそぼぬれていた熊笹がガサッと、人間を袈裟がけに切ったような無気味な音を立てた。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日しも与八は、おひるの時分、いつものように大勢とは離れて、小高みになった藪蔭のところに竹樋を通した清水を掬いながら、握飯を郁太郎にも食べさせ、自分も食べていると、不意に後ろから人の足音があって、ガサガサッと藪の下萌が鳴る。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然ガサッと音がして、私の前に立ち現われたのは、一匹の羊であった。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで俄かに気を許したことが悪かったのだが、お午の御飯に、今日はゆっくり食べようと思って、三十分ほど階下へ降りている時だった、二階で何か、ガサッと云う音がしたようなので、急いで上って来てみると、襖が五寸ほど開いている。",
              "citation": {
                "source": "猫と庄造と二人のおんな",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
