    "definitions": [
      {
        "index": 1,
        "gloss": "to yell",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は興奮して、周りの声も聞こえないほどがなり立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "隣の部屋から、誰かが大声でがなり立てる声が聞こえてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "監督が選手たちに向かって、作戦をがなり立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "会議中、突然感情的になってがなり立てる人がいて困った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "特に初めて射った直後の、体中の細胞という細胞が勝手気ままに大声でがなり立てるような狂騒状態は、豊饒とでも評したくなるような奇妙ですさまじいものでした。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、突然、となりの左官の家で山の神のがなり立てる声が起こった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その大人は泣き叫ぶ子供を鎭めようとしているらしく、その泣聲が外に漏れるのをひどく苦にしている樣子だったが、そのくせ自分のほうが子供よりひどくがなり立てるのだった。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "うめきながら熱冷ましの座薬を使いますが、チューニングの狂ったオーケストラが、ばらばらのメロディーをフォルテシモでがなりたてるような狂騒の宴は、そこからさらに一時間近く続きました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、彼はがなりたてるのだ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月頃からこの虫が腹の中で暴れて、雪が食いたい、雪が食いたいとがなりたてる。",
              "citation": {
                "source": "五色温泉スキー日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑仕事や女房のがなりたてる声から逃れるには、銃を手にして森のなかへ迷いこむよりほかに手段はなくなった。",
              "citation": {
                "source": "リップ・ヴァン・ウィンクル",
                "author": "ディードリッヒ・ニッカボッカーの遺稿",
                "note": "青空文庫"
              }
            },
            {
              "text": "先夜は失礼した――」　低迷する左膳の声――とともにこの時母家のほうに当たって戸のあく音がして、鈴川源十郎のがなりたてるのが聞こえた。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある人々はわれわれアメリカ人、そして一般に近代人は、古代人――エリザベス時代人にくらべてさえ、知性的な小びとであるということをやかましくわれわれの耳にがなりたてる。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの地獄の鐘めが、いやにうるさく我鳴り立てるもんだから、つい……」２　名高い提琴家ミイシャ・エルマン氏が、初めて大阪に来て、中之島の中央公会堂で演奏を試みたときのことだった。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "狗が外から帰つて来ると、嬉しさうに我鳴り立てるし、狗が日向ぼつこでもすると、自分もその前に蹲踞込んで、太い嘴で相手の鼻つ先を突き廻したりする。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この婦人会は大阪市の有力な夫人が集まつて、姉さんごつこのやうな事をして遊ぶ為に拵へてあるのだが、広岡のお婆さんが、何ぞといふと我鳴り立てるので、近頃出席者がぽつぽつ減り出した。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫のやうに背を円つこくして哲学を考へてゐると、電話がやかましく我鳴り立てるし、こつそり恋でもしてゐると、窓の外を嫉妬家の電車が、狂人のやうな声を立てて駈けづり廻る。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの地獄の鐘めが、いやに我鳴り立てるもんだから、つい……」　名高い提琴家ミイシヤ・エルマン氏が、初めて大阪に来て、中之島の中央公会堂で演奏を試みたときのことだつた。",
              "citation": {
                "source": "茶話",
                "author": "昭和三（一九二八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "何百というこの独立の私営賭馬人が、思い思いのところにずらりと陣取って、サム・ワウだのアウサウ・フウリガンだのという名乗りの大看板をあげ、酒場の主人らしいのや東部のごろつき然たるのが、汗と泡を飛ばしながら、白墨と財布を両手に握って、台の上から我鳴り立てる。",
              "citation": {
                "source": "踊る地平線",
                "author": "テムズに聴く",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、ことばの判らない時の用意にもと絶えず貯蔵してある奥の手を出して、例のにやにやをやってみたが、先方には一から反響しないどころか、しまいには自分でいらいらして来て何やら耳のそばで我鳴り立てる始末。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "卓上電話は癇癪を起したようにジリジリと我鳴り立てる。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲間には馬鹿丁寧で、お神さんに頭が上がらず、おしのどんにもやさしい口を利く師匠なのにこの自分にばかりはガミガミガミガミ我鳴り立てる。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "八五郎が遠慮もなく我鳴り立てると、平次は店の方から飛んで來ました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お此お糸",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎者の表情、絶間なく我鳴り立てる老婆――それ等は実に完全に表現され、皆を笑わせた。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちぇッ、どこまでドジに出来てやがる」　と、のッけから、散々に我鳴り立てるので、独鈷の仁三が、しきりに※せした効もなかった。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
