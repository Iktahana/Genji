          "standard": [],
          "literary": [
            {
              "text": "伊藤は牙籌一方の人物で、眼に一丁字なく、かつて応挙の王昭君の幅を見て、「椿岳、これは八百屋お七か」と訊いたという奇抜な逸事を残したほどの無風流漢であった。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵学者中に数学上の著述のあった者には山県大弐の『牙籌譜』などもある。",
              "citation": {
                "source": "文化史上より見たる日本の数学",
                "author": "三上義夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
