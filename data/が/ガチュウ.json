[
  {
    "uuid": "8fef6b86-5a31-55b3-a113-ab6a3f838b7b",
    "entry": "画中",
    "reading": {
      "primary": "がちゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
