          "literary": [
            {
              "text": "ロバート・ボイルも直接に、またガッセンディを通じて間接にルクレチウスに親しんだ事が明らかである。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "王都の中央にてエルベ河を横ぎる鉄橋の上より望めば、シュロス・ガッセに跨りたる王宮の窓、こよひは殊更にひかりかがやきたり。",
              "citation": {
                "source": "文づかひ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "王都の中央にてエルベ河を横ぎる鉄橋の上より望めば、シュロス、ガッセにまたがりたる王宮の窓、こよいはことさらにひかりかがやきたり。",
              "citation": {
                "source": "文づかい",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "山岳会の陳列場は、ワイセンハウスプラッツから、右に曲ったツォイクハウス・ガッセで、建てものはミュンヘンみたいに立派ではないが、千八百七十四年に、万国聯合郵便大会が初めて開催されたと云う、曰くつきの家だから、門口にカントンの紋章をうって、表からのぞき込んだばかりでも何となく黴くさい。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
