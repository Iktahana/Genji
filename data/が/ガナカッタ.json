          "literary": [
            {
              "text": "答　其ノ日マデ、確カナ証拠ガナカッタノデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年時カラ六十三四ニ達スルマデハ、肛門周囲炎ノ手術デ一週間程度入院シタ以外、病気ラシイ病気ハシタコトガナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンガ行ッテシマッテカラ一人デ静カニ考エテ見ルト、アンナニ怒ラナイデモヨカッタ、颯子ガ婆サンカラ聞イテドンナ風ニ取ッタカト、シキリニ気ニナッテ仕様ガナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ子供ニモ隠シヨウガナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ今日マデハソレヲ確カメル機会ガナカッタガ、今日彼女ガ映画ヲ見ニ出カケタ間ニ茶ノ間ヲ捜シテ、容易ニ探リアテルニハ、早クモ僕ニ嗅ギツカレルヲスル女デアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………考エマイトシテモソノ家ノ様子、室内ノ空気、二人ノ寝テイル恰好マデガ浮カンデ来テ仕方ガナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
