      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "face (of person)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "突然の衝撃で、彼は顔面から地面に叩きつけられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試合中、サッカーボールが彼の顔面を直撃し、一時的に意識を失った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "緊張のあまり、彼の顔面は蒼白になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "そのピエロは顔面に派手なメイクを施し、子供たちを喜ばせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "白髪交りの荒い頭髪は何時も三四分位に刈揃へられ、さうした顔面の上に「ワ」の字型に懸つてゐた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "代りに親猪の怒れる顔面を翁は保与のついた山松の根方に見出した。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上は全身に関する「いき」であったが、なお顔面に関しても、基体としての顔面と、顔面の表情との二方面に「いき」が表現される。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "基体としての顔面、すなわち顔面の構造の上からは、一般的にいえば丸顔よりも細おもての方が「いき」に適合している。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔面の表情が「いき」なるためには、眼と口と頬とに弛緩と緊張とを要する。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに顔面における「いき」の表現は、片目を塞いだり、口部を突出させたり、「双頬でジャズを演奏する」などの西洋流の野暮さと絶縁することを予件としている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上、「いき」の身体的発表｛３｝を、特にその視覚的発表を、全身、顔面、頭部、頸、脛、足、手について考察した。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔面に対してかなり大きな角度をして突き出た三角形の大きな鼻が眼に付く。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、そこには栗鼠の毛皮の外套をつけた、僕にたいする敵愾心を青ざめた顔面に浮べた女性が寝台の柱に凭掛っていた。",
              "citation": {
                "source": "東京ロマンティック恋愛記",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は、今まで押し怺えていた泣けそうなものが、一時に顔面に溢れて来るのをどうすることも出来なかった。",
              "citation": {
                "source": "雪のシベリア",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔面はさんざんに傷われて見るかげもなくなっていた。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "微笑したるところの幻影であり、沈默せる遠きけちえんの顏面であることを明らかに知覺するとき我は卒倒せんとする。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして先生の顏の平面が急に崩れて、顏面筋が小波のやうに痙攣したかと思ふと、怒りの紅潮がさつと顏中に走つた。",
              "citation": {
                "source": "猫又先生",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにかその顏面筋肉の收縮の感覺に快感があるかの樣に。",
              "citation": {
                "source": "奎吉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年の顏面は自身の努力によつて赤らんでゐた。",
              "citation": {
                "source": "夢",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "漆の中に眼の輝く、顏面凡て髯なるが、兩腿出した毛むくぢやら、蝟の大胡坐で、蒋生をくわつと睨む、と黒髯赤く炎に照らして、「何奴だ。",
              "citation": {
                "source": "麥搗",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "從つて顏面は若くは蒼白、若くは黝黄、若くは枯赭で、間々或は肺病徴候のやうに兩頬の美淡紅色を呈して居るのもあるが、先づ大抵は眼の結膜などの紅色も薄くて、腦の血量の乏しいことを現はして居る。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は長い時間氷雪の間を渉つた後、一｜杯の冷たい釣瓶の水を注ぐことによつて快よい暖氣を其の赤く成つた足に感ずる樣に、僅少な或物が彼の顏面の僻んだ筋を伸るに十｜分であるのに、彼は其の冷水の一｜杯をさへ空しく求めつゝあつたのである。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "深い憂が顏面の皺に強く刻んだ。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして其顏面には何處にも寛容の樣子を發見し得ない。",
              "citation": {
                "source": "記憶のまゝ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "校長は今迄忘れて居た嚴格の態度を再び裝はんとするものの如く、其顏面筋肉の二三ヶ所に、或る運動を與へた。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "不圖したら今日締切後に宣告するかも知れぬ、と云ふ疑ひが電の樣に心を刺した、其顏面には例の痙攣が起つてピクピク顫へて居た。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "立ちあがるなり目の前にあるビール瓶をつかんで、櫻内の顏面をめがけて力いつぱい投げつけた。",
              "citation": {
                "source": "就職",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "顎骨と顏面骨の下部とは石炭と乾いた血と粘々した肉とに全部蔽はれてゐるので檢死官は初め下顎骨は燒失したものと思つた位であつた。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の顏面には物凄い掻傷と打撲傷とがあり或恐ろしい長時間の爭鬪をやつた跡を顯はしてゐた。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは顏面といふだけではなく、心にまで觸れてゐます。",
              "citation": {
                "source": "鏡二題",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "（第壹圖イ參照）第壹圖（武藏權現臺）イ（土器）　ロ（土偶顏面）　ハ（土偶胴部）　斯うして殆ど毎日の如く掘つて居る間に、萱原を三｜間幅で十｜間ばかり、南から北まで掘進んで、畑の方まで突拔けて了つた。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "權現臺の懷古",
                "note": "青空文庫"
              }
            },
            {
              "text": "正しく土偶の顏面なのであつた。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "權現臺の懷古",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の聖人像は顏面のみを簡素にしてしかも生き／＼と表現され居り、服裝等の用筆は極めて粗なり。",
              "citation": {
                "source": "日本の肖像畫と鎌倉時代",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "像の部分的手法も洗練された作家の神經をおもわせるものがあり、大まかな肉づけの緊密性、細部の適當な處理、頭部をつつむ王樣頭巾の樣式化、顏面の氣品などに意を用いていることがわかる。",
              "citation": {
                "source": "古代エジプトの作品",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
