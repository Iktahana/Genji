        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は引き出しの中をがじゃがじゃとかき回し、古い手紙を探していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「どこに置いたっけ？」と、彼はカバンの中身をがじゃがじゃと漁った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あら、そんなにがじゃがじゃ探さなくても、きっと見つかるわよ。」と母は優しく言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "書類の山をがじゃがじゃと掻き分ける音だけが響いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ともし灯を慕うて桐の葉にとまった轡虫が髭を動かしながらがじゃがじゃがと太十の心を乱した。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
