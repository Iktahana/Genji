[
  {
    "uuid": "d3851edd-f1f7-5bac-851e-e9b56a5fe900",
    "entry": "画心",
    "reading": {
      "primary": "がしん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
