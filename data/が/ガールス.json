        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "昭和…年頃のあやしげなレヴュー団によくあった例だが、そのレヴュー団、ピエロ・ガールスではたいていの踊子たちは入団した途端に女にされてしまう。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "レヴューが好きで、弥生座のピエロ・ガールスのファンだった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日土門が豹一と弥生座の前で会うことにしたのも、じつはピエロ・ガールスを見るためであった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピエロ・ガールスに悪漢はちゃちな海賊船ほどいるがね、あのいたいけな、なよなよした、可憐な東銀子のような娘を食うのは、ピエロ・ガールスひろしといえど、貴様のような助平爺ひとりだ！",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――こちらはピエロ・ガールスの座附作者であらせられる北山老人」　よろしくと豹一が頭を下げると、北山は瞬間別人のように改った表情をちょっと見せて、「これは、これは……。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はマチネー、十二時近く宿を出て、さくらゐ屋で大人の玩具類を求め、こっちでガールスの会をやってやる約束がフイになったから、さくらゐ屋の人形その他で三十個くぢを造ってやることゝした。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼終りに、ガールスその他にくぢ引きさせた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一回の終りに、ガールス二三人連れて、石段下の十二段家へ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時半頃からロッパガールスの宿、美登里館といふのへ行く、勝太郎に貰ったもなかを土産に。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二時、日劇五階でガールスの声楽試験を徳山にやって貰ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガールスが水泳をやり出したので、禁じる旨はり出した。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月は男はなるべくその方へ、大部屋は東宝劇団へ貸し、ダンスチームは東横・横宝のアトラクションに廻ってロッパ・ガールス公演と大きく出ようといふことになった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "横浜と東横へ定ったロッパ・ガールスが「私たちガールスだけで独立公演したい、田村・北村の応援無用」と、稽古に入らなかった件あり、柳はぢめ文芸部に注意せよと言ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "横浜へロッパ・ガールスが出てゐる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "終ると東横へ行き、アトラクション、ロッパ・ガールスの「ブーケドートンヌ」を見る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "うちのガールスの中、清見他二名来り、テストして貰ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "上山が佐藤邦夫と来り、十二月ガールスの公演用、「青春デパート」といふのを僕案で立てる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネると、今日はロッパ・ガールスのすきやき会で、宝塚へ、川万の三階大広間、昼間うっかりしてすきやき食ったのでもう食べる気なし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉野にたのまれた問題の会で、青年部・ガールスがやり、藤山・山野が呼びもの、僕も十五六分喋る、吉野大感激で男泣きした。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガールスの一人で故郷へ帰ってゐた雲井つばさ死去の報あり。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「遠山」の暗転で、暗くなり切らないうちに体をくづすのでガールスを怒る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "技芸賞とナロー賞は、「松の一番」の月野恵子、「遠山」の久米夏子、「フォリース」の加川・兎のダンスチーム、リヅムガールス四名に出た。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガールスの葉月照子が花井と連立って来り、ベソ／″＼涙ぐんで話すが一向ハッキリせず、くしゃ／＼しちまふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
