  {
    "uuid": "63819957-f9c2-58f0-a9fc-be4aa7545738",
    "entry": "ガンドウ",
    "reading": {
      "primary": "がんどう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
