        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "六月二日　北ガスビル裏の、にしん料理小原女へ。",
              "citation": {
                "source": "このたび大阪",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時近くガスビル裏の丸治へ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "済むと、文芸部連七名で、ガスビルの食堂へ、さゝやかに食事し、いろ／＼意見をきく、舞台進行といふ名を変へて貰ひたいと提議される。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "五時ガスビルの食堂で、天中軒雲月と対談。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガスビルの永田氏、ガスビルまんじゅう持参で来訪。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガスビルの永田氏に招かれてゐるので、三益と高杉を連れてガスビルへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "来訪永田ガスビル・加藤雄策。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事は抜きにして、十二時阪急梅田で、上山・堀井等と落ち合ってガスビルへ、永田氏に地下グリルを馳走になる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三時に起きる、平野の骨折で、土佐堀の京家といふ宿へ移ることゝして、僕と堀井はガスビルへ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガスビル趣味の会、先日の放送をそのまゝ実演といふ趣向、熱八度以上。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "五時近くガスビルへ、昨日の会三十分程やって、座へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "松竹本社の千葉吉造氏のとこ、これが朝鮮出張中、吉本の林正之助氏へ行くと上京中、ガスビルの永田氏のとこへ行ったら留守、三ヶ所ともフラれた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ第一に、丸治――ガスビル裏の丸治の料理、お値段もいゝが、うまし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガスビルの趣味の会てのへ今明日オザで行く（100）。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人別れてガスビルへ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二時すぎに終り、道子を乗せ、梅田映画劇場へ「綴方教室」を見に行ったが満員で、ガスビルの映画館へ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼終ると、ガスビル迄使をやり、べーコンエグス、サンドイッチ二つとり、食べる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月二十四日（水曜）　竹川が迎へに来り、ガスビルへ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の終り、ガスビル迄、花井と轟を連れて、地下のグリルへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月十六日（木曜）　十一時起き、夫婦でガスビルの永田氏を訪れようといふ日。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時半頃ガスビルへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガスビルの永田将紀と会ひ、天八といふのへ入り天ぷらを食べる、天汁がくどい、僕には安いハゲ天の方がいゝ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆で揃ってガスビル地下のグリルへ行き、食事。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月二十四日（月曜）　十一時起き、ガスビルへ永田氏を訪れる、女房とも／″＼行くと、食堂へ案内され、昼食と他にチキンカツレツを馳走になり、二階の映画場で「木に攀る女」といふ映画を見る、涼しくていゝ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は舞台けい古十二時すぎからと定り、女房・竹川・堀井とでガスビルへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから三益とガスビルへ、講演場のガスビル趣味の会で漫才をやる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼終るとガスビル趣味の会へ、三益・上山と早目に行き、地下のグリルで食事する。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
