        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "先日、佐藤先生よりハナシガアルからスグコイという電報がございましたので、お伺い申しますと、お前の「晩年」という短篇集をみんなが芥川賞に推していて、私は照れくさく小田君など長い辛棒の精進に報いるのも悪くないと思ったので、一応おことわりして置いたが、お前ほしいか、というお話であった。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "マタ、俺ノ眉毛ヤ俺ノ皮膚ハレプラニナル可能ガアル。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノスケッチニ取ルベキトコロノアルモノガアルデショウカ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ノ日記ニハ「古白曰来」ノ四字ガ特書シテアル処ガアル。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、その色彩の原素性は、彼がフランス的であるといふ意味でシャガアル風な民俗的などうにも割り切れない人間的な色彩上の原素性、原始性ではない。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲイシャガアルは素晴しいね」とか言い、皺くちゃの顔いっぱいに、歯の疎らな口を開け、笑ってみせます。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――今日ハ小峯公園ニケイ馬ガアル。",
              "citation": {
                "source": "貧しき日録",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シイゼエボオイ・エンドゼエガアル」と。",
              "citation": {
                "source": "地球儀",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ガアル・ド・リヨンの停車場へ自動車で着いたのは、ちょうど八時幾分かの急行の出る少し前だった。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトニヨルト、我国ニハ「シロウトハクロウトヲ支配ス」トイウ法則ガアルノデハナイカト思ウガマダ調ベテモミナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "九、印刷文化ノウエニズイブン大キナ徳ガアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "十、世ノ中ニハ、ソノ気ニナルノハワケハナイガ実行ガ面倒ダトイウ問題ト、実行ハ簡単ダガナカナカソノ気ニナレナイ問題トガアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまだに欧羅巴と亜米利加では係りの探偵が眼を皿のようにしてキスの影を求めているが、これこそほんとの不良外人だ、ひょっとすると、モダン・ガアルを狙って銀座あたりを流しているかも知れない。",
              "citation": {
                "source": "生きている戦死者",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　其ノ日「マージャン」ヲシテ居ル最中、タシカ九時半頃デシタト思イマス、友田ガ便所ニ立ッタノデス、スルト道子ガ続イテ何カ台所ニ用ガアルト見エテ室ヲ出マシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ勿論権利ガアルトハ思イマセンケレ共、余リ乱暴ナ言イ方ナノデ私モ二言三言申シマスト、　「一体アナタハホントニ私ニ可愛ガラレテ居タト思ウノ？",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　被告ハ清三ニ恨ミガアルノカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つはガアル・ド・リオンに、一つは東の停車場に、一つはサン・マルタンの商店をこわした。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ産ヲスルマデハ、イクラ物好キナ彼奴トテモ手ヲ出ス様ナコトガアルマイ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論こんな言葉は主として若い細君や、職業婦人、学校の先生、女学生、モダンガアル等が使うようである。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "女学生やバスガアルの帽子を見るに、何ゆえか素晴らしく大きなもので、殊に前後へ間延びしている。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣にある昔の市長の住んだドガアルの宮殿はモネが此春｜描いた絵で見知つて居たが、僕の着いた当日は何かの節会で縦覧させない。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日目には美術館でチチアノの「基督昇天」、「ピエタ」を始めチエボオロの画を観、又貴族政治時代の栄華をドガアルの宮殿に眺めたが、フイイレンチエ行の汽車の時間が迫つたから委しく書く余裕が無い。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イブセンの第三帝国の所で、キアルケガアルドが真理は主観であると云う事を云って居たとあるがそれには同意しかねるのである。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしたらミス・ソーヤーは、シイ・イズ・ア・ナイスガアルっておっしゃったんですもの……行きましょうよ！",
              "citation": {
                "source": "海流",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　困ったように杉は黙りこんでいたが、「あたし、ちっともナイスガアルなんかじゃないわ」　内気な中に譲歩しない口調で、やっぱり秋田訛を響かせてねばっている。",
              "citation": {
                "source": "海流",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼ハ大キクハナイガ非常に特色ガアル。",
              "citation": {
                "source": "ロシアの過去を物語る革命博物館を観る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
