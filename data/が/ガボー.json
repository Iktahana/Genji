        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "糺の森がぼーっと霞んで見えなくなる。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "齒を食ひしばつてぢつと堪へてゐるうちに眼の前がぼーつと暗くなり、意識が次第に痺れて行くのが自分にもわかるのである。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "寢臺の上に一寸立上つても貧血のために目の前がぼーツとかすむやうになると、彼はしばしば幻影に惱まされ始めた。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝台の上にちょっと立ち上っても貧血のために目の前がぼーッとかすむようになると、彼はしばしば幻影に悩まされ始めた。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "膳に向っても、水にでも浸っていたように頭がぼーッとしていて、持ちつけぬ竹の塗り箸さえ心持が悪かった。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "方々へ無事帰庵のハガキを書く、身心がぼーつとしてまとまらない、気永日永に養生する外ない。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、どきんと心悸がたかまり、目先がぼーっとなってはッきり確かめることは出来なかった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして急にあたりがぼーっと見えなくなった。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うーむ」、　房枝は、黒川のうなるこえをきいたが、次の瞬間、彼女も頭がぼーっとしてしまった。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりイワノフ博士の人造人間エフ氏の実験をたいへん長いこと見せてくれたんだが、あの日は、人造人間エフ氏の身体と僕の身体との間になんだか怪しい火花をぱちぱちとばせてさ、急に目まいがして、しばらくなんだか気がぼーっとしてしまったんだよ」「まあ、ひどいわね。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひょっとすると、そのドン助というのは、そのときこの○○獣に喰われてしまったかもしれないよ」「ええっ、ドン助が○○獣に喰べられてしまいましたか」　それを聞くと、敬二は頭がぼーっとしてきた。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それには及ばぬ」こういって再び持ち上げましたが、その瞬間、ふと、これが昨日まで一しょに語った箕島の『はらわた』であるかと思って、気がぼーっとしました。",
              "citation": {
                "source": "稀有の犯罪",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だか気がぼーっとして、心臓の音だけが、いやに強く私の耳に響きました。",
              "citation": {
                "source": "体格検査",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして傍らにあった椅子に腰をかけ、気を静めようとしましたが、何だか頭がぼーっとしてきました。",
              "citation": {
                "source": "玉振時計の秘密",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "体じゅう熱くなるばかりで、人の顔や声がぼーっと遠のいたようになるのであった。",
              "citation": {
                "source": "打あけ話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……その辛辣さがこたえて、ひろ子の目さきがぼーっと涙でかすんだ。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜気に冷えた窓硝子がぼーっと曇りを帯びるほど、車室内の空気は温まっているのに、彼は黒羅紗のマントに固く身を包んで、二人分の座席の真中に、棒のように真直に坐っていた。",
              "citation": {
                "source": "林檎",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲にさしてる明るみがぼーと仄白くて、今にもそれがだんだん薔薇色に染ってきそうだった。",
              "citation": {
                "source": "月かげ",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして実際、不意に葦の茂みが無くなって、その高い堤防の上から、向うにぽつりぽつりと真白な花の咲いてる蓮田が見渡された時、振返ってみると、東の空の裾がぼーっと薄赤く染っていた。",
              "citation": {
                "source": "道連",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "煤けた三尺の仏壇に、小さな新らしい位牌がぽつりと立っていて、豆ランプがぼーっとともっていた。",
              "citation": {
                "source": "狐火",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "櫺子窓からさす廊下の明りがぼーっと曇っている。",
              "citation": {
                "source": "春",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "強く強く抱きしめられたということ以外は、頭がぼーっとして、何にも覚えていません。",
              "citation": {
                "source": "女と帽子",
                "author": "――「小悪魔の記録」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼のように明るい街路、美しい賑やかな人通り、宮殿のようにきらびやかな店先、うまそうな食物の匂い、楽しい音楽の響き、そんなものに悪魔は気がぼーっとして、いつまでもうろついていました。",
              "citation": {
                "source": "不思議な帽子",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、霧の中がぼーっと明るいのは、月の光りがさしていたのでしょうか。",
              "citation": {
                "source": "男ぎらい",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "見まわしたが、書棚の硝子戸がぼーっと白んでるだけで、異状はない。",
              "citation": {
                "source": "或る作家の厄日",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "物忘れが甚しく、時によると記憶全体がぼーっと陰った。",
              "citation": {
                "source": "怒りの虫",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "全山紅葉だが、赤色から黄色にいたる色どりがぼーっとかすんでいる。",
              "citation": {
                "source": "山上湖",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そうですね、いつも頭がぼーっと熱でも出たように熱くなって、それに何だか物を考える力が無くなってくるようです。",
              "citation": {
                "source": "囚われ",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、三杯の酒に私は頭がぼーっとしてしまった。",
              "citation": {
                "source": "楠の話",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔がぼーっと赤くなっていた。",
              "citation": {
                "source": "子を奪う",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
