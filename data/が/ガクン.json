        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その間雑木林の下道のゆるやかな坂を曲り、竹煮草の森のような茂みの傍を通り、仄白い野菊の一ぱい咲いている野原の一片が眼に残り、やがて薄荷草がくんくん匂って里近くなって来た往還で、かの女はタクシーを拾って、東京の山の手の自宅へ帰って来た。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝陽は靄を抜けて、光をじかに庭に当て始めたためでしょうか、木々の芽立ちの匂いがくん／＼あたりに立ち籠めてまいりました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷畑から採って来た鮮かな山葵の束が縁につけてあるのがくんくん匂う。",
              "citation": {
                "source": "呼ばれし乙女",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに僕毎日百ずつ息をかけてみがくんですもの」　「実際そうだといいがな」とお父さんが申しました。",
              "citation": {
                "source": "貝の火",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「莫迦だなア」　ちょっと笑って、信吉はいきなり口を寄せると、冴子はがくんと信吉の胸へ倒れて来た。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "右側の棟の外れに足場がくんであり、石の壁が崩れていたが、我々が訪れたとき、職人の姿はどこにも見えなかった。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "平野水がくんくんと音を立てるような勢で、食道から胃へ落ちて行く時の心持は痛快であった。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼は、そんな似而非ヒロイズムを呟きながら、がくんがくんと玩具のやうに首を動かせた。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく彼は炉の火にからだをあたため、宿のかみさんがくんで出してくれる熱いネブ茶を飲んで見ている間に、なかなか人の口に戸はたてられないことを知った。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "所が突然爺はその場にがくんと跪いて頭を温突につけ、「う、わっしあ、丁元三でごぜえますだ。",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "息がぜいぜいとなって苦しく悶え、爺はその場にがくんと坐り込んでしまいそうだった。",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "爺は慌てて再び起き上ろうとして膝を立てたが今度はそれががくんと辷ってころげ出した。",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、調子に乗って喋り立てていた安倍誠之助もがくんと躓くものを感じた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人も無げな騒々しいひびきのなかで、一つの固有名詞が阿賀妻の足をがくんと停めた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんならわしがくんで来てやるが」「はあ、いえ、あの、かまいません」　渡る世間に鬼ばかりもいない。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネルの着物を通して山肌がくんくん匂っている。",
              "citation": {
                "source": "風琴と魚の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "湖畔に出て、しばらくほえたてていたペットは、急に後脚が痛くなって、がくんと雪の上にへたばってしまった。",
              "citation": {
                "source": "美しい犬",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあさ、自動車よ、礼ちゃん眠っちゃ駄目よ、重いじゃないのさア」　啓吉が見上げると、母親の腕の中で、礼子が頭をがくんとおとしていた。",
              "citation": {
                "source": "泣虫小僧",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻のいなくなった部屋で、彼はがくんと蹲り茫然としていた。",
              "citation": {
                "source": "苦しく美しき夏",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はがくんと蹲り祈りと怒りにうち震えた。",
              "citation": {
                "source": "苦しく美しき夏",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はがくんと突離されたやうな気持だ。",
              "citation": {
                "source": "魔のひととき",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "がくんと全身が痙攣した後、後は何ごともない静けさなのだ。",
              "citation": {
                "source": "心願の国",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "その廻転椅子は心棒がどうかしていると見え、彼が尻を下ろした途端にがくんと大きな音をたてて後へ傾いた。",
              "citation": {
                "source": "地獄の使者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思ったら、とたんに、ぷすーっという音がして、がくんと横にかたむき、速度が落ちた。",
              "citation": {
                "source": "不沈軍艦の見本",
                "author": "――金博士シリーズ・10――",
                "note": "青空文庫"
              }
            },
            {
              "text": "がくんとハンドルは引かれ、スロット（飛行機の両翼にある墜落をふせぐ仕掛）は変えられた。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "三本松にかかったばかりだから――一時間の余あらあ」「早く出て来すぎたかな、こりゃあ」　がくん、と汽車は動き出した。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その肩から背へかけて露出した肌を、思いきって見せつけられるところへ、真黒くふんだんな髪の毛がくんずほぐれつして乱れかかる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その無意味なやうな薄暗がりのなかに何者かがくんづほぐれつして爭つてゐる。",
              "citation": {
                "source": "「馬車」",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると、全身に気持のよい貧血が起って、しだいにうとうととなってゆくそうですからな」　その瞬間、伸子の視線がガクンと落ちて、両手で顔を覆い、卓上に俯伏してしまった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ところで、八住が殺された際に、貴方だけは椅子に落着いていて、動かなかったそうでしたね」「無論そうなりましょうとも」　とヴィデは、黒眼鏡をガクンと揺すって、傷痕だらけの物凄い顔を、法水に向けた。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
