        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヨキ文章ユエ、若キ真実ノ読者、スナワチ立チテ、君ガタメ、マコト乾杯、痛イッ！",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "封建時代ノ武士ガ凡テ後顧ノ憂ナキガタメニ其ノ道義的奮進又ハ犧牲的冒險ヲ敢行シ得タル如ク、國民ハ其ノ子女ノ國家的保障ノタメ戰場ニ於テモ平和ノ其レニ於テモ何等後顧ノ憂ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "男子ノ姦通罪ヲ罰スルコトハ第一ニ一夫一婦タル國民道徳ノ大本ヲ明カニスルガタメナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮其者ノ歴史ガ示ス如ク、又清國ガ此レヲ屬國トセンガ爲ニ起リタル日清戰爭、及ビ滿洲ニ來タレル露西亞ガ其ヲ侵略セントセシガタメニ破レタル日露戰爭ニ示ス如ク、其ノ亡國タルベキ内外呼應ノ原因ハ統治者ガ日本タラザル時ハ露支兩國ノ焉レカナリシハ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ル民族ガ其ノ國家組織ヲ失フ所以ハ外部的壓迫ト内部的廢頽トニヨリテ自決スル力ヲ缺ケルガタメナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "（則チ當面ノ現實問題トシテ濠洲又ハ極東西比利亞ヲ取得センガタメニ其ノ領有者ニ向テ開戰スル如キハ國家ノ權利ナリ）。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "スナワチ、高山山巓ニ於テ、米国ノ放送ヲ如何ナル程度ニ受信シ得ラルルカヲ試ミンガタメナリキ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ノ欲スルトコロハ領土ニアラズ、物資ニアラズ、己レノ良心ト信仰トノ活路ヲ見出サンガタメニ新天地ニ出デタルモノ也。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "画人ハ背景ヲ描カンガタメニ俳優ノ鼻息ヲ窺ヒ文士ハ書賈ノ前ニ膝ヲ屈シテ恬然タリ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガタメニ遂ニ加筆スル所ナクシテ止ミヌ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガタメニ悲感更ニ深シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "目コレガタメニ奪ハル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ日駅吏ワガタメニ供帳ヲ中田ニ設ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガタメニ竟夕寧カラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "独千仞ハ藩論反覆ノ日ニ当ツテ挺然トシテ正義ヲ持シ一時コレガタメニ獄ニ下リ幾ド死セントス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル予言ニヨラバ、閣下、定メラレシ年月過ギシノチ、コノ世ニ甦リ、コノ家カラコノ地ヲ再ビ征服センガタメ、崇拝者ヲ連レテ立ツ、トアリ。",
              "citation": {
                "source": "処刑の話",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ノ喜ビヲ買ワンガタメニ負傷ヲシテモ惜シイトハ思ワナイ、ソノ負傷ガ原因デ死ヲ招イタトシテモ、ムシロ望ムトコロデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
