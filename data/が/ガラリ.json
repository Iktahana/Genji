    "definitions": [
      {
        "index": 1,
        "gloss": "(opening a door) with a clatter",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「お邪魔します」と声をかけ、古い木製の引き戸をガラリと開けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ガラリと襖を開けると、そこには雪の積もった美しい庭園が広がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夜更けに玄関がガラリと開く音がして、ようやく父が帰宅したことに気づいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「起きてる？」母がガラリと戸を開けて、朝食の準備ができたことを知らせに来た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」　桟敷の後の戸がガラリと開く。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）　＝（Ｆ・Ｉ）物部の家　表障子ガラリと開いて嘉助老人打ち沈んで帰って来た。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "＝五郎蔵の家の表　大吉と半次格子戸をガラリと開くと、　バラバラと五六人の通行人急ぎ、　走り去る。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "座敷へ上って――　次の室の襖ガラリ開いて二人共アッと叫んだ。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　すると彗星の態度がガラリと変ってしまいました。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "６３＝内部　一室の襖がガラリと開くと室の中には浪人浪之助。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "63＝内部　一室の襖がガラリと開くと室の中には浪人浪之助。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も千万……」「ところが又その前の御寮さんが今のお熊さんを難産したアトの長患で死にまして、今度の後妻……お艶さんと申します……相生町の芸妓上りで……それになりますと女中衆の素振りまでが、見る間にガラリと違うて来ましたなあ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも江戸、大阪へ紛れ込む積りで御座いましっろうか……その当てがガラリと外れた昨晩の蔵元屋のお召捕騒動。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君の家」の君勇は稽古に出掛けようとして、「……通い馴れたる細路地を……」　と、昔、はやったが今はもう時代おくれになってしまっている鴨川小唄の一節を、ふと口ずさみながら、屋形の玄関をガラリとあけて出た途端、「あら――」　と、立ちすくんだ。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お房は、點首いたまま、土間を下りるか下りぬに、ガラリ格子戸を啓け、顏だけ突出して大きな聲で花屋を呼ぶ。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は顔を見合わせて、どうしたらいいか困っておりますと、表の入り口をガラリとあけて、最前馬に引っぱられて走って行った馬車屋のお爺さんが這入って来ました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で、夫婦と子供三人の一家が夕食の最中に、主人が箸をガラリと投げ出して、「タッタ今おれに不動様が乗り移った」　と云いつつ凄い顔をして坐り直した。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから汁椀をソッと置いて、大きな飯の固まりを二ツ三ツ、頬張っては呑み込み呑み込みしたと思うと、真青になってガラリと箸を投げ出してしまった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも……これから心掛けます」「つまり湯に這入るふりをして棄てたんじゃナ」「ヘエ……じゃけんど、ヒョットしたら落いて行ったもんじゃ御座いませんでしょか」「馬鹿な……吾が児を落す奴があるか」　その時に男湯の入口がガラリと開いて、百姓姿の男が一人駈け込んで来た。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それなのに、昨年の秋、私がれいに依ってよそで二、三夜飲みつづけ、夕方、家は無事かと胸がドキドキして歩けないくらいの不安と恐怖とたたかいながら、やっと家の玄関前までたどりつき、大きい溜息を一つ吐いてから、ガラリと玄関の戸をあけて、「ただいま！",
              "citation": {
                "source": "家庭の幸福",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "箒売は土間の真中に突立ったまま唖然となって、上機嫌の二人を眺めておった……が、やがてガラリと血相を変えると、知らん顔をして指を舐めている仁三郎に喰って蒐った。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところへ表の扉がガラリと開いて、湊屋の仁三郎が這入って来た。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがサテその私が、頭や顔の手入れをして、見違えるような青年に生れ変ったのを見ますと、Ａの気持が又もやガラリと一変してしまいました。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "間抜けた強盗か、図太い強盗かと思いながら、ガラリと戸をあけると、素足に八つ割草履をはいた男がぶるぶる顫えながらちょぼんと立ってうなだれていた。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝るのにも化粧をする程お洒落で、お転婆な彼の従妹の道子は、丁度風呂から上つて唇や頬を塗り終へて、威勢よく梯子段をドンドン昇つて来るや、ガラリツと手荒く彼の室の障子を開けた。",
              "citation": {
                "source": "爪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして翌日になるとガラリと打つて変り何も知らぬ顔をしてゐるのだつた。",
              "citation": {
                "source": "熱海へ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "処へ案内もなく障子をガラリと開けて、方面無髯の毬栗頭がぬうッと顔を出した。",
              "citation": {
                "source": "貧書生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラリ、兵助は手にせる真槍を叩きおとされて、片手突きの当て身に脾腹を襲われながら、すでにそこへのけぞっていたところでした。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラリ槍を投げすてると、悄然としながらうしろを見せてとぼとぼと歩み出しました。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "(falling) with a clatter",
        "register": "standard",
