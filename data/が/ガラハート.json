        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "騎士の一人にガラハートという勇士があった。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラハートは当惑してあちらこちらと彷徨った。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてガラハートに呼びかけた。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたはなぜそんなに沈んだ顔をしていますか、日頃の雄々しいあなたにも似合わない」　ガラハートは親切な言葉を感謝して、自分のぶつかっている困難を打ち明けた。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「心配なさらないでようございますよガラハート、私はあなたの武勇を崇拝しているから、答を与えて上げましょう。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日限が来た時ガラハートは勇んで例の森へ出かけた。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やい、ガラハート、難題はどうした。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前の命も今日きりだぞ」　ガラハートは落着いて「まあまあ急ぐな」といった。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "言え」　ガラハートは清廉潔白な騎士であるから、森の中で、赤い着物を着た恐ろしい女に出合って、その女が智慧を貸してくれたことを告げた。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、婦人の社会におかれた地位の本質は、このガラハートの諷刺的な物語が示すようなものであったことは疑いない。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
