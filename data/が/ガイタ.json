        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "御返信ネガイタク、参銭切手、二枚。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年ノ今頃モ修繕シタコトガアッタッケガ、ソノトキハ赤沢常造ノ奴ガイタカラ、半日デ片付イタモノダ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラブラドンドン　トユラレテカラダヂウガイタミマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は割り部屋がなくなったし、割り部屋があったら、いつ洋服など身ぐるみ盗んでドロンされるか見当もつかず、それだけ世間が平和じゃないんだ、と石川淳が、彼らしい述懐によって世相をガイタンしていたのを妙にハッキリ記憶している。",
              "citation": {
                "source": "精神病覚え書",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、彼女の父が彼を浮薄な奴だと評したときいて、「若い男の心のプライドを傷けるに十分な四十男の世の見方でした」とガイタンしているのである。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "女というものはどうしてこう愚劣なんだろうかと日野はガイタンいたしました。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ショルダー・バッグを肩から吊るした女どもが、毎日、二三十人ずつもやってきて、プールで大騒ぎをするので、近所では、評判だったようです」　そこで、ガイタンに耐えぬというような顔つきになって、「話はちがいますが、職業の性質によるのか、彼等は、ふしぎに運動をしたがりませんね。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ガイタンヌ・ド・グウマンヴィル嬢、スュジイ・リセット嬢。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「センセ、オテテガイタイノ」　私は手を揚げるべき時にそう云った。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょッと理窟屋の日本人はすぐそう考えて、世をガイタンし、拙者の選ぶものが正しいとくる。",
              "citation": {
                "source": "現代の詐術",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "説教強盗氏が世相をガイタンされて、昔の盗人は仁義があった、とおっしゃる。",
              "citation": {
                "source": "ヤミ論語",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔新派ニ若山千鳥ト云ウ美少年ノ女形ガイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冗談ニソンナコトヲ云ッタラ、オ望ミナラサセテアゲマスト云ッテクレタ或ル待合ノ女将ガイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マア考エテオクコトニシヨウ」「今日御返事ガイタヾケナインデスカ」「コノトコロイロ／＼ト出銭ガ多クッテネ」ブツ／＼云イナガラ二人ハ出テ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ書ハ昔或ル美術商カラ手ニ入レタモノダガ、荷風ノ書ハ非常ニ偽筆ヲ上手ニ書ク男ガイタソウデアルカラ、コノ幅モ真偽ハサダカデナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
