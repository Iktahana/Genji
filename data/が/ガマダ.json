        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コトニヨルト、我国ニハ「シロウトハクロウトヲ支配ス」トイウ法則ガアルノデハナイカト思ウガマダ調ベテモミナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "往年ノ軽微ナ脳溢血ノ痕跡ガマダ残ッテイ、脳中枢ニ僅カナ変化ガアルノデ、ソレガ脚ニ影響シテイルノダトモ云イ、又レントゲンデ検ベテミルト頸椎ト腰椎トガ曲ッテイルカラデアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンテロビオフォルムヲ三錠服用シタガマダ止マラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日ノ諍ガマダ頭ニ残ッテイテ、少シイツモヨリ萎ゲテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂場ト離レ屋トヲ廊下デツナゲルノト、ピアノノ床下ニ煉瓦ヲ積ム工事ハアラカタ終ッタガ、電話ノ切リ換エガマダデアルシ、今日ハ赤口デ日ガ悪イカラ二十一日ノ大安マデ待チナサイト昨日郁子ハ云ッテイタガ、敏子ハ構ワズ行ッテシマッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………朝八時、妻ガマダ昏睡中ニ木村ガ来タ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレ臣ガマダ解カザルノ（戦袍ノ意）一｜也。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
