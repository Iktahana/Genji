  {
    "uuid": "aeb22328-9ca4-5bbf-89b7-5e23d65ce2a4",
    "entry": "ガアン",
    "reading": {
      "primary": "があん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ガアン、ドロドロドロドロ、ノンノンノンノン。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガアン、ドロドロドロドロ、ノンノンノンノンノン。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガアン、ドロドロドロドロ。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガアンと頭が鳴った。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽が窓いっぱいを赤くしてガアンと当たっていた。",
              "citation": {
                "source": "秘密の風景画",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでだ……まず劈頭第一に一つの難解を極めた謎々をタタキ付けて、読者のアタマをガアンと一つ面喰らわせてしまうのが、探偵小説の紋切型だろう。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽屋に運び込まれた親方の死骸に取付いてオイオイ泣いているうちに、片っ方で仲間を集めてボソボソ評議していた拳固の梅という奴が、いつの間にか立上って来て、何も知らない吾輩の横っ面をガアンと一つ喰らわしたもんだ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "岸に立っている二人の黒点が見えなくなると、静かなドックの上には、ガアン、ガアンと鉄を打つ音がひびいていた。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の黒点が消えると、静かなドックの上に、ガアン　ガアンと鉄を打つ音がひゞいていた。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「タンバガアン……」澄子が舟を呼んだ。",
              "citation": {
                "source": "ボルネオ　ダイヤ",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな金槌で、ガアンと頭のてっぺんをどやされた形だった。",
              "citation": {
                "source": "反逆",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂ゲエテ・クロオチエ・スピンガアン商会の美学によれば、この差別も「表現」の一語に霧のやうに消えてしまふであらう。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の耳がガアンと鳴った。",
              "citation": {
                "source": "子をつれて",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の耳がガアンと鳴つた。",
              "citation": {
                "source": "子をつれて",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、諄いようだが、光陰矢の如く、時刻は刻々に移って大時計の鳴鐘はガアンと無慈悲の音をたてて、一時半を報じた。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "といふより、何か金槌のやうなもので脳天をガアンとやられたやうな気持でした。",
              "citation": {
                "source": "死児変相",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "「助けてくれ」　阿Ｑは口に出して言わないが、その時もう二つの眼が暗くなって、耳朶の中がガアンとして、全身が木端微塵に飛び散ったように覚えた。",
              "citation": {
                "source": "阿Ｑ正伝",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムクンガアンマリサワグノデ、マタタロー　　サンニシカラレマシタ、ガマタ　スグウレシクテタマラナイノデサワギダシマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「折角ソコマデ習ッタノニナゼ止メタンダネ」「ダッテ、トテモ足ガ変形シチャッテ醜クヽナルノヨ」「ソレデ止メタノカネ」「アタシ、足ガアンナニナルノハイヤダワ」「ドンナニナルノサ」「ドンナニナルッテ、ソリャヒドイノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たえず、冷々と面をかすめてくる陰森たる風、ものいえば、ガアンと間道中の悪魔がこぞって答えるようにひびく。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
