      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "両親があんなことになりさえせねば、奉公人とまでなるのではない。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お母さんがあんまり甘過ぎる。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "民子は死ぬのが本望だと云ったか、そういったか……家の母があんなに身を責めて泣かれるのも、その筈であった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "話があんまり抽象的になつてしまつたが、お前の妻の肉體に刃物を加へてどこか忍びない所がありはしないかい。",
              "citation": {
                "source": "實驗室",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな熱病的なことがあんまり沢山だものだから、文学志望者をだけ読者に持つやうな、浅間しいことにもなるのだ。",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私そんなこと、夢にも思わないんだけれど、たとえばね、もしか、私があんたを愛したくっても私が淫売ならその資格がないとでも、あんたはいいたいんだわね。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "消したつもりの薪を、……」　と言いかけて、自分があんまりみじめで、涙がわいて出て、それっきりうつむいて黙った。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一度、マア坊があんな露骨な言動を示したならば、僕は断然、組長の竹さんに訴えて、マア坊を道場から追放してもらおうと覚悟した。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがあんまり本を讀みすぎた結果、なんにも書けなくなつたのださうです。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "服装があんな工合だから、心までどぶ鼠のように、チョロチョロしている。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なにせ、お母さんがあんなにお悪いのですから。",
              "citation": {
                "source": "故郷",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、お母さんがあんなに悪いのに、温泉どころじゃありません。",
              "citation": {
                "source": "故郷",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その絵があんまりのんきで、その描き方があんまり気楽なので、思わず二人で笑ってしまった事があるが、同じ油絵をかくのでも、人によってこんなにもちがうものかと思った。",
              "citation": {
                "source": "中村彝氏の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "天プラや、すしなどがあんなに恐ろしい鬼気をもって人に迫り得るという事を始めてこの画から教えられる。",
              "citation": {
                "source": "二科会その他",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "出かけるとなって庭へおりると、髪があんまりひどいからちょっとなでつけるまで待ってちょうだいと言う。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、その革命の背後には幾千、幾萬の犧牲者があんな風にして苦しんでゐる。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とに角狐につままれたと云ふにしても、話があんまりうま過ぎるぢやないか。",
              "citation": {
                "source": "Ｓ中尉の話",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "八　皆まで聞かず、め組は力んで、「誰が、誰があんな許へ、私ア今も、だからそう云ってたんで、頼まれたッて行きゃしねえ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その優しさが身に浸みたか、お蔦の手をしっかり握った、小芳の指も震えつつ、「お蔦さん、可いから寝ておいでな、お嬢さんがあんなに云って下さるからさ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "なに美い水があんべい。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の女房だって、僕があんまりお酒を飲みすぎると、里へ行って一晩泊って来る事がありますよ。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤野先生の講義にも、その日はじめて出席してみたが、周さんがあんなに情熱をこめて褒めていたほど、それほど、たのしい授業ではなかった。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、私の経験に依れば、女があんな事を言う時には、たいてい男がふられているのだと解して間違い無いようである。",
              "citation": {
                "source": "チャンス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お葬式があんまり華麗すぎたので、それで、興奮して泣いちゃったのかも知れません。",
              "citation": {
                "source": "誰も知らぬ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当に、前から私があんなに言っているのに、主人は国民服も何も、こしらえていないのだ。",
              "citation": {
                "source": "十二月八日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんの通りがかりの者ですけれども、お内があんまり面白そうなので、つい立ち寄らせていただきました、それでは、お邪魔させていただきます、などと言い、一面識もないあかの他人が、のこのこ部屋へはいり込んで来ることさえあった。",
              "citation": {
                "source": "花燭",
                "author": "燭をともして昼を継がむ。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、自分は、女があんなに急に泣き出したりした場合、何か甘いものを手渡してやると、それを食べて機嫌を直すという事だけは、幼い時から、自分の経験に依って知っていました。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがあんまり本を読みすぎた結果、なんにも書けなくなったのだそうです。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘さんは、すると、落ちついて私の傍に坐つて、あたしも何かお話しようと思ふのですが、お客さんがあんまり默つてゐるので、つい、あたしも考へてしまつて、何も言へなくなります。",
              "citation": {
                "source": "九月十月十一月",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二度と再び『オリンピア』へ来られんように、がーんとひとつ行ったらんといかん！",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
