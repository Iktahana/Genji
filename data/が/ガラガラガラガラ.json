        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夜も昼もがらがらがらがら三つの糸車をまわして糸をとりました。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "空車の音だけが、がらがらがらがら呆けた音を立てている。",
              "citation": {
                "source": "道連",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "独りでに足が重くなって早く歩けなかった、がらがらがらがら、すぐ後に空車の音がやってくる。",
              "citation": {
                "source": "道連",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラガラガラガラと音を立てて、人夫がトロツコを送り臺の方へ走らせて來た。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラガラガラガラガラガラ、走り出す。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "パタパタ、トントン、すうっ、ガラガラガラガラである。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同時に、　……ガラガラガラガラ……ガチャンガチャン……パーン……パチーン……　という激しい物音が、引き続いて私の足の下に起った。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラガラガラガラと落ちる音！",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敦子の言葉にダブって、ケーブルで鉱石を運ぶ音が、ガラガラガラガラ、ガラガラガラガラ、ガラガラガラ。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラガラガラガラン、バリバリドタドタドタドタンピシーン。",
              "citation": {
                "source": "圓太郎馬車",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
