[
  {
    "uuid": "077718df-96dd-5bce-af47-386ed84a406b",
    "entry": "ガキ大将",
    "reading": {
      "primary": "がきだいしょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "leader of the pack (of a group of kids)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「おいお前ら、今日からここが俺たちの秘密基地だ！」とガキ大将が宣言した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昔の町内には、必ず一人は鼻水を垂らした元気なガキ大将がいて、子供たちを束ねていたものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はクラスのガキ大将だったが、弱い者いじめだけは絶対に許さない一本気な性格だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "泥だらけのシャツを誇らしげに見せるその姿は、まさに昭和のガキ大将そのものだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "腕力の強いガキ大将、お山の大将、乃木大将。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガキ大将にくっついて、ヤーッ、チャンチャン、バラバラ、とやるんじゃない。",
              "citation": {
                "source": "ソヴェトのピオニェールはなにして遊ぶか",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "役人と来ちやア、昔の代官と同じで、全く、子供のガキ大将と同じでさア……。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドストエフスキーとなると、不良少年でも、ガキ大将の腕ッ節があった。",
              "citation": {
                "source": "不良少年とキリスト",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年時代のガキ大将は珍しくないが、このオヤジは一生涯ガキ大将であった。",
              "citation": {
                "source": "安吾史譚",
                "author": "勝夢酔",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
