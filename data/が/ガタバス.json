          "literary": [
            {
              "text": "大泉へ、のり巻の包みをかかえておりると、もとはガタバスがあったのが、馬車になっているの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は先年上河内に行った時、せめてあの辺まででも登山電車を敷いたらどうかと思ったが、そうしたら実際あのこわれかけたようなガタバスで揺られて行くよりどのくらい愉快だか知れないのだ。",
              "citation": {
                "source": "吹雪のユンクフラウ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地の人たち四五人と一しよに小さなガタバスに乗り、酒屋の前でおりた。",
              "citation": {
                "source": "念仏の家",
                "author": "小寺菊子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
