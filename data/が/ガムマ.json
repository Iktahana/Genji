          "literary": [
            {
              "text": "ではアルファー」「アルファー」「ビーター」「ビーター」「ガムマー」「ガムマーアー」「デルター」「デールータァーアアア」　実に不思議です。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次のガムマも亦同様の仕事を繰返して死ぬ……という順序で、人類世界に存在する彫刻作品の数は殖えるばかり。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "また同様に大熊星座のベータ、ガムマ、デルタ、エプシロン及びゼータの諸星は一群を成していていずれも同じ鳩座のガムマ星に向かって動いている。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "仁科博士は超ガムマ線吸収に関して、クライン‐仁科の式をつくった人だ。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
