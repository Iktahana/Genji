        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――チチシスアサ七ジウエノツク――私はガアーンと頭を殴られた気がして、呆然としてしまった。",
              "citation": {
                "source": "父の出郷",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "なおも言うと、それと反対に九谷となると、初めからガアーンと芸術的に吾人の眼に迫って来る。",
              "citation": {
                "source": "古九谷観",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤ、いねえぞ」　先へ向った孫兵衛の声が、暗闇の突き当たりから、ガアーンと響いて返ってきた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "剣山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥のほうからガアーンと返ってくるのは、おのれの口｜真似をする穴山彦。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "剣山の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
