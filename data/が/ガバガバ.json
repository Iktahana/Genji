    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　今度は、がばがばと手酌で注ぐ。",
              "citation": {
                "source": "古狢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるだけ水の上の高い処を、と拾って畦を伝えば、雨続きで、がばがば崩れる、路を踏めば泥濘で辷る、乾いた処ちっともなし。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "心に呟きつつ、またまた彼は、殆ど無意識にのび上って、塵臭い、がばがばした革天幕に皺深い顔をすりよせる。",
              "citation": {
                "source": "古き小画",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかと土と汗と雨とで、がばがばになった服、それにシラミがうごめき、ノミが跳び、やぶれからむき出した皮膚にはぼりぼり引っかいた爪あとに血がにじみ、いちめんのカイセンがさ。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "がばがばの除草器は泥水の底を潜つて音を立てた。",
              "citation": {
                "source": "無題※",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "思の外、容易に近づくか知らと、喜ぶ時、船前五間許の処にて、がばがばと水を撥ねたるは、十貫目錨を投じたる程の水音にて、船は為めに揺られて上下せり。",
              "citation": {
                "source": "大利根の大物釣",
                "author": "石井研堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "門柱につづいた古い板塀はところどころ破れて、犬でも出入りしたらしい大きな孔があって、孔のまわりの羽目板はがばがばにゆるんでいる。",
              "citation": {
                "source": "恐怖の幻兵団員",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "脛までひたして、がばがばと歩き廻り、また波打際にとって返す。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "台所に行くと野呂はもう起きていて、がばがばと顔を洗っておりました。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
