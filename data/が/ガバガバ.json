[
  {
    "uuid": "eb75250b-49c0-5503-be34-c9e50b3db7f3",
    "entry": "ガバガバ",
    "reading": {
      "primary": "ガバガバ",
      "alternatives": [
        "がばがば"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-の形容詞",
        "形容動詞"
      ],
