[
  {
    "uuid": "09367c7b-8ad3-54ef-b6e5-4d6e7e828fd8",
    "entry": "ガツン",
    "reading": {
      "primary": "ガツン",
      "alternatives": [
        "がつん"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
