[
  {
    "uuid": "89e4c020-bbc6-553a-b986-61e78ee24582",
    "entry": "伽藍堂",
    "reading": {
      "primary": "がらんどう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
