          "literary": [
            {
              "text": "流した石膏に青や赤の色を着けておいて、外型を毀してゆく時に赤が出て来たからもう直ぐ肌だとか、青が出たから肌であるなどと、そんなことをやったりしたこともあった。",
              "citation": {
                "source": "美術学校時代",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒人たちの狂気を、その外型だけ巧みに模倣している。",
              "citation": {
                "source": "愛のごとく",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
