[
  {
    "uuid": "487801b9-b5a7-5ee5-bac1-0290487490aa",
    "entry": "莢迷",
    "reading": {
      "primary": "ガマズミ",
      "alternatives": [
        "がまずみ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
