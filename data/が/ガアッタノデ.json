          "literary": [
            {
              "text": "コレハアタシノ想像ダケレドモ、颯チャンガ立ッテ行ッタノハ外ニ何カ、早ク東京ニ帰リタイ理由ガアッタノデハナカロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "国カラ子ト、昨日妻ガ錦ノ市場デ買ッテ来タ鮒鮨ガアッタノデ、スグブランデーニナッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長崎人ノ木村モハナイノダガ、今日ハ始メカラ晩ノ食事ヲトモニスル底意ガアッタノデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………佐々木ノ帰朝祝賀宴ガアッタノデ十時過ギニ帰宅シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
