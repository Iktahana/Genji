[
  {
    "uuid": "650d08d1-7312-591c-b8c6-da2cfb77b269",
    "entry": "願望",
    "reading": {
      "primary": "がんぼう",
      "alternatives": [
        "がんもう"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "desire",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女の最も深い願望は世界を旅することだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は平和的解決への願望を表明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この目標を達成することが、私の生涯の願望です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「ああ、あのコンサートに行けたらなあ！」彼女は明らかな願望を込めて叫んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「あなたと呼べば」の歌詞は、現代サラリイマンの無気力、無希望な人生願望を表象してゐる。",
              "citation": {
                "source": "流行歌曲について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間が鳥のやうに、空中を飛翔したいといふ夢の願望。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが善い悪いは別として、そうしなければ大願望が成就しないことだけはたしかである。",
              "citation": {
                "source": "徒然草の鑑賞",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての酒飮みたちが願ふところは、醉中にしたところの自己の行爲を、翌朝になつて記憶にとどめず、忘れてしまひたいといふ願望である。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこのもつともな願望は、それが實現した場合を考へる時、非常に不安で氣味わるく危險である。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "下らんことのために、こゝに居る者の願望が根こそぎ掘り取られてしまうのだ。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、さらに多くの讀者に自分の作品を讀んでもらひたいのは、著者たるものの、ひそかな願望にちがひない。",
              "citation": {
                "source": "『老ハイデルベルヒ』序",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の理想や彼の兩親の願望の忠臣である彼の意志なるものはあまりに弱かつたのである。",
              "citation": {
                "source": "奎吉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎は巨大な眼を願望した。",
              "citation": {
                "source": "太郎と街",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎は巨大な脚を願望した。",
              "citation": {
                "source": "太郎と街",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の満たされない願望は、ときに高い屋根の上へのぼり、空へ手を伸ばしている男を想像した。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誇張でなしに、相手を殺したいと願望したからである。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "抑圧された願望がめざめたのである。",
              "citation": {
                "source": "読書の今昔",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、夢が阻止された願望の実現となるように、映画の観客は映画を見ることにより、実際には到底なれない百万長者になり、できない恋をしたり、不可能事をしとげるというようなことも言っている。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "現実の世界において望んで得べからざる願望が夢の国において実現されるように、人工映画の世界においてはあらゆる空想が安々と実現される。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おおこれだ」と云はない許りに、期待も焦心も願望もそれ一通に籠つてゐるかのやうに、狂気じみた身悶えして、怪物はただ凝視した。",
              "citation": {
                "source": "公判",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体世の中の事は、斯うなつて欲しいと思ふ願望が容易に実現しないものであると共に、斯うなつたら困ると思ふ杞憂も案外に到来せずに済むものである。",
              "citation": {
                "source": "公判",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ以後「風船」は私の最も大きな願望の一つとなった。",
              "citation": {
                "source": "風船美人",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そうして彼女を無事に逃がして遣りたいというような願望を、夢うつつのように抱きながら一所懸命の思いで腹ばいに起き直った。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は、これまでの生涯に於いて、人に殺されたいと願望した事は幾度となくありましたが、人を殺したいと思った事は、いちどもありませんでした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "卑しい願望が、ちらと胸に浮ぶことは、誰にだってあります。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その場合に、醜いものだけを正体として信じ、美しい願望も人間には在るという事を忘れているのは、間違いであります。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「醜いものだけを正体として信じ、美しい願望も人間には在るということを忘れているのは、間違いであります。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "高原の草に坐つてあなたはなにを眺めてゐるのかあなたの思ひは風にながれはるかの市街は空にうかべるああ　ぼくのみひとり焦燥してこの青青とした草原の上かなしい願望に身をもだえる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の物語の作者たちは、さうした悲しい數數の旅行の後で、それでも、漸く最後に取つて置きの籤をひかせて、首尾よく願望を成就させた。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜならそれは、世の親たちの子供に對する、すべてのエゴイズムの願望の、最も露骨にして勇敢な表現であるからである。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なもみはげたか・なまはげ・がんぼう・もうこなど言ふ名で、通有點は簑を著て、恐しい面を被つて、名稱に負うた通りの唱へ言、或は、唸り聲を發して家々に踊りこんで、農村生活に於ける不徳を懲す形をして行くのである。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
