        "examples": {
          "standard": [
            {
              "text": "親はようやく子どもの留学計画に肯んずることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "上司は部下の提案を肯んずるかどうか検討している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女はやっと僕の結婚提案に肯んずってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "人はたゞ單に黒鴉白鷺の如く、生れてそして死ぬことを肯んずるもので無い。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは私がいわないでも多くの読者は知ってそして肯んずる事実であろうと思う。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "速やかに帰れ」といわば、彼は「君の意に従って帰る代わりに、君もまたわが意に従うことを肯んずるか」と反問せん。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
