        "examples": {
          "standard": [
            {
              "text": "親はようやく子どもの留学計画に肯んずることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "上司は部下の提案を肯んずるかどうか検討している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女はやっと僕の結婚提案に肯んずってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "人はたゞ單に黒鴉白鷺の如く、生れてそして死ぬことを肯んずるもので無い。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは私がいわないでも多くの読者は知ってそして肯んずる事実であろうと思う。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "速やかに帰れ」といわば、彼は「君の意に従って帰る代わりに、君もまたわが意に従うことを肯んずるか」と反問せん。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は僕の市蔵に対する今日までの態度に顧みて、この非難をもっともだと肯ずる。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが爲め幕府の末年には朝鮮で日本へ使に行くを肯ずる者がなくなりました。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "所有主は土地から引離し得ざる彼れの資本部分を抛棄することを肯ずるが、けだし彼は、この資本部分を抛棄しない場合よりも、引去り得る部分をもって、より多くの価値とより多量の粗生生産物とを取得し得るからである。",
              "citation": {
                "source": "経済学及び課税の諸原理",
                "author": "PRINCIPLES OF POLITICAL ECONOMY AND TAXATION",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
