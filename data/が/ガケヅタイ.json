        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二つばかり転がったが、ゴロゴロと河岸の石崖伝い河の中へ落ちて行った。",
              "citation": {
                "source": "三甚内",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――が、咄嗟に御方の眼を怖れてあたりを見廻したが、折よく、その姿がなかったので、崖伝いにザワザワと二人の後を慕いだした。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "バラバラ、バラバラと、揺するたびに落ちてくる枯葉を浴びて、崖伝いに下りてゆくと、そこは、太田媛神社の境内であった。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "強右衛門は、城の片隅にある一叢の木立へかくれ、やがて不浄門へ崖づたいに降りて行った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊織は救われたように、崖づたいに駈けて行った。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
