          "literary": [
            {
              "text": "薬罐一杯、イガズル――。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イガズルって、なんぼだい？",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そら、支那の一銭銅貨のようなやつ一ツさ、あれがイガズルだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "首絞めや、板歩かせ（註八）や、海上の暴風雨や、ドゥライ・トーテューガズ（註九）や、スペイン海（註一〇）での乱暴な所業やそこの土地土地などの話だった。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "九　ドゥライ・トーテューガズ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ノ楽シミヨリ、君ノ楽シミノ方ガズット大キイ筈ジャナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大シテ痛クハナカッタガ、後頭部ヲ打ッタノガズシント脳ニ響イタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーガズムがちかづくにしたがって、無我夢中でいろんなことをぼくに命令する。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍幕未ダ弁ゼズ、将｜倦ムヲ曰ハズ、軍｜竈未ダ炊ガズ、将飢ヱヲ曰ハズ、冬、裘ヲ暖ニセズ、夏、扇ヲ採ラズ、雨ニ蓋ヲ張ラズ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
