    "definitions": [
      {
        "index": 1,
        "gloss": "Gaza (Palestine)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
