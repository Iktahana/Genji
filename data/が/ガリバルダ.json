        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "第二提琴奏者ガリバルダ・セレナは伊太利ブリンデッシ市鋳金家ガリカリニの六女。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガリバルダは逆さになりて殺さるべし。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、次のガリバルダ・セレナ夫人は、すべてが前者と対蹠的な観をなしていた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オリガ・クリヴォフ（同前）　ガリバルダ・セレナ（同前）　オットカール・レヴェズ（同前）　田郷真斎。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "扉際に立っていたのは彼女一人だけではなく、続いてガリバルダ・セレナ夫人、オットカール・レヴェズ氏が現われたからだった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガリバルダは逆さになって殺さるべし――それは伸子の失神姿体に現われている。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
