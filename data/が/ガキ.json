[
  {
    "uuid": "87c7f6b8-ee97-5818-b1a2-e21a959df6b8",
    "entry": "餓鬼",
    "reading": {
      "primary": "がき",
      "alternatives": [
        "ガキ"
      ],
      "is_heteronym": false
    },
    "grammar": {
