        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノ　トキ　ムカウノ　ムギバタケカラ　コトシニ　ナツテカラ　ハジメテノ　ヒバリガ　ソラニ　マヒアガリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "クルマハ　デキアガリマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スズメト　ポストト　ガイトウハ、ケイキキユウト　マルイ　カゲヲ　ミクラベテ　ウラヤマシガリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サヘヅル　ヒバリモ　　　ゲンキヨクピイチク　ピイチク　　　アガリマス。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ニカイ　アガリマショウ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ニカイ　アガリマショウ、ワタシ　アヤシクナイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニカイ　アガリマショウの男は、盛んに私にウインクしていた。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年ノウチニワタシハ、コタンヘカヘリマスガ、マタ、コンド、アガリマスカラ、ドウカ、ヨロシクネガヒマス。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、いよいよ、その原稿がガリマアル君の手に渡された時は、全体の分量の三分の一しかなかつた。",
              "citation": {
                "source": "続言葉言葉言葉（その二）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ出版屋のガリマアル君が、そつと紙屑籠から拾ひだしたといふ「日記の破片」を、多くのルナアル党は早く増補として世に出せと注文した。",
              "citation": {
                "source": "続言葉言葉言葉（その二）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネコ　ノ　オバアサン村山籌子　タイヘントシトツタオバアサンネコガ、オヒルコロニナツテメヲサマシテ、ベツドノウヘヘオキアガリマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルヒ　タラウサンノ　ウチデハ、ナニカ　オホソウドウガ、モチアガリマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを「ガリマ」と言っていた。",
              "citation": {
                "source": "幼年時代",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガリマをしようじゃないか。",
              "citation": {
                "source": "幼年時代",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガリマ隊の来ないうちに。",
              "citation": {
                "source": "幼年時代",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "私もよくその「ガリマ」隊に加わったものであった。",
              "citation": {
                "source": "幼年時代",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガリマ」隊の進んで行ったあとの道路は、ちぎられた青葉若葉が乾いた路の上に、烈しい子供の悪戯のあとをのこして散らばっていた。",
              "citation": {
                "source": "幼年時代",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "私だちは空地の草場に輪をつくって、「ガリマ」に拠って得た果実をみなに頒けっこをするのであった。",
              "citation": {
                "source": "幼年時代",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガリマ」隊が陣取っていると、そこらに遊んでいた女の子供らも、みな言い合わしたように集ってくるのであった。",
              "citation": {
                "source": "幼年時代",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の子らはややはにかみながらも、「ガリマ隊」のなかに兄さんなどもいるので、みな親しく分けてもらって、隊をはなれて遊ぶのであった。",
              "citation": {
                "source": "幼年時代",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、Ａの町の「ガリマ」隊と、Ｂの町の「ガリマ」隊とが、よく静かな裏町で出会すことがあった。",
              "citation": {
                "source": "幼年時代",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九五一年ガリマール初版である。",
              "citation": {
                "source": "探偵小説の「謎」",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
