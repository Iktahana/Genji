        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "）友は語をつぎて、車主はこたびもモラ、ヂ、ガエタ（即ち昔のフオルミエ）の別墅に車を停むるならん、今は酒店となりて、眺望好きがために人に知らるといひぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "白帆懸けたる大舟小舟は、徐かに高き家の軒を並べたるガエタの灣に進み入る。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガエタはカエタより出でたる名なりといふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガエタアノ、お婆さんが病気で薪を採りに行かれないから、今夜わたしと一所に森へ行つて、薪を一二｜荷お婆さんへ持つて行つてやる手伝ひをして頂戴な。",
              "citation": {
                "source": "翻訳小品",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「をう、ガエタアノ、」少女が叫んだ。",
              "citation": {
                "source": "翻訳小品",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエノホウデ、サッキノコトヲ、一ツデモタガエタラ、シゲルヲ、コロシテシマウゾ」　そして、カチャンと、電話が切れてしまった。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
