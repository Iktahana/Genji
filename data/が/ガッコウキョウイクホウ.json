        "examples": {
          "standard": [
            {
              "text": "文部科学省のホームページで、学校教育法の最新の改正内容がどのように現場に影響するかを確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「大学も学校教育法第一条に規定されている『学校』に含まれるから、教育基本法の理念に基づいているんだよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "教員採用試験の対策として、学校教育法の第一条を暗記し、その目的を深く理解することに努めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "フリースクールの法的地位を巡り、学校教育法との整合性をどう確保するかが教育委員会で議論されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "この間に教育に関する二大法案「教育基本法」および「学校教育法」が議会を通過した。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
