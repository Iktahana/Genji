  {
    "uuid": "cb0cf5fd-044e-570e-937c-e5ab10794561",
    "entry": "ガレ",
    "reading": {
      "primary": "がれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "黒き浜辺にマルガレエテが歩み寄するヴェールを風に千々にされながら。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "三寸四方くらいの小さい包で、中には、シガレットケースが入っていた。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、シガレットケースをもらった事さえ忘れている。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの人たちから僕は、シガレットケースと、それから竹細工の藤娘をもらって、少し閉口だったけれども、でも、そのうちに何かお返しをしなければならぬのではあるまいかと、内心、ちょっと気になっていたところへ、君が気をきかせてお土産を持って来てくれたので、ほっとしました。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽い口調でそう言って、シガレットケースから煙草を取り出し、一本口にくわえて、「マッチないか？",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナガレ」はもちろん「流れ」であるが、ある人の話では「ナガ」は「長」で「ルル」が「流」であろうとの事である。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルコの「ネフル nehr」（川）はｈを例のｇにすると、「ナガレ」に近よる。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が階下に花田君子の靴音を聞いたころ、友人の横田は紐育の女優メイ・マアガレッタの男妾として外科的な名誉と人気をかち得ていた。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "横田はヤンキーの女によって陶酔されメイ・マアガレッタの虚栄心を満足さしたが、河村はひたすら必要品に過ぎなかった。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、寢臺の側の臺の上や、窓敷居にパンジイや、フリイジヤや、釣鐘草や、撫子や、マガレツトの花などの順順に變つて行くのを、やつと首だけ動かしながら見て樂しんだ。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とある廊下の一角＝＝白磁の大水盤に紅白カーネーシヨンの群花入り乱れたる「戦ひの図」　食堂＝＝ミユンヘン国立ビール飲用場の陶製ジヨツキーに石楠花、すかし百合、耳付一輪挿にマーガレツト、スヰートピー。",
              "citation": {
                "source": "花は勁し",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イエツ教授の娘のマーガレットはこういう実験のプランを可愛ゆいとき色の小脳の襞から揉み出して支度にかかった。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "眩しいような白と萌黄の午前服で男を圧迫しながらマーガレットは爪磨きをして二日目の彫刻的な指先で甘える。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一枚、同じくマルマレードをつけて、もう一枚、もう一枚、もう一枚――マーガレットは男に取って貰って六枚まで喰べた。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三木本の帰ったあと遅く出た風の送る水仙草の匂いを嗅ぎながら広いサンルームでマーガレットは安楽椅子にくたりとした。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は座席に即くと悠々小田島のシガレットケースから煙草を抽き出してふかし始めた。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "半分は捨鉢な気持で新聞広告で見た霞町のガレーヂへ行き、円タク助手に雇われた。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガレーヂの二階で低い天井を睨んで寝ていたが、肺と知って雇主も困り、「家があるんやったら知らせたらどないや」　待っていましたとばかり、母親に手紙を書いた。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガレーヂの二階で寝ていたころとはすっかり養生の状態が変った。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅で買った新聞の広告を見て、霞町ガレージの円タク助手に雇われた。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガレッジの二階で臥床していたが、肺と知って雇主も困り、家に知らせたら如何や。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガレッジの二階で寝ていた頃とはすっかり養生の状態が変った。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞紙で包んだものを取り出すのを見ると、この家庭芸術家三人の作品のたぶん代表的なものであろう、分厚で長方形のシガレットケース――これは科学者の作、それから半月形の灰皿――これは美しい令夫人の作、それから手どくで白釉に碧緑の色を流した花瓶――これは母堂の作である。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガレージにクラブのメンバーが集まって激論をたたかわせているのだが、その内容がすこぶる高い。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホームブルー・コンピューター・クラブの第一回会合は、一九七五（昭和五十）年三月、設立を呼びかけたメンバーの家のガレージで開かれた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九七五年三月五日、サンフランシスコ郊外のメンローパークにある発起人の家のガレージで開かれた初めての会合に顔を出すと、驚いたことにアルテアが動いていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのアルテアが、ガレージの机の上でフロントパネルのランプを点滅させていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルナンデスは作業場となった自宅のガレージに同級生のスティーブン・ジョブズを呼んで、仕上がったマシンを披露した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "パロアルトの貸しガレージを根城とし、五〇〇ドルの資金を元手に測定用の音声周波数発信器の開発から出発したＨＰに飛躍のきっかけを与えたのは、ディズニー映画だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "この作業用に、ガレージからスタートしたばかりのベンチャーの製品ながら、すぐれた性能を備えたＨＰの音声周波数発信器が採用された。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
