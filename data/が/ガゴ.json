        "examples": {
          "standard": [
            {
              "text": "「いとをかし」は、平安時代の文学を代表する雅語の一つだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "古文の授業で、和歌に頻出する枕詞や掛詞といった雅語の技法について学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "その詩人は雅語を巧みに使いこなしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
