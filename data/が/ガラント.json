        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ブラントームの『レー・ダム・ガラント』第二に、ある紳士が美人睡中露身を見て一生忘れず、居常讃嘆してわれ毎にこれを観想するのほかに望みなしといったとあるは、仏印の所想とすこぶる違う。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラントームの『レー・ダム・ガラント』一には、トルーフル女人にもよく廻るとある。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラントームの『レダムガラント』にスペイン女の三十相を挙げて、膚と歯と手は白きを要し、目と眉と睫毛は黒きを要し、唇と頬と爪は紅きを要し、胴と髪と手は長きを要しとは、手の長い者は盗みすると日本でいうと違う。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "縞水仙の黄金色の花、迎春花の紫の花、椿、寒紅梅、ガラントウス、ところどころに灌木がある。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
