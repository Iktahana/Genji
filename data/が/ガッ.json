    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "糟谷は土曜と知って目がさめたようにたちあがった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "土曜日日曜日をうかがって、遊びにくるものがあってもたいていは避けて会わないようにした。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この野郎ふざけた野郎だ……」　猛然立ちあがった糟谷はわが子を足もとへ引き倒し、ところきらわずげんこつを打ちおろした。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "礼子は外から飛び込みさまに母に泣きすがった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっしょけんめいに泣きすがって離れない。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "深川の乳屋も知ってる人と見え、やあとあいさつして遠慮もなくあがってきた。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "芳輔は、十時ごろに台所からあがってこっそり自分のへやへはいった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず第一に長女の髪をゆう、何がよかろうという事、髪はできぬという、祖母に相談する、何とかいう事に極って出来あがった、それから次なはお下げにゆう、仲なは何、末なは何にて各注文がある、これもまた一騒ぎである、予は奥に新聞を視ている、仲なと末なが、かわるがわる、ひききりなしにやってくる。",
              "citation": {
                "source": "浅草詣",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "又貴様小刀を持出して無くしてしまいやがったなどうした何をした。",
              "citation": {
                "source": "井戸",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれか子をうみやがったなと思うていると。",
              "citation": {
                "source": "牛舎の日記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "女達はしきりに気もちわるがってよせよせと云う。",
              "citation": {
                "source": "牛舎の日記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですからあれは母牛の乳をまだ飲たがって鳴のでしょうと男等は云った。",
              "citation": {
                "source": "牛舎の日記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ児供がなく自分を大へんに可愛がってくれたのだ。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は姉の可愛がってくれるのも嬉しかったけれど、守りのお松もなつかしかった。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝飯をたべて自分が近所へ遊びに出ようとすると、お松はあわてて後から付いてきて、下駄を出してくれ、足袋の紐を結び直してくれ、緩んだへこ帯を締直してくれ、そうして自分がめんどうがって出ようとするのを、猶抑えて居って鼻をかんでくれた。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月の何日頃であったか、表の呉縁に朝日が暖くさしてる所で、自分が一人遊んで居ると、姉が雑巾がけに来て「坊やはねえやが居なくても姉さんが可愛がってあげるからね」と云ったら「ねえやなんか居なくたってえいや」と云ってたけれど、目には涙を溜めてたそうである。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "四歳のお児はがっこといい、三歳の奈々子はあっこという。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "出口がせまいので少しからだを横にようやく通る窮屈さをいっそう興がって、ふたりは笑い叫ぶ。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "上がってからおよそ十五、六分も過ぎたと思う時分に、あわただしき迎えのものは、長女とお手伝いであった。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうする詮も知らずに着物をあたためてはあてがい、あたためてはあてがってるのみ、家じゅう皆立って手にすることがなくうろうろしてる。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "聴診器を三、四か所胸にあてがってみた後、瞳を見、眼瞼を見、それから形ばかりに人工呼吸を試み注射をした。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから少し過ぎてお児がひとり上がってきて、母ちゃん乳いというのに、また奈々子はと姉らに問えば、そこらに遊んでいるでしょう、秋ちゃんが遊びにつれていったんでしょうなどいうをとがめて、それではならない、たしかに見とどけなくてはなりませんと、妻は今は起き出でて、そこかここかとたずねさした。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうして素足でここへ来たか、平生用心深い子で、縁側から一度も落ちたことも無かったのだから、池の水が少し下がって低かったら、落ち込むようなことも無かったろうにと悔やまれる。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人が上がってきて、また一しきり、親子姉妹がいってかいないはかな言を繰り返した。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "民やは年上の癖に……」　などと頻りに小言を云うけれど、その実母も民子をば非常に可愛がって居るのだから、一向に小言がきかない。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう次第だから、作おんなのお増などは、無上と民子を小面憎がって、何かというと、「民子さんは政夫さんとこへ許り行きたがる、隙さえあれば政夫さんにこびりついている」　などと頻りに云いはやしたらしく、隣のお仙や向うのお浜等までかれこれ噂をする。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には僕が余り俄に改まったのを可笑しがって笑えば、民子も遂には袖で笑いを隠して逃げてしまうという風で、とにかく一重の垣が二人の間に結ばれた様な気合になった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう嬉しがってと云われるのが口惜しいのである。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしてこんなかと、自分でも思う位」「民さんはそんなに野菊が好き……道理でどうやら民さんは野菊のような人だ」　民子は分けてやった半分の野菊を顔に押しあてて嬉しがった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやな野郎がきやがったなと思うていると、「や政夫さん。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
