  {
    "uuid": "6570724a-98d0-5cfa-a7a2-2b7c7ce24fdb",
    "entry": "ガコ",
    "reading": {
      "primary": "がこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "貴官ガコノ事件ヲ、本気デ調査サレタ事ガワカリマシタラ私ガ貴官ノ御宅ニ出頭シテ、真相ヲオ話シシマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ガココニ書イテオキタイコトハ、日本ノ活字カラヒラガナヲナクシタホウガヨイトイウ私見デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮮明度、速力ナドニ関シテハモチロン、資材ノウエカラ労力ノウエカラ大変ナ経済ダト思ウガコノ種ノコトハ私ニハヨクワカラナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミズガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリッタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボロウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行っただろうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミヅガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリツタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボラウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行つただらうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガコマルナラ、コンヤ十一ジニ、クロカワダンチョウト、ハナガタフサエト、マルノウチ、ネオン・ビルノマエニキナサイ。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるにその石一夜のうちにそこから逃げていまの和歌郡丹内村のヤツアナのガコという所まで来て止まった。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸ニシテ子重ガコノ挙アリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "○あぢき無く何の枉言いま更に小童言する老人にして　〔巻十一・二五八二〕　作者不詳　枉言はマガコトと訓んでいたが、略解で狂言としてタハコトと訓んだ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシタ方ガコノ老人ノ気ニ入ルコトヲ看テ取ッタカラデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ハ家督相続人デアルケレドモ、目下ノトコロ予ガコノ家ノ主人デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今オ気持ガオ悪イヨウナコトハゴザイマセンカ」「気持ハドウモアリマセンガネ、血壓ガ高インデスカ」「二百ホドゴザイマス」彼女ガコンナ風ニ云ウ時ハ大概二百以上ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ新築ノ隠居所ノ空想ガコノ柔カイ掌ノ上ノ一点ト化シ去ッタコトヲ知ラサレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガコノ二人ノ美人ノ間、明治二十七年ト昭和三十五年トノ間ニ、日本人ノ体格ニ何ト云ウ隔タリガ生ジタコトカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母ノ亡クナッタ昭和三年カラ数エテ三十三年後ニ、忰ガコノヨウナ狂人ニナリ、コノヨウナ嫁ガ我ガ家ニ入リ込ムニ至ッタコトヲ、夢ニモ考エタヾロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「来テハイケナイッテ仰ッシャッタケレド、浄吉ガ行ケッテ云ウカラ来タワ」「浄吉ハドウシタンダ」「今又何処カヘ出テッタワ、チョット飲ンデ来ルッテ」「浄吉ガコヽヘ君ヲ連レテ来テ、僕ノ眼ノ前デ君ニ命令スルトコロヲ見タイト思ッタンダガナ」「命令ナンカ出来ヤシナイワ、工合ガ悪イカラ逃ゲチャッタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ハ一向恐クナイ、ダガ、予ハ今コノ瞬間ニ死ニ直面シテイルノダト思ウト、―――死ガコノ刹那ニ予ノ眼前ニ迫ッテイルノダト思ウト、―――ソウ思ウソノコトガ恐イ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モヒデハナイガコレモ一種ノ麻薬デアルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ颯子ガコノ老人ノタメニ心ヅクシヲ示シタノデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガコノ家ヲ訪ウノハコレデ二回目デアルト云ウガ、最初ニ訪ウタノハイツノコトデアッタカ殆ド記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "城山家ハモト吉田山ニ住ンデオリ、当時ハシバ／＼来往シタ覚エガアルガ、主人桑造ノ死後遺族ガコヽニ移ッテカラハメッタニ訪ネナイヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体誰ガコノムズカシイ仕事ヲ引キ受ケテクレルカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「食堂ヘ行カナイデモイヽジャナイカ、コヽニ鮨ガコンナニ残ッテル、コヽデコレヲ食ベナサイ」「ソウ、デハソウスルワ」「君ト鱧ヲ食ベルノハ浜作以来ダナ」「ソウダッタワネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今後ハ僕ハ、彼女ガコレヲ実際ニ盗ミ読ミシテイルト否トニカカワラズ、シテイルモノト考エテ、間接ニ彼女ニ話シカケル気持デコノ日記ヲツケル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ガコノ日記帳ヲ盗ミ読ミシテイルヲ書イタラ今後酔ウヲ証拠立テルヨウナモノデアルカラ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ガコレラヲ撮ッタ目的ハ何ニアルカトイウト、第一ハ撮ルニ愉悦ヲ覚エタカラダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢ガコンナニ生々シイ色ヲ帯ビテ見エルノハ神経衰弱ガヨホドヒドイ証拠ダナト、夢ノ中デハッキリトソウ思イナガラ、僕ハジーットソノ夢ヲ視ツメテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガコンナニ種々ナ技巧ヲ心得テイルトハ意外デアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシモクロガコイシクテナリマセン。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガコレラハスベテ架空ノ出来事ナノダ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
