          "literary": [
            {
              "text": "ガウズネル、米川、秋田、鳴海さん達を迎えに来た。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "勉強していると、ガウズネル、秋田さん鳴海氏と来。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月十一日（日曜）　ガウズネルと、六時頃ベラ・イムベルの家へ行く。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのう、ガウズネルにきいたフィリッポフの店で食事す。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、ガウズネルが来た。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月二十三日（水曜）　メリー、ヴェラ、ガウズネル来。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はガウズネルのところへゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月二十六日（金曜）　○朝、荒野の詩人を演じたメイエルホリドのガーリン、ガウズネルと来る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月十五日　土　ガウズネルさんとキム夫妻がお茶に来る。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月十日　火　仕事して居ると、ガウズネルが寺島さんをつれて来た。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
