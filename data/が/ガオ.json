[
  {
    "uuid": "cad2fcea-9506-56dd-890e-6d0aaba1d5ec",
    "entry": "顔",
    "reading": {
      "primary": "がお",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
