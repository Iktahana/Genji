        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スリッパから飛び出した足の様に、私の気持はスガスガした。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "椿や山茶花が垣根に咲く、人の精神がスガスガしくなる。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　川田功氏の「或る朝」は、恰度一杯の清涼剤を、飲み干したようなスガスガしいもの、いい気持で読みました。",
              "citation": {
                "source": "御存与太話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで博士はこの反省の煉獄を抜け出すために、反省の煩わしさを断ち切ったスガスガしい直観界をあこがれる、絶対者は博士の願望の対象なのである。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "義理人情がないということは、実にアッパレ、スガスガしいものだ。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、現実を素直に受けいれるだけの、妙にスガスガしい落付きがあった。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争以来、見失っていたスガスガしい気持だ。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "スガスガしい愛情だ。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉慾にこだわりがなく、それを没したようなスガスガしさがあった。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "これをくり返すこと五日または七日で全身皮膚なめらかにクレオパトラの如くに冴え、顔のシワを去り、霊水をたたえた如くにスガスガしく顔に精気がこもるという。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十四　ロッテナム美人術",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が小笠原の徴用生活を書いたものは、この戦争生活の日本人の手記としては頭抜けてマトモで、一行の力んだところもないスガスガしい珍品であったと云えよう。",
              "citation": {
                "source": "親が捨てられる世相",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは悲劇的ではなくて、牧歌的――いわば、彼だけは切支丹史上に異例な、切支丹西部劇というようなスガスガしくて無邪気で明るい牧歌的なものを私は考える。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてと……（絵に没入して行く、ガスガスガスと木炭の音。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（唸っていたが不意に絵具箱から大きなパレット・ナイフを取り上げて、生がわきの画面をガスガスとけずり取ってしまう）タン　あ！",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "穴の奥から花岡のうなり声と、岩をなにかで引っかいているガスガスガスというひびき。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スガスガしいほど言葉がなく、クモリも、チリもとめないのです。",
              "citation": {
                "source": "飛騨の顔",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネオンサインダツテアンナニジーツトシテイル様ニ見ヘテモ実ハ不断ニネオンガスガ流レテイルンダヨ。",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ女房ノ日記トイエドモ、無断デ読ムヨウナナク剥ガスナシニ剥ガスガ分ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全市スガスガしい朝を見るだけでもお互いの心が和むと思うが、休日の街ときたらまるで紙クズだらけが寒々している廃虚の観だ。",
              "citation": {
                "source": "文化の日",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
