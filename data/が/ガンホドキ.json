    "definitions": [
      {
        "index": 1,
        "gloss": "visiting a shrine or temple to give thanks for the fulfilment of a prayer",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "願い事が叶ったので願解きに神社へ向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "毎年、願いが成就したら願解きをするのが家の習慣だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "合格したので、その願解きで有名な寺院に参拝した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "今日はの、それ……わしの死んだ家内の血盆経の願解きでな」「へえ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "看経二タ刻、巧雲は、御本尊の地蔵｜菩薩までが、いつかしら裴如海の色白な顔に見えてきて、るると乱れる香煙の糸も妖しく、心は故人の願解きどころか、わが生身の願結びで、うつつはなかった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "よつて錦繍の幡を造り、更に詣でて願ほどきをなす。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一行が逢坂の関を越えようとする日は、偶然にも源氏が石山寺へ願ほどきに参詣する日であった。",
              "citation": {
                "source": "源氏物語",
                "author": "関屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩は其のお願ほどきをする、準備をしてくれ」　武太夫もお願のかけっぱなしはいけないと思った。",
              "citation": {
                "source": "海神に祈る",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮沿海からドンの音が一掃されたので、最早大願成就……金比羅様に願ほどきをしてもよかろう……と思ったのが豈計らんやの油断大敵だった。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お父様は、そんな歌が流行り出してからというもの、毎日のお墓参りや、方々の神様や仏様への安産の御願ほどきや、お礼参りのほかは、お母様を一歩も外へお出しにならなかったそうです。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "流石に博多は諸芸の都だけあると皆、感心をしておりましたので……そこへちょうど私が櫛田様へ御願を立てて運動に取りかかりました株式の取引所が、このごろ鰯町の私の地所に来る事になりましたので、その御願ほどきのために奥様の押絵を上げましたならば神様もきっとお喜びになる事と思って伺いました次第です。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何んでもその社には錆びた二つ三つの鋏を置き、その願ほどきに切ったらしい、女の黒髪の束にしたのを数多かねの緒に結びつけてあったのを憶えている。",
              "citation": {
                "source": "宇賀長者物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年の二月、江の島の辨天樣へお詣りに行つたとき、願をかけたんだ相で、今ではその願が叶つたから、丁度一年目の巳の日の今日、私の代りに願ほどきに行つてくれと、斯う申しますし、あまり急なことでしたが、その願といふのは、私にも係り合ひのあることで、喜んで行つて參りました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "金の番",
                "note": "青空文庫"
              }
            },
            {
              "text": "重吉が琴平へいねの願ほどきに詣っている留守にできたので琴代とつけた。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その願ほどきだってしなければなりませんしさ」　そのとき、女中が茶を運んできた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "血盆経の願ほどきに、きっと行きますわよ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
