        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヤガテ　オドロキガ　トマルト、「イマノ　フトイ　コヱハ　ダレデセウ」「キツト　オソロシイ　モノニ　チガヒナイネ」ト　ヒソヒソ　イヒアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テフテフハ　花トハ　チガヒマス、オハネガ　アツテ　アチラ　コチラ　トビマワル　コトガ　デキマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゴカキハ、「ダンナ　カンチガヒデスヨ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オネガヒダ、ワタシニ　キラセテ　クレ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、イタチダケヲ　ヨバナイト　イタチハ　キツト　オコルニ　チガヒ　アリマセン。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルホド　マルイ　トコロヲ　ミルト　ケイキキユウノニ　チガヒ　アリマセン。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "○合唱いざり、さあ、タワリシチ　　　深刻ぶつた　　　夜中の思想の幕を引きあげろ　　　五体揃つた人間様ぢや　　　とかく物事に尻込なさる　　　そこで腰の蝶ツガヒの　　　はずれた我々が　　　人生を陽気にするやう　　　前座を勤めませう。",
              "citation": {
                "source": "きのふは嵐けふは晴天",
                "author": "小熊秀雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしてもわたしは、三日の間でも関はぬから大将軍になりきつて、浜の子供等とでも遊んで見たいといふ願望は仲々逞しいけれど、キチガヒ師匠の言行は凡そ忘れてゐて、轍を踏まうにも恰で埒もあかぬのである。",
              "citation": {
                "source": "気狂ひ師匠",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ母ッチャモヤセテ、目ガヒッコンデ、カミノケガヌケタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンタチハ、オ母ッチャガ死ヌ四五日モマエカラ、何ンニモタベルモノガナク、目マイガシ、ムネガヒクヒクシ、ペッタリネタキリダッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何ダイ、オ前ニハ女学生ノ友達ガヒトリモヰナイナンテ、随分気ガ利カネエハナシダナ。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この近所の子供は私がたつた一言、『あれはキチガヒだ』とそそのかせば、今後あなたを見るたびに石を投げます」「………………」「それに、あの畑の持主は、いつでも物蔭から見張りしてゐて、少しでも怪しげな奴が立つてゐれば、いきなり鍬で撲りつけます。",
              "citation": {
                "source": "飢ゑ",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ見タトコロデモ死骸ハ大概同ジヤウナ形ニナツテヰタ頭ガヒドクフクレ　顔ハマル焦ゲ　胴体モ腕モケイレン的ニフクレ上ツテヰル　火傷者ノ腕ニ蛆ガ湧イタリスル　十三日後ニナツテモ広島市デハマダ整理ノツカヌ死骸ガ一万モアルラシク　夜ハ人魂ガ燃エテヰルト云フ。",
              "citation": {
                "source": "原爆被災時のノート",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年ノウチニワタシハ、コタンヘカヘリマスガ、マタ、コンド、アガリマスカラ、ドウカ、ヨロシクネガヒマス。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "風ガヒドクテ三匹ハ　カゼヲヒキマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　オタガヒニ、ムカフガ　サキニ　ネムツテ　クレレバヨイニ、トオモヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "知らないお客はとてもこれがマダムなどゝは思はれず、最も新マイの半分色キチガヒではないかなどゝ思ふほど、落附きなく、アハヽと笑つたり、オホヽと笑つたり、妙に身体をくねらせてニヤニヤしたり、この人の本来を知る者にとつては、まことにどうも見るに堪へない。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "カストリなんて、そんなマガヒモノ、うちにはないね、うちの酒は高いよ、仕入れが高いし、品物が違ふんだ、それでもお客の数が一日ごとにふえるのだから、お客は発狂してゐるのである。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "近所ではキチガヒだと思つてゐるので、年中ヒトリゴトを呟いて街を歩いてゐるからで、私と土方のＴ氏、これは酔つ払ふと怪力を発揮するので、この両名は別人種さはるべからずといふことになつて無事戦争を終つた。",
              "citation": {
                "source": "ぐうたら戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "トウ　トウトムガ　オホキナカラダデ、アンマリアバレタ　　　ノデ、フネガヒックリ　カヘッテ、シマイ　　マシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この草には右のオキナグサのほかになおたくさんな各地の方言があって、シャグマグサ、オチゴバナ、ネコグサ、ダンジョウドノ、ハグマ、キツネコンコン、ジイガヒゲ、ゼガイソウもその内の名である。",
              "citation": {
                "source": "植物知識",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくこの麦門冬をヤマスゲといったのは極めて古い昔の名であるが、しかしこの名は疾くに廃れて今はこれをジャノヒゲあるいはリュウノヒゲあるいはジョウガヒゲあるいはジイノヒゲあるいはタツノヒゲなどと呼んでいる。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはダージリンあるいはタイガヒルなどで見た類でありませぬ。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "車内ノ暑サモ思イヤラレルガ、冷房ガヒトシオ厳シイニ違イナク、手ノ痛サノ方ガ心配デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "経助ガヒトリ家デションボリシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ又愉快ナノヨ」予ハコノ話ノ途中カラ左手ガヒドク痛ムヨウニ感ジ始メタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ガヒドク心配スルノデ、又三十分ホド粘ッテカラ漸ク立チ上ッテ部屋ニ帰ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
