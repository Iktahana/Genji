        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コトニヨルト、我国ニハ「シロウトハクロウトヲ支配ス」トイウ法則ガアルノデハナイカト思ウガマダ調ベテモミナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "往年ノ軽微ナ脳溢血ノ痕跡ガマダ残ッテイ、脳中枢ニ僅カナ変化ガアルノデ、ソレガ脚ニ影響シテイルノダトモ云イ、又レントゲンデ検ベテミルト頸椎ト腰椎トガ曲ッテイルカラデアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バレリーナニナロウト思ッテ、バーレッスンヲ一二年受ケタコトガアルノデ、チョットグライ立ツコトハ立テタンデスガ、サア今デモ立テルカ知ラ」ッテ、ソンナ話ヲシタコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春久ガシャワーヲ浴ビニ来サセテクレト云ウノハ、タヾソレダケノコトデナク、何カ魂胆ガアルノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "横網ニ親戚ノ家ガアルノデ、ソコヘ行ク途中ナンダロウト思ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ、婆サント連レ立ッテ這入ッテ来タノハ何カ仔細ガアルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓石ノ様式ニツイテハ、予ニサマ／″＼ノ案ガアルノデ、未ダニ孰レニシテイヽカ迷イ抜イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
