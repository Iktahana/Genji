          "literary": [
            {
              "text": "二十五日ニ実ハ颯子ト約束ガアルンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後楽園ジムニ全日本フライ級タイトルマッチガアルンダ」「年寄ノ冷水ネ、ソンナ所ヘ出カケテ行ッテ怪我デモナサラナケレバイヽガ」二十三日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸子ハ泣イテマシタガネ」「何ヲ泣クコトガアルンダ」「五子モ出テ来ルッテ云ッテマシタカラ固ク止メテアルンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「己ハ颯子ニダケ用ガアルンダ、外ノ人間ニナンカ用ハナインダ！",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ彼ガ、イクラ親父ノ髯ダカラト云ッテ、大事ナ女房ニ本気デ剃ラセル気ガアルンダロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鄭板橋ノ書ガゴザイマスガ御覧ニナッテ下サイマスカ」「ソレヨリ君、突然妙ナオ願イヲスルヨウダガ、アッタラ売ッテ貰イタイモノガアルンダ」「何デゴザイマス」「紅絹ノ裂ヲ二尺バカリト布団綿ヲ一ト塊、分ケテ戴キタインダガネ」「変ッタ御用ヲ承リマスナ、一体何ニナサルンデ？",
              "citation": {
                "source": "瘋癲老人日記",
