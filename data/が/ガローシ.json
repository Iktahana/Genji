        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ガローシの底でキシキシいう雪の音を思い出します。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "散歩に出ると、ガローシュ〔オバーシューズ〕の中で足の指がいたく迚も向い風に長くさらされて居られぬ。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○街路の雪、軟かになって、深くガローシを埋める。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日天気がいいので、ガローシなしで□ったところが、足がしめってやり切れず。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴムトレストでガローシの価を上げた。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば男のガローシ 4р72к だったのを 5р15к に、女 4р7к の代 4р60к　○今日カールミン　　　　　　　　　　　――○――　Ｙ七時頃来た。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "春らしい日曜日で人々は乾いた歩道の上をガローシなしでたのしそうに歩いた。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この活動小屋はガローシをはいて入れるからよろしい。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○モスク※ではまだガローシをはいて居る。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガローシ〔オーバー・シューズ〕なしだ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "傘をさして、毛の靴下をはいて、ガローシをはいて、АОМС へ行った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガローシ、毛の靴下何とあったかでいい心持か！",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月十四日　火　晴、よごれきったガローシをはいて（室に居たら曇り故）堂々と出かけたら路はカラカラ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガローシなしで歩く特別な感覚。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、モスク※人は北方の季節の重厚なうつりかわりをよく知っていて、まだガローシをぬいでいるものはなかったし、外套のボタンをはずしているものもなかった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
