[
  {
    "uuid": "09d44989-3bd8-510e-9768-374ba48917c8",
    "entry": "学頭",
    "reading": {
      "primary": "がくとう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
