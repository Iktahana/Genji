        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "小屋から出た鵝が、があがあ鳴きながら、河ふちへ這って行く。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなその梢の中に入ってしばらくがあがあがあがあ鳴いていましたが、まもなくしいんとなってしまいました。",
              "citation": {
                "source": "鳥をとるやなぎ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "艦隊は一斉に、があがあがあがあ、大砲をうちました。",
              "citation": {
                "source": "烏の北斗七星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「があがあ、遅くなって失敬。",
              "citation": {
                "source": "烏の北斗七星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、そのときはもう、そらがいっぱいの黒い雲で、楊も変に白っぽくなり、蝉ががあがあ鳴いてゐて、そこらはなんとも云はれない、恐ろしい景色にかはってゐた。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ゴーシュはおっかさんのねずみを下におろしてそれから弓をとって何とかラプソディとかいうものをごうごうがあがあ弾きました。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、そのときはもう、そらがいっぱいの黒い雲で、楊も変に白っぽくなり、蝉ががあがあ鳴いていて、そこらは何とも云われない、恐ろしい景色にかわっていた。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、蛇はひがんで、のたのた這い廻るし、蛙はがあがあ騒ぐのだし、蜂はぶんぶん腹立ちまぎれに螫しに来るし、狼や獅子は、鋭い牙を研ぎ出したのだよ。",
              "citation": {
                "source": "トシオの見たもの",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「があがあ、遅くなつて失敬。",
              "citation": {
                "source": "烏の北斗七星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "『これは本当の暴風ですね、林ががあがあ云ってますよ、枝も折れてますよ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "じき近くにあるあひる小屋にいる二わのあひるが、人のけはいでひもじさを思い出したのか、があがあとやかましく鳴きだした。",
              "citation": {
                "source": "屁",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は兵站部の一室を仮りて、板の間に毛布を被って転がっていると、夜の十時頃であろう、だしぬけに戸の外でがあがあと叫ぶような者があった、ぎいぎいと響くような者があった。",
              "citation": {
                "source": "二階から",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なにしろ長屋でがあがあ云っちゃあ面倒だ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "朝顔屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "家鴨はがあがあと鳴いて川の中まで出て来る。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "家鴨ががあがあ鳴く。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "機嫌の悪い時はやけにがあがあやる、機嫌の好い時は元気づいてなおがあがあやる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり機嫌のいい時も悪い時も休みなく勢よくがあがあやる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この硝子窓の中にうじゃうじゃ、があがあ騒いでいる人間はことごとく裸体である。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴉はみるみる数百羽になって、かあかあ、があがあと何か事ありそうに叫びながら廻った。",
              "citation": {
                "source": "太虚司法伝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日紹介をしたごとく依然としてがーがー、げーげーを持続している。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と　みずかきジェマイマは　がーがー。",
              "citation": {
                "source": "みずかきジェマイマのはなし",
                "author": "THE TALE OF JEMIMA PUDDLE-DUCK",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ野暮ったくもったい振り、何の芸も機智も勇気も無く、図々しく厚かましく、へんにガアガア騒々しいものとばかり独断していたのである。",
              "citation": {
                "source": "家庭の幸福",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "林はガアガアと鳴り、カン蛙のうちの前のつめくさは、うす濁った水をかぶってぼんやりとかすんで見えました。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「母、かう云にしてガアガアど聞えるものぁ何だべ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かう云にしてガアガアコーコーど鳴るものぁ何だべ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガアガアッと云ふその雹の音の向ふから、「ホーォ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「母、こう云にしてガアガアど聞えるものぁ何だべ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう云にしてガアガアコーコーど鳴るものぁ何だべ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガアガアッというその雹の音の向うから、「ホーォ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カアカア、アオウガアガアガア、と五六｜羽、水の上へ低く濡色の烏、嘴を黒く飛ぶ。",
              "citation": {
                "source": "二た面",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
