  {
    "uuid": "f37dfaac-c222-5a56-92d3-539c5868fd5d",
    "entry": "ガミ",
    "reading": {
      "primary": "がみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――ナストウリ、モノサシトハサミ、カガミガアリマス、イケニフネ……」大急ぎでそれだけ読んだが、そこで息が切れた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "太い、逞ましい喬木でも、心が朽ちているから、うっかり捉ると枝が折れて、コイワカガミや、ミヤマカタバミの草の褥へ俯ったりする。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はどうせあとでわかることだからと思って取っといたのです」チーフメーツも、船長からガミガミやられると「何だこの野郎、おれだってあと一年で船長の免状がとれるんだぞっ」と思わざるを得ないのであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "義妹も、かえって私たちには遠慮をして、ずいぶん子供たちの世話もしてくれて、いちども、いやな正面衝突など無かったが、しかし、私たちには「家を喪った」者のヒガミもあるのか、やっぱり何か、薄氷を踏んで歩いているような気遣いがあった。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」夜中の二時頃、俺が集合場に馳せつけると、志願兵上りの少尉が見つけてガミガミ云う。",
              "citation": {
                "source": "防備隊",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "網元を「ムラギミ」と云って、そこの親爺の、嘉平と利吉という二人が、ガミ／＼子供を叱りつけた。",
              "citation": {
                "source": "自伝",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "フジサンヤウミガミエルアイビキ！",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂を下るとき、そのなかの素足の女半ば青きシラガミススキの蔭にゆきて、青き弁当の包を取り出しながら連のあとより急ぎゆく。",
              "citation": {
                "source": "春の暗示",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかげよりまた四十前後の女園丁三人手拭の頬冠りして出て来る、坂を下るとき、そのなかの素足の女半ば青きシラガミススギの蔭にゆきて、青き弁当の包を取り出しながら連のあとより急ぎゆく。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいじょうぶだ、へびはいねえよっていってやりましたら、おれさまともあろうものが、こまっけえやつの下風についてたまるけえと、こんなことをガミガミ言いのこしまして、どこかへずらかっちまいましたんですよ」　いっているところへ、どうもやることなすことが伝六流でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "へび使い小町",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の気持に思い遣りがなく、ただもう頭からガミガミ怒鳴り付ける。",
              "citation": {
                "source": "悟浄歎異",
                "author": "―沙門悟浄の手記―",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ムスコニ　テガミヲ　ヤリマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "欧州でも、地獄の大侯ガミギンは小馬の形といい、馬怪ルー・ドラペーは小児を百五十人までその尻に載せ去って復さずという。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランス……ノ……チチ……ニ……テガミ……デ……シラセ……マス……」　という無邪気な日本語が殿下の唇から洩れた。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはもうこの時既に、逸早く私の心理に蔽いかかっていた、片輪者らしいヒガミ根性のせいであったかも知れないけれども……。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に、これからは断然足の夢を見まい……両脚のある時と同様に、快活に元気よくしよう……片輪者のヒガミ根性なぞを、ミジンも見せないようにして、他人様に対しよう……放ったらかしていた勉強もポツポツ始めよう。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "三好が、一番下手なんで、貴方が三好ばかりガミガミ云ったもんだから、あれっきり来なくなっちゃったんですが……」「ウム。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "気に入らない奴は片端からガミつける。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがに吾々の祖先は万物の霊長だけあって、途中で出会うたんびに一々尻を嗅ぎまわってイガミ合っていては、手数が大変だという事を直ぐに覚ったのでありましょう。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、突然彼女をガミガミと勢急に罵り出した。",
              "citation": {
                "source": "秋晴れの日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「云ふなら云ふでちやんと道理をたてゝ云ひ聞かせたらよからう、たゞ無暗とガミ／＼腹をたてたつて――外聞が悪いばかしだ。",
              "citation": {
                "source": "池のまはり",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
