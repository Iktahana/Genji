        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "山ハ絵ノ具ヲドッシリ付ケテ、山ガ地上カラ空ヘモレアガッテイルヨウニカイテミタイモノダト思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「山ハ絵ノ具ヲドッシリ付ケテ、山ガ地上カラ空ヘモレアガッテイルヨウニカイテミタイ」‥‥山が地上から空にもれあがる‥‥それはすばらしい自然への肉迫を表現した言葉だ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ガ昔カラ西洋ヲ見タガッテ居タノハ君モ知ッテルダロー。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "百丈和尚、凡ソ参ズルツイデ一老人アリ、常ニ衆ニシタガッテ法ヲキク。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "コッチノ一同躍リアガッテ喜ブ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「重油ハプスプス燃エヒロガッテユク」「重油」――という所で、人造人間はクルリと左へ向いた。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "小次郎に対する憎しみと、自分に対する怒りとで、彼はアガッテいるのであった。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前八時半トルガッテン島に着船し、九時上陸す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ノ運転デハ危ナガッテ家ノ者ハメッタニ乗ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「僕ニモ分ラン、僕ハアンマリ浄吉ノコトヲ考エナイヨウニシテイル」「アタシモソウナノ、聞イテモ彼ハ面倒臭ガッテホントノコトヲ云ッテクレナイノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「腐ッテタラ犬ニヤレバイヽジャナイノ、アナタ達ハ面白ガッテ何デモアレヘ投ゲ込ムンダネ、アンナモノヲ買ワナキャヨカッタ」ソウ云ッテ颯子ハ後悔シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若イ時カラ女房ナドニ始終意地悪ヲ云イツヾケテ悪党ガッテイタガ、ソノ女房ニ泣カレルト、カラッキシ意気地ガナク負ケテシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ小サクッテイラッシャルノニ、ヤッパリオ爺チャンノコトヲ心配ナスッテイラッシャルンデゴザイマスネ」「子供ノ癖ニ変ニマセテイヤガッテ小生意気デイヤナ奴ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ハアンナノハ大嫌イダ」「マア、ソンナコトヲ仰ッシャッテ」「子供ハ病室ヘ寄越スナッテ云ットイタノニ、勝手ニ這入ッテキヤガッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロハワタシヲコイシガッテイマス。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
