          "literary": [
            {
              "text": "がっちゃん、がっちゃん、がっちゃん。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこか、ねむるのに、いい場所はないだろうか」　壁の穴のそばに立っていたグロテスクな機械人間が、がっちゃん、がっちゃんと動きだした。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれ、探してみようか」　怪しい機械人間は、そういいながら、がっちゃん、がっちゃんと金属の太い足をひきずって、室の一隅にあった階段を、上へと登っていった。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その標本は、生きているはずなんだが、ひょっとすると、死んでしまったかもしれない」「動物ですか」「さあ、動物といった方がいいかどうか――」　そういっているとき、がっちゃん、がちゃんと音がして、階段の上からおりて来る者があった。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年の協力　がっちゃん、がっちゃん、がっちゃん。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくあっちへ行こう」　がっちゃん、がっちゃんと、機械人間は、妙なことばを残して、奥の方へ歩みさった。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この足音を聞いたら、分かるだろう」　機械人間は、がっちゃんがっちゃんと荒々しく足ぶみをしてみせたが、そのときあいている方の左手をのばしたて、がーんと制御台のパネルを叩きやぶった。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "がっちゃんがっちゃんの足音に、所員たちはすぐ気がついた。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝まだ眠いのに家でガッチャンガッチャン、裏の長屋でガッチャンガッチャン。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "タコスケの分りにくい地図をたよりにどうやら到着してみると、小ヂンマリした印刷所で二十人ばかりの若い者がガッチャン／＼働いている。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その全ての店内の全てのパチンコ台も空気銃もみんな女学生に占領されて、ガッチャン、ガッチャンと賑やかなものですよ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "宝塚女子占領軍――阪神の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラガラ、ガッチャン。",
              "citation": {
                "source": "夜の道づれ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
