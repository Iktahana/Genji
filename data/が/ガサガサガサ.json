          "literary": [
            {
              "text": "天井がガサガサガサガサ云ひます。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなガサガサガサガサさがしましたが、どうしてもそんなものはありません。",
              "citation": {
                "source": "よく利く薬とえらい薬",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなはガサガサガサガサやりますけれどもどうもなかなか見つかりません。",
              "citation": {
                "source": "よく利く薬とえらい薬",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "天井がガサガサガサガサ言います。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "天井がガサガサガサガサ云います。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人の男は早速、大きな蓑をガサガサガサガサいわせながら耕地を越えて、水車屋の方へ馳けつけた。",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガサガサガサと木や草を掻き分けて近づく足音。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けんどさ、俺の云うのは……ガサガサガサと下生えの音をさせて、二人の足音が沢に出て行く。",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その瞬間、ヒリリと刺すような痛みを手の甲に感じて、博士がおもわずひるんだすきに、ガサガサガサとはげしい音をのこして、となり屋敷とのさかいの、雑木林へわけいってしまったのです。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥がいると「ヤチ」のなかをガサガサガサ追って追って追い廻す。",
              "citation": {
                "source": "犬",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
