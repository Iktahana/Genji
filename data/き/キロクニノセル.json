        "examples": {
          "standard": [
            {
              "text": "この発見を後世に伝えるために記録に載せるべきだと、研究者たちは口をそろえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "口頭で伝わってきた地域の慣習を文字にして記録に載せる作業が、地元の有志によって進められている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "会議での決定事項を必ず記録に載せておくことで、後から内容を正確に確認できるようになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし記録に載せるのも物にこそよれ、沖縄人｜如何に愚なりといえども、こういう一国の運命にも関するような政治上の秘密を記録などに遺しておくような事はしない。",
              "citation": {
                "source": "沖縄人の最大欠点",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
