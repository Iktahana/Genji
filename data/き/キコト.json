        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ將來ノ大領土ニ於ケル諸多ノ鐵道ヲ再ビ南滿鐵道ニ學バシムルコトアラバ國民ニ鬪志ナキコト明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ノ徴集シ得ベキ資本ノ概算ハ推想スルヲ得ベキモ、其眞實ヲ去ル甚ダ遠キコトハ○○○○○ノ調査徴集ヲ必要トスル所以ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ不幸ナル幸ハ中學教育ニ英語ヲ課シ來レル慣習ノ爲ニ、其ノ程度ノ教育者モ被教育者モ、何等カノ言語ヲ習得スベキコトヲ必須的ニ確信セルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "成年者ガ三月又ハ半年ニテ足ル國際語ノ修得ガ、中學程度ノ兒童一二年ニシテ完成スベキコトハ、英語ガ五年間沒頭シテ尚何ノ實用ニ應ズル完成ヲ得ザル比ニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ下掲ノ如ク日本國民ハ永久ニ兵役ノ義務ヲ有シ、且ツ一年志願兵特權ハ此等ノ訓練アルヲ一理由トナスヲ以テ其レヲモ廢止スルガ故ニ、兵役ニ於テスベキコトハ凡テ兵營ニ於テスベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ國民教育ノ根本的革命ハ戒嚴令施行中ヨリ實施スベキ者ナルヲ以テ、現時ノ校舍ヲ直チニ使用スベキコトヲ明示シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "貞操ノ賣買ハ此ノ改造組織ノ後ニ於テハ漸次消滅スベキコトヲ信ズト共ニ、暫クノ近キ將來ニ存在スベキ其等ニ對シテ、國家ハ兩者共ニ法律ヲ以テ臨マザル方針ヲ取ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺産相續ニ際シテ國家ガ課税ノ理由ナキコトハ、相續者則非相續者ノ肉體的延長ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ヲシテ日本ノ愛蘭土タラシムル如キコトアラバ、將來大羅馬帝國ヲ築カントスル日本ハ全然其ノ能力ナキコトヲ第一歩ニ於テ立證スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時ノ強國中各種老幼ノ民族ヲ包有セザル者ナキコト各家庭ニ於テ老婆少女ヲ有スルガ如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ朝鮮ハ合併以前自決ノ力ナカリシコトハ八十歳ノ老婆ノ如ク、合併以後未ダ自決ノ力ナキコト十歳ノ少女ノ如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "周知ノ如ク英獨協商ハ香港ヲ根據トセル英國ト青島ヲ根據トセル獨逸トガ、支那分割ノ亞佛利加大陸ノ如ク實現スベキコトヲ確信シテ、北支那ヲ獨逸ニ中央支那以南ヲ英國ニ妥協シタル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國境ヲ撤去シタル世界ノ平和ヲ考フル各種ノ主義ハ其ノ理想ノ設定ニ於テ、是レヲ可能ナラシムル幾多ノ根本的條件則チ人類ガ更ニ重大ナル科學的發明ト神性的躍進トヲ得タル後ナルベキコトヲ無視シタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "といい、またこの後ち明治三年に出版の「西洋事情」第二編の例言中に、彼ノ常言モ、我耳ニ新シキコトアリテ、洋書ヲ翻訳スルニ臨ミ、或ハ妥当ノ訳字ナクシテ、訳者ノ困却スルコト、常ニ少カラズ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "古人ノ語ニ、一身ヲ自由ニシテ自ラ守ルハ、万人ニ具ハリタル天性ニシテ、人情ニ近ケレバ、家財富貴ヲ保ツヨリモ重キコトナリト。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "又好悪ノ出来ルト云フコトナリ、危キ事ヲモ犯シテ為サネバナラヌ、心ニ思ハヌ事ヲモ枉ゲテ行ハネバナラヌナドト、心苦シキコトノナキ趣意ナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち「石狩国札幌郡｜空知郡ノ内――但シ、地所ノ儀ハ石狩府ニテ差図ニ及ブベキコト――右｜其ノ方支配仰セツケラレ候事」という許可であった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンジノイエニ、オソルベキコトオコラン。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ驚クベキコトハ、彼等ノ中ニハ西洋人多ク混ジ居ルヲ認メタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "他ハ日本人ナルカト思イタレドモ、後ニ至リテ彼等ハ日本人ニハ非ザルモノノ如キコト判明セリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "左様ナ一度トカ一糎トカ僅少ノ幾何学的問題ニ一生ヲ棒ニフル者ガ少クナイノハ実ニ嗤ウベキコトデアル。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド之ヲ愛玩スルニ就テ、論ズ可キコト亦鮮ナカラズ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "古物ヲ賞鑑スルニ於テ、内外ノ区別ヲ立ツルハ笑フ可キコトニテ、其ノ識量ノ狭隘ナルヲ奈何セン。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "是レ深ク注意ス可キコトナリ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノコトハ、交際上ニ於テハ毫モ論ズ可キコトニ有ラネド、尚古ノ道ニ取リテハ口惜キコトナラズヤ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
