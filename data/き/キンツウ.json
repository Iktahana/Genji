        "examples": {
          "standard": [
            {
              "text": "マラソン大会の翌日、彼女は激しい筋痛に襲われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "医者は、患者の筋痛が過度なトレーニングが原因だと説明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "関節炎に伴う筋痛は、彼の日常生活を著しく制限していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "元来この歌に朝といふ字がどれほど必要……図に乗つて余り書きし故｜筋痛み出し、やめ。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            }
          ]
