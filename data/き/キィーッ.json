          "literary": [
            {
              "text": "「キィーッ」　一同は、はッと、呼吸をつめた。",
              "citation": {
                "source": "夜泣き鉄骨",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キィーッ、キィーッ」　呀ッ、いよいよ、泣きだしたのだ。",
              "citation": {
                "source": "夜泣き鉄骨",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キィーッ、キィーッ、ぐうッ、ぐうッ」　彼等は、見えない眼を閉じた。",
              "citation": {
                "source": "夜泣き鉄骨",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キ、キ、キ、キ、キィーッ」　もう堪りかねたものか、一行のうちから、サッと、懐中電灯の光芒が、射るように、高い天井を照した。",
              "citation": {
                "source": "夜泣き鉄骨",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
