    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マノノ島へ急航したビックフォード艦長は三時間の期限付で降服を促した。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "期限付の約束に追立てられることもなく、又、季節の繼ぎ目といふものも無しに、たゞ長閑にダラ／＼と時が流れて行く此の島では、浦島太郎は決して單なるお話ではない。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "期限付の約束に追立てられることもなく、また、季節の継ぎ目というものも無しに、ただ長閑にダラダラと時が流れて行くこの島では、浦島太郎は決して単なるお話ではない。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "然も一種の世間師だから期限付のファッシストを宣言したところ思わず人を哄笑させる。",
              "citation": {
                "source": "ブルジョア作家のファッショ化に就て",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先週も三人組の独逸人に百万｜法近くやられて、三日の期限付でモナコ公国にモラトリアムが出たばかりのところなんです。",
              "citation": {
                "source": "黒い手帳",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍医に下級され、二年間の期限付でケープ殖民地へ左遷。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼には請人もなく、故郷のことは云えないので、無宿人の扱いを受け、五年という期限付きで寄場へ収容された。",
              "citation": {
                "source": "さぶ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "登州奉行はそのために、令を発して、「期限付き、虎退治の指令を、村々の百姓｜猟人へいい渡せ」　と、土地の庄屋や村役場へ厳達してきた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
