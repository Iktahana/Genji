        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "語原意識を明らかに見せた傍岡・傍丘など言ふ記載例もある。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "まづ此様式から言へば、後世の新撰姓氏録の記載例なども、其固定した俤を伝へるものと見てよい。",
              "citation": {
                "source": "日本文学の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "後の二つは、記載例としては遅れてゐるが、同じ感じを持たせる「とも」である。",
              "citation": {
                "source": "副詞表情の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の記載例を見るに、例へば元屋村の条下には、　一、家数三拾六軒内廿六軒百姓拾軒間脇とあり、明かに百姓と区別したのものに有之候。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
