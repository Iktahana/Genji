[
  {
    "uuid": "3c4ed151-1879-5f12-8cf4-160e40f2a4ee",
    "entry": "キビキビ",
    "reading": {
      "primary": "キビキビ",
      "alternatives": [
        "きびきび"
      ],
      "is_heteronym": false
    },
    "grammar": {
