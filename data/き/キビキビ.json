    "definitions": [
      {
        "index": 1,
        "gloss": "briskly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「新人さん、動きがキビキビしてて気持ちいいね！こっちまでやる気が出るよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "指揮官の号令一つで、隊員たちがキビキビと整列し始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「はい、分かりました！」とキビキビした返事をして、彼はすぐさま現場へ向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "幸田露伴にも『枕頭山水』の名作があり、キビキビした筆致で、自然でも、人間でも、片っぱしからきめつけるような犀利な文章を書いている。",
              "citation": {
                "source": "紀行文家の群れ",
                "author": "――田山花袋氏――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その短い文章は例の通りキビキビとして極めて要を得ているのは勿論であるが、その行文の間に卑怯な迫害者に対する苦々しさが滲透しているようである。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "文藝春秋といふ雜誌は、文壇稀れに見る「頭腦の好い雜誌」であつて、編輯がキビキビとして居り、詰將棋の名手を見るやうな痛快さがある。",
              "citation": {
                "source": "常識家の非常識",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "文藝春秋といふ雑誌は、文壇稀れに見る「頭脳の好い雑誌」であつて、編輯がキビキビとして居り、詰将棋の名手を見るやうな痛快さがある。",
              "citation": {
                "source": "常識家の非常識",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜の酒手が利いたらしくキビキビと立働らいて、間もなく帆を十分に引上げると、港中の注視の的になりながら、これ見よがしに港口を出るや否や、マトモ一パイに孕んだ帆を七分三分に引下げた。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は事務所では実際いつも如才なくキビキビと働いてはいましたけれど、しかし世間でこんな風に私の噂をしていようとは夢にも思っていませんでした。",
              "citation": {
                "source": "株式仲買店々員",
                "author": "コナンドイル　Arthur Conan Doyle",
                "note": "青空文庫"
              }
            },
            {
              "text": "この新聞材料にぶつかった最初から受け続けている、何とも云えないイヤナ感じを、ここでもっと突込んでみようか……それともこの辺で思い切ってしまって、もっと明るいキビキビした、ほかの材料に乗り換えようかと、一瞬間思い迷った。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "したくをしながら、二十五歳のキビキビした青年、波田は悲痛な冗談をいっていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "魯とは鈍とか遅鈍のことで、キビキビした敏捷な人で無く、おっとりと薄のろい人だった。",
              "citation": {
                "source": "一貫章義（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　中戸川吉二氏の「叔母老いる」（「表現」）は、キビキビした筆致で、書かうとしたことを一気に書き終へた（事実はそんな筈はなからうが）やうに思はせらるゝ作だ。",
              "citation": {
                "source": "海浜日誌",
                "author": "六月創作評",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、全体としては白鳥式にキビキビしてゐて好い。",
              "citation": {
                "source": "存在",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の事はない、緑雨の風※、人品、音声、表情など一切がメスのように鋭どいキビキビした緑雨の警句そのままの具象化であった。",
              "citation": {
                "source": "斎藤緑雨",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "最う二、三月辛抱すれば卒業出来るのだし、二葉亭は同学中の秀才だったから、そのまま欠席して試験を受けないでも免状を与えようという校長の内諭もあったが、気に喰わない学校の卒業証書を恩恵的に貰う必要はないと、キビキビ跳付けてプイと退学してしまった。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "とてもたいへんな人だね、といって悪い意味じゃないが、態度といい、会話といい、とてもキビキビしているねぇ。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "只、その仕事が組織的にキビキビしているために有力な不良少女団と認められている。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中でこの前に見かけなかったような一人のキビキビした背広の男が一同の前になにか云っていた。",
              "citation": {
                "source": "俘囚",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛んでゐる時は勿論、とまつてゐる時も溢るる精気に絶えず全身を小刻みにキビキビ動かし続けてやまない。",
              "citation": {
                "source": "ジガ蜂",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "リユクサツクを背負つた學生や、さういふキビキビした若い聲は久しぶりなだけに一層だつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　思ひがけなくキビキビした聲ですぐにじゆんが答へた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはり洋服でキビキビしたプレイをしていた。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして安子との交わりで私は甘い、こってりとした情緒でなく、キビキビした多少ラッフなものへの感覚を呼び醒まされた。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに情熱と明るさがあつて、キビキビしたところがあります。",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "序",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿直の医師はキビキビした調子で看護婦を督励し、総監の身体を裸にした。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう行事には場を踏んで来たものらしく、声も態度もキビキビしていた。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "かういふ行事には場を踏んで来たものらしく、声も態度もキビキビしてゐた。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、家に帰つて来ると、実にキビキビとして、一階から三階の間を馳け廻り、部屋々々の様子をうかがつて、逢ふ人ごとに如才なく弁舌を振ふのである。",
              "citation": {
                "source": "日本三文オペラ",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼には処世のために必要なあらゆる武器がそろっていた――洗煉された挙措動作はいかにも気持よく、事務にかけてはキビキビと縦横に敏腕をふるった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとこれが結びついて、初鰹の氣負のよさとなり、切れ味の冴えた肉のしまり、海から飛んできたやうな色艶や、キビキビした賣聲や、男性的颯爽たる諸條件がそろつて、初鰹は江戸の季節の一景物とまでなつたのだ。",
              "citation": {
                "source": "初かつを",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "』陽向葵はどんな荒れた土の上にも咲いてゐた自由な空気をいつぱい吸つた坑夫達は飯を頬ばつたり女房の鼻をつまんだりしてキビキビした笑ひを投げあつてゐる油陽照りの八月だ！",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
