        "examples": {
          "standard": [
            {
              "text": "うな重の相棒といえば、やっぱりこの透き通った出汁の肝吸いだよね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あ、肝吸いに三つ葉の香りが効いてて最高！」と彼女は嬉しそうに啜った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "精をつけるために、今日は奮発して肝吸い付きのセットを注文しちゃおう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "うなぎの肝吸いものというのは、相当しゃれた下手吸いもののひとつに加わっているが、これは単に肝のみを利用しているのではない。",
              "citation": {
                "source": "知らずや肝の美味",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかだにした蒲焼、きも吸い、う巻の玉子焼。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "葛岡は食べながら、「下町の食いものはうまいね」　と言いましたが、鰻屋の料理なぞはよく食べ方を知らない様子なので、わたくしは葛岡に食品の説明をしてやりながら、きも吸いの椀の中に入っている縁起鉤に気をつけさせ、それを取出させて襟にかけることを教えました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
