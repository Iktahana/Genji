          "literary": [
            {
              "text": "−−−−−−−−−−−−−−−−−−−−−−−−−−日本画の将来　映画の出現は、小説や劇やその他の芸術ジャンルに甚だしく不安を与へ、そのためにキノドラマといふものが現れたり、詩の方でもシネポヱムなどゝいふ、映画と他の芸術形式との結合を企てたものがでたりした。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "新築地のキノドラマと、「未完成交響楽」をやってゐる、恐るべき不入り、気の毒のやう。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノドラマなるもの、中々の参考品だ、これを音楽沢山にしてやってみたいものである。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノドラマ「軍国女学生」がよかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
