        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三　キユウピツド　浅草といふ言葉は複雑である。",
              "citation": {
                "source": "野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、キユウピツドに扮した無数の少女の廻り梯子を下る光景は如何にも溌剌としたものだつた。",
              "citation": {
                "source": "野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "キユウピツドに扮した無数の少女の廻り梯子を下る光景である。",
              "citation": {
                "source": "野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はマネジヤアのＮ君と彼等のおりるのを見下しながら、ふとその中のキユウピツドの一人の萎れてゐるのを発見した。",
              "citation": {
                "source": "野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "キユウピツドは十五か十六であらう。",
              "citation": {
                "source": "野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あのキユウピツドは悄気てゐますね。",
              "citation": {
                "source": "野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "このキユウピツドの出るオペラは喜歌劇だつたのに違ひない。",
              "citation": {
                "source": "野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし兎に角月桂や薔薇にフツト・ライトの光を受けた思ひ出の中の舞台には、その後もずつと影のやうにキユウピツドが一人失恋してゐる。",
              "citation": {
                "source": "野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
