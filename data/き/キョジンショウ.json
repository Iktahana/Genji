        "examples": {
          "standard": [
            {
              "text": "下垂体の腫瘍が原因で巨人症を発症した少年は、成長期に急激に身長が伸びた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "巨人症の患者は骨格や内臓にも異常が生じることがあるため、早期治療が重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "医師から巨人症と診断されたとき、両親は驚きと不安で言葉を失った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "どういうわけか我々は、周りを取り巻くキュクロプス式の重量感や巨人症から不愉快な感じを受けるようになっていた。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
