    "definitions": [
      {
        "index": 1,
        "gloss": "wooden spatula",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
