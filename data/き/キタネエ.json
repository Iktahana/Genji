          "literary": [
            {
              "text": "「キタネエ」という評判は、死刑宣告だ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時点では、まだ長い修学旅行をしていて、たまたま旅館のおなじ部屋に、キタネエ野郎がいるだけだと思っていた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやなら、てめえのキタネエ指を、いま切り落としてやる！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "あした、返してやるが、自宅にもち帰ること」「キタネエな、さんざん食べといて。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "チイ嬢はそこであっしのキタネエ首根ッ子に今一つキッスをしますと、あっしの手を引きながらその店の中に這入って行きましたが、それは大きなレコード屋だったんですね。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "……日本人は、キタネエよ。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
