        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "都会の片隅に、昔ながらの木賃がひっそりと残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "一文無しになった旅人は、その夜、木賃を求めて町を彷徨った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は住む家を失い、しばらく木賃暮らしをしていたという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
