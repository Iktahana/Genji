    },
    "definitions": [
      {
        "index": 1,
        "gloss": "holiday",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "明日は休日だから、ゆっくりと家で映画でも見たり、読書を楽しんだりしようかな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "待ちに待った休日、家族全員で近くの湖畔へキャンプに出かけ、満点の星空を眺めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "休日には、いつも近所のカフェでモーニングを食べてから、公園を散歩するのが私のルーティンだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "就任早々、一週を五日として、六日目毎に休日を與へ、授業も毎日午前中だけにしたい、それゆゑに生徒が怠けるとは思はれない。",
              "citation": {
                "source": "校長三代",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時候はづれでそして休日でもないせゐか他にお客は一人もなかつた。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "休日でもないのに何處へ行くのだらうと思つて氣をつけて居た。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがその場の滞を流すように、「今日は僕も休日さ。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大方は休日などの朝出かけて行って、夕方はもう東京の家へ帰って来る事にしてある。",
              "citation": {
                "source": "石油ランプ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その際、おりおり出漁の休日があっても、また魚の数え損じがあってもさしつかえはない。",
              "citation": {
                "source": "物質群として見た動物群",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "デパートの休日でない日はそれほど込み合っていない。",
              "citation": {
                "source": "三斜晶系",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "休日などにはよく縁側の日向で赤ん坊をすかしている。",
              "citation": {
                "source": "イタリア人",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "時候はずれでそして休日でもないせいか他にお客は一人もなかった。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "休日でもないのにどこへ行くのだろうと思って気をつけていた。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後ある休日の午後、第Ｘシンフォニーの放送があったとき、銀座のある喫茶店へはいってみた。",
              "citation": {
                "source": "路傍の草",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　侵入者　郊外の田舎にわずかな地面を求めて、休日ごとにいい空気を吸って頭を養うための隠れ家を作った。",
              "citation": {
                "source": "路傍の草",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "休日に近郊などへ散歩に出かけられるのでも、やはり同様な見地からであったように自分には思われる。",
              "citation": {
                "source": "田丸先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "月に三度の公休日にも映画ひとつ見ようとせず、お茶ひとつ飲みにも行かず、切り詰め切り詰めた一人暮しの中で、せっせと内職のミシンを踏み、急ぎの仕立の時には徹夜した。",
              "citation": {
                "source": "旅への誘い",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　Ｙ君の休日の日課があらためられた。",
              "citation": {
                "source": "アンドロギュノスの裔",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言ふ、特赦の休日があたへられてる。",
              "citation": {
                "source": "病床生活からの一発見",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはちょうど、ハンスの子守歌や、ヘンデル草や、ペテロの休日と、同じようなものでした。",
              "citation": {
                "source": "丘の銅像",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりは、はじめての定休日に、クロを見にきたのでした。",
              "citation": {
                "source": "正坊とクロ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に小人数ですから家族的気分でいいとかいいながら、それだけ競争もはげしく、ぼくなど御意見を伺わされに四六時中、ですから――それに商売の性質から客の接待、休日、日曜出勤、居残り等多く、勉強する閑はありません。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日は銀行休日であった。",
              "citation": {
                "source": "決闘場",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "めずらしく三つ押し並んだ休日があった。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには週末休日のゴルフと漁季の鱒釣りとには依然親愛の情を持って御交際するが、その他の一切に関しては御交渉を絶ち度いという申出でだ。",
              "citation": {
                "source": "バットクラス",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度その日は君枝の公休日だった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "公休日というものも設けず、毎日せっせと精出したから、無駄費いもないままに、勢い残る一方であった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "前にもちょっと話したようであったが、末造は小綺麗な身なりをするのが道楽で、まだ大学の小使をしていた時なんぞは、休日になると、お定まりの小倉の筒袖を脱ぎ棄てて、気の利いた商人らしい着物に着換えるのであった。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "役所に出る前、役所を引いた後、休日などがあるから、人を尋ねれば尋ねられる筈である。",
              "citation": {
                "source": "長谷川辰之助",
                "author": "森林太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "常の日の内にゐる時間も、休日も、祭日もお客のお相手をする。",
              "citation": {
                "source": "長谷川辰之助",
                "author": "森林太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまに休日で、博士が晝間内にゐても、母君が來ると、奧さんが例のつと立つて逃げる。",
              "citation": {
                "source": "半日",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇　稽古は二五八、三六九の日に分けて、四の日七の日十の日が翁の休日であったらしい。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "天気の好い休日には娘の操る車に、村のあらゆる階級の若者、主に娘達が乗り込んで、屹度何処かへ遊びに行く。",
              "citation": {
                "source": "一九三〇年型",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
