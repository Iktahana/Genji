        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "カタログから欲しいページを切り抜く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新聞記事を丁寧に切り抜いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "紙を定規に沿って切り抜く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "我が書きたるものに振仮名を附くる事と、日毎の新聞より『閑天地』切り抜くを勤めなりけるその人も、亦今我と共にこゝにあり。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間壮士らの宿料をば、無理算段して埋め合せ、辛うじて無銭宿泊の難を免れたれども、さて今後幾日を経ば調金の見込み立つべきや否や、将た如何にしてその間を切り抜くべきや。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "またたとい犯人が、叔父さんのうちのものであっても、叔父さんが真っ先に読む新聞を切り抜くはずはない。",
              "citation": {
                "source": "紅色ダイヤ",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "あくまでいないとしらを切り抜くのだ。",
              "citation": {
                "source": "田舎風なヒューモレスク",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は画用紙へその大蜘蛛の姿を墨で描いて、鋏で切り抜くのであった。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "色つやのいい唇をキット引しめ、気をつけてカール・リープクネヒトの秀でた額際をきりぬくと、ペーチャは、二つつづきの指導者たちの像を、ちょっと顔から遠くへはなして眺めた。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月十七日（日曜）　牛込南榎町に家があるという広告をＹ切りぬく。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "姐様は、半紙で小さな坊主つくりを作って、千代紙の着物をきせることもあるが、多くは、絵双紙店で売っているのを切りぬく。",
              "citation": {
                "source": "源泉小学校",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等が人形や鶏や鷺やその他を切りぬく巧な方法は、驚くばかりであった。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガタガタする車体の中で、メチャメチャに燥いでお出でになった三人は、私が安全剃刀の刃で、後窓の周囲をＵの字型に切抜くのをチットモお気付きになりませんでした。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがマアそんな詰まらねえ理屈は、ここでは一切抜くとして、ひとつそういう約束にしよう。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
