        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "遠くの円形棧敷の貴賓席に、ぽつりと一人いる人の黒服と白髪の輪廓も鮮やかにこちらから見える。",
              "citation": {
                "source": "待呆け議会風景",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴賓席にはロード・キッチナーやチャーチル等イギリスの大臣や高位高官が居並んでいるし、日本の井上大使御夫妻を始め、各国の大公使やその夫人が綺羅星のように居並んでいるのが、まるでお雛様のように、ちいさく見えました。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "大公爵と廷臣らは、大きな貴賓席を占めていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴賓席にはいると、クリストフは短上衣を着た人の前にすわらせられた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴賓席はただ付随の輩ばかりで、数人の貴顕婦人で占められた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その晩私は、いつもよりも多量にウヰスキーを呷って、三友館の二階の貴賓席に上り込んで居た。",
              "citation": {
                "source": "秘密",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めは誰も居なかった筈の貴賓席の私の側の椅子が、いつの間に塞がったのか能くは知らないが、二三度目に再び電燈がともされた時、私の左隣りに二人の男女が腰をかけて居るのに気が附いた。",
              "citation": {
                "source": "秘密",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "秩父宮妃殿下（未亡人）貴賓席で見物、幕が下りると、妃殿下、お供の婦人達と舞台へ上り、おことばをたまはる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
