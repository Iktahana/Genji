        "examples": {
          "standard": [
            {
              "text": "この学術書は菊判だから、カバンに入れると少し角が当たるんだよね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "A5判より一回り大きい菊判は、図版が多い実用書に向いているサイズだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昔の文芸雑誌を菊判で復刊するプロジェクトが進んでいるらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "菊判のハードカバーは、棚に並べた時の存在感が違う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
