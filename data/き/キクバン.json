    "definitions": [
      {
        "index": 1,
        "gloss": "kiku-ban (paper size; 636x939 mm)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「この古い学術書、手にしっくりくるサイズだと思ったら菊判で製本されているんだね」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "文庫本より一回り大きく、四六判より少し小さい菊判は、専門書や文芸誌などで今も根強く使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "印刷所にパンフレットを発注する際、高級感を出すためにあえて規格サイズのA4ではなく菊判を指定した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "一番売れたのは『吾輩は猫である』で、従来の菊判の本の外に此頃縮刷したのが出来て居る。",
              "citation": {
                "source": "文士の生活",
                "author": "夏目漱石氏−収入−衣食住−娯楽−趣味−愛憎−日常生活−執筆の前後",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして菊判の本の下へポケット、ブツクを蔵つて了つて、俺の手帳が無くなつたと呟き出すことは、往々にして有り勝ちな事である。",
              "citation": {
                "source": "些細なやうで重大な事",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "定價一部金十八錢郵税二錢△半年分前金税共一圓十錢△一年分同二圓十錢廣告料　菊判一頁金十五圓　半頁金八圓（明44・２・１「創作」第二卷第二號）　　　〜〜〜〜〜〜〜〜〜〜〜〜〜〜〜〜前金購讀及び廣告申込は必ず左記發行所宛の事又爲替劵に豫め受取人を指定する時は發行所同番地石川一とせられたし。",
              "citation": {
                "source": "無題",
                "author": "月刊文藝雜誌　樹木と果實　初號三月一日發行",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊判三百｜頁で、三十五銭であるから、廉い／＼と云はれる如何なる全集も、到底比べものにはならないだらう。",
              "citation": {
                "source": "「小学生全集」について",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間も前から眼を通していた二十｜頁に近い菊判の雑誌の切抜がやっと終った。",
              "citation": {
                "source": "雨夜草紙",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "形を菊判にしたのが珍しかつた。",
              "citation": {
                "source": "樹木とその葉",
                "author": "野蒜の花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「当世書生気質」を収録した『太陽』増刊号の赤いクロースの厚い菊判も、綴目がきれて混っている。",
              "citation": {
                "source": "本棚",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故なら、率直に言ってこれは菊判六百頁に近い程長く書かせる種類の題材でなく感じられたし、長篇小説として見ればどちらかと言えば成功し難い作品であるから。",
              "citation": {
                "source": "「或る女」についてのノート",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると店先の陳列台に古い菊判の本が一冊、「大久保湖州著、家康と直弼、引ナシ金五十銭」と云ふ貼り札の帯をかけたまま、雑書の上に抛り出してあつた。",
              "citation": {
                "source": "大久保湖州",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は迂濶にも「日本橋」の出版の豫告を知らなかつたので、菊判帙入の美本を手に取上げる迄は、それが眞實に泉先生の新作であるかどうかを疑つた。",
              "citation": {
                "source": "貝殼追放",
                "author": "購書美談",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊判より大きく四六倍判より小さいが、左にならんでゐる歐文はパイカで、例の「單語篇」のイタリツクとちがひ、假に嘉平もパイカを作つたにしても字形が洗練されすぎてゐる。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして同教室の小林行雄、岡崎敬両君の熱心な助力を得て、初版刊行後に得られた新資料及び斯学の進歩を採り入れて『校訂日本石器時代提要』は、菊判五百五十ページに及ぶ大著となって、再び世に出た。",
              "citation": {
                "source": "『日本石器時代提要』のこと",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊判ではあるが二百頁を少し越す程度の、手頃の分量の本である。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "その樺氏がＪ・Ｇ・ドロイゼンの『史学綱領』（菊判二三〇頁）を翻訳した（刀江書院）。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一九三六年・白揚社版・菊判四〇三頁・定価一円五〇銭）　10　岡邦雄・吉田斂・石原辰郎著『自然弁証法』　本書はまず二つの著しい特色を有つ。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一九三六年九月・『生活と精神の科学』叢書・二十八巻・東宛書房版・菊判二六〇頁・定価二円六〇銭）　12　ジード著　小松清訳『ソヴェート旅行記』　あまりに多く論じられた書物であるから、今更特別な紹介を必要としないだろう。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一九三六年十二月・岩波書店版・菊判・四八〇頁・定価三円）　16　早川二郎著『日本歴史読本』　以前発表された『日本歴史読本』を殆んど全部に渡って書き改め、全く別稿としたものである。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一九三七年四月改版・白揚社版・菊判四八〇頁・定価二円）　17　小倉金之助著『科学的精神と数学教育』　小倉金之助博士が二十余年間に渡って選集した評論集であり、序篇の五篇は比較的旧いもの、本篇の十二篇は比較的新しいものである。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへゆくと、小波の世界お伽噺は菊判四号活字で読み易くもあったせいか、すでに何十種も出版されていたが、出ている限りの物はあらまし読んだ。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "俳句に対し総括的な定義を下すと共に、修学第一期、第二期、第三期の順を追うて種々の方面よりその特質を説いたもので、菊判｜半截一八八ページの小冊子を以てほぼ意を尽している。",
              "citation": {
                "source": "「俳諧大要」解説",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "★明治二十九年七月、英国小説「孤児」金桜堂、菊判、一七四頁。",
              "citation": {
                "source": "探偵小説の「謎」",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが所謂馬糞紙の箱に入れる風が始まって、菊判四六等々の大きさ以外に、外から本の性質を見当づける途が先ず無くなり、次で文庫が始まってどれも是も川原の小石の如く、手に取って細字の標題を読まなければならぬようになった。",
              "citation": {
                "source": "書物を愛する道",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初は、四六版の計画であつたが、発表前後に、共同印刷所へ、全｜頁四度刷と云ふ破天荒な機械が輸入されたので、（その機械は菊版でなければかゝらないので）急に菊版に模様がへした。",
              "citation": {
                "source": "「小学生全集」について",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、わづか三十五銭で菊版三百｜頁の本が出来るかと云へば、かうだ。",
              "citation": {
                "source": "小学生全集に就て（再び）",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いえ、癪などは起していただかんでもよろしいので、ここに賛助員の名簿が」と云いながら紫の風呂敷から大事そうに小菊版の帳面を出す。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊版で、ワツトマンの純白な紙に、富岡鐵齋翁の金字塔といふ字を金箔で捺した清雅な裝幀でしたが、高安氏に會ふと、尾崎氏は同じやうにこの本の裝幀をほめ、『私もこんなにして本を出してみたい。",
              "citation": {
                "source": "詩集の後に",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある社で計画した今度の新しい叢書は著作者の顔触れも広く取り入れてあるもので、その中には私の先輩の名も見え、私の友だちの名も見えるが、菊版三段組み、六号活字、総振り仮名付きで、一冊三四百ぺージもあるものを思い切った安い定価で予約応募者にわかとうというのであった。",
              "citation": {
                "source": "分配",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに地方からもだいぶ原稿が来るからだいじょうぶだろうと思うよ」　こう言って、地方の小雑誌やら東京の文学雑誌やらを五六種出したが、岡山地方で発行する菊版二十四｜頁の「小文学」というのをとくに抜き出して、「たいていこういうふうにしようと思うんだ。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "四五年前までは新本でも丸善で二十五銭で買えた菊版の六片版を十銭位で古本屋からあさってあるいたこともあった。",
              "citation": {
                "source": "私の要求する探偵小説",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間のは菊版で四百何十頁か。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
