        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "パソコンで記事をコピーして切り貼りするのは簡単だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "プレゼン資料を切り貼りして急いで完成させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "画像編集ソフトで写真を切り貼りして合成画像を作る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
