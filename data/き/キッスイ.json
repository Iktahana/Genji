[
  {
    "uuid": "9324a4fc-b4da-57bc-bc7b-755985bdfd82",
    "entry": "生粋",
    "reading": {
      "primary": "きっすい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
