          "literary": [
            {
              "text": "サツキヨリ、マダヤカマシクナツタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサ　ミタトキヨリモ、モツト　モツト　カゲハ　オホキク　ナツテヰタノデス。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大槻博士の『大言海』によれば、タデは「爛レノ意ニテ口舌ニ辛キヨリ云フト云フ」と出ている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近畿地方の多くの村々では、盆や正月祭礼までを引きくるめて、小さな休みの日までをトツキヨリという人が多い。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
