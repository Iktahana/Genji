          "literary": [
            {
              "text": "見ると、イ警第三二五六号　聴取の要有之本日午後三時本警察署人事係まで出頭致され度しイーハトーヴォ警察署一九二七年六月廿九日第十八等官レオーノ・キュースト殿とあったのです。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お呼びがありましたので参りましたが、レオーノ・キューストでございます。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「第十八等官、レオーノ・キュースト氏はあなたですか。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君がレオーノ・キュースト君か。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おおい、キューストさんが来たぞ。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キューストはたびたび来て見てくれるだろう。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい、みんな、キューストさんがぼくらのなかまへはいると。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
