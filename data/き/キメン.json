[
  {
    "uuid": "b3222147-02e0-5363-b2e0-ceeaf96c246c",
    "entry": "鬼面",
    "reading": {
      "primary": "きめん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
