        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この地域ではきちきち蝗虫が多く見られる季節がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "きちきち蝗虫の特徴的な模様を観察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "きちきち蝗虫の幼虫が茂みの中に群れていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
