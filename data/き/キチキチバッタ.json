    "definitions": [
      {
        "index": 1,
        "gloss": "male Oriental longheaded locust (Acrida cinerea)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "秋になるときちきち蝗虫の鳴く音が田んぼに響く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子どもの頃きちきち蝗虫を探すのが好きだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "草むらの中にきちきち蝗虫が隠れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「原っぱへポチをつれて、きちきちばったを捕りにいこう。",
              "citation": {
                "source": "はちの巣",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "原っぱへいくと、ほかにも子供たちがいて、きちきちばったを追っていました。",
              "citation": {
                "source": "はちの巣",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇ちゃんはきちきちばったを捕らえて、指のあいだにはさんでいました。",
              "citation": {
                "source": "はちの巣",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇ちゃんは、じゅず玉のなっている枝を光子さんにわたすと、きちきちばったをうけ取って、「お母さんに、お薬をつけてもらうから。",
              "citation": {
                "source": "はちの巣",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "Gonista bicolor (species of grasshopper resembling the Oriental longheaded locust)",
