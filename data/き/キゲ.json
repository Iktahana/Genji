        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "内容に踏み込むことはレビューの狙いからは外れるだろうが、作品はすっとぼけたゴキゲンな宇宙オトギ話だ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨降ッテ、だんなのキゲンワロシ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミナサン、ゴキゲンヨクオヤスミナサイマセを云ったあとですよ。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "けさ、大キゲンでおきて、私が「アボチン、アッコおばちゃんのお机の草、もう古くなったから又とって来てよ」と云ったら、大得意で、「もうとって来てあるよ」と見得をきりました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "浩子さんは、ものを考えつづけている人の顔に馴れないからキゲンわるいのかと心配するだろうと思って、下にいると、ついつとめても話していたから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙも出がけフキゲンであった。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（手入れ）　夜、食後、又仕事、十時すぎやめ、自分何だかフキゲンになった。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "不安なり、フキゲンでもある。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "不キゲンなり、そしてフキゲンなことを恥辱とも思わぬらしく人に当る。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月二十八日（火曜）　Ｙ、フキゲンなり、　散歩、ふみ子洗髪のまま出た。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○自分寂しいときＹはフキゲンとなって怒る。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十三枚半　今日二人キゲンよし。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに自分は又、ああいう状態であったから、余り気の利いた迎えようもせず、ためにＹまるでフキゲンなり。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月二十八日（日曜）　Ｙ今日又朝からフキゲン。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、午後になってもフキゲン。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、胃の工合がわるいと云ったり、昨夜眠らなかったりでキゲンわるく、一時間おくれてスボートに行った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "目をさましてから雀ヶ岡へ行こうと思って来たのにと云い出しキゲンわるし。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで Post office へ行き　ベコアヤマル　キゲン　ナオセ　モスク※デ　オコルト　アタマニワルイ　と打ってやった電報を。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "フキゲンだし、しょげた手紙だ。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月六日　日　南京虫が出ないのでＹ、よく眠ったと見えて、丸い顔してキゲンよろしい。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ときいた時フキゲンそうに「知らない」と云ってたわけだ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紙の小さい表現、フキゲンの表現などにそれほど動かさるべきではないのだ。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "親父一杯キゲンで、いいよたべろと過度にさせるから。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、まちかねて居、殆ど不キゲン。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどくひどく不キゲンでその為に、私が涙を出した位であった。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕　Ｙ、キゲンよくなり、自分も楽しくよく仕事が出来るようになった。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな風に腹をたてると、たゞはキゲンを直してくれず、もう冬近いころだというのに風呂桶にマンマンと冷水をみたして、私にはいれ、というのであった。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫は幼年学校、陸士育ちの生粋の軍人であるから、敗戦にヤブレカブレ、グウタラ、不キゲン、毎日腹を立てゝいる。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "時にゴキゲンは相変らずで、実は小々本日は話の筋があつて」「もうダメだよ。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
