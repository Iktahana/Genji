        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "救助隊員たちは自らの危険を顧みず、二次災害の恐れがある崩落現場へと足を踏み入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「いやあ、あの時の彼女は本当に勇敢だった。自分の危険を顧みずに燃え盛る家から貴重品を持ち出したんだから。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "周囲の制止を振り切り、記者は危険を顧みず戦火の絶えない紛争地域へと取材に向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "一寸法師の話に出てくる鬼も一身の危険を顧みず、物詣での姫君に見とれていたらしい。",
              "citation": {
                "source": "桃太郎",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "第七九、英米の気風　英国人は堅牢を貴び、米国人は危険を顧みず。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "九条村では信者の親戚や知己の家を転々して隠れていたが、掠奪に来た荒木の兵士やそれに内応した村人たちに対し、危険を顧みず敢然としてフロイスを庇ったのは、その父がキリシタンであったという一人の異教徒であった。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
