          "literary": [
            {
              "text": "＊　　　　　　　　　　＊　　　　　　　　　　＊　陸軍竜騎兵中尉伯爵ポルジイ・キルヒネツゲルは実際邸へ帰った。",
              "citation": {
                "source": "世界漫遊",
                "author": "ダウィット　Jacob Julius David",
                "note": "青空文庫"
              }
            },
            {
              "text": "令嬢フィニイはキルヒネツグ領のキルヒネツゲル伯爵夫人になるのが本望である。",
              "citation": {
                "source": "世界漫遊",
                "author": "ダウィット　Jacob Julius David",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もこれに驚かされたのは、ストロオガツセなる伯爵キルヒネツゲル家の邸の人々である。",
              "citation": {
                "source": "世界漫遊",
                "author": "ダウィット　Jacob Julius David",
                "note": "青空文庫"
              }
            }
          ]
        }
