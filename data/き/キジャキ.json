          "literary": [
            {
              "text": "人間はよかったが品行はわるく、木崎の名を「キジャキ」と発音して、木崎を見る眼がいつも熱く燃えているので、木崎は辟易していた。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "忙しなく煙草の葉を揃える人の手元や、ジャキジャキと煙草の葉を刻んでいる職人の手許を夢中になって眺めていた。",
              "citation": {
                "source": "チンコッきり",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
