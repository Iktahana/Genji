[
  {
    "uuid": "d850df5d-c1ca-55c8-9d09-2c266abd414a",
    "entry": "切り花",
    "reading": {
      "primary": "きりばな",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
