[
  {
    "uuid": "927f55fd-b22b-53b8-9e0c-27d2814f16f5",
    "entry": "気任せ",
    "reading": {
      "primary": "きまかせ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
        "名詞"
      ],
      "ctype": null,
