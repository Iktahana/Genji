        "examples": {
          "standard": [
            {
              "text": "その検察官は謹厳実直な人格で知られ、誰からも尊敬を受けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼の謹厳実直な態度が、危機的状況を乗り越える力となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "学校の教頭は謹厳実直な人物で、生徒からも信頼されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "彼は謹厳実直の郷士で、一滴の酒も嗜むことなく夙に竜巻村小字界隈の風教改革運動に東奔西走して寧日もなき人であります。",
              "citation": {
                "source": "月あかり",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに謹厳実直な外見の下に、深い人間愛があったなんて、もっと驚くだろう。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "斎宮は十二年も江戸家老を勤続して、比較的には謹厳実直な人物であると信じられていた。",
              "citation": {
                "source": "思い違い物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄は堅物ですから、自分は謹厳実直だと思っています。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
