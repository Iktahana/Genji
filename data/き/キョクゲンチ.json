        "examples": {
          "standard": [
            {
              "text": "この工業機械の回転数の極限値は毎秒5000回転だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "圧力の極限値を超えると装置全体が破損する恐れがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "データ処理の極限値を計算してシステムを設計する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "しかしあらゆる可能な漫画家を一団として見る時には、各画家を微分とした無限項の和としての積分は渾然たる一つの定まった極限値を有する「真の」一面と考えるに不都合があるだろうか。",
              "citation": {
                "source": "漫画と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしともかくもこの曲線は下降し、そうして平均温度からの全偏差はますます減少し、数学者の言葉で言えば漸近的に極限値の零に接近してゆく。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
