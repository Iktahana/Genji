          "literary": [
            {
              "text": "但シ古銭ハ鑑識頗ル難キモノニテ、古鏡古銅器ヲ観ルノ眼ニテ之ヲ観レバ、必ズ贋品ヲ攫ムニ至ル。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ本国いぎりすノ国家ノ強ヒル宗教ヲ信ズルコトヲ肯ンゼザルナリ、制度ハ国ノ制度ヲ遵奉セザル可カラズトイヘドモ、信仰ハ自由也、国家ヨリ賦課セラルベキモノニアラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "僂麻質性モシクハ神経痛ノ如キモノニ変化シテイル證拠デアルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
