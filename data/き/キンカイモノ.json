        "examples": {
          "standard": [
            {
              "text": "市場の鮮魚コーナーに近海物が並んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "近海物の方が遠洋漁業の魚より新鮮だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "近海物は地元の食卓に欠かせない食材である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "素人ながらに、近海物と、そうでない魚とを見分けることの出来るお三輪は、今｜陸へ揚ったばかりのような黒く濃い斑紋のある鮎並、口の大きく鱗の細い鱸なぞを眺めるさえめずらしく思った。",
              "citation": {
                "source": "食堂",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "近海物の魚を積んで、船は躍るようにはいって来る。",
              "citation": {
                "source": "煩悩秘文書",
                "author": "林不忘",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
