          "literary": [
            {
              "text": "田楽が武家の愛護を受けてから、曲舞に近づいて行つたと同じく、猿楽も肝腎の狂言は客位に置く様になつて、能芸即神事舞踊に演劇要素を多くした。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして居並ぶ人々へ、いちいち名を問い、いちいち礼をほどこしてから、「いただきます」　と、静かに客位の席へついた。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
