    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしさつきもいひます通り、我軍と違つて実に可哀想だと思ひます。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがだん／＼嵩じて、のっ引ならなくなり、安宅先生は葛岡の勤めている学園などにはもう一ときもいられないと駄々を捏ねて、その駄々をまた本当のことに捏ね直す羽目になり、いよ／＼先生は来年の学課始めまでには学園の始末をつけて、どこか遠いところへ転任する相談が決まったらしい。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言った方が、響きもいいし、単的です。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしでさえ、ただ三｜秒ひらめくときも、半時空にかかるときもいつもおんなじよろこびです」　「けれども、あなたは、高く光のそらにかかります。",
              "citation": {
                "source": "めくらぶどうと虹",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてまた例の木の丸太を渡るのじゃが、さっきもいった通り草のなかに横倒れになっている木地がこうちょうど鱗のようで、譬にもよくいうが松の木は蝮に似ているで。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしさっきもいいます通り、我軍と違って実に可哀想だと思います。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "忘れはしない、ガ『アクーリナ』ちッとこれからは気をつけるがいいぜ、わるあがきもいい加減にして、おやじの言うこともちッとは聴くがいい。",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから書きもいたしませんでした。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その空に、その苑に、ほのの青みに静かなる欷歔泣きもいでつつ、いづくにか、さまだるる愛慕のなげき。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあれ、なほ薫りのこれる一列の紅き花罌粟かたかげの草に濡れつつ、うちしめり浮きもいでぬる。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆめ、にほひ、その吐息……彼はまた、怖々と、怖々と、……眩しげに頬をふくらませ蒸し淀む空気にぞ吹きもいでたる。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "とんだにょろにょろとした隠し男をおかわいがりでござりまするな」「ではもう……ではもう、なにもかも……」「聞きもいたしましたし、詳しく拝見もいたしましたゆえ、ここらが潮どきとおじゃまに出てきたんでござんす。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血の降るへや",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからこそ、さっきもいっそ駕籠かきどもを締めあげたほうが早くわかるだろうと、そちらのだんなにも思ったとおり申しあげたんですよ」「そのことば、うそじゃあるめえな」「いまさらうそなんぞいってなりますものか！",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "啖呵のききもいいが、よしっ引き受けたとなりゃ、人一倍たのもしいおいらなんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "どかっしゃい」「おじゃまなら、どきもいたしましょうが、これはいったいなんのまねでござる」「いらぬおせっかいじゃわい！",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　抜いたらば早く逃げればいゝのですが、大勢の中にはごろつきもいる。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さっきもいう通り、来年の三月には国へ帰って身請けの金を持って来る」「ほんとうざますか」「嘘はつかない」　次郎左衛門は息が詰まるほどに苦しくなった。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "おきん　さっきもいうたじゃないか。",
              "citation": {
                "source": "義民甚兵衛",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車が国府津へ着くと、小田原の町長を始め、講演会のきもいり達はそこのプラツトホームに仏手柑や馬鈴薯のやうな顔を並べて突立つてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟は水の邊に立ち、聲あげて泣きもいでしか。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、役人連中はそれでなくてさえ、やれ局長の肖像のための寄付だとか、やれ何とかいう本を、著者の友人である課長のきもいりで買わされるとかで、かなり多額の出費をしていたからである。",
              "citation": {
                "source": "外套",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は數學的認識の如きもいまだ十分な意味においては認識とはいひ得ぬとした。",
              "citation": {
                "source": "認識論",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と云って、ビールの栓を抜く手つきもいつもとは違い、争われぬなまめいた形になるのだった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "うむ、お前の唇付きもいい。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の如きもいひ過ぎ許りして居た様だ。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "めでたきもいみじきことも知りながら君とあらんと思ふ欲勝つ　斯うすれば富貴も得られ幸福も得られるといふ途を私はよく知つてゐる。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "棹ふれし筏は一瀬過ぎながらなほ影なびく山吹の花「棹ふれし筏」といふ言葉続きも「一瀬過ぎながら」の言葉続きもいと拙く覚え候。",
              "citation": {
                "source": "人々に答ふ",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなにお藤がさそっても、左膳は見向きもいたしません。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、さしずめ、うしろの柱時計でも見上げるところだが、享保の昔で、時計なんてものはないし、第一、そんな、郊外の文化住宅でサラリーマン夫人がハズバンドの帰りを待ってるような、そんな生易しい場面ではないのだから、お絃の顔つきもいささか緊張している。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅原商店の鶴峯という人のキモいりなり。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
