          "literary": [
            {
              "text": "その雪のようやく消えんとするころ、毎夜、屋後に拍子木をうつ音がするとの大評判になり、ここに来たり集まるもの、みなその声を聞いて恐れて帰り、これは狸の拍子木であるとの公評であった。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローマは宗教の大首府にして、諸国より高僧大徳の来たり集まる所なり。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代わりに、ランプのある所へは群蜂来たり集まる。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
