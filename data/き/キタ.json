  {
    "uuid": "4c83a52d-4eac-5856-8a57-463f8a929303",
    "entry": "キタ",
    "reading": {
      "primary": "きた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ガタ馬車キタキター、ノレノレ」と僕達は歌つてゐた。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、のぞみとあらば、来月あたり、君たちに向って何か言ってあげてもかまわないが、君たちは、キタナクテね。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで勝ったと思っているのだから、キタナクテね。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "七ジタツ」キタ　それだけでもう中畑さんには、なんの事やら、ちゃんとわかるのだそうである。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "急ニ書キタクナクナッタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日も四日も飯にありつけない、彼等のおふくろや、おやじや、妻が、キタならしいなりをして息子に面会を求めに来ても、門鑑はそれを拒絶した。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、何故か、不潔で、くさく、キタないように見えた。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お菜は、ふのような乾物類ばかりで、たまにあてがわれる肉類は、罐詰の肉ときている彼等は、不潔なキタない豚からまッさきにクン／＼した生肉の匂いと、味わいを想像した。",
              "citation": {
                "source": "前哨",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　病室には、汚れたキタならしい病衣の兵士たちが、窓の方に頭を向け、白い繃帯を巻いた四肢を毛布からはみ出して、ロシア兵が使っていた鉄のベッドに横たわっていた。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいつくらい他人のキタないところをいつもかつもさぐっている奴は少ないであろう。",
              "citation": {
                "source": "自画像",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分のキタないところはまるで棚にあげて人が集って話をして居っても、あんまり口を出さずに、じいっとうしろの方から、人のアラをさがして見て居るような奴だ。",
              "citation": {
                "source": "自画像",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくせ、人の醜悪面を見ては不公平だの、キタないのと云ってこぼして居るのだ。",
              "citation": {
                "source": "自画像",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツカレノ銀ヲクユラシテ、　　　モロ人谷ヲイデキタリ、ココニ二タビ口ソソギ、　　　　セナナル荷ヲバトトノヘヌ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "前者のキタナさ、「剃刀」の痲痺的痛覺。",
              "citation": {
                "source": "詩集『戰爭』",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいまもこのキタナさを愛してゐる。",
              "citation": {
                "source": "詩集『戰爭』",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "築山を繞つて覗かれる花畑にはヂキタリスの細い頸の花が夢の焔のやうに冷たくいく筋もゆらめいてゐた。",
              "citation": {
                "source": "汗",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ、ソノ　ハナシヲ　キイテ、スグニ、ウミ　ト　イウトコロ　ヘ　ユキタクテ　タマラナク　ナリマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "築山を繞って覗かれる花畑にはジキタリスの細い頸の花が夢の焔のように冷たくいく筋もゆらめいていた。",
              "citation": {
                "source": "汗",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨組太き童一人、身に着けたるものとては、薄き汗衫一枚、鞣革の袴一つなるが、その袴さへ、控鈕脱れて膝のあたりに垂れかゝりたるを、心ともせずや、「キタルラ」の絃、おもしろげに掻き鳴して坐したり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "想ふにあながち難からむとは思はれず、「キタルラ」一つだにあらましかば。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は姫の「キタルラ」を把りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は手をさし伸べて、壁上なる「キタルラ」を取りて我に授けつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "此煩惱の間、我は忽ち「キタルラ」の音の街上に起るを聞く。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "われは「キタルラ」の琴を抱きて人々に題を求めつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は傷ついた鳩のごとく、ややもすると狭心症の発作に悩まされがちなので、常住ポケットにジキタリスの小壜を用意することを忘れなかった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "微風ハキタル、足ノ指ノソノ間ヲ洩レテ君ガ眠リニ。",
              "citation": {
                "source": "疲レ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キタネエ」という評判は、死刑宣告だ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時点では、まだ長い修学旅行をしていて、たまたま旅館のおなじ部屋に、キタネエ野郎がいるだけだと思っていた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやなら、てめえのキタネエ指を、いま切り落としてやる！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
