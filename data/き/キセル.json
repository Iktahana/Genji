  {
    "uuid": "7bf8e04f-2261-56a4-8bea-e891dbdd00b3",
    "entry": "キセル",
    "reading": {
      "primary": "きせる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
