        "examples": {
          "standard": [
            {
              "text": "セントビンセント・グレナディーンの首都キングスタウンは、黒砂のビーチで有名だと旅行ガイドに書いてあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "キングスタウンの市場では色鮮やかなスパイスが山積みにされていて、強い香りが漂っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "フライトの乗り継ぎでキングスタウンに一泊し、港の夕景が印象に残った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "家畜の個体は毎週入れ替わっているようで、キングスタウンの農夫たちから新しい群れが納入された。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
