    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "此處はいゝ加減に切上げて丘の上の畑の中を歩いた。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人足の通った、ありそうな処だけで切上げたが可いでしょう――　それもそうか、いよいよ魔隠しに隠したものなら、山だか川だか、知れたものではない。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、其の勝敗を紀念として、一先づ、今度の蜜月の旅を切上げやう。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "テーブルスピーチのようなこともあっさり切上がり、内輪で寛いだ会に見えた。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは逸作の腕に支えられながら、弟の医者にちょっと脈を検められ、「生きの身の」と、歌の頭字の五文字を胸に思い泛べただけで急いで帰宅の俥に乗り込んだだけを記して、早くこの苦渋で憂鬱な場面の記述を切上げよう。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "池上は感心して、「君はよく、その程度で、切上げられるね。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔うためには違いございませんが、ときには気付け薬になったり、ときには滋養になったり、だから飲むに時と処は選みませんが、よいだけ酔って、これ以上、むだだと思ったらさっさと切上げます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは、この辺が切上げどきと思って、「いずれ、私たちもよく考えまして――」　と月並な挨拶をして葛岡と共に座を立ちました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "景子は切上げ時だと思って催促の眼ざしを宮坂の横顔に向けた。",
              "citation": {
                "source": "ガルスワーシーの家",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "早く話を切上げてそこヘ出かけなければならない。",
              "citation": {
                "source": "瘢痕",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "捲り手の肱を曲げて手首から、垂々と血が流れる拳を握って、眦の切上った鋭い目にはッたと敵を睨んだが、打仰ぐ空次第に高く、鷲は早や光のない星のようになって消えた。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ切上げてもいいんですの。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "言語道断、腕まくりで膝を立て、「借もんだからね、皺にしちゃあ動きが取れませんや、」と、切上った眦に筋を集めてニヤリと笑った。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥坐舗の長手の火鉢の傍に年配四十｜恰好の年増、些し痩肉で色が浅黒いが、小股の切上ッた、垢抜けのした、何処ともでんぼう肌の、萎れてもまだ見所のある花。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も空がすつかり切上つて夏の日が急に暑く照すやうに成つてからは女の座敷も障子が開けてあつた。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は伯父が早くこの話を切上げてくれるように、と念じながら、黙って火箸で灰に字を書いているより外はなかった。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "古今道徳の区別はこれで切上げておいて話は突然文芸の方へ移ります。",
              "citation": {
                "source": "文芸と道徳",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "但粘入半切上包半紙折懸上に名計。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ残り惜しいがもうこゝらで切上げようかと、水に入れてあるびくを引きあげると、ずっしりと重い。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜は金沢で泊ることにして、見物はまずいい加減に切上げて、鎌倉のお名残りに由比ヶ浜へ出て、貝をあさる女子供の群れをながめながら、稲村ヶ崎の茶屋に休んでいると、五十前後の男が牛を牽いて来た。",
              "citation": {
                "source": "恨みの蠑螺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "八　翌日岡田は会社を午で切上げて帰って来た。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十一　母が暴風雨に怖気がついて、早く立とうと云うのを機に、みんなここを切上げて一刻も早く帰る事にした。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "船が門司近くの海に来ると、書店の主人は今まで興じていた世間話を急に切上げにかかった。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりＡはそこで、久美子と子供達の写真を、何枚か撮っただけで、一先ず探険を切上げて来ればよかったのですが、そうしなかったのがＡの運の尽きでした。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘定口の側に、「二十九日仕事の切上げの予定のところ、今日になりました。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君なんかも早く切上げて了いたまえ」「君はそういうけれど、僕は外に仕方が無いし……生涯エジトルで暮すだろう……これも悪縁でサ」と言って、記者は赤皮の靴を鳴らして、風の寒いプラットフォムの上を歩いてみた。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、心配はしても、それほどとは考えていなかったろうサ」　好い加減にこういう話を切上げて、三吉はこの兄の直接関係したことを聞いてみようとした。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
