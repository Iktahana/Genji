        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子どもが切り紙で雪の結晶を作った",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "切り紙のワークショップに参加した",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女は切り紙の技術に長けている",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "あなたがあやつる人生切り紙細工は大｜南北のものの大芝居の如く血をしたたらせている。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの決まったところ、さっとつぶてをかわしたところ、きりっと体が締まったところ、おいたはおよしなさいませとおちついたところ、やっとう剣法、竹刀のけいこでたたきあげたにしても、まず切り紙以上、免許ちけえ腕まえだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "やまがら美人影絵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「数馬は切り紙でござりまする。",
              "citation": {
                "source": "三右衛門の罪",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「へえ、さようでごぜえます」「拙者はな、切り紙だ」「切り紙というとビリッ尻だね」「無礼なことをいうものではない」「さあそれじゃやりやしょう」　そこで二人はまた構えた。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "千葉道場の切り紙は、他の道場での目録に当たった。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "腕も確かに切り紙以上だろうが、それだけではない。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしか、小野派一刀流切り紙以上、なお、甲源流に少しいた、それに小太刀をよくするそうだ。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "民芸品の切り紙も人形も皆タマヨのあの魅力的な紫色や桃色なのでした。",
              "citation": {
                "source": "民芸品の部屋で",
                "author": "我々はメキシコ美術をこうみる",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供は前もって夫婦の寝室へつれてゆかれていて、白い壁の上に、復活祭の飾りか、誕生日祝の飾りか、赤と緑の紙で大きいトロイカの切り紙細工がのこされていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その黒いふたの上に、赤い切り紙でつくられているВ・В・マヤコフスキーという詩人の名の、二つの頭字が、はっきりさかさに映っていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしか、小野派一刀流切り紙以上、なお、甲源流に少し居た、それに小太刀をよくするそうだ。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若者は組み伏せられたまま左の腕を口にあてがって思いきりかみしばりながら泣き沈んだ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピンヘッドとかサンライズとか、その後にはまたサンライトというような香料入りの両切紙巻が流行し出して今のバットやチェリーの先駆者となった。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "マヴラが出て行くと、プリューシキンは安楽椅子に腰をおろしてペンを取ったが、それから長いこと礼の四つ切紙をあちこちひねくりまわしながら、何とかしてそれを八つ切にする工風はないかと骨折ってみた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "監督の実際は、会社の方針、検閲制度、経済的制御、機械的不備、スターの精神異常、こういつた種類のこわい鬼どもの昼寝のすきをねらつてささやかなる切紙細工をして遊んでいる子供にも似たはかない存在である。",
              "citation": {
                "source": "雑文的雑文",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに不幸にしていつたん作品ができあがつて世に現われるやいなや、この切紙細工のぼつちやんは突然防弾衣のごとく雨と降りくる攻撃の矢面に立たされる。",
              "citation": {
                "source": "雑文的雑文",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ははあこの隙は誘いだな」切紙の白井とは少し違う。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海添ひの家の屋根が、白と黒との切紙細工のやうなのも、富岡には珍しい眺めだつた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "課長は大湯呑を左手に移し、右手の太い指を延ばして帳簿の天頂から長くはみ出している仕切紙をたよりにして帳簿のまん中ほどをぽんと開いた。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは彼が忠実に未決書類函へ手を延ばし、黒表紙の引継簿の仕切紙の挟まっているところを開いて読んだときに、そうなったからである。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどく面白い切紙細工をのこして死にました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "モーニング姿の新郎と白紗を頭からまとった新婦とが相並んでるのへ、四方からテープや切紙を投げかける賑かな室の中で、闖入者たる芝原氏へにこやかな目礼をなす人が多数である。",
              "citation": {
                "source": "中支生活者",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "室の床には、水瓜の種の皮や、向日葵の種の皮や、落花生の皮や、梅の実の種や、鶏の骨などが、あたりに散らばり、また誰かが結婚式の残りのものを持って来たと見えまして、五色の切紙やテープが散乱していました。",
              "citation": {
                "source": "画舫",
                "author": "――近代伝説――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに切紙細工の黒｜蝙蝠が一匹うれしそうに貼りついていた。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、この男は、別段に師匠の手から切紙、目録、免許といったような印を与えられてはいない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆伝になったのではないので、翌々年すなわち長享三年の三月、宗祇はさらに『古今集序』聞書ならびに三ヶ事のうち切紙一、題歌事切紙一、以上を、実隆の邸に持参して、口伝いろいろ仔細があったと、実隆はその日記に載せている。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "はたして宗祇はその歿する前年すなわち文亀元年の九月に『古今集聞書』切紙以下相伝の儀ことごとく凾に納め封を施して実隆のもとへ送り届けた。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ此の病院生活の後半期は病状が割に平静を保持し、精神は分裂しながらも手は曾て油絵具で成し遂げ得なかったものを切紙によって楽しく成就したかの観がある。",
              "citation": {
                "source": "智恵子の半生",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "百を以て数える枚数の彼女の作った切紙絵は、まったく彼女のゆたかな詩であり、生活記録であり、たのしい造型であり、色階和音であり、ユウモアであり、また微妙な愛憐の情の訴でもある。",
              "citation": {
                "source": "智恵子の半生",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "看護婦さんのいふところによると、風邪をひいたり、熱を出したりした時以外は、毎日「仕事」をするのだといつて、朝からしきりと切紙細工をやつてゐたらしい。",
              "citation": {
                "source": "智恵子の紙絵",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
