          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "床に切り髪が散らばっている",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "散髪後に切り髪を掃除した",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "美容室の床には毎日たくさん切り髪が落ちている",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "同時に、本花道からしずかにあゆみ出た切り髪の女は太宰の後室定高で、眼の大きい、顔の輪郭のはっきりして、一種の気品をそなえた男まさりの女、それは市川｜団十郎である。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、伯母は切り髪頭の、長い凋びた顔を顰めながら言った。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "下町育ちらしい束髪の細君が、胸を披けて萎びた乳房を三つばかりの女の子に啣ませている傍に、切り髪の姑や大きい方の子供などもいた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "切り髪にした女隠居が一人、嫁入り前の娘が一人、そのまた娘の弟が一人、――あとは女中のいるばかりである。",
              "citation": {
                "source": "春の夜",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪を上品な切り髪にしている。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ようやくわかった切り髪の女「旦那お家でござんすかえ」　ご用聞きの松五郎が、こういいながら訪ねて来たのは、その同じ日の午後のことであった。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "切り髪女の目星がね」「ほほう、そいつは耳よりだな」平八の顔は輝いた。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「阪東米八といいますので」「そいつが切り髪の女なのか？",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "滅法仇っぽい美い女で、阪東しゅうかの弟子だそうです」「鬘を着けていたひにゃア、切り髪なんかわかるまいに、どうしてお前は探ったな？",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……最初に鼓を聞いたのは、今年の春の雪の夜で、そうしてその場に落ちていたのは、鬘下地の切り髪であった。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、切り髪と鼓とは、深い関係がなければならない。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「うん、訊きたいことがある」「へい、やっぱり切り髪女の？",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしだって、泣きたくなるよ」　と、どうやら急に、色っぽい口調……丹波が闇を透してのぞくと、お蓮様は顔をしかめて、切り髪の根に櫛を入れて、きゅっと掻いている。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "切り髪のお蓮様は、いたくやつれているように見えるものの、その美しさはいっそうの輝きを添えて、見る人の心に、いい知れぬ憐れみの情を喚び起こさずにはおかないのでした。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "つややかな切り髪であった。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムロというのは禿だから、頭を小さめにした毛髪の短い子供、切り髪にした童子にほかならない。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "若者は組み伏せられたまま左の腕を口にあてがって思いきりかみしばりながら泣き沈んだ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "色紙、短冊でも並びそうな、おさらいや場末の寄席気分とは、さすが品の違った座をすすめてくれたが、裾模様、背広連が、多くその席を占めて、切髪の後室も二人ばかり、白襟で控えて、金泥、銀地の舞扇まで開いている。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「とかく、その年効いもなく、旅籠屋の式台口から、何んと、事も慇懃に出迎えた、家の隠居らしい切髪の婆様をじろりと見て、（ヤヤ、難有い、仏壇の中に美婦が見えるわ、簀の子の天井から落ち度い。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の長い切髪の、いつ納めたか、元結を掛けて黒い水引でしめたのが落ちていた。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒き毛、白髪の塵ばかりをも交えぬを、切髪にプツリと下げた、色の白い、艶のある、細面の頤尖って、鼻筋の衝と通った、どこかに気高い処のある、年紀は誰が目も同一……である。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、切髪の白髪になって、犬のごとく踞ったが、柄杓の柄に、痩せがれた手をしかとかけていた。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と念を入れて喋舌れば顔も動くし、白い切髪も動いたのである。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と取って返す辻の角、茶綾子の被布を召したる切髪の気高き老婦人、腕車の傍に彳みたるが、「三吉々々。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "額から下は赭っと柿ばんでいて、それがテッキリ、嬰児の皮膚を見るようであるが、額から上は、切髪の生え際だけが、微かに薄映み――その奥には、白髪が硫黄の海のように波打っていた。",
              "citation": {
                "source": "絶景万国博覧会",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "法水は庵主盤得尼の切髪を見て、この教団が有髪の尼僧団なのを知った。",
              "citation": {
                "source": "夢殿殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを耳にもかけないような風で、娘はその切髪を持ったままで何処へか行ってしまいました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "雷獣と蛇",
                "note": "青空文庫"
              }
            },
            {
              "text": "又あの切髪は誰のだろうと云ったが、それも判らない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "雷獣と蛇",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分そこらの溝へでも這入ってしまったか、空屋敷の庭へでも這い込んだろうということになって、見物人は次第に散ってしまったのですが、なにしろ、それが蛇と小娘と切髪と、不思議な三題｜噺が出来あがっているので、その晩のうちにその噂が新宿から青山の方まで一面にひろまってしまいました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "雷獣と蛇",
                "note": "青空文庫"
              }
            },
            {
              "text": "その娘とその切髪とどういう因縁があるのだろう』　こうした噂が繰り返されて、それに又いろいろの想像説も加わって、見て来たような作り話を吹聴する者もある。",
              "citation": {
                "source": "半七捕物帳",
                "author": "雷獣と蛇",
                "note": "青空文庫"
              }
            }
          ]
        }
