  {
    "uuid": "040f262d-5d0c-5299-a6a6-5204ab4fbdb3",
    "entry": "キソ",
    "reading": {
      "primary": "きそ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
