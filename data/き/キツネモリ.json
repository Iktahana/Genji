        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "早く妻子に死別れて獨身生活をして居た自分の伯父の一人が、窮迫の餘り人と共に何か法網に觸るる事を仕出來したとかで、狐森一番戸に轉宅した。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "（註、狐森一番戸は乃ち盛岡監獄署なり。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "早く妻子に死別れて独身生活をして居た自分の伯父の一人が、窮迫の余り人と共に何か法網に触るる事を仕出来したとかで、狐森一番戸に転宅した。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し又暇をえて狐森の煉瓦塀内に客とならば、その陰暗たる方三尺の監房にも心雲悠々たる閑天地を発見するに難からじ。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
