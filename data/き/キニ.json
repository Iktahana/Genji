        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ニョキニョキと人々は立ち上った。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく彼はチューリヒのポリテキニクムへ入学して数学と物理学を修める目的でスイスへやって来た。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでチューリヒのポリテキニクムの師範科のような部門へ入学して十七歳から二十一歳まで勉強した。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九一一年にはプラーグの正教授に招聘され、一九一二年に再びチューリヒのポリテキニクムの教授となった。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "知ルヤ、君、断食ノ苦シキトキニハ、カノ偽善者ノ如ク悲シキ面容ヲスナ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "青キ朝日ハコノトキニ、　　　　ケブリヲノボリユラメケバ、樹ハサウサウト燃エイデテ、　　カナシキマデニヒカリタツ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カクテアシタハヒルトナリ、　　水音イヨヨシゲクシテ、　鳥トキドキニ群レタレド、　　　ヒトノケハヒハナカリケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤や黄のオードコロンやオードキニン。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビキニ島でアメリカが行なった水爆実験で、第五福竜丸が死の灰を浴びたのが前年。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "トキニ出立は明日になッた……」「あした！",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "トキニ何は、内海は居ますか」「ハア居ますヨ」「それじゃちょいと逢て来てからそれからこの間の復讐だ、覚悟をしてお置きなさい」「返討じゃアないかネ」「違いない」　ト何か判らぬ事を言ッて、中背の男は二階へ上ッてしまッた。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トキニ内海はどうも飛だ事で、実に気の毒な、今も往て慰めて来たが塞切ッている」「放擲てお置きなさいヨ。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "君だから何だけれども、僕なら直ぐブン打ッてしまう」　文三は黙してしまッてもはや弁駁をしなかッたが、暫らくして、「トキニ君は、何だと云ッて此方の方へ来たのだ」　山口は俄かに何か思い出したような面相をして、「アそうだッけ……一番町に親類が有るから、この勢でこれから其処へ往ッて金を借りて来ようと云うのだ。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トキニ些し貴嬢に御相談が有る。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがビキニの下だとしたら、かなり大胆な部類に入るほど、わずかな面積しかない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルはキニーネを必要とし、ロイドは腹をこわし、私は瀟洒たる小喀血。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　タウトウ　イチバン　イタダキニ　ヰタ　ツボミガ　オメメヲ　ヒライテ　花ニ　ナリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドレ　ドコニ」「ソラ、ソラ、ソコニ」　ナルホド、ミルト　ナタネノ　ミキニ　マダ　ヒラカナイ　ツボミガ　ヒトツ　ノコツテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ケレド、ヨク　ミルト、ソノ　サルハ　ビヨウキニ　カヽツテ　ウゴケナク　ナツテ　ヰマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ア、カアチヤン、ハツパノ　サキニ　タマガ　ヒカツテル」「ソレハ　アサツユツテ　モノ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリアゲテ　ヰタ　イシコロヲ、ポーント　ムカウノ　キニ　ナゲツケテ、マタ　コヒツジヲ　フトコロニ　イレ、スイタ　オナカヲ　オサヘナガラ　一ツノ　ムラヘ　ヤツテ　キマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ヲトコハ　ウチヨウテンニ　ナツテ　ヰマシタノデ　ソンナ　コトハ　キニモ　カケナイデ、イサマシク　ラツパヲ　フキナラシナガラ　マタ　アルイテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンノキノ　シタデ　オカアサンノ　タヌキガ　コドモノ　タヌキニ　バケル　コトヲ　ヲシヘテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ネンネン　ヨヲヲヲ　ネンネン　ヨウ」　シカシ、アカンボウヨリ　サキニ、コモリノ　ハウガ　ウツラ　ウツラ　ネムリハジメマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、特異性のある人間だと、中毒量はるか以下のストリキニーネでも、屈筋震顫症や間歇強直症に類似した症状を起す場合がある。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりその一句と云うのが、『｜ルクレチア盗み』という沙翁の劇詩の中にあって、羅馬の佳人ルクレチアがタルキニウスのために辱しめをうけ、自殺を決意する場面に現われているからなんだ」と法水はこころもち臆したような顔色になったが、その口の下から、眉を上げ毅然と云い放ったものがあった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストリキニーネさえ混ぜれば、呪文でも人間を殺せる――と云ったのは」　寂蓮尼は顔一杯に凄愴な隈を作って、憎々し気に法水を凝視めていたが、やがて、襖を荒々しくたて切って、室を出てしまった。",
              "citation": {
                "source": "夢殿殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "加之、甚シキニ至リテハ、其事ノ故誤ヲ問ハズ、其ノ理ノ当否ヲ顧ミズ、復讐ノ名義ヲ挟ミ、濫リニ相構害スルノ弊往往有之、甚ダ以テ相不済事ニ候。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ安寧秩序ヲ保持スルコトガ國家ノ唯一任務ナリトセバ、國民ノ死活榮辱ヲ日夜ニ亘リ終生ヲ通ジテ脅威シツツアル此等ヲ處分セズシテハ國家ナキニ同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
