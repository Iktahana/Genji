  {
    "uuid": "d5644f18-0004-55ef-9428-721fb23c09c4",
    "entry": "キントト",
    "reading": {
      "primary": "きんとと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
