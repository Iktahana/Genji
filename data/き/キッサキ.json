      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "point (of a sword, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "居合の達人が刀を抜くと、切っ先が月の光を鋭く反射した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "鉛筆の切っ先が丸くなってしまったので、削り直す必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古い万年筆の切っ先は、使い込むほどに書きやすくなるという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "槍の切っ先を相手に向け、隙を見せない構えを取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "用心深い半七は彼が必死の切っ先に空を突かせて、刃物を十手でたたき落した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "甘蔗のひと節を短刀のごとく握り持ってその切っ先からかじりついてかみしめると少し青臭い甘い汁が舌にあふれた。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは確かにそれを切るという気でもなく、ただ無暗に振りまわした切っ先があたかもそれに触れたのかも知れない。",
              "citation": {
                "source": "馬妖記",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいて上がろうとした一人も、手鳶を柄から斜めに切られて、余った切っ先きで小手を傷つけられた。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "小坂部の懐剣は彼の額を斜に突き破って、その切っ先が烏帽子の懸け緒を切り払ったのであった。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも弥兵衛が固く捉えて放さないので采女は焦れて差添えをぬいて邪魔する彼の喉を突こうとしたが、相手が早くも頸を替わしたので、その切っ先は土に深く縫い込まれてしまった。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いざ、介錯下されい、御配慮によって、万事心残りなく取り置きました」といいながら、左の腹に静かに匕首の切っ先を含ませた。",
              "citation": {
                "source": "恩を返す話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "出刃の切っ先に切られていく骨の一つも、筋の一つも、肉の間に網のごとく走っている白い奇怪な線条も、白く浮き上っている脂肪も、びろびろと胸郭いっぱいに気味悪く広がっている肺も、左肺の下から覗いている真っ赤な桃の実のごとき心の臓も、ターヘルアナトミアの絵図と、一分一点の違いもなかった。",
              "citation": {
                "source": "蘭学事始",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "刀の切っ先のようである。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "――小柄の切っ先で食いしばっていた歯を、ぐいとこじあけてみると、血だ！",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに、相手の突かれるくまのほうは、悲しいことに檻の中という不自由な場所にいたものでしたから、身をかわすべきすべもなく、哀れ三突きめの鋭い切っ先にぐさりとその脾腹をやられて、うおうと一声、けもののような人間のようなわけのわからないうめき声を発しながら、あけに染まってのけぞりました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "耳のない浪人",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は再び恋のかたきを蹴倒して、腰に佩いている衛府の太刀に手をかけたかと思うと、闇にきらめいた切っ先は兼輔の烏帽子をはたと打ち落として、その小鬢を斜めにかすった。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "止どめの切っ先　最後の勇気を腕へこめ、広太郎刀を一振りした。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルブルブルブルふるえる切っ先、大波を打つ背のうねり、その上を火光と月光と、ボ――ッと淡く照らしている。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "片足あげて横顔を踏み、抜き身の切っ先ユルユルとおろし、耳のつけ根をぶッつりと！",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢中で力一ぱい突き立てた刀の切っ先は、ほんとうに彼の脇腹を深く貫いたのであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "勘平の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚太郎はパッと転がった、切っ先届かず五分残ったのは甚太郎にとっては天祐でもあろうか、引く太刀に連れて飛び上り二の太刀を避けて横へ飛んだ。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と刀が鞘走り、その切っ先から鍔際まであたかも氷の棒かのように、月の光に白み渡ったが、「行者！",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "卜伝は切っ先へ眼を付けた。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "構えた木刀の切っ先から、卜伝は向こうを隙かして見た。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "では、一つ関東風の、鋭い切っ先きというものを、今夜は充分に賞翫して見ようか？",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "切っ先きを突きつけたら、何でもない――その寮というのは、廻船問屋の別荘で、大川端、浜町河岸の淋しいあたり――一方は川浪、三方は広やかな庭――丸木屋とは、長崎以来の、これも、深い因縁の仲だ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "平馬の切っ先きが、案の定、動揺した。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "油断していた多四郎の腕へ切っ先鋭くはいったが冬の事で着物が厚く裏掻くことはなかったものの、多四郎の周章てたことは云うまでもない。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、切っ先から柄頭まで、ベッタリ血汐で濡れていた。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "グイと切っ先を眼前へ引き寄せ、一寸一寸送り込み、じいいっと刃並みを覗いて見た。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それとても一瞬で、刀身はまたもや白く輝き、柄で蔽われていた茅野雄の額の、陰影さえ消えて炬のような眼が、眼前数間の彼方に群立ち、刀の切っ先を此方へ差し向け、隙があったら一斉に寄せて、打って取ろうとひしめいている、七人の敵を睨んでいた。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、その刀と向かい合って、一本の刀が茅野雄の眉間へ、切っ先を向けて宙へ浮かんだ。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）労働者農民及び多くの、所謂敵国に向って銃剣を取っていた××を××し、その銃剣のきっさきを、×××、××××××に向けさせる――そういうことを文学の持つありったけの宣伝、××をつくしてその影響を確保拡大することが必要である。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すでに過日も、現に今日の午後にも、礼之進が推参に及んだ、というきっさきなり、何となく、この縁、纏まりそうで、一方ならず気に懸る。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "pointed verbal attack",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
