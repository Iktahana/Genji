[
  {
    "uuid": "f8131751-ad0e-58fa-9e9c-eacd33433e96",
    "entry": "切っ先",
    "reading": {
      "primary": "きっさき",
      "alternatives": [
        "ほう"
      ],
      "is_heteronym": true
    },
    "grammar": {
      "pos": [
