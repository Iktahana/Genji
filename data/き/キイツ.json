      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "united into one",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "諸説紛々としていた議論も、最終的には「ユーザーの利便性向上」という一点に帰一した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "万法帰一の理を悟るべく、彼は俗世を離れて山中での修行に身を投じている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "どんなに複雑なプロットの物語であっても、結局は愛という普遍的なテーマに帰一するものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "如何に踏み迷っても、ひとたび国難到来すれば、雛の親鳥の周囲に馳せ集うが如く、一切を捨てて皇室に帰一し奉る。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "近ごろ帰一協会などでは、それを子供のために悪いと言って気づかっている。",
              "citation": {
                "source": "寒山拾得縁起",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "｜順逆無二門五十五年夢｜大道徹心源｜覚来帰一心　多分後世の仮作であろうが、光秀も死ぬまで順逆を気にしていただろう。",
              "citation": {
                "source": "山崎合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "抽斎は終に儒、道、釈の三教の帰一に到着した。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "上の三教帰一の教は即ちこれである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "プランタンの出来るときは友人の石川伊十君や岡本帰一君などと手つだいに行ったりしたのを覚えている。",
              "citation": {
                "source": "新古細句銀座通",
                "author": "岸田劉生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「しかし、神に帰一する希いはカソリックだって同じだよ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂｜ＮＡＲＺＩＳＳＭＵＳ（自己恋着）はこれにして、筆者の所謂積極消極両様の変態恋愛の交叉帰一点そのものの発露と見るを得べし。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "万法帰一から脱体したものであらうが唯恐れ入る外はない。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲遊ぶ空と小島のある海と二つに分けて見るべくもなし　秋の空が海に映り、海の青が空に映る瀬戸内の風光を、空には雲を遊ばせ、海には島を浮せ各その所を得しめた儘、之を併せて帰一させ、二にして一の実相として彷彿させる大手腕の歌だ。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し私も次第に年をとり、何時までもコンな事に勉強するでもなし、老余は成る丈け閑静に日を送る積りで、新聞紙の事も若い者に譲り渡して段々遠くなって、紙上の論説なども石河幹明、北川礼弼、堀江帰一などが専ら執筆して、私は時々立案してその出来た文章を見て一寸々々加筆する位にして居ます。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうなかごろから倉持と鎌子夫人の名は預けおかれて、高遠な芸術と理想論とになってしまったが、つまりいつも男性はあらゆる複雑さを通り越して、単純に帰一させようとする純粋性というものにむかって突進むが、女性はある事に触れるたびにその環境に動かされやすく、感情に殉じやすいのは当然である。",
              "citation": {
                "source": "芳川鎌子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうした用途に用ゐられた鳥は、恐らく、色々の種類を含んで居たものと思はれるが、其が白鳥の白鳥たる鵠に帰一したものと考へるのが順当らしい。",
              "citation": {
                "source": "鷹狩りと操り芝居と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうした女性の常の挙措であり、全部の表情が、完全に歌舞妓の女に帰一して来ることが、彼の舞台で気づかせられたものである。",
              "citation": {
                "source": "街衢の戦死者",
                "author": "――中村魁車を誄す――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その結果内乱は終息し、日本の国家は平和となり、上下合一、官民一致、天皇帰一、八｜紘一｜宇、新時代が生れるのだ」21　安房守はじっと耳を澄ました。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し、此とて、元々別々のものが帰一せられたものではなく、同根の分派が再び習合せられたものと見るのが、当を得てゐるであらう。",
              "citation": {
                "source": "琉球の宗教",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "社会共同態の観念もわれと汝と彼とをひとつの全体として、生を与うる絶対に帰一せしむる基礎なくしては支えがたい。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "欠陥ある個人意識が独立自全なる真生命に帰一せんがために、おのれに対立する他我を呼び求むる心である。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲愴な覚悟というものは、たとえば味覚に端を発していながらも、結局は特攻隊と同じような、支離滅裂な亢奮と絶望に帰一するものらしい。",
              "citation": {
                "source": "遺恨",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し、此は唯の伝説で、こんなに帰一せない以前には、口授をはじめた神が沢山あつたに違ひない。",
              "citation": {
                "source": "国文学の発生（第二稿）",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして、仮りに様々な「し何」の形を綜合すると、「しもの」と言ふ形に帰一するのは明らかだ。",
              "citation": {
                "source": "形容詞の論",
                "author": "――語尾「し」の発生――",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代の邑落生活様式の、宮廷に帰一せられて来るのは、普通だが、必しもすべてが同じだとは言へない。",
              "citation": {
                "source": "日本文学の発生",
                "author": "――その基礎論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝには、新しい協力の姿があり、帰一の道がある。",
              "citation": {
                "source": "「詩歌の午後」について",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「天皇に帰一し奉れ」という湊君の説、「生きぬいて作家として新しき日本を作る基礎をつくれ」という間宮君の説、いずれもまじめで真剣。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇帰一、「我」を捨て心身を放棄してこそ、日本人の道。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が無言で涙組んで居るのを見ると、私には言葉には云えないでも彼の心はすっかり感じられる様になって二つの感傷的な心は、非常な調和と帰一を見出し得て居た。",
              "citation": {
                "source": "追憶",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "暦法を異にした古代の村々が、段々帰一して来る間に、其々の暦に絡んだ風習が、互にこんがらかつて来て、極めて複雑な民間年中行事をつくる様になつた。",
              "citation": {
                "source": "古代生活の研究",
                "author": "常世の国",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰一と同時に開展する。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この場合、万法帰一をいくら振り廻してもよい。",
              "citation": {
                "source": "陶磁印六顆を紹介する",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうなってはじめて万法帰一が腑に落ちるではないか。",
              "citation": {
                "source": "良寛の書",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
