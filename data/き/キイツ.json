[
  {
    "uuid": "1b1f3913-37a1-5133-9044-3e7b86d6de2c",
    "entry": "帰一",
    "reading": {
      "primary": "きいつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
