        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "生活費を切り詰めて、毎月少しずつ旅行のための貯金をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "電気代を切り詰めるために、使わない部屋の照明をこまめに消すようにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "旅費を切り詰めるため、新幹線ではなく夜行バスを予約した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
