        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "代助はルキイルは殆んど見えなかつた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助はヴァルキイルを雲に見立てた積りでこの図を注文したのである。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅子と共に部屋を出た時は、このヴァルキイルは殆んど見えなかった。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "事によったら例のファキイルと云う奴がアルラア・アルラアを唱えて、頭を掉っているうちに、覿面に神を見るように、神経に刺戟を加えて行って、一時幻視幻聴を起すに至るのではあるまいか。",
              "citation": {
                "source": "百物語",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬中ファキイル僧のように仮死の状態にあったそこらの木々の瘠せかじけた黒い枝には、また生命が甦って、新しい芽を吹き出しているではないか。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度のフアキイル僧のやうに死真似のうまいこの虫は、このごろ人間の社会に心中沙汰が多いのを聞き伝へて、人間がしていいことが、虫にとつてして悪からうはずがないと、もの好きにもわざわざそれを真似て見せたものらしかつた。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日の夜、コラムの部屋にオランとキイルが来た。",
              "citation": {
                "source": "魚と蠅の祝日",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "女のように物やさしいキイルが呼んだ。",
              "citation": {
                "source": "魚と蠅の祝日",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "キイルは言葉を添えた「父よ、父よ、あわれんで下さい、私たちは饑えかわくようにあなたのお顔を見たがっております。",
              "citation": {
                "source": "魚と蠅の祝日",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前はこれをどう思う、兄弟オラン、兄弟キイル」ながい断食と身の疲れのために枯れがれになった低い声で訊いた。",
              "citation": {
                "source": "魚と蠅の祝日",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "「天の御使でしょう」キイルが言った。",
              "citation": {
                "source": "魚と蠅の祝日",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "オランは惶れの低い声で言った「おお、神よ」　キイルはおそろしさに蒼じろくなって言った「おお、神よ、神よ」　しかしコラムは立ち上がって壁にかけてあった笞をとった。",
              "citation": {
                "source": "魚と蠅の祝日",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オランよ、平和のために、キイルよ、平和のために」　そう言ってコラムはキイルとオランのうな垂れた背に強く笞をあてた、三日間の断食もコラムの強い腕にやどる深い信仰を弱めはしなかった、それは神のみさかえの為とコラムは思った。",
              "citation": {
                "source": "魚と蠅の祝日",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アーメン」キイルが言った。",
              "citation": {
                "source": "魚と蠅の祝日",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただオランとキイルの二人は海の深みの魚を呪い、空気の深みに飛ぶ虫どもを呪った。",
              "citation": {
                "source": "魚と蠅の祝日",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "「父と子と聖霊の御名によって」弟子たちすべてがかしこみうな垂れて叫んだ、中にもオランとキイルは深く感じていた、コラムの部屋で見たかの蠅が総大将であるが如く虫の全軍をひきいて不思議な美しい歌をうたっていたから。",
              "citation": {
                "source": "魚と蠅の祝日",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "オランとキイルはこの話をした、みんなは驚きと畏れにみたされた、コラムは神をほめ讃えた。",
              "citation": {
                "source": "魚と蠅の祝日",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
