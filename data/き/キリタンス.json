        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（あの小刀は、家の桐箪笥に入れてあった筈じゃが……？",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ちょっと、待って」　マンは、奥に入ると、桐箪笥を探って、巾着を取りだした。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "桐箪笥から、数枚の着物、肌襦袢、腰巻の類をとりだして、風呂敷に包んだ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "今も小木町には幾軒かの箱屋があって、大きな鉄金具を打った桐箪笥を作ります。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや無邪気といえば、子供ばかりではなく、露八自身も涎を垂らして、時々｜桐箪笥に背中を辷らせては、吃驚したように、渋い眼をしばだたく。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "道頓堀川を隔てて、芝居茶屋のお内緒の桐箪笥や、赤い座ぶとんや、長火鉢がのぞかれる。",
              "citation": {
                "source": "治郎吉格子",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは茶の間と次の間に据えてある桐箪笥やら用箪笥に艶布巾をかけることだった。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
