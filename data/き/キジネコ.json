        "examples": {
          "standard": [
            {
              "text": "捨て猫の保護シェルターには、いろんな柄のキジ猫がいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "友達の家で生まれた子猫は、みんな元気なキジ猫だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このキジ猫は、しっぽの先がカギ型で珍しいね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "庭に迷ひこんで来たキジ猫を「キシロ」といひ、赤猫は「アカ」で、白猫は「マシロ」、赤猫の子どもを「コアカ」といふやうに。",
              "citation": {
                "source": "仔猫の「トラ」",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この地方では金沢猫とも呼ぶ、一種のキジ猫であった。",
              "citation": {
                "source": "猫料理",
                "author": "村松梢風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
