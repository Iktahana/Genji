          "standard": [
            {
              "text": "相場操縦は違法であり、金融操作に該当する行為は厳しく罰せられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "当局は市場での不正な金融操作を摘発するために監視を強化した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その投資ファンドは金融操作の疑いで調査を受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "この藩に限らず、当時は諸侯ぜんたいが経済的に逼迫していたのであるが、ここでは計画がゆき当りばったりで、生産の裏付けのない金融操作にはしったため、その状態はしだいに破局的なものになっていった。",
              "citation": {
                "source": "初夜",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
