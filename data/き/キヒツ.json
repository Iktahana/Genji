  {
    "uuid": "6285f73f-e669-5402-921d-94c57e2f664e",
    "entry": "木櫃",
    "reading": {
      "primary": "きひつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
