        "examples": {
          "standard": [
            {
              "text": "新規事業を立ち上げるために、十分なキャピタルが必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "会社の成長には、潤沢なキャピタルが不可欠である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は自己資金だけでなく、外部からのキャピタルも活用して投資を行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "付け加えると、現時点での負債の総額が、確認できる限りでは八八ポンド一〇シリング、一方でキャピタル＆カウンティーズ銀行の預金残高は二二〇ポンドある。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            }
          ]
