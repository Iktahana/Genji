          "literary": [
            {
              "text": "著作権の保護期間満了を、単なる終わりにとどめてはつまらない。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "向こう六ヶ月間は土地を抵当に一銭も融資されないし、先々代の遺言期間満了まで借金できないが、期間満了時には、たとえ先代の息子が現れても法的に全て相続できる。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "但し、衆議院解散の場合には、その期間満了前に終了する。",
              "citation": {
                "source": "日本国憲法",
                "author": "施行、昭和二二年・五・三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
