    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……売台の上に滑稽な下着だけで、両足をブラリとさせて、黙りこんでしまってキョロンと坐ったヴィンセントの寂しい姿。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（死ぬといわれて、キョロンとして）死ぬ？",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男はキョロンとして御橋を見ている）……フフ、いいかげんにした方がよかろうぜ君も。",
              "citation": {
                "source": "夜の道づれ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔はと云うと、皺だらけの渋紙色の中に、お玉じゃくしの恰好をした、キョロンとした目が飛出し、唇が当り前でないと見えて、長い黄色い乱杭歯が、いつでも現われている。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、品川の方では、やっぱりキョロンとして、解せぬ顔をしている。",
              "citation": {
                "source": "猟奇の果",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
