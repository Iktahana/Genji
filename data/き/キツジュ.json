        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "神奈川縣橘樹郡旭村大字駒岡村瓢簟山の東面部に其怪窟はある。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "お穴樣の探檢",
                "note": "青空文庫"
              }
            },
            {
              "text": "小机源八郎は、武州｜橘樹郡小机村の郷士の子で、子供の時に眼を患ったのを、廻国の六十六部が祈祷して、薬師の水というのを付けてくれた。",
              "citation": {
                "source": "怪異暗闇祭",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "場所は何處だと聞くと、神奈川縣、橘樹郡、北加瀬村の貝塚。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "疑問の加瀬貝塚",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大發掘はせぬが）　電車が神奈川に初めて通じた時に、其沿道低地に、貝塚を發見したといふ人の説を聞き、實地に就てチヨイ／＼發掘して見て、破片の香もせなんだ例を考へ、又橘樹郡樽の貝塚は、可成り大きいけれど、僅かに一｜小破片を見出したのみといふ八木水谷二｜氏の談話など考へて、余はおぼろ氣ながら。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "疑問の加瀬貝塚",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸山教の御開山様というのは、武州｜橘樹郡登戸の農、清宮米吉のことであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "海知らぬ止利が嫉妬はこの祕密に萌して、婚後一年、伊佐奈が携へ來し妖鏡を偸見して、始めて鏡裏に海波橘樹を窺ひ、白影漸く凝りては少女が姿を知り、少女が手を執る夫を嫉みぬ。",
              "citation": {
                "source": "春鳥集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "橘樹　陜西の劉公、興化の令たる時、一道士来りて盆樹を献じぬ。",
              "citation": {
                "source": "『聊斎志異』より",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そを見るに橘樹の小さなる、指頭ほどあるを、細やかに裁りなせり。",
              "citation": {
                "source": "『聊斎志異』より",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "劉公はその後任期満ちて帰らむとするに、橘樹の生ひたちて把にも余りたるが、是年始めて実を結びぬ。",
              "citation": {
                "source": "『聊斎志異』より",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて橘樹は人の盗み去らむことを恐れて、前栽に移し植ゑ置きけり。",
              "citation": {
                "source": "『聊斎志異』より",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人はいたく喜びて、竊かに意ふやう、はや十年あまりを経たり、かの橘樹はそもいかがなりつらむと、行き着きて見れば、樹の大さ十囲、黄金色したる実の凡そ千もやあらむ、※々として枝も撓めり。",
              "citation": {
                "source": "『聊斎志異』より",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "詳しく云えば、武州｜橘樹郡平間村の百姓、軽部五兵衛というものの住居の一部で、ここには前に、富森助右衛門が引き籠っていたこともあり、村の子供たちに、習字読本を授けていた縁故から、その跡を急に手入れして内蔵助を迎えたのであった。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "神奈川県｜橘樹郡向丘村上作延）　ところがまた八王子の極楽寺という寺でも、これは地蔵ではないが、本尊の阿弥陀様を、鼻取｜如来と呼んでおりました。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "九　帷子武蔵｜橘樹郡｜保土ヶ｜谷町大字｜帷子安房安房郡｜保田町大字大帷子陸中｜巌手郡寺田町大字帷子美濃｜可児郡帷子町大字東・西帷子　その他諸国の帷子はすべて片平である。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "武蔵｜南葛飾郡｜綾瀬村大字小谷野字｜土富耕地同　橘樹郡城郷村大字岸根字島ドブ常陸真壁郡中村大字林字｜土深同　同　　騰波ノ江村大字｜筑波島字｜土腐磐城双葉郡｜幾世橋村大字｜棚塩字ドブ谷地伊勢三重郡朝上村大字田口字ドブ　相模にも無数のドブという地名があるのみならず、普通名詞にもこの意味に用いられている。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "土佐高岡郡長者村大字長者字フカホド武蔵｜橘樹郡｜生田村大字金程字程田　武蔵にはこのほかにも無数のホドがある。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京附近では、武蔵｜橘樹郡橘村大字｜明津は、『新篇風土記稿』によれば近い頃まで悪津と書き、大里郡｜明戸村大字明戸もまた旧称は悪戸である。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
