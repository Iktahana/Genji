[
  {
    "uuid": "5a86eebe-3936-5db3-9cc1-02f8ff04aa46",
    "entry": "聞き書き",
    "reading": {
      "primary": "ききがき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
