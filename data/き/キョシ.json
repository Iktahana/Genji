        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "巨資を投じて開始されたこのプロジェクトは、期待と不安が入り混じっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その企業は巨資を海外事業の展開に配分している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "巨資が必要なため、複数の銀行から融資を受けることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "この地底世界に、それほどの巨資があるのであろうか。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
