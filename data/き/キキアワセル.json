[
  {
    "uuid": "151732ea-1a98-5636-80e1-18d077fff4c0",
    "entry": "聞き合わせる",
    "reading": {
      "primary": "ききあわせる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
