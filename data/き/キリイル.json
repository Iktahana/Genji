        "examples": {
          "standard": [
            {
              "text": "ナイフでパン生地に切り入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "敵の陣地に鋭く切り入る戦術が採用された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「おい、勝手に人の話に切り入ってくるなよ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "調査団は、未踏のジャングルに深く切り入っていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "それは事物の秘密を洞察しその中に切り入る。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこんな部屋にすみ子と二人きりいるのが気が咎めた。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "東の空の真青に　きり入る山の端東の低き山の嶺　夕鳥の越えゆきてより、時たちにけり山ふかく　日は落ちゆきて、なほあかる夕山の端に顕ち来る　三日月ふたゝびを来にける山か。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
