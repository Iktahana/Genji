        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "コンサートのきつぷを購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "このきつぷの有効期限は3ヶ月だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "電子きつぷを使ってスタジアムに入場した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "派遣代表者諸君日本の豚はかういふ手つきで幣束を数へるとか、内股がすれるほど肥えてゐるから歩るきつぷりが斯うだとか、金ののべ棒をもつた馬占山を追つかけ廻したときのラッパの吹きやうなどを上手なみぶりで報告して集団農場や工場やサークルの若い突撃隊員を笑はしてくれ。",
              "citation": {
                "source": "小熊秀雄全集",
                "author": "―３―",
                "note": "青空文庫"
              }
            },
            {
              "text": "といふのは、もとより、全國的代表移民の都會であるから、そのころの負けじ魂が、利かぬ氣のきつぷになつて殘つてゐるので、すべてが鉋ツ屑のやうなものばかりではない。",
              "citation": {
                "source": "凡愚姐御考",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "おせいの事よりも、おせいの亭主に済まない気がして、毎日が罪人みたいにきつぷせな生活なンだぜ。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同時に、エミリアンはバイオリンをとつて、子豚の鳴き声と笑ひ声と歩きつぷりとに合せて、更に奇妙な音楽をひきだしました。",
              "citation": {
                "source": "エミリアンの旅",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紙の文面から判断しても、流石に修養があるだけに、この気違は却々きつぷの良いところがあり、謙遜の美徳など心得てゐる。",
              "citation": {
                "source": "盗まれた手紙の話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "メガネをかけた房珠鶏の気どつた歩きつぷり。",
              "citation": {
                "source": "希臘十字",
                "author": "高祖保",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
