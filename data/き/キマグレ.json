[
  {
    "uuid": "b3e4bacb-72c4-517f-a2c3-f028cfab4c49",
    "entry": "気まぐれ",
    "reading": {
      "primary": "きまぐれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
