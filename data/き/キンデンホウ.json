        "examples": {
          "standard": [
            {
              "text": "均田法に基づいて、農地が等しく配分された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "均田法の施行により、農民と貴族の経済格差が縮小した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "唐代の均田法は後世の農地制度の基となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "郡宰としての先生の治績には、父老会飲、賞罰の厳明の如き徳育風教の振興は勿論、社会法の徹底、均田法の施行、　雲南四郡看山遍　芸北三川度水頻　知道君恩無極已　衰来還賜自由身。",
              "citation": {
                "source": "頼杏坪先生",
                "author": "中村憲吉",
                "note": "青空文庫"
              }
            }
          ]
        }
