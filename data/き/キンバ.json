[
  {
    "uuid": "d1736f21-b720-50ec-81d2-e27bb8f94827",
    "entry": "金歯",
    "reading": {
      "primary": "きんば",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "gold tooth",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖父は笑うたびに金歯が光り、その顔が妙に懐かしかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "歯医者で虫歯を治療した際、奥歯に金歯を入れることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「その金歯、昔はずいぶん高かったんだよ」と父は自慢げに言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それからアスファルトの屋根材の継目に塗りつける黒いペイントを顎のとこへ大きな点につけてしばらくの間じっとそんな油や何かの乾くのを待ってたが、それがきれいに乾くとこんどは鏡台の引出しをあけてにせものの金歯を二枚出して犬歯へはめました。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）金歯で呼込んで、家内が留守で蕎麦を取る処だ、といって、一つ食わしてくれました。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "春の水をさかのぼる笑へば金歯が見える春風　三月十九日花ぐもりだ、身心倦怠。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヨイヨ面白そうに金歯を出して笑った。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」瀬川国十郎が、金歯をちらと光らせて言った。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この亭主もベラベラお饒舌をする男だが、同じく申上げたろう、と通りがかりに睨むと、腰かけ込んだ学生を対手に、そのまた金歯の目立つ事。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと例の煙草屋の金歯の亭主が、箱火鉢を前に、胸を反らせて、煙管を逆に吹口でぴたり戸外を指して、ニヤリと笑ったのが目に附くと同時に、四五人｜店前を塞いだ書生が、こなたを見向いて、八の字が崩れ、九の字が分れたかと一同に立騒いで、よう、と声を懸ける、万歳、と云う、叱、と圧えた者がある。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――塩で釣出せぬ馬蛤のかわりに、太い洋杖でかッぽじった、杖は夏帽の奴の持ものでしゅが、下手人は旅籠屋の番頭め、這奴、女ばらへ、お歯向きに、金歯を見せて不埒を働く。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "向う歯の金歯が光って、印半纏の番頭が、沓脱の傍にたって、長靴を磨いているのが見える。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "下廊下を、元気よく玄関へ出ると、女連の手は早い、二人で歩行板を衝と渡って、自分たちで下駄を揃えたから、番頭は吃驚して、長靴を掴んだなりで、金歯を剥出しに、世辞笑いで、お叩頭をした。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マア坊は、金歯を光らせて笑った。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反しスウェーデンで牧女どもの言い伝えに、昔畜生皆言語した時、狼が「吾輩を狼と呼ぶな仇するぞ、汝の宝と呼べば仇せじ」と説いたとかで、今にその実名を呼ばず、黙った者、鼠色の足、金歯など唱え、熊を老人、祖父、十二人力、金足などと称う。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "その金歯がはっきりと彼の目に映る。",
              "citation": {
                "source": "透明な輪",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨のなかに混ってゐる金歯を掌にすると、義兄もほろりと涙を零した。",
              "citation": {
                "source": "焔",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "４　婆さんのおはぐろや女の人の金歯は虫か何かのやうに見えるからたまらないのです。",
              "citation": {
                "source": "かげろふ断章",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "」アムリは山口に椅子をすすめて対座すると、白い歯並の中から、金歯を一枚強くきらきらと光らせながらいった。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さう緩りしちやゐられないの」と云つて、昔の金歯を一寸見せた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "庸三は時に小夜子の帳場で、お行儀よく坐っている彼女を見かけるのだったが、渋い作りの身装もきちんとしていたが、ごつい金歯がひどく顔の感じを悪くしていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉の薄い目尻の下った、ボチャボチャした色白の顔で、愛嬌のある口元から金歯の光が洩れていた。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と叔母は楊枝で金歯を弄りながら、愛想笑いをした。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　女の口には金歯が光った。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お上さんは莫迦に鉄火な女だっていうから、外套を一つ拵えてもらおうと思うんだが……」　金歯や指環などをぴかぴかさせて、糸織の褞袍に着脹れている、五十年輩のその親方は、そう言いながら、サンプルを見はじめた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "金歯などをぎらぎらさせたその中の一人の話によると、浜屋は近頃自分の手に買取ったその山のある一部の森林を見廻っているとき、雨あがりの桟道にかけてある橋の板を踏すべらして、崖へ転り陥ちて怪我をしてから、病院へ担ぎこまれて、間もなく死んでしまったと云うのであった。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼い娘だった時分、金歯にしてしてとねだって一本何でもないのに金で包んで貰ったのがそのままになっているのだそうだ。",
              "citation": {
                "source": "九月の或る日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代、きんばい・ちんべいなど言ふ。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなぞうきんばかりで拭けるもんか。",
              "citation": {
                "source": "掃除当番",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょきんばこみたい！",
              "citation": {
                "source": "つまさきチミーのはなし",
                "author": "THE TALE OF TIMMY TIPTOES",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄金色のものではしなのきんばい、みやまきんぽうげ、白くて大きな、梅の花に似たものにははくさんいちげ、淡紅色のいはかゞみ、かわいらしいみやまをだまき等澤山な種類があります。",
              "citation": {
                "source": "森林と樹木と動物",
                "author": "本多靜六",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
