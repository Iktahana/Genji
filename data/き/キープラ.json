          "literary": [
            {
              "text": "キープラ　Jan Kiepura　映画の方では非常に有名な歌手だが、私などはあまり興味を持てない。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "テナーのキープラ、ソプラノのムーアと同じように私は考えている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャンキープラといふ本格歌手を生かした、音楽映画だが、何うも買へない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
