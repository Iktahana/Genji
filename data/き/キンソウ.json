  {
    "uuid": "e2b3d508-08be-57bf-b05a-dcb8fd3fa0ba",
    "entry": "金相",
    "reading": {
      "primary": "きんそう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
