    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この泥水分離の境地に至ったにしても持って生れた天分の大小はどうすることは出来ないから、やはり小者は小、狭者は狭、偏者は偏、浅者は浅で有るが、それでも各々必ずその特長を現わす。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めは人相の悪い奴だと思つたが、黒木綿の大分汚なくなつた袴を穿いて居たのが、蕎麦屋の出前持をする男には珍らしいと云ふので、褊狭者の主筆が買つてやつたのだと云ふ。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "偏狭者によって悩まされたことの記念と、伊藤博文を景慕する気もちを象徴したものであった。",
              "citation": {
                "source": "親は眺めて考えている",
                "author": "金森徳次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この泥水分離の境に到り得たにしても、有つて生れた天分の大小は如何ともすることは出來無いから、矢張り小者は小、狹者は狹、偏者は偏、淺者は淺で有るが、それでも各必らず其の妙を呈する。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めは人相の惡い奴だと思つたが、黒木綿の大分汚なくなつた袴を穿いて居たのが、蕎麥屋の出前持をする男には珍らしいと云ふので、偏狹者の主筆が買つてやつたのだと云ふ。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
