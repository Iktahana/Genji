    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もうもう我が世はだめだとふかくあきらめて、なるままに身をも心をもまかせてしまったというふうである。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しようがないから」「どうすることもできないから」「よんどころないからあきらめている」というような心持ちで、いかにもつまらない冷やかな家庭を作っていねばならないのか、ああ考えるのもいやだ……。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただの町獣医の妻では親類に会わせる顔もないと思うから、どう考えてもあきらめられない。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あきらめねばなるまい。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あきらめるよりほかに道はない。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局両親は自分たちの隠居金を全部むすめにあたえて、「ふたりの男の子をせい一ぱい教育しなさい、そうしてわが世をあきらめて、ふたりの子の出世をたのしめ」とさとしたのである。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この野郎ふざけた野郎だ……」　猛然立ちあがった糟谷はわが子を足もとへ引き倒し、ところきらわずげんこつを打ちおろした。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸くあきらめがついて帰ってしまった　先生の許へ往くようになってからこんな事はきょうが始めてである十三日の午後から急に訪問を思い立って出掛けた。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代り天気はきらきらしている。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな風に言われたから、民子はすっかり自分をあきらめたらしく、とうとう皆様のよい様にといって承知をした。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの通り温和しかった民子は、自分の死ぬのは心柄とあきらめてか、ついぞ一度不足らしい風も見せなかったです。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、つまり古代国語では、一語中に、母音と母音とが直接に結合することをきらったのである。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、派手の特色たるきらびやかな衒いは「いき」のもつ「諦め」と相容れない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月初旬の日光は、青葉の葉影で明るくきらきらと輝やいて居た。",
              "citation": {
                "source": "夏帽子",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るにその後『憂鬱なる××』といふ題の小説が現はれたり、同じやうな書銘の詩集が出版されたりして、この「憂鬱」といふ語句の官能的にきらびやかな觸感が、當初に發見された時分の鮮新な香氣を稀薄にしてしまつた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふるいふるい記憶のかげでどこかの波止場で逢つたやうだが菫の病鬱の匂ひがする外光のきらきらする硝子窓からああ遠く消えてしまつた　虹のやうに。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおいとしげな私の新芽よはちきれる細胞よいま過去のいつさいのものに別れを告げずゐぶん愉快になり太陽のきらきらする芝生の上でなまあたらしい人間の皮膚の上でてんでに春のぽるかを踊るときだ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "輝やける手おくつきの砂よりけちえんの手くびは光るかがやく白きらうまちずむの屍蝋の手指くされどもらうらんと光り哀しむ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "白夜夜霜まぢかくしのびきて跫音をぬすむ寒空に微光のうすものすぎさる感じひそめるものら遠見の柳をめぐり出でしがひたひたと出でしが見よ　手に銀の兇器は冴え闇に冴えあきらかにしもかざされぬそのものの額の上にかざされぬ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吠えるところの犬は、その心靈に於てあきらかに白熱され、その心臟からは螢光線の放射のごときものを透影する。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは『徒然草』の兼好法師に説かれないでも、僕位の年齢に達するまでには、出家悟道の大事を知って修業し、いつのまにか悟りを啓いて、あきらめの好い人間に変ってしまう。",
              "citation": {
                "source": "老年と人生",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "みよ風景はいみじくながれきたり青空にくつきりと浮びあがりてひとびとのかげをしんにあきらかに映像す。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "櫻の枝はいちめんにひろがつてゐる日光はきらきらとしてはなはだまぶしい。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後生だわ」　女は、小倉が自分をきらって駄々をこねるんだと思って、困り切っていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども姉さんは、理由もなく、鈴岡さんをきらってしまったのだ。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前も兄さんも、下谷の家を、とってもきらっているんでしょう？",
