    "definitions": [
      {
        "index": 1,
        "gloss": "fine clothes",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祭りの夜、綺羅をまとった花魁が艶やかに廊下を歩いていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女は綺羅に身を包み、宴席に華やかな雰囲気をもたらした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "綺羅をまとった貴族たちが御所の庭に集まり、雅楽の音色が響き渡った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "良久しうありて奧さま大方醉も覺めぬれば、萬におのが亂るゝ怪しき心を我れと叱りて、歸れば盃盤狼藉の有さま、人々が迎ひの車門前に綺羅星とならびて、何某樣お立ちの聲にぎはしく、散會の後は時雨に成りぬ。",
              "citation": {
                "source": "われから",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他、私は貴女が男装して男の前でズボンを脱いでみせる芸当と、フォルベルゼエルの寄席の衣裳の綺羅を棄てた手踊と。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥の三面鏡にはたえまなく綺羅を着かざったブルジョワ婦人が、三面鏡があたえる美化された三つの姿態に惚れ惚れと見ほれてしまった。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "女性の尻ばかり見て暮す男にとっても、売笑婦の心理的な綺羅によって飾られた脣から、下腹部にかけてのガリッシュな紅色の部分については特殊な魅惑を感じる。",
              "citation": {
                "source": "戦争のファンタジイ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣も釣でおもしろいが、自分はその平野の中の緩い流れの附近の、平凡といえば平凡だが、何ら特異のことのない和易安閑たる景色を好もしく感じて、そうして自然に抱かれて幾時間を過すのを、東京のがやがやした綺羅びやかな境界に神経を消耗させながら享受する歓楽などよりも遥に嬉しいことと思っていた。",
              "citation": {
                "source": "蘆声",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体昔の大名の別邸を取払った幾分の造作が残ったのに、件の洋風の室数を建て増したもので、桃色の窓懸を半ば絞った玄関｜傍の応接所から、金々として綺羅びやかな飾附の、呼鈴、巻莨入、灰皿、額縁などが洩れて見える――あたかもその前にわざと鄙めいた誂で。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "茸狩に綺羅は要らないが、山深く分入るのではない。",
              "citation": {
                "source": "小春の狐",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "左右前後の綺羅が頭の中へ反映して、心理学にいわゆる反照聯想を起すためかとも思いますが、全くそうでもないらしいです。",
              "citation": {
                "source": "虚子君へ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、それがいかにも歓びに溢れ、青春を持て剰している食後の夜の町のプロムナードの人種になって、特に銀座以外には見られぬ人種になって、上品で綺羅びやかな長蛇のような帯陣をなして流れて行く。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体本来を云えば樹下石上にあるべき僧侶が、御尊崇下さる故とは云え、世俗の者共｜月卿雲客の任官謝恩の如くに、喜びくつがえりて、綺羅をかざりて宮廷に拝趨するなどということのあるべきでは無いから、増賀には俗僧どもの所為が尽く気に入らなかったのであろう。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "角の柳光亭の楼上、楼下は雛壇のような綺羅びやかさを軒提灯の下に映し出しています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あまり綺羅びやかに最上級に洒落て居るので却って平凡に見える幾十組かが場の大部分を占めて居るので、慾一方にかかって居る樺色の老婆や、子供顔のうぶな青年が却って目立つ。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてその前後左右に綺羅星の如くに居並んでいる人々は、遠目の事ゆえ善くは見えぬが、春陽堂の新小説の宙外、日就社の読売新聞の抱月などという際立った性格のある頭が、肱を張って控えて居るだけは明かに見える。",
              "citation": {
                "source": "鴎外漁史とは誰ぞ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "）頼家　鎌倉は天下の覇府、大小名の武家小路、甍をならべて綺羅を競へど、それはうはべの榮えにて、うらはおそろしき罪の巷、惡魔の巣ぞ。",
              "citation": {
                "source": "修禪寺物語",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一つの長閑な例――奇妙な囚人服を着せられ道路工事に使役されている土人の囚人の所へ、日曜着の綺羅を飾った囚人等の一族が飲食物携帯で遊びに行き、工事最中の道路の真中に筵を敷いて、囚人達と一緒に一日中飲んだり歌ったりして楽しく過すのだ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "落成式の当日、公は華やかな宴を開き、衛国の名流は綺羅を飾って悉く此の地に会した。",
              "citation": {
                "source": "盈虚",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "落成式の當日、公は華やかな宴を開き、衞國の名流は綺羅を飾つて悉く此の地に會した。",
              "citation": {
                "source": "盈虚",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二番に何屋の某と綺羅を尽くした伊達姿が、眼の前を次から次に横切っても、人々は唯、無言のまま押合うばかり。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴族院議員の愛娘とて、最も不器量を極めて遺憾なしと見えたるが、最も綺羅を飾りて、その起肩に紋御召の三枚襲を被ぎて、帯は紫根の七糸に百合の折枝を縒金の盛上にしたる、人々これが為に目も眩れ、心も消えて眉を皺めぬ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら花魁の、太夫のと、うわべばかりに綺羅を飾っても、わたし達の身の果てはどう成り行くやら。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪子の家には、母親と姉妹との夫々の雛が三組もあつて、その家の隆盛時代を物語るかのやうに最も豪儀な姉妹の雛段が存分な綺羅を競ふてゐた。",
              "citation": {
                "source": "熱い風",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧乏咄をして小遣銭にも困るような泣言を能くいっていても、いつでもゾロリとした常綺羅で、困ってるような気振は少しもなかった。",
              "citation": {
                "source": "斎藤緑雨",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな長屋に親の厄介となっていたのだから無論気楽な身の上ではなかったろうが、外出ける時はイツデモ常綺羅の斜子の紋付に一楽の小袖というゾロリとした服装をしていた。",
              "citation": {
                "source": "斎藤緑雨",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これが資本だ、コンナ服装をしないと相手になってくれない」と常綺羅で押出し、学校以来疎縁となった同窓の実業家連と盛んに交際し初めて、随分｜待合入りまでもして渠らと提携する金儲けの機会を覘っていた。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "（下略）　大正十三年九月一日　とあって、賛助員に後藤新平、中村是公、目賀田種太郎、金子堅太郎なぞいう名士の名がズラリと並び、発起人に何々会社重役、何々病院長、何々ビルディング支配人なぞいうのから、肩書も何も無いのまで、綺羅星の如く並んでいる。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "）頼家　鎌倉は天下の覇府、大小名の武家小路、甍をならべて綺羅を競えど、それはうわべの栄えにて、うらはおそろしき罪の巷、悪魔の巣ぞ。",
              "citation": {
                "source": "修禅寺物語",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その綺羅びやかな、そうして壮厳な仏事のありさまをよそながら拝もうとして、四方から群がって来た都の老幼男女も、門前を埋めるばかりにひしひしと詰めよせていた。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "賣りものに花の綺羅をかざり、松の位の君達と、世に全盛をうたはれても、その身の果はなんとならう。",
              "citation": {
                "source": "箕輪の心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、われのみの、われのみの聖なる遊戲、知るひととてもありやなしや、怒れば足深空に跳り、その靴もきらめききらめき、涙のみくちなはのごとく地をはしる。",
              "citation": {
                "source": "光る風景",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔卑屈の友らをいきどほろしく〕宮沢賢治卑屈の友らをいきどほろしく粘土地二片をはしりてよぎり崖にて青草黄金なるを知りのぼりてかれ草黄なるをふめば白雪きららに落ち来るものか一列赤赤ならべるひのきふたゝび卑屈の友らをおもひたかぶるおもひは雲にもまじへかの粘土地なるかの官庁に灰鋳鉄のいかりを投げよ",
              "citation": {
                "source": "〔卑屈の友らをいきどほろしく〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
