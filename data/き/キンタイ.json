  {
    "uuid": "c03f4594-6e25-5f02-a073-e387b9132043",
    "entry": "錦袋",
    "reading": {
      "primary": "きんたい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "錦袋円の娘、池の端（いまの台東区池之端一丁目一番、同上野二丁目一一・一二番）に錦袋円という有名な薬屋がありました。",
              "citation": {
                "source": "江戸の化物",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "中島または木村を姓とし初め時太郎｜後鉄蔵と改め、春朗、群馬亭、菱川宗理、錦袋舎等の号あれども葛飾北斎最も現わる。",
              "citation": {
                "source": "北斎と幽霊",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の足の爪先は、池の端、錦袋円の裏路地に、　――おん仕立物――　と、小さい札を出した小家を差していそぐ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬道三丁目入口の角で、錦袋円と廿軒茶屋の間だなあ。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "石橋山の合戦の折もこの錦袋と共に戦ったという。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第五巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
