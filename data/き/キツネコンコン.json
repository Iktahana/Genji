        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「狐こんこん白狐、お嫁ほしけりゃ、とってやろよ。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「狐こんこん、狐の子、お嫁がいらなきゃ餅やろか。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「狐こんこん狐の子、狐の団子は兎のくそ。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「狐こんこん狐の子、去年狐のこん兵衛が、ひだりの足をわなに入れ、こんこんばたばたこんこんこん。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「狐こんこん狐の子、去年狐のこん助が、焼いた魚を取ろとしておしりに火がつききゃんきゃんきゃん。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "狐こんこん狐の子、こんこん狐の紺三郎。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「狐こんこん狐の子、去年狐のこん兵衛が　　左の足をわなに入れ、こんこんばたばた　　　　　　　　　　　　　　　　こんこんこん。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「狐こんこん狐の子。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「狐こんこん狐の子、去年狐のこん兵衛が左の足をわなに入れ、こんこんばたばたこんこんこん。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この草には右のオキナグサのほかになおたくさんな各地の方言があって、シャグマグサ、オチゴバナ、ネコグサ、ダンジョウドノ、ハグマ、キツネコンコン、ジイガヒゲ、ゼガイソウもその内の名である。",
              "citation": {
                "source": "植物知識",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、飛騨でモノグルイ、備中でもキツネコンコン、加賀・越中でオニゴロというのもこれであり、筑前その他でゼカイソウといったのは、疑いもなく能の是界坊から出ている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
