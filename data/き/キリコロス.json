    "definitions": [
      {
        "index": 1,
        "gloss": "to kill with a sword (knife, dagger, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "時代劇で、武士が敵を刀で切り殺すシーンが映された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "小説では、主人公が野盗に切り殺されるという場面があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "歴史的な記録に、その兵士は多くの敵を切り殺したと書かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "たとい、その下に使わるる石工が幾人いようとも、切り殺すに何の造作もあるべきと、勇み立った。",
              "citation": {
                "source": "恩讐の彼方に",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、彼だって、私の編み出した剣の一撃で切り殺すことが出来る。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "いねむりのじゃまをした子どもたちを、さむらいがきりころすと思ったのです。",
              "citation": {
                "source": "飴だま",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国人をおいはらえという人々は、ちょっとしたことがあると、すぐ外国人をきりころすようならんぼうをしました。",
              "citation": {
                "source": "福沢諭吉",
                "author": "ペンは剣よりも強し",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
