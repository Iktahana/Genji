          "literary": [
            {
              "text": "彼は樫の木に出来る木瘤のやうな拳を握りしめながら、今にも青年に飛びかゝるやうな身構へをしてゐた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は樫の木に出来る木瘤のような掌を握りしめながら、今にも青年に飛びかゝるような身構えをしていた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄暗さの中にかすかに見える、木瘤、小さな瘤の真ン中に、たしかにプスリと弾丸が突き刺さったのだ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "こは生きて動ける大いなる木瘤の、道行く人を遮らんと、さし伸ぶる章魚の足めく小枝なり。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            }
          ]
        }
