        "examples": {
          "standard": [
            {
              "text": "失敗して気を落とす必要はない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "試験に落ちて、兄は気を落としていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "会社で気を落とさずに、頑張ってください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「そう気を落とすものじゃアない、しっかりなさい」と、この店の亭主が言った。",
              "citation": {
                "source": "窮死",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "気を落とすにはあたりません。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "燕尾服の自殺　――ブルゴオニュの葡萄祭り――",
                "note": "青空文庫"
              }
            },
            {
              "text": "八郎、気を落とすな！",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨がなくなると犬は気を落とすだろ、ええ？",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            }
          ]
        }
