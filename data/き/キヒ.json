  {
    "uuid": "5921084c-227c-5297-bd16-b241338206d8",
    "entry": "キヒ",
    "reading": {
      "primary": "きひ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
