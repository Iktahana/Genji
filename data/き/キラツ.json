          "literary": [
            {
              "text": "キラキラツと黄金のぶちがひかりました。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さう思ふ間もなく電車は遠ざかり、窓からの顏は横向きになり、眼鏡がキラツと光つた時に、駿介にはその名が思ひ浮んだ。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "キラツと閃めく度にキーンといふ響きが大空に傳はるやうな氣がした。",
              "citation": {
                "source": "泥の雨",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "キラツと閃めく雷光が、親爺の白髮のうなじを青くはつきりと見せた。",
              "citation": {
                "source": "泥の雨",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "春になる――童話風景――櫻間中庸雲が浮いてらあ――猫柳が浮いてらあ――キラツと魚のお腹が光つたよ",
              "citation": {
                "source": "春になる",
                "author": "――童話風景――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
