        "examples": {
          "standard": [
            {
              "text": "地方の文化が急速に均質化され、地域の特色が失われつつある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新しい機械の導入により、液体の均質化が効率的に行われるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "グローバル化による社会の均質化に対して、懸念の声も上がっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "だが文字主体のＭＳ―ＤＯＳの環境でこれらのソフトに寄せられるユーザー側の期待は、今、かなり均質化されてきている。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
