          "literary": [
            {
              "text": "紫の花も白い花もちっ共愛されていませんね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれ共愛すべき所々を持って居たのではあるまいか。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし彼は、それらの破廉恥な行いや、泥のような心の奴らや、彼らが自分を陥れようとした不倫な共愛などを、いまいましく唾棄しながら、林の間を逃げていった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
