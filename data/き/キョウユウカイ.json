    "definitions": [
      {
        "index": 1,
        "gloss": "social organisation for people originating from the same town, village, or island who live in an urban center far from home (predominantly used by people from Okinawa)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は東京に出てから郷友会で沖縄の友人たちと定期的に会っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その郷友会はオキナワ出身者を中心に月1回の懇親会を開いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "沖縄から上京した彼女は郷友会に入ることで新しい人間関係を広げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "近きに郷友会の秋季大会あらんとて、今日委員会のありし帰さを彼等は三人打連れて、遊佐が家へ向へるなり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
