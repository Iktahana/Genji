        "examples": {
          "standard": [
            {
              "text": "あ、テレビのチャンネルが勝手にニュースに切り替わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "会議の途中で、話題が急にプロジェクトの進捗状況に切り替わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このゲーム、操作方法が複雑で、ボタンを押すたびに機能が切り替わるのが慣れないな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "すぐに、真横から校舎裏玄関をねらった絵に切り替わる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日のゲストはデビューしたばかりの女性ロックバンド、サイバネティック・スキゾイドのみなさんです」　カメラが切り換わる。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこまでを２カメが捉え、首尾よく４カメに切り換わる。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして水銀灯に切り替ると、水牛仏が廻転を始めるのです」「あの水牛仏が、廻りだしたことが、よくお分りになったものね。",
              "citation": {
                "source": "鬼仏洞事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのカードには、現在どんな新聞をよんでいるか、これからどんな新聞が読みたいかを書きこむ欄があって、希望新聞の名を書けばその新聞へ切りかわることができるしくみになっていた。",
              "citation": {
                "source": "主婦と新聞",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜田門事変から戊辰戦争にいたる大小幾多の政争や内乱をそのあいだにさしはさんで、混乱しきっている日本幣制を、金銀両本位の円制度に切替るというはなれわざが、どうしてあの貧乏政府にできたかという問題である。",
              "citation": {
                "source": "明治の五十銭銀貨",
                "author": "服部之総",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
