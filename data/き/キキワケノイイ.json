        "examples": {
          "standard": [
            {
              "text": "うちの夫は聞き分けのいい人だから、頼み事をしても嫌な顔一つしない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は昔から聞き分けのいい子供だったそうで、先生からも評判が良かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "新しいプロジェクトのメンバーは、皆聞き分けのいい人ばかりで、意見交換もスムーズだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "あとで呼ぶ」「はい、はい」　聞き分けのいい猫のように、そろりは、茶室を出て行った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなにして二人とも家から呼ばれるまではなにもかも忘れて遊びにふけつてるが、ききわけのいいお※ちやんはどんなときでも「お嬢様もうお帰りあそばせ」と呼ばれると「はい」とすなほに返事をして、帰りともない様子はしながらさつさと帰つてゆく。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
