        "examples": {
          "standard": [
            {
              "text": "野鳥観察会で双眼鏡を向けると、葦の茂みに金腹が止まっているのが見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "図鑑で金腹のページを開くと、栗色の羽と鮮やかな腹部の写真が載っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "沖縄の田んぼで金腹の群れが稲穂の間を飛び回っているのを撮影した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "紅雀、じゅうしまつ、きんぱら、文鳥などが一つがい、二つがいずついる。",
              "citation": {
                "source": "小鳥",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭がつやつやと黒く、体は全体金茶色で、うす灰色の嘴と共に落付いて見えるきんぱらは、嘗て見苦しいほど物に動じたのを、私は見たことがない。",
              "citation": {
                "source": "小鳥",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
