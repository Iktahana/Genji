        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "暑かつた、労れた、行程八里、厚狭町小松屋といふ安宿に泊る（三〇・中）、掃除が行き届いて、老婦も深切だが、キチヨウメンすぎて少々うるさい。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "△これだけキチヨウメンであつて、そしてこれだけダラシないとは。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "予期した通りにＫから送金、何とキチヨウメンな息子だらう、ありがたし／＼。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女もまたいつもキチヨウメンで、理性的で、品行方正である。",
              "citation": {
                "source": "婦人解放の悲劇",
                "author": "エンマ・ゴルドマン",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
