        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "両国は局地戦争に留めることで国際的な了承を得た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "局地戦争として始まった紛争が数年で全面戦争へ拡大した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "現在の軍事衝突は局地戦争の域を出ていないという見方が強い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
