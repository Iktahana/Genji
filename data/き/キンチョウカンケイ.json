        "examples": {
          "standard": [
            {
              "text": "米露間の緊張関係が数十年続いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "親子間に緊張関係が生まれた翌日から、家の雰囲気が変わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "営業部長と人事部長の間に緊張関係があり、プロジェクトに悪影響を及ぼしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "とまあこうした我が家の緊張関係が示すとおり、マイクロコンピューターを組み込んで賢くなった機器のお相手は、色々やれる分だけやっかいだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "大内は情報処理のＰＣ―９８０１と電子デバイスのＰＣ―１００のあいだに生じた鋭い緊張関係に、社内抗争の兆しを感じとったのだという。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
