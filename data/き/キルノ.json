          "literary": [
            {
              "text": "「ナント　イフ　キレイナ　コヱデセウ」「アンナニ　ヨイ　コヱデ　ウタフ　コトノ　デキルノハ　タレデセウ」ト　ナタネノ　ツボミタチハ　ウツトリシテ　ササヤキアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナルホド、イママデ　キヅカズニ　ヰタガ、カナヅチハ　クワヲ　ツクル　コトガ　デキルノダナ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサ　イチバン　ハヤク　オキルノハ　アノ　ヲトコデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムシロ生涯、生キルノ扶持ヲ歓ンデ恵マン。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            }
          ]
