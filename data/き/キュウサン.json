        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "蛮声終れば拍手｜急霰のごとし。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "万は急霰のような拍手に包まれた。",
              "citation": {
                "source": "手品",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "拍手の音が急霰のように場内一面に湧き起った。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らく、本会の秋季大会には、報告できるようになるだろうと思います」　博士は急霰のような拍手を浴びながら演壇を下った。",
              "citation": {
                "source": "人造人間",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "急霰のような拍手が島をゆるがす、小鳥がおどろいて一時にパッと飛びたった。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔心ニ知ル白髪一宵ニ添フルヲ／客路鏡奩ヲ借ルニ由無シ／鉄券何人カ功績ヲ恃マンヤ／黄裳今日爻占ヲ玩ブ／頑雲月ヲ包ミテ山角ニ走リ／急霰風ニ乗リテ帽尖ヲ撲ツ／遺却ス身材ハ襪線ノ如シ／擬ス涓滴ヲ将テ炎炎ヲ救フニ〕　毅堂は時に年四十三。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "無事にすむと急霰のような拍手が起こった。",
              "citation": {
                "source": "美音会",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その烈しい急霰の落ちようは人の話し声も聞えないほどさかんであった。",
              "citation": {
                "source": "性に眼覚める頃",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "聴衆は思わず声をあげてどよめいたが、たちまち急霰の拍手だった。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯くの如く組織的な、団体的な応援は日本に於ては最初のものであつたから、何も知らぬ観衆は先づ驚き、次で急霰の如き拍手を以て迎へた。",
              "citation": {
                "source": "野球界奇怪事　早慶紛爭囘顧録",
                "author": "吉岡信敬",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢は急霰のように追ったが、徐栄軍はついに追いきれなかった。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　口々にわめく酔いどれの声々が混乱して、たちまち急霰の拍手が起こった。",
              "citation": {
                "source": "黒蜥蜴",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
