[
  {
    "uuid": "fcbb8623-3b54-5863-af6d-72f7af47cd5a",
    "entry": "来此",
    "reading": {
      "primary": "きこれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
