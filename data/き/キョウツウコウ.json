        "examples": {
          "standard": [
            {
              "text": "彼らは育った環境は全く違うのに、驚くほど多くの共通項を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この二つのアイデアの共通項は何だろう？それを見つけたら、もっと良いものが作れるはずだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "まずは、お互いの共通項に焦点を当てて、協力関係を築いていこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "生年に三年の差はあるものの、東京の世田谷に生まれ、私立有名大学の理工系に進み、同じ会社の同じ部門に籍を置くことになった二人の経歴には、共通項が多い。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
