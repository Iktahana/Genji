    "definitions": [
      {
        "index": 1,
        "gloss": "winter jasmine (Jasminum nudiflorum)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭の隅に植えた金梅が、真冬の寒さの中で黄色い花をつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "金梅は葉が出る前に花を咲かせるため、枝だけに黄色が映えて美しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "寒い季節でも庭を彩ってくれる金梅を、祖母はとても気に入っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "白樺の痩せた稚い樹が出て来て、その中から山桜の花が、雪のように咲いている、四月の色は北岳の北の尾根から、信濃金梅の傾斜を伝わって、この森林にまで、流れ込んでいる。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "此処は白馬浅葱、白馬扇、白山小桜、信濃金梅、高根薔薇、黄花石楠、黒百合、色丹草など、素人目にも美しい花がそれこそ妍を競い麗を闘わし、立派なお花畑である。",
              "citation": {
                "source": "白馬岳",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頂上は割合に広く、三角点を取巻いて深山小田巻草、深山金梅、岩梅、白馬黄者、白山一華、深山塩竈などの高山植物が今や全く花盛りで、紅や白や黄や紫が入り乱れて艶を競うている。",
              "citation": {
                "source": "朝香宮殿下に侍して南アルプスの旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾根の西側には舟底に似た草原の窪地が続いて、目のさめるような鮮黄色の信濃金梅や珍車の花などが咲いている。",
              "citation": {
                "source": "大井川奥山の話",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫からは楽な登りを続けていつか三角点を過ぎ、木立を抜け出ると偃松の散生した草原に、黄金色の信濃金梅や純白な白山一華、夫等に交って大桜草、小岩鏡などの紅花を点綴したお花畑を眺めながら、燕の小屋場といわれていた山稜上の一地点に達するのである。",
              "citation": {
                "source": "秩父宮殿下に侍して槍ヶ岳へ",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "信濃金梅のようであったが、側まで行って確める程の勇気はなかった。",
              "citation": {
                "source": "奥秩父の山旅日記",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長之助草や裏白金梅を初めて見た。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒岳の東面にはエゾの金梅草が咲く、日本アルプスの信濃金梅に似て、ひとまわり大きく、眼のさめるようなみごとな花だ。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたり一面エゾの金梅草で、清流はヤチ蕗の花に埋もれ、まず黄金の波間にただよっているような感じだ。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここから沼ノ原山までの間が五色ガ原で、見る限り霧に融け入るエゾの金梅草、あるいは白山一華、あるいはその混交で、金と銀の独奏また交響の色彩楽だ。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代、きんばい・ちんべいなど言ふ。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄金色のものではしなのきんばい、みやまきんぽうげ、白くて大きな、梅の花に似たものにははくさんいちげ、淡紅色のいはかゞみ、かわいらしいみやまをだまき等澤山な種類があります。",
              "citation": {
                "source": "森林と樹木と動物",
                "author": "本多靜六",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中に倉橋君が来る、晃平を殿として、一行が揃う、こう霧がひどくては、方角も何も解らない、晃平は荷を卸して、路を捜索に出たが、無益に戻って来た、岩の間を点接して、トウヤクリンドウ、ミヤマキンバイ、ミヤマウスユキソウ、チングルマなどがあったが、風と霧と雨の中で、一々眼に止めていられない。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも石の河原のような小隆起を、二タ山ほど盲越えに越えた、高頭君はウラジロキンバイが多いと、指して驚いている、この高山植物は、白馬岳や八ヶ岳に産したものだが、今濫採されて、稀少になったものだそうで、今のところ、ここが最も豊饒な産地であろうと語られた。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "採集植物シモツケソウ　クカイソウ　ルリトラノオ　キンバイソウ　ヤナギラン　ウスユキソウ　ヨブスマソウ　ノブキ　バイケイソウ　シュロソウ　ヒメユリ　シラヤマギク　オタカラコウ　タムラソウ　キオン　谷を上れば、右が霧ヶ峰主峰たる車沢山（？",
              "citation": {
                "source": "女子霧ヶ峰登山記",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この辺はキンバイソウの群落で、黄金色の花が、歩に従って咲き続いて居る。",
              "citation": {
                "source": "女子霧ヶ峰登山記",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車は川に沿うて、やや開いた谷の底を、両側にはたえず雪の山脈を仰いで、北にむかうと草原にはキンバイやタンポポが一面に咲いて、百姓家のあいだあいだには、林檎、すももなどの花盛りである、やがて西から流れるライン河の本流に合した。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "河幅はあまり広くないが、岸の牧場にあふれるばかりに滾れ落ちる水は、いかにもたった今氷河から融けて来たと思われる、底濁りのある蒼色で、その重々しい様子が、キンバイの咲き乱れた鮮やかな川岸の草原と、面白いコントラストを示しておる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "街道は、あるときは丘の斜面に、キンバイや三色菫の咲き乱れた間をぬけたり、またはさらさらと流れ落ちる、山川の岸に沿う牧場のふちをぐるっと廻って、行き止りになるかと思うと、柵のあいだに小さな木戸があって、また西の方へつづいてゆく。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "何んとなれば婆羅門参はヒガンバナ科のキンバイザサすなわち仙茅の一名であるからである。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち婆羅門参の由来はこの如くであって、それはキンバイザサの名にほかならない。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シナノキンバイとハクサンイチゲの花盛りだった。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
