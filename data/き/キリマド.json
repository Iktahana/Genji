[
  {
    "uuid": "d581d4ab-24a7-5961-9613-5337b70f951a",
    "entry": "切り窓",
    "reading": {
      "primary": "きりまど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
