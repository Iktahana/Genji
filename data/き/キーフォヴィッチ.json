          "literary": [
            {
              "text": "もう一人の男は、血をわけた彼の息子で、モーキイ・キーフォヴィッチといった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "モーキイ・キーフォヴィッチはそんな風な男ではあったが、根は案外善良であった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "『若旦那のモーキイ・キーフォヴィッチは何てお方でございましょう！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "モーキイ・キーフォヴィッチは、わしのこの胸の中にちゃんと住まっておるのじゃ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "』彼はこのような父性愛を披瀝して、伜のモーキイ・キーフォヴィッチには相も変らず猛者ぶりを発揮させておいて、自分はまた例のお気に入りの題目にかえって、フイとこんなような問題に頭をひねるのであった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
