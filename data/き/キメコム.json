    "definitions": [
      {
        "index": 1,
        "gloss": "to take for granted",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は私が手伝うと決め込んで、何の相談もしてこなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "最初から犯人だと決め込んで捜査するのは良くない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はその情報をうっかり信じ込んで、すぐに決め込んでしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ようし、お前らが忘れたふりを決め込む気なら、オレが思い出させてやるぞ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレ様のあまりの惨状に目を反らせて他人顔を決め込む慶子の肩も借りられず、「病院、病院」と呻きながら転がり込んだイエロー・キャブの運ちゃんが三日前にインドネシアのハルマヘラ島からニューヨークにやってきて、昨日タクシーの免許を取ったばかりときた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、ここで知らん顔を決め込むのも、実に芸がない。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな事を真似て、濡手をきめこむ、目の鋭い人間も、又北海道に入り込んできた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そのだいたいが、あぶないものさ『この天が下、人あるところ、みなそれがしの住居でござる』などと途方もなく大たばをきめこむ、あの島原城之介の住居だ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "百｜米選手がマラソンで優勝するのは一応不可能と見てよろしいかも知れないが（これとても絶対に不可能だとはきまっていない）五千、一万の優勝者がマラソンに優勝不可能だときめこむのは滑稽千万の話である。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、久生君の小説が同君の独創的な発想によるもので、パリの事実に即しているわけではないかも知れないが、そういうことはとにかくとして、一応負けたシャモは勝てないときめこむよりは、訓練次第で再び優勝者になりうる、と考える方が正しいように私は思う。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんのためらうところもなく一目散｜随徳寺をきめこむこと。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "またそれをよいことにし横着をきめこむものもないではなかろう。",
              "citation": {
                "source": "震災後記",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで一泊した翌日、私が、彼のひきとめるままに居候をきめこむ気をおこしたのは、父のいない家族内でのわずらわしい自分の役目から、たとえ一時的にせよ解放されたかったためにすぎない。",
              "citation": {
                "source": "軍国歌謡集",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で海へくだらないで川に居残りの佐平治をきめこむのを、ヤマメだと土地の人はいっている。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "白旗を出しておいて、半兵衛をきめこむ修練はまだ幸にしてつまれて居りませんから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "権八をきめこむ、とはどういう意味なのか、益村にはてんでわからなかったし、べつにわかろうとも思わなかったが、なんとなく、金助よりも権八というほうが人柄に合うようには感じられた。",
              "citation": {
                "source": "滝口",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて約束だ、先斗町で豪遊ときめこむ、松平晃・藤山一郎・杉狂児・山一・石田と大一座で、ウイを飲み、大いに遊ぶ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "臙脂怨　伊兵衛と馬春堂とが、昼寝の狸をきめこむ事にした例の家の二階では、お粂をとりまいて、一座の男や女に土地の遊び人が二、三枚加わって、西陽の窓にすだれを垂れこめ、浅ましい眼色になりながら、手なぐさみのウンスンに夢中であります。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤穂城を明け渡す折に、家老ひとりで、一万両をよそへ隠したという世間の風評もあるから、思いきった普請をして、後は、何といわれようが、後生安楽にきめこむつもりだろうと、これは、大工の下職や左官などが、仕事場から帰り途での噂であった。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "東洋語としての日本語の統体が欧米語によって煩わされること今日のごとく甚しい場合に、我々の日用語が大部分外来語だといって無関心をきめ込むのは識見においていささか欠けるところがありはしないだろうか。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで始めはここ一か年休学して養生せねばと思っていたのを、この分ならば差しつかえもあるまいという気になり、取りあえず手紙で大木に相談すると、君がやって見ようという気になったのならば、むろんやるべしじゃ、あまり消極的に考えて、自分から病人ときめ込むのは、大いにおもしろくない。",
              "citation": {
                "source": "廃める",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "店頭へ来て、桝飲みをきめ込む輩も、日に二人や三人はあるんだから、そういう奴が飛び込んだら、ここの呑口をこう捻って、桝ごと突き出してやるんさ。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは自分の買って出るような事件があるかないかを当たって見るので、ないとなるとフンといったような顔つきで同心控え室の片すみに陣取り、もう右門党のみなさまがたにはおなじみな、あのひげをぬく癖をあかずにくりかえしくりかえし、半日でも一日でも金看板のむっつり屋をきめ込むのがそのならわしでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "青眉の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "怒るたんびに泣かせられるだけなら、まだ余裕もあるけれども、金田君が近所のゴロツキを傭って今戸焼をきめ込むたびに、八っちゃんは泣かねばならんのである。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、言葉や文字の中には長い間にちよい／＼間違つて了つて、鰒を河豚だと思ふやうな人も少しは出來たりしたが、それをまた訛言だの、方言だのと、物識り顏に、ごりがんをきめ込むこともない。",
              "citation": {
                "source": "ごりがん",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "小面倒な着物なンか脱いでしもうて、毛深い体丸出しの赤裸々黒条々をきめ込む。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "果して見るだけ見、たたくだけたたいてみたがんりきの百蔵は、なあんだ、つまらないという面をして、以前のところへ戻って来ると、弁信法師は相変らず縁に腰をかけていたが、茂太郎は再び九太夫をきめ込む。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが私の流浪していた昭和初頭の頃、上方には東京のような酒屋の店頭で、一杯十銭の兜酒をきめ込むあの設備はできていなかった。",
              "citation": {
                "source": "わが寄席青春録",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "五百や一貫費ひ込んで、尻喰ひ觀音をきめ込むこちとらとはわけが違ふ」「成程ね」「腹を切つた武家があつたら、その妻子はどうなつたか念入りに訊き出すんだ」「腹を切らなかつたら何うします」「百梃の鐵砲は公儀に取上げられてしまつた。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "八千兩異変",
                "note": "青空文庫"
              }
            },
            {
              "text": "待っていたようにハイチャイ極め込む。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に葉書や書翰箋の類が品切れだと、好い口実にして、彼方此方へ御無沙汰を極め込む。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉と霊とを峻別し得るものの如く考えて、その一方に偏倚するのを最上の生活と決めこむような禁慾主義の義務律法はそこに胚胎されるのではないか。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "渠奴の長処は妙に記憶が好いので日本の新聞雑誌を読んで外国通を極込むのだ。",
              "citation": {
                "source": "犬物語",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
