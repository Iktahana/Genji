[
  {
    "uuid": "916d2598-07bb-5041-b766-1f1e0f19d5a9",
    "entry": "決め込む",
    "reading": {
      "primary": "きめこむ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
