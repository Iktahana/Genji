        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ムラカラ　ムラヘ　コジキヲ　シナガラ、ニホンノ　アシデ　テクテク　アルイテ　イツタノデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キイテ　ヰタ　トシヨリハ　フカイ　タメイキヲ　ツイテ、「センサウハ　モウ　タクサンデス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ミナサン、ゲンキヲ　ダシナサイ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲンキヲ　ダシテ、フミアラサレタ　ハタケヲ　タガヤシ、ムギノ　タネヲ　マキマシヨウ」ト　ヲトコハ　ヒトビトニ　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒトビトハ　ゲンキヲ　ダシテ　ハタケデ　ハタラキハジメマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、マダ　アカチヤンヲ　ダツコシテルヤウナ　テツキヲ　シテ　オウチヘ　カヘツテ　キマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナノ　モノハ　タメイキヲ　シテ　カホヲ　ミアハセマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十世紀ニ命ジテ十九世紀ニ背クヲ禁ズル革命論ノ多キヲ不審ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家生産ノ勞働者ニ利益配當ヲ用ヒザル所以ハ、國家ハ全生産ノ永遠的經營ヲ本旨トスルガ故ニ、全國家ノ生産的活動ノ爲ニ或省ニハ殊更ニ投賣ヲ行ハシメテ損失ヲ顧ミザルコトアル如ク、或ル省ヲ犧牲トシテ或省ノ對外競爭ヲ專ラナラシムルコトモアルベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯ル場合ニ於テ各別ニ利益配當ヲナス時ハ非常ナル不公平ヲ生ジ甲省ノ勞働者ノ利益配當ヲ奪ヒテ乙省ノ其レニ與フルガ如キヲ生ズベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "體刑ヲ課スル所以ハ國家ノ兒童ヲ保護スルニ最モ嚴勵ナルベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母共ニナキ兒童ヲ孤兒院ニ收容セザル所以ハ、孤兒院ノ弊害甚ダシキト、兒童ノ保護者トシテ血族長者ノ保護ニ優ル者ナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ヲ男子ト同一ニ教育スル所以ハ、國民教育ガ常識教育ニシテ或ル分科的專攻ヲ許スベキ年齡ニ非ルト共ニ、滿十六歳マデノ女子ハ男子ト差別スベキ必要モ理由モナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本海ヲ庭池トシテ南北滿州ト極東西比利亞トニ革命大帝國ヲ建ツル時、朝鮮ハ特ニ其ノ心臟肺肝ノ重キヲナサントス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "數百年間ノ半亡國史ハ實ニ朝鮮人ノ道念ヲモ生活ヲモ腐敗シ盡シタルヲ以テ、眞ノ國家的覺醒アル鮮人ハ之ヲ現在新精神ニヨリテ教育セラレツツアル人々ノ生長ニ待ツノ外ナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "比等ノ領土内ニ在郷軍人團ナキヲ以テ、國家任命ノ改造執行機關ヲシテ土地資本財産ノ調査徴集ニ當ラシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ改造ヲ終リタル後ニ着手スル所以ハ、無智ト事情不通トノ爲メニ日本内地ト同時ニ着手スルトキハ、内地ノ紛囂ヲ誤傳シタル不安騷擾ヲ釀スベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ノ理由ハ在郷軍人團ナル好適ノ機關ナク、今ノ植民政策的頭腦ノ總督府等ニ此ノ大任ニ當ラシムルハ明白ニ不正不義ヲ殘シテ改造ノ精神ヲ傷クルノミナラズ、或ハ意外ノ變ヲ招クベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三ノ理由ハ三年間ノ日月ハ日本ノ整然タル改造組織ヲ傳聞セシムルニ十分ナルガ爲メニ、日本大多數國民ノ歡喜ヲ傳ヘテ彼等ノ大多數國民亦速ニ其ノ福利惠澤ニ浴センコトヲ欲スルニ至ルベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ニ白人ノ新移住者印度人支那人ノ移住者ガ取得スル所ヲ、已ニ早ク日本國民タリシ彼等ニ拒絶スベキ理由ナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ル理想又ハ或ル信仰ニ基キテ徴兵ヲ在否セントスル者ノ歐米ニ多キヲ以テ、日本ガ國家ノ權利トシテ主張スルヲ非議スル者アラン。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來「クエーカー」宗ノ如キ又淺薄ナル非戰主義ノ如キヲ輸入シテ徴兵忌避ヲ企ツル者アラバ、刑罰ハ斷々トシテ其ノ最モ重キ者ヲ課シテ可ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ其ノ兵質ガ、前註説明ノ如ク今ノ少尉級ニ匹敵スベキヲ以テ自ラ現役年限ノ短縮トナルベク、一年又ハ一年半ノ軍隊的軍艦的訓練ハ如何ナル專門的使命アル者モ身心ノ根源ヲ培養シテ其ノ使命ノ大成ヲ準備セシムル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "米支兩國ノ排日ニ省悟一番シテ日露戰爭ノ天道宣布ニ歸ル時、日本ハ排日ノ實ニ天寵限リナキヲ見ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國政ヲ執ツテ國ヲ亡ボサントスル斯クノ如キ者ニ加フベキ大逆罪ノ法文ナキヲ如何セン。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "過去ニ歐米ノ思想ガ日本ノ表面ヲ洗ヒシトモ今後日本文明ノ大波濤ガ歐米ヲ振撼スルノ日ナキヲ斷ズルハ何タル非科學的態度ゾ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヘ上ルノニ、トチュウデ何ンベンモヤスンデ、イキヲ入レナケレバナラナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ母ッチャハネタキリデ、目アナガウントヒッコンデ、ダマッテミテイルト、イキヲスルタビニウゴイテイタフトンガ、ダンダン分ラナイグライニナッテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イアイダ、タベモノヲ見タコトモナカッタトコロヘ、ハジメテソウシキノオソナエモノヲミルト、モウ矢モタテモタマラズ、目ガクラクラットシテ、ソレニ小サイ弟ヤ妹ナノデ、死ンダオ母ッチャニワルイトオモイナガラ、スキヲネラッテ、ミンナデムチュウニナッテタベテシマッタンダッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガヤノ人タチハ、ソレヲキイテイルウチニ、一人一人ミンナモライ泣キヲシテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
