          "literary": [
            {
              "text": "それから、ひまがあれば、選挙候補者の演説を聞き歩くことにしました。",
              "citation": {
                "source": "心の芽",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が明けるのを待ち兼ねて近所のものに聞き歩くと、「何でも、年内は東大寺御参詣とか伺いましたが、正月は長谷寺にお籠りとも聞きました」　という返事である。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十二巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日、同じ姿で聞き歩くのも変なので、俄屑屋を思いついた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
