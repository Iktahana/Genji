        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "内に居る身狭乳母・桃花鳥野乳母・波田坂上刀自、皆喜びと、不安とから出る歎息を洩し続けてゐる。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "志斐｜嫗の負け色を救ふ為に、身狭乳母も口を挿む。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "身狭乳母の思ひやりから、男たちの多くは、唯さへ小人数な奈良の御館の番に行けと言つて還され、長老一人の外は、唯｜雑用をする童と奴隷位しか残らなかつた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "何から何まで縛りつけるやうな身狭乳母に対する反感が、此で幾分帳消しになる気がするのであらう。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "身狭乳母は、今の今まで、姫の側に寄つて、後から姫を抱へて居たのである。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、身狭乳母の計ひで、長老は渋々、奈良へ向いて出かけた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "内に居る、身狭乳母・桃花鳥野乳母・波田坂上刀自、皆｜故知らぬ喜びの不安から、歎息し続けてゐた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "志斐嫗の負け色を救ふ為に、身狭乳母も口を※む。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "づうと這ひ寄つて来た身狭乳母は、郎女の前に居たけを聳かして、掩ひになつた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其を聞くと、身狭乳母は、激しく、田舎語部の老女を叱りつけた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "郎女の声・詞を聞かぬ日はない身狭乳母ではあつた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "身狭乳母の思ひやりから、男たちの多くは、唯さへ小人数な奈良の御館の番に行け、と言つて還され、長老一人の外は、唯｜雑用をする童と、奴隷位しか残らなかつた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "何から何まで縛りつけるやうな、身狭乳母に対する反感も、此ものまねで幾分、いり合せがつく様な気がするのであらう。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、身狭乳母の計ひで、長老は渋々、夜道を、奈良へ向つて急いだ。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "内に居る、身狭乳母・桃花鳥野乳母・波田坂上刀自、皆故知らぬ喜びの不安から、歎息し続けていた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "志斐嫗の負け色を救う為に、身狭乳母も口を挿む。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずうと這い寄って来た身狭乳母は、郎女の前に居たけを聳かして、掩いになった。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "郎女の声・詞を聞かぬ日はない身狭乳母ではあった。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "身狭乳母の思いやりから、男たちの多くは、唯さえ小人数な奈良の御館の番に行け、と言って還され、長老一人の外は、唯｜雑用をする童と、奴隷位しか残らなかった。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "何から何まで縛りつけるような、身狭乳母に対する反感も、此ものまねで幾分、いり合せがつく様な気がするのであろう。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "身狭乳母は、今の今まで、姫の側に寄って、後から姫を抱えて居たのである。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、身狭乳母の計いで、長老は渋々、夜道を、奈良へ向って急いだ。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "内に居る、身狹乳母・桃花鳥野乳母・波田坂上刀自、皆故知らぬ喜びの不安から、歎息し續けてゐた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "志斐嫗の負け色を救ふ爲に、身狹乳母も口を※む。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "づうと這ひ寄つて來た身狹乳母は、郎女の前に居たけを聳かして、掩ひになつた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "其を聞くと、身狹乳母は、激しく、田舍語部の老女を叱りつけた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "郎女の聲・詞を聞かぬ日はない身狹乳母ではあつた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "身狹乳母の思ひやりから、男たちの多くは、唯さへ小人數な奈良の御館の番に行け、と言つて還され、長老一人の外は、唯｜雜用をする童と、奴隷位しか殘らなかつた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "何から何まで縛りつけるやうな、身狹乳母に對する反感も、此ものまねで幾分、いり合せがつく樣な氣がするのであらう。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "身狹乳母は、今の今まで、姫の側に寄つて、後から姫を抱へて居たのである。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
