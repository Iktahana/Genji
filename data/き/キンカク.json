[
  {
    "uuid": "160ef38f-f543-5d37-95ea-60195810041e",
    "entry": "勤恪",
    "reading": {
      "primary": "きんかく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "faithful service",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の勤恪な態度は誰もが認めるところだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "勤恪に職務を遂行する姿勢が彼を昇進させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "勤恪さは何より重要な資質である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "白い綺麗な陶器でできているんだが、ちょうどおまるのような大きさの、そしてまたそんな形のもので、そのきんかくしにあたるところに水と湯との二つの栓がついている。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、いって、つぎの日　さっそく　あんこくじに　つかいを　よこして、「あす　小ぞうの　しゅうけんを　つれて　きんかくじに　きなさい。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしみつ公は　そのころ　あたまを　そって　ぶつもんにはいり、天山と　いいましたが、きんかくじを　たて、そこに　すんで　いたのでした。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しょうぐんさまから　まねかれる　ことは　大へんな　めいよですから、おしょうさまは　さっそく　しゅうけんを　つれて　きんかくじに　いきました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
