        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "眼科検査で私の近点は25センチメートルと測定された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "加齢とともに眼の近点は次第に遠ざかっていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "このレンズの近点距離は20センチメートル以上必要である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 2,
        "gloss": "periapsis",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
