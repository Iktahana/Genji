        "examples": {
          "standard": [
            {
              "text": "央行による金融引き締めで、融資が厳しくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "インフレ対策として、政府は金融引き締めを実施することを決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "金融引き締めの影響で、新興企業の資金調達が難しくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "戦後のインフレ抑制を狙った金融引き締め政策、ドッジラインが発表された直後の一九四九（昭和二十四）年四月二十三日、日本電気経営陣は「会社再建に関する新提案」をまとめて、労働組合に提示した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドッジラインに沿った金融引き締め策によって不況風が吹きはじめた直後の一九四九（昭和二十四）年四月には、日本電気は工場や研究所の閉鎖、人員整理に追い込まれた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
