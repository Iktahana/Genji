    "definitions": [
      {
        "index": 1,
        "gloss": "to cut up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "獣医が検査のため、臓器を切り裂いて調べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "布を切り裂いて、何本かの切れ端にした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "鋭い爪で彼のシャツを切り裂いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "著者の心の上には、常に極地の侘しい曇天があり、魂を切り裂く氷島の風が鳴り叫んで居る。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "振幅がもの凄く広くなり（約三十フィートか、またはそれ以上）、しゅっしゅっと音をたてて降りてくる勢いが鉄の壁さえ切り裂くくらいであっても、数分間というものはそれのすることはやはり私の外衣を擦り切ることだけであろう。",
              "citation": {
                "source": "落穴と振子",
                "author": "THE PIT AND THE PENDULUM",
                "note": "青空文庫"
              }
            },
            {
              "text": "（……）　切り裂くような大戦慄が全身を走った。",
              "citation": {
                "source": "不思議なる空間断層",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "柵外の道路を隔てた小川の縁の、竹藪にかこまれた藁屋根では間断なく水車が廻り、鋼鉄の機械鋸が長い材木を切り裂く、ぎーん、ぎん／＼、しゆツ／＼、といふ恐ろしい、ひどく単調な音に、そしてそれに校庭の土手に一列に並んでゐる松の唸り声が応じ、騒がしい濤声のやうに耳の底に絡んだ。",
              "citation": {
                "source": "途上",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "「このいずれかをＰＣシリーズの上位機種として事業化したとしても、とても売れるとは思えない」　渡辺は、重苦しい空気を切り裂くようにそう断言した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "頸を締めたうえに、頸動脈まで切り裂くとは……」　だが、これは随分御丁寧な殺し方である。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ち空気を切り裂くやうな、叫声が響いた。",
              "citation": {
                "source": "フロルスと賊と",
                "author": "クスミン　Mikhail Alekseevich Kuzmin",
                "note": "青空文庫"
              }
            },
            {
              "text": "断末の苦しみは強烈で、激しく、身を切り裂くようで、デンは頭から足まで汗びっしょりになった。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "空気はまるでナイフで切り裂くように冷たい。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然宇治の背後で、空気を切り裂くような鋭い女の叫び声が上った。",
              "citation": {
                "source": "日の果て",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘は口をあいて喘ぎながら、そっと片手を伸ばし、死躰の顔へ当てがっていたが、やがて、なにかを切り裂くように、喉をしぼって悲鳴をあげ、うしろさがりに、死躰からはなれた。",
              "citation": {
                "source": "あすなろう",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲間のサーファーのボードが水を切り裂くのを見ながら、したたかに海水を飲みこむ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "サーフボードの右側のレールが、鋭い音をあげて水を切り裂く。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "完全には忘れないまでも、さっくりと鋭く心を切り裂くような鮮明さとともにすべてを思い出すことは、やがて不可能になるかもしれない、と邦子は覚悟した。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェトコンは、あるひとつの村にしのびこみ、腐敗した指導者の喉を切り裂く。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "またもや舞台から絶叫が空気を切り裂くと、あたかも手品のように控えの間に武装軍隊が現れた。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然切り裂くような金切り声がキャーと上がり、大きなシャンデリアが落ちるぞ、と大声。",
              "citation": {
                "source": "見えざる力",
                "author": "THE INVISIBLE FORCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "（海峡の間を一路風をきりさくようにしてゆけば、怒れる波は船を打ちつけて船窓に波の音がひびく。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時、自他ともに「斬り裂くジャック」と呼んで変幻きわまりなく、全ロンドンを恐怖の底に突き落としていた謎の殺人鬼があった。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、こうして屍体にばかり気を取られていた発見者の横を、影のようにするりと抜け出たであろう「斬り裂くジャック」は、すぐその足でアルドゲイトのミルト広場へ立ちまわり、四十五分後には、また一人キャザリン・エドウスという辻君を殺害し、やはり陰部から下腹を斬り裂いて、子宮を取っている。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "この「斬り裂くジャック」が現下の視聴を集めているので、なにか素晴しい人気者かなんぞのように勘違いし、そうでないまでも、ひとつ面白いから騒がしてやれなんかという好奇な閑人があってかかる不届きな悪戯を組織的に始めないともかぎらない。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「斬り裂くジャック」は、職業的に、あるいは趣味的に、この売春婦という社会層に属する女だけを選んで、斬り裂くのである。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "斬り裂く――文字どおり、生殖器から上部へかけて外科的に切開し、引裂するのだ。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "この、被害者の生殖器にかかる残虐を加える一事こそは、「斬り裂くジャック」の全犯行を貫く共通な大特徴で、また一世を怖慄せしめたセンセイションの真因でもあった。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人妖「斬り裂くジャック」は前後をつうじて、たった一度一人の人間に顔を見られて話をしている。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "被害者は葡萄を食べながら犯人と談笑して、その商取引を終るやいなや、ただちに「斬り裂くジャック」の狂刃の下に、名の示すごとく、両脚の間を腹部まで「斬り裂」かれたものであることが容易に推測される。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の証言が口火となって、その男こそ「斬り裂くジャック」に相違ないといっそう騒然と大緊張をきたしている最中だ。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンドン中が「斬り裂くジャック」の就縛を熱望して爪立ちしていることは、パッカアはもっとも熟知していたはずの一人である。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "子宮を奪うためならなにも売春婦にかぎったわけではなく、普通の婦人のほうがより健康な、より清潔な子宮をもっていて、商品としての目的にも適したはずだから、この子宮売買説は、「斬り裂くジャック」の場合当てはまらないといわなければならない。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにおいて「斬り裂くジャック」は精神病者に相違ないとの見込みが、まず必然的に立てられたのだった。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
