        "examples": {
          "standard": [
            {
              "text": "勇敢な騎士は敵の将軍を切り伏せて戦況を変えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "歴史小説の中で主人公は多くの兵士を切り伏せる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "剣豪は相手の刀を弾いて一撃で敵を切り伏せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "遂に武蔵、一同を斬り伏せる。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏、菩薩では、不動明王は煩悩を智の利剣で斬り伏せる折伏門係り、観世音は慈悲で智慧を育て上げる摂受門係りであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに引きかへ土耳古軍には、十人の手勢にてよく一聯隊の敵を斬り伏せるてふ、勇猛果敢の将軍ありき。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、一刀両断とか、言語道断とか、それに似てバッサリと斬り伏せる趣きは充分現れているから、文を学べば、一かどの文士になった人物かも知れない。",
              "citation": {
                "source": "巷談師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏切りを宣言した瞬間からわたしの生命はたちまち危険に瀕するわけですが、阪井の扶持から離れるとたちまち無一文になってしまうこのわたしが、廃人同様の男を抱え、どういう武器で阪井を斬り伏せるのか、しかし、なにがなんでもやりぬくほかはないと、夕暮の窓に佇みながら心はむらむらと燃えたつばかりでした。",
              "citation": {
                "source": "ハムレット",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地者には、この二人のあぶれ者を一緒に相手にして、見事に斬り伏せるやうな、そんな腕の立つ人間はありません」　喜八の説明は如何にもよく行屆きます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "狐の嫁入",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地者には、この二人のあぶれ者を一緒に相手にして、見事に斬り伏せるような、そんな腕の立つ人間はありません」　喜八の説明はいかにもよく行届きます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "狐の嫁入",
                "note": "青空文庫"
              }
            },
            {
              "text": "拝打、輪切、袈裟掛、はて、我ながら、気が冴え、手が冴え、白刃とともに、抜けつ潜りつ、刎越え、飛び交い、八面に渡って、薙立て薙立て、切伏せると、ばさばさと倒れるごとに、およそ一幅の黒い影が、山の腹へひらひらと映って、煙が分れたように消える、とそこだけ、はっと月が射して、芭蕉のあとを、明るくなる。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
