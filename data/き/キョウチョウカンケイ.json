        "examples": {
          "standard": [
            {
              "text": "両国は長年にわたる協調関係を基盤に、新たな貿易協定を締結した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "企業と行政が協調関係を築くことで、地域の課題を効率的に解決できた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "創業メンバー同士の協調関係が崩れ始め、会社の経営に支障をきたした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ＩＢＭにベーシック以外の言語も求められたマイクロソフトには、デジタルリサーチをこのプロジェクトに引きずり込んでともに全力疾走するか、言語とＯＳで棲み分けるという従来の協調関係を清算して、別の新しいＯＳに言語を対応させるかの二つの選択があった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
