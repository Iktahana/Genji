        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すなわちそれは競争性と筋肉操作の二作用である。",
              "citation": {
                "source": "スポーツの美的要素",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "また競争性も単に麻雀のごとく知的の場合もスポーツの意味の外にある。",
              "citation": {
                "source": "スポーツの美的要素",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "競争性の意味は本質的に量的比較でなければならない。",
              "citation": {
                "source": "スポーツの美的要素",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "５　しかし、かくのごとき喜びは競争性自体のもつ組織性、数学性、力学性に関連する対象的美感にしかすぎない。",
              "citation": {
                "source": "スポーツの美的要素",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまでのべたのは競争性の美的要素である。",
              "citation": {
                "source": "スポーツの美的要素",
                "author": "中井正一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
