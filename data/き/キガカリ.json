[
  {
    "uuid": "61649c49-021f-5d1d-a753-7ce4c3b91a60",
    "entry": "気がかり",
    "reading": {
      "primary": "きがかり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
