    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to cut at",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "敵の兵士が彼の腕を剣で切りつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "侍は素早い身のこなしで相手を切りつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "誤って刃物で腕を切りつけてしまい、血が出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "どちらが悪いとかいいとか」「ええ、内匠頭の短慮と吝嗇はよく知っていますが、殿中で切りつけるには、よくよく堪忍のできぬことがあってのことだろうというので、やはり同情されています。",
              "citation": {
                "source": "吉良上野の立場",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、抜打ちに死骸に切りつけると、大ドロあって、浪幕の間より、代りの戸板が差し出されて、骸骨を載せたまま、本水の中を花道指して流れ行くのであった。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、たぶん切りつける所作の拍子に、逢痴の咽喉を刺したのかも知れませんよ。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人が刀を抜いて切りつけると、女は走つて海へ飛びこんだ。",
              "citation": {
                "source": "河童の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "額ざまに切りつけるぞ――。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はすかさず、「そんな忘れっぽい人に、いくら実をつくしても駄目ですわねえ」と嘲けるごとく、恨むがごとく、また真向から切りつけるがごとく二の矢をついだ。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうか、そんなことをおっしゃらないで……」　茜さんは、切りつけるような調子で、「結構よ。",
              "citation": {
                "source": "キャラコさん",
                "author": "蘆と木笛",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、叫んで切りつける）　この通りにやったのです。",
              "citation": {
                "source": "撮影所殺人事件",
                "author": "酒井嘉七",
                "note": "青空文庫"
              }
            },
            {
              "text": "懐剣を抜いて切りつける。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "六郎、橘から手を外し、左手で橘を押さえつけながら、刀を抜いて寄ってくる千鳥の肩先を切りつける。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "こん畜生とか、みやがれとか叫びながら、力まかせに切りつけるのである。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、腰にさげた剣をぬいて、いきなり三人に切りつけるのではないでしょうか。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ふたりが口をそろえて、切りつけるように、さけびました。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「とはいうものの、善悪のけじめははっきりつける娘だ」カーはもの思いにふけるようにつづけた。",
              "citation": {
                "source": "井戸",
                "author": "Ｗ・Ｗ・ジェイコブズ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
