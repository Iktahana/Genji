          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "レポートの期日が明日なので、今夜は徹夜になりそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "プロジェクトの期日を再設定する必要があるかもしれません。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "期日を過ぎてしまうと、ペナルティが発生する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「期日は厳守でお願いします」と上司は釘を刺した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
