        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女の切ない歌声に、胸がキュンキュンした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "映画のクライマックスで、主人公たちのロマンスにキュンキュンしっぱなしだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「この漫画、イケメンだらけで毎回キュンキュンしちゃう！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "学生時代の淡い恋を思い出して、なんだかキュンキュンする気持ちになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "テレフンケン・システムの大きな蛇のようなスパークがキュンキュンと音を立ててひらめいては消えるのを見た。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "静寂を破るのは、はあはあと荒い息をする三人の男と、片隅でキュンキュン震えているデンの犬だけ。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　犬がキュンキュン鳴き、全身を震わせた。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてテントの方へ向きを変え、時々キュンキュン鳴いては立ち止まり、とうとう一目散に走って行った。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
