        "examples": {
          "standard": [
            {
              "text": "せっかくのパーティーが、彼のネガティブな発言で台無しになった。まったく、興を冷ます天才だよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「ちょっと、そんなこと言わないでよ！」と、彼女は興を冷ます彼に軽く注意した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "盛り上がっている最中に、急に現実的な問題点を指摘して興を冷ます人がいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「みんなで楽しもうよ。興を冷ますのはやめよう」と、リーダーが提案した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
