        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "上賀茂神社で曲水の宴が催され、装束を纏った人々が和歌を詠んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "曲水の宴では、流れてくる杯が自分の前を過ぎるまでに歌を詠み上げなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "平安時代の宮廷文化を再現した曲水の宴に、多くの観光客が訪れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "其が形式化して曲水の宴ともなつたので、通常伝へる処では、魏の後、上巳をやめて三日を用ゐる様になつたが、名前は依然、上巳で通つてゐるのだといふ。",
              "citation": {
                "source": "雛祭りの話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其が形式化して、曲水の宴ともなつた。",
              "citation": {
                "source": "偶人信仰の民俗化並びに伝説化せる道",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "醍醐の花見や、加茂の葵祭、観学院の曲水の宴、さては仙院の五節舞などというありきたりな風流ごとにはどうしてもなじめない。",
              "citation": {
                "source": "無月物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "醍醐の花見や加茂の葵祭、勧学院の曲水の宴、仙院の五節舞、そういうありきたりな風流にはなじめない。",
              "citation": {
                "source": "無月物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから岡倉先生らしいのは、友だちをいろいろ呼んで、本田種竹だの其他の文墨関係の人がたくさん来ましたし、曲水の宴をやった。",
              "citation": {
                "source": "美術学校時代の岡倉先生",
                "author": "板谷波山",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
