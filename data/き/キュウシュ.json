  {
    "uuid": "39541b7a-467b-5f34-890a-f7f8dd64868c",
    "entry": "旧守",
    "reading": {
      "primary": "きゅうしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "気品は旧守でもなく、また新奇でもない。",
              "citation": {
                "source": "梅花の気品",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の演奏には旧守派の固陋さも、徒らにチェロを唄わせる芝居気もない。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "松原郡太夫の一派は旧守派で、ただこれ古い権力政治を押通そうとしていた。",
              "citation": {
                "source": "夜明けの辻",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉報を受けた筈の沈団長は、あれから十日もたたぬうちに、何故か、突然、箇旧守備隊長に転補され、腹心の僅かな将校と兵を伴なって、前線から、この街へ着任したのだ。",
              "citation": {
                "source": "雲南守備兵",
                "author": "木村荘十",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
