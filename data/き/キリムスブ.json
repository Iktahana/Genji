    "definitions": [
      {
        "index": 1,
        "gloss": "to cross swords (with)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
