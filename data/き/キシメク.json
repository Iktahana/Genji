        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　馭者が馬を追う声がして、ぎしぎしと車体の軋めく音が近付いて来た。",
              "citation": {
                "source": "熊の出る開墾地",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝・木の葉の相｜軋めく音が、やむ間なく聞える。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝・木の葉の相軋めく音が、やむ間なく聞える。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "暴風が起って、海が荒れて、波濤があの小家を撃ち、庭の木々が軋めく時、沖を過ぎる舟の中の、心細い舟人は、エルリングが家の窓から洩れる、小さい燈の光を慕わしく思って見て通ることであろう。",
              "citation": {
                "source": "冬の王",
                "author": "ハンス・ランド　Hans Land",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は私の背後に太いロップや金具の緩く緩くきしめく音を絶えず感じながら、その船首に近い右舷の欄干にゆったりと両の腕をもたせかけている。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "風の夜をりをりに気が附くと、屋外には嵐……戸が寒相にわななき、垣と軒がきしめく……どこかで幽かに鳴る二点警鐘……子供等を寝かせたのはもう昨日のことのやうである。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "心のきしめく時必ず神をよんだ。",
              "citation": {
                "source": "（私はさきごろ）",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
