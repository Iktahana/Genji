          "literary": [
            {
              "text": "何じゃ、片仮名をもってキミョウニナオル丸、疝気寸白虫根切、となのった、……むむむむ疝気寸白は厭わぬが、愚鈍を根切りの薬はないか。",
              "citation": {
                "source": "白金之絵図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それからキミョウニナオル丸、牛豚開店までやりやがって、按摩ン許が蒲生鉄斎、たつじんだ、土瓶だとよ、薬罐めえ、笑かしやがら。",
              "citation": {
                "source": "白金之絵図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミョムリョジュノライ　すると　なたねばたけの　なかに　うさぎが　いて、「こぼうず　あおぼうず。",
              "citation": {
                "source": "こぞうさんの　おきょう",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
