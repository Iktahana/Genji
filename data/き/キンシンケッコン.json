        "examples": {
          "standard": [
            {
              "text": "ヨーロッパの王族は歴史を通じて近親結婚を繰り返してきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "遺伝学的リスクを踏まえて、ほとんどの現代社会では近親結婚は法律で禁止されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "民族学の論文で、近親結婚と社会構造の関係性が詳細に分析されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "秋田犬はテンパーに弱くて死に易いように近親結婚の結果、繁殖率が低くなって絶滅を辿るのみであるという。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての医学的な証拠によりアプリアの住民は近親結婚が多く精神病に罹るものが多くタランタティの大部分が神経症であったことは疑いが無い。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんでも近親結婚の非を説いているところであったが、その数々の理由のなかに、「そのような婦人に対して注ぐ情愛は無節制に陥る危険がある。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
