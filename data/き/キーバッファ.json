        "examples": {
          "standard": [
            {
              "text": "キーボードから入力された文字はまずキーバッファに格納される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "キーバッファの容量が満杯になると、新しい入力が受け付けられなくなる可能性がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "キーバッファの制御によって、入力の順序が保証される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "マシンの側には、どのキーが押されたかを一時的に記憶しておくキーバッファーと呼ばれる小さなメモリーが用意してあるが、こうしたゲームに対応するためにはバッファーに記憶された内容をあらかじめ消しておかないと、以前に押されたキーの内容をユーザーからの指示と取り違えて、誤動作する可能性があった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで新しくキーバッファーの中身をクリアするための機能を付け加えると、それが思わぬところでじゃまをして今度は別のプログラムに問題が生じた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
