[
  {
    "uuid": "994a954d-6c47-56c2-abe6-22d26275fb18",
    "entry": "肝いり",
    "reading": {
      "primary": "きもいり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
