    "definitions": [
      {
        "index": 1,
        "gloss": "hewn stone",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "城壁はすべて切り石で造られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "庭園の通路には、立派な切り石が敷き詰められている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この石垣、切り石でできてるんだね。すごい！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "古い寺院の柱は、一つ一つが大きな切り石から削り出されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ひと足遅れてのぼり来る姫の息せまりて苦しげなれば、あまたたび休みて、ようよう上にいたりて見るに、ここはおもいのほかに広く、めぐりに低き鉄欄干をつくり、中央に大なる切り石一つすえたり。",
              "citation": {
                "source": "文づかい",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも今度の石にかぎって、それが大きい切り石であったので、猪上の右の眉の上からは生血がおびただしく流れ出した。",
              "citation": {
                "source": "父の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那」の切り石のような迫力との対照は、メイエルホリドがひととおりの才人でないことを知らされる。",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたずらに足の底に膨れ上る豆の十や二十――と切り石の鋭どき上に半ば掛けたる編み上げの踵を見下ろす途端、石はきりりと面を更えて、乗せかけた足をすわと云う間に二尺ほど滑べらした。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この石室の大きさや形は、いろ／＼種類がありますが、なかには綺麗な切り石で造つたものもありますし、また、さう手を加へない重さ何噸といふほどの大きな石を用ひて、造つたのも少くはありません。",
              "citation": {
                "source": "博物館",
                "author": "濱田青陵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、おじさんは、かきねの外がわの、切り石の上へ、自分がさきに腰をおろしました。",
              "citation": {
                "source": "春さきの朝のこと",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏は小広い空地ではあったが、地面には雑草がぼうぼうと生えて、ところどころに木立ちがあって、切り石などが置いてあった。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お石場にも、朝から、陽がかんかん照りつけて、捨て置きの切り石の影は、むらさきだった。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "悲願百両",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭は斜面になっていて、すぐり類の灌木が植えられ、野生の植物がいっぱいはえており、切り石のおおげさな突堤で限られていて、その突堤には二重の脹れのある柱の欄干がついている。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをよくながめる時、第一に不思議な点は、戸口は単なる破屋の戸口らしい粗末なものにすぎないのに、窓の方は、それがもし荒ら石の壁の中にあけられてるのでなく切り石の中にでもこしらえられてたら、りっぱな邸宅の窓としても恥ずかしからぬほどのものだった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "板の裂け目から彼は、いい加減にセメントで固めた素石や切り石をのぞき見ることができた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "監獄の懲戒規定によって囚人を勝手に放置しておくそれらの厳重な場所は、昔、石造の四壁と、石の天井と、切り石の床と、一つのたたみ寝台と、鉄格子をはめた一つの軒窓と、一つの鉄の二重扉とでできていて、地牢と呼ばれていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし地｜牢はあまりひどすぎるということになって、今日では、一つの鉄の扉と、鉄格子をはめた一つの軒窓と、一つのたたみ寝台と、切り石の床と、石の天井と、石の四壁とでできていて、結局同じではあるが、懲治監房と呼ばれている。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "フイイーはいつも扇の薄い骨を彩色するになれた指で、切り石を二所につんで石灰樽や馬車のささえにした。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "その切り石も他の物と同じく即座に取ってこられたもので、どこで得られたのかわからなかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして小さな切り石と塗装でもって、パリのほぼ総ての家屋に卑しい性格を与えているあの黄色い色を施していた。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "その石も巨大なるブッ欠きや、角の取れない切石や、石炭のかすのような「つぶて」で、一個一個としては、咸陽宮の瓦一枚にすら如かないものであるが、これが渾然として、富士山という創造的合成を築き上げたとき、草も、木も、人も、室も、この中へと融合同化してしまう。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は埋められて金蓮花の畑地にした平地の上に架かっている切石の橋や、枝振りよく枯れて立っている亀島の松によって、庭園は相当凝った、小堀遠州系の池泉廻遊式であったことが想像される。",
              "citation": {
                "source": "唇草",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、火切石にかねをぶつけたので、ぱっと火花がちりました。",
              "citation": {
                "source": "ひこうかばん",
                "author": "DEN FLYVENDE KOFFERT",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷たい何かの切石の上に、幽かな薄玻璃の鏡の如に坐つて居た私の前に何時からとなく現れてひたと一列に座つた八九人の児供がある。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は鋭く尖った頂きは無論の事、切石を不揃に畳み上げた胴中さえ所在がまるで分らない。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い矩形に作られている本館の中央は、半円形に突出していて、左右に二条の張出間があり、その部分の外壁だけは、薔薇色の小さな切石を膠泥で固め、九世紀風の粗朴な前羅馬様式をなしていた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、それ以外の部分は、玄武岩の切石積で、窓は高さ十尺もあろうという二段｜鎧扉になっていた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝珠院本堂の背後の縁下には、九つの大瓶が切石の上に伏せてある。",
              "citation": {
                "source": "堺事件",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと足遅れてのぼり来る姫の息｜促りて苦しげなれば、あまたたび休みて、漸う上にいたりて見るに、ここはおもひの外に広く、めぐりに低き鉄欄干をつくり、中央に大なる切石一つ据ゑたり。",
              "citation": {
                "source": "文づかひ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きい切石で脳天をぶち割られて。",
              "citation": {
                "source": "蜘蛛の夢",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔父の頭を石でぶち割ったというのは、その疵口ばかりでなく、血に染みた大きい切石がその近所に捨ててあったのを見て、すぐにそれと覚られたのだそうでございます。",
              "citation": {
                "source": "蜘蛛の夢",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともかくも暗い夜道を千駄ヶ谷の方角へたどって行きまして、広い草原のなかを探しあるいて、ここらの土のなかには強い袋蜘蛛がたくさんに棲んでいると教えたので、叔父は小さい蝋燭のひかりを頼りに、そこらを照らして見ると、善兵衛は足もとに転がっていた大きい切石を拾って……。",
              "citation": {
                "source": "蜘蛛の夢",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ためしに空鉄砲を放してみよう」といって、井上某が鉄砲を取りに立とうとすると、ぽかりと切石が眉間に当たって倒れました。",
              "citation": {
                "source": "江戸の化物",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんどは他の者が代わって立とうとすると、また、その者の横鬢のところに切石が当たったので、もう誰も鉄砲を取りに行こうという者もありません。",
              "citation": {
                "source": "江戸の化物",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
