        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今月號に於て同人淺沼の評論、金斗熔氏から頂いた原稿が載せられなかつたことを遺憾に思ふ。",
              "citation": {
                "source": "編輯後記（昭和二年一月號）",
                "author": "『青空』記事",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ朝鮮人のくせに、日本人から女房と金を貰って、金斗星先生や安――。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "朴鳳錫　金斗星先生の独立運動をスパイしてやがる。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
