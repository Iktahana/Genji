        "examples": {
          "standard": [
            {
              "text": "勤労感謝の日に合わせて、子どもたちが保育園で農家の人々への感謝の絵を描いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "毎年勤労感謝の日には家族で近くの農場を訪れ、収穫体験をするのが恒例になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "勤労感謝の日は十一月二十三日で、もともと新嘗祭に由来する国民の祝日だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "（昭和二十九年一月一日）二　感謝祭の七面鳥　戦後になって、勤労感謝の日などという下手な名前に変ったが、昔の新嘗祭というのは、なかなかよい名前であった。",
              "citation": {
                "source": "御馳走の話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
