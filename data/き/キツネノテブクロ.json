          "literary": [
            {
              "text": "きの　そばに、　キツネノテブクロが　あるの　わかる？",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ、　どうして　キツネノテブクロって　いうか　しってる？",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "せのたかい　キツネノテブクロを　みつけると　このあたりの　きりかぶは　どうかなと　おもいまして。",
              "citation": {
                "source": "みずかきジェマイマのはなし",
                "author": "THE TALE OF JEMIMA PUDDLE-DUCK",
                "note": "青空文庫"
              }
            },
            {
              "text": "つれてこられたのは、　キツネノテブクロが　たくさん　はえた　おくの　おくにある　いっけんの　わびごやでした。",
              "citation": {
                "source": "みずかきジェマイマのはなし",
                "author": "THE TALE OF JEMIMA PUDDLE-DUCK",
                "note": "青空文庫"
              }
            }
