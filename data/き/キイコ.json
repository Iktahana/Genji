        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――寒子は沈黙つて立ち上ると、部屋の隅に、埃だらけになつてゐる蓄音機の蓋をあけて、キイコキイコ捻をまはした。",
              "citation": {
                "source": "瑪瑙盤",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "風が出たのか、ガクガクの雨戸が、難破船のようにキイコ、キイコゆれて、チェホフの小説にでもありそうな古風な浜辺の宿、十一月にはいると、もう足の裏が冷々とつめたい。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
