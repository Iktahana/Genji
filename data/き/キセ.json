[
  {
    "uuid": "3d827ded-31f6-5cfc-b40e-3326c56be832",
    "entry": "被せ",
    "reading": {
      "primary": "きせ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
