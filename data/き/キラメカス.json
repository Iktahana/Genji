        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "五十川女史のそばにすわって、神経質らしく眉をきらめかす中老の官吏は、射るようないまいましげな眼光を時々葉子に浴びせかけていたが、いたたまれない様子でちょっと居ずまいをなおすと、ぎくしゃくした調子で口をきった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人体よろしくない人山が、一せいに獰猛な歯をむき、サッと白刄をきらめかすと、わあッと異様な叫びをあげて、主水之介、菊路、京弥の三人めがけて襲いかかりました。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は時々ぎろりとした眼を薄闇い灯にきらめかす。",
              "citation": {
                "source": "しらくちの花",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼうぼうと激しい炎が唸りを立てて、猛火が、家内を一ぱいにきらめかすのが見えるのだった。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、誘って大刀をきらめかす。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……槍の穂先をきらめかす儀仗の小隊。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "防波堤の突端にある燈台の灯が、ゆるやかに、廻転しながら、夜の幕のうえに、光の条をきらめかす。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "西には毛勝、劔、立山の連脈が、よく見れば赤錆、青錆を吹いて、霜げ荒けた鉄の肌を、半ば氷化した万年雪に包んでガキガキに尖り、一斉に澄明な光りと影をきらめかす。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
