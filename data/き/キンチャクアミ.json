        "examples": {
          "standard": [
            {
              "text": "漁船は巾着網を使ってイワシの大群を一気に囲い込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "巾着網漁法は魚群を効率よく捕獲できるため、世界中の漁業で使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "巾着網の底を絞ることで、逃げ場を失った魚が一か所に集まる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "……巾着網よりも底曳網の方が有利だ……底曳網よりも爆弾漁業の方が多量の収穫を挙げる……というだけの話で、要するに比較的収益が多いというだけのものじゃないですか。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "尋常に巾着網や、長瀬網を引いている奴は、馬鹿みたようなもんで……ヘエ……。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
