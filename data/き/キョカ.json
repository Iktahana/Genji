  {
    "uuid": "0b1ea31f-afbd-561e-b552-388f9d5d3b80",
    "entry": "巨花",
    "reading": {
      "primary": "きょか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
