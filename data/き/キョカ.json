    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "水中巨花　やがて、またしても、海面が波立って、水底からスーッと白いものが浮き上がってくるのが見えた。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはどんな植物の本でも、一度も見たことのないような、ぶきみにも美しい桃色の巨花であった。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれはこれも人工のものにちがいないのだが、美女の巨花を背景に、青黒い水中を、うろこをにぶい銀色に光らせて、ヘビがくねくねと身をよじらせながら横切っていく光景は、やはり胸おどる妖異であった。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
