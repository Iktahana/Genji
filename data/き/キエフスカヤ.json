          "literary": [
            {
              "text": "カニョーフ　キエフスカヤ県カニョーフ郡の首都で、ドニェープルの河港。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェルカースイ　キエフスカヤ県チェルカースイ郡の首都で、ドニェープルの河港。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは彼女がまだ女学生時代にスタロ・キエフスカヤ街の或る邸で紹介された男であったが、今では名さえも思い出せなかった。",
              "citation": {
                "source": "頸の上のアンナ",
                "author": "АННА　НА　ШЕЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、馬丁が飛ぶように側を走り、馭者の代りにアルトイノフが馭者台に坐った二頭立てに乗って、アーニャがスタロ・キエフスカヤ街を疾走して来るのに出会うと、ピョートル・レオンチイッチはシルク・ハットを脱いで何か大声を上げそうにするのであった。",
              "citation": {
                "source": "頸の上のアンナ",
                "author": "АННА　НА　ШЕЕ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
