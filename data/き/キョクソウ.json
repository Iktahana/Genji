        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この地域のブナ林は極相に達した安定した森林生態系を形成している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "伐採された森林が植生遷移を経て極相に達するまでには、百年以上かかることもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "生態学の実習で、草原から極相の森林へと移り変わる遷移系列を観察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "寒さには閉口せしが、古を懷ふには、至極相應したる天氣也。",
              "citation": {
                "source": "石田堤",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "布恬廷　條約之儀昨年以來厚く御心配被爲在候て、御取極相成候儀に付、政府御不承知之儀無之事と存候處、はからずも右等之次第を承り驚き入候。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
