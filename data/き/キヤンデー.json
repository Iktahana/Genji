        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "関日の波多君が小学校の先生二人を同伴して来庵、アイスキヤンデーをかぢりながら暫時雑談、今日は私の雑草哲学を説く元気もなかつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "町を歩いて、嫌とも気のつくことはキヤンデー時代だといふことだ、こゝにもそこにもキヤンデー売店、そしてあの児もこの人もキヤンデーをしやぶつてゐる。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "□アイスキヤンデーの店でアイスキヤンデーの青いのを一本供養してくれた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつのまにやらアイスキヤンデー店が焼芋屋にかはつてゐる、季節のうつりかはりがはつきり解る。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰も彼もアイスキヤンデーを食べる、現代風景の一齣。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイスキヤンデーの看板が目についた。",
              "citation": {
                "source": "小さな村",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカのガムやキヤンデーなど、をかしくつて、近頃の子は、かへりみもしない。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
