        "examples": {
          "standard": [
            {
              "text": "二人の政治家は表面上は敵同士だが、実は水面下で気脈を通じているという噂だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "秘密組織の幹部たちが気脈を通じて、極秘の計画を進めていたことが後に判明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女は親友と気脈を通じるようにして、誰にも知られてはいけない秘密を守った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "いずれにせよ産物交易は、雲浜が長藩当路へ説きつけた論理に従うと、「他日御国（長州）天朝を御守護され候基本と相成るべき」もので、他日の政治的行動の端緒であり、京摂と長州が気脈を通じるための機関であり、物的根底たるべきものであるとした。",
              "citation": {
                "source": "志士と経済",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる場所で、かかる敵味方のあいだで、こういう密会をしているのを認められたら、直ちに、敵へ気脈を通じるものと疑われよう。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうやら、この邸内にも、一八郎へ気脈を通じる者がある様子でござりますぞ」「心得ぬことじゃ。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
