        "examples": {
          "standard": [
            {
              "text": "クリスマスイブの礼拝で、参加者全員が「きよしこの夜」を合唱した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女はピアノで「きよしこの夜」を静かに弾き始め、部屋に穏やかな雰囲気が漂った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "幼稚園の発表会で子どもたちが「きよしこの夜」を歌い、保護者たちは涙をぬぐった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "この三日間、夕食後に全員で〈きよしこの夜〉〈ジングル・ベル〉〈赤鼻のトナカイ〉を英語で歌う練習をしたのに、じっさいに晩餐まえにやったのは、〈ジングル・ベル〉だけなのは不満だが。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後の〈きよしこの夜〉が終わると、すべての灯が落とされた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
