        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "國家ノ徴集シ得ベキ資本ノ概算ハ推想スルヲ得ベキモ、其眞實ヲ去ル甚ダ遠キコトハ○○○○○ノ調査徴集ヲ必要トスル所以ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "成年者ガ三月又ハ半年ニテ足ル國際語ノ修得ガ、中學程度ノ兒童一二年ニシテ完成スベキコトハ、英語ガ五年間沒頭シテ尚何ノ實用ニ應ズル完成ヲ得ザル比ニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ下掲ノ如ク日本國民ハ永久ニ兵役ノ義務ヲ有シ、且ツ一年志願兵特權ハ此等ノ訓練アルヲ一理由トナスヲ以テ其レヲモ廢止スルガ故ニ、兵役ニ於テスベキコトハ凡テ兵營ニ於テスベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺産相續ニ際シテ國家ガ課税ノ理由ナキコトハ、相續者則非相續者ノ肉體的延長ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ驚クベキコトハ、彼等ノ中ニハ西洋人多ク混ジ居ルヲ認メタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "況テ宝器什物ノ有ル可キ様無ケレバ、必ズ曝サネバナラヌト云フコトモ無ケレド、午熱烈シキ比快キ風ノ吹キ入ルヽ小楼ニ、独リ古キ櫃ドモ取出デヽ、手ニ触ルヽ物ヲ列ラネ曝ス程面白キコトハ有ラジ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
