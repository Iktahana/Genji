        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "モシ、君ガ充分ノ親切心ト忍耐力トヲ保有シテイルナラバ、君ノ今日ノ用事ヲコノ紙片ニ書キシタタメテ欲シイ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "我輩ハソノ期間ニ、我輩自身ヲ我輩ノ私室ニ密閉シ、君ノ文章ヲ研究シ、シカシテ、我輩ノ答ヲ、我輩ノ能力ノ最大ヲ致シテ書キシタタメルデアロウ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘘ノ世ノ中ニハアキアキシタ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ此ノ話ヲ立チ聞キシタ時真ニ心カラ憤慨シマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
