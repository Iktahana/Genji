          "literary": [
            {
              "text": "すなわちそれはジャガタラズイセンとキンサンジコとベニスジサンジコ（牧野命名）の三種である。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャガタラズイセンは九州を主として東では豆州、房州辺でも今見られるがキンサンジコは既に絶滅したのかどうもそれが見付からない。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キンサンジコは金山慈姑の意である。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
