[
  {
    "uuid": "8dc41692-fa60-5a8d-8266-5ffd6977115c",
    "entry": "寄宿",
    "reading": {
      "primary": "きしゅく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
