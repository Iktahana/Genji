        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あたりようやく薄暗く工夫体の男｜甲走りたる声張り上げて歌い出せば商人の娘堪えかねてキヽと笑う。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヂイサン、マア　オキヽヨ、オレノ　フエハ　トテモ　スバラシインダゼ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　オカアサンガ　キヽマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さつきから癪に触つてゐたんだが、我慢してゐたんだぞ――」「此方こそ……」「キヽヽヽヽ。",
              "citation": {
                "source": "毒気",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "（前と同じやうな姿勢で挑みかゝらうとする）校長　　（軽く、それを受けとめて、腰をひねりながら）かうやつて、相手のキヽ腕をとつたら、この膝をずらして、相手の腰へ十分こつちの腰をはめこむ。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "其人柄及ビ當時此話ヲキヽシ時ノ心持ヲ想像シテ數語ヲ加ヘタリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝室ニ横臥シタキリデ佐々木ガ毎日附キヽリデ看護シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十分ホド経ッテ、スッカリ涙ガ乾キヽッテカラ、予ハ布団カラ顔ヲ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして塒に急ぐらしい数羽の鴉が夕焼けのした空を飛んで行った後には、森の奥の方で何も知らぬ鳥がキキキヽヽヽヽヽとけたたましく啼いていた。",
              "citation": {
                "source": "逗子物語",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "『宝物集』に「抑人ノ身ニ何ガ第一ノ宝ニテ有ケル、――人ノ身ニハ隠蓑ト云物コソ能宝ニテ有ベケレ、食物ホシキト思ハヾ、心ニ任セテ取テンズ、人ノ隠テ云ハン事ヲモキヽ、又｜床シカラン人ノ隠ンヲモ見テンズ、サレバ是程ノ宝ヤハアルベキ」云々。",
              "citation": {
                "source": "蓑のこと",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "裕佐がその後に続いた時、その叢の中からは藪鶯がチヽ、キヽ、と啼いて飛び散つた。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
