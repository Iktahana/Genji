[
  {
    "uuid": "27dda35a-d2ad-572a-b9c9-49b42aa721a4",
    "entry": "気管支",
    "reading": {
      "primary": "きかんし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
