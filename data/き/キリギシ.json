        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "海岸沿いの遊歩道は、片側に切り岸が迫っていて、歩くだけでスリルがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "断崖絶壁の切り岸から、遥か下の海を見下ろした。壮観だったよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "波が切り岸に激しく打ちつけ、白い泡を散らしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "林の外は切り岸の上、切り岸の下は海であつた。",
              "citation": {
                "source": "老いたる素戔嗚尊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　素戔嗚は高い切り岸の上から、遙かに二人をさし招いだ。",
              "citation": {
                "source": "老いたる素戔嗚尊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い土手は春に籠る緑を今やと吹き返しつつ、見事なる切り岸を立て廻して、丸い屏風のごとく弧形に折れて遥かに去る。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからローンの流れを渡ると、だんだん谷らしくなって、右の高い切り岸の下に、小さな村が表われた、ここはサン・モリス St. Maurice、レマンの南岸に沿う鉄道の分岐点で、ローンの谷の入口である。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして両側の切り岸は、額橡のように偉大な山岳をめぐって、その中心はブライトホルン、そうして左にはシュワルツ・メョンヒの、悪魔のような岩の上に、ユンクフラウの斜めに朝日を浴びたシルベルホルンが白銀よりも美しかった。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "切り岸のやうな山の上には青々とした杉の林があり、そこには雪のやうに白い一羽の鷺が朝の日の光りを浴びてゐた。",
              "citation": {
                "source": "八月の霧島",
                "author": "吉田絃二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "切り岸の様な額の上に、赤黒き髪の斜めにかかる下から、鋭どく光る二つの眼が遠慮なく部屋の中へ進んで来る。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところどころ、時代を経た切り岸が、苔臭い水に臨むといった、滋味のある景色もないではないが、それはむしろ一部分だ。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩の切り岸をのぼると平地に出ました。",
              "citation": {
                "source": "大金塊",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "四人の探検隊が上陸したのと反対がわの、島の切り岸に、一そうのりっぱなランチがつないであったのです。",
              "citation": {
                "source": "大金塊",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、彼の戦車さえ何らの功を立てなかったばかりか、彼の家来どもをのせた船もシチリアに帰りつかず、途中で暴風にあい、タラスの切り岸に乗りあげたと知ると、人々は、これは神々が、自分たちと同様に、彼のへたくそな詩にお怒りになったためであると確信した。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここはちょうど笠置の北で、屏風のような切り岸である。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年は何よりも歌を唄うことが得意だったと見えて、丘のきりぎしに立つといつでも唄った。",
              "citation": {
                "source": "赤い煙突",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "碧い色の海と月見ヶ丘のきりぎしとであった。",
              "citation": {
                "source": "赤い煙突",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの日幸子さんは、どう云うものか、ひどくヒステリックになっていて、あのきりぎしの上で僕が幸子さんを捕まえると、幸子さんは泣きながら、僕に一緒に死んでくれと云いました。",
              "citation": {
                "source": "勝敗",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "漕ぎ寄せた所は高いきりぎしに囲まれた小さな入江で、岩を噛んで打返すうねりが高くて、辛くもボートを岸へ乗りつけることが出来た時には余程時間が過ぎてゐた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は、はたして、このきりぎしの上に立つだけの勇気があろうか。",
              "citation": {
                "source": "考えこじき",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "（工藤梅次郎『アイヌ民話』150―３ページ）（１）語原は 〔We'n-sir〕（けわしい・きりぎし）。",
              "citation": {
                "source": "あの世の入口",
                "author": "――いわゆる地獄穴について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつか一度、私はその夢のやうな坂を登り、切岸の上にひらけてゐる、未知の自然や風物を見ようとする、詩的な Adventure に驅られてゐた。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつか一度、私はその夢のやうな坂を登り、切岸の上にひらけてゐる、未知の自然や風物を見ようとする、詩的なAdventureに駆られてゐた。",
              "citation": {
                "source": "散文詩集『田舎の時計　他十二篇』",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この世界の切岸に立って、この世界と面と向き合ったものは、撃たれるとか、放心とかゞある、たゞそれだけです。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "上を見ると、大きな空は、いつの世からか、仕切られて、切岸のごとく聳える左右の棟に余された細い帯だけが東から西へかけて長く渡っている。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ろは切岸に海の鳴る音を聞き、砕くる浪の花の上に舞い下りては舞い上る鴎を見る。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "底を覗いて見ると、切岸は見えるが底は見えない。",
              "citation": {
                "source": "夢十夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "本間、渋谷の手の者が、真っ先立って突き進み、堀の中へこみ入りこみ入り、忽ち切岸の下まで押し進み、逆茂木を引きのけ打ち入ろうとした。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここのは天然の切岸と、川の流れそのままがお濠になっている――優れているのがそこで、また足りないところがそこだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「武門に伍して、日頃は人並の言を吐いている又兵衛も、いざとなっては、わずか数丈の切岸に怯んで、馬を捨てたといわるるも口惜しい。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは小噴火丘を切り開いたところで、真赤な熔岩の肌を見せた切岸が、両側につっ立っている。",
              "citation": {
                "source": "黒い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな日の激流に削られたような切岸が、足利の町屋根から数町東の岩井村の辺で赤肌をむいていた。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏の切岸から渡良瀬川の流れへかけて、人影がみだれ合っていた、松明の火も走り廻ッている。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
