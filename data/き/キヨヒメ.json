        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "白砂に這い、ひろがれる千本松原、または紅葉に見えかくれする清姫滝、そのような絵はがきよりも浅草仲店の絵はがきを好むのだ。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ものの本によると、清姫は、あのとき十四だつたんだつてね。",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "安珍清姫のことまで例えに引きました。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "安珍清姫の昔からあるんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "安珍清姫恨みの恋路、坂田の金時｜女夫の相撲、牛若丸はてんぐのあしらい、踊れといえば、そら、あのとおり、――牛若丸はてんぐの踊りとござい」　いいながらむちでたたくまねをすると、いかさま二匹のくまはのっそりのっそりと立ち上がって、いとも器用に鞍馬山の牛若丸を思わすような剣術の型を使いました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "耳のない浪人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「清姫が蛇になったのは何歳でしょう」「左様、やっぱり十代にしないと芝居になりませんね。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホホホ私は清姫のように追っ懸けますよ」　男は黙っている。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう少し涼しくなると、彼女は鱗形の銀紙を貼り付けた紅い振袖を着て、芝居で見る清姫のような姿になって、舞台で蛇を使うことがある。",
              "citation": {
                "source": "両国の秋",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしが大劇場の舞台で最後にかれを観たのは、三十年の三月、神田三崎町に東京座が出来たときで、その舞台びらきの二番目に「日高川」が出て、福助の清姫に対して彼は真那古庄司と船頭とを勤めていた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔から云う安珍清姫さ。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしそれ失恋の極蛇になったもっとも顕著なは、紀伊の清姫の話に留まる。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "事跡は屋代弘賢の『道成寺考』等にほとんど集め尽くしたから今また贅せず、ただ二つ三つ先輩のまだ気付かぬ事を述べんに、清姫という名余り古くもなき戯曲や道成寺の略物語等に、真砂庄司の女というも謡曲に始めて見え、古くは寡婦また若寡婦と記した。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "予は清姫の話は何か拠るべき事実があったので、他の話に拠って建立された丸切の作り物と思わぬが、もし仏徒が基づく所あって多少附会した所もあろうといえば、その基づく所は釈尊の従弟で、天眼第一たりし阿那律尊者の伝だろう。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "明き者同士なれば、当時の事体、安珍の対手を清姫てふ室女とするよりは、宿主の寡婦とせる方恰好に見える。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "この辺で俗伝に安珍清姫宅に宿り、飯を食えば絶だ美し。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "窃かに覗くと清姫飯を盛る前必ず椀を舐むる、その影｜行燈に映るが蛇の相なり。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "……総司さんは、お千代は、恋患いで寝込んでいるだろうと仰有ったが、寝込んでいるどころか、東海道の長の道中を、清姫より執念深く追って来たよ。",
              "citation": {
                "source": "甲州鎮撫隊",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫と黄色と白と土橋を胡蝶並びて渡りこしかな　たとへば日本舞踊で清姫のやうな美姫を三人並べて踊らせる舞台面があつたとする。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえ、太夫、あたしを、清姫にならせずに置いておくんなさいよ――あたしは自分で自分をどうすることも出来ないように、いつの間にか成ってしまっているのです。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "まことや、むかし、清姫は、蛇ともなり、口から炎を吐いて、日高川の荒波を渡ったとか――このお方を、このまま、すげなく突き放したならば、あられもなく、夜ふけの道を、さまよい出すに相違ない――お美しい目に、あの奇しい光り、これは、尋常のことではない。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "清姫の前には鐘があった。",
              "citation": {
                "source": "女性の諸問題",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "安珍清姫で有名な道成寺の縁起にも、一羽の雀が一丈もあろう一筋の髪の毛をくわえてくる話があったように記憶しているが――とにかく、往古の女の髪は、いろいろの文献を話半分に考えてみても、大体において長かったことは事実らしい。",
              "citation": {
                "source": "髷",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは日高川の清姫ですから（ユーモアもあるから、大したものよ）自分のからだで海も山も越すことはいといません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "中で、今記憶にあるのは、清姫、（玉葉）鯉。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そはこの話に止らず、安珍清姫の話を翻訳したる「紀州日高の女｜山伏を殺す事」も然り、葛の葉の話を翻訳したる、「畜類人と契り男子を生む事」も然り。",
              "citation": {
                "source": "案頭の書",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もその時の田之助は、既に脱疽に罹り横浜の医師のヘボンに片足を切ってもらっていたのだが、うまく他の片足を使って芸をして、何とかいった河竹作物の傾城遠山と飛高川の清姫を勤めた。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "また清姫が日高川へ飛びこんで、安珍を追ったときはこんなものか、十七や十八で豪気なもの。",
              "citation": {
                "source": "朱絃舎浜子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが細長くつづきさえすれば、赤であっても、白であっても、ほかのどんな色でも、色合いにはかまわず、土地の人は一体にそれを「清姫の帯」と呼びます。",
              "citation": {
                "source": "大菩薩峠",
                "author": "竜神の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま、お豊が見たのも、その「清姫の帯」であって、牟婁郡から来て有田郡の方へ流れているのであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "竜神の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
