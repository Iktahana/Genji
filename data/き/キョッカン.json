        "examples": {
          "standard": [
            {
              "text": "この曲管は水を流すために使われる",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "化学実験で曲管を通して液体を移送した",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "トイレの曲管が詰まった",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "牛乳は一旦煮沸したる者を喞筒にて三階に送り、其処にて氷を盛りたる鉄の曲管間を潜らせ、その状あたかも滝の如く、潺々混々、白糸を撒くが如し。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
