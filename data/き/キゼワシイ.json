  {
    "uuid": "86f8bb49-c368-5e47-ad06-54a52c7f6643",
    "entry": "気忙しい",
    "reading": {
      "primary": "きぜわしい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
      ],
      "ctype": "形容詞",
      "inflections": null,
      "ctype_source": "existing",
