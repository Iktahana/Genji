[
  {
    "uuid": "83da2fe0-517f-561b-aabb-55c893aa30bc",
    "entry": "軋み",
    "reading": {
      "primary": "きしみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
