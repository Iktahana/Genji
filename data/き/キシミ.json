        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "急激な円安が進む中で、輸出入を巡る国際経済のバランスに深刻な軋みが生じている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あそこの派閥争い、相当ひどいらしいよ」「ああ、党内の軋みはもう隠しようがないね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "伝統的な生活様式と近代化の波がぶつかり合い、村のコミュニティに軋みが生まれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "無理な増産計画のせいで、現場の労働環境には限界に近い軋みが生じていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
