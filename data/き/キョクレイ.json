        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『礼記（玉藻）』に「父の命じて呼ぶ、唯して諾せず」とあり、『礼記（曲礼）』に「必ず唯諾に気をつける」とあるのも、解説に「返事は、諾より唯は恭しい」とあるので明らかである。",
              "citation": {
                "source": "一貫章義（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」などというと大いに欣んで聞いているが、曲礼の細則を説く段になるとにわかに詰まらなさそうな顔をする。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "『禮記』の曲禮にも、四十曰強而仕とある。",
              "citation": {
                "source": "支那史上の偉人（孔子と孔明）",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "不反兵（『禮記註疏』卷三、曲禮上）。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "身分ある者は、家屋を造る際に、先づ祖先を奉安すべき宗廟から着手する（『禮記』曲禮下）。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は父之讎弗與共戴天（『禮記』曲禮上）といひ、或は「【居父母之仇】弗三與共天下也。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に『禮記』に嫂叔不通問（曲禮上）とか、「嫂不撫叔。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "『禮記』曲禮に「取妻不取同姓。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に曲禮の措之廟、立之主、曰帝、の條の孔穎達の正義に崔靈恩の説を引き、生きて帝と稱したものは死して後も亦帝と稱し、生きて王と稱したものは死して後も亦王と稱したと言つてゐるが、此説が一番確實である。",
              "citation": {
                "source": "易疑",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に引用した曲禮の語でも鄭玄は帝の字を天神と解してゐる。",
              "citation": {
                "source": "易疑",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
