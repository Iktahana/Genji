        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "人気アニメのキャラクターゲームが発売され、初日から店の前に行列ができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "このキャラクターゲームは原作ファンからの支持が厚く、発売一週間で百万本を超えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "キャラクターゲームはライセンス料が高いが、既存ファン層をそのまま取り込める強みがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
