          "literary": [
            {
              "text": "蜘蛛はキリキリキリッとはがみをして云ひました。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜘蛛はキリキリキリッとはがみをして云いました。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その小児に振向けた、真白な気高い顔が、雪のように、颯と消える、とキリキリキリ――と台所を六角に井桁で仕切った、内井戸の轆轤が鳴った。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリキリキリキリと帆綱の鐶も鳴っている。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリキリキリと帆綱の鐶。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリキリキリと帆綱の鐶が鳴る。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリキリキリキリと帆綱の鐶。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏帽子がキリキリキリと虚空に回転して飛んで行く。",
              "citation": {
                "source": "道成寺不見記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの迷信は捨てなければならない」　キリキリキリと轆轤車は、その間も廊下を軋って行く。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリキリキリキリと車が軋り、尼は怯まず叫びつづける。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "名に負う鏡弓之進は、高遠の城主三万三千石内藤｜駿河守の家老の一人、弓は雪河流の印可であるが、小中黒の矢をガッチリとつがえキリキリキリと引き絞ったとたん、「待った待った射っちゃいけねえ！",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢をつがえました」「あれが竹林派の固めかな」「いやいやあれは昼行灯流で」「ナール、これはよう云われました」　この時葉之助は矢を取るとパッチリつがえてキリキリキリ、弦一杯に引き絞ると、狙いも付けず切って放した。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち彼女の慣用手段、眠りを誘う催眠秘術、キリキリキリキリと廻し出す。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右腕を肩から落とされて、悲鳴を上げるとキリキリキリと、独楽のように二、三度廻わったが、まずグンニャリと腰を砕き、すぐに横倒しに倒れてしまった。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢頃を計り射落とすがよいぞ」「かしこまりましてござります」　近習の捧げる重籐の弓をむずと握って矢をつがえたが、二間余りつと進むと、キリキリキリと引き絞った。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリキリキリー　それに応じて、六門の主砲が、右舷の方へ旋回して行った。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはいかん」　と思う間もなく、キリキリキリと音がして足が頭より上に上った。",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリキリキリと怪音を立てて蠅男の右腕が起重機のように三｜米ばかりも伸びたかと思うと、それが象の鼻のようにくるくるッと帆村の背後に曲って来て、大きな鋏のような鉄の爪が帆村の細首目掛けてぐっと襲い掛らんとする――あッ、危い！",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつがキリキリキリと、ルゾン号の積荷用のほばしらにからみついた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "×の四門の砲身はキリキリキリと右へ動きました。",
              "citation": {
                "source": "太平洋雷撃戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリキリキリと引き廻した。",
              "citation": {
                "source": "柳営秘録かつえ蔵",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　独楽のように、左の腕を肘のあたりから、切り落とされた頼春は、キリキリキリキリぶん廻った。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "左手で袴の股立ちを、キリキリキリと取り上げた。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹林派の押し手弓、キリキリキリと引き絞り、満を持して放たない。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
