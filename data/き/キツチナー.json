        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "独身元帥６・９（夕）　キツチナー元帥が不意の横死を遂げたのは、同盟国の為に気の毒に堪へぬ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "キツチナー将軍が首相のアスキスと婦人選挙権と兵役強制法の事を論じてゐると、其処へ婦人の訪問客が来て、将軍を調弄ふ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "キツチナー将軍が武器を取上げるのは私の職務だといふと、今一人の婦人が十八世紀式の短銃を掴み出して、「これをもお取り上ですか。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのキツチナーも六十五歳、独身の儘死んでしまつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国ではキツチナーが落ちた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "キツチナーは味も臭味も無いが、刺毛だけは鋭い。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
