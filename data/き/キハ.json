        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "或夜大友は二三の友と会食して酒のやや廻った時、斯ういう事を言ったことがある「僕の知っている女でお正さんというのがあるが、容貌は十人並で、ただ愛嬌のある女というに過ないけれど、如何にも柔和な、どちらかと言えば今少しはハキハキしてもと思わるる程の性分で何処までも正直な、同情の深そうな娘である。",
              "citation": {
                "source": "恋を恋する人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのように心掛けて何事によらず一事一物をハキハキと片付けて仕舞うのである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "それというが全躰あの方は如才がなくッて発明で、ハキハキしてお出でなさるからだヨ。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「被雇本人、軍籍ニアリ、万一不時ノ召集ヲ受ケ、労務ニ服スルコト能ハザルトキハ、前借金ニ利子ヲ附シ即時本人又ハ保証人ヨリ弁償スベシ。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁場到着後ナルトキハ、日割ヲ以テ精算ノコト。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「イイヤ、生レタトキハ良カツタ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「イイヤ、生レタトキハ良カッタ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゴカキハ、「ダンナ　カンチガヒデスヨ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　フエフキハ　イヒマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」フエフキハ、タカイ　トコロデ　ハタライテ　ヰル　ダイクノ　テニ　カナヅチガ　ニギラレテ　ヰルノニ、ハジメテ　キガ　ツイタヤウニ　オドロキマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　スコシ　イクト　フエフキハ　小サナ　クツヤノ　マエニ　キマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "クツヤノ　ヂイサンハ　一リデ　セツセト　クツヲ　ツクツテ　ヰテ、フエフキガ　フエヲ　フキハジメルト、「ウルサイカラ　イツテ　オクレ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フエフキハ　ツギノ　マチヘ　ハイル　ミチデ、ヒロツタ　カナヅチヲ　フリアゲ、クシヤント　フエヲ　クダイテ　シマヒマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒトビトハ　ゲンキヲ　ダシテ　ハタケデ　ハタラキハジメマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミドリイロノ　ペンキハ　アメノ　タメニ　ハゲテ　シマヒ、ワガネハ　アカク　サビテ　ヰマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オニゴツコノ　トキハ　コノ　バシヤハ　ヤスミバト　ナリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オテラノ　コゾウサンニ　バケル　トキハ　コロモヲ　ツケテ　デルノダヨ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オサムラヒニ　バケル　トキハ　マゲヲ　ツケテ、ヒゲヲ　ハヤシテ、カタナヲ　オコシニ　サシテネ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソレデハ、オテラノ　コゾウサンニ　バケテ　ミヨツト」　コドモノ　タヌキハ　コゾウサンニ　バケテ　ミマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　オサムラヒニ　バケル　トキダヨ」　オカアサンノ　タヌキハ　ガツカリシテ　イヒマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ　グアヒデ　コドモノ　タヌキハ　ナカナカ　ウマク　バケル　コトハ　デキマセンデシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　コドモノ　タヌキハ　ゲタニ　バケマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノ　カゲカラ　コノ　ヤウスヲ　ウカガツテ　ヰタ　オカアサンダヌキハ　タイヘンナ　コトニ　ナツタト、メヲ　マンマルクシテ　オドロキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コドモダヌキハ、イマニモ　ツブレサウデ、オモハズ、「グツ　グツ」ト　コヱヲ　ダシマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「グツグツグツ、カアチヤン」　コドモダヌキハ　タマラズ　トウトウ　オホキナ　コヱヲ　ダシテ　ナキダシマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカアサンタヌキハ　シンパイシテ、キノ　カゲヲ　カクレテ　サムラヒノ　アトヲ　ツイテ　イクノデス。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コドモダヌキハ　オアシヲ　モラツタノデ　サツキノ　クルシサモ　ワスレテ、ヨロコビ　イサンデ　カヘツテ　イキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
