        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "熱い汁が下腹へ、たらたらと染みた処から、一睡して目が覚めると、きやきや痛み出して、やがて吐くやら、瀉すやら、尾籠なお話だが七顛八倒。",
              "citation": {
                "source": "薬草取",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩が痛む腰が痛む、手の節足の節共にきやきやして痛い。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
