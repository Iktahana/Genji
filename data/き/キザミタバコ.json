        "examples": {
          "standard": [
            {
              "text": "骨董市で、古い煙管と刻みタバコの道具一式を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「おじいちゃん、それって刻みタバコ？珍しいね」と孫が尋ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "父の書斎には、いつも刻みタバコの独特の香りが漂っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "私は二階の縁側に出て、レンズをたよりに太陽の光線で刻みタバコに火を点けようとしてゐた。",
              "citation": {
                "source": "小さな村",
                "author": "原民喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
