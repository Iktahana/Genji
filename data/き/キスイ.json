    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "湯気水の中に、出がらしの茶の葉がプカプカと浮いてるじゃねえか。",
              "citation": {
                "source": "右門捕物帖",
                "author": "袈裟切り太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは線路が、この辺一帯を蔽うている涯てしもない雑木林の間の空地に出てから間もない処に在る小川の暗渠の上で、殆んど干上りかかった鉄気水の流れが、枯葦の間の処々にトラホームの瞳に似た微かな光りを放っていた。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦敗国｜独逸の新武器が――火焔放射器や、高熱砲や、磁気水雷や、落下傘部隊等が、かつての戦勝国、英仏その他を現に支配しているのだから。",
              "citation": {
                "source": "独逸の範とすべき点",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "涼気水の如く闇中に浮動す。",
              "citation": {
                "source": "良夜",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
