        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「前々から聞いていたことだが、錦屏山の岩窟にひとりの道士がいるそうな。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴公ひとりで訪ね給え」「よろしい、行ってくる」　部下数十騎をつれて、劉※はすぐ錦屏山へ登った。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲しいかな、いまその人は逝く」　勅して、順平侯と諡し、成都郊外の錦屏山に、国葬をもって厚く祭らしめた。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
