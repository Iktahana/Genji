        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おなじ荷の中に菎蒻キツトあり。",
              "citation": {
                "source": "寸情風土記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "キツトその蘭人があれから先づ己の国に帰つて又日本に来る途中で自分の戦勝を聞き、取り敢へず祝の品を持つて来たのだらうと思つた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてキツト二人の蘭人を見つめた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らく、その時私の理智の瞳が正しく開いてゐなかつたならば、私はキツト自殺したであらう。",
              "citation": {
                "source": "雀の卵",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤガテ　オドロキガ　トマルト、「イマノ　フトイ　コヱハ　ダレデセウ」「キツト　オソロシイ　モノニ　チガヒナイネ」ト　ヒソヒソ　イヒアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンノ　オトウサンハ　ソレヲ　キクト、タキクンノ　ハウヲ　キツト　ミテ、「タキ、イジメタリ　シテハ　イケナイヂヤ　ナイカ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、イタチダケヲ　ヨバナイト　イタチハ　キツト　オコルニ　チガヒ　アリマセン。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "□僕は詩人として中川一政氏を最も尊敬する、日本未来の大詩人はキツト此の人だ。",
              "citation": {
                "source": "TZSCHALLAPPOKO",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論小使部屋だ、マツチ箱の様な中に持つて来て、角火鉢、大薬鑵、炭取、箒、寝台、布団、机、鈴、乃至茶碗、土瓶、飯箱、鉄串に至るまで、まるで足の踏み処も無い始末、もし火事が始まつた時には、小使はキツト焼け死ぬるに異ひないと思つた。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、久しく見ないで居た石を偶然見付けると、キツト太つて大きくなつて居るといふ話を聞きました。",
              "citation": {
                "source": "入庵雑記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "源吉は、ひどくムツシリし出す、その次には何かキツトいゝことがなかつた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "かへつて、自分の思ひ切つたことが、闇にゐる牛のやうにのろい百姓にキツト何か、グアンとやるだらう、そしたら、それが、口火のやうになつて、皆が案外かへつて手ツ取早く、一緒になつて、ヤレツ、ヤレツ※　と鍬と鎌をもつて立ち上る！",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "――お前一人がどうしやうが、どうにもなるものぢやない、若しもの事があり、食へなくなつたらだうする、お前は世間の人達の恐れてゐるやうなそんな事をする人間ではなかつた筈だ、キツト何んかに馮かれてゐるんだ、お母さんは毎日お前のために神樣や、死んだお父さんにお祈りしてゐる……。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キツト何かあつたんだと思ふんだ。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「……うん、いや、その氣持も運動をしてゐるものがキツト幾分はもつ……何んて云ふか、センチメンタリズムだよ。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうすればキツトこんな事で、案外重大な裂目を引き起さないとも限らないんだ。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ではちつとも何もせず、一足飛びに直ぐ、（キツト他の誰かゞしてくれた）××の成就してしまつた世界のことだけを考へて、興奮してゐる者にはかういふ經驗こそ、いゝいましめだ。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "一緒にゐる不良少年の女をひつかける話や、浮浪者の慘めな生活などは、何時もならキツト佐多の興味をひいた。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして其折を外さず用ゐて行けば、キツト人を助けられるもんです。",
              "citation": {
                "source": "黄金機会",
                "author": "若松賤子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だん／＼其忘れる癖を矯め直して、心を落着け、恐れ多いことですが、総べて聖き御心のまゝに治めて入つしやる御神の見まへと思つて万事する様にしたら、キツトしまひには思ひ通り出来る様になりませう。",
              "citation": {
                "source": "黄金機会",
                "author": "若松賤子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あすのあさ來る葉書にはキツト又五｜匁ぐらゐふえてゐるだらう。",
              "citation": {
                "source": "ハガキ運動",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「忘れるな、キツト忘れてくれるな。",
              "citation": {
                "source": "茗荷畠",
                "author": "眞山青果",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ婆サンハ何ヨリモ『アグニ』ノ神ガ怖イノデスカラ、ソレヲ聞ケバキツト私ヲ返スダラウト思ヒマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の者の中でも、この三太郎は一番色白でええ男やさかい、あれにはキツト気をつけいとナそれ。",
              "citation": {
                "source": "心の鬼",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キツト、オナベノナカダ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今度は、キツト君が勝つよ。",
              "citation": {
                "source": "耳長さん　と　あひるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシタノアサハ　ジヤガイモサンニモサウ言ツテ二人デ一シヨニ、キツト　オミオクリニキテクレタマヘ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キツト、キツト、二人デオクツテユクヨ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
