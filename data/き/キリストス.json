          "literary": [
            {
              "text": "そうしてエイズス・キリストスの降誕、受難、復活のてんまつ。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これもまた眞鍮の版、萬民にかはりて、髑髏の阜にクルスを負ふ猶太の君那撒禮のイエススキリストス、神の御子。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "不思議なる御名にこそあれ、イエスス・キリストス、かみのみこ、よの人のすくひ、げにいきがみよ。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            }
          ]
        }
