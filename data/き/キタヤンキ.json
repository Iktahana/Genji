        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "頬の赤く太ったその若い女は、素子にとがめられてちょっと不意をくらった目つきになったが、すぐ、前より一層挑戦的に、もっと、意識的に赤い唇を上下にひろげて、白い歯の間から、「キタヤンキ」と云った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのキタヤンキって云いようは！",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつだってきまっているじゃないか、ホージャに、キタヤンキ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ころぶのをロシアの人に見られたくないという素子の気分は、伸子に、いつか、素子が彼女をキタヤンキ！",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
