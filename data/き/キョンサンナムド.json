        "examples": {
          "standard": [
            {
              "text": "今回の旅行では慶尚南道の南海岸を巡り、新鮮な海産物を堪能した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "慶尚南道に位置する昌原市は、韓国南部最大の工業都市として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女は慶尚南道出身で、故郷の方言が今も抜けないと笑っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "大加羅国は、現在の慶尚南道に在つた国であるが、日本が接触した最初の外国であるから、日本人はカラと云ふ名をその後外国の総称に使ひ、支那大陸まで唐と云つたのであらう。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッタ一ヒネリだぞ……というので、腕に縒を掛けて釜山一帯の当局連中を鞭撻にかかったものだが、その手初めとして取りあえず慶尚南道の有志、役人、司法当局四十余名を釜山公会堂に召集して、爆弾漁業｜勦滅の大講演会を開く事になった。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
