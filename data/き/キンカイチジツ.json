        "examples": {
          "standard": [
            {
              "text": "人生の栄光も槿花一日のようにはかないものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その栄華も槿花一日で終わってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "槿花一日という言葉は東洋の無常観を表している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "朝顔と蓮　松樹千年の緑を誇ろうよりも、槿花一日の栄えを本来の面目とする江戸ッ児には、旦々に花新たなる朝顔を愛し、兼ねては汚泥を出でて露の白玉を宿す蓮の清新を賞する、洵にあらそい難きことどもである。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "久次の牢輿にて連れ行かれしを見送り「まことや槿花一日の栄、是非もなき世の盛衰ぢやなあ」との白廻しも値あり。",
              "citation": {
                "source": "両座の「山門」評",
                "author": "三木竹二",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち槿花一日の栄だといわなければその花の実際とは合致しない。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
