[
  {
    "uuid": "7319a60c-c1c0-5e4f-a423-c74c19d4ea3c",
    "entry": "聞き惚れる",
    "reading": {
      "primary": "ききほれる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
