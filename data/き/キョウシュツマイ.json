        "examples": {
          "standard": [
            {
              "text": "戦後しばらくは供出米の割当が厳しく、農家の食卓は質素なものだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "供出米の検査に来た役人が、俵の重さを丁寧に量り記録していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "父は供出米を運び終えた翌日だけは少し気が楽になると話していたと、祖母が語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "米　一月十日現在として全国の供出米が割当のやっと二割八分しか集まらなかったことが報じられている。",
              "citation": {
                "source": "女の手帖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先頃、中国地方の田舎を旅行したときも、話題は供出米が中心となった。",
              "citation": {
                "source": "女の手帖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、なんと云つても、小川指導部長の力を籠めて説くところは、耕地整理と供出米の問題であつた。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "つい先頃、一月十日までの供出米は、予定の二割ばかりしかないという報道があった。",
              "citation": {
                "source": "人民戦線への一歩",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
