  {
    "uuid": "76380d23-3072-5f8b-a6dd-e4d716ea22f9",
    "entry": "轎夫",
    "reading": {
      "primary": "きょうふ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
