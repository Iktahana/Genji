        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "轎夫駄児の類浴する故｜穢濁なり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "海の名を轎夫に問へば谷間の朝霧なりと答ふ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "轎夫脚を愛して海中｜潮斥の処を行く。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「諸侯の乗るような轎じゃねえか」　それにしても、轎夫もいなければ伴の者もいない。",
              "citation": {
                "source": "棄轎",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、小さな旋風が起ってそれが薄すりと塵を巻きながら、轎夫の頭の上に巻きあがって青い簾の垂を横に吹いた。",
              "citation": {
                "source": "悪僧",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さよか」と吉之助様はおっしゃいまして、しばらく考えておられましたが、「轎夫、この駕籠を茶屋の前で止めろ、人数の真ん中へ舁き据えてくれ」とこのようにおっしゃってでございます。",
              "citation": {
                "source": "犬神娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "轎夫は皆｜跣足である。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬夫二人、轎夫四人、毛布と二日分の食糧（弁当、白米、食器、砂糖、缶詰類）とを持つ人夫六人、何れも支那人、それに私達四人と云ふ一行が、路をホテルの後方に取つて動き出した。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の轎夫や人夫達が、太孤山へ一行を送つて置いて五六里の路を徒歩して今夜は湯崗子へ帰られない、一泊すれば宿料が要る、一所に汽車に乗せて帰つてくれと云ふ。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "余のために轎を担いだ壮丁の好意　中国式の轎は不潔ではあるが、読書することもできれば、眠ることもできて、僕には最も都合よいが、轎夫のがやがや騒ぐために大いに楽しみの程度を低められる。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに天気が不良の場合に、轎夫が絶対に働かないで、途中に轎を置き去りすることがある。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "警官に依頼し轎夫の雇入を命令的に誘導的に周旋してもらったが、しばしは一人の応ずるものもなく、雨曝しになって進退｜谷まった。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも轎夫としては御免ですが、壮丁としてなら参りましょう」　といった。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "というは、轎夫として担げば、相当の賃銭を受ける一つの商売である。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ官職を帯びて巡廻するものが、轎夫なきために一歩も進めなくては公務のために憂うべきことである。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "前にいった轎夫の賃銭は金銭で計算されるが、壮丁の僕に対する好意は金銭をもって換算できぬものである。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "轎　　一人乗りで二人の轎夫が棒で肩に担いで運ぶもの。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "轎夫も九死に一生をえた思い。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
