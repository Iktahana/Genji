          "literary": [
            {
              "text": "外へ向つて展かれた器關を凡て閉ぢ、まるで掘上げられた冬の球根類のやうにならうとした。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは花を作る場所で、今年ももう球根類は植付けをすませたらしく、くろぐろと柔らかく湿気を帯びた土は、日光をたっぷりと吸って、あたかも生きて呼吸をしているかのごとくみえる。",
              "citation": {
                "source": "花咲かぬリラ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
