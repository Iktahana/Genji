        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "タガメは金魚に取付くのに凶暴性を持つ害虫である。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "普段は威勢のいい快活な老兵なのだが、うちに秘めたる激烈な凶暴性や執念深さを見せるようなこともあった。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "凶暴な人間が血を見ていっそう惨虐性を発揮するように、涙を見ると、私の凶暴性が爆発する。",
              "citation": {
                "source": "父の出郷",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな男にも隠れ潜む凶暴性が、この瞬間デンに起きた。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ岡っ引を憎む凶暴性が勃然と彼を取りまいたのだ。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの天平盛期の平和を思いながら、大仏殿に佇んで、大仏の偉大な美と荘厳に打たれていると、時には、これへ火を放ける心理にもなった人間の前科に、人間の凶暴性や愚に、ふと、慄然たるものを覚えずにはいられない。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
