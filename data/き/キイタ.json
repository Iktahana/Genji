        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "花タチハ　キイタ　コトノ　アル　コヱダト　オモツテ　ミルト、ウマヤノ　マドニ　大キナ　ヤサシイ　ウマノ　カホガ　ノゾイテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ　キイタ　コノ　マヅシイ　ヲトコノ　ヒトハ、「ヨシ、ソレデハ　ジブンモ　センサウノ　アル　トコロヘ　イツテ、リツパナ　テガラヲ　タテ　タイシヨウニ　ナラウ」ト　ヒトリゴトヲ　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ソレハ、オヂイサンノ　ミミガ　キイタノデハ　アリマセン、ココロガ　キイタノデス。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナハ君チャンニワケヲキイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「玉ネギノヱカキサンナンテキイタコトガナイ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キミノナ、ヒラノ、イチロ、ダネ、キミノアネ、ヒラノ、ユリカ、ダネ、ユリカ、オンガク、キレイ、ウツクシイ、ステキ、ワタシ、マイバン、ココキテ、キイタ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
