        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "道路の中央部には雨水を外側に流すためのキャンバーがつけられており、わずかに盛り上がっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "サーキット仕様にカスタムするなら、フロントのキャンバー角を調整して旋回性能を上げたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「このスキー板はキャンバーが強めだから、硬い雪面でもエッジのグリップがしっかりきくね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "タイヤの偏摩耗を防ぐために、車検のタイミングでキャンバーの数値を適正に直してもらう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "キャンバーウェル州パラダイス通り十七番地と書けば、ザリが明朝受け取る」　ヴィラがあて先をしっかり明確に書き、多少恥じて渡した。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふいに目の前に現われた壮大な白いキャンバスを前にした少年の、生きることへの恐れにもにた感動か。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャンバスを走らせる筆の跡だけに意識を集中する画家や、めまぐるしく動く指先が奏でるメロディーに、ゆったりと意識を浮遊させるピアニストのように、闇の中に浮かんでくる言葉の連なりと無心に向き合うことができました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまでなら、絵は紙やキャンバスの上、写真は印画紙、動画はフィルムやビデオテープ、音はレコードやＣＤと、それぞれ専用の〈器〉におさめられていた。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも電子のキャンバスの上では、動きまで表現できるのです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "番組を受信する装置としてではなく、電子のキャンバスとしてブラウン管を使うという「正しい見方」は、時代の流れを先取りしていました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「キャンバウェル、ライアン町三一番。",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "故人はアメリカの紳士で、数週間この街に滞在しており、キャンバウェル、トーキィ・テラスにあるシャルパンティエイ夫人の旅籠を宿としていた。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョン・アンダウッド商会製、住所はキャンバウェル通り一二九だ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "また女性たちがよくしてくれたので、キャンバス屋根の動く家であっても、すぐさま新しい生活に順応することができた。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつらは川向こうキャンバウェルの賄い付き下宿屋におりました。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "パラドールの間のこと、大家具屋の地下室に集う素人乞食団なる一流倶楽部のこと、英国帆船ソフィ・アンダソン号難破に関する真相のこと、ウーファー島のグライス・パタソン一味の奇譚のこと、〆はキャンバウェル毒殺事件のこと。",
              "citation": {
                "source": "橙の種五粒",
                "author": "THE FIVE ORANGE PIPS",
                "note": "青空文庫"
              }
            },
            {
              "text": "画家は軍部へ奉仕しなければ職能的存在を抹殺されて、えのぐやキャンバスの配給を受けられないようにした。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ絵の修業のひとは哀れと思う、キャンバスその他も高いから。",
              "citation": {
                "source": "日記",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エジプトのミイラは、キャンバイシーズ王も歳月も手をふれることを差しひかえたのに、今は貪欲な人間がけずりとっている。",
              "citation": {
                "source": "ウェストミンスター寺院",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            },
            {
              "text": "この海藻のむしろの上に、貝と蝦と野菜類とを載せて、上からすっかりテント用のキャンバスでおおう。",
              "citation": {
                "source": "西洋の浜焼",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャンバスをあけると、湯気が白々と立って、貝はもう蒸されている。",
              "citation": {
                "source": "西洋の浜焼",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャンバスをめくると、夕闇の中に、湯気が真白に立ち上がる。",
              "citation": {
                "source": "西洋の浜焼",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四季とりどりの大観は、大自然のキャンバスに、神様が御自分の手で描いてくれます」「嘘だ」「まだ信じては下さらないのですか、それでは申しましょう。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "第四の場合",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後七時、長さ一千メートルの流網はキャンバス・ポラッド及び浮樽二十一個と浮燈三個を海面に留めて、一文字に投ぜられた。",
              "citation": {
                "source": "地震なまず",
                "author": "武者金吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁側のキャンバス製の寝椅子に、栄介はながながと背を凭たせ、本を読んでいた。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ若い頃だから保ったけれど、今のおれならとても出来ることじゃない」　キャンバス椅子の上で栄介は背伸びをした。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "このネコが僕の部屋にのそのそと入って来て、とかくキャンバスに爪を立てたがる困った傾向がある。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャンバスを見れば条件反射的に爪を立てるような訓練を、野呂がネコにひそかにほどこしているらしいのです。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからネコは僕の部屋に入ってきて、油絵具を塗ったキャンバスを見ると、もう夢中になって爪を立てるのです。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "可憐なる小動物を虐待する気分は毛頭ないのですが、キャンバスに爪を立てられてはこちらも上ったりです。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
