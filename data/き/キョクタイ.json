    "definitions": [
      {
        "index": 1,
        "gloss": "polar body (cell structure within the ovum)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
