        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そしてせっせせっせと世話女房らしく切り回す事に興味をつないでみた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "東太という低能児と自分の娘を結婚させれば、期せずして千頭家をきりまわす力は嫁方のもので、おまけに東太の母だって、自分の妹ではないか。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "低能の東太に当主の実力は有りッこないから、家をきりまわす者は嫁であり嫁の一族だ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "伯母は多少気丈な女で家の中を切り廻すが、病身で、とき／″＼寝ついた。",
              "citation": {
                "source": "蔦の門",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでだんだんにほかの議政官たちを押しのけて、町中のことは自分一人で勝手に切り廻すようになりました。",
              "citation": {
                "source": "デイモンとピシアス",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうして切り廻すことが自分にできようとも思はなかつたし、そんな時節が來ようなどとも思ひもうけなかつた。",
              "citation": {
                "source": "四十餘日",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "従つて、一家の経済はかつ子の月給で切り廻す結果になるので、今のところをやめさせるわけには行かない。",
              "citation": {
                "source": "現代詩",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "うむ、そうだそうだ、自分も使われる人でなくなって、あの身上も、商売も、自由に切り廻す主人となれるのだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "金之丞さんも身内には相違ありませんが、縁が遠くなりますし、それに、あの通り弱い方で、大店を切り廻す方ぢや御座いません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "路地の足跡",
                "note": "青空文庫"
              }
            },
            {
              "text": "金之丞さんも身内には相違ありませんが、縁が遠くなりますし、それに、あの通り弱い方で、大店を切り廻す方じゃございません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "路地の足跡",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれじゃお前が一人で切廻す訳だと、お客さまが仰ゃって下さいます」　お島はそう言って、この商売をはじめた自分の行立を話して、衆を面白がらせながら、二時間も話しこんでいた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "先夫人の死去と共に、いつとなく後妻のような位置に坐り、美人でもなければ才女でもないのですが、加茂家を切廻す権勢は大したものです。",
              "citation": {
                "source": "露の答",
                "author": "ぬばたまのなにかと人の問ひしとき露とこたへて消なましものを",
                "note": "青空文庫"
              }
            },
            {
              "text": "先夫人の死去と共に、いつとなく後妻のやうな位置に坐り、美人でもなければ才女でもないのですが、加茂家を切廻す権勢は大したものです。",
              "citation": {
                "source": "露の答",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……百のものを百に切廻すのは個人の家政で、百のものを千にも万にも活かして働かすのが政治というものだ、しかしこんなことはいま云ってもしようがない、近いうちにその証拠を見せてやる、政治がどういうものかという証拠をな」　そしてそのあとで必ず、「桃園の娘の返辞を早くたのむぞ」　と、くどく念を押すのだった。",
              "citation": {
                "source": "彩虹",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "京の女はこまかいそろばんをはじくというが、あんな女房を持っているとは、おうらやましいことだ」　詰りきった下士の台所を切りまわすには、亭主の内証を知っているほうが便利だろうが、まだ祝言もすまない長屋の青女房が、勘定割場まで差し出るのは、少々、念が入りすぎている。",
              "citation": {
                "source": "奥の海",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "（だが車懸とは如何するのか一寸疑問で、大軍を立ちきり立ちきり廻すというのは、実際困難である。",
              "citation": {
                "source": "川中島合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "一家を、男ばかりできりまわせるものならば、妻を喪った男やもめに、蛆が湧くという川柳は出来なかった筈であると思う。",
              "citation": {
                "source": "現実に立って",
                "author": "――婦人が政治をどう見るか――",
                "note": "青空文庫"
              }
            }
          ]
        }
