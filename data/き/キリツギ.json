        "examples": {
          "standard": [
            {
              "text": "この古い着物の裾には目立たない切り継ぎが見られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "織物職人は布の切り継ぎで古い素材を有効活用する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "着物の修復に使われる切り継ぎは高度な技術を必要とする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "その収入や地位の向上はもとより、その首の切り継ぎまでも彼女達の上役の異性の手に任せねばならぬ。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
