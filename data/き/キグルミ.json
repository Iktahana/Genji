        "examples": {
          "standard": [
            {
              "text": "遊園地の入口でくまの着包みを着たスタッフが、子どもたちを笑顔で出迎えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "真夏の炎天下で着包みを着て街頭宣伝するアルバイトは、想像以上に過酷だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼はハロウィンパーティーにパンダの着包みを着て現れ、会場を沸かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "矮虎の手下にきいてみると、あれから女轎の供の兵隊七、八人を追っ払い、女の身は轎舁きぐるみ、矮虎が自分の住居へ連れ込んでしまったきりだという。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
