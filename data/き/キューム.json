          "literary": [
            {
              "text": "当時アメリカのキューム社は、菊の花弁の先に活字を付けたような印字機構を持つ製品で市場を押さえていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワードプロセッサーとして、また純然たるプリンターとしても、スピンライターはキュームの製品を追い上げる実績を残していった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "国も在宅で、労働服着て、バキュームを動かして、カーペットの塵をすっかりとって、食堂に敷きました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
