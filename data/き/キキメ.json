[
  {
    "uuid": "82688518-b05c-5e55-bcb0-8c2fe2176635",
    "entry": "効き目",
    "reading": {
      "primary": "ききめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
