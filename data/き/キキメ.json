  {
    "uuid": "fb298177-38ae-5491-a874-13ba3bfc1510",
    "entry": "利き目",
    "reading": {
      "primary": "ききめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこで遡江部隊の遡という字からシンニユウを除いた朔だとか、国民に愬ふといふ愬から心を除いた上の字だとか言つてみるが、これもまた一向に利き目がない。",
              "citation": {
                "source": "名前の話",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやな顔をするな、例というものは実感がないと利き目が薄いものだ。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはり病院よりは田舎の空気が安くて利き目がよかったのである。",
              "citation": {
                "source": "異質触媒作用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱で渇いた口に薫りの高い振出しをのませ、腹のへったものの前に気の利いた膳をすえ、仕事に疲れたものに一夕の軽妙なレビューを見せてこそ利き目はあるであろう。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでこそ例えば津浪を戒める碑を建てておいても相当な利き目があったのであるが、これから先の日本ではそれがどうであるか甚だ心細いような気がする。",
              "citation": {
                "source": "津浪と人間",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、阿片の代りに、もっと割が安い、利き目が遙かにきつい三号含有物がここでは用いられた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは山の垢と呼んで、最も利き目の多い肥料の一つである。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "するうち悲哀に包まれた人々の環視のうちに、注射の利き目は次第に衰え、銀子の目先に黒い幕が垂れ、黒インキのようにどろどろした水の激流に押し流されでもするように、銀子は止め度もなくずるずる深く沈んで行き、これが死ぬことだと思った瞬間に、一切が亡くなってしまった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "津島はその弟に可なりな補助を与へたこともあつたけれど、利き目のないのに懲りて、さうした交渉は作らないことに決めてゐたのであつたが、ふいと虚につけ込んで小股をすくはれたのが、腹立しかつた。",
              "citation": {
                "source": "風呂桶",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "何んの利き目もない。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主水之介の眉間傷も小魚共には利き目が薄いと見ゆるよ」「はッ。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "御帰館との御諚ならば立ち帰りまするでござりますが、釣れぬのは――」「釣れぬのは何じゃ」「水死人ゆえでも、御眉間傷の利き目が薄いゆえでもござりませぬ。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう事は威厳をつけぬと兎角利き目が薄いでな。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "山県有朋から使いが立った、と分れば、わしが現在どういう職におるか、陸軍、兵部大輔という職が、どんなに恐ろしいものか、おまえなんぞなにも申さずとも、奴等には利き目がある筈じゃ。",
              "citation": {
                "source": "山県有朋の靴",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の腐つた心には、もう薬もなんの利き目がないのかも知れないなどゝ思ふ。",
              "citation": {
                "source": "脱殼",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　此人も私に、利き目のない薬を盛らうとすると思ひながら、自分を鞭打たれる快さを私は味はふ。",
              "citation": {
                "source": "脱殼",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしてその天邊からころがり落ちてくたばつて呉れりやア、あツちの女にもさぞ利き目が早からう。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "人を笑わせるには自分から笑っていては利き目がないということもその一つだ。",
              "citation": {
                "source": "猫八",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "車つき運び寢臺の上に乘せられ、魔睡劑の利き目がまだ殘つてゐるのが運び去られる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして注射をして貰つたのが、藥の利き目でか、一層不氣分を増した。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "父兄が叱ろうが、教師が説諭しようが、なんの利き目もないという持て余し者がずいぶん見いだされた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも利き目がないらしく、女湯は男湯よりも三倍以上の水量を要すると云われていた。",
              "citation": {
                "source": "明治時代の湯屋",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに籠城が北条の十八番でも、のびのびと屈托のない秀吉に対しては一向利き目がない。",
              "citation": {
                "source": "小田原陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "留学費のなかから買込むだ大缶の蚤取粉を、惜気もなくばら撒いてみたところで一向利き目が無い。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが鼻が一等きき目があるからな。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "表六句の中に月が置かれているのはこの一ページのうわずるのを押える鎮静剤のようなきき目をもっている。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはりこの興奮剤の正当な作用でありきき目であるに相違ない。",
              "citation": {
                "source": "コーヒー哲学序説",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "野中兼山は椋鳥が害虫駆除に有効な益鳥であることを知っていて、これを保護しようと思ったが、そういう消極的な理由では民衆に対するきき目が薄いということもよく知っていた。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸福のうわおいぐつのおそろしいきき目にびっくりして、助手はむちゅうでうちへかけ込みました。",
              "citation": {
                "source": "幸福のうわおいぐつ",
                "author": "LYKKENS KALOSKER",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその前に、二つの水がほんとうにきき目があるかどうか、ためして見ていただきたいと言いました。",
              "citation": {
                "source": "黄金鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
