  },
  {
    "uuid": "07866a85-abaa-5e66-bfb5-b37336c59be6",
    "entry": "効目",
    "reading": {
      "primary": "ききめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "牛の脚の肉などよりは、直接、舌のほうに効目があろうという心意気らしい。",
              "citation": {
                "source": "女人訓戒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　――馴れぬ手つきで揉みだした手製の丸薬ではあったが、まさか歯磨粉を胃腸薬に化けさせたほどのイカサマ薬でもなく、ちゃんと処方箋を参考にして作ったもの故、どうかすると、効目があったという者も出て来た。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな風に扱われては、支店長たちも自然自滅のほかはないと、切羽つまった抗議の手紙を殆んど連日書き送ったが、さらに効目はない。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "効目が卓れていたから、薬がよく売れた、――そんな莫迦げたことは、お前も言うまい。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「へえ、へえ、もう、これぐらい滞在なすったら、ずっと効目はござりやんす」　駅のプラットホームで客引きが男に言っていた。",
              "citation": {
                "source": "秋深き",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度話をしたい（一同舌をしたい）と柳吉だけが判読出来るその手紙が、いつの間にか病人のところへ洩れてしまって、枕元へ呼び寄せての度重なる意見もかねがね効目なしと諦めていた父親も、今度ばかりは、打つ、撲るの体の自由が利かぬのが残念だと涙すら浮べて腹を立てた。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "妹が聟養子をとるとあれば、こちらは廃嫡と相場は決っているが、それで泣寝入りしろとは余りの仕打やと、梅田の家へ駆け込むなり、毎日膝詰の談判をやったところ、一向に効目がない。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "気が付かねば、まじないは効くのだとひそかに現のあらわれるのを待っていたところ更に効目はなかった。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "病者自身が、生かせてほしいと仏に願っておればともかくであるが、女王にすれば、病になったのを幸いとして死にたいと念じていることであるから、祈祷の効目もないわけである。",
              "citation": {
                "source": "源氏物語",
                "author": "総角",
                "note": "青空文庫"
              }
            },
            {
              "text": "醫者は又自分の用ひた眠り藥が比較的新らしいもので、學理上、他の睡眠劑の樣に有害でない事や、また其効目が患者の體質に因つて、程度に大變な相違のある事などを語つて歸つた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "産婆は細い硝子の管の樣なものを取つて、小さい口の内へ強い呼息をしきりに吹き込んだが、効目は丸でなかつた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "千代子は平手でその背中を二三度｜叩いたが、何の効目もなかった。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪結はより効目のある相手として、すぐ年の若い千代子を選んだ。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論若い女の口から出れば効目が多いだろう。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その薬は効目がいちじるしかつただけに、値段も高かつた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれは、うんと言って頂かなきゃルチアノの顔が立たねえが、そんな強面は百万だら並べたところで、先生にゃ効目もありますまい。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、三時間ほど禁断症状が起ったのを我慢した後だから、四錠ほど飲んでも、いつもの十錠分ほどの効目がある。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "満洲の土人は薬をめったに飲んだことがないので、日本人にくらべると非常に薬の効目がある。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "この不意撃に一同も総立となって、井神は屈せず鉄砲を放ったが、空砲とは云いながら何の効目もなく、石はますます降るという始末に、何れも殆ど匙を投げて、どうにもこうにも手の着様がない。",
              "citation": {
                "source": "池袋の怪",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "二回りか三回り入浴して来なければ、温泉の効目はないものと決められていた。",
              "citation": {
                "source": "温泉雑記",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "野暮を云わねえで、そこまで一緒に来てくんねえ」「むむ、そうか」　中間も相手の何者であるかを大抵推量したらしく、思いのほか素直に誘い出されたので、吉五郎は先きに立って彼を元の小料理屋へ連れ込むと、さっき余分の祝儀をやった効目があらわれて、女中はしきりに世辞を云いながら二人を二階へ案内した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "白蝶怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯れてしまっては呪いの効目もあるまいと思ったので、お琴は庭から新らしい葉を折って来て、人に頼むまでもなく、自分がその葉を吊り換えようとする時、ふと見ると古い枯葉には虫の蝕ったような跡があった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "かむろ蛇",
                "note": "青空文庫"
              }
            },
            {
              "text": "「飲みましたが思ったほど効目がないようでした」　昨日の津田にはリチネの効目を気にするだけの暇さえなかった。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども不意に座を立った姉の挙動が、もうすでにその状態を崩していたので、お延の慫慂は何の効目もなかった。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "またおっしゃったところで効目がなければ仕方がありませんからね」「じゃどこが強情なんだ」「どこがってお聴きになっても駄目よ。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者はまた自分の用いた眠り薬が比較的新らしいもので、学理上、他の睡眠剤のように有害でない事や、またその効目が患者の体質に因って、程度に大変な相違のある事などを語って帰った。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "産婆は細い硝子の管のようなものを取って、小さい口の内へ強い呼息をしきりに吹き込んだが、効目はまるでなかった。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "和江村では、その都度幾度か地方の神官を招いて、清祓式を行つてはみるが、一向｜効目が無くて狂人は殖えるばかりなので、寧そ大社教の管長様を迎へたらといふ事になつて、さてこそ千家管長の乗込みになつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今時の会社の重役から、こつちの欲しいものを取り出さうとするには、自分で自分に愛相が尽きて、あとで胸が悪くなる位のことをいはなくつちや、何の効目があるものか。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "寢る前に砂糖をなめればいいとか、時計のかちかちを數へろとか、水で兩足を冷せとか、ねむのきの葉を枕のしたに敷いて寢るといいとか、さまざまの眠る工夫をうちの人たちから教へられたが、あまり效目がなかつたやうである。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
