        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "うす菊花石があって、背の低い方だった。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "白っぽいうす菊花石が、ひと粒ひと粒笑っていた。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊花石くずれの鬼みたいな顔である。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "――左次郎はそんなことを考えながら、銅鑼という通称をとった彼の菊花石を眺めていた。",
              "citation": {
                "source": "醤油仏",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊花石の顔を少し険しくして、電光のように、しきりと右の眼を顰めている様子。",
              "citation": {
                "source": "醤油仏",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで今夜は遅く帰って来たが、その代りにゃ土産があるぜ……」　と言って、銅鑼屋の亀さんはさも得意気に、顔の菊花石が一粒一粒笑うようにニヤニヤとした。",
              "citation": {
                "source": "醤油仏",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
