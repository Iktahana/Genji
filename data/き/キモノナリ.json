          "literary": [
            {
              "text": "数千百年ヲ歴タル物ハ、多ク朽腐シ或ハ欠損シテ、其ノ完存スルヲ得ルハ甚ダ鮮ナキモノナリ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "［edel ハ單ニ Tabak ノ枕詞ノ如キモノナリ。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "他ノ高等精神作用亦皆習練ニヨリテ育成セラルルコト此ニ同キモノナリ」というのがある。",
              "citation": {
                "source": "呉秀三先生",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノ点ハ諸君ノ熟慮ヲ待ツベキモノナリ」　と、さう述べてゐる――この宣伝文の筆者は、賤民があの最下層住宅区の高さ一メートル、巾は三分の二メートル、長さ一メートル半の場所のなかで自己の自由な意志で運動出来ることを喜べる者と想像してゐるらしいのは寧ろ滑稽であつた。",
              "citation": {
                "source": "のんしやらん記録",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
