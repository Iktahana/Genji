        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "生命が消えかけるのである。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローソクの灯が板壁の隙間風にゆらゆらとゆれて、時々消えかける。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪はもう降りつつ重みで梢をすべり落ち、地の上で消えかける時候になって居た。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "焚火が消えかけると足が寒い。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼間も、なかなか眠る間もあるまい……」「眠らないのも、修行と存じますれば」　新蔵は、師の薄い背中をさすりながら、ふと、消えかける短檠を見て、油壺を取りに起った。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……困ったことを」　新蔵は、消えかける短檠へ、何度も嘆息をもらしては、また、腕ぐみの中に面を沈めていた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは第一の口において早くも消えかける。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
