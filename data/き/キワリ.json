        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこを自得の袈裟掛け一刀、伊那高遠の八幡社頭で、夜な夜な鍛えた生木割り！",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "薪を採つてそれを眞木割で裂いて干して置く。",
              "citation": {
                "source": "炭燒のむすめ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "サゲフリを下げて木割にし、小さい部分から伸ばしてゆく。",
              "citation": {
                "source": "回想録",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "上河内岳の下には生木割、少し離れて白峰山脈南半の盟主笊ヶ岳、千挺木、七面山。",
              "citation": {
                "source": "奥秩父の山旅日記",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから笊も今迄何処からも見えなかったのですが、これも青年会館から確に笊、或は間違った所で其の隣りの生木割か千挺木か、どちらかだろうと思いますが、併し頭の恰好からはどうしても笊で、多少疑問がないでもありませんが、笊に相違なかろうとそう極めて置きます。",
              "citation": {
                "source": "望岳都東京",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
