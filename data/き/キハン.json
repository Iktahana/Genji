  {
    "uuid": "166508e3-f15e-5057-b30b-bd6e023d5fac",
    "entry": "帰藩",
    "reading": {
      "primary": "きはん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
