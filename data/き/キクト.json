          "literary": [
            {
              "text": "ソレデ、コノ　ウグヒスハ、オカアサンヲ　ナクシタ　コドモノ　フク、カナシイ　ウグヒスブエノ　オトヲ　キクト、ナクシタ　ボウヤノ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンノ　オトウサンハ　ソレヲ　キクト、タキクンノ　ハウヲ　キツト　ミテ、「タキ、イジメタリ　シテハ　イケナイヂヤ　ナイカ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムネイタイノ、ト君チャンガキクト、イヤト頭ヲフルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナッテ、又ムネイタイノ、トキクト、ダマッテ目ヲツブッテ、ソレカラムネナンテ何ンデモナイ、ト云ッテ、君チャンノカオヲ見、何ンベンモソットナミダヲフイテルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人ノ言葉ヲキクト今マデ死ンダヨウニナッテ居タ奥様ガ何カ云イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
