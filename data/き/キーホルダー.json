        "examples": {
          "standard": [
            {
              "text": "修学旅行の土産物屋で買ったキーホルダーは、二十年経った今も玄関の鍵につけたままだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "娘は工作の授業で作ったキーホルダーを父親の誕生日プレゼントにと手渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "スマートフォンに取り付けられるキーホルダー型のトラッカーを買って、鍵の紛失対策にした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "佃煮にしたり、クッキーに煎餅、饅頭に団子にアイスクリーム、シャツにキーホルダーにハンカチ、タオルにと、なににでも利用が可能だ。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
