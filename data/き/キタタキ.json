        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "森の中で、木啄が木を叩く音が響いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "珍しい木啄の姿をカメラに収めることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの大きな鳥は、もしかしたら木啄かもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "お媼さんは薄い髪を切り下げにして幅のせまい黒繻子の丸帯を、貝の口に結び上げた、少し曲った腰を、たたきたたき、お爺さんが実家へ帰って留守の夜などはとりわけ広い家のなかをぐるぐる見廻って、下男や下女に、内外の戸締りなどを厳しく云うのであった。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　鋭くいわれて、女はこわごわ面を上げながら、燃えさかってきたたき火のあかりで、しげしげ右門の姿を下から上に見ながめていましたが、そのみずみずしくも秀麗な美丈夫ぶりに、それとうなずかれたものでありましょう。",
              "citation": {
                "source": "右門捕物帖",
                "author": "足のある幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇畑たたきたたき土用かと聞けば土用だ土用だと麻がいふた　　　◇麻の下葉が落ちよと枯りよと土用に刈らりよか麻の木を　岩島からは対岸の山がせまつて来て、吾妻川は次第次第に急流となつて来る。",
              "citation": {
                "source": "大利根八十里を溯る",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "ようかわいがったげるさかいな、精だしてお稼ぎや」　桃龍が、笑いもせずもう一遍、「え――、里栄はんの姉妹御ゲン里はんでござい……」　章子は、獅々舞いが子供を嚇すように胸を拳でたたきたたき笑いこけている小婢の方へじりじりよって行った。",
              "citation": {
                "source": "高台寺",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "水を飲みに池のふちに下りたのも尾でたたきたたき啼いている。",
              "citation": {
                "source": "茶粥の記",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "木魚をたたきたたきその児の後生を弔ってまわった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "小春日に背中を暖めながら、軽口をたたきたたき、五日市街道の関宿の近くをのそのそと道中をするふたり連れ。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "日高川",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝島から運んできたたきぎを、山とつんで、まる一日たきつづけた。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
