        "examples": {
          "standard": [
            {
              "text": "北極圏は人類にとって最大の極限環境である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "極限環境での生存訓練に参加したスポーツ選手たちがいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "砂漠での極限環境調査が進められている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "なるほど、とここで閃き、「『ぞなもし』とは要するに、極限環境微生物なのだ」と断言してみる。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "では水中に暮らす魚も極限環境微生物かとなりそうなので訂正すると、通常見慣れた生き物が暮らすことのできない場所に住む微生物を指す。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはまあ、極限環境へなど人間だって出かけて行くのは一苦労となりそうだから、見つからないのが自然である。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "人が入るには、我慢試しにも熱すぎるから極限環境であるに違いない。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "極限環境微生物と関係があるのではという着眼点はなかなかだった」と、急にこちらを採点しだし、「だが、『ぞなもし』と『極限環境微生物』は、お湯でつながるわけではない」と一拍を置き、勿体ぶって、「両者は『起源』でつながるのだ」と言う。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
