        "examples": {
          "standard": [
            {
              "text": "子どもの転落事故が相次いだため、公園の遊具に緊急対策として安全フェンスが設置された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "豪雨被害を受けた市は、床上浸水家屋の清掃を支援する緊急対策を打ち出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "緊急対策を協議するため、関係省庁の担当者が深夜に官邸に集まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "つづいて六月十一日に八項目から成る「経済緊急対策」を発表、同十九日に業種別平均賃銀千八百円ベースを公表した。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "農村の疲弊は経済的窮迫に原因するものとして、その緊急対策が講ぜられた。",
              "citation": {
                "source": "農村の文化について",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで警保局は緊急対策を慎重協議の揚句、あたらずさわらずの方針をヤット確立することにしたのである。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際、これは実験ではなく緊急対策であった(22)。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
