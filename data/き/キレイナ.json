          "literary": [
            {
              "text": "千代紙｜貼リマゼ、キレイナ小箱、コレ、何スルノ？",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、アソコニハ、サカナ　ト　イウ　キレイナ　オヨグ　モノ　ガ　イテ、ソレハ、ソレハ、オモシロイ　トコロダ　ト　タカ　ハ、ヤマキチ　ヘ　オシエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナント　イフ　キレイナ　コヱデセウ」「アンナニ　ヨイ　コヱデ　ウタフ　コトノ　デキルノハ　タレデセウ」ト　ナタネノ　ツボミタチハ　ウツトリシテ　ササヤキアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人は背の高いキレイナ人で、清元のお浚いの時に山台に乗って、二、三人で唄っていたことがあって、みんなにオシイー、オシイー、とほめられた人だった。",
              "citation": {
                "source": "大丸呉服店",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハ大ヘンヨロコンデ、ボンコチヤンノリボンヲ前ヨリモモツトモツトキレイナノニトリカヘテ、キレイナ桃色ノ箱ニイレテ、空色ノリボンデソノ箱ヲシバリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
