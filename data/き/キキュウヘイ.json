        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "午後乗り組みの帰休兵が運動競技をやった。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "マニラの帰休兵とかで茶色の制服に中折帽を冠ったのがここばかりでない途中でも沢山見受けた。",
              "citation": {
                "source": "根岸庵を訪う記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "無期帰休兵のグーセフが、釣床から半分起きあがって、小声で言う。",
              "citation": {
                "source": "グーセフ",
                "author": "ГУСЕВ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐるりには帰休兵や乗組員たちが、帽子を脱いで立っている。",
              "citation": {
                "source": "グーセフ",
                "author": "ГУСЕВ",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰休兵と乗組員は十字を切って、舷越しに波を覗き込む。",
              "citation": {
                "source": "グーセフ",
                "author": "ГУСЕВ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はシャン・ダジール（訳者注　フランスの追放者帰休兵らによって当時アメリカに建てられていた植民地）に金を出していた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
