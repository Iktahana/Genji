        "examples": {
          "standard": [
            {
              "text": "江戸時代の俳諧や浮世草子は近世文学の代表的なジャンルとして国文学の授業で取り上げられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "近世文学を専門とする教授は、西鶴の作品を通じて当時の大坂商人の暮らしを読み解いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼は近世文学の研究を進めるうち、江戸期の出版文化に深い関心を抱くようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "近世文学なんて私大嫌です。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした卑俗な言葉で書かれた内容も従って卑俗な文学が、ロマンスという近世文学の形式であったことは誰しも知っている。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
