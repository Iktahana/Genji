          "literary": [
            {
              "text": "キミハ　テガツカヘルクセニ　アシデ、ナンキンマメノ　カハヲムイテ、タベルヂヤナイカ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ウオオ、ウオオ、ウオオ、キミハ　キガチガツタラシイヨ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゲガドンナニ　オホキクナツテモ　キミハ　ヤツパリ　コイヌ　ナンダヨ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミハユキ、ワレハヤム、という打電だけで私は平常親友とまでゆかない間柄なのに、急速に宇野浩二に近づいていったのは宇野がもう生きていないことが、もとになっていた。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミハ、ハイニナルノガ、コワクナイノカ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キミハ、ツヨイネ、エライコドモダ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
