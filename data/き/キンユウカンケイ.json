          "standard": [
            {
              "text": "彼は大学で経済学を学んだ後、金融関係の仕事に就いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "金融関係の法改正が相次いだため、企業のコンプライアンス部門は対応に追われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「金融関係にお勤めなんですか」と聞かれ、彼は「証券会社のアナリストです」と答えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ところで、金融関係も預金者側もだれひとり知らぬうちに、沼間氏はいつの間にか一文なしになり、銀行の経済状態までが危殆に瀕していたのである。",
              "citation": {
                "source": "キャラコさん",
                "author": "社交室",
                "note": "青空文庫"
              }
            }
          ]
        }
