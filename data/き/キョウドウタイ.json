[
  {
    "uuid": "5454760a-7e4e-5fbc-9bf3-a3343dea994f",
    "entry": "共同体",
    "reading": {
      "primary": "きょうどうたい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
