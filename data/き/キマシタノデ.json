          "literary": [
            {
              "text": "ヤマキチ　ハ　イタクテ　オイオイ　ナイテ　イマスト、タカ　ガ　ムカイ　ニ　キマシタノデ、イソイデ　ヤマ　ヘ　ツレテ　カエッテ　モライマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンダマト　テフテフハ　タカイ　タカイ　トコロマデ　キマシタノデ、マチガ　ツミキザイクノヤウニ　チヒサク　ミエマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タローサンハ　モシモ　トチウデ、コマルコトガデキ、タラト、バスケツトノナカヘ　デンシヨバトヲイレテキマシタノデ、テガミヲツケテ、ハナシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
