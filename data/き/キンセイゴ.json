        "examples": {
          "standard": [
            {
              "text": "『古事記』は近世語で記されており、現代人には理解が難しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "言語学者が近世語の特徴を分析して論文を発表した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "現代日本語と近世語の違いを学ぶことは、言語の変遷を知る上で興味深い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "資性温順の上に、天成の麗質であったが、厳粛なる家庭教育の下に人となり、ことに古文学および近世語に熟達しておった。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーツ科（古文学、歴史学、論理学および哲学、数学、近世語学）　右の諸学を、一年を限りまたは数年にまたがりて履修する課程に候。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
