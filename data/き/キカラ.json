        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "和田ノ詮議モ終ラヌサキカラ、ソノヤウニ騒ギタテテハ、モノノ順序ガドウナリマス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "チイサイ　トキカラ、ヤマ　ノ　ケモノ　ヤ、トリタチ　ト、ナカヨク　アソンデ　ソダチマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、ウグヒスタチハ　ミンナデ　イツシヨニ、キカラ　キヘ　ツタハリナガラ、ニギヤカニ　コドモタチノ　ハウヘ　アソビニ　ユキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　スルト、アサツユハ、ハノ　サキカラ　ピヨイト　ハナレテ　プツント　ヂベタヘ　オチテ　シマヒマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "）よしんばそれが諸※のインチキカラクリの所産であっても、それなしにウッカリ女も口説かれぬという秘蔵の媚薬。",
              "citation": {
                "source": "おみな",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "）よしんばそれが諸々のインチキカラクリの所産であつても、それなしにウッカリ女も口説かれぬといふ秘蔵の媚薬。",
              "citation": {
                "source": "をみな",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハサッキカラ呆レテ突ッ立ッタキリデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………雨ノ日ハ手足ノ工合ノ悪サガ一層ヒドク、雨ガ降リ出ス前ノ日アタリカラ豫感ガアルノダガ、今日ハ朝起キルトキカラ手ノ痺レ加減モ脚ノ浮腫ミ加減モ縺レ加減モ甚ダシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「颯チャン、颯チャン、ワア、ワア、ワア、―――」「オ止シナサイヨ、オ爺チャン」サッキカラ少シ薄気味悪ソウニ黙ッテジット予ノ表情ヲ見ツメテイタ颯子ハ、偶然眼ト眼ガ打ツカリアッタラ、咄嗟ニ予ノ心ノ変化ヲ看テ取ッタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――オ爺チャン、サッキカラ何シテルノヨ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
