    "definitions": [
      {
        "index": 1,
        "gloss": "kinako",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お餅にきな粉をたっぷりまぶして食べるのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "きな粉と牛乳を混ぜて、ヘルシーなドリンクを作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "焼き立てのパンから、香ばしいきな粉の香りがする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "和菓子屋さんできな粉団子を買って帰った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "お空はこれから銀のきな粉でまぶされます。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、さらに目を転ずると、今までなまもちにそれをつけながらかじりかじり張り番をしていたらしく、三人の子どもの死骸のまくらもとに、きな粉のさらがうやうやしく置いてあるのがふと目に映ったものでしたから、名人の顔が美しくほころびました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "二刻近くもヤットウのおけいこをなさっては、さだめしご空腹でござりましょうから、ちょっとお手貸しいたしましょう」　静かに立ち上がりながら、きな粉のさらを手にすると、「おにいさん……」　声からしてできが違うのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そなた、このきな粉に未練がおありだろう。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほら、きな粉をあげるから、たっぷりつけておあがりな」　まったくうれしいくらいでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "果然、狂人は名人のずぼしどおりきな粉に未練があったとみえて、にやりとしながらおとなしく近よってきたところを、――やんわりと軽く草香流！",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆっくりきな粉をおなめな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜はクリスマスの前夜ですから、大きな粉挽場の中は、目のさめるように美しくかざり立てられていました。",
              "citation": {
                "source": "フランダースの犬",
                "author": "A DOG OF FLANDERS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「別にこれってきめてはいないんですがね」　きな粉色のスーツが黒い髪によく似合っている素子が答えた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "きな粉・炒粉のように火にかけたものもまた砕けやすい。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「他のことなら此方から訊いたつてロク／＼答へない男が、自分の好きなことならあんなに訊かない先に答へるんだ」と兄は思つた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」つてな大きなことを言つてゐる。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の好きなことをするに気がねがいらなくなったように思われたらしい。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の畫の好きなことは全く天性といつても可からう、自分を獨で置けば畫ばかり書いて居たものだ。",
              "citation": {
                "source": "畫の悲み",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の画の好きなことは全く天性といっても可かろう、自分を独で置けば画ばかり書いていたものだ。",
              "citation": {
                "source": "画の悲み",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」少し大きなこどもがききました。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんの、のんきなことがあるものか。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「大きなことだよ。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "瀬古　　そうしておはぎはあんこのかい、きなこのかい、それとも胡麻……白状おし、どれをいくつ……沢本　　瀬古やめないか、俺はほんとうに怒るぞ。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともちゃんが家を出ようとすると、お母さんが「ともや、ここにこんなものが取ってあるから食べておいでな」といって、鼠入らずの中から、ラーヴェンダー色のあんこと、ネープルス・エローのきなこと、あのヴェラスケスが用いたというプァーリッシ・グレーの胡麻……戸部うなり声を立てる。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十八等官でしたから役所のなかでも、ずうっと下の方でしたし俸給もほんのわずかでしたが、受持ちが標本の採集や整理で生れ付き好きなことでしたから、わたくしは毎日ずいぶん愉快にはたらきました。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その大きなこわれかかった白い建物の二階で、だれか大きな声でしゃべっていました。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿部川と言へば、きなこ餅とばかり心得、「贊成。",
              "citation": {
                "source": "雨ふり",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それであといくらも残らなかったがたぶん足りるだろうとのんきなことを考えながら、私をかき船に誘ったということだった。",
              "citation": {
                "source": "天衣無縫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろ考えた末、ポケットにさしてある万年筆に思い当り、そや、これで十円借りようと、のんきなことを考える。",
              "citation": {
                "source": "天衣無縫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きなこはくの窓をあけると、さかなたちがおよいではいってきました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、音楽に耳をかたむけたり、車のひびきや、人々のざわめきを聞くのもすてきなことでしたし、また、たくさんの教会の塔をながめて、鐘の鳴るのを聞くのも楽しかったそうです。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまり、なまいきなことを言うんじゃないよ！",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "世の中に、これほどすてきなことはありゃあしない、と、モミの木は思いました。",
              "citation": {
                "source": "モミの木",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだ、もっと大きなことが、もっとすばらしいことがくるにちがいない――！",
              "citation": {
                "source": "モミの木",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
