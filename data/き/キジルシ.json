[
  {
    "uuid": "1faef803-15c6-5b48-8e16-b5c507ddf095",
    "entry": "キ印",
    "reading": {
      "primary": "キじるし",
      "alternatives": [
        "きじるし",
        "キジルシ"
      ],
      "is_heteronym": true
