        "examples": {
          "standard": [
            {
              "text": "その虚聞は根拠がない",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "町で虚聞が広がっている",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "虚聞を信じるべきではない",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "随分相当分別のある人までがそういう虚聞を信じて、私と大杉とが交際あるのを知らないで、「アナタのお宅の裏には大変な危険人物がいて、毎晩｜多勢集って隠謀を企らんでるそうです、」と告げたものもあった。",
              "citation": {
                "source": "最後の大杉",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "板垣の復活、自由黨の再興、何たる捏造説ぞ、余の夢にも覺えざる虚聞なり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "板垣の復活、自由党の再興、何たる捏造説ぞ、余の夢にも覚えざる虚聞なり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
