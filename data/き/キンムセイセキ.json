        "examples": {
          "standard": [
            {
              "text": "年に一度、勤務成績の評価が上司から伝えられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "勤務成績の良い社員には、ボーナスが加算される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新入社員の勤務成績は、期待よりも良好だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "毎朝倉庫の扉を開放するのも彼の役目だったから万々疑ぐられることはない――此の方法に依れば、全然勤務成績に影響を及ぼすことがない――「だが、宿直員の店内巡回と云うやつがあるぞ」　然し、これは極わめて形式的に行なわれる。",
              "citation": {
                "source": "扉は語らず",
                "author": "小舟勝二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「勤務成績なんか糞喰らえだ。",
              "citation": {
                "source": "扉は語らず",
                "author": "小舟勝二",
                "note": "青空文庫"
              }
            },
            {
              "text": "秘書が帳面につけるとすれば、私の勤務成績は満点だったろう。",
              "citation": {
                "source": "ガラマサどん",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
