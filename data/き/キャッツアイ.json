        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖母の形見の指輪には、珍しいキャッツアイが埋め込まれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "光の当たり方で表情が変わるキャッツアイのブレスレットを誕生日プレゼントに選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このキャッツアイは、見る角度によって猫の目のように光の筋が現れるんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "指環モ取リ換エテ、何ト思ッタカ問題ノキャッツアイヲ篏メテ来テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "膝ノ上ニキャッツアイヲ煌カシツヽ座布団ノ上ニ横ッ坐リニ坐ッタマヽデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「叔母サン、ソレガキャッツアイッテ云ウ石デスカ」座ガ白ケルトデモ思ッタノカ、菊太郎ガ突然云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サア勝ッタ、モウイヤダナンテ云ワセヤシナイ」「何ダネ、君ノ要求ハ」「ビックリシテ腰ヲ抜カサナイヨウニ」「何ダヨ一体」「コノ間カラ欲シイト思ッテタモノガアルノ」「ダカラ何ダヨ」「キャッツ・アイ」「キャッツ・アイ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ油谷サンノ奥サンガ何ヨリ先ニ眼ニ附イタノハ、颯チャンノ指ニ光ッテイタキャッツ・アイダト云ウンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥サンノ見タトコロデハキャッツ・アイト云ッタッテアンナ大キナ立派ナ石ハ、ソンナニザラニアルモンジャナイ、恐ラク十五カラット以上アルコトハ確カダト云ウンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今マデ颯チャンガソンナ石ヲ持ッテタノヲ、オ婆チャンモ見タコトハナイト仰ッシャイマスシ、アタシモ知リマセンケレドモ、イツアンナモノヲ買ッタンデゴザイマショウネ」「………」「ソウ云エバ岸サンガ総理大臣ダッタ時、佛印カ何処カデキャッツ・アイヲ買ッテ問題ニナッタコトガアリマシタッケネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
