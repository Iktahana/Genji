        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "長方形な滑かな頭と胴体をぐつと掴んで、しみじみと見ると、キララともせず、柔かく、素直で、スツキリとして、方に清長の美人の体駆である。",
              "citation": {
                "source": "魚美人",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "明るい日向に泳ぎ出で、キララな光線の中へ顔を擡げてヂッとしてゐる。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "（近所の人たちどやどや入って来るパトリックとデリヤも彼等と一しょにいる）パトリック　　港に船が来ているよ、フランス人がキララに上陸するとこだ！",
              "citation": {
                "source": "カスリイン・ニ・フウリハン（一幕）",
                "author": "CATHLEEN NI HOOLIHAN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
