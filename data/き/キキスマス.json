[
  {
    "uuid": "31933730-c425-56cd-a171-2891107b0171",
    "entry": "聞き澄ます",
    "reading": {
      "primary": "ききすます",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
