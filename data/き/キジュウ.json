        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "冒険者は、巨大な狼を騎獣とし、雪原を駆け抜けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "異世界では、ドラゴンを騎獣にする騎士も珍しくないそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あのキャラクターが乗っている騎獣は、どうやら空を飛べるらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "森の奥で、珍しい騎獣の足跡を発見した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
