        "examples": {
          "standard": [
            {
              "text": "両国の国境紛争が釁端を開き、外交交渉は暗礁に乗り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "歴史家はその事件を釁端として、長い戦争の始まりを分析している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "小さな領土問題が釁端となって、地域全体に戦火が広がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
