          "literary": [
            {
              "text": "青水泥ひどらが沼、蟠るぬめり蟒、憚らず曠野巨牛、畏る無し禍つ狼。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "青水泥ひどらが沼、蟠るぬめり蟒、憚らず曠野巨牛、畏るなし禍つ狼。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸い、この八月十七日に二十村郷の竹沢村に六十頭の前頭、大関、横綱級の巨牛が出場して、火花を散らして闘うことになっているから、ぜひ案内したいものだ。",
              "citation": {
                "source": "越後の闘牛",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤は、両の角を敵の横頸へ立てると、なんの猶予もなく、そのまま電撃の疾さをもって、押し立て押し立て、二百余貫の巨牛を土手の中腹まで押しあげてしまった。",
              "citation": {
                "source": "越後の闘牛",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで私は、二頭の巨牛の尻尾を両手につかまえ、暴れる牛を後ろ歩きにさせて賊の屯の近所まで持って行ってやりました。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
