        "examples": {
          "standard": [
            {
              "text": "彼女はこの会社の金庫番として、すべての資金の出入りを一手に管理している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "政党の金庫番を長年務めた元幹事長が、不正流用の疑いで家宅捜索を受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "うちの家族で金庫番を任されているのは、細かい計算が得意な母だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "もっとももう一人補助者として金庫番の山形君をつけてやろう」「課長。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、それから山形君」といって金庫番の柔道四段の青年を呼んでポケットから黄表紙をだした。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそれを追いかけていって、このとおり壁で鼻をいやというほどつぶしてしまいました」　金庫番の山形は、鼻血をだして赤く腫れあがった自分の鼻を指した。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
