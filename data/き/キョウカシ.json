        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "半井卜養という狂歌師の狂歌に、浦島が釣の竿とて呉竹の節はろくろく伸びず縮まず、というのがありまするが、呉竹の竿など余り感心出来ぬものですが、三十六節あったとかで大に節のことを褒めていまする、そんなようなものです。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "諏訪町の狂歌師｜千種庵川口｜霜翁の後を襲いで、二世千種庵と云う。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "王侯貴人が往々文芸の士を羅致して、声威を張り儀容を飾る具となすように、藤次郎は俳諧師、狂歌師、狂言作者、書家、彫工、画工と交って、その多数を待つことほとんど幇間と択ぶことが無かった。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "狂歌師には勝田諸持とその子福太郎と、室田鶴寿、石橋真国がある。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼学者の渋江抽斎、書家の市河米庵、ないし狂歌師仲間の六朶園荒井雅重、家元仲間の三世清元延寿太夫等と同じく、虎列拉に冒されたのかも知れない。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬼が出るか、蛇が出るか……」　目明の良助に誘われた乞食｜体の狂歌師、赤猪口兵衛は二、三本の渋団扇を縄の帯に挿したまま、春吉三番町のお目付役、松倉十内国重の玄関脇の切戸から、狭いジメジメした横露地を裏庭の方へ案内された。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "名物男の狂歌師、赤猪口兵衛の独住居はすべて二、三日前の通りに閑寂である。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　狂歌師岡鹿楼笑名　前記の報条は多分喜兵衛自作の案文であろう。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "狂歌師としては無論第三流以下であって、笑名の名は狂歌の専門研究家にさえ余り知られていないが、その名は『狂歌｜鐫』に残ってるそうだ。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この驕々たる三馬が一日思い立って日本橋から遠い四谷の端れまで駕輿をやったのは、狂歌師｜宿屋飯盛としての雅望と、否、それよりも六樹園の本来の面目である国文学の研究に少からず傾到するところがあったからだ。",
              "citation": {
                "source": "仇討たれ戯作",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "めっかち長屋の一｜棟、狂歌師｜手枕舎里好と名乗る男の家である。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おはようございます」「や、これは嫁御寮、お眼ざめかな、わっはっはっは、いや、おはよう」　あから顔の四十男、でっぷりふとって、狂歌師よりも質屋のおやじという人がら。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "狂歌師の里好さん――？",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "この女のひとと、婦人の狂歌師――諷刺詩人が一人いてね、それもどういうのか知りたいの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある狂歌師の作に曰く、負けて勝つ心を知れや首引きのかちたる人の仆るゝを見よ　ジャンケンで勝負を決するのも同様である。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると此の狂歌師の中へ職人を入れたら品格が悪くなるだらうと拒んだものもあつたが、ナニ職人だツて話が上手なら仔細ないと云ふ事で、可楽を入れてやらせて見た所が、大層評判が宜しく、可楽が出るやうになつてから、一ト際｜聴手が殖えたと云ふ位。",
              "citation": {
                "source": "落語の濫觴",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしてこれらの絵本はいづれも当時著名の狂歌師の吟咏を画賛となせり。",
              "citation": {
                "source": "江戸芸術論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "俳諧は正風体の刷新によりてますます世の迎ふる所となりしが、狂歌は卜養貞柳未得らの以後その吟咏に工みなるものなかりしが故か、一時やや振はず、安永末年朱楽菅江唐衣橘洲四方赤良ら青年狂歌師の輩出するを待つて始めて再興せられたり。",
              "citation": {
                "source": "江戸芸術論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "大汐に松をかすめて猪牙とほり　一世に諷はれた天明の狂歌師で、川柳家としては牛込蓬莱連の盟主だつた朱楽菅江にはこの川柳があり、近世では伊藤松宇に、しぐるゝや嬉しの森に首尾の松がある。",
              "citation": {
                "source": "下町歳事記",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも一休と同じやうに、おどけやの皮肉屋で朝から晩まで茶化してゐる狂歌師か、幇間みたいな曾呂利が通念になつてゐるが、ぼくの考へでは、何も青年時代からあんな洒落一點張の道化師ではなかつたらう、さういふ諦觀に行きつく迄の曾呂利新左衞門といふ人間の、苦しい人生道中と苦悶を探り知りたいと思ふ。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
