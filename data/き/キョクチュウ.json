[
  {
    "uuid": "3624b2f3-8bdc-5ab2-9499-7a677a2227c2",
    "entry": "曲中",
    "reading": {
      "primary": "きょくちゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
