          "literary": [
            {
              "text": "そのゴーゴーと云う音の中に、遠くから鈴の音が入って来る……）さぶ　あゝ、鷲山のキチゲ婆さんが来た。",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キチゲなどと云うと罰が当るぞ。",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（鈴の音がとまる）そうじゃあるめえ、キチゲのふりして、そうやってツラ当てに歩いてるだけずら？",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲買　ああ、一日キチゲの？",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の子　やいこら、キチゲばば――どけえ行くよ？",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の子　（前出）やいやい、キチゲばば！",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
