[
  {
    "uuid": "22fdffbe-fe47-55c2-a86c-0beabd916004",
    "entry": "気づき",
    "reading": {
      "primary": "きづき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
