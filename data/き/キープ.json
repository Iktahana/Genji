[
  {
    "uuid": "e266e3ae-131e-5d77-811b-d7783a3d3731",
    "entry": "キープ",
    "reading": {
      "primary": "キープ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-サ変",
        "動詞-他動詞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to keep (e.g. the lead)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "前半で先制点を奪ったチームはその後もリードをキープし、一対ゼロで試合を終えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "体重をキープするために、彼女は週三回のジョギングを欠かさない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "職人は窯の温度を一定にキープするため、夜通し火の番をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "破れかぶれのライターに発表会を葬式にされてしまったワークスは、売り上げランキングの上位をキープする大ベスト・セラーとなった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ママズ＆パパズの〈マンデイ・マンデイ〉と、スペンサー・デイヴィス・グループの〈キープ・オン・ラニング〉だ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これ、おまえのぶん」　といって、高志は〈キープ・オン・ラニング〉を慶一にわたした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま、四階は〈アイ・フィール・ファイン〉、慶一と柾生は〈キープ・オン・ラニング〉、二階は〈スループ・ジョン・Ｂ〉をやっている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "なしくずしに、〈キープ・オン・ラニング〉が終わる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは、むずかしいよ」　柾生が、さっきの〈キープ・オン・ラニング〉のことを、いま終わったように話しはじめた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこの番組だって、ヒット中の曲はなんどもかけるだろ」「〈キープ・オン・ラニング〉にしたら？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ディス・プログラム・イズ・コンパイルド・バイ・ケイ・アンド・ユアーズ・トゥルーリー、キープ・ユア・ヘッド・アップ、ティル・ネクスト・サンデイ、バイバイ」　ワラのあいさつが終わると、〈バルボア・ブルー〉が大きくなり、二〇秒ほどでフェイドアウトした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "これでは音程もはずれるし、リズムもキープできないだろう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分から他人の垣を越えようとせず、ある垣を此方からもキープアウトして居る。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンキープールの奇遇　私はブダガヤに参詣するばかりが目的ではなかった。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜汽車に乗り翌日昼過ぎにバンキープールという停車場に着きました。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "浩がボトルキープしておいたウイスキーはすぐなくなり新しく注文しなくてはならなかった。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "キープラ　Jan Kiepura　映画の方では非常に有名な歌手だが、私などはあまり興味を持てない。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "テナーのキープラ、ソプラノのムーアと同じように私は考えている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いい女といい庭をキープ・アップするのには金がかかるのだ。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャンキープラといふ本格歌手を生かした、音楽映画だが、何うも買へない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to put aside (for someone)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "人気の席だから今のうちにキープしておいてよ、あとで合流するから。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼は最後の一個のシュークリームをキープして、帰ってくる妹のために残しておいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「この資料、来週の会議まで私の分をキープしておいてもらえますか」と同僚に頼んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "to keep (the ball; in soccer, rugby, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "相手のプレスをかわした選手はボールをキープしながら味方の上がりを待った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "コーナー付近でキープし続けた彼のおかげで、チームは終了間際のピンチを切り抜けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "監督は「焦らずキープして相手を引きつけてから展開しろ」と選手に指示した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 4,
        "gloss": "to hold service (in tennis)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "第一セットを取った彼女はサービスゲームを確実にキープし、そのまま優勝を決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "長いラリーの末にキープに成功した選手は、ガッツポーズをしながら大きく息をついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ブレークされた直後に自分のサービスゲームをキープできたのが、試合の流れを取り戻す転機になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 5,
        "gloss": "person one is dating while hoping for someone better",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「あの子、本命じゃないのにずっと連絡してるの？」「まあ、キープかな」と彼は悪びれもせず言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "自分がキープにされていたと気づいた瞬間、彼女は着信を無視することにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "本命に振られた途端に急に優しくなってきたのを見て、自分はキープだったのだと確信した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
    ],
    "relations": {
