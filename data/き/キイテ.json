        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "キイテ　タイソウ　ヨロコンデ「ヨシヨシ　ワタシモ　コノコブヲゼヒトモ　トツテ　モラヒマセウ」　と勇み立つ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ、ソノ　ハナシヲ　キイテ、スグニ、ウミ　ト　イウトコロ　ヘ　ユキタクテ　タマラナク　ナリマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ前タチ、デンデンムシノ　ウタ　シラナイカ」ト、オソバノ　モノニ　キイテモ、「シリマセン」ト　イツテ　クビヲ　カシゲテ　ヰマス。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キイテ　ヰタ　トシヨリハ　フカイ　タメイキヲ　ツイテ、「センサウハ　モウ　タクサンデス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガヤノ人タチハ、ソレヲキイテイルウチニ、一人一人ミンナモライ泣キヲシテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　ソノ間道子ハ黙ッテキイテイタノカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "北海道ハ、タイヘン寒イトユフコトヲキイテタマゲマシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　コレヲキイテコホロギサンハ大笑ヒシマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」三　三匹ノコグマサンハ、ソレヲキイテ、方々サガシマシタ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナツテ、人参サンハ　ジヤガイモサント、ケンクワヲシテヰルコトヲ思ヒ出シマシタガ、シカタナク、何度モ、ソノコトヲ話ニジヤガイモサンノオ家ノ入口マデ行ツテハ、「エエ、イマイマシイ、ボクノハウカラ、口ヲキイテヤルナンテコトハナイ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンコチヤンハソレヲキイテ　一シヨニカナシクナツテ、ワン、ワンナキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤントワンコチヤンノナキゴヱヲキイテ、オ母サンハ、キツト、ワンコチヤンガモンコチヤンニホエツイタノダラウトオモヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクル朝、ボンコチヤンハ、ボーイサンニ「バウシノオ父サン」ノオ家ヲキイテ、トコロトバンチヲカイテモラヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹ハソレヲキイテ噴キダシタ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノコトワ、本ヲヒロウタ人ニキイテ下サイ、サウシテワタシヲ此所カラダシテ下サイ、アナタワ、キレイデ、カシコイ人デスカラ、キツト助ケテ下サイマス。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
