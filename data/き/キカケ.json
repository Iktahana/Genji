        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ドッコイ、ドッコイ、ドッコイショと、爺様のような懸声をしながら漸く河を渡り、やがて町付という寒村に来掛かれば、もう時刻は正午に近い。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一八）焼酎の御馳走　一行は多少ヤケ気味に、それよりはブラリブラリと牛の歩み宜しく、またもや一里あまり進んで、南方村という寒村に来掛かれば、路傍の開放されたる一軒家では、褌一本の村の爺さん達四、五人｜集って、頻りに白馬か何か飲んでいる。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "抽斎がそこへ来掛かると、本箱が崩れ墜ちた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "太政官を退出した横井平四郎の駕籠が、寺町を御霊社の南まで来掛かつた。",
              "citation": {
                "source": "津下四郎左衛門",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ臼田才佐と云ふものが来掛かつたので、それをも誘つて、三人で茶店に入つて酒を命じた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "是は来掛かる人に彼問を試みて、怖るべき面貌を見せたのであるが、柏軒は近視で其面貌を見なかつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃そろそろ出来掛かった文芸界のBohemiensが、岡村の交際している待合のお上だの、芸者だのの目に、いかに映じているかと云うことを聞くに過ぎない。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃そろそろ出来掛かった文芸界の 〔Bohe'miens〕 が、岡村の交際している待合のお上だの、芸者だのの目に、いかに映じているかと云うことを聞くに過ぎない。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへフランスの兵が来掛かった。",
              "citation": {
                "source": "堺事件",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな事を、幾分かの注意を払って見た為めに、歩調が少し緩くなって、家の真ん前に来掛かるまでに、数秒時間の余裕を生じた。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨がかかると鶯の象が顕れるように言い伝えられた大きな石の傍へ来掛る頃は、復た連の二人がサッサと歩き出した。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、うッて変った優しい御声は、洋服を召した気高い貴婦人が其処に来掛って、あの可哀相な女の人をお呼止めになったのでした。",
              "citation": {
                "source": "昇降場",
                "author": "広津柳浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯うして、又もやそれ程近く迄伸びて来掛った救いの手が外れて、タイタニック号の人々は、よくよく其の夜の冷たい水に溺死す可き運命に決められていたのだろう。",
              "citation": {
                "source": "運命のＳＯＳ",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬車が白島から泉邸入口の方へ来掛かつた時のことである。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬車が白島から泉邸入口の方へ来掛った時のことである。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "其を偶然来掛つたモリエエルが瞥見した。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが或る日の放課後、行くでも帰るでもない正隆が、呆然と、図書室の柱により掛っているところへ、思いがけず、副島氏が来掛った。",
              "citation": {
                "source": "渋谷家の始祖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あちこち歩いているうち、或る立派な庭園の前に来掛った。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ母親が来掛かつた。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "その跡から山を下りて来掛かつてゐるのが三人あります。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "狆と見えますかね」　私は狆の見本を得ることに困難した話などしながら、出来掛かった彫刻を合田氏に見せている。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "葉茶屋の狆のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、これまで注文した分には、鷹、雉子、鴛鴦、鶴、鶉など……もう、それぞれ諸家の手で取り掛かったものもあり、また出来掛かっている物もあるのだという。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "鶏の製作を引き受けたはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "難有く思うのは、出来掛かっている人間です。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩人なるほどそうかも知れないが、そんならこのわたくしがやはり出来掛かった人間であった時を返して下さい。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへメフィストフェレス来掛る。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "富の神今どんな事が外から起って来掛かっているか、あいつは知らずにいるのだ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが今そろそろ出来掛かっているのです。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな舟が一艘、11145掘割をこちらへ来掛かっている。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その歸り道日本橋通りは電柱の行列と道普請と兩側の粗惡な建築物とで豫想外の醜惡な光景に、自分は呆然として却て物珍らしく彼方此方を眺めながら歩いて行くと偶然にも向うから來掛る宇田流水に出會つた。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
