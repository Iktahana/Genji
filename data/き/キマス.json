        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「咲キマス」　二日目には、酔いどれの若い紳士が、一本買った。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルヒ　アサカラ　ヨイテンキヤマヘ　ユキマス　シバカリニ　このお爺さんの楽しみは、お天気のよい日、腰に一瓢をさげて、剣山にのぼり、たきぎを拾ひ集める事である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルヒ　アサカラ　ヨイテンキヤマヘ　ユキマス　シバカリニ　このお爺さんの樂しみは、お天氣のよい日、腰に一瓢をさげて、劍山にのぼり、たきぎを拾ひ集める事である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナタネノ　ツボミタチハ　カンバシイ　ニホヒノ　ナカデ　ダンダン　フクランデ　イキマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ　ヂキ、ネ」ト　一ツノ　ツボミガ　ササヤキマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テフテフハ　花トハ　チガヒマス、オハネガ　アツテ　アチラ　コチラ　トビマワル　コトガ　デキマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ヨビナガラ　オツカケテ　キマス。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ラツパシユニ　ナツテ　リツパニ　ハタラキマス」ト　ワカイ　ヲトコハ　コタヘテ、トシヨリタチノ　マエデ　イサマシイ　ラツパヲ　フイテ　キカセマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　トシヨリト　ワカレテ　ナホモ　アルイテ　イキマスト、ナルホド　アノ　トシヨリガ　イツタトホリ、ハタケハ　タイハウノ　ワヤ　ウマノ　アシデ　スツカリ　アラサレテ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イイエ、ワタシハ　ツイテ　イキマス」　ソシテ、テフテフハ　ヒラヒラト　アカイ　フウセンダマニ　ツイテ　イキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イイエ　ワタシ　ツイテ　イキマス」ト　シロイ　テフテフハ　イヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私ハ貴官ノ正シイ御心ヲ信ジテコノ手紙ヲ書キマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "下手な鉛筆の走り書きで、今スグ行キマス　ムコウノポストノソバデマツテイテ下サイ　と記されてある。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウトウヲ、イレテオキマス、ヘンジヲクダサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニヨリモ、カラダヲ、タイセツニ、イノル、フウトウ、イレテオキマス、ヘンジクダサイ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本帝国　東京　大関久五郎　地理学を修むる者　此宿ノ人ノ話ニ拠レバ、コレ迄吾日本帝国民ニシテコヽニ泊ッテ Jungfrau ニ登ツタ人ハ無イトノコトデス、本当カウソカハ私ハ知リマセンガ、兎ニ角コヽニ吾邦人ニシテコノ後コヽニ来リ宿ル方ニ対シ御免ヲ蒙ツテ私ノ名ヲ日本語デ書イテ置キマス。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "交番ニユキマスト、カワイラシイ女ノ子ノオマワリサンガヰテ、帳面ヲシラベテクレマシタガ、サツパリ玉ネギサンノスンデヰル村トイフノガ分リマセンデシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナミハ　ジヤブリ、サラ、サラ、ト　ジロウノ　ハダカノアシニ　カカツテハ　ヒイテユキマス。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゼニ　フカレテ、ゴミハ　ウエキノ　トコロマデ　トンデキマス。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　マイニチノヤウニ　カメコオバサンハ　マルコオバサンノ　トコロヘ　サウダンニ　ユキマス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おむすびヲツクツテ、ネズミイラズニ入レテオキマス。",
              "citation": {
                "source": "母子ホームの子供たち",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「十方三世ノ諸仏、ナラビニ本師釈迦牟尼仏、本来ノ願望ハ遂ゲザレドモ、父母、朋友、信者ノタメ、イマイチド生レ変ッテ仏法ノ恩ヲ報ズルコトガデキマスヨウニ」――この手が岩角から離れたときが今生の命の終りと、朦朧と偈をとなえていると、テンバが精気の霊薬だというコカの葉を智海の口もとにさしつける。",
              "citation": {
                "source": "新西遊記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピイ……トフヱヲ　ナラシテ、シロイ　ケムリヲ　　　　ダシタリ、クロイ　ケムリヲハイタリ、テッキヨウヲ　ワタッテ、トンネルヲ　ヌケテ、マタトンネルヘ　ハイッテ、ドンドン　ハシッテ　ユキマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンシンバシラヤ、ハタケヤ、モリヤ、イナカヤヤ、ケシキガ　ドンドンウシロヘ　ハシッテユキマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ偶然ニソウナッタノデアルガ、午後ノ六時ニ今夜ハオ暇ヲ戴キマスト云ッテ、佐々木ガ子供ノ所ヘ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「伯父サン、チョットオ邪魔サセテ戴キマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンガ颯子トノ結婚ニ反対シタ当時、「踊リ子上リナンゾッテ云ウケレド、キット彼女ハ家政ノ切リ盛リナンカモ上手ニヤッテ行キマスヨ、ソウ云ウ才能ノアルコトヲ僕ハ見抜イテルンデス」ト浄吉ハ云ッタガ、アノ時ハ恐ラク当寸法ヲ云ッタノデ、先見ノ明ガアッタ訳デハアルマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ一度測ラセテ戴キマス」結果ハ幸イニモ常態ニ戻ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後怱々鈴木氏ヨリ電話、「颱風ガ来ルト困リマスカラ本日ノ鍼ハ休マセテ戴キマス」トノコト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "辻堂ノ子供達モセイ／″＼使ワシテ戴キマスワ」「ソウダトモサ、イクラデモ這入リニ来ルガイヽ」飛ンダトコロデ敵ヲ取ラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
