        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「夾竹桃がたくさんあるじゃないの」　私は、わざと、つっけんどんな口調で言った。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一晩この家に寝かせて下さい、玄関の夾竹桃も僕が植えたのだ、庭の青桐も僕が植えたのだ、と或る人にたのんで手放しで泣いてしまったのを忘れていない。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "草原には矮小な夾竹桃がただ一輪真赤に咲いている。",
              "citation": {
                "source": "ゴルフ随行記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月の中ごろ、私はお隣りの庭の、三本の夾竹桃にふらふら心をひかれた。",
              "citation": {
                "source": "めくら草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、あとは奥さまとことし十六になる娘さんとふたりきりで、夾竹桃のことは、かえって恐縮であって、どれでもお気に召したものを、とおっしゃった。",
              "citation": {
                "source": "めくら草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三本のうち、まんなかの夾竹桃をゆずっていただくことにして、私は、お隣りの縁側に腰をかけ、話をした。",
              "citation": {
                "source": "めくら草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夾竹桃などめずらしいのです。",
              "citation": {
                "source": "めくら草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、多少いい気持ちで夾竹桃などに心をひかれたのをくやしく思っていたので、その木の植えかた一さい家人にまかせ、八畳の居間でマツ子と話をした。",
              "citation": {
                "source": "めくら草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹藪の中で、赤く咲いているのは夾竹桃らしい。",
              "citation": {
                "source": "令嬢アユ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、やがて眼近い夾竹桃は深い夜のなかで揺れはじめるのであった。",
              "citation": {
                "source": "ある心の風景",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗のなかの夾竹桃はそのまま彼の憂鬱であった。",
              "citation": {
                "source": "ある心の風景",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "病院境いの鉄柵までには夾竹桃などの咲いた芝生があって、テレスに添うては篠懸の一列の木かげが、あたりを青く染めたように、濶い葉を繁らせていた。",
              "citation": {
                "source": "草藪",
                "author": "鷹野つぎ",
                "note": "青空文庫"
              }
            },
            {
              "text": "夾竹桃、枸櫞樹、たこの木、オレンジ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "夾竹桃の家の女　午後。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "夾竹桃が紅い花を簇らせてゐる家の前まで來た時、私の疲れ（といふか、だるさといふか）は堪へ難いものになつて來た。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "檳榔と竝んで、ずつと丈の低い夾竹桃が三四本、一杯に花をつけてゐる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそれに背中を向けて、入口の夾竹桃の方へ歩き出した。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根を叩き、敷石を叩き、椰子の葉を叩き、夾竹桃の花を叩き落して、すさまじい音を立てながら、雨は大地を洗ふ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨が霽つてから暫くして表へ出て見たら、まだ濡れてゐる敷石路を、向ふから先刻の夾竹桃の家の女が歩いて來た。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "夾竹桃が紅い花を簇らせている家の前まで来た時、私の疲れ（というか、だるさというか）は堪えがたいものになって来た。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "檳榔と並んで、ずっと丈の低い夾竹桃が三、四本、一杯に花をつけている。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根を叩き、敷石を叩き、椰子の葉を叩き、夾竹桃の花を叩き落して、すさまじい音を立てながら、雨は大地を洗う。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨が霽ってからしばらくして表へ出て見たら、まだ濡れている敷石路を、向うから先刻の夾竹桃の家の女が歩いて来た。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "夾竹桃が紅い花を簇らせてゐる家の前まで来た時、私の疲れ（といふか、だるさといふか）は堪へ難いものになつて来た。",
              "citation": {
                "source": "夾竹桃の家の女",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "檳榔と並んで、ずつと丈の低い夾竹桃が三四本、一杯に花をつけてゐる。",
              "citation": {
                "source": "夾竹桃の家の女",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨が霽つてから暫くして表へ出て見たら、まだ濡れてゐる敷石路を、向ふから先刻の夾竹桃の家の女が歩いて来た。",
              "citation": {
                "source": "夾竹桃の家の女",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "とりわけ八月には、セン・マリ、セン・ルイの大祝日があるので、これを当てこんで何千本というえぞぎく、フクシア、きょうちくとうなどを温室や温床にはいりきらないほどしこんでおいた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "温室の温度と日光を弱めるために、わざわざ石灰乳をガラスのフレームにぬった温床の下で、フクシアやきょうちくとうがさきかけていた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
