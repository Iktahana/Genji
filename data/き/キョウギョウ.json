        "examples": {
          "standard": [
            {
              "text": "国内大手と海外スタートアップが協業して、新しい物流システムを開発した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "競合他社同士でも技術開発では協業することで、コストを大幅に削減できた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "農家と飲食店が協業し、規格外野菜を使ったメニューを共同開発した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "我々の党の組織は、将来の社会の完全な雛型で、そこには最も厳密な分業と協業とが行われている。",
              "citation": {
                "source": "鉄の規律",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
