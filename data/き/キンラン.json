  {
    "uuid": "ee5ea55c-fb8a-5c48-8054-27588dd736d3",
    "entry": "錦襴",
    "reading": {
      "primary": "きんらん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
