        "examples": {
          "standard": [
            {
              "text": "新入社員は勤倹力行の精神を胸に、仕事に励んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その企業の創業者は、生涯勤倹力行の姿勢を貫いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "勤倹力行できる人材こそが、企業の真の財産だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "翁も代々の家業であつた質屋を渡世とし、且つ縮の仲買をしてゐたが、文雅の士であつたにも関はらず商法には非常に熱心で勤倹力行大に家道を興こされた、平生東照公や楽翁公の為人を景慕し、専ら堪忍を旨として居られた、平生は粗衣粗食に甘じ、寸あつたので、官から度々その篤行を賞せられた。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "名古屋人同様皆｜勤倹力行の精神に富んでいます。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
