        "examples": {
          "standard": [
            {
              "text": "協商国との外交関係は、この地域の平和維持に大きな役割を果たしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "複数の協商国が一堂に会して、共同防衛協定に署名した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "協商国の間に意見の相違が生じたが、慎重な交渉により解決された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "今度の戦争で、協商国側にも連合国側にも或国民との相互扶助が行われました。",
              "citation": {
                "source": "三面一体の生活へ",
                "author": "与謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "協商国側も連合国側も軍事上政治上の協同だけでは戦争の出来ないことを知りました。",
              "citation": {
                "source": "三面一体の生活へ",
                "author": "与謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
