        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ただもう、きゃあきゃあ騒いでいる。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おめえは山の宿で、たった一晩、それだけを手がら顔に、きゃあきゃあ言っていやがる。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丘の上では、彼等が、きゃあきゃあ笑ったり叫んだりした。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "姐さんたちは、自分たちをお客に聘ばせて呉れた恩人のお雛妓の顔を立てて、ばつを合せるようにきゃあきゃあと癇高く笑った。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男だの、女だの、七八人寄って、たかって、猿にからかって、きゃあきゃあいわせて、わあわあ笑って、手を拍って、喝采して、おもしろがって、おかしがって、散々慰んで、そら菓子をやるワ、蜜柑を投げろ、餅をたべさすわって、皆でどっさり猿に御馳走をして、暗くなるとどやどやいっちまったんだ。",
              "citation": {
                "source": "化鳥",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はそして、暫くは（きゃあきゃあっ！",
              "citation": {
                "source": "三稜鏡",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "看護婦は（きゃあきゃあ！",
              "citation": {
                "source": "三稜鏡",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "撫でられて擽ぐられて、きゃあきゃあ云うよりほかはない。",
              "citation": {
                "source": "倫敦の一夜",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "とうとうこちらが凱歌を上げてなだれ込んで行くと、室内では先から待ち構えていた六七人の少女がきゃあきゃあしながら悦び立てた。",
              "citation": {
                "source": "光の中に",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はその光景を見て驚いて立ち止ったが、直ぐ、大げさに手を拍ち腰をゆすぶってきゃあきゃあと笑いこけてから、「おやおや、どうなさいましたの」　と駆け寄って来た。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきから、まっくらな、このしめっぽい空井戸の底みたいな中で、きゃあきゃあいっていたのは、この女の子だったんだ。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の見物などもきゃあきゃあ声を立てながら見ていた。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで私は色々と滑稽な真似をやって見せると、子供たちはきゃあきゃあ喜んで、すっかり私になついてしまった。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、二人の一層小さいクラチット達、すなわち男の児と女の児とは、麺麭屋の戸外で鵞鳥の匂いを嗅いだが、それが自分達のだと分ったと云って、きゃあきゃあ叫びながら躍り込んで来た。",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "友だちと一緒になって、隅のほうできゃあきゃあ笑い轉げてるんです。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、その跫音に愕いた鶏どもは、宿木の上で、きゃあきゃあ騒ぐ。",
              "citation": {
                "source": "にんじん",
                "author": "POIL DE CAROTTE",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に恭一と次郎が、きゃあきゃあ笑い出した。",
              "citation": {
                "source": "次郎物語",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "元気のいい叫びや笑い声が絶え間なしに起こり、女たちは必要もないのにきゃあきゃあ云ったり、人の背中を叩いたりした。",
              "citation": {
                "source": "雨あがる",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天床で例の石臼でも転げるような音が轟き始めた、ごろごろがらがら家鳴り震動である、床下でもきいきいきゃあきゃあ得体の知れない悲鳴が起った。",
              "citation": {
                "source": "風流化物屋敷",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いってみるとその女房は問題の男と寝間の中で、お互いに擽ぐったりつねったりして、きゃあきゃあ遊戯に耽っていた。",
              "citation": {
                "source": "ゆうれい貸屋",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにか腰元たちに悪戯をしているものとみえ、きゃあきゃあ、きいきい、たいへんな騒ぎだ。",
              "citation": {
                "source": "若殿女難記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういえばきゃあきゃあ騒ぎが聞えなくなってだいぶ時間が経つ、まだ酔い潰れるには早いだろうし、まさか、と思ったが紋太夫の顔色が変った。",
              "citation": {
                "source": "若殿女難記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがその直後である、紋太夫が若殿の御殿へゆくと、奥でなにやらきゃあきゃあ女の声がする。",
              "citation": {
                "source": "若殿女難記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕はなく、めいめいの帯などをたたんで、きゃあきゃあ、わあわあの騒ぎだった。",
              "citation": {
                "source": "風",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "白河法皇や鳥羽帝や女院などがいそうな席に、進駐軍の将校やカールやルージュの女性群がきゃあきゃあいっているだけの相違でしかない。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "』のプログラムを見ながら、キャアキャア騒いでいる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれも二十歳前後の娘さんとみえますが、なかに一人、豊かに肥えた肩をむきだした洋装の、だぼ沙魚みたいなお嬢さんが、リイダア格で、「サインして下さいよう」とサイン帳をつきだすと、あとは我も我もと、キャアキャア手帳をつきつけます。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "中には芸者を舷へ押し付けてキャアキャア云わしている者もいた。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず、最初は三々九度の真似事らしく、顔を真赤にして羞恥んでいる西村さんと、キャアキャア笑っているハイカラ美人が、呆気に取られている片輪たちの前で、赤い盃を遣ったり取ったり、押し戴いたりしていたが、間もなく外の連中も、白い盃や茶呑茶碗でガブガブとお酒を呑み初めた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒ん坊の野蛮人が戦争している看板があげてあって、その下に、からだじゅう真黒に塗った男や女や子供が真っ裸と言ってもいいような恰好をして、キイキイキャアキャア呼びながら槍だの刀だのを振り廻して見せている。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
