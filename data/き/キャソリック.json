          "literary": [
            {
              "text": "何も彼も知って大らかと云うのでなく、ややキャソリック的に。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○宮廷儀式の中にあるスペイン風　◎キャソリック教の弊風　◎チェッコのガラス　◎ブロンズ細工（小さい人形、動物、クロンボ、位の大さ　　（記念塔など石少し　ブロンズカストが多い）　◎金唐皮（手提）、ごぶらん織　◎卓子かけ、クッションなど毛糸刺繍五月十三日　月　降り。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は却つて、彼女を大小樣々の罪を一つの善行によつて贖ふロオマン・キャソリックの主義で守り育てゝゐるぐらゐなんですがね。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
