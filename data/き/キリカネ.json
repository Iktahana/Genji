[
  {
    "uuid": "ee073f2a-d56f-5c0e-80f4-3730a3349100",
    "entry": "切り金",
    "reading": {
      "primary": "きりかね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
