        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖父母は琴瑟相和すような関係で、見ていて心が温まる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "年配の夫婦が琴瑟相和す姿を見かけると、本当の愛とは何かが分かる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "琴瑟相和す結婚生活を続けるには、互いの尊重が何より大切だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "琴瑟相和すとは、この夫婦の事なるべし。",
              "citation": {
                "source": "妙義山の五日",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻を娶つて非常に其妻が氣に入つた、琴瑟相和すけれども、若し姑の氣に入らぬ時には廟見せずに直ちに離縁しなければならぬ。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく干したものを削って耳掻きに一杯飲むと、身体自ら熱温を生じ性気昂進して、琴瑟相和するところの奇薬であるという。",
              "citation": {
                "source": "海豚と河豚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "直子女史のアカデミー振りと琴瑟相和す部分もないではないようだ。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
