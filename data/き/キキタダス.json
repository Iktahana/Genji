[
  {
    "uuid": "a96ffaa8-8d4b-527c-a6dd-b94601f0c120",
    "entry": "聞きただす",
    "reading": {
      "primary": "ききただす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
