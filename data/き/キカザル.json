      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to dress up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は友人の結婚式のために、お気に入りのドレスを着飾って出かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今日のパーティーには多くの著名人が来るので、皆が普段よりも着飾っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "特別な日のために、母はいつもより丁寧にアクセサリーを着飾る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "初めてのデートだからと、彼はめいっぱい着飾って駅で待っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それによって、その家はますます富み、奉公人や馬などを持って、衣服も着飾るようになった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "録異記",
                "note": "青空文庫"
              }
            },
            {
              "text": "奉仕せぬ着飾る器は、工藝において罪と呼ばれねばならぬ。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちはあの着飾る贅沢な工藝を夢みる心を早く放棄せねばならぬ。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの人は、食い飲みもするし着飾ることもすきだが、働くことがきらいで、『キリスト様の御名によって』物を貰うことをしません。",
              "citation": {
                "source": "イワンの馬鹿",
                "author": "SKAZKA O IVANE-DURAKE",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に私の大好きなお召や縮緬を、世間｜憚らず、恣に着飾ることの出来る女の境遇を、嫉ましく思うことさえあった。",
              "citation": {
                "source": "秘密",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月にはいれば世の中は三日見ぬ間に桜となるように、六カ月で彼女には美を着飾るに足りたのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "鏡を前に着飾るジャンヌよ、俺の心は飛び去った、それをお前が持ってるね。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆きれいに着飾るように心掛けていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして、今夜は除夜です、明日はもう人の着飾る元日です。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "爾はかの流動の枢軸の動く音をきかざるか。",
              "citation": {
                "source": "墓の上に墓",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "腰元は驚き恐れつゝ件の部屋を覗けば、内には暗く行灯点りて、お村は脛も露に横はれる傍に、一人の男ありて正体も無く眠れるは、蓋此家の用人なるが、先刻酒席に一座して、酔過して寝ねたるなれば、今お村が僵れ込みて、己が傍に気を失ひ枕をならべて伏したりとも、心着かざる状になむ。",
              "citation": {
                "source": "妖怪年代記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "初手の烏もともに、就中、後なる三羽の烏は、足も地に着かざるまで跳梁す。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "看護員は現在おのが身の如何に危険なる断崖の端に臨みつつあるかを、心着かざるものの如く、無心――否むしろ無邪気――の体にて、「すべてこれが事実であるのです。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "看護員は現在おのが身のいかに危険なる断崖の端に臨みつつあるかを、心着かざるもののごとく、無心――否むしろ無邪気――の体にて、「すべてこれが事実であるのです。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るにその手紙も未だ着かざる可きその日の夕刊にて自分は彼哀れむ可き考古学者戸田元吉が佐竹廃園の丘上に他殺されその死体が発見された事を知つた。",
              "citation": {
                "source": "殺人行者",
                "author": "村山槐多",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時取急ぎて普請せし芝の新宅は、未だ人の住着かざるに、はや日に黒み、或所は雨に朽ちて、薄暗き一間に留守居の老夫婦の額を鳩めては、寂しげに彼等の昔を語るのみ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この圈｜嫉妬の罪をむちうつ、このゆゑに鞭の紐愛より採らる　三七―三九銜は必ず響きを異にす、我の量るところによれば、汝これを赦の徑に着かざるさきに聞くならむ　四〇―四二されど目を据ゑてよくかなたを望め、我等の前に坐する民あり、各※岩にもたれて坐せり。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "泰平の世に、誰でも何時でも持っているもの、所持することが不自然でないもの……と、なると、銭ということに落ち着かざるを得ない。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "松の内とて彼は常より着飾れるに、化粧をさへしたれば、露を帯びたる花の梢に月のうつろへるが如く、背後の壁に映れる黒き影さへ香滴るるやうなり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
