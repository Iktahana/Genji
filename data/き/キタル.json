    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "骨組太き童一人、身に着けたるものとては、薄き汗衫一枚、鞣革の袴一つなるが、その袴さへ、控鈕脱れて膝のあたりに垂れかゝりたるを、心ともせずや、「キタルラ」の絃、おもしろげに掻き鳴して坐したり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "想ふにあながち難からむとは思はれず、「キタルラ」一つだにあらましかば。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は姫の「キタルラ」を把りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は手をさし伸べて、壁上なる「キタルラ」を取りて我に授けつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "此煩惱の間、我は忽ち「キタルラ」の音の街上に起るを聞く。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "われは「キタルラ」の琴を抱きて人々に題を求めつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "微風ハキタル、足ノ指ノソノ間ヲ洩レテ君ガ眠リニ。",
              "citation": {
                "source": "疲レ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "其次ハいつまで草四巻　此草紙ハ余ガ青年ノ比、柳春三、桂月池等ノ人々ト会飲スル毎ニ、各自筆トリテ見聞キシコトヲ書キタル反故ナリ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "指先残ラズ血ノツキタル思ヒイレニテ）かほど邪見なこなさんの胤とは言へど、いとゞ不便に（ト思ヒ入レ。",
              "citation": {
                "source": "夏芝居",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "人｜一度、アレナノ会堂ニ赴キテ、ジョットーノ描キタル、ユダノ口吻スル耶蘇ノ面貌ヲ見タランモノハ、粛然トシテ恐レ、茲ニ神人ナザレ村ノ青年ヲ見ルト共ニ、ジョットーノ偉才ニ襟ヲ正サザル無カルベシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "蕗ノ葉ヲ以テ屋根ヲ葺キタルガ故ニ此名有リ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この歌は、第二句ナツキニケラシ（旧訓）、古写本中ナツゾキヌラシ（元暦校本・類聚古集）であったのを、契沖がナツキタルラシと訓んだ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二句、「立儀足」は旧訓サキタルであったのを代匠記がタチヨソヒタルと訓んだ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "唄音風ニ順ツテ碧波ニ入ルニ逢ヒ、蛤聞熏ノ力ニ因ツテ海浪ニ激揚セラレテ自ラ天王寺ノ西ノ浜畔ニ着キタルトキ、童僕戯レニ抛ツテ天王寺堂前ノ床ニ置キタルニ、（註、大阪の天王寺が昔いかに海に近かったかということが、此の記事に依って想像される。",
              "citation": {
                "source": "覚海上人天狗になる事",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「拝啓、イツゾヤ拝借ノ金、ヨウヤク都合ツキタルニツキ、返却仕候。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月二十六日、月、晴改造高平キタル　リンカク校正ワタシ「三つの寶」の本文のメーク・アップのこと。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
