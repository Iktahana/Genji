[
  {
    "uuid": "b1faeb1d-c94c-5790-93f4-40e4180a01d7",
    "entry": "欽定",
    "reading": {
      "primary": "きんてい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-の形容詞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "authorized (by imperial or royal order)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このルールは欽定されたものであり、絶対に変更できない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "明治憲法は欽定憲法として、帝国議会に提示された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "欽定の法令に違反することは、当時の日本において最大の罪とされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "これは欽定憲法と呼ばれている。",
              "citation": {
                "source": "明日をつくる力",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども明治二十二年に出来て最近まで伝えられた日本の欽定憲法は人民によって作成され、決定されたものではなかった。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由民権を、欽定憲法によってそらした権力は、この一つの小規模な、未熟な、社会主義思想のあらわれを、できるだけおそろしく、できるだけ悪逆なものとして扱って、封建風のみせしめにした。",
              "citation": {
                "source": "現代の主題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時に当たり断然起ちて万世不易の国体を説き王権論を説き欽定憲法論を説きたるものはひとり帝政論派なり。",
              "citation": {
                "source": "近時政論考",
                "author": "陸羯南",
                "note": "青空文庫"
              }
            },
            {
              "text": "乾隆帝の作つた『欽定儲貳金鑑』に、委細にその理由を載せてある。",
              "citation": {
                "source": "支那人の妥協性と猜疑心",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "（６）『欽定四庫全書總目提要』卷五十。",
              "citation": {
                "source": "紙の歴史",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "この論文は『欽定古今圖書集成』の庶徴典の旱災部の記事を資料としたもので、必しも完全なものとはいへぬが、しばらく之に據ると、この一千二十三年間に於ける五百八十三年は、旱災に罹つたといふ。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ｄ）『四川總志』（『欽定圖書集成』閨媛典、第三十四卷、閨孝部列傳三所引）四川茂州曰。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ｅ）『武進縣志』（『欽定圖書集成』閨媛典、第三十四卷、閨孝部列傳三所引）、楊氏徐時肩妻。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "不准旌表（『欽定大清會典事例』卷四百三、旌表節孝の條）。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "已加恩準其旌表矣（『欽定大清會典事例』卷四百三、旌表節孝の條）。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて東晉の元帝に『孝經傳』があり、孝武帝に『孝經講義』があつたといふ（『欽定四庫全書總目』卷卅二參看）。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "唐には玄宗の『御注孝經』があり、清には順治帝の『御注孝經』があり、康煕帝の『孝經衍義』があり、更に雍正帝の『御纂孝經集注』がある（『欽定四庫全書總目』卷卅二及び『聖諭廣訓』參看）。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "已加恩准其旌表矣（『欽定大清會典事例』卷四百三、旌表節孝の條）。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "『欽定四庫全書總目』（卷八十二）に「論者謂。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、二条伝統の欽定――此集は準勅撰集――歌集では、まづ殆ど、最後の飛躍を示したものと言うてよからう。",
              "citation": {
                "source": "短歌本質成立の時代",
                "author": "万葉集以後の歌風の見わたし",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもかうした正史とも言ふべき欽定の書に粗漏があるだらうか。",
              "citation": {
                "source": "日本書と日本紀と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに、欽定・私撰に拘らず、本朝の歴史と言ふ用語例に入る様になつたものらしい。",
              "citation": {
                "source": "日本書と日本紀と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "短歌では、万葉集――別の理由で、ある部分まで、勅撰の意義を持つて編纂せられたらしい――を除けると、漢詩文よりも、欽定集が遅れて出た。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "嵯峨朝の欽定による漢詩文より、五十年後に短歌選集の勅撰せられたのは、国民的自覚と言ふよりも、其動力となつた漢文学の思想に対しての、理会のなくなつて来た反動である。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "後撰を勅撰し、更に漢詩文集を欽定せられたのは、醍醐の事業に競争意識を持つて居られた村上天皇であつた。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "此欽定事業は奈良以後平安初期に続いた漢詩文の復興を期する意味と、一種の文化誇示の目的との外に、文学史風に見れば、外国文学の最後を記念する標本を立てた訣である。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "顧ふに立憲政治の創設は、岩倉、木戸、大久保の諸賢夙に之れを　聖天子に獻替して其の基を啓らき、爾來補弼の重臣之れを内に翼贊し、在野の政治家之れを外に唱道して、遂に欽定憲法の發布を見るに至りたりと雖も、此の憲法の立案、及び之れを實施するが爲に必要なる一切の準備は、殆ど專ら伊藤公の手に成れりと謂ふべし。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "顧ふに立憲政治の創設は、岩倉、木戸、大久保の諸賢夙に之れを　聖天子に献替して其の基を啓らき、爾来補弼の重臣之れを内に翼賛し、在野の政治家之れを外に唱道して、遂に欽定憲法の発布を見るに至りたりと雖も、此の憲法の立案、及び之れを実施するが為に必要なる一切の準備は、殆ど専ら伊藤公の手に成れりと謂ふべし。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ここで予め注意しておかなくてはならぬ点は、日本におけるこの教育（教育は元来常に社会教育なのだが）が官僚的社会政策として発生発達したものであって、福沢諭吉等の例を除けば、殆んど例外なしに官製の欽定教育（？",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "それによると日本の憲法は欽定憲法であるということと国体に基いた憲法だという点とで、世界無比な出来具合だというのである。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳者解説　米国医学史学会を創設し、晩年はオクスフォード大学の内科学欽定教授であり英国医学史学会の会長であったウィリアム・オスラー卿が英米の学生に読むように推薦したノイバーガーのこの本は、体系的に整頓された優れた本である。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "君主たる者がそれらを「欽定する」。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブールボン家をして、一八一四年に「欽定された」保証の上に、彼らのいわゆる譲与の上に、再び手をつけしむるに至ったことは、いかに重大な誤謬であったか。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は最終的にはオスラーの後任としてイギリス最高の医師として８年ほどオクスフォード大学の欽定教授になったが、それまでは幾つかの病院で数多くの患者を診ながら研究に専念していた（伝記参照）。",
              "citation": {
                "source": "アルカプトン尿の発現",
                "author": "THE INCIDENCE OF ALKAPTONURIA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
