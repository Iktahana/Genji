          "literary": [
            {
              "text": "「キ、キ、キ、キキキッ」　ああ厭な鳴き声だ。",
              "citation": {
                "source": "恐しき通夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キキキッ」　とまた鳴いた。",
              "citation": {
                "source": "恐しき通夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "キキキッ、キキッ、キキキッ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "キキッ、キキキキッ、キキッ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "キキキッ、キキキキッ、キッ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "キキキキッとれいの怪物が鳴いた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "キキキッと悲鳴のような泣声をだす楽器もあるが、どれとも見当がつかないのである。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "キョッキョッ　キキキッ　頭上の樹の枝で、べつの鳥が鳴きだした。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに――　長い蔓繩は左右に大きな波のうねりを打ち、キキキキキッ――と車啼きを立てた籠は、お蝶の体を振りこぼしてしまいそうに絶壁を離れてすべり出しました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
