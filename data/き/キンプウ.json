    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "四月十一日◯預金封鎖、支払制限令、それから財産申告。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "人民の眼からかくされている上層部の裏面的な政治勢力は、内閣および議会をかいらいとして表面上は財閥解体令を受け入れながら緊急金融措置令によって新円切換えを行い、さらに半年のうちに第二回の金融措置（一般に預金封鎖とよばれた）を行って特権的階級に手厚い保護を与えた。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "預金封鎖の強化と失業におびやかされて、芝居ずきの人も手当りばったりに金を出さなくなったわけです。",
              "citation": {
                "source": "朝の話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀行預金封鎖の爲生活費を得んとて中央公論社顧問囑託となる。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀行また／＼預金封鎖の風聞あれば貯金六萬圓また別口貳萬圓を引出す。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "連合国のドイツの敗戦処理のしかたをみてからは、財閥解体、財閥家族の財産拘束、新円切換、預金封鎖、財産税と、無一文になるまで追いまくられることを予想し長謙さんなどは、「これでおれも真人間になれるか」　なんていっていたのに。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "隠すが早いか、食堂の笠付黄色電球がずらっと点灯し、あたかも手品のようにテーブルに完璧な食べ物が現れ、銀器やグラスやクリスタルに凝った夕食が盛られ、金封のボトルがあった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
