        "examples": {
          "standard": [
            {
              "text": "すりおろしたキャロットをたっぷり生地に混ぜ込んで、しっとりと甘いパウンドケーキを焼いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「うわっ、この野菜ジュース、キャロット特有の青臭さが全然なくてすごく飲みやすいね！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "肉料理の付け合わせに添えたキャロットグラッセは、バターの香りと蜂蜜の甘みが絶妙にマッチしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "家庭菜園で収穫したばかりのキャロットは、皮が薄くてそのままかじると驚くほど甘みが強かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
