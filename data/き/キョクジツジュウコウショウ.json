          "standard": [
            {
              "text": "外交官として数十年間日本と友好国の橋渡し役を担い、旭日重光章を授与された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "旭日重光章は旭日章の中でも高い位に位置する勲章だと説明を受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "科学技術分野への多大な貢献が認められ、旭日重光章の受章が決まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "その前年の明治三十九年に、功三級に叙せられ、金鵄勲章を授けられ、また勲二等に叙せられ、旭日重光章を授けられているのである。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
