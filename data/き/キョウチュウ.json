[
  {
    "uuid": "a8ab9841-7a53-5e6e-b752-a68317db762f",
    "entry": "胸中",
    "reading": {
      "primary": "きょうちゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "one's heart",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は、長年抱えていた胸中の思いを、ついに親友に打ち明けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "あの時の後悔は、今も胸中に残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "引退を発表した選手の胸中には、やり残したことへの悔しさが渦巻いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "實に久しい間、私は自分の胸中を打ちあけて語るべき、眞のよき友人を持たなかつた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たち不勉強の学生たちを気の毒に思い、彼の知識の全部を公開する事は慎しみ、わずかに十分の三、あるいは四、五、六くらいのところまで開陳して、あとの大部分の知識は胸中深く蔵して在るつもりでいたのだろうけれども、それでも、どうも、周囲の学生たちは閉口した。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムカシ　ムカシノオ話ヨ　などと、間の拔けたやうな妙な聲で繪本を讀んでやりながらも、その胸中には、またおのづから別個の物語が※釀せられてゐるのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "などと、負け惜しみに似たやうな自問自答をして、さて、その父なる奇妙の人物は、ムカシ　ムカシノオ話ヨ　と壕の片隅に於いて、繪本を讀みながら、その繪本の物語と全く別個の新しい物語を胸中に描き出す。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、また、默つてゐる人によくありがちの、皮裏の陽秋といふんですか、そんな胸中ひそかに辛辣の觀察を行ふなんて事も、乙姫は決してなさらない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "へんな憂愁が浦島の胸中に湧いて出る。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の出鱈目を何でも信じてくれる者の胸中には、しばしば何かのおそるべき惡計が藏せられてゐるものだと云ふ事を、迂愚の狸は知らなかつた。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人たちの所謂「青春の純眞」とかいふものは、しばしばこの兎の例に於けるが如く、その胸中に殺意と陶醉が隣合せて住んでゐても平然たる、何が何やらわからぬ官能のごちやまぜの亂舞である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お爺さんの胸中に眠らされてゐた何物かが、この時はじめて頭をもたげたやうにも見えるが、しかし、それは何であるか、筆者（太宰）にもわからない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、風が自分の耳元にそのやうにひそひそ囁き、さうして、いつのまにやら自分の胸中に於いても、その變てこな歌ともお念佛ともつかぬ文句が一歩一歩竹藪の下の雪を蹈みわけて行くのと同時に湧いて出て、耳元の風の囁きと合致する、といふやうな工合ひなのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "うち出して会おうとするには、すでに胸中見透されている気がして逡巡まれた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸中いかに見透されていようと少くともこの形の態度なら超越の伯母に対し、初対面の姪むすめの恰好はつけられる。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人の胸中も自ずから平らかなるを得たようである。",
              "citation": {
                "source": "ゴルフ随行記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "民子は小声で、「お増がまた何とか云いますよ」「二人共お母さんに云いつかって来たのだから、お増なんか何と云ったって、かまやしないさ」　一事件を経る度に二人が胸中に湧いた恋の卵は層を増してくる。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "機に触れて交換する双方の意志は、直に互いの胸中にある例の卵に至大な養分を給与する。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "女達はそれを胎内に、男達はそれを胸中に持つてゐた。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、無｜論お互に胸中｜密に「なアに己の方が……」と思つてゐる事は、それが將棋をたしなむ者の癖で御多分に洩れざる所。",
              "citation": {
                "source": "下手の横好き",
                "author": "―將棋いろいろ―",
                "note": "青空文庫"
              }
            },
            {
              "text": "閑中の余技として樂しむ僕達の棋戰でさへ負けては樂しからず、惡手を指したり讀みの不足で詰みを逸したりした時など、寢床にはひつても盤面が腦裡に浮んで來て口｜惜しさに眠れぬ思ひのする事しばしばだが、敗れたる專門｜棋士の胸中や果して如何に？",
              "citation": {
                "source": "下手の横好き",
                "author": "―將棋いろいろ―",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう誰だって胸中からもくもく湧いてくるうれしさに笑い出さないでいられるでしょうか。",
              "citation": {
                "source": "イーハトーボ農学校の春",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これより一説ある處、何の大晦日を逃げた癖に、尊徳樣もないものだと、編輯の同人手を拍つて大に嘲けるに、たじ／＼となり、敢て我胸中に蓄へたる富國經濟の道を説かず、纔に城の俤を記すのみ。",
              "citation": {
                "source": "城の石垣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その面貌の無邪気なる、その謂うことの淡泊なる、要するに看護員は、他の誘惑に動かされて、胸中その是非に迷うがごとき、さる心弱きものにはあらず、何等か固き信仰ありて、たといその信仰の迷えるにもせよ、断々｜乎一種他の力のいかんともし難きものありて存せるならむ。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸中おのずから閑あるごとし。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "面の色は変えたれども、胸中無量の絶痛は、少しも挙動に露わさで、渠はなおよく静を保ち、おもむろにその筒服を払い、頭髪のややのびて、白き額に垂れたるを、左手にやおら掻上げつつ、卓の上に差置きたる帽を片手に取ると斉しく、粛然と身を起して、「諸君。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸中、戦戦兢兢たるものがあった。",
              "citation": {
                "source": "美少女",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸中にあるものは、ただ「一体になろうとする特殊な性的｜煩悶」だけである。",
              "citation": {
                "source": "チャンス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "男一｜疋、女の胸中の恋人に幻影化され偶像にされ、病死の往生際の念仏代りになる。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "無限に対するこの懸命の働きそのものの上に、言い知れぬ悲壮な気持ちと、使命に殉じている安心光明が油然と胸中に湧くのであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わざと打解けて、底気味の悪い紳士の胸中を試みようとしたお雪は、取附島もなく悄れて黙った。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は真先に世間外に、はた世間のあるのを知って、空想をして実現せしめんがために、身を以って直ちに幽冥に趣いたもののようであるが、婦人はまだ半信半疑でいるのは、それとなく胸中の鬱悶を漏らした、未来があるものと定り、霊魂の行末が極ったら、直ぐにあとを追おうと言った、言の端にも顕れていた。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一人は秋山男爵にして、一人は博士の遠縁に当る雲井文彦という青年紳士なるが、いずれも博士が、まだ出発せざる以前より深くも嬢に心をよせ己が胸中のありたけを打ち明けしも、嬢は二人の情に絆されていずれとも答えかねしが、今二人のこの申込に対し、親を思うに厚き嬢は遂にその言を容れたり。",
              "citation": {
                "source": "月世界競争探検",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
