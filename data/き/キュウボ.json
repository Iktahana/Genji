        "examples": {
          "standard": [
            {
              "text": "イベントスタッフ急募！週末働ける方、今すぐご応募ください！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "緊急事態への対応のため、現地で活動できるボランティアの急募を行っています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「急募！即戦力となる経験豊富なエンジニアを求む！」という求人広告が掲載されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "お店のオープンが間近に迫っているため、ホールスタッフの急募中です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "もとより急募してかき集めたのが大半の軍勢である。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第八巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "『曾呂利物語』四には伊予の出石の山寺で足利の僧が妖怪を鎮めたとし、主怪をえんひょう坊、客怪をこんかのこねん、けんやのばとう、そんけいが三足、ごんざんのきゅうぼくとす。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
