          "standard": [
            {
              "text": "電気刺激を与えると筋収縮が瞬時に起きることが実験で確認された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "マラソンの終盤に筋収縮が乱れ始め、彼は脚の痙攣に苦しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "筋収縮のメカニズムを学ぶため、学生たちはカエルの標本を使って観察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "注意深く研究されてきた幾つかの共役した生化学反応たとえば筋収縮とか呼吸のような反応においてすべての個々の段階は他の段階と特異的に関連していることが示された。",
              "citation": {
                "source": "生体構成物質の動的状態",
                "author": "THE DYNAMIC STATE OF BODY CONSTITUENTS (1942)",
                "note": "青空文庫"
              }
            },
            {
              "text": "筋収縮の源泉は何だろうか？",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "解剖学者であり生理学者であったので例えば筋収縮を見た。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカのグループは、タンパク質が直接に筋収縮の燃料に使われないとしても、“努力しようとする”ための神経エネルギーに使われると考えていた（4）。",
              "citation": {
                "source": "栄養学小史",
                "author": "A Short History of Nutritional Science",
                "note": "青空文庫"
              }
            }
          ]
