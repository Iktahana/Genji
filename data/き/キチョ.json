  {
    "uuid": "ae918dce-54f8-5c56-97e5-00ebae57f4c6",
    "entry": "機杼",
    "reading": {
      "primary": "きちょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "涼風葉を揺かして湲水音を和し、村歌起るところに機杼を聴く。",
              "citation": {
                "source": "客居偶録",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな機杼は他の場合には起こらないわけである。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "小夜ふけし裏町に簾を編む機杼の響のいそがしく聞ゆるさま、春去りて夏ちかくなりたる心地更に深く、山の手の屋敷町にては味ひがきき趣なり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜半八丁堀の溝渠に沿うて築地の僑居に歸らうとした道すがら、わたしは家毎に簾を編む機杼の音の薄暗い裏町にひゞくのを聞き、春は去つて將に夏ならんとする市井の情調の猶掬すべきものあるを思ひ、却て愁思を動した事があつた。",
              "citation": {
                "source": "十年振",
                "author": "一名京都紀行",
                "note": "青空文庫"
              }
            },
            {
              "text": "民舎ノ機杼伊鴉トシテ相響ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
