        "examples": {
          "standard": [
            {
              "text": "山里に住む禁欲者は、週に一度だけ町に下りてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "禁欲者としての人生を選んだ彼は、物質的な豊かさを求めていない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その禁欲者の教えに従う信者たちは、厳格な生活ルールを守っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それは痩せて背の高い、しかしまだ壮健らしい老人で、黒い髪にはひどく胡麻塩が交じって、おも長な禁欲者らしいものものしい顔をしていた。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
