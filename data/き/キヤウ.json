        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その他、今日の普通の書き方によれば「キヤウ」と書いても「キヨウ」と書いても「ケウ」と書いても「ケフ」と書いても「キョー」であります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊ワレラコクキヤウニアリ　妻子を初め東京の諸友に、その安別から打電した時には、私もまた意気軒昂たるものがあった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の蔓がニキヤウといふので其実がコカだといふのである。",
              "citation": {
                "source": "しらくちの花",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分はふと又コカはニキヤウへ成るのだなと念をついたら此の女もさうだといつた。",
              "citation": {
                "source": "しらくちの花",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ビックリつて、キツキヤウと書くンでせう。",
              "citation": {
                "source": "「リラ」の女達",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（３）「其の下には」ト原文ニナキモ、木ト花草ノ關係ヨリ入レ候ヘドモ、必要ナキヤウニ思ハル。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
