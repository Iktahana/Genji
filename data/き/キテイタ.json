          "literary": [
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "萬一父ガ生キテイタラ、予モ浄吉モ勘当サレルニ決ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣キナガラ予ハ「痛イ、痛イ」ト叫ビ、「痛イケレド楽シイ、コノ上ナク楽シイ、生キテイタ時ヨリ遥カニ楽シイ」ト叫ビ、「モット蹈ンデクレ、モット蹈ンデクレ」ト叫ブ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
