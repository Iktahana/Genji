        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の優しい言葉に、胸がきゅんとなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "小さな子犬が甘えてくる姿に、思わずきゅんとしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の恋を思い出して、心臓がきゅんとするような感覚が蘇った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「え、それって、もしかして…きゅんとする話？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "またそのきゅんきゅんと叩く音が河向いの塀に反響したような気がするくらい鮮明な印象が残っている。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
