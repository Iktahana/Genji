    "definitions": [
      {
        "index": 1,
        "gloss": "dried daikon strips",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "朝食に切り干しを白菜と一緒に炒めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "切り干しの栄養価は生の大根よりも高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "常備菜として瓶詰めの切り干しが冷蔵庫にある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "食料は米味噌、そのほかに若布切り干し塩ざかななどはぜいたくなほうで、罐詰などはほとんど持たない。",
              "citation": {
                "source": "地図をながめて",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "若狹鰈――大すきですが、其が附木のやうに凍つて居ます――白子魚乾、切干大根の酢、椀はまた白子魚乾に、とろゝ昆布の吸もの――しかし、何となく可懷くつて涙ぐまるゝやうでした、何故ですか。",
              "citation": {
                "source": "雪靈續記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "若狭鰈――大すきですが、それが附木のように凍っています――白子魚乾、切干大根の酢、椀はまた白子魚乾に、とろろ昆布の吸もの――しかし、何となく可懐くって涙ぐまるるようでした、なぜですか。",
              "citation": {
                "source": "雪霊続記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "名物と聞く切干大根の甘いにほひをなつかしんで、手製ののり卷、然も稚氣愛すべきことは、あの渦卷を頬張つたところは、飮友達は笑はば笑へ、なくなつた親どもには褒美に預からうといふ、しをらしさのおかげかして、鴻の臺を向うに見る、土手へ上ると、鳴く、鳴く、鳴くぞ、そこに、よしきり。",
              "citation": {
                "source": "木菟俗見",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「切干でも切つたもんだかな」おつぎが庭から大きな聲でいつた時お品はふと枕を擡げた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "おつぎは庭葢の上に筵を敷いて暖かい日光に浴しながら切干を切りはじめた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "お品は切干を刻む音を聞いた時先刻のは大根を洗つて居たのだなと思つた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "お品は二三｜日此來もう切干も切らなければならないと自分が口について云つて居たことを思ひ出して、おつぎが能く機轉を利かしたと心で悦んだ。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "切干の筵は三枚ばかり其庭葢の上に敷いた儘で、切干には氷を粉末にしたやうな霜が凝つて居て、東の森の隙間から射し透す朝日にきら／＼と光つた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い切干は蒸さずに干したのであつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "切干は雨が降らねば埃だらけに成らうが芥が交らうが晝も夜も筵は敷き放しである。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで其の蔬菜が庖丁にかゝる間は口にこそつぱい干菜や切干やそれも缺乏を告げれば、此れでも彼等の果敢ない貯蓄心を最も發揮した菜や大根の鹽辛い漬物の桶にのみ其の副食物を求めるのである。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、一切干渉しないようにして、西谷が二階で人形と一緒にいるときには、絶対に上って行かなかったが、私にはその様子が判然とわかった。",
              "citation": {
                "source": "三稜鏡",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前の菜畑のあるじから大根を貰ふ、切干にして置く、大根は日本的で大衆的な野菜の随一だ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず日曜が豆腐汁、それから油揚と菜、大根の切干、そら豆、うずら豆、馬肉、豚肉など大がい献立がきまっている。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚肉などといえば結構に聞ゆれど、実のところは菜か切干かの上に小さな肉の切が三つばかり乗っているまでのことだ。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　こんなように云ってから形をただし、「俺に関しての行動に、一切干渉してはならない。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "車窓に近く山、浅い　広い溪流　樹木一種特長ある　細さ　線の複雑さ　枝がこまかく　楓、山桜もあり　繊かに美しい絵的断片的風景　浅き川コンコンと流れる　山家の日向の庇に切干や薪干してあり。",
              "citation": {
                "source": "一九二七年春より",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　切干の煮つけをサイは昼もたべた。",
              "citation": {
                "source": "三月の第四日曜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この一家族は美津子の親戚筋に当るが、美津子がどう言いくるめたのか、山田と彼女との関係には一切干渉しないことになっている。",
              "citation": {
                "source": "春盲",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夕も、関ヶ原まで伸すという行動には一切干渉しない代り、心利いた若い者の庄公を目附として、ここまでつけてよこしました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、煮炊をする鍋釜、米と塩、鰹節と切干――食料は、よく中身を調べて、この次へこうしてお置きなせえ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一切干渉はせんといふ主義だが、さうなると、もう、してやりたいことも、おつかなびつくり伺ひを立ててからといふ始末だ。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "田所　　あなたは、一切干渉をなさらない方針ぢやなかつたんですか。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "流もとの大笊の中にはきざんだ切干が水を切ってあり、沢庵桶からたくあんを出しかけていたところと見え、糠の中からたくあんが半分ほど顔を出している。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "遠島船",
                "note": "青空文庫"
              }
            },
            {
              "text": "一門の睦み集ひて桃青忌切干もあらば供へよ翁の忌紅葉せるこの大木の男振り十一月十二日　吉右衛門一座、「嵯峨日記」を上演するにつき、芭蕉二百五十年忌追善会を上野清水寺客殿に催す。",
              "citation": {
                "source": "六百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お膳を下げてから台所で切干大根の煮たので冷飯をかっこんで厠へゆくと、いつか冷たい風が吹きだしたらしく、月明りで窓の障子へ真黒く映る笹寺の笹がしきりに音立てて揺れていた。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "岳ビル（行者ニンニク）はもう軟くもないが汁の実に入れると、虫の巣になった大根の切干よりは遥にうまい。",
              "citation": {
                "source": "大井川奥山の話",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑巾まで売っている都会の生活にあきれながら、となりの米屋で白米一升を袋に入れてもらい、八百屋により、乾物屋で高野豆腐と切り干大根を買った。",
              "citation": {
                "source": "風",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩の糧に、乏しい粟と、大根の切干しとを、笊に入れて、彼女はやがてそこから出て来た。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
