        "examples": {
          "standard": [
            {
              "text": "「まずは久濶を叙すのが先決だろう。長らく連絡を怠っていたのだから」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "数年ぶりに故郷の土を踏み、幼馴染と酒を酌み交わしながら心ゆくまで久濶を叙す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "互いに死生を共にし合った往年の英傑児同志が、一方は天下の頭山翁となり、一方は名もなき草叢裡の窮措大翁となり果てたまま悠々｜久濶を叙する。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の応酬も、見たところ久濶を叙す挨拶とそれほど変ったところも無くなった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
