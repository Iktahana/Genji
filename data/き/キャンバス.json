        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "下地を丁寧に塗り終えたキャンバスをイーゼルに立て、構図を練り始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「新しいキャンバスの白い布地を前にすると、何を描こうかワクワクするね！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "風景画を描くために、持ち運びに便利な小型のキャンバスをカバンに忍ばせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "特大のキャンバスに大胆な筆致で描かれた抽象画が、ギャラリーの壁を飾っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "また女性たちがよくしてくれたので、キャンバス屋根の動く家であっても、すぐさま新しい生活に順応することができた。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャンバスを走らせる筆の跡だけに意識を集中する画家や、めまぐるしく動く指先が奏でるメロディーに、ゆったりと意識を浮遊させるピアニストのように、闇の中に浮かんでくる言葉の連なりと無心に向き合うことができました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまでなら、絵は紙やキャンバスの上、写真は印画紙、動画はフィルムやビデオテープ、音はレコードやＣＤと、それぞれ専用の〈器〉におさめられていた。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも電子のキャンバスの上では、動きまで表現できるのです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "番組を受信する装置としてではなく、電子のキャンバスとしてブラウン管を使うという「正しい見方」は、時代の流れを先取りしていました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "画家は軍部へ奉仕しなければ職能的存在を抹殺されて、えのぐやキャンバスの配給を受けられないようにした。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふいに目の前に現われた壮大な白いキャンバスを前にした少年の、生きることへの恐れにもにた感動か。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ絵の修業のひとは哀れと思う、キャンバスその他も高いから。",
              "citation": {
                "source": "日記",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この海藻のむしろの上に、貝と蝦と野菜類とを載せて、上からすっかりテント用のキャンバスでおおう。",
              "citation": {
                "source": "西洋の浜焼",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャンバスをあけると、湯気が白々と立って、貝はもう蒸されている。",
              "citation": {
                "source": "西洋の浜焼",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャンバスをめくると、夕闇の中に、湯気が真白に立ち上がる。",
              "citation": {
                "source": "西洋の浜焼",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後七時、長さ一千メートルの流網はキャンバス・ポラッド及び浮樽二十一個と浮燈三個を海面に留めて、一文字に投ぜられた。",
              "citation": {
                "source": "地震なまず",
                "author": "武者金吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "四季とりどりの大観は、大自然のキャンバスに、神様が御自分の手で描いてくれます」「嘘だ」「まだ信じては下さらないのですか、それでは申しましょう。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "第四の場合",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁側のキャンバス製の寝椅子に、栄介はながながと背を凭たせ、本を読んでいた。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ若い頃だから保ったけれど、今のおれならとても出来ることじゃない」　キャンバス椅子の上で栄介は背伸びをした。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "このネコが僕の部屋にのそのそと入って来て、とかくキャンバスに爪を立てたがる困った傾向がある。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャンバスを見れば条件反射的に爪を立てるような訓練を、野呂がネコにひそかにほどこしているらしいのです。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからネコは僕の部屋に入ってきて、油絵具を塗ったキャンバスを見ると、もう夢中になって爪を立てるのです。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "可憐なる小動物を虐待する気分は毛頭ないのですが、キャンバスに爪を立てられてはこちらも上ったりです。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "洞窟の通路は兵の居住区をもかねているのだが、そこでは分配された物資を衣嚢につめたり出したり、なるたけ余計もってゆこうというので、キャンバスをもってきて新しく衣嚢をつくってる奴もいるしさ。",
              "citation": {
                "source": "赤い駱駝",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "マストのカンバス（帆布）は、ハッチの上部カバーであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、彼は、油絵のカンバスのような、オーバーオールを一つ手に入れることができた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人の傾向を徹底させて行くとつまりは何もかいてないカンバスの面がいちばんいい事になりはしないか。",
              "citation": {
                "source": "昭和二年の二科会と美術院",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだのにそうかと云って、洋画家で絵絹へ油絵具を塗る試みをあえてする人、日本画家でカンバスへ日本絵具を盛り上げる実験をする人がないのはむしろ不思議なくらいである。",
              "citation": {
                "source": "異質触媒作用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボートの上にカンバスをかまぼこ形に張ったのが日本の屋根舟よりはむしろ文人画中の漁舟を思い出させた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また他の学者はある種の鶚の前へカンバスで包んだ腐肉を置き、その包みの上に鮮肉の一片をのせた。",
              "citation": {
                "source": "とんびと油揚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンバスなどは使わず、黄色いボール紙に自分で膠を引いてそれにビチューメンで下図の明暗を塗り分けてかかるというやり方であった。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ君のすすめに従って今度はカンバスへやることにした。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとまず中止としてカンバスを室のすみへ立てかけて遠方からながめて見ると顔じゅう妙に引きつりゆがんで、始めに感じのよかった目も恐ろしく険相な意地悪そうな光を放ってにらんでいるので、どうもそのままにしてあすまで置くのは堪えられないような気がした。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "目で見なかった代わりに、自分の想像のカンバスの上には、美しい青草の毛氈の上に安らかに長く手足を延ばして寝ている黄金色の猫の姿が、輝くような強い色彩で描かれている。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
