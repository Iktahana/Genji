        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "チャンピオンの放った右ストレートが炸裂し、挑戦者は無残にもキャンバスに崩れ落ちた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ああっ！立ち上がれるか？膝をついたまま、キャンバスを拳で叩いて悔しがっているぞ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "マットの弾力を確かめるように、選手は試合前にキャンバスの上を軽く跳ねてみせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "激闘の末、タイムアップの鐘が鳴ると同時に二人のボクサーはキャンバスに大の字になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
