          "literary": [
            {
              "text": "但シ母其人ノ生活ハ母自身ノ維持スベキモノトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ女學校特有ノ形式的課目女禮式茶湯生花ノ如キ又女子ノ專科トセル裁縫料理育兒等ノ特殊課目ハ全然廢止スベキモノトナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯粒ノ附着セサル弁当箱ハ特許スヘキモノトス。",
              "citation": {
                "source": "科学時潮",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "種を明かして仕舞えば何でもないが、兎も角も「飯粒ノ附着セサル弁当箱ハ特許スヘキモノトス」は愉快な文句ではないか。",
              "citation": {
                "source": "科学時潮",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ犯跡ヲ完全ニ抹殺スベキモノトス。",
              "citation": {
                "source": "人造人間殺害事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "『本願ハ左記理由ニ仍リ拒絶スベキモノト認ム。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "愕いて、これを読み下すと、拒絶スベキモノト認ムという主文は同じで、その理由としては、次のようなことが綴られていた。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "公告決定通知本願ハ拒絶ノ理由ヲ発見セザルヲ以テ、公告スベキモノト決定セリ　輝かしい日だ、雪は降りしきっているが……。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　オマツリニジブンノ　キルキモノト、コドモタチニ　キセルキモノノコトデス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノオマツリニ　ジブンノ　キルキモノト、コドモタチニ　キセルキモノノコトデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
