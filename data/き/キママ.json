[
  {
    "uuid": "ad85988e-38fe-5bde-8a40-71964b532957",
    "entry": "気まま",
    "reading": {
      "primary": "きまま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "willful",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はいつも気ままな一人旅を楽しんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "猫は気ままに日向ぼっこをしたり、部屋をうろついたりしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "気ままな生活を送ることに憧れるが、現実はなかなか難しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの人は気ままだから、計画通りに動かないことが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "かえって私は、勝手気ままに振舞えるのである。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ僕だけが変人であり、一人の自由と気まま勝手を楽しむのである。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "気まま者の日記山中貞雄　ある日・１　近頃、大衆小説を読んであまりこころよく思わないことがある。",
              "citation": {
                "source": "気まま者の日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵の具と筆が勝手気ままに絵をかいて行くのを自分はあっけに取られて見ているような気がするのである。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間は知恵でこの動物を気ままにしていると思ってうぬぼれている。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "気ままにピアノの鍵盤をたたきまわっても一つの音楽であるかもしれないがソナタにはならないと同様である。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして人間には、たった一人のときでも自分を完成し、周囲の自然を開拓しようとする意志は持って生れているのですから、その人間本来の意志に従わず、勝手気ままな外界の自然のありさまを手本にでも見習うような放縦な生活は、どうあっても「真理」の逆行です。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちが、生活という自動車に乗って、人生の路を気ままに走っているとき、過ちの曲り角へ来ると、「菩提心」は急に制動機をかけます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「来たぞや、来たぞや、」「今は早や、気随、気ままになるのじゃに。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄さんは、あなたと別れて以来、いい具合にもそんなに不仕合せな目にも会わず、殊にこの頃ではお伽噺の作家として割合に評判もよくなって、殆ど不自由なく気ままな暮しをしていますが、やはり一日だってあなたの身の上を忘れることはなく、何とかして早く見つけ出して一緒になりたいと念じていたのでした。",
              "citation": {
                "source": "恋",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "気ままなところに気ままな形で立つてゐました。",
              "citation": {
                "source": "鳥右ヱ門諸国をめぐる",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、これ等の仕事は、気ままできれぎれで、物質生活を恵む筈なく、学才は人に脅威を与へ乍ら、生活はだんだん孤貧に陥つて行つた。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たくましく生きている職工さん、軍人さんは、いまこそ芸術を、美しさを、気ままに純粋に、たのしんでいるのでは無いか。",
              "citation": {
                "source": "正直ノオト",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前の好きな土地に、お前の気ままの立派なお屋敷をこしらえてあげましょう。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山には木の実、草の実が一ぱいあって、それを気ままにとって食べてのんきに暮すのが山居の楽しみと心得ていましたが、聞いて極楽、見て地獄とはこの事、この辺の山野にはいずれも歴とした持主がありまして、ことしの秋に私がうっかり松茸を二、三本取って、山の番人からもう少しで殴り殺されるようなひどい目に遭いました。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、あなたの気ままな酔いかたを見て、ねたましいくらい、うらやましく思いました。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "謂わば、人生の峻厳は、男ひとりの気ままな狂言を許さなかったのである。",
              "citation": {
                "source": "花燭",
                "author": "燭をともして昼を継がむ。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふらんすへ行きたしと思へどふらんすはあまりに遠しせめては新しき背広を着て気ままなる旅にいでてみん……「ははあ、この詩人も御多分に洩れず、あまり金持でないと見えるな。",
              "citation": {
                "source": "十年",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの女は僕を、もう、手のうちにまるめていると思っていたのか、ただ気まま勝手に箸を取っていて、お酌はお袋にほとんどまかしッきりであったのだ。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来が、ほとんど同人雑誌のような俳句雑誌のために、きわめて気楽に気ままに書き流したものである。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "前述のごとく、自分は勉強するにしても気随気ままな方法を執っていたから、こんな種類の物を読んでいる余裕もあったのであろう。",
              "citation": {
                "source": "わが中学時代の勉強法",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "散歩にも出かければ、好きなものを見にもゆく、はなはだ勝手気ままのやり方ではあるが、こうして好きなことをして一日遊ぶと今まで錯雑していた頭脳が新鮮になって、何を読んでもはっきりと心持ちよくのみ込める。",
              "citation": {
                "source": "わが中学時代の勉強法",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、他の人は決して悪口したり蹴ったりしなかったが、ただ崑は少年の気ままから、喜べば忘れ、怒れば践み殺して、大事にしてやらなかった。",
              "citation": {
                "source": "青蛙神",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イングランドには親類知己がひとりとしておらず、空気のように気ままであり、一日一一シリング六ペンスの支給額の許す限りは勝手に過ごせた。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々の『しかし』は、勝手に集まった連中が気ままに出していったミニコミで、教師の指導とも無縁です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に初めて射った直後の、体中の細胞という細胞が勝手気ままに大声でがなり立てるような狂騒状態は、豊饒とでも評したくなるような奇妙ですさまじいものでした。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの酩酊状態のギターを抱えた小学校五年のオレは、ともかく一本の弦でメロディーを追うことを覚え、他の連中が弾いているキーとは全く無関係に、時には一弦で、時には二弦で、はたまた三弦でとメロディーのみを気ままに追い、ともかくも無事に演奏を終えたのだった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "省作が気ままをすれば、それだけ母は家のものたちの手前をかねて心配するのである。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして所在なきままに煙草に火を點けては、しきりなく吸つた。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "口惜しく腹立たしきまま身の周囲はことごとく敵ぞと思わるる。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
