          "literary": [
            {
              "text": "その井戸から最後に水をくんだ者は、ギーヨーム・ヴァン・キルソムという男であった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギーヨーム・ヴァン・キルソムは「城の番をするため」にウーゴモンに残って、窖の中に身を潜めていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "その家に住んでる家族の祖父というのが、昔の園丁ヴァン・キルソムであった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
