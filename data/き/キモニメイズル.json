        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "亡き祖父の「正直に生きろ」という教えは、今も私の肝に銘ずるべき言葉だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この度の経験を肝に銘ずるとともに、今後の人生に深く刻み込んでいきたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "上司の熱い期待を肝に銘ずることで、日々の業務に真剣に取り組める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "肝に銘ずる文章であると思う。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「独歩」の二字よく彼の面目を表わし、その語、また大丈夫の所信として肝に銘ずる。",
              "citation": {
                "source": "南浦紹明墨蹟",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
