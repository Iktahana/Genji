        "examples": {
          "standard": [
            {
              "text": "保険金目当ての狂言強盗が捜査の過程で発覚し、当人が逮捕された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "店員と客が共謀した狂言強盗は、防犯カメラの映像で見破られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "借金返済に困った彼は狂言強盗を思いついたが、計画はすぐに露見した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それで様子を窺っていると、三度目に清水に呼ばれた時、古田の奴、狂言強盗で入りもしない泥坊に、ホンのちょっと掠り傷を負わされて、ひどい目に遭わされたように見せかけ、残りの原稿をすっかり自分の懐へ入れちゃったのです。",
              "citation": {
                "source": "ニッケルの文鎮",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
