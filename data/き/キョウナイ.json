    "entry": "胸内",
    "reading": {
      "primary": "きょうない",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "儂が何かやまいで気分が悪しく、胸内が苦しいような時でも、あの子が眼の前にあらわれると、おのずとその苦しさが止むのじゃ。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸内で起きている解剖学的変化に光を投げかけるような音色が作られた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "打診音のように人工的に作ったのではなく自発的に作られる他の音が胸内には無いだろうか？",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "古くからヒポクラテス主義者たちはある種の病気の人たちにおいて胸内で不思議な音が起きていることを指摘していた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
