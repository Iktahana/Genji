        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "近頃熱心なのは將棋で菊池寛二段の飛香落とどうやら戰へる。",
              "citation": {
                "source": "自分のこと",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其後飛香落から平手までに指し進んだ。",
              "citation": {
                "source": "将棋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人も飛香落から指して、平手に進んだ。",
              "citation": {
                "source": "将棋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "香落で指して、滅茶苦茶に負けた。",
              "citation": {
                "source": "将棋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "二枚落で指してゐるときは二枚落の定跡を、飛香落で指してゐるときは飛香落の定跡をと、定跡の研究を進めて行くべきである。",
              "citation": {
                "source": "将棋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛香落にも、角落にも、飛落にも、ゼヒとも指さなければならない手があるのである。",
              "citation": {
                "source": "将棋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
