    "definitions": [
      {
        "index": 1,
        "gloss": "guts",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あの店の女将は肝っ玉が据わっていて、どんな客にも臆することなく対応するからすごい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "会社の存続がかかった大勝負だったが、彼は肝っ玉の太さで乗り切った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「いやぁ、あんたも肝っ玉が小さいねぇ。こんなことでびくびくしてどうするんだい。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の妻は、大家族を一人で切り盛りする肝っ玉母さんとして近所で有名だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それでもときどき、滞潮に一分ほど遅れたり早すぎたりしたときには、肝っ玉がひっくり返ったものですよ。",
              "citation": {
                "source": "メールストロムの旋渦",
                "author": "A DESCENT INTO THE MAELSTROM",
                "note": "青空文庫"
              }
            },
            {
              "text": "「手前も……だろう――って言われた時にゃあ、あたいも肝っ玉がふっとんじゃったぞ。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいかげん弱っちゃあいるようだが、無暗に吠えねえで悠々と寝ているところを見ると、肝っ玉がありそうな畜生だ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "道庵と鰡八の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「知りませんよ――男と逢引する位な肝っ玉のお房さんですもの、相手の男を気取られるような事をするものですか」「お内儀のお余野さんと、主人の造酒助は二階に居たと言ったね」「それが不思議なんです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "腰抜け彌八",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それはわかった、岩見重太郎だって、宮本武蔵だって、八五郎よりは肝っ玉が太くなかったかも知れないということにして、お前は一体何んの話をしに来たんだ」　平次は膝をツン向けました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "万両分限",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い者たちは、鬼を一拳の下になぐり殺したこの親分の底の知れない腕っぷしと、肝っ玉に、ひたすら恐れ入っているらしい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の考えもその通りなのです……あいつの恐ろしさは、こういうズバぬけた考え方によって、ばかばかしいトリックを、平然として実行する肝っ玉にあるのです。",
              "citation": {
                "source": "黒蜥蜴",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "肝っ玉もあるし」「さあ。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "事実、一同は密かに、この女の肝っ玉に驚いた。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、海の上で経験をつんだ、きもったまの太い日本海員は、こういう探検に出かけるとき、どんなことがあっても、きっと島をさがし出す、という強い信念をもって出発するのだ。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この子どもたちは、からだは小さいけれど、きもったまは大きいのだからね。",
              "citation": {
                "source": "大金塊",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのこわいことを、わざとやって、きもったまを強くしようとしたのです。",
              "citation": {
                "source": "夜光人間",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の時分にこの臆病な私の胆玉を脅かしたものの一つは雷鳴であった。",
              "citation": {
                "source": "家庭の人へ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "淵に臨んで、崕の上に瞰下ろして踏留まる胆玉のないものは、いっその思い、真逆に飛込みます。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "気象はその通だし、胆玉は大いし、体は鍛えてある、まあ、第一、その目つきが容易じゃあない。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……が……その時のお八代さんの胆玉の据わりようばっかりは、今思い出しても身の毛が竦立ちます。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "匂い袋なんぞを持っているけに、たわいもない柔弱者かと思うと、油断のない体の構え、足の配り……ことに彼の胆玉と弁舌が、年頃と釣合わぬところが奇妙じゃ。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "戊辰戦争の経験は胆玉のことには役立っても、指揮者としては何にもならない。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「憚りながら的矢の貫一、胆玉がよわくなったの、腕があまくなったのといわれちゃあ――」「そんならいい。",
              "citation": {
                "source": "奇賊悲願",
                "author": "烏啼天駆シリーズ・３",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度たべた以上は、少くたべても、たくさんたべても同じことだと胆玉をすえた。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "からだは大きいが胆玉の方は、それほど大きくないのがこの大辻助手だ。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "記憶するというのは、ちょっと申訳がないが、実はいよいよたいへんなことが始まったぞというので、僕の胆玉は上がったり下ったりして、現場を逃げだそうかどうしようかと思案に暮れていたときなので、その辺はハッキリ覚えていないのである。",
              "citation": {
                "source": "人体解剖を看るの記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は胆玉をひやひやさせたよ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "大佐は二人の顔を見るや、いきなり「おお、帰って来たか、武田君から、君等二人の胆玉を、うんと練り上げてくれと、たのまれたからな。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生の幕下に属しながら、そんな小さな胆玉でどうなるか。",
              "citation": {
                "source": "誰が罪",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、くちさがない魚河岸の若い者などは、胆玉の小さい者を指して、あれは陸奥のアンコウだといったものである。",
              "citation": {
                "source": "アンコウの味",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "すごいなあ」　あまりものにおどろいたことのないポコちゃん川上少年も、艇外をひゅうひゅうととびかう鬼火のような、いん石群には、すっかりきもっ玉をうばわれた形であった。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
