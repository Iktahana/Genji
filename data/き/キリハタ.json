        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山の斜面に切り畑が広がっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "田舎の村にはいくつもの切り畑がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "祖父の切り畑で野菜を育てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "言って見れば、この地方の遠い古は山にたよって樵務を業とする杣人、切り畑焼き畑を開いて稗蕎麦等の雑穀を植える山賤、あるいは馬を山林に放牧する人たちなぞが、あちこちの谷間に煙を立てて住む世界であったろう。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "切り畑焼き畑を開いて稗蕎麦等の雑穀を植えるもの、新田を開いて柴草を運ぶもの、皆元気いっぱいだ。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもなお、五木以外の雑木と下草とは人民の自由で、切り畑焼き畑等の開墾もまた自由になし得た証拠は、諸村｜山論済口の古証文、旧尾州領主よりの公認を証すべき山地の古文書、一村また数村の公約と見るべき書類等に残っている。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "音はと思うに、きりはたりする声は聞えず、山越えた停車場の笛太鼓、大きな時計のセコンドの如く、胸に響いてトトンと鳴る。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "散策子は踵を廻らして、それから、きりきりはたり、きりきりはたりと、鶏が羽うつような梭の音を慕う如く、向う側の垣根に添うて、二本の桃の下を通って、三軒の田舎屋の前を過ぎる間に、十八、九のと、三十ばかりなのと、機を織る婦人の姿を二人見た。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "路は一際細くなったが、かえって柔かに草を踏んで、きりきりはたり、きりきりはたりと、長閑な機の音に送られて、やがて仔細なく、蒼空の樹の間漏る、石段の下に着く。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "渚は浪の雪を敷いて、砂に結び、巌に消える、その都度音も聞えそう、但残惜いまでぴたりと留んだは、きりはたり機の音。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "かまきりはたった今生捕ったばかしの小さな赤とんぼを、大事そうに両手でもって胸へ抱え込んでいる。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "高機に、その胸に、  きりはたり。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "高機に、その胸に、　きりはたり。",
              "citation": {
                "source": "思ひ出",
                "author": "抒情小曲集",
                "note": "青空文庫"
              }
            },
            {
              "text": "新墾路の切畑に、赤ら橘葉がくれにほのめく日なか、そことも知らぬ靜歌の美し音色に、目移しの、ふとこそ見まし、黄鶲のあり樹の枝に矮人の樂人めきし戲ればみを。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "新墾路の切畑に、赤ら橘葉がくれに、ほのめく日なか、そことも知らぬ靜歌の美し音色に、目移しの、ふとこそ見まし、黄鶲のあり樹の枝に、矮人の樂人めきし戯ればみを。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "八『狐にかくれて、切畑の片日向にもおろしやれ、木の葉ごろもの山姫の袖をこぼれた實ぢやまでに、あり慰めにまゐらす。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "六『夫は巣立の子もつれて、深山つぐみの來ぬひまを、老の峠の切畑に、黄金覆盆子や摘みやる。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "薩摩藷などを植えた切畑が谷の入口に見えていた。",
              "citation": {
                "source": "忘恩",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と庄助は言って、その日から向こう三日間、切畑、野火、鉄砲の禁止のお触れの出ていることを近在の百姓たちに告げるため、青の原から杁の方まで回りに行くところだという。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお大分県の「史蹟名勝天然紀念物調査報告」第十五輯に拠れば、上の外、梅の野生地は、やはり南海部郡なる因尾村の黒岩、切畑村の提内、上堅田｜大越の船河内、同じく富士河内、下堅田の石打にもあると記してある。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び引き返して右岸の道を登って行くと、これは切畑への路であった。",
              "citation": {
                "source": "奥秩父の山旅日記",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥後田（ヒゴノタワの略称）という所で、元は切畑があったそうだが、今では雑木が可なり大きく育っている。",
              "citation": {
                "source": "奥秩父の山旅日記",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
