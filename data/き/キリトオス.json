    "definitions": [
      {
        "index": 1,
        "gloss": "to cut through (with a road, tunnel, or canal)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
