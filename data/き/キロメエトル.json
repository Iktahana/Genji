          "literary": [
            {
              "text": "敵の騎兵は八十キロメエトルの処まで来ている。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそ十二キロメエトルほど歩いて、自動車を雇ってホテルへ帰った。",
              "citation": {
                "source": "襟",
                "author": "オシップ・ディモフ　Ossip Dymoff",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二キロメエトル歩いたあとだからおれは随分くたびれていて、すぐ寝入った。",
              "citation": {
                "source": "襟",
                "author": "オシップ・ディモフ　Ossip Dymoff",
                "note": "青空文庫"
              }
            },
            {
              "text": "町はづれから二キロメエトルぐらゐも離れてゐませうか。",
              "citation": {
                "source": "匈奴の森など",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
