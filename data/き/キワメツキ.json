    "definitions": [
      {
        "index": 1,
        "gloss": "certified (as genuine, valuable, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その骨董品は極め付きの逸品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "極め付きの真物であることが証明された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "極め付きの品質基準に達している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "極め付きのあの退屈が、にょきりにょきりと次第に鎌首を抬げ出して来たのです。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボイジャーの隅で極め付きの幸福のご相伴にあずかりながら、この仕事が終わり次第ここから立ち去るべき僕は、萩野正昭さん、北村礼明さん、鎌田純子さんをはじめとするスタッフの全員に嫉妬していた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これでお互いが極め付きのマヌケだということが、はっきり判っただろ。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも技芸抜群、「道成寺」「山姥」を始め、八重垣姫、政岡、八重桐、朝顔なぞは男女ひっくるめての極め付き、「勧進帳」の弁慶で堂々と脅やかすかと思うと、「油屋」の善六で腹を抱えさせる。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "右が臭いと思わば左を洗うべし――むっつり右門きわめつきの奥の手だよ」「ちげえねえ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "子持ちすずり",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも尋常一様の品物ではなく、一見して女の持ち物であったことを物語るなまめかしい紙入れでしたから、なんじょう右門のきわめつきの鋭知がさえないでいられましょう。",
              "citation": {
                "source": "右門捕物帖",
                "author": "達磨を好く遊女",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで伯爵は土地の貴紳をのこらずその劇場に招待し（したがって座席券は売出されなかった）、極上きわめつきの出し物をすぐって上演した。",
              "citation": {
                "source": "かもじの美術家",
                "author": "TUPEJNYJ HUDOZHNIK",
                "note": "青空文庫"
              }
            },
            {
              "text": "羽左衛門は、あれほど若衆方を役処として、生涯勤めた人だが、其でも久我之助や、桜丸乃至は力弥を極めつきとするまでには、相当な経歴があるのである。",
              "citation": {
                "source": "手習鑑雑談",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、それ以前から人前では廃った面になって、これで内外共に、人外の極めつきにされてしまった。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼ぶわけにもゆかないので、そのままにしていると――一番に振られたのが、「本阿弥の極めつき、堀川国広の脇差、目貫は白魚に蛇籠、うぶご磨上げなし！",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜の客人をいぶすのは禁物だったかもしれない」　最前ここへ訪ねて来て、そこに居合せた雲霧と四ツ目屋も、声を合せて笑いながら、「なあに、おれたちは極めつきの白浪だ。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "言語に絶する一日の中でも、極めつきの屈辱だ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつまでわし達を角髻の子供と見おって」「されば、てまえの弓勢は、山崎の御合戦の折にも、韮山城の城詰の折にも、しばしば大殿の御感にあずかった、極めつきの弓でござる。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえが悪い、ありていに白状しな、と出刃打ちの野郎を極め付けてやりまさあ」　渠の鼻息はすこぶる暴らかなりき。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とますます私を極め付ける。",
              "citation": {
                "source": "鶴は病みき",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　周三は、畫室を出ると、また父に取捕まつて、首根つこを押へ付けて置いて極め付けられるのが怖いのだ。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、洋服を着た儘、部屋の敷居の上に立つて、何か急しい調子で、細君を極め付けてゐた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、洋服を着たまま、部屋の敷居の上に立って、何か急しい調子で、細君を極め付けていた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "野々宮さんは、若いものを、極め付ける積で云つたんで無いと見えて、少し調子を変へた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると友人は「カーライルが胃弱だって、胃弱の病人が必ずカーライルにはなれないさ」と極め付けたので主人は黙然としていた。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　こう一声極め付けた。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はみな一流一派に傑出した者共で、無事に苦しんでその腕の悪血が取りたさにこの団体に入ったくらいでしたから、人違いなどは大した問題ではなく、むしろ剣法において当代一の極め付の島田虎之助を突き出したことを勿怪の幸いと感じたくらいのものであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "甲源一刀流の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に極め付この上なしを紹介する。",
              "citation": {
                "source": "洗いづくりの美味さ",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「手前は默つて居ろ、――本人に言はせ度いんだ」「へエ――」　平次に極め付けられて、ガラツ八は一と縮みに縮んでしまひました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "花見の仇討",
                "note": "青空文庫"
              }
            },
            {
              "text": "町方の岡つ引風情が、武士に向つて、詮索がましい事を申すのは無禮であらう」　ピシリと眞つ向から、一本極め付けて置いて、川上源左衞門は戸口の障子を閉め切らうとするのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "十手の道",
                "note": "青空文庫"
              }
            },
            {
              "text": "三「番頭さん、何處へ行つたんだ、俺の言ふことを聽かなきア、繩ア付けて引立てなきアならないが――」　與母吉の顏を見ると、仙太は以ての外の樣子で斯う極め付けました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "どんど燒",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドローレス……私は口が下手だから思うことが言えないが、私は決してお前を怒っているのではないのだ……私はお前には」「立ち聞きをなすっといて私が叱られては堪りませんわね」とピシッと彼女は極め付けた。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "階段の下に私だけが取り残されて――しかもその私は頭髪を掻きむしってネクタイは引ん曲り、灰皿を掴んで、見て見ぬ振りをしている召使たち環視の中で、妻に立ち聞きを極め付けられて、いかに悄然として立場を失ってしまったかは、最早くだくだしく言うだけ愚かなことであったろう。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの晩のことをみんな言ってしまえ」　平次は高飛車に極め付けました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "二本の脇差",
                "note": "青空文庫"
              }
            },
            {
              "text": "三「番頭さん、どこへ行ったんだ、俺の言うことを聴かなきゃア、縄付けて引立てなきゃアならないが――」　与母吉の顔を見ると、仙太は以ての外の様子でこう極め付けました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "どんど焼き",
                "note": "青空文庫"
              }
            }
          ]
        }
