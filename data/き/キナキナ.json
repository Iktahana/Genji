          "literary": [
            {
              "text": "本米国の土語キナキナは樹皮中の樹皮の義で、西班牙人が欧洲に伝へ、和蘭人が我国に伝へた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "――或は、いとも陽気な、チョンキナ、チョンキナ、チョンチョンキナキナ。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "成否は時の運、キナキナ思っても仕方がない。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
