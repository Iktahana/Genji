        "examples": {
          "standard": [
            {
              "text": "試験の結果をきなきな待っている学生たちの顔は青ざめていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "母は遠くの空を見上げて、きなきなと息子の無事を祈っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は、締め切りが迫るプロジェクトの進捗をきなきな気にしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「ちょんきな、ちょんきな、ちょんちょん、きなきな。",
              "citation": {
                "source": "長い名",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "うれしなきなきなきだした。",
              "citation": {
                "source": "トントンピーピ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりきなきな思って、あなたまで煩わぬようにされるがようござりましょうぞ」「ありがとう存じます」と、娘は優しく言われるにつけて、またもやせぐりくる涙を前垂の端で押え押えした。",
              "citation": {
                "source": "四十八人目",
                "author": "森田草平",
                "note": "青空文庫"
              }
            },
            {
              "text": "必ず必ずきなきな思し召してはなりませぬ。",
              "citation": {
                "source": "磯馴松",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
