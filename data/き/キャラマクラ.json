        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "われ之を彼が従来の著書に徴して知り、而して「伽羅枕」に対して初めて其説を堅うするを得たり。",
              "citation": {
                "source": "粋を論じて「伽羅枕」に及ぶ",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "今「伽羅枕」を読むに粋の粋を写さんとせし跡、歴々として見受けらる。",
              "citation": {
                "source": "粋を論じて「伽羅枕」に及ぶ",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "読者若し詳に「伽羅枕」の後半部を読まば、彼の義気、彼の侠気、彼の毒気とを兼ね合せて、一条の粋抜く可からざるあるを見む。",
              "citation": {
                "source": "粋を論じて「伽羅枕」に及ぶ",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅葉は「伽羅枕」を、露伴は「辻浄瑠璃」を、時を同うして作り出たり。",
              "citation": {
                "source": "「伽羅枕」及び「新葉末集」",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "従来の諸作は分明に紅葉をして細微なる人情の観察者たらしめ、露伴をして逸調の奇想を吐く者たらしめたるに、不思議にも「伽羅枕」及「新葉末集」に至りて、両家の意匠の、其外部の形式の如何に拘らず、陰然相似たる所あるが如し。",
              "citation": {
                "source": "「伽羅枕」及び「新葉末集」",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に「伽羅枕」は紅葉従来の作に見る可からざる奇気を吐けり、而して「新葉末集」は露伴が登壇以来見せし事なき人情の微妙を細察したり。",
              "citation": {
                "source": "「伽羅枕」及び「新葉末集」",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「伽羅枕」が紅葉の「一代女」にして、公けに元禄を代表する事、批評家既に言へり。",
              "citation": {
                "source": "「伽羅枕」及び「新葉末集」",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「伽羅枕」を読みたらむ人は必らず、佐太夫なる魔女の終始一回も盲目的恋愛に陥らざるを認むるなる可し。",
              "citation": {
                "source": "「伽羅枕」及び「新葉末集」",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "『焼継茶碗』だの、『心の闇』だのは、『伽羅枕』だとか、『紅白毒饅頭』だとかいふ模倣臭、俗気臭のある作品に比べては、余程構造に於て、命意に於て、純な処がある。",
              "citation": {
                "source": "尾崎紅葉とその作品",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "『伽羅枕』『紅白毒饅頭』それから『三人妻』といふ順序である。",
              "citation": {
                "source": "尾崎紅葉とその作品",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "『伽羅枕』は西鶴の一代女を真似た書き方をして居る。",
              "citation": {
                "source": "尾崎紅葉とその作品",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし『一代女』と『伽羅枕』との比較は殆どその比較を為さないほど其内容に於て差違がある。",
              "citation": {
                "source": "尾崎紅葉とその作品",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "『伽羅枕』には何処を探したつて、そんな心理はない。",
              "citation": {
                "source": "尾崎紅葉とその作品",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "『伽羅枕』は一老女の単なる物語に留つてゐる。",
              "citation": {
                "source": "尾崎紅葉とその作品",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "『読売新聞』で、露伴の『ひげ男』と紅葉の『伽羅枕』とを同時に掲載する計画を立てたのは、あれは確か二十三年の春頃だつたと思ふ。",
              "citation": {
                "source": "紅葉山人訪問記",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅葉は『伽羅枕』を牛込の北町の家で書いた。",
              "citation": {
                "source": "紅葉山人訪問記",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "『伽羅枕』は百囘近く続いた。",
              "citation": {
                "source": "紅葉山人訪問記",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはずっと後になってからだが、その広場に出ようとするところの左側にその時分評判だった紅葉の『伽羅枕』と露伴の『ひげ男』とが両々相並んで『読売』紙上に載せられるという大きな広告の絵看板が出たことを記憶している。",
              "citation": {
                "source": "日本橋附近",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その「多情多恨」の如き、「伽羅枕」の如き、「二人女房」の如き、今日｜猶之を翻読するも宛然たる一朶の鼈甲牡丹、光彩更に磨滅すべからざるが如し。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
