    },
    "definitions": [
      {
        "index": 1,
        "gloss": "glittering",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "湖面にキラキラと光が反射し、子どもたちは歓声を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "クリスマスツリーの飾りがキラキラと輝き、部屋全体が華やいだ雰囲気に包まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女の瞳がキラキラしていて、新しいプロジェクトへの期待が全身からあふれ出ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "夏草が生ひ茂つて、出たばかりの朝日は露にキラキラ光つてゐた。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜露にしめつた秋草の葉は月の光で青白くキラキラ光つて居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝は日を受けて柔和な桃色を潮し、昼は冴えた空に反映して、燧石のようにキラキラ晃めき、そのあまりに純白なるために、傍で見ると空線に近い大気を黒くさせて、眼を痛くすることがある。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう時、下りて見ると、麓の草原は雨の雫で緑がシットリと輝くのと対照して、山の新しい雪が、キラキラと雲母のように光って、雪と雨とを区別する境界線が、山の中腹に引かれている。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからなお一層寒い時また軽気球などでごく高い空中に昇ると、時として針のような細長い雪がキラキラと降るを見る事があるそうな。",
              "citation": {
                "source": "雪の話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "温室の白塗りがキラキラするようでその前に二三人ふところ手をして窓から中をのぞく人影が見えるばかり、噴水も出ていぬ。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "キラキラツと黄金のぶちがひかりました。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "霧は殆ど霽れ上つて、空には星影がキラキラと見え出した。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして強い眩しい日光の中にキラキラして飛んでいる蜂の幻影が妙に淋しいものに思われて仕方がなかった。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手の方の空間で何かキラキラ光るものがあると思ってよく見ると、日本橋の南東側の河岸に聳え立つあるビルディングの壁面を方一尺くらいの光の板があちらこちらと這い廻っている。",
              "citation": {
                "source": "異質触媒作用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれが沢山の小さな小さな鏡のようにキラキラキラキラ光るのです。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お星さまは野原の露がキラキラ固まったようです。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてキラキラ涙をこぼしたのです。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "遁ぐるが遠くには去らず、いつもおなじほどのあわいを置きてはキラキラとささやかなる羽ばたきして、鷹揚にその二すじの細き髯を上下にわづくりておし動かすぞいと憎さげなりける。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただひとえにゆう日照りそいたるつつじの花の、わが丈よりも高き処、前後左右を咲埋めたるあかき色のあかきがなかに、緑と、紅と、紫と、青白の光を羽色に帯びたる毒虫のキラキラと飛びたるさまの広き景色のみぞ、画のごとく小さき胸にえがかれける。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひるすぎ、野原の向ふから、又キラキラめがねや器械が光って、さっきの四人の学者と、村の人たちと、一台の荷馬車がやって参りました。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キラキラッと黄金のぶちがひかりました。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひるすぎ、野原の向うから、又キラキラめがねや器械が光って、さっきの四人の学者と、村の人たちと、一台の荷馬車がやって参りました。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の顔を穴のあく程みつめていた未亡人の頬に見る見るポーッと紅がさして、眼がこの上もなく美しくキラキラと輝やき初めた。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "グラグラと頭をシャンデリアの方向に仰向けて、健康そうな、キラキラ光る白い歯を見せた。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人とも申し合わせたように頭の上のシャンデリアを仰いだが、シャンデリアは依然として消えたままで、ただ数限りもない硝子の切子玉が、遠い遠い窓の外をキラキラと反射しているキリであった。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "キラキラと、その凄かった事。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐるりと三人、三つ鼎に夫人を巻いた、金の目と、銀の目と、紅糸の目の六つを、凶き星のごとくキラキラと砂の上に輝かしたが、「地蔵菩薩祭れ、ふァふァ、」と嘲笑って、山の峡がハタと手拍子。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちらりと紅の透る、白襟を襲ねた端に、一筋キラキラと時計の黄金鎖が輝いた。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて瓶がずらりと板の間にならんで、まるでキラキラします。",
              "citation": {
                "source": "葡萄水",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがおかしいことは、先生がいつものキラキラ光る呼子｜笛を持っていきなり出入口から出て来られたのです。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれが沢山の小さな小さな鏡のやうにキラキラキラキラ光るのです。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
