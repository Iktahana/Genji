[
  {
    "uuid": "b7f24adf-a1ce-5f55-b94f-a3014cd54f81",
    "entry": "キラキラ",
    "reading": {
      "primary": "キラキラ",
      "alternatives": [
        "きらきら"
      ],
      "is_heteronym": false
    },
    "grammar": {
