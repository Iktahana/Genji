  {
    "uuid": "7262a558-9c77-5749-925e-5a1f34e0df28",
    "entry": "近称",
    "reading": {
      "primary": "きんしょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "proximal pronoun (indicating proximity to the speaker)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "国語の授業で、「これ」「ここ」「こちら」などの近称を学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "近称の指示語は話し手に近いものを指すため、「これ」が代表的な例とされる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "日本語の指示語は近称・中称・遠称に分類されると教師が黒板に書いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "では成田屋さん、お伴させて頂きんしょう」　櫛、こうがい、裲襠姿のままで吉三郎が真ん中、先を成田屋、うしろに主水之介がつづいて、木挽町の楽屋を出た三｜挺の列ね駕籠は、ひたひたと深川を目ざしました。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            }
          ]
