        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "枝がきいきい云って折れる。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人や軍人の男装をした踊り子までがみんな女の子のきいきい声を出すので猶更そういう「毀れやすい」感じを起こさせるようである。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "細くて徹つたきいきいといふ鳴声を挙げる。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "またきいきいと鳴く。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝙蝠は口を開けてきいきい鳴き続ける。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の子は、女中ばかりでなくお涌が一しよなのに驚いた様子で、片足｜退つて身構へる様子だつたが、女中の説明を聞くうち、男の子はすつかり笑顔になつて、自分も手伝つてきいきいいふ小鳥のやうな動物を空いた鸚鵡籠の中へ首尾よく移した。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "細くて徹ったきいきいという鳴声を挙げる。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の子は、女中ばかりでなくお涌が一しょなのに驚いた様子で、片足｜退って身構える様子だったが、女中の説明を聞くうち、男の子はすっかり笑顔になって、自分も手伝ってきいきいいう小鳥のような動物を空いた鸚鵡籠の中へ首尾よく移した。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ひょろ竹と云われる瘠せたのが、きいきいと軋む声で、「疾に罰が当って、気の違った奴なんか構わねえや。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "うッふ、ねずみはきいきい歯ぎしりして、わらくずや木切れに、どんなによびかけたことでしょう。",
              "citation": {
                "source": "しっかり者のすずの兵隊",
                "author": "DEN STANDHAFTIGE TINSOLDAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかみさんはきいきい言って、火箸でぶとうとするし、子供達もわいわい燥いで、捕えようとするはずみにお互いにぶつかって転んだりしてしまいました。",
              "citation": {
                "source": "醜い家鴨の子",
                "author": "DEN GRIMME AELING",
                "note": "青空文庫"
              }
            },
            {
              "text": "味をやる、きいきい声を出す。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐怖と悲嘆とに気が狂った女が、きいきい声をあげてかけ歩く。",
              "citation": {
                "source": "大震火災記",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "室を締め切って、きいきい云わせるのだから、親は可なり上手だと思っている。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その物を言う声が、なんとも言えない、不自然な、きいきい云うような声である。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "直ぐにきいきいと轆轤の軋る音、ざっざっと水を翻す音がする。",
              "citation": {
                "source": "カズイスチカ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "困ったな」「君は無絃の素琴を弾ずる連中だから困らない方なんだが、寒月君のは、きいきいぴいぴい近所合壁へ聞えるのだから大に困ってるところだ」「そうかい。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "わてらその日稼ぎだすよつて、忙しおますからな」「それぢや、猫の子があまり可哀さうだとはおもひませんか」　婦人は疳の高い、きいきいした声を立てました。",
              "citation": {
                "source": "黒猫",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　夫人は眼一杯に涙ぐんで、きいきいした声で我鳴り立てた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、直ぐ側の卓子に、お洒落な青年士官が三四人居合せて、軍鶏のやうに胸を反らして、軍鶏のやうなきいきいした声で何か頻りと軽躁ぎ散らしてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカ帰りの男で、現代人の多くは神経衰弱症に罹つてゐる、そしてその神経衰弱は大抵眼から来てゐるのだから、現代人を救ふには、も一つ大きく言ふと、現代文明の廃頽的傾向を済ふには、是非眼を療治しなければならぬと言つて、鵙のやうにきいきい騒いでゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　芸者は鸚哥のやうにきいきいした声で言つた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに劇場の支配人が、ものずきにそばから油をかけて煽りつけるので、二人の女優は猿のやうに白い歯をむき出して、きいきい我鳴り立てました。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "出て来たのはきいきいした女声で、「主人は今書斎にゐてお仕事をしてゐますから、邪魔をするわけにはまゐりません。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから猫や豚が、尻つぽに括り付けてある時計の十三時を打つのが不都合だと心得たものか皆駆け出して、きいきい、にやあにやあ啼きながら、そこら中を引つ掻いて、何もかも蹴飛ばして、人の顔に飛び付いたり、着物の裾にこんがらかつたりした。",
              "citation": {
                "source": "十三時",
                "author": "THE DEVIL IN THE BELFRY",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、こら――」と彼は守衛がかりの男をいきなり呼びつけて云った、きいきい軋むような声であった、「わからんか、俥を呼べえ――禄ぬすッとめが、走らんか――」　そして鼻ひげを捻りあげてじろッと阿賀妻の顔を見た。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「怠慢じゃ無いかア――手を束ねて見とれとるやつがあるかア――」と、この権中主典は棟の下一ぱいに響きわたるきいきい声で叫んだ。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その実、彼がコッソリ、夜中になると、工場へ忍びこみ、自分で、クレーンをキィキィ云わせたのだ。",
              "citation": {
                "source": "夜泣き鉄骨",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲がすっかり消えて、新らしく灼かれた鋼の空に、つめたいつめたい光がみなぎり、小さな星がいくつか連合して爆発をやり、水車の心棒がキイキイ云います。",
              "citation": {
                "source": "烏の北斗七星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲がすつかり消えて、新らしく灼かれた鋼の空に、つめたいつめたい光がみなぎり、小さな星がいくつか聯合して爆発をやり、水車の心棒がキイキイ云ひます。",
              "citation": {
                "source": "烏の北斗七星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
