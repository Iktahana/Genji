          "literary": [
            {
              "text": "「キングオブキングを十杯飲んでごらん、拾円のかけだ！",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜んだのはカフェーの主人ばかり、へえへえ、一杯一円のキングオブを十杯もあの娘が呑んでくれたんですからね……ペッペッペッだ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランタンの蔭キングオブキングを十杯呑ませてくれたら私は貴方に接吻を一ツ上げませうおゝ哀れな給仕女青い窓の外は雨のキリコダマさあ街も人間も××××もランタンの灯の下でみんな酒になつてしまつた。",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            }
          ]
        }
