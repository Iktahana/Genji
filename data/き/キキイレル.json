[
  {
    "uuid": "edf36da6-5f03-5718-bf14-300a1eacc179",
    "entry": "聞き入れる",
    "reading": {
      "primary": "ききいれる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
