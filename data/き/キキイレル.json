      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to grant (a wish)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「どうしてもその企画を通したいんです」と熱心に訴え、上司は彼の願いを聞き入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "住民の要望を聞き入れ、市は公園の改修工事を決定した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の懇願を聞き入れ、一度だけ秘密を打ち明けることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "露西亜人には、二人の哀願を聞き入れる様子が見えなかった。",
              "citation": {
                "source": "雪のシベリア",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "詰ったとて聞き入れるような彼ではなかったし、私としても説法するほどの自信を持っていなかった。",
              "citation": {
                "source": "物を大切にする心",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は女の願ひを聞き入れることになつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校の友達という友達で家庭から通っていないものは無い中にあって、泉太や繁が子供心に果して自分の言うことを聞き入れるだろうか、そう思っては幾度か躊躇した。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は速水の言葉の前には傍の見る眼も可笑しいほどの温和しさをもって聞き入れるのだった。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ走り書きにした文章にも入道の学問と素養が見え、仏も神も聞き入れるであろうことが明らかに知られた。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（下）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まではしばらく堪えていたが、もはや包むに包みきれずたちまちそこへ泣き臥して、平太がいう物語を聞き入れる体もない。",
              "citation": {
                "source": "武蔵野",
                "author": "山田美妙",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、兄上と呼ばれた武士は、物にかかわらない性質と見えて、聞き入れるようすも見えなかった。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "是を、鎌倉の頼朝殿に見られてしまったら、わし達はおろか、他の者にまで迷惑がかかる、どうしたものであろう、何かよい思案はないものかのう」「聞くところによりますと、義経は中々の女好き、女房の申すことは大抵は聞き入れると申します。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "小松殿の若君のどなたか一人出向かれて、彼をなだめられたら如何でしょう、主筋の方のお言葉なら必ずや聞き入れると存じますが」　これは名案であると、新三位中将資盛が五百余騎を率いて豊後に向った。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第八巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "司令官は思慮深いお方でして、とりわけ子どもの願いを聞き入れるべきだとおっしゃりました。",
              "citation": {
                "source": "処刑の話",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども今晩のお雪ちゃんは、そんなことで聞き入れるお雪ちゃんではありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "というか、『坊ちゃん』の例を虚心に考えるなら、あらすじなるものはどうやら、書かれている文章とは関係がないらしいということになる」　それは極端ではないかと思うが、聞き入れる様子は見えない。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "年景どの、お身が養っていた山吹という女子、海辺から親鸞が連れて参った、どうぞ親鸞がたのみを聞き入れて下さるまいか」「人を悪しざまに罵って、その上の頼み事、聞き入れる耳はない」「では、多年、寵愛した女子が、死のうと生きようと、お身はかまわぬというか。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵対する両者を和解させることは不可能であるが、各々が要請することを引き続き聞き入れることによって、即ち、二重存在を偽造することによって、各々が要請する全ての条件を持つことを見い出し得る限り、我々は出来るだけ対立を解くように努めるのである。",
              "citation": {
                "source": "人間本性論（人性論）",
                "author": "A Treatise of Human Nature",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、この鳥のいうことを、はたして、雷がききいれるだろうかと不安に思いました。",
              "citation": {
                "source": "ぴかぴかする夜",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "その考えすら、素直にシミジミと心を傾けてききいれることができた。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、法師は、寺男のことばをききいれるどころか、ますます一心に、ますます高らかな声で、吟じつづけています。",
              "citation": {
                "source": "壇ノ浦の鬼火",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくし如きは、到底その任ではない」　とばかり、何と一同が推しても、ききいれる色はなかった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈何して吾家の児は斯う行儀が不良いだらず――』　といふ細君の言葉なぞを聞入れるお作では無かつた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と銀之助は聞入れる気色も無かつた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの言葉を自分の耳に聴き入れるために言っている自分は、そっくり大人になった気がしています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前はそれを聴き入れるか。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし彼らがこれを聴き入れるつもりがなければ、当然宇宙戦争がはじまるわけだった。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「馬鹿ッ、そんなことを聴き入れる平次と思ったか」「どっこい、怒るだけまだ若いぜ、――俺はまた、素直に承知したと見せて置いて、いざ金を渡そうという時、『御用ッ』と来るのが怖かったのさ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞ手をお挙げ下さい」「平次殿、聴き入れて下さるか」「聴き入れるも聴き入れないもありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで自分の悪かったことは幾重にも詫まるし、どんな条件でも聴き入れるから、一切の過去は水に流して、是非もう一度帰って来てくれるように。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――」どんな条件でも聴き入れると云う文句の次に、もっと正直な気持を云うと、「彼女が土下座しろと云うなら、僕は喜んで土下座します。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな忠告をしたところでとても聴き入れる恒川ではないし、又、鴛鴦の如き二人の様子を眼の前にしては、彼等に逆らふやうなことを切り出せる筈のものでもなかつた。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめてもの詫心、良平が命に賭けて恋い慕う娘を納得させて、一日も早く祝言の盃を交させようと思いましたが、真弓は、おどかしても、叱っても、宥めても、頼んでも、こればかりは聴き入れることではありません。",
              "citation": {
                "source": "百唇の譜",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
