        "examples": {
          "standard": [
            {
              "text": "作業に集中したい時は、歌詞のない穏やかなアンビエント・ミュージックをBGMとして流すことにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "スマートフォンの専用アプリを使って、世界中の最新ヒットミュージックをいつでもどこでもストリーミングで楽しむ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ドライブにはお気に入りのミュージックが欠かせないので、自分専用のプレイリストを何種類か作成しておいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "一九八一（昭和五十六）年に関西大学の工学部建築学科に入学し、先輩たちとオーディオミュージック同好会を作りました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ステレオがあっても、聴くものがなければ話にならないからだろう、ここには「世界名曲全集」などという、クラシックやホームミュージックを集めた、解説つきのレコードセットもある。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ミュージック・ライフ』に大意がのってたじゃねえか」　高志は小さく笑った。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "15いいからちょっとロックンロールを聴かせてくれ〈ロックンロール・ミュージック〉チャック・ベリー「だいたい、ギターにさわったから、いけないんだってば」「だからって、あそこまでやることはないだろ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈ロックンロール・ミュージック〉だ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも楽観的な「ミュージック・ライフ」ですら、解散説を記事にしていたぐらいだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "音楽にも軽音楽やダンス・ミュージック、みんなが口ずさむようないろいろな歌。",
              "citation": {
                "source": "質問へのお答え",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、ぼんやり右往左往に入れ乱れ、房々、涼しそうな葉をつけた梧桐を見ながら、隣家から聞えて来るダンス・ミュージックを聞いた。",
              "citation": {
                "source": "一九二三年夏",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の関係もないと思われるかもしれないパーソナルコンピューターの歴史とロックミュージックの忘れえぬ出来事は、ある種の人々の歩みの中では深く結びついている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに色彩音楽（カラー・ミュージック）をその中に織り込み、また、知識的思惟作用が映画的表現を得るかどうかも試みるために、映画語（キノ・ザッツ）の実験も考えたのであった。",
              "citation": {
                "source": "色彩映画の思い出",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "また琴を弾く者達が、不思議な音楽をやった（私は一人の日本人に、ミュージックの日本語は、直訳すると「音のたのしみ」を意味するということを聞いた）。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "次はミュージックレビューのコーナーです」キューの合図とともにそれまで生気の失せた表情を突然溌刺とした笑顔に変えたアナウンサーが言った。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "イエスとかピンク・フロイドとかＥＬ＆Ｐの曲にヴァンゲリスばりのシンセサイザーミュージックを加味したような……まあそういう風なサウンドをあたしたちは基本的に目指してるんです。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "次はミュージックレビューのコーナーです」アナウンサーが言った。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいね」「はい」「そこで君はミュージックレビューのお定まりの挨拶を済ませた後、テーブルに戻ってはじめて彼女たちに会う。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何デソンナモノ穿イテルンダネ」「ミュージックホールノヌウド・ショウナンカヘ行クト、ミンナ裸デコレヲ穿イテ出テ来ルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「うんそうだ、プリシラ・ディーンだ」「ラ、ラ、ラ、ラ」と浜田が再びダンス・ミュージックを唄いながら、踊り出した時でした。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後は日劇ミュージック・ホールの踊り子となった。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどミュージック・カセットのテープの箱とおなじようなサイズの、片木で出来た四角な平たい箱なのです。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ビルボード』誌が一九四九年にリズム・アンド・ブルースをレイス・ミュージック（黒人音楽）と呼ぶことをやめた。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "４　カントリー・ミュージック〈１〉　アパラチアのストラデヴァリアス　一九二〇年には一億六〇〇万人だったアメリカの人口は、一九三〇年には、一億二三〇〇万人にまで増加した。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カントリー・ミュージックのまず最初の楽器は、ヴァイオリンだった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "聴取者からの反応がいいので、ラジオ局はカントリー・ミュージックをながすようになり、二五年の『グランド・オール・オプリイ』の開始で、ラジオはカントリー・ミュージックの単なる発表の場ではなく、カントリー・ミュージックでカネを稼ぐ場になった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜカントリー・ミュージックが選ばれたかというと、人々はオペラなどよりもアパラチア山中のフィドラーのフィドル（ヴァイオリンとは呼ばずに、フィドルと呼ぶ）を聞きたがったからであり、聞きたいものを聞かせておけば、コマーシャルにも有利だったのだ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カントリー・ミュージックは、アパラチアの山のなかからでてきたとたんに、コマーシャリズムと表裏の関係を結ばなくてはいけなかった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "不況のなか、そしてそこから立ちなおろうとしている人たちにとって、おそらく唯一の娯楽は、カントリー・ミュージックだったろう。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダイアル６５０をさがせばＷＳＭ局の『グランド・オール・オプリイ』が土曜日には必ずあったし、バーン・ダンスのかたちで、多くの局が、カントリー・ミュージックをながしていた。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラシックはテンポが遅いどころか、「ああした深いことをもう云つてのけたのか」と、君が若しミュジックなるものの存在に耳を触れるに相応しければ当然感ずる次第なのであつたかも知れない。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方二時間ばかりミュジック・ホールへいらっしゃるのは、一日働いたあとに害にはなりませんよ」　彼はそう云って笑いました。",
              "citation": {
                "source": "株式仲買店々員",
                "author": "コナンドイル　Arthur Conan Doyle",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが旧劇の観客は、大部分、仏蘭西に於ける「ミュジック・ホオル」の観客である。",
              "citation": {
                "source": "新劇のために",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
