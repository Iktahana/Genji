    "definitions": [
      {
        "index": 1,
        "gloss": "farewell cups of water",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "出征する友人と、固い決意を込めて水杯を交わした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の武士は、戦の前に水杯をすることで覚悟を示した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「いざ出陣！」と、皆で水杯を飲み干した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "彼らは当日、家を出るときに、銘々の妻子と水杯を掬み交わした。",
              "citation": {
                "source": "乱世",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛妻のおもとと水杯を交わすとき、格之介は、不覚にも涙を流した。",
              "citation": {
                "source": "乱世",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その九十一　成善は藩学の職を辞して、この年三月二十一日に、母｜五百と水杯を酌み交して別れ、駕籠に乗って家を出た。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "水杯を酌んだのは、当時の状況より推して、再会の期しがたきを思ったからである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただの百姓や商人など鋤鍬や帳面のほかはあまり手に取ッたこともないものが「サア軍だ」と駆り集められては親兄弟には涙の水杯で暇乞い。",
              "citation": {
                "source": "武蔵野",
                "author": "山田美妙",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の永い幽界生活中にもお客様と水杯を重ねたのは、たしかこの時限りのようで、想い出すと自分ながら可笑しく感ぜられます。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれ、水杯を一つやらかして……」　道庵は一杯グッと飲んでからに、袴の塵を打払って、「御免よ」といって人立ちを分けて舞台の方へ進み出しましたから、米友もじっとしてはおられず、それにつづいて舞台へと進みました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「われわれはどこまでも穏かに、どこまでも従順にして来たのに、警察のやり方はわれわれを威嚇して事を計ろうというのだ」と憤慨し、「水杯までして出て来たのだ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "社会的施設の知識についても、警察制度の発達や、交通機関の発達のため、追剥ぎ、辻斬り、水盃をして旅立ち等の悲惨事は絶無になりましたが、他方に失業問題や、階級闘争問題が起りまして、文化の余弊と言われております。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――銀の波も……こうなると、水盃だわね、疾のむかし、お別れになって、灰神楽が吹溜ったような、手づくねの蝋型に指のあとの波の形の顕われたのを、細工盤に載せたのを、半分閉じた目で熟と見まもって、ただ手は冴えても、腕は鳴っても、遣場のない鉄鎚を取りしめて……火鉢に火はなし、氷のように。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人は型ばかりの水盃を取り交した。",
              "citation": {
                "source": "番町皿屋敷",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがために、その前夜はかたきの方を眠らせないとか、あるいは水盃に毒を入れて飲ませるとか、種々の臆説を伝える者もあるが、そんなことはしなかったに相違ない。",
              "citation": {
                "source": "かたき討雑感",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうせ家を出る時に、水盃は済まして来たんだから、覚悟はとうからきめてるようなものの、いざとなって見ると、こんな所で弁慶の立往生は御免｜蒙りたいからね。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで並みいる士官も我劣らじと水盃を挙げて下士官の健康を祝したと云うぜ」「こんな噺もあるよ」とだまってる事の嫌な迷亭君が云った。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "清方といふ人は江戸ツ子によくある酷い郷土自慢で、偶に病気にでも罹つて、箱根辺へ保養に出掛けなければならぬ折には、家族と水盃も仕兼ねない程の旅行嫌ひで、東京市内でも山の手は田舎臭いといつて、滅多に出掛けた事が無いさうだが、その日は築地だつたから、別れに水盃の必要もなかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は人の為に酒を佐るに嫻ひし手も、などや今宵の恋の命も、儚き夢か、うたかたの水盃のみづからに、酌取らんとは想の外の外なりしを、唄にも似たる身の上｜哉と、漫に逼る胸の内、何に譬へん方もあらず。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "将来絶対禁酒というので水盃で三三九度を遣ったそうだ。",
              "citation": {
                "source": "無系統虎列剌",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸いにして議会が開設されるにはされたが、その当初は選挙といっても全然暴力選挙のダイナマイト・ドン時代で、選挙運動者は皆、水盃の生命がけであった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この水盃は無量の思いでかわされた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆、水盃だ」　右源太は、吐出すようにいった。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "八郎太は、腰の竹筒から、水を飲んで、小太郎が、手当を終って脚から手を放すと「水盃」　と、云って、蒼白めた顔に、微笑して、竹筒を差出した。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「水盃が厭なら、血を啜るか」　八郎太は、左腕を捲った。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "東海道は百三十里、駅路の数は、五十三、京都までは二十日の長旅、この時代では人生の大事、そこで旅へ出る人々など、水盃をして別れたという。",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の見事さというものは、謂わば危くも転落しそうに見える房飾つきの水盃を、百尺竿頭に保っている、その際どいかね合いで、拍手は、その緊張に対し、そのサスペンスの精力に対してなされた。",
              "citation": {
                "source": "落ちたままのネジ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて、こいつで水盃でもして……」　と、ここまでいった時、森閑と静まりかえった遠い廊下の端の方で、何かしら鋭い短い音がした。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "（間）さうさう、今朝、旦那さまと奥さまが、水盃つていふのをなすつたわよ。",
              "citation": {
                "source": "動員挿話（二幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "よし　　だから、今朝、お別れの水盃をなすつたんだわ。",
              "citation": {
                "source": "動員挿話（二幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝、奥さまとお別れの水盃つていふのをなすつたわよ。",
              "citation": {
                "source": "動員挿話［第一稿］",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "作法の真似事をし、重吉に新年の祝儀を述べ、形ばかりの膳に向って御酒代りの水で盃をまわしはじめたが、水盃というのは不吉な時にかぎってするものだから、気を悪くしてものをいうものもない。",
              "citation": {
                "source": "重吉漂流紀聞",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "大膳は斜めならず喜び、行水をして佛前に香を焚き、客殿の畳を裏返しに重ねた上で水盃を酌み、脇差を取って西に向うと、立ちながら腹を十文字に切った。",
              "citation": {
                "source": "聞書抄",
                "author": "第二盲目物語",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
