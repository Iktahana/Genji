[
  {
    "uuid": "1b29b472-e3ae-5c6d-b524-a546f937b299",
    "entry": "みたい",
    "reading": {
      "primary": "みたい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "接尾辞",
        "形容動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "-like",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夢みたいな話だが、それは現実だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は天使みたいに優しい人だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "まるで映画みたいな展開に驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、そんな定規みたいな「ほがらか」なんぞはおやめなさい。",
              "citation": {
                "source": "酒場にて（定稿）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、輝き出でるや、諸君は云ひます、「あれでああなのかねえ、不思議みたいなもんだねえ」。",
              "citation": {
                "source": "酒場にて（定稿）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで音楽批評家はといふと、「どうだ、夜の絵は――さう日光の御厄介ばかりならんで」なぞと画家に云ふ画家の叔父さんみたいな思ひ付きを並べるか、（まあその叔父さんなんざあ甥に親愛を感じて云つたのだからまあまんざら空無ではないがね。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "）それともも少し上等になると、例へばヴィオロンの批評には、「まづ、ボーイングはと……つまりボーイングなる眼点よりしてこの提琴演奏家はと……」といつた具合らしく、発表された批評文恰かも生理衛生の答案みたいなのがあるのである。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の詩を辿り乍ら、この稿を書いてゐる今、色々と心に浮ぶことを、何の反省をも加へずに、唯々書誌してみたいと思ふ。",
              "citation": {
                "source": "海の詩",
                "author": "――人と海――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして茲で何がなし附加へてみたいのは、孤独を恐れぬこと、といふことである。",
              "citation": {
                "source": "詩と現代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに氏のエッセイはとみると、時にダダツ子みたいに感じられる時がある。",
              "citation": {
                "source": "萩原朔太郎評論集　無からの抗争",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今、件の青年をＡとし、相手の青年をＢとするとして、二人の交游がどんな有様を呈するであらうか、以下そのことを誌してみたい。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて中の一人が、「云ふことは分らないから、一つ農学士様の話す様子を見てやらう」といふことになり、「なんだい、まるで腰抜みたいぢやないか。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "右は、新聞記事を読んでの私の記臆でありまして、詳しいことは何も存じませんが、又私はこれから、此の記事に出て来る実際人物のことを云はうとは思つてゐませんが、この記事を種に、私が想像出来るだけのことを記して、以て我邦感傷主義を一寸論じてみたいのです。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は今、その世界を聊かなりとも解明したいのであるが、当抵手に負へさうもないことであるから、仮りに、さういふ世界に恋著した宮沢賢治が、もし芸術論を書いたとしたら、述べたでもあらう所の事を、かにかくにノート風に、左に書付けてみたいと思ふ。",
              "citation": {
                "source": "宮沢賢治の世界",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "通路を距てて直ぐの向ひ側には、鉄道従業員の妻君みたいなのが、胸をはだけて赤坊に乳を飲ませてゐる。",
              "citation": {
                "source": "三等車の中（スケッチ）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は暫く麦のよく稔つた田園を歩いた後、フト玉を突いてみたい欲望を抱いた。",
              "citation": {
                "source": "西部通信",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君ちやん（僕の名、実は君介、どうもブラ公みたいな名ですよ）どうも遅くなつて御免よ、富田の奥さんがいろんな話をしなさるから、あとからあとから話しなさるから。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがまた不思議に癒る（心は悪くないが、浅墓であることの象徴みたいだと予てブラ公はさう思つてみてゐるのである）。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "女　だつてあたし、なんだかみたい気がするんですもの。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "女　さうよ、あなたみたいに、常識主義者ぢやないことよ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりは暗くなる時刻が来る少し前あたりから人に会ふやうな機会になつてゐたことが不運みたいなもんで、それ故何もかも神秘なやうなものでもある。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだ唐人の寐言みたいだ。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "なまなかそれをいつかどな理由をつけて、その理由への対策を講じてみたつて、暗い女が明るくならうとしてアバズレになるみたいなもんだ。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "自己弁解でない文章を読みたい。",
              "citation": {
                "source": "創作余談",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当にもうこのごろは、お互い腹のさぐり合いで、十年来の友人でも、あいまいな事をちょっとだけ書いて寄こして、あなたみたいに、長い手紙を書いてはくれません。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいささかでも便乗みたいな事は、てれくさくて、とても、ダメなのです。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　羽左衛門の私生活なども書いてみたい。",
              "citation": {
                "source": "男女川と羽左衛門",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "下手な歌みたいなものまで書いて、恥ずかしゅうございました。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その語尾の感嘆詞みたいなものだけは、よせ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「朝顔みたいなつらをしやがって、と来るんじゃないかね？",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕は馬場みたいに出鱈目を言うことはきらいですねえ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな逆説めいたことを口走って、サイダアを一瓶、頭から僕にぶっかけて、きゃっきゃっと気ちがいみたいに笑った。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝居の台詞みたいな一種リズミカルな口調でもって、「君、僕は泣いているのじゃないよ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
