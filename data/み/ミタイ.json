  {
    "uuid": "61e64d73-5937-518f-b40d-44d1195805ee",
    "entry": "ミタイ",
    "reading": {
      "primary": "みたい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "太宰イツマデモ病人ノ感覚ダケニ興ジテ、高邁ノ精神ワスレテハイナイカ、コンナ水族館ノめだかミタイナ、片仮名、読ミニククテカナワヌ、ナドト佐藤ジイサン、言葉ハ怒リ、内心ウレシク、ドレドレ、ト眼鏡カケナオシテ、エエト、ナニナニ？",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリツク怒濤、実ハ楽シキ小波、スベテ、コレ、ワガ命、シバラクモ生キ伸ビテミタイ下心ノ所為、東京ノオリンピック見テカラ死ニタイ、読者ソウカト軽クウナズキ、深キトガメダテ、シテハナラヌゾ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山ハ絵ノ具ヲドッシリ付ケテ、山ガ地上カラ空ヘモレアガッテイルヨウニカイテミタイモノダト思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「山ハ絵ノ具ヲドッシリ付ケテ、山ガ地上カラ空ヘモレアガッテイルヨウニカイテミタイ」‥‥山が地上から空にもれあがる‥‥それはすばらしい自然への肉迫を表現した言葉だ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月×日　昨夜八時半頃ロイドと自室にいると、ミタイエレ（十一・二歳の少年召使）がやって来て、一緒に寐ているパータリセ（最近、戸外労働から室内給仕に昇格した十五・六歳の少年、ワリス島の者で英語は皆目判らず、サモア語も五つしか知らない。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とミタイエレが言う。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　マダ　オメメヲ　トヂテ　ネネシテ　ヰルノデスヨ」　花タチハ　ウマノ　アカンボヲ　ミタイト　オモヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　ミツルクンミタイナ　ヨワムシニマデ、バカニ　サレルト　オモウト　ハラガ　タツテ、「ヒゲサンガ　ナンダイ！",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コヒツジハ　オカアサンノ　オチチガ　コヒシク　ナツテ　キテ、「メイ　メイ、オカアチヤン　オカアチヤン　オチチ　ノミタイ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニシロ、イマニ、コヤミタイニ　オホキナ　ロバニ　ナルト　イフノデスカラ、チヒサナ　クルマデハ　マニアヒマセン。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒点ガ見エ、強イ光デ網膜ガヤケタトキノ感ジガアリ、且ツチラチラト電線ノ雑音ミタイナモノガ盛ンニ動クノデアル。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "小穴曰そんな死にもの狂ひミタイなものと一しよになるものか。",
              "citation": {
                "source": "芥川龍之介論",
                "author": "――藝術家としての彼を論ず――",
                "note": "青空文庫"
              }
            },
            {
              "text": "小穴君曰、そんな死にもの狂ひミタイなものと一しよになるものか。",
              "citation": {
                "source": "（芥川龍之介の書翰に就いて）",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミタイカタハ、私ノ家ヘ遊ビニオイデナサイ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨシヲサンノオ母サンハ、オカシクナツテ「アラ、マア、何テヘンナオ子サンダラウ、マルデ、カツパノオバケミタイダワ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "水ガ　ケダモノミタイニウォーウォー　ト言ッテ流レタ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何トカ出来タラ一夕彼ヲオ座敷ヘ呼ビ、舞台デ見タ通リノ女装ヲサセテ、チョットデモイヽカラ一緒ニ寝テミタイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸モペッタリシテオ乳ナンゾナクナッチマウシ、肩ノ筋肉モマルデ男ミタイニコチ／＼ニナルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――去年ミタイニ長クイルノハ退屈ダナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛞蝓ニ舐メラレタミタイデ、一日気持ガ悪カッタワ」「相手ガ春久ダッタラドウカナ」グット、声ヲ呑ンデカラ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「医者ガ内診スルミタイダ」「馬鹿ネ」「舌ヲ使ワズニ接吻シロナンテ、随分無理ナ註文ダナ」「接吻ジャナイモノ、タヾ唇デ触ラセルダケダモノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナコトヲ今知ッタノカ、君ミタイナ利口ナ人ガ」「ダケド、ドウ云ウ気持カラソンナコトヲ考エルノ」「自分デ恋ノ冒険ヲ楽シムコトガ出来ナクナッタ腹癒セニ、セメテ他人ニ冒険サセテ、ソレヲ見テ楽シム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――冗談ミタイニ云ッテタケド、案外本気ラシカッタワ」「誰デモ女房ニソウ云ワレルト、ソンナ負惜ミヲ云ウモノサ」「彼ニモ誰カ好キナ人ガアルラシイノヨ、アタシト同ジヨウナ過去ヲ持ッタ、何処カノキャバレノ人ラシイワ。",
              "citation": {
                "source": "瘋癲老人日記",
