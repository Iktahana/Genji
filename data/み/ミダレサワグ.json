          "literary": [
            {
              "text": "……ソフィヤ・リヴォヴナは心の乱れ騒ぐのを感じながら、おずおずとその平尼僧に近づいて、肩ごしに顔を覗いて見るとやはりそれがオーリャだった。",
              "citation": {
                "source": "大ヴォローヂャと小ヴォローヂャ",
                "author": "ВОЛОДЯ　БОЛЬШОЙ　И　ВОЛОДЯ　МАЛЕНЬКИЙ",
                "note": "青空文庫"
              }
            },
            {
              "text": "口から泡を吹いて、酔眼をビードロのように据えたまま、野猪のように、艫から舳へ、舳から艫へと、乱れ騒ぐ人間を掻きわけて飛び廻ります。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "笑い茸",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ少女のようなしなやかな脚が、活溌に水を蹴って動く度に、水は飛沫を上げて乱れ騒ぐ。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            }
          ]
