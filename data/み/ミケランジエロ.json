        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "）われは心を死せる文字の間に濳むること能はず、魂を彼のミケランジエロが世に罕なる丹青の力もて此堂の天井と四壁とに現ぜしめたる幻界に馳せたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミケランジエロは蓋し能くダンテの歌ひしところを畫けるなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "羅馬なる聖彼得寺塔を觀てミケランジエロが作りし雛形の美に驚くは、建築を視る眼あるものゝ皆能くするところなるべし。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミケランジエロの晩年に感じた寂寥は固よりステンダールの比較にならない程大きい。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しミケランジエロの嘆きはその爲す可き事を遂げ得なかつたため、その美しい本質が伴侶を見出し得なかつたための寂しさであつた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しドン・ホアンとして生きた者の晩年にミケランジエロが經驗したやうな大きい、深刻な寂寥がやつて來たらどうであらう。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しミケランジエロやレオナルドに比べれば、ロダンでさへその傍により付けないであらう。",
              "citation": {
                "source": "合本三太郎の日記の後に",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
