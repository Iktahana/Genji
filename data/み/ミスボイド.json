          "literary": [
            {
              "text": "ミスボイドは学校で見るより、家で見た方がどれほど好いか分らない。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "長谷川先生に手紙でミスボイドのことわりを出して置いて貰う。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月十六日（月曜）　今日からミスボイドがはじまる。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミスボイドと、ミストロットはまるで大変に違う。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            }
          ]
        }
