          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "生後一ヶ月を過ぎたので、氏神様へ子供の健康を祈って宮参りに行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "お宮参りの日は天候に恵まれ、祝い着に身を包んだ息子の姿を写真に収めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖父母も一緒に宮参りに参列し、家族全員で新しい家族の誕生を祝った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "あたしたちは神田明神へお宮参りをしましたが、お父さんは山王様へお宮参りにいったのですかときくと、そうだといわれる。",
              "citation": {
                "source": "大門通り界隈一束",
                "author": "続旧聞日本橋・その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶応義塾の下に春日神社が今でもあるが、あれが、私の産土神で、あの社へお宮参りもしたのであった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお、わが国の宮参りのごとし。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "その写真は赤坊がお宮参りの晴衣をつけているのです。",
              "citation": {
                "source": "むかでの跫音",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは恰度お宮参りの日で、お屋敷はお祝いのお客様で大混雑、応接室の方からは晴れやかな笑声が絶えず聞えて居りました。",
              "citation": {
                "source": "美人鷹匠",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その年の六月、梅雨あけの晴れた日の午後に、わたくしはこずえを宮参りに伴れていった。",
              "citation": {
                "source": "やぶからし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮参りを済ませて、家へ帰る途中も、帰ってから夕餉の支度をするあいだも、わたくしの頭はすっかり混乱して、どうしても考えをまとめることができなかった。",
              "citation": {
                "source": "やぶからし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おしゃぶりをしゃぶって宮参りの犬張子、お祝物の鯛車で育て上ったわんぱくどもが、おいみんな遊ぼうよ、とひっくり返すおもちゃ箱の中は、芳藤のおもちゃ絵そのまま。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まではどの家でも子供のお宮参りの時、これを祝いに求めましたが、犬をこんなにも特色ある形にこなしたものは、他にないように思われます。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "生まれ児がお宮参りに着るのをミヤマヰリゴ（美作）、女がお歯黒を始めてつける日に着るのがカネツケゴ（北美濃）、年寄が厄年の祝に着るのをヤクゴ（讃岐）というのを見ると、ゴは着物のことと思われる。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌十三日は鏡番と称していろいろの余興があり、翌々日も宮参り、終って一年の総勘定をする。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "神さまは赤子の初宮参りの日から、もう氏子をごぞんじであって、それが心に何を願っているかもよく知っていられるものと、昔からわたしたちは教えられていたのである。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう正一のお宮詣りですよ、着のみ着のままであまり可哀そうですから、私｜昨夜こんなものを二枚分買って来ましたの。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それに、お宮詣りに行かないとしても、祝ってもらったところへだけは配り物をしなければなりませんからね。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たちの七五三の祝着なども干されましたが、そのなかで背中に飾紐のついてる広袖の着物が、私のお宮詣りの日に着たものだと聴かされた時には、自分の憶えのない遠い赤児の頃を思って、ふしぎな気持がしました。",
              "citation": {
                "source": "虫干し",
                "author": "鷹野つぎ",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四日後の朝日に谷川徹三氏の書いた年頭神宮詣りの記事は一般にその膝のバネのもろさで感銘を与え、時雨女史も賢い形で一応の挨拶を行った。",
              "citation": {
                "source": "一九三七年十二月二十七日の警保局図書課のジャーナリストとの懇談会の結果",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へば京阪地方で産兒の宮詣り（男兒は出産後三十一日目女兒は三十日目に産土神に健康と幸福をさづかりに來る）に必らず麻緒を産衣に結びつける、それも近親ではなくて、近隣の人々に結んで貰ふ土俗があるのは、この産所の緒紡ぎと何等かの關係があつたことを暗示するものではなからうか。",
              "citation": {
                "source": "淡路人形座訪問",
                "author": "竹内勝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "清子は深見高次の実の姉で、深見高次の戦死のこともありますし、子供も数人あることですし、時勢をも考えまして、七歳の娘に御宮詣りはさせませんでしたが、家庭内で、ささやかな祝いを催しておりました。",
              "citation": {
                "source": "沼のほとり",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治神宮へ行つて居れば盛裝で參詣する可愛いゝ男女の子供が見られたのに、いつもは朝新聞を見るのに、昨日に限つて故郷へのクリスマス・プレゼントの荷作りなどで、夕方新聞を見て初めてお宮詣りの日だつたと知つた。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後は二匹の女狐が赤坊を連れてお宮詣りをするところで『家内繁昌、芽出度し／＼終』で結んであつた。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「此宵の宮詣りは一生を通じて詣って来たようなものだ。",
              "citation": {
                "source": "津の国人",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "元日、勝則に、新調の晴衣を着せ、夫婦揃って、氏神の白山神社に宮詣りをした。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "百日の宮詣りが近づいていた。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いねは姉たちの着古した赤い布をあれこれと見積っていたが、姑のかやに向って、「孫のような子をつれて宮詣りでもあるまい、やめとこか」　するとかやはもってのほかという顔つきで首をふり、「何をいうぞいの、罰当りな。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏でさえも卵生んだら、ここここと鳴くのに」　いねはつぎはぎをして実枝の宮詣りの赤い着物を縫った。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリクリとして、美しいお稚子人形のようであった新九郎は、その母に連れられて、城下端れへ宮詣りに行ったことがある。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が子供のころ母について近所の家に行っていたときに、その家の母親が「伜はお宮詣りに行きました」という。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁の歿したのは大正五年十二月、その一カ月ほど前、ある席で懐中から小冊子を取り出し「これは君にあげるつもりでようやく探しだした」とわざわざ恵まれたのは『宮詣り東のつと』という潮来の細見で狂歌人の絵本、しかも文久二年後の種彦求之と書入れがある。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
