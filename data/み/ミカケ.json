    "definitions": [
      {
        "index": 1,
        "gloss": "outward appearance",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は見かけによらず、実はとても繊細な性格をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "その料理は見かけは地味だが、味は天下一品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "商品を選ぶとき、見かけだけで判断してはいけない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "パラソルをさして歩くと、少したすかるかも知れませんが、男がパラソルをさして歩いている姿は、あまり見かけませんね。",
              "citation": {
                "source": "炎天汗談",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "棟方志功氏の姿は、東京で時折、見かけますが、あんまり颯爽と歩いてゐるので、私はいつでも知らぬ振りをしてゐます。",
              "citation": {
                "source": "青森",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "棟方志功氏の姿は、東京で時折、見かけますが、あんまり颯爽と歩いているので、私はいつでも知らぬ振りをしています。",
              "citation": {
                "source": "青森",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正九年、露細亜詩人ベールィの作を雑誌で見かけて破格語法なぞといふことは、随分先から行はれてゐることなんだなと安心す。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "因に、こうした景趣の村は関西地方に多く、奈良、京都の近畿でよく見かける。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主婦や娘は台所で立働いているのを裏口の方から見かける事があるが、一体に何処となく陰気なこの家内のさまは、日を経るに従うて自分の眼に映る。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、お祝言の時などの島臺の、れいの蓬莱山、尉姥の身邊に鶴と一緒に侍つて、鶴は千年、龜は萬年とか言はれて目出度がられてゐるのは、どうやらこの石龜のやうで、すつぽん、たいまいなどのゐる島臺はあまり見かけられない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹木の幹に「登山記念、何月何日、何某」とナイフで彫つてある文字を見かけることさへあるが、私には笑へない。",
              "citation": {
                "source": "貪婪禍",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "市中の堀などでよく見かけるやうな、船を家として渡つて行く家族の一つである。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々は真昼の百貨店でよく彼女を見かける。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "農婦の派手な色の頬冠りをした恰好がポーランドあたりで見かけたスラヴ女の更紗の頬冠りを想い出させる。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "五稜郭行というバスを見かけて乗る。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見かけた田代はコーヒーの勘定などはあとでいいからすぐ駆出せばよいのにその勘定でまごまごしてなかなか追っかけない。",
              "citation": {
                "source": "初冬の日記から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "住宅を建てた時でも色々な耐震的の工夫をして金目をかけたが、見かけの華美を求める心はなかったようである。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕食前の数分間には子供部屋をおとずれている彼を見かけた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃は日本人の顔がだんだんに西洋人に似てくるようで、銀座などを歩いているとあちらの映画スターに似たような顔つきをした男女を見かけることも珍しくないがただ髪の毛だけは、当り前のことだが皆申し合せたように真黒である。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "町には平凡な商家が並び、どこの田舎にも見かけるような、疲れた埃っぽい人たちが、白昼の乾いた街を歩いていた。",
              "citation": {
                "source": "猫町",
                "author": "散文詩風な小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あれァ都田村の吉兵衛親分じゃねえか」　「そうじゃねえんだ、吉兵衛親分と将棋をさしてる男よ」　「このあたりじゃ、見かけぬ顔だが……誰でえ」Ｓ＝二階の一室　離れ座敷と庭を隔てた二階の座敷。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "が其の店といふのも見すぼらしくはないまでもただあたりまへの八百屋に過ぎなかつたので、それまであまり見かけたことはなかつた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々の存在の一部をもつて「見えざるもの」に協力してゐる、（少くとも）見かけだけはそのごとくに見える、そして我々の生きてゐるかぎり、我々の持分である「見えざるもの」を増加せしめなければならないところの、我々の裡で。",
              "citation": {
                "source": "ドゥイノ悲歌",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、私はその時、彼の左手が言ひやうのないくらゐ素早く外套の襟の方へ走つて、それをこつそりと掴み、そしてそれを立て、それから非常に細心に、兩手でもつて、その襟を下ろさうとするのを見かけて、どんなに驚いたことでせう。",
              "citation": {
                "source": "巴里の手紙",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、また私は幌無しの辻馬車が――臨終前の一時間といへども、ふだんの賃金どほりに二法で走るところの、幌をすつかり上げた、時間ぎめの辻馬車が、大急ぎでやつて來るのを一度ならず見かけたものだつた。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はアダの話で夢中なのだがアダがかつて土人街に蟄居していた日本の売笑婦だと云ったり、或るものは自分はヴィクトリア公園の熱帯樹の下を黒奴の中年の紳士と日傘をさして歩いていた彼女を見かけたことがあると真実らしく話して、彼女が洋妾だろうと云う。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る支那帰りの商人は、アダを北京の南陽門通りの裏街の露西亜人の酒場で、彼女がフランス兵とふざけているのを見かけたと云うのだ。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京で震災前までは深川へんで見かけたことのあるあの定斎屋と同じようなものであったらしいが、しかし枇杷葉湯のあの朱塗りの荷箱とすがすがしい呼び声とには、あのガッチンガッチンの定斎屋よりもはるかに多くの過去の夢と市井の詩とを包有していたような気がする。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二）同一ならばその家の猫Ｂと、宅の庭で見かけた猫Ｃと同一か。",
              "citation": {
                "source": "ある探偵事件",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう光景を何遍となく街頭で見かけた。",
              "citation": {
                "source": "鑢屑",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那や御領ンさんに顔を合すのがおっかなくって、向うから来るのを見かけると、わざと道を外らした。",
              "citation": {
                "source": "「紋」",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "がその店というのも見すぼらしくはないまでもただあたりまえの八百屋に過ぎなかったので、それまであまり見かけたことはなかった。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "銭湯のなかで私は時たま一緒になる老人とその孫らしい女の児とを見かけました。",
              "citation": {
                "source": "橡の花",
                "author": "――或る私信――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
