  {
    "uuid": "53d0b726-6f9e-51c0-a69f-603842da0ac8",
    "entry": "妙応",
    "reading": {
      "primary": "みょうおう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
