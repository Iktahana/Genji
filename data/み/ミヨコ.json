        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "九時過ぎの住宅地のなかを、十四歳のミヨコは、大きなこうもり傘をさして、雨のなかをひとりで歩いていた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "傘を頭のすぐ上まで下ろして柄を両手で持ち、首をすくめてミヨコはゆっくり歩いた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "降る雨は歩道から跳ね返る雨といっしょになって、ミヨコの短いスカートの裾のすぐ下あたりまで、常に届いていた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩いていくミヨコの脚を、密度の濃い雨をかいくぐったヘッド・ライトが、すれちがいながら照らした。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その乗用車を見送るように立ちどまったミヨコは、傘を少しだけ上へ上げた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その集合住宅の駐車場へ、ミヨコは入っていった。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "集合住宅の広い駐車場の縁を歩いていったミヨコは、やがてふと駐車場のなかに入った。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "停めてある自動車の列のなかを蛇行して歩き、ミヨコは建物にむかった。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "駐車場を抜けたミヨコは、建物の正面入口の軒下に入った。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミヨコは一方の壁へ歩み寄った。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "電話機とおなじ配列の数字のボタンとインタフォーンがある前に立ち、ミヨコはヒトミの部屋の番号を押した。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ミヨだよ」　と、インタフォーンの送話口にむけて、ミヨコは言った。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミヨコは奥のガラス・ドアへ歩き、部屋にいるヒトミがロックを開放したその重いドアを全身で押して開き、なかに入った。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミヨコの目の前に、エレヴェーターがあった。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "エレヴェーターにひとりで乗ったミヨコは、六階で降りた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミヨコはドア・チャイムのボタンを押した。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミヨコと良く似た体型と雰囲気の、おなじ十四歳の少女であるヒトミが、ミヨコを招き入れた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "空気がみんな雨みたい」　傘をドアのわきに立てかけ、ミヨコはサンダルを脱いでフロアに上がった。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こんな雨の日に、ミヨコはなにをはいて来るのかなあと、私は思ってたの。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "左にむかう廊下の奥へ、ヒトミはミヨコを連れていった。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗面室の外に立ちどまったヒトミは、なかをミヨコに示した。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ミヨコがきいた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "空を相手に本気で怒るから」　両脚を、そして両腕を、ミヨコがタオルでぬぐうのを外で待ち、ふたりは廊下を歩いていった。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒトミの家のなかは、何度来ても私は迷子になるよ」　キチン、そしてそれに隣接している食事のためのスペースのさらに奥の部屋に、ミヨコとヒトミは入った。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お寺の匂いがする」　ミヨコは言った。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ミヨコはきいた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ヒトミの質問に、「言うような気がする」　と、ミヨコは、答えた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ミヨコが重ねてきき、ヒトミは首をかしげた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミヨコは笑い、その笑いの延長で、「お母さんは、いまいないの？",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
