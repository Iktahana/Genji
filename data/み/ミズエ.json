        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供が筆に水をつけて、画用紙に水絵を描いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "乾くと消えてしまう水絵は、何度でも練習できるので面白い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "伝統的な技法を用いた水絵の展示会が開かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
