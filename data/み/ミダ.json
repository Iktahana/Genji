[
  {
    "uuid": "fa32b5ae-678e-5ed3-ba48-5a3ff896e2b7",
    "entry": "弥陀",
    "reading": {
      "primary": "みだ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
