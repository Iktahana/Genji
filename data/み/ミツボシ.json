    "definitions": [
      {
        "index": 1,
        "gloss": "three stars (shape)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "クリスマスの飾り付けに、可愛い三ツ星のオーナメントを使った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夜空には、きらめく三ツ星がはっきりと見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女が描いた絵には、夜空に輝く三ツ星が描かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "松浦侯の三ツ星の家紋のついた幕舎の床几に、老中阿部対馬、牧野｜内匠頭、堀内加賀、目付兼松五郎左衛門、松浦侯などがいた。",
              "citation": {
                "source": "ひどい煙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "三ツ星さん竹内浩三私のすきな三ツ星さん私はいつも元気ですいつでも私を見て下さい私は諸君に見られてもはずかしくない生活を力一ぱいやりまする私のすきなカシオペヤ私は諸君が大すきだいつでも三人きっちりとならんですゝむ星さんよ生きることはたのしいねほんとに私は生きている",
              "citation": {
                "source": "三ツ星さん",
                "author": "竹内浩三",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時近くに宿を出て、メーンストリートを歩き、丸善でスキメールの封筒を買ひ、三ツ星デパートで珍しい洋酒を求め、ぶらり／″＼と大須の方へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二時に三ツ星デパートの常務井上氏に会ひ、ウイスキーを安く分けて呉れるといふので三本ブラック・ホワイトとジョニ赤を四十円宛で買ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハサミの先端の名称は地図上でそれぞれ三ツ星点、シュール点だ。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "『三ツ星点から乗って……』おそらくボートでしょう。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいですか、水中望遠鏡で見ればはっきり、三ツ星点のサンゴ礁に、深い星型が三つ刻まれています。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "三ツ星点からボートに乗れば、そう、頭骨点があるに違いない。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
