        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして道を距てた前に民芸館と称する、同スタイルの大建築がまるで戦国時代の城のように建ちかけている。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "同氏の嗣子から、遺愛品のうち何か一つ記念に民芸館に寄贈したいから、遠慮なく選んでくれまいかとの便りであつた。",
              "citation": {
                "source": "赤絵鉢",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今民芸館に所蔵され、いつも陳列されているのは、凡てその頃の朝市の獲物なのである。",
              "citation": {
                "source": "京都の朝市",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等の布類も、今は全部民芸館に納めてある。",
              "citation": {
                "source": "京都の朝市",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく民芸館に飾られる全緑釉、指掻紋の大捏鉢があるが、之も朝市での収獲であった。",
              "citation": {
                "source": "京都の朝市",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちの一枚を私は鹿児島で獲たから、民芸館には今二枚所有していることになる。",
              "citation": {
                "source": "京都の朝市",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "倉敷民芸館にも一枚絶品がある。",
              "citation": {
                "source": "京都の朝市",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今も民芸館に備へてある。",
              "citation": {
                "source": "和紙十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "後それ等の品は、民芸館所蔵の屏風の裏張に沢山用ゐられた。",
              "citation": {
                "source": "和紙十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は同君の染紙なくしては、表具の仕事を民芸館のために充分になすことは出来なかつたであらう。",
              "citation": {
                "source": "和紙十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は最近それ等の凡てを集めて、六曲一双の屏風を民芸館のために作つた。",
              "citation": {
                "source": "和紙十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
