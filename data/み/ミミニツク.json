        "examples": {
          "standard": [
            {
              "text": "電車の中で流れる広告の音楽が、ずっと耳に付いて離れない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "隣の席の人のひそひそ話が耳に付いて、集中できなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "変な流行語が一度耳に付くと、つい使ってしまうことがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "このごろは家内もおちついて、毎日ふり続くさみだれの音も耳に付くようになった。",
              "citation": {
                "source": "鼠",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "水戸藩の志士が一団二団と分かれて江戸に潜入し、佐久間町の岡田屋、馬喰町井筒嘉七、さては吉原大門前の平松などに変名変装で泊まり込んでいることはとうに調べがついているのだが、顔の識れない連中が多いし、なまりも、耳に付くほどではないので誰が誰だかいっこうにしっぽをつかませない。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "一旦出て行く事は出て行つたが耳に付く子供の泣声……ハハハ、ま、かう言つた調子だ。",
              "citation": {
                "source": "妻恋行",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
