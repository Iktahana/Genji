        "examples": {
          "standard": [
            {
              "text": "彼は若い頃、自国の民主化運動に身を投じ、何度も投獄された経験を持つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "天安門事件は、中国の民主化運動が武力で弾圧された悲劇として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼女は、SNSを通じて海外に自国の民主化運動への支持を訴えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "佐野、鍋山、三田村達がさかんに策謀している組合、労働組合の民主化運動に対し組合員党員の一人一人がどんなに正しくまたひろい実際性をいかして闘っていくかということを、改めて考えてみるべき日でもある。",
              "citation": {
                "source": "共産党とモラル",
                "author": "――三・一五によせて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "勤労人民が生活安定を求めて団結する力を扱いやすい形に分裂させるため、組合民主化運動と称する分裂運動が盛に行われている。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に吉田内閣の反民主的政策の現れとして全般的に勤労者の自主的民主化運動への反撃が開始されたために、紙面が沈滞の傾向をたどり、経営者が発言権を回復した。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "民主的な出版事業の確立という点から民主的な出版業者から出版業界の民主化運動が起った。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九四五年八月以後、すべての学校では学内の民主化運動が活溌に起った。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本画の領域にははっきりした民主化運動が起らないほど封建的習慣がしみついている。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
