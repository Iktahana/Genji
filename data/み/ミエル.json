        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "フジサンヤウミガミエルアイビキ！",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "フジサンヤウミノミエルアイビキ！",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "アミエルの乾物になるな。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハツパト　ハツパノ　アヒダニ、トホク　ミエル　モノ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがその中に、クミエルニツキー大迫害に関する詳細な記録があったのでございます。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へば、アミエルの日記は最上の日記のひとつと認められてゐる。",
              "citation": {
                "source": "日記と自叙伝",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "「景色とは、人間の心状態である」といつたスヰスの詩人アミエルの名句は、まさしく此處へ來て味はふことが出來る。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはアミエル自身が、自國の山影、湖光に對して、親しく味つた經驗に違ひない。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里から帰って　フランスへ出発前、中島健蔵氏から同氏訳のラミエルを貰ったので、向うでゆっくりフランスと引きくらべて読んでみようと思い、これだけ持っていったのに、それも読まずに持って帰って来た。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アミエルの言ったように、腕だめしに剣を揮ってみるばかりで、一度もそれを実際に使わないようなことになっては、たいへんだと思う。",
              "citation": {
                "source": "校正後に",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから Journal とは、主観的には日記（例えばアミエルの Journal intime）などを意味するし、客観的には新聞紙などを指すこととなるのである＊。",
              "citation": {
                "source": "イデオロギー概論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "Journal とは、であるから、主観的には日記（アミエルの Journal intime の如き）を、客観的には新聞紙類を指すことが出来る。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アミエルの日記」でも持つていつて讀みたいのだが、君のところに原書は無いか。",
              "citation": {
                "source": "手紙",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "アミエルは彼女のことを「田舍のセヴィニエ夫人」だといつてゐるが、言ひ得て妙である。",
              "citation": {
                "source": "モオリス・ド・ゲランと姉ユウジェニイ",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他ロロ・Ｈ・ミエルといふ人も「蝶」と「かはらひわ」を音楽化した。",
              "citation": {
                "source": "「博物誌」の序に代へて",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ディケンスの小説のなかの名を借りて、メグは一ばん年上なので、サミエル・ピクイック氏。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばバイロン、アミエル、グリルパルツァーなどの日記、ゲーテの書簡や対話などである。",
              "citation": {
                "source": "「世界文学大系58　カフカ」年譜",
                "author": "原田義人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
