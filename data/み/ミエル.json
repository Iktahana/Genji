    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to be seen",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "遠くの山々がはっきりと見える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の部屋からは、東京タワーが見える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "雲一つない青空に、飛行機が小さく見える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "うつらうつらと僕はする……風もある……松林を透いて空が見えるうつらうつらと僕はする。",
              "citation": {
                "source": "蝉",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに牧野さんが酔ふと発しはじめるのなぞは、当人に自制力がないよりも、周囲が彼にとつてはあまりに不真面目に見える所から起るのであつたと考ふべき点もあるのであるから、さういふ定説が呑気に繰返されることは辛かつたのである。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "浪のうねりと白歯が見える。",
              "citation": {
                "source": "海の詩",
                "author": "――人と海――",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは一見逃避のやうに見えるかも知れないが、人間自分が自分を生んだのでないからには、自力をだけ恃むのではどうしても根無草だと思ふのだ。",
              "citation": {
                "source": "詩壇への願ひ",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見突慳貪にも見えるけれど、実は寧ろ気が弱い迄に見解の博い人である。",
              "citation": {
                "source": "萩原朔太郎評論集　無からの抗争",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見、その根性は人をして屡々知慧ある態度を採らせるやうに見える。",
              "citation": {
                "source": "詩と詩人",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ個性のある人間といふものは、個性のない人間からみると、フーチヤンと見える理由があるのだ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は却々さうでもないやうに見えるとしても、少しく時が経過してみれば、まこと嗤ふべきことに過ぎないであらう。",
              "citation": {
                "source": "近頃芸術の不振を論ず",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三造は因循に見える。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　智的ではない社交しか未だない此の国では、其処にゐる人達には社交能力の欠乏といふことが、論なく無価値と見えるのである。",
              "citation": {
                "source": "西部通信",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "健康や、生活の向上をしか念としない多くの人々は、つまり多くの幸福論者達には、実験室で働いてゐる者は愚と見える。",
              "citation": {
                "source": "西部通信",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯草は針金のやうに硬くて、トゲトゲとした檜か何かの森が遠くに見える。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "沖は、あまりに稀薄に見える、其処では何もかもが、たちどころに発散してしまふやうに思はれる。",
              "citation": {
                "source": "一つの境涯",
                "author": "――世の母びと達に捧ぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ひは、無感覚に見えるかも知れない。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひよつとしたら怜悧にさへ見えるかも知れない。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "新宿の數多いビルヂングは、何かの張子細工のやうに見えるし、アスハルトの街路の上を無限に續く肥料車が行列して居る。",
              "citation": {
                "source": "悲しい新宿",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「海は、海の見えるのは、どちら側です。",
              "citation": {
                "source": "海",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは、海の見える側に坐った。",
              "citation": {
                "source": "海",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "浦島太郎さんの海が見えるよ。",
              "citation": {
                "source": "海",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の行く手には、死の壁以外に何も無いのが、ありありと見える心地がしたからだ。",
              "citation": {
                "source": "織田君の死",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のこせこせした心境を軽蔑しているようにも見える。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ程この女は持操ない女である――否、この女は、ある場合には極度に善良であり、ある場合には極度に悪辣に見える、かの堕落せる天使であつたのだ。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞそれが可能に見えるのは、かの記憶、或は経験によつてゞある。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで近代の作品は、私には、歌はうとしてはゐないで、寧ろ歌ふには如何すべきかを言つてゐるやうに見える。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論それは余りお菓子の欲しくない人が駄菓子の方が寧ろ美味い、といふ時のやうなふうにして発生した通念と見えるが、それにしても、一応の由来はあると思へるので、一寸その事に就いて云つてみれば、　西洋人の方が、我々よりも尠くも形の上では楽天的である、従つて即興的であるよりも構成を怡しむ習性を一層持つてゐる。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が刹那主義といふ時、恰かも私が上に述べた如き趣意にあるやうに見える。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "土塀を越して見える屋根といふ屋根に、一度落ちた雨がまた跳ねあがつてゐる。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "一丁ばかり先の練瓦建の家が、泳いでゐる緋鯉のやうに、ボンヤリトキ色に見える。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄曇りの空が針葉の間から隙いて見える、根を張り樹脂の多い、男松の印象を此の顔は与へた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "設計が生ずるためには、最初は唯盲目的意欲とも見える発明家の意志がなければならぬ。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to look",
        "register": "standard",
