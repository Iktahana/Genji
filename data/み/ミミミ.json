        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "乳臭い声で「ミミミミ」と甘える声や、可哀くてたまらない様にそれに答える母牛の声が私までが良い気持になる様にひびいて隙間から、草を口うつしに喰べさせて居るのが見える。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒヒヒフミミミ　イイイムイ――　ドドドレミミミ　ソソソラソ――と発音するところを、年よりの男先生はヒヒヒフミミミ――という。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミミミミフフフ　ヒヒフミヒ――　唱歌は土曜日の三時間目ときまっている。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒヒヒフ　ミミミ　イイイムイ　奥さんだけが歌い、それにオルガンの調子があうまでにはだいぶ夜もふけた。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒヒヒフミミミ　イイイムイ　はいッ」　生徒たちはきゅうに笑いだしてしまった。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ミミミミフフフ　ヒヒミヒー　フーフフフヒミイ　イイイイムイミ……　これでは、まるで気ちがいが笑ったり怒ったりしているようだ。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
