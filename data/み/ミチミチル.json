        "examples": {
          "standard": [
            {
              "text": "彼の顔には、大仕事を成し遂げた後の自信が満ち満ちていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "その広場は、祝祭を楽しむ人々の熱気に満ち満ちていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "生命力に満ち満ちた若葉が、太陽の光を浴びて輝いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "仇討ちは気持ちいいものだとわかっていたつもりでしたが、これほど魂に安らぎが充ち満ちるとは今まで思ってもみなかったのです。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は云う、地球の表面に他の植物がないならば、徐々としてただの一種たとえば茴香が蔓延して全土を蔽ってしまい、またそれに他の住民がいないならば、それは数世紀にして、ただの一国民たとえば英蘭人で充ち満ちるであろう、と１）。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
