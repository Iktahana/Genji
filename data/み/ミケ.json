    "definitions": [
      {
        "index": 1,
        "gloss": "calico (pattern)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あの三毛の着物は、とても珍しい柄だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "三毛の模様が特徴的な猫は、とても可愛い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は三毛の浴衣を着て、夏祭りに出かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "妻が三毛猫だけ連れてもう一匹の玉の方は置いて行こうと云ったら、子供等がどうしても連れて行くと云ってバスケットかなんかを用意していた。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は三毛猫を膝からおろしながら云った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっとした庭を控えて、庭と桑畑との境の船板塀には、宿の三毛が来てよく昼眠をする。",
              "citation": {
                "source": "嵐",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆さんは長火鉢を前に三毛を膝へ乗せて居眠りをしている。",
              "citation": {
                "source": "嵐",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇敢なクジマ、今までに四十人の生命を助け十回も屋根からころがり落ちた札付きのクジマのおやじが屋根裏の窓から一匹のかわいい三毛の子ねこを助け出す。",
              "citation": {
                "source": "火事教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはとにかく、この胚子の壺の形がだんだんにどこまでも複雑な形に分岐し分岐して、それがおしまいにはクレオパトラになったり、うちの三毛ねこになったりするのである。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "クレオパトラでも三毛ねこでも畢竟は天然の陶工の旋盤なしにひねり出した壺である。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしてそんならいまのやうに、三毛だの赤だの煤けたのだの、斯ういろいろになったんだい。",
              "citation": {
                "source": "林の底",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　梟ははじめ私が返事をしだしたとき、こいつはうまく思ふ壺にはまったぞといふやうに、眼をすばやくぱちっとしましたが、私が三毛と云ひましたら、俄かに機嫌を悪くしました。",
              "citation": {
                "source": "林の底",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三毛といふのは猫の方です。",
              "citation": {
                "source": "林の底",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥に三毛なんてありません。",
              "citation": {
                "source": "林の底",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてその部下の一番書記は白猫でした、二番書記は虎猫でした、三番書記は三毛猫でした、四番書記は竃猫でした。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな事務所のまん中に、事務長の黒猫が、まつ赤な羅紗をかけた卓を控へてどつかり腰かけ、その右側に一番の白猫と三番の三毛猫、左側に二番の虎猫と四番のかま猫が、めいめい小さなテーブルを前にして、きちんと椅子にかけてゐました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "といふわけは、もうみなさんもお気づきでせうが、四番書記のかま猫は、上の方の三人の書記からひどく憎まれてゐましたし、ことに三番書記の三毛猫は、このかま猫の仕事をじぶんがやつて見たくてたまらなくなつたのです。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度は向ふの三番書記の三毛猫が、朝仕事を始める前に、筆がポロポロころがつて、たうとう床に落ちました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "三毛猫はすぐ立てばいいのを、骨惜みして早速前に虎猫のやつた通り、両手を机越しに延ばして、それを拾ひ上げようとしました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "三毛猫は殊にせいが低かつたので、だんだん乗り出して、たうとう足が腰掛けからはなれてしまひました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが丁度この時に、三毛猫はあんまり乗り出し過ぎてガタンとひつくり返つてひどく頭をついて机から落ちました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが三毛猫はすぐ起き上つて、かんしやくまぎれにいきなり、「かま猫、きさまはよくも僕を押しのめしたな。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度はしかし、事務長がすぐ三毛猫をなだめました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで三毛猫も、仕方なく、仕事にかかりはじめましたがやつぱりたびたびこはい目をしてかま猫を見てゐました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうしてどうしてかま猫は、」三毛猫が云ひ出しました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "」三毛猫が口を尖せて云ひました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "扉が開いて三毛猫がはひつて来ました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "」かま猫は立つて挨拶しましたが、三毛猫はだまつて腰かけて、あとはいかにも忙がしさうに帳面を繰つてゐます。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "」三毛猫が云ひました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "」虎猫と三毛猫が一緒に挨拶しました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがすうと扉を押してはいって来たのはいままで五六ぺん見たことのある大きな三毛猫でした。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」三毛猫が云いました。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お目見得に来た人民の中に一人の婆さんがいて、一匹の三毛猫を抱いて犬の王様の前に出てお辞儀をしました。",
              "citation": {
                "source": "犬の王様",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
