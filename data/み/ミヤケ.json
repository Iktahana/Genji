[
  {
    "uuid": "5730fcac-69ab-59c2-bf6a-6f35d837dc6c",
    "entry": "宮家",
    "reading": {
      "primary": "みやけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "house of an imperial prince",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "戦後の皇籍離脱によって、多くの宮家が民間人としての生活を送り始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歴史ある宮家ゆかりの品々が、特別展で一般公開されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "〇〇宮家には代々伝わる独自の家訓があり、今も大切に守られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "何とか男爵別荘、何々の宮家別邸、缶詰に石ころを入れた有名な奴の別荘などが湖畔に建っていた。",
              "citation": {
                "source": "名勝地帯",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてお岩を田宮家から出した喜兵衛は、早速お花を伊右衛門にやることにしたが、仲人なしではいけないので伊右衛門に云いつけて近藤六郎兵衛に仲人を頼ました。",
              "citation": {
                "source": "四谷怪談",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがために扶持を召し放されて田宮家は断絶した。",
              "citation": {
                "source": "四谷怪談",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長右衛門は驚いて庄兵衛の家の跡目の心配をしていると、六日目の夕方から長右衛門自身が病気になって八日目に歿くなり、続いて庄兵衛が十日目になって歿くなったので田宮家は又断絶した。",
              "citation": {
                "source": "四谷怪談",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの家へ出入りする学生は夫人の妹の次男で、ゆくゆくは田宮家の相続人となって、伯母の夫人を母と呼ぶことになるらしい。",
              "citation": {
                "source": "鰻に呪われた男",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "只今首尾よくこの悪僧を仕止めた以上、この寺に在る不浄の金銭は残らず宮家に於て召上げられる故に左様心得よ。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その師匠さんが、先年奥さまをなくなさったとかで、和田の叔父さまと謡曲のお天狗仲間の或る宮家のお方を介し、お母さまに申し入れをなさって、お母さまは、かず子から思ったとおりの御返事を師匠さんに直接さしあげたら？",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その継母の家へ出入りすることをきらって、命婦は祖父の宮家へ帰るのである。",
              "citation": {
                "source": "源氏物語",
                "author": "末摘花",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども今さらしかたのないことである、いつまでも捨てずに愛してやろうと、源氏は結論としてこう思ったのであるが、それを知らない常陸の宮家の人々はだれもだれも暗い気持ちから救われなかった。",
              "citation": {
                "source": "源氏物語",
                "author": "末摘花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十日の夕方に宮家から贈った衣箱の中へ、源氏が他から贈られた白い小袖の一重ね、赤紫の織物の上衣、そのほかにも山吹色とかいろいろな物を入れたのを命婦が持たせてよこした。",
              "citation": {
                "source": "源氏物語",
                "author": "末摘花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私に御遺言をなすったこともありますから、ただ今からは私を睦まじい者と思召してくださいましたら幸せです」　と源氏は言ってから、宮家の人々を呼び出していろいろすることを命じた。",
              "citation": {
                "source": "源氏物語",
                "author": "澪標",
                "note": "青空文庫"
              }
            },
            {
              "text": "「兵部卿の宮の中姫君も弘徽殿の女御と同じ年ごろなのだから、それではあまりお雛様遊びの連中がふえるばかりだから、少し年の行った女御がついていて陛下のお世話を申し上げることはうれしいことですよ」　と入道の宮は人へ仰せられて、前斎宮の入内の件を御自身の意志として宮家へお申し入れになったのであった。",
              "citation": {
                "source": "源氏物語",
                "author": "澪標",
                "note": "青空文庫"
              }
            },
            {
              "text": "親しい家司に命じて下男などを宮家へやって邸内の手入れをさせた。",
              "citation": {
                "source": "源氏物語",
                "author": "蓬生",
                "note": "青空文庫"
              }
            },
            {
              "text": "職を欲しがっている下家司級の人は、源氏が一人の夫人の家として世話をやく様子を見て、仕えたいと申し込んで来て、宮家に執事もできた。",
              "citation": {
                "source": "源氏物語",
                "author": "蓬生",
                "note": "青空文庫"
              }
            },
            {
              "text": "入道夫人の祖父の中務卿親王が昔持っておいでになった別荘が嵯峨の大井川のそばにあって、宮家の相続者にしかとした人がないままに別荘などもそのままに荒廃させてあるのを思い出して、親王の時からずっと預かり人のようになっている男を明石へ呼んで相談をした。",
              "citation": {
                "source": "源氏物語",
                "author": "松風",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮家の財政も心細くなった際に、源氏が熱心な求婚者として出て来たのであるから、女たちは一人残らず結婚の成り立つことばかりを祈っていた。",
              "citation": {
                "source": "源氏物語",
                "author": "朝顔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついこの間も、宮家へお嫁入りになるＩ公爵家の令嬢が、玄関から馬車に乗るところを撮ろうとして、どうしても門番が入れてくれないものだから、白昼公爵邸の塀を乗越えて、問題になったという男です。",
              "citation": {
                "source": "Ｍ侯爵と写真師",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "其一二を擧げるならば、一つは久邇宮家に關する事である。",
              "citation": {
                "source": "維新史の資料に就て",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ等の事は、自分は後に久邇宮家の傳記を調査した故の内藤恥叟翁其他から親く聽いた所である。",
              "citation": {
                "source": "維新史の資料に就て",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "久邇宮家では其の傳記を世に發表せられずして其の儘藏されて居るといふことであるが、これ等の事も今日になれば勝利者の態度を保護する爲めに何時迄も眞相を蔽ひ隱すといふことは甚だ不都合であつて、有りの儘の材料を傳へることをはかるべきである。",
              "citation": {
                "source": "維新史の資料に就て",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "後に或る奈良の宮家へ下されたそうですが、それをまた奈良の新薬師寺の尼さんが御ねだりして拝領して、今は同寺の宝物になっているそうであります。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "谷中時代の弟子のこと",
                "note": "青空文庫"
              }
            },
            {
              "text": "一宮家から吉田さんの at home day に行き、コスモポリタンに行く。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯今は、またぞろ、ある宮家に納まるべきものに筆を着けています。",
              "citation": {
                "source": "靄の彼方",
                "author": "――現代風俗描写への待望――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの前、徳川喜久子姫の御入輿に、今は高松宮家に納まっています一双の御屏風も、これに似た調子のものでして、これにも萩を描き加えました。",
              "citation": {
                "source": "虹と感興",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子薫子の父若江量長は伏見宮家職の筆頭で、殿上人の家格のあつた人である。",
              "citation": {
                "source": "津下四郎左衛門",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばこれを食物についていえば、今日ドイツでは、パンや肉の切符というものがあって、上は皇室宮家を始めとし、各戸とも口数に応じて生活に必要なだけの切符を配布されることになっている。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "大将は姫君を非常に恋しがって逢いたく思うのであったが、宮家のほうでは少しもそれを許さない。",
              "citation": {
                "source": "源氏物語",
                "author": "真木柱",
                "note": "青空文庫"
              }
            },
            {
              "text": "前夫人がどう恨んでいるかというようなことは知らぬふうにして、長男、次男を中にして好意を寄せる尚侍に前夫人は友情をすら覚えているのであるが、式部卿の宮家には大夫人という性質の曲がった人が一人いて、この人は常にだれのことも憎んで、罵言をやめないのである。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（下）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この手紙を持って、少将はずんずん宮家へはいって来た。",
              "citation": {
                "source": "源氏物語",
                "author": "夕霧二",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩は久しぶりの骨休みやけに、どうぞ一つ腹一ぱいやつておくんなさい。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
