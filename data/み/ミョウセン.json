        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "むかし読本のいわゆる（名詮自称。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "水聲は中々激しくて、川といはうよりは瀧といつた方が好い位であり、成程「瀧」といふ地名も名詮自性であると首肯かせた。",
              "citation": {
                "source": "華嚴瀧",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　叫びざまに、こぢんまりとしたからだをちょこちょこと走らせて、逃げゆく影を追跡していった様子でしたが、いかさま名詮自称のことばのとおりで、右手のうちから得意の投げなわが、するすると長いへびのごとく伸びたかとみるまに、わざは知恵伊豆守が希代の名技と折り紙つけた秘芸でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "曲芸三人娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "左なるが世附川、右なるが玄倉川、中なるが名詮自性の中川也。",
              "citation": {
                "source": "足柄の山水",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "名詮自性、お兼は殖産の才と慈悲の心とを兼ねたり。",
              "citation": {
                "source": "鹽原新七不思議",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "日光より湯本まで六里の間、見晴しは、この名詮自性の見晴山にのみ在りて、單調を破る。",
              "citation": {
                "source": "上州沼田より日光へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日のいわゆる胎内潜り――その辺に巣食っていたのであって、名詮自性表向きは陶器を焼いていた。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの命名は客観的にその人々の特徴を言い現したものだといえば、名は体をあらわすといわれる、いわゆる名詮自性とやらである。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体餅花とくりすます・つりいとは非常に近い関係にあるものと見えるが、同じ信州松本地方のものづくり或は名詮自性のけやきのわかぎ、小田原で楢の木にならせる団子の木、岡市氏の報告せられた北河内の餅花（郷土研究三の一）などを見ると、愈其類似点が明らかになつて来る。",
              "citation": {
                "source": "髯籠の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は東陽、これは西陰、彼は上古史、これは近代史、原始と新進の対照、「夜昼峠」は正に的確な名詮自称である。",
              "citation": {
                "source": "南予枇杷行",
                "author": "河東碧梧桐",
                "note": "青空文庫"
              }
            },
            {
              "text": "背戸の柳緑の糸をかけそめて枯葦の間からぽつぽつ薄紫の芽がふく頃となれば、それ「雪は申さず先ず紫の筑波山」霞ゆえに遠くなって名詮自称霞が浦は一面春霞だ。",
              "citation": {
                "source": "漁師の娘",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "離婚といふに未練はなけれど、金輪内雅の名詮自称、やりくり一つで持つ機関に、幾千円の穴明けてはと。",
              "citation": {
                "source": "今様夫婦気質",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "淵は瀬となる世の中に、名詮自称の金三のみ、いかでかはその数に漏るべき。",
              "citation": {
                "source": "野路の菊",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういう間違った生れつきか、人なみはずれた長い顎を持っているので名詮自性して、曰く、アコ長。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "小鰭の鮨",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の家には忠八という名詮自性の忠僕がいた。",
              "citation": {
                "source": "村一番早慶戦",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "名詮自性、蘭の花を聯想させるような美人だ。",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "名詮自性、蘭の花を聯想させるような美人だ』と書いてある。",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お師匠さんも『太田原は名詮自性、宗郷じゃの』と頭は認めていてくれた」「栴檀は二葉より香しかったんですな」「何あに、十で神童の組さ。",
              "citation": {
                "source": "ガラマサどん",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山中村は名詮自性、山また山の中にある。",
              "citation": {
                "source": "村の成功者",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
