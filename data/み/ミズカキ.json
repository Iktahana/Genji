        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "カヌーの選手たちは、力強く水かきを漕いで前に進む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は初めてのカヤックで、水かきの使い方に戸惑っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "釣りの後、水かきについた泥を洗い流した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
