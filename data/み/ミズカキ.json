[
  {
    "uuid": "4d5e34dc-e804-5dcb-9e4f-0a51b15ea073",
    "entry": "水かき",
    "reading": {
      "primary": "みずかき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "web (between fingers or toes)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "アヒルは水かきのある足で、スイスイと水面を泳いでいく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私たちの指には小さな水かきがあり、それが水泳を助けてくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "水かきのある生き物たちは、水中で素早く移動できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "舷側の水かきは、泥濘に踏みこんで、二進も三進も行かなくなった五光のようだった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶩は、ぶさいくな水かきのある脚を、破れるばかりにかわして、ひょくひょくした。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべはなし、朱のうすき水かきや、ちらら見せて。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしよく見ると、関節が二つもあり、大地をふまえるところには、五本の指があって、水かきのようなものがついていた。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "水かきのある手足、驚くほど大きくてたるんだ唇、ギョロッとしたガラスのような目玉、その他、思い出すのも気持ち悪い特徴にもかかわらずだ。",
              "citation": {
                "source": "ダゴン",
                "author": "DAGON",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の歌人は、人間の営みのいとまなさを、やすむ間もなき鴨の水かきとよみました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "大体においてペローが一行の先頭に立ち、幅の広い水かきのような雪靴で雪をふみ固めて、一行の進みを楽にした。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　けれども、カワウソとしては、足の指のあいだに水かきをもっているばかりか、カイのようにすばらしい、かたいしっぽと、水のとおらない皮膚をもっているのですから、あの渦まいている流れをわたることができないと言われては、だまっているわけにはいきません。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうえ、手足の指のあいだに、水かきのようなものがついているのをみると、きっと、泳ぎも、うまいのでしょう。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "トカゲ怪人は、おとなだけをあいてにしているのではなく、だんだん子どものほうへ、あのぶきみな、水かきのある指を、のばしはじめるのです。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "カエルの手を、千倍も大きくしたような、水かきのある、みどり色の手でした。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "水かきのある、みどり色の手！",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "小林君は、宇宙怪人が、空を飛ぶことばかり考えて、水にもぐることを、わすれていましたが、水かきがあるからには、水の中にも、すめるのです。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうえ、手と足に水かきがあります。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その水かきでも、カエルのように水をかいています。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きなはねのほかに、水かきまで、力をあわせるのですから、どんなさかなだって、かなわないほど、早いのです。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギョッとして、よく見ると、水かきのある大きな手が、ペッタリとガラスにすいついているではありませんか。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "足の先にはアザラシのヒレのような大きな水かきがついています。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、怪人は、足のさきについている、大きな水かきで、サーッと水をけって、みるみる階段の上へ浮きあがっていきました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのはだかの人たちはみんな、背中に酸素のボンベをつけ、水中めがねをもち、足のさきには、大きな水かきをはめ、手には、みょうな形の水中銃を持っていました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三人のはだかの勇士が、水中めがねをつけ、ボンベをせおい、足には大きな水かきをつけ、水中銃をかまえて、ほら穴の上下左右を、じゅうおうに泳ぎまわっているありさまは、じつにいさましい光景でした。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、そこに書いてある、さしずに、したがって、八人のはだかの勇士は、水中メガネと、ボンベと、水かきをつけて、海底の洞窟の外へ泳ぎだし、そこに待っていた五人の勇士と、いっしょになって、敵が海底に、姿をあらわすのを待ちかまえていることでしょう。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔のまえはガラスばりになっていて、手足のさきには大きな水かきがつき、背中には、酸素のボンベ（鉄のくだ）が、二つならんでついています。",
              "citation": {
                "source": "探偵少年",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、大きな水かきで、じゆうに泳げるのです。",
              "citation": {
                "source": "探偵少年",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は足や手に、家鴨みたいなみずかきがついていました。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで彼は再び、さかなみたいで、うろこがあって、足にみずかきがついていて、頤に一束の海藻みたいなものが生えた人間の姿に返りました。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "はいだめは　きたないから　ちかよらない、　それから　へにぺにサリーにも、　あと　ぶたごやも、　みずかきさんたちにもね！",
              "citation": {
                "source": "ねこぬこタムのはなし",
                "author": "THE TALE OF TOM KITTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、　なんぎしていると　そこへ　ぺたぺた　みずかきの　あしおとが！",
              "citation": {
                "source": "ねこぬこタムのはなし",
                "author": "THE TALE OF TOM KITTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると　２ひきの　あひる、　みずかきリベカと　みずかきジェマイマが　ぼうしと　えりかざりを　ひろいあげ、　じぶんたちで　かぶってしまって。",
              "citation": {
                "source": "ねこぬこタムのはなし",
                "author": "THE TALE OF TOM KITTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "みずかきドレークさん。",
              "citation": {
                "source": "ねこぬこタムのはなし",
                "author": "THE TALE OF TOM KITTEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
