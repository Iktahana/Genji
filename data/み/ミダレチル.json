          "literary": [
            {
              "text": "仮名文字わが歌の仮名文字よ、あはれ、ほつほつ、止所なく乱れ散る涙のしづく。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰かまた手に結び玉とは愛でん、みにくくも乱れ散る涙のしづく。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は自分の躯が、裂け、破れ、乱れ散るように、悩乱した。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "畳の上に乱れ散る小菊、偽物の短刀。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "傀儡名臣",
                "note": "青空文庫"
              }
            },
            {
              "text": "――兵糧が乏しくなってきたのはよい折、この折を幸いに、兵糧を送らずにおいて、彼自身の兵が意気｜沮喪して、乱れ散るのを待つのがいいです。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
