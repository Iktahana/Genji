[
  {
    "uuid": "8a61cfe9-3363-5e59-97ad-d70734b50bdf",
    "entry": "未練",
    "reading": {
      "primary": "みれん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "形容動詞"
      ],
