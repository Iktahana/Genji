      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "lingering attachment",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "元恋人への未練を断ち切るのに、長い時間がかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は、諦めた夢にまだ少し未練があるようだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "いくら努力しても報われなかったが、この仕事への未練はない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "春の思ひ出摘み溜めしれんげの華を　　夕餉に帰る時刻となれば立迷ふ春の暮靄の　　　　土の上に叩きつけいまひとたびは未練で眺め　　さりげなく手を拍きつつ路の上を走りてくれば　　　　（暮れのこる空よ！",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "すでに死を期しては月色に冴えまさり行く翁の心丹に一ひら未練の情がうす紅色に冴え残った。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふる郷を立つときから紅色に萌し始めた人情の胸の中の未練のほむらは子の慕わしさにかき立てられ旅の憂さに揺り拡げられ、こころ一面に燃え盛っている。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは稚気と、未練であるでもあろう。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "稚気と未練に含まれて、そこに何かあるに違いない。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伯母にとっては父、自分にとっては祖父の執着未練な人型なるものを見度かった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女の未練のようなものを感じていじらしかった。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして「いき」のうちの「諦め」したがって「無関心」は、世智辛い、つれない浮世の洗練を経てすっきりと垢抜した心、現実に対する独断的な執着を離れた瀟洒として未練のない恬淡無碍の心である。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩は少年や青年の文學だから、中年になつて詩に執するのは未練であり、潔よく捨ててしまふ方が好いと言ふのである。",
              "citation": {
                "source": "詩に告別した室生犀星君へ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯一つ彼女にとって未練であったのは自分の生みの父親に別れることだった。",
              "citation": {
                "source": "不幸",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "場所はまだ下町の中央に未練があって、毎日、その方面へ探しに行くらしかった。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘆の根方に住んでいる小｜鰻がそれに取りつく、環をそっと引き上げて、未練に喰い下って来る小鰻を水面近くまでおびき寄せ、わきから手網で、さっと掬い上げる。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、僕は粋な香港に未練があるんだ。",
              "citation": {
                "source": "飛行機から墜ちるまで",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は臆病ではあったが未練ではなかったのだと思っている。",
              "citation": {
                "source": "家庭の人へ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「音さえすりゃあ、いいんだね」「音さえすりゃあ、いいんだよ」、こんな事を云いながら、それでもやはり未練らしくいつまでも見物している職人の仲間もあった。",
              "citation": {
                "source": "雑記（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "では、なにぶんお願い申します」　おまきはさのみ未練らしい顔を見せないで、家じゅうの猫を呼びあつめて三人に渡した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "支配人は、工人が給料に未練を残して、逃亡もしない。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "中津は、すゞに未練を残して宿州へ出かけて以来、前々から抱いていた直感をたしかめた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山崎は、この五人のゴロツキどもを、なお、未練げになにか釣銭でも取ってやりたいように見送っていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（異なことをいうようだが何かね、世の中の女が出来ねえと相場がきまって、すっぺら坊主になってやっぱり生命は欲しいのかね、不思議じゃあねえか、争われねえもんだ、姉さん見ねえ、あれでまだ未練のある内がいいじゃあねえか、）といって顔を見合せて二人でからからと笑った。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "と一斉に声を合わせるトタンに、故郷も、妻子も、死も、時間も、慾も、未練も忘れるのである。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが世間に得てあるところの例で、品物を売る前には金が貴く思えて品物を手放すが、品物を手放してしまうとその物のないのが淋しくなり、それに未練が出て取返したくなるものである。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "死とともに欲望も死ぬるから、だれも、満たされなかった望みに未練を感ずるものはない。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "早く中止すればいいと思わない事はないが、そういう時に限って未練が出てやめるに忍びない。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一方では捨てようとして捨て切れない現世への未練の糸の端をこれらの遺物につなぎ留めるような心持ちもあるかもしれない。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "清逸の心にある未練を残しつつその万花鏡のような花は跡形もなく消え失せた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも園が……清逸が十二分の自信をもって掴みうべき機会を……今までの無興味な学校の課業と、暗い淋しい心の苦悶の中に、ただ一つ清浄無垢な光を投げていた処女を根こそぎ取って園に与えるということは……清逸は何んといっても微かな未練を感じた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして未練というものは微かであっても堪えがたいほどに苦い……。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "みれん（未練）とわ、いまだねれず、とかく由。",
              "citation": {
                "source": "盲人独笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそれでも成績にみれんがあつたので、そんな宿題を毎日せい出してやつたのである。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
