          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夏休みに入ると、子供たちはみっしり宿題に取り組んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は毎日、みっしり練習を重ねて、大会に備えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新入社員は、入社後みっしり研修を受けて社会人としての基礎を学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "三つのものを一つに減らしてもその中の一番根本的な一つをみっしりよく理解し呑込んでしまえば、残りの二つはひとりでに分かるというのが基礎的科学の本来の面目である。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙草の一番うまいのはやはり仕事に手をとられてみっしり働いて草臥れたあとの一服であろう。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お徳は老母からも細君からも、みっしり叱られた。",
              "citation": {
                "source": "竹の木戸",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "後に理科大学物理学科の課目として教わったものが「物理学」だとすると、その基礎になるべき「物理そのもの」とでもいったようなものを、高等学校在学中に田丸先生からみっしり教わったというような気がする。",
              "citation": {
                "source": "田丸先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者さんもあんまり、がおれなぃで、折角みっしりやったらいがべ。",
              "citation": {
                "source": "植物医師",
                "author": "郷土喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "「みっしり百姓のごとを習って、いいどこさ嫁に行けば、それでいいんだ。",
              "citation": {
                "source": "緑の芽",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おめえ、本当に試験を受げんのだごったら、みっしり勉強しなげえなんねえんだ。",
              "citation": {
                "source": "緑の芽",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんなことは心配しねえでも、まあ、みっしり勉強して……試験を受げさ行ぐ時の旅費ぐらい、父がなんとかしっから、こっそり行って受げて来い。",
              "citation": {
                "source": "緑の芽",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のこんな了簡じゃ、舞台に立てば引撲かれるし、謡の出稽古はしたくなし、……実は、みっしり考えようと思ってね、この墓所へ逃込んだんだが。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "逸走する馬に眼もくれず、気勢に乗った城之介、振りあげた鉄杖で、も一つみっしり脳天を食らわせた。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "みっしり利こうぜこの目算！",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代わりみっしりおとすぞよ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ここへみっしり木を入れて、この町の公園にしようてえのが、あの人の企劃なんだがね。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しそれを見越しても、その時にはその時必然の階梯を、みっしり踏んで置くことは大切と思うのです。",
              "citation": {
                "source": "われを省みる",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――短いものでしたが褒めて下さいました、そして、一二年みっしり努力すれば作家としてちゃんと立って行けると云って下さいました」「それなら、どうして――例えばこの間のような時、×社で仕事を見つけて下さるようには出来ないの？",
              "citation": {
                "source": "沈丁花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "母はきっと、二人を並べて、もう一度、みっしり自分の考を明にされたいのだろう。",
              "citation": {
                "source": "二つの家を繋ぐ回想",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "きゃつみっしり撲られるがいい。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗灰色の密雲は、みっしりと空を罩め、褪色した水彩画のようなあたりには「豊さ」というものは寸分も見出せなかった。",
              "citation": {
                "source": "自殺",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「当分二人でみっしり働こうね。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "よくお父様がおっしゃる通りのことをして――椅子の上に一寸置いて――大切な眼鏡をみっしりと破ってしまった。",
              "citation": {
                "source": "日記",
                "author": "一九二〇年（大正九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸へ帰ったらあいつを呼び付け、みっしり叱ってやらなけりゃならねえ」　夜具を冠って寝てしまった。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……出娑婆るとみっしり喰らわせるぞ！",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の出京は始めてなのだが一体にＡほどせかつかず、みっしり、しんなり（福井方言）かまえて居るのでよろし。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなた様は、どうか私の分までみっしり出世をなすっておくんなさいまし、出世をなさるには、酒と女……これがいちばん毒でございますからな、この金助が見せしめでございますよ、あの神尾の殿様も見せしめでございますよ、と言って駒井の殿様も、あんまりいいお手本にはなりませんな。",
              "citation": {
                "source": "大菩薩峠",
                "author": "黒業白業の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりも今は大将のいう通り、ナポレオンをどこかの囲い場へ引っ張って行って昼夜兼行でみっしり叩きあげなくてはなりません」「それがいい。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "乱視の奈翁　――アルル牛角力の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この辺はどの村もみな、谷川と石崖にはさまれた細い道の両側に、雛壇のように板屋を積みあげ、猫の額ほどの平地にも馬鈴薯を植え枝豆を植え、糸すじほどのその畔に玉蜀黍と辣薤をたがいちがいにたくしこみ、そのまたわずかばかりの隙間へみっしりと韮を割込ませる。",
              "citation": {
                "source": "生霊",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜はみっしり稼がなくっちゃ、ねえ、兄さん。",
              "citation": {
                "source": "渡鳥いつかへる",
                "author": "軽演劇一幕四場",
                "note": "青空文庫"
              }
            },
            {
              "text": "みっしり薗八を稽古させて行々は家元の名前でも継がせて見たいと思っているのですが、どんなものでしょう。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
