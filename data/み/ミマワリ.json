[
  {
    "uuid": "89c7f27f-7043-59b1-b80c-1c257ae11b3a",
    "entry": "見回り",
    "reading": {
      "primary": "みまわり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "patrolling",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夜間の防犯見回りが強化された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "警備員は定期的に建物内を見回りしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "町内会のボランティアが、子供たちの安全のため毎日見回りを行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "正式の見回りではなく、私の用事があって来たのである。",
              "citation": {
                "source": "最後の一句",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、鈴木教員はなおも忠実に、休業の鐘が鳴ってちょっと教員室に引き揚げていってからすぐまた、自分の受持ち教室の見回りに引き返してくるのが例だった。",
              "citation": {
                "source": "錯覚の拷問室",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親とともに番小屋に住んでまして、実にまじめな男でしたから、見回りでもするつもりで母屋へ行ったのだろうと我々は踏んでいます。",
              "citation": {
                "source": "ライギット・パズル",
                "author": "THE REIGATE PUZZLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "で散歩のつもりで甲板の見回りに出ると岡さん」　といいながらもう一度後ろに振り返って、「この岡さんがこの寒いに手欄からからだを乗り出してぽかんと海を見とるんです。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれたちが火事見回りに行くんじゃねえんだよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "身代わり花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "またあるときは、誰か見回りの番人が、カンテラを下げて、私の隠れ場所を探しにきそうな気がしてしょうがなかった。",
              "citation": {
                "source": "動物園の一夜",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもちょうど見回りの男が通りかかるときに、私がくしゃみか、咳をしたらどうだろう。",
              "citation": {
                "source": "動物園の一夜",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへこの現世の上では、不貞くされの土竜馬であるとはいへ、ひとたびゼーロンとしての因果なゆかりを持つた上は、自分までが土竜馬と蔑んで見回りもしないといふのはうしろ目たき思ひであらう――私は、終ひに左う気づいて、提灯に灯を入れた。",
              "citation": {
                "source": "夜見の巻",
                "author": "「吾が昆虫採集記」の一節",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中が二階や三階を見回りに来たので、安井君はさらにビールと肴とを注文した。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "りょうしは何事が起こったのかと思って、山刀を持って飛び出して、そこらを見回りました。",
              "citation": {
                "source": "忠義な犬",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたしも、ただならない物音を聞いて飛んできたんです」　鈴木は裏の廊下から、階段下の便所のほうを見回りに行った。",
              "citation": {
                "source": "宝石の序曲",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "父と連れだってそこいらへ見回りに出たころは、本陣の界隈に住むもので家の中にいるものはほとんどなかった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜番に、見回りに、ごく困窮な村民の救恤に、その間、半蔵もよく働いた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "その地方にある山林の枯れ痛み、風折れ、雪折れ、あるいは枝卸しなどの見回りをしているような人であった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "公儀御目付役、戸川｜中務少輔様、松平｜十郎兵衛様、右御両人は異国船見届けのため、陣場見回り仰せ付けられ、六日夜浦賀表へ御出立にこれあり候。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "半蔵は家の囲炉裏ばたに香蔵を残して置いて、ちょっと会所の見回りに行って来たが、街道には旅人の通行もなかった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ下男の佐吉も蓑と笠とで田圃の見回りから帰って来て、中津川の大橋が流れ失せたとのうわさを伝えた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には、半蔵は村の見回りに行って、そこいらを出歩く父や金兵衛にあう。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉左衛門ももう杖なぞを手にして、新たに養子を迎えたお喜佐（半蔵の異母妹）の新宅を見回りに行くような人だ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の習慣として、ちょっとそこいらを見回りに行くにも質素な平袴ぐらいは着けた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう半蔵も帰りそうなものだと思って、ちょっとそこいらを見回りに来たよ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "とりあえず半蔵は身軽な軽袗をはいて家の外へ見回りに出た。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちにはあちこちの見回りから引き返して来て、最も破損のはなはだしかったところは村の万福寺だと言い、観音堂の屋根はころびかかり、檜木六本、杉六本、都合十二本の大木が墓地への通路で根扱ぎになったと言って見せるものがある。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日のように半蔵は背戸田へ見回りに出た。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅長としての半蔵はその最後の一行を送り出した後、宿内見回りのためにあちこちと出歩いた。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "半蔵はその会所の見回りを済まし、そこに残って話し込んでいる隣家の伊之助その他の宿役人にも別れて、日暮れ方にはもう扉を閉じ閂を掛ける本陣の表門の潜り戸をくぐった。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は会所へ出かける前、ちょっと裏の酒蔵の方を見回りに行ったが、無心な幼いものの世界にまで激しい波の浸って来ていることを考えて見ただけでもハラハラした。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "眠りがたい一夜をお民のそばに送った後、彼はその翌朝に会所の方を見回りに行った。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "廃藩置県以来、一村一人ずつの山守、および留山見回りも廃されてから、伊之助もその役から離れて帯刀と雑用金とを返上し、今では自家の商業に隠れている。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "署長さんは立派な金モールのついた、長い赤いマントを着て、毎日ていねいに町をみまわりました。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "watchman",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
