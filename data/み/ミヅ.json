  {
    "uuid": "589d19e0-bcb0-5a3b-a637-a4efcd83d9ed",
    "entry": "ミヅ",
    "reading": {
      "primary": "みづ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "英語の humid（水けある）の終わりのｄをとれば「ウミ」に近くなり、第二｜綴字だけだと「ミヅ」になる。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "┌ミヅカラ△自│　　└オノヅカラ二月一日　晴曇。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇　坂本繁二郎は昔から同じことをやつてゐる男であつた、さうかと思ふと坂本とは反対にミヅテンのやうにがらがらと画風を変へてゐる連中も少くないが、結局坂本は個性的な作家である。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが国に古くミヅチなる水の怪あり。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "『延喜式』下総の相馬郡に蛟いずれも竜蛇の属の名の字をミヅチと訓んだから、ミヅチは水蛇、野蛟は野蛇の霊異なるを崇めたものと思う。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "その蛟が仏国の竜同様変遷したものか今日河童を加賀、能登でミヅチ、南部でメドチ、蝦夷でミンツチと呼ぶ由、また越後で河童｜瓢箪を忌むという（『山島民譚集』八二頁）。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく蛇を霊怪視した号なるミヅチを、十二支の巳に当て略してミと呼んだは同じく十二支の子をネズミの略ネ、卯を兎の略ウで呼ぶに等し。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "また『和名抄』に蛇和名倍美、蝮和名波美とあれば蛇類の最も古い総称がミで、宣長の説にツチは尊称だそうだから、ミヅチは蛇の主の義ちょうど支那で蟒を王蛇と呼ぶ（『爾雅』）と同例だろう。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって俗伝の野槌は、かように落ち来る蝮から生じた譚で、あるいは上世水辺の蛇を、ミヅチすなわち水の主、野山の蝮をノヅチ野の主と見立てたのかとも思う。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらを合せ攷うるに、わが邦のミヅチ（水の主）は、最初水辺の蛇能く人に化けるもので、支那の蛟同様人馬を殺害し、婦女を魅し婬する力あったが、後世一身に両役｜叶わず、本体の蛇は隠居して池の主淵の主で静まり返り、ミヅチの名は忘らる。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてその分身たる河童小僧が、ミヅシ、メドチ、シンツチ等の号を保続して肛門を覘うたり、町婦を姙ませたり、荷馬を弱らせたりし居ると判る。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はミヅナガレと読んだが、それはツルと訓むのださうだつた。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ミヅナガレ舟二郎か――こいつはどうも打つてつけの名前だな。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "水車小屋の三階の窓から伯五郎の到来を視守つてゐる雪太郎が芋畑の彼方に提灯の灯を認めるがいなや、ラツパを吹いてミヅグルマの閂を切るのだ。",
              "citation": {
                "source": "沼辺より",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この小屋は普通の水車小屋と違つてミヅグルマの大きさに比べて、蝸牛のやうに小さく側面から眺めると車の蔭にそんな家が附着してゐることは気づかれぬ程のものであつた。",
              "citation": {
                "source": "沼辺より",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の部屋は位置としては二階で、ピラミツド型の天井を持つた屋根裏なのだが、梯子段が嶮しい山へ登る径のやうにミヅグルマの背後を縫つて稲妻型に折れ曲つてゐるのだ。",
              "citation": {
                "source": "沼辺より",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりそれらの窓を持つた脚場は階段でつながれながら上下の部屋とミヅグルマの間に挟まれてゐるのだ。",
              "citation": {
                "source": "沼辺より",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕などは眠さは眠いが、とてもそんな離れ業は出来ないし、二階に逃げ込んで眠らうとしても大地震に寝台もろとも体が弾んでゐる有様では到底凝つとしては居られなかつたから、いよいよ堪らなくなると裏梯子づたひにミヅグルマの蔭をつたつて馬小屋に忍び込むのである。",
              "citation": {
                "source": "沼辺より",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ミヅカマキリ有吻類だつたかしら？",
              "citation": {
                "source": "沼辺より",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "小山の上に達すると僕はゼーロンの手綱を鞍の端に結びつけて、遥かの夕靄の彼方に見えるミヅグルマを指さして、「先へお帰りよ。",
              "citation": {
                "source": "沼辺より",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミヅグルマの家へ行かう、ミヅグルマが廻り出さない前にまた持ち返つておけば壊れる気遣ひはなし……」　お雪は、勉強の時間が少なくなることを憂ひて僕の返事も待たずに裏口の方へ忍び込んで行つた。",
