        "examples": {
          "standard": [
            {
              "text": "大工は水秤を使って、柱が正確に垂直に立っているかを確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "地面の傾斜を測るために、昔ながらの水秤を持ち出して作業を始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このテーブルは少し傾いているので、水秤で水平を調整する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "今日も　あさから　なんにも　たべないで、みずばかり　のんで　いたのです。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            }
