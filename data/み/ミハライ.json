          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "先月分の公共料金が未払いだったので、督促状が届く前に急いでコンビニで支払った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "労働組合は、長年にわたって蓄積された未払いの残業代について経営陣に抗議した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「未払いの代金が決済されるまで、新しい注文はお受けできません」とはっきり告げられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "昨夜計算したら十一万円以上未払い。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ約半額は未払いです。",
              "citation": {
                "source": "中庸",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それゆえベエコンの夢見る人類の復活は未払いの借用証文の山の頂に、しだいに影の薄いものとなった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子が、未払いになっていた授業料を届けがてら、素子のつかいで、病気だというハガキをよこしたその女教師のところへ行った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "未払いまた未払い、さきに教員を軽蔑していた役人どもは、そのうち幾人かは月給支払要求大会の驍将となった。",
              "citation": {
                "source": "端午節",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "徴収員は鼻の赤い四十前後の男で、その男の説明によれば、不破時代のが三期分たまっているし、陳根頑は全然の未払い、だからそれらの全部を払って呉れというのですが、もちろんこの家屋の名義人は不破数馬になっている。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私達の未払い分を清算して下さい。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "民事訴訟を無視した結果、ある野蛮な商人によって、未払い借金をたてに、いつ何どき刑務所送りにされかねません。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき分かりましたね、南アの億万長者コプリ氏は配当未払い事件を起こしたまさに同一人物、ずいぶん昔リンカン競馬場で半殺しにされたのを見ています。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにいろんなもめ事に加え、数週間も家賃未払いで、あす払わなければ路上に追い出される。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの怖い女家主に未払い家賃を立て替えましょう。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近知人が気づいたのは同氏の懐具合が良くなり、もう悪い噂が聞こえず、カードの未払いがあるとか、当座預金が底をついたとか、競馬場で聞かなくなった。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "未払い家賃を支払い、黄金色のソブリン金貨を二、三個見せたら、渋顔の強欲女に絶大な効き目があり、大満足して、下にも置かない扱いだ。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "とつくにのふねの、わがわたつみにしずめるをなん、すくわんとするには、たなつもの、はたつものそなえて、かみはらいにはらいまつりて――後、その作業にかかるが礼儀だと申し出がありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "Ocean の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日来配達中止だつた新聞をまた配達して来てゐる、昨日は防長社の主人が来て、代金未払の歳事記を何とか彼とか口実をいつて取り戻していつた。",
              "citation": {
                "source": "行乞記",
                "author": "仙崎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何うも思ひあたるところがないので、いろいろ考へて見たところ漸く何年か前に百合子が彼の名前で衣類を註文し、つい金を使ひ込んで先方へは未払のまゝであることがわかつた。",
              "citation": {
                "source": "好色夢",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニャ　（書きながら）ええと、未払金の残額、二ルーブリ七十五｜也と……下男登場。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "凄風冷雨のこの一日が来てから、教員等は政府に未払月給を請求したので、新華門前の泥々の中で軍隊に打たれ、頭を破り、血だらけになった後で、たしかに何程かの月給が渡った。",
              "citation": {
                "source": "端午節",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがその二三日｜前に、學生聯盟は政府に一文を上程し、「教員が授業しなかったら未払月給を渡す必要はない」と言った。",
              "citation": {
                "source": "端午節",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでその年も暮れ、一九〇二年の二月のはじめ、和蘭のデルフトの警察から、グランヴィルと名乗る男が、ホテルに鞄を置き、宿料を未払で逃亡したという通報があった。",
              "citation": {
                "source": "悪の花束",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
