          "literary": [
            {
              "text": "」ト　アル　ヒ、サクラノ　木ノ　カゲカラ　ヨワムシノ　ミツルクンガ　ヨビマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　ミツルクンミタイナ　ヨワムシニマデ、バカニ　サレルト　オモウト　ハラガ　タツテ、「ヒゲサンガ　ナンダイ！",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ミツルクンヲ　オツカケテ　イツテ　三ツ四ツ　ナグリツケテ　ヤリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミツルクンガ、「ワアー。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、カネガ　ナツテ　キヨウシツノ　マエニ　ナラビニ　ユクト、ミツルクンハ　マダ　ナイテ　ヰマス。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ミツルクン、ドウ　シマシタカ？",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　タキクンノ　オトウサンガ　ヤサシク　タヅネルト、ミツルクンハ　ナキナガラ、「タキクンガ　イジメタ、アーン。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ミツルクンガ　ボクヲ　カラカフンダモノ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
