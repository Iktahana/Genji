        "examples": {
          "standard": [
            {
              "text": "彼女の芸術作品には、深いミスティシズムが感じられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "東洋哲学を学ぶ中で、ミスティシズムという概念に触れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はミスティシズムに傾倒し、瞑想の日々を送っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そこに瞑想とミスティシズムとの最も深い結び附きがある。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "この故にひとは瞑想を欲するのであり、その限りすべての人間はミスティシズムに對する嗜好をもつてゐる。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞の宗教がミスティシズムに反對するのはかやうな誘惑の故であらう。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "瞑想のうちに、從つてまたミスティシズムのうちに救濟があると考へることは、異端である。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "この故にひとは瞑想を欲するのであり、その限りすべての人間はミスティシズムに対する嗜好をもっている。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "真の宗教がミスティシズムに反対するのはかような誘惑の故であろう。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "瞑想のうちに、従ってまたミスティシズムのうちに救済があると考えることは、異端である。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代日本の反悟性的な反動（だからそれはミスティシズムになるのだ）に対して、再び悟性を持って来るのでは、理論的武器にならぬ。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
