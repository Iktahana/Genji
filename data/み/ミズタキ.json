  {
    "uuid": "973cfe0f-6813-5799-9331-d8aced33c167",
    "entry": "水炊き",
    "reading": {
      "primary": "みずたき",
      "alternatives": [
        "みずだき"
      ],
      "is_heteronym": true
    },
    "grammar": {
