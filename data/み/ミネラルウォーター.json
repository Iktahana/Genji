        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "運動後には、ミネラルウォーターを飲んで水分補給をする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "食卓には、いつもおいしいミネラルウォーターが用意されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "海外旅行では、衛生面を考慮してミネラルウォーターを選ぶことが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "片端から胃の腑へ送り込んで、ミネラルウォーターを飲んでいると、自動車の用意が出来たと知らせてくる。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "水道システムや、瓶詰のミネラル・ウォーターといった、人間の作った制度をとおさず、地表から直接にいい水を飲むことが、この国ではいまも未来も、二度と出来ないことなのです。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コーヒーの粉とミネラル・ウォーターを冷蔵庫から取り出し、彼は一杯のエスプレッソを作った。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "キチンへいき、冷蔵庫から冷えているミネラル・ウォーターを取り出した。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタリーではお水の代りにミネラルウオーターを飲みます。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
