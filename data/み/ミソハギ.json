    "definitions": [
      {
        "index": 1,
        "gloss": "Lythrum anceps (species of loosestrife)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
