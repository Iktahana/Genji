        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノトキ、ハルカ　トオク　ノ　ホウニ、ミドリ　ノ　ミズ　ガ、カギリナク　ヒロク　ツヅイタ　セカイ　ガ　ミエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ　ヤマ　ノ　オヒサマ　ニ　カガヤイテ、チョウド　クンショウ　ノ　ヨウニ　ミエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンダマト　テフテフハ　タカイ　タカイ　トコロマデ　キマシタノデ、マチガ　ツミキザイクノヤウニ　チヒサク　ミエマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハボンコチヤンデイヤイヤモンコチヤンニカブサリマシタカラ、ソレハソレハオカシクミエマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トカイタ大キナハタヲモツテ、小サナ男ノ子ノ手ヲ引イタカイスイヨクジヨウノバン人ガムカフカラ歩イテ来ルノガミエマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
