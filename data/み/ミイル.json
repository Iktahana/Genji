[
  {
    "uuid": "14ad8cde-a118-5c7d-a94d-83ba60ed3ec9",
    "entry": "見入る",
    "reading": {
      "primary": "みいる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
