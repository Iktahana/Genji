  {
    "uuid": "a728d03a-684e-510e-b517-230e04a402a2",
    "entry": "水溜め",
    "reading": {
      "primary": "みずだめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
