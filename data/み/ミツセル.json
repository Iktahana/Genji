        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕も梅原君の世話でモンマルトルの方に下宿は見附かつて居るが、会話の稽古に行くミツセル夫人の下宿が近いのと、喫茶店に気に入つた家があるのとでまだ越さずに居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミツセル夫人と云へば其れがオテル・スフロオの初代の主人の細君だ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は馬車、自動車、オムニブスの込合ふサン・ミツセルの橋に立ちつつ、端なく我胸に砕け入る黄金の太陽の片と見て戦けり。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サン・ミツセルの通に並んだ露店が皆ぶん廻し風の賭物遊びの店であるのに自分は少し情けない気がした。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サン・ミツセルの通に竝んだ露店が皆ぶん廻し風の賭物遊びの店であるのに自分は少し情けない氣がした。",
              "citation": {
                "source": "巴里の獨立祭",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
