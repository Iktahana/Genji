[
  {
    "uuid": "38dffb0c-3fa2-5f2d-a6f4-0e9567947783",
    "entry": "妙光",
    "reading": {
      "primary": "みょうこう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
