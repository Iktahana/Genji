        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「おもろ」は幸いにして古い形を固守していてくれたが、その中にさえも稀にはミルヤカナヤがある。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "海の来訪者のニイル人またはニラ人は、『おもろ草紙』ではまたミルヤニヤとも謂っていたようである。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミルヤは次にくるナ行｜子音をいたわるための変声であり、ニヤの人の中のややあがめられる者の称呼であった。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めてこのニヤという名の、ミルヤの使者に附与せられた時代が、相応に早かったことは是だけでもわかる。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのミルヤニヤがしばしばこの世をおとずれ、世馴れ神とまで誉めたたえられていたのであった。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
