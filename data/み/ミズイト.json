        "examples": {
          "standard": [
            {
              "text": "基礎工事の段階で、職人が正確に水糸を張っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "庭に花壇を作るために、まずは水糸を引いて高さを合わせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "水糸が少しでもたるむと、壁が真っ直ぐに立たなくなってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "金網の鼠捕りで捕った鼠の足を水糸でゆわえ、片方を犬の首輪へ結ぶ。",
              "citation": {
                "source": "犬",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで子供がタコをあげているようで、巻いてはしめ、ゆるめては出し、やったり取ったりしたあげく、ようやくのことで手でつかまえて足を水糸でゆわえ、翌日食ってみようと庭に出して置いたが、ひと晩中バタバタ羽ばたきをする。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
