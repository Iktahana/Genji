        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "物音に驚いて、布団の中でわずかに身じろぐ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "痛みに耐えかねて、彼は苦しげに身じろいだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "長い会議に疲れ、椅子の上でそっと身じろいで体勢を変える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "愛子が身じろぐごとにさやさやと衣ずれがして、香料の薫りが快く俺の官能をそそる。",
              "citation": {
                "source": "畜生道",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫の書斎から差すほのかな灯かげの闇で、夜おそく、かさかさと巣の中で身じろぐ音などが聞える。",
              "citation": {
                "source": "餌",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭をガクンガクンさせながら、「もっともだ、もっともだ」と呟いては涙をこぼしていた孝之進は、フト今までひそまり返って物音一つしなかった隣室で、お咲の身じろぐ音を聞きつけると、急に気がついて、こごんだ体を引き起しながら、あちこちを見まわした。",
              "citation": {
                "source": "日は輝けり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の薄い几帳越しに人のみじろぐのが暗い中にもよく感じられるのであった。",
              "citation": {
                "source": "源氏物語",
                "author": "空蝉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
