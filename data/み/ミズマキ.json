        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎朝、日課として庭の植物にたっぷりと水撒きをする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夏の暑い日中は、芝生が枯れないようにこまめな水撒きが必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ホースを使って畑に水撒きをしていると、汗がだらだらと流れてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "私も水撒きの手伝ひをする。",
              "citation": {
                "source": "夏",
                "author": "〔私が貧乏で〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "父の定吉は花屋を商売にしている他に、この寺内が広いので、寺男の手伝いをして草取りや水撒きなどもしている。",
              "citation": {
                "source": "半七捕物帳",
                "author": "地蔵は踊る",
                "note": "青空文庫"
              }
            },
            {
              "text": "八つの年初めてお目見得に上って、お茶との御所望があったとき、過ってお膝の上にこぼしたら、ほほう水撒きが上手よ喃、と仰せられた程の殿である。",
              "citation": {
                "source": "老中の眼鏡",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の長い日もようやく暮れて、家々の水撒きもひと通り済んで、町の灯がまばらに燦めいてくると、子供たちは細い筒の花火を持ち出して往来に出る。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ等の乳くびの先きには水撒きの如露のやうな沢山の穴が通つてゐる。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "年若い友達はみな私の庭掃きや、水撒きを根気好く眺め、仕事の済むまで残酷に手伝ってはくれなかった。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子は、ある日、片手で着物の裾をつまみながら、如露で部屋の前に水撒きをしていた。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで思いついた水撒きだあね。",
              "citation": {
                "source": "日本名婦伝",
                "author": "谷干城夫人",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおかた、二三春のやつめ、ほれた男の江戸五郎が、嵐の三左衛門に人気をさらわれちまったんで、それがくやしさに水まきして歩いているにちげえねえんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんでまた、てめえでてめえの座敷に水まきしたんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "跣足になって庭を掃いたり、昔風のポンプで水まきしたり、お客様のときは御給仕役もまわって来た。",
              "citation": {
                "source": "青春",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日電車を用いて大仕掛けの水まきをなす。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "恭一は、二階で、きょう午前中に運びこんだ白鳥会の文庫の整理に夢中になっており、大沢と次郎と俊三とは、背戸の井戸端で午すぎから取りかかった鶏の解剖――それは大沢の表現だったが――のあと始末やら、畑の水まきやらで忙しかった。",
              "citation": {
                "source": "次郎物語",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを一昨年加工してポンプを仕かけ、タンクを設け、消防用兼水まき用に造っておいたのが、この度いよいよ実用に供せられることになったのだ。",
              "citation": {
                "source": "震災日誌",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏になると、水まきの時などよくたわし、でこの石をみがいて、その青さに一種の驚きに近い喜びをおぼえた。",
              "citation": {
                "source": "石",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
