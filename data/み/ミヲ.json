        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "以来、十春秋、日夜転輾、鞭影キミヲ尅シ、九狂一拝ノ精進、師ノ御懸念一掃ノオ仕事シテ居ラレルナラバ、私、何ヲ言オウ、声高ク、「アリガトウ」ト明朗、粛然ノ謝辞ノミ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アア、ソラトウミ、ナミヲハシルハエントツノカゲ　私はまた環投げの遊戯に加わった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウ　シタノデセウ」「マダ　ネンネシテルノカシラ」「ワタシタチガ　モウ　オメメヲ　ヒライタ　コトヲ　シラナイノカシラ」「モウ　ハルガ　キテルノヲ　シラナイノカシラ」　ソコデ　花タチハ　マダ　ヒラカナイ　ツボミヲ　オコシニ　カカリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ワタシノ　カナシミヲ　コラヘテ　イカナキヤ　ナラナイ」　ソシテ、コノ　デンデンムシハ　モウ、ナゲクノヲ　ヤメタノデ　アリマス。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ムスコニ　テガミヲ　ヤリマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「註」ハ固ヨリ説明解釋ヲ目的トセルモ、語辭悉ク簡單明瞭、時ニハ只結論ノミヲ綴リシ者アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ土地問題ハ單ニ國内ノ地主對小作人ノミヲ解決シテ得ベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大地主ト投機商人トノ有スル大資本ガ米穀ノ買占メ賣惜ミヲ自由ナラシメテ現時ノ米價騰貴ヲ現出シツツアルヲ見ヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "體育ヲ丹田本位ト決定スル所以ハ、只肉體ノ一面ノミヲ見ルモ根本的體育タルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツヅイテ刺スヨウナ痛ミヲオボエマシタノデハット思ッテ目ヲ開クト要之助ガ悪鬼ノヨウナ相ヲシテ白イ光ルモノヲモッテ私ニ馬乗リニナッテイマス。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シュジュツゴ、ガーゼヲトッテ、テガミヲミヨ」「手術後、ガーゼを取って、手紙を見よ」この信号は、繰返し発信されたのだった。",
              "citation": {
                "source": "西湖の屍人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド故サラニ穢ナゲナル物ノミヲ喜ビ選ンデ、其ノ形ノ極メテ見悪クキヲ取ル人有リ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那ノ古物ヲ愛スル人ニテ、本邦ノ古器ヲバ和臭有リトシ、又本邦ノ物ノミヲ玩ンデ、外国製ノ物ハ観ルヲモ厭フ輩モ無キニ非ズ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ一証ヲ申サバ、日本古代ノ鋳銭ハ僅カ十二種ナレド、其レサヘ識ラヌ者多ク、却テ支那ノ半両五銖ノ類ノミヲ古イ銭ナリト思フ人ノミ有リキ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "従来ノ殺害目的者ニ対シテハ、殺害ノ予告ノミヲシテ方法及ビ期日ヲセザリシ為メ普通月並ナル脅迫状位ニ思フテ覚梧（死ノ）モセズ、遺言モセズ、不意ニ我党ノ手ニ掛リ、卑怯ナル不敏ナル最後トナリシ者アリシニ付キカク明ラカニセリ。",
              "citation": {
                "source": "編輯室より（一九一三年六月号）",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミミヲ　クワエテ　ヒツパツタノデ、チビスケハ　シカタナク　クビヲアゲテ、ジブンノカゲヲ　ミマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "實驗ヲ主トスルハ言ハズトモ知レタル事ナレドモ、只管ニ歐洲ノ事ノミヲ主トシテ、本邦ノ利害得失ヲ審カニシ、本邦並ニ亞細亞東方ノ歴史、人情、風俗ニ通ジ、殊ニハ又自己ノ經歴、體驗ヲ主トスル事ナリ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "オフネニノリマシタ、ミンナハハジメテ　ウミヲミタノデ、ヒロイノニビックリ　　シマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゼガ　ホヲフクラシテ、フネハ　ナミヲ　　　タテテハシリマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "タローサンハ　モシモ　トチウデ、コマルコトガデキ、タラト、バスケツトノナカヘ　デンシヨバトヲイレテキマシタノデ、テガミヲツケテ、ハナシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "書シテ以テ予ノ哀ミヲ記ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ムシロ餓死スルモ哀ミヲ儕輩ニ乞ハズト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "北亞米利加ノ南部ヨリ南亞米利加ノ北部ニ掛ケテ古代開化國ノ存在セシ證跡甚ダ多ク、諸建築諸彫刻ノ外形ノミヲ見ル時ハ殆ト「ヱジプト」ノモノニ亞グガ如キ觀有リ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、いきなりキジマツトムハ、キミヲシリマセン、エイエンニ、キミヲキミダト、シラナイソシテ、カレハ、ジンセイヲシリカミトナツテ、ショウテンスル、キミニ、シュクフクアレ、ココロカラ、アリガトウＧ「そのＧと言うのが、Ｍさんと言う人じやない？",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし隱身也の如きは、ミミヲカクシタマヒキの訓と、カクリミニマシキの訓とが對立しており、これは讀み方によつて意味が相違してくるので、どちらでもよいというわけにはゆかない。",
              "citation": {
                "source": "古事記",
                "author": "解説",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハネエチヤンニ、「ネエチヤン、アノウサギノミミヲ立テテ下サイ」トイヒマシタノデ、ネエチヤンハ足デウサギノミミヲツマンデ、立テテオヤリニナリマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪子は慌てて、「ネエチヤンハ足デウサギノミミヲ………」とある「足デ」の二字を鉛筆で消した。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
