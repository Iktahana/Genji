        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "浮袋は勿論私だけの必要品ですわ、今年こそは貴女にクロールを教へて戴かなければなりません――屹度、屹度それまでには爽々しい水着姿の貴女の御様子を拝見出来るものと祈つて、そんなものをとりそろへたのです。",
              "citation": {
                "source": "〔婦人手紙範例文〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂の上にも水の中にも、露はな海水着姿の男女が、膚と膚と觸れ合はんばかしにして、自由に戲れ遊んでゐる。",
              "citation": {
                "source": "おせい",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "その二度目の真中あたりで、利男が水着姿で、街道の方からスタスタやつて来る。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊満な水着姿が、つと立ち上がったと見る間もなく、たちまち中心を失って、ドボンと水煙立てて！",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "左のサイド・パネルから少しだけ突き出ているボードの先端に、姉の舞子が水着姿で立っている。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで僕は水着姿の舞子を撮影した。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ成熟しきってはいない女性の、鋭い端正さが際立って美しい、見事に整った体をした姉が、水着姿で飛び込み台の最上段に立った。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月が私の月で、伊豆の海岸で水着姿になったのよ。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "水着姿の上半身があらわになった。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "濡れた水着姿の彼女は矢野のかたわらに立った。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "海水のしたたる水着姿でここに立った三津子を、いま絵に描いたらどうなるか。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "水着姿で母親が廊下に立っていた。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽が高いうちはこれでいいのだと言って、恵子は水着姿の腰にスカーフを巻き、夏のハイヒール・サンダルを履いた。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "節子は水着姿だった。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "水着姿の節子が発揮しているすさまじいまでの魅力の吸引力に、十七歳の彼はなすすべがなかった。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "４　夏子が水着姿でピアノを弾いている場面を写真に撮る試みは、その年の五月に実現した。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「被写体はこの自分なのに、この人はいったいなになのかしらと、自分でも不思議に思うわ」「また水着姿を撮りたいそうです」　ヨシオが言った。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「撮ってもらうのよ」「水着姿でピアノを弾いているところです」　夏子は面白がった。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬彦が夏子の家へ戻ると、夏子はすでに水着姿だった。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬彦と夏子はすぐに水着姿になった。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀子さんと芳子さんは無論のこと、大姉さんの松浦夫人まで西川老の忌諱に触れそうな短い海水着姿で通りかゝった。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "道化服の老人も、薄物一枚で裸体同然の奥さんも、水着姿の娘さんも、赤マントの闘牛士も、勇敢にそのあとに続いた。",
              "citation": {
                "source": "地獄風景",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
