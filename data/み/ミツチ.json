        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "宗教に入つて、尠くも朝と夕方に、帰依する気持があれば、謙譲は持続しやすく、さうであれば、詩的恍惚もミツチリと感じられ、漸次に味の深いものが、生れるやうになる筈だと思つた。",
              "citation": {
                "source": "詩壇への抱負",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "作品の主人公は、自分の生き方に就いてときどき「良心的」な反省をするが、そんな箇所は特に古くさく、こんなイヤミな反省ならば、しないはうがよいと思はれるくらゐで、「文学的」な青臭さから離れようとして、かへつて、それにはまつてしまつてゐるやうなミミツチイものが感ぜられた。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "既く論じた通り、上古の野椎ミツチなど、蛇の尊称らしきより推せば、足名椎手名椎は蛇の手足なきを号としたので、この蛇神夫妻の女を悪蛇が奪いに来た。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "下総の海上郡ではオミツチャゴというのがこの遊びの名である。",
              "citation": {
                "source": "こども風土記",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
