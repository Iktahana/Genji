        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼は眠い時に本を読む人が、眠気に抵抗する努力を厭いながら、文字の意味を判明頭に入れようと試みるごとく、呑気の懐で決断の卵を温めている癖に、ただ旨く孵化らない事ばかり苦にしていた。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "明頭来も暗頭打も知ったことではないけれど、父から無心に習い覚えた伝来の三曲。",
              "citation": {
                "source": "大菩薩峠",
                "author": "東海道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫ちりめんの大明頭巾でもなし、縞物の与作頭巾でもない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
