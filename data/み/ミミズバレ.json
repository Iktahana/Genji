[
  {
    "uuid": "4dccec8e-360c-50cd-b5df-b38df3aac68c",
    "entry": "ミミズ腫れ",
    "reading": {
      "primary": "みみずばれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "wale (on the skin)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "茂みの中を半袖で走り回っていたら、腕のあちこちに赤いミミズ腫れができてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「鞭で打たれたようなひどいミミズ腫れを診て、医者はアレルギー反応を疑った。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "かゆくて何度もかきむしったせいで、足に痛々しいミミズ腫れの跡が残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "三月のはじめ、凍てつくような寒い朝、刑吏はカテリーナ・リヴォーヴナのむき出しになった白い背中の上に、定めの数だけの青むらさきのミミズ腫れをしるしづけ、つづいてセルゲイの両肩にもきまった本数の鞭をふるった上、彼の美しい顔に徒刑の焼印を三つおしたのである。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "高は、あちこちミミズ腫れになった肌を撫でながら、いまいましげに、王昇の姿を振りむいた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういわれりゃ、三ところばかりみみずばれがあったようでござんしたが、ではなんですかい。",
              "citation": {
                "source": "右門捕物帖",
                "author": "なぞの八卦見",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのみみずばれは、おふくろがこしらえたものとでもおっしゃるんですかい」「あたりめえよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "なぞの八卦見",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの小娘のおれに訴えてえものは、おやじのこともことだが、ほんとうはあのみみずばれのことがおもにちげえねえんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "なぞの八卦見",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしかに前夜見たときはなかったはずの腕首に、まっかなばらがきのあとが――さるかねこにでもひっかかれたように、赤いみみずばれの跡がはっきりとついていたものでしたから、突然右門の胸はどきどきと高鳴りました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば、手首にみみずばれの跡があるが、さるにでもひっかかれましたか！",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "首筋のみみずばれに眼をつけたのも、あぶねえ気違いを押えたのも、みんなおいらのだんなじゃござんせんか！",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そっと撫でてみると、皮膚がところどころみみずばれに腫れあがっていた。",
              "citation": {
                "source": "立枯れ",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "文身、偶像、面倒くさい儀礼、そんな事はまだ物の数でもなく、装飾のつもりで、耳朶へ孔をあけて大きな金属の輪をざくざくと通したり、皮膚へ疵をつけてみみずばれの紋様をつくつたり、甚しいのになると上下の唇を引きのばして茶盆ほどの木の円盤を嵌めこんだりする。",
              "citation": {
                "source": "装幀について",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "依然として彼は口を開かないで私の顔のみみずばれをみつづける。",
              "citation": {
                "source": "四年のあいだのこと",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨツと見ぬ間にシヤツは乱れ、顔はみみずばれだらけになり、手の平でにじみ出す血を拭いてゐる）全体、君、どうしたんだ！",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかすかなみみずばれや、痛みが、伸子にのこされた佐々の家庭の風変りな情愛のしるしだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "爪はもう鈍くなっていたが、女教師が今度は猫のことを考えもしないでその爪をしっかと押しつけたので、引っかいたあとに血がにじんで、みみずばれになった。",
              "citation": {
                "source": "城",
                "author": "DAS SCHLOSS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンスは、女教師がＫの手にひっかいてつけた血のにじむみみずばれを見て、ひどく心を動かされたので、そのときＫの味方になろうと決心したのだ、ということがわかった。",
              "citation": {
                "source": "城",
                "author": "DAS SCHLOSS",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺の手首にみみずばれができていた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は自分の口にその手首を持って行って、ヒリヒリするみみずばれを舌でなめた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頬には平手打ちの跡が赤く、みみずばれのように残っていた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "瘤だらけになった蛾次郎と、みみずばれをこしらえた竹童とが、菊村宮内の住居のほうで、かた苦しくすわらされていた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
