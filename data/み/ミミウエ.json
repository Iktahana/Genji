          "literary": [
            {
              "text": "『物類相感志』に虎が人を食うごとに耳上に欠痕もしくは割裂を生ずる、その数を験して何人食ったと判るとある。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "故時衣横幅、結束相連而無縫、頭亦無冠、但垂髮於兩耳上。",
              "citation": {
                "source": "隋書倭國傳",
                "author": "魏徴",
                "note": "青空文庫"
              }
            }
          ]
