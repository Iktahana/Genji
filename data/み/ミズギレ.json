        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "六ヶ村の水切れじゃ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏ばかりでなく、冬でも少し照りつづくと、ここらは水切れに脅かされるのであると、土地の人は話した。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏ばかりでなく、冬でも少しく照りつづくと、ここらは水切れに脅かされるのであると、土地の人は話した。",
              "citation": {
                "source": "郊外生活の一年",
                "author": "大久保にて",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日わづかなる地震にて水切れとなるが如きは敢て怪しむに足らず。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京市経営の水道は炎暑｜来って水最も入用の時水切れとなり電燈は初更深夜の別なく消える事勝手次第なり。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "水切れはよいが、しかしどちらかというと、化粧であって丈夫ではない。",
              "citation": {
                "source": "蓑のこと",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――何と私等が高台の町では、時ならぬ水切がしていようという場合ではないか。",
              "citation": {
                "source": "朱日記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎晩、仮装舞踏会へ出かけたり、お金の札でたこをこしらえたり、海へ行けば、石のかわりに、金貨で水切りをしてあそんだりしました。",
              "citation": {
                "source": "空とぶトランク",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうにも水切りすることが出来ないのであった。",
              "citation": {
                "source": "血曼陀羅紙帳武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあさあ主水切り込んで来い。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいの刺身のように獲りたてもよし、一日ぐらい手当したのもよし、というようなものもあるが、小魚に至っては、なんとしても水切りに近いものをよしとする。",
              "citation": {
                "source": "料理の妙味",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "手のひらが痒いのか、水仕事の水切りのくせがついて手の甲を反らせてゐるのか、ともかく男は追ひついて言つた。",
              "citation": {
                "source": "はるあはれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンクの水切りの上に、父親のコーヒー・マグが伏せてあった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その船はもう古いので、舶先の水切には無数の傷があったけれども、これが源太の船と衝突した跡だ、などと立証できる箇所はなかった。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛾次郎さまの腕まえは――」　かれはひとりで鼻うごめかしたが、もうねらうべきものが見あたらないので、こんどは、たくみな水切りの芸をはじめた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここだよ、お侍さん――」　と蛾次郎はまえに水切りをやっていたところを教えた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "レタスの水切りをして、手で適当にちぎって、それを冷蔵庫の中に入れておく。",
              "citation": {
                "source": "サラダの謎",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その船はもう古いので、舳先の水切には無数の傷があったけれども、これが源太の船と衝突した跡だ、などと立証できる箇所はなかった。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
