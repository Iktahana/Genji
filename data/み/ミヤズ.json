          "literary": [
            {
              "text": "かくて尾張の國においでになつて、尾張の國の造の祖先のミヤズ姫の家へおはいりになりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてその國から信濃の國にお越えになつて、そこで信濃の坂の神を平らげ、尾張の國に還つておいでになつて、先に約束しておかれたミヤズ姫のもとにおはいりになりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで御馳走を獻る時に、ミヤズ姫がお酒盃を捧げて獻りました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるにミヤズ姫の打掛の裾に月の物がついておりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでミヤズ姫が、お歌にお答えしてお歌いなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで御結婚遊ばされて、その佩びておいでになつた草薙の劒をミヤズ姫のもとに置いて、イブキの山の神を撃ちにおいでになりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
