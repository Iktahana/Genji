    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それに、ラマルチーヌの、サント・ブーヴの、モンモランシイの、レカミエ夫人の、ミシュレの友情を招来したのだつた。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして奥の一部屋で熟練のお弟子が二人、ミシンをカタカタと動かしている。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年十月三十一日『東京朝日新聞』）　　　　　　　　　三十一　　　　　　世界一の高圧電流　米国ミシガンのマスケゴン電力会社で昨年来使用している高圧電流は七万二千ボルトの高圧でけだし世界第一と称せられている。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "窒扶斯菌の寿命　北米シカゴ市ではミシガン湖から用水を取っているので市中の下水を湖水に流し込む訳に行かぬ。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "小路の奥の、石塀の中の一ツの家では、すゞが、安物の手ミシンにむかって、ドレスを縫ったり、ほぐしたり、また縫ったりやっていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すゞは、一心に、ミシンに注意を集中している。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　屋内には、ついさきほどまで、ミシンをかけていたすゞが、縫いさしのドレスをそのまゝに見えなかった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の手ミシンを小脇にかゝえて、向い側の小路へ消えて行くよごれた男があった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "声を聞きつけてミシミシと二階を下りてきて「ヤア」と現われたのが、一別以来三年会わなんだ桂正作である。",
              "citation": {
                "source": "非凡なる凡人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで身体が壊れそうになってミシミシ云うんだ。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある窓では運動シャツを着た男がミシンを踏んでいた。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗濯屋の二階には今晩はミシンを踏んでいる男の姿が見えなかった。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "狭い匙の中でフォークの尖はミシン機械のように動く。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "地響きするような夕の寺の太鼓が鳴ると、空中の箒のような木の中から無数の鳥の影が周囲に撒き散らされ、ミシンの糸の端屑のような細く短い声を吐いて姿を入り混らせていましたが、太鼓が止むとすぐ又元の様に中空の箒の中に吸い込まれて行きます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "裁縫の上手な娘は、前の担任者の後を享け継いでその部落全部の裁縫を引き受けて、家事の閑にあかして仕上げて行く、たとい嫁入りしてもその女は一生専門に村有のミシン機械を使用して裁縫をし続けます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ朝ニ猿ヲ友トセリ」「昼ニ書ヲ読ミシハ？",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな清閑荘の感じを一番よく代表しているのは、おシンというその女中で、ずんぐりと背が低く「ガタガタのミシン」とかお化けとか綽名がついているくらい醜かった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "月に三度の公休日にも映画ひとつ見ようとせず、お茶ひとつ飲みにも行かず、切り詰め切り詰めた一人暮しの中で、せっせと内職のミシンを踏み、急ぎの仕立の時には徹夜した。",
              "citation": {
                "source": "旅への誘い",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と胡坐かいた片脛を、づかりと投出すと、両手で逆に取つて、上へ反せ、膝ぶしからボキリボキリ、ミシリとやる。",
              "citation": {
                "source": "妖魔の辻占",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばミシンにマイクロコンピューターを組み込むとして、それで何ができるかに自分が充分答えられないとしても、考えてみれば当然ではないか。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在のミシンにやらせたいと思ってもできないでいることを一番よく知っているのは、ユーザーでありミシン屋であろう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "突破口となったキャッシュレジスターに続いて、ミシンや編機にマイクロコンピューターが採用され、手の込んだ模様を簡単に縫い込めるタイプがブームを呼んだ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マアともかくも」ト取旁付に懸りは懸ッたが、考えながらするので思の外暇取り、二時頃までかかって漸く旁付終りホッと一息吐いていると、ミシリミシリと梯子段を登る人の跫音がする。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ頃、臺所の後片附けをした妹達は、茶の間へ來て坐つて、手内職にと此頃はじめた絹手袋のミシン縫ひにかかる。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
