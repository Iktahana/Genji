        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "相州さまがその年来の郎従の中で、特に功労のあつたものをこんど侍に取り立てたい、それに就いておゆるしを得たく参上いたしましたと気軽に将軍家へ申し上げたところが、将軍家はにつこりお笑ひになつて、考ヘテミマシタカ「え、何事でございませう。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルヒ、ヤマキチ　ノ　トモダチデ、イチワ　ノ　オオキナ　タカ　ガ、ヤマキチ　ヲ　ヒロイ　ツバサ　ニ　ノセ、ヒコウキ　ノ　ヨウニ　ソラ　ヲ　トンデ、シバラク　タカイ　キ　ノ　ウエデ、ヤスミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ、ウマレテ　ハジメテ　コンナ　メズラシイ　ケシキ　ヲ　ミマシタノデ、フシギ　デ　タマリマセン。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、タカ　ニ、ドウカ　アソコヘ　ツレテ　イッテクレ　ト、タノミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト　モウシマス　ト、サカナタチ　ハ、サモサモ　バカ　ニ　スルヨウニ、ワラッテ　オヨギ　モ　シラナイデ　ウミ　ニ　クルナンテ、キミ　ハ　オオバカサンダ　ト　イッテ　アイテ　ニ　シテ　クレマセンノデ、ヤマキチ　ハ　コンド　ハ　ナミ　ニ　ムカッテ、ボク　ヲ　オヨガセテ　クダサイ　ト　タノミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトシノ七月カラ始メテ画用紙ヲトジテ画帖ヲ作リ、鉛筆デ（モノ）ニ向カッテミマシタ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤガテ　ツヨイ　ヒカリニ　ナレテ　クルト　ナタネノ　花タチハ　アタリヲ　ミマハシテ、木ヤ　ハタケヤ　ミチヤ　イヘヤ　ソラヤ　ミズヲ　ミマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ヨンデ　ミマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニカ　タベサセテ　クダサイ」ト　タノミマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、オテテデ　ミチコサンノ　ネクタイヲ　ツカミマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハ、ソノ　ラツパヲ　ミミニ　アテテ　ミマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヤウサンハ　チヨウド、ロバガ　イツピキ　ホシイト　オモツテ　ヰタ　トコロデシタノデ、アキナヒノ　モツテ　ヰル　カゴヲ　ノゾイテ　ミマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サカナサン、カンザシヲ　ヒロツテ　クダサイ」ト　ヲンナノ　コガ　サカナニ　タノミマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒトツ　アタマニ　サシテ　ミヨウ」ト　イツテ、カンザシヲ　サシテ　ミマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソレデハ、オテラノ　コゾウサンニ　バケテ　ミヨツト」　コドモノ　タヌキハ　コゾウサンニ　バケテ　ミマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、洋服ヤヘ、真赤ナ洋服ヲタノミマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　シカタガナクテ、汽車ノナカノアミダナニモグリコミマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラブラドンドン　トユラレテカラダヂウガイタミマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、オバアサンハプリプリシテ、マドノソトヲミマシタラ、キンジヨノミケ子トトラ三ガ、ランニングヲシテヰマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二ミミヅクサン　ハオイケ　ノ　ミヅ　ヲノミマシタ。",
              "citation": {
                "source": "ミミヅクサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ジロウハ　ウミニ　ハイツテ　ブリキノバケツニ　ミヅヲ一パイ　クミマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミミヲ　クワエテ　ヒツパツタノデ、チビスケハ　シカタナク　クビヲアゲテ、ジブンノカゲヲ　ミマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニ、オ母サンハネムクナツタノデ、パラソルノ下デ、グツスリネムリコミマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝学校ヘ行ク時ニゲンカンヘ出テミマシタラ、ウサギノミミガ、一ツダケピント立ツテヰテ、一ツハヨコニタオレテヰマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その四弘サン学校ハイツカラ休ミデスカ、モウ試験ハ済ミマシタカ、僕ハチョウド君ノ学校ガ休ミノ時分ニソチラヘ行キマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ベンキョウスミマシタのパパ」はママや書生達と共に子供等相手に唱歌を歌ったり、鬼ごっこしたり、ヒライタヒライタの遊戯をしてくれました。",
              "citation": {
                "source": "父八雲を語る",
                "author": "稲垣巖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
