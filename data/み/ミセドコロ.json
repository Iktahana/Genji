    "definitions": [
      {
        "index": 1,
        "gloss": "opportunity to show off",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「試合の終盤、一点差を追いかける場面こそが、エースピッチャーとしての見せ所だ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「パーティーの最後に披露するマジックは、一ヶ月間練習してきた彼の一番の見せ所だ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この難しい局面をどう切り抜けるか、リーダーとしての手腕の見せ所と言えるだろう。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そこが何より、この場面仕掛の見せ所だったのである。",
              "citation": {
                "source": "オフェリヤ殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ急げ、男の見せ所だ」　マーシが踵を返して、テントを去った。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめは五か一〇くらいで、それは集金の操作でうまくまじくなったが、一〇が一五となり一八となるうち、ますます栄子に熱があがり、ここが男のみせどころだと、すっかり太っ腹になってしまった。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにがさて御本城の御奉行閣下の臨席裁判だ、兼尾殿はこれぞわが腕のみせどころと、能力いっぱいぎりぎりの意気込みで主訟状を読み上げた。",
              "citation": {
                "source": "艶妖記",
                "author": "忍術千一夜　第一話",
                "note": "青空文庫"
              }
            },
            {
              "text": "弓と矢を持って戻ってきた三之丞、「五年来修行の腕のみせどころだぞ、ぬかるなよ」伯父が念を押すのをうしろに聞きながら、足場を計って弓を構えた。",
              "citation": {
                "source": "備前名弓伝",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」料理人の泣言４・13（夕）　大隈伯の台所に長く働いてゐる或る料理人の話によると、伯爵家の台所はかなり贅沢なものだが、それとは打つて変つて伯自身のお膳立は伯爵夫人のお心添で滋養本位の柔い物づくめなので頓と腕の見せどころが無いさうだ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、分析家の腕の見せどころは、単なる法則の限界を越えたところにあるのだ。",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "このへんが、操縦士のうでまえの見せどころであります。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、前田マサ子がここを見せどころと少女歌劇ばりの作り声を出す。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "事がらそのものはなるほど秘密に属するもののようだが、尋常会話の体で語り出したところに、秘密の時効があり、はらの見せどころがあるのではないかと思われます。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからが関守氏とお角さんの、本当の腕の見せどころと言わなければなりません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の見せどころといふ奴だ。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ吊りましょう」　ここが忠義の見せどころと、スッと圓太郎は立ち上がった。",
              "citation": {
                "source": "圓太郎馬車",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "濡れて重さのある洗濯物を満載した竿を、三本から四本、同時に支えてびくともしない横木を、支柱にどのように取りつけるかが、知恵のしぼりどころであり腕の見せどころでもあった。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしここが大和魂の見せどころだと思ってがまんしている。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……これがせめて戦国の世なら、おれたちの腕の見せどころもあるのだが、こんな時代ではどうしようもない、まあ眼をつむって我慢するんだ」　そして幕張の外へ出てしまった。",
              "citation": {
                "source": "足軽奉公",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここが災害記者の腕の見せどころ、機会を逃さない。",
              "citation": {
                "source": "四日闇夜",
                "author": "THE FOUR DAYS' NIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらなどもだん／＼はげしくなつて来ましたが、万一敵が上つてゞも来たら、その時こそわれ／＼の力の見せどころです。",
              "citation": {
                "source": "島の便り",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
