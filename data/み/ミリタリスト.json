        "examples": {
          "standard": [
            {
              "text": "彼は生粋のミリタリストで、軍事的な解決策を常に優先する傾向がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その国の指導者は、強硬なミリタリストとして知られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この本は、20世紀初頭のヨーロッパにおけるミリタリストの台頭を描いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "いくらミリタリストのチャキチャキでも、むちゃくちゃに百姓を殺す訳にや行かなかった。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランスに電報を打ち、クラルテの仲間は、決してアンリー・バルビュスの想像するように十人ぼっちの者ではないし、此処に集ったアンティ・ミリタリストは今後も団結して仕事に当り、今夕、万堂一致で、再びルール占領に反対の意を表する、と云って遣ろうと発議する。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、一朝事が目前に迫り、前田駸一郎が熱を以て説いたように、近い将来に於て、日米が衝突でもすることが起ったら、彼等は、どんな態度を以て、アンティ・ミリタリストとしての正義を体顕するだろう。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
