          "literary": [
            {
              "text": "「法華経方便品」によれば、「十方仏上ノ中ニハ、唯一乗ノ法ノミアリテ、二モ無ク亦三モ無シ」とある。",
              "citation": {
                "source": "学生と先哲",
                "author": "――予言僧日蓮――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分犬の仔のような心持で、うれしく、しかし恋病にかかって Post へゆき、　テガミアリガトウ　タスカッタ　モヤモゲンキダセ　と打った。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォーカス番号　番号　姓名　　　人気１　　　　　　　１　　白太郎　　入着ノ見込ミアリ２　　　　　　　２　　田川博一　対抗。",
              "citation": {
                "source": "安吾巷談",
                "author": "今日われ競輪す",
                "note": "青空文庫"
              }
            },
            {
              "text": "（８）原文ニハ「自云」トノミアリテ、何人ノ言タルヲ明言セザレドモ、家ノ主人ノ語ト見ルベキヲ以テ「あるじ」ヲ加ヘタリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "精励勉強ノミアリテ逸予｜休竭ナケレバ精神身体共ニ頽廃スベシ」。",
              "citation": {
                "source": "呉秀三先生",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
