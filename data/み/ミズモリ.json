        "examples": {
          "standard": [
            {
              "text": "壁の水平を測るために、水盛りを使った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大工さんは、水盛りで正確に基礎を築いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "水盛りは、建設現場で欠かせない道具だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "寺にありて、僧の歌ふとき、提香爐を打ち振りても、街にありて、叫ぶ賈人、轟く車の間に立ちても、聖母の像と靈水盛りたる瓶の下なる、小き臥床の中にありても、たゞ詩をおもふより外あらざりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
