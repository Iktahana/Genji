          "literary": [
            {
              "text": "ミーラヤ、ラドナーヤとでも囀っているのか。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "水浅黄の服で、オカッパの頭で、車窓から片手を出し、いつまでも扇でバイバイをして居る姿、小さく、ミーラヤ〔かわいい〕に見えた。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はミーラヤ〔かわいい〕だ。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "モヤー、ミーラヤ、ドロガーヤ！",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            }
