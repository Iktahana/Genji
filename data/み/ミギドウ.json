        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "右胴へ来た奴をチャリンと鉄砲の砲口で弾いたが、その切尖の欠けた刀を持ち直さぬうちに、十手を鍔元に引っかけて巻き落いた。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍔ぜり合いは、動の極致の静……こうなると、思いきり敵に押しをくれて、刀を返しざま、身を低めて右胴を斬りかえすか。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちが押せば向うも押し返す、この押し返して来たところを力を抜き、敵の手の伸びきったのに乗じて、やはり刀をかえして右胴を頂戴するか。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "へたばったままの横手払い、幹之介の払った太刀が極まり、右胴を深く割り付けられた。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "真向から右胴へ、大きく跳躍し、くの字に身を沈めて。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "真向へ来るとみえた刀が右胴へ切り返されたとき、六郎兵衛はすっと爪先だちになり、刀を右に振りざま横へとんだ。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第一部",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
