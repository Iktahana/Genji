[
  {
    "uuid": "9213a6ad-ef98-571a-87e5-e047f0a9eadf",
    "entry": "身びいき",
    "reading": {
      "primary": "みびいき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "favoritism",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は自分の教え子に対して、どうしても身びいきな判定をしてしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "親の身びいき目線かもしれないが、うちの子が一番輝いて見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "監督が特定の選手を身びいきしていると、チーム内に不満が溜まる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかも、それはほかの土地よりも高かったのだと言えば、余りに身びいきになりすぎるかも知れないが、すくなくとも私は大阪は香りの高い、じっくりと味うべき珈琲だった筈だと、信じている。",
              "citation": {
                "source": "大阪の憂鬱",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "厩舎に依りて、強がりあり弱気あり、身びいきあり、謙遜あり、取捨選択に、自己の鑑定を働かすに非ざれば、厩舎の情報など聞かざるに如かず。",
              "citation": {
                "source": "我が馬券哲学",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は、上方勢の中では、鑓取る者とも云われるが、徳川殿の中に加わりては、足手｜纏いの弱兵にて一方の役に立ったとも覚えず、自分の勲功を御賞めになるなど、身びいきと云うもので、三河の人の思わむことも恥し」と。",
              "citation": {
                "source": "姉川合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女とＳ街の街燈の灯の下を歩るきました、　見れば見るほど彼女は変化してゐるのです、例へば悪魔が神に変つたやうにです、以前の彼女は『悪い奴』でした、私は男だから男の立場に立つて身びいきにさういひたいのです。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄の理会のない身びいきも、結句、あり難く思はれて来る。",
              "citation": {
                "source": "古代研究　追ひ書き",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この身びいきからして突然ひき起された克明な興味を以て、彼は房一を、その中に在る医者といふものを熱心に眺めた。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "はたして自分の他にまだそんな者があって、今その世話でこうなっているとすれば、どう、自分の身びいきという立場を離れて考えても不埒である。",
              "citation": {
                "source": "霜凍る宵",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "この双方の身びいきは、日一日と烈しくなっていって、とうとうしまいに、「よし。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうなると、身びいきをしてくれたここの番頭さんがいっそ怨めしかった。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "或はそれは身びいきに過ぎた解説という人があるかもしれぬが、その前後の事情を考えても今以て私は斯く信じて居る。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "親兄弟が彼をいくらほめても、誰もそれを身びいきだと笑うものがない。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、多少の身びいきや偏見がまじっていたとしても、自分というもののほんとうの姿を、だいたいにおいて正しく見｜究めることが出来た。",
              "citation": {
                "source": "次郎物語",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは一学の身びいきのみではありますまい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉親の身びいきというものか、お里のことばには明らかに、お蔦の行状はみんな自分のせいかのように恨んでいる気持がみえる。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてもう聟ときまった藤吉郎へ、無意識に身びいきの眼がかかっていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
