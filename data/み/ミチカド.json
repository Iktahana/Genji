        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自転車屋の店がみえなくなった道角でふたりはややほっとした。",
              "citation": {
                "source": "空気ポンプ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思っているところへ、その道角から、太郎左衛門がひょっこりとすがたをあらわしたのである。",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの松の木の下へ来る」　斜めにうねった道角に、二抱えもある大松の、その木の下をただ一人、次第に冴えた夕月の光を浴びながら、野中に咲いた一｜本の白菊のように、静かに歩みを運んで来るほのかな姿。",
              "citation": {
                "source": "おせん",
                "author": "邦枝完二",
                "note": "青空文庫"
              }
            },
            {
              "text": "あわてた巡査、佩剣を抱えて道角でグルグル二、三回廻った末、左手への道を走って消える。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまでは一人も客は無かつたのが、此のあたりで前方の道角に立つて馬車に向つて手を上げてゐる中年の男。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見送れぬことを残念がって、ミネが道角を曲るまで、閑子は垣根のそとに立っていて、ふり返る度に手をふった。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "春日山城のお濠と、大手との道角に、この附近の二之木戸三之木戸などを守っている番士衆の溜りがあった。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "職業は、南京路角、百貨店｜泰興公司の女店員、支配人デー・ダブリュ・クロフォードに愛さる。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "去って行く男の俥上の後姿が、二三丁離れた路角の大欅の下に見えた。",
              "citation": {
                "source": "窓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "目標東方上空の射光内の重爆、高度千二百、始め、航速十秒、航路角五百、五発……」といふやうな文句が、僕のノートに書きつけられた。",
              "citation": {
                "source": "空襲ドラマ",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「高度二千」「始め」「航速十五秒」「航路角六百」「六発」（砲声六発）喊声とも悲鳴ともつかぬどよめき。",
              "citation": {
                "source": "空の悪魔（ラヂオ・ドラマ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は路角に躄り出て、じっと耳を澄まして聴いていると何だかざわざわしているようだ。",
              "citation": {
                "source": "阿Ｑ正伝",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "郊外の小ぢんまりした路角の家の茶の間で、赤ん坊はうつら／＼眠かゝつてゐる。",
              "citation": {
                "source": "姉弟と新聞配達",
                "author": "犬養健",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒い帽子はさういふ彼を揶揄するやうに、路角まで走つてゐる。",
              "citation": {
                "source": "姉弟と新聞配達",
                "author": "犬養健",
                "note": "青空文庫"
              }
            },
            {
              "text": "……二つほど路角を曲つた時、彼は意外なものを見た。",
              "citation": {
                "source": "姉弟と新聞配達",
                "author": "犬養健",
                "note": "青空文庫"
              }
            },
            {
              "text": "……さて路角の彼の家では、赤坊は眠つて二階につれて行かれた。",
              "citation": {
                "source": "姉弟と新聞配達",
                "author": "犬養健",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
