[
  {
    "uuid": "0573cc94-d28f-5e3c-ab2b-8eb8ac30b504",
    "entry": "見晴るかす",
    "reading": {
      "primary": "みはるかす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
      ],
