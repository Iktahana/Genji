[
  {
    "uuid": "0cdce853-0091-5c84-b444-122e97859db8",
    "entry": "弥撒",
    "reading": {
      "primary": "ミサ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
