        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ホテ・グリで、如月敏と食事、ミネストロン、カネロニ、ポークチャップで、うまかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、ミネストロンと犢の白ソース煮。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スープは、ミネストロン、飯粒がフンダンに入ってゝ、竹川の曰く、「お粥さんやネ」全く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "終って、ホテルニューグリルへ、樋口と吉本と提携興行の件につき語りつゝ、ミネストロンとハムエグス、メリンゲパイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミネストロンにオルドヴル、チキンパイ、みんなまづかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、ミネストロン、チキンソティー、アイスクリーム。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、ミネストロン、カレーライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴルの肉パイはうまかったが、ミネストロンから次がカレーライスなのは、うんざりした。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事、ミネストロン、フィレソール、鳥のプリンセスにペストリー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミネストロンとチキン・ヌードル。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミネストロンにポークソーセージ、ラヴィオリと食べてコーヒーとプディング。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ出てフィナレの歌をかへるので稽古をし、鈴木静一・友田・穂積等とホテ・グリで食事、ミネストロン、フィレソール、ムサッカ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はミネストロンに、スクラムルエグ・ベーコン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スープ、これがミネストロン風。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
