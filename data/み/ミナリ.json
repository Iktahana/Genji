  {
    "uuid": "061506d7-0d1a-5b2b-8322-7868bf59bd90",
    "entry": "ミナリ",
    "reading": {
      "primary": "みなり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ことにわれわれのなかに一人アメリカのマサチューセッツ州マウント・ホリヨーク・セミナリーという学校へ行って卒業してきた方がおりますが、この女学校は古い女学校であります。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもマウント・ホリヨーク・セミナリーという女学校は非常な勢力をもって非常な事業を世界になした女学校であります。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の人の嫌がることをなせ　これがマウント・ホリヨーク・セミナリーの立った土台石であります。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カミナリ昼頃から雨雲が一つ、空に浮んでゐるが動かない。",
              "citation": {
                "source": "小熊秀雄全集-13",
                "author": "詩集（12）その他の詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、カミナリの激しさに命が惜しくてならない――といつたあわてぶりで逃げまはる群衆をみて、思はず或る一つのことを思ひ出して微笑が湧く。",
              "citation": {
                "source": "小熊秀雄全集-13",
                "author": "詩集（12）その他の詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "大生産業ノ徴集ニ於テ其等ヲ有シ、更ニ土地徴集ニ於テモ各所ニ其等ヲ有スル大富豪等ハ、要スルニ只一百萬圓ヲ所有シ得ルノミナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "でもハイカラな浜でなくて幸せさ、若し、オダハラでなかつたら、あんなミナリで泳いでゐたら、とうに、つかまつてしまつたらうよ。",
              "citation": {
                "source": "秋が深い頃だ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいはマタ茶道ヲ千宗佐ニ受ケテ漆器ノ描金ニ妙ヲ得｜硯箱茶器ノ製作ニ巧ミナリとあるが如き少しも意を解せず。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレト共ニ『パチノ』ノ墓穴ニ関スル重要書類ハ紛失シ、只本国ヘ送リタル二三ノ通信ト『パチノ』ノ墓穴｜廓内ノ建築図トヲ残スノミナリ――というのです。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "大分臼杵という町は、昔大友宗麟の城下で、切支丹渡来時代、セミナリオなどあったという古い処だが、そこに、野上彌生子さんの生家が在る。",
              "citation": {
                "source": "九州の東海岸",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "臭剥きいて、ミミナリよくなる。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "余其家ヲ訪フ一二次、我ガ古器ヨリ勾玉管玉ノ類迄驚クバカリ多ク貯蔵シ、且ツ皆貴重ス可キノ品ノミナリ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼一人ノ奢ハ千万人ノ羨ミナリ。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから反封建的なノミナリズム的な経験論的機械論（之が近世ブルジョアジーの本来の世界観であった）が、絶対君主主義などと理論的に結合することも強ち不可能ではなかったので、恰もホッブズの倫理思想は、そうした場合に相当するものに他ならなかったわけだ。",
              "citation": {
                "source": "道徳の観念",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾々はこうした場合、ノミナリズムの真理を忘れてはならないだろう。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "横浜のセミナリイの恩師の悲壮な献身的な最后もその一つだつた。",
              "citation": {
                "source": "水と砂",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大巻先生じゃありませんか」　振向いてみると、五十がらみの宗匠然とした渋いミナリの人物。",
              "citation": {
                "source": "神サマを生んだ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、この女のミナリは上等のようだ。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、しかるべきミナリ、四十ぐらいの苦味走った伊達男である。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "リュウとした凄いようなミナリの女が、ドタ靴の男のなけなしの給料を貢がせるんだから」　そして、又、こうつけたした。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼんやり考えごとをするとき、タバコふかすのよ」「一本おくれ」「あんた、立派なミナリしてるけど、お金ないのね。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも、ミナリのパリッとしたのは、変な世渡りしてるらしいわね」　こう言ったが、咎める表情が浮かんだ様子も見えない。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "善鬼はカミナリ大臣とよばれて、癇癪もちで有名であったが、ここぞカンニンのしどころ、蝋マッチに一文字をひいたハゲ頭に湯気もたたせず、ニコリニコリと笑ってみせたという。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その一　舞踏会殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "まア人間は普通カミナリがキライのようだが、特別キライという人種があって、私の知人にもカミナリがキライで疎開このかた伊東の地に住みついてしまった人がある。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊東は年に四、五回、遠雷がかすかにカミナリのマネをしてみせる程度で、片道三時間の通勤は不便だが、ヘソをぬかれる心配のない平和に替えられないと彼は云っている。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど東京はカミナリの多いところだ、私は矢口の渡しに住んでいたころ、処によると物凄いカミナリになやまされたものだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
