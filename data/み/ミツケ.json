        "examples": {
          "standard": [
            {
              "text": "この家具は、天板の見付が薄く、全体的にすっきりとした印象を与える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ドアの見付を揃えることで、統一感のある美しい仕上がりになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は、木材の見付を調整するのに、熟練した技術を要すると語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
