        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ここの俳優がミチキン・ツァーリストヴォをやって下手なわけ判った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "次がその劉の室へカーテンで仕切りをこさえて一緒に住んでる若い靴職のミチキンと、女房のアグーシャだ。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから靴職ミチキンや信吉みたいな二重の間借人が出来る。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチキンは黙ったまんま、休み日の愉しさを一漕ぎごとに味ってるように、力を入れて漕いでる。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はミチキンにとって特別な日だ。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "信吉、アンナ、アグーシャはミチキンのお祝によばれてモスクワ河へ遊びに来ているというわけなんだ。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前だってもうおふくろの裾へつかまって歩く坊やじゃないんだもの」　ミチキンがあっち向いて漕ぎながら真面目な声できいた。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
