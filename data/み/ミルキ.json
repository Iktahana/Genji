        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鏡面に漣がたったかと思うと、大統領ミルキの髭の中にうずもれた顔が浮きあがった。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミルキ国万歳」　と博士コハクは挨拶をした。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おお博士、すこし内談をしたい」　ミルキは髭をうごかして物をいった。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "目下のところ音楽浴には国楽第39番が使われているがこれは博士コハクが大統領ミルキの命令により改良に改良を加えた国楽であって、所謂第39型標準人間を作るに適した音楽であった。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "国一番の重罪人を試験台として試みたところ、たちまちミルキの希望どおりの模範人間に改造できたものだから、腰をぬかさんばかりに愕いたのも無理はない。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前にはミルキ閣下ご自慢の音楽浴もあまり効いていないらしいネ」「うむ。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "見る目嗅ぐ鼻を持ったミルキ閣下に一杯喰わせて得々としている男が、彼の親しい友人の中にいたのである。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼もまたポールと同じく、ミルキ閣下を冒涜する一人であると思った。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "表札には「ミルキ夫人」と記されてあった。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「令夫人に忠誠を誓います」　ミルキ夫人はホホと笑って、博士を奥の一室に導いた。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミルキ夫人は博士を向い合った椅子に招じた。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミルキ閣下においても、殊の外の恐悦です。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "賢明なる貴下がそれに気がついていないはずはないのです」「ミルキ夫人よ。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミルキ閣下などはそばへ寄れないくらいの偉人なんです」「お言葉が過ぎるようにぞんじます。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この国をミルキが支配するよりも、貴下が支配するほうがどのくらいいいかしれないのです。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミルキ一の美人であるわたしが国民の前でたった一言唇を開けば、国民はわたしの言うとおりになります。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあわたしを早く抱きしめて下さい」　ミルキ夫人は爬虫類を思わせるようなしなやかな身体をくねらせて椅子から立ち上った。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、ミルキ夫人は博士の膝の上で、愕きの声をあげた。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人はミルキ閣下、一人は針金毛の女大臣アサリ女史だった。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミルキ夫人は、それと見るより早く、博士の膝から跳ね下りた。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミルキ閣下は、髭の中から大きな両眼をむきだし、鉄丸のような拳を振り上げながら、「どうも結構な場面を拝見するものだ。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それッ」　ミルキ閣下は言い捨てるなり、アサリ女史をしたがえ外へ飛びだすなり扉をしめた。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "このときまで壁を背にして傍観していた美しきミルキ夫人は、この様子に愕いて自分もともに室外へ飛びだそうとした。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "閣下それではお話が違うではありませんか」　ミルキ夫人は狂人のようになって扉をドンドンと叩いた。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方の壁付にミルキ夫人が苦悶している。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレビ受影機をジッと覗きこんでいるのはミルキ閣下と女大臣アサリ女史だった。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミルキ閣下と針金毛のアサリ女史は目と目とを見合わせた。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人とも死んでしまうことは、もう明らかでございますからネ」「きっと死ねるかネ、アサリ女史」「問題はありませんわ」　そういっているとき、ミルキ夫人の室から轟然たる一大音響が聞えてきた。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あッ」とミルキ閣下は耳に蓋をしながら、「あの物音は一体何が起ったんだろう」「閣下、早く行って見ましょう。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミルキ夫人と博士コハクとはかくしてアロアア区の煙と化したものと見られた。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
