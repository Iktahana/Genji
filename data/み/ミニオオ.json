          "literary": [
            {
              "text": "ジユウル・ミニオオは銀行業者にして、ドロレエヌ町なるミニオオ父子商会の名前主なり。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "老ミニオオの方なり。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アアドルフ・ルボンはミニオオ父子商会の雇人にて、その申立次の如し。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "然も残つてゐた金貨は夫人がミニオオ銀行から引き出して来た金の全額で、それが袋に入れたまゝ床の上にあつたのだ。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            }
          ]
        }
