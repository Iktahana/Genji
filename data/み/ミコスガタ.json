          "literary": [
            {
              "text": "「巫女姿の一人の老婆……」「巫女姿の一人の老婆？",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "巫女姿の女が弦四郎の横手を辷るようにして歩いて行く。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "真先に立ったのは巫女姿のお久美で、点火した龕を捧げてい、御弊を片手に持っている。",
              "citation": {
                "source": "前記天満焼",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "巫女姿の老婆であった。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中に雑って煽動しているのは、巫女姿の鬼火の姥であった。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
