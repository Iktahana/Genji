          "literary": [
            {
              "text": "適度に乾燥したものはさらに二つに引裂かれて身欠き鰊となる。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「Ｓ村の小作が、身欠鰊みたいに、ズラリ並んで首でもつる時来るべ。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "俳優の場合には、それ自身欠点ではないというような性質が、どうかすると、その生活を乱すのですが、これもその例の一つです。",
              "citation": {
                "source": "俳優倫理",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
