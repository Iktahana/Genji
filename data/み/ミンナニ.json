              "text": "トムハ　ミンナニ　アヤマリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "家庭ノ費用ハ出来ルダケ切リ詰メテ女中イジメヲシ、残リハ全部自分ノ懐ヘ取リ込ムラシイ、ミンナニ窮屈ナ思イヲサセテ自分ダケドンナ贅沢ヲシテルカ知レタモンジャナイト、婆サンハ云ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナニ、シラセナサイ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミナラ、オレノイウコトヲ、ミンナニ、ツタエテクレルダロ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナニ、ソウイッテオケ、ウミノソコノ、マモノガ、イヨイヨ、ニッポンニ、ジョウリクシタト、ソウイッテオケ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
