        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ミミッチクってつきあってらんねえよ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビオメカニズム〔メイエルホリドが唱えた生物力学的演技法〕によって機械の動き、「ベルト」「車輪」など生しもするが大体はミミック〔顔面の作為的表情〕だ、普通の。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに「身振り」（ミミック）が加はつて複雑味を増し、「主題」が「筋」さては「物語」に発展して益々完全な心理的要素となるのであります。",
              "citation": {
                "source": "演劇一般講話",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は内々大喜び、よくぞお気がつかれた、というところであるが、それでは大人物らしくないものだから、イヤ、人間は、図太いということゝ、善良さとは無関係なものですよ、変に小心ヨクヨクたる奴が内々はフテクサレのミミッチイ嘘つきのホラ吹きなどゝは、よくある奴ですよ、などゝ言う。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで私は大浦家を訪れて、「あなた方御兄弟もミミッチイ悪党じゃありませんか。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな宿泊料を小娘に押しつけようなんて、ケチもいゝけれど、あんまりミミッチイ話じゃありませんか。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいつを捨てゝよその酒場で働いて男を養ふなんてえミミッチイ思想は、ミーチャンハーチャンにはよろしいけれども、最上清人の女房たるものに、なんですか、あなた。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "反抗などということはミミッちくて、私はきらいなのだ。",
              "citation": {
                "source": "青鬼の褌を洗う女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンマの代りというのが、ミミッチイですよ。",
              "citation": {
                "source": "神サマを生んだ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "説教強盗などのように、強盗強姦などゝ刃物三昧や猫ナデ声のミミッチイ悪どさもないし、世帯やつれしたところもない。",
              "citation": {
                "source": "安吾巷談",
                "author": "湯の町エレジー",
                "note": "青空文庫"
              }
            },
            {
              "text": "文人らしい趣きがどこにも見当らないミミッチイ幻覚である。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですが、私自身はそんなミミッチイ稼ぎに興味なかったのよ」「それはお察しいたしております。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ほかでもありませんがね、あんたが可愛くって可愛くってならねえあっしの気持にして見りゃ、ねえカテリーナ・イリヴォーヴナ、あんたに正真正銘の奥様ぐらしをこそして貰いたいんで、これまでみたいなミミッチイ暮らしなんぞ、まっぴら御免でさあ」と、セルゲイ・フィリップィチは答えた。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
