        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ミミヲ　クワエテ　ヒツパツタノデ、チビスケハ　シカタナク　クビヲアゲテ、ジブンノカゲヲ　ミマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし隱身也の如きは、ミミヲカクシタマヒキの訓と、カクリミニマシキの訓とが對立しており、これは讀み方によつて意味が相違してくるので、どちらでもよいというわけにはゆかない。",
              "citation": {
                "source": "古事記",
                "author": "解説",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハネエチヤンニ、「ネエチヤン、アノウサギノミミヲ立テテ下サイ」トイヒマシタノデ、ネエチヤンハ足デウサギノミミヲツマンデ、立テテオヤリニナリマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪子は慌てて、「ネエチヤンハ足デウサギノミミヲ………」とある「足デ」の二字を鉛筆で消した。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――………ネエチヤンモウサギノミミヲツマンデ、立テテオヤリニナリマシタガ、ネエチヤンガソノミミヲオハナシニナルト、マタパタリトタフレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
