[
  {
    "uuid": "39637622-3047-5ece-b4ab-aa10babc1531",
    "entry": "身分",
    "reading": {
      "primary": "みぶん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "(social) standing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "江戸時代、武士と町人の間には厳格な身分の差が存在していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「私のような身分の者が、そのような大役を引き受けてよいのでしょうか」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は自分の身分を隠して、一般市民の中に混じって生活していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "結構な身分でいて、道楽で書くくらいなら、僕ははじめから何も書きはせん。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに、草の庵とはいへ、まあ、結構な身分と申さざるを得ないであらう。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして、そんな結構な身分の者に限つて、あまりひとの役に立たぬものである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の自分から見ると此等の畫家は實に羨ましい有福な身分だと思ふ。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親も気付いて相手の身分を図り近頃はぐずぐずいう。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は寝具だけは身分不相応のものを作っていて、羽根蒲団など、自分で鳥屋から羽根を買って来て器用に拵えていた。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "星になるには、それ相応の身分でなくちゃいかん。",
              "citation": {
                "source": "よだかの星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一例とも見られるのは、『諸国咄』の中の「忍び扇の長歌」に、ある高貴な姫君と身分の低い男との恋愛事件が暴露して男は即座に成敗され、姫には自害を勧めると、姫は断然その勧告をはねつけて一流の「不義論」を陳述したという話がある。",
              "citation": {
                "source": "西鶴と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、自分はここではボーイをしているが日本へ帰れば相当な家もあって、相当な顔のある身分であると云ってひどく腹を立てた。",
              "citation": {
                "source": "チューインガム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃本郷の或る家に間借りして居た彼は、三度の食事にも缺乏するほどの貧しい身分で、金一錢の餘裕を見つけ、どこかで一本の西洋蝋燭を買つて來る。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　七五郎、　「――手や爪を綺麗にして毎晩酒の一本も呑める身分になってみてえ……」　お民、　「お酒だったの。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その杯を持つた手を出すにも、一人々々身分相応に控目にして出すのである。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "身分のある人びとには、語られてゐることがすつかり分かつた。",
              "citation": {
                "source": "旗手クリストフ・リルケ抄",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、彼等は遊んでいられる身分ではない。",
              "citation": {
                "source": "選挙漫談",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "石井翁は一年前に、ある官職をやめて恩給三百円をもらう身分になった。",
              "citation": {
                "source": "二老人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまさらわしが隠居仕事で候のと言って、腰弁当で会社にせよ役所にせよ病院の会計にせよ、五円十円とかせいでみてどうする、わしは長年のお務めを終えて、やれやれ御苦労であったと恩給をいただく身分になったのだ。",
              "citation": {
                "source": "二老人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう行きがかりで晩年自分が某研究所に入って自由に好きな研究の出来るという幸福な身分になったとき、別にわざわざ選ぶともなく自然に選んだ研究題目の一つは空中放電現象のそれであった。",
              "citation": {
                "source": "家庭の人へ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "宇三郎の白状で、鯉を食った者はみんな判っているんですが、身分のある人は迂濶に詮議も出来ず、大町人は金を使って内々に運動したのでしょう、その方の詮議はすべて有耶無耶になってしまいました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "むらさき鯉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれの身分は知らねえでも、熊の野郎が湯屋のほかに商売をもっていることは知っているだろう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "「蚊帳のなかを見ても宜しゅうございますか」「どうぞお検めください」　半七の身分を知っている家主は異議なく承知した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お化け師匠",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はきのうの朝以来、半七の身分を大抵察しているらしかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お化け師匠",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｋのをぢさんも或大名屋敷の門内に住んでゐたが、おそらく其の昔は家老とか用人とかいふ身分の人の住居であつたらう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらは一種のかどわかしで、身分のありそうな武士や女に化けて来て、容貌のいい娘をさらって行ったに相違ない、と半七は鑑定した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局、後の方の説が勢力を占めて、その役目を云いつけられた武士どもは、身分柄にもあるまじき拐引同様の所行をくり返すことになったのである。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜすぐ自身番へでも連れて行かないんですえ」　かれらは半七の顔を識らなかったが、それでも庄太の連れであるので、薄々はその身分を覚ったらしく、余計な世話を焼くなというような反抗の顔色も見せなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鬼娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺達はすきこのんで、あいつ等をやっつける身分かい！",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは畜生同然の身分でございますが、私のようなものにさえまことの力はこのようにおおきくはたらきます」「ではそのまことの力とはどんなものかおれのまえで話してみよ」「陛下よ。",
              "citation": {
                "source": "手紙　二",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この役人は、たいそう、かくしきばった男で、みぶんの下のものが、おそるおそるはなしかけたり、または、ものでもたずねても、ただ「ペ」とこたえるだけでした。",
              "citation": {
                "source": "小夜啼鳥",
                "author": "NATTERGALEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶっきょうの　もとを　ひらかれた　おしゃかさまは　おうじの　みぶんを　すてて、山に　はいり、こじきのような　くらしを　しながら、だれにでも　おんなじに　おきょうを　よんで　くれました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "みぶんのちがいと申しましても、ういてんぺんは世のつねのこと、とり分けえいこせいすいのはげしいのは戦国のならわしでござります。",
              "citation": {
                "source": "盲目物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
