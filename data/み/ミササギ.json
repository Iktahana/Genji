        "examples": {
          "standard": [
            {
              "text": "遠くに見える陵は、あの山の向こう側だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この辺りには、いくつかの大きな陵がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の人は、高い陵に神の存在を感じた。",
              "citation": {
