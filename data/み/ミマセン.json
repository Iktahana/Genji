          "literary": [
            {
              "text": "あなたたばこノミマセンカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　ウチニ　オバサンハ　スツカリ　ウバグルマノ　ナカヲ　カタヅケテ、「スミマセンデシタ、ホントウニ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ私ハ、ドナタ様モ怨ミマセン。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネ、オクレテ、スミマセン。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントニ、ドウモ、オサワガセシテスミマセンデシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「スミマセン」　先生は必死に叫んだ。",
              "citation": {
                "source": "遺恨",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "国民酒場のオヤジに向って、旦那、スミマセンガ、モウ一杯ナントカ、と頼んでいるのはオ客の方で、ダメだよ、ウルセエナ、と言っているのはオヤジの方なのである。",
              "citation": {
                "source": "敬語論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずいぶん、侮辱じゃないの」「オイ、オイ、スミマセン、アナタ。",
              "citation": {
                "source": "カストリ社事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイスミマセン」「今朝オレが帰る時にマニ教の内務大臣から話があって、明暗荘に秘書の者がおるから伝言せよと言うのだな。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔をあからめてごまかす代りに、せめて、マキゾエにしてスミマセン、ぐらいの口上でも述べたら、どう？",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙な処へ気焔を吐き散して相スミマセン。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「二萬五千圓アル、昨日ノハンドバッグヲ買ッタライヽ」「ドウモ済ミマセン」颯子ハ急イデブラウスノ内側ヘ札束ヲ放リ込ム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "魯迅さんの最後の手紙は記念館にありますが、「老板几下、意外ナ事デ夜中カラ又喘息ガハジマツタ、ダカラ、十時頃ノ約束ガモウ出来ナイカラ甚ダ済ミマセン。",
              "citation": {
                "source": "魯迅さん",
                "author": "内山完造",
                "note": "青空文庫"
              }
            }
          ]
        }
