          "literary": [
            {
              "text": "水部の線宮沢賢治きみがおもかげうかべんと夜を仰げばこのまひる蝋紙に描きし北上の水線青くひかるなれ竜や棲みしと伝へたるこのこもりぬの辺を来れば夜ぞらに泛ぶ水線の火花となりて青々と散る",
              "citation": {
                "source": "水部の線",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "穴の底は、一段と闇が濃く、気のせいか、轟々と水音のこもって聞こえるのは、いよいよ三方子川の底が抜けて、地下室全体、水部屋になっているのか……。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンテナをやききった怪力線は、こんどは目標をかえて、駆逐艦の吃水部をねらった。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "方々への航海中に、貝殻の厚い層が喫水部に付着して、速力の半ばを減じていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその掃除のために喫水部の釘が損じていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二日午前十時十五分赤水部落の直上海拔約三百五十米突乃至四百米突の谷間（噴火口？",
              "citation": {
                "source": "櫻島噴火の概況",
                "author": "石川成章",
                "note": "青空文庫"
              }
            }
          ]
        }
