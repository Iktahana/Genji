    },
    "definitions": [
      {
        "index": 1,
        "gloss": "civil affairs",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "貸したお金が返ってこないため、専門家に相談して民事訴訟の手続きを取ることに決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "警察に相談したが、家族間の金銭トラブルは民事不介入なので介入できないと言われてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "民事裁判は刑事裁判とは異なり、原告と被告の間で和解が成立して解決することも多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "親類に民事上の訴訟問題でも起りかかった場合に、われわれはある具体的の法律上の知識の概要を得ておきたくなる。",
              "citation": {
                "source": "夏",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "民事訴訟の紛紜、及び余り重大では無い、武士と武士との間に起ったので無い刑事の裁断の権能をもそれに持たせた。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑事ではあるまい、おそらく民事であろう。",
              "citation": {
                "source": "白髪鬼",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「宝島」の作者は何時迄も海賊と埋もれた宝物のことを書いていればいいのであって、南海の殖民事情や、土着民の人口減少現象や、布教状態に就いて考察する資格が無いとでもいうのか？",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その名から思い出したのは一時大阪で鳴らした実業家の岩下清周という人が富士の裾野に広大な土地を買い込んで、其処に一種の植民事業を試み、そのために学校をも建て、橋をも架けたと聞いていたそれである。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々の注文をいえば、もっと、法律を背景とした事件、すなわち民事、刑事に関する面白い事件を、材料として大いに取り扱ってもらいたいですな。",
              "citation": {
                "source": "島原心中",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがその頃にはもう元気を回復してゐて、日本人はもう相手にしないと云つて南洋の殖民事業を計画した。",
              "citation": {
                "source": "毒気",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "』そう言うと彼は、さっそく例のスコットランド式の着物をヨーロッパ風の洋服に著換えて、太鼓腹をギュッと尾錠でしめつけ、オーデコロンをふりかけて、防寒用の縁無帽を手にとると、書類を小腋にかかえて、売買登記をすませるために民事裁判所をさして出かけた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "平民の知徳を開き、これをして公に民事を議するの権を得せしむる者も、この子女ならん。",
              "citation": {
                "source": "京都学校の記",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから、支那では民事の裁判事件などは、大體は一族の間で處置されて、比較的容易に治安が維持される譯であります。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち被害者またはその親戚らより起訴して、原被両告の対審となることは、民事訴訟と同一であった。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "九四　違約に対する刑事責任　現今の法理においては、違約はその性質上民事責任を生ずべきものとしておって、各国の法律、その点において規定を一にしているが、独りかの有名なるマコーレー卿(Macaulay)の立案に係る印度刑法においては、旅客運送契約の違約者に対して、刑事責任を負わしめている。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度において旅客運搬を業としているのは、土人の轎舁きであるが、彼らは我国の雲助にも劣った、真に裸一貫の輩であるから、民事責任を負うて賠償するなどという事は、到底出来ない相談である。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "またその旅客の通行する地方には、森林沙漠などの荒寥無人の境が多いから、もしそのような場所で、運送契約を破って、女子供の足弱を置去りにすることがあったならば、これ実に生命身体に重大な危険を及ぼすものであって、民事責任をもってしては、制裁が十分でないのは勿論である。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくの如く、性質上は民事責任を生ずべき行為でも、場合によっては、刑事責任を生ぜしめなくては、法律の目的を貫き得ないことがある。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "九四　違約に対する刑事責任　現今の法理においては、違約はその性質上民事責任を生ずべきものとしておって、各国の法律、その点において規定を一にしているが、独りかの有名なるマコーレー卿（Macaulay）の立案に係る印度刑法においては、旅客運送契約の違約者に対して、刑事責任を負わしめている。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論裁判所は民事も刑事も無い、専ら賞勲の公平を司つて、弁護士には臨時に批評家がなる。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　呼び出されたのは同じ構内の今の民事第一法廷で、当時はそこで革命裁判が開かれ、冷酷なフーキエ・タンヴィルがてきぱきと矢継早やに判決を下していた。",
              "citation": {
                "source": "パリの地下牢",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "農村の諸方に現れる類型的な民事裁判の例、証文なしで借りておいてその親友を裏切つたり、畑の垣根を少しづつづらしたり、彼等は如何に親友や隣人を裏切つてゐるか。",
              "citation": {
                "source": "地方文化の確立について",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日諸方の農村に於ける相似た民事裁判の例、境界のウネを五寸三寸ずつ動かして隣人を裏切り、証文なしで田を借りて返さず親友を裏切る、彼等は親友隣人を執拗に裏切りつづけているではないか。",
              "citation": {
                "source": "堕落論〔続堕落論〕",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "民事裁判の場合などでも、原告被告の人柄とか、判事の私生活との類似とかというようなことから、微妙な傾斜が起りはじめる危険がありそうに思われる。",
              "citation": {
                "source": "安吾巷談",
                "author": "巷談師退場",
                "note": "青空文庫"
              }
            },
            {
              "text": "（東京地方裁判所民事第一部、裁判官、安武東一郎）　この判決に対して二三反対の言葉を新聞紙上で見た記憶がある。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その二　大岡越前守",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は遠方に住居を変えて、学校で教えるかたわら法律を勉強し、弁護士になり、政治家に転じ、選挙運動に奔走し、新聞に寄稿もし、ついに民事裁判所の判事になったということであった。",
              "citation": {
                "source": "スリーピー・ホローの伝説",
                "author": "故ディードリッヒ・ニッカボッカーの遺稿より",
                "note": "青空文庫"
              }
            },
            {
              "text": "また「全国民事慣例類集」によると、遠州敷知郡地方のエタは「所持地多分ありて貢租を納め、中には富豪の家あり、平民へ金銭を貸付くるものもあるなり」とある。",
              "citation": {
                "source": "特殊部落と細民部落・密集部落",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「全国民事慣例類集」に、遠江国敷知郡地方では、「三代皮剥ぎの業をなさざれば、平民となるの例あり。",
              "citation": {
                "source": "遠州地方の足洗",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、民事高等裁判所★の裁判長の面貌の方へ肩で他人を押し除けて突き出ているストライヴァー氏の血色のよい顔が、ちょうど庭一面に生い繁った仲間のけばけばしい花の間から太陽をめがけてぐっと伸び出ている大きな向日葵のように、仮髪の花壇★からにゅっと現れ出ているのが、毎日のように見受けられたのであった。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
