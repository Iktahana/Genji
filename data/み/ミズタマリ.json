[
  {
    "uuid": "910bad24-2d81-55ab-876c-702839cdb169",
    "entry": "水たまり",
    "reading": {
      "primary": "みずたまり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
