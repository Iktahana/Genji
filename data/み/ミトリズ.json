        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "旅行先のホテルで、避難経路の見取り図を確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は頭の中で家の間取りの見取り図を描くのが得意だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "工事現場には、必ず現在の状況を示す見取り図が掲示されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "書物の記載も、見取り図も至極簡単であるからやむを得ない。",
              "citation": {
                "source": "沓掛より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "時によると僕も日記中に君の見取り図くらいなところを書きとめたこともあるが、それは真の粗雑としたものだ。",
              "citation": {
                "source": "小春",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然科学の研究なども、プレパラートと見取り図とを作ることに彼は不器用だったが、それさえ除けば、あまり分りきった事実の排列にすぎなかった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、天主閣の見取り図の写しに取りかかつてゐたのであるが、長い勤労の疲れが凝つて稍ともすれば、唸り声をあげるのであつた。",
              "citation": {
                "source": "熱い風",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "半紙いっぱいに書いた見取り図の要所要所へそういう文字を書き入れて、ここ加州家裏門としるしたその門の横の道に、長々と寝そべっている人の姿が見えました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "子持ちすずり",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、それによって、ふたたび見取り図を描いて説明しながら、「まずこういったあんばいでございます」と、話しを結んだ。",
              "citation": {
                "source": "四十八人目",
                "author": "森田草平",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは次郎と三郎とでくわしい見取り図まで取って来た家で、二人ともひどく気に入ったと言っていた。",
              "citation": {
                "source": "嵐",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが氏が要求している処の、即ち又やがて氏自身が造り上げるだろう処の、体系の見取り図は、ある一点に於て、決定的に決っているようだ。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "あ、それから、川波さんのうちの見取り図をここへ書いておいてください」　影男の速水は、テーブルに紙をひろげて、千代に鉛筆を渡した。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が考え考え、見取り図を書き終わると、速水は要所要所の質問をして、屋敷のもようをすっかり頭に入れてしまった。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三の紙草の上に描かれたものは、当地付近の見取り図であります。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "明くる朝も、同じ時刻に小屋へ帰り、見取り図へ必要な条項を、詳しく書き加えた。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまり太く線を引きすぎて、墨を滲ませたり、ぼとっと墨汁を落したり、幾たびか失敗したあとで、どうやら升屋の見取り図ができあがった。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちばん基礎的な見取り図のような知識を得るための本。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、家の見取り図を知らないか。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいぜん、ここへ伺う前、まだ夕明りのまま、あちこち駒を遊ばせて、ざっと懐紙に写しとってまいった、兵庫の地の見取り図ですが」「ほ？",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺人、あるいはもっとけがらわしい犯罪が起り、其の現場の見取図が新聞に出ることがありますけれど、奥の六畳間のまんなかに、その殺された婦人の形が、てるてる坊主の姿で小さく描かれて在ることがあります。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、入口の扉を中心にして、水星と金星の軌道半径を描くと、その中では、他殺のあらゆる証跡が消えてしまうのです」と法水は室の見取図に、別図のような二重の半円を描いてから、「ところで、その前にぜひ知っておかねばならないのは、惑星の記号が或る化学記号に相当するという事なんです。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてが伸子に集注されてゆくじゃないか」　法水はその調査書を衣袋に突き込んだ手で、先刻｜拱廊で受け取った、硝子の破片とその附近の見取図を取り出した。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二条の足跡が印されている、見取図に包まれているのが何であったろうか、意外にもそれが、写真乾板の破片だったのである。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、裏庭へ行って、この見取図に書いてある二条の足跡を調べることにするかな」　ところが、その途中通りすがりに、階下の図書室の前まで来ると、法水は釘付けされたように立ち止ってしまった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "院長と河竹医学士とどちらが先でしたか」「院長の方です」　といって、杏丸は、見取図を認めた紙片を取り出し、法水に与えてから、「院長は相当時期の進んだ結核患者なので、無風の夜には、窓を開放して眠る習慣になって居るのです。",
              "citation": {
                "source": "失楽園殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「然し、もう一歩進んで、飛去来器特有の弧線飛行を―殊に復路の大きな弧線―を考えると、杏丸氏の室を基点とする容易い解釈が、実に誤った、皮相な観察に過ぎない事が判るのです」　それから、見取図に弧線を描いて、法水は説明を続けた。",
              "citation": {
                "source": "失楽園殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし、この点をきめる前に、この紙にここに僕が描いておいた小さな見取図をちょっと見てもらいたいな。",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓ岬に到着する迄に犬田博士は、Ｓ岬の地理と、ロスコー家の間取を、参謀本部の五万分の一の地図と、司法主任の見取図を参考にしながら、出来るだけ詳細に亘って聴取った。",
              "citation": {
                "source": "Ｓ岬西洋婦人絞殺事件",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして作った簡単な見取図は旅での手紙と一緒にして伝馬町宛に送ろうとも考えた。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "韃靼冬へ集まっていた若い人々は、西郷が来ないので、雑草の深い庭へ出て、草の頭をむしってみたり、縁側へ寝転んで、美少年の噂をしたり、懐から、日本外史を出して読んだり、それから、七八人の人々は、見取図を書いて、何う襲撃したらいいかを話していた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来あがった見取図には主君の館がひとりでに中心になっていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "貨物の積み込み方が拙くて、片方へ寄ったのだろうという説も出たが、これは、ダアバンで積荷を請負ったマアシアルという人が出て、ワラタ号の船艙の見取図に就いて説明し、その疑いは氷解した。",
              "citation": {
                "source": "沈黙の水平線",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "たびたび申す通り、私は図を描くのは苦手なのだが、不正確ながらも大体の見取図を書くと丁度こんな風になる。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
