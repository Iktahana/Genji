[
  {
    "uuid": "a1c2ebb8-7fbc-5105-a407-904ae19ac2e9",
    "entry": "見かける",
    "reading": {
      "primary": "みかける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
        "動詞-他動詞"
      ],
