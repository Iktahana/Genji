        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夕方、樹明君を通して敬治君から呼び出し、すぐ出かける、第一窟から宿直室へ、――酒、むきみ貝、樹、敬、山の三重奏、ぢやない、キミチヤンを加へて四重奏。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤガテ　ツヨイ　ヒカリニ　ナレテ　クルト　ナタネノ　花タチハ　アタリヲ　ミマハシテ、木ヤ　ハタケヤ　ミチヤ　イヘヤ　ソラヤ　ミズヲ　ミマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一日にミチヤさんが靜岡の實家からやつて來た。",
              "citation": {
                "source": "樹木とその葉",
                "author": "地震日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからもう四学年になつてゐたミチヤが病気になりまして、神様の許へ引き取られてしまひました。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
