          "literary": [
            {
              "text": "等の訓があるが、「伎美止之不在者」（巻十八・四〇七四）などを参考して、平凡にキミトシヌレバと訓むのに従った。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はバリー・キミトシ・カネシロという。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "またカグヨ姫と結婚して生んだ子は、オホカグヤマトミの神、次にミトシの神の二神です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
