[
  {
    "uuid": "3037ac46-6099-5348-810b-ae6da1fcc8fa",
    "entry": "御年",
    "reading": {
      "primary": "みとし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
