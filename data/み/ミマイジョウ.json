        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "入院中の上司に、部署全員で見舞い状を書いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "手術を終えた母に、温かいメッセージが書かれた見舞い状を送った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は友人の回復を願い、丁寧に見舞い状を綴った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "筆不精の私は、未だにお礼状も何も差し上げていない仕末ですが、こないだの三宅島爆発では、さぞ難儀をなさったろうと思いながら、これまたれいの筆不精でお見舞い状も差し上げず、東京の作家というものは、ずいぶん義理知らずだと王様も呆れていらっしゃるだろうと思います。",
              "citation": {
                "source": "小さいアルバム",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこへ見舞い状を出す先もないと思う事がさびしかった。",
              "citation": {
                "source": "二十四年前",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "予は同人諸君からの見舞状を次ぎ次ぎと見る。",
              "citation": {
                "source": "水籠",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "方々から見舞状、ありがたし／＼。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "一週間ほどしてから、彼らは各々に見舞状を書いて、それを一つ封に入れて、余の宿に届けた。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞で蓮太郎のことを読んで見舞状まで書いた丑松は、この先輩の案外元気のよいのを眼前に見て、喜びもすれば不思議にも思つた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは省吾の書いたもので、手紙の文句も覚束なく、作文の時間に教へた通りをそつくり其儘の見舞状、『根津にて、瀬川先生――風間省吾より』としてあつた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺族から死去の報知を受けたものは寄宿舎で私一人であつた程、それだけ私は度々見舞状を出した。",
              "citation": {
                "source": "途上",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処からも見舞状もやって来ないし、父はよほど寂しかったのだろう。",
              "citation": {
                "source": "雲の裂け目",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "一週間たち、十日たつても出て來ないので、病氣で寢てゐるのだらうと思つて、見舞状を出してみた。",
              "citation": {
                "source": "貝殼追放",
                "author": "女人崇拜",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ病人に逢えないのにその家人をして応接に忙殺せしむるのも気の毒だから私は御見舞に出ないけれども先生の御全快を祈って窃に衷心を苦めておりますと見舞状を出しておいた。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "是れは八月三日の端書で、特に「土用見舞状」と書き、尚ほ「今日の所では埼玉二ヶ村本年大豊年巡視中、谷中植付無し」と表書の宛名の下に書き足してある。",
              "citation": {
                "source": "大野人",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の学校では先に松丸乙近と云ふ教頭の先生が函館の師範へ転任なすったさうでしたが、先日また、本間重と云ふ高等師範出の女教師中の上位の方が退職なすって小樽のお宅から私に宛て長い御見舞状を下さいました。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の人にもまだ見舞状を出しませんが嘸うらんでゐるでせう。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "実はわたしもあの時お負傷の事を聞いたンで、ちょいとお見舞に行かなけりゃならんならんと思ってたンだが、思ったばかりで、――ちょうど第一師団が近々にでかけるというンで、滅法忙しかったもンですから、ついその何で、お見舞状だけあげて置いたンでしたが。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月十六日（日）　各地から見舞状がボツボツ配達される。",
              "citation": {
                "source": "震災後記",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それではひとの病気処にては無之、御見舞状を受けて却って痛み入る次第に候。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "幽香子の手紙、泣言たらたらな手紙は、一週間一本ずつは受取りましたが、佐良井の手紙というものは、活版刷の年始状と、暑さ寒さの見舞状以外に、私が受取ったのは後にも先にもこれが初めてです。",
              "citation": {
                "source": "死の舞踏",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこればっかりは、『やっぱり長生きはせんならんもんや』とも、言ってられないしね」　私は兄夫妻へ礼状、母には見舞状を書く。",
              "citation": {
                "source": "日を愛しむ",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "大地震の時だって見舞状一本下さいませんでしたわ。",
              "citation": {
                "source": "或良人の惨敗",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "見舞状の返事、森岩雄・長谷川一夫その他書く、疲れた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年はここに見えた升田名人も、今年は入院と聞いて、病むもよし　　病まば見るべし萩芒　と呟いた一句を、彼への便りに出そうと思いながら、ついまだ見舞状も書けずにいる。",
              "citation": {
                "source": "随筆　私本太平記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
