[
  {
    "uuid": "f20dbcf1-c374-5ad8-9094-0104a8056a41",
    "entry": "見なし",
    "reading": {
      "primary": "みなし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-接頭辞"
      ],
