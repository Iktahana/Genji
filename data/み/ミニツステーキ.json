        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ホテ・グリで一人で大急行の食事、ポタアジュとミニツステーキのみ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木静一と東京会館へ行って食事、ポタアジュ、レタス、ミニツステーキとマカロニ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "他、ミニツステーキとマッシュド・ポテト。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロビーで清と遊び、平野と又十一時にグリルへ、ポタアジュとミニツステーキ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "チアコンソメとオルドヴル、ミニツステーキを食って座へ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕、クリームスープにミニツステーキ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュと、ミニツステーキにフレンチペストリ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳山・高尾を誘ってホテルへ行き、グリルで、ポタアジュとサワラのフライに、ミニツステーキ、これはうまくなかりし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニューグリルでポタアジュとミニツステーキをやり、日劇へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルニューグリルで、オニグラとミニツステーキをやり、座へ出ると今日も補助椅子がワンサと出てゐる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムエグストーストと、ミニツステーキ、わりにいゝ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩が有楽座の撮影で徹夜だから、うんと食っとこうと、オニグラに、フィレソール、ミニツステーキに、アイスクリーム、ペストリーにコーヒー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、コーンチャウダー、ミニツステーキにマカロニ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィル・ブロス、フィレソール、ミニツステーキ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、ポタアジュ、ミニツステーキに、マッシュポテトーとスピナッチ、ババロア。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュ、フィレソール、ミニツステーキ、栗のプディングがうまいのでアンコール。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテ・グリへ行き、ミニツステーキを食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "小笠原章二郎が今井博士と来り、京都ホテルのグリルへ行き、ポタアジュとミニツステーキ、アスパラガス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "けい古すむと、ホテ・グリへ、滝村・屋井と食事、ポタアジュ・ラングース・ターミドオ・ミニツステーキ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュとミニツステーキ、バヴァロア。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サントリータンサン、チーズトースト、伊藤にお任せの、ビーフ・ミニツステーキ風、バタライス、マッシュポテト添。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
