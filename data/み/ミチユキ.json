        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "初詣に出かけるため、着物の上に上品な道行きを羽織った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "母から譲り受けた道行きは、時代を感じさせるがとても上質な生地だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬の冷え込みが厳しくなってきたので、防寒用の道行きを新調した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
