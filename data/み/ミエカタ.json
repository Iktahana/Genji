          "literary": [
            {
              "text": "人により、時によりこれの見え方に異同のあるのも事実らしい。",
              "citation": {
                "source": "錯覚数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしも元来は平凡な、涙もろい人間と思うが、あんまり早くエライ人間になろうと思うて、自分の性格を裏切った人生の逆コースを取って来たために、物の見え方や聞こえ方が、普通の人間と丸で違ってしもうた。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "月は丸いものと思っていたのに、これはふしぎな見え方をするものである。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
