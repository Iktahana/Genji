        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夜に入つて雨が又強くなつて梓川の水音も耳立つて強くなつた。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と耳立つほど、名を若く呼んだトタンに、早瀬は屹となって鋭く見た。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかに一人ちよつぴり鼻の尖つた狐のやうな表情をした、商人らしい男が、口汚くウヰルソンを罵るのが、殊更耳立つて聞えた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一に目立つ――否耳立つ？",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "二言目には、逢はれぬと、お清お清のその中には、春衛さんの、大臣が耳立つて。",
              "citation": {
                "source": "移民学園",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏冬ともに人の声よりも小鳥の囀る声が耳立つかと思われる。",
              "citation": {
                "source": "葛飾土産",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "初秋の日はいつか暮れかけ、玉蜀黍をゆする風の音につれて道端に鳴く蟲の音が俄に耳立つて來るので、此の上いか程尋ね歩いても、門札の讀み分けられる中には到底行き當りさうにも思はれないやうな氣がし出した。",
              "citation": {
                "source": "羊羹",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝顔の花が日毎に小さくなり、西日が燃える焔のやうに狭い家中へ差込んで来る時分になると鳴きしきる蝉の声が一際耳立つて急しく聞える。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもならば向河岸の屋根を越して森田座の幟が見えるのであるが、時節がらとて船宿の桟橋には屋根船空しく繋がれ芝居茶屋の二階には三味線の音も絶えて彼方なる御浜御殿の森に群れ騒ぐ烏の声が耳立つばかりである。",
              "citation": {
                "source": "散柳窓夕栄",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉田編修官は家遠しとて先に暇を告げられしが、吾等は居殘りて外濠を過る電車の響の木枯に交りて鋭く耳立つ頃まで、何かと打かたらひたり。",
              "citation": {
                "source": "鴎外全集刊行の記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "その老人はいつかすっかりわきで聞いていたとみえて、いきなりわたしのほうに指さしして、耳立つほどの外国なまりでバルブレンに話しかけた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし中佐は両のかかとを揃えて、上体を少し前にかがめながら、妻のほうへ向き直ると、耳立つほど声を落していった。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "衣ずれの音も耳立つその静かなあいだに、義元は着席していた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんよりした闇夜なぞは又、からだが何かに吸いつけられるようで、自分の足音が、いやに耳立つ。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたしは初耳だつたけれど、そんなことがあるんですねえ。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "便所の手拭ひ掛けがこと／＼と、戸袋に当つて搖れるのがやむと、一頻りひつそりと静かになつて、弱り切つた虫の音が、歯※にしみるやうに啼いてるのが耳だつて来る。",
              "citation": {
                "source": "散歩",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何んとも、何人も云はないやうですが、」「さうかね、空耳だつたらうか、」　省三はまた箸を動かしだしたが彼はもう落ち着いたゆとりのある澄んだ心ではゐられなかつた。",
              "citation": {
                "source": "水郷異聞",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く英雄的人物ですよ……」　ゆき子にはそれは初耳だつた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "空耳だつたかなと思つてゐると、今度は確かに身を動かして居る容子が聽ゆる。",
              "citation": {
                "source": "姉妹",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙に長くて人目立つ鼻にお白粉を塗って、白ヴォイルのブラウスの胸に造花の飾りをつけたエレーナ・ニコライエヴナが、小さくて黒く光る眼をせわしく動かしながら耳だつ声でトルストイが最後に家出した気持は理解できるとか出来ないとか盛に喋っている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなにしずかに話しても、その声が自分に耳だつほどしんからひっそりとして、しかも明るいヴェルダン。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっともっと綺麗だった時には見る人もなかった」　この木いっぱいに薔薇が花をつけていた頃、三十日も前になるだろう、彼女は田舎にいて、夜毎に耳だつ広い虫の音と、黄色くなって来る庭の芝を見て暮していた。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつしかにおさんの笑い声も耳だつほどとなりぬ。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何んだか声がしたので、又｜誰か来やがつたと思つたんだが、空耳だつた」と、アルライが答へました。",
              "citation": {
                "source": "ラマ塔の秘密",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、こつちへお寄んなさい」　富田は房一に声をかけて彼のために席を明けながら、つづけて「あなたは御存知ないんですかね」「どういふことです、わたしにはさつぱり――」　房一はさつきから自然と聞いてはゐたが、事は初耳だつた。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　イリリヤが留学生だといふことは、十吉には初耳だつた。",
              "citation": {
                "source": "灰色の眼の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「離屋の方で物音がしたやうに思ひました、――私の空耳だつたかもわかりませんが」　主人金兵衞はひどく言ひ憎さうです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "弱い浪人",
                "note": "青空文庫"
              }
            },
            {
              "text": "その声は耳だつほど顫えていたし。",
              "citation": {
                "source": "日本婦道記",
                "author": "藪の蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "露の音すら耳だつ暁方の静寂を破って、ふいに、ぐわあん！",
              "citation": {
                "source": "山浦清麿",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜もふけてゆくし、それがために一層、清盛の声は、耳だつばかりだった。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
