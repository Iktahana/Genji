        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ケキヨケキヨケキヨ、ヨ、　ケキヨケキヨ、ヨ」　ミンナハ　アタタカク　ナツテ　クルト　ハヲリヲ　ヌイデ　フキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、アル　ヒノ　コト　ガチヨウノ　タンジヨウビト　イフノデ、ミンナハ　ガチヨウノ　トコロヘ　ゴチソウニ　マネカレテ　イキマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナハ　イタチハ　ケツシテ　ワルモノデハ　ナイ　コトヲ　シツテ　ヲリマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナハ　タラフク　タベマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナハ　イイ　グアイダト　オモツテ　イマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ミンナハ、カゲト　イフ　モノハ　タイヤウガ　ツクルノダト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナハラガヘッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモハジメノウチデ、工場ノ人モダンダンコナクナッテ、死ンダトキニハ、ミンナハモウ君チャンノオ父ッチャノコトヲワスレテシマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナハ君チャンニワケヲキイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナハオホヨロコビデス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オフネニノリマシタ、ミンナハハジメテ　ウミヲミタノデ、ヒロイノニビックリ　　シマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "サァ　コレカラドウシテ　オウチヘ　カヘロウカト、ミンナハ　シクシク　ナキダシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナハ　トテモ　　　　　ヨロコビマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
