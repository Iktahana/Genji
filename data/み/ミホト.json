          "literary": [
            {
              "text": "持仏堂におさめて、ヒメが朝夕拝むものだが、ミホトケの御姿と、それをおさめるズシがほしい。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミホトケはミロクボサツ。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒメの気に入ったミホトケを造った者には、美しいエナコをホービに進ぜよう」　長者が金にあかして買い入れたハタを織る美しい奴隷なのだ。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に荘厳なる記紀の神代物語にもしばしばミホトの記事があり、『出雲風土記』にも、神門郡｜陰山　大神の御陰なりとある。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この天皇の御年四十九歳、御陵は畝傍山のミホトにあります。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
