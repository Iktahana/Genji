        "examples": {
          "standard": [
            {
              "text": "髪をバッサリ切る勇気はないので、肩にかかるくらいのミディアムヘアにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "このワインはミディアムボディで、どんな料理にも合わせやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はテニスラケットのガットを、中間の強さであるミディアムに張った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
