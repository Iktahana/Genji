        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "其書懐の詩に曰く聊取文章当結草、効身未必在華替。",
              "citation": {
                "source": "頼襄を論ず",
                "author": "山路愛山",
                "note": "青空文庫"
              }
            },
            {
              "text": "明子は容色の幾分を減却したれども、猶｜紫藤花下に立ちし当年の少女を髣髴するは、未必しも難事にあらず。",
              "citation": {
                "source": "開化の殺人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一六　賢者臨、未必爲遺訓。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが不幸な未必的予感が当って、四月十四日の大空襲が来た。",
              "citation": {
                "source": "親は眺めて考えている",
                "author": "金森徳次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼山陽は、その詠史の詩のうちに言って、翠楠未必勝黄花　と、うたったが、菊池の一族一門中、初めから終りまで、宮方へ味方して、終始一貫、変節者や離反をひとりも出さなかったことは、たしかに、ひがしに楠木、みなみに菊池党、ほかになかったといってよい。",
              "citation": {
                "source": "私本太平記",
                "author": "筑紫帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
