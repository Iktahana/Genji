          "literary": [
            {
              "text": "ミチコサン新美南吉　ミチコサンガ、コトリヤノ　マヘマデ　クルト、シラナイ　オバサンガ、ウバグルマノ　ナカノ　ニモツヲ　ナホシテ　ヰマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、オバサンノ　ソバニ　ヨツテ、「アカチヤン　ダイテテ　アゲマセウカ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オバサンハ　アカチヤンヲ　ミチコサンニ　ダツコサセテ　クレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンノ　ウデニ、オチチクサイ、シロイ　パヂヤマノ　カハイラシイ　アカチヤンガ、ダカレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、「チユツチユツ、ホラホラ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、アカチヤンハ、コトリヲ　ミナイデ、ミチコサンノ　カホヲ　ミテ　ヰテ　ニツコリ　ワラヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、オテテデ　ミチコサンノ　ネクタイヲ　ツカミマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、カワイイ　テダナト　オモヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、マダ　アカチヤンヲ　ダツコシテルヤウナ　テツキヲ　シテ　オウチヘ　カヘツテ　キマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカアサンハ　ミチコサンヲ　ミルト、「ナニヲ　ソンナ　オカシナ　テツキ　シテルノ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イツテ　ミチコサンハ　ムネノ　アタリヲ　カギマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカアサンハ、ミチコサンハ　イヽ　コダナト　オモイマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
