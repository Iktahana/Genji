[
  {
    "uuid": "36bf653c-f685-538a-8694-11bae7b36a9b",
    "entry": "水明かり",
    "reading": {
      "primary": "みずあかり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "faint reflection of light upon the water in the dark",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "月のない夜、湖面にわずかな水明かりが揺れていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "遠くの街の光が水明かりとなって、川面に映る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "小さな漁船の灯りが、暗い海に水明かりを描いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "蒼ざめた星が黒い松の上に凍り着いたように寂しく光って、鼠色の靄につつまれたお茶の水の流れには水明かりすらも見えなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "朝顔屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "人家のまばらな田舎道のところどころに、大きい櫨の木が月のひかりを浴びて白く立っているばかりで、川らしい水明かりは見当らなかった。",
              "citation": {
                "source": "怪獣",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "水明かりでそこらを透かしてみたが、近いところでは二人の人間があらそっている様子も見えなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二人は息をころして窺っていると、彼らの隠れ場所から十｜間余りも距れたところに、一つの大きい黒い影の現れたのが水明かりでぼんやりと見えた。",
              "citation": {
                "source": "馬妖記",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "大川の水の上には鼠色の煙りが浮かび出して、遠い川下が水明かりで薄白いのも寒そうに見えた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "石燈籠",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い沼のおもては水明かりのしないほどに黒ずんで、岸には枯芦や芒が茂っていた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "灯の少ないここらの町はだんだんに薄暗く暮れて来て、栗の立木も唯ひと固まりの暗い影を作るようになりましたが、空と水とはまだ暮れそうな気色もみえないので、水明かりのする船端には名も知れない羽虫の群れが飛び違っています。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　平助はそこにかけてある蓑を引っかけて、小さい掬い網を持って小屋を出ると、外には風まじりの雨が暗く降りしきっているので、いつもほどの水明かりも見えなかったが、その薄暗い岸の上に一｜尾の大きい魚の跳ねまわっているのが、おぼろげにうかがわれた。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "水明かりと雪あかりを頼りにして、大勢の人影は白いゆうぐれの中をさまよっていた。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "足音を忍ばせてだんだんに近寄ると、池の岸にひとつの黒い影の動いているのが、水明かりと雪明かりと星明かりとでおぼろげに窺われた。",
              "citation": {
                "source": "鴛鴦鏡",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、暗いのを幸いに、黙ってそこをすり抜けて行こうとすると、水明かりで早くもそれと認めた実雅は、これも無言で駈けつけて、彼が直衣の袖を力任せにぐいと曳いた。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "水明かりに透かして視ると、それは確かに人の影で、音羽の方角からふらふらと迷って来るのであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "白蝶怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀河の箭づくり一　富士の二｜合目をはなれ、いっきに、五湖の水明かりをのぞんで飛行していた竹童は、夜の空から小手をかざして、しきりに、下界にある伊那丸主従のいどころをさがしている。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこちらの松明が、近づいていくのを待っておいでなされます」　指さすかたをみると、なるほど、滝の水明かりと、ほのかな星影の光をあびて、孤岩の上に立っている白い道士の衣がみえる。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　ガドルフはあらんかぎりすねを延ばしてあるきながら、並木のずうっと向うの方のぼんやり白い水明りを見ました。",
              "citation": {
                "source": "ガドルフの百合",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の性格が朦朧として、無口に白け切って来るほど、その淡い魅力は、水明りのように冴え出して来て、彼女を牽き寄せる。",
              "citation": {
                "source": "唇草",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "往時英国の潜航艇に同様不幸の事のあつた時、艇員は争つて死を免かれんとするの一念から、一所にかたまつて水明りの洩れる窓の下に折り重つたまゝ死んでゐたといふ。",
              "citation": {
                "source": "文芸とヒロイツク",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは眼の前に大きく開けている不忍池の水明りをみると、滑るようにそこに駈けて行って、裸のままで岸から飛び込んだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "松茸",
                "note": "青空文庫"
              }
            },
            {
              "text": "灯の少いここらの町はだんだん薄暗く暮れて来て、栗の立木も唯一と固まりの暗い影を作るようになりましたが、空と水とはまだ暮れそうな気色もみえないので、水明りのする船端には名も知れない羽虫の群が飛び違っています。",
              "citation": {
                "source": "栗の花",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄月と水明りとに照らされた河原には、二つの刀の影が水に跳る魚の背のように光っていた。",
              "citation": {
                "source": "鳥辺山心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と前ぶれして思い出す風に、「春の夜の月さまざまな水明り。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つ俳句になほして見むとて、一峯の數峯になりて時雨れけり落葉して武藏野遠し水明り飛ぶ鳥を追ひこす山の落葉かな伯勞鳴くや石の地藏の首が無き　よかれ、あしかれ、ともかくも、出來上りたり。",
              "citation": {
                "source": "國府臺",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "又同じ時同じ山を詠んだ歌に　歌舞伎座の菊畑などあるやうに秋山映る湖の底　わが閨に水明りのみ射し入れど全面朱なり男体の山　などがあり、又戦場が原に遊んでは　宿墨をもて立枯の木をかける外は白けし戦場が原　さるをがせなどいふ苔の房垂れて冷気加はる林間の秋　といふ様なすばらしい歌もこの時出来てゐる。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "川風に筵があおられて、水明りで内部はほのかに明るい。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　白い剣身に、河原の水明りが閃々と映えて、川浪のはるかかなたに夜鳴きする都鳥と、じっと伸び青眼に微動だにしない、切れ味無二の濡れ燕と――。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "おだやかに、流れている川の水の上にも、霜のように月の光が降りそそいでいて、水明りをボッと立てている。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "舫の上では、月と水明りとが呉劉二夫人の水色のマントオを白く見せるのであつた。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "運河の水明りも美しかった。",
              "citation": {
                "source": "馬の脚",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "天井の太い梁も、隅棚の和蘭の人形も、置時計も、花瓶も、木の間ごしにチラチラとうごく水明りも、眼にうつるものはすべて、もうなんの情緒もひき起さない。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "上からくる水明りをたよりに、藻の間をすかして見る。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
