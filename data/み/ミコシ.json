[
  {
    "uuid": "82ff519e-ace2-57f8-bdf3-073877edc52a",
    "entry": "神輿",
    "reading": {
      "primary": "みこし",
      "alternatives": [
        "しんよ"
      ],
      "is_heteronym": true
    },
    "grammar": {
