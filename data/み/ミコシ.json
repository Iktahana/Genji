  {
    "uuid": "23f33b64-a3ac-5aad-b74d-77dc3c86ef90",
    "entry": "御輿",
    "reading": {
      "primary": "みこし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
