          "literary": [
            {
              "text": "まったくどんな大作でもちょっと四角のミニアチュールでも要するに一目でわかる。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてあの胴体の草色と青色のエナメル風の色沢は、油絵の色沢であり、ガラス絵であり、ミニアチュールの価値でもあった。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら私の考えでは、ガラス絵はなるべく小品のミニアチュールとして、手のひらへ乗せて味わう程度のものがもっとも好ましいものであると思う。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、彼の本領は必ずしも、文字でミニアチュールを描くことではない。",
              "citation": {
                "source": "博物誌 あとがき",
                "author": "岸田国士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは美しい少女のミニアチュールで、とても古風な装いをしており、可憐な胸元に深紅のバラが結わえてあった。",
              "citation": {
                "source": "犬酸漿",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
