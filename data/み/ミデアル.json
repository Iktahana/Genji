          "literary": [
            {
              "text": "二　裁判言渡しの時どう感じたか実ニ不都合デアルト感ジタ三　受刑者として収容せられた時どう感じたか別ニ処感ナシ四　被害者に対してどう思ふか自分ハ正当ト信ズル事ヲ行ッタノミデアル。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "努力ニ免ジテ将来ノ大成ヲ祈ルノミデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………午睡ノアト、今日ハ鍼ハ休ミデアルガ、ヤハリ気ニナルノデ寝室ニイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟻走感ト云ウノニ似テイルガ、アンナ生ヤサシイモノデハナク、モット強ク激シイ痛ミデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ知ッテイルヲ容易ニ口ニ出サナイノガ常デアルガ、悪イコトニハソレヲ女ノ嗜ミデアルトモ思ッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
