[
  {
    "uuid": "72ede70b-ab9c-59cb-8bf8-eb00899b07e0",
    "entry": "瑞々",
    "reading": {
      "primary": "みずみず",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
