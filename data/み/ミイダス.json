    "definitions": [
      {
        "index": 1,
        "gloss": "to find out",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "泥沼のような状況の中から、ようやく解決の糸口を見出すことができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はガラクタの山の中から、価値のあるアンティークをいくつも見出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "失敗の経験の中にこそ、成功への鍵を見出すことができるはずだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "――さうだとすると、これはまたしても芸術の中に生活を見出すことのない、「生活の余暇の芸術」であると思はれる。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "新短歌のみならずすべて一呼吸詩歌（私は短歌や俳句や新短歌を今仮りにさう呼ぶ）が、その詩歌の中に生活を見出すものでなくて、生活の傍に生ずるものとしてだけ意義を有するものであるといふことを、左にもう少し言添へよう。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘルンは常に散歩を好み、学校の帰途などには、まだ知らない町の隅々を徘徊したが、新しい興味の対象を見出すごとに、必ず妻を連れてそこへ再度案内した。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「侘び」とは、前にも他の句解で述べた通り、人間生活の寂しさや悲しさを、主観の心境の底で噛みしめながら、これを対照の自然に映して、そこに或る沁々とした心の家郷を見出すことである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし不幸にして特に四十二歳の前後に跨がった著しい突起を見出すことは出来なかった。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "下谷のある町の金貸しの婆さんの二階に間借りして、うら若い妻と七輪で飯を焚いて暮している光景のすぐあとには、幼い児と並んで生々しい土饅頭の前にぬかずく淋しい後姿を見出す。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ティアガルテンの冬木立や、オペラの春の夜の人の群や、あるいは地球の北の果の淋しい港の埠頭や、そうした背景の前に立つ佗しげな旅客の絵姿に自分のある日の片影を見出す。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁はときどき、ひょんなところで、ひょんな憩い方をしていると、苦笑して悩みつつある一人ぼっちの自分を見出すのであったが、なかなか腰は上げ悪かった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女を見出すと、片息の鹿を女の足元に抛り出した。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然現象に関する言葉でさえ既にかようであるから、まして社会の特殊な現象に関する語は他国語に意味の上での厳密なる対当者を見出すことはできない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "しからばフランス語のうちに「いき」に該当するものを見出すことができるであろうか。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとより「いき」と類似の意味を西洋文化のうちに索めて、形式化的抽象によって何らか共通点を見出すことは決して不可能ではない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いき」を若い芸者に見るよりはむしろ年増の芸者に見出すことの多いのはおそらくこの理由によるものであろう｛１｝。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに西洋の絵画では、湯に入っている女の裸体姿は往々あるにかかわらず、湯上り姿はほとんど見出すことができない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "縦縞が全体に波状曲線になっている場合も「いき」を見出すことは稀である。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして仮りにもし「いき」がかくのごとき漠然たる意味よりもっていないものとすれば、西洋の芸術のうちにも多くの「いき」を見出すことができるはずである。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "既にいったように、この種の現象と「いき」との共通点を形式化的抽象によって見出すことは必ずしも困難ではない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "客観的表現が「いき」そのものの複雑なる色彩を必ずしも完全に表わし得ないとすれば、「いき」の芸術形式と同一のものをたとえ西洋の芸術中に見出す場合があったとしても、それを直ちに体験としての「いき」の客観的表現と看做し、西洋文化のうちに「いき」の存在を推定することはできない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "しからば意識現象としての「いき」を西洋文化のうちに見出すことができるであろうか。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "初春の賑やかな往来をあるきながらも、彼は絶えずこの疑問の鍵をみいだすことに頭を苦しめたが、どうも右から左に適当な判断が付かなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "湯屋の二階",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう彼是二十日間は泊つてゐるだらう、彼はどうしてホテルに自分が泊らせられてゐるか理由をみいだすのに困つたが、係官はその理由をはつきりと知つてゐた、即ち『下駄は携帯すべからず履いて歩るくべきものなり』といふことであつた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとり寝の別れという難題をこれ程に詠みいだす者は、都はおろか、日本じゅうにもあるまい。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとり寝の別れという難題をこれほどに詠みいだすものは、世におそらく二人とはござるまい。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "言葉をかえていえば、わたしたちはその作品の世界にひきこまれることで、自分だけの日常には経験されていない人生の複雑な諸関係の間を通過しながら、自分だけの生活では自覚されていなかった社会関係、そこから生じる人間感情の葛藤と進展と批判をみいだすのである。",
              "citation": {
                "source": "文学と生活",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロダンの彫像の如何なる部分を見ても、我々はやはりこの大自然の刻みいだす山岳を構成する各部分、各線の美を見出すと同じやうに、我々はまたこの大自然の原型藝術の中に、我々人類の巨匠の創造し出す、無數の變化を一層擴大したる形に於て認むるのである。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "實にも靈性の深奧に祕密の殿堂をみいだすことは感覺のプリズムに富瞻の色彩を悦樂することである。",
              "citation": {
                "source": "風は草木にささやいた",
                "author": "跋",
                "note": "青空文庫"
              }
            },
            {
              "text": "未来を生みいだす真の現在の実存的把握ではない。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえそれが失敗しても、新制中学の女生徒は、やがて主婦となる時、理解ある協力者を男性のうちにみいだすことが容易となるに違いありません。",
              "citation": {
                "source": "Ｓ夫人への手紙",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも――ハッキリ本人は、芸以外の何物にも情熱をみいだすことはできないといい切っている。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "随分、風変りにも程があるが、無理矢理出家してしまったればこそ、いまだ若僧の身分ではあるが、法の道の深さありがたさは身にしみじみと滲みわたり今やようやく前途一縷の光明をさえみいだすことができそうになっているではないか。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
