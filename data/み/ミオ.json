        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "船が通り過ぎた後、白い澪が長く残った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夕日に照らされた海に、美しい澪が描かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ジェットスキーが素早く走り去り、鮮やかな澪を残した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
