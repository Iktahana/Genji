        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "宮柱太しく立てる神殿いと広く潔らなるに、此方より彼方へ二行に点しつらねたる御燈明の奥深く見えたる、祝詞の声のほがらかに澄みて聞えたる、胆にこたえ身に浸みて有りがたく覚えぬ。",
              "citation": {
                "source": "知々夫紀行",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "）思へ、天業恢弘の黎明、鎭みに鎭む底つ岩根の上に宮柱太しき立てた橿原の高御座を、人皇第一代｜神倭磐余彦の天皇を、ああ、大和は國のまほろば、とりよろふ青垣、鵄は舞ひ、朗かにおほらかに草も木も言祝ぎ謳つた。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "白木の宮柱に萱葺の屋根をした素朴な社でありました。",
              "citation": {
                "source": "宇賀長者物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "祠は神武天皇の御世にはじまり、底つ岩根に宮柱ふとしきたち、高天原に千木高知り、萬古儼として威靈を留む。",
              "citation": {
                "source": "鹿島詣",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中心地、小金ヶ原へ一夜のうちに出来た仮宮の宮柱も、みるみる太くなりました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四回　宮柱、太しく立てて、東洋を、鎮護の神と仰がるる、招魂社の片辺りに。",
              "citation": {
                "source": "したゆく水",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれ此地ぞいと吉き地」と詔りたまひて、底つ石根に宮柱太しり、高天の原に氷椽高しりてましましき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "此處こそはたいへん吉い處である」と仰せられて、地の下の石根に宮柱を壯大に立て、天上に千木を高く上げて宮殿を御造營遊ばされました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "すでに心の宮柱としておるものを、何でわれからわが心にそむけようか」「御意」　と、介は同調して。",
              "citation": {
                "source": "私本太平記",
                "author": "筑紫帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど伊勢の宮柱のある志摩の国だけにこういう人を見るのはなんだか皮肉である。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
