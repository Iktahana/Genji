        "examples": {
          "standard": [
            {
              "text": "叔父に頼んで、新しいマンションの身元保証人になってもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "社員が会社の金を持ち逃げした場合、身元保証人が損害を賠償することになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "身元保証人が見つからず、彼は就職を諦めざるを得なかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "貴女の身元保証人は……」「あの。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今迄はたった一人の労働者を雇うのにも厳重な調査をし、身元保証人をきめた上でなければ駄目だった。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の身元保証人になっている、女の伯父だという男から持ち込まれた難題に、お爺さんも妾のお芳も蒼くなっていた。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "波瑠子の身元保証人が実在の人物でなかったことが分かったからである。",
              "citation": {
                "source": "宝石の序曲",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "当然、身元保証人を立てたでしょう」証言人「いいえ、立てませんでした。",
