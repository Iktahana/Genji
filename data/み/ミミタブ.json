[
  {
    "uuid": "c4aed426-90f9-5eef-bd3d-63b5665bce44",
    "entry": "耳たぶ",
    "reading": {
      "primary": "みみたぶ",
      "alternatives": [
        "じだ"
      ],
      "is_heteronym": true
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "earlobe",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女の耳たぶには、キラキラと輝く上品なパールのピアスが揺れていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「寒い外から帰ってくると、冷え切った耳たぶがじんじんとしびれるように痛む。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "福耳と呼ばれる厚い耳たぶを持っている人は、金運に恵まれるという言い伝えがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "もっとも耳たぶがあるために各方の耳が精確にどちらに向いているかという事はそう簡単に言われないが、しかし、この平凡な事実は考えてみるといろいろなおもしろい意義をもっている。",
              "citation": {
                "source": "耳と目",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも人間のからだで云えば、例えば――まあ「耳たぶ」か何かのようなものかもしれない。",
              "citation": {
                "source": "石油ランプ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳たぶは、あってもなくても、別に差支えはない。",
              "citation": {
                "source": "石油ランプ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は子供の時に蜂を怒らせて耳たぶを刺され、さんしちの葉をもんですりつけた事を想い出したりした。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまり暑いので耳たぶへ水をつけたり、ぬれ手ぬぐいで臑や、ふくらはぎや、足のうらを冷却したりする安直な納涼法の研究をしたこともあった。",
              "citation": {
                "source": "涼味数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはとにかく、額に紅を塗ったり、歯を染めたり眉を落としたりするのは、入れ墨をしたり、わざわざ傷あとを作ったりあるいは耳たぶを引き延ばし、またくちびるを鳥のくちばしのように突出させたりする奇妙な習俗と程度こそ違え本質的には共通な原理に支配された現象のような気がする。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなの顔の耳たぶの耳環もうつつてをりました。",
              "citation": {
                "source": "井戸",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねむれよ、息づかひも、毛帽子のをさな児、耳たぶの紅さ見せて。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ははははは」　お菊は耳たぶを紅くして俯向いてしまった。",
              "citation": {
                "source": "番町皿屋敷",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "岡は怖じながらもその目から自分の目をそらす事ができないようにまともに愛子を見て見る見る耳たぶまでをまっ赤にしていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "切り下げにした厚い黒漆の髪の毛の下にのぞき出した耳たぶは霜焼けでもしたように赤くなって、それを見ただけでも、貞世は何か興奮して向こうを向きながら泣いているに違いなく思われた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近ごろばかに耳たぶがあったけえと思っていたら、必定こういう福の神が舞い込むんだからね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひいでた眉、高い鼻、思い切って切れ長の涼しい眼、私は冷酷じゃアありませんよ、こういいたげにやや厚手の、それでいて醜くない立派な口、金持ちの証拠に耳たぶが厚く、詩人的｜気禀があるからであろう、額が広く光がある。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと氣がついたのは、女の左りの耳たぶの下部に、ちひさな瘤の樣な物が附いてゐる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その」と、押されたのを少し苦しみに感じながら、「耳たぶの瘤よ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、何氣ない風をして、女の耳たぶの下部のニキビのかたまりと云ふのをさはつて見る。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "義雄は下を向いて靴の紐を結んでゐながら、自分の後ろまでふところ手をして送つて來た女の耳たぶの下に在るニキビのかたまりが、いつも自分が氣にしていぢくつて見ると、やはらかであつたことを考へてゐた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘は、いかにも娘らしい古風な島田にでも結うような娘ならば人から何か云われると耳たぶまで赤くしてたたみの目をかぞえながらこもったような声で返事をする。",
              "citation": {
                "source": "妙な子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "片耳が花の芯のように小さく縮まってしまって、耳たぶがなかったのだ。",
              "citation": {
                "source": "河沙魚",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳たぶの中には樹木が一本累々と円い実をみのらせている。",
              "citation": {
                "source": "誘惑",
                "author": "――或シナリオ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳はその鬢のはづれに、ちよいと上つた耳たぶだけ見える。",
              "citation": {
                "source": "好色",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、法印、ニヤリとしたと思うと、左右から、撲りかかる二人の雲助の、耳たぶを両手で、ぐっとつかんだと思うと、　――ガツン！",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも博士は視力をうしなっているので、見えるはずはなかったが、しかし博士は、見えない目を見はり、両方の耳たぶに手をあてがって、機械人間の発する足音や、動きまわる気配に、全身の注意力をあつめて、何事かを知ろうとあせっている様子だった。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳たぶのうしろにかざした博士の手が、ぶるぶるとふるえている。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、耳たぶもふるえている。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊かな垂れ頬、ひきしまった頤、厚い耳たぶ、長目の首、総体が華奢で上品で、そうして何んとなく学者らしい。",
              "citation": {
                "source": "怪しの館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "唇へ差した余りの紅を耳たぶや眼の間へ差して、髪を掻揚げてしまい、着物を着替えたりするとボーンと夜の亥刻になります。",
              "citation": {
                "source": "霧陰伊香保湯煙",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
