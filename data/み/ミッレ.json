        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしながら前に他の章（音楽と美術）で言っているように、美術それ自体の部門に於てまた主観派と客観派との対立があり、その主観派に属するもの――ミレーや、ターナアや、ゴーガンや、ゴーホや、ムンヒや、歌麿や、広重や――は、画家と言うよりはむしろ詩人に属している。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美術にあっては、一方にミレーやゴーガン等の、抒情派があり、一方にピカソやセザンヌ等の、歪んだ科学的の叙事詩派がある。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうはいうものの私は例えばミレーの田園風俗画とスタンランの漫画との間に或る区別を感じない訳ではない。",
              "citation": {
                "source": "漫画と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "線路に沿うたとある森影から青い洋服を着て、ミレーの種蒔く男の着て居るやうな帽子をかぶつた若者が、一疋の飴色の小牛を迫うて出て來た。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミレ、タンポポ、野菊、ツツジ、白ウツギ、アケビ、野バラ、それから、私の知らない花が、山路の両側の芝生に明るく咲いてゐる。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂山には、スミレが咲いてゐた。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "春宵一刻、――」などと、つまらぬ事を呟きながら木の虚から這ひ出ると、オヤ　ナンデセウ　サワグコヱミレバ　フシギダ　ユメデシヨカ　といふ事になるのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも明るい貴族的なラファエルよりも、素朴な単純なミレーを好み、理智的に円満なダビンチよりも、悲哀と破綻に終ったアンゼロを愛するという具合です。",
              "citation": {
                "source": "岡本一平論",
                "author": "――親の前で祈祷",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこかミレーの絵の鼠色の気分である。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "線路に沿うたとある森影から青い洋服を着て、ミレーの種まく男の着ているような帽子をかぶった若者が、一匹の飴色の小牛を追うて出て来た。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "きれいにみがかれたクルミのからの上に、スミレの花びらをシーツ、バラの花びらをしきぶとんにしたきれいなゆりかごです。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲は赤く、スミレ色にもえて、頭の上を流れていきました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、きれいなベッドの中へはいって、青いスミレの花をつめた、赤い絹の掛けぶとんをかけて、眠りました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいて、スイカズラとスミレのにおいが、それよりも、もっと強くしてきました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "青いスミレの花は、かわいらしい海軍士官の候補生で、ヒヤシンスやサフランに、『お嬢さん』と呼びかけては、ダンスにさそうんだよ。",
              "citation": {
                "source": "イーダちゃんのお花",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "青いスミレの花や、赤いサクラソウも、ヒナギクやスズランも、やってきました。",
              "citation": {
                "source": "イーダちゃんのお花",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸を歩くと、ミレ村共同宿泊所、エボン村共同宿泊所等と書かれた家屋があり、其の傍で各島民が炊事をしてゐる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸を歩くと、ミレ村共同宿泊所、エボン村共同宿泊所などと書かれた家屋があり、その傍で各島民が炊事をしている。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "次にはタチツボスミレの天ぷらである。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミレーの晩祈の図は一種の幽遠な情をあらわしている。",
              "citation": {
                "source": "文芸の哲学的基礎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏蘭西のミレーも生きている間は常に物質的の窮乏に苦しめられていました。",
              "citation": {
                "source": "道楽と職業",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トコロデ、ミレバ　モウ　コノ　バシヤモ　ズヰブン　フルボケテ　シマツタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、ジョン・ミレイズの「オフェリヤ」そのままの美しさで、キラキラ光る水面を、下手にかけて流れ行くのである。",
              "citation": {
                "source": "オフェリヤ殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくあの顔か、この顔か、と思案しているうちに、ミレーのかいた、オフェリヤの面影が忽然と出て来て、高島田の下へすぽりとはまった。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "余が平生から苦にしていた、ミレーのオフェリヤも、こう観察するとだいぶ美しくなる。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミレーのオフェリヤは成功かも知れないが、彼の精神は余と同じところに存するか疑わしい。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミレーはミレー、余は余であるから、余は余の興味を以て、一つ風流な土左衛門をかいて見たい。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "画家のミレエの細君は貧乏で食べる物が無くなつた時には、雲脂だらけな頭をした亭主を胸に抱へて、麺麭の代りだといつて、熱い接吻をして呉れたものださうだ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
