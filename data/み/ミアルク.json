        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "文展には色々の大家名家が数知れず出品してゐるが、ある批評家は、あのなかを唯四十五分で見歩く事が出来ると自慢してゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊太利亜の山の色の美しきを見つつ、かの国を君と見歩くゆかりの無くやはありける。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "百合子興に乗じ更に両国より人形町の夜市を見歩くべしと云ふ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "郊外の家はその前に畳んで牛込矢来町に移っていたので、毎晩手をひきつれて神楽阪の夜店を見歩く。",
              "citation": {
                "source": "ひかげの花",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
