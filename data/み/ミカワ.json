[
  {
    "uuid": "deb7f3a5-b355-57b5-aa8a-b453c572eb6c",
    "entry": "三河",
    "reading": {
      "primary": "みかわ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
