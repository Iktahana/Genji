    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それに、ラマルチーヌの、サント・ブーヴの、モンモランシイの、レカミエ夫人の、ミシュレの友情を招来したのだつた。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその二つの世界の限界を定めようとする時にドーミエーやゴヤやロートレークの或る作物をいずれの領分に配していいかを決定するのに迷うのである。",
              "citation": {
                "source": "漫画と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホガースやドーミエーからは享楽の影に潜む恐ろしさを味わわされる。",
              "citation": {
                "source": "漫画と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "名画をもじったタブロー・ヴィヴァンの中にダヴィドの「ルカミエー夫人」を模したのなどは美しかったが、シャバの「水浴の少女」をそっくりそのままベッドの前に立たせ、変なおやじが箒で腰をなぐろうとしている光景は甚だ珍妙ないかがわしいものであった。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日のリュミエール会社のオートクローム板は三色の澱粉を混合して作ったものだが、今度のは種板の上に三色の細い線を並べたもので大体の理窟は前のと変りはない。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　易者がニヤッと笑って、Ｔ「十八」　トホッと左膳、Ｔ「番茶も出花か」　易者が、Ｔ「名前はキミエ」　「ヘッ」と左膳が、Ｔ「その君江さん何処に居る」　易者が、Ｔ「それが分らん」　で左膳げっそりした。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、ハルカ　トオク　ノ　ホウニ、ミドリ　ノ　ミズ　ガ、カギリナク　ヒロク　ツヅイタ　セカイ　ガ　ミエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ　ヤマ　ノ　オヒサマ　ニ　カガヤイテ、チョウド　クンショウ　ノ　ヨウニ　ミエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（キケロの別墅はこゝを距ること遠からざるフオルミエにあり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "）友は語をつぎて、車主はこたびもモラ、ヂ、ガエタ（即ち昔のフオルミエ）の別墅に車を停むるならん、今は酒店となりて、眺望好きがために人に知らるといひぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "フジサンヤウミガミエルアイビキ！",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "フジサンヤウミノミエルアイビキ！",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "アミエルの乾物になるな。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ヒバリハ　スガタガ　ミエナク　ナルホド　タカク　ノボツタ　トキ　ウツクシイ　コヱデ　ウタヒハジメマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　タイヘン　ウツクシク　ミエタノデ　花タチハ　コノヤウナ　セカイニ　ウマレテ　キタ　コトヲ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ソノ　ウチニ　ノハラノ　ムカフニ　ムラガ　ミエテ　キマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テフテフガ　ミエナク　ナルト、コドモノ　デンデン蟲ハ、「アレ、ナアニ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハツパト　ハツパノ　アヒダニ、トホク　ミエル　モノ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンダマト　テフテフハ　タカイ　タカイ　トコロマデ　キマシタノデ、マチガ　ツミキザイクノヤウニ　チヒサク　ミエマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マモナク、アカイ　フウセンダマト　シロイ　テフテフハ　ミエナク　ナツテ　シマヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "見給え、ドーミエの口絵で、あの悪党坊主が嗤っているじゃないか」「あッ、鍵がある！",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがその中に、クミエルニツキー大迫害に関する詳細な記録があったのでございます。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へば、アミエルの日記は最上の日記のひとつと認められてゐる。",
              "citation": {
                "source": "日記と自叙伝",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "「景色とは、人間の心状態である」といつたスヰスの詩人アミエルの名句は、まさしく此處へ來て味はふことが出來る。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはアミエル自身が、自國の山影、湖光に對して、親しく味つた經驗に違ひない。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、清廉を看板にし売物にする結果が貧乏をミエにする奇妙な虚飾があった。",
              "citation": {
                "source": "三十年前の島田沼南",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "又或る時はレカミエエ式の、金の棕櫚の葉の刺繍をした服を着る。",
              "citation": {
                "source": "クサンチス",
                "author": "XANTHIS",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里から帰って　フランスへ出発前、中島健蔵氏から同氏訳のラミエルを貰ったので、向うでゆっくりフランスと引きくらべて読んでみようと思い、これだけ持っていったのに、それも読まずに持って帰って来た。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "招待状にもちょっと書いてあったように、九月の半ばに、スイスのセン・ティミエで、最初の国際無政府主義大会と言ってもいい、いわゆるセン・ティミエ大会の五十年紀念会があった。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
