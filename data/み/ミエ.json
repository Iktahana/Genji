        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "歌舞伎役者が見栄を切る姿は、観客を魅了する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "時代劇で、武士が見栄を切るシーンは迫力がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は舞台上で堂々と見栄を切り、大きな拍手を受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
