          "literary": [
            {
              "text": "黒ずんだ荒い幹肌の梅の樹が行く先に立ちはだかっている。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから庭の方へ通う木戸を開けて、手にした箒を茶の間の横の乙女椿の側へも持って行き、築山風な楓の樹の間へも持って行き、すっかり葉が落ちて幹肌のあらわな梧桐の根元のところへも持って行った。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹々の幹肌に寄生木が蒼黒い葉を茂らせ、蔦が梢をおおって這っていた。",
              "citation": {
                "source": "日の果て",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
