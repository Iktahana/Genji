[
  {
    "uuid": "a617861a-c964-50eb-a382-a86f029ce482",
    "entry": "神籤",
    "reading": {
      "primary": "みくじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
