      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "fortune slip (usu. bought at a shrine)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "初詣で神籤を引いたら「大吉」だったので、今年は良い一年になりそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「神籤の結果が悪くても、木に結んでおけば大丈夫だよ」と母が慰めてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "どの神籤を引くか真剣に悩みすぎて、後ろの人に少し迷惑をかけてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "今もお堂で御神籤を頂いたんですが、やっぱり凶と出たので……」と、女は苦労ありそうに細い眉を寄せた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            },
            {
              "text": "御奥の老女は御神籤を下しに行く。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "神籤を取れば凶と出る。",
              "citation": {
                "source": "半七捕物帳",
                "author": "朝顔屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "お岩稲荷のお神籤を取ってみたらば、凶と出たということでした。",
              "citation": {
                "source": "蜘蛛の夢",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "廓という世界に生きている人たちに対しては、うらないやお神籤が無限の権力をもっていた。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは試みに一銭銅貨を入れてみると、カラカラという音がして、下の口から小さく封じた活版刷のお神籤が出た。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍にもし霊あらば、どのお神籤にもみんな凶が出るに相違ないと思った。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは試みに一銭銅貨を入れてみると、からからという音がして、下の口から小さく封じた活版刷の御神籤が出た。",
              "citation": {
                "source": "春の修善寺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍にもし霊あらば、どの御神籤にもみんな凶が出るに相違ないと思った。",
              "citation": {
                "source": "春の修善寺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからもう一つ訊きたいのは、そのお福は占いに見て貰うとか、お神籤を頂くとか、そんな事をしますかえ」「はい。",
              "citation": {
                "source": "半七捕物帳",
                "author": "河豚太鼓",
                "note": "青空文庫"
              }
            },
            {
              "text": "相談じゃあない、占いを見て貰いに行ったんです」「白雲堂は前から識っていたんですか」「お福はお神籤とか占いとかいうものを信じる質で、田町の次郎吉の家へ縁付いている間にも、観音さまへ行ってお神籤を取ったり、白雲堂へ寄って占ったりしていたので、前々からお馴染であったんです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "河豚太鼓",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうまでゆくえの知れない以上はもう死んだものに決まっているのだが、それでも死骸を見ない以上はまだなんだか未練があるので、おかみさんは今日も浅草の観音さまへ御神籤を取りに行った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "新カチカチ山",
                "note": "青空文庫"
              }
            },
            {
              "text": "神籤のために、嫌々ながら、東下論に従っていた恭順論者は、再び自説を主張し始めた。",
              "citation": {
                "source": "乱世",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方東下論者の酒井、杉山は、神籤によって決った東下を、明日にも実行しようと迫った。",
              "citation": {
                "source": "乱世",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "占いやお神籤はこれまでにも、たびたび引いて見たことがある。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三番目の箱からは、これまた街路で拾った大きな真鍮ピン、長靴にうつ平鋲のちぎれたの、靴やスリッパーの扣金、真鍮の扉のハンドル、ステッキについている骨製の頭、「夢判断の神籤」その他の、つまり屑が沢山つまっているのであった。",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            },
            {
              "text": "安産のお守を受けたり、御神籤を引いている人もあります。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲店の雑沓をも今では少しも恐れずに観音堂へと急いで、祈願を凝した後に、お神籤を引いて見た。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "また御神籤を引いて」　継子は長さ二寸五分幅六分ぐらいの小さな神籤箱の所有者であった。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒塗の上へ篆書の金文字で神籤と書いたその箱の中には、象牙を平たく削った精巧の番号札が数通り百本納められていた。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日の予言はお神籤じゃないのよ。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "お神籤よりもっと偉い予言なの」「そう」　お延は後が聞きたそうにして、母子を見比べた。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「継子さん、今日はあたしがお神籤を引いて上げましょうか」「なんで？",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたの嬉しがるのを出して上げるから」　神籤に何の執着もなかったお延は、突然こうして継子と戯れたくなった。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ神籤箱を継子の机の上から奪い取りたかった。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "発作が静まった時、継子は帯の間に隠した帙入の神籤を取り出して、傍にある本箱の抽斗へしまい易えた。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "日參をして岡つ引に睨まれた日にや、江戸に怪しくない人間は幾人もゐないことになるぜ」「それが變なんで」「娘が綺麗過ぎるんだらう」「その綺麗過ぎる娘が、觀音樣にお詣りをするだけなら構はないが、必ず御神籤を引くのはどうしたわけでせう」「毎日か」「一日も缺かしません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "教科書の問題を解くのでも、おみくじかなんかを引くように、できるもできないのも運次第のものででもあるかのように思っていた自分のような生徒たちには、先生のこの説は実に驚くべき天啓であり福音であった。",
              "citation": {
                "source": "田丸先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "水をかけ終ると、やがて彼女たちはおみくじをひく。",
              "citation": {
                "source": "大阪発見",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "凶のおみくじをひいたときは、その隙間へおみくじを縛りつけて置く。",
              "citation": {
                "source": "大阪発見",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
