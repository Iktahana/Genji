        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その名刀は、一度見初めると忘れられないほどの凄みと美しさを兼ね備えていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この土地を初めて見初めた時から、ここで店を開こうと心に決めていたんだ」とオーナーが語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "骨董市で見初めた古びた時計に不思議な縁を感じて、思わず衝動買いしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
