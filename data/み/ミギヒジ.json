        "examples": {
          "standard": [
            {
              "text": "長時間のデスクワークのせいで、机に当たっている右ひじの皮がむけてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "転んだ拍子に右ひじを強く打ち付けてしまい、痛みがなかなか引かない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ピッチャーとしての選手生命を守るため、彼は右ひじの手術を受ける決断をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
