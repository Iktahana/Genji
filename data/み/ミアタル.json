[
  {
    "uuid": "789a791e-1691-5f2f-8e43-c6d92defc1ed",
    "entry": "見当たる",
    "reading": {
      "primary": "みあたる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
