    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to be found",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "野原を歩いていると、珍しい高山植物がいくつか見当たった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "警察の捜索により、ようやく事件の証拠となる遺留品が見当たった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この古い地図には、現代の道路と一致する箇所がいくつか見当たる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そういうおもしろい研究に対してもその研究題目それ自身に対していろいろの故障を申し立てる学者があると見えて、そういう「異端学者」の論文の中に、そういう故障への弁明の辞を述べ立てたのがおりおり見当たる。",
              "citation": {
                "source": "物質群として見た動物群",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上の三種類のものがもっとも現在でも多く見当たるところのものである。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、われわれがいう寿司らしい寿司を作る店は、そうたやすく見当たるものではなかった。",
              "citation": {
                "source": "握り寿司の名人",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼の音楽を見当たる限りことごとくやってみた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なに、書物の中で見当たる誤植のようなものさ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "足跡らしいものは多少みあたるが、草が倒れていないのはどうしたわけでしょう」　藤波は油断のない面つきで、切長なひと皮眼のすみからジロジロと顎十郎を眺めながら、「仙波さん、まア、そうとぼけないでものこってすよ。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "御代参の乗物",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はまた、日本の田舎の町辻にある涎掛けをかけた石の地蔵とか、柳の落葉をかぶっている馬頭観音とかいうものの姿が、直ぐ其処らにでも見当るような親しさで、胸に思い出して居た。",
              "citation": {
                "source": "褐色の求道",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なほ、再査すれば捨てるでもなかつたと思へるものもいくらかは見当る。",
              "citation": {
                "source": "文庫版『雀の卵』覚書",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧幕時代の文学のどこをどう尋ねてもこんな意味の訪問感想録はけっして見当るまいと信じます。",
              "citation": {
                "source": "文芸と道徳",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔のようにただうつくしいから玩ぶという心持は、今の僕には起る余裕がない」　兄さんはその時電車のなかで偶然見当る尊い顔の部類の中へ、私を加えました。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてはとその邇くを隈無く掻起しけれど、他に見当るものは無くて、倉前と覚き辺より始めて焦壊れたる人骨を掘出せり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者は東京市中の秘密出版物の景況を探る目的で、絵葉書屋を見当る毎度に飛び込んで、「男の裸体の絵葉書はないか」　ときいてまわった事がある。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "八十助は両眼をグルグル廻して何物か見当るものはないかと探した。",
              "citation": {
                "source": "火葬国風景",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのようなものを検べて居る余裕はないから、捨ててしまおうとは思ったが、事件のあった附近で発見したものだから、何か手懸りになるようなものが見当るかもしれないと思ったので、ポケットからシガレット・ライターを出して、その光の下に改めてみた。",
              "citation": {
                "source": "人造人間殺害事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際、「心理試験」ほどの傑作は、多産な英米の探偵小説界にも、めったに見当る作品ではないと私は断言して憚らぬ。",
              "citation": {
                "source": "「心理試験」序",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕が時々書く詩だの随筆だのは、見当る限り読んでるとのことだった。",
              "citation": {
                "source": "椎の木",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この近所に自動車はなかなか見当るまいと聞いて、彼はちょっと考えてる風だったが、帽子は忘れ、泥水にずぶ濡れになったまま、すたすた歩き出して、板倉邸の方へ行き、その裏口へはいってしまった。",
              "citation": {
                "source": "化生のもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台に比較して素敵に長いこの橋掛ぐらゐ暗示的なものは、世界の舞台芸術いづれを尋ねても見当るまい。",
              "citation": {
                "source": "能楽論",
                "author": "野口米次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "心魂も今は空になり、其処か此処かと求食るほどに、小笹一叢茂れる中に、漸く見当る鼠の天麩羅。",
              "citation": {
                "source": "こがね丸",
                "author": "巌谷小波",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の話はいざ知らず、今の世に二十六万の大軍を操る者が俺の外に見当るかな。",
              "citation": {
                "source": "二流の人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "精神科学――人間を単位にした学問には所詮解決は見当るまいと思はれるが。",
              "citation": {
                "source": "麓",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "都会にだつて、ざらに見当る筈のない美人ですもの」　葛子は、すでにひらりと立上つて、修吉が彼女について立上るのを疑ひもせぬ様子であつた。",
              "citation": {
                "source": "木々の精、谷の精",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが新古今系統のものに多く、万葉系統のもの例へば賀茂真淵のものなどにも見当るが、それは真淵の中の新古今風の歌に多い。",
              "citation": {
                "source": "『さびし』の伝統",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして斯く思想的大観的に歌うのは、此時代の歌には時々見当るのであって、その恩想を統一して一首の声調を完うするだけの力量がまだこの時代の歌人にはあった。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩三郎さんを殺した者は、容易には見当るまいよ――大方見当もついたことだろうが、あれは岩三郎さんを狙ったのでは無くて、兄のお前さんの命を狙ったのだ」「へェ――私も薄々そんな気がいたして居りました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "春宵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも注意して上の方で路を探せば、通れる所が見当るであろう。",
              "citation": {
                "source": "越中劒岳",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見当るものは、僕におなじみの群です。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "急に酔が発してきたような顔も見当るし、わざと、さりげない話をとってつけたようにし出す者もあるし、露骨に、「いよう、思いがけない美人がこのあたりへ匂って来たぞ。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "之を山男と謂ひ、稀には其｜糞を見当ることあるに鈴竹といふ竹葉を食する故糞中に竹葉ありといふ。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは「延宝伝燈録」などの審さなものを調べたら、記名ぐらいは見出されるかもしれないが、とにかくその事蹟とか人間については、ほとんど見当るものがない。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
