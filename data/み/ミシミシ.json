        "副詞-と",
        "動詞-サ変"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "with a creak",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古い木造アパートの階段を上がると、足元でミシミシと音が鳴った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "台風の強風に煽られて、窓枠がミシミシと不気味にきしんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "重い荷物を載せすぎた棚が、今にも壊れそうにミシミシと悲鳴を上げている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "まるで身体が壊れそうになってミシミシ云うんだ。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "声を聞きつけてミシミシと二階を下りてきて「ヤア」と現われたのが、一別以来三年会わなんだ桂正作である。",
              "citation": {
                "source": "非凡なる凡人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "船は、うめくような音をたてて、ミシミシときしりはじめました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、そのうちに、トランクの底のほうで、ミシミシいう音がしてきました。",
              "citation": {
                "source": "空とぶトランク",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたりは、まもなく、ミシミシと音をたてるほど、こおりついてきました。",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "しまいには、からだの中がミシミシいうほど、かたくこおりついてきました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぼくのからだの中が、いやにミシミシいうぞ」と、雪だるまが言いました。",
              "citation": {
                "source": "雪だるま",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、からだはつめたくこおりついて、ミシミシいっていました。",
              "citation": {
                "source": "雪だるま",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたりでは、ミシミシ、パチパチ、音がしています。",
              "citation": {
                "source": "雪だるま",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてミシミシという音響を発して真ン中の部分がまず頽れ始め、続いて、緑色の鉄と、煙を吐きつつある石炭と、真鍮製附属品と、車輪と木片と長腰掛とが、奈落の底をめがけて、滝つ瀬のようにくだけ落ちて行った。",
              "citation": {
                "source": "臨時急行列車の紛失",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ梯子段をミシミシいわせて上って来た下宿の女将が頓狂な声を張りあげた。",
              "citation": {
                "source": "科学者と夜店商人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹木の多いせいか、大きなササラでもすり合わせるような、さっさっさっさっと云う無気味な戦ぎが、津波のように遠くの方から寄せて来ると一緒に、ミシミシミシ柱を鳴して揺れて来る。",
              "citation": {
                "source": "私の覚え書",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小屋は海上の和船のようにゆれて、ミシミシ音がした。",
              "citation": {
                "source": "雪女",
                "author": "YUKI-ONNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミシミシという音がして、液体空気が奔騰した。",
              "citation": {
                "source": "人間灰",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "庵は余り新しくない建て物でありますから、ギシギシ、ミシミシ、どこかしこが鳴り出します。",
              "citation": {
                "source": "入庵雑記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝目を醒ますと、体がミシミシと病めてよろよろする程だった。",
              "citation": {
                "source": "夏蚕時",
                "author": "金田千鶴",
                "note": "青空文庫"
              }
            },
            {
              "text": "早くさあ」　と云ううちにミシミシと二階へ上って行く足音がする。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、滝人の胸の中で、凱歌に似た音高い反響が鳴り渡った、と云うのは、稚市の遠ざかるにつれて、廊下がミシミシと軋みはじめたからだった。",
              "citation": {
                "source": "白蟻",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、家全体がミシミシ気味悪げに鳴り出して、独楽のように風を切る音が、それに交った。",
              "citation": {
                "source": "白蟻",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お祝いをやろうと思っていたんだ」「お祝いとは豪気だな」柏はミシミシと壊れかかった藤椅子へ腰を下すと、絵具の附着いた指先で無雑作に卓上の煙草を抜出して口へ持っていった。",
              "citation": {
                "source": "日蔭の街",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは月も氷るという大寒が、ミシミシと音をたてて廂の上を渡ってゆく二月のはじめの夜中の出来ごとだった。",
              "citation": {
                "source": "電気看板の神経",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時、外では盲法師の悲鳴が三たび響き出しました、「わたくしには、どうしてわたくしが、これほどの目に遭わなければならないのですか、それがわかりません、お助け下さいまし」　井戸の車がミシミシと軋る音を聞いていると、盲法師は神尾の暴力を必死にこらえて、井戸の縄にとりすがっているもののようです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "小名路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「若い女だということだね」「いやいや男だということだ」「ナーニ一人の名ではなくて、団体の名だということだ」「飛天夜叉組ってやつか」「術を使うっていうじゃアないか」「摩訶不思議の妖術をね」「宮方であることには疑がいないな」「武家方をミシミシやっつけている」「何がいったい目的なんだろう？",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「万一のときのことを考えて私は二階に置いてある書きものの始末をつけてくるから」　こういって、「すぐ下りてくるけれど、構わないから先へお前たちは寝ておしまい」　手燭片手に、そのままミシミシ音させて梯子段を上がっていった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
