        "examples": {
          "standard": [
            {
              "text": "靴ブラシでていねいにほこりを払ってからクリームを塗ると、革靴が長持ちする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "出張から戻ると、まず靴ブラシを手に取って旅先の汚れを落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "靴ブラシは硬いものと柔らかいものを使い分けると仕上がりが美しくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "はつとして、バルカは靴ブラシをおとしました。",
              "citation": {
                "source": "子守つ子",
                "author": "アントン・チエーホフ　Anton Chehov",
                "note": "青空文庫"
              }
            },
            {
              "text": "パパと　ママは　からのふくろに　くさった　ペポカボチャ　みっつと　つかいふるしの　くつブラシを　ひとつ、　いたんだ　カブを　ふたつ　つめこみます。",
              "citation": {
                "source": "ばにばにきょうだいのはなし",
                "author": "THE TALE OF THE FLOPSY BUNNIES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
