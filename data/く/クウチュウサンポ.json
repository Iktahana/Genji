        "examples": {
          "standard": [
            {
              "text": "友人たちと一緒にヘリコプターで空中散歩を楽しむ計画を立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その贅沢なリゾートでは、空中散歩のツアーが人気アクティビティとなっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "晴れた日に小型飛行機での空中散歩をすれば、町全体の地形が見渡せる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "・風来坊はうたふ・風の歌　　（空中散歩）生活は水の流れるやうに――といふのが私の念願であつたが、今日へう／＼として風を歩いて、生き方は風のやうに――ありたいとも考へた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
