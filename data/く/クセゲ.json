        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は自分の癖毛をいつも気にしているが、私はそれが個性的で素敵だと思う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "朝の支度で、癖毛をまとめるのに時間がかかってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "湿気の多い日は癖毛が広がりやすいので、ヘアケアには気を使っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "あれの峭然と外眥の昂つた所が目標さ」蒲「さうして髪の癖毛の具合がな、愛嬌が有つたぢやないか。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどい癖毛を銀杏返に結つた、面皰の痕の滿面にはびこる、くりくり肥つた、二十六七には確かになる女だつた。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪の毛も叔母によく似た癖毛である。",
              "citation": {
                "source": "帰つてから",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪なんて――くせっ毛だし、目は――見るだけのものだし、唇は――しゃべりやすくしてるだけ。",
              "citation": {
                "source": "ＲＵＲ――ロッサム世界ロボット製作所",
                "author": "R.U.R. (ROSSUM'S UNIVERSAL ROBOTS)",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどく硬さうなクセ毛の濃い額ぎはをした小男だつた。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
