        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そら、むすこが、エングランド、ロンドンにいて、おやじがスコットランド、カルクシャイヤにいた。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おまえは英語はわかるかい、ね、センド、マイブーツ、インスタンテウリイすぐ長靴送れとこうだろう、するとカルクシャイヤのおやじめ、あわてくさっておれのでんしんのはりがねに長靴をぶらさげたよ。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ははあ、こいつらはラクシャンの四人兄弟だな。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラクシャンの四人兄弟だ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番右はたしかラクシャン第一子まっ黒な髪をふり乱し大きな眼をぎろぎろ空に向けしきりに口をぱくぱくして何かどなってゐる様だがその声は少しも聞えなかった。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "右から二番目はたしかにラクシャンの第二子だ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "次はラクシャン第三子やさしい眼をせはしくまたたきいちばん左はラクシャンの第｜四子、末っ子だ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "楢ノ木大学士がもっとよく四人を見ようと起き上ったら俄かにラクシャン第一子が雷のやうに怒鳴り出した。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜならラクシャン第一子はやっぱり空へ向いたまゝ素敵などなりを続けたのだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」しづかなラクシャン第三子が兄をなだめて斯う云った。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの若い第｜四子が微笑って兄をなだめ出す。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの狂暴な第一子も少ししづまって弟を見る。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」若いラクシャン第四子は兄のことばは聞きながし遠い東の雲を被った高原を星のあかりに透し見てなつかしさうに呟やいた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第三子が少し笑って弟に云ふ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」暴っぽいラクシャンの第一子が金粉の怒鳴り声を夜の空高く吹きあげた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第｜四子はしょげて首を垂れたがしづかな直かの兄が弟のために長兄をなだめた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第一子は尚更怒って立派な金粉のどなりをまるで火のやうにあげた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第三子はしばらく考へて云ふ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」暴っぽいラクシャン第一子がこのときまるできらきら笑った。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "暴っぽいラクシャンの第一子がずゐぶんしばらく光ってからやっとしづまって斯う云った。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第三子もつい大声で笑ってしまふ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ところがラクシャン第一子は案外に怒り出しもしなかった。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」俄かにラクシャンの末子が叫ぶ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャン第一子がびっくりして叫ぶ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」その声にラクシャンの第二子がびっくりして眼をさまし、その長い顎をあげて、眼を釘づけにされたやうにしばらく野火をみつめてゐる。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」するとラクシャンの第一子がちょっと意地悪さうにわらひ手をばたばたと振って見せて「石だ、火だ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばかなラクシャンの第二子がすぐ釣り込まれてあわて出し顔いろをぽっとほてらせながら「おい兄貴、一｜吠えしようか。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しづかなラクシャン第三子がラクシャンの第｜四子に云ふ「空が大へん軽くなったね、あしたの朝はきっと晴れるよ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
