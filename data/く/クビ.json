  {
    "uuid": "da71cf70-4556-5616-8b84-bf6c52c8df6e",
    "entry": "頸",
    "reading": {
      "primary": "くび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "水にぬれた紙のごとく、とんと手ごたえがなく、頸も手も腰にも足にも、いささかだも力というものはない。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "しなやかに光沢のある鬢の毛につつまれた耳たぼ、豊かな頬の白く鮮かな、顎のくくしめの愛らしさ、頸のあたり如何にも清げなる、藤色の半襟や花染の襷や、それらが悉く優美に眼にとまった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとに民子さん、きょうというきょうは極楽の様な日ですねイ」　顔から頸から汗を拭いた跡のつやつやしさ、今更に民子の横顔を見た。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "火気の満たる室にて頸やいたからん、振あぐる鎚に手首や痛からん」　女は破れ窓の障子を開らきて外面を見わたせば、向ひの軒ばに月のぼりて、此処にさし入る影はいと白く、霜や添ひ来し身内もふるへて、寒気は肌に針さすやうなるを、しばし何事も打わすれたる如く眺め入て、ほと長くつく息、月かげに煙をゑがきぬ。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜田川守貞の『近世風俗志』に「首筋に白粉ぬること一本足と号つて、際立たす」といい、また特に遊女、町芸者の白粉について「頸は極て濃粧す」といっている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上、「いき」の身体的発表｛３｝を、特にその視覚的発表を、全身、顔面、頭部、頸、脛、足、手について考察した。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "躯幹、肩、頸、首、腕、手、指は心的表現の道具である」（Albert Maybon, 〔Le the'a^tre japonais〕, 1925, pp. 75-76）。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前のほつそりした頸すぢお前のながくのばした髮の毛ねえ　やさしい戀びとよ私のみじめな運命をさすつておくれ私はかなしむ私は眺めるそこに苦しげなるひとつの感情病みてひろがる風景の憂鬱をああ　さめざめたる部屋の隅から　つかれて床をさまよふ蠅の幽靈ぶむ　ぶむ　ぶむ　ぶむ　ぶむ　ぶむ。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はその憎々しい奴どもの頸を引っつかんで、床にいる猫の鼻先へ、無理にもぐいぐいと押しつけてやろうとする、強い衝動を押えることができなかった。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして本能的な憎悪の感情に熱しながら、いきなり一人の婦人客の頸を引っつかんだ。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その婦人客の細い頸は、夫人の熱した右手の中で、死にかかった鵞鳥のようにびくびくしていた。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小羊の頸ふる鈴の優し音に似しともききし野行く春風。",
              "citation": {
                "source": "短歌",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大泥醉の粹背肌、弓手を拳で懷中に蓄へ、右手を延ばして輪を畫くと、手頸をぐいと上げて少し反身のかたち。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頸の處はお蔭で樂になつた。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きい猫が頸ふりむけてぶきつちよに一つの鈴をころばしてゐる、一つの鈴を、ころばして見てゐる。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "剃りたての、頚条も手頸もどこもかしこもそはそはと、寒かつた。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上思想を持込むなぞは野蛮人がありつたけの頸飾りを着けるがやうなものだ。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてこそ、かの成巧者達が、大抵頸の硬い中庸主義者であり、殆んど理論なくカンでばかり体験し、苦労を咬み殺した人達であることが分ります。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "（男一足下つて首をクネクネ廻して、頸の凝りを直す）夢だ…………常識主義者だ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "木々が若い学者仲間の、頸すぢのやうであるだらう。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "しどけなき、なれが頸は虹にしてちからなき、嬰児ごとき腕して絃うたあはせはやきふし、なれの踊れば、海原はなみだぐましき金にして夕陽をたたへ沖つ瀬は、いよとほく、かしこしづかにうるほへる空になん、汝の息絶ゆるとわれはながめぬ。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "靴の磨きようが悪いと、その靴を頚に引っかけさせられて、各班を廻らせられる。",
              "citation": {
                "source": "入営前後",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "型のくずれた中折を冠り少しひよわな感じのする頚から少し厳った肩のあたり、自分は見ているうちにだんだんこちらの自分を失って行った。",
              "citation": {
                "source": "泥濘",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勤めていた石川島の方の会社で、いくらか信用ができて株などに手を出していたが、頚に白羽二重を捲きつけて、折り鞄を提げ、爪皮のかかった日和下駄をはいて、たまには下宿へもやって来るのを、お庄もちょいちょい見かけた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩つきのほっそりしたこの叔父と、頚の短い母親とが、お庄には同胞のようにも思えなかった。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "帽子も冠らないで、ピンヘットを耳のところに挟んだような、目容のこわらしい男や、黒足袋をはいて襷がけしたような女の往来している中に、子供の手を引いた夫婦連れや、白い巾を頚に巻いた女と一緒に歩いている、金縁眼鏡の男の姿などが、ちらほら目についた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "お庄は急いで合せ鏡をしながら、紙で頚などを拭いて、また叔父のところへ駈けつけた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "頚筋や肩のあたりが、叔母のいたころから比べると、著しい痩せが目立って、影が薄いように思えた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "芳太郎はそこにあった盃洗を取って投げつけるし、お庄は胸から一杯に水を浴びながら、橋廊下の方へ逃げて行って、手※で頚首などを拭いていた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょッとああいったようなね、頚つきでしたの。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
