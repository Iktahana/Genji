        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "聖ポール寺院★の大鐘が澄みわたった空気の中で一時を鳴らした頃、ロリー氏は、長靴を穿いて提灯を持ったジェリーに護衛されて、クラークンウェルへの帰途に就いた。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソホーとクラークンウェルとの途中には処々に淋しい路があったので、ロリー氏は、追剥の用心に、いつでもジェリーをその用事に雇っておいたのだ。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラークンウェル　　ロンドンの本市の北にある区域。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソホー広場の東方約一マイル半、クラークンウェルの南にある。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
