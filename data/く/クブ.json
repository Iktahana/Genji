        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ストライクブレーカーはおあいにくであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふといロイド眼鏡かけて、ことし流行とやらのオリンピックブルウのドレス着ている浅田夫人、幼な名は、萱野さん。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分でも吹きだしたいくらいブクブクと肥った彼女が、まるで袋のようなそんな不細工な服をかぶっているのを見て、洋裁学院の生徒たちは「達磨さん」と称んでいた。",
              "citation": {
                "source": "旅への誘い",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "エキスパンドブックを読むためのブックブラウザーという小道具を、彼らは無料で公開してきました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "些し水層が増そうものならブクブク往生しようと云うんだ。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに、そこまで行くのには、ずいぶん長いあいだ、ブクブクとあわのたっている、あついどろの上を行くほかには道がありません。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "（中略）私ノ町ノ知的素養ノイクブンナリトモアル青年デモ、自分トイウモノニツイテ思イヲメグラス人ハ少ナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トモ子、おまえ、いまにブクブクに太るぞ」　トモ子は、イーだ、と鼻をクシャクシャにし、長いひものついた、巾着の親玉のようなバッグをふりまわし、高志を一撃した。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "進歩性が少ないといふことは、絵を見るよりも、その絵を収めてゐるガクブチを見ればそれを雄弁に語つてゐる。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまや私は決闘の時間だ、私に悠々閑々たるたたかひの時間を与へよ、いまや私は食事の時間だ、舞台の上のレストランだ、ビールはほんものだし、ブクブク泡の立つた奴だ、私はこいつをグイとひつかけて幾分酔ふ、滑稽なコロッケに憂鬱なソースをかけて喰ふ私の演技のこまかいところを買つてくれよ。",
              "citation": {
                "source": "小熊秀雄全集-5",
                "author": "詩集（４）小熊秀雄詩集２",
                "note": "青空文庫"
              }
            },
            {
              "text": "風がね」　とロイド眼鏡をひからせてまっ先に乗り出してきたのが、「スター紙」の山岳通マクブリッジ君。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆が力一杯引き揚げるが、ちょうど水面から、一間ばかり離れると、縄を引いている連中の力が抜けて、ダラシなく縄を緩めるので、女優は、水音高く再び水中に落込んでブクブクやる。",
              "citation": {
                "source": "死者を嗤う",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのまま、「……アアッ……ああッ……」　と藻掻き狂いながらブクブクブクと沈んで行く。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "血だらけの櫓柄を洗って、臍に引っかけると水舟のまま漕ぎ戻して、そこいらのブクブク連中をアラカタ舷の周囲に取付かせてしまったので、とりあえずホッとしたもんだ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャフトのアトからブクブクブクと来るんだ。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな禿頭のようにブルブル震えている股の切口と、ブクブクした敷蒲団ばかりである。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういえばあの角屋の青柳喜平はまあだ三十四五にしかならんのに豚の様ブクブク肥えとる。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その下の畳はブクブクに膨れて、何ともいえない噎せっぽい悪臭を放っていた。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モトは学校の作法教室だったそうですが、今では壁も瓦も落ちて、ペンペン草が一パイに生えて、柱も階段も白蟻に喰われて、畳が落し穴みたいにブクブクになっております。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関には鉾を持った門番が一人立っていたが、そいつが、まるで伯爵みたいな面がまえで、バチスト麻のカラーをつけているところは、何のことはない、ブクブク肥らされた狆にそっくりなんでね……。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "（九月十日）百二十二○一日のうちに我｜痩足の先｜俄かに腫れ上りてブクブクとふくらみたるそのさま火箸のさきに徳利をつけたるが如し。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "裾はひきずり、手なんかスッカリかくれて、ブクブクです。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "腰掛けは得たいが知れない程ブクブクして柔かである。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "天井から豆がおちて来たねずみのイントクブッシかな西どなりで水の音がする　これも金井君のうたったもの。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "腰掛けは得たいが知れない程ブクブクしていた。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき横顔がチラリと見えたが、四十を二つ三つ越したかと思われるブクブクと肥えた中年女であることがわかった。",
              "citation": {
                "source": "西湖の屍人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "復興新市街をもった帝都の昼間は、アスファルト路面が熱気を一ぱいに吸いこんでは、所々にブクブクと真黒な粘液を噴きだし、コンクリートの厚い壁体は燃えあがるかのように白熱し、隣りの通にも向いの横丁にも、暑さに脳髄を変にさせた犠牲者が発生したという騒ぎだった。",
              "citation": {
                "source": "省線電車の射撃手",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
