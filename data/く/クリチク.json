        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "チクリチクリと狙っては揉み通すその右肩は居合斬りに限らず、武芸鍛練の者にとっては大事な急所で厶ります。",
              "citation": {
                "source": "十万石の怪談",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "激しい疼痛が、彼の神経をチクリチクリと刺戟したが、歯を喰いしばって地上に坐りなおした。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "イムベルのところ　　フランスの色調、トミスという犬、　ジェリンスキー、構成派のクリチク　　アメリカに行きたい　　アメリカの New インテリゲンチャの好奇心。",
              "citation": {
                "source": "一九二七年八月より",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "疎開者を入れるにしろダイヤモンドにかすにしろ自分達は暮しかたを変える、それについて国チクリチクリ妙に底意地のわるいことをいう。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうすれば、こう感じるということを、千も万も承知でいながら、チクリチクリと苛なんでは、苦しむ彼をなぶり者にしていたのである。",
              "citation": {
                "source": "日は輝けり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お銀様はそれをチクリチクリと深く刺し込みます。",
              "citation": {
                "source": "大菩薩峠",
                "author": "小名路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど鬼が、一寸法師と一緒に針をのみ込んだように、その針が、すなわち、自分自身の批判精神が、チクリチクリと自分を刺しはじめるのである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の時は私は居合はせなかつたが、満座の中で氏が吉井の戯曲の悪口を云ひ出して、それも遠廻しにチクリチクリと搦んで来るので、「そんなことを云つたつておめへには書けめえ」と、吉井が憤然としてタンカを切つた。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう私も、芥川のように正面切っては書かなかったが、遠廻しにチクリチクリ書いた覚えは数回ある。",
              "citation": {
                "source": "文壇昔ばなし",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "切ったあとがチクリチクリ痛む。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おりから後ろの机の横田生が先生の目をぬすみながら、チクリチクリと正三君の背中をつねりはじめた。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "よし、ひとつまたチクリチクリ嫌がらせをいってやらなくっちゃならねえ」　と、隣の部屋からニジリ出して、境の襖を少し開けた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寸だめし五｜分だめしに、チクリチクリと急所を突いて行った。",
              "citation": {
                "source": "恐ろしき錯誤",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
