    "definitions": [
      {
        "index": 1,
        "gloss": "to incur the wrath of god (e.g. by speaking ill of someone behind their back)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「そんな罰当たりなことを言うと、死んでから口が曲がるぞ」と祖母に脅された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "仏様を馬鹿にした罰で口が曲がったという昔話を聞いて、子供心に震え上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「嘘をつくと閻魔様に舌を抜かれるし、悪口を言うと口が曲がるんだよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「可能性」などとはおこがましくて口が曲がる。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ、いつも、こういうふうにシャチコ張っている、曾根権太夫という人のことさ」「これは怪しからん、かりそめにも、秋元六万石の御家老をさして、おやじなどと申すと口が曲がるぞ」「でも、万太郎様が、おやじをすぐに呼んで来いといったんです」「御家老はまだお城からお退がりになりません。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、とげのある、こけももだけは、まだ実をむすんでいましたが、こけももはすっぱくて、くちがまがるようでした。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to warp one's mouth",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "脳梗塞の後遺症で、彼は少しだけ口が曲がってしまったが、懸命にリハビリを続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は怒ると口が曲がる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子どもが不満そうに口が曲がっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
