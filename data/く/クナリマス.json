          "literary": [
            {
              "text": "」「困リマス、バロメーの水銀無クナリマス」「……驚いたなあ……また時化るんですか」　運転手は返事せずに、階段の方向へ駈け出した。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ニ行クホド暑クナリマス」正直ノトコロ、予ハ手ノ痛サニ閉口シテ晝ノ部ヲ見ルノハ止メヨウカト思ッテイタノダガ、婆サンニ窘メラレタノデ却ッテ依怙地ニナリ、痛イノヲ怺エテ明日ノ晝ニ又来ヨウカト思ッテイタノダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩カズニイルト、今ニ本当ニ歩ケナクナリマスト嚇カサレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供達ガ来ルトウルサクナリマスカラ、早イ方ガヨゴザンスヨ」ト、婆サンガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニヨクナリマスヨト婆サンハ云ッタガ、ドウヤラコウヤラ少シ楽ニナリカケテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソバデ煙草ヲオ吸イニナッタラ、ゴホン／＼オ咳ガ止マラナクナリマスヨ」「ボーイサン、ソノトランクヲコッチノ部屋ヘ運ンデ頂戴」颯子ハ構ワズサッサト隣室ヘ這入ッテ行ッテシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
