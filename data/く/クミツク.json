[
  {
    "uuid": "05e3641f-95db-554b-a2fb-648150c99b20",
    "entry": "組み付く",
    "reading": {
      "primary": "くみつく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
