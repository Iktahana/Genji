  {
    "uuid": "dcf49ef0-7e2f-5b92-a5b3-285b082a264d",
    "entry": "クデ",
    "reading": {
      "primary": "くで",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『ドクター・ドブズ・ジャーナル』というおかしな名前をでっち上げたのは、『ＰＣＣ』のデザイン関係の作業を一手に引き受けていたグラフィックデザイナーのリック・バカリンスキーだった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "エキスパンドブック版のブックデザインは、永原康史さんに力を奮っていただいた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけは少年にも読めたと見えて、「ムクデン」「ムクデン」と誰にいうともなく少年は大きな声で繰返した。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る楼へ遊びに行ったら、正太夫という人が度々遊びに来る、今晩も来ていますというゆえ、その正太夫という人を是非見せてくれと頼んで、廊下鳶をして障子の隙から窃と覗いて見たら、デクデク肥った男が三枚も蒲団を重ねて木魚然と安座をかいて納まり返っていたと笑っていた。",
              "citation": {
                "source": "斎藤緑雨",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシマズ最初ニ新聞ダケデモカタカナニナツテシマエバアトハ割合ラクデアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときどきバランスを崩して倒れながら、登りの何倍もの骨を折ってようやくルックデポに着いた。",
              "citation": {
                "source": "春の遠山入り",
                "author": "松濤明",
                "note": "青空文庫"
              }
            },
            {
              "text": "二度目に彼女に会ったのは、それから数カ月を経たロンドンのあるウイークデーの、閑寂な朝の公園であったっけ。",
              "citation": {
                "source": "暴風雨に終わった一日",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "――マスミサン、貴女ノ兄サンノ四ツ木鶴吉氏ハ、先月ノ二十九日ノ夜、本所ノ亀井戸近クデ殺害サレマシタ。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今見たいにこんなにデクデク肥っちゃいませんが、中肉中背という奴で頬っぺたも赤くて、桜の蕾かなんぞのように少しふくらんでいましたよ。",
              "citation": {
                "source": "三角形の恐怖",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒコートウノコージハオモイノホカハヤクデキアガルコトガワカッタタブン三シユウカンノノチトオモワレル。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名な真空の実験に、「マクデブルクの半球」というのがある。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "キット覚エテオクデス。",
              "citation": {
                "source": "夏の日の夢",
                "author": "THE DREAM OF A SUMMER DAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、きょうは私はホクホクデイなわけです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月三十日　〔巣鴨拘置所の顕治宛　目白より（封書）〕　六月三十日　　第五十七信　きょうもホクホクデェイと申すわけです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、モスクデ　オコツテイルトアタマニワルイ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "従業員の賃金を２・１／２パーセント切下げているうちに、鉄道事務員組合書記エー・ジー・ワークデン氏のところでは年俸二百五十ポンドが年俸千ポンドに上昇しつつある。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ショウワユウゲキタイヲ、オソレルナ……コウフクヲトリケシ……ゼンソクリョクデ、ニゲヨ……」「畜生ッ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなれば著者の考え方と思想とは、もしも著者が文化的なロクデナシででもない限り見当がつくものだ。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカライクラ、オモシロクツテモ、アンマリナガク水ノ中ニハイツテヰルト、カラダニドクデスカラネ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが漢訳が全部出たのみならず胡語ソクデヤ（※利）の言語で翻訳した物が出た。",
              "citation": {
                "source": "東洋文化史における仏教の地位",
                "author": "高楠順次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソクデヤというのはギリシャ人とペルシャ人と一緒になったような人種であります。",
              "citation": {
                "source": "東洋文化史における仏教の地位",
                "author": "高楠順次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロクデナシメ、覚えてゐやがれ、と失踪してしまつた。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "百人が百人ながら大バカヤロウのロクデナシと云ってるな。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロクデナシメ、覚えていやがれ、と失踪してしまった。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それこれと当時の事を思い出すにつけて兼太郎は娘のお照が顔立は母に似ているが身体付は自分に似たものかそれほどデクデクもしていないのを見ると共に、あの母親の腋臭はどうなっただろうと妙な処へ気を廻した。",
              "citation": {
                "source": "雪解",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は十一時で、ウイークデー、こんなすさまじい天気だというのに、説教があろうなどと考えることはばかげていた。",
              "citation": {
                "source": "審判",
                "author": "DER PROZESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてヒヨイと目を上げると、列車の最後の車――第三番目の後尾の車掌室（非常に狭い場所）の所に、デクデク肥え、鼻が上を向いた車掌が腰かけて、非常に小さな眼を眠さうに開けたままウツラウツラとしてゐたのが、ヒヨイと眼を開ける。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "年上も年上、年上過ぎらい、あのデクデク婆。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "デクデクに肥って小金を貯めていると評判だった。",
              "citation": {
                "source": "圓太郎馬車",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
