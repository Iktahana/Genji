[
  {
    "uuid": "87aa1ebb-d66a-566c-9fe4-78ea4320f58e",
    "entry": "屈服",
    "reading": {
      "primary": "くっぷく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
