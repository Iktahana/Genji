        "examples": {
          "standard": [
            {
              "text": "不要になった自転車は、くず鉄として回収された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "工場から出るくず鉄は、リサイクルされて再利用される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "港には大量のくず鉄が積み上げられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ボースンは、横浜へ帰って、全く、くず鉄の山の中の一本のねじ釘のように、わずかに存在しているに止まった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
