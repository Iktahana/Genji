          "literary": [
            {
              "text": "要吉の仕事の第一は、毎朝、まっさきに起きて、表の重たい雨戸をくりあけると、年上の番頭さんを手伝って、店さきへもちだしたえんだいの上に、いろんなくだものを、きれいに、かざりたてることでした。",
              "citation": {
                "source": "水菓子屋の要吉",
                "author": "木内高音",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、オオカミは、あっさりみんなを見つけだして、大きな口をぱっくりあけると、かたっぱしからのみこんでしまいました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            }
          ]
        }
