        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕等は、子供の時から、その嘉平と利吉に、「クソノカス」にどなられて育った。",
              "citation": {
                "source": "自伝",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシモコレヲ不調和ト感ジル人ガアツタラオソラクソノ人ガカタカナヲ見ナレナイセイカ、ソウデナカツタラ数学ノ本デ十分ニ痛メツケラレタ記憶ヲ持ツ人ニチガイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ問題ハオソラクソノアトノ場合デアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "余モマタ深クソノ為ス所ヲ惜シムトイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "是ヲ以テ能クソノ機宜ヲ詳ニシソノ形勢ヲ悉クス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "文名世ニ高キモシカモ或モノハ深クソノ学アルヲ知ラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "『本草綱目啓蒙』によればゴンズイのほかにキッネノチャブクロ、スズメノチャブクロ、ウメボシノキ、ツミクソノキ、ハゼナ、クロハゼ、ダンギナ、ハナナ、ダンギリ、タンギ、クロクサギ、ゴマノキの名がある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナカンズクソノ下半身ヲホントウニ残ル隈ナク見ル、下腿部ガヤヤＯ型ニ外側ヘ彎曲シテオリ、遺憾ナガラマッスグトハ云イニクイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カツテノ執権、最明寺時頼ノ母スラ、自ラ破レ障子ヲ繕ウテ、勤倹ノ教ヘヲ垂レタリト聞クソノ松下ノ禅尼ノ子孫高時、今ハ数十人ノ妾ヲ蓄へ、妾ニハ領地ヲ分カチ、白拍子、猿楽、田楽俳優ナド、府内二千人ヲ超ユルニイタル。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
