        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "インフルエンザは空気伝染するため、満員電車の中でのマスク着用が強く推奨されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "空気伝染の経路を断つべく、隔離病棟では廊下との間に陰圧設備が設けられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "結核は空気伝染性の感染症なので、患者の隔離と換気の徹底が院内感染防止の基本となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "この一節はいわゆる空気伝染をなす病気の実例として付け加えられたものであろう。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どすは空気伝染じゃぞ。",
              "citation": {
                "source": "映画と癩の問題",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったく新しき趣味、新しき雰囲気、新しい色彩、新しい考えは流感における空気伝染の如くいつの間にか隅々まで拡がっている。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがしかし、よく交際の間にうつされる流行病、空気伝染によって生ずる流行病には、わたしはかかりやすくない。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
