        "examples": {
          "standard": [
            {
              "text": "ミルクをクオート単位で購入する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "レシピではクオート分のバターが必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "クオートは米国での容量の標準単位である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "…… Jewel of world（「世界の宝石」）という絵入りの英語本がございますが、何かお調べになるんならお目にかけましょうか」　といって奥の本棚から、クオート版の大きな本を持ち出して来た。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
