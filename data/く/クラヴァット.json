          "literary": [
            {
              "text": "」七　クラヴァット　ここに自然、省いてならない一事を述べておかなければならない。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "オリウールの峡路を荒した山賊ガスパール・ベスの一隊が瓦解した後、その首領の一人であったクラヴァットという者が山中に逃げ込んだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラヴァットはアルシュおよびその向こうまで山を占領していたのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「クラヴァットよりビヤンヴニュ閣下へ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
