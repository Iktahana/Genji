  {
    "uuid": "adeecef6-255b-5f81-a91b-acc30165dd89",
    "entry": "くんくん",
    "reading": {
      "primary": "くんくん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」僕は鼻をくんくんさせた。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "帽子の下に天子印の、四五間さきの空気をくんくんさせる高価な化粧品をしのばせていた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "校長さんの狐は下を向いて二三度くんくん云ってから、新らしく紅茶を私に注いでくれました。",
              "citation": {
                "source": "茨海小学校",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから二人はうちの方へ蚊のくんくん鳴く桑畑の中を歩きました。",
              "citation": {
                "source": "革トランク",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間雑木林の下道のゆるやかな坂を曲り、竹煮草の森のような茂みの傍を通り、仄白い野菊の一ぱい咲いている野原の一片が眼に残り、やがて薄荷草がくんくん匂って里近くなって来た往還で、かの女はタクシーを拾って、東京の山の手の自宅へ帰って来た。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓄膿症でもあるのか鼻をくんくん鳴らして居る。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷畑から採って来た鮮かな山葵の束が縁につけてあるのがくんくん匂う。",
              "citation": {
                "source": "呼ばれし乙女",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると森までががあっと叫んで熊はどたっと倒れ赤黒い血をどくどく吐き鼻をくんくん鳴らして死んでしまうのだった。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして鼻でくんくん嗅ぎまわりました。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お増はくんくん鼻を鳴らしながら、なつかしい主の膝や胸へ取りついて来る愛物の頭を撫でながら、買って来た干菓子などを壊して口へ入れてやった。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬は肉屋の注意を引くように、ときどきくんくん鼻をならしてはこっちを見ます。",
              "citation": {
                "source": "やどなし犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬は、そのへんなもののまえに、くわえて来た肉のきれをおいて、くんくんなきつづけました。",
              "citation": {
                "source": "やどなし犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言うように、くんくん言っていましたが、それでもまだ食べようとしないので、相手の食慾をそそろうとするように、その肉のきれのかどを、小さく食い切って、ぺちゃぺちゃと食べて見せました。",
              "citation": {
                "source": "やどなし犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言わぬばかりに、しきりにくんくんないたりしました。",
              "citation": {
                "source": "やどなし犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　あくる朝、肉屋がいつもの時間に店をあけますと、犬はもうちゃんと来てまっていて、くんくん言いながら尾をふります。",
              "citation": {
                "source": "やどなし犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬は、つれの犬を肉屋にひきあわすように、くんくん言い言い尾をふりました。",
              "citation": {
                "source": "やどなし犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉屋の二ひきの犬は肉屋の足もとへとんで来て、くんくん言ってよろこびました。",
              "citation": {
                "source": "やどなし犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうひとつの犬は、かなしそうに、くんくんなきなきうろうろしていました。",
              "citation": {
                "source": "やどなし犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐに押し入りますか」　斬らぬうちから、もう血の匂いでもがしているとみえて、鼻のひしゃげた市原小次郎が、ひしゃげたその鼻をくんくんと犬のように鳴らし乍ら、隣りの神代の袖をそっと引いてささやいた。",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あの、お待ちかねですから、お早く願います……」　せきたてるようにまた呼んだ表の声をききながら、不審そうに首をかしげて、しきりと鼻をくんくん鳴らしていたが、不意に名人がおどろくべきことをいって立ちあがりました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血の降るへや",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤がいつものようにぴしゃぴしゃと飯へかけてやった味噌汁を甞める音が耳にはいったり、床の下でくんくんと鼻を鳴らして居るように思われたり、それにむかむかと迫って来る暑さに攻められたりして彼は只管懊悩した。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして棚の上のさまざまの形ちの青や赤の酒瓶が眼についた、ぷんぷんとお美味い酒の匂ひを嗅ぐと馬賊の大将はたまらなくなつて鼻をくんくん鳴らした。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
