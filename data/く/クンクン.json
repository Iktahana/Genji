        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "飼い主が家を出たとたん、犬は寂しそうにドアの前でクンクンと鳴き始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「もう、クンクン言わないの。散歩は雨が止んでからよ」と母がなだめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "迷子になった仔犬は、段ボールの中でクンクンと細い声で鳴いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
