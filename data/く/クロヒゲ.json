        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "能楽師は黒ひげの面を付けた瞬間、鬼神の形相をまとい、舞台の空気が一変した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "楽屋で師匠は弟子に「黒ひげを使う場面は気迫が何より大切だ」と教えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "博物館に展示された室町時代の黒ひげは、目の彫りが深く、見る者を圧倒する迫力があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
