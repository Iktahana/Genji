        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "因ニ云フ、確乎タル証拠ナシト雖モ、旧来ヨリ言伝ヒ聞伝ヒヲ参考スルニ、山野等ノ名称粗々縁故アルモノヽ如クナレバ、記シテ後来ノ識者ニ俟ツノミ。",
              "citation": {
                "source": "尾瀬の昔と今",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレマデノ間ニソット二階カラ下リテ消エテナクナレバイヽ筈デアッタノニ、彼等ノ方ニモ計算違イガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉体ガナクナレバ意志モナクナル道理ダケレドモ、ソウトハ限ルマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒドクナレバ失心スルハナカッタノダガ、今日始メテ測ラセラレ、心電図ヲ取リ、腎臓ノ検査モサセラレル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
