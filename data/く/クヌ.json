        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ああ、そう言う人もあるが、イクヌーモンとも言う。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾根にたどりついた高志が、ひゅー、といって立ちどまり、クヌギに手をついた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "コナラだのクヌギだのといった高い木、クワやアケビなどの低い木、笹や大きなシダ類などにさえぎられて、地肌こそ見えないが、ここからは、山裾が谷間にたたみこまれていくのが見える。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "丘を大きく迂回する道をとらず、三人はクヌギやカエデのあいだをぬって、ゆるやかな斜面をいく。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その設計に従ってその時自分がヌクヌクともぐり込もうとした坑の、何と、うじうじと、ふやけた、浅間しくもだらしないものだったか。",
              "citation": {
                "source": "狼疾記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはブリッジの名手と云われた、クヌト・ライデンの逸話なのです。",
              "citation": {
                "source": "白蟻",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「クヌルプ」（岩波文庫・漂泊の魂）には、この作家の弱点というべきものが典型を示していて、人間の生命の浪費が、当然向けられるはずの疑問もなく美化して呈出されているのである。",
              "citation": {
                "source": "若き精神の成長を描く文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　クヌウト・ハムスンだって、こんな行きがかりは持たなかっただろう――。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはうらやましい、たしか、クヌウト・ハムスンの『飢え』と云う小説の中にも蝋燭を買いに行って、五クローネルのつり銭と蝋燭をただでもらって来るところがありましたね。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはうらやましい、たしか、クヌウト・ハムスンの飢ゑと云う小説の中にも、蝋燭を買いに行って、五クローネルのつり銭と蝋燭をたゞでもらって来るところがありましたね。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　クヌウト・ハムスンだって、こんな行きがゝりは持たなかっただろう。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくその朝、天津飛行士の作った黄金階段に見張りに出ていたクヌヤという月の住人が急いで天津のところへ駈けつけてきた。",
              "citation": {
                "source": "月世界探険記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「冷え切っていようの、うっちゃって行こう」「うんにゃ、ヌクヌクじゃ、まだ暖かい」「では死んではいないのか」「気絶しているだけじゃ、そこで活じゃ。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結構な夜具にくるまって、ヌクヌク寝ているのは荻野八重梅、顔がすっかり変っている。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『キング』は労働者の家庭にも農村にも入るのだが今日の軍事経済政策による深刻な生活難で、どこの誰の爺さんと孫が実際こんなにヌクヌク安楽な目をして暮らしているか？",
              "citation": {
                "source": "『キング』で得をするのは誰か",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "勉が重い荷物でよろめきながら、麗らかな陽のさしとおす欅やクヌギの間を林の奥へ奥へとわけて行くと、不意に芝草の生えた狭い平地へ出てしまった。",
              "citation": {
                "source": "小祝の一家",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルジョアの子は、学校の行きかえりにさえ自動車にのり、好きな犬までそばへつけてヌクヌクと育っているのに、プロレタリアや農民の子はどうです。",
              "citation": {
                "source": "従妹への手紙",
                "author": "――「子供の家」の物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "『クニス』が約まって『クス』になる最好の適例としては、『ハニシ』（土師）が『ハジ』になり、『クヌガ』（陸）が『クガ』になったものを提供したい。",
              "citation": {
                "source": "国栖の名義",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京付近のクヌギ林の下などには、諸処に野生しているから、これを採集して来て栽えるとよろしい。",
              "citation": {
                "source": "植物知識",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウメ、モモ、ケシ、ダイコン、エンドウ、ソラマメ、トウモロコシ、イネ、ムギ、ソバ、クリ、クヌギ、ならびにチャの実などがそれである。",
              "citation": {
                "source": "植物知識",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし君達のその様な態度は、丁度ヌクヌクと安楽椅子にふんぞり返って居られる金持が、道楽に魚釣りに出かけて、「魚が一匹も釣れないでは、俺は食えなくなる」と心配しているようなものだ。",
              "citation": {
                "source": "俳優への手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ひとつ、ヌクヌクと、てめえを抱きてえばつかりに、だ。",
              "citation": {
                "source": "疵だらけのお秋（四幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪しい死にように違いありませんが、私はまだ十一や十二で、どうしようも無く、世間付き合いの良い伯父は、誰にも怪まれずに、そのまま出雲屋の主人に納まり、あの身上をヌクヌクと自分のものにしてしまいました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "春宵",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから俺は余計なことをするんじゃないと言ったろう」「だって女二人まで殺してヌクヌクと――」「誰が女二人を殺したんだ」「あの味噌摺用人でなきゃ、下女のお初」「違うよ、八」「ヘエ？",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "遠眼鏡の殿様",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからヨセフ・クヌーベル――誰でもかれを好きにならざるを得ない――その他の簡単な、しかも要所をつかんだ写生。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分たちは何の冒険もなし得ず、その最愛なる妻を蛮地に失いもせで、ヌクヌクと幸福に暮していながら、自分たちにわからぬ新学説が世に出さえすれば、これをけなし付け、抹殺してしまうのだ。",
              "citation": {
                "source": "令嬢エミーラの日記",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "亡くなった先代のクヌード・ドラーゲ公も商務大臣を、そしていくらか現王室とも繋がりがあるように聞いていた。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、待つ間ほどなくそこへ、大奥様と呼ばれる商務大臣を務めた先代のクヌード・ドラーゲ公未亡人がはいって来た。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
