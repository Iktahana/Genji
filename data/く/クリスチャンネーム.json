        "examples": {
          "standard": [
            {
              "text": "海外では、クリスチャンネームが個人を特定する重要な役割を果たす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼のクリスチャンネームは、聖書に登場する人物にちなんでつけられたそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "パスポートには、フルネームとクリスチャンネームが記載されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "一八四〇年作　　　訳注　暦の別の個所をめくった――ロシア正教の暦には各々その日に命名すべきクリスチャンネームが数個ずつ指定してあるからである。",
              "citation": {
                "source": "外套",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは同人が生れますと間もなく非常に虚弱な体質に見えて来ましたので、異性に形どった名前を附けると丈夫に育つという日本在来の迷信から、妻が小生と相談の上ジョージというクリスチャンネームを象って附けたものであります。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
