        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は口脇を拭いながら、美味しそうにパンを食べ続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "笑うと、彼女の口脇にできるえくぼがとても可愛らしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "緊張すると、口脇がピクピクと動く癖がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "口脇耳ノ根マデ広ク割ケ。",
              "citation": {
                "source": "縁結び",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "北口不浄門からも、東口御小屋門からも、西口脇門からも、何の声すらないのです。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「とりあえず山を越えて、あとはそれから考えよう」　高志は、非常口わきの、小浴場の換気扇をかえりみた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思って、新刊書のおかれている網棚の方へ目を移そうとしたとき、入口わきの凹みに、横顔をこちらへ向けて小卓に向い、何か読んでいる一人の司書の老人に注意をひかれた。",
              "citation": {
                "source": "図書館",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルは、昼間つかっていた正面入口わきの正食堂をしめて、横通りから入るカフェー・レストランだけあいていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
