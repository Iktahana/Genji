          "literary": [
            {
              "text": "十一月八日（水曜）曇　きのうの話、野上さんはギリシア神話からプロメシウスの話をとってヘレニズムとクリスチャニズムとの対抗を描きたいと思い着手して居られる由。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしまた、実際的に働いて見た上で、マルクシズムに非ずんば、結局は勤労大衆の幸福をもち来らせることが出来ないという結論が生まれたら、自分のクリスチャニズムを批判し、否定なさるんですな。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
