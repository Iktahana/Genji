          "literary": [
            {
              "text": "そのためには、麻薬以外になかったのです。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「頭ヲ使ウナ、精神ノ安静ハ薬以上ニ効果アリ」ト言ワル、頭脳稼業ノ吾等ニハ痛イコトナリ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｘ塗料の発明されたことは、報告されたが、その塗料がどんなものであるかということについては、火薬以上にその秘密が厳重にたもたれた。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "早朝に発見されたその死体は、やがて解剖されたが、死因は毒薬以外には何もなかった。",
              "citation": {
                "source": "どぶろく幻想",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもこれは医薬以上の偉効があつた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らのウェスリアン大学はメソジスト教会の支援を受けていて、この教会は完全禁酒を推奨し、アルコールは毒薬以外の何物でもないというパンフレットを配っていたからである。",
              "citation": {
                "source": "栄養学小史",
                "author": "A Short History of Nutritional Science",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼れには今二つのどちかが必要だ、この過去の怨靈を嘔吐するか、またはこの痺れ藥以上の毒消し藥を飮むか……だがさうしてる内に冬がやつて來た、そして雪が降つた、どんどん降つた、眼もあけられない位降り込めた、一と月も二た月も……彼れは舊來の毒のきゝめで方々の節々が凍るやうな痛さを感じた。",
              "citation": {
                "source": "展望",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
