        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カジヤハ　マツカニ　ヤケタ　カネカラ　クワヲ　ツクツテ　ヰマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "クツヤノ　ヂイサンハ　一リデ　セツセト　クツヲ　ツクツテ　ヰテ、フエフキガ　フエヲ　フキハジメルト、「ウルサイカラ　イツテ　オクレ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチノ　上ニ　ヒカツテ　ヰタ　モノハ、ナクナツタ　ホシデハ　ナクツテ、ガラスビンノ　カケラダツタノデス。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンダン　ミミガ　トホク　ナツタノデ、ミヤコニ　ヰル　ムスコノ　トコロヘ、「ミミガ　トホク　ナツタカラ、ヨク　キコエル　キカイヲ　カツテ　オクツテ　クレ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ　オヂイサンハ、「アノ　ラツパデハ　キコエナク　ナツタカラ、モツト　ヨク　キコエルノヲ　オクツテ　クレ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ　イロイロ　カンガヘテカラ、マタ　マエノ　ラツパト　オナジ　ラツパヲ　オクツテ、「コノ　ラツパヲ　ミミニ　ツケルト　ワタシノ　コヱガ　キコエマス。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノアイダ、オクツテ、クダサツタ、ハナノクスリ、オツイデノトキ、スコシオクツテクダサイ、センジテノムト、ノボセガ、ナオツテ、カホリガ、ヨロシイ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンダカサムクツテシカタガナイカラ、コノナカデ、ホンヲヨミマセウ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キツト、キツト、二人デオクツテユクヨ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人参サンハ　ジヤガイモサンニダマツテ、一人デ玉ネギサンヲ　オクツテユカウト思ヒマシタケレド、ソレデハ、ドンナニ玉ネギサンガカナシガルデセウ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカライクラ、オモシロクツテモ、アンマリナガク水ノ中ニハイツテヰルト、カラダニドクデスカラネ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、シキリニアタマヲヒネクツテ考ヘマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おむすびヲツクツテ、ネズミイラズニ入レテオキマス。",
              "citation": {
                "source": "母子ホームの子供たち",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから推して考えて見ると、ずっと以前にも別になおこれと類した他の話があったのかも知れぬが、少なくとも沓手鳥の異名のもと、即ち百舌に対して馬の沓の代価をはたるという話は、あの啼き声をクツテと聴くようになって後に、始めて発生したものに相異ないのである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
