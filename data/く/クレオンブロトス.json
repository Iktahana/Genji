        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この学派のもう１人の医師クレオンブロトス（Cleombrotus）はアンティオコス（Antiochus）王の診察を行って100タレント（約１万5000ポンド）を受け取った。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "クレオンブロトス・アンブラキアはプラトンの『パイドン』を読んでから、来世にあこがれる心が切になって、ほかに何の理由もないのに海に身を投げた。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫クレオンブロトスがその都市の騒乱に際して彼女の父レオニダスよりも優勢であった間は、彼女はよい娘であった。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊＊　父たるレオニダスも夫たるクレオンブロトスも、共にスパルタ王。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
