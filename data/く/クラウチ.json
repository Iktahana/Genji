        "examples": {
          "standard": [
            {
              "text": "猫は獲物を狙うかのように、低い姿勢でクラウチした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は敵の攻撃を避けるため、素早くクラウチして身を隠した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "狭い洞窟の中を進むには、ずっとクラウチしたままでいなければならなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "電車の中では、つり革につかまらず、両脚を変な恰好にしてバランスをとり、会社の廊下のリノリュームに油を塗ったばかりだと、そこを滑って重役に衝突し、日曜日には縁側から張板を庭にかけ渡した上でクラウチの真似をやり、事務所の回転椅子では、ジャークド・クリスチャニアを練習する。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
