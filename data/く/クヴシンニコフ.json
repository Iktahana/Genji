          "literary": [
            {
              "text": "それからクヴシンニコフって中尉だがね……。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は屹度、あのクヴシンニコフ中尉とは別れられなかったよ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがね、クヴシンニコフって奴がどんな女たらしだか、君が知ったものなら！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがクヴシンニコフの奴は、ああいう恥知らずだから、その女の傍へ擦りよりゃあがって、フランス語なんかでジャラジャラおべっかを使やがるんだ……。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれはクヴシンニコフと一緒に、毎日あいつの店で朝飯を食ったもんさ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "クヴシンニコフの奴はおれの傍に坐っていやがったがね、『どうだい、君、あの野苺も摘んでやろうか！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の騎兵二等大尉のポツェルーエフとクヴシンニコフの野郎とだよ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
