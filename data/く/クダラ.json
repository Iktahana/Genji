[
  {
    "uuid": "b0efd31a-dca0-552e-9fcf-64d48d7aa337",
    "entry": "百済",
    "reading": {
      "primary": "くだら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
