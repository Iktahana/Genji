        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "森林には下生えに偃松と笹とクロウスゴが繁っているし、草原には小梅慶草や日光黄菅、珍車が散生している外、一団をなした偃松が途切れ途切れに縁辺を囲んでいる。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもサンタ・クロウスに貰ったというから珍らしいや。",
              "citation": {
                "source": "いたずら小僧日記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもサンタ・クロウスは乃公に何もくれなかった。",
              "citation": {
                "source": "いたずら小僧日記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そればかりでなく忠公は確かにサンタ・クロウスを見たと言った。",
              "citation": {
                "source": "いたずら小僧日記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンタ・クロウスは乃公の家へも来たに相違ない。",
              "citation": {
                "source": "いたずら小僧日記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
