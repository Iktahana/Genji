        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "記者たちは政治家に食い下がり、真実を引き出そうとしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "弁護士は証人に食い下がって、矛盾を突いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "上司は部下に食い下がり、報告書の提出を催促した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      },
      {
