        "examples": {
          "standard": [
            {
              "text": "彼は文章のリズムを整えるために、あえてここで句を切る手法を選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「もっと読みやすくするために、適切な場所で句を切るようにしなさい」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "朗読の際、彼は言葉を噛みしめるように一拍置いて句を切った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
