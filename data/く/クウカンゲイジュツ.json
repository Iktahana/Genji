          "standard": [
            {
              "text": "美術館の大きな吹き抜けに設置された空間芸術の作品が来場者を圧倒した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彫刻や建築のような空間芸術は、鑑賞者が歩き回ることで体験が変わる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女は空間芸術を専攻し、廃工場をまるごとインスタレーションに変えた卒業制作で賞を受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "およそ芸術は、表現の手段によって空間芸術と時間芸術とに分け得るほかに、表現の対象によって主観的芸術と客観的芸術とに分け得る。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            }
          ]
