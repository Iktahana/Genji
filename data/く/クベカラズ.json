        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "精神的價値等ヲ擧ゲテ遊戲ノ本旨ヲ傷クベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡テノ光榮ハ其レヲ維持スベキ物質的條件ヲ缺クベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "要スルニ日本ハ日本海朝鮮支那ノ確定的安全ノ爲メニ、則チ日露戰爭ノ結論ノ爲メニ、極東西比利亞ヲ領有スベク露西亞ニ對スル大陸軍ヲ缺クベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに対するシナ人の答えは、痴人ノ前ニ夢ヲ説クベカラズ、達人ノ前ニ命ヲ説クベカラズという句に示されているように見える。",
              "citation": {
                "source": "夢",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「人ハ瓦斯ノミニテ生クベカラズ」といふ文字が、ガラスの上に書かれてゐるのが、その裏から左文字になつて読めるのであつた。",
              "citation": {
                "source": "のんしやらん記録",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "許シ無ク縄解クベカラズ。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
