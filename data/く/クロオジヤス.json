          "literary": [
            {
              "text": "カリギュラの叔父、クロオジヤス。",
              "citation": {
                "source": "古典風",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロオジヤスは、申し分なき好人物にして、その条件に適っている如く見えた。",
              "citation": {
                "source": "古典風",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロオジヤスの后メッサライナ。",
              "citation": {
                "source": "古典風",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "父のクロオジヤスに似て、おっとりしていた。",
              "citation": {
                "source": "古典風",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はては、クロオジヤスの后になりすまして、そうしてクロオジヤスを毒殺する。",
              "citation": {
                "source": "古典風",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
