        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その理由は、雰囲気がこれに入射する太陽の輻射を通過させる程度は暗黒物体の表面から出る熱輻射を通過させる程度と同一でなく、前者よりも後者が多いからである。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば、地上に黒物蜿蜒たり。",
              "citation": {
                "source": "千葉夜行記",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒物の方は振り向く者がない。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "近い鹿児島の街ですら黒物はほんのわずかよりしか扱わない。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今も七個の窯を擁して黒物が焼ける。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方は雑器として永く続く黒物である。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　これで見れば黒物こそ「古薩摩」の正系であるが、位が卑しいために今何が焼けるかを注意する者がない。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それならその正しい子孫である黒物を顧みないのは不思議である。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "苗代川の歴史は動くとも黒物の歴史は動かない。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともかく今焼く黒物に付ては進んで語った者がない。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし黒物がもてはやされているとしたら、早くも歴史は雅器へと変っていたであろう。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑器に止るという事が黒物の性質である。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧しく暮すのが黒物の運命である。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「古薩摩」の美しさを語るその声が、今の黒物に向って沈黙するなら、「古薩摩」をも解ってはいないのだと詰る事が出来よう。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑器である事が、黒物の美を保証しているとむしろ断じていい。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それなら白物よりむしろ黒物が、もっと恵まれた条件で作られるのだといい切っていいではないか。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "苗代川の陶器では吾々は躊躇なく白物より黒物を挙げる。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に苗代川の黒物はその典型的なものと思える。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山と積まれる黒物の置場で、昔ながらの名器を選び出す事は、さして難事ではない。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒物がしばしば金では買えず、物と物との交換に今なお使われているのは当然ともいえる。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒物はどうしても薩摩焼の正系である。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "御用窯としての苗代川は白物を育てたであろうが、少くとも黒物を続け得たのは協存の賜物と思える。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然に委せた黒物には醜いものが出来難いのである。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし今後苗代川の黒物に醜いものが現れるとしたら、それは自然に逆らう事を敢てする時であろう。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "陶工たちは黒物を知識で焼いてはいない、だが多分に本能から焼いている。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから黒物は作られる品というより生れる品という方がいい。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの素朴な苗代川の黒物には自然が味方している。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この点でもこの質素な黒物は個人陶にとって怖るべき存在だといえる。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒物は救われる約束の許で作られているのである。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの本能から生れ出る苗代川の黒物ほど、知識へ多くの示唆を贈るものはない。",
              "citation": {
                "source": "苗代川の黒物",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
