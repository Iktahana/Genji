        "examples": {
          "standard": [
            {
              "text": "スペイン語の授業で先生が「ウノ、ドス、トレス、クアトロ」と数えて見せ、生徒たちが後に続いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "メニューに「クアトロ・フォルマッジ」と書かれていたので、四種類のチーズを使ったピザだと分かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「クアトロ！」とディーラーが叫ぶと、4番に賭けていたテーブルの客たちが一斉に歓声を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
