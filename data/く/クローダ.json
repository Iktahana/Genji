        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この外交秘録を発表するに当って、何よりも先にお断りしておきたいことは、筆者クローダ・サヤマ……すなわち私が、現在日本に居ない人間という事である。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "只、ミスタ・クローダ・サヤマは直ぐに探す事が出来ましょう。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミスタ・クローダ・サヤマは日本で……世界で一番上手な探偵です。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミスタ・クローダ・サヤマにバード・ストーンが会いたいと申しました。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "クローダン・ボーピエという若者を殺害。",
              "citation": {
                "source": "殺人狂の話",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "初期の『クローダディ』や『フュージョン』がぼくをどれだけ力づけてくれたかは、言葉で書くことができない。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
