[
  {
    "uuid": "bd04c0c9-f097-59fb-95e6-14ad1fdbc9b0",
    "entry": "空間",
    "reading": {
      "primary": "くうかん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
