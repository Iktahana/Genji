          "literary": [
            {
              "text": "私たちはいつもの習慣で、カフェを飮み、クロワサンをかじりながら、しばらく往來の人通りを眺めてゐた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "實はパリの最後の朝食を、いつものカフェのテラスに腰かけて、あのうまい珈琲とクロワサンでしたかつたのだが、出發前の氣持のあわただしさは、私たちをホテルの平凡な食卓で我慢させた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九時頃目覚めて床の内にて一碗のシヨコラを啜り、一片のクロワサン三日月形のパンを食し、昨夜読残の疑雨集をよむ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "サラ・リーのクロワサンはハムとスイス・チーズ入りだ。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
