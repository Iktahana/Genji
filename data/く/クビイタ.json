          "literary": [
            {
              "text": "議会閉会の後自由党の強要にて党首板垣退助入閣。",
              "citation": {
                "source": "政治の破産者・田中正造",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、選挙の結果百余の議員を得た自由党は、この勢力を楯にして党首板垣の内務大臣を要求した。",
              "citation": {
                "source": "政治の破産者・田中正造",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗ってしまうとそれを首板の上へ載せて次へ廻す。",
              "citation": {
                "source": "武州公秘話",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「は、―――はい」娘は油で光っている手を首板の上に衝いて、貴人に応対する場合の慇懃な姿勢を取った。",
              "citation": {
                "source": "武州公秘話",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "半※や、盥や、首板や、机や、香炉や、屋根裏の場面の再現のために必要な小道具類が揃えられると、気の毒な道阿弥は肩から以下を床下に埋めて、寂然たる一箇の首と化した。",
              "citation": {
                "source": "武州公秘話",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
