        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "男は洟をかんだあとの紙を小さく畳んで袂にいれると、鼻をクスンクスンさせながら、「随いて来い」と、言った。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "あぐね果てたお妙はクスンクスンと涙をすすり上げる。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "段六　（鼻をクスンクスン言わせて）お前が、こんなロクでもねえ戦なんどに夢中になっている間に、仙エムどんは、そんねえにならした。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ドシドシ歩いて戸外へ消える）まだクスンクスン泣いている瀧三。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴に抱かれた幼児が半ば目をさましてクスンクスンとグズリはじめる。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お豊　（クスンクスン言う赤子を抱きながら出て来る）あい。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（戸口の方へ）一剣、天下を行く……（ドシドシ歩いて戸外へ消える）（まだクスンクスン泣いている滝三。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
