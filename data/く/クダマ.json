          "literary": [
            {
              "text": "ソレデモ、シバラクダマッタママ、少シズツ大キクユスッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョウロクダマめが。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "神伝魚心流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆえにこの実にはハズミダマだのオフクダマだのオドリコだのオンドノミだのジュウダマ（リュウダマの転訛だろう）だの、またはインキョノメダマだのの名がある。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（なんだ、このヒョウロクダマ！",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "留め役の俺は、これじゃてんでクダマ（阿呆）みたいだ。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
