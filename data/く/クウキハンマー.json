        "examples": {
          "standard": [
            {
              "text": "解体業者は空気ハンマーでコンクリートの基礎を次々と砕き、一日で建物の土台を取り除いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "空気ハンマーの打撃力は手作業の数十倍あり、固い岩盤でも短時間で穿孔できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "工場では空気ハンマーを使ってベアリングをシャフトに圧入し、組み立て作業を効率化している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "これは圧搾空気ハンマーに似た形をしていたが、原子力で動くものであるから、長い耐圧管もなければ、ボンベもなく、構造はずっとかんたんになっていた。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "常識家の君でさえそう思っているんだから、ミミのやつなんかにいくら話してやっても分らないのは無理もないんだ」　と、氏は大きな掌で自分の膝小僧を掴み、空気ハンマーのように揺すぶった。",
              "citation": {
                "source": "宇宙尖兵",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
