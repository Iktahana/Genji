          "literary": [
            {
              "text": "「オ前タチ、デンデンムシノ　ウタ　シラナイカ」ト、オソバノ　モノニ　キイテモ、「シリマセン」ト　イツテ　クビヲ　カシゲテ　ヰマス。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サア　ナンノ　カゲダラウ」ト　モウ　ヒトリガ　クビヲ　カタムケマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カナシサウナ　チビスケハ　クビヲ　タレタママ、ジヨンノ　アトカラ　ツイテユキマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ジヨンガ　イヒマシタガ　チビスケハ　クビヲ　アゲマセン。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミミヲ　クワエテ　ヒツパツタノデ、チビスケハ　シカタナク　クビヲアゲテ、ジブンノカゲヲ　ミマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カメコオバサンハ　オホキナ　アクビヲ　カミコロシナガラ、イヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメコオバサンハ　オホキナ　アクビヲ　カミコロシナガラ、「デモネエ、ワタクシ　スコシ　ハデスギヤシナイカト　オモフノデスケレド。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
