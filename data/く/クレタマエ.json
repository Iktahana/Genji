          "literary": [
            {
              "text": "僕ハ足ノ指ノ股マデモキレイニ拭イチテヤリ、「君、ソノ手ノ指ノ股ヲ拭イテヤッテクレタマエ」ト木村ニモ命ジタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜マタ飲ミニ来テクレタマエ」ト云ッタラ、「トンデモナイ、一昨夜ノ晩ハビックリシマシタ、少シ先生モ慎ンデ下サイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ意ヲ決シテ木村ニ云ッタ、「デハコレノ現像ヲ頼ム、絶対ニ誰ニモ見セナイデスベテヲ君自身デシテクレタマエ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　クレタマエと到頭私もやったりけり。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
