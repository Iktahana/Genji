          "literary": [
            {
              "text": "」「クリユキンです。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「実はそのクリユキンさんですか、其方がいつも革命々々と云ふ事をお書きになるですな。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはクリユキンの文章に革命と云ふ詞があるかも知れませんが、あつたつて差支なささうなものですがなあ。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリユキンといふ先生は、なぜ不用心な物の言ひやうをするのでせう。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            }
          ]
        }
