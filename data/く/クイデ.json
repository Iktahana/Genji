[
  {
    "uuid": "0e9d4592-8a47-56b1-82da-f5424166a47e",
    "entry": "食い出",
    "reading": {
      "primary": "くいで",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
