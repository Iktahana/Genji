        "examples": {
          "standard": [
            {
              "text": "壁越しからくぐもった声が聞こえてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "マスク越しのくぐもった声では何を言っているか聞き取れない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼のくぐもった声は実は風邪が原因だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "（くぐもった声）香川　聞いたろ君も、今の二人の話？",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "狭山は私が傍に立っているのさえ眼にはいらないようすで、赧黒い頬にとめどもなく涙をつたわらせながら、「すぐおさまる」とか、「元気を出したり」とか、涙にくぐもった声で呼びかけ、口を割って水を飲ませ、掌を煖炉で温めては一心に膃肭獣の背をさすっている。",
              "citation": {
                "source": "海豹島",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまはくぐもった声でそう説明した。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マンのその言葉が聞えたのか、聞えなかったのか、うつろな眼で、ジロリと見て、「ウンコじゃ」　くぐもった声でいって、ゆらゆらと、便所の方に行った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫みたいに忍び足で跡をつけていき、海岸に出てバラドスのテントへ着くと、仲間が集まっており、くぐもった声が聞こえた。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞き耳を立てていると、ホールの反対側の部屋からくぐもった声がする。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
