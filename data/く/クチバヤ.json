[
  {
    "uuid": "6b38629f-9baa-5503-9d61-8a4cd3eaaa97",
    "entry": "口早",
    "reading": {
      "primary": "くちばや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
