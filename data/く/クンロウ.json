          "literary": [
            {
              "text": "其父正盛の勳勞を思ふに由りて、狂氣とは云ふ也。",
              "citation": {
                "source": "宗吾靈堂",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "さはれわが父クロニオーン、奇怪の計慮胸にして、　360つれなく常に剛愎にわれの努力を妨げつ、＊ユウリスチュウス命じたる役に惱める彼の子を屡※助け救ひたるわが勳勞を顧みず。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に何程國家に勳勞有る共、其職に任へぬ人を官職を以て賞するは善からぬことの第一也。",
              "citation": {
                "source": "遺訓",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
