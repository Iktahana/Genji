          "literary": [
            {
              "text": "黒薔薇栽培にも一家言を持っていた。",
              "citation": {
                "source": "古典風",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒バラの目印　大佐は随員と協議した。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "形も見おぼえがあり、塗りの色もそうでしたし、さらにまちがいないことは黒バラの目印がついている。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒バラは、『宇宙の女王』号のマークなんですからねえ」　助教授はそういって、卓子のうえを、とんと一つたたいた。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして黒バラ印の空間浮標の一件については本国へ向かっての報道を禁止する。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
