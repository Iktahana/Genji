  {
    "uuid": "b642cdaf-9bcb-508a-bdd9-0e47fc698fdf",
    "entry": "クラヤミ",
    "reading": {
      "primary": "くらやみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "クラヤミノナカデ、オ母ッチャノコエガスルト、ヤットアンシンスルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの蝿帽子峠の手前に、クラヤミ峠というのがございます。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ひどい峠で、三里の間は闇を行くようだと申しますんで、それで俗にクラヤミでございますさ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "達人の手裏剣がクラヤミの中の見えない敵を倒しているようなものだ。",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まッくらで、淋しかったでしょう」「ここでこのままミイラになりそうな気持でしたよ」「これが本当のクラヤミね。",
              "citation": {
                "source": "発掘した美女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、クラヤミがこんな生命力にあふれているなんて、すばらしいわ。",
              "citation": {
                "source": "発掘した美女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "言うに言われぬ快感のさなかに、ふと目が覚めて、彼はクラヤミへ突き落された。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんと云っても、彼の修練はクラヤミに於ける声の表現で、表情や身の動きは中年からの年期であるから、宙を含むの天分ありとはいえ、年期の遅きをいかにせん。",
              "citation": {
                "source": "戦後新人論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "一足クラヤミの外へでて、ヤミに向って光をてらすと、百鬼夜行、ジャングル満山百鬼のウゴメキにみちている。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がまだ何の予感もないのに、彼がにわかにクラヤミの一点をパッとてらしだす。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚もクラヤミのペーヴメントを歩いて行くと、歩道に二三十人の男女が立っているところがある。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "巡査はその人群れの隅ッこで立ち停ったが群れに目をつけているのではなく、何か奥のクラヤミをうかがっている様子である。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "警官身をひるがえしてクラヤミへかけこむ。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "小屋の外のクラヤミに三十五六の女が茫然と立っている。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラヤミだから定かではないが、二十二三の若者らしい。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラヤミのベンチに五六人のパンパンが腰かけたり、立ったり、あつまっている。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "新宿のアンチャンは自分のジャングルへくるお客からはぎとるが、このジャングルはクラヤミで、凄愴の気がみなぎっているが、訪う趣味家はむしろ無難だ。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "満山クラヤミながら、概して平穏なのである。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "家もなく、又はムシロの小屋にすみ、自らのすむクラヤミのジャングルを平和にたもつ異国人こそ、悲しく、痛々しく、可憐ではないか。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとへ戻れば火が食いつくし先はマックラ、トンネルだアどうしよう神さま、きてくれ石川淳を知らねえか　ついに意を決してクラヤミのトンネルをくぐりぬけ、二里の難路を突破して、一命無事に伊豆多賀の里に辿り着くことができた。",
              "citation": {
                "source": "安吾巷談",
                "author": "熱海復興",
                "note": "青空文庫"
              }
            },
            {
              "text": "一服クン、青くなって、怒ったわよ」　大鹿はなんとも不快な気持がこみあげてきたが、しかし、この先どうしたらいいのか、思えば、クラヤミがあるだけだ。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツカの根元までクラヤミの気配を狙って一刺しにできるのは相当の使い手でありましょう。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十　冷笑鬼",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしクラヤミのせいか、よく拭きとられていないのだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三枝ちゃんがクラヤミで拭たのでしょうか。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっと何かがあったんですわ」「しかし、クラヤミで三枝子が花ビンにつまずいて倒れるようなことはありがちだね」「いいえ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの方のお部屋は二階ですから、外はクラヤミで、のぞいても外が見えよう筈はありませんが、そのときイナズマが光ったのです。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "時田に向っては、貴公を救うためお三枝の仕業の如くにクラヤミに仕掛をほどこしておいたところ、お三枝は己れのアヤマチと早合点して行方不明と相なったが、死んでおるかも知れぬ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、それから二時間後、クラヤミの氷川町へ現れた虎之介はガッカリしたように首をふりふり、感無量であった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十二　愚妖",
                "note": "青空文庫"
              }
            },
            {
              "text": "これもクラヤミで処理されたことを示しています。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
