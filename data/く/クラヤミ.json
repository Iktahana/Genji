    },
    "definitions": [
      {
        "index": 1,
        "gloss": "darkness",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "突然の停電で、家中が吸い込まれるような深い暗闇に一瞬で包まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "暗闇の中で物音がした方向をじっと見つめると、猫の目だけがピカッと光った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "手探りで暗闇の中を慎重に進んでいくと、ようやく出口の微かな光が見えてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "駅から旅館までの俥の上で自分の息が見知らぬ町の暗闇の中に、白く立昇つたことを夢のやうに覚えてゐる。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬱陶しいほど両側から梢の蔽い重なった暗闇阪を降り尽して、左に曲れば曙湯である。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "疲労も不平も洗い流して蘇ったようになって帰る暗闇阪は漆のような闇である。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後｜田舎へ帰ってからも、再び東京に出た後も、つい一度もやもりというものを見なかったが、駒込の下宿に移って後、夏も名残のある夜の雨にこの暗闇阪のやもりを見つけた時、十九の昔の一夜がありあり思い出された。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "やもりは雨のふる夜ごとに暗闇阪の街燈に出ているが、いつ何処から這い上がるとも知れぬ。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗闇阪を下りつめた角に荒物屋がある。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬が容捨もなく迫って来て木枯しが吹き募るある夜、散歩の帰り途に暗闇阪近くなった時、自分の数間前を肩をすぼめて俯向いて行く銀杏返しの女がある。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗闇阪の街燈は木枯しの中に心細く瞬いていた。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が年中で一番｜厭な時候が再び来て暗闇阪にはまたやもりを見るようになった。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗闇阪の街燈には今でもやもりが居るが、元のような空想はもう起らぬ、小さな細長い黒影は平和な灯影に眠っているように思われるのである。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗闇の中で、私は子供たちの姿を見失つてしまつた。",
              "citation": {
                "source": "氷雨",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "私より遙かに先きに立つて、暗闇の中に姿を消してしもうた子供たちの心の中に、私は入らうと努めた。",
              "citation": {
                "source": "氷雨",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗闇で毛を逆立てゝパチパチ火花を出すアンデルゼンの猫を。",
              "citation": {
                "source": "猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二　一と頃、学生の観客の多い映画館で、ニュース映画の中にたまたまソビエトの赤旗の行列などがスクリーンに現われると、観客席の暗闇から盛んな拍手が起るのであった。",
              "citation": {
                "source": "ＫからＱまで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことによると、自分の中にもどこかに隠れているらしい日本人固有の一番みじめな弱点を曝露されるような気がして暗闇の中に慚愧と羞恥の冷汗を流した。",
              "citation": {
                "source": "ＫからＱまで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると僕はとんでもない忘れものをしたことに気が付いて象徴的にさえ感じられる露西亜の暗闇を疾走する列車の窓から北欧に向ってわめきたいような衝動にかられるのです。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "皺だらけの私の寝室をノックする音がして、暗闇から出た女の手が、楕円形の天井をみつめていた私の目前で葡萄蔓のようにからんで、青いリノリウムのうえにMELINSの扱帯が夜光虫のように円をつくると、私は断截された濡れた頭髪を腕の中に感じて、いつのまにか恋愛のマッフのなかに、ひとときの安息を求めた。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くの暗闇の中に見覺えのある支那料理屋の明りが、ぽつつと一つ光つてゐる。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "立ち止まつた私の前に、暗闇の中から、影のやうにひよいと近附いて來たのは、肩掛を頭越しにかぶつた、何となくみすぼらしい身成の外國の婦人だつた。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今一寢入させてくれりやあ命も要らないな‥‥」「はは、かうなりやあ人間もみじめだ‥‥」と、私は暗闇の中で我知らず苦笑した。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ち夜の暗闇の中に劇しい水煙が立つて、一人の兵士が小川の中にバチヤンと落ち込んでしまつた。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは球突を少しやつた人の誰しも經驗する事で、夜電氣を消して床にはひると暗闇の中に赤白の四つの球をのせた青い球台が浮かんで來て、取り方を夢中で空想したりする。",
              "citation": {
                "source": "文壇球突物語",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗闇の中に、黄色の玉が二つ光っていた。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "負傷者は、今、内地へ帰れなかったら、この次、いつ内地へ帰れるか、さきは暗闇だった。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "湿った暗闇の中を、砂煙が濛々と渦巻いているのが感じられる。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は暗闇のなかにやがて消えてしまう。",
              "citation": {
                "source": "ある心の風景",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしちょっと気を変えて呑気でいてやれと思うと同時に、その暗闇は電燈の下では味わうことのできない爽やかな安息に変化してしまう。",
              "citation": {
                "source": "闇の絵巻",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは道も灯もない大きな暗闇であった。",
              "citation": {
                "source": "過古",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗闇に点された火は、また彼の空虚な頭の中に点された火でもあった。",
              "citation": {
                "source": "過古",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と青年は、暗闇の中で口をゆがめる。",
              "citation": {
                "source": "渡り鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
