        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔の貴族は、供の者に沓持ちをさせていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "宴席に招かれた沓持ちは機転の利いた冗談で座を大いに盛り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "沓持ちと呼ばれた道化者は、殿様の機嫌を取りながら辛辣な皮肉をさりげなく交えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
