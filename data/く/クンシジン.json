        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "實際北京の正陽樓や小有天あたりで正式な支那料理を食ふなどは、君子人にとつてはちつと險呑な事だと云へぬでもない。",
              "citation": {
                "source": "阿片の味",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "八歳になるまでは一銭の小使いも与えられず、支那の君子人の言葉を暗誦することだけを強いられた。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三郎はその支那の君子人の言葉を水洟すすりあげながら呟き呟き、部屋部屋の柱や壁の釘をぷすぷすと抜いて歩いた。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "うん、あの男は後輩の中でも天才的な特長があるらしいけど、多少変りものなのだ、根は君子人だ。",
              "citation": {
                "source": "夏の夜の夢",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "緑平老はまことに君子人なるかな。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "優しい髯を蓄へた、色白の、女に可愛がられる顔立で、以前は何処かの中学の教師をした人なさうだが、至極親切な君子人で、得意な代数幾何物理の割に筆は立たぬけれど、遊廓種となると、打つて変つて軽妙な警句に富んだものを書く、私の心に陰影のさした時、よく飛沫の叱言を食ふのは、編輯助手の永山であつた。",
              "citation": {
                "source": "菊池君",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "△大石誠之助　被告中の一異彩なり、温厚にして聰明なる君子人と傳へらる、醫を業とし其藥代診察料等の掲示には必ず『何十何圓の筈』と書し筈の字なきはなし。",
              "citation": {
                "source": "日本無政府主義者陰謀事件經過及び附帶現象",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "清廉潔白百年｜稀に見る君子人として世を挙げて哀悼された。",
              "citation": {
                "source": "三十年前の島田沼南",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "古は曾子のいわく「以て六尺の孤を託す可し、以て百里の命を寄す可し、大節に臨んで奪う可からず、君子人か君子人｜也」と。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、相手が生真面目な女性だとか、謹厳な君子人だとかの場合には、後から弁解のしようもないことに立ち到らないとも限らない。",
              "citation": {
                "source": "囚われ人",
                "author": "――寓話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のような君子人でも、小説家などと云うものは、この位虚栄を求める心が、旺盛に出来上っているものである。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "粟野さんはなるほど君子人かも知れない。",
              "citation": {
                "source": "十円札",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "或者ハ、耶蘇ノ面貌ヲ以テ、醜悪ニシテ、怖ルベキ勁烈ノモノトナシ、或者ハ、温厳兼ネ備ヘタル秀麗ノ君子人トナス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりとて術數を蓄へ陰謀を成すの策士にも非ず、要するに氏は一種の獨善主義者にして名節を貴ぶの君子人なり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "（五）星征伐の失敗　　自由黨にして若し果して黨紀を振肅するが爲に星氏を除名するの必要あらむか、何ぞ比較的信用ある末松、江原等の君子人をして之れを提議せしめざる是れ他なし、黨紀振肅は眞の黨紀振肅に非ず、星除名論は亦唯だ嫉妬的感情の發現に外ならざればなり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "有體にいへば末松、江原等の君子人が、尚ほ黨の平和を口にして滔々たる濁流と浮沈するは頗る解す可からざるものあるに似たり黨の平和を計るが爲には勢ひ星除名論を鎭撫せざる可からず※何となれば、たとひ星除名論を實行するも、自由黨の腐敗は固より救ふに足らず、適々以て自由黨の分裂を見るに過ぎざればなり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりとて術数を蓄へ陰謀を成すの策士にも非ず、要するに氏は一種の独善主義者にして名節を貴ぶの君子人なり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "（五）星征伐の失敗　　自由党にして若し果して党紀を振粛するが為に星氏を除名するの必要あらむか、何ぞ比較的信用ある末松、江原等の君子人をして之れを提議せしめざる是れ他なし、党紀振粛は真の党紀振粛に非ず、星除名論は亦唯だ嫉妬的感情の発現に外ならざればなり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "有体にいへば末松、江原等の君子人が、尚ほ党の平和を口にして滔々たる濁流と浮沈するは頗る解す可からざるものあるに似たり党の平和を計るが為には勢ひ星除名論を鎮撫せざる可からず※何となれば、たとひ星除名論を実行するも、自由党の腐敗は固より救ふに足らず、適々以て自由党の分裂を見るに過ぎざればなり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "感情に動かされやすい人間になることは君子人のくみするところでないと考えるのである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷崎精二先生のような温厚な君子人が現れるばかり、ままならぬものである。",
              "citation": {
                "source": "西荻随筆",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「安んじて幼君の補佐を頼み、国政を任せることが出来、重大事に臨んで断じて節操を曲げない人、かような人を君子人というのであろうか。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "正にかような人をこそ君子人というべきであろう。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "おぬしこそはわしが交際ろうた人のなかの真の君子人じゃ」「はて、これは」「ああ、いや、追従とばかし思うまい。",
              "citation": {
                "source": "ハムレット",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "我等、君と交わりを結び数十年に渡る長き間、反目｜軋轢の悪記憶を留めざりしは、淡々たる君の君子人たる態度に依るならんか。",
              "citation": {
                "source": "弔辞（徳田秋声）",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "實に先生は單に教授として斗りでなく、又た人として眞に人間味のある君子人である。",
              "citation": {
                "source": "巽軒先生喜壽の祝辭",
                "author": "中島徳藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが大佐殿だったから止めるものが沢山あって、全快されたようなものゝ、我輩のように品行方正の君子人だったら、空しく手を束ねて死を待つ外はあるまいと思いついたのさ。",
              "citation": {
                "source": "閣下",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「勿論さ、君子人なら兎に角、君達の程度じゃ何か焚かないと鼻持ちがならないぜ」「ハッハヽヽ」「積極的にやることだ」「主筆、すると煙草が沈香ですか？",
              "citation": {
                "source": "善根鈍根",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "折合のつくような君子人同志なら、初めから争いません」「…………」「安達君、よく、考えて見なければいけませんよ」「はあ」「親友が二人出来るか、敵が二人出来るかという問題です。",
              "citation": {
                "source": "求婚三銃士",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
