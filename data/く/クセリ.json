        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "現代世界ヲ展開セシメタル三大發明ノ中火藥ガ人類ヲ殺スヨリモ甚シク、印刷術ノ害毒全世界ノ頭腦ヲ朽蝕腐爛シ盡クセリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジウタイノママジゾクセリ」　私は直ぐに持久戦を覚悟した。",
              "citation": {
                "source": "父杉山茂丸を語る",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "プレハーノフの女弟子、ソヴェト同盟のマルクス主義機械論的修正派の最も有名な代表者アクセリロードは、「トルストイの創作を批評するのにもスピノザの哲学を分析する際にも、彼女は永久不変の道徳法から出発している。",
              "citation": {
                "source": "婦人作家は何故道徳家か？　そして何故男の美が描けぬか？",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルクス主義的社会科学からブルジョア「社会学」を批判したものとしては、アクセリロート・オルトドクス女史『ブルジョア社会学の批判』（永田訳・南宋書院発行）や、A Lewis, An Introduction to Sociology（高畠訳『社会主義社会学』・改造社）などが、一応の参考になる。",
              "citation": {
                "source": "科学論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌年アクセリロート（P. Akselrod）、ドイッチュ（L. Deutsch）、ザスーリチ（V. Zasulich）と共に、ロシアに於ける最初の社会民主主義的組織である「労働解放団」を組織した。",
              "citation": {
                "source": "辞典",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "此山ハ村持ナレトモ松洗院ニ託シテ別当ノコトクセリ、明神ノ眷属トテ犬アリ、此犬ヲ乞ヒ借リ、狐ツキ或ハ猪鹿ノ防ヲナスニ応験アリトテ、比隣ノ村郷祈誓シテ参詣スルモノ多シ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
