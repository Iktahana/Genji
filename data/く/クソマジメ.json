    },
    "definitions": [
      {
        "index": 1,
        "gloss": "overly serious",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はクソ真面目すぎて、冗談を言ってもすぐに真に受ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "もっと肩の力を抜けばいいのに、いつもクソ真面目だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あのクソ真面目な性格が、彼の魅力でもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "クソ真面目な色男気取りの議論が国をほろぼしたんです。",
              "citation": {
                "source": "親という二字",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガキ用の出版物をクソ真面目に作ろうとする連中は、三年生以下用と表記した本の中で四年以上で習う漢字が使われることをタブーとする。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
