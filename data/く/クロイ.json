  {
    "uuid": "bbe12f0a-ecf8-5b55-89cc-abfc152dc8bb",
    "entry": "クロイ",
    "reading": {
      "primary": "くろい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
