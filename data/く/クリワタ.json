        "examples": {
          "standard": [
            {
              "text": "昔ながらの方法で繰り綿を作り、布団の詰め物にした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は繰り綿を使って、手作りの人形を作るのが得意だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この地方では、繰り綿の製造が伝統産業として栄えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そのうちとっくりわたしのほうから伺っていただきたいと思っていたくらいですからそれまで……」「きょう聞いてください。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "掛川へつぎこんだおせい様の金さえ、おせい様のほうへ返してしまえば、あの具足屋は、そっくりわたしのものになるわけだから、ひとつあれを育てて、何とか、芽のふくものなら、芽をふかしてみたい気もする」そして、思い出して、きいた。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七軒のお店が、そっくりわたしのものでしたら、わたしは、江戸で名代の金持ちのはずでございますねえ」　一空さまは、にこりともしないのだ。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなされば、横顔がすぐにそっくりわたくしどもに似ておいでなさいます。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはかれが兄弟としていっしょのうちに住むようになること、わたしの両親もわたしの友だちのことだからそっくりわたし同様に愛してくれるだろうと思ったということを話したが、まだかれは首をふっていた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それこそそっくりわたしの考えです。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その専門家に打ってもらった繰綿を、よく働く家では女たちが、篠巻きという管に巻いてヨリコを作った。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
