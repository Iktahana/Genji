        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夏の日下り、くれ縁に座ってスイカを食べながら風鈴の音を聞くのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い日本家屋のくれ縁からは、手入れの行き届いた美しい庭園が一望できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖父はいつもくれ縁で日向ぼっこをしながら、新聞を読むのを日課にしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "たとえば「くれ縁に銀｜土器を打ちくだき」に付けて「身ほそき太刀のそるかたを見よ」とする。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
