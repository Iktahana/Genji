        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ユフダチ　ヤムノヲ　マツウチニツカレガ　デタカ　オヂイサンイツカ　グツスリ　ネムリマスオヤマハ　ハレテ　クモモナクアカルイ　ツキヨニ　ナリマシタ　この月は、春の下弦の月である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九七七年三月号の『コンピューター』に発表した「パーソナル・ダイナミック・メディア」に続いて、アラン・ケイは同年九月号の『サイエンティフィックアメリカン』誌に、姉妹編に相当する「マイクロエレクトロニクスとパーソナルコンピューター」を発表した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "電子少年ウォズニアックアップル※を創る　一九五〇年八月、スティーブン・ウォズニアックは、カリフォルニア工科大学で電気工学を専攻したエンジニア、ジュリー・ウォズニアックの長男として生まれた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウォズニアックが原型を作り上げたこのゲームは、のちに設計しなおされ〈ブレイクアウト〉と名付けられて世界的なヒット商品となった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "バーガーを四つ、テイクアウトにしてください。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいよ、いらないよ」　そういいながらも、慶一は「テイクアウト」ということばを記憶しようと、頭のなかで転がす。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピックアップが壊れたかもしれないんだよ」「そんなもの、修理できるさ」「藤井だって、修理できるよ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピックアップが壊れていないといいけど。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "膝掛けにしている毛布の端が、ピックアップをかすめそうになり、慶一はハラハラした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "※高等女学校のスチユデント、　腰にはバンドの輝きて、　右手に持つはテキストブツク、　左手にシルクアンブレラア、　髪にはバツタアフライ、ホワイトリボン……」　自分は亦此処にも日本らしいからぬメロデイを聞いておやおやと思つたのある。",
              "citation": {
                "source": "市街を散歩する人の心持",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "別府所見、――小秦誰、朝見川朝日橋のほとり、竹田が妓にかく書いて与へたといふが、夜はともかく、昼はゴモクアクタでワヤだ！",
              "citation": {
                "source": "道中記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "漢名｜鶏というも鶏は稽なり、能く時を稽うる故名づくと徐鉉は説いたが、グリンムの童話集に、鶏声ケケリキとあったり、ニフィオレ島等で鶏をキオ、マランタ島等でクアと呼んだりするから推すと、やはりその声に因って鶏（キー）と称えたのだ。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "…ところが翌る日行ってみると、今度はそいつがノックアウトされている。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで生蕃小僧は意地になってしまって、どうしてもこの等々力巡査をノックアウトしてやろうと思って色々と智恵を絞ったのでしょう。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い古い缶詰めやタクアンが美味く感ぜられるくらい大衆は胃下垂状態に陥っているらしい。",
              "citation": {
                "source": "路傍の木乃伊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした事情で明治政府から筑前閥がノックアウトされたという事が、その後に於ける頭山満、平岡浩太郎、杉山茂丸、内田良平等々の所謂、福岡浪人の濶歩の原因となり、歴代内閣の脅威となって新興日本の気勢を、背後から鞭撻しはじめた。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "センセイノオシヘヲヨクマモリ、オトモダチト、ワルフザケヤケンカヲセズニ、ゲンキヨクアソベ。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "席に縄張りなくピツクアツプが自在だと落語の精神を忘れた泥くさい芸人だけが売れて行くといふ現象を来たすこともあらう。",
              "citation": {
                "source": "落語家たち",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主僧が早稲田に通うころ読んだというシェークスピアのロメオやテニソンのエノックアーデンなどもその中に交っていた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "本堂の机の上には乱れ髪、落梅集、むさし野、和尚さんが早稲田に通うころよんだというエノックアーデンの薄い本がのせられてあった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "エノックアーデン二十｜頁のところまで進む。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫婦の船客だけは自らノックアウトされていく。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "最一層入念するには、カルボリックアッシードか又はコロレードポットアスと云ふ藥を求め、便所に入れ置く可し。",
              "citation": {
                "source": "養生の心得",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サクアミとか、南無阿弥とか、たえず妙なことを口ばしっておるようじゃが」「ナニ、言いたいことをいわせておけばよいのじゃ」　と、これでは、お蓮様はどこにも、取りつく島がありません。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "サクアミが始まった！",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかに一人、ごくものずきなのが、妙なかっこうでお蓮様の前へしゃしゃり出て、「サクアミ様をおたずねなら、お会わせ申すはわけのないこと。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "日が暮れますと、あの太郎山の頂上に宵の明星がピカリ、ピカアリと光りまするナ……」「オイオイ、よせよせ」「そもそも、この、星が光ると申しますのは、お星様から下界へ向かって、青い糸を投げおろしまするので――サクアミ様はその糸にぶらさがって、スルスルスルッと降りてきましてな。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "落ちこまんとした穴を、ふち伝いにうしろに避けた左膳、柄をひるがえして下から上へ、クアッ！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
