          "literary": [
            {
              "text": "そこでは日本人街といふのを通つたが、なるほどと思つただけで、なんの感慨もおこらず、これに反して、クヰンス・ロードの店舗街から、植物園の方を歩いてみて、三々伍々、白人の家族が打ち連れて通るのに逢ひ、なにか身近な温かい空気を感じた。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のアウストラリヤのクヰンスランド土人の如きは實に食人人種の好標本なり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「クヰンスランド」土人ト「ニウジイランド」土人ト等シク石器時代ノ人民ナリト雖モ開化ノ度ニ於テハ二者相距ル事遠シ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
