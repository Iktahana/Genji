        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "クロプイは或る歴史の時期がすぎるともう動物学の標本にしか存在しなくなるの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロプイ的存在のすべてがそうなるのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "びっくりして、クロプイを見ているの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "マヤコフスキーに「南京虫」（クロプイ）という劇があって、現在はどこにでもいるクロプイが、或る時代には全く標本しかいなくなって、南京虫、ネップ、ビュロクラートみんな標本として博物の教室で学生が観察する芝居がありました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロプイという劇をメイエルホリドが上演しました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分パッサージへ行って、クロプイ〔南京虫〕の薬かって、上靴を買った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
