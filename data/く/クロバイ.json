        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "昔の灰の木を今日の植物学者はトチシバとかクロバイとかいって居る。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の人は、日本にない山礬という植物をこのクロバイだと思って居った。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから書物には山礬をクロバイとかトチシバなどと書いてあるけれども、それは間違って居る。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで面白いことには、京都辺で用いるクロバイも、東北地方でのサワフタギも、同属で Symplocos です。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
