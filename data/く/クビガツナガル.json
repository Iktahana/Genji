        "examples": {
          "standard": [
            {
              "text": "今回のプロジェクトを成功させなければ、私の首が繋がらないだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "不況の中、なんとか首が繋がって働き続けられることに感謝している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "経済危機の中、何とか彼の首が繋がったのは幸運だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "夕刻中島さんの家を出る時は悄げ返っていたけれど、無事に首が繋がると共に、もう好い気になって、お礼さえ碌々言わなかったのである。",
              "citation": {
                "source": "ガラマサどん",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
