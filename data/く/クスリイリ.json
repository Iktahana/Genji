        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは金が予て魔薬入りのゴールデン・バットをバラ撒いていた女たちに与えるものがなくなったことだった。",
              "citation": {
                "source": "ゴールデン・バット事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれこそ爆薬入りの花籠ではなかったか？",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい、オルガ姫｜咳止めの丸薬をくれないか、三粒あればいいよ」　オルガ姫は、私の前にいたが、鞄の中から、丸薬入りの缶を出して、私の掌に、三つの黒い丸薬をのせた。",
              "citation": {
                "source": "地球要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "公爵は、ラスプーチンを階上の食堂へ案内し、毒薬入りの葡萄酒をすすめた。",
              "citation": {
                "source": "世界の裏",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ず物置から火薬入りの鑵を取り出して薄暗い電灯のついて居る勝手元に置いた。",
              "citation": {
                "source": "鼻に基く殺人",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "六ツばかりある引出しには、絃や、小鋏や、懐中持ちの薬入れに入れた、絃に塗る練油などが入れてあった。",
              "citation": {
                "source": "神田附木店",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "長さおよそ一尺ぐらい、酒ならば一升五合も入るべき黒塗り革製の弾薬入れであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "三輪の神杉の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと目見、ちょっと触ってみて、ヴァランタンの臂のそばに丸薬入りの小函があることを見た、人々はヴァランタンが椅子の中に冷たくなっている事を知った。",
              "citation": {
                "source": "秘密の庭",
                "author": "THE SECRET GARDEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "左の肩まで届いている大きな皮の前掛けを掛けていて、その上に帯をしめてポケットのようになった所に、槌や赤いハンケチや火薬入れや種々なものを入れていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "『邪宗門』がちんぷんかんぷん解らなくとも、えたいの知れぬ麻薬入りの活字があの中に封じこめられていることだけは、今日の私にも解るのである。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "籠手、脛当、胴、腹巻などの物具はいうもおろか、金創薬、燧打、弾薬入れ、すべて身に纏うばかりに揃えてあるのだった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "……茂助どの」「はい」「これへ来い」　隼人は、のろし筒と、硝薬入れとをそこへ出して、茂助に伝授していた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来印籠は印の入物であるが、携帯用の薬入れとしても重宝がられた。",
              "citation": {
                "source": "樺細工の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
