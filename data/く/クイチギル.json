        "examples": {
          "standard": [
            {
              "text": "リンゴを食いちぎる音がして、隣の部屋から聞こえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "犬はおもちゃを食いちぎって、ボロボロにしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子どもはパンを食いちぎりながら、走り回っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "鋭い歯はありませんけれども何せ力が強うございますから、人間の指の一本や二本は、わけなく食いちぎるそうで、どうも、いやになります。",
              "citation": {
                "source": "黄村先生言行録",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "乳首食いちぎるに」　妻は慳貪にこういって、懐から塩煎餅を三枚出して、ぽりぽりと噛みくだいては赤坊の口にあてがった。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに二三春がとち狂ったにしても、ほれてほれてほれぬいた男の小指を食いちぎるはずあねえですぜ」「うるせえや。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "あごが魚を食いちぎる音や、下から襲ってくる魚に船が揺らされる音が聞こえる。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "喰いちぎってやりたい……人間が人間を喰いちぎる……一瞬にして変貌する女の顔がパッと僕のなかで破裂したようだった。",
              "citation": {
                "source": "火の唇",
                "author": "原民喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
