    },
    "definitions": [
      {
        "index": 1,
        "gloss": "gods of the land",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "天津神に対し、地上の神々を国津神と呼ぶ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "日本の神話には、多くの国津神が登場する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "国津神は、その土地の豊穣や安寧を守る存在として崇められてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "もし違乱に及び候わば、八百万の天津神、国津神、明らかに知ろしめすべきところなり。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこれらの先住民族の首領と仰ぐものを、古史には「国津神」と称している。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "天孫瓊々杵尊の日向に降臨し給うや、国津神たる事勝国勝長狭は、自ら進んで潔くその国土を天孫に奉った。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じく国津神たる大山祇神は、その女木花開耶姫を献じて、天孫の妃となし奉った。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして天孫の御子なる彦火火出見尊、その御孫なる草葺不合尊は、また共に同じく国津神たる海神の女を妃と遊ばされたと伝えられている。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "我が「日本民族」は、実に天津神の後裔たる天孫民族と、これに同化融合した国津神の後裔とが、相倚り相結んで成立したのである。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず天皇は、さらに天社・国社を定め、神地・神戸を奉りて、あまねく天津神・国津神をお祭りになった。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ以て我が「日本民族」が、天津神と国津神とを祖神と仰ぐ両民族の、完全なる融合同化から出来た複合民族であることを、立証したものと謂わねばならぬ。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "果して然らばその国津神と云い、先住土着の民族と呼ばれるものは、果していかなる系統に属するものであるか。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただに国津神の後裔のみならず、秦・漢・百済等海外諸蕃の裔を承けたもので、入って皇妃・夫人の列に加わったものさえも、史上その例に乏しくはない。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "またこれを古伝説に徴するも、天孫降臨以来代々国津神の女を妃と択び給うたとある。",
              "citation": {
                "source": "「ケット」と「マット」",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "国津神はすなわち先住民で、その相互の関係は、天津神は父たり、夫たり、国津神は母たり、妻たるの間柄であった。",
              "citation": {
                "source": "「ケット」と「マット」",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に少彦名命の研究にも一寸述べておいた様に、我が国津神の中に久久都彦・久久都媛という二神の名の見ゆることによってである。",
              "citation": {
                "source": "くぐつ名義考",
                "author": "古代社会組織の研究",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯浅村｜顕国神社も此神を勧請せるにて、国津神とも唱ふ、……名所図会云、『国主神社は古くより久授呂宮と云ひ伝ふ。",
              "citation": {
                "source": "国栖の名義",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは古伝説において、国津神または地主神として伝えられたものである。",
              "citation": {
                "source": "国栖の名義",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "今もお稲荷様を始めとして、神社に往々その社殿や玉垣や鳥居やを赤く塗る習慣の遺っているのは、もと国津神の社から起ったのではないかと自分は疑っている。",
              "citation": {
                "source": "炭焼長者譚",
                "author": "系図の仮托と民族の改良",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　結語　炭焼長者の出世物語は世にありふれた俗伝として、ハハアここにもあるのかと軽く笑ってすます程度のものではあるが、これを民族上より観察すれば、我が国において、天津神の系統と国津神の系統とが、渾然融和して区別なきに至った道筋を示すものとして、尊重せねばならぬものではあるまいか。",
              "citation": {
                "source": "炭焼長者譚",
                "author": "系図の仮托と民族の改良",
                "note": "青空文庫"
              }
            },
            {
              "text": "我が神代の古伝説によっても、天津神系統の天孫民族は現界を掌り、国津神系統の先住民族は、幽界の事を掌ると信ぜられていた。",
              "citation": {
                "source": "憑き物系統に関する民族的研究",
                "author": "その一例として飛騨の牛蒡種",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の考察するところによれば、所謂オオミタカラなる里人といえども、その大部分はやはり国津神を祖神と仰ぐべき先住民の子孫である。",
              "citation": {
                "source": "憑き物系統に関する民族的研究",
                "author": "その一例として飛騨の牛蒡種",
                "note": "青空文庫"
              }
            },
            {
              "text": "この雑戸には、先住の土着人すなわち、後に申すところの所謂｜国津神系統の民族や、支那・朝鮮の帰化人の子孫が多い様ではありますが、土着人だからとて、帰化人だからとて、その理由で賤しむと云うことは我が古史には見えませぬ。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでさらに遡って、本来傀儡子というのはどんな者であったかと申すと、これは主として土着の民族、すなわち国津神系統の民族と、世の落伍者とであろうと思います。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂国津神の系統の民族です。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "我が日本の国には、神様に天神・地祇という区別がありまして、すなわち天津神・国津神ですが、その天津神とは高天原の神様、すなわち天孫民族の祖神と仰ぐ神様で、国津神とは天孫降臨以前からこの国土におられた神様、すなわち先住民族の祖神と仰ぐ神様です。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "近く明治・大正の御大典の際に於かせられても、大甞祭に悠紀殿・主基殿において、天皇陛下はまず新穀を天津神・国津神に捧げ給うというようなことであります。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "最古の皇室の御成立の御次第を申しますならば、天孫｜瓊瓊杵尊が日向の高千穂峯にお降りになりますと、国津神の事勝国勝長狭という者が、土地を献上して服従し奉った。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "また同じく国津神の大山祇神は、娘の木花咲耶姫を尊の御妃として奉ったのであります。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてその御子の彦火火出見尊の御妃も、同じく国津神の豊玉姫で、さらにその御子の鵜草葺不合尊の御妃は、その豊玉姫の御妹の玉依姫と申すお方でありました。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇大和に御即位になって、皇后をお立てになるに、国津神｜大物主神の女｜五十鈴姫命をお択びになりました。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
