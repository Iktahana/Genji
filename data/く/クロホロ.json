          "literary": [
            {
              "text": "「呼びかえせ」　伝令の黒母衣を負った一騎が、命をおびて、すぐ本陣から急いだ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "返せッ返せッ」　しかし、かれの左右にいた黒母衣五十人組も、老臣や諸頭たちも、ひとたび崩れ立っては、逃げ足が止まらなかった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ、味方の黒母衣か誰かが残っていて、死闘をふるっているものとみえる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
