        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「故郷の嘲笑、故郷の嘲笑――今に………クツツ！",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "汗でシャツは脊中にクツツク……。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「つきぬ」とは何の意味かわからず、あるいはクツツクの意か。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "それならば空よりふる雪のクツツキたるか下につもりたる雪のクツツキたるか、いづれにしても穏かならぬやうなり。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、灸點師は火をクツツケてしまつた。",
              "citation": {
                "source": "お灸",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
