        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夫人間ノ浮生ナル相ヲツラツラ觀ズルニ、オホヨソハカナキモノハ、コノ世ノ始中終マボロシノゴトクナル一期ナリ、――てれくさくて讀まれるものか。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　――ワクシハ、オマエト、イッショニ、クラスコトガ、デキナクナルモノ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手は比の頃、ベルクナルにも劣るまいと評判の高い活動写真の悲劇女優である。",
              "citation": {
                "source": "アンドロギュノスの裔",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "涅槃堂、マタ人ノ病ムナシ、何故ニ、コノ如クナルト。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ本書ニ説述シタ吾ガ田内整形手術ガ全世界ニ普及セラレタル暁ニハ、世界中ニ只一人ノ醜イ人間モ存在シナクナルデアロウ云々」　実に大胆なるヒルミ夫人の所説だった。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上ノ如クナルヲ以テ、芋ヲ焦焼スルコトナク（僕はいささか焦げた方が好きです）、蒸焼シ得ルノミナラズ蒸焼ヲ二回ニ順次行ウヲ以テ塩ノ浸滲ハ良好ニ行ワレ（とてもタマランです）、更ニ蓋ニ保温室ヲ設クルコトニヨリ之ヲ焼冷シトナスコトナカラシメ、常ニ保温シ得ル等ノ効果ヲ有ス。",
              "citation": {
                "source": "発明小僧",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "何奈ンゾ之ヲ賜ハル恩沢ヲ忘レテ、之ヲ遣フ湯水ノ如クナルヤ。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キミモ　イマニハ　オホキクナルサ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ　イクラ　ガマンシテモ　ネムタクナルバカリデス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ　イクラ　ガマンシテモ　ネムタクナルバカリデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "座敷をデイ、寝室をチョーダイなどと云ったし、病気を「悲シイ」、病気ニナルが「悲シクナル」、尊トシヤ、だとか、大いに驚く時に「あな、うたてやな」と今も言うそうだね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫ノ羽族ノ序ヲ逐ヒ影ヲ聯ネテ飲啄相離ルヽコトナキガ如クナルコト能ハズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎ニ角予ハ助六ノ芝居ガ好キナノデ、助六ガ出ルト聞クト、勘弥ノデモ見ニ行キタクナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ蔭デ左手ノ神経痛ガ一層痛ミ、皮膚感覚ノ麻痺モ激シクナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ何カ喰ッテモイヽナ」「冗談ジャナイ、ソレデ足リナインデスカ」「足リナイコトハナインダガ、コヽヘ来ルト関西ノモノガ恋シクナルンダ」「グジノ一ト塩ガアリマスゼ」ト浄吉ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ時間ト回数トヲダン／＼ニ殖ヤスヨウニシテ二三カ月モ続ケレバヨクナルダロウトノ事。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワガ家ニ来テカラ既ニ十年近クナルノニ、歳月ヲ経ルホドマス／＼美シクナリツヽアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ガ買ッテ来タドルシンヲ三錠ズツ日ニ三回服用、オ蔭デ痛ミハ軽クナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕刻、六時頃カラ手ノ冷エ方ガ一層激シクナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウデスカ、少シハイヽ方デスカ」「イヽドコロカ、マス／＼悪クナル一方ダ」「ダッテ、髯ナンカ剃ッテサッパリシテルジャアリマセンカ」予ハ実ノトコロ、手ガ痛ムノデ剃刀ヲ使ウノモ不自由ナンダガ、ソレヲ怺エテ今朝剃ッタバカリデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "睡眠剤モ時々イロ／＼取リ代エテ使ワナイト直グ利カナクナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヤ、ソコガアノ方ノ偉イトコロデスヨ、麻酔ドクターマデ呼ンデ十分ノ用意ヲシテカヽッタンダカラ、誰デモヤッテシマイタクナルトコロダガ、僅カ一滴ノ血ヲ見タヾケデモ大事ヲ取ッテ中止スルト云ウコトハ、ナカ／＼出来憎イコトデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………「少シヨクナルト直グソレダカラオ爺チャンハ困リマスヨ、モウ暫ク様子ヲ見テカラニナスッタラドウ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ンデシマエバソンナコトヲ考エル意志ハナクナルデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉体ガナクナレバ意志モナクナル道理ダケレドモ、ソウトハ限ルマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヤコレヤデ僕ハ一層手ノ施シヨウガナクナル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "因果ナ※ニ、僕ハソコマデ想像スルトイヨイヨタマラナイ嫉妬ヲ感ジ、ソノ嫉妬ノ快感ノユエニアエテソノ危険ヲ冒シテミタクナルノデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
