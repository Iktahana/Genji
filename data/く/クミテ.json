    "definitions": [
      {
        "index": 1,
        "gloss": "wooden joint",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔の建築では、釘を使わずに精密な組み手で木材を接合していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大工職人から組み手の技を習得するには、数年の修行が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この木製の欄間の組み手の細かさは、職人の技術の高さを示している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "おれはバーユー将軍の、からだをよくみて知つてゐる。",
              "citation": {
                "source": "北守将軍と三人兄弟の医者",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かろく冷たき微風も鹹をふくみて薄青し、「秋」は流行の細巻の黒の蝙蝠傘さしてゆく。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひなた石の面にほのとぬくみて。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "鷽鳥よいづくにか鳴き、くくみて、色、匂、さまわかず、風なるか、空なるかも。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "子らと来て、足投げて、膝くみて、ただにしろきかも。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると猫がまた「けれど、どうも耳が長過ぎるね」と、つくづくみてゐて批評しました。",
              "citation": {
                "source": "ちるちる・みちる",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともし灯を中にかくみて。",
              "citation": {
                "source": "長塚節歌集　上",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　おかみさんは、参事官の顔をうさんらしくみて首をふりました。",
              "citation": {
                "source": "幸福のうわおいぐつ",
                "author": "LYKKENS KALOSKER",
                "note": "青空文庫"
              }
            },
            {
              "text": "人生上から文芸を軽くみて、心の向きしだいに興を呼んで、一時の娯楽のため、製作をこころみるという、君のようなやり方をあえて非難するのではない。",
              "citation": {
                "source": "去年",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "（四）　郊外になど住んでゐると、色々な物売が、女子供とみれば甘くみて、押つけがましく、恐喝らしく玄関先に品物を拡げ、買つてやらなければ何時までも立去らうとしないことが多い。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年は腕をくみて考える。",
              "citation": {
                "source": "蟹満寺縁起",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ若きは酒くみて、甘き夢に興がるを、獨り冷えし堂に入り、破れしみ經や讀むべき。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほのかなるぬる火のぬくみ、胸の脈ゆたにむくみて、　　　　火吹だるま、初立ちし生命の日かな、面はゆに火屑を吹きぬ。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "美しい人の美しい心ざし、よくみてやりな」　そして、なおよよとばかりに泣き伏していたお弓のむっちりと美しい右手を取りあげながら、そおっと伝六の目の先につきつけたものでしたから、伝六はいぶかって、まじまじと見ながめていましたが、やがて吐き出すようにいいました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちが「僚友会」を重くみていたのは、そこには臨時工はホンの少ししかいなかったが、本工が多かったからである。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれを甘くみてやがるとしょうちしねえぞ。",
              "citation": {
                "source": "透明猫",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、将棋さし二人男のほうをつくづくみていたが、急に飛びあがった。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "九『草くだものの償ひに、秋のとまりの神無月、末枯を小野に齎らする『日』は、鈍の葉もはぐくみて、咲いたか、花の忘れぐさ。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "五『曾ては、深き青山の老木の枝の巣ごもりに、つがひの雛を羽ぐくみて、夫を待ちゐた日もそろ。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "我家の方角なれば、気遣しとてわれを負ひながら急ぎ帰りしが、我が住む横町へ曲らんとする瞬間、思ひがけなくも猛烈なる火は我家を焼きつつありと見るや母は足すくみて一歩も動かず。",
              "citation": {
                "source": "わが幼時の美感",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそれを何ということもなくとっくりとみていたかったが、歩いていると、それはただそれだけではなしに、実はそこにもここにもといったぐあいにあるのであって、誰も私のように物珍しくみているものなぞはないのである。",
              "citation": {
                "source": "余齢初旅",
                "author": "――中支遊記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "かひ／″＼しく、水をくみて運びゆく女もあれば、買物風呂敷さげて歸る女もあり。",
              "citation": {
                "source": "飛鳥山遠足",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふうん、面白いんだねえ‥‥植物って、なかなかしんけいしつなんだね」「そりやそうさ、生物ってものは、ちゃんとよくみてやらなくちゃ何にもならないよ。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "よくみていると、初秋に飛んで来るみそさざいが、ちょん、ちちちっと気ぜわしく飛びはねているが、死んだ田舎の祖母が、「みそさざいが来ると、雪が降るだよ」と言った事を思い出して、秋はいいなア、と啓吉は思わず空を見上げた。",
              "citation": {
                "source": "泣虫小僧",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜も光井がよくみていると、重吉が泳ぎに例えれば二肩ばかりまわりを抜いたと思われたところがあった。",
              "citation": {
                "source": "道づれ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｋさんは、未だ高等商船を出たばかりで、学生気の抜けない明るい青年で、後輩のぼくの面倒をよくみてくれて、船の隅々迄、案内もしてくれるし、一緒に記念｜撮影などもしていました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとりで、暗い海を暫くみてから、寝に帰ろうと、喫煙室のなかを通り抜けていると、一隅で沢村、森、松山、東海さん達が、麻雀をやっていましたが、「おい、おい」と河村さんが、ぼくを呼びとめます。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
