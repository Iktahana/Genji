[
  {
    "uuid": "fb852485-5ee6-5649-bc06-9bb051fce4cd",
    "entry": "口当たり",
    "reading": {
      "primary": "くちあたり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
