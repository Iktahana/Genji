    },
    "definitions": [
      {
        "index": 1,
        "gloss": "taste",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このお茶は口当たりがとても滑らかで、飲みやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "初めて食べたこのデザートは、予想外の口当たりだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ワインの口当たりが良くて、つい飲みすぎてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "風薫る初夏の時候に応じたまことに気分のよい、また口当たりのよいものである。",
              "citation": {
                "source": "鮑の宿借り作り",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで飲みやすいかと騙されて飲むと、もともと苦くて口当たりの悪いのに変りはないのです。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "人口当たりニューヨークの火事はロンドンの四倍だ。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは既に知られていた化合物がビタミンとなった唯一の例であり、今では口当たりの良い“ナイアシン”の名称が与えられている。",
              "citation": {
                "source": "栄養学小史",
                "author": "A Short History of Nutritional Science",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷たい軽い風のある日で、ワイシャツの袖口あたりに、ウブ毛の風に靡くのが感じられるやうなふうであつたことを記憶してゐる。",
              "citation": {
                "source": "亡弟",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "天狗の大木を伐り倒す音がめりめりと聞えたり、小屋の口あたりで、誰かのあずきをとぐ気配がさくさくと耳についたり、遠いところから山人の笑い声がはっきり響いて来たりするのであった。",
              "citation": {
                "source": "魚服記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "所が、その時｜衣摺れのような音が――たしか天井の、それも簀子の方へ行く、階段の口あたりでしたと思われたのです。",
              "citation": {
                "source": "オフェリヤ殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手に草稿を持つた儘、ぢつとして考へてゐる岡田の耳に、廊下一つを隔てた講堂の口あたりから人声が聞えた。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど赤楽の茶※を手にした茶人が、その釉薬のおもしろみに、火の力を感じると同時に、その厚ぼったい口あたりに、茶を啜るときの気持よさを感じるのと同じようなものだ。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこいらのゴミ溜や、よその畠から失敬して来た材料にアニリン塗料とサッカリンで色と味を附けた、ちょっと口あたりのいい料理を作るのが芸術界の大勢になって来る。",
              "citation": {
                "source": "路傍の木乃伊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "“SORI-BATTEN!”秋のお祭がすみ、立ってゆく博多｜二〇加のあとから戰のやうな酒つくりがはじまる、金色の口あたりのよい日本酒。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "14その酒の、その色のにほひの口あたりのつよさよ。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "“SORI-BATTEN!”秋のお祭がすみ、立つてゆく博多｜二〇加のあとから戰のやうな酒つくりがはじまる、金色の口あたりのよい日本酒。",
              "citation": {
                "source": "思ひ出",
                "author": "抒情小曲集",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに、もしもチチコフが何処かお寺の門口あたりでこんな服装をした相手に出会ったとしたら、きっと二カペーカ銅貨を一枚くれてやったに違いない。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "いったん、やめて見た酒も、口あたりのよいやつを鼻の先へ持って来ると、まんざらでもない。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうだ――」と三吉はお雪に、「この酒は、欧羅巴の南で産る葡萄酒だというが――非常に口あたりが好いぜ。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それとも酔醒めの口あたりにはアブサンが好いでせうかな。",
              "citation": {
                "source": "露路の友",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、彼の目は自動車にそそがれるよりも、警察署の表口と裏口あたりにそそがれる方がひんぱんであった。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "口あたりはいいが、呑むと胃袋の内壁に銀鏡で出来て、いつまでももたれていけません」「ま、真逆ね」「本当ですよ。",
              "citation": {
                "source": "大使館の始末機関",
                "author": "――金博士シリーズ・７――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……縁起直しに、いま古い葡萄酒でも持ってくるわ」　あたしたちは、それから口あたりのいい洋酒の盃を重ねていった。",
              "citation": {
                "source": "俘囚",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "サラッとした口あたりが殊によい、梅干は古いほどよかった。",
              "citation": {
                "source": "茶粥の記",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "無気味に、がらんとしていた広場だったのに、いま伸子たちが爪立って前方を眺めようとしている横通りへの出口あたりは、黒山の人だった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この芹が恒吉の自慢で、池の水の落ち口あたりに自生してるのでした。",
              "citation": {
                "source": "崖下の池",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "漢口あたりの水面の高低は、夏冬に四十五六｜呎も違いますよ。",
              "citation": {
                "source": "長江游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "さし当り口を突いて出て来た調子のままに、口あたりよき雅言が、詠歎的に歌調をなしたまでのことで、つまり多少とも、清澄の茂太郎にかぶれたものと見ておけばよい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "勿来の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、いい年をして、木口あたりの手下になって、頭を下げに来る、老爺の人のよい姿を見ると、鐚も物の哀れを感じないわけにはゆきません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは草原地の野牛にあっては、口あたりのよい草の幾インチかと飲み水だけである。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "小麦もこころみたが、結局ライ麦粉とトウモロコシ粉とをまぜたのがいちばん便利で口あたりもよいのを発見した。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅の出口あたりで、途方にくれておろおろしている叔母のようすが見えるようで、思っただけでも胸がつまるようだった。",
              "citation": {
                "source": "野萩",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "次郎は、女が店を出るとすぐ、なるほど学校の通り道に春月亭という料理屋があり、今のはその門口あたりでよく見かける女だった、ということに気がついたのである。",
              "citation": {
                "source": "次郎物語",
                "author": "第三部",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
