[
  {
    "uuid": "8a886073-cc18-5a18-808e-a52470ec7383",
    "entry": "食い違う",
    "reading": {
      "primary": "くいちがう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
