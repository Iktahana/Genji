          "literary": [
            {
              "text": "モウ　ヂキ　ハルガ　クルノデス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤ、ナルホド、コノ　ウチモ　ヤツパリ　カナヅチガ　ツクルノダナ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「マタ　ハツパノ　トコヘ　カヘツテ　クルノ」「モウ、キマセン。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カイドウニ　ソツタ　イエイエノ　ヒトタチハ、ムカシ　ジブンタチノ　ノツタ　バシヤガ　コドモタチニ　ヒカレテ　イクノヲ　ミルト、シゴトヲ　ヤメテ　オモテニ　デテ、バシヤヲ　ミオクルノデ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ミンナハ、カゲト　イフ　モノハ　タイヤウガ　ツクルノダト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ノ理由ハ在郷軍人團ナル好適ノ機關ナク、今ノ植民政策的頭腦ノ總督府等ニ此ノ大任ニ當ラシムルハ明白ニ不正不義ヲ殘シテ改造ノ精神ヲ傷クルノミナラズ、或ハ意外ノ變ヲ招クベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ問題ハ活字ト関係ガナサソウデアルガ、原稿ヲ書ク場合ニ関係ガ生ジテクルノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "中山伊知郎『数理経済学方法論』（改造社版・『経済学全集』第五巻）、及びＡ・クルノー『富の理論の数学的原理に関する研究』（中山訳）を見よ。",
              "citation": {
                "source": "科学論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで例えば、クルノーの確率主義（Probabilisme）は一定の重大な意味を持って来なければならぬだろう＊＊。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ前ガ出テクルノヲ待ツ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マゼクルノデハ無クテ、オサメルツモリデショウ」「親子トモドモ、若松港ノガンジャワイ」トイッタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑ハ、以テソノ及バザル所ヲ、補クルノミ……　と。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
