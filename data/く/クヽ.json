          "literary": [
            {
              "text": "『ククヽヽクウ』と、すぐ頭の上、葉隠れに昼杜鵑が啼く。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、少し隔つた彼方から、『ククヽヽクウ』と同じ声が起る。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ククヽヽクウ、ククヽヽクウ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ククヽヽクウ』と鳥の声。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ククヽヽクウ』と、すぐ頭の上、葉隱れた晝杜鵑が啼く。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、少し隔つた彼方から、『ククヽヽクウ』と同じ聲が起る。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ククヽヽクウ』と鳥の聲。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、彼を変に感心させて、「お前さへしつかりしてゐれば、大丈夫だよう、いくつだと思ふのさ、ほんとにお前はよう……ほんとうなら阿母さんは、クヽヽヽヽ。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ歩キニクヽテモ、毎日少シズツデモ歩カナケレバイケナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「折角ソコマデ習ッタノニナゼ止メタンダネ」「ダッテ、トテモ足ガ変形シチャッテ醜クヽナルノヨ」「ソレデ止メタノカネ」「アタシ、足ガアンナニナルノハイヤダワ」「ドンナニナルノサ」「ドンナニナルッテ、ソリャヒドイノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「クックヽヽヽ」　と僕は吹き出してしまった。",
              "citation": {
                "source": "冠婚葬祭博士",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
