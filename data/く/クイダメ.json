        "examples": {
          "standard": [
            {
              "text": "明日は忙しいから、今日は食いだめしておこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "病気で何日か食べられなくなるから、今から食いだめをしておく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "旅行前に好物を食いだめするのは、良い思い出になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "平常ご馳走らしいご馳走もたべない村の人たちもお盆中はいろいろのご馳走をつくって一年中の食いだめをする。",
              "citation": {
                "source": "山の秋",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
