          "literary": [
            {
              "text": "眼をつぶるとさまざまの花が、プランクトンが、バクテリヤが、稲妻が、くるくる眼蓋の裏で燃えている。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イマハ山中、イマハ浜、イマハ鉄橋、ワタルゾト思ウ間モナクトンネルノ、闇ヲトオッテ広野ハラ、どんどん過ぎて、ああ、過ぎて行く。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "狐は可笑しさうに口を曲げて、キックキックトントンキックキックトントンと足ぶみをはじめてしっぽと頭を振ってしばらく考へてゐましたがやっと思ひついたらしく、両手を振って調子をとりながら歌ひはじめました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キック、キック、キック、キックトントントン。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キックキックトントンキックキックトントン　　凍み雪しんこ、堅雪かんこ、　　　　　　野原のまんぢゅうはぽっぽっぽ　　酔ってひょろひょろ太右衛門が　　　　　　去年、三十八たべた。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キックキックキックキックトントントン　写真が消えました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キックキックトントン、キックキック、トントン、　　凍み雪しんこ、堅雪かんこ、　　　　　　野原のおそばはぽっぽっぽ、　　酔ってひょろひょろ清作が　　　　　　去年十三ばい喰べた。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キックキックトントン、キックキックトントン。",
              "citation": {
