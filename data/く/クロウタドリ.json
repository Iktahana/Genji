        "examples": {
          "standard": [
            {
              "text": "電線に止まっている黒歌鳥が、美しい声でさえずっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "朝早く、窓の外から黒歌鳥の歌声が聞こえてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "公園で黒歌鳥のひなを見つけて、そっと親鳥の元に戻した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そとの　はらっぱにいる　つぐみや　くろうたどりを　のぞいたり、　あと　ともだちの　こまどりくんもね。",
              "citation": {
                "source": "まちねずジョニーのはなし",
                "author": "THE TALE OF JOHNNY TOWN-MOUSE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
