        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "公園の入り口に設置された車止めにより、車両の進入が制限されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "商店街の歩行者天国には、デザイン性の高い車止めが並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "不法な車両の侵入を防ぐため、敷地境界に車止めを設置した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
