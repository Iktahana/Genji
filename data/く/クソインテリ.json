        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "てめえみたいな、くたばりぞこないのクソインテリに、おどかされて――佐山　食いものは、この三人の、みんなのもんだ。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "クソインテリの観念過剰だ。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……クソインテリの、思いきりの悪い、疑ってばかりいる、弱虫の、青っしょびれた、テレてばかりいる、ウジウジと世間のことばかり気にする、命がけになれない、チットばかり良心的みたいな、そいでイザとなると逃げてばかりいる――クソインテリは、あん時、死んじまって、俺あ、別の人間になっていたんだ。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、俺がクソインテリだからだ。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
