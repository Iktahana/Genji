          "literary": [
            {
              "text": "そこでハヤブサワケの王とメトリの王と、共に逃げ去つて、クラハシ山に登りました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでハヤブサワケの王が歌いました歌、梯子を立てたような、クラハシ山が嶮しいので、岩に取り附きかねて、わたしの手をお取りになる。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、梯子を立てたようなクラハシ山は嶮しいけれど、わが妻と登れば嶮しいとも思いません。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
