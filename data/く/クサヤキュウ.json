        "examples": {
          "standard": [
            {
              "text": "毎週末、会社の仲間たちで草野球をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "草野球の大会は、地域の交流深化の場として盛り上がっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子どもの頃は、放課後に毎日草野球をして遊んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "草野球のタマ拾いがいいところだ」「今に見てやがれ。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京で頭のひどく忙しい彼は休日に草野球を見ることで轉換を計つてゐるらしい。",
              "citation": {
