    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "銅貨のふくしゅうだ。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、しゅくしゅく鳴きながら苦しみを訴える鹿の眼の懸命に戸惑う瞳の閃きに一点の偽りもないのを見ると掻き抱いてやり度いようだった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あのウ母様（だって、先生、先生より花の方がうつくしゅうございます）ッてそう謂つたの。",
              "citation": {
                "source": "化鳥",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "王子は、にこにこしながら、人々とあくしゅしていました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "あくまでも徳川にふくしゅうしようっていう魂胆で、まずそれには、というところから伊豆さまのご藩中へ先に巣を造り、巧みに所所ほうぼうへあのとおりのさるまわしとなって駆けまわり、将軍家の日光ご社参の機会を探っていたというわけさ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "必ずこのふくしゅうをしろ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "生首の進物",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女が命よりもたいせつなはだを、人の仲間にもはいれない非人に許すんだもの、気違いのまねでもしなきゃ、正気じゃできねえじゃねえか」　――しかし、それほどのしんけんなふくしゅうに、貞操をふみにじってまでも行なったふくしゅうに、上のお慈悲が届かないはずはありませんでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "生首の進物",
                "note": "青空文庫"
              }
            },
            {
              "text": "王　　美くしゅうは熟れても、心のやくたいものうくされはてたのが多いのじゃ。",
              "citation": {
                "source": "胚胎（二幕四場）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "使うときは、その缶づめの栓をひらくと、その穴からＱＱガスがガス状になってはげしくしゅうしゅうとふきだすのです。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで直ちに部隊は隊伍をととのえて、しゅくしゅくと行進をはじめた。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この暮はまったくしゅらの巷でしょうね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "風あたたかに空は晴れて、洋々たる春の平野を少年連盟はしゅくしゅくとしてねってゆく。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを見ていたおえいは驚いて、アレーと云いながら逃出しますと、馬は尚更暴れておえいを追掛けて、背後からおえいの髷を囓えて後へ引倒して、花嫁の美くしゅう濃てりとお粉粧をした顔を馬がモリ／＼ッと噛みましたから、これは全く馬が多助の讎を討ったようなものでございます。",
              "citation": {
                "source": "鹽原多助一代記",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "定刻となれば、砂場の穹門から陽気な軍楽隊を先に立て、しゅくしゅくと繰り出して来たのが、金糸銀糸で刺繍した上衣に鍔広帽子をかぶった仕止師、続いて銛打師、やせ馬にまたがった槍騎士。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "乱視の奈翁　――アルル牛角力の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はくしゅされたら、これであいさつする。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "てきぱきゆでゆで　ぐにゃぐにゃまぜまぜ　くしゅんと入れて　いち、に、さん　さいしょはかみさん、つぎは猫に、さいごは赤子の分なのさ　コックはスープと赤んぼに代わる代わるコショウをかける。",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "御前さままでときおりはくしゅん、赤ちゃんはというと、ひっきりなしにかわるがわるくくしゅんおぎゃあ。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさに　そのとき　ピーターが　くしゃみを　――「はっくしゅん！",
              "citation": {
                "source": "あなうさピーターのはなし",
                "author": "THE TALE OF PETER RABBIT",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の黒いステッキを握ると、エザウの首っ玉をつかんでつるさげておいて、泣き叫ぶ小犬をめったうちにしながら、同時に憤懣のあまり我を忘れて、物すごくしゅうしゅういう声で、何度も何度もこういった。",
              "citation": {
                "source": "トビアス・ミンデルニッケル",
                "author": "TOBIAS MINDERNICKEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつはふくしゅうしたかったのです。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「エッ、ふくしゅうですって？",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "いったいなんのうらみで、だれにふくしゅうしたいというのですか。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それであいつのふくしゅうの目的は、じゅうぶん達したわけなのです。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、ぼくが事件に関係して、にわかに蛭田博士の身辺があやうくなったものだから、ほかの少年たちを誘かいすることはあきらめて、そのかわりに、こんどはぼく自身にたいしてふくしゅうしようとしたのです。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのぼくが、もしべつの私立探偵と競争して、むざむざ敗北したならば、こんな痛快なふくしゅうはないじゃありませんか。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし、これほど世間をさわがせて、わが身の危険をおかしてまで、そんなふくしゅうをするというのは、いったい何者です。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
