          "literary": [
            {
              "text": "クセニエンわたし共は小さい剪刀を持った虫になって来ています。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "と言つて、たれかれの私に寄するクセニエに、一向私は恐れない。",
              "citation": {
                "source": "わがひとに与ふる哀歌",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし安穏を私は愛するので、その片よつた力で衆愚を唆すクセニエから、私は自分を衛らねばならぬ。",
              "citation": {
                "source": "わがひとに与ふる哀歌",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは自分で自分にクセニエを寄することである。",
              "citation": {
                "source": "わがひとに与ふる哀歌",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそのクセニエの中で、いかにも悠々と振舞ふ。",
              "citation": {
                "source": "わがひとに与ふる哀歌",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "たれかれの私に寄するクセニエに、寛大にうなづき、愛嬌いい挨拶をかはし、さうすることで、彼らの風上に立つのである。",
              "citation": {
                "source": "わがひとに与ふる哀歌",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうして私は静かなクセニエを書かねばならぬ！",
              "citation": {
                "source": "わがひとに与ふる哀歌",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
