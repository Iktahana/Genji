        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "よほど国引き神話に近づいて居るし、あまんしやぐめの嫉みも、童話に危く堕ち相な境目を示してゐる。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤ遠き国は綱うち掛け、もそろよと、もそろと、国引くと、引き寄すと。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ロ）『出雲国土記』には、臣津野神の「国引」の説話あり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀吉の怖るべき理由は、中国引っ返し以後、山崎の合戦でも、清洲会議のときでも、飽くほど、胆に知らされて来た勝家である。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "平家が長門国引島に着くと同時に、源氏が同じく長門の追津に着いたのは、天の配剤であったろうか。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "中国引揚者に、ハイや蚊がいないという話を、さもうらやましそうに聞いてばかりいないで、頼まれなくとも、鼠とゴキブリくらいは、自分で楽しみながら退治したらいいだろう。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
