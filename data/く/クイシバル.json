[
  {
    "uuid": "22fec222-55eb-5714-beca-773bc3fc52a8",
    "entry": "食いしばる",
    "reading": {
      "primary": "くいしばる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
