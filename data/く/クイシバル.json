    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "嗚咽びかえっているのです、それを見た武の顔はほんとうに例えようがありません、額に青筋を立てて歯を喰いしばるかと思うと、泣き出しそうな顔をして眼をまじまじさせます。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤコフ・イリイッチは歯を喰いしばる様にして、お前も連帯であげられ無えとも限ら無えが、「知ら無え知ら無え」で通すんだぞ、生じっか……　此の時ぴーと耳を劈く様な響きが遠くで起った。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲哀というよりも、むしろ悲壮といいたい表情、歯を喰いしばるようにして眼を閉じたのであった。",
              "citation": {
                "source": "蜜柑",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべからく現代を超越すべしといった才人はとにかく、僕は是非共｜生死を超越しなければ駄目だと思う」　兄さんはほとんど歯を喰いしばる勢でこう言明しました。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべからく現代を超越すべしといった才人はとにかく、僕は是非共生死を超越しなければ駄目だと思う」　兄さんはほとんど歯を喰いしばる勢でこう言明しました。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは歯を喰いしばるような矢代の痛さだったが、日本へ帰っても今の気持ちが切れるものなら、それならいっそ今のうちに切ってしまうのも、二人のためと思うことに変りはなかった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い能役者は、鬼の面をつけると、面の下で自分の歯迄喰いしばる。",
              "citation": {
                "source": "日記",
                "author": "一九二四年（大正十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉛を溶かしたように熱いのが顔中に溢れて、悪蛇のうめくようは――（息のつまる笑い）ちょうどそばに細長い石があったのをへらへらした舌の中へ、喰いしばる歯をたたき破って押し込むとだんだん呻くのが、きえて行く煙のように断え断えになって来た。",
              "citation": {
                "source": "道成寺（一幕劇）",
                "author": "郡虎彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "捕まえたら、眼球でもくり抜いてやろうと思っている」　たった一つの眼を光らせて、一徹な歯を喰いしばる利助の気持を、平次はもとより察し兼ねたわけではありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "永楽銭の謎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あッ、ツ」　身体をねじ曲げて、歯を喰いしばる女の苦悶の姿は、どうかしたら、兵庫には快いものに映るのかもわかりません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "大村兵庫の眼玉",
                "note": "青空文庫"
              }
            },
            {
              "text": "振袖の下へ鎖帷子を着せておいたので、力任せで刺した匕首も、五分とは斬らなかったよ」「…………」　錦太郎は何べんかお福に飛びかかりそうにしましたが、その都度、平次の眼に威圧されて、キリキリと歯を喰いしばるばかりです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "ガラッ八祝言",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうだね、人は許さないだらうね」と云つて齒を喰ひしばる樣にした。",
              "citation": {
                "source": "半日",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と彼は激しく總身を震はし、齒を喰ひしばるやうにして云つた。",
              "citation": {
                "source": "不良兒",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "かういふ時に、こんな意気地のないところを見せてはと、歯を喰ひしばるやうにしても、いつたん緩んだ気持は、もう取り押へやうがなかつた。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あツ、ツ」　身體をねぢ曲げて、齒を喰ひしばる女の苦悶の姿は、どうかしたら、兵庫には快よいものに映るのかもわかりません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "兵庫の眼玉",
                "note": "青空文庫"
              }
            },
            {
              "text": "振袖の下へ鎖帷子を着せて置いたので、力任せで刺した匕首も、五分とは斬らなかつたよ」「――」　錦太郎は何べんかお福に飛びかゝりさうにしましたが、その都度、平次の眼に威壓されて、キリキリと齒を喰ひしばるばかりです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "ガラツ八祝言",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
