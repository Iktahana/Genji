        "examples": {
          "standard": [
            {
              "text": "毎月の食い代が家計を圧迫しているので、節約を心がけよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大家族なので、食い代だけで月に10万円以上かかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "仕事を辞めたので、食い代を削減する必要が出てきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「部屋代だけでも、そのくらいかかるだろう」「じゃ食い代は、どう工面しているんだろう。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸くてすべらかで、重くて、うっかりすると割ってしまうこの持ちにくいしろものを、こうしてここまで担いで来ることよりも、これを譲ってもらうために頭を何べんも下げたときのほうがよけいに汗が出ましたよ、と言い言い上衣をぬいだ。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
