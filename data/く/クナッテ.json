        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　――オマエハ、モウ、ソレヨリ、オオキクナッテハ、イケマセンヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "万一出来タトシテモ其時ハ話モ出来ナクナッテルデアロー。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモハジメノウチデ、工場ノ人モダンダンコナクナッテ、死ンダトキニハ、ミンナハモウ君チャンノオ父ッチャノコトヲワスレテシマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月八日◯去ル五日ニ気ガ附イタコトデアルガ、イツノ間ニカ左眼ガワルクナッテイルノダ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「西風ガ一トキワ強クナッテキタ――」　と地の文章を読む。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナッテシマウノデスガ、今夜ハソウナラナイ内ニ、ワザト魔法ニカカッタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "オサルサンハ　タイソウハヅカシクナッテ、アカイカホヲ　モットアカクシマシタ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ滝川ドウフノ他ニ晒シ鯨ノ白味噌和エガ欲シクナッテ追加スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "東大梶浦内科ノ診断デハ、今日デハ脳中枢ノ病巣ハ殆ドヨクナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々前ノ日記ヲ取リ出シテ見ルト、ヒドク忘レッポクナッテイルノニ驚ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト、夕食ヲ済マシタアトデ、婆サンガ急ニ気分ガ悪クナッテ茶ノ間デ臥テシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "数年前カラ予ニハ前立腺（青年時代花柳病ヲ患ッタ頃ニハ摂護腺ト呼ンダモノダガ）肥大症ガアリ、トキ／″＼残尿ガ溜ッタリ、尿ガ出ナクナッテカテーテルデ導尿シタリシタコトガ二三回アル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――近頃ハ伯父サン、オ見受ケシタトコロ大層オ元気デ」「ナーニダン／＼老イ惚レガ激シクナッテネ、毎日颯子ニ叱ラレテバカリイルヨ」「イヤ、イツマデモオ若イッテ、颯チャンガ感心シテマスガ」「飛ンデモナイ、今日モコウヤッテ鍼ナンカシテ貰ッテ、辛ウジテ露命ヲツナイデルノサ」「ソンナコトガアルモンデスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ数年来、予ハ白眼ガシバ／＼充血スルコトガアリ、普通ノ時デモ赤味ガ強クナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "面白クナッテ何度モ試シテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ経助ハイナクナッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、昨日モ申シ上ゲタヨウニ博士ハ今マデニ何十人トナクコノ患者ヲ扱イ、コノ方法デ簡単ニ成功シテイルノデ、ソンナ神業ナンテ云ワレル程ノムズカシイモノトハ思ッテイナイ、患者モ格別不安ガッタリ恐レタリシタ者ハナカッタ、皆気軽ニ注射シテ貰イ、直グ良クナッテ大喜ビデ帰ッテ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤットノコトデ出テ見タラ三島ニ近クナッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ンデシマエバ何処ニ埋メラレタッテ構ワナイヨウナモノダケレドモ、今ノ東京ノヨウナ不愉快ナ、自分ニ何ノ因縁モナクナッテシマッタ土地ニ埋メラレルノハイヤダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ヨリモ、僕ガ彼女ヲ心カラ愛シテイルハ前ニモタビタビ書イテイルガ、ソレハ偽リノナイニハ疲レヤスクナッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ、ソレヨリモ何ヨリモ、今ノトコロ僕自身ガ自分ヲ制御デキナクナッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "脈ハ大分ヨクナッテイルノデ連レテ帰ルハ私ヲオ信ジニナッテ下サイ、オ嬢サンガスベテ御存ジデス」ト云ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "友田ハ胃カイヨウノ手術ケイカガヨカッタノカ、昔ヨリ血色ガ善クナッテ居ル。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ人ハ大キクナッテカラ……」　なぞと思い出す。",
              "citation": {
                "source": "凡人伝",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
