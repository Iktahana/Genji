        "examples": {
          "standard": [
            {
              "text": "楽曲のクライマックスに向けて、演奏は力強いクレッシェンドを奏でた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "劇場の静寂を破るように、突然、大音量のクレッシェンドが響き渡った！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、感情の高まりを音楽のクレッシェンドで表現しようとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "このパリからロンドンへ向おうとする伸子の心には、音楽でいうクレッシェンドのように次第に強くなりまさりつつある探究の情熱があった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、とうとうある力強いクレッシェンドオで幕が上って、暗い森かまたは壮麗な広間で、芝居がはじまる。",
              "citation": {
                "source": "道化者",
                "author": "DER BAJAZZO",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
