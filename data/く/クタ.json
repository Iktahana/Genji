        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "糟谷は以来｜栄達の望みをたち、碌ろくたる生活に安んじてしまった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫くたたずんで内の様子を見ると云うでもなく考えて居ると云うでもなく只ぼんやりしていたのである。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月の何日頃であったか、表の呉縁に朝日が暖くさしてる所で、自分が一人遊んで居ると、姉が雑巾がけに来て「坊やはねえやが居なくても姉さんが可愛がってあげるからね」と云ったら「ねえやなんか居なくたってえいや」と云ってたけれど、目には涙を溜めてたそうである。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「民さん、くたぶれたでしょう。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この夜は頭も少しくさえて夕飯も心持よくたべた。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "また僕に寄られたらば、民子が困るだろうとも思って、いくたび寄ろうと思ったけれどついに寄らなかった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくたまさかに取出るにも指の先こわきやうにて、はか／″＼しうは得も縫ひがたきを、かの人あらばいかばかり言ふ甲斐なく浅ましと思ふらん、など打返しそのむかしの恋しうて、無端に袖もぬれそふ心地す。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお、縦縞のうちでは万筋、千筋の如く細密を極めたものや、子持縞、やたら縞のごとく筋の大小広狭にあまり変化の多いものは、平行線としての二元性が明瞭を欠くために「いき」の効果を十分に奏しない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま室内にひとりで坐つて暮れゆくたましひの日かげをみつめるそのためいきはさびしくしてとどまる蠅のやうに力がないしづかに暮れてゆく春の夕日の中を私のいのちは力なくさまよひあるき私のいのちは窓の硝子にとどまりてたよりなき子供等のすすりなく唱歌をきいた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "題のない歌南洋の日にやけた裸か女のやうに夏草の茂つてゐる波止場の向うへ　ふしぎな赤錆びた汽船がはひつてきたふはふはとした雲が白くたちのぼつて船員のすふ煙草のけむりがさびしがつてる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこにこんな荒寥の地方があるのだらう年をとつた乞食の群はいくたりとなく隊列のあとをすぎさつてゆき禿鷹の屍肉にむらがるやうにきたない小蟲が燒地の穢土にむらがつてゐる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま憂鬱の重たくたれた黒いびらうどの帷幕のかげをさみしく音なく彷徨するひとつの幽しい幻像はなにですか。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのチャンチャン坊主の支那兵たちは、木綿の綿入の満洲服に、支那風の木靴を履き、赤い珊瑚玉のついた帽子を被り、辮髪の豚尾を背中に長くたらしていた。",
              "citation": {
                "source": "日清戦争異聞（原田重吉の夢）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま室内にひとりで坐つて暮れてゆくたましひの日かげをみつめるそのためいきはさびしくしてとどまる蠅のやうに力がない。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ　俥のはしる轍を透してふしぎな　ばうばくたる景色を行手にみる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふはふはとした雲が白くたちのぼつて船員のすふ煙草のけむりがさびしがつてる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "年をとつた乞食の群はいくたりとなく隊列のあとをすぎさつてゆき禿鷹の屍肉にむらがるやうにきたない小蟲が燒地の穢土にむらがつてゐる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうぼくたちの別れをつげようあひびきの日の木小屋のほとりでおまへは恐れにちぢまり　猫の子のやうにふるへてゐた。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ああ、ああ、歴史は忘れゆく夢のごとし」　明るい日光の野景の涯を、わびしい砲煙の白くただよふ。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはれな、たよりのない、木造の侘しい橋は、現實の娑婆世界から、彌陀の淨土へ行くための、時間の過渡期的經過を表象し、水を距てて空間の上に架けられてる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幽靈の手は鋼鐵製である、鋭どくたたけばかんかと音がする。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくたび、私は夢の中でその人と逢つてるだらう。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の日や、簾あまねくたれこめて、涼しと書きぬまづやる文へ。",
              "citation": {
                "source": "短歌",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "空気は陰湿にカビ臭く、室内は昼でも薄暗くたそがれている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥棒じゃあるめえし、夜中に踏み込まなくたって、逃げも隠れもしやしねえよ」（此儘行ったんじゃ困る。",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれじゃあ、姑でなくたって、音を上げちゃうね」　と、小林も音を上げた位だった。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんなにしなくたって、そういつもあることじゃないんだから、今日だけ願っといたらいいじゃないか」とボースンはなだめた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めからわかっているんだから、しまいを読まなくたって落ちはわかっているし……」と、おっしゃって、いや、言っていることになっているが、（しかし、座談会の速記録、或いは、インタヴィユは、そのご本人に覚えのないことが多いものである。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いなくたっていいじゃないの。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あたしが泣かなくたって、ひばりには、泣いてくれる人がいくらでもあるわ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
