          "literary": [
            {
              "text": "水がちよろちよろ流れ出してゐる所を、大きくふかく掘開いて、池の水を出来るだけ落してしまふのです。",
              "citation": {
                "source": "ふしぎな池",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう池の水は、土手を掘開いた所から、大てい流れ落ちました。",
              "citation": {
                "source": "ふしぎな池",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "土手の掘開いた所を、また、土でうめて、ふみかため、石をしいて、水の落口をつくりました。",
              "citation": {
                "source": "ふしぎな池",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから之は必ずしも事大的であることを意味するのではないわけだが、批評としての掘開力も足りなければ公正な精神でもあるまい。",
              "citation": {
                "source": "戦争ジャーナリスト論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
