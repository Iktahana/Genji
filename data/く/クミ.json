  {
    "uuid": "71988860-462d-5363-bc9b-dbdf467ac2cd",
    "entry": "来実",
    "reading": {
      "primary": "くみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
