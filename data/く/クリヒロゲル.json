    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to unfold",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は壇上で、熱弁を繰り広げ、聴衆を魅了した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "白熱した議論が繰り広げられ、会議室は一時騒然となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大規模な反対運動が街頭で繰り広げられ、警察が出動した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その証拠に、「あらすじ」を言ってみせよというと大抵の者が、「坊ちゃんなる人物が英語の先生として松山に赴任して、赤シャツやら山嵐やら、ぬらりひょんやらいった同僚たちと、マドンナなる婦人をめぐって鞘当てを繰り広げる話」などと答える。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "反英闘争を繰り広げるインド国民に対して、暴力を放棄すべしと主張することもまたないのだ。",
              "citation": {
                "source": "ナショナリズムについての覚書",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "虚飾を繰り広げる天井には水晶シャンデリアが何千という蝋燭で輝いている。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "順吉が歸らぬうちのことであつたならば、それらは胸もつぶれるほどのおそれとかなしみのたねになるだけであつたであらう、今はしかしなつかしさと、なにか珍らしいものでも見るやうな氣持でくりひろげることができるのである。",
              "citation": {
                "source": "第一義の道",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪質の支払主は、そこに相当の才覚と無恥とをくりひろげることは火を見るよりも明らかなのだから。",
              "citation": {
                "source": "家庭と学生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "生存の条件の下に自主の力のない運命をくりひろげるものとして描かれている人間の姿は、生活の条件に評価をもって働きかけようとする人間の力の実際で見直されるはずではないだろうか。",
              "citation": {
                "source": "昭和の十四年間",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが次々に絵巻物をくりひろげる。",
              "citation": {
                "source": "木々の精、谷の精",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルコールの餓鬼取引には六ヶ月の期限がついてゐることを重々承知の上で、最上先生が意外、夜の王様の雄大な構想をくりひろげる。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとより惚れるといふほどの真剣な気持ではなかつたにしても、親しい女友達の尠い雨宮紅庵にしてみれば、秘かに情炎の絵巻物をくりひろげる時の最も実感ある対象は日頃親しい蕗子のほかになかつたわけで、さういふ意味では彼の最愛の情婦だつたに相違なかつた。",
              "citation": {
                "source": "雨宮紅庵",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "瞑眩のうちに陶酔を感じながら空壜をおっぽり出すと共に、またそこいらをガラガラひっかき廻しているうちに、ふと、折込みの舶来のガラス鏡を発見し、「ははあ、こいつ、お絹のやつが異人からせしめたのだな」と言って、くりひろげる途端、思わず自分の面がうつると、明々瞭々たる三ツ眼！",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はそれらの諸記録をくりひろげるたびに、あそこにだれの名があった、ここにだれの名があったと言って見て、平田一門の諸先輩によって代表された中世否定の運動をそこに見渡すことができるように思った。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七……愁いにしずむ私の胸にくるしい思いがむらがっている、思い出は言もなく私のまえに長い巻物をくりひろげる。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "闇の部屋にあって、源三郎は、絵巻物をくりひろげるようにハッキリと、ここにたちいたった径路を見た。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女の筆蹟じゃありませんか、親分」「あッ、――こいつはお澪の遺書だ、伝吉と一緒に死ぬつもりだぜ、八」　くりひろげると、哀れ深く綴った文句は、――父親の非道を責めながらも、添い遂げ兼ねる伝吉と一緒に死んで行くことが、先立つ不孝の罪――といった極り文句で書いてあるのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "南蛮仏",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、詩集をくりひろげるごとに、ヒローの優雅な気品への傾倒を深めます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間、私が余りいそがしくて詩集くりひろげるどころでないかい、と笑っていらしたわね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "このときから、時代はまったく新しい歴史をくりひろげるのである。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "当初｜稚なくしてまた上品な貞門の俳諧を突破して、梅翁一派の豪胆なる悪謔が進出した際には、誰しも鳥羽僧正の画巻をくりひろげるような痛快さをもって、悦び迎えざる者は無かったのであろうが、しかも百鬼夜行の路は行き究まる処があった。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "とりあえず持参の折弁当を一同でくりひろげる。",
              "citation": {
                "source": "随筆　私本太平記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいまは、物語の考証はあきらめて、ただ自分ひとりの空想を繰りひろげるにとどめなければならぬだらう。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいまは、物語の考證はあきらめて、ただ自分ひとりの空想を繰りひろげるにとどめなければならぬだらう。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "机に向ふもいゝし、寝ころんで新聞を繰りひろげるもよい。",
              "citation": {
                "source": "なまけ者と雨",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "机に向ふもいゝし、寢ころんで新聞を繰りひろげるもよい。",
              "citation": {
                "source": "樹木とその葉",
                "author": "なまけ者と雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "まづ、人間の心理、または行為としてこれをみる時に、恋愛は複雑微妙な変化に富み、濃淡色とりどりの多彩な絵巻物となり、時には波瀾をきはめた劇的情景を繰りひろげるのに反して、結婚は、殆ど常に恋愛の終局と考へられ、或は単に「家を持つ」ための便宜手段であるかの如くみられがちであります。",
              "citation": {
                "source": "青年の夢と憂欝",
                "author": "――力としての文化　第五話",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、或る場合には当然であるが、ある場合には、日本人の考へ及ばないやうな奇怪な場面をも繰りひろげるのである。",
              "citation": {
                "source": "北支物情",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "少くも定家は春夜の夢がと切れたというほかに、青春の恋物語も終をつげて、ふと眼ざめた主人公は、しののめの嶺に流れる横雲をながめつつ、思い出を繰りひろげるのだったというような、物語的｜雰囲気をねらっていたことであろうと思われる。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "巻の紐爪を解き、くるくると繰りひろげる。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、どう考へ直しても薬局に入つて薬を盛つたり、試験の為にノートなどを繰り拡げる気にはなれなかつた。",
              "citation": {
                "source": "白明",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりも、おれの生活、つまりおれの世界を、自由な境地に繰り拡げることだ。",
              "citation": {
                "source": "花ふぶき",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは丁度絵巻物を繰り拡げるように、物心ついた小娘時代から三十四｜歳で歿るまでの、私の生涯に起った事柄が細大漏れなく、ここで復習をさせられたのでした。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
