[
  {
    "uuid": "ab0ef4f0-4e9e-52a6-a40f-e36024afa09b",
    "entry": "繰り広げる",
    "reading": {
      "primary": "くりひろげる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
