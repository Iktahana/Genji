        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オニドモ　ヘイコウジユンジユンニ　タツテ　ニゲマスヤマオクヘ「待つて下さい！",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「リツコジウビヨウビヨウメイミテイダイガクヘニウインシタアトフミ」そういう文言であった。",
              "citation": {
                "source": "挿話",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "……朝も三平汁、昼もおなじ三平汁（三平汁は樹明直伝のもの、朝も三平、昼も三平、そして晩も三平だつたら、合して九平、クヘイ、クヘイ）、晩はにんぢん葉の煮付、何を食べてもうまい、此点に於て、私はほんとうに幸福だ、やつぱりメグマレテヰル！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコタチハ　トホクヘ　イキタガツテ　シヨウガ　ナイノデ、オカアサンノ　タケガ、「ソンナニ　トホクヘ　イツチヤ　イケナイヨ、ヤブノ　ソトニ　デルト　ウマノ　アシニ　フマレルカラ」ト　シカツテ　ヲリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、イクラ　シカラレテモ、ヒトツノ　タケノコハ　ドンドン　トホクヘ　モグツテ　イクノデ　アリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五　翌日、練習休みで、近くのゴルフリンクヘ一同でピクニックに行きました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネハ、イツモノヨウニ、ハンヲ、オシテ、アリマスカラ、コノママキョクヘ、トリニユキナサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと続けて」「……同ニ長干ノ里ニ居リ両小｜嫌猜ナシ十四、君ノ婦トナッテ羞顔未ダ嘗テ開カズ頭ヲ低レテ暗壁ニ向イ千｜喚一トシテ廻ラズ十五、始メテ眉ヲ展ベ願ワクハ塵ト灰ヲ同ニセン常ニ存ス抱柱ノ信豈上ランヤ望夫台十六、君遠クヘ行ク……」　城太郎はふいに起って、じっと聞き入っていたお通を促した。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "……十四｜君ノ婦ト為ッテ羞顔未ダ嘗テ開カズ十五初メテ眉を展ベ願ワクバ塵ト灰トヲ共ニセン常ニ抱柱ノ信ヲ存シ豈上ランヤ望夫台十六｜君遠クヘ行ク　近所に住む少女であった。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
