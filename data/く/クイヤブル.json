        "examples": {
          "standard": [
            {
              "text": "樽の蓋を食い破ってネズミが侵入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "犬が皿を食い破ろうとしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "イナゴが野菜を食い破る被害が大きい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "人間ならば来年の夏の青葉の夢でも見ながら、安楽な眠りに包まれている最中に、突然わき腹を食い破る狼の牙を感じるようなものである。",
              "citation": {
                "source": "簔虫と蜘蛛",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "収穫季の終が来て蛇が閉塞して畢うと鼠は蕎麦や籾の俵を食い破る。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに妙見さまは弁天さまのごきょうだいにしたって、ただの布切れが人ののど笛を食い破るなんてことは、どう考えたってもがてんがいかねえんだからね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちが、うっかりしている間に、警察署の小使が飼っている玉ちゃんという猫が、昨今腹が減っていると見え、いつの間にか机の上のすしを見つけ、紙包の横を食い破ると、中のすしを盗んで食っているのです。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "関村つる子の真率さは、どのようにそのまゆをくいやぶるだろうか。",
              "citation": {
                "source": "婦人作家",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "高見順が文学について書いているのに、先ず文学は非力である、非力であるが、獅子と鼠の物語のように、ライオンのとらえられた網をくいやぶるのはネズミであるというような云いかたをしている。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがの大ワシも、このかたいのどを、くいやぶることができません。",
              "citation": {
                "source": "魔法人形",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "……女にこんなまねをさせるのも、みんな、男の罪っていうものじゃないか」　ふかい魔夢に落ちた金吾の頬へ、自分の顔をそっと持ってゆく……　やがては、ものの怪にでもつかれたように、わくわく身をふるわしつつ、なおも金吾の喉笛を食いやぶるようにしがみついて。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
