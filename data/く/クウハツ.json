    "definitions": [
      {
        "index": 1,
        "gloss": "exploding without destroying the target",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "砲撃が空発に終わり、目標は無傷だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "銃が空発して弾が発射されたが、的に当たらなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "空発を防ぐために火薬の量を調整している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そして「民間航空発展の貴い人柱」となった人々への哀悼、遺族への慰問の責任を表明した。",
              "citation": {
                "source": "市民の生活と科学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "気持ちの遠い人と歩いて居ると、心は何となくうはついて居るものだが、自分の身に近い者が一処だと、二つの心が一つ事を感じてゐると言ふのか、自分の心が連れの心に乗りかゝつて了ふと言ふのか、しんみりした気持ちを持ち合つて行くものである。",
              "citation": {
                "source": "山の音を聴きながら",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "going off (of a gun) before taking aim",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "銃が空発して弾を無駄にしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "散弾銃が空発する前に狙いを定めなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "空発を減らすための訓練を積んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
