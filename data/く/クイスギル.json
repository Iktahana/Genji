        "examples": {
          "standard": [
            {
              "text": "子どもが調子に乗って食いすぎると、夜に寝つきが悪くなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ポップコーンを食いすぎて、塩辛さに気が付いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "今日は昼食を食いすぎてしまったから、夕食は軽くしよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "盛りきり飯の盛り方が不公平だとか、年寄りのくせに食いすぎるとか、子供の菓子をお爺さんが盗んだ、とかね。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ美人諸君、よく心に入れたまえ、諸君はあまりに多く砂糖を食いすぎる。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの種の人は、雑誌や客間にあまり多くいすぎる。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
