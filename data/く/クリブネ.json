          "literary": [
            {
              "text": "忽ち手繰り船の親杭の上に攀じ登った。",
              "citation": {
                "source": "死剣と生縄",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の漏る箇所が出来たか、或いは、浪が高くなって甲板上の開いた船艙から浸水し、そのために、そっくり船の形のままで沈没したに決まってる。",
              "citation": {
                "source": "沈黙の水平線",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に私の心にぱっと思い浮んだのは、その砲の砲弾と火薬とを残して来たことで、斧を一振りすればそれがそっくり船にいる悪者どもの手に入るのであった。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "おもしろい所ではわたしたちはたいそうゆっくり船を進めた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
