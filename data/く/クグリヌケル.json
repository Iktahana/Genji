  {
    "uuid": "34cd0a9f-277a-5824-a7f1-14883178cf6e",
    "entry": "潜り抜ける",
    "reading": {
      "primary": "くぐりぬける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "下一段-カ行",
      "inflections": null,
      "ctype_source": "existing",
