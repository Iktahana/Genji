        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アクースティック・ギターのコードが流れるなか、ウッド・ベースが降りてきて、エレキ・ベースがその下降にピリオドを打つ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクースティック・ギターと、グロッケンシュピールのイントロが流れる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "このＪ-１６０Ｅはそのひとつで、アクースティックに不慣れな慶一は、悪戦苦闘を強いられ、おかげで、雑念は吹き飛んでしまった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月六日　木　八日の女の日にテクースチーリヌイ〔紡織工場〕工場とクラブを見たい。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちどきに三人もの人間が席をたって、はぬけのようになっているテーブルに、ザクースカのたべのこりや、よごれた皿、ナイフ、フォークなどが乱雑に目立った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その晩私は秦啓源と二人きり、アルカヂアで、踊り子なしのキャバレー・バンドを聞きながら、豊富なザクースカを味い爽醇なウォートカに酔った。",
              "citation": {
                "source": "秦の出発",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "過度の夢想はエスクースやルブラのごとき人物を作り出す（訳者注　共同して戯曲を書きその劇が失敗して悲観の余り自殺せる人）。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "15世紀にクース（＊ドイツ）のニコラスやレギオモンタヌス（ドイツ）は太陽中心説を示唆した。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "きれいなＦホールのついた、古風なアクースティック・ギターだ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "二台のアクースティック・スティール・ギターのデュエットが、せつなく軽やかに美しかった。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "観客の反応はひどく否定的で、ピーター・ヤロー（ＰＰＭのひとり）のとりなしでギターをアクースティックにかえ、ディランは泣きながら『すべては終った、ベイビー・ブルー』をうたわなければならなかった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは従来のアクースティック蓄音機に対しても電気蓄音機でも同じことである。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばアクースティックの方にして見ても、サウンドボックス一つについてもいろいろの場合がある。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つは恐ろしく豪華なザクースカ(*3)（ソ連版バイキング）だった。",
              "citation": {
                "source": "西洋科学は素晴らしい",
                "author": "C. スミス　C. Smith",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを説明する前に、悪いがこれらの糞ったれたトラックをどけて、ザクースカをどこかにやってくれないか？",
              "citation": {
                "source": "西洋科学は素晴らしい",
                "author": "C. スミス　C. Smith",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
