        "examples": {
          "standard": [
            {
              "text": "「苦あれば楽ありだよ、今は辛くても必ず報われる日が来る」と父に励まされ、受験勉強を再び続ける気になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "三年間の下積みを乗り越えた先輩は、苦あれば楽ありという言葉を噛み締めながら初めての主役の舞台に立った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "苦あれば楽ありで、長い工事期間が終わると新しい道路は驚くほど毎朝の通勤時間を短縮してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "おとうさんが、楽あれば苦あり、苦あれば楽ありとおっしゃったことが思いあたるようで、豊年で、お米がたくさん出来るといいなと思いました。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
