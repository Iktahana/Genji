        "examples": {
          "standard": [
            {
              "text": "「うるさい糞餓鬼だな、静かにしろ！」近所の住人が怒鳴った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの糞餓鬼たちは、また人の家の庭に入って悪さをしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "親の言うことも聞かない糞餓鬼に、教師も手を焼いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しかしラッサは必ずしも食糞餓鬼の都ではない。",
              "citation": {
                "source": "第四の夫から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
