        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このラーメンのスープは、味が少し諄いと感じる人もいるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ケーキは美味しいが、クリームが諄くて全部食べきれなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は諄い味付けよりも、あっさりとした料理を好む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
