        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大きなケシの花と、シャクヤクの花が、顔をまっかにして、エンドウのさやを吹きならしていました。",
              "citation": {
                "source": "イーダちゃんのお花",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "畜生畜生……二人で夜の眼を寝ずに働いた養蚕の売り上げをば……いつまでも渡らぬと思うておったれば……エエッ……クヤシイ、クヤシイ」　しかしいくら小突かれても若い主人はアヤツリのようにうなだれて、首をグラグラさせるばかりであった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年の方は、学校を出てから何になろうか、自分の才能がどんな仕事に向くだろうかという事を発見し難く、モヤクヤと困しんでいる。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ブレスト　正しくはブレスト・クヤフスキイと言ひ、波蘭ワルシャフスカヤ県下にある猶太人町。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマオカマサヨシクンゴフサイガ、シナヘイノギセイトナッタコトヲオクヤミモウシマス、イサイハアトヨリ、ニホンジンクラブ　務の顔色はみるみるかわった。",
              "citation": {
                "source": "白っぽい洋服",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "クヤクヤ貴様は何じゃ、往来で大声放歌はならんちゅう位の事は心得て居るじゃろう。",
              "citation": {
                "source": "煩悶",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな寒い晩でも何でもチャント立って往来を睨んで、何でも怪しいものと見とめると、クヤクヤ貴様は何じゃ、とおいでなさる、私は神田八丁堀二丁目五十五番地ふくべ屋呑助でございます、と来ると、見受ける処よほど酩酊のようじゃが内には女房も待っちょるじゃろうから早う帰ってはどじゃろかい、とおいでなさる。",
              "citation": {
                "source": "煩悶",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "新シイ人間ガ生レツツアル　ソレヲ見ルノハ※シイ　早クヤツテキタマヘ　と、東京の友は云つて来た。",
              "citation": {
                "source": "氷花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "強情で、ナキ虫で、クヤシがりで、ヤキモチ屋で、ダラシがなく、経済観念が欠乏して、野性的であった――野枝さん。",
              "citation": {
                "source": "ふもれすく",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ南々西ニ向ケ、雷門吾妻橋ノ方ヘ（書信ニハ地圖ニ矢ヲ記入シテ方向ヲ示シテアル）進ンデ行クヤウニ見エタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "通というものは要するにその道のガクヤ話や癖や迷信や伝統を知り、それに屈伏している評価者ですから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の警官はイギリスのストックヤードの警官のように足を掬って自由を失ったところを逮捕すればよく、その人が警官を殺そうとして反抗をしない限り足を撃って自由を失ったものを逮捕する、そういう訓練はうけていない。",
              "citation": {
                "source": "浦和充子の事件に関して",
                "author": "――参議院法務委員会での証人としての発言――",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴方は　モスクヤで食事をして居たと云いましたね。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "メリーさん、自分のような赤いシャクヤクの花をもって来てくれた。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガクヤへつれてゆかれ、役者連にとりまかれ、一寸まごついた。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "モスクヤは今スープ25к、あと40―50к までだ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在ではモスクヤの問題。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、ターイユトウヤー（鮒取）サバツクヤー（草履造）、帽子編…………さう云ふ職業に従事して居る。",
              "citation": {
                "source": "奥間巡査",
                "author": "池宮城積宝",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の人々が赤沢君に白のクヤミを言うたそうです。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ、ウソヲツクヤウナ玉ネギヤ、ジヤガイモハ、デキソコナイダラウ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "六ヒゲナシ山羊サン　ヲ見テミンナ　オコルヤラ、泣クヤラ大ヘン　ナ　サワギニナツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつは婚礼の時はきまつておクヤミを言ひやがる。",
              "citation": {
                "source": "朴水の婚礼",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オクヤミの時でも笑つてゐる、と言ふけれども、実際は、日本人ぐらゐ笑ひの欠如した世界で訓練を受けてきた国民は外にない。",
              "citation": {
                "source": "五月の詩",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧ヲ改メ新ヲ布クヤ群議沸騰ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、単独ノ歩行ヲ避ケ、止ムヲ得ザル場合ニハ三人以上連レダツテ歩クヤウニスル。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボタンの図シャクヤク　和名として今日わが邦では、芍薬をシャクヤクと字音で呼んでいることは、だれもが知っているとおりであるが、しかし昔はこれをエビスグサ、あるいはエビスグスリと称え、古歌ではカオヨグサといった。",
              "citation": {
                "source": "植物知識",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
