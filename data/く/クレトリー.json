        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "他にプロ・アルテ、コーリッシュ、クレトリーその他の四重奏団のモーツァルトもあるが、それは以上数曲を味聴してのうえのことである。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「弦楽四重奏曲（作品一二一）」のクレトリー四重奏団のレコードも逸するわけにいくまい（コロムビアＪ七九〇七―九）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一つ「第二弦楽四重奏曲」をクレトリー四重奏団の演奏したのが英国コロムビアに入っている。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "我らに一番親しめるのは英国コロムビアに入っている「弦楽四重奏曲」（十インチ四枚）で、演奏はクレトリー四重奏団だ。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロムビア系のいろいろ　クレトリー弦楽四重奏団　　新人たちの室内楽団だ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
