        "examples": {
          "standard": [
            {
              "text": "日本の皇位継承の三種の神器の一つが草薙の剣だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "神話では、スサノオが八岐大蛇から草薙の剣を取り出したとされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "古典の授業で、草薙の剣について学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "草薙の剣は能く見ゆる野火を薙ぎ尽したりと雖、見えざる銃鎗は、よもや薙ぎ尽せまじ。",
              "citation": {
                "source": "人生に相渉るとは何の謂ぞ",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、命が草をお切りはらいになった御剣を草薙の剣と申しあげるようになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            }
          ]
        }
