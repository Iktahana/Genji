        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "けれども継ぎ継ぎだらけのワイシャツとズボン下を穿いて、黒いボロボロのネクタイを上手に結んでしまうと、ウルフは、穴だらけの黒靴下を両手にブラ下げたまま、又、ジッとうなだれて考えはじめた。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の中は壁から床まで黒靴で詰っていた。",
              "citation": {
                "source": "街の底",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その重い扉のような黒靴の壁の中では娘がいつも萎れていた。",
              "citation": {
                "source": "街の底",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆき子は自分が惨めに敗けてしまつた気で、学校時代のサージの制服を仕立てなほした洋袴に、爪先きのふくらんだ、汚れた黒靴をはいてゐる事に、いまいましいものを感じてゐる。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つの駅で、野天プラットフォームの砂利を黒靴で弾きとばしながらどっと女学生達が乗込んで来た。",
              "citation": {
                "source": "東京へ近づく一時間",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒靴みがき、十カペイキ！",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十銭、五銭とりまぜの財布の口をしめ、ひろ子はもう一遍首をかしげるような恰好をしたが、時計を見直すと、今度は地味な黒靴をはっきりとした急ぎ足になって停留場に向った。",
              "citation": {
                "source": "乳房",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子には、この艶々した黒靴が、妙に人格を持っているように感じられた。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖画の古さ、婆さんが頭にかぶったきたない布、婆さんの前を突切って通行する皮外套の婦人共産党員の黒靴下の急速な運動など――互に対照する人生の断面が一目のうちにとび込んで来る。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなと同じ仕事着を着て頭をきっちり赤い布でしばって、穿いている黒靴こそ、醋酸をのんで倒れたとき、穿いていたままだが、顔つきと云い歩きっぷりと云い、これは別人だ。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "リボンのついた可愛いい黒靴……。",
              "citation": {
                "source": "傷痕の背景",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ズボンは並の黒靴の下で、革紐でとめてある。",
              "citation": {
                "source": "なぐり合い",
                "author": "WIE JAPPE UND DO ESCOBAR SICH PRUGELTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "男たちは一人ずつ椅子に座り、居心地悪そうに磨かれた黒靴を毛足の長いグレーの絨毯に擦りつけていた。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
