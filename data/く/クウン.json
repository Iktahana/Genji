        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "きゃんきゃんきゃん、クイ、キュウと息を引いて、きゃんきゃんきゃん、クイ、クウン、きゅうと鳴く。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポルトガル人伴天連デオゴ・カルバリョ、日本人伴天連シスト・トクウン潜入。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人伴天連シスト・トクウンは長崎で穴つるし。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロボックウングル、トイチセグル、メナシクル、シュムクル、チュプカグル、コタンコルクルなどのクルこれである。",
              "citation": {
                "source": "「ケット」と「マット」",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "クウンスヴィルの州立病院に当時の診断書があるはずだから、照会すればすぐわかることだ。",
              "citation": {
                "source": "三界万霊塔",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "甘えるようにクウンクウンと鼻を鳴らしながらヨタヨタと側へ近付いて来たのであったが、その姿が譬えようもなく醜悪で、私にはまるで私自身の歩む姿としか思われず、面を背けたいほどに憎悪が込み上げて来たのであった。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と呼んだが、犬は怯え切ったようにただクウンクウンと啼いているばかりで、長椅子の下から出ては来なかった。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "はげしく尾をふり、クウン、クウンと鼻を鳴らして、まつわりつく。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
