          "literary": [
            {
              "text": "「クサチュカ、私と一しょにおいで」と犬を呼んで来た。",
              "citation": {
                "source": "犬",
                "author": "レオニイド・アンドレイエフ　Leonid Andrejew",
                "note": "青空文庫"
              }
            },
            {
              "text": "「クサチュカ、好い子だね。",
              "citation": {
                "source": "犬",
                "author": "レオニイド・アンドレイエフ　Leonid Andrejew",
                "note": "青空文庫"
              }
            },
            {
              "text": "「クサチュカ、どうもするのじゃないよ。",
              "citation": {
                "source": "犬",
                "author": "レオニイド・アンドレイエフ　Leonid Andrejew",
                "note": "青空文庫"
              }
            },
            {
              "text": "大人でも子供でも「クサチュカ、またやって御覧」という度に、犬は翻筋斗をしてくるくる廻って、しまいには皆に笑われながら仆れてしまう。",
              "citation": {
                "source": "犬",
                "author": "レオニイド・アンドレイエフ　Leonid Andrejew",
                "note": "青空文庫"
              }
            }
