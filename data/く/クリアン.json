        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "栗あんを使ったどら焼きは、秋の味覚として人気が高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "秋祭りで栗あんの大福が売られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "栗あんの上品な味わいは、洋風のスイーツとも合う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "手紙で知らさうかしらとも思つたけれど、そんなことをして逃げられたら大変だ……と母さんが心配したので、其処にぽつくりあんたはやつて来たわけさ、決して逃げられないわよ。",
              "citation": {
                "source": "小川の流れ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "chestnut red bean paste",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "栗あんは、小豆あんに栗の甘露煮をすりつぶして混ぜ合わせた、素朴で優しい甘さのお菓子によく使われます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "栗あんパンは、朝食にもおやつにもぴったりで、どこか懐かしい味がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "栗あんが入ったしるこを冬に飲むのは格別だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
