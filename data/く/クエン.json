        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "枸櫞の果実は酸味が強く、そのまま食べるよりもジャムや薬用に加工されることが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "漢方薬局の棚に枸櫞の乾燥した皮が並んでいて、芳香性健胃薬として使われると店主が説明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "江戸時代の本草書には枸櫞の栽培方法と薬効について詳しい記述が残されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "夾竹桃、枸櫞樹、たこの木、オレンジ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "珈琲がなければ極く手軽にして湯冷しの水へ砂糖を加えてレモンを絞り込んでその水を壜へ入れて井戸の中かあるいは氷で冷しておいても好いのですし、今のような砂糖水一合へ枸櫞酸の結晶したのなら半グラム、即ち一分三厘を溶かしてレモン油なら一滴｜橙皮油なら半滴を落して冷しておいてもようございます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "枸櫞酸のでも毎日多量に飲むと痩せます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "上等にすると生レモンを絞り込まなければなりませんが、代価が高くなりますから軽便法にして、二十人前なら一升のお湯へ枸櫞酸の結晶したのを大匙軽く一杯位入れて、砂糖を半斤とゼラチンばかりなら四十枚｜要りますけれども代価が高いからゼラチン十枚に寒天三本位使いましょう。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば、アメリカでも第一流のＢ会社で売り出している老人用粉乳は、肝油やビール酵母などから必要のビタミン類を補給し、第一燐酸ソーダや枸櫞酸鉄などを加えて、鉱物質を添加するというふうに、大分進んだ考え方になっている。",
              "citation": {
                "source": "老齢学",
                "author": "――長生きをする学問の存在――",
                "note": "青空文庫"
              }
            },
            {
              "text": "癒着の方は少し厄介だが、枸櫞酸ソーダが效くと思いますね。",
              "citation": {
                "source": "ジストマ退治の話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "枸櫞酸ソーダ入りの粉薬は、毎食後にのむので、これはきわめて尋常である。",
              "citation": {
                "source": "ジストマ退治の話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで不思議なことには、約三週間、その半日のうつらうつらをやり、枸櫞酸ソーダをのんでいたら、胃袋の存在がいつの間にか、自覚されないようになって来た。",
              "citation": {
                "source": "ジストマ退治の話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まアよくえんでること。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「金持のなまツ白い息子さおべツかつくえんた奴だ――！",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "四人で充分にくえる」「くえん」「お前バカだな。",
              "citation": {
                "source": "水鳥亭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだとも、それでと……いや、四十万くらいで止めて置くようなことはあるまい、なかなかくえん親爺だからなあ！",
              "citation": {
                "source": "クリスマスと結婚式",
                "author": "ЕЛКА　И　СВАДЬБА",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋服が突然｜猿臂を伸ばして――全くえんぴという感じだった――太った男の手をとった。",
              "citation": {
                "source": "一寸法師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、日ならずして、Ｈ＆Ｑのボタンは、米国シカゴのヘンドリックス・エンド・クエンティン会社の製品であることが判明した。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いえ、もっと丸卓子の方へよっているように思いました」「するとここらだね」　川北先生は、手を伸ばして丸卓子の上に大きな獅子のブックエンドにはさんである大きな帳簿をなでた。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "文房堂では同じとき、鉄製のどっしりしたブックエンド一対をも買いました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二つがあってはじめてそのものとして役立つというところがブックエンドを選んだ所以です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "四時すぎごろ重いブックエンドもって栄さんのところへゆき、つれ立っておっかさん［自注３］のところへ出かけました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのうは、あれからカンガルーのブックエンドをお祝にもって行ってやりました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○伊東やに欲しいブックエンド一対あった。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "さわ子が、赤い麻の服を着て、姉の縫子につれられて、子供らしくむく犬のついたブックエンドを伊東屋で買って貰った頃、東京は、たしかに読本にかかれているような東京であったのだ。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "金井は、なかなかいい坊つちやんだと褒め、御褒美にサッカリンとクエン酸とで旨い飲物を作つてくれたりした。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが済むと、また暢気な表情にかへつて薬局の隅にとぐろを巻き、相変らずクエン酸とサッカリンで、旨い飲物を少年につくつてくれたりする。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれがはじめてモオリーに逢ったのは、アラスカのクエンスローにあるベーリング会社の罐詰工場へ契約の｜鮭殺しを運んで行くドーソン号の最下船だった。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "クエンスローというのはどんなところだと思うのか。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "濃霧と暗礁で有名なウニマク水道と氷山の間をすりぬけ、まる三週間ベーリングの怒濤に翻弄されながら命からがらクエンスローへ到着するという段取りだ。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはまあいいとしても、クエンスローにはアラスカ蚊と寂寥と饑餓という三つの化物がついている。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから会社のタグ・ボートでユーコン河を百浬ほどのぼり、ここがクエンスローだと追いおろされたところは、菅がチョビチョビと生えた雪まじりの沼地で、骨ばかりになった雑木林と斜にかしいだ半｜潰れの木骨小屋が霧の中からぼんやりとあらわれだしている。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでそのモオリーが、どういう動機で踏ン切りをつけたか、そこまではきけなかったが、ともかく、いよいよアメリカ人になると決心し、領事館に国籍離脱の届出をすると同時にクエンスローのシイズンの契約をした。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハツハハ、でもな、ロクマクエンは治つたが、治つた時にほ、髪の毛えが、みんな抜けてしまうてな、キレーに丸坊主になりましてな。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
