        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "從テ此ノ改造組織ヲ其等ノ領土ニ施行シテ主權國民自ラ私利横暴ヲ制スルト共ニ、先住ノ白人富豪ヲ一掃シテ世界同胞ノタメニ眞個樂園ノ根基ヲ築キ置クコトガ必要ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして子供の前掛けのように、胸に、それが明らかに監督の筆致で、「此者ハ不忠ナル偽病者ニツキ、麻縄ヲ解クコトヲ禁ズ」　と書いたボール紙を吊していた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワガ忠告ヲ聞クコトナク出発スレバ、貴艇ノ行動ハ自殺ニ等シカラン」「自殺ニ等シカラン――か。",
              "citation": {
                "source": "月世界探険記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "菅政友氏は「漢籍倭人考」投馬國の條に不彌國ヨリ南ニ向ヒテ進ミ行クコト二十日ノ後ニ、投馬國ニハイタルトノ義ナレバ、必ズ内海ニハアラズ、豐前豐後ノ東洋ヲ經テ、日向アタリ所謂投馬國ナラント覺シケレバ、本居翁ノ説オホカタハ違ハサルベシ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　アル日、人参サンノ所ヘ、人参サント　ジヤガイモサンノオ友達ノ玉ネギサンガ　タヅネテキテ、「ボクモ、コンナニ大キクナツタノデ、トウトウ、アシタノアサ、六ジニ　キシヤデ　マチノイチバヘ行クコトニ　キマツタヨ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "過去ノ經驗ニ依ラズ、現在ニ誤リテ惡源因ニ從事スレバ、未來ニ惡果ヲ招クコト避クベカラザルノ勢ニテ、之ヲ不知ト謂フナリ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一曲ヨリ東北ニ行クコト三、四曲ニシテ、以テ木母寺ニ至ツテ窮ル。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔古自リ佳期｜動スレバ相失ヒ／天時人事長吁スルニ足ル／独リ旧交ノ旧約ヲ尋ヌル有リテ／年年此夕余ヲ負カズ／観月ノ伴時トシテ闕クコト有ルモ／観月ノ遊歳トシテ無キコト無シ〕云々と言ってある。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "潮ハ方ニ落チテ舟ノ行クコト太ダ駛カニ橋ヲ過グルコト七タビ始メテ市廛ヲ離ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢ニ沿ヒ沮洳ノ間ヲ往クコト数里ニシテ鹿島台ニ飯ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡ソ遠国ニ赴任スル者日ニ行クコト十里ニシテソノ地ニ到レバ則三十日以内ニノ額ヲ闕イテ以テ破程ノ費ヲ補フベシト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "その解説は「九子羊ハ衡山ニ産シ、蔓生細緑茎、葉ハ峨眉豆葉ノ如ク一枝ニ或ハ三葉或ハ五葉、秋ニ淡緑花ヲ開クコト豆花ノ如ク、而シテ内ニ郭アリテ人耳ノ如シ、短角ヲ結ブ、根ハ円クシテ卵ノ如ク数本同ジク生ズ、秋時ニ掘取レバ輒チ多クヲ得、俚医之レヲ用ウ」（漢文）である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちその文句は彼岸桜　其花桜花ヨリ小ニシテ桜ニ先立テ早ク開クコト旬余日花開ク時葉未生桜ヨリ小樹ナリ花モ小也桜ノ類也である。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此すばり越ノ辺マテモ山師杣人ノ外ハ行クコトナシ、夫ヨリ北方ニさら／＼越トイフ所アリ、昔シ天正年中信長公ノ臣佐々内蔵助、越中国ヨリ此さら／＼越ヲ通リテ、当国ヘ来ルコトアリシト云伝ヘタルハ、此辺ヲ越テ加賀川ニ沿ヒ、野口村ノ方ヘ出テタリトカヤ。",
              "citation": {
                "source": "後立山は鹿島槍ヶ岳に非ざる乎",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ外ニ書クコトモナイカラ、コンナ時ニ少シ心ニアルコトヲ記シテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マア考エテオクコトニシヨウ」「今日御返事ガイタヾケナインデスカ」「コノトコロイロ／＼ト出銭ガ多クッテネ」ブツ／＼云イナガラ二人ハ出テ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノブロンハ利クコトハ利クケレドモ、アトノ気持ガ不快デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………日記ヲ書クト云ウコトハ、書クコト自身ニ興味ガアルカラ書クノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "流シ場ニハ木製ノ下司板ヲ敷クコトニシタガ、浴槽ハイカントモスル訳ニハ行カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年ノ夏ハオ爺チャンノオ守リデ海ヘ行クコトガ出来ナカッタ、ヤッパリ日ニ焦ケテ来ナケレバ駄目ダト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ家ノ庭ニモ稀ニ蟋蟀ガ鳴クコトハアルガ、コノ寝室ノベッドニ寝テイテ聞エルノハオカシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨク考エルト、颯子ノ手前好キヲ装ッテイルニ過ギナイノダト云ウコトニ、自分デモ気ガ付クコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸子ハ泣イテマシタガネ」「何ヲ泣クコトガアルンダ」「五子モ出テ来ルッテ云ッテマシタカラ固ク止メテアルンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ハ小勢ニシテ大敗スルモ、貞盛ナホ天助アリ、山ヲ家トシ、薪ニ枕シ、艱難漸ク都ニ帰リ着クコトヲ得タリ……。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう上下の不安が満ちていたところへ、右馬允貞盛が――山ヲ家トシ、薪ニ枕シ、艱難漸ク都ニ帰リ着クコトヲ得タリ――という姿で関東から逃げ帰って来たのであるから、「すわ、何事かある？",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "再四｜慎ンデコレニ負クコトアルナカレ。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "人一年分ノ糧食ヲ載セテ一日行クコト二十里。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
