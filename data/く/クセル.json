        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「埋木」OSSIP SCHUBIN「アルフォンス・ド・ステルニイ氏は十一月にブルクセルに来て、自ら新曲悪魔の合奏を指揮すべし」と白耳義独立新聞の紙上に出でしとき、府民は目を側だてたり。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈カラー表示の画面の解像度は、一〇〇〇×一〇〇〇ドットのミリオンピクセル。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルチプランやのちにマイクロソフトが開発することになる表計算ソフト、エクセルは、Ｐコードをインタープリターによって実行する構造を持っていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに先ずＷｉｎｄｏｗｓ３・０の目玉となるアプリケーションとしてマイクロソフトが出してくるのが、マック用にかねてから提供してきたワードやエクセルだもんな。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつが此間クレビリヨンの作クセルクセスの主人公を勤めた。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君、あの果物屋を見て、それから靴屋のシヤンチリイがクセルクセスだとか、その外古代劇に出て来る英雄の役に不適当だと云ふことを考へたのだらう。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャンティリというのは、もとサン・ドニイ街の靴直しだったが、芝居気違いになり、クレビヨン（５）の悲劇のクセルクセスの役をやって、さんざん悪評を受けたのであった。",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「クセルクセスとか、すべてそういった役をするにはあの靴底直しでは寸が足りないという結論を、君にさせたのはね」「果物屋だって！",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　なにおどろいたか、カビ博士は急にアクセルを入れて、艇に最大速力をあたえた。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてアクセルを踏んで、車を出した。",
              "citation": {
                "source": "英本土上陸戦の前夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンドルをしっかりにぎつて、アクセルをふめば、水中快速艇は、矢のように走りだした。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、エクセルシオの二番へ泊った。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子は英字新聞「エクセルショア」をもったまま、梨の木の下をあちらからこちらへ、こちらからあちらへ、と幾度も歩いた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リイユやブリュクセルやパリイに、夫は昔馴染を持っていて、わたくしと一しょになってからも、始終その関係を断たずにいたのでございます。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、その殿堂はクセルクセスのペルシア軍に侵入されて焼かれた。",
              "citation": {
                "source": "パルテノン",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は今朝汽車に乗って、同じ線をアルプナッハの湖にそうて、サルネルゼーの片ほとり、ザクセルン Sachseln の停車場に降りた。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザクセルンの停車場から、湖の岸をぐるっと廻って、北はずれのサルネンの村に来た。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かご用がありましたら、ホテル・エクセルシオルへ使なり手紙なりいただけばわかるやうにしておきます。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "バットの煙を夜空にふき上げながら、縺れるようにして歩道の傍の車台へ近寄り、物憂そうに運転台へ乗ると、アクセルを踏んで四丁目の方へ走り出した。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしどもにはあと何時間かすれば進駐がはじまることがわかっておりましたので、この夜会は、ウェリントン将軍がウォータァローの戦いの前夜、ブリュクセルで催した夜会のようなものだと思いまして、なんともいえぬ感じにうたれましたのです。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナポレオンの新生涯」説、死んだ年や場所にも異説が多く、一八三〇年の七月十五日にアフリカの西海岸で病死したとか、一八二三年の八月十五日、墺太利、シェンブルヌの王宮の門前で歩哨に撃たれて死んだとか、前皇后の生地マルチニック島で、白耳義のブルュクセルで、瑞西のベルヌで、というぐあいなのである。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "克彦も心配して、行ってみるほうがいいというので、ブリュクセルまで自動車を飛ばして、午後の急行をつかまえ、夜遅く巴里へ着くと、案のじょう伊作はどこかで遊び呆けているのだとみえ、やすの電報は再配達の青鉛筆のマークをいくつもつけて手紙受の硝子箱の中におさまっていた。",
              "citation": {
                "source": "ユモレスク",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車が出てから気がついて、困ったことをしたと思って、巴里へ着くまで心配のしどおしだったけど、あなたが出ていてくれたのでほっとしたわ」　伊作のほうはともかく、ブリュクセルまで電報をくれたそのひとというのは誰だったのだろうと思って、「あなたその方のお名前、伺って」「それがつい気がつかずだったの。",
              "citation": {
                "source": "ユモレスク",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして奴隷的な徒輩にたいする嫌悪のふうを装って、差し出されもしないアルタクセルクセスの贈り物を拒んでいた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルタクセルクセスの古衣を拒むヒポクラテスのようなまねをしたって、僕は何とも思やしない。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンナ・エクセルは７才の健康な女の子で上に述べた患者の一人であり、はっきりと腕の３箇所に病毒を差し込んで感染を起こした。",
              "citation": {
                "source": "イングランドの西部の諸州とくにグルスターシャーで見つかった病気で、牛痘の名で知られているウシ天然痘の原因および効果についての研究",
                "author": "AN INQUIRY INTO THE CAUSES AND EFFECTS OF THE VARIOLAE VACCINAE, A DISEASE DISCOVERED IN SOME OF THE WESTERN COUNTIES OF ENGLAND, PARTICULARLY GLOUCESTERSHIRE, AND KNOWN BY THE NAME OF THE COW POX.",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛び乗るとスグにアクセルを踏んで、セーゲルフォス丘に向って走らせた。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の名声はペルシャにも伝わり王のうちの王であったアルタクセルクセスは彼が侍医となることを希望した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "難解であって読むのが困難な手書き原稿がフランクフルトの出版社に送られ有名な論文「動物の心臓および血液の運動についての解剖学的研究」（＊エクセルキタティオと略称）の表題で出版された。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
