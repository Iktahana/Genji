          "literary": [
            {
              "text": "それが此の空闊な浜にたつた一つぽつりと立つて居る。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の空闊な浜を控へて後には一帯の松原が濃い緑を染めて居る。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "西天を彩れる夕映の名残も、全く消え果て、星の光は有りとは言へ、水面は、空闊にして、暗色四面を鎖し、いよいよ我が船の小なるを想うのみ。",
              "citation": {
                "source": "大利根の大物釣",
                "author": "石井研堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
