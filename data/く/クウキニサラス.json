        "examples": {
          "standard": [
            {
              "text": "梅干しを作る際は、塩漬けした梅を数時間空気にさらすことで余分な水分を飛ばす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "長期間密封保存していた木材を空気にさらすと、内部に含まれていた水分が蒸発して反りが生じることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "醸造家はワインを空気にさらして香りを開かせてから、試飲のグラスを客人に差し出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "試みにその中のただ一つを掘り出してこの世の空気にさらすと、たちまちに色も光も消え褪せた一片の土塊に変わってしまった。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホモゲンチジン酸溶液はアルカプトン尿に特有なすべての反応を呈し、空気にさらすと暗色になりアルカリを加えるともっと促進され、沸騰させるとフェーリング溶液を還元し、低温でアンモニア性硝酸銀を還元し、第一塩化鉄によって一時的に紺色を呈した。",
              "citation": {
                "source": "先天性代謝異常",
                "author": "INBORN ERRORS OF METABOLISM (1909)",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
