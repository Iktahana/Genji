        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "冷露声ナクシテ桂花ヲ湿ス。",
              "citation": {
                "source": "月の詩情",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」日本、古来ノコノ日常語ガ、スベテヲ語リツクシテイル。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カクテアシタハヒルトナリ、　　水音イヨヨシゲクシテ、　鳥トキドキニ群レタレド、　　　ヒトノケハヒハナカリケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシタイテイハ風トイッショニ雨ガバラバラヤッテ来テ道ヲ悪クシテイルノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノ　カゲカラ　コノ　ヤウスヲ　ウカガツテ　ヰタ　オカアサンダヌキハ　タイヘンナ　コトニ　ナツタト、メヲ　マンマルクシテ　オドロキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「顔色ハ白黒ヲ問ハズ眼中涼シクシテ、憂色ヲフクミ左頬ニヱクボアリ、アゴヤヤ長シ」　隠徳の相として挙げられているのは、三項ある。",
              "citation": {
                "source": "奉行と人相学",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "爲メニ簡明ナル一事一物ヲモ迂漫ナル愚論ナクシテ解悟スル能ハザル穉態ハ阿片中毒者ト語ル如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ國内物價ノ暴騰ヲ防グト同時ニ、貿易上ノ利益ヲ國庫ニ收得スルヲ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧困ニシテ實男子又養男子ナキ六十歳以上ノ男女、及ビ父又ハ男子ナクシテ貧困且ツ勞働ニ堪ヘザル不具廢疾ハ國家之レガ扶養ノ義務ヲ負フ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "言語ノ統一ナクシテ大領土ヲ有スルコトハ只瓦解ニ至ルマデノ槿花一朝ノ榮ノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ輕キ國家ノ制裁ヲ受クルコトニヨリテ、男子ハ家族ニ對スル權威ヲ失シ交友ニ於ケル信用ヲ損スル重大ナル苦痛ヲ受クルヲ以テ自ラ身ヲ愼ミ亦以テ婦人々權ノ擁護トナリ、全家族生括ノ保障ヲ加フルコトトナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "外力ノ援助ナクシテ植民米人ガ戰フベキ武力ヲ有セザリシ如ク、一切ノ武器ヲ奪ハレシ印度獨立軍ニ對シテ恣ニ鎭壓軍ヲ輸送セシムルナラバ其ノ獨立ハ永久ニ期待スベカラザル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ日本ハ北ニ大ナル圓ヲ畫キテ支那ヲ保全シ、支那亦日本ノ前營タルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸に生ズ、大サ寸ニ足ラズ、頭ハ蝦ニ似テ、螯ハ蟹ニ似タリ、腹ハ少シ長クシテ、蜘蛛ノ如ク、脚ニ爪アリ、空ナル螺ノ殻ヲ借リテ其中ニ縮ミ入ル、海辺ノ人ハ其肉ヲ食フ。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「月黒クシテ雁飛ブヤ高シ　匈奴　遠ク遁走ス　軽騎ヲ能ツテ逐ハント欲スレバ　大雪　弓刀ニ満ツ」　斯く歌ふに伴れて私の挙が、閑吉の鼻先をかすめたり、五郎の胸に突きかゝつたりすると、観衆はその度に仰山な悲鳴を挙げて、益々私達を山上遥か無敵の城内に祭り上げた。",
              "citation": {
                "source": "武者窓日記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｇ師は毎夜のやうに圭一郎を呼び寄せて「無明煩惱シゲクシテ、妄想顛倒ノナセルナリ」……今は水の出端で思慮分別に事缺くけれど、直に迷ひの目がさめるぞ、斯うした不自然な同棲生活の終に成り立たざること、心の負擔に堪へざること、幻滅の日、破滅の日は決してさう遠くはないぞ、一旦の妄念を棄て別れなければならぬ。",
              "citation": {
                "source": "業苦",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "といい、またこの後ち明治三年に出版の「西洋事情」第二編の例言中に、彼ノ常言モ、我耳ニ新シキコトアリテ、洋書ヲ翻訳スルニ臨ミ、或ハ妥当ノ訳字ナクシテ、訳者ノ困却スルコト、常ニ少カラズ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "当方通信用電源小サクシテ長時間ノ通信ニ耐エズ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド人事ヲツクシテ天命ヲ俟タンコトヲ思イ、許シ得ル範囲ノ応急送信機及ビ受信機ヲ建造セルナリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ完全ニ蒸焼サレタル芋ハ、蓋ヲ取去リテ取出シ、蓋ニ具ウル保温室内ニ常ニ保温セシメ置クモノナリ。",
              "citation": {
                "source": "発明小僧",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「松下童児ニ問ウ、云ウ師ハ薬ヲ採リ去ルト、只此山中ニ在ラン、雲深クシテ処ヲ知ラズ」渓流のように澄み切った、響きの高い声であった。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「雲深クシテ処ヲ知ラズ、とんとその辺わかりませんなあ」「いつごろお帰りでございましょう？",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二条　土地ハ一切ノ（公然タル若クハ隠蔽サレタル）賠償ナクシテ今日限リ全労働大衆ノ使用ニ帰スルモノトス。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ］人民公民ノ権ヲ失フモノ算ナクシテ町村ノ自治全ク［破壊→頽廃］セラレ［飢餓→貧苦疾病］及ビ毒ニ中リテ死スルモノ亦年々多キヲ加フ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙草幾管捻リ来タリ捻リ去リ、空々タル談話百回説クモ益無ク終日聴クモ利無クシテ、其ノ尻ノ長キ絛虫ニ百倍スル如ク、屡バ他人ノ事業ヲ妨グル者ニ至テハ真ニ辟易畏避セザルヲ得ズ。",
              "citation": {
                "source": "忙ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代ノ物程貴クシテ愛ス可キハ無シト雖ドモ、千年モ古ニシテ百年モ亦古ナレバ、只管古キヲノミ喜ブハ、贋物ヲ取ルノ憂無キニ非ズ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "古来説者云フ、胡地草白クシテ此塚独リ青シ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "当人自ラ哀シムノ心無クシテ一類之ヲ哀シム。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼吾ガ生計ノ忙ハシクシテ汝ガ吾レニ力ヲ致スノ厚キ、其ノ面ハ深墨ニシテ其ノ骨ハ稜々タリ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
