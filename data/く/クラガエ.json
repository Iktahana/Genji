[
  {
    "uuid": "d01f773f-461c-5dd9-8003-42f45d1ac9d2",
    "entry": "鞍替え",
    "reading": {
      "primary": "くらがえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
