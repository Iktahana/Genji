  {
    "uuid": "fe5e1973-ff87-5e4b-8b01-f76e90a7a00e",
    "entry": "クドク",
    "reading": {
      "primary": "くどく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
