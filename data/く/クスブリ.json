[
  {
    "uuid": "c176357d-c011-56fd-8a6b-871acb1c2fa5",
    "entry": "燻り",
    "reading": {
      "primary": "くすぶり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
