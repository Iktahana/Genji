        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "背後の村には燃えさしの家が、ぷすぷす燻り、人を焼く、あの火葬場のような悪臭が、部隊を追っかけるようにどこまでも流れ拡がってついてきた。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、枕木は炭焼竈の生木のように、雪の中で点火されぷす／＼燻りながら炭になってしまうのだった。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "幻山を証拠立てるよう塩尻がたの尖から何やら煙のようなものの燻り出るのが見えるようでもある。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "出口を塞がれたような青春の情熱が燻り、乏しい才能が徒らに掘じくり返された。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "停車場を出て橋を一つ渡ると、直ぐそこに町端らしい休茶屋や、運送屋の軒に続いて燻りきった旅籠屋が、二三軒目についた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "静けさや、靄の古びを黄蝋は燻りまどかに照りあかる。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "花瓦斯のほそきなげきに絹帷紅き天鵝絨、散り藉ける花束のくづ、おぼろげに室は青みて、うらわかき騎士が拍車の音の乱れ、舞の足ぶみ、頬のほてり、かろきさざめき、髪あぶら、あはれ、楽声、あたたかに交りみだれてゆめのごと燻りただよふ。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "野袴をつけた若者が二人、畠の道具を門口へ転がしたまま、黒燻りの竈の前に踞んで煙草を喫んでいる。",
              "citation": {
                "source": "千鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏戸口の※の木の下に据ゑられた風呂には牛が舌を出して鼻を舐めづつて居る樣な焔が煙と共にべろ／＼と立つて燻りつゝ燃えて居る。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "お秋さんは一人で醋酸石灰――之はどういふものかといふと炭竈の煙を横につないだ土管のなかを濳らせれば、煙は其間に冷却して燻り臭いひどくすつぱい液體になる。",
              "citation": {
                "source": "炭燒のむすめ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "藁屑の交つた粉炭の燻りは蒲團の裾から少し煙を立てる。",
              "citation": {
                "source": "開業醫",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「灰が湿っているのか知らん」と女が蚊遣筒を引き寄せて蓋をとると、赤い絹糸で括りつけた蚊遣灰が燻りながらふらふらと揺れる。",
              "citation": {
                "source": "一夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "土間の中央には、大きな摺鉢形をした窪みがあって、そこには丸薪や、引き剥がした樹皮などが山のように積まれ、それが、先刻から燻りつづけているのである。",
              "citation": {
                "source": "白蟻",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "塔婆は燻りて白き煙がうづまき※る。",
              "citation": {
                "source": "俳諧師",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの禅房の一室なりける我が書斎の茶煙や煙草の煙に燻りたるも少なからじ。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "片手には葉巻の半燻りしを撮み、片臂を五紋の単羽織の袖の内に張りて、鼻の下の延びて見ゆるやうの笑を浮べつつ、「ああ、おまへ其処に居らんければ可かんよ、何為歩いて来るのかね」　子爵の慌てたる顔はこの時｜毛繻子の覆の内よりついと顕れたり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを置く窖（ずいぶん長いあいだあけずにあったので、その息づまるような空気のなかで、持っていた火把はなかば燻り、あたりを調べてみる機会はほとんどなかったが）は小さくて、湿っぽく、ぜんぜん光線の入るみちがなく、この建物の私の寝室になっている部屋の真下の、ずっと深いところにあった。",
              "citation": {
                "source": "アッシャー家の崩壊",
                "author": "THE FALL OF HOUSE OF USHER",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手に燻りかえる安線香の束を持ち、左手に念珠を掛けながら、膝頭をガクガクさせて「南無南無南無」と言うばかり。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は卓子に頬杖をしながら差し迫つて考へなければならない用件のために、時々眼を瞑るのであつたが、ほかほかとするあまり快い陽気の加減か、頭の中はたゞ涯しもなく明るいやうな混沌の燻りが厭に長閑に棚引いてゐるだけだつた。",
              "citation": {
                "source": "熱い風",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "燻りかえっていた木が、又燃え出した。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "のめりかけている藁屋根の隙間からも、がたぴしゃに取付けてある窓からも、煙が燻り出ていた。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人の群がら燻り出した線香の煙が栗の幹のまわりで輪を解いていた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の火鉢では始終柴を折りくべて燃やすので、火鉢も其の周圍も黒燻りにくすぶつてゐた。",
              "citation": {
                "source": "父の婚禮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "火に入れば熱い焔色、燻りむせる煙に巻かれれば見わけのつかない煤色になって、恐れて逃る人間達を導き導き空気とともに勇気を与え、必要な次の営みにつかせます。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "照るともなく、曇るともなく、燻り渡つた一面の光である。",
              "citation": {
                "source": "山寺",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "その不和が「家のために」というひとつの旧い習慣の下でぶすぶすと燻りつづけてきた。",
              "citation": {
                "source": "父",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが薬なら、身体中、一筋ずつ黒髪の尖まで、血と一所に遍く膚を繞った、と思うと、くすぶりもせずになお冴える、その白い二の腕を、緋の袖で包みもせずに、……」　聞く欣八は変な顔色。",
              "citation": {
                "source": "菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」大古の黒の中山高帽を脱いで、胡麻塩のちょぼりとした髯を扱きながら、挨拶したのは、べんべらものの被布を着て、煤くすぶりの総の長い中位な瓢箪を提げている。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "印刷術は、すでにくすぶり出していた知識を求める火に注ぐ、油に他ならなかったのです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞き入れて、ホームズをくすぶり立つ炉辺の椅子に残して下がった。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
