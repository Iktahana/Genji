    "definitions": [
      {
        "index": 1,
        "gloss": "to be covered in grass",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "数年間放置されていた空き地は、すっかり草むすしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その古い墓地は苔と草むすして、往年の面影を失っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "廃屋の周辺は、完全に草むすている状態だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "海行かば水漬く屍、山行かば草むす屍、また顧みぬ防人の昔ながらの雄たけびや。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "また長歌には、「大伴の遠つ神祖の、其の名をば大来目主と、負ひ持ちて仕へし官、海行かば水漬く屍、山ゆかば草むす屍、おほきみの辺にこそ死なめ、顧みはせじと言立て」（巻十八・四〇九四）云々とあるもので、家持は生涯の感激を以て此の長短歌を作っているのである。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして草むす生品の辺をさまよい、幾多の英魂に心からな血涙を手向けては帰った。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
