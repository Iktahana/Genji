        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎日欠かさず腹筋とツイスト運動を続けたおかげで、理想的なウエストの括れを手に入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "あのモデルは、タイトなドレスを着こなすのに完璧な、美しい括れのあるボディラインを持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "水泳選手特有の引き締まった括れを見て、自分もジムに通おうと決意した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
