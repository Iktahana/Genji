        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "眼ハ大キクハナイガ非常に特色ガアル。",
              "citation": {
                "source": "ロシアの過去を物語る革命博物館を観る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついでに、税務署の役人と握手して、税金をタダにしておいてくれると、もっと偉いのだが、今カラデモオソクハナイ。",
              "citation": {
                "source": "西荻随筆",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ意味ガナクハナイヨウニ予ニハ取レル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ステージダンサーデモ幾分カソウナルケレドモ、アタシハ幸イニシテナラナカッタワ」浄吉ガ彼女ニ魅セラレタノハ彼女ノ姿態ニアルコトハ確カダガ、ロク／＼学校モ出テイナイノニ、頭モ悪クハナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マアオ爺チャン、可哀ソウニ」「ソンナ恰好ヲシテ何分グライ続ケルンデス」「幾日グライヤレバイヽノ」「オ止メニナッタ方ガヨクハナイ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今モエスピノザハイルケレド、モウ昔ホド良クハナイノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イズレハ焼イテシマッタ方ガイヽト思ウガ、遺シテ置クノモ悪クハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆デ相談ノ結果、コウケチガ附イタ以上、誠ニ残念デアルケレドモ、兎ニ角コノ注射ハ一ト先ズ打チ切リニシタ方ガヨクハナイカト云ウコトニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ハソンナニ強クハナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「脳貧血カモ知レマセンカラ、湯タンポハオ止メニナッタ方ガヨクハナイデスカ」ト木村ガ云ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真デ思イツイタガ写真機ガ欲シクハナイデスカ、「パテエ・ベビイ」ハイカガ？",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………ケレドアナタノ決心ガ真ニ最後ノモノデアルナラ、一日モ早イ方ガヨクハナイデスカ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
