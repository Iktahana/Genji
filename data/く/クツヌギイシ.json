        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "和風庭園の入口には大きな靴脱ぎ石が置かれ、縁側へと続いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "苔むした靴脱ぎ石に腰を下ろして、縁側から庭をぼんやりと眺めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "茶室への露地には、飛び石に交じって靴脱ぎ石が据えられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "東向きの、屋根のない門をはいって突き当たりの玄関の靴脱ぎ石は、横降りの雨にぬれるような状態であったような気がする。",
              "citation": {
                "source": "夏目漱石先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰りついた玄関の靴脱ぎ石の上には岡の細長い華車な半靴が脱ぎ捨てられていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして靴脱ぎ石の上に鋏の大きな蟹が死んでいるのを見ると、学者たちを呼んでまいりました。",
              "citation": {
                "source": "椰子蟹",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "志村はそこの靴脱ぎ石に庭下駄を揃えて、「あちらでございます」　と真暗な庭を指さす。",
              "citation": {
                "source": "白髪鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
