    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "藤子が食い付きそうだと云ったのは、この青年の顔であった。",
              "citation": {
                "source": "カズイスチカ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤子が食い付きそうだと云ったのも無理は無い。",
              "citation": {
                "source": "カズイスチカ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔琉球で盗人を検出するに、巫女蛇を連れ来り、衆人を集め示せば、盗人に食い付きていささかも違わず、故に盗賊なかりしと（『定西法師伝』）。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "馳せ返って来た毒蛇は、帯刀様へ食い付きました」葉之助は頷いた。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "食い付きなさいまし、お仕事にね。",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのアウアー門下のヴァイオリニストに共通の特色は、いずれも、優れた技巧家であることと、それから、華麗で外面的で、食い付きの良いことである。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常に美しいものだが、モーツァルトの甘美さが、無表情過ぎて食い付き難いと言う人もあるだろう。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「親方、精が出るね」「早桶の註文かい」　どうも少し食い付きよくありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "江戸阿呆宮",
                "note": "青空文庫"
              }
            },
            {
              "text": "無暗矢鱈とツンツンして、今にも食い付きそうに乃公を睨める。",
              "citation": {
                "source": "いたずら小僧日記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今にも食い付きそうな権幕だったから乃公は一目散に逃げて来た。",
              "citation": {
                "source": "いたずら小僧日記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
