        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "焼鳥屋で串焼きを注文すると、炭火の香ばしい香りが食欲をそそる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "夏祭りで串焼きを食べながら、屋台を回るのが恒例になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "串焼きの焦げ具合を見極めるには、職人の経験と感覚が必要である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "(Ice.)steik は steka と親類で英語の stick すなわちステッキと関係があり、串に刺して火にあぶる「串焼き」であったらしい。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつを、刺殺そうなんて、八つ裂きにして、串焼きにしてえってのが、人情だが、惚れた人情って奴あ、又、人情の中でも別だわな。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "失恋の傷手に悶々たる烏啼の奴は、今頃はやるせなさのあまり、君の心臓を串焼きなんかにして喰べてしまったかもしれないよ。",
              "citation": {
                "source": "心臓盗難",
                "author": "烏啼天駆シリーズ・２",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それが終ると、ソオセエジを串焼きにして麺麭にはさんで食べたりしながら、その焚火のまわりで踊ったりなんかして遊ぶんだわ。",
              "citation": {
                "source": "晩夏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふん、ソオセエジをその焚火で串焼きにして食べるのかい？",
              "citation": {
                "source": "晩夏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰彼なしに金を用立てる、療治をしてやる、婚礼の橋渡しをしてやる、喧嘩の仲裁をしてやる、ピクニックの音頭取りになって、羊肉の串焼きをする、とても旨い鯔のスープをこしらえる。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "土鰌を丸のまま串焼きにし、味噌たれを付けて「どかば」という、つまり土鰌｜蒲焼の意味だろうが、それを一年中つきだしに使うのが、特徴でもあり評判だったようである。",
              "citation": {
                "source": "七日七夜",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「このお屋敷じゃあ預かり物もするのか」「なあにそんなんじゃあねえ」　燗酒を湯呑でぐっと呷って、串焼きの、まだ膏のぶつぶついっているのを、ひと口にこいで喰べながら、虎造はちょっと自慢らしく声をひそめて云った。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとにあがるんですか」とおつまはにやにやした、「今日は鶉の串焼きのうまいのがあるのよ」「刺身だ」と房二郎は手酌で一つ飲みながら云った、「かなっけのことは心配するなって云ってくれ」「悪いしゃれだ」とまた木内が云った。",
              "citation": {
                "source": "へちまの木",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まずその細いのからはじまって、串焼き肉のあの棒みたいなブウジイが尿道に※入される。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿道の拡張が目的で、拡張させた上で殺菌液を注入するのがブウジイ療法――なんとも、はや旧式な、鋳物屋を笑えぬ旧式さだが、そんな妙な棒を、ひとのヨシコのなかに串焼きみたいに突っこんでおいて、何分か放っておくのだから、放っておかれる身はたまらない。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その代りあの方と口をきくのはこれ限りよ、わたくしやきもちやきですからね」五　吉岡の家は湯島聖堂裏の高台にあった。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "盛合わせ皿には、燻製の鮭、パン片に塗りつけたキャビア、鮒の串焼、黄いろい生雲丹、ラドッシュ。",
              "citation": {
                "source": "地獄の使者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋田、鳴海、我等四人で「シャシュリーク」〔串焼羊肉を食べさせる店〕にゆき、かえり、ホテルの入口で、鳴海君一人「少しブラツイテ来ヨーカナ」と云って、外に止った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "羊肉の串焼を高く捧げて、一人の助手がそれを恭々しくぬいては客に供する、実にこと／″＼しい。",
              "citation": {
                "source": "中條精一郎の「家信抄」まえがきおよび註",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理に何か串焼のようなものが出たら、かの子さんがいかにも食べにくそうに、どうしてたべるのかしらと眺めていられるので、私がその串をぬいてあげたことがあった。",
              "citation": {
                "source": "作品の血脈",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "天狗を酔いつぶさせるために爺さんが苦心してこしらえた料理ですから、豚肉の串焼の中にも、雉の肝の揚物の中にも、鯉の丸煮の中にも、その他いろんな見事な料理の中には、みな強い酒がまぜてありましたし、それを食べながら、さらに大きな杯でがぶがぶ飲んだものですから、二人が酔っぱらうのも無理はありません。",
              "citation": {
                "source": "天狗の鼻",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "千住の名産｜寒鮒の雀焼に川海老の串焼と今戸名物の甘い甘い柚味噌は、お茶漬の時お妾が大好物のなくてはならぬ品物である。",
              "citation": {
                "source": "妾宅",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「城中では会っているが、元気でやっている、近いうちに馳走のし直しをして招くとしよう」「それが宜しゅうございますわ、もう雁が出はじめましたから、お好きな串焼をどっさり御馳走致しましょう」「そうだ、明日にでもそう云って置こう」　けれど実は、兵馬は城中でも絶えて辰之助に会う機会がなかったのである。",
              "citation": {
                "source": "柿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビーフ串焼、チキンのクリームソース。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "煤だらけな浪宅に竹脚の膳をすえ、裂いた松茸に鮒の串焼、貧乏徳利をそばにおいて、チビリ、チビリ、昼の酒。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "鳴門の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "小酒屋めかした野天の腰かけ板へ、濁酒と串焼をもらって、その串ザシの肉を咥えて、串をぽんと捨てながら。",
              "citation": {
                "source": "私本太平記",
                "author": "八荒帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "――おや、美味え臭いがすると思ったら」　と、土間炉で、小鳥の串焼をしている亭主の肩からのぞいて、「俺も、餌がほしい。",
              "citation": {
                "source": "雲霧閻魔帳",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "メンコ以上に博奕的でスリルのあるアテ物とか玉ツブシなどもその中の駄菓子屋で覚え、モンジヤキとか、犬だか豚の臓物だか知れない怪しげな串焼の味も知った。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
