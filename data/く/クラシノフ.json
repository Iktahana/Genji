        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "クラシノフ――亡命中の露西亜革命党員。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラシノフは、中央の机に腰かけて露語新聞を読み、鄭吉炳は箒でそこらを掃き、その間を李剛は、何か呟きながら探し物の態で、部屋じゅう跛足を引いて歩き廻っている。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラシノフ　（舌打ちして）またか。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラシノフ　（不安げに立って）いやいや、暗いほうがいいです。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "階段の上にクラシノフが現れて下を覗く。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラシノフ　どうしたい。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラシノフ　僕も弥次りに行こう。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラシノフ　救世軍の前でやろうじゃないか。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラシノフ　名案だ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラシノフ　はっはっは、洒落たことを吐かしたね。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "鄭吉炳とクラシノフは小冊子の束を抱えて出て行く。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
