        "examples": {
          "standard": [
            {
              "text": "毎週金曜日のクイズ番組は、視聴率が高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "クイズ番組で見かけた問題が、大学の試験に出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "家族でクイズ番組を見ながら、一緒に考えるのが日課だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "一〇歳のときには、ラジオのクイズ番組「クイズキッズ」のチャンピオンになったケイは、Ｊ・Ｄ・サリンジャーの描くシーモア・グラスを思わせる繊細で多感な早熟の天才だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "原敬や横綱大錦あたりになると、覚えている人も多いだろうが、豊川良平、岩崎小弥太、加藤弘之、黒田清輝、徳川｜家達、野口｜小蘋となると、ラジオのクイズ番組でも、歴史上の人物という分類にはいるかも知れない。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学教授がテレビのインチキなクイズ番組に加担していたことが発覚し、クイズ番組が議会の調べを受けた。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
