          "literary": [
            {
              "text": "＊４　クルイロフ　イワン・アンドレーヴィッチ（1768-1844）有名な寓話作家。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "菩提樹のなかにロシアのイソップ・クルイロフの銅像がある。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロシアにもクルイロフというがっちりした爺さんがいて、エソープの焼直しものをうんと書いた。",
              "citation": {
                "source": "新たなプロレタリア文学",
                "author": "――アレゴリーと諷刺――",
                "note": "青空文庫"
              }
            },
            {
              "text": "今でもレーニングラードの冬宮裏の公園へ行くと、濃い菩提樹のしげみのかげに、クルイロフの銅像が立っている。",
              "citation": {
                "source": "新たなプロレタリア文学",
                "author": "――アレゴリーと諷刺――",
                "note": "青空文庫"
              }
            },
            {
              "text": "文明はこの点、かえって僕らに熊の親切〔熊が主人の顔にとまった蠅を追おうとしてその顔を叩き潰してしまったという、クルイロフの寓話詩からきた慣用語。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
