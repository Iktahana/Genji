          "literary": [
            {
              "text": "センサウノ　タメニ　ワタクシタチハ　ハタケヲ　アラサレ、タベル　モノハ　ナクナツテ　シマヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　ユウガタニ　ナツテ、タイヤウガ　オチテ　シマフト　ヒロツパノ　マンナカノ　マルイ　カゲハ　ナクナツテ　シマヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナツテシマフノデスガ、今夜ハサウナラナイ内ニ、ワザト魔法ニカカツタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、シカタガナイノデ、ソノ洋服ヲキテ、小サクナツテ学校ヘユキマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、マスマスオコリマシタガ、シカタガナイノデ、オザシキノアンラクヰスニコシヲカケマシタラ、タウトウキモチガヨクナツテ、マユヲシカメタママネムリコンデシマヒマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンコチヤンハソレヲキイテ　一シヨニカナシクナツテ、ワン、ワンナキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゲガドンナニ　オホキクナツテモ　キミハ　ヤツパリ　コイヌ　ナンダヨ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　ナニヲキタライイカ、イロイロト　ソウダンシテヰルウチニ、ダンダント　ネムクナツテ　キマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　ナニヲキタライイカ、イロイロト　サウダンシテヰルウチニ、アマリ　ポカポカト　アタタカイモノデスカラ　ダンダント　ネムクナツテキマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨシヲサンノオ母サンハ、オカシクナツテ「アラ、マア、何テヘンナオ子サンダラウ、マルデ、カツパノオバケミタイダワ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
