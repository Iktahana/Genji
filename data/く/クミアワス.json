        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "次の試合で彼はチャンピオンと組み合わされることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "テニスのトーナメントでは、実力のある選手同士が序盤で組み合わされることもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はその相手と組み合わすことを恐れていなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
