          "standard": [],
          "literary": [
            {
              "text": "まったく、クラントルがエピクロスの無痛を、それがもし苦痛の接近も発生も全然ない深い所に置かれているのだとしたら御辞退する、と言ったのは至極もっともであった。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "正か邪か、有用か無用かを、彼は、クリュシッポスやクラントルよりもよく我らに言う。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはクラントルと同じ意見である。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
