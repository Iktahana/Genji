        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "建坊、キバッテ、エヽ写真、ツクッテヤ。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ、アノ新聞記事ヲ見マシテカラ、ヤット昨晩、家ニ帰ッテ見マシタラ、祖母ハ蚊帳ノ釣手ニ、妻ノ赤イ細帯ヲカケテ、首ヲククッテ死ンデオリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、ウルサクナクッテ、イヽアンバイダと思ふ、それは小雨のしとしとと降る日曜の午前でした。",
              "citation": {
                "source": "嘆きの孔雀",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "揚句ノ果ニハ、　「アナタハ一体今迄清三ニカクレテ私ト愛シ合ッテ居タノデハナクッテ？",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ビョウキシテ、コマッテ、イルカラ、三円クメンシテ、オクッテクダサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノアイダ、オクッテ、クダサッタ、ハナノクスリ、オツイデノトキニ、スコシオクッテクダサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンナノトテモ欲シインダケレド、オ高クッテ手ガ出ナイワ」ト、墺太利製ラシイベージュノスウェードノ、口金ニサファイヤノイミテーションラシイ石ガ這入ッテイルハンドバッグノ前デ、颯子ハ頻リニ嘆声ヲ発シテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ五時ダネ、オ婆チャン、コレカラ銀座ヘ出テ晩飯ヲ喰ッテ帰ロウジャナイカ」「銀座ノドコヘ」「浜作ヘ行コウヨ、コノ間カラ鱧ガ喰イタクッテ仕様ガナインダ」颯子ヲ呼ンデ浜作ニ電話サセ、カウンターノ席ヲ三四人分取ッテオイテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マア考エテオクコトニシヨウ」「今日御返事ガイタヾケナインデスカ」「コノトコロイロ／＼ト出銭ガ多クッテネ」ブツ／＼云イナガラ二人ハ出テ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今デハ女ヨリモ仕事ノ方ガ面白クッテ溜ラナイラシクモアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉ニデモ行ッテ貰ウサ」「御自分デ御覧ニナラナクッテモイヽンデスカ」「コノ暑イノニコノ体デハ行ケソウモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――ト云ウノハ、タイルニシテ見タラ濡レテイル時ツル／＼滑リ易クッテ、老人ハ危クテ仕方ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コナイダハ手加減シタゲタノヨ」「ソンナ御遠慮ニハ及バンヨ」「アタシノ掌ハヨク撓ウノヨ、ホントニ打ッタラ眼ガ飛ビ出ルホド痛クッテヨ」「ソレハ寧ロ望ムトコロ」「始末ニ悪イ不良老年、ジヾイ・テリブル！",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「出来タラ出来タデ仕方ガナイ、ドウゾ御遠慮ナクッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ唇ダケデナクッテモイヽ、舌ヲ着ケテモイヽ」予ハ七月二十八日ト同ジ姿勢デ、彼女ノ脹脛ノ同ジ位置ヲ唇デ吸ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通ノ日本人ノ靴ハ平ベッタクッテアタシノ足ニハ合ワナイト、颯子ハ自慢スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今考エルトアノ奥サン大層オシャベリナ方ダッタカラ、ワザ／＼コレガ云イタクッテ寄ッタンジャナイカッテ、陸子ハ云ウンデスガネ」「コレトハ何サ」「マア、コレカラ先ハ陸子ニオ聞キニナッテ下サイ」安楽椅子ニ腰カケテイル予ノ面前ニ並ンデ立ッテイタ二人ハ、コヽデ「ドッコイショ」トソファニ腰ヲ据エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「少シハ痛クッテモコンナコトヲシテイル方ガ気ガ紛レルヨ、痛クテ溜ラナクナッタラ止メル、今ノウチハ仕事シテイル方ガイヽ、アッチヘ行ッテヽクレ給エ」午後一時ヨリ午睡、一時間ホドトロ／＼トスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ呼ベタコトガ予ニハ嬉シクッテ溜ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ颯子ト同様ニ偽悪趣味ガアリ、男ノ癖ニ泣クナンテ見ットモナイト思ッテイルノダガ、ソノ実案外涙脆クッテ、屁デモナイコトニ訳モナク涙ガ出ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ小サクッテイラッシャルノニ、ヤッパリオ爺チャンノコトヲ心配ナスッテイラッシャルンデゴザイマスネ」「子供ノ癖ニ変ニマセテイヤガッテ小生意気デイヤナ奴ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「隣ニ佐々木サンガ寝テヽクレヽバ何カアッタッテ安心ジャナイカ、ネエ、颯チャンハコッチデ寝テオクレヨ」「煙草ガ吸エナイノガ困ルワ」「吸ッタライヽサ、イクラデモ吸ッテオクレ」「ソンナコトヲシタラ佐々木サンニ叱ラレチャウワ」「オ咳ガヒドクッテイラッシャイマスカラネ」ト、佐々木ガアトヲ引キ受ケル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少クトモ今日一般ニ行ワレテイル長方形ノノッペラボウノ石ノ表面ニ戒名又ハ俗名ヲ記シ、ソノ下ニ台石ヲ据エテ、ソノ前ニ線香立テノ穴ト手向ケノ水ヲ供エル穴トヲ穿ッテアルアノ形式、アレハイカニモ平凡デ、俗ッポクッテ、何事ニモ旋毛曲リノ予ニハ気ニ入ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリスマスのあと、ブロート夫妻とクッテンベルク・モラヴェッツに四日間滞在。",
              "citation": {
                "source": "「世界文学大系58　カフカ」年譜",
                "author": "原田義人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
