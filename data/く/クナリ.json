        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "海デ沢山遊ビ黒クナリマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「北海道ハ秋モ晩クナリマシタ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『コチラノオクサマガ、サクバンオナクナリニ、ナリマシタカラ、オシラセシマス』彼は、こうした文句から激動を受けながら、差出人の名を探ったが、夫は何処にも書いてなかった。",
              "citation": {
                "source": "大島が出来る話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「困リマス、バロメーの水銀無クナリマス」「……驚いたなあ……また時化るんですか」　運転手は返事せずに、階段の方向へ駈け出した。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ内ニ音ガ小サクナリ、風モ治マリ、柱状ノモノモ以前ノノヤウニ明瞭ニハ見エナクナツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ後急ニ近隣ノ火ノ手ガ強クナリ、今戸八幡ノ方ニモ火ノ手ガ擴ガツテ來タタメ、大川縁ヲ傳ヒ北方ニ、逃ゲル仕度ヲ始メタノデ、後ノ状況ハ見ナカツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "此比俄ニ日本古銭ヲ玩ブ人多クナリテ、其価ノ十年前ニ四五倍スル様ニナリシハ、泰西ノ風ニ化シタルナリト云フモ、失言ニハ非ザル可シ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カヘルサンハ生レツキ色ガ青カツタノデスガ、コノ時バカリハ赤クナリマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オユデ、ウダツタノデ、ジヤガイモサンハイロガマツシロニナツテ、イゼンヨリモ、ウツクシクナリマシタノデ、ミンナオホヨロコビ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラトイフモノ、モンコチヤンハボンコチヤンヲケツシテカブラナクナリマシタカラ、オ父サント、オ母サント、オ姉サントオ兄サンハモンコチヤンニカウイヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ家ヲトビダシテ、アツチコツチヲアルキマシタケレドモ、ツカレテ、ダンダンネムクナリマシタノデ、自転車ニノツテ、ホテルヘユキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンノクシヤミハモツトモツトヒドクナリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マルコオバサンガ「マア――ソンナ――コト――」　カメコオバサンガ「ダツテ――イイエ――ヤツパリ――」　ソシテ　フタリトモ、コヱガ　ダンダン　チヒサクナリ、クチガマワラナクナリ、ヤガテ　グツスリ　ネムリコンデ　シマヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチ、カメコオバサンモ　トロトロト　マブタガ　オモクナリマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ソシテ　フタリトモ、コヱガ　ダンダン　チヒサクナリ、クチガマワラナクナリ、ヤガテ　グツスリ　ネムリコンデ　シマヒマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレデハ頁ガ多クナリマセンネ。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この句は旧訓ヒビクナリであったのを、代匠記で先ず注意訓をして「響ハトヨムトモ読ベシ」と云い、略解から以降こう訓むようになったのである。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治三十五年三月十日の日記に午前十時「此日始メテ腹部ノ穴ヲ見テ驚ク穴トイフハ小キ穴卜思ヒシニガランドナリ心持悪クナリテ泣ク」とある。",
              "citation": {
                "source": "青春論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ニ行クホド暑クナリマス」正直ノトコロ、予ハ手ノ痛サニ閉口シテ晝ノ部ヲ見ルノハ止メヨウカト思ッテイタノダガ、婆サンニ窘メラレタノデ却ッテ依怙地ニナリ、痛イノヲ怺エテ明日ノ晝ニ又来ヨウカト思ッテイタノダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩カズニイルト、今ニ本当ニ歩ケナクナリマスト嚇カサレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供達ガ来ルトウルサクナリマスカラ、早イ方ガヨゴザンスヨ」ト、婆サンガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワガ家ニ来テカラ既ニ十年近クナルノニ、歳月ヲ経ルホドマス／＼美シクナリツヽアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "息ヲ強クスルト音モ強クナリ、マルデ笛デモ吹イテイルヨウニピイピイト鳴ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニヨクナリマスヨト婆サンハ云ッタガ、ドウヤラコウヤラ少シ楽ニナリカケテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソバデ煙草ヲオ吸イニナッタラ、ゴホン／＼オ咳ガ止マラナクナリマスヨ」「ボーイサン、ソノトランクヲコッチノ部屋ヘ運ンデ頂戴」颯子ハ構ワズサッサト隣室ヘ這入ッテ行ッテシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルヘ戻ッテ何シテタンダ」「寒クナリソウダカラ着換エテ来タノヨ、オ爺チャンモ気ヲオ付ケニナラナイト風邪ヲ引クワヨ」四条通リデ買ッテ来タノヲ早速着テ見タカッタノダロウ、白ノブラウスニ、ブリューニ銀ノラメガ繍イ込ンデアルセーターヲ着テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔ウトマスマス意地ガ悪クナリ、足ニ触ラセマイトスル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシコノ状態ガ持続シ、カツソノ程度ガ漸次ニ昂進スルトスレバ、ヤガテ僕ハ大学教授ノ職ニ堪エナクナリハシナイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
