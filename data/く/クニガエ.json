      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "forced relocation of a daimyo to a different domain (Edo period)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "江戸時代の大名にとって、国替えは家臣団にも大きな影響を与える出来事だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は、突然の国替えの命令に戸惑いを隠せなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "歴史の研究者は、特定の藩の国替えが地域の発展に与えた影響を分析している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、この孤島の所在は、探鯨の死と同時に国替えなどもあって、ついに姉川家の記録から、消え失せてしまったのであった。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時、お国替えの藩主を迎えた川越藩では、きびしいお触れを町家に回して、藩の侍に酒を売ることを禁じた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀家は後に、信州飯田から播州に移った脇坂家のあとに入って、飯田に国替えになった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔は藩主のお国替えによって方言の交流ということも行われたが、これは文化的に見てプラスであったろうかというに、必ずしもそうとはいえなかった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに国替えをすると、何処の言葉だか判らないものになってしまう。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは上州館林の人だったが、藩主の秋元という家は度々国替えになって、もと山形にいたのが館林に移ったので、田山の母君も山形で育った人であった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち唐の玄宗皇帝が女色を愛するの極、美人と国替えに往こうとする、それを歌ったのである。",
              "citation": {
                "source": "現代の婦人に告ぐ",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうしてどうやら身のまわりも落ち着いたと思うとき、水野忠善はふたたび国替えとなり、五万石に加封のうえおなじ三河の岡崎城へ移された、正保二年七月のことである。",
              "citation": {
                "source": "日本婦道記",
                "author": "箭竹",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀久太郎は強いことは強いが、後に至って慶長の三年、越後の上杉景勝の国替のあとへ四十五万石（或は七十万石）の大封を受けて入ったが、上杉に陰で糸を牽かれて起った一揆の為に大に手古摺らされて困った不成績を示した男である。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが信雄は此の国替を悦ばなくて、強いて秀吉の意に忤った。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ氏郷が寿命が無くて、朝鮮へ国替の願を出さずに終ったことは、氏郷の為に、太閤の為に惜んでも余りある。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "家康も家康公と云って然るべき方である、利家も利家公と云って然るべき人である、其他上杉でも島津でも伊達でも、当時に立派な沸り立った魂は少くないが、朝鮮へ国替の願を出そう者は、忠三郎氏郷のほかに誰が有ったろう。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後某は御先代妙解院殿よりも出格の御引立を蒙り、寛永九年｜御国替の砌には、三斎公の御居城｜八代に相詰め候事と相成り、あまつさえ殿御上京の御供にさえ召具せられ候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりながら一旦切腹と思定め候｜某、竊に時節を相待ちおり候ところ、御隠居松向寺殿は申に及ばず、その頃の御当主妙解院殿よりも出格の御引立を蒙り、寛永九年御｜国替の砌には、松向寺殿の御居城｜八代に相詰め候事と相成り、あまつさえ殿御上京の御供にさえ召具せられ、繁務に逐われ、空しく月日を相送り候。",
              "citation": {
                "source": "興津弥五右衛門の遺書（初稿）",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸幕府の制度は、外面は最も地方分権的体裁を示してゐるが、内面は最も精緻な中央集権制で、自領内では行政権、警察権をもつてゐる百万石の大名も、幕府の一片の命令で蟄居、国替、減石、断絶せしめられるので、その何れも今の内閣が地方官の変更任免を奏請するよりも、まだ容易であつた。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "目の盲ひたお婆さんは、車に乗ると眼が眩ると言ふので、昔｜御国替への時乗つて来たやうな軽尻馬をわざわざ仕立てゝ、町の通をほつくり／＼と遣つて来た。",
              "citation": {
                "source": "朝",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "小笠原家が、豊前小倉に国替への後、突如として狐が姿を現した。",
              "citation": {
                "source": "信太妻の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがいつしか時代と共に、武家が土地に執著するやうになり、大名の国替へで擾乱を起したりしますが、幕府のその国替への政策は無謀のやうですが、それがかつての土地を自由に思つてゐた時以来の考へであり、徳川の初め以来さう考へてゐたものが、治つて来ると土地への執著と共にさうゆかなくなります。",
              "citation": {
                "source": "無頼の徒の芸術",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度｜明和の元年に粂野美作守高義公国替で、美作の国｜勝山の御城主になられました。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月一日、越後国｜頸城郡高田へ国替を命ぜられ、翌年、入部した。",
              "citation": {
                "source": "鈴木主水",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしんば北極へお国替へを命ぜられたにしても、彼らはやはり揃ひの浴衣で樽神輿をかつぐだらう。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "この上水井戸は、藩祖長直公が、常陸の笠間からお国替になった折に、領民のため、こうして城下の辻々に掘っておかれた有難い恩水なのじゃ。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると御家老様の仰しゃるには、いずれ秋には、浅野家の後へ、お国替してくる何処かの御家中が見るだろう、誰が見ようと咲く花にちがいはなし、萎縮た花は残しとうないからと仰しゃる。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "名字と地名との関係断絶の理由　三百諸侯の中には、三百年の間同じ領地を保っておった家もないではないが、その大半は三度も五度も国替・城替があったのである。",
              "citation": {
                "source": "名字の話",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわんや奥州の棚倉などいうような所へ、懲戒的に国替させられるような中大名にあっては、その藩士の漂泊生活というものは、明治の今日の軍人や裁判官も三舎を避けるくらいであった。",
              "citation": {
                "source": "名字の話",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
