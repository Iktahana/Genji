  {
    "uuid": "663fe6df-dbfe-5229-ae09-d162c949f127",
    "entry": "国替え",
    "reading": {
      "primary": "くにがえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
