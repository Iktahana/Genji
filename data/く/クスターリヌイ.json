          "literary": [
            {
              "text": "十一月二十一日（水曜）　クスターリヌイ〔手芸品屋〕へ行って、モヤへクッションを買い、自分机かけ。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クスターリヌイ〔手芸品屋〕に二人でよって、パン入れざるとしゃくしを買った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月二日　水　クスターリヌイで買もの（麻にぬいのある服地、テーブルかけ等）　ずいぶん歩いた。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○クスターリヌイによって樺の木の箱を買った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この間クスターリヌイ（民芸美術館）へ行って買って来たものを出して、見てもらおう。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
