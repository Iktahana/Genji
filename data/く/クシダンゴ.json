        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "屋台の串団子は甘辛いたれがかかっていて、三本でちょうどいい食べきりサイズだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "祭りで売っている串団子を買って、友人と食べながら歩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "串団子の焦げた香りが漂ってくると、縁日が近いことを感じさせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "懸茶屋には絹被の芋｜慈姑の串団子を陳ね栄螺の壼焼などをも鬻ぐ。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この串団子の模様が祇園の表象ですよ。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "三つ刺したくしだんご！",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "判じ文を唯一の手がかりとなさるならば、貴殿のお知恵によって、絵のところに待っているという三つ刺したくしだんごはいずれの地名か、それをお判じなすってお出かけなさることだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "くしだんごのところへ行きたくも、あば敬にゃこの判じ絵がかいもく見当がつかねえんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「このくしだんごのなぞが、おまえさんにおわかりか、といってきいてるんだよ」「バカにおしなさんな、こんなものぐれえわからなくてどうするんですかい。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まごまごしているばかりで、からきし物の役にゃたたねえんですよ」　伝六、出がけにつかんでいったくしだんごをまだ食べているのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
