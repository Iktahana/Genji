    "definitions": [
      {
        "index": 1,
        "gloss": "rotting",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "腐れが進行している木の板を取り外した",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "柱の腐れを発見して専門家に相談した",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "腐れは伝染しやすいので早期の対処が大切だ",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "心は腐れ、器物は穢れぬ。",
              "citation": {
                "source": "地極の天使",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "露営地の外では、細長い爬行動物――この谷の主――東俣の川――が、蜿ねりながら太古の森林の、腐れ香に噎んで、どこまで這って行くことであろう。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "次第に喬木の森林に入った、白く光る朽木は、悪草の臭いや、饐えたような地衣の匂いの中に立ち腐れになっている、うっかり手が触れると、海鼠の肌のような滑らかで、悚然とさせる、毒蚋が、人々の肩から上を、空気のように離れずにめぐっている、誰も螫されない人はない、大樺池を直ぐ眼の下に見て、ひた下りに下る。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪の毛は汗でねばねばしていて、ふて腐れたように手にザワザワ捲きついて来た。",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "奴等が一段ずつ位と月給が上って、俺たちゃ立ち腐れになるんだ）「誰だい？",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし気分がそのまま外に現われるとしたら自分の顔は半腐れの鬼婆のようなものだろう。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの記事がもし半分でも事実とすると、東京市の公共機関の内部には、ゆるみきりにゆるんでしまって、そうして生命を亡って腐れてしまった部分がいくらかはあると見える。",
              "citation": {
                "source": "初冬の日記から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞ばかり見ていると東京も日本も骨髄まで腐れているかと思うこともあるが、そうでもないと思われるたしかな証拠もなくはない。",
              "citation": {
                "source": "初冬の日記から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹の葉の水気が集つて一滴の露となり、腐れた酒の蒸気が冷たいランビキの玻璃に透明な酒精の雫を形づくる迄のそれ自身の洗練はかりそめのものではない。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありあけながい疾患のいたみから、その顔はくもの巣だらけとなり、腰からしたは影のやうに消えてしまひ、腰からうへには藪が生え、手が腐れ身体いちめんがじつにめちやくちやなり、ああ、けふも月が出で、有明の月が空に出で、そのぼんぼりのやうなうすらあかりで、畸形の白犬が吠えてゐる。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "からだぢうに巣喰つた病気が腐れた噴水のやうに、友の詩を味ふ私を不安にした。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ながい疾患のいたみから、その顔はくもの巣だらけとなり、腰から下は影のやうに消えてしまひ、腰から上には藪が生え、手が腐れ身体いちめんがじつにめちやくちやなり、ああ、けふも月が出で、有明の月が空に出で、そのぼんぼりのやうなうすらあかりで、畸形の白犬が吠えてゐる。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "くらい人間のお腹にぐにやぐにやに詰つたいろいろな機械の病んだもの腐れかけたもの死にさうなものの類ひが今光の方面を向いてゐる。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これっぽっしの目腐れ金で妾をろうらくして、売女奴！",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あいつらは、女の腐れみたいな野郎さ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今が、あいつとの腐れ縁も見切時かな。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あんな腐れ婆にゃ、あき／＼していら。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の労働者達は焚き火にあたりながら冗談を云ったり、悪戯をしたりして、笑いころげていたが、京一だけは彼等の群から離れて、埃や、醤油粕の腐れなどを積上げた片隅でボンヤリ時間を過した。",
              "citation": {
                "source": "まかないの棒",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで四人は足のさきからだんだん腐れてべとべとになり、ある日たうとう雨に流れてしまひました。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで四人は足のさきからだんだん腐れてべとべとになり、ある日とうとう雨に流れてしまいました。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いい加減な眼腐れ金をくれているのにつけあがって、我儘もほどほどにしろ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "へえ天国に入れてもらいます……ばか……おやじが博奕打の酒喰らいで、お袋の腹の中が梅毒腐れで……俺の眼を見てくれ……沢庵と味噌汁だけで育ち上った人間……が僣越ならけだものでもいい。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かんかん虫手合いで恐がられが己れでよ、太腐れが彼奴だ。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イフヒムの奴も太腐れて居やがる癖に、胸三寸と来ちゃからっきし乳臭なんだ。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "をつかしい奴だなあ……ほれ、今酒を飲んだべ」　その沢庵漬で酒を飲むのが、あとで勃凸と腐れ縁を結ぶやうになつた「おんつぁん」だつた。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだからふて腐れて赤いスエターを頭からすつぽりと被つて、戸棚の中で泣いてゐた。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺｜太て腐れてゐたら、おんつぁんが……いつもさうだべ、なあ……額に汗をかき／＼俺のものを綺麗に風呂敷に包んで、さあ出て行けと俺の坐つてゐるわきさ置いてよ、自分はそつぽを向いてもう物をいはねえでねえか。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人のもてあそびの腐れ爛れ汚れものが、かけまくも畏き……清く、美しき御神に、嫉妬の願を掛けるとは何事じゃ。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と大酒飮んで、醉ふたまきれに「乃公なんかは近い内に大仕事があるのだ、其仕事の爲に今此港へ來て、明後晩にはまた此處を出發するのだが、其一件さへ首尾よく行けば、百や二百の目腐れ金はお前にもあげるよ。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　水ぶくれの按摩の面は、いちじくの実の腐れたように、口をえみわって、ニヤリとして、ひょろりと立った。",
              "citation": {
                "source": "怨霊借用",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
