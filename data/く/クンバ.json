        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日本ノ對外行動ハ取ルベカラザル者ヨリ寸土ヲ得ザルト共ニ、天日照覽ノ下苟モ奪フベクンバ全地球ヲモ大ナリトセザルベキ大丈夫ノ健脚ニ立ツベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一ハ打シ、一ハ刺ス、棒ニ刃ナクンバ何ヲ以テ刺スコトヲ為サン。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論漢學ナル者ハ支那ヲ祖トスレバ、之ヲ師トセザルヲ得ズト雖ドモ、皆蹈襲摸傚ヲ事トシ、化シテ本邦ノ益トナスコト無クンバ、亦何ノ用ゾヤ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "祇園ノ妓若シ東山ノ勝無クンバ則亦幾分ノ聲價ヲ減殺シ了ラン。",
              "citation": {
                "source": "十年振",
                "author": "一名京都紀行",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽ今ノ兵ヲ説ク者コノ篇ノ晩出ヲ以テコレヲ軽ンズルコトナクンバ則可ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "不肖｜此クノ如クンバ子ナキニ如カズト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "二字ヲ辱ムルナクンバ可也（妙才ハ夏侯淵ノ字）　とあった。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
