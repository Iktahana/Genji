    "definitions": [
      {
        "index": 1,
        "gloss": "to ration out and survive on (some food)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎月の給料では家族を食い繋ぐのが精一杯だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "少ないお金を工夫して食い繋ぐしかない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "小売商として細々と食い繋いできた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "どうしても、それまで食いつなぐことも出来んというのなら、わしに出来るだけのことはしよう……』ってね。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人の秘密など、剖かぬこと剖かぬこと」「そうともそうとも」と合い槌を打ったのは、山口という武士で、「その日その日を食いつなぐだけでも大わらわの我ら、他人の秘密事など、どうでもよかよか。",
              "citation": {
                "source": "血曼陀羅紙帳武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君自身のもっと高い緯度の地帯を探険したまえ――もし必要なら、食いつなぐべき保存食肉を船につんで、そして目印しに空罐を山と積みたまえ。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなことよりも、とにかく食いつなぐことの方が焦眉の急を告げているというわけ。",
              "citation": {
                "source": "猿の図",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "参右衛門たちには食べる米がないので、自分の家の収穫時まで喰いつなぐ米を、早米の田を持つ家の稲を刈り、そしてそこから借りるのだとの事である。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間を喰いつなぐ米塩の用意であった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで王者のような態度だわ」「ああして友人のところを廻って食いつなげる間はねえ」と鄭は多少軽蔑的に言ったが、私がそれに不服そうなのを見て、「でも偉いですよ、あの男は。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to eke out a living",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その家族は少ない給料で毎日をやっと食い繋いでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "古米を食い繋ぎながら新米の収穫を待った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼は何度も仕事を変えながら食い繋いできた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
