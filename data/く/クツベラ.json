          "literary": [
            {
              "text": "ゲートルは暗闇の中でもすぐ捲けるが、手拭とか靴篦とかいふ細かなもので正三は鳥渡手間どることがある。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "蚊取線香、靴篦、歯ブラシ、征露丸、梅肉エキス、蚤とり粉、毛筆、紙挟み、殆ど使用に堪へさうもない安全剃刀、パイプなど畳一杯に展げられてゐたが、ゲートル、帽子、雑嚢などになると、一層奇妙なものが多かつた。",
              "citation": {
                "source": "小さな村",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ナニ云ってんのさ、この人は」「この靴ベラをみろ。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            }
          ]
        }
