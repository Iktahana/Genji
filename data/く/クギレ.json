          "literary": [
            {
              "text": "」　亨一は此話の間に屡々｜喙を※さまうとしたがやつと女の詞の句切れを見出した。",
              "citation": {
                "source": "計画",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　亨一は此話の間に屡々｜喙を挿さまうとしたがやつと女の詞の句切れを見出した。",
              "citation": {
                "source": "計畫",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "外の三四人が句切れ句切れに囃子を入れて居る。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "句切れ句切れの頭の字を拾い集めると『はしかかるい』となっておるだけの袁許禁厭じゃ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの松倉さんに遣った歌の句切れ句切れの一字一字拾い集めるとのにしはるとなっとる。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "一句切れ、一句切れ毎に皆の言葉がはさまった。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "年寄達は一句切れ、一句切れ毎に、「南無阿弥陀仏」を繰りかえした。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
