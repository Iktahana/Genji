        "examples": {
          "standard": [
            {
              "text": "悩み事を抱えているのか、電話越しに聞こえる彼女の曇り声がとても気にかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "風邪気味で鼻が詰まっているため、どうしても曇り声になってしまい聞き取りづらい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "敗戦直後の監督の曇り声からは、選手たちを責めることができない苦渋の決断が滲み出ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「謹さん、」　というも曇り声に、「も、貴下、どうして、そんなに、優くいって下さるんですよ。",
              "citation": {
                "source": "女客",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "半泣きの曇り声を張上げて念仏を初めた。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
