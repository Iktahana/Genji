        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "絵を描かしても、うまい、ただし、それはデッサンやクロッキイやスケッチにかぎられた。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしては、デッサンやクロッキイに舞いもどってくる。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのデッサンやクロッキイを見ていると、この男が本腰をすえてタブロウを描いたら、どんな良い画ができるだろうと思わせる。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりデッサンやクロッキイを描いてさえおれば彼は或る種の画家であり、かつ画家としての自尊心は保たれ得るのであった。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
