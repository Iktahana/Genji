[
  {
    "uuid": "31fde267-b3d8-5f65-8a65-498744274099",
    "entry": "食い荒らす",
    "reading": {
      "primary": "くいあらす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
      ],
      "ctype": null,
