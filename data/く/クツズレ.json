        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「靴擦れで足が痛え――」ひょいと踞み乍ら力任せに為吉は刑事の脚を浚った。",
              "citation": {
                "source": "上海された男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "靴擦れだよ、ただの。",
              "citation": {
                "source": "富士はおまけ（ラヂオ・ドラマ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "女　　ただでない靴擦れだつたら、どうする？",
              "citation": {
                "source": "富士はおまけ（ラヂオ・ドラマ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に左右の踵に処々靴ズレが出来たらしくヒリヒリと痛みだしたのを感じた。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
