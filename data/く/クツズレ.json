        "examples": {
          "standard": [
            {
              "text": "新しい靴で長時間歩いたら、靴ずれができて痛かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "新しい革靴を履いて歩き回ったら、かかとに靴ずれができてひりひりと痛んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "靴ずれの痛みをこらえながら、式典の会場をひたすら歩き続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "すると靴ずれの音がして私が出て行くのを早くも待つ人がいた。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人か二人かわからないが、多分一人らしく靴ずれが次第に感情を交えてざくざく聴えて来た。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母さんはくたびれたなんて言わないけど、すぐくつずれをこしらえるんだよ。",
              "citation": {
                "source": "火の扉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
