        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "第二ノ理由ハ在郷軍人團ナル好適ノ機關ナク、今ノ植民政策的頭腦ノ總督府等ニ此ノ大任ニ當ラシムルハ明白ニ不正不義ヲ殘シテ改造ノ精神ヲ傷クルノミナラズ、或ハ意外ノ變ヲ招クベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯ル唾棄スベキ思想ガ上級將士ヲ支配スルトキ、其ノ國ノ徃クベキ唯一ノ途ハ革命カ亡國カナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "勞兵會ヲ作ラシムベキ宮廷ノ權臣ト腐敗將校トハ、實ニ日本ニ「レニン」ノ宣傳ヲ導クベキ内應者ナリト云フベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見兩立スベカラザルカノ如キ此等ガ、其實如何ニ日米兩國ヲ同盟的提携ニ導クベキ天ノ計ラヒナルカノ如キ妙諦ハ今是レヲ云フノ「時」ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ貴局ニ驚クベキ報道ヲセムトス。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ驚クベキコトハ、彼等ノ中ニハ西洋人多ク混ジ居ルヲ認メタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、有材ノ公卿諸侯及ビ天下ノ人材ヲ顧問ニ備ヘ官爵ヲ賜ヒ、宜シク従来有名無実ノ官ヲ除クベキ事。",
              "citation": {
                "source": "船中八策",
                "author": "慶応三年六月十五日",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、金銀物貨宜シク外国ト平均ノ法ヲ設クベキ事。",
              "citation": {
                "source": "船中八策",
                "author": "慶応三年六月十五日",
                "note": "青空文庫"
              }
            },
            {
              "text": "「勇気ノ盛ンナルコト、忍耐力ノ強キコト、感情ヲ抑制スルノ力ハ驚クベキモノアリ」　これは考えものだ……ことに今日のような頽廃を極めた時代を、かえって諷誡しているような文字とも思われるが、しかし、よく考えてみると、古来、日本武人の一面には、たしかにこの種の美徳が存在していた。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレマタ愛シテ聴クベキナリ。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ方今英｜夷ヲ防グノ術火攻ヲ除イテハ則チ手ヲ措クベキナシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "篷ノ避クベキモノナシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
