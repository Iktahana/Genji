      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私は、くにゃくにゃと、どやしつけてやりたいほど不潔な、醜女の媚態を以て立ち上り、とっさのうちに考えた。",
              "citation": {
                "source": "善蔵を思う",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の意味も無く、こんな派手ともなんとも形容の出来ない着物を着て、からだを、くにゃくにゃさせて歩いていたのかと思えば、私は顔を覆って呻吟するばかりである。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "手では短い、その、くにゃくにゃとした脚を片股もぎとって、美婦がった鼻へくッつけされ、さぞよかろ。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、へやにはまゆげの跡の青いくにゃくにゃとした若い男が汗みどろになって、せっせと荷造りを急いでいるさいちゅうでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、まだ脚がくにゃくにゃ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのう（十日）は一時間半ほどしか眠らないで体がくにゃくにゃだったけれども、御心配だといけないと思って大苦心をして、田端まで歩いて行きましたところそちらもお休みでした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "五年計画で電力（＝水仕かけの滝を見せ）、石炭（＝焔色の男がとび廻る）、石油を見せたはよいが、五年計画は何で表現されるかと思うと、何だかいやに神秘的な色のヴェールをひるがえして、さながらニムフの如き女が五人で、極めて非生産作業的なくにゃくにゃ踊りをするのだ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "御落胤はすっかり眼をくぼませ、ふらふらと、骨の抜けたような歩き方で出て来て、くにゃくにゃとそこへ坐ったのである。",
              "citation": {
                "source": "長屋天一坊",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "膝が蝋みたいにくにゃくにゃになり、頭が大砲の弾丸よりも重くなってくる、あの罰。",
              "citation": {
                "source": "秘密礼拜式",
                "author": "アルジャナン・ブラックウッド",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
