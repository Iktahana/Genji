    "definitions": [
      {
        "index": 1,
        "gloss": "(the impression of being) soft and flexible",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
