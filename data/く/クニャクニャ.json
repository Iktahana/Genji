        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "赤ちゃんの指はクニャクニャしていて、とても可愛い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "熱で溶けたプラスチックがクニャクニャになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長時間座っていたので、足がクニャクニャして立てない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "クニャクニャになって詰まらん」　と云って門弟連中を絶倒させた。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、いうと、おだやかでないが、陰気で、しなやかに撓む、クニャクニャした気象の女だったら、どうか我慢も出来たであろうが、お八重さんが、サックリした短所も長所も、江戸ッ子丸出しの気性だったのだから、その嫁と姑のやっさもっさが、何処やら、今から見ると時代ばなれがしている。",
              "citation": {
                "source": "鬼眼鏡と鉄屑ぶとり",
                "author": "続旧聞日本橋・その三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人は酔っぱらっているんじゃないかと思う程クニャクニャした躯つきをしていた。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此人は酔っぱらっているんじゃないかと思う程クニャクニャしていた、でも人の良さそうな坊ちゃんだが。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間はあんなに身体が透きとおるなんてことがないし、それから身体がクニャクニャで大きくなったり小さくなったり出来るものか。",
              "citation": {
                "source": "崩れる鬼影",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「玄関で、しょんぼりしているわ」　ドアにつかまって、クニャクニャと身体をくねらせながら、「あんたって、部屋にいたためしがないんですもの。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブロッティングが古くてクニャクニャ、おやおやこんなにすれてしまって。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
