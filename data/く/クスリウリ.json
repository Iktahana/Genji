        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔の日本の農村部では、薬売りが人々の健康を支える重要な役割を担っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、古文書に描かれた薬売りの姿に興味を持った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "旅の途中で出会った薬売りから、珍しい薬草を購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "子供らはこの薬売りの人間を「ホンケ」と呼んでいた。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オーセ」は「ちょうだい」という意味であるが、ここの「ホンケ」はこの薬売り自身をさすのではなくて、薬売りの配って歩く広告のビラ紙のことである。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人間の「本家」がまき歩くビラの「ホンケ」は、鼻紙を八つ切りにしたのに粗末な木版で赤く印刷したものであったが、その木版の絵がやはり蝙蝠傘をさして尻端折った薬売りの「ホンケ」の姿を写したものであった。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "部落といっても、見すぼらしい蒲鉾小舎が、四ツ五ツ固まっているきりであったが、それでも郵便や為替も来るし、越中富山の薬売りも立ち寄る。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、兎には違ひありませんが、私は男の薬売りです。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなとき両者を比較して多少の興を覚えるように案配したわけである、などと、これではまるで大道の薬売りの口上にまさる露骨な広告だ。",
              "citation": {
                "source": "鉄面皮",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見たところ、御料林を見分に来た県庁のお役人か、悪くいえば地方行商の薬売りか、まずそんなところであろうと重兵衛はひそかに値踏みをした。",
              "citation": {
                "source": "木曽の旅人",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "11越中富山の薬売りおはぐろとんぼがついとでて白いカウモリ傘の柄にとまりまた日まわりの葉にとまりついととんではまたもどる。",
              "citation": {
                "source": "どんたく",
                "author": "絵入り小唄集",
                "note": "青空文庫"
              }
            },
            {
              "text": "安重根　（子供に）小父ちゃんは薬売りじゃないよ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬売り　（鞄から蛇の頭を覗かせて）そうら！",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "群集はかすかに興味を示して、薬売りの周囲へ集まって行く。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬売り　なに、蛇なんざあ珍しくねえ？",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬売りは腕を組んで、首を捻って考え込む態をする。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "群集はすっかり安重根に背中を向けて、薬売りを取りまいて熱心に聴き入っている。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "内地人の薬売り――新植民地情景。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "これら三つの戦争は、そのときどきの英雄大将を生みつつ一方では日本の街頭に廃兵の薬売りの姿を現出し、一将功なって万骨枯る、の思いを与えた。",
              "citation": {
                "source": "平和への荷役",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺した方がよい」「さては薬売りは悪人だったと見える」「悪魔の手下でございます」「魔王は誰だ？",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「脱疽のために左の腕が、肩から千切れた薬売り！",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "愚老が手に掛けた薬売り！",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲州弁にございました」「甘糟の逢った薬売りは、片足なかったということだ」「脱疽でござる。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "脱疽に相違ない」「さては薬売りは多人数と見える」「日本国津々浦々へ行き渡っていることでござろうよ」「欲しいものだ、是非欲しい。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも知らぬ薬売りは城下の方へ歩いて行った。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてそいつを水へ入れると、ポンと天井へ飛び上がりますそうで」　――つまりこういう経験が、その過去においてあったところから、そこでこの日「五臓丸」という薬売りの呼び声を耳にするや、すぐ一粒を需めたのであった。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイチニの薬売りになつて手風琴をならして歩いた。",
              "citation": {
                "source": "反逆の呂律",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "心を定めてよく見直すと、品の好い老女で、糸を繰る手はやめなかったが、振返って薬売りを流し眼に見て「返してやるのではないが、お前に言便次をしてもらいたいから、助けてあげる。",
              "citation": {
                "source": "糸繰沼",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と頼まれたかと思うと、おばあさんの姿も、糸車の音も消えて、薬売りは人の助けに生返ったのでした。",
              "citation": {
                "source": "糸繰沼",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "無言っていろと口をかためられたのですから、薬売りは一人で気味｜悪るがりながら、その家が誠にはないようと祈ったり、そんな馬鹿馬鹿しいことがありようはないと思ったりして、それでも「池の主になっているから、姿をかくしたが安心してくれ。",
              "citation": {
                "source": "糸繰沼",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬売りは顫えあがったそうで、兎に角主人にあって、その顛末を語りますと、主人のいわれるには、思い当ることがあるというのです。",
              "citation": {
                "source": "糸繰沼",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで水の底で助けて帰されたことを、薬売りが咄しますと、主人も驚いたには違いありませんが、その御主人の言葉に「毎年秋祭りの前後に、はげしい山おろしが吹荒れると、中妻のおばあさんが来たということを、里の者は何の訳か言いつたえている。",
              "citation": {
                "source": "糸繰沼",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴客には限りませず、薬売の衆、行者、巡礼、この村里の人たちにも、お間に合うものがござんして、そのお代をと云う方には、誰方にも、お談話を一条ずつ伺います。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
