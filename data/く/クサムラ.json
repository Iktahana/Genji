[
  {
    "uuid": "039b696a-2848-5003-94e5-b9abce7468be",
    "entry": "草むら",
    "reading": {
      "primary": "くさむら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
