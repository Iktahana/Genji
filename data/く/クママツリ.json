    "definitions": [
      {
        "index": 1,
        "gloss": "Ainu bear-sacrifice festival",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "アイヌの伝統儀式である熊祭りは、神の化身であるクマの魂を天に送る神聖な行事だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "博物館で上映された熊祭りの記録映像を見て、その厳格な作法と精神世界に圧倒された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "熊祭りの際に歌われる独特のリズムの歌声が、静かな山間に響き渡る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それはモクチャランケ宅の熊祭りであった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「熊祭りを本日に延期したのは何故であるか」「雨のためであろう――」と堀は自分の通訳に答えさせた、「そういうことは土人どもの自由で、本官のあずかり知るところではない」　すると彼はまたこう云わせた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを我々が考へて行きますと、例へばあいぬの熊を殺して祭る熊祭りがあります。",
              "citation": {
                "source": "真間・蘆屋の昔がたり",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊祭りのときに、アイヌは神前に一瓶の酒を供える。",
              "citation": {
                "source": "香熊",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、毎年盛んなる熊祭りを行うことは、なんぴとも聞いている。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてまた旭川でアイヌの熊祭を観、札幌に淹留し、函館より海を越えて当別のトラピスト修道院を訪ねた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　アイヌの熊祭と捕獲物供養　北海道のアイヌは今もしばしば熊祭という事を行っている。",
              "citation": {
                "source": "奥羽地方のシシ踊りと鹿供養",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊の幼児を捕獲してこれを飼育し、二歳位に達したならば、適当の時を選んで、所謂熊祭を挙行するのである。",
              "citation": {
                "source": "奥羽地方のシシ踊りと鹿供養",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも熊祭やユーカラの話を英語でやるのだから、多分通じなかったことだろうと思う。",
              "citation": {
                "source": "北国の春",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊祭のような山間の行事の中に在ってさえも、かつては海の民であった彼等の面影がうかがわれるのであります。",
              "citation": {
                "source": "言語と文化史",
                "author": "――アイヌ文化の探究にあたりて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、それを述べる前に、熊祭とは一体、何であったか、ということについて、ちよっと触れておきたいと思います。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでその季節の初めに、盛大な祭を行って、山の神に山の幸を授けてくれるように祈るのが、この熊祭の本来の意義だったのであります。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、冬になって山入りの時が近づくと、あらかじめ猟運を確保するためにいわゆる幸先を祝って、熊祭なるものを行ったのでありますが、その際、前に述べたような仮装舞踊劇が演じられたのであります。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの神謡や散文の物語に数多く接していると、熊祭の行事の一つ一つがどのような観念のもとに行われるか、ということを内側からまざまざと見ることが出来るのであります。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "（三）例えば、熊祭の際には、彼は壁際の衣桁から熊の皮を取り下して身につけます。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお、日高の静内地方の熊祭に於て、“ヘペレ・アイヌ”（heper-aynu 熊の子である人間）という奇異な行事が行われておりました。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの行事や遊戯は、前に述べたマイタケをとる際の呪術的演劇と共に、かつて熊祭の際にシャーマンによって演じられた仮装舞踊劇の名残りと見られるものなのであります。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウポポといふのは熊祭の際などに唄はれるものであつて、近文などでは立つて手拍子を取りながら唄はれるものをもさう云つてゐるけれども、幌別では立つて踊に合はせて唄ふものは踊そのものと共にリムセと云ひ、ウポポは普通屋内で広間の一隅に婦人のみが坐って円陣を作り、行器の蓋などを叩きながら唄ふものとしてある。",
              "citation": {
                "source": "アイヌ族の俚謡",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
