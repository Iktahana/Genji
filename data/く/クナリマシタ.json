          "literary": [
            {
              "text": "海デ沢山遊ビ黒クナリマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「北海道ハ秋モ晩クナリマシタ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カヘルサンハ生レツキ色ガ青カツタノデスガ、コノ時バカリハ赤クナリマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オユデ、ウダツタノデ、ジヤガイモサンハイロガマツシロニナツテ、イゼンヨリモ、ウツクシクナリマシタノデ、ミンナオホヨロコビ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラトイフモノ、モンコチヤンハボンコチヤンヲケツシテカブラナクナリマシタカラ、オ父サント、オ母サント、オ姉サントオ兄サンハモンコチヤンニカウイヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ家ヲトビダシテ、アツチコツチヲアルキマシタケレドモ、ツカレテ、ダンダンネムクナリマシタノデ、自転車ニノツテ、ホテルヘユキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンノクシヤミハモツトモツトヒドクナリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチ、カメコオバサンモ　トロトロト　マブタガ　オモクナリマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
