        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "＊２クラースヌイの戦いか、＊３ライプツィッヒの戦いで、片手と片足を失ったんです。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊２　クラースヌイ　スモレンスク県下の町。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラースヌイ・マークを一時間も見てから（昇さん一人）ステーションへ来る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "これから、クラースヌイ・コルプスの家を見にゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、馬車でズッと河岸を廻り、クラースヌイ・プロシチャージへ抜け見物した。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸に居て彼の職業をして居たのじゃやりきれないが、北海道の漁夫なら十六時間位ヘデもないさ、そういう奴の手紙を開けて見るとネ云々、十一月八日（木曜）　クラースヌイ・コルプスの部屋を見にゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、クラースヌイ・コルプスへ行くことにするとて二人で出かけ、自分そとで待って居た。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日彼女、クラースヌイ・コルプスにかえるなり。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、頻りに食事その他満足せず、クッションを持って行った自分にくっついて Остоженка（クラースヌイ）へ来てしまった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラースヌイ・コルプスへ。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラースヌイ・コルプスは、住人、胡瓜の大小に頓着しては居ないのだ。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「労働者の、文学に対する師匠的役割」の決議には、モスクワの自動車工場「アモ」、電気工場「ディナモ」「赤色プロレタリー」その他ハリコフの「鎌と鎚工場」、レーニングラードの「クラースヌイ・プチロヴェーツ」などが参加した。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
