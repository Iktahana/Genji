        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の口利きは聴衆を魅了した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "政治家としての口利きが彼の強みだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "口利きの上手な弁論家だ。",
              "citation": {
