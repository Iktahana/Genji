          "standard": [
            {
              "text": "地方の方言的な口利きがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "あの地域特有の口利きが聞こえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "口利きから出身地がわかることがある。",
              "citation": {
