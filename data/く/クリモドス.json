        "examples": {
          "standard": [
            {
              "text": "図書館で借りた本を元の棚に繰り戻す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "時計の針をゆっくりと繰り戻し、過去を懐かしんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "一度預けたお金を、再び自分の口座に繰り戻す手続きをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "婿君のふみながら、衣絵さんの心を伝へた巻紙を、繰戻すさへ、さら／＼と、緑なす黒髪の枕に乱るゝ音を感じて、取る手の冷いまで血を寒くしながらも、園は、謹で其の意を体したのである。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに不幸にして男性の素振に己れを嫌忌するの状あるを見ば、嫉妬も萌すなり、廻り気も起るなり、恨み苦みも生ずるなり、男性の自ら繰戻すにあらざれば、真誠の愛情或は外れて意外の事あるに至る可し。",
              "citation": {
                "source": "厭世詩家と女性",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇將かくてアレースに疵を負はして肉破り、槍を手許に繰りもどす、其時強きアレースの叫ぶ音聲譬ふれば九千或は一萬の　860軍勢ともに同音に戰場中に叫ぶごと、トロイア及びアカイアの兩軍ひとしくこれを聞き、恐怖に震ふ、アレースの叫喚かくも凄かりき。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
