          "literary": [
            {
              "text": "愛宕山程の石段が四段程も附いて居て、此処を降りれば帰りは十息かそこらの間にクリツシイの通へ出られるのである。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "急に明るいクリツシイ通に出て行きつけの珈琲店へ入つて行くことも思つて見た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　斯う云つて、クリツシイ街の方へ金糸の光る手提を手にしながら行つて仕舞つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
