  {
    "uuid": "2a0ce7f0-7f42-52ce-af8f-6c78fa8a7b7c",
    "entry": "クグ",
    "reading": {
      "primary": "くぐ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
