    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ただし、クグは鎌倉時代以後、漸次キ・ケ・ギ・ゲに変じて消失した。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからだんだんまはって行って、その時は丁度十時頃でしたが、一つの標本室へ入って行きましたら、三人の教師たちが、一つの顕微鏡を囲んで、しきりにかはるがはるのぞいたり色素をデックグラスに注いだりしてゐました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "青いリトマス液が新らしいデックグラスに注がれました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は泳ぐように手を前へ出してその車の後を追ったが、バックグラスに透けて見えたのは僅かに乗客のソフト帽だけだった。",
              "citation": {
                "source": "越年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたバックグラウンドを持ち、さらには中途入社という経験を持つ渡辺は、堅い一方という日電マンのイメージからはかなりはずれたところがある。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで「あなた自身はどのようなバックグラウンドを持っているのか」と問うと、「これまでは企業のデータ処理部門でメインフレームのおもりをしてきたのだけれど、将来は必ずパーソナルレベルでコンピューターが使われるようになると思って、ここの店長になった」のだという。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "送信前のデータ圧縮時には他の仕事を受け付けないが、一応バックグラウンドで送受信可能である。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにこれらをバックグラウンドで処理してくれるという寸法である。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "神神の祖先（アイヌ語）老いしアイヌの歌アイヌはよ、老いしアイヌ、神アヱオイナ、アイヌ・ラクグル（アイヌの臭ひある人）の後、神ながらの頭、土の体、柳の脊骨、シネ・シツキ・プイコロクル（眼窩の人）神神の髪の毛の人、彼こそはげに、カムイ・オトプ・ウシユ・グルなれ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "神アヱオイナ、アイヌ・ラクグル（アイヌの臭ひある人）の後、神ながらの頭、土の体、柳の背骨、シネ・シツキ・プイコロクル（眼窩の人）神々の髪の毛の人。",
              "citation": {
                "source": "篁",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「喧嘩口論、悪人成敗、命ノヤリトリ、白刄クグリ、ヨロズ退屈凌ギトナルベキ荒事ナラバ何ナリトモ御相談ニ応ズベク候間、遠慮ノウ当館ヘ申出デ可然候。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダークグレイの背景に白ヌキで、KWTS PRESENTS の文字がフェイドインしてくる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なあ、ロックンロールだけだと思わないか」　広岡のあいまいな表現も、バックグラウンドを共有する慶一には、注釈なしで理解できた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコ新美南吉　タケノコハ　ハジメ　ヂビタノ　シタニ　ヰテ、アツチ　コツチヘ　クグツテ　イク　モノデ　アリマス。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　テフテフハ、キノハノ　アヒダヲ　クグツテ　ソラ　タカク　トンデ　イキマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "独り離れてゐて、女は胸の奥深い処から、音楽家の肖像を取り出して、目の前の闇をバツクグラウンドにして、空中に画いてゐる。",
              "citation": {
                "source": "クサンチス",
                "author": "XANTHIS",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもわかりますが、それかと云ってこの二人は有島の破滅のバックグラウンドを十分鮮明にしているのでもありません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　女は前後を見まわして人の姿がないのを見とどけると、門のクグリ戸をあけて左近を先に押しこんだ。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなた方、門のクグリ戸をあけて入ってきましたね」「当り前だ」「クグリ戸があいたんですね」「あかなければ入れない」「してみると、女は逃げましたね。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクらがクグリ戸から入ったとき、女はカンヌキをかけたんですから。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かで見たようだと思ったが、見定めるヒマもなく女はクグリ戸から消えこんでしまった。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが私が門前にいたとき、緑の高級車が横づけになって美しい女の人がクグリ戸をあけて邸内へ消えたのよ。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、それもあるかも知れないが、しかしだね、彼女がクグリ戸にかけたカンヌキが外れていて一同がそこから悠々乱入したのはどういうわけだろう。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "三枝子は各部屋の雨戸をしめ、門もしめてクグリ戸だけカンヌキをかけないでおいた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて三枝子が頼まれたことを果して戻ってくると、当吉はフトンのフタをあけずに、クグリ戸のカンヌキはかけずにおいたかと確かめたし、ラクは机上の燭台のことと枕元の水のことを確かめ、由也はまだ戻らないことも確かめた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関の戸締りもしてなかったし、クグリ戸のカンヌキもおりていないのは泥酔のせいであろう。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏のクグリから屋内へはいると、タタミ、否、ムシロをしいた部屋は一間しかない。",
              "citation": {
                "source": "桂馬の幻想",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちクグツは蟆人の義ではなかろうかというのである（五巻一号二二頁―二三頁）。",
              "citation": {
                "source": "くぐつ名義考",
                "author": "古代社会組織の研究",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
