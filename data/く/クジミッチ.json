          "literary": [
            {
              "text": "「叔母がその……私に申しますには、何でも亡くなられたステパン・クジミッチの御遺言書とかが、その……。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ステパン・クジミッチの遺言の中に、その何です、贈与契約書とかがあつて……それが、この私に……。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "フョードルは名、クジミッチは父称といって、父親の名に特定の語尾をつけて、自分の名と併用するものである。",
              "citation": {
                "source": "身体検査",
                "author": "ソログーブ・フョードル",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
