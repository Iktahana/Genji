        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "温かい出汁で葛掛けにした魚は、上品な味わいだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "葛掛けのあんかけ料理は、体を温めるのにぴったり。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "料亭で食べた葛掛けの料理は、見た目も美しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "オヤまだ何か出ますか、ナニ蜜柑の葛掛、これは妙ですな。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日私は余所で南瓜の葛掛を戴いた事がありますがそれはどう致します」お登和嬢「あれは南瓜の皮を剥いて蒸して別に煮汁へ葛を引いてかけたのです。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚のロースの葛掛や粉海老の海参じゃあんまり平凡だ。",
              "citation": {
                "source": "幸福な家庭",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "わらさの照焼はとにかくとして、ふっと煙の立つ厚焼の玉子に、椀が真白な半ぺんの葛かけ。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鱒の塩やき、小蝦のフライ、玉子焼、鱒と芙萸の葛かけの椀。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
