        "examples": {
          "standard": [
            {
              "text": "彼女は病気の家族の世話をするため、仕事のシフトを繰り合わせてもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "忙しい友人たちと会うために、週末に集まる時間をなんとか繰り合わせました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "教授は、私たちが理解できるよう、追加のオフィスアワーを繰り合わせることを約束してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "店の方は繰り合せるから、今月中機嫌好く遊んで、来月から魂を入れ替えるさ」　と父親も改めて快諾を与えた。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この二つの情報をつづくり合せると、沼間夫人がどういう目的でこのホテルへやって来たか誰にもすぐ了解された。",
              "citation": {
                "source": "キャラコさん",
                "author": "社交室",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
