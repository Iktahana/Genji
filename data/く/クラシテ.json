          "literary": [
            {
              "text": "ラツパ新美南吉　オヂイサンハ　イナカニ　ヒトリボツチデ　クラシテ　ヰマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクタチ兄ダイハ、ナカヨク、タッシャニ、コノシマニ、クラシテイマス。",
              "citation": {
                "source": "瓶詰地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネコノオバアサンハ、マイニチ、コンナフウニクラシテヰマス。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　ミナサンモ　ゴランニナルヤウニ　カメサンハ　ミンナ　イマダニ　ハダカデ　クラシテイルト　イフワケデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゼガ　ホヲフクラシテ、フネハ　ナミヲ　　　タテテハシリマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            }
          ]
