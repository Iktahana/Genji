        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "口先のうまいセールスマンに言いくるめられ、不要な商品を買ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼は口先のうまい政治家として有名だったが、実績は乏しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「口先のうまい人間には気をつけろ」と父に何度も言い聞かされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "これなどまだ小心で正直な方だが口先のうまい奴は、これまでの取りつけの米屋に従来儲けさしているんだからということを笠にきて外米入らずを持って来させる。",
              "citation": {
                "source": "外米と農民",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に叔父の口先のうまいのにいつも感心させられた。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この男は、きわめて口先のうまい、他人の気をそらさぬので、みんなからりこう者の与助といわれていました。",
              "citation": {
                "source": "おおかみと人",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
