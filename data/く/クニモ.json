          "literary": [
            {
              "text": "よしや古人の苦心なぞ理解し得ずとも、習った通りに演じておりさえすれば、トニモカクニモおまんまが喰って行けるのである。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ私ハ近ゴロ原稿ヲ書クニモ手紙ヲシタタメルニモヒラガナトイウモノヲ使ツタコトガナイ、ソレハナゼカトイウニ、我々仰臥シタママデモノヲ書クモノニトツテハ些細ナ力ノ消費モ大キナ問題トナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハツマリ、構成ガ単純デ、劃ガ少ナク線ガ直線的デカツ規則的ナタメ、書クニモ読ムニモマチガウ機会ガ少ナイコトヲ意味スル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヽル文字ハ後世古文ヲ書クニモ使用セズ、必ズ何人ト明記ベキ所ト思ハル。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
