          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供と一緒にクリスマスツリーを飾り付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "街の広場には巨大なクリスマスツリーが設置されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "クリスマスツリーの電飾がキラキラと輝いていて美しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "世界で一番ベルリンがクリスマスツリーを、氾濫させるのだそうです。",
              "citation": {
                "source": "伯林の降誕祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえ、こんなきたない、古ぼけたクリスマスツリーに、まだこんなものがついてたよ！",
              "citation": {
                "source": "モミの木",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、今度は、たとえようもないほど美しいクリスマスツリーの下に、すわっているのでした。",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきの、あったかいストーブや、おいしそうな焼きガチョウや、それから、あの大きくて、すてきなクリスマスツリーみたいに！",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女はきれいなクリスマスツリーの下に座っていたのです。",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "THE LITTLE MATCH-SELLER",
                "note": "青空文庫"
              }
            },
            {
              "text": "あったかいストーブや、ガチョウの丸焼き、大きくてきれいなクリスマスツリーみたいに、パッと消えちゃうんでしょ……」少女はマッチの束を全部だして、残らずマッチに火をつけました。",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "THE LITTLE MATCH-SELLER",
                "note": "青空文庫"
              }
            },
            {
              "text": "その小松は、何處からか光を受けてるらしく、丁度銀モールで飾られたクリスマスツリーのやうに、枝々が光榮にみちてぐるりに輝いてゐた。",
              "citation": {
                "source": "日の光を浴びて",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "又も一つ困った事には、クリスマスの日には子供より大人の方が夢中になって、クリスマスツリーを飾ったり、クリスマスプレゼントを遣ったり貰ったりしますが、そのためによく子供の方がお留守になって、クリスマスの日になると、『うるさいからあっちへ行っていらっしゃい』なぞと叱られる事があります。",
              "citation": {
                "source": "雪の塔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "道路をはさんでデパートの伊勢丹と向かい合う派出所横で、クリスマスツリーに見せかけた爆弾がすさまじい音とともに炸裂。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "イス、テーブルをゴチャ／＼並べるとか、なんとか、たとえばだ、スキマというものが広さを感じさせるのだから、スキマというスキマへクリスマスツリーみたいな植木鉢をつめこむ」「ハア、ナルホド。",
              "citation": {
                "source": "ニューフェイス",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリスマスツリーを私共の部屋へ立てることにして、四人出かける。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリスマスツリーがきらきらしてて、夜ミサのおんがくがあって、みんな気もちよくにこにこしてたからこそ、ぼくのもらった、あのクリスマスプレゼントは、あんなふうに、きらきらかがやいていたんだ。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "目的は、クリスマスツリーに雪をかぶらすのではないが、とにかく面白い話である。",
              "citation": {
                "source": "雪を降らす話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしも　やることが　おわったら　きっと　もどってきて、　あんたさんの　こどもらに　ええ　クリスマスツリーを　とどけてやるぞい。",
              "citation": {
                "source": "ババールとサンタのおじさん",
                "author": "BABAR ET LE PERE NOEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は張切って枝のニョキニョキ出た奇妙なクリスマスツリーを描き，それを美しいオレンジ色と黄色にしました。",
              "citation": {
                "source": "“青い顔”",
                "author": "間所紗織",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝になってみると、くつ下の中にも、クリスマスツリーのところにも、プレゼントがない！",
              "citation": {
                "source": "サンタクロースがさらわれちゃった！",
                "author": "A KIDNAPPED SANTA CLAUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は医科大学生Ｆ兄弟の宅へ招ばれ、素晴らしく大きなクリスマス・ツリーの下で御馳走になり乍ら、医科大学の教室でつくるツリーへかける飾付けは、人間の心臓や肺、そのあらゆる人体諸臓器の形をボール紙で造らえて色彩をつけたものだという話など聞き夜を更かしました。",
              "citation": {
                "source": "伯林の降誕祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど、これはクリスマスの晩のことで、立派な家の窓から暖かそうな明りがさして、部屋のまん中には、大きなクリスマス・ツリーが立っていていい着物をきた子供たちは、部屋の中を飛廻っていました。",
              "citation": {
                "source": "街の子",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "お家も、クリスマス・ツリーも、御馳走も。",
              "citation": {
                "source": "街の子",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは三四郎が、臨時講師に出る前から可愛い春夫のために買い植えてやったクリスマス・ツリーであった。",
              "citation": {
                "source": "寒の夜晴れ",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその部屋に入った私が、まっ先に気づいたものは、部屋の片隅の小机の前に延べられた、クリスマス・ツリーの小さな主人の寝床だった。",
              "citation": {
                "source": "寒の夜晴れ",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人を見失ったクリスマス・ツリーの銀紙の星が、キラキラ光りながら折からの風に揺れ、廻りはじめていた。",
              "citation": {
                "source": "寒の夜晴れ",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎平から上ノ岳の小屋までも、クリスマス・ツリーの点在した気持のよい雪原だった。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この附近の木は皆すばらしいクリスマス・ツリーになっていた。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ははあ、クリスマス・ツリーだな。",
              "citation": {
                "source": "キリストのヨルカに召された少年",
                "author": "フョードル・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのクリスマス・ツリーには、あかりや、金紙や、りんごが、どっさりつるさがっていて、そのまわりは、人形やおもちゃの馬が、ぎっしり並べてある。",
              "citation": {
                "source": "キリストのヨルカに召された少年",
                "author": "フョードル・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、またそこにも、ガラスの向こうに部屋があって、やっぱりクリスマス・ツリーが立っている。",
              "citation": {
                "source": "キリストのヨルカに召された少年",
                "author": "フョードル・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたしのクリスマス・ツリーのところへ行こうよ、ねえ坊や。",
              "citation": {
                "source": "キリストのヨルカに召された少年",
                "author": "フョードル・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、なんというクリスマス・ツリーだろう。",
              "citation": {
                "source": "キリストのヨルカに召された少年",
                "author": "フョードル・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、これはもう、クリスマス・ツリーどころじゃない。",
              "citation": {
                "source": "キリストのヨルカに召された少年",
                "author": "フョードル・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
