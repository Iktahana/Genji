          "literary": [
            {
              "text": "心にもなき惡逆も主君の爲と思へる愚かさ、と口々に悔い悲しむ彼等は、今は片時もためらふべき、いざ主君の跡にすがれと叫ぶやひとしく頭を揃へて劒に伏した。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "美妻の最後の無惨さに、夫悔い悲しむ事限りなく、精神｜魍魎として家を迷い出で行方知れずなってしまった。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
