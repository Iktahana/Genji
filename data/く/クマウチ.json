          "literary": [
            {
              "text": "あれから、くま打ちにいかなかったかと、たずねましたから、猟師が、その後のことをすっかり打ち明けて物語ったのでした。",
              "citation": {
                "source": "猟師と薬屋の話",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "上原君は、熊撃ちをはじめてから未だ僅かに七年しかたっていない。",
              "citation": {
                "source": "熊狩名人",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この地方の山村には、信州側にも越後側にも幾人もの熊撃ちがいる。",
              "citation": {
                "source": "熊狩名人",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、熊撃ちをはじめた最初のころは、随分怖ろしくて、からだががたがたふるえたものです。",
              "citation": {
                "source": "熊狩名人",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
