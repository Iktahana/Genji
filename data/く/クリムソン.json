        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夕焼け空がクリムソンに染まり、息をのむほど美しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女はクリムソンのドレスを身につけ、パーティー会場でひときわ輝いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "クリムソンのバラが庭いっぱいに咲き誇り、甘い香りを漂わせている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そしてクリムソンレーキを水に薄く溶かしたよりもっと鮮明な光を持った鱗の色に吸いつけられて、思わずぼんやりと手の働きをやめてしまう。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "色素は芸術家が使うウルトラマリン、カルミンおよびクリムソン・レーキ；アントワープ・ブルー、クローム・イエロウおよびインディアン・インク；だけではなく、普通のペンキ屋が使う粗野な色素もあるていど混ぜ物処理をされている。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛び飛びに白の無地を交へて、クリムソン・レーキ、ウルトラマリン、ビリジヤン及びガムボージの各色を配した。",
              "citation": {
                "source": "「いろは」の五色ガラスについて",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽子はキング・クリムゾンの『太陽の戦慄※』をダビングしたテープを光江に貸した。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
