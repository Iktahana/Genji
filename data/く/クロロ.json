[
  {
    "uuid": "444435ab-60fb-5a97-8012-6ac19a1a68b9",
    "entry": "黒絽",
    "reading": {
      "primary": "くろろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
