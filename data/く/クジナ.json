        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "魂からの素町人のマヌケのイクジナシ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな情けないマヌケのイクジナシが私の兄だなんて、まッぴらよ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞記者という動物は、商売の時と酔っ払っている時のほかは、全然イクジナシですよ。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その三　精神病診断書",
                "note": "青空文庫"
              }
            },
            {
              "text": "オメサマみたいな慾タカリのイクジナシれも神様にしてくれるもんだ。",
              "citation": {
                "source": "淪落の青春",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オメサマ、敵のタマが尻ッペタから前の方へぬけたもんでは、恥なもんだガネ」「キサマ、主人を慾タカリのイクジナシと言ったな」「言うたもんだ。",
              "citation": {
                "source": "淪落の青春",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "岐阜県では山に属する北半分、信州でも主として北信の諸郡において、クジナといっているのがそれである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "男やもめとクジナの花は盛り過ぎれば御坊となる　この御坊は即ち坊主で、何人もすさめざる淋しい人のことであるが、この草の花が綿になって飛んだあと、あたかもがっそうのような頭になる点が似ていたのである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "クジナという名詞もまた飛び散って奥羽の処々に行われている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば宮城山形の二県の南半分でクジナまたはグジナ、九戸の葛巻附近ではクジッケァともいっている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "羽前も米沢あたりはタンポポに近い花の名が別にあって、嫩い葉を食料にする場合ばかり、クジナという語を用いるのである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分は北信などの臼唄と同様に、元はタンポポもクジナの花で通っていたのであろう。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち少なくともかつてある時代に、京都の上流の間にもクジナに近い語は認められていたのである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "信州でも山を越えて諏訪の湖岸に下ると、そこにはクジナもあるがそれよりもガンボウジの方がよく知られている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "クジナの行われている善光寺平などにも、やはりガンボジという名が知られているのを見ると、これは花の方をさしていたものらしい。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくにこれとクジナとの間には、最初から語原の関係はなかったようである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
