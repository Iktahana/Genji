          "literary": [
            {
              "text": "滿十五歳未滿ノ父母又ハ父ナキ兒童ハ、國家ノ兒童タル權利ニ於テ、一律ニ國家ノ養育及ビ教育ヲ受クベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ今日ノ日本語ハ特殊ノ研究者ニ取リテ焚語「ラテン」語ノ取扱ヲ受クベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "拓殖會社ノ土地ハ土地私有限度ニヨリテ一度國家ニ徴集スルト共ニ、朝鮮ニ在ル内鮮人ハ平等ノ權利ニ於テ其ノ分配ヲ受クベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "山行伐木ノ声、渓行水車ノ声｜並ニ遠ク聴クベシ。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛙声ノ枕ニ近クシテ喧聒ニ堪ヘザルガ如キモ、隔ツレバ則チ聴クベシ。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "秘密探偵の書綴る報告書は裁判所の速記録と同じくところ／″＼古めかしい漢文調の熟語、「二人ハ奇貨措クベシトナシ」なんど言ふ語句と、極めて卑俗な口語とが混用されてゐて、時には却つて筆者の面目を躍如たらしむる処に別種の面白味がある。",
              "citation": {
                "source": "来訪者",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "※々トシテ聴クベシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "序破急に甲音三｜声、揺韻をゆるくひいて初甲の音にかえる、勘助流陣貝吹き、「変アリ部ニツクベシ」のあいずである。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
