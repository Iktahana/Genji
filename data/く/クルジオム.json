        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ゴール人らはクルジオム（訳者注　エトルリアの昔の都）を渇望し、ローマはクルジオムを保護して、それが彼らに何の害を与えたかを尋ねる。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "クルジオム人らはわれらの隣人である。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝らはアルバを奪った、われらはクルジオムを奪うのだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "『汝らはクルジオムを奪ってはいけない。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
