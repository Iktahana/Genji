          "literary": [
            {
              "text": "カジヤハ　マツカニ　ヤケタ　カネカラ　クワヲ　ツクツテ　ヰマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナルホド、イママデ　キヅカズニ　ヰタガ、カナヅチハ　クワヲ　ツクル　コトガ　デキルノダナ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガレボシ新美南吉　フユノ　サムイ　サムイ　ヨフケ、ヒユーン　ヒユーント　コガラシノ　フク　オソラノ　上ノ　ハウデ　三ツ　ナランダ　コドモノ　ホシガ、ケンクワヲ　シマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トテ　トテ　トテ　ト　ミナ　ミナ　オキロ　モウ　アサダ、　トテ　トテ　トテ　ト　クワヲバ　モツテ　ハタニ　デロ、　トテ　トテ　トテ　ト　タネヲバ　マケヨ　ムギノ　タネ　トテ　トテ　トテ　ト　トテ　トテ　トテ　ト」ト　ヲトコハ　フイタノデ　アリマス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナツテ、人参サンハ　ジヤガイモサント、ケンクワヲシテヰルコトヲ思ヒ出シマシタガ、シカタナク、何度モ、ソノコトヲ話ニジヤガイモサンノオ家ノ入口マデ行ツテハ、「エエ、イマイマシイ、ボクノハウカラ、口ヲキイテヤルナンテコトハナイ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
