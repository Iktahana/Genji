          "standard": [
            {
              "text": "深い草薮の中に、野狐の巣穴があるらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "急な山道は草薮が茂っていて、足を踏み入れるのが困難だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "草薮をかき分けながら、ゆっくりと奥へ進んでいった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
