[
  {
    "uuid": "436d2a9d-ee23-542e-83eb-8d76a468c777",
    "entry": "口汚い",
    "reading": {
      "primary": "くちぎたない",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
