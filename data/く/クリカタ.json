        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "建物の軒の繰形を見ると、その時代の建築技法がわかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "繰形の技術を習得するには何年もの修行が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "柱の繰形が精密に彫られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "浮浪人はそのひっこんだ戸口へのそりのそりと入り込んで戸の鏡板でマッチを擦り、子供たちは踏段の上で店を張って遊び、学校の生徒は繰形でナイフの切味を験したりした。",
              "citation": {
                "source": "ジーキル博士とハイド氏の怪事件",
                "author": "THE STRANGE CASE OF DR. JEKYLL AND MR. HYDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上すべての繰形に金が塗ってあるからけばけばしい、重いバルコニーの迫持の間にあって、重り合った群集の顔は暗紅色の前に蒼ざめ、奥へひっこみ、ドミエ風に暗い。",
              "citation": {
                "source": "シナーニ書店のベンチ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "龍吉君は二階でごろりとして雑誌を読んでゐるので、子供をおくりかた／″＼外へ出る。",
              "citation": {
                "source": "五月六日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "女学校の方で使っていた古い校舎のつくりかたも、明治初年の洋風でなかなか風趣があった。",
              "citation": {
                "source": "女の学校",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "晶子が「歌のつくりかた」について語っている言葉には、明星派に流れ入った彼女自身の物語はあるが、明星派の芸術理論は、与謝野寛のもち場として、はっきり区分されている。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男に逢う前は、かならずこうした玄人っぽい地味なつくりかたをして、鏡の前で、冷酒を五｜勺ほどきゅうとあおる。",
              "citation": {
                "source": "晩菊",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "栗山が、わたしの事を、神様が皮肉なつくりかたをした女だと云つたけれど、わたしは、こんな処にじつとしていられない気持ちだつた。",
              "citation": {
                "source": "淪落",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男に逢ふ前は、かならずかうした玄人つぽい地味なつくりかたをして、鏡の前で、冷酒を五勺ほどきゆうとあふる。",
              "citation": {
                "source": "晩菊",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう真個に情のあふれた落着いて勇ましい励ましの歌が欲しいわねえ」　好子は、型紙のつくりかたをやっているところで、ハトロン紙の隅で計算をしては物指で作図をしている。",
              "citation": {
                "source": "二人いるとき",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○目下その「クラブのつくりかた」のパンフレットほんやく中。",
              "citation": {
                "source": "往復帖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "つくりかたの本を見ればいいわ。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "この本は、長崎で手に入れたオランダの築城書（城のつくりかたの本）だ。",
              "citation": {
                "source": "福沢諭吉",
                "author": "ペンは剣よりも強し",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ボクに、お菓子のつくりかたを教えて、ちょうだい。",
              "citation": {
                "source": "キャラコさん",
                "author": "月光曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨年の秋ごろ、ペール島からペラホの土人の女が逃げてきて、ラムのつくりかたをおしえた。",
              "citation": {
                "source": "ボニン島物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "）ところで、こんなステッキなんか、自分はつくりかたを知っている。",
              "citation": {
                "source": "城",
                "author": "DAS SCHLOSS",
                "note": "青空文庫"
              }
            },
            {
              "text": "本のつくりかた雑なのよ、ですからすこし悲しいのよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどいま、小人は長持の中から縫取のしてある胸着を取りだして、感心した顔つきでその古風なつくりかたを眺めています。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとは、錠前やぶりのどろぼうが、かんがえだしたのですが、明智探偵はそれのつくりかたを知っていて、助手の小林少年におしえておいたのです。",
              "citation": {
                "source": "超人ニコラ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、歯を総いれ歯にすれば、そのいれ歯のつくりかたで、口やほおの形を、どんなにでもかえることができます。",
              "citation": {
                "source": "超人ニコラ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時、時計塔の西洋館を見て、そのお城のような古風なつくりかたが、すっかり気にいってしまい、西洋館を買いとって、そこに住むことになったのです。",
              "citation": {
                "source": "塔上の奇術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その朝、小林少年がとじこめられたカブトムシの衣装とは、つくりかたがちがっていました。",
              "citation": {
                "source": "鉄塔の怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "懐中電灯でてらしてみると、石のコマイヌと思ったのは、ショーウィンドーにかざってあるマネキン（人形）と同じつくりかたの、はりこのコマイヌだったことがわかりました。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そのとき、明智は、この小部屋のつくりかたが、どうも、ふつうでないことに、やっと気がつきました。",
              "citation": {
                "source": "仮面の恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ロボットといえば、きょうのきみのロボットと、あの空へとんだロボットとは、つくりかたがちがうんだね。",
              "citation": {
                "source": "電人Ｍ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、身体を入れる左脇の引合口の方を背後にして、そこからはみ出した背中の瘤起を、幌骨の刳形の中に入れてある。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、鐘鳴器の鍵盤は、壁を刳形に切り抜いて、その中に収められてある。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "刳形へ手をかけて、つかつかと、前へ出ると、若者達は、二三歩退いた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "小太郎は刳形へ、手をかけて、親指で、鯉口を切った。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「小冠者っ」　天童は、刳形へ手をかけて、ずっと、鞘ぐるみ刀を――丁度、柄頭が、自分の眼の高さに行くまでに延した。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに、見事な細工の羽目板や浮き出し刳形には跡が付けられ、切り刻まれ、彫り込まれ、あるいは安っぽい壁紙で覆われていた。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
