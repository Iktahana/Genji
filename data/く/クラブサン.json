        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の演奏するクラブサンは、まるでバロック時代にタイムスリップしたようだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "クラブサンの音色は、ピアノとはまた違った魅力がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は古いクラブサンを修理して、再び美しい音を奏でた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "乙女は頭傾け白き指先運ばせて深き思ひにくれつゝもクラブサン奏ではじめぬ。",
              "citation": {
                "source": "偏奇館吟草",
                "author": "永井壮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の夜に細き指先運ばせてかなでし象牙のクラブサン。",
              "citation": {
                "source": "偏奇館吟草",
                "author": "永井壮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こいさん、出し巻の玉子、どうもなってえへんやろか」「それよりクラブサンドイッチが怪しいで。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルでクラブサンドウィッチ食って青山へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニーナの気ぜはしい叩きやうとは違つて、調子のととのつた滑らかな打ち方であるが、なるほどさう言はれてみればあの手ぶりには、そのむかしダルマチヤの貴族屋敷の一室、夕闇せまるサロンの窓辺か何かで、ひつそりと独りクラヴサンを弾いてゐるとでもいつた風情が、たしかに何処となく消え残つてゐるやうだ。",
              "citation": {
                "source": "灰色の眼の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときの唄が、せつないときは　かけこみ　かけこみ　パッとひらいて　天の花　この合唱には月琴、横笛、太鼓、三味線、拍子木、これにハープとヴァイオリンとクラヴサン（ピアノの前身のようなもの）が加わっている。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はベートーヴェンを敗徳漢だとしシェイクスピヤを香具師だとしていて、その代わりに、気取ったつまらない作家を喜び、丁髷王を感心させるクラヴサンの音楽などを喜んでいたのだ。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベートーヴェンの交響曲、アイスキュロスの悲劇、いとものどけきクラヴサン、ヴァチカン宮殿の古代像、オルフェウス、トリスタン、キリスト受難、体操、その他すべてのものが踊られています。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が四歳になると父は日に数時間もむりやりにクラヴサンを弾かせたり、ヴァイオリンを持たせて一室に閉じ込めておいたり、過度な音楽の勉強を強いた。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘンデルは音楽をお好きなうえ、自らクラヴサンをよく演奏した女王アンに謁した後、超人的に天才を発揮してわずかに十四日間で歌劇「リナルド」を書き下して上演した。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いて私はランドフスカ夫人の入れた「クラヴサン組曲」を挙げたい（ビクターＪＤ九四五―五〇）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、二枚物　一枚物、二枚物ではランドフスカのクラヴサンで「調子のよい鍛冶屋」（ビクターＪＥ一九〇）が面白い。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラヴサンの名曲「フランス組曲」は六曲のうち最後のホ長調のものがランドフスカのクラヴサンでビクター愛好家協会レコードに採られている。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イタリー協奏曲へ長調」はランドフスカのクラヴサン（ビクターＪＤ一二四二―三）と、シュナーベルのピアノのがある（ビクターＶＤ八一一五―六）が、シュナーベルほどの名ピアニストを煩わしても、これはランドフスカのクラヴサンの古朴な面白さに及ばない。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴールドベルク変奏曲」はバッハの作品中でも大物だが、この貴人の眠りを誘うために作られたという伝説を有する曲も、ランドフスカのクラヴサンの名演奏で聴くとこよなくも楽しい（ビクターＪＤ二七一―六）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「半音階的幻想曲と遁走曲ニ短調」もランドフスカのクラヴサンのと、ドルメッチのクラヴィコードのと、フィッシャーのピアノのと三通りあり、それぞれに美しくもあり興味もあるが、この曲の魅力的な美しきを味わうためには、ランドフスカのクラヴサンをもって第一とするだろう（ビクターＪＤ八〇一―二）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランドフスカのクラヴサン曲で、バッハのものをたった一枚味わうために、私は「幻想曲ハ短調」をすすめたい（ビクターＤＡ一一二九）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランドフスカ夫人の「クラヴサン協奏曲ニ長調」も逸することの出来ないものだろう（ビクターＪＤ一三一六―八）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ピアノ協奏曲（戴冠式）第二六番ニ長調Ｋ五三七」は、クラヴサンのランドフスカ夫人が、女流ピアニストとしても第一流であることが証拠立てられる。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲目を一々挙げるのは煩わしいが、現にこの項を続けながらも私は、ボーリン・オーベルの弾く、十七世紀のクラヴサン曲の邪念のない美しさに陶酔しながらペンを執っている有様である。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビクターのベン・スタット指揮、「古代の音楽」は、きわめて重要性を持った古典の編集であり、演奏もアメリカ古代楽器研究会の優れたものであるが、一般人のためにはそれよりも、ランドフスカ夫人のクラヴサン曲の方に魅力を感ずるだろう。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "クープラン（〔Franc,ois Couperin〕 1668―1733）の「クラヴサン曲集」などはその代表的なものである。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "が顧みて、　ドメニコ・スカルラッティ（Giuseppe Domenico Scarlatti 1685―1757）の「クラヴサン奏鳴曲集」、ランドフスカ夫人演奏（ビクターＪＤ六八二―七）を逸していることに気が付いた。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロムビアの世界名盤集には同じくシャンピオンの独奏で「クラヴサンの協奏曲＝ハ長調＝よりのロンド」があり、もう一つメンゲルベルクがニューヨーク・フィルハーモニック管弦団を指揮して入れたビクターの「交響曲＝変ロ長調」は十年以前の吹込みだが名演奏と言ってよい（七四八三―四）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「クラヴサン協奏曲」は美しいことではファリアのレコード中で第一だろう。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "作曲者自身のクラヴサンにモイーズのフリュートで入っているのは大変な御馳走だ（コロムビアＪ七八四四―五）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランドフスカ　Wanda Landowska　言うまでもなくクラヴサンのランドフスカだ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラヴサン（ハープシコード）の項に詳説するが、ピアニストとしても知名で、その、『ピアノ協奏曲「戴冠式」ニ長調』（モーツァルト・Ｋ五三七）（ビクターＪＤ一〇七六―九、名曲集六六三）は名演奏とされている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラヴサンランドフスカ　クラヴサンという楽器は、どういうものか、日本の好楽家には大変好かれている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラヴサンの世界的巨匠は、言うまでもなくワンダ・ランドフスカ夫人である。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
