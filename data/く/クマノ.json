          "literary": [
            {
              "text": "クマノカワにシシノカワと！",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギンザヲトホルト、クマノ　トムクント　メリーサンハココハ　ボクシッテヰルアタシモ　シッテルワトオホキナコヱヲ　　　　　ダシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "クマノ　トムト　　イヌノ　ジヨンハアマリヨロコンデ、トンダリハネタリシテ、タローサンニ　　シカラレマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "レンコンはハチノスで、ナスはクロドリ、塩ナスはクマノイ。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "その音をなつかしんで波子は、耳もとでお手玉をついていたが、やがて、高くつきあげて、サイジョウザンハ　キリフカシチクマノカワハ　ナミアラシハルカニキコユル　モノオトハサカマクミズカ　ツワモノカ　それはいたいけな少女の声だった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
