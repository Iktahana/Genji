    "definitions": [
      {
        "index": 1,
        "gloss": "writing with the brush in one's mouth",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "両手の自由を失った書道家が、口書きで力強い作品を書き上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は病室のベッドの上で、口書きを使って家族への感謝の手紙を綴った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "口書きの練習を始めた当初は、筆を安定させることさえ難しかったという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "はじめは気の変わりやすい、怒りっぽい惣七の口書きをすることは、大変な仕事だったが、それも、慣れてしまうと、このごろのように楽なものになって来た。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "その側で口書きを取つて居るのは、得意滿面の三輪の萬七、お神樂の清吉。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "紅い扱帶",
                "note": "青空文庫"
              }
            },
            {
              "text": "お孃樣をおびき出して望月丹後の屋敷につれ込み、その最期まで見て居た金兵衞が、悉く白状した上、口書きまで取つてありますから間違ひ御座いません」「何んと言はれる」　芝田要の驚きは、やがて主人清左衞門の説明で、激しい忿怒に變つて行きました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "閉された庭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それぢや錢形の親分が來る迄に、口書きの用意でもして置かう」　六丁目の銀六が、宜い心持さうに立ち去つた後、平次の背後からそつと囁く者があるのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "死人の手紙",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう宜いよ、此上は自身番に預けてある本人の徳太郎に當つて、口書きを取るまでさ、――ぢや後を頼むぜ、錢形の親分」　猪之助はひどく自尊心を傷つけられた樣子で、憤々として歸つて行きます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "女臼",
                "note": "青空文庫"
              }
            },
            {
              "text": "謎の箱一「お願ひだ、親分、お粂を助けてやつて下さい、今日中に口書きを取つて、八丁堀へ送ると、お神樂の清吉の野郎があつしの前でフヽンと鼻を鳴らしましたよ」　八五郎は明神下までついて來て、執こく平次に食ひ下がるのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "鬼女",
                "note": "青空文庫"
              }
            },
            {
              "text": "その側で口書きを取っているのは、得意満面の三輪の万七、お神楽の清吉。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "紅い扱帯",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、その間に三輪の万七親分は、力松を責めて口書きを取ったという話もある。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "蜘蛛の巣",
                "note": "青空文庫"
              }
            },
            {
              "text": "金があって男が好いと、世間が物騒だぜ」　重吉とお栄の口書きまで取らせて、八丁堀の組屋敷からの帰り、銭形平次はこう言って八を振り返りました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "雪の足跡",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そう言わずに兄哥」「気の毒だが勝は口書きを取ってお係りに引渡すばかりになっているんだ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "雪の夜",
                "note": "青空文庫"
              }
            },
            {
              "text": "三文字屋殺しは養子の小三郎と決って、下手人を挙げた手柄はことごとく若い島吉に帰し、平次は組屋敷あたりの噂で、小三郎のお白洲の神妙さや、口書きも無事に済んで、処刑を待っているという話を聴いているだけのことでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "刑場の花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "「林彦三郎は口書き拇印も済んで、伝馬町へ送られるという話だ、困ったことだな」　何かしら、平次にも鬱陶しい日が続いたのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "懐ろ鏡",
                "note": "青空文庫"
              }
            },
            {
              "text": "三文字屋殺しは養子の小三郎と決つて、下手人を擧げた手柄は悉く若い島吉に歸し、平次は組屋敷あたりの噂で、小三郎のお白洲の神妙さや、口書きも無事に濟んで、お處刑を待つてゐるといふ話を聽いてゐるだけのことでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "刑場の花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初金六に逢つて見ましたが、紋次郎を縛つた手柄に陶醉して、今度は平次の言ふことなどを耳にも入れず、少しは痛め付けても、今日中に口書きを取らうとあせつてゐる樣子です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "矢取娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから三日、必死の探索も何んの役にも立たず、小染は口書き拇印を取られて、いよ／＼送られるばかりになりました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "吹矢の紅",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから三日、必死の探索も何の役にも立たず、小染は口書き拇印を取られて、いよいよ送られるばかりになりました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "吹矢の紅",
                "note": "青空文庫"
              }
            },
            {
              "text": "お関と幾松は厳重に縛られて、口書きを取って奉行所に送られるばかりになっていましたが、銭形平次はその縄を解かせて、さて問い進むのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お由良の罪",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初金六に逢ってみましたが、紋次郎を縛った手柄に陶酔して、こんどは平次の言うことなどを耳にも入れず、少しは痛め付けても、今日中に口書きを取ろうとあせっている様子です。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "矢取娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そして、両者こもごもの自供は、胡正の筆記で、洩らさずそばから口書きとなっていった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その口書きを、こっちへよこしてくれ」　武松は入念だった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん証拠の一書も見せ、生擒った密使の口書きもつぶさに示しての上である。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、だれも、ごてんのなかにはいると、かぎたばこでものまされたように、ふらふらで、おうらいへでてきて、やっとわれにかえって、くちがきけるようになる。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "所詮町奉行所の白洲で、表向の口供を聞いたり、役所の机の上で、口書を讀んだりする役人の夢にも窺ふことの出來ぬ境遇である。",
              "citation": {
                "source": "高瀬舟",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "見分の役人は三右衛門の女房、伜宇平、娘りよの口書を取った。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒井家から役人が来て、三人の口書を取って忠学に復命した。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に永井、久保田両｜徒目附に当てた口書を取った。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に呼び出されていた、亀蔵の口入人神田久右衛門町代地富士屋治三郎、同五人組、亀蔵の下請宿若狭屋亀吉が口書を取られた。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に九郎右衛門等の届を聞き取った辻番人が口書を取られた。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "酉の下刻に与力仁杉八右衛門の取調を受けて、口書を出した。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "九郎右衛門等三人は口書下書を読み聞せられて、酉の下刻に引き取った。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
