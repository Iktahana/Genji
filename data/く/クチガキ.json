[
  {
    "uuid": "10bb62b3-3c66-5d69-bd21-752f32d0eabd",
    "entry": "口書き",
    "reading": {
      "primary": "くちがき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
