        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日本の山奥には、まだ黒熊が数多く生息している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "動物園で、冬眠前の黒熊が餌をたくさん食べているのを見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "登山中に黒熊と遭遇しないよう、熊鈴を携帯した方が良い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "大きい納壺の一つは戸が開けっぱなしになって、とてもすばらしい黒熊の毛皮がその形なりにぶら下っていた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々のプロスペロオは球乗の黒熊。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏経や南欧の文章に美人を叙するとて髪はもちろんその他の毛の色状を細説せるを、毛黒からぬ北欧人が読んで何の感興を生ぜぬは、自分の色状と全く違うからで、黒熊皮を見ても妻を想起せぬのだ。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "爺は槍にさされた黒熊のようにばたばたのめった。",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカ黒熊というのは、よくありふれたヨーロッパの Brown Bear よりは少し小さい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒマラヤ黒熊というのは、特徴の一つとして胸に月毛がある。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、日本の熊は、このヒマラヤ黒熊の地方種といってよかろう。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月上旬、吹雪のなかで一頭の黒熊を撃ち止めたという報せがあったから、その肉を送ってくれと電報したところ、それは我々射手と勢子とで、舌鼓をうってしまった。",
              "citation": {
                "source": "香熊",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "折柄、私は吾妻渓谷へ雪代｜山女魚を釣りに行き、義弟の家へ泊まっていたのでこれを見ると素晴らしい黒熊だ。",
              "citation": {
                "source": "香熊",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊は本州の山に産するものは、アジア大陸に産する黒熊の變種です。",
              "citation": {
                "source": "森林と樹木と動物",
                "author": "本多靜六",
                "note": "青空文庫"
              }
            },
            {
              "text": "よって、余のちょっと書物あるいは人に見聞したることを申さんに、夢の発作するありさまは、吾人もし硬き疎なる辱上に寝ね、もしくは狭窘なる位置に臥したるときは、骨を傷つき、もしくは楚撻に遭うと夢み、消化せざる食餌をなすときは、肥大なる黒熊来たり、わが胸膈に当たりて、泰然として座したりと夢みたりと。",
              "citation": {
                "source": "妖怪報告",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘉十はだんごをたべながら、すすきの中から黒くまっすぐに立っている、はんのきの幹をじつにりっぱだとおもいました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘉十はだんごをたべながら、すすきの中から黒くまつすぐに立つてゐる、はんのきの幹をじつにりつぱだとおもひました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十人そこそこの軽業師と、年をとった黒くまと馬二とうだけの小さな団です。",
              "citation": {
                "source": "正坊とクロ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "燃えるようなカンナの花茎に黒くまつわりのぼる蟻が見られた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "益々近づくその船を見れば、黒い煙突には○のマークが躍り、船側には黒くまぎれもない釧路丸の三文字が、鮮かにも飛沫に濡れているのだった。",
              "citation": {
                "source": "動かぬ鯨群",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "水色にすみわたった五｜更の空――そこに黒くまう一｜葉のかげもなく、ただ一｜閃、ピカッと※惑星のそばの星が、あおい弧線をえがいて巽から源次郎岳の肩へながれた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
