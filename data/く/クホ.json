      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "留守になると、橋手前には腕白盛の滝太一人、行儀をしつけるものもなし、居まわりが居まわりなんで、鼻緒を切らすと跣足で駆歩行く、袖が切れれば素裸で躍出る。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "脚の長い、駆歩に慣れたフランス人にはなかなか及ばない。",
              "citation": {
                "source": "堺事件",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸で火事があって出掛けるのに、早足の馬の跡を一間とは後れぬという駆歩の達者である。",
              "citation": {
                "source": "堺事件",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて庭を横切って、寺の門を出るや否や、公使を包擁した兵卒は駆歩に移って港口へ走った。",
              "citation": {
                "source": "堺事件",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、彼等は先祖代々｜深山幽谷に棲んでいるから、山坂を駆歩くことは普通の人間よりも素捷いであろうし、腕力も亦強いかも知れない。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "オギクボ、西オギクボなどといふ小駅を通過して私達は、大きな沼のあるイノカシラといふ処まで半ば駆歩で到達しました。",
              "citation": {
                "source": "蔭ひなた",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌｜朝は早く出てブレラの美術館が開くまで市内の各所を駆歩いた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里を去らうとして　羅馬に七日、ナポリとポンペイに二日と云ふ駆歩の旅をして伊太利から帰つて見ると、予が巴里に留まる時日は残り少くなつて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時馬がたちまち駆歩になって、車罔は石に触れて火花を散らした。",
              "citation": {
                "source": "破落戸の昇天",
                "author": "モルナール・フェレンツ　Molnar Ferenc",
                "note": "青空文庫"
              }
            },
            {
              "text": "火の鼻息に水晶の雨を吹き、暴く斜めに、駆歩す、駆歩す。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "副馬は平等な駆歩を蹈んで橇の脇を進んで行く。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "時間は殆ど目分量で極めていて不安心だから、時には駆歩をした。",
              "citation": {
                "source": "ドナウ源流行",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "川原にゐた老若男女も慌しく駆歩などをするので、これは降るかも知れんといふ気がしてゐるうちに、もう大滴の雨が落ちて来た。",
              "citation": {
                "source": "イーサル川",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど遥か向うの街道を騎馬の人が駆歩している。",
              "citation": {
                "source": "玉菜ぐるま",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "駆歩する馬の後えには少しずつ土げむりが立って見える。",
              "citation": {
                "source": "玉菜ぐるま",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "渠は驅歩の蹄の音をカムパニアの廣野に響かせて去りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬はいつも驅歩なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "挽くものは唯だ一馬なるが、その足は驅歩なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
