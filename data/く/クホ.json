  {
    "uuid": "a0ad5ec0-e6d0-5839-8392-5acd37b65173",
    "entry": "駆歩",
    "reading": {
      "primary": "くほ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
