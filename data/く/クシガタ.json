        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "レモンをくし形に切ってグラスの縁に飾り、見た目を華やかに仕上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "スイカをくし形に切り分けてお盆に並べると、夏らしいテーブルになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "レシピにりんごをくし形に切って芯を取り除くよう書いてあったので、その通りに準備した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "さはいへ東京はその地勢河を帯にして海を枕せる都なれば、潮のさしひきするところ、船の上り下りするところ、一条二条のことならずして極めて広大繁多なれば、詳しく記し尽さんことは一人の力一枝の筆もて一朝一夕に能くしがたし。",
              "citation": {
                "source": "水の東京",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは、たゞ葛岡にこれを見せて遣り、それに突き付けてわたくしがたった一言いい度い言葉によって葛岡に何か激しい気象を起させ度いためでした。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に進んで故人の肉を描き血を流動せしめて全人格を躍動せしめようとするには勢い内面生活の細事にまでも深く突入しなければならないから、生前の知友としてはかえって能くしがたい私情がある。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "われらが播種し、もしくは移植した艸木が、大地の生生の気に刺激せられ、化育せられて、艸は艸として、木は木としての生命の発展を遂げゆくのを見て、言語に言ひつくしがたい、甚深な感激と歓喜とに先づ心を躍らせる者は、誰よりも土に親しみ、手を汚してまでも種子を播いたもの、彼自らでなければならない。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "享和三年は文化紀元に先だつこと僅に一年ではあるが、わたくしがためには此小発見も亦重要である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "滞留中何かと御懇意は申つくしがたく、これはいはぬはいふにまさると思召可被下候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "たび／＼参候ていろ／＼さしつかひ候御せわのだん申つくしがたく候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "真相を知らぬ人々の寄贈したおびただしい祝品のあるのを御覧になっても、この誤りを正しくしがたい心苦しさから恥ずかしくばかりおなりになる院であった。",
              "citation": {
                "source": "源氏物語",
                "author": "柏木",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ前に沖があつて、上總標などのみほつくしがたつてゐたのに、そんなものもなく埋たて地が連なり、潮にのつて、シユツ／＼と漕ぎたててくる八丁櫓の押送り船や白帆のかかつた大きな船など見ることも出來ない。",
              "citation": {
                "source": "河風",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかが語らむいかが語らむ、おもふこと、そはいと長きこゝろなれ、いま相むかふひとときにつくしがたなき心なれ。",
              "citation": {
                "source": "恋衣",
                "author": "山川登美子・増田雅子・與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大洋上に出た船、而かも真夜中の闇い潮の中で船火事などの起った場合の心細さ絶望的な悲しみは到底筆につくしがたい。",
              "citation": {
                "source": "梟啼く",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "大小の島々に至りては数へつくしがたし、かかれば海岸の風光、つねに、大に多様多趣なるなきあたはず、そのながめや麗はしく、その彩色や明かなり。",
              "citation": {
                "source": "松浦あがた",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "エゴイズムを基礎とする関係機構への不安を覆いかくしがたいのである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎事筆端につくしがたし」とまで云って、右の光明房の手紙に就て法然は、「一念義｜停止の起請文」をまで定めて世に示した。",
              "citation": {
                "source": "法然行伝",
                "author": "中里介山",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ただ今、わたくしを、じょうずにひっぱり出して下すった、忠実な友だち、そして、尊敬すべき後援者は、今夜のずるい計画については、すこしも責任はないのでありまして、これはすべてわたくしがたてた計画で、わたくしがむりをいって、やっと承知させたのであります。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "在京する諸大名、および水戸、肥後、加賀、仙台などの家老がいずれもお召に応じ、陣装束で参内した混雑は筆紙に尽くしがたい。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしがたま／＼静に月を観やうといふやうな――それも成るべく河の水の流れてゐるあたりへ行つて眺めやうと云ふ心持になるのは、大抵尾張町の空に、月の昇りかけてゐるのを見る夕方である。",
              "citation": {
                "source": "町中の月",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハガキの作者はベランメー型で、筆で委曲がつくしがたいから、拳コの代りに呼びすてにして溜飲を下げているらしい。",
              "citation": {
                "source": "巷談師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな情動と共にそのキュクロプス式巨石建造物の断片と――客観的現実性を以て――直接に接触したかは筆舌に尽くしがたい。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁が編者の指導の下に、その御老体の全力を、再び而も異常な神速さをもって敢行しつづけられた努力に対しては、わたくしは涙ぐましき感激の情のこみあげてくるばかりで、なみなみの言葉を以ては、とても尽くしがたい程であって、今も益々感銘が深い。",
              "citation": {
                "source": "『言林』新版序",
                "author": "新村出",
                "note": "青空文庫"
              }
            },
            {
              "text": "建物に沿った古びた石じきの歩道をゆくと、その建物の一階の四つの窓に白レースの目かくしがたれて、桃色のきれいなゼラニウムの花が、窓のひろさいっぱいに飾られているのがちらりと目に入った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "せっかく、せっかく、われわれは、言葉では言いつくしがたい位の高価なギセイを払った末に、われわれ自身を世界的場の高さにまで引きあげ得る手がかりと可能性をつかんだのに、そして、そのことについてのチャンピオンが、これらの人たちであり得ただろうのに、それを再び失いかけているとも言えば言える現象だからだ。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちばんしまいに申しました、あのディデロートの洗礼の話は、わたくしがたった今、自分で作ったのでございます。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで倒れて死ぬのは、愛と家庭と、真に優しい妻が待っているのに、余りにもむごいし、筆舌に尽くしがたい。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「………そも／＼女人のやさしさ美しさ、絵にも文にもかきつくしがたく、何にたとえ何にくらべてか告げまいらせ候わん。",
              "citation": {
                "source": "二人の稚児",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "対等では忠節がつくしがたいとある。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
