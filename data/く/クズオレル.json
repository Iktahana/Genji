[
  {
    "uuid": "1be549c3-58e3-549b-9357-9ef744bf3a39",
    "entry": "くず折れる",
    "reading": {
      "primary": "くずおれる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
        "動詞-自動詞"
      ],
      "ctype": "一段",
      "inflections": null,
      "ctype_source": "pos-derived",
