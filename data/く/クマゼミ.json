        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "真夏の都会の公園で、熊蝉が「シャアシャア」と耳を劈くような凄まじい声で鳴いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "熊蝉の大きくて丈夫そうな抜け殻を見つけて、その迫力に子供たちが驚きの声を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ああ、朝から熊蝉がうるさくて、目覚まし時計が鳴るよりずっと先に目が覚めてしまった」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "磴たるや、山賊の構えた巌の砦の火見の階子と云ってもいい、縦横町条の家ごとの屋根、辻の柳、遠近の森に隠顕しても、十町三方、城下を往来の人々が目を欹れば皆見える、見たその容子は、中空の手摺にかけた色小袖に外套の熊蝉が留ったにそのままだろう。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊蝉最初の声、油蝉も鳴いた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊蝉が、むかうの方で、ちよいと鳴いた、今夏最初の声である。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "――熊蝉が鳴く、真夏の歌だ、油蝉も鳴きだした、それは残暑の声だらう。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "まつたく猛暑だ、油蝉熊蝉が鳴きだした。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとにうるさい位だ」　熊蝉が、あちらこちらの樹に止って、ここを先途と鳴いていた。",
              "citation": {
                "source": "桜島",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "倉市は僕の腕の中で、クマゼミのやうに激しく泣き出した。",
              "citation": {
                "source": "ベツコウ蜂",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京にはジイジイ、アブラ、ミンミン、ツクヅクボウシ、カナカナ位しか居らず、ハルゼミ、チッチゼミ、クマゼミ、エゾゼミなどは居ないようである。",
              "citation": {
                "source": "蝉の美と造型",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "クマゼミは先年熱海で松の木のてっぺんに鳴いているのを見たが竿が届かず、手にはとれなかった。",
              "citation": {
                "source": "蝉の美と造型",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "クマゼミ又の名シャンシャンゼミはセミの中で一番巨大で色も黒、緑の外に橙色が交り、翅も透明でしかも強く、形もよいようであるが、此は手にとって見たのでないから詳細は知らない。",
              "citation": {
                "source": "蝉の美と造型",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
