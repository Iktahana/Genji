        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（シィヌは耳に入れないで歌いつづける）クリスチイネ！",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィン　頼むから、クリスチイネ！",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々クリスチイネがやって来ちゃ引っかけて行くヂンのお代は勘定に入れなくてもですよ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらのクリスチイネが頼むからまあ――クリスチイネとはズット以前からナジミですからね、食べるものがないと言って泣き付かれりゃ、うっちゃっても置けないしね、それに、近頃じゃ、あの子のおふくろまで時々やって来ちゃ、バタなんぞ持って行って、あんたんとこの帳面につけといてくれと言うんですよ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれも無理もないさ、クリスチイネの子供を四人もおっつけられて養ってやってんだからね。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなザマだと、また、クリスチイネは、あたしん所へ金を借りに来ますよ？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
