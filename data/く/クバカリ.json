          "literary": [
            {
              "text": "百ノ霹靂一時ニ落ツトモ、カクバカリ心ニ強ク響クマイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "余其家ヲ訪フ一二次、我ガ古器ヨリ勾玉管玉ノ類迄驚クバカリ多ク貯蔵シ、且ツ皆貴重ス可キノ品ノミナリ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　ドウシテヨイヤラタメイキ　ヲ　ツクバカリ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "境内ノ幽邃ナコトハ真ニ五子ノ言ニ背カズ、前ニモ二三度杖ヲ曳イタコトハアルガ、コレデモ大都会ノ市内カト驚クバカリ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
