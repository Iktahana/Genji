        "examples": {
          "standard": [
            {
              "text": "その腕時計はクォーツ式で、電池で動いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "クォーツの結晶は透明で、宝飾品によく使われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "精密機器の部品にはクォーツ時計の技術が応用されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "すると病気でないものは僕とクォーツさんだけだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「うむ、うむ、そのクォーツさんもお気の毒ですがクウシャウ中の瓦斯が病因です。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「うむ、うむ、そのクォーツさんもお気の毒ですがクウショウ中の瓦斯が病因です。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは穴蔵にジャガイモの小さいひと樽と、コクゾウ虫のまじったエンドウ豆二クォーツ〔一クォーツは約一リットル〕ばかりとをもち、棚には少量の米、糖蜜ひと壜、ライ麦とトウモロコシとの粉をおのおの一ペックあまりをもっていた。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
