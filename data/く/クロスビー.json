          "literary": [
            {
              "text": "クロスビーと、グレース・スリックと、あとひとりはだれだっけ、ポール・カントナーだったかな」　tri- は三を示す接頭辞で、triad というのは、たとえば「三和音」のように、なんであれ、三つでひと組のものをいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "べつに、クロスビーたちみたいに、セックスはからまっていなかったけど、おなじことだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして次に、クロスビーの書いた「カーペンターの伝記」を読むだのである。",
              "citation": {
                "source": "半農生活者の群に入るまで",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月九日（月曜）　九時起きで、内幸町大阪ビル、メトロ試写室へ、「虹の都へ」Going Hollywood を見に行く、西洋の声帯模写があるとの話だったが、ちょぼッとだけ、メリオン・デヴィス、ビング・クロスビーで、愚にもつかぬ愚劇なりし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
