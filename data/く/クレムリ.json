        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "白濁した河の向うの塵埃の多い淡褐色の丘の上に、金色に塗られた丸いクレムリンのドウムが見える。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "クレムリンの建築は赤黒い刺繍を見ているようで奇怪な面の感じである。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "新クレムリン宮殿は、突兀たる氷山の如く擬装されてあった。",
              "citation": {
                "source": "地軸作戦",
                "author": "――金博士シリーズ・９――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この新クレムリン宮も、あと三時間以内には水中に没するぞ。",
              "citation": {
                "source": "地軸作戦",
                "author": "――金博士シリーズ・９――",
                "note": "青空文庫"
              }
            },
            {
              "text": "宰相は、新クレムリン宮を後にするに際して、委員の一人をしてネルスキーに叱責の言葉を伝達せしめられた。",
              "citation": {
                "source": "地軸作戦",
                "author": "――金博士シリーズ・９――",
                "note": "青空文庫"
              }
            },
            {
              "text": "氷花のついた窓硝子にまっ青な月の光が一面にさし、夜中十二時になると打ち出すクレムリ時計台のインタナショナルの音が厳寒をふるわして室内にまで響いて来た。",
              "citation": {
                "source": "坂",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月七日（土曜）　朝十二時頃よりクレムリンの中の歴史博物館へ行ったが、ブブノワ女史の紹介して呉れた人居ず。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのままクレムリンをずっと見ながら抜けて、モスクワ河を彼方岸へ出て、エハガキにあるような位置から、クレムリンを眺めた。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クレムリンの持って居る色彩。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○今日はモヤの誕生日にして、自分コムナールで、カビヤ、オッカ、鶏、カウカーズ〔コーカサス〕の店でスリッパなど買い、散々クレムリンを歩いた揚句だからクタクタになって部屋へ戻った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "始め、クレムリの時計かと思ったらそうでなかった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここ、クレムリンへ入る陸橋をとおして、ずっと下り坂になった彼方の展望よろし、　雪、黒い立木、スキーをする男の子、スレッジをする小さい子、犬をつれた女、　きのう一人で散歩したとき居た男が、やはりトウェルスカヤ〔街路名、現在のゴーリキー通り〕の先のところで、松の枝を売って居た。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕　泣いた顔を洗ってベゲテリアン食堂へ行き、宿へ一寸かえってから、クレムリンの方へＹずんずんゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クレムリンの壁に※1917―1928と巨大なイルミネーションがともって、暗い空に赤旗が翻って居る感じ、赤いイルミネーションで群集が体は暗く、顔だけ赤くうき立たせて散歩する感じ。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはクレムリンの中が引越して来る筈の新建築。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月十八日　金　朝 ВОКС へ集ってクレムリンの見物。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月二十九日（日曜）　布施勝治がリガに行っていて、中国のスペイン化がクレムリの意見であると。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　クレムリン城内と向いあって、四角にモスストロイ（モスクワ土木課）がある。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "後は日の照りつけるクレムリンの壁だ。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　秋山が、一寸耳をすませ、「ああ、クレムリンの時計台のインターナショナルですよ」と云った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "クレムリンを中心として八方へ、幾本かの大通りが走っている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この大通りはクレムリンの城壁の外にある広い広場から遠く一直線にのびて、その途中では、一八一二年のナポレオンのモスクをとりかこむ最も見事な原始林公園・鷲の森の横を通っている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボリシャーヤ・モスコウスカヤと並んで、大きく古びたホテル・メトロポリタンの建物がクレムリンの外壁に面してたっていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トゥウェルスカヤ通りが、クレムリン外壁の一つの門につきあたる。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "韃靼風に反りのある矛形飾りのついたクレムリンの城壁が広場の右手に高くつづき、その城壁のはずれに一つの門があった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "クレムリンの城壁からは、そのなかに幾棟もある建物の屋根屋根の間に、高く低く林立という感じで幾本もの黄金の十字架がきらめいていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一本は、双曲線を描いて、左側の大建築の下につけられているアーチから、支那門とよばれているクレムリンに相対するもう一つの門へ出てゆく道。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひろい雪の上でさえぎるものない視線に、この首の座とクレムリンの城壁から林立している金の十字架の頂きを眺めあわせると、伸子は、いつも激しい叙事詩の感銘にうたれた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その群集の訴えに向って、血の流されている首の座に向って、クレムリンの住人ツァーの一族がふりかざしたものは林立する十字架だった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
