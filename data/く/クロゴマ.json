        "examples": {
          "standard": [
            {
              "text": "パンに黒ごまをたっぷりかけて焼くと香ばしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "黒ごまプリンは、健康にも良いとされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "料理のアクセントに黒ごまを散らす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "上唇についた黒ごまと鼻汁とを一緒になめているものもある。",
              "citation": {
                "source": "西川小りん",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほそいんげんの黒ごま和へ。",
              "citation": {
                "source": "季節の変るごとに",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たんぽぽは春の野草であるけれど、黒ごまあへがおいしい。",
              "citation": {
                "source": "ともしい日の記念",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
