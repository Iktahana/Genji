        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから窓際に立ち寄ると、指で窓ガラスをガタガタたたいて、『おーい、プローシカ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく誰か慌ただしく玄関へ駈けこんだ気配がして、そこで何か久らくごそごそやっているようだったが、やがて長靴の音がどたばたと近づいて来ると、扉があいて、プローシカが入って来た。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "プローシカがどうしてこんな大きな長靴をはいていたかということは直ぐに分る。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とプリューシキンはプローシカの顔を指しながら、チチコフに向って言った。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ここで彼は暫らく口を噤んだが、それに対してプローシカの方も黙りこくっていた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と彼は、プローシカが長靴を曳きずって出ていってから、チチコフに向って言った。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
