        "examples": {
          "standard": [
            {
              "text": "彼は若手の中でも特にプロミッシングな新人として注目されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "このスタートアップ企業は、市場で非常にプロミッシングな立場にある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "プロミッシングな才能を見出し、育成するのが私の役目だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "私はあなたは大学を出る頃にはすでにひとかどの学者になるだろうと思われて非常にプロミッシングな期待を置いています。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたなどは、最もいろいろな意味で、プロミッシングな方だとおもいます。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はあなたを全くプロミッシングに期待しています。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
