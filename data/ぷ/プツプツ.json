        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古くなって劣化した輪ゴムを引っ張ると、伸びる前にぷつぷつと細かく千切れてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "生地が傷んでいたのか、古いシャツを雑巾にしようと裂いたら糸がぷつぷつと切れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "安物のミシン糸を使ったら、縫っている最中にぷつぷつと何度も切れてイライラした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
