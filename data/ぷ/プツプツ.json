    "definitions": [
      {
        "index": 1,
        "gloss": "bumpy (e.g. of a rash)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新しい化粧水を使ったら肌に合わなかったらしく、顔中に赤いぷつぷつができてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "汗をかいたまま放置していたら、背中にあせものぷつぷつが現れて痒くてたまらない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "アレルギー反応なのか、腕の内側に小さなぷつぷつが広がっていて心配だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "私どもははじめまるで死んだようになっていましたがだんだん近くなって見ますとその役人の顔はまっ赤でまるで湯気が出るばかり殊に鼻からはぷつぷつ油汗が出ていましたので何だか急にこわくなくなりました。",
              "citation": {
                "source": "二人の役人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私どもははじめまるで死んだやうになってゐましたがだんだん近くなって見ますとその役人の顔はまっ赤でまるで湯気が出るばかり殊に鼻からはぷつぷつ油汗が出てゐましたので何だか急にこはくなくなりました。",
              "citation": {
                "source": "二人の役人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「絵葉書に針でもってぷつぷつ穴をあけて、ランプの光に透かしてみると、その絵葉書の洋館や森や軍艦に、きれいなイルミネエションがついて、――あれを思い出さない？",
              "citation": {
                "source": "秋風記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝からすこし腹ぐあいがわるく、なにか重いものが下腹いったいにつまっている感じで、ときどき、ぷつぷつと豆のにえるような音もしていたので、ゆだんすると屁をするぞと、心をいましめていたのだが、ついに、しごとに熱中していて、今その屁を音もたてずにしてしまったのである。",
              "citation": {
                "source": "屁",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "痛風の小さな老人は鞴みたいにぷつぷつ言った。",
              "citation": {
                "source": "ペスト王",
                "author": "寓意を含める物語",
                "note": "青空文庫"
              }
            },
            {
              "text": "妹はこの姿をみると、朝寝したことをぷつぷつ難じてゐたが、私は黙つて便所へ這入つた。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "田芹のおひたしに、大きな塗椀の中にはぷつぷつと泡立っているとろろ汁が入っていた。",
              "citation": {
                "source": "茶粥の記",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪を冠った鉾杉の幹の下でぷつぷつ切れてゆく葉脈の匂いが強く発ち、あたりの雪の白さが急に眼に滲みついて痛んだ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "とてもいいお天気で、海の底にもガラスのようなまっさおい光りが透けて、水泡がぷつぷつと舞いあがっているといった気持ちのいいお天気です。",
              "citation": {
                "source": "ひらめの学校",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鋏でぷつぷつと細引を切つてしまひたい気がしてゐた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "野原まで運ぶのにいくらか貰わにゃ、とぷつぷつ云うと、年よりの番頭が、そりゃええ、あすこまでじゃったら自転車でも行けるけに、と、職人らしくあっさりしている。",
              "citation": {
                "source": "日記",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうひとつ、こわいながらも彼のたのしみだったことは、冬の夜ながを年老いたオランダ人の女房連とすごし、彼女たちが炉ばたで糸をつむぎ、焼き林檎が炉にならんでぷつぷつ音を立てているとき、そのふしぎな物語に聞きいることだった。",
              "citation": {
                "source": "スリーピー・ホローの伝説",
                "author": "故ディードリッヒ・ニッカボッカーの遺稿より",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、黒いやわらかな土からは、来年さく草花の芽が、もうぷつぷつとみどり色に頭を見せていたのです。",
              "citation": {
                "source": "朝の公園",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとから、あとから追いかけては消えてなくなる湯気を見ていると、そのうちに、ぷつぷつと、勢いよく吹き出して、重いふたを動かしました。",
              "citation": {
                "source": "おかまの唄",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、一つ一つの、つばみがふくらんで、ぷつぷつとして、もうそれが開くのも間のないことでありました。",
              "citation": {
                "source": "汽車は走る",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い丸い鼻の頭に汗をぷつぷつと浮かべ、くるくる目をぱちぱちさせて、情報を申しあげます、ただ今……と叫んでいる姿はとてもかわいらしかった。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "折々ぱちぱちが止むと、煙突の口から寒空へ立ち昇る火の子のぷつぷついふのが聞える。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "縄目も、ただの縄をかけたのでは、ぷつぷつ断ってしまうし、暴れる、吠える、ほとんど手がつけられない。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのプツプツした空気、野獣のような匂い、大気へというよりも海へ射し込んで来るような明らかな光線――ああ今僕はとうてい落ちついてそれらのことを語ることができない。",
              "citation": {
                "source": "海　断片",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただプツプツとけむるばかり、煙は茅屋のまわりにただようている。",
              "citation": {
                "source": "告げ人",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　村川は、腸がプツプツちぎれるように思った。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に非道いのになると、毎日剃らないせいか、黒い毛がプツプツと芽を吹いて、白粉とゴチャゴチャになって、二タ眼と見られぬ醜態である。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　なるほどどこやらから、ピシピシプツプツと、異様な音響が聴えてくるのであった。",
              "citation": {
                "source": "人間灰",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "八時間の後｜温い処から出してみるとプツプツと盛に醗酵していますからその中へメリケン粉二斤を加えてよく混ぜると饂飩の少し柔い位なものが出来ます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくして受話器がプツプツ鳴り、緊張して耳をすませながら、再び下に呼びかけたのです。",
              "citation": {
                "source": "墓場",
                "author": "西尾正",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時、博徒の円陣の右から二番目に構えている男の裸の肩の辺から腹帯へかけて一筋血がプツプツとにじみ出して来て、見るまに腹帯を赤く染めるのと同時、トットットッ三、四歩前にのめってウムと低く唸って前に倒れてしまう。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし煮てみると前歯で皮がプツプツと切れるのが合鴨、切れないでいつまでもしねしねしているのはあひる。",
              "citation": {
                "source": "料理メモ",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、考えてみると、数の子を歯の上に載せてパチパチプツプツと噛む、あの音の響きがよい。",
              "citation": {
                "source": "数の子は音を食うもの",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてプツプツと少しづつ出て行く空気が、その悲しい泣声になるのだ。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "横を巻いて尾根の頂上に達し、少し上って又同じような横搦みを続け、岩多き斜面を過ぎ、最後に沢を伝って下りて行くと、岩面の小さな孔からプツプツと息を切って、水蒸気と共に熱湯が沸き出している、あたりの岩の裂目からも湯が滲み出して、硫黄の華が真黄色な素麺を流したように沈澱している。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
