          "literary": [
            {
              "text": "五月二十日（金曜）　プレシドン・ドウメルの食事。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三益と待ち合せ、速水に会ひ、神戸港のプレシドン・ドウメルへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月十七日（木曜）　プレシドン・ドウメル行。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "速水育三と理学博士清水氏と待合せ、神戸港突堤へ、プレシドン・ドウメル、五月にも一度来たことのある船、バルベ氏が日本話のうまいルキエン氏と共に来り、バアで先づカクテル。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
