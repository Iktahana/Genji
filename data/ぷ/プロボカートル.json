          "literary": [
            {
              "text": "第二、プロボカートル〔スパイ挑発者〕に対する方針。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月八日（土曜）　公判第三回、プロボカートルに対する方針。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮借なきということの意味、仮借なき自己批判という場合にも明らかなように、政治的に妥協せぬ意味、プロボカートルが組織を腐敗させ、方針を歪め、損傷を与えるのみならず検挙後も偽りの陳述、中傷等によって罪悪を重ねるのが特長である。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            }
          ]
        }
