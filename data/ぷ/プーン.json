        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ふと、うしろを見ると、クルマバソウのにおいが、ぷーんとしてきました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "――しかも、その包み紙には、ぷーんと強い線香のにおいがある。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこにそんな証拠があるんですかよ」「五十両の包み紙から、ぷーんと強く線香のにおいが散っているじゃねえかよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぷーんとなやましいはだのにおいが、否、紛れもないおしろいの移り香がするのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "持ち主のあたしはかくのとおり色香ざかりの若い女でござりますといわぬばかりに、憎いほどにもなまめかしくまっかで、そのうえぷーんといいにおいのおしろいの移り香がするじゃねえかよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごわごわして、あらいたての布だけが持っている快いにおいがぷーんとする。",
              "citation": {
                "source": "空気ポンプ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、ぷーんとして、くるりと後を向いてスタスタ行きかけるのを、母親が、「この日盛りを、病気になってしまうよ。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥からコーヒーの香がぷーんと匂ってきたからである。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "元気が出ますから」　検事の鼻さきに、ぷーんと強い洋酒のにおいがした。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "卓子の上に、飲みのこしのウィスキーの壜があり、その横に空になったコップがありましたが、ぷーんと強く杏仁の匂いがしていました。",
              "citation": {
                "source": "密林荘事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてぷーんと、かびくさい匂いが鼻をうった。",
              "citation": {
                "source": "時計屋敷の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼の口にぷーんといい匂いのする葡萄酒の壜をあてがった。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぷーんと、あのにおいがするぜ」「ほんとだ。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぷーんと、いい匂いのするやつがおれの前へ持って来やがったから、多分それは若い女にちがいない。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しんぱいいりません」　このとき、ひじょうに香の高い香水が、房枝の鼻をぷーんとついた。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が、小一時間あまりも、それをつづけているうちに、どうしたわけか、ぷーんとへんな臭いがしてきたではないか。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ぷーんと、ゴム臭い臭いがし、白い煙が電動機の中から、すーっと昇っていることに、始めて気がついた。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、どこからともなく、ぷーんと、いい匂いが鼻をうった。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　函をとりあげて、蓋のところを鼻につけてみると、ぷーんとつよい酒の匂いがする。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして函の中には、小さい薬びんが一つ転っていて、栓の間から、酒がにじんで、ぷーんといいかおりを放っていた。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぷーんと髪の香がした。",
              "citation": {
                "source": "脳の中の麗人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "口のところへ持っていくと、ぷーんと黴くさい臭いがしたので、舗道のうえへ叩きつけた。",
              "citation": {
                "source": "英本土上陸戦の前夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぷーんと饐えくさい空気が、彼の鼻をうった。",
              "citation": {
                "source": "英本土上陸戦の前夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぷーんと、薬品の匂いが、入口に立つ三人の鼻を打った。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて二人が近よったのはぷーんと異様な臭気のただよっている倉庫だった。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくあけたこともなかったとみえ、中からはぷーんとかびくさい臭がただよってきました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとともに、ぷーんとはげしい酒くさい息が、彼の鼻をうった。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてぷーんと、はげしい香が鼻をついた。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてぷーんと強い酒の匂いが、杉田の鼻をついた。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぷーんと黴くさい匂いが、鼻をうった。",
              "citation": {
                "source": "生きている腸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
