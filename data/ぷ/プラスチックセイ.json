        "examples": {
          "standard": [
            {
              "text": "「落としても割れにくいように、子供用の食器はプラスチック製にしているんだ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "高級そうに見える外観だが、実際に手に取ってみるとプラスチック製であることがわかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "キャンプには持ち運びに便利な、プラスチック製の折りたたみ椅子を持参した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "だがコスト削減の厳しい圧力を受けた低価格のメモリーのパッケージは、急速にプラスチック製に置き換わりつつあった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒やオレンジ色の、プラスチック製の丸い浮きが、いくつもころがっている。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
