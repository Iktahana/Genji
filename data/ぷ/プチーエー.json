        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あゝ友、父のペーリュウス、プチーエーより君の身を＊アガメムノーンに送りし日、訓戒切に斯く曰ひき。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "253　オヂュシュウスはネストールと共にプチーエーに行きてアキリュウスを誘へり。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "大地を震ふポセードーン善き航海を惠みなば、第三日に豐沃のプチーエーにぞ歸るべき。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど十日目暗黒の夜來る時、わが室の堅く閉せる戸を破り、　475又中庭の厚き壁、容易く越して、警戒の諸人並に奉仕せる女性の眼を掠め去り、逃れて遠く茫々のヘラスの郷を巡り行き、足駐めしは羊群の滿てる肥沃のプチーエー。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯くプチーエーの端を占め、＊ドロペス族を我統べぬ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "484　プチーエーの西に住む民族、こゝよりプォイニクスはミルミドネス五隊の一を率ゐ來る。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ友、君をそのむかしプチーエーより總帥の　765アガメムノーンに送るときメノイチオスは警めき、われ諸共にオヂュシュウス、その時共に室にゐて、彼が汝を警しめしその一切を耳にしき。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
