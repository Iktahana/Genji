              }
            },
            {
              "text": "二人の火星人はまるい頭をあげて、ひゅうひゅうぷくぷくと、喜びの声をあげた。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねこぬこタムは　ぷくぷく　ふとって　おおきくなっていましたので、　ボタンが　いくつも　はじけとんでしまって。",
              "citation": {
                "source": "ねこぬこタムのはなし",
                "author": "THE TALE OF TOM KITTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」なんて　しまりすさんが　いうもんだから、　つまさきチミーは　ぷくぷく　ふとるばかりで。",
              "citation": {
                "source": "つまさきチミーのはなし",
                "author": "THE TALE OF TIMMY TIPTOES",
                "note": "青空文庫"
              }
            },
            {
              "text": "じっさいあのまっしろなプクプクした、玉髄のやうな、玉あられのやうな、又｜蛋白石を刻んでこさへた葡萄の置物のやうな雲の峯は、誰の目にも立派に見えますが、蛙どもには殊にそれが見事なのです。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "じっさいあのまっしろなプクプクした、玉髄のような、玉あられのような、又蛋白石を刻んでこさえた葡萄の置物のような雲の峯は、誰の目にも立派に見えますが、蛙どもには殊にそれが見事なのです。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰌が時々プクプク浮いて泡を吹く。",
              "citation": {
                "source": "水籠",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "両側の狭い浅い溝には、襤縷片や葫蘿蔔の切端などがユラユラした※泥に沈んで、黝黒い水に毒茸の様な濁つた泡が、プクプク浮んで流れた。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙りが、今にも水泡になつてプクプクと浮き上ると水面で砕ける……そんな可笑しなことを想ひながら戯れ気に煙りを吹いては星を見上げた。",
              "citation": {
                "source": "痴想",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "プクプクとおもしろいようにわき出る血綿、血糊が、みるみる袴のすそを染め、板の間にひろがって、「わッ！",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "白いプクプクした小山の向うに、空と船が逆さに写っていた。",
              "citation": {
                "source": "風琴と魚の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "まんなかへんで、一生ケンメイ、プクプクともぐってみたが、蛇にでくわさない。",
              "citation": {
                "source": "織田信長",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "立派な壮年の大将となっても、冬空にフンドシ一つで、短刀くわえて、大蛇見物に池の中へプクプクもぐりこむ信長なのである。",
              "citation": {
                "source": "織田信長",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "汁などに入れて食べるが、軽くてプクプク浮いている。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
