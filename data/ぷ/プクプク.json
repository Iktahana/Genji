      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "bubblingly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "水槽の底にあるエアレーションから、ぷくぷくと絶え間なく泡が湧き出ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "鍋の底から小さな泡がぷくぷくと立ち上がり、スープが煮立ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "カニが口の周りでぷくぷくと白い泡を吹いているのを、子供が不思議そうに見ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ぷくぷくぷくと小さい泡の出るところがみつかる。",
              "citation": {
                "source": "空気ポンプ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「阿母さん」はぷくぷくした自分の下つ腹の辺を眺めて、逡巡してゐると、若い画家はにこ／＼しながら一寸｜愛相をいつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぷくぷくと黒い血が沸いたよ牛の血が！",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            },
            {
              "text": "君、『テエブル』が一畳敷もあろうかと思われる位大きくて、その上には青い織物が掛けてもあるし、肘突なんかもあるし、腰掛には空気枕のようなやつが付いてて、所長の留守に一寸乗って見ると――ぷくぷくしていて、工合のいいことと言ったら。",
              "citation": {
                "source": "藁草履",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "塚原あ――大人はみんなお内儀さんがあってな、そんでお前大人は、な、お内儀さんばっか可愛がってんだぞお……」　塚原は自分の瞼をぐいと操りあげ「野郎――」と罵りかえした、「八幡さまに手前のことを呪ってやるから、おぼえてろお…………」　順序も連絡もなくその子供らの考はぷくぷくと浮びあがった。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぷくぷく、ぷくぷく。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その叫び声のわけは、一向にわかりそうもないが、そのひゅうひゅう、ぷくぷくと言う声は、何か話をしているらしいことが、おぼろげながらわかった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひゅうひゅう、ぷくぷく。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳元では、例の通り、ひゅうひゅうぷくぷくと、火星の生物が、奇声を出しながらしきりに騒いでいた。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、ひゅうひゅうぷくぷくと言う声が、火星人の口から出ていないで、のどのあたりから出ていることだった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひゅうひゅうぷくぷくの声は、首と肩とのつぎ目のあたりから、もれて来るのであった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると下の方から、また例の、ひゅうひゅうぷくぷくと火星人の声がして、こっちへ近づいて来る様子なので、びっくりしてまたもとへ引返した。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の火星人はまるい頭をあげて、ひゅうひゅうぷくぷくと、喜びの声をあげた。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねこぬこタムは　ぷくぷく　ふとって　おおきくなっていましたので、　ボタンが　いくつも　はじけとんでしまって。",
              "citation": {
                "source": "ねこぬこタムのはなし",
                "author": "THE TALE OF TOM KITTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」なんて　しまりすさんが　いうもんだから、　つまさきチミーは　ぷくぷく　ふとるばかりで。",
              "citation": {
                "source": "つまさきチミーのはなし",
                "author": "THE TALE OF TIMMY TIPTOES",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "cute and chubby",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "生後半年になる姪っ子は、手足がぷくぷくしていて本当に愛らしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "栄養をたっぷり取って、すっかりぷくぷくに太った子犬が元気に走り回っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼女のぷくぷくとした柔らかいほっぺたを、思わず指でつつきたくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "Puku Puku",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔のゲームで、橋の上を歩いていると下からぷくぷくが飛び跳ねてくるステージがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "水中ステージでは、どこからともなく泳いでくるぷくぷくを避けるのが難しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "おやつの時間に、魚の形をした最中菓子のぷくぷくたいを子供と一緒に食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ぷくぷくぷくと小さい泡の出るところがみつかる。",
              "citation": {
