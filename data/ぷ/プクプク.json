[
  {
    "uuid": "2a597a26-c742-55a7-9151-a05c4ad28940",
    "entry": "ぷくぷく",
    "reading": {
      "primary": "ぷくぷく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
