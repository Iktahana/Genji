        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このスパークリングワインは、北イタリアで栽培されたグレラ種、かつてプロセッコと呼ばれていたブドウから作られています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "昔はブドウの品種名そのものがプロセッコでしたが、原産地呼称の保護のためにルールが変更されたんです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "地元の農家から、プロセッコ種のブドウ栽培に関する苦労話を聞くことができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
