          "literary": [
            {
              "text": "56　X 160.57　又プーリュダマスとも曰ふ、トロイアの名將。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかヘクトール陳ずれば、トロイア軍勢愚かにも　310贊じ叫べり、アテーネー彼らの心くらませり、將ヘクトール誤りて計るを彼ら譽め稱へ、叡智の言を宣んしたる＊プーリュダマスを喜ばず。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "313　プーリュダマス即ちポリュダマス、調のため原典に自由に用ふ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "城門の中に我もし今入らば、プーリュダマスは眞先に我を咎めむ、剛勇の　100アキルリュウスの起てる時、夜に乘じて城中に、＊トロイア軍を引くべしと彼は其時説きたりき、されども我は聽かざりき。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
