        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして、花見小路に最近出来た「京都プルニエ」で食事を済ませて、勘定を払おうとすると、財布がないことに気がついた。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「プルニエ」を出ると、やがて小郷と君勇は四条通りを歩いて、京極へ来た。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あてが払いました」「映画館へ行く前プルニエへ行ったんだろう」「へえ」「その金は……？",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "緑郎さんの送別会東京会館プルニエ。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論巴里のプルニエー、倫敦のスコツトなどに行けば、よい魚も食べられようが、安下宿住居の留學生などには其の勇氣はない。",
              "citation": {
                "source": "異國さかな雜談",
                "author": "濱田耕作",
                "note": "青空文庫"
              }
            },
            {
              "text": "プルニエのパンを賞めているのは、賛成。",
              "citation": {
                "source": "駄パンその他",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　と、なるほど、プルニエへ、パンだけお呉れと言って行くわけにも行かないだろう。",
              "citation": {
                "source": "駄パンその他",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京会館――そしてプルニエ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "プルニエへ食事に行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京会館のプルニエで三人で食事、白葡萄をのみたかったが一本でないと売らないのでビールをのむ、ビールてものゝまづさ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "プルニエで食事、ポタージュに舌平目洋酒蒸、チキンカレーライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "出て、プルニエへ歩く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "人参クリーム・スープをやり、次に、こゝのフィレソール・ボンファムを試みる、プルニエのと同じで、こっちの方が量が多いやうだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
