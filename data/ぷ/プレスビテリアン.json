          "literary": [
            {
              "text": "プレスビテリアンの中心たる此の都が、彼には悉く偽善の府と見えたのである。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも当市では、プレスビテリアン教会総会と芸術｜倶楽部と、都合二回講演をした。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "スコットランド国教宗、プレスビテリアン宗、メソジスト宗等これに属す。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "コングレゲーショナル宗、バプテスト宗、メソジスト宗、プレスビテリアン宗、ユニテリアン宗、クエーカー宗等は、みな非国教宗なり。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "スコットランド非国教宗には、フリー・チャーチとユナイテッド・プレスビテリアンの二宗あり。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つはメソジスト宗に属し、一つはプレスビテリアン宗に属す。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人は英国宗（チャーチ・オブ・イングランド）、一人はプレスビテリアン宗であるが、この二宗とも新教なれば、ともかくも一致ができる。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "一七三〇年頃にスコットランドのプレスビテリアン教会の牧師にジョン・グラスという人があった。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "大体の教義については、清教徒に近く、礼拝の形式においてはプレスビテリアンに似ている。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "プレスビテリアン Presbyterian.「フラザー雑誌」Fraser's Magazine.プリュッカー（人）〔Plu:cker.〕 ジリヤス・プリュッカー。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "それのみならず、米国より観光に来た紐育市第五街の有名なプレスビテリアン教会のピアソン牧師夫人を貧民窟に連れて来て、新見に紹介した。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイルランドのプレスビテリアン牧師の子として生まれ幼児のときにニュージランドに渡り、ウィルミントンの病院の外科医となり、ボア戦争、第１次、第２次世界大戦に軍に参加し、病院の管理者、医学雑誌の編集者、小説著者、ペン・クラブ会長などもしていて、医学史専門家ではありません。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
