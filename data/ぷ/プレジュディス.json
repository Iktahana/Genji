          "literary": [
            {
              "text": "腹が立っても、どうする事もできないところへ、こういう境遇に置かれてプレジュディスのめがねの焦点になっては全くやるせがない。",
              "citation": {
                "source": "解かれた象",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも保子さんが私に持っていらっしゃるプレジュディスはかなり根深いものであるかも知れませんけれども、この私のシンセリティとそれとがどちらが力強いものであるかを見たい気も致します。",
              "citation": {
                "source": "男女関係について",
                "author": "女房に与えて彼女に対する一情婦の心情を語る文",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は、まるでプレジュディスも何もない愛と歓とを彼のため、彼の周囲、並、日本のために感じずには居られない。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            }
          ]
        }
