        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかもその窓硝子を外から締め合わせたとなると、この婦人は女賊プロテアそっちのけの身軽だといわなければならない」　これには大寺警部も、すぐに応える言葉を知らなかった。",
              "citation": {
                "source": "地獄の使者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにはともあれ少年の頃にあこがれに胸をときめかした「プロテア」の主演女優の名を夢声さんに聞かねばすまないような気がするではありませんか。",
              "citation": {
                "source": "私の洋画経歴",
                "author": "小野佐世男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「プロテア」の上映も恐らく同じころだつたらう、黒い海水着のやうなものを着た明眸の女探偵（だつたらう）が、屋根から屋根を這ひ廻つた。",
              "citation": {
                "source": "大正東京錦絵",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "（四）プロテアス及びトライトンを指す、有名なる“The World is too much with us”の歌を見よ。",
              "citation": {
                "source": "天地有情",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "三葉三四郎が編纂した『世界映画史』の口絵写真にある、今から四十年まえに大人気を博した女賊映画の主人公プロテアのような姿の美女であった。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その胸の上に、かっこうのよい長い首と、プロテアの顔がついていた。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロテアの美女は、横倒しになった醜悪なけだものを見おろして、嫣然と笑った。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
