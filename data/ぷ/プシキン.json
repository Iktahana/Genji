          "literary": [
            {
              "text": "自分はプシキンの「大尉の娘」を讀んで居る。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "感嘆する實に感嘆する流石にプシキンだ。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "プシキンは死に先つて非常に苦痛を感じ、不幸なるハイネは數年間中風に罹つて臥してゐた。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "プシキンは死に先って非常に苦痛を感じ、不幸なるハイネは数年間中風に罹って臥していた。",
