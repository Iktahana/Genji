        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アイヌの「ヌプリ」は「登り」に通じ、山頂を意味する「タプカ」も「峠（タウゲ）」に少し似ている。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなふうにして、水の中で死ぬことは、この国の語ではエップカップと云いました。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "広っぱがあって、それからが、プカプカドンドンだ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "立て膝の蹴出しも淫らがましく、プカリプカリと長煙管を操っていた、あの許し難き女スリでした。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯気水の中に、出がらしの茶の葉がプカプカと浮いてるじゃねえか。",
              "citation": {
                "source": "右門捕物帖",
                "author": "袈裟切り太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "法水はプカプカ莨を灰にしながら、黙考に耽けっていたが、熊城は絶えず揉手をしながら、悦に入っていた。",
              "citation": {
                "source": "オフェリヤ殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "書きくたびれるとスリッパのまま、廻転椅子の上に座り込んで、膝を抱えながらプカリプカリと、ウルトラマリンや、ガムボージ色の煙を吐き出す。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "船長は平気でコバルト色の煙をプカプカやり出した。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今度は霧が早く来たようだね」「すぐ近くに氷山がプカプカやっているんじゃねえかな。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし真中の鬚男だけは、なおも金口煙草に気を取られているらしく片眼をつぶって、唇を横すじかいにしいしいプカプカと紫色の煙を吸い味わっていた。",
              "citation": {
                "source": "老巡査",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "困ったことだ」　とお父さんはふりかえりながら言って、口に啣えたきせるから煙をプカプカ吹かされました。",
              "citation": {
                "source": "雨ふり坊主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿屋の主人が表に来て見ますと、無茶先生は相変らずパイプを啣えながらプカリプカリと煙を吹かしています。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「煽がないだつて好いのよ、何か手に持つてゐなければ格構がつかないわよ、煙草ばかりプカ／＼喫されてゐるのも困るからね。",
              "citation": {
                "source": "小川の流れ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああではないか、こうではないかと、いくら頭の中で考えてみても、さっぱり合点がゆかず、しょうことなしに彼は煙草ばかりプカプカ喫かしながら、夕飯までずっとそこに坐りこんでいた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
