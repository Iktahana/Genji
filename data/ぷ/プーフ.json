        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アマリヤはたまりかねてすぐにまたもや、『わたしの父はベルリンでもたいへん、たいへん偉い人で、両手をポケットに入れて回っていた、そしていつもこんな風に――プーフ！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに、自分の父親をいっそうまざまざと現わして見せるために、椅子からおどり上がって、両手をポケットに突っ込み、頬をふくらませて、プーフ！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "プーフという音に似るように、口で何かあいまいな響きを出し始めた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマリヤはえびのように赤くなって、それは多分、カチェリーナこそ『まるで父がなかったろうが、わたしの父はアウス・ベルリンあって、こんなに長いフロックを着込み、始終プーフ、プーフ、プーフやっていた』と金切り声を立てた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
