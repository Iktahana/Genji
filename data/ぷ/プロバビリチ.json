        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ところで機因は、宇宙の因果律が構成するところの、複雜微妙極みなきプロバビリチイの數學から割り出される。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "意志の力と自由によつて、宇宙が自分に都合よく、プロバビリチイの骰子の目が、思ひ通りに出ることを信じてゐる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、近所のＡ家の猫と宅の猫との血族関係に関しては幾分のプロバビリチが出来ていた訳である。",
              "citation": {
                "source": "ある探偵事件",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは恐然の法則、プロバビリチイの法則と云ふものを知らないからだ。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の眼には、彼の足の下に後から後から現われて来る線路の枕木の間ごとに変化して行く礫石の群れの特徴が、ずっと前に研究しかけたまま忘れかけている函数論や、プロバビリチーの証明そのもののように見えて来た。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
