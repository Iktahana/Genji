[
  {
    "uuid": "f1a8a699-9b23-52c7-bd18-06d2861907be",
    "entry": "プリプリ",
    "reading": {
      "primary": "プリプリ",
      "alternatives": [
        "ぷりぷり",
        "ぶりぶり",
        "ブリブリ"
      ],
      "is_heteronym": false
    },
    "grammar": {
