        "動詞-サ変"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "angrily",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "デートに30分も遅刻してしまったため、彼女は腕を組んでプリプリと怒っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「もう、私のプリン勝手に食べたでしょ！」と妹がプリプリしながらリビングに入ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "会議で自分の提案が通らず、彼は終始プリプリした態度で周りに八つ当たりをしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "プリプリしながら、だがその晩は七時にはお湯屋に行き、目覚時計を四時に掛けて八時には床に這入つた。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "女のふくろふにはおろおろ泣いてゐるのもありましたし、男のふくろふはもうとても斯うしてゐられないといふやうにプリプリしてゐました。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女のふくろうにはおろおろ泣いているのもありましたし、男のふくろうはもうとても斯うしていられないというようにプリプリしていました。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」いたちはプリプリして、金米糖を投げ出しました。",
              "citation": {
                "source": "ツェねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたはめくらぶどうさんでしょう」　めくらぶどうは、まるでぶなの木の葉のようにプリプリふるえて輝いて、いきがせわしくて思うように物が言えませんでした。",
              "citation": {
                "source": "めくらぶどうと虹",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　少女のギルダは、まるでぶなの木の葉のようにプリプリふるえて輝いて、いきがせわしくて思うように物が云えない。",
              "citation": {
                "source": "マリヴロンと少女",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "返事をしないでプリプリ怒ってやろうかとも思うのだが、なにせ相手は柔道四段だそうだから、やはり怖い。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもあとお茶をすすり、爪楊子を使うとは、若気の至りか、厚顔しいのか、ともあれ色気も何もあったものではなく、Ｋはプリプリ怒り出して、それが原因でかなり見るべきところのあったその恋も無残に破れてしまったのである。",
              "citation": {
                "source": "大阪発見",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな思いをしているのに、真琴ちゃんは一人音楽をのん気なかおして聞いているなんて、ほんとにあんまりと、プリプリ内心怒っておりましたの。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（陸中）　そのお月様は、紅いのに桃色だと云つたとて、プリプリ怒つたのもあります。",
              "citation": {
                "source": "お月さまいくつ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "士官は汗をふきながら、プリプリして、「後で主計が廻ってくるんだから、その時申告すれアいいんだ。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　　　　　七之助の手紙　畑から帰ってくると、母親がプリプリ怒っている。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローラ嬢の立腹　その日、お昼が近くなったというのに、ドン助が帰ってこないので、足立支配人はプンプンの大プリプリに怒っていた。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺という支配人が居るのに、東京ビルの主任だなんて新聞にいいやがって、怪しからん奴だ」　プリプリと足立支配人は怒りながら、向うへいってしまった。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし内臓はなんとなく内部から外方へプリプリと飛び出してきたような感じがした。",
              "citation": {
                "source": "人体解剖を看るの記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、彼はプリプリしながら呟やいた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "エヘヘヘヘヘ……」　と冷やかし笑いをして見せたら、試験官の奴、塩っぱい面をして睨み付けたと思うと、プリプリして出て行きおった。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はる子さんぐらいになったら、病気手当ぐらい貰えたっていいわね」「そんなもん、会社が出すもんですか」　依田とよ子がいつもになくプリプリした口調でミサ子に云った。",
              "citation": {
                "source": "舗道",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに、あなた達はパンツ一枚なのですから、太股の紅潮した筋肉が張りきって、プリプリ律動するのがみえ、ぼくはすっかり駄目になり、ほうほうの態で、退却したことがあります。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑う人の気がしれないって一人でプリプリして居る。",
              "citation": {
                "source": "つぼみ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お水でも……」「水か、いや、それには及ばぬ」「ではお茶でも、ホ、ホ」　その女は、プリプリしているお侍さんを、からかってやろうというような様子を、見せはじめましてございます。",
              "citation": {
                "source": "怪しの者",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、オバアサンハプリプリシテ、マドノソトヲミマシタラ、キンジヨノミケ子トトラ三ガ、ランニングヲシテヰマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トプリプリシテ、オダイドコロヘオリテユキマシタガ、マダ、オシタクガデキテヰマセン。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（プリプリして出て行く）ふみ　まあ。",
              "citation": {
                "source": "女の一生",
                "author": "五幕七場",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大蘆原軍医殿は、この栄螺の内臓を珍重されるようだが、僕はこんな味のものだとは、今日の今日まで知らなかった」と、星宮理学士は、長い箸を器用に使って、黄色味がかったプリプリするものを挾みあげると、ヒョイと口の中に抛りこんで、ムシャムシャと甘味そうに喰べた。",
              "citation": {
                "source": "恐しき通夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と　プリプリして、ことわりました。",
              "citation": {
                "source": "きりぎりす　の　かひもの",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、プリプリして、どなりつけました。",
              "citation": {
                "source": "きんまくわ",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時七斤ねえさんは飯籃をさげて卓の側に行き、卓上に飯籃を投げ卸してプリプリ腹を立てた。",
              "citation": {
                "source": "風波",
                "author": "魯迅",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
