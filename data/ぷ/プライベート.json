        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ハワイの高級リゾートホテルで、誰にも邪魔されないプライベートなビーチを満喫した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "大切な商談だったので、周囲の視線が気にならないレストランのプライベートな個室を予約しておいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "資産家である彼は、週末になると所有するプライベートなクルーザーで海釣りを楽しんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ことにあの手紙のなかには、僕のプライベートな、したがって親しきものへのほかは秘密にしておきたいような部分をも含んでいるのですから。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お客様を前にしたコンサートでさえこういうわがままなのですから、お客様の居ないところ、プライベートの生活は大変なわがままでまわりの人はずいぶん手古摺らされたものです。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のプライベートな部屋へ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここは奥まった雅座――プライベート・ルームの一室である。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "パブリックなスペースから廊下を曲がりながら奥へと入っていくと、そこはいつのまにかプライベートなスペースだ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パブリックなスペースとプライベートなスペースとを、区切ると同時につないでもいるのがこの廊下だ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "23　そのホテルのプライベート・ビーチに接してすぐわきに、万能のダイニング・ルームがある。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな天才生活時代の前生涯と、今のプライヴェート生活のような親密な性情と両面持っている……」　かの女とむす子がプライヴェートな会話に落ちこんでいると見たらしく、アルトゥールは非常に軽快なアクセントで、他の連中に講演口調で喋っていた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくストランドのプライヴェート・ホテルに寝泊まりし、無味乾燥な生活を送り、金銭を湯水の如く使っていた。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今朝六時頃、ハリデイ・プライヴェート・ホテルで殺害されました。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝も早くから始めて、八時にリトル・ジョージ街のハリデイ・プライヴェート・ホテルに行き着きまして。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう言われては秘書もやってられるかと匙を投げ、終電を逃したらハリデイ・プライヴェート・ホテルで合流という取り付けだけをしました。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ハリデイ・プライヴェート・ホテルだ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつの宿泊先がハリデイ・プライヴェート・ホテルなのはわかってましたから、一日じゅう待ち伏せしたのですが、やつは一向出てきません。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "学課についてでも、課外の読書に関してでも、或はもっとプライヴェートな相談でも、他に障害を来さない程度で、指導をいとわれなかった。",
              "citation": {
                "source": "弟子の心",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、Ａ啓明会とプライヴェートの金の勘定を混同し、手伝い、くさくさしたので一寸散歩に出、シャロッテ・ブロンテの Jane Eyre を70銭で買って来る。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんどの仕事にプライヴェート・シュレンが役に立つ。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の結婚だの姙娠だのという人間の女に関することは、勤務とは別の、患者のかかわりしらない、彼女だけの問題――プライヴェート・アフェアだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はＫ君の心持は解つてる積りだが、もし忠告する事があるとしても、もつとプライヴェートにする方がいゝと思ふ。",
              "citation": {
                "source": "良友悪友",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝは役所だ」「でも、プライヴェートのお部屋じやございません？",
              "citation": {
                "source": "火の扉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ちなみにこの遮蔽法は男女間の或るプライヴェートな交渉の場合にも、当分のあひだ適用を許されてゐる。",
              "citation": {
                "source": "わが心の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "十四年に宗教団体法が通過して、いいひとたちがあまり苦しめられるので、腹がたって、内側へ入って緩和してやれと思って、三菱をやめて、文部省の宗教局の属になったもんですが、公的には迫害する役、私的には緩和する役、公式とプライヴェートの使いわけで、これ以上あぶない芸当はない。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "米本国のことはいざ知らず、比島の野戦陣地では、将校も、下士官も、プライヴェート〔兵〕も、まったく同じ食物である。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが本当のデモクラシーだと思っていたが、プライヴェートにすれば、同じ鶏にしても、将校にばかり胸の白い肉や脚の赤い肉が行くと、ひがむのであろう。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "心の交感としての手稿文化が元となって、やがてそこが作品の源泉となるわけですが、もちろんプライヴェートなものと、公へと送る出版とは受け手が異なり、作品もその変化に合わせて書き直されることになります。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに〈その場にじっと〉→〈妹がはなれた〉、〈アリス〉→〈妹〉という記述の変化も、視点の問題として、『地底』では姉という登場人物にプライヴェートな同一視をしていたのが、『不思議』では彼女に少し距離を取ったような推敲になっているとも読み取れます。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "本来は居間ではないのだが、食事を終わったあとにくつろぐ場所として、ごくプライヴェートな居間のように整えた部屋だった。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "相客はさすがに閉口なので、「プライヴェートルームを頼む」といったら、窓のない真暗な部屋へ案内してくれた。",
              "citation": {
                "source": "アラスカ通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀座の全線座へ、「コンドル」が始まるところ、樋口のプライヴェート室で、一人ゆう／＼と見物。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "弘一路と二人、雑誌新体制の結末の話から、その他のプライヴェート話をする。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
