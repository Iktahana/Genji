          "literary": [
            {
              "text": "またプウレオウリか。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたのプウレオウリ、思い出すわ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼がパリのレストランで、毎日毎食、プウレ・オ・リ（若鶏の肉に米の飯をあしらつた料理）ばかりとつて、これを無上の珍味なりとしたといふ逸話は、まことに横光君らしい、さもありさうな事実である。",
              "citation": {
                "source": "横光君の印象",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（笑声起る）　ミルラン君――作中の一人物、プウレットが、その朋輩の女エリザに向つてかう云ひます。",
              "citation": {
                "source": "仏国議会に於ける脚本検閲問題",
                "author": "――ゴンクウルの『娼婦エリザ』――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「世間にいくらだつてゐる、あの亭主持ちの女と、一体どう違ふんだい……亭主を持ちながら、それが不足でいろんなことをする女とさ、……」それから、最後の一ヶ所は、プウレットが、「見ておやりよ、この色気狂ひをさ……」と云ふと、エリザが「あらさうぢやないんだよ……。",
              "citation": {
                "source": "仏国議会に於ける脚本検閲問題",
                "author": "――ゴンクウルの『娼婦エリザ』――",
                "note": "青空文庫"
              }
            },
            {
              "text": "互に名を呼び合ふのでありますが、その名は、「頬張月」「エリザ」「プウレット」、それから「ぶつた斬りのマリイ」　会話が交換されます。",
              "citation": {
                "source": "仏国議会に於ける脚本検閲問題",
                "author": "――ゴンクウルの『娼婦エリザ』――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの人のためになら、からだをコマ切りにされてもいいよ」エリザがかう云ふと、先程ミルラン君も引用されたとほり、今度はプウレットが、「こいつあ、をかしいや。",
              "citation": {
                "source": "仏国議会に於ける脚本検閲問題",
                "author": "――ゴンクウルの『娼婦エリザ』――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしんとこなんかへ来ると、あの人が汚れるつていふ気がするの……」するとプウレットが、「ちえツ、およしつたら、くだらない理窟は……。",
              "citation": {
                "source": "仏国議会に於ける脚本検閲問題",
                "author": "――ゴンクウルの『娼婦エリザ』――",
                "note": "青空文庫"
              }
            },
            {
              "text": "七時の顔見世に遅れちや駄目だよ」　プウレット。",
              "citation": {
                "source": "仏国議会に於ける脚本検閲問題",
                "author": "――ゴンクウルの『娼婦エリザ』――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
