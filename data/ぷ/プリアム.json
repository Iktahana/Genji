        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "此パリス、実は「トロヤ」王プリアムスの子なるも、其母ヘカーベの悪夢を夢みし結果として、「イダ」の山へ棄てられし者なり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "其後久しからずして、プリアムスの命令によりて、「トロヤ」の王都に競技の大会あり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "火災がプリアムの宮殿をのみ尽くさないうちに、祖国の宝を炎から取り出そうではないか……。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
