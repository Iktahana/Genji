        "examples": {
          "standard": [
            {
              "text": "隣の部屋の話し声が筒抜けになるこのアパートでは、プライバシーの確保なんて到底望めない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "有名人のスキャンダルを過剰に報道する一部のメディアの姿勢は、明らかなプライバシーの侵害にあたる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "病院の診察室では、患者のプライバシーに配慮して名前ではなく受付番号で呼び出すシステムが導入されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "家は充分な空間を持っていて住んでいる人たちに充分の空気とプライバシーを供給することが必要である。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし問題の解決にはほど遠く、高い家賃を払っている中程度の人たちも都市のアパートに群がりプライバシーが無く近所のラジオなどの野蛮な音で絶えず悩まされている。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが当時の文化人であり婆娑羅な氏は「君はわしのプライバシーをおかしたものとして訴える」なんて顔はどこにもしていない。",
              "citation": {
                "source": "随筆　私本太平記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来、所謂「上流社会」は「下層社会」に較べて、有産者らしい便宜や名誉のおかげで、生活のプライヴァシーが遙かに厚く社会的に保護されているから、有閑マダムのプライヴァシーを曝くということは、下層社会のお神さん連の公的な風紀壊乱を指摘するのと全く同じ水準の社会取締り方針にぞくする。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
