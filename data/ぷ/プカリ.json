    "definitions": [
      {
        "index": 1,
        "gloss": "puffing (e.g. cigarette smoke)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "縁側に座った祖父は、満足げに煙草をぷかりと吹かした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は深く息を吸い込むと、紫色の煙をぷかりと空に向かって吐き出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "焚き火の煙が、風のない夜空にぷかりぷかりと立ち昇っていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "青くぬった、木の足のおかげで、ぷかり、ぷかりと、波のまにまに、浮んでいたのです。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "それほどに茂作は、煙草が大好物で朝から晩まで、一日中、ぷかり／＼と煙草を吸つてをりました。",
              "citation": {
                "source": "小熊秀雄全集-14",
                "author": "童話集",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちらりと見ると、岸にのぞんだ大きな柳の陰に、だれを乗せてきたのか、だれを待っているのか、こざっぱりとした伝馬が一艘やはりつながれてあって、六十がらみの日にやけた船頭が、ぷかりぷかりとのどかになた豆ギセルから紫の煙を吐いているのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうですか」　藤枝はこう云つてぷかりと煙を輪にふいた。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてぷかりぷかりと夜長を吹かす。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして自分は真白なターバンをぐるぐる頭へ巻きつけて、広いヴェランダに据えつけてある籐椅子の上に寝そべりながら、強い香のハヴァナをぷかりぷかりと鷹揚に吹かす気でいた。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "じっと見つめていると真っ暗な闇のなかにしゃぼん玉のような五色の泡がいくつもぷかりぷかりと湧きあがってくるように思った。",
              "citation": {
                "source": "抱茗荷の説",
                "author": "山本禾太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずいぶん長くたってから立ち上ると、両腕を伸したり曲げたり、体操のまねみたいなことをやり、二三度でぐったりして、また湯にはいり、頸筋を湯壺のふちにもたせて、仰向にぷかりと、死人のように浮いていました。",
              "citation": {
                "source": "女と帽子",
                "author": "――「小悪魔の記録」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな腹がぷかりぷかりと水に揺られて、向うへ流れて行った。",
              "citation": {
                "source": "金魚",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "空には、夢のように、阻塞気球が、ぷかりぷかりと浮んでいた。",
              "citation": {
                "source": "英本土上陸戦の前夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつまでいつまで、ぷかりぷかり煙草ばかり喫んでけつかって……」「いま考えていっとこだ。",
              "citation": {
                "source": "おびとき",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、その土は一足一足毎にぷかり／＼と舞ひ立ち、むつとした草いきれと一緒に、脛から股から胸から顏へ匍ひ上り、たく／＼流れる汗へ飛びついて來る。",
              "citation": {
                "source": "旱天實景",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあひだの掘割に、机や小箱などが、ぷかりぷかり浮いてゐるのが物珍らしかつた。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぷかりぷかりと煙が出た。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "立て膝の蹴出しも淫らがましく、プカリプカリと長煙管を操っていた、あの許し難き女スリでした。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "書きくたびれるとスリッパのまま、廻転椅子の上に座り込んで、膝を抱えながらプカリプカリと、ウルトラマリンや、ガムボージ色の煙を吐き出す。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿屋の主人が表に来て見ますと、無茶先生は相変らずパイプを啣えながらプカリプカリと煙を吹かしています。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、あのように完全に、あのように堂々と行われるべきである」　彼はプカリとシガーの煙をはいた。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからの彼はプカリプカリと煙草を吐くばかりで、一言も発しない。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実におそるべき天才だとね」　藤枝はいい終ると、一向感情を動かしたようすもなくすまして天井に向つてプカリと煙を吐いた。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで何事か判らないが、おどろいて、そのまま逃走した、とまあこういうのです」　警部は語り続けて、プカリと朝日の煙を吐いた。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで、第二の惨劇の説明ができたつもりなんだが」　プカリと煙を吹いて藤枝は一座を見廻した。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まずそれを充分に承りたいものだね」　奥山検事が朝日をプカリプカリとふかしながら、勢いのいい声で云つた。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "撫で肩に自棄に引っかけた丹前、ほのかに白粉の移っている黒｜襟……片膝立てた肉置もむつちりと去りかけた女盛りの余香をここにとどめている景色――むらさきいろの煙草の輪が、午さがりの陽光のなかをプカリプカリと棚の縁起物にからんで。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸州浪人の茨右近という男、これが、その、よろず喧嘩買い入れの喧嘩師で、叩くとかあんと音のしそうな、江戸前の生のいい姐御がひとり、お約束の立て膝に朱羅宇の長煙管、その喧嘩渡世の長火鉢のむこうで、プカアリ、プカリたばこをふかしていようという――知らずのお絃。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "燐寸を擦って火を点けると、スパスパと性急に吸いつけてから、背中をグッタリと椅子に凭れかけ、あとはプカリプカリと紫の煙を空間に噴いた。",
              "citation": {
                "source": "蠅",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "総同盟系が何しろ五万というからね」　煙草をプカリ、プカリと吹き、「五万の人間がワーッと動き出せば、放っても置かれまいじゃないですか」　それだけ云って、あとは煙草を指に挾んだままの腕組みで凝っと横目に私の顔を眺める。",
              "citation": {
                "source": "刻々",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二升もはいる大｜薬缶ほどの、鈍く光ったものが、地の上二、三尺の高さで、プカリプカリと流れていった。",
              "citation": {
                "source": "牢屋の原",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙草を買って行こうとその店へ面を突っ込んで見ると、そこの店先に腰をかけてプカリプカリ煙草をふかしているのが右の小間物屋です。",
              "citation": {
                "source": "大菩薩峠",
                "author": "壬生と島原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "八五郎はその顏を眺め乍ら、プカリプカリと所謂山吹色の國分の煙を輪に吹いて居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "百足屋殺し",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
