        "examples": {
          "standard": [
            {
              "text": "湖の真ん中で、赤い浮き輪がぽつんとぷかりと浮かんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "お風呂の底からおもちゃのアヒルがぷかりと顔を出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "海面を漂う流木が、波に合わせてぷかりぷかりと揺れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
