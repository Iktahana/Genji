        "examples": {
          "standard": [
            {
              "text": "劇場の改修工事により、舞台と客席を隔てるプロセニアムの装飾がより豪華なものに生まれ変わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "プロセニアム型の劇場では、観客はまるで額縁を通して演劇を見ているかのような感覚になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "演出の都合上、役者がプロセニアムを飛び出して客席の通路を走り抜けるシーンが用意されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "――プロセニウムに近く、炬燵に向ひ合つて、文六とおせい。",
              "citation": {
                "source": "遂に「知らん」文六（三場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "灰色の壁の低い空を思はせる陰鬱さもさることながら、アーチ形のプロセニウムが階段でオルケストルにつながつてゐる、その冷たく重い線のなかに、僕は、もう、「北方」を感じて、思はず肩をすぼめてしまつた。",
              "citation": {
                "source": "芝居と僕",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロセニウムにはボエックリンの半身像円柱の上に立つ。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロセニウムはしばし暗きままに止る。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "コポオは、これを呼んで「常設舞台」（セーヌ・ペルマナント）と言い、プロセニウムの客席に通じる半円形の階段とともに、彼の目指す「演劇の再演劇化」を象徴するものとさえなったのです。",
              "citation": {
                "source": "あるニュウ・フェイスへの手紙",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じく右手、プロセニウムに近く、事務所の出入口。",
              "citation": {
                "source": "浅間山",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手、プロセニウムに近く、書棚を背にして塾長用のデスク。",
              "citation": {
                "source": "速水女塾",
                "author": "四幕と声のみの一場よりなる喜劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
