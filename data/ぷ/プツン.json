[
  {
    "uuid": "2b5c073b-fb42-5efa-b19a-fd6e195df8a4",
    "entry": "プツン",
    "reading": {
      "primary": "プツン",
      "alternatives": [
        "ぷつん"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞-と"
      ],
