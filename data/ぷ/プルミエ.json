        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "約束をして置いたら寝坊の九｜里が遠方のカンパン・プルミエのアトリエから朝早く遺つて来た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、カンパン・プルミエの徳永さんの画室まで歩いて行つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "我髪梳きて口そそぎ枕に就き候とき、君は未だカンパン・プルミエにある人人の画室に語り興じ居給ふらん、あるはパンテオンのキヤツフエに寒ければとてアメリカンなど飲みて居給ふらん、ピガルの広場の前の例の家の伊太利亜少女の楽人にや聞きほれて居給ふらん。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、カンパン・プルミエの徳永さんの畫室まで歩いて行つた。",
              "citation": {
                "source": "巴里の獨立祭",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ、シャンパアニュ・プルミエェル街十七番地にささやかなアトリエを構へた。",
              "citation": {
                "source": "一插話",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月、巴里に出でカムパアニュ・プルミエェル街に居を構ふ。",
              "citation": {
                "source": "リルケ年譜",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "再びカムパアユニュ・プルミエェル街に住す。",
              "citation": {
                "source": "リルケ年譜",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
