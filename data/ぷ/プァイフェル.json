        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マダム・プァイフェル〔一七九七―一八五六年、オーストリアの旅行家〕が東から西にかけて彼女の冒険的な世界周遊をした際、アジア領ロシアまで彼女の故国に近づいたときに、当局者に会いに行く段になって彼女はいつもの旅行着でないものを着る必要を感じた、といっている。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には、音楽長トビアス・プァイフェルの代わりをした。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その別荘はトビアス・プァイフェルの所有で、町から一時間ばかりの距離にあった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一楽長のトビアス・プァイフェルは、遠からず隠退することになっていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
