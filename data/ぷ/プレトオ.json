          "literary": [
            {
              "text": "自分も牛津大学在学時代にプレトオを読まされたが、今は楽しみとして折々これを開くことがある。",
              "citation": {
                "source": "趣味としての読書",
                "author": "平田禿木",
                "note": "青空文庫"
              }
            },
            {
              "text": "プレトオには到底他の哲人に見出し得ざる快楽を自分に供してくれると云つてゐる。",
              "citation": {
                "source": "趣味としての読書",
                "author": "平田禿木",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、ソクラテスとプレトオをも教師だったなどと云うのは、――保吉は爾来スタアレット氏に慇懃なる友情を尽すことにした。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
