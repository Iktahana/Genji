        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「まあまあ、なんてお馬鹿さんなの、プレドポスィロフ！",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「私は請合いますがね、そんな入れ知惠をしたのは、あの――なんとか言ったっけ――あのプレドポスィロフでしょう？",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかにも御察しのとおりです――これはプレドポスィロフの思いつきなんです。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなぼやぼやしたことを仰しゃると、あのプレドポスィロフにずばりと切って捨てられますぜ。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たちは三本も倒しちまったんですよ、もっともプレドポスィロフも一緒でしたがねえ。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
