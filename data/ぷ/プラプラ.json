        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大学を卒業してからも定職に就かず、実家でぷらぷらしている弟が心配だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「いつまでもぷらぷらしてないで、そろそろ本気で就活しなさい」と母に叱られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "宝くじが当たったら、南の島で毎日ぷらぷらして暮らしたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
