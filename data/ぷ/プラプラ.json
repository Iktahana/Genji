        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ランドセルの横にぶら下げた防犯ブザーが、走るたびにぷらぷらと揺れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "取れかけのボタンが一日中ぷらぷらしていて、気になって仕事に集中できなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "赤ちゃんの足がベビーサークルからぷらぷらとはみ出しているのが可愛らしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "詩集はぷらぷらしましたがなかなかそれで落ちませんでした。",
              "citation": {
                "source": "土神と狐",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まっ赤な花がぷらぷらゆれて光っています。",
              "citation": {
                "source": "チュウリップの幻術",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鋼砥の上で金鋼砂がじゃりじゃり云いチュウリップはぷらぷらゆれ、陽がまた降って赤い花は光ります。",
              "citation": {
                "source": "チュウリップの幻術",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "欧洲から日本へ、日本から欧洲へと往復するにもただプラプラと青い尻尾さえ引摺れば済むのだから、今の若い日本の画家等にとっては大変な福音なのだ。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い朴歯の足駄をはいた太短い足が地上二三寸のところでプラプラしていた。",
              "citation": {
                "source": "一寸法師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "(walking) leisurely",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
