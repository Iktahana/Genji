          "literary": [
            {
              "text": "さて周囲の御婦人にビールを差し、その都度、プロヂットとか、チェリオとか、乾盃し、多忙である。",
              "citation": {
                "source": "風人録",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、隣席の客をつかまへて迎へうち、自分の席へ拉し来り、又隣席へ割りこんで、談論風発、カラ／＼と笑ひ、ビールをつぎ、プロヂット、チェリオ、間断なく乾盃してゐる。",
              "citation": {
                "source": "風人録",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、サンボアへ呼び、ウイスキソーダでプロヂットする。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
