        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "絵筆をとって肖像を描いたら、＊３プロメシュースだ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "手もなくプロメシュースそっくりだ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊３　プロメシュース　ギリシャ神話の神。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギリシャ神話の中にプロメシュースの神話というのがあります。",
              "citation": {
                "source": "幸福について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、火の起源の話ですが、プロメシュースという若者が人間の生活に火が必要だと考え、天上の神様の火を盗んでまいりました。",
              "citation": {
                "source": "幸福について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間が火を得たということは人間の社会の発達のために、大きな歴史であったわけですが、それを、ギリシャ神話では、プロメシュースが火を盗んで来たという具合に話しているわけです。",
              "citation": {
                "source": "幸福について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "このプロメシュースの話は、私たちにとって興味もあるし、昔から沢山の芸術の材料になっております。",
              "citation": {
                "source": "幸福について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルリンのプロメシュースが制作したのだ。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "民衆をして、プロメシュースの火の薪たらしむることであった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アスパジアは実に、プロメシュースに女が必要である場合には、その用をなすために作られたようなものであった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "縛られたるプロメシュース（訳者注　アイスキロスの戯曲、火を盗みてジュピテルより岩に縛られし所を取り扱えるもの）は事を始め、アリストゲイトン（訳者注　ハルモディオスと共にヒッパルコスをくつがえせし者）は事を終える。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
