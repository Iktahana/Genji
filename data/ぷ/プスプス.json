[
  {
    "uuid": "b6472a66-adba-5e2b-88a0-ffe59bc70001",
    "entry": "ぷすぷす",
    "reading": {
      "primary": "ぷすぷす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三郎はその支那の君子人の言葉を水洟すすりあげながら呟き呟き、部屋部屋の柱や壁の釘をぷすぷすと抜いて歩いた。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "背後の村には燃えさしの家が、ぷすぷす燻り、人を焼く、あの火葬場のような悪臭が、部隊を追っかけるようにどこまでも流れ拡がってついてきた。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一本のマッチを摩ったのが、ぷすぷすといって燃え上がった時、隅の方でこんなことをいうのが聞えた。",
              "citation": {
                "source": "白",
                "author": "リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "中に火気が籠っていて、落ちた石が触れる縁板はぷすぷす煙を立てた。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は腫れものに触るように庸三を取り扱ったが、ぷすぷす燻る憎悪の念をどうすることもできなかった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "海法師海地獄などへも、私は観音寺で出来た連と一緒の乗物で見に行つたものだが、其の辺は一体に田圃や流れのなかからもぷすぷす硫黄くさい烟が立つてゐた。",
              "citation": {
                "source": "佗しい放浪の旅",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇はそれらの者たちから、「お髪をつかめばお髪がはなれ、玉の緒もお召物も、みんなぷすぷす切れて、とうとうおとりにがし申しました」とお聞きになりますと、それはそれはたいそうお悔みになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして博士は、自暴自棄的に、死体の各部へぷすぷすとメスを入れるのであった。",
              "citation": {
                "source": "三稜鏡",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "灰のなかからぷすぷすと煙がいぶり出して来た。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由主義は、ぷすぷす矢を突き立てられる的となり、それ自体の混濁した鍛錬をもって、思想の母体を守護していく。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぷすぷす槍襖の突き立っている中へ帰るのも、勇気は出るものだ。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "子は室へは入って障子の片端を胸に押しつけると、指を舐めてぷすぷすと幾つも障子に穴をあけた。",
              "citation": {
                "source": "火",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "不安な、第三期の戦争の気配すらぷすぷすいぶつてゐる。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "灰と瓦と、まだぷすぷすとくすぶっている焼け棒くいの銀座である。",
              "citation": {
                "source": "一坪館",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、まだぷすぷすと、煙のあがっているビルもある。",
              "citation": {
                "source": "一坪館",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういうわけか、その途中で、人造人間のからだが、ぷすぷす燃えだした。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "散らばった幟の破片、まだぷすぷすといぶっている木材、なにを見ても胸がせまる。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おや上官、麻綱がぷすぷすくすぶりだしましたぞ」「なんだ、麻綱がとうとう燃えだしたか」　怪塔ロケットの金属壁が、とろとろとけているくらいですから、そのあたりの温度はたいへんあつくなって、やがて麻綱がぷすぷすとくすぶりだしたのです。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほうっておくとあいつは焼け死ぬばかりだ」　　　　　４　偵察機と怪塔ロケットをつなぐ一本の麻綱にぶらさがり、怪塔へじりじり近づいていく勇敢な青江三空曹の服が、ぷすぷす燃えだしたのを見て、機上の小浜兵曹長ははっと胸をつかれたようにおもいました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、うまくいくぞ」　水が革ぶくろのなかになくなると見るや、小浜兵曹長は、まだぷすぷすとのこりの火種の光っている青江のズボンのうえを、彼の両脚でもっておさえつけ、たたきつけ、とうとう火をのこりなくたたき消してしまいました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人は、導火線があき樽のかげでぷすぷすともえ出すのをたしかめたのち、室外にとびだした。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　まるで、ぷすぷすと燃え上らずに煙を吐くような焦躁に、胸一杯を窒らせながら、正隆は翌朝学校に出掛けた。",
              "citation": {
                "source": "渋谷家の始祖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "稀には自由なのびのびとした気息が、その下から燃え出すことはあっても、すぐにぷすぷすとくすぶって、秩序とか経験とかいうものの重みの下に、押しつぶされ消し止められてしまう。",
              "citation": {
                "source": "都会に於ける中流婦人の生活",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼の凄い眼が私の心にぷすぷすと小さい針を無数にさし通している。",
              "citation": {
                "source": "蠱惑",
                "author": "――冬夜、瞑目して坐せるある青年の独白――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、単に、家屋が崩れ、人影がさびれ、鉄兜や銃剣が、そここゝに散らばり、ぷすぷすと何かゞ燃えてゐる、あの不気味な光景ばかりではない。",
              "citation": {
                "source": "北支の旅",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　大きな松の根ぼっくのぷすぷす燃えている炉の正面にどっかと胡座をかいて、六十歳にしてなお若い妾を囲っておくという評判の前村長は、つるつるに剃った頬のあたりをしきりに撫で廻した。",
              "citation": {
                "source": "荒蕪地",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方で、ベエコン老夫人の意見を聞いてみると、彼女はゴオランベリイでぷすぷす燻りながら「伯爵があんまり騒ぎたてなさるから、なにもかも打ち壊しになってしまうのだ」というのである。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "やらねばならない石を動かす所作で、私の胃潰瘍はぷすぷす穴があきはじめたが、藥でおさへ、毎日根氣好く石積みをやつた。",
              "citation": {
                "source": "巷の子",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
