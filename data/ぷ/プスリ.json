[
  {
    "uuid": "8ea48ff8-6311-553d-8ef6-4b06b13b5a22",
    "entry": "プスリ",
    "reading": {
      "primary": "ぷすり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
