          "literary": [
            {
              "text": "ホムンチオ（小人）とプラウツスは言うであろう。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラウツスの書いた鞦韆はエトアール凱旋門の気球の下に現われている。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラウツスはカルタゴのふたりの兵士にフェーニキア語を話させながら、故意にか偶然にかかかる仕事をした。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
