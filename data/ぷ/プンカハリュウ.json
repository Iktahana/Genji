        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "奥地の湖水地方へ――イマトラ――サヴォリナ――プンカハリュウ――ヴィプリ―― And God knows where !　　　奥の細道　イマトラの滝。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "プンカハリュウ――木の繁ったせまい陸地が橋のように七キロ｜米もつづいて、対岸プンカサルミへ達している。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "このプンカハリュウでの鎮静的な五日間は私たちの生涯忘れ得ないところであろう。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちはいつまでもプンカハリュウを愛するだろう。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "プンカハリュウの五日間、私達も何から何まですっかり手真似で用を足した。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
