    "definitions": [
      {
        "index": 1,
        "gloss": "shaking like a jelly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お皿に盛り付けたパンナコッタが、スプーンを入れるとぷるんと弾けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "化粧水をたっぷり染み込ませた翌朝の肌は、指を押し返してくるようにぷるんとしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "新鮮な卵の黄身は、お箸で摘もうとしてもぷるんとしてなかなか破れない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ぷるん、と時折、首を上げて舌なめずりをし、顔を横に顎の雫を振って切る。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "事によると薄いスプルングシヒトぐらいはできていたかもしれなかった。",
              "citation": {
                "source": "池",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "近ごろになってヘルツスプルング（Hertzsprung）はまた、これとは遠く離れた天空にある若干の恒星、なかんずくシリウスなどもやはり同一群に属するということを証明した。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "畳一枚ぐらいもあるような翅がプルンプルンと顫動していた。",
              "citation": {
                "source": "蠅",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なおも後からフワリフワリと騰ってくるシャボン玉は、みるみる重なりあって、お互いに腹と腹とをプルンプルンと弾きあった。",
              "citation": {
                "source": "火葬国風景",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへば、女といふ言葉を普通にコーネと言はないで、フリョード Flyod、またはスプルンド Sprund といふやうな類であります。",
              "citation": {
                "source": "スカンヂナヴィア文學概觀",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "地図をひろげると、すぐ前にひらくカプルネルタール Kaprunerthal の源は、カルリンゲル・グレッチャー Karlinger Gletscher、尾根つづきにグロース・グロックナーになっているが、カプルンの村のうしろは森から雲で、氷河らしいものはてんで見えない。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう十年になりますが、私の住んでいる街の、それもちょうど隣合せの小さな家に、マルファ・シモーノヴナ・カプルンツェーシャは私と同い年で、母親と一緒に暮らしていました。",
              "citation": {
                "source": "女房ども",
                "author": "БАБЫ",
                "note": "青空文庫"
              }
            },
            {
              "text": "亡くなったカプルンツェフ老人は輓馬を五対も持っていて、町じゅうに荷馬車を出していましたが、婆さんもその稼業を継いで、馭者の取締りにかけては故人に劣らぬ腕前でした。",
              "citation": {
                "source": "女房ども",
                "author": "БАБЫ",
                "note": "青空文庫"
              }
            },
            {
              "text": "竿の先がピリピリプルンプルンとふるえている。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "モチ竿の先はビリビリ、プルプルン、ジリジリと目にせまる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして編輯長ドクトル・ウィイゼンシュプルングは、間際になってから、「社会的意義における春のビイル」という題の、諧謔的な講演を引き受けた。",
              "citation": {
                "source": "ルイスヒェン",
                "author": "LUISCHEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
