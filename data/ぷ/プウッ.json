          "literary": [
            {
              "text": "だが、奈落とはよく云ったものさ」　熊城は屍体から顔を離して、プウッと烟を吐いた。",
              "citation": {
                "source": "オフェリヤ殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我慢が出来なくて、誰か隅の方で、プウッと吹き出してしまった。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　七之助が「勉学」という言葉で、思わず、プウッ！",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "プウッと火吹き竹をふいているお藤姐御、ほおをまるくしているのは、心中はなはだおもしろくないから、海豚提灯のようなふくれっつらにもなろうというもの。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と唱へて、ひきはたけた赤い目の中を、不意にプウッと強く吹きました。",
              "citation": {
                "source": "栗ひろひ週間",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "倒れている役人のところに行き、顔を目がけて、プウッ、プウッと、二度に、水をふきかけた。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "背後で、プッ、プウッ、と、ラッパの音が起った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "俥に乗った気配がし、もう暗くなった黄昏の道を、プッ、プウッ、と、ラッパの音が遠ざかって行った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "プッ、プウッと、ラッパの音とともに、数台の人力車は、街の方へ、ゆるやかな速度で出て行った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "プッ、プウッ、とラッパの音が遠ざかったころ、表から、「ノロ甚」が顔を出した。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "プッ、プウッ、と二度に、夫の顔にふきかけた。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
