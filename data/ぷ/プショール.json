          "literary": [
            {
              "text": "この一行の行手には早くも＊プショール河が見えだして、まだ遠くから、清涼な河風がもう頬を撫でて、それが堪へがたい酷暑の後でひとしほと身に浸みるやうであつた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "プショール河　ドニェープルの一支流。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガデャーチ　ポルタワ県下の同名の郡の首都で、プショール河に臨んだ小都会。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            }
          ]
        }
