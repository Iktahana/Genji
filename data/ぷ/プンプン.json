[
  {
    "uuid": "ead522c7-dcc7-57ae-9d24-810dc25f9800",
    "entry": "プンプン",
    "reading": {
      "primary": "プンプン",
      "alternatives": [
        "ぷんぷん"
      ],
      "is_heteronym": false
    },
    "grammar": {
