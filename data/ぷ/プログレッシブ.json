        "examples": {
          "standard": [
            {
              "text": "彼は常にプログレッシブな思想を持ち、社内の古い慣習を次々と打ち破っていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "あのファッションブランドは、環境問題に対してプログレッシブなアプローチを取り入れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "伝統的な邦楽に電子音楽を融合させた、プログレッシブな舞台芸術に観客は圧倒された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "女性だけのバンドでプログレッシブロックをやるのはほとんどあたしたちが最初なんじゃないかしら。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
