        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "外交官として国際会議に出席する際は、相手国の文化を尊重した厳格なプロトコルを遵守しなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "晩餐会の席次や乾杯の作法一つをとっても、伝統に基づいた詳細なプロトコルが存在する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「公式行事におけるプロトコルの不備は、国家間の外交問題に発展しかねません」と儀典長が注意を促した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "protocol (system of rules)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
