          "literary": [
            {
              "text": "汚れたプラトオクに頭をくるんだ女が鞭を振り上げてあとからそれを追って行く。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、プラトオクに頭をくるんだ牛を追う女は、馬が自分の傍を通りぬける時、なつこい声をかけた。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるでロシアの農婦の被るプラトオクのようだ。",
              "citation": {
                "source": "石ころ路",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            }
          ]
