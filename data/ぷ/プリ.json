  {
    "uuid": "fa313f34-092a-5545-b1d1-f3fcc54661cf",
    "entry": "ぷり",
    "reading": {
      "primary": "ぷり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
