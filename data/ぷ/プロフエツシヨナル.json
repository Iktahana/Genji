          "literary": [
            {
              "text": "」「やつぱり木村のモーシヨンはプロフエツシヨナルに出来あがつてゐやアがる。",
              "citation": {
                "source": "明るく・暗く",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピンセツトを撮んで翅をそろへ、脚を直し、つまり生きてゐるやうな恰好に虫の姿勢をつくつて、仕上げが出来て、ですね、標本箱にピンで止めるんでせう、その頃私の指先きは至極科学家らしい無感情に、何となくプロフエツシヨナルに働きました。",
              "citation": {
                "source": "趣味に関して",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「このごろでは、すつかりあなたの声はプロフエツシヨナルになつて来たわよ。",
              "citation": {
                "source": "山を降る一隊",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "タバン・イダーリアに現れる饒舌な常客の大半は、夫々の銅像として勤勉に働いてゐるプロフエツシヨナルの銅像役だつた。",
              "citation": {
                "source": "山彦の街",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
