  {
    "uuid": "4caf134f-87ce-5c89-8330-948b421ce6bb",
    "entry": "銀歯",
    "reading": {
      "primary": "ぎんば",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
