        "examples": {
          "standard": [
            {
              "text": "検査の結果、そのアクセサリーは銀位と判定され、純銀品より低い評価を受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "この茶器は銀位の素材で作られており、純銀よりやや硬くて扱いやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "職人は銀位の金属を丁寧に叩き伸ばして薄い板状に仕上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "……へんッお前さんなんぞのような田舎者に江戸ッ児が馬鹿にされてたまるものか」　まるで人間を見たことのない田舎の犬が吠えつくようにぎんぎんいった。",
              "citation": {
                "source": "うつり香",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "リューシは　ハンカチを　きれいになった　じぶんの　エプロンのなかに　おりたたんで、　ぎんいろの　あんぜんピンで　とめます。",
              "citation": {
                "source": "チギウィンクルおばさんのはなし",
                "author": "THE TALE OF MRS. TIGGY-WINKLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのひかりの中をなん十ぴきという小さなさかなが、ぎんいろのうろこをぴかぴかさせて、およいでいるではありませんか。",
              "citation": {
                "source": "ふしぎな人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
