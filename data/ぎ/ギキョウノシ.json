        "examples": {
          "standard": [
            {
              "text": "その戦国大名は義侠の士として部下からも敵からも尊敬されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "義侠の士となることが当時の武士の最高の理想像だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "義侠の士として知られた彼の一つの決断が領地全体の命運を変えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "日本の政府は、この留学生たちの革命思想に対して、いまのところは、まあ、見て見ぬ振りというような形でいるらしいが、しかし、民間の日本の義侠の士は、すすんでこの運動に援助を与えている。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
