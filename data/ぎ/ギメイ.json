[
  {
    "uuid": "1418fd50-f7d0-5337-87f1-3acdd3582b92",
    "entry": "偽名",
    "reading": {
      "primary": "ぎめい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
