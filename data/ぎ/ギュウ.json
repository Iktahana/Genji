        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ふたを開けようとしてもびくとも動かないので、ぎゅうと力を込めてもう一度捻った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "弟はランドセルにぎゅうと本を詰め込んで、ファスナーを閉めようと格闘していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女は手紙を折りたたみ、封筒にぎゅうと押し込んでから切手を貼った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
