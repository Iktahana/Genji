          "literary": [
            {
              "text": "彼女の神経は銀針のように鋭敏になって、絹糸のように戦いているのだった。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "倏にして太い銀針のような雨脚があたりを真白にしてしまう。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "毒殺の起きたことを証明するには、mimosa（オジギソウ）saponariaの煎じ液を通した銀針を紙で包んで死体の口に入れる。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾野課長の頸の真うしろに一本の銀鍼がプスリと刺さっていた。",
              "citation": {
                "source": "赤外線男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはあとで判ったことだけれど、彼女はあの銀鍼をシャープペンシルの軸の中に隠して持っていたのだった。",
              "citation": {
                "source": "赤外線男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
