    "definitions": [
      {
        "index": 1,
        "gloss": "silver coin",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "旅商人はポケットから銀貨を数枚取り出して宿代を払った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "博物館のガラスケースには、江戸時代の銀貨が整然と並べられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "子どもは砂浜で拾った丸い石を磨き、銀貨みたいだと嬉しそうに言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "『足を蹈んだのは僕が惡かつた、惡かつたから謝罪る、ねえ君、これは僅かだけれど膏藥代に、な、納めて呉れ玉へ、さあ』對手の心事、酒代にありと見て取つた若紳士は、事の組し易きを喜んで、手早く握つた銀貨、二枚、三枚、光る物手をすべつて男の掌に移るよと見る間に「呵」と叫んで紳士は身を轉換した。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "途端、目標を外れた銀貨はチチンと小石に衝突つて、跳返つて、囘轉つてベタリ。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の日はポツオリに行って腹立たしくうるさい案内者に悩まされながらセラピスの寺の柱に残る地盤昇降の跡を見、ソルファタラ旧火口の噴煙を調べ、汚い家でスパゲッティの昼食を食って、帰りの電車で、贋銀貨をつかまされた外にはあまり人間味のある記憶が保存されていない。",
              "citation": {
                "source": "二つの正月",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとさっきの白服を着た人がやっぱりだまって小さな銀貨を一つジョバンニに渡しました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は十錢銀貨を固く握つて、賣店の前を幾度か往復した。",
              "citation": {
                "source": "室生犀星に與ふ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、机の引き出しから一円銀貨を掴んできた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "床篦子、卓子、机子、花模様の茶壺、旅行鞄、銀貨の山。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "地下の秘密室にかくして置いた銀貨まで、あとで帰って行ってみるとなくなっていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十銭銀貨を一つ盗んでも禁固を喰う。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あつても到底五十錢銀貨一枚つかめそうになかつた。",
              "citation": {
                "source": "奎吉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらが見てよくわかっているのにと思い、財布の銀貨を袂の中で出し悩みながら、彼はその無躾に腹が立った。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっと銀貨が出て婦は帰って行った。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　高信さんが、銀貨を若干、先棒の掌へポンと握らせると、にこりと額をうつむけた処を、「いくら貰うたかい。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "袋の底から銀貨が光っていました。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると白服を着た人がやっぱりだまって小さな銀貨を一つジョバンニに渡しました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀貨を一枚払ひました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」なるほど大学士の頭の下に支那の六銭銀貨のくらゐのみかげのかけらが落ちてゐた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると白服を着た人がやつぱりだまつて小さな銀貨を一つジヨバンニに渡しました。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」なるほど大学士の頭の下に支那の六銭銀貨のくらいのみかげのかけらが落ちていた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると婦人が「失礼ですけれど」といいつつ二十銭銀貨を手渡して立ち去った。",
              "citation": {
                "source": "非凡なる凡人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕はその銀貨を費わないでまだ持っている」と正作はいって罪のない微笑をもらした。",
              "citation": {
                "source": "非凡なる凡人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と親方は言いながら、財布から五十銭銀貨を三四枚取り出して「これで今夜は酒でも飲んで通夜をするのだ、あすは早くからおれも来て始末をしてやる。",
              "citation": {
                "source": "窮死",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、もらった銀貨一枚を出した。",
              "citation": {
                "source": "窮死",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその中からありったけの一円五十銭だけ、大小の銀貨を取りまぜて掴みだした。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "園は例のとおり、ポッケットの中から、机の抽出しから、手帳の間から、札びらや銀貨を取りだした。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、女中に銀貨と小銭を貰って出て行く蓑吉の後姿を見送り乍ら、室子は急に不憫になった。",
              "citation": {
                "source": "娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちがここに五十銭銀貨を使うとします。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "讀者余が言を信ぜずば罪と罰に就きて、更に其他の記事を精讀せられよ、思ひ盖し半に過ぎんか。",
              "citation": {
                "source": "「罪と罰」の殺人罪",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、あるいは杞憂にすぎんかもしれんがね。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れども危きを恐れて常に遠ざかる事の甚しきに過ぎんか。",
              "citation": {
                "source": "猥褻独問答",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
