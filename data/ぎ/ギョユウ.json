[
  {
    "uuid": "3f5b6374-544f-527f-8e94-fa92278b5965",
    "entry": "御遊",
    "reading": {
      "primary": "ぎょゆう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
