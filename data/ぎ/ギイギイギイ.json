            {
              "text": "ギイギイギイ、フウ。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギイギイギイギイギイ」　桐の葉蔭の髪切虫は、思わず啼いてしまった。",
              "citation": {
                "source": "髪切虫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ギャギャギャギャ、ギイギイギイギイッ……」　往来を通りかかっていた人が皆、走り集まって来たので待合室の中が急に、暗くなった。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギイギイギイ――ッ……」　青鬼のようになった三好の両眼が、酸漿のように真赤になった……と思ううちに鼻の穴と、唇の両端から血がポタポタと滴たり出した。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギイギイギイと腕金の錘りが浮きだした。",
              "citation": {
                "source": "鍵から抜け出した女",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「相馬二遍返し」　その歌に感動して、屋根の上でギイギイギイと鳴きしきる豚達。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
