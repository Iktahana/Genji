        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "林房雄トイウ名ノ一陣涼風ニソソノカサレ、浮カレテナセル業ニスギズ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "單ニ國家ノ統一ト國民大多數ノ自由ノ爲ニ少數者ノ所有權ヲ制限スル者ニ過ギズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "又現時露西亞ノ土地沒收ノ如キハ明カニ維新革命ヲ五十年後ノ今ニ於テ拙劣ニ試ミツヽアル者ニ過ギズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大戰中ニ於ケル印度獨立運動ノ失敗ハ凡テ日本ガ日英同盟ノ忠僕タリシガ爲メニシテ、從テ英國ガ一時的全勝將軍タルガ爲ニ瞬時雌伏スルニ過ギズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "キルギズ人の口碑には、アレキサンダー王の頭に二の角あるを臣民知らず。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "どう言ふ意味がフクマつてゐるか」　福間先生は二学期からいきなり僕等にゲラアデ・アウスと云ふギズキイの警句集を教へられた。",
              "citation": {
                "source": "二人の友",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ今摸傚ノ弊ヲ矯メムト欲セバ、何如ナル道ニ從事スベキヤト云フニ、余ガ見ル所ニテハ、唯二道アルニ過ギズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ我ハ纔ニ下谷ナル鷲津氏ノ家人ニ聞キシ所ヲ識シタルニ過ギズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽ降誕ト訃来ト五十四年ヲ隔ツトイヘドモソノ地｜相距ルコト百歩ニ過ギズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "邑ハ官道ヲ距ルコト数里ニ過ギズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "※デモ、木村ハ刺戟剤トシテ利用シテイルニ過ギズ、ソレ以上ノ何者デモナイトシテオイテクレ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イニシテソノ麻痺状態ニ置カレテイタ期間ハモノノ二三十分ニ過ギズ、間モナク遮断サレテイタ神経ノ通路ガ復舊シ、失ワレタ記憶ガ戻ッテ来テスベテガ平生ノ通リニナッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "でもアブドル・アギズ大公はまだ望みを捨ててない」「アブドル・アギズ大公が衣装を預かっている寵臣なの」「その通り。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アブドル・アギズ大公だよ。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "確かにアブドル・アギズ大公はトルコ支配階級の中でも狡猾な人物だ。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "アブドル・アギズ大公は詩人の気風があり、それがために女性にひどく心がときめいた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "約束の夜、グライドはアブドル・アギズ大公のホテルに立ち寄った。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "「故郷のようだ」　とアブドル・アギズ大公がつぶやいた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあと、アブドル・アギズ大公の人生のなかで、最高に夢心地の楽しい時が過ぎた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は木曜日までだし、それ以降は土くれか、廃人だ」　これらのすべてが証明していることはアブドル・アギズ大公がすっかり、いかれてしまったことだ。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたかもアルギズスの暗き森の中なる樫の樹のごとし。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
