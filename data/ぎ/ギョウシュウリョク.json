        "examples": {
          "standard": [
            {
              "text": "団結力の強い組織は高い凝集力を持つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この物質の凝集力は温度の低下とともに増加する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "社会的な凝集力が低下すると、様々な問題が生じる可能性がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "この距離においては吾人は種々の場合に別の方則に従う凝集力を考えたくなる。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この凝集力と重力とは如何なる関係があるだろうか。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "カフカの短編は凝集力をもち、たしかに完結性をもつものと考えてよいであろう。",
              "citation": {
                "source": "「世界文学大系58　カフカ」解説",
                "author": "原田義人",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一性質とは、延長と固性、とともにそれらのいろいろな混合と変容である、形状、運動、重力、凝集力である。",
              "citation": {
                "source": "人間本性論（人性論）",
                "author": "A Treatise of Human Nature",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦わぬうちから、すでに曹軍は散開を呈して、兵の凝集力を欠き、士気もあがらない様子を見たので、文醜は、「見ろ、すでに敵は、わが破竹の勢いに恐れをなして、逃げ腰になっている」と、誇りきった。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
