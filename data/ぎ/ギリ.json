[
  {
    "uuid": "bafbb4b7-897f-595c-9f79-b92a66c5d249",
    "entry": "義理",
    "reading": {
      "primary": "ぎり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
