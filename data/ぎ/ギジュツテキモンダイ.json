        "examples": {
          "standard": [
            {
              "text": "報告されている技術的問題をいくつか修正しました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "技術的問題を全て解決するまで、本格運用は延期します。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ユーザーから報告された技術的問題を分類しています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "尤もこれ等の心理的過程や技術的問題も亦その説明を社会学的方法のうちに見出されるのであるが。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "先行して開発が進められたモデル１００では、全体をきわめてコンパクトに仕上げようとしたために、回路が発生させる電磁波によってメモリー内の情報が化ける可能性が生じるというあらたな技術的問題点も浮かび上がった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "マイクロコンピューターや周辺機器の高速化、グラフィックス処理に対する要求の増大といったその後焦点化する課題に応えるうえで、ＡＴはさまざまな技術的問題点を抱えていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
