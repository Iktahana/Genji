        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その井戸から最後に水をくんだ者は、ギーヨーム・ヴァン・キルソムという男であった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギーヨーム・ヴァン・キルソムは「城の番をするため」にウーゴモンに残って、窖の中に身を潜めていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギーヨームは彼らに水を持ってきた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でもギーヨーム・ランベールという名だったと思います。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャーロン・スュール・ソーヌの司教ギーヨーム・ド・シャンポーから修道院長の位を授かりました。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "防障の役（一五八八年五月）の後ギーヨーム・デュ・ヴェールが発した荘重な言葉を、今更に思い起こさしめ、全世界の眼前に実行したものは、それはひとりの者ではなく、また数人の者ではなく、実にフランス自身であり、フランス全体であり、勝利を得、自らその勝利に酔ったるフランスであった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギーヨームの言葉に曰く、「貴顕の愛顧を求むるになれ枝より枝へと飛び移る小鳥のごとくに、悲運より幸運へと向背するになれたる者どもにとりては、逆境にある君主に対して不敵なる態度を取るはいとやすきことなり。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
