        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "生ビールがギンギンに冷えていて、最高だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "冬の朝はギンギンに冷えた空気が鼻を刺す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ギンギンに冷えた水を飲むと、喉がすっきりする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
