        "examples": {
          "standard": [
            {
              "text": "工事現場でドリルがギンギンと大きな音を立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "セミがギンギンと鳴いて、夏の昼間を彩っている。",
              "citation": {
