        "examples": {
          "standard": [
            {
              "text": "その擬似的な改革は、実際には何も変わらなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "政治家の擬似的なリーダーシップは、国民の信頼を失った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "擬似的な努力では、本当の成果は生まれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それは気圧変化にほぼ一週間に近い週期あるいは擬似的週期の現われることがしばしばあるからである。",
              "citation": {
                "source": "時事雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊戯的或は擬似的な接触としての友情なんて、そういう表現をえてつかいたがる連中の頽廃でしかありません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばアメリカの大衆がなんとなく不安をおぼえはじめたトルーマン時代の末期では、アメリカの国民的な英雄としてアイゼンハワーが大統領にえらばれ、これによって擬似的な統一感が大衆の心のなかになしとげられ、不安を自己満足にすりかえていったのだ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
