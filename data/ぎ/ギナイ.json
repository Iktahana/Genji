          "literary": [
            {
              "text": "）三、ヒラガナトイウモノハソノ素性ヲ探ルト、イズレモ漢字ヲ極端ニ崩シタモノニスギナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ調和シテイルト考エル人ガアレバ、ソレハ習慣ニヨツテ感覚ガ麻痺シテイルニスギナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ美醜間ニ於ケル眉目ノ寸法配列等ノ差タルヤ極メテ僅少ニ過ギナイ。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨク考エルト、颯子ノ手前好キヲ装ッテイルニ過ギナイノダト云ウコトニ、自分デモ気ガ付クコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………コンナデモナイノイローゼニ過ギナイヨウニモ思エルカラダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "徒ラニ悲シミヲ増サセルニ過ギナイノナラ知ラセルノハ無駄ナノダカラ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
