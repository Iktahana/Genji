        "examples": {
          "standard": [
            {
              "text": "デバッグ中にエラーメッセージに示された行番号を確認し、そこから原因を追跡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "コードレビューでは行番号を指定してコメントを残すと、修正箇所が明確になって作業しやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "エディタの設定で行番号の表示をオンにしたら、コードのナビゲーションが格段に楽になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "同書の記述によれば、ゲイツは三人の日本人の書いたプログラムのうち、行番号で管理する形式のエディターに不満を感じた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "『帝王の誕生』の記述どおり、当初エディターにはベーシックそのものが持っていた行番号単位のものに若干の味付けを施して、汎用エディターらしく見せたものを使っていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次の行からはＩＦ文が五つ並び、Ｊが２から５か７か11のときは――Ｊがテレビ局のチャンネル以外の数字になったときは――ＮＥＸＴ／Ｊ文の行番号までＧＯＴＯするようになっている。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
