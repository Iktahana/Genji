        "examples": {
          "standard": [
            {
              "text": "実行ファイルを逆アセンブルして、内部の処理フローを確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "セキュリティ研究者はウイルスを逆アセンブルし、攻撃コードの構造を明らかにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "このバイナリを逆アセンブルすると、関数の呼び出し構造が浮かび上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "機械語に変換されてＲＯＭに組み込まれているベーシック処理プログラムを、逆アセンブルと呼ばれる工程を経てアセンブラーの形式に戻して分析すれば、マイクロソフトがどういった手順で機能を実現しているかを覗いてみることができた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで古山は逆アセンブルを禁止し、あくまで一からの組み立てに徹した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで６８００で実現可能な最高速を目指すという目標をかかげたが、これを達成しようとする以上、すでにあるものを逆アセンブルして参考にしようとしてもあまり意味はなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
