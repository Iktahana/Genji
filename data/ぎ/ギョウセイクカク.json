        "examples": {
          "standard": [
            {
              "text": "都市開発に伴い、行政区画の見直しが必要になってきたと考えられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "行政区画の変更には住民投票が必要とされている自治体も多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "効率的な行政サービス提供のため、行政区画の統合が進められている地域もある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "国郡のごとき行政区画のできるはるかに前から、火山の名が存し、それが顕著な目標として国郡名に適用されたであろうとは思われるが、これも確証することはむつかしい。",
              "citation": {
                "source": "火山の名について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "三山の遺臣はなお三平等（三ツの行政区画）に割拠して調和しなかったのであります。",
              "citation": {
                "source": "ユタの歴史的研究",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
