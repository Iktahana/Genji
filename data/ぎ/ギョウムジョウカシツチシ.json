        "examples": {
          "standard": [
            {
              "text": "火災で逃げ遅れた客が死亡し、ホテルの管理者が業務上過失致死で書類送検された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "業務上過失致死の事件は、企業の安全管理体制が厳しく問われる機会となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "医療過誤による患者の死亡で、担当医が業務上過失致死の疑いで捜査を受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "然し、Ｈ署ではこの事件を「業務上過失致死事件」として、一件書類を区裁判所検事局に送って来たのである。",
              "citation": {
                "source": "彼は誰を殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十人の証人が居て悉く子爵に不利益な証言をした所で事件は業務上過失致死罪の罰、即ち三年以下の禁錮又は千円以下の罰金ですむ筈です。",
              "citation": {
                "source": "彼は誰を殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は直ぐに自首しようと思ったのですが、あまり自分の罪が大きかったので自首出来ず逃れたのです」　業務上過失致死罪です、一番重くて三年の禁錮ですみます。",
              "citation": {
                "source": "死者の権利",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
