    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "魚網を肩へかけ、布袋を下げた素人漁夫らしいのも見かけた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲浦深く陸地に入ること數十町、鹽釜祠下、漁戸數十、浮世を山と海とに遮りて、魚網夕陽に晒し、扁舟蘆荻の間に浮び、八十島かけて澄む月影と共に、漁人の心もいかばかり澄みたりけむ。",
              "citation": {
                "source": "金華山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "――昔彼が青島の一漁夫にすぎなかった頃、沖で魚網を投ずると、魚は一尾もはいらず、重い壺が一つかかってきた。",
              "citation": {
                "source": "碑文",
                "author": "――近代伝説――",
                "note": "青空文庫"
              }
            },
            {
              "text": "倫（蔡倫）乃造意用樹膚麻頭及敝布魚網以爲紙。",
              "citation": {
                "source": "紙の歴史",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの舟橋には十数名の警官が大きな魚網を張りわたして立ち塞っていた。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "舟には大きな捕魚網が積まれ、潮が満ちて来て浮き上るのを待っている。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この砂だよ」と、富なあこは、踏んだ魚を女串で刺し、魚といっしょに砂を掴みあげて、魚を魚網へ入れ、砂を掌でもてあそびながら云った、「――こうやってみると、なんでもねえ、ただの砂だ、ただ砂だってだけだ、ほれ、これだけのもんだ、なあ」「うう」と云って倉なあこはあたりを眺めまわした。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「砂が」と倉なあこは鰈を魚網へ入れながら訊いた、「育つってかい」「おうよ」と富なあこが云った、「それもただ育つだけじゃねえ、育って大きくなりながら、だんだん川をのぼるんだ、だんだんにな、おらもこれにはびっくりした」　倉なあこは右手の中指で、頭のうしろを掻いた。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "白魚網だろう、そのあたりから水面を伝って、人の声がとぎれとぎれに聞えて来る。",
              "citation": {
                "source": "寒橋",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
