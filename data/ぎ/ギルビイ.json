        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "平野と、遊びに来た松平晃とを連れて、ギルビイへ寄り、ウイを買ひ（Ｂ＆Ｗを半分ほど）祇園の大住へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "白粉落して、ギルビイへ行く、南僑・山伸・山野。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ十時二分前、京宝の小田を誘ってギルビイへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、又ギルビイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて又々ギルビイ、山野と。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、石田とギルビイ、少々のウイ、宿へ早く帰ってニギリ飯を食ひ、十二時半に寝る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、京宝の小田・渡辺篤を連れてギルビイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "小田・渡辺に玉木潤を誘ひてギルビイから先斗町へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "祇園のギルビイで乾杯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "加藤弘三来訪、鈴木桂介も来り、ギルビイでウイスキーのみ、すしや花川戸で白身沢山食って宿へ帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木桂介が来たので、石田・山野といふ浅草メムバーでギルビイへ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "終ると、腹は減るし、ものかなしい、京都の町へ出てギルビイで一杯のみ、鳴瀬へ行って、深山あげで海苔茶漬を食ひ、腹が張って苦しい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "滝村と二人で、ギルビイへ行き、チーズ・トーストでウイをのむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "あきれたぼういずをギルビイへよんで大いにハシャぎ、広千代へ行って又々のめやさわげ――一人で僕がはしゃいでゐた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡辺・上山とギルビイでのみ、広千代へ行き、ガボリ／″＼飲み、むやみとはしゃぐ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネたのが、九時四十五分、京宝の小田・ダッシー息子武男さんも誘って、ギルビイから広千代へ行き、二時頃迄。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
