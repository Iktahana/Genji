[
  {
    "uuid": "94f4ae5b-e65b-5d2a-93fd-da78c056323b",
    "entry": "御幸",
    "reading": {
      "primary": "ぎょうき",
      "alternatives": [
        "みゆき",
        "ごうき",
        "ごこう"
      ],
      "is_heteronym": false
    },
    "grammar": {
