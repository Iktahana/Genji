        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "快活、憂鬱、謹厳、戯謔さまざまの心持が簡単な線の配合によって一幅の絵の中に自由に現われていると思うのである。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論戯謔だが隨分迷惑な事だ。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オホホ、厭ですネエ、お戯謔なすっては。",
              "citation": {
                "source": "太郎坊",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と松さんは、戯謔て口真似した。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶山は戯謔したに過ぎない。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論先生の戯謔ではあるが、夫人は酒量があつたから、多少これがために病を重くしたかも知れない。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "処で俺の旦那がお世辞半分に新聞記者の天職を壮んなりと褒めて娘も新聞記者に嫁る意だと戯謔面に煽動てたから、先生グツト乗気になつて早や聟君に成済したやうな気で毎日｜入浸つてゐる。",
              "citation": {
                "source": "犬物語",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "倦メバ則アルイハ坐シ、アルイハ臥シ、劇談一｜餉、善ク戯謔シテシカモ虐ヲナサズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はこれ等の多くを散文にものしたが、天成の詩人たる彼が詩歌に第一の新聲を出すに難んじたとは運命の戯謔か、――悲痛の感に堪へないのである。",
              "citation": {
                "source": "新しき聲",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ戯謔の初め、初笑々々。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "処が私は鉄漿を付けて居るから兵隊共が私の顔を覗き込んで、御卿様だなどと戯謔つて居りました。",
              "citation": {
                "source": "千里駒後日譚",
                "author": "楢崎龍、川田雪山",
                "note": "青空文庫"
              }
            },
            {
              "text": "こは固より戲謔に過ぎざりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "コルソオの大道にて戲謔能く人の頤を解きしは誰ぞ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "この婦人の家にあるさまを見るに、其戲謔も愛すべく其氣儘も愛すべし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度誂草と云ふ書物の著者が企てたと同じ樣に廣い範圍に亙つてゐるが、些の戲謔を交へず眞摯一點張で通してゐる。",
              "citation": {
                "source": "安藤昌益",
                "author": "狩野亨吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の心はアンジエラに對する熱情的な戀によつて、「地上から夢の國に――最も天國的な、最も尊い戲謔圖中に高められた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを兩性の關係に引移せば、俺の中にも明かに「ドン・ホアン」がゐて心の底にその美しい「戲謔圖」を織つてゐる。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シーリヤスな點に觸れる限りに於いては、彼は戲謔の間にシーリヤスな忠告をしようとする目的を持つてゐると思つた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
