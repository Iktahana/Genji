          "standard": [],
          "literary": [
            {
              "text": "例の塩風呂に浸つてから例の酒店で一杯やる、この店は安い、一合でも二合でも喜んで燗をしてくれる、下物は刺身五銭、天ぷらもも五銭、ぬた弐銭、湯豆腐弐銭、私のやうなノンベイでも三グワン握つて行くと、即身成仏が出来る、ギヤアテイ、ギヤアテイ、ボーヂ、ソワカ、などゝ親しい友に書いてやつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "口を利くのも面倒だア、ハ……だア、面倒臭いや、ギヤツ、ギヤツ、ギヤア――だ！",
              "citation": {
                "source": "毒気",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "毒を呑ませるのか、俺に……、誰が呑むものか、皆な吐き出してしまふぞウ――ギヤア、ギヤア、ギヤア――だア！",
              "citation": {
                "source": "毒気",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いくらギヤア／＼と云つたつて離しませんぞ、これからおとなしくするか。",
              "citation": {
                "source": "余の倅に就いて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ギヤア／＼位ゐには驚かんぞ。",
              "citation": {
                "source": "余の倅に就いて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "不図私は、私の身近かに、「ギヤアーツ！",
              "citation": {
                "source": "驚いた話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に私も爆弾のやうに仰天して、「ギヤアーツ！",
              "citation": {
                "source": "驚いた話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、悲しさうにギヤア／＼とあたしを見あげて鳴き喚いた。",
              "citation": {
                "source": "鵞鳥の家",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴオギヤアンの手紙を読んで見ろ。",
              "citation": {
                "source": "闇中問答",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "宍戸　　これで、家賃を取るために家を貸してゐる人は知りませんが、わたしなんかのやうに楽しみに人を置いてるものには、年寄りがゐて念仏を唱へたり、子供にギヤアギヤア泣かれたりしては、全く引き合ひませんからな。",
              "citation": {
                "source": "百三十二番地の貸家",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "川岸の岩の上で、親猿小猿はギヤアギヤア言つて下の方を眺めて居ました。",
              "citation": {
                "source": "山さち川さち",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男２がギヤアと叫んで、猿のように正面の鉄柵の、かなり上部に飛びついて歯をむく。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
