        "examples": {
          "standard": [
            {
              "text": "この財布は本物の牛革を使っているので、使うほどに味が出てくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "祖父から譲り受けた牛革のベルトは、何十年経っても丈夫なままだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "牛革のソファは猫に引っかかれると傷がつきやすいので、ペットがいる家には向かない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "象の頭を持った唐獅子の面白い絵の付いた薄い牛革の枕と快適な畳の上で横になりました。",
              "citation": {
                "source": "手紙",
                "author": "一八九三年七月二二日付　チェンバレン　宛",
                "note": "青空文庫"
              }
            },
            {
              "text": "韓当、周泰のふたりが、「仰せ、承りました」　と、すぐ江岸から十数艘の牛革船を解き放ち、左右から鼓を鳴らして敵船へ迫って行った。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
