        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "舞台照明を浴びたシャンデリアがぎらついて、観客席を幻想的に照らし出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "水面に広がる油膜が七色にぎらついて、不思議な美しさを放っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女の首元のネックレスがキャンドルの灯りの下でぎらついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
