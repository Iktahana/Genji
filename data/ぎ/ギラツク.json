    "definitions": [
      {
        "index": 1,
        "gloss": "to glare",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "炎天下の舗装道路がぎらついて、歩くだけで体力を奪われるようだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "尋問室の白熱灯がぎらつく中、刑事は無言で容疑者を見つめ続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "正午の海面がぎらついて、サングラスなしでは前方をまともに見られなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "夏の街の恐怖焼けつくやうな夏の日の下におびえてぎらつく軌条の心。",
              "citation": {
                "source": "詩",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼けつくやうな夏の日の下に、おびえてぎらつく軌条の心。",
              "citation": {
                "source": "心の姿の研究",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、純白の纏布を巻いた額をあげ、苦しそうにぎらつく眼で、母を見た。",
              "citation": {
                "source": "古き小画",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぎらつく日光を掠めて、イラン戦士の鉾が飛んだ。",
              "citation": {
                "source": "古き小画",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　腕は動かず、脂汗のにじむ赧黒い頬骨をじりじりかたむけ、ぎらつく双眼から涙が二筋、繃帯のしたにながれこむ。",
              "citation": {
                "source": "原爆詩集",
                "author": "峠三吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてあの人のあのぎらつくやうな眼のなかを一心に覗きこんだといふではないか。",
              "citation": {
                "source": "死児変相",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "一面にぎらつく白い光で、なんにも見えない。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲一つない空からぎらつく太陽が照りつければ、灼きつく大地に風一つなく草の葉一枚もそよがぬ日、山ぞいの藪の中に入ると裸になって大の字に寝ころんだのである。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第五巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぎらつく日のきらいな伸子が、白い大きなハンカチーフの端を髪の上にかけ、つみ集めた花をもっていない方の手でかつぎのようにもう一つのはしをもって、西日をよけながら歩いているのであった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこはじめっとした夜にひっそりして、あたりに歩行者はおらず、たった一人で橋壁に立ち、下のぎらつく流れを見た。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぎらつく眼光の裏に、憂鬱な仮面が隠れている。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "厚かましい態度が嫌だし、何かぎらつく目に、尻込みした。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "グラスゴウ部長が片手で顔を覆う仕草は、ぎらつく目をアイダに見られたくないかのようだ。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどい暗黒木曜日になりそうだぜ」　エリクソンとアシャトン・スミスはブランデーをちびちび飲んでいたが、もはや、ぎらつくまなこでほくそ笑むことはなく、とらぬ狸の札束を数えることもできなかった。",
              "citation": {
                "source": "バブル崩壊",
                "author": "A BUBBLE BURST",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐるりは、ギラつく油と工場の塀で、まさに色もなにもないまっ黒な堀水である。",
              "citation": {
                "source": "地虫",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひでえこんだ、こりゃ、推進機にやられたらしいな」　ギラつく脂のなかで、その全裸の屍体が男であると分った。",
              "citation": {
                "source": "地虫",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　十｜呎ほどの距離まで接近して来た列車は、ギラつく前燈を一面に軌道の上に投げていた。",
              "citation": {
                "source": "美しき月夜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも獣よりもなお悪いことは、荒んだ心の外に、男たちは年中喧嘩をして、そして……私を見る眼ばかり鋭くギラつく。",
              "citation": {
                "source": "令嬢エミーラの日記",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "今し方、どこぞで聞いた声のようだが――と思いながら、影ににひとみをこらして見ると、ガッシリした町人｜体の、大地に膝を突いて屈まっている様子、手坑いすべき態度でないのは分っているが、嫌なことには此奴も一本、銀のギラつく磨きの十手を、支いている手裡にかくしてつかんでいます。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ひと太刀だ……」とお十夜は、胸がすいたように、また、その快味の消逸を惜しむように、斬った刹那の構えをくずさず、白い刃の肌にギラつく脂と、のた打つ影とを等分に眺めながら、ニイ……と唇をゆがめて笑う。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
