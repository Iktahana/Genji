    "definitions": [
      {
        "index": 1,
        "gloss": "(male) waiter",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ギャルソンの客あしらいに多少の薄情さはあっても、それがいつも芝居の舞台のように陽気に客を吹き流して行くロン・ポアンの店が、妙に春に似合う。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　少女達がいろいろなサンドウイッチを手頃な荷にして、ギャルソン達の忙しいサーヴィスの間を、邪魔にならぬように詰った客の間を、売歩く。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギャルソンのステファンが、「ヴォアラー・ムシウ」と言って小卓にのせて行く朝食は一日じゅうの大なる楽しみであったことを思い出す。",
              "citation": {
                "source": "コーヒー哲学序説",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "出どころの判らない匂いと笑いと唄とを引き切るように掻き分けて、物売りと、分別顔のギャルソンが皿を運んだり斡旋したりしている。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "空いたところがある」　鳶色の髪をフランス刈りにしたマネージャーが、人を突きのけるようにして、かの女等親子を導いて、いま食卓の卓布の上からギャルソンが、しきりにパン屑をはたき落している大テーブルへ連れて行った。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギャルソンは新しい卓布を重ねて、花瓶の位置をかの女の方向へ置き直した。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギャルソンに註文を誂えた後のむす子は画家らしい虚心で、批評的の眼差しで、柱の柱頭に近いところに描いてある新古典派風の絵を見上げていた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギャルソンがスープを運んで来た。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "星がうるんで見える初夏の夕空のような淡い浅黄色の汁の上へギャルソンはパラパラと焦したパン片を匙で撒いて行った。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁の前に、左の腕にナフキンをかけて彫刻のように突立っているギャルソンの頭が、妙に怪物染みて見える。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じくびっくりした壁の前のギャルソンは、急いでその方へ駆けて行ったが、すぐ一抱えにクラッカーの束を持って来て、テーブルの上へ投げ出した。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい酒の註文にギャルソンの駆せ違う姿が活気を帯びて来た。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたギャルソンにすこし握らせてごらんなさい。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は益々いい気になって方々彼女を連れて歩きながら、道行く人々に聞えよがしに、ボンジュール、トレビアン、ボウギャルソン、ススワルとか知っているだけのフランス語を全部叫んだ。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い手袋、エナメルの靴と身を替えて鏡の前に立って見ると、少し照れ気味な映画のギャルソンのような自分の恰好に苦笑が泛んで来るのだった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも空席が見つけにくいほど立てこんでいて、腕にナプキンをかけたギャルソンが軽快に陽気にその間をとびまわっていたオペラの角のカフェー・ド・ラ・ペイにしろ、ずっとはなれてエトワールに近いクポールにしろ、往来を眺めて椅子にかけているような人は、ほんの数えるしかなかった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "良いギャルソンだあ！",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとその翌朝になって帳場のそばの溜まりで、ガルソンから、けさ一人の支那人が宿から程遠からぬ所を流れている黄浦江の河岸に惨殺されていた、と云う話を聞かされたのです。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "服裝を整へた何處にでも見るオテルのガルソンが、第一に私を迎へた。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガルソンはちよつとギシェの所まで立ち歸つて訊いてゐたが、私の所へ引き返して二週間前に出發してしまつたと告げた。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "インタアラアケンの私の泊つた旅館でも、一人のガルソンがやつて來て、到る處のホテルが給仕人や、料理人に仕拂ふことすら出來ないで困つてゐる状態や、それが戰時から引續いてゐるので、瑞西全體が非常に困却してゐることなぞを、ゆるゆる話して行つた。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "またこの曹長が来ると同時に、それまで僕等が坊ちゃん軍曹だとかガルソン軍曹だとかあだ名していたほどおとなしかった、もう一人の班長の稲熊軍曹が、急に意地悪くなり出した。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一間の入口にガルソン〔使用人〕が箒をつかって居た。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に彼が子供たちに、ハムブルグの動物園の象の声だの、巴里のガルソンの身ぶりだのを巧みに真似て見せる時は、一層その笑ひ声が高くなつた。",
              "citation": {
                "source": "山鴫",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "とある停車場でガルソンを呼んで、御茶を運ばせる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "前大戦の後ではフランスが今の日本と同じことで、ガルソンヌなどゝいふ実験少女が現れたものだ。",
              "citation": {
                "source": "破門",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "実験から実験へ、更により良き結果をもとめて、その生涯を実験室で終るやうなガルソンヌはめつたにゐない。",
              "citation": {
                "source": "破門",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍医を迎へるホテルのガルソンの手にあるランプが赤黄ろくガラス戸の向ふに動くのを、私は重苦しい思ひで眺めてゐました。",
              "citation": {
                "source": "亜剌比亜人エルアフイ",
                "author": "犬養健",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
