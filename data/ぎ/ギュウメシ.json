    "definitions": [
      {
        "index": 1,
        "gloss": "rice covered with beef and vegetables",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "弁当屋で牛飯を買い、職場で食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この食堂の牛飯は米が古いとの評判だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "牛飯は手早く食べられるので人気がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "私は、最後の十銭の白銅を牛飯にかえて五六時間地上の生活をのばす代わりに、ついふらふらと気紛れでそれをこの動物園の入場料にかえてしまったものらしい。",
              "citation": {
                "source": "動物園の一夜",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｂ　上は精養軒の洋食から下は一膳飯、牛飯、大道の焼鳥に至るさ。",
              "citation": {
                "source": "一利己主義者と友人との対話",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "男爵と牛飯８・28（夕）　頃日亡くなつた岩村透｜男は、平素から自分を巴里仕立の結構な美術家だと信じてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「美味い牛飯屋が一軒あるんです、御存じですか、本郷の中央会堂の横丁に。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして物の二十分と経たぬ間に会堂｜側の牛飯屋の店先に立つてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十銭の牛飯も食えないなんて……。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、夜おそくなると書生と牛飯というのを食いに行き行きした。",
              "citation": {
                "source": "三筋町界隈",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂利や瓦や川土を積み上げた物蔭にはきまって牛飯やすいとんの露店が出ている。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂利や瓦や川土を積み上げた物蔭にはきまつて牛飯やすゐとんの露店が出てゐる。",
              "citation": {
                "source": "水　附渡船",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "私なんぞ本郷三丁目から通っていたんですが、本郷本富士町の警察の前に大きな牛飯食堂がありました。",
              "citation": {
                "source": "美術学校時代の岡倉先生",
                "author": "板谷波山",
                "note": "青空文庫"
              }
            },
            {
              "text": "焦土の生計として上野の山に葭簀を持ち牛飯を売る。",
              "citation": {
                "source": "年譜",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かね又という牛めし屋へ「芋ぬき」というシュチューを食べに行く。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "おこしを食うのに、ばりばり音を立てなさんな、新造に嫌われる、と世話を焼いて、帰途が、屋台の牛めしです。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "２　これも榛原の主人の話だが、小間紙をたつ職人がやはり地震の時、牛めし屋になつてゐるので、就いてきくと、たち庖丁を燒いたので、その邊の出來合では間にあはず、堺までいつて自分で自分の腕に合ふのを買ひにゆく旅費はなし、身に染みない仕事をするより、いつそ牛めし屋の方が氣樂ですからと、言つたと言ふ。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛めしやすいとんなどはもはや四十年も昔のものだ。",
              "citation": {
                "source": "地震の時",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま手許にある十五銭はこれから一度牛めし屋の暖簾をくぐればなくなってしまうのだ。",
              "citation": {
                "source": "悪魔の聖壇",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで牛めし一杯食ったところが、数時間空腹を先へのばすだけに過ぎない。",
              "citation": {
                "source": "悪魔の聖壇",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛めしを食べて、ロート眼薬を買う。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそれながら申しあげますわたしはただ息をしている女百万円よりも五十銭しか知らない牛めしは十銭葱と犬の肉がはいってるのね小さくてだるまみたいでよく泣いているおこりんぼ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪に着くなり、行きあたりばったりに駅前の闇市のバラック街へ飛びこみ、食べるだけという条件で牛めし屋の下働きに住みこみ、鍋前に立つ合間に、声を嗄して客引きをした。",
              "citation": {
                "source": "虹の橋",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛肉は、こま切れであるが、これで牛めしもやる方針である。",
              "citation": {
                "source": "烏惠壽毛",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "浅草独得（ではないが、そんな気がする）の牛めし、またの名をカメチャブという。",
              "citation": {
                "source": "浅草を食べる",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "今月の「文藝首都」に、菊岡久利氏が、西銀座の並木横丁で、十人の青年をおき、牛めし屋を開業したとか、欄外記事に見えた。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "万太郎宗匠の俳句短册を掛け、コツク帽十人の青年が、庶民に牛めしを供す樣は、想像してもホヽ笑ましい。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくもまた、馳出し記者時代には、牛めし、深川めし、三好野の強飯など迄、およそ、いかに安く、うまく、かつ滿腹するかに、苦心經營したものだつた。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとの話をよそ事にして、上野に一個の床几と葭簀とをもち出して、軒なみのスイトン屋牛めし屋さんの一軒にわりこんだのである。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は牛めしを食いに行くところだったので、「どう、一緒にカメチャボを食わない」とドサ貫を誘ったのであった。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "小屋の連中がひいきにしている「田中屋」という牛めし屋の暖簾をくぐって、ドサ貫がマスクを取ったのを見て、私はこれはと驚いた。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕もミーちゃんから誘われたが、断わりました」　へい、お待ちどおさまと、玉葱に肉がチラホラ混っている牛めしが前に置かれた。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "外で咳をとめて、戻ってくるのだろうと思った私は、気にしながらも、ひとりで牛めしを食っていた。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
