        "examples": {
          "standard": [
            {
              "text": "インターネットの普及は二十世紀末最大の技術革新の一つとして歴史に刻まれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "技術革新によって農業の生産性が劇的に向上し、食料不足の解消に貢献した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "次の技術革新は量子コンピューターにあると、多くの研究者が予測している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが一九〇〇年代の電球の技術革新は、電気屋さんが事業の柱に照明を据えることを許さなくしてしまった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "この偉大な技術革新に、電灯会社は大いに危機感を募らせた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "マッキントッシュのシステムがいかに時代をリードしてきたとはいえ、アップル一社でハードウエアの技術革新を担うのは大事だ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまでコンピューターは目覚ましい技術革新を繰り返してきたが、ダイナブックに求められるパワーを持ち運び可能なサイズに収められる日は、まだまだはるかに遠かった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
