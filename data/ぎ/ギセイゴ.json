    "definitions": [
      {
        "index": 1,
        "gloss": "onomatope (i.e. word formed by onomatopoeia)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
