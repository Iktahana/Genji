  {
    "uuid": "96bd8549-980d-5c23-84b1-21c912ae70cb",
    "entry": "御史",
    "reading": {
      "primary": "ぎょし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
