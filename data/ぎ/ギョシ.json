    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "独り巍と御史韓郁とは説を異にす。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇道を行きて入り、陛に登りて拝せざる等、不敬の事ありしかば、監察御史曾鳳韶これを劾せしが、帝曰く、至親問う勿れと。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "都御史暴昭、燕邸の事を密偵して奏するあり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝は猶北方憂うるに足らずとして意を文治に専らにし、儒臣｜方孝孺等と周官の法度を討論して日を送る、此間に於て監察御史韓郁（韓郁｜或は康郁に作る）というもの時事を憂いて疏を上りぬ。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "揚州の守将｜王礼と弟｜宗と、監察御史王彬を縛して門を開いて降る。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "右副都御史練子寧、縛されて闕に至る。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "左僉都御史景清、詭りて帰附し、恒に利剣を衣中に伏せて、帝に報いんとす。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "万暦に至りて、御史屠叔方奏して敬の墓を表し祠を立つ。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "監察御史葉希賢、臣が名は賢、応賢たるべきこと疑無しと白す。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "御史曾鳳韶、願わくは死を以て陛下に報いまつらん、と云いて退きつ、後果して燕王の召に応ぜずして自殺しぬ。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて御史ありて晟の自ら専にすることを劾しけるに、帝｜聴かずして曰く、人に任ずる専ならざれば功を成す能わず、況んや大将は一辺を統制す、いずくんぞ能く文法に拘らんと。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "御史僧を糾すに及びて、僧曰く、年九十余、今たゞ祖父の陵の旁に葬られんことを思うのみと。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "御史、建文帝は洪武十年に生れたまいて、正統五年を距る六十四歳なるを以て、何ぞ九十歳なるを得んとて之を疑い、ようやく詰問して遂に其偽なるを断ず。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "御史また今更に大に驚きて、此事を密奏す。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "御史の密奏を聞召して、即ち宦官の建文帝に親しく事えたる者を召して実否を探らしめたもう。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "丞相公孫賀、御史大夫杜周、太常、趙弟以下、誰一人として、帝の震怒を犯してまで陵のために弁じようとする者はない。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ阿諛迎合を事としても、杜周（最近この男は前任者｜王卿を陥れてまんまと御史大夫となりおおせた）のような奴は自らそれと知っているに違いないがこのお人好しの丞相ときた日には、その自覚さえない。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌年、監察御史、陳郡の袁は、しかし、供廻りの多勢なのを恃み、驛吏の言葉を斥けて、出發した。",
              "citation": {
                "source": "山月記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌年、監察御史、陳郡の袁は、しかし、供廻りの多勢なのを恃み、駅吏の言葉を斥けて、出発した。",
              "citation": {
                "source": "山月記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは朝野類要の「安撫転運、提刑提挙、実分御史之権、亦似漢繍衣之義、而代天子巡狩也、故曰外台」と云ふと同じく、外台を以て地方官の義となしたのである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "唐の貞元年中に盧虔という人が御史に任ぜられて、宿所を求めた末にかの古屋敷を見つけた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "宣室志（唐）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いったん買い取った以上は、その女を他人に譲ることは出来ないというので、さらに御史台に訴え出たが、ここでも容易に判決をくだしかねて、かれこれ暇取っているうちに、問題の女は又もや姿を消してしまった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "異聞総録・其他",
                "note": "青空文庫"
              }
            },
            {
              "text": "泰不華元帥はその当時｜西台の御史であったので、その事件の記録に朱書きをして、「鬼贓」としるした。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "輟耕録",
                "note": "青空文庫"
              }
            },
            {
              "text": "渾は後に都御史になって政治に功績があった。",
              "citation": {
                "source": "陸判",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは『日本紀』と参照して、かの天皇の御史跡たるを知るのみならず、古えわが邦に特に火を重んずる風ありしを知るに足れり。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "宣慰大使崔渙や、御史中丞宋若思や、武勲赫々たる郭子儀などは、その最たるものであった。",
              "citation": {
                "source": "岷山の隠士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、監察御史や起居舎人知制誥を経て、とんとん拍子に中書門下平章事になりましたが、讒を受けてあぶなく殺される所をやっと助かって、驩州へ流される事になりました。",
              "citation": {
                "source": "黄粱夢",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "創建清眞寺碑記賜進士及第戸部員外郎兼侍御史王※撰篆竊聞俟百世而不惑者道也。",
              "citation": {
                "source": "創建清眞寺碑",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "其次に御史であります、御史は邦國都鄙及び萬民を治むることを掌ると云ふことを書いてありまして、これは周の時の冢宰の副官になるのだと云ふことを書いてあります。",
              "citation": {
                "source": "支那に於ける史の起源",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
