        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして、ぼくたちは、ギネタという小さい町へ入ったのだ。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギネタは、人口八千人ばかりの、小都会であった。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前は、このギネタに、多島海｜総督府があり、総督がいたそうな。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すばらしい計画　ぼくたち二人は、しばらくその豆潜水艇｜恐龍号（どうです、すばらしい名前ではないか）の運転を習うために、ギネタ船渠会社へ通った。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでその夜、ぼくたちはこの荷物を海岸のギネタ船渠の構内にあるぼくたちの潜水艇の中へはこびいれた。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろこのギネタの町は、そんなに繁盛している町ではないから、一日のうちに、入港船も出港船も一隻もないことがめずらしくないのである。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日の漁をおえてギネタの港へもどっていく現地人の舟であった。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐龍号は、それからギネタの方へ引っ返した。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでぼくたちは相談して、ギネタの北東七マイルのところにある小さい無人島へ艇をつけ、夕方まで休むことにした。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギネタ湾頭の浅瀬に艇をのしあげて、ぼくたちは「やれやれ助かった」と思った。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレクサンドリアには最後の有名なギリシア医師であったパウルス・アエギネタが住んでいた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はまたテルトゥリアン（Tertullian）により引用され、パウルス・アエギネタ（アエギナのパウルス）によってはメジナチュウ（guinea-worm）を記載した最初のギリシャ人とされている。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "不思議で馬鹿らしいガレノスの学理にパウルス・アエギネタ（Paulus Aegineta：ビザンティンの医師、c.625-c.690）が密接に従っていたことは、薬物学からの次の引用が示している。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンテュロスの著作の断片はパウルス・アエギネタによって保存され、古代になされた仕事の質を示している。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "パウルス・アエギネタ　パウルス・アエギネタ（アエギナのパウルス）はギリシャの医者として最後に有名であり、最も有名な一人であった。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "医療の衰退　パウルス・アエギネタの時代の後に内科学および外科学の臨床は急速な低下を起こし、そして５世紀にわたって進歩は起きなかった。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
