        "examples": {
          "standard": [
            {
              "text": "議事日程に載っていない案件は、この会議では議論されない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "議事日程を事前に配布することで、準備が容易になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その議事日程には、重要な案件が三つ含まれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "その議事日程の中、委員付託による四つの問題の検討がされている。",
              "citation": {
                "source": "ペンクラブのパリ大会",
                "author": "――議題の抜粋についての感想――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一昨日のことなら、今この議事日程について質問中でありますから、発言を許しませぬ」　正造は突立ったまま、小首をかしげたが、「左様ですか、前に政府委員には発言をお許しになったのでございましょう。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "議事日程を止めてもらわなければならぬ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八三〇年十月、人の記憶するかぎり、ナポレオンを円柱塔の下に埋めようとの提議を議事日程で退けた数日後、議会は全員泣きはじめ嘆きはじめた。",
              "citation": {
                "source": "死刑囚最後の日",
                "author": "LE DERNIER JOUR D'UN CONDAMNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
