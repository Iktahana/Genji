[
  {
    "uuid": "d9aa64b4-4ef2-5a2d-a4bd-b098dcf81d6c",
    "entry": "漁期",
    "reading": {
      "primary": "ぎょき",
      "alternatives": [
        "りょうき"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
