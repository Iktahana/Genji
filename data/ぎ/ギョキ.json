  {
    "uuid": "991c0289-e71a-59ba-a403-d716f76bed57",
    "entry": "御忌",
    "reading": {
      "primary": "ぎょき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
