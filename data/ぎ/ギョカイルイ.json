        "examples": {
          "standard": [
            {
              "text": "魚介類には豊富なタンパク質が含まれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その地域は魚介類の宝庫として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "様々な魚介類を使ったこのスープは絶品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "海の魚介類は、漁師の漁る灯火の下に、群をなして集つて来るし、山野に生棲する昆虫類は、人家の灯火や弧灯に向つて、蛾群の羽ばたきを騒擾する。",
              "citation": {
                "source": "月の詩情",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "１　最上の米（新潟・福島・秋田｜辺の小粒）　２　最上の酢（愛知｜赤酢・米酢）　３　最上の魚介類、だいたいにおいていちばん高価な相場のもの。",
              "citation": {
                "source": "握り寿司の名人",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "内子も外子もともに、独特の味をもっているが、その基調となっているものは、魚介類の卵の味である。",
              "citation": {
                "source": "母性愛の蟹",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに、病気の魚貝類が身を寄せて、静かに死んでゆく。",
              "citation": {
                "source": "竜宮",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべて、魚貝類の色とりどりの水中の群舞を形どつたものであるが、たまには、殺気満々たる海底の死闘をうつしたものもある。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "米でも魚貝類でも、食うと食わざるとを問わず、食う習慣と食わざる習慣を持つとを問わずこれを一切平等に配給する、骨の折れることではある。",
              "citation": {
                "source": "食べもの",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
