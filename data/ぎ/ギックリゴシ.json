        "examples": {
          "standard": [
            {
              "text": "重い荷物を持ち上げた瞬間にぎっくり腰になり、その場から動けなくなってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ぎっくり腰で一週間仕事を休んだおかげで、日頃の姿勢の悪さを痛感した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "父はぎっくり腰をくせにしており、年に一、二度は整骨院のお世話になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "」と云うと、ぎっくり腰を折って、膝の処へ一文字に、つん、と伏せた笠の上、額を着けそうにして一ツおじぎをした工合が、丁寧と言えば丁寧だが、何とも人を食った形に見える。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのう誰かがぎっくり腰になったらしい。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とギックリ腰を曲げる。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ギックリ腰というやつではないかと思うんですがね」　医師はその言葉に、別に反応は示さなかった。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
