        "examples": {
          "standard": [
            {
              "text": "父はギャング映画が好きで、休日になると古いDVDを引っ張り出して観ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "そのギャング映画は1930年代のシカゴを舞台に、禁酒法時代の闇社会を描いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "映画評論家はその作品を「近年まれに見る完成度の高いギャング映画だ」と絶賛した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "あきらかに善人、女将あるいはギャング映画の影響うけて、やがて、わが悪の華、ひそかに実現はかったのではないのか、そんな大型の証拠、つきつけられては、ばからしきくらいに絶体絶命、一言も弁解できないじゃないか、ばかだなあ、田舎の悪人は、愛嬌あって、たのもしいね。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "密林へ阿片を埋めたりなんかして、ギャング映画ね。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋のギャング映画ではありません。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
