        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」奥歯をギリリと鳴らして、検事が綱から手を放すと、その手に法水は合鍵の束を与えた。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おきみは、よろ／＼と立ち上り、うしろの壁へ倒れかゝりながら、ギリリと白い齒をむいた。",
              "citation": {
                "source": "天國の記録",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その眼つきと、身のこなしが、ギリリと音を立てるように、僕に迫つて來て、何かもう、絶對絶命の所に追いつめられた氣が僕はしたのです。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ギリリリリ、ギリリリリ……。",
              "citation": {
                "source": "赤いカブトムシ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
