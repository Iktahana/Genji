        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どうせ文楽の広告ビラだろうくらいに思い、懐手を出すのも面倒くさく、そのまま行き過ぎようとして、ひょいと顔を見ると、平べったい貧相な輪郭へもって来て、頬骨だけがいやに高く張り、ぎょろぎょろ目玉をひからせているところはざらに見受けられる顔ではない――すぐお前だとわかった。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "二つのぎょろぎょろ目玉。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるでぎょろ目をむいているようで極めて醜い。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見してかび臭い城出身、顔色の悪いぎょろ目の女と、ニタを比べて見ろ。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもぎょろ目でムーアに浴びせた憎しみは、血の気が引いても失ってない。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
