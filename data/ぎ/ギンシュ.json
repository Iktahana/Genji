        "examples": {
          "standard": [
            {
              "text": "江戸時代の浮世絵には銀朱が使われた作品が多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "銀朱で描かれた唇が、浮世絵の美人画を引き立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この屏風には銀朱と金箔が施されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "いつか白茶地に銀朱の色のはいった上着を羽織って居た夫人は今までよりもずっと上品に見えた。",
              "citation": {
                "source": "ガルスワーシーの家",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
