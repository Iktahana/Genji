        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼は盛んに逆理を用いた。",
              "citation": {
                "source": "岷山の隠士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが金言というやつは、それ自体では値打ちがなく、逆理において値打ちがあるらしい。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同じで、有能者が無能者に負けることの逆理を説き出したのが、なるほどと聞きなされました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツェノンの逆理以来、この連続の問題が、少し大袈裟にいえば、近代数学における最大の課題であった。",
              "citation": {
                "source": "神仙道と科学",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの偉大な平凡の中に、幾多の逆理が啓示されてくるのを順次に見守っています。",
              "citation": {
                "source": "民藝とは何か",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての工藝の美はこの驚くべき逆理を告げています。",
              "citation": {
                "source": "民藝とは何か",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがとりわけ二つの驚くべき逆理をここに発見する。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに不思議な逆理であろう。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
