        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「おとうさん、おとうさん」「とんちゃん、とんちゃん」　糟谷はきょうにかぎって、それがうるさくてたまらないけれど、子煩悩な自分が、毎朝かならず出勤のまえに、こうして子どもを寵愛してきたのであるから、無心な子どもは例のごとく父にかわいがられようとするのを、どうもしかりとばすこともできない。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "木蘇の御嶽山が、その角々しき峰に白雪を戴いて、青ぎった空に美しい。",
              "citation": {
                "source": "白菊",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "青ぎった空に翠の松林、百舌もどこかで鳴いている。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "汗で油ぎってる黒い顔に、いつも面皰を吹き出してる中学生の群を見る時、僕は自分の過去を回想して、言いようもなく陰惨の思いがする。",
              "citation": {
                "source": "老年と人生",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "労働者のいない船が、バルコンを散歩するブルジョアのように、油ぎった海の上を逍遥し始めた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "金はちぎって出せるが、子供はちぎる訳にはいかない。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪は船と陸とをヴェールをもってさえぎった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいえ、そうよ、ま、黙ってらっしゃい」彼女は、小倉が何もいおうとしてもいないのに、あわてて彼のいうのをさえぎった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは足へ煮えたぎった湯でもかかった時のように飛び上がるのだった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "すくなくとも、私たちの身のまわりに於いては、古い道徳はやっぱりそのまま、みじんも変らず、私たちの行く手をさえぎっています。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶるぶる煮えたぎって落ちている。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前の事は、お城の外の人たちまで褒めちぎっているそうだ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、玄関にも廊下にもお座敷にも、本がぎっしりなので驚いた。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "相変らず、玄関にも廊下にもお座敷にも、本がぎっしり。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」前の便箋とはちがう、巻紙を引きちぎったような小さい紙片を差し出した。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（節子）（それをさえぎって、鋭く）いいえ。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "「勝手に夢の国で、ぐずぐずしていて、」と神はさえぎった。",
              "citation": {
                "source": "心の王者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おはぐろのような臭気が車内にみなぎっていたが出所は分からない。",
              "citation": {
                "source": "猫の穴掘り",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中にぎっしり色々の品物をつめ込んであった。",
              "citation": {
                "source": "チューインガム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その世界では現在あるような活字で印刷した書物の代りに映画のフィルムのようなものが出来ていて、書庫の棚にはその巻物がぎっしり詰っている。",
              "citation": {
                "source": "教育映画について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると彼女の癇高い水銀色の声が市内の電線を引ちぎってしまう。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が彼の興奮をさえぎって単刀直入に、　――アダを私に世話していただけませんか。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "地の透く髪を一筋｜梳に整然と櫛を入れて、髯の尖から小鼻へかけて、ぎらぎらと油ぎった処、いかにも内君が病身らしい。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥方と目配をし合って、とかく銚子をこぎって不可ん。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それに、もうやがて、庭を横ぎって、濡縁か、戸口に入りそうだ、と思うまで距たった。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、陸軍病院の慰安のための見物がえりの、四五十人の一行が、白い装でよぎったが、霜の使者が通るようで、宵過ぎのうそ寒さの再び春に返ったのも、更に寂然としたのであった。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……四日町を抜けて、それから小四郎の江間、長塚を横ぎって、口野、すなわち海岸へ出るのが順路であった。",
              "citation": {
                "source": "半島一奇抄",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘉吉が、そこで、はい、櫓を握って、ぎっちらこ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうか言うて、東京のお客様に、あんまりな人も見せられはしませずな、容色が好いとか、芸がたぎったとかいうのでござりませぬとなあ……」「いや、こうなっては、宿賃を払わずに、こちとら夜遁をするまでも、三味線を聞かなきゃ納まらない。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時に控え室となっていた教場の机の上にナイフでたんねんに刻んだいろいろのらく書きを見ていたら、その中に稚拙な西洋婦人の立ち姿の周囲にリリアン・ギッシュ、メリー・ピクフォードなどという名前が彫り込んであった。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
