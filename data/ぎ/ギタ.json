        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夜、木村が、ギタを持って家へ遊びに来たので、ひいてみ給え、と言ってやった。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨の中を、わざわざギタをかかえてやって来る奴は、馬鹿だ。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうは、兄さんに、ギタを買ってもらった。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "起きてすぐ、ギタを、布で磨いた。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしゃくしゃして来て、僕は、ギタをひいてばかりいた。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギタが、ますます巧くなったが、これは何も自慢にならない。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "机よ、カーテンよ、ギタよ、ピエタよ。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギタは、押入れにしまい込んだ。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨夜、ギタをかかえて出かけて、それっきり家へ帰らないのだそうだ。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言ったら、首をかしげて、「ギタを持って出たから、きっとあなたの所だとばかり思って、ちょっとお寄りしてみたのですが。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕は、もうギタは、やめました。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田ノ詮議モ終ラヌサキカラ、ソノヤウニ騒ギタテテハ、モノノ順序ガドウナリマス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "未来派の絵というと、ギタアが出て来るのは、あれはどういう理由によるのだろうか。",
              "citation": {
                "source": "二科会展覧会雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつたい「櫻の園」には第一｜幕の汽車の音、第二｜幕のギタアの音色、第四｜幕の終りの櫻の木を切り倒す斧の響きなどと、塲面々々の感じと相俟つて音響の効果が實に巧に用ゐられてゐるが、私の狹い知識の範圍では、戯曲に球突の球の響きなどを用ゐたのはひとりチエエホフあるのみのやうである。",
              "citation": {
                "source": "文壇球突物語",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "口ギタなく罵る叫びは、向うの山壁にこだました。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘は食後の洗物を手伝って、それから蓄音機をかけて、若い事務員たちのダンスの相手をしてやっていたが、疲れた様子もなく、まだ興を逐うこの僻地に仮住する青年たちのために、有り合せの毀れギターをどうやら調整して、低音で長唄の吾妻八景かなにかを弾いて聞かしている。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前には麦藁帽の中年の男と、白地に赤い斑点のはいった更紗を着た女とが、もたれ合ってギターをかなでる。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "旗亭の入り口に立ってギターをひく若者があった。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "表の町のほうでギターにあわせて歌っている声もこの井戸の底から聞こえて来た。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "朧夜を流すギターやサンタ・ルチア（昭和五年五月、渋柿）　　　　　　　＊　うすら寒い日の午後の小半日を、邦楽座の二階の、人気の少ない客席に腰かけて、遠い異国のはなやかな歓楽の世界の幻を見た。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギターを抱え、演奏しながら歌うというスタイル。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギターとベースを弾き、ドラムを叩くことはけっして伴奏ではなく、歌うことと渾然一体となった演奏だったのです。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らよりうまいギタリスト、ベーシストそしてドラマーは、当時でもいくらでもいたでしょう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろ、へたくそなギターを含めた彼らの世界を、彼らだけで作り上げるということに、若い世代は新鮮な驚きを感じた、この要素の方が本質的なのではないかと思います。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビートルズのように無内容で商業的な歌ではなく、アコースティックギター一本を抱えて政治的なメッセージにあふれる自作の歌を歌うはずのボブ・ディラン。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのボブ・ディランが一九六五年のニューポート・フォーク・フェスティバルにエレクトリックギターを抱え、バンドを引き連れて登場したとき、観衆の多くは目を丸くしました。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔ながらのアコースティックギターを持ってもう一度舞台に立った彼は、涙ながらに「新しいマッチをすって、やりなおすんだ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギターを抱えての弾き語りというスタイル、あるいはギターの奏法などにおいて、一九六〇年代半ばから広がりはじめたフォークソングには復古的なにおいも入りまじっていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "安田講堂攻防戦の直後、新宿西口の地下広場で、長髪の貧相な若者たちがギターを抱えて歌いはじめた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
