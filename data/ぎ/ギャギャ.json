        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ギャアギャアギャア……ギャギャギャギャッ……」　と人間離れのした声を立てた。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ギャギャギャギャ、ギイギイギイギイッ……」　往来を通りかかっていた人が皆、走り集まって来たので待合室の中が急に、暗くなった。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中から探偵小説らしい奴を一匹引っぱり出そうとすると、ちょっと見たところ全然別物に見えるほかの化物連中が、その探偵小説の胴体に、背中や尻ペタ同志で、シャム兄弟のように繋がり合って、ギャギャ悲鳴を揚げながら絡み合って出て来るから、ビックリさせられてしまう。",
              "citation": {
                "source": "探偵小説の正体",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギャギャッとたまぎる雷象の悲鳴。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "君がギャギャやかましい声を立てると、厭でも痛い目に合わせなきゃならないてものさ。",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
