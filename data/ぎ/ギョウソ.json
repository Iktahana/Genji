        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オオバネルは、ミストラル、ルウマニユ等と相結で、十九世紀の前半に近代プロヴァンス語を文芸に用ゐ、南欧の地を風靡したるフェリイブル詩社の翹楚なり。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオバネルは、ミストラル、ルウマニユ等と相結で、十九世紀の前半に近代プロ※ンス語を文藝に用ゐ、南歐の地を風靡したるフェリイブル詩社の翹楚なり。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "三女史の如きは女流小説家の翹楚である某々女史たちや、婦人理学士の第一着者である某々女史たちと共に、確かに我国婦人界の宝の人であると思います。",
              "citation": {
                "source": "平塚・山川・山田三女史に答う",
                "author": "与謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "佛教排斥者の翹楚として聞えた、唐の傅奕でも、韓愈でも、皆佛教に無父無君といふ非難を加へて居る。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "理義精純、邦儒語録ノ翹楚タリ。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "佐藤一齋略傳",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
