        "examples": {
          "standard": [
            {
              "text": "このセーターの素材には擬毛が混ざっているので、本物のウールより安い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "擬毛は天然ウールと比べて、手入れが簡単である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "品質表示に擬毛が三〇パーセント含まれていることが記載されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "怠惰の暦いくつかの季節はすぎもう憂鬱の櫻も白つぽく腐れてしまつた。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜八時すぎもうねてしまう。",
              "citation": {
                "source": "日記",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "津の国｜難波の里は夏がすぎもう秋風が白い砂地のうえをひいやりと過ぎて行った。",
              "citation": {
                "source": "荻吹く歌",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　どんな烈しい人間の悪感情に向っても、親鸞は親鸞の気の持ち方に、さざ波ほどの揺るぎもうけなかった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
