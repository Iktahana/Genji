        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "喧嘩で何発も殴られてギタギタになった彼は、医者の診察を受けに行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "交通事故で乗用車がギタギタに破損してしまい、運転手の無事を祈った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ボクシングの試合で、相手に一方的にギタギタにやられてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "霧壁の上では雲塊が集まり、飛行機はギタギタの油滴に覆われた。",
              "citation": {
                "source": "四日闇夜",
                "author": "THE FOUR DAYS' NIGHT",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
