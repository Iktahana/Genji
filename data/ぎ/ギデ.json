        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "なおほかに英文で、ウォドのピュア・ソシオロジイとサイキカル・ファクタアス、ギディングスのプリンシプル・オブ・ソシオロジイ。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギルボアの北麓には、ギデオンがメデア人を撃ちし時、水を飲ませてイスラエルの勇士をすぐりし泉の跡ありと、案内者は遥に山下の一所を指しぬ。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホントニ、コレハヱカキノ玉ネギデス。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイタリ、タタイタリ、コスツタリ、ナカハ　タイヘンナサワギデス。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギデオン・ヘイク氏のほうは生気のないガラスのような目でやはり学寮の庭を眺めていた。",
              "citation": {
                "source": "共産主義者の犯罪",
                "author": "THE CRIME OF THE COMMUNIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデソレデハ　ユカウトオホイソギデシタクシテ、ジドウシヤニノリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノウサギハアル人ガ「オヂヤウチヤンニサシ上ゲマス」トイツテ、モツテキテクレタウサギデス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもコロムビアのニノン・ヴァランが歌う「ハバネラ」や「セギディリア」などは、さすがに昔の大カルメン歌手らしく優れたものだ。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "カルメンと同じスペイン人で、若くて死んだスペルヴィアの「ハバネラ」や「セギディリア」も異色がある。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピアノの一枚物では、老ピアニスト、ヴィニエスのピアノでコロムビアに「セギディリア」「グラナダ」があり、ビクターに「カディス」がある。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ハバネラ』でも『セギディリヤ』（Ｊ五四〇〇）でも、少しお品が良いが、この人ほど見事に歌える人は、まず断じて当代にない（スペルヴィアは別の意味でうまい）。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "『カルメン』の「ハバネラとセギディリア」（Ｊ五三三七）は本当に焔と血の匂いがする。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "実例を示せば――『カルメン』Carmen で、「ハバネラ」Habanera と「セギディリア」Seguidilla と「シャンソン・ボエーム」〔Chanson Bohe^me〕。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
