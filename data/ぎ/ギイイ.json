          "literary": [
            {
              "text": "続いて扉が重々しくギイイ――ッと開いて、何やらガサガサと音を立てて這入って来た気はいがしたので、私は反射的に跳ね起きて振り返った。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、あの大岩が、ギイイッと音をたてて、むこうへたおれていくではありませんか。",
              "citation": {
                "source": "奇面城の秘密",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "門を入って、暗闇の玄関にたどりつくと、ギイイイイと軋む音を立てて扉が開かれた。",
              "citation": {
                "source": "偉大なる夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
