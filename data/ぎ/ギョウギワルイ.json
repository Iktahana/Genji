        "examples": {
          "standard": [
            {
              "text": "肘をついたまま食事を続ける彼を見て、彼女の両親は目を見合わせ、行儀悪いな、と眉をひそめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "図書館で電話に出て大声で話し始めた男性を司書が注意すると、「行儀悪いとか関係ないでしょ」と逆ギレした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "行儀悪いとわかっていながら、疲れ果てた帰り道には電車の中でつい食べてしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "」鶴村は、行儀悪い格好で胡坐をかいてゐる彼の方を向いて訊ねた。",
              "citation": {
                "source": "眠い一日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
