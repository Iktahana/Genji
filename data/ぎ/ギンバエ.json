        "examples": {
          "standard": [
            {
              "text": "夏の厨房に置き忘れた魚の切り身に銀蝿がたかり、慌てて窓を開けて追い払った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "銀蝿は光沢のある腹部が特徴で、肉や魚に素早く産卵するため厄介な存在だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "屋外の生ごみ置き場に銀蝿が集まらないよう、蓋をしっかり閉めるよう張り紙が貼られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "駈け下りて来た久作の足もとから、わッと、銀蝿の群れが唸って舞った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
