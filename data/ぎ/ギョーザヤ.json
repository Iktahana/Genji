        "examples": {
          "standard": [
            {
              "text": "路地裏の餃子屋はいつも行列で、開店前から常連客が並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "その餃子屋の焼き餃子は皮がパリパリで、生ビールとの相性が抜群だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "学生時代によく通った餃子屋が閉店したと聞き、彼は懐かしさで胸が痛んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "これらの餃子屋は、皆、安直で、ギドギドなのを食わせるので、流行っている。",
              "citation": {
                "source": "ああ東京は食い倒れ",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "餃子屋につづくものは、お好み焼。",
              "citation": {
                "source": "ああ東京は食い倒れ",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
