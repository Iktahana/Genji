        "examples": {
          "standard": [
            {
              "text": "この植物の葉は逆向きに生えているのが特徴だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "葉脈の逆向きな走行パターンを顕微鏡で観察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "トゲが逆向きに生えているため、昆虫の移動が制限される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
