      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　魚容は、ぎゃふんとまいって、やぶれかぶれになり、「よし、行こう。",
              "citation": {
                "source": "竹青",
                "author": "――新曲聊斎志異――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ぎゃふんと参った。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "生命がけで、描いて文部省の展覧会で、平つくばって、可いか、洋服の膝を膨らまして膝行ってな、いい図じゃないぜ、審査所のお玄関で頓首再拝と仕った奴を、紙鉄砲で、ポンと撥ねられて、ぎゃふんとまいった。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "亭主ぎゃふんと参った体で、「二進が一進、二進が一進、二一天作の五、五一三六七八九。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　吉弥はちょっとぎゃふんとしたようであったが、いずまいを直して、「聴いてたの？",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "これなら、相手方は、ぎゃふんというだろうと思っていたのに、帰って来た返事を読むと、“なるほど、洞内に於て、何某が死亡しているようであるが、その写真で明瞭であるとおり、何某から五六メートルも離れた位置より、彼等の内の何人たりとも何某の首を切断することは不可能事である。",
              "citation": {
                "source": "鬼仏洞事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで竹内の奴、一度にぎゃふんさ。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私どうしても、どうあっても今日のうちに、今日この日のうちにあれをつっ返してやって、ぎゃふんという目に逢わしてやらないじゃ承知できないの。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　どうだ、ぎゃふんだろうとモラガスの応答を待っていると、案の条かれはにやにやして話題の急転を計った。",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            },
            {
              "text": "父さんや母さんも、それを聞いたらぎゃふんだ。",
              "citation": {
                "source": "にんじん",
                "author": "POIL DE CAROTTE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「実はぎゃふんと参ったところなんだ。",
              "citation": {
                "source": "論語物語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "――どうだ、ぎゃふんと参るじゃないか。",
              "citation": {
                "source": "論語物語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "強いて、屍骸に近寄ろうというのならば、おまえも、屍骸にしてやろう」「…………」不気味なその一言に、ぎゃふんと参ってしまった。",
              "citation": {
                "source": "怪奇人造島",
                "author": "寺島柾史",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い人に一度はぎゃふんと言わせてもらうと、家んなかの空気がすっきり入れ替わるから」　そう言いながら母親は茶碗にお櫃からご飯をよそった。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「すべての女にあなたのような謀反気があったら、男はぎゃふんだけれど、そして面白いんだけれど、そうはゆかないわね。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが世の禁酒運動に対する防衛説は、いつでもきまって神祭りはどうする、婚礼の祝には昔から飲むではないかという二つの点で、是でもって始終歴史にうとい人を、ぎゃふんと言わせている。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊勢では櫛田川のほとりのある村で、可愛い童子が樹の上にいるのを見て、さる稚児と見るより早く木に登りと口ずさんでいい気になっていると、すぐにその童子が下の句をつけて、狗のようなる法師来たればとやり返したので、ぎゃふんと参って早々に遁げ去ったという話。",
              "citation": {
                "source": "こども風土記",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはいい、雲の上人も、ぎゃふんであろう」　と、結び封にして、墨菊太夫の手へわたした。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
