  {
    "uuid": "d6e97014-de0e-5348-ab46-3114acc2810a",
    "entry": "ぎゃふん",
    "reading": {
      "primary": "ぎゃふん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
