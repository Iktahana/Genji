[
  {
    "uuid": "fc1e4b18-14bf-555f-a83d-33edd8961dd8",
    "entry": "ギラリ",
    "reading": {
      "primary": "ギラリ",
      "alternatives": [
        "ぎらり",
        "ギョロリ",
        "ぎょろり",
        "ギロリ",
        "ぎろり",
        "ギロッ",
        "ぎろっ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "副詞-と"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "staring (e.g. eyes)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "抜き身の短刀がギラリと光り、男は思わず一歩後退した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "老師の目がギラリと光り、弟子は思わず背筋を正した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "波打ち際に落ちていた貝殻が朝日を受けてギラリと輝いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "が、慌しく刀を拾うと、何を思う隙も無さそうに、ギラリと冷かに抜いて、鞘を棄てて提げたのである。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と小刀をギラリと拔く。",
              "citation": {
                "source": "麥搗",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大将はサーベルをギラリと抜いて兵隊に眼くばせをしますと、兵隊も鉄砲に剣をつけてあとから上って行きました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "充血した顔の、額に顱割のある、髯の薄い人物で、ギラリと輝く黄金縁の目金越に、看護婦等を睨め着けながら、「君たちは……」　と云うた眼が、目金越に血走った。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ面を打って巴卍に打ち乱れる紛泪の中に、かの薙刀の刃がギラリと光って、鼻耳をそがれはしまいか。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤いお盆がそれこそサーチライトのようにギラリギラリと輝きまわり屈折しまわる。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "痒くてたまらないのでソーッと手を遣って掻こうとすると、直ぐに翁の眼がギラリと光る。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と叫んで、ギラリと白刃を抜き放つて見せた。",
              "citation": {
                "source": "或る日の運動",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "木ッ葉旗本、行くぞッ、行くぞッ」　ののしり叫びざまにギラリギラリと抜いて放って、四人もろとも、正面左右から迫って来たのを、退屈男は莞爾たり！",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もうし、あの、殿様、お願いでござります」「なにッ」　同時にギラリ、退屈男の目が冴え渡りました。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "溜漆重籐飾り巻のけっこうやかなひと張りを奥から持ち出すと、ギラリ、目を光らしながら小声で囁きました。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　声もろ共に、ギラリ抜いたのは相模守の一刀です。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして又ギラリと晴れ渡ったと思うと、一人の騎馬の少年の姿が現われました。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして一歩退ってギラリと剣を引き抜いたと思うと、女王に飛びかかろうとしましたが、彼の時早くこの時遅く、青眼先生がうしろからしっかりと抱き止めました。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」最上の浪人と呼ばれる武士、自分の大刀をギラリと抜いた。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　すると続いて七軒町という武士、同じくギラリと引き抜いた。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "柔和な表情はしているが、どこか底知れないものを湛えているし、どうかした拍子に顳※に浮かぶギラリとしたものが、やはり、複雑な過去を潜めており、そう単純に親切ではあり得ないことを暗示しているようでもある。",
              "citation": {
                "source": "曲者",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "その首領らしき人物は、ギラリと眼を光らせると、サッと右手を水平にさし上げ、「右足のない梟！",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺と一所に静かに、二三度うなずいた船長は伊那少年を顧みて、硝子のような眼球をギラリと光らした。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がソンナ風に仕事に忙殺されている中に、白樺の林の奥の方から強力な携帯電燈の光りがギラリギラリと現われて、患者の間を匐いまわりながらダンダンと私の方へ近附いて来た。",
              "citation": {
                "source": "戦場",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
