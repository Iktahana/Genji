[
  {
    "uuid": "9f805569-fd8b-5ce7-9aef-0ba50345a3de",
    "entry": "漁舟",
    "reading": {
      "primary": "ぎょしゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "small fishing boat",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "百尺岩頭燈台の白堊日にかがやいて漁舟の波のうちに隠見するもの三、四。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁舟江心に向かいてこぎ出せば欸乃風に漂うて白砂の上に黒き鳥の群れ居るなどは『十六夜日記』そのままなり。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒く静かな入江には、漁舟が四五艘動かずに浮いていた。",
              "citation": {
                "source": "「紋」",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大江の上には帆走っているやや大きい船もあれば、篠の葉形の漁舟もあって、漁人の釣しているらしい様子も分る。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "大江の上には帆走つてゐるやゝ大きい船もあれば、篠の葉形の漁舟もあつて、漁人の釣して居るらしい様子も分る。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三日の午後富之助は鹿田と伴つて、漁舟を借りて釣に行つた。",
              "citation": {
                "source": "少年の死",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して前には城ヶ島の緑が横たはり、通り矢とその間の五丁にも足らぬ海峡を小蒸汽が来、渡海船が通り、余多の漁舟が漕ぎつれて行く、而して遠くは煙霞の間に房州の山をのぞみ、欧洲航路の汽船軍艦はいつも煙を曳いてこの眺望の中を消えて行つたなど、全く明快な近代劇の舞台面であつた。",
              "citation": {
                "source": "雲母集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "止まること數日、たま／＼天曇りて海氣濛々たり、漁舟皆河口よりかへりぬ。",
              "citation": {
                "source": "長塚節歌集　中",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボートの上にカンバスをかまぼこ形に張ったのが日本の屋根舟よりはむしろ文人画中の漁舟を思い出させた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "舟人は漁舟を陸に曳き上げたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度は松の木の代りに鴉のとまり場は其處に置き竝べてある漁舟の舳となり艫となつた。",
              "citation": {
                "source": "鴉と正覺坊",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "動かない漁舟、漕ぐ手も見ゆる帰り舟、それらが皆活気を帯びてきた。",
              "citation": {
                "source": "浜菊",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "湊と云へど、わづかに小なる漁舟を通ずるばかりの處也。",
              "citation": {
                "source": "常磐の山水",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝに至りて、商家蜒居と接し、商船漁舟と竝び、絃歌欸乃に交れり。",
              "citation": {
                "source": "金華山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "二兒をつれて、濱邊を散歩しけるに、一艘の漁舟、沖より歸りしばかりにて、漁せし鰕、少しばかり舟に有り。",
              "citation": {
                "source": "親馬鹿の旅",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "九日の日は、金子重輔が舟がとにかく漕げるというのを幸いに、漁舟を盗んで、黒船へ投じようとした。",
              "citation": {
                "source": "船医の立場",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上、弁天堂のすぐ真下の渚に、二隻の漁舟が繋ぎ捨ててある。",
              "citation": {
                "source": "船医の立場",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　七郎丸と鱗丸は発動機を持たない手おしの漁舟である。",
              "citation": {
                "source": "円卓子での話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁舟や、沖を航海している帆前船などが難船して、乗組の漁夫や水夫が溺死したりするのは、いつもその風の吹く時でした。",
              "citation": {
                "source": "少年と海",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つい一カ月ばかり前にも、村の漁舟が一艘沖から帰りがけに、その風に遇って難破し、五六人の乗組の漁夫がみんな溺死して、その死体がそれから四五日もたってから隣村の海岸に漂著しましたが、その日も矢張り朝から白山の姿が物すごく海の中に魔物のように立っていました。",
              "citation": {
                "source": "少年と海",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「漁舟なんかお前、一年に二艘や三艘打ちあげられるけれど、あんなことはなかったよ。",
              "citation": {
                "source": "少年と海",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "入江には小さな漁舟が五六｜艘、舷を接してつながれていました。",
              "citation": {
                "source": "少年と海",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父も継母も寺へお詣りに行つて居た留守の間に、私は小さな風呂敷包を一つ抱へて、干魚を積んで加賀の金石まで行く小さな漁舟の一隅に身を寄せて、また再び相見えようとの予想もなく、故郷の山河に別れを告げた。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹木家屋の遠近濃淡漁舟人馬の往来坐臥、皆狩野の規矩に準り、一点の非の打ち所もない。",
              "citation": {
                "source": "北斎と幽霊",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "周囲四里の小湖ではあったが、浪が立てば随分危険で、時々｜漁舟を覆えした。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シドチのボートは帆をはつて漁舟を追ふたが、漁舟の方でも帆をあげて逃げはじめた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "湾には煙立つ汽船、漁舟が浮いて居る。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
