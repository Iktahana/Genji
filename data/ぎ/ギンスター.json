        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "経文歌の「アレルヤ」は映画「オーケストラの少女」のディアナ・ダービンで一般に知られたが、ダービンよりはコロムビアのギンスターがうまく、ギンスターよりはＨ・Ｍ・Ｖのエリザベト・シューマンがよく、シューマンより、ビクターのオネーギンが上手で、最後にオネーギンよりも、旧盤のファーラーの方が魅力がある。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビクターのギンスターにも幾枚かあり、シュナーベル夫人にもあるが、それは省略する。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギンスター　Ria Ginster　愛すべきソプラノだ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかに、ポンスも、ムーアもギンスターもある。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
