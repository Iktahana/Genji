        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "登りかけたところで、ぎゃお、わお、がお、うわァああ、わお、ぎゃおお、うわうう、ぎゃお、わあ、わお。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぎゃお、わお、がお、うわァああ、わお、お、お、ぎゃお、うわうう、ぎゃお、わお、わお、おう。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぎゃお、わお、がお、うわァああ、わお、おお、ぎゃお、うわうう、ぎゃお、わお、わお、おう。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "吼える、　吼える、　吼える、　吼える、　吼える、　　ぎゃお、わお、がお、うわァああ、わああ、おおおおお。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぎゃお、わお、がお、うわァああ、わああ、　おおおおお。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "排他、脅迫、防禦、突進、乱闘、流血、　ぎゃお、わお、がお、うわアああ、わお、お、お、　ハーレムとは一の成牡（ブル）を中心として成る成牝（カウ）の多くは百頭三百頭の集団である。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "咆哮、咆哮、咆哮、　ぎゃお、わお、がお、うわあああ、わお、おおお。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぎゃお、わお、がお、うわあああ、わお、おお、　飛び入る、飛び入る、飛び入る。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぎゃお、わお、がお、うわアああ、わお、おお、　ぎゃお、うわうう、ぎゃお、わお、おう。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぎゃお、わお、がお、うわアああ、わお、おお、　ぎゃお、うわうう、ぎゃお、わお、おう、　ぎゃお、わお、がお、うわアああ、わお、おお、　ぎゃお、うわうう、ぎゃお、わおおう。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "たった今まで、おぎゃおぎゃいっていたんだ――おい、目をさませ！",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "うさぎゃおこるし　かにゃはじょかくししかたなくなく　あなへとにげる　おしまいまで歌っているうちに、失敗した蟹のあわてぶりが、じぶんたちの仲間ができたようなおもしろさで思いだされ、いつかまた、心から笑っている先生だった。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、ひときわたかい左近将監の叫びと同時に、たしかに手ごたえあったらしく、「ギャオッ！",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
