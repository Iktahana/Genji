[
  {
    "uuid": "a980bf86-2ce5-5895-8619-6d45008b8f90",
    "entry": "銀製",
    "reading": {
      "primary": "ぎんせい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "made of silver",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "銀製のネックレスは、長年使っても色褪せない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この銀製の茶道具は、江戸時代の作品である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "銀製の仏具は、毎月磨いて手入れしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "』　それからさて父親は小さな銀製の箱を寝床の下から取り出しながら、イワンの方を向いてこう云いました。",
              "citation": {
                "source": "イワンとイワンの兄",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀製の光った匙は、床の上で跳ねあがり、鋭く澄んだ響を立てた。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時として君は黒い覆面をかけ、手中に見えざるピストルを閃めかし、盗心を神聖視し、憔悴しては銀製の乞食となつて彷徨ひ歩るき、消え失せんとしては純金の蜩の声を松の梢に聴いた。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集のはじめに",
                "note": "青空文庫"
              }
            },
            {
              "text": "神仙は銀製の長さ二寸ばかりあるトッコンと云う楽器、水晶で造らえた亀の甲の形をした一寸五分ばかりのもの、鉄扇、剣の四種の品をくれた。",
              "citation": {
                "source": "神仙河野久",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さあ」とついに彼は、見事な七宝細工を施したどっしりした銀製のテーブルの方へと振向きながら、言った。",
              "citation": {
                "source": "しめしあわせ",
                "author": "THE ASSIGNATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "云ふを止めよう、どうやら白銀製の鼻が盛りあがつて来た感が強いだけだ。",
              "citation": {
                "source": "ユリイカ・独言",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "五分刈頭のわたしは、夜になると、街の被服商で購つて来た海兵用の白の作業服を着て、一服喫すといふ場合には、徐ろに胸のポケツトから、先頃「しぐれ」進水式の折に拝領した銀製のシガレツト・ケースを取り出し、高射砲型のライターからパチンと火をつけた。",
              "citation": {
                "source": "緑の軍港",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは銀製の鴨を余興に進らせたと見ゆ。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "余り貰ひ過ぎるので夫人も嬢様も心配なすつたが、呉れるものを断るわけにも行かず、断はつたとて持つて呉れば無下に返すわけにも行かず、仕方がなしに美術会で名高い美術家の彫刻した銀製の紙莨入れを買つて御返礼に差上げた。",
              "citation": {
                "source": "犬物語",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の正午にまちがいない」と考えながら、私は、デスクの上においてある銀製の灰皿の上で、燐寸をすって、件の紙片の一端に点火した。",
              "citation": {
                "source": "秘密",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "探してみると、それは銀製のシガレット・ケースにすぎなかった。",
              "citation": {
                "source": "人造人間殺害事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "五分刈頭のわたしは、夜になると、街の被服商で購つて來た海兵用の白の作業服を着て、一服喫すといふ場合には、徐ろに胸のポケツトから、先頃「しぐれ」進水式の折に拜領した銀製のシガレツト・ケースを取り出し、高射砲型のライターからパチンと火をつけた。",
              "citation": {
                "source": "緑の軍港",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、銀製の牛を拵へて側に置き、閑さへあれば呪文を唱へて、その背を撫でてゐる事だ。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "かんざしも夏には銀製の薄のかんざしをさしたもので、見るからに涼しげな感じのものでした。",
              "citation": {
                "source": "絵筆に描き残す亡びゆく美しさ",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして今度は、琺瑯や、銀製の果実庖丁などの入っている函には手も触れずに、「こんなものは、おれの目的じゃないんだ」　自分の気怯れを弁護でもするように、ぶつぶついって、つま立ちをしてその棚を離れた。",
              "citation": {
                "source": "空家",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふ物のあひだには、銀製の台附洋杯だの、金を鏤ばめた酒杯などもあるが、それは、贈物として貰つたもの以外は、みな戦利品である。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀製の指輪が眞黒になつた。",
              "citation": {
                "source": "摩周湖紀行",
                "author": "――北海道の旅より――",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀製の葉巻皿と灰落し。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝋涙が彼の心の影を浮べて、この部屋のたった一つの装飾の、銀製の蝋燭立てを伝って、音もなく流れて行った。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、その洋橙が載っていた、果物皿と云うのがこれなんだがね」　そう云って熊城は、寝台の下から銀製の大皿を取り出した。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "陶磁器類、硝子器類、金銀製器具……」　一冊の本に失望したたね子はもう一冊の本を検べ出した。",
              "citation": {
                "source": "たね子の憂鬱",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "床の間には、銀製の、西洋人形の立っている置時計があったし、掛軸は、重豪公の横文字の茶掛けであった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "視線の向けられた膝の上に、銀製の小さな鍵がある。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その傍らの壁の高所に、銀製の漏斗型の管があって、そこから香水の霧｜水沫が、絶間なく部屋へ吹き出している。",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "文科と同じこっちゃ、銀時計でなくちゃ通用せん」　小野さんは橋の手擦に背を靠たせたまま、内隠袋から例の通り銀製の煙草入を出してぱちりと開けた。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "草花が食卓を明るく飾り、銀製の古風な食器が、彼等の家柄を思はせた。",
              "citation": {
                "source": "世界覗眼鏡",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "室の正面には、多彩な政治家だった故人波多野氏の肖像画が掲げてあり、それと向いあって、孫中山の書がかかっており、一方の卓上には、画集や写真帖が置いてあり、他方の棚のケースには、銀製の種々の記念品や骨董品が並べてあり、煖炉棚には、古い壺や皿が飾られていて、その片端に、坐形の大きな人形が一つあった。",
              "citation": {
                "source": "波多野邸",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
