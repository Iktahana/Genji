        "examples": {
          "standard": [
            {
              "text": "彼は技術士の資格を取得し、地方自治体の橋梁設計プロジェクトで主担当として活躍している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "技術士でなければ受注できない業務があるため、若手社員が資格取得に向けて猛勉強している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "技術士として独立した彼女は、中小企業の設備改善コンサルティングを手掛けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "十月一日には海軍の技術士官となり、その後敗戦まで、音波探知器に携わることになる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "万事につけてその筆法で、その意味の専門技術士であった。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
