        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "晩餐会のテーブルに並んだ銀盤には、シェフ自慢の料理が順々に運ばれてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "家宝の銀盤は代々磨き続けられ、宴のたびに食卓の中央に据えられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "美術館に展示された十八世紀の銀盤には、蔦の葉と花の精緻な彫刻が施されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
