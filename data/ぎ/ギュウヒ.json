        "examples": {
          "standard": [
            {
              "text": "手作りの求肥は柔らかくておいしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "求肥は大福の中身としてよく使われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この和菓子店の求肥は評判が良い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "」で、すぐにその晩、近所の寄席の色ものへ連出して、中入の茶を飲んで、切端の反古へ駄菓子を撮んで、これが目金だ、万世橋を覚えたまえ、求肥製だ、田舎の祭に飴屋が売ってるのとは撰が違う、江戸伝来の本場ものだ。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "当日は本所の五百羅漢へゆくつもりで、本郷通りを真すぐに切通し、寄席の求肥の、めがねへ出ました。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
