        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ああ、帰りたや帰りたや、オギヤ　と生れた俺の家！",
              "citation": {
                "source": "よもやまの話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギヤングだの、低脳記者だの、ろくなものありやしない。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "※と眞黄色な目を光らしたが、ギヤツと啼いて、ひたりと欄干を下へ刎返る、と橋を傳つて礫の走つた宿の中へ隱れたのである。",
              "citation": {
                "source": "二た面",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――アノ、ニギヤカナ、マチデサ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガア／＼息を喘ませながら、第二番目に續いた學生は、其の勢にギヤフンとなツて、眼をきよろつかせ、石段に片足を掛けたまゝ立往生となる。",
              "citation": {
                "source": "解剖室",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとピエロがギヤン／＼ほえたてる声がします。",
              "citation": {
                "source": "小犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これでは王さまに何かのことがおありのときには、きつとまた私をおよびつけになるにちがひない、あの指輪だけは、じぶんがひろつてゐたので、すぐにおわたししたやうなものゝ、このつぎ、何かをさがせの、見とほせのと言はれたら、ギヤフンとまゐるよりほかはない。",
              "citation": {
                "source": "ダマスカスの賢者",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「誰そあるか」　失望したような、ほっとなったような気持で対馬守は、短銃と一緒にオランダ公使が贈ったギヤマン玉の眼鏡をかけ直すと、静かに呼んで言った。",
              "citation": {
                "source": "老中の眼鏡",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "上に円い枠のついた三本脚の黒塗の台に、硝子鉢が篏めてありましたが、父はそれを『ギヤマンの金魚鉢』と呼んでいました。",
              "citation": {
                "source": "虫干し",
                "author": "鷹野つぎ",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこれほどの用事を帯びて来て、それを二人の娘の母親に話さずにも帰られぬと思って、直談判をして失敗した顛末を、川添のご新造にざっと言っておいて、ギヤマンのコップに注いで出された白酒を飲んで、暇乞いをした。",
              "citation": {
                "source": "安井夫人",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "――（×印へ）同宿のテキヤさん、トギヤさん、なか／＼の話上手だ、いろ／＼話してゐるうちに、猥談やら政治談やら、なか／＼面白かつた、殊にオツトセイのエロ話はおかしかつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の塩風呂に浸つてから例の酒店で一杯やる、この店は安い、一合でも二合でも喜んで燗をしてくれる、下物は刺身五銭、天ぷらもも五銭、ぬた弐銭、湯豆腐弐銭、私のやうなノンベイでも三グワン握つて行くと、即身成仏が出来る、ギヤアテイ、ギヤアテイ、ボーヂ、ソワカ、などゝ親しい友に書いてやつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹明君がめづらしく山ゆき姿で来た、ルンペンのやうでもあり、ギヤングのやうでもあるが、樹明はやつぱり樹明だ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "同宿同行の話がなか／＼興味深い、トギヤ老人、アメヤクヅレ、ルンペン、ヘンロ、ツジウラウリ。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナデ　イツシヨニ　ニギヤカニ　フキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、ウグヒスタチハ　ミンナデ　イツシヨニ、キカラ　キヘ　ツタハリナガラ、ニギヤカニ　コドモタチノ　ハウヘ　アソビニ　ユキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガチヨウノ　タンジヨウビ新美南吉　アル　オヒヤクシヨウヤノ　ウラニハニ　アヒルヤ、ガチヨウヤ、モルモツトヤ、ウサギヤ、イタチナドガ　スンデ　ヲリマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "選手は幸いにして、数分後には、気を取り直しボオトを引き上げ、更衣所に帰るや、一同その場に打ち倒れ、語るに言葉なく、此所にも綴るレギヤツタ血涙史の一ペエジを閉じた※　ボオトを漕ぐ苦しさについて、ぼくは、敢て書こうとは思いません。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "選手は幸いにして、数分後には、気を取り直しボオトを引き上げ、更衣所に帰るや、一同その場に打ち倒れ、語るに言葉なく、此所にも綴るレギヤツタ血涙史の一ペエジを閉じた≫　ボオトを漕ぐ苦しさについて、ぼくは、敢て書こうとは思いません。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は、ギヤマンの壺から、梅ぼしを小皿にわけて、茶を入れてくれたが、「どうしたの。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十二　自分は経験のある或る年長者から女の涙に金剛石はほとんどない、たいていは皆ギヤマン細工だとかつて教わった事がある。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしていつもの剣菱をギヤマンの徳利に入れて、自分で燗をしだした。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラムネの瓶にはギヤマンの「魂」が、露西亜人にはだらけた「心」が要るやうに、清元に無くて叶はぬものは、この遊蕩的分子である。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "疾風の如く棺に取縋つたお夏が、蹴られて※と倒れた時、懐の赤児が『ギヤツ』と許り烈しい悲鳴を上げた。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "船上に怪しい叫び声が起り、人の気勢がしたかと思うと、ギヤマンの灯籠が、舷側から吊し下ろされた。",
              "citation": {
                "source": "船医の立場",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギヤマンのランプが室内を真昼のように、煌々と照らしていた。",
              "citation": {
                "source": "船医の立場",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "英領ギヤナのアラワク人の談に、往時上帝地に降って人を視察した、しかるに人ことごとく悪くて上帝を殺そうとし、上帝怒って不死性質を人より奪い蛇蜥蜴甲虫などに与えてよりこれらいずれも皮脱で若返ると。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギアー（舵器）を廻してから三十分もして方向が利いて来ると云うのだから、瀬戸中で打つからなかったのは、奇蹟だと云ってもよかった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "四五人で食事をしたあと、客室でのんきにおもしろく話をしていると、突然頭の上でギアーギアーギアーギアーと四つ続けて妙な声がした。",
              "citation": {
                "source": "路傍の草",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "てにはは器械のギアーでありベアリングである。",
              "citation": {
                "source": "俳諧の本質的概論",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
