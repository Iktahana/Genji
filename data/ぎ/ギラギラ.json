        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夏の正午、砂浜に降り注ぐ太陽がギラギラと照りつけ、子供たちは日陰へ逃げ込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼の目がギラギラと輝き、「必ず成功してみせる」と低い声で言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ネオンサインがギラギラと点滅する繁華街を、彼女は足早に通り抜けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "濃い青空に、濃い白雲がギラギラ光つて、おもひばかりが一杯で、私には、なにが何やら分らない。",
              "citation": {
                "source": "夏",
                "author": "〔私が貧乏で〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギラギラする光の中から、地下室の監房のような船室へ、いきなり飛び込んだ彼は、習慣に信頼して、ズカズカと皿箱をとりに奥へ踏み込んだ。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜べはまだ風がなく蒸し暑くて海面が油を流したようにギラギラして、空を映している時、沖のほうの海面がきわ立って黒くなって来るのがよく見える事があります。",
              "citation": {
                "source": "夏の小半日",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしニーチェはあんまりギラギラしている（glitzernd）と云っている。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしニーチェを評してギラギラしていると云った彼はこれらの弱点に対してかなり気の永い寛容を示している。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "陰氣だつた梅雨の日も忘れたやうに過ぎて、緑の深くなつた桐の葉に照る日光が急にギラギラと夏めいて來た、病室の中は暑苦しくなつた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その歯がギラギラ光ったのです。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギラギラのお日さまがお登りになりました。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜘蛛はまた枝のかげに戻って、六つの眼をギラギラ光らせながらじっと網をみつめて居た。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして黄色なダァリヤの涙の中でギラギラの太陽はのぼりました。",
              "citation": {
                "source": "まなづるとダァリヤ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜘蛛はそして葉のかげに戻って、六つの眼をギラギラ光らせてじっと網をみつめて居りました。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラスのマントがギラギラ光りました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "眩しい刺繍の丸帯の前に束ねた、肉づきのいい両手の間から、巨大なダイヤの指環がギラギラと虹を吐いた。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっと崖を登りきったらそこはまばらに栗の木の生えたごくゆるい斜面の平らで雪はまるで寒水石という風にギラギラ光っていたしまわりをずうっと高い雪のみねがにょきにょきつったっていた。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼠色のマントがまるでギラギラする白光りに見えました。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでマントがギラギラ光り、ガラスの沓がカチッ、カチッとぶっつかって鳴ったようでした。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギラギラする鋼の小手だけつけた青と白との二人のばけものが、電気｜決闘というものをやっているのでした。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日午前七時、昨日までの雨に引替えてギラギラ光る太陽に射られながら水戸出発、右に久慈川の濁流を眺めつつ進む。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "その供養のために、毎年六月の一日は、氷室の朔日と云って、少い娘が娘同士、自分で小鍋立ての飯ごとをして、客にも呼ばれ、呼びもしたものだに、あのギラギラした小刀が、縁の下か、天井か、承塵の途中か、在所が知れぬ、とあっては済まぬ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "途端に、弓子の眼はギラギラと燃えた。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "針助はギラギラ燃える眼で、なめるように二人を見つめていた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "針助はギラギラと燃えていた眼を、急にうっとりと細めて、針の先を見つめていたが、やがて、「ほな、どない言うても、いやか」　次郎はうなずきながら、思わず三郎に寄り添うた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "すかされた思いだったが、やがて衣裳をつけた冴子が舞台へ出てくると、信吉の眼はギラギラと輝いた。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は必死になって※いて漸くその恐しい指を払い除けることが出来たが、今度はピストルの金具の鳴る音を聞き、そして彼の頭を真直ぐに狙っているギラギラ磨かれた銃口とずんぐりとした汚れた男の顔と向き合った。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食が済んだ後で、霧がはれて、海がギラギラ青い鋼鉄色に煌きはじめると、二組の夫婦はそろって海水浴に出かけた。",
              "citation": {
                "source": "花嫁の訂正",
                "author": "――夫婦哲学――",
                "note": "青空文庫"
              }
            },
            {
              "text": "舌はだらりと長くたらして、目はぞっとするほど、ギラギラ光っていました。",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなにギラギラにらんでいるぞ！",
              "citation": {
                "source": "雪だるま",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつが、ぼくをギラギラにらむのだけは、やめさしてやったぞ。",
              "citation": {
                "source": "雪だるま",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっき、ぼくをギラギラにらみつけて、しずんでいったのは、たしかお日さまと言ってたが、あれも、ぼくの友だちなんかじゃないようだ。",
              "citation": {
                "source": "雪だるま",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
