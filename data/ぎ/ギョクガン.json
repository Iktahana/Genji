    },
    "definitions": [
      {
        "index": 1,
        "gloss": "imperial face",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "皇后の玉顔は厳粛な表情をしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "玉顔を目にするために、多くの国民が沿道に並んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その玉顔には深い思慮の跡が刻まれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "主上則ち南殿の御簾を高く捲せて玉顔殊に麗しく、諸卒を照臨ありて正行を近く召して、以前両度の戦に勝つことを得て、敵軍に気を屈せしむ。",
              "citation": {
                "source": "四条畷の戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああおそれ多いことじゃ」　おじいさんは頭を大地につけてないている、千三は涙が目にたまって玉顔を拝むことができなかった。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ラザレバ徒ニ纏頭ヲ他隊ノ婢ニ投ジテ而モ終宵阿嬌ノ玉顔ヲ拝スルノ機ヲ失スト云。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "暮山の雲をながむれば、君が花釵かと心も憂く、閑窓の月にうそぶけば、玉顔われに笑み給うかと迷うも浅まし。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
