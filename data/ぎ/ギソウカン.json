        "examples": {
          "standard": [
            {
              "text": "患者が訴えた蟻走感は末梢神経障害の典型的な症状だと医者は診断した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "更年期症状として蟻走感を感じる女性は珍しくない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "医学生は蟻走感がフォルミカチオンというラテン語で呼ばれていることを学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "なるほど、蟻走感、そういえばちょっと痒くなったぞ」　快川長老が哄笑した。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟻走感ト云ウノニ似テイルガ、アンナ生ヤサシイモノデハナク、モット強ク激シイ痛ミデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
