        "examples": {
          "standard": [
            {
              "text": "親は子どもに学習の義務を課すだけでなく、成長を見守るべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "市民に過度な義務を課すのは、民主主義の原則に反する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "法律は企業に従業員の安全を確保する義務を課している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "八、すべての人に對して平等の勞働義務を課すること。",
              "citation": {
                "source": "共産黨宣言",
                "author": "カール・マルクス",
                "note": "青空文庫"
              }
            },
            {
              "text": "人民に義務を課する場合には、天地宋廟の神々を祭る時のように、恐懼するがいい。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
