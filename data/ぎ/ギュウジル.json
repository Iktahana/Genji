        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その政商は長年にわたり地域の建設業界を牛耳ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女は入社三年で部署全体を牛耳るほどの影響力を持つようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "一人の実力者が委員会を牛耳っているせいで、他のメンバーの意見がまったく通らない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "あなた方を牛耳るつもりで来たのが、スッカリあべこべになりそうですね。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "かりにも青年団が牛耳る文化祭でしょう。",
              "citation": {
                "source": "文化祭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "学内の言論を牛耳るばかりでなく、町内婦人会や街頭に於ても発言することを好み、彼女の向うところ常に敵方に難色が見られた。",
              "citation": {
                "source": "お奈良さま",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって、千人の普通の女をかちえる男はどうやら名声を博するに価するだけだが、浮気女を一人でも手に入れて、完全にこれを牛耳ることができる男こそは、まさに英傑である。",
              "citation": {
                "source": "スリーピー・ホローの伝説",
                "author": "故ディードリッヒ・ニッカボッカーの遺稿より",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がやつらを追い出したということは、事情によってはあいつらを牛耳ることができるということを証明するものだし、さらにまた、やつらが何一つ本質的なことでクラムとは関係がないということを証明しているものだ。",
              "citation": {
                "source": "城",
                "author": "DAS SCHLOSS",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、好きなのはこの世で一番洗練された新聞を牛耳ることだ。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "当分、どっちの派閥が会議を牛耳るか、意見は真っ二つに割れている。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェームズ・バーナムが「経営者革命論」を書いた時、多くのアメリカ人は、戦争が終わる時にはドイツ人が欧州の覇者になるだろうと考えていたため、ユーラシア大陸に君臨するのはソ連ではなくドイツであり、日本は東アジアを牛耳るとするのは自然な仮定だった。",
              "citation": {
                "source": "あなたと原子爆弾",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
