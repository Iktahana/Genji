        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "島内を一巡して見たが、島中、椰子と蛸樹と麺麭樹とがギツシリ密生してゐる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寸何分と長の定ツた奴許りが、ギツシリとつめ込んである。",
              "citation": {
                "source": "漂泊",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたずらに肩を押し合い、揉み合い、めいめい先へ出ようと邪魔しあって、お神輿をかつぐようにギツシリ廊下に詰まって、ワッショイワッショイ！",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぞと誠におとなしい夫故押される憂ひはございません、けれども軒の下にはギツシリ爪も立たんほど立つて居ります。",
              "citation": {
                "source": "牛車",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁際には三つの本箱が据ゑられ、それにみんなに寄付してもらつた、色々の本や雑誌がギツシリつまり、「資料箱」の上には、木琴や積木や智慧の環や、それから地球儀や、環投げ遊びの道具などもありました。",
              "citation": {
                "source": "仔猫の裁判",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミが柵に近づくと、急にギーギーブウブウといふ鳴声がするのでヒヨイと見ると、二つの荷物車にはギツシリ豚が積込まれてゐるのが横板の間からのぞける。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "７．ずつと圓天井にまでかけて、繪やトロフィーといつたやうなものがギツシリ懸かつてゐた。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
