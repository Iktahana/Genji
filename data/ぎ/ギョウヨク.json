        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "俺の官能は強烈の刺戟に生き、俺の肉体は楽欲にとろかされた。",
              "citation": {
                "source": "畜生道",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽欲の極みか、甘き寂寞の大光明、に喘ぐ時。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽欲の渇たちまちかのわかき接吻思ひ、目ぞ暈む。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "時経ぬ唇は『楽欲』の渇に焦れ、心の臓喘げば、紅火『煩悩』の血彩薫ずる眩暈よ。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔火のごとく花いづるわかうど一人、黒漆のわかき瞳に楽欲の苦痛を湛へ、大跨に一歩ふりむく。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "（楽欲は君がまにまに）ああ君よ、賤の児なれば我はもや自然の巣へと花ちる日、市をはなれて、鄙ごころ、またと帰らじ。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の後継者たる代々の皇帝はひたすらに狂気じみた享楽欲に耽溺の度を深めていった。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "法利賽の徒と共に虚偽の生を営みて、醜辱｜汚穢の沼に網うつ、名や財や、はた楽欲を漁らむとすなり。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "一二五頁「花冠」は詩人が黄昏の途上に佇みて、「活動」、「楽欲」、「驕慢」の邦に漂遊して、今や帰り来れる幾多の「想」と相語るに擬したり。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、なにものぞ、ほてりたるもろ手ひろげて「楽欲」にらうがはしくも走りしは。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "法利賽の徒と共に虚偽の生を営みて、醜辱汚穢の沼に網うつ、名や財や、はた楽欲を漁らむとすなり。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏訳詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三、肉交のエクスタシイは愛のエクスタシイではない、肉交はけっして霊肉の法悦ではなく、キリスト教的にいわば肉のみの楽欲である。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "寡人は楽欲に克つた其の為に、星が寡人に言をかけてくれたのだ』とバルタザアルが云つた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピエル・ルイの Aphrodite なども、金瓶梅に比ぶれば、子供の玩具も同じ事なり、尤も後者は序文にある通り、楽欲主義と云ふ看板もあれば、一概に比ぶるは不都合なるべし。",
              "citation": {
                "source": "雑筆",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、もう、わたしの目にはダリヤもない、指もない、唯だ光と、※と、匂ひと、楽欲とに眩暈して慄へたわたしの心の花の象があるばかり。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし恋の楽欲を先づ了解したのは寧ろ花子であつた。",
              "citation": {
                "source": "水に沈むロメオとユリヤ",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリストフはそういう音楽欲に感心した。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "また彼らは地上生活の愉悦を知ってもいる、しかし飽くことなき楽欲に追われて、飽くまでも愉悦の杯をのみ干そうとする大胆さはない。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生活を高めようとする心と、ほしいままに身を投げ出して楽欲を求むる心と。",
              "citation": {
                "source": "「ゼエレン・キェルケゴオル」序",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
