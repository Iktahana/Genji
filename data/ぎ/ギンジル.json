        "examples": {
          "standard": [
            {
              "text": "住職が経文を吟じる声が、お寺全体に響き渡っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "古い詩を吟じる老詩人の姿は、多くの人に感動を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "能楽師が楽器に合わせて詞を吟じている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そして詩でも吟じるがごとく、自嘲の感を、ひとり壁に向って云っていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "背に腹はかえられん」「でも、罪なき者を殺すのは、人道に反くではありませんか」「否」　曹操は、詩でも吟じるように、大声でいった。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
