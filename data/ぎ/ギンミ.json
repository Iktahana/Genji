  {
    "uuid": "f6b5830d-1039-57aa-a306-b4f650d48f9b",
    "entry": "ギンミ",
    "reading": {
      "primary": "ぎんみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "朝々のお茶の類は、うんとギンミして、よきものを愉しむ舌を持ちたいものだ。",
              "citation": {
                "source": "朝御飯",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃、自分の内的生活を、次に次にと新たなものを受け入れる為、一つ一つをたんねんにギンミし、それに一つ一つの decision を与えて居ない傾向がある。",
              "citation": {
                "source": "一九二三年冬",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は文学者だから、綴方と小説の相違、天分とか才能の限界に就て常々ギンミになやむ思ひが去らず、それが先生自らのボンクラ性に対しての悲劇的な悩みの種でもあるのだから、この心眼の観察力は悲痛なほど深刻、シンラツであつた。",
              "citation": {
                "source": "破門",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで女優、ダンサー、歌手、ストリッパー、いろいろギンミしたあげく、自分の好みにも合い、また見込みのありそうなのもアルバイトの女学生芸能家だと見当をつけた。",
              "citation": {
                "source": "文化祭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで契約に上京した時もバンドよりも女学生歌手のフェースの方に主眼をおいて念入りにギンミしたのである。",
              "citation": {
                "source": "文化祭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって彼の「鉢の木」は世間の謡曲と似た部分が少なかったが、シサイにギンミしてきくと義太夫よりはやや謡曲に似ており、また浪花節よりもやや謡曲に似ているように思われる部分があった。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンの中を掘ってみて、その内容の底までギンミして、「ヤヤ。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドッコイショ」　彼はイスに腰を下して、たちまち彼をとりまいた女たちを一人一人ギンミした。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "加納五兵衛殿の死の瞬間、すなわち、不肖が叫び声をあげた時に於ける皆様方の位置へ各々お立ちを願います」　国威を失墜しないように熱心に言葉をギンミしている。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その一　舞踏会殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅干がお好きで、御前様の梅干は小田原の農家の古漬を特にギンミして取寄せております」　五兵衛の食膳へのせる梅干の壺は明の高価な焼物だということであった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その一　舞踏会殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚八の言葉をよくギンミしながら、「そうだねえ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "これにこりたから、今度の彼氏はギンミするわよ」　お竹もすっかり人間が変った。",
              "citation": {
                "source": "人生案内",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "着かざってみがいてみると、お竹はどことなくチャーミングで男の心をそそる情感が豊富であるから、言い寄る男も少くなかったが、今度はギンミしなければならぬと考えているから浮気男の口車にはなかなかのらない。",
              "citation": {
                "source": "人生案内",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "猥画を書けというのだが、絵の道具がないからと断ると、それは困ったな、弘法は筆を選ぶと言って、商売人は絵筆のギンミ又厳重だと言うから、コチトラの筆じゃア埓があくめいな、と至極物分りのよい独り言をもらして、どうだい、之は、え、筆は立つかね、なにさ、文章は書けるかってことさ。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "猥画を書けといふのだが、絵の道具がないからと断ると、それは困つたな、弘法は筆を選ぶと言つて、商売人は絵筆のギンミ又厳重だと言ふから、コチトラの筆ぢやア埒があくめいな、と至極物分りのよい独り言をもらして、どうだい、之は、え、筆は立つかね、なにさ、文筆は書けるかつてことさ。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの料理も手数を省かずによくギンミした風情で、味もよろしいばかりでなく、一皿の量が少量なので酒飲みには大そうよかった。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この山刀を買う時には、値段をいとわず斬れ味をギンミすべきで、二級品を買わないような根性を身につけておかなければならないものだ。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、その商売の性格や商品の質をギンミして見ることは、別にさしつかえないだろうと思います。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
