          "literary": [
            {
              "text": "僕等は、長年の経験で初めて仕事の出来る技術工だから。",
              "citation": {
                "source": "機関車",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雜戸は農耕以外の技術工藝雜役に從ふもので、例へば玉造部・弓削部・鎧作・樂戸・船戸・酒戸・藥戸・雜工戸・鷹戸・その他馬飼や犬飼・機織部・土師部等あらゆる業態を網羅して居る。",
              "citation": {
                "source": "淡路人形座訪問",
                "author": "竹内勝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "技巧が主になると、技術上に関する事柄に興味が偏して、例えば、どういう風の横線がよいとか、どういう撥ね方がおもしろいとか、そのほか筆に力を入れるとか入れないとか、太いとか細いとか、そういった外観を飾る技術工作が一番重大事件のように考えられて来る。",
              "citation": {
                "source": "現代能書批評",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
