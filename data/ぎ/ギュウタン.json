        "examples": {
          "standard": [
            {
              "text": "仙台に来たら牛タン定食を食べないわけにはいかないと、友人に連れられて専門店へ入った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "炭火で焼いた牛タンは外がカリッと、中はジューシーで、塩とレモンがよく合う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "薄切りの牛タンをフライパンで一気に強火で焼くのが、やわらかく仕上げるコツだと料理人は言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
