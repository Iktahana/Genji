          "standard": [
            {
              "text": "宜陽殿には歴代天皇から受け継がれた宝物が納められ、厳重に管理されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "平安宮の宜陽殿については、藤原道長の日記にもその様子が記されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "古典の講義で宜陽殿について触れられた際、学生たちはその壮麗さに目を輝かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "この琴は宮中の宜陽殿に納めておかれた御物であって、どの時代にも第一の名のあった楽器であったが、故院の御代の末ごろに御長皇女の一品の宮が琴を好んでお弾きになったので御下賜あそばされたのを、今日の賀宴のために太政大臣が拝借してきたのである。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（上）",
                "note": "青空文庫"
              }
            }
          ]
        }
