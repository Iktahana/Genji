          "standard": [
            {
              "text": "船長は魚探の画面を眺めながら、大きな魚群がすぐ下にいると判断した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "最新の魚探を導入したおかげで、以前より効率よく漁ができるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "魚探の反応が急に消えて、ベテランの漁師も首をかしげた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "毎日の川魚探しに直助の母の手造りの紺無地の薄綿の肩の藍が陽やけしたのか少し剥げてゐた。",
              "citation": {
                "source": "川",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
