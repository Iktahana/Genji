[
  {
    "uuid": "71772f86-be11-53f2-853b-746354fc093d",
    "entry": "魚腹",
    "reading": {
      "primary": "ぎょふく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
