[
  {
    "uuid": "fd70d907-211e-5f6e-816f-799ca69da401",
    "entry": "吟唱",
    "reading": {
      "primary": "ぎんしょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "recital",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の吟唱は深い感情が込められていて、聞く者の心を揺さぶる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "能の吟唱は独特の音階で、世代から世代へ受け継がれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "詩人は自作の詩を吟唱して、観客から拍手を浴びた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "艶麗な市民、いつも俺に泣顔ばかり見せてゐる市民達の悦びの吟唱が聞き度いのだ。",
              "citation": {
                "source": "闘戦勝仏",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らのお家の芸たる神楽歌というものや遊芸吟唱のたぐいが朝廷に召され、そのダシモノが自然神話に結びつくことになって、神話の大物をオラがふるさとの物語に仕立てて唄ったり踊ったりするようになった。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第一回　高千穂に冬雨ふれり≪宮崎県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラビアの吟唱詩人の影響の下にまず南フランスから『トゥルーバドゥル』が起ってくる。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばしば部族の吟唱詩人でありときには首領でもあった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
