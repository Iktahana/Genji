        "examples": {
          "standard": [
            {
              "text": "行の長さを45〜60字程度に抑えると、本文が読み手の目に優しくなると教わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ウェブデザインではmax-widthを使って行の長さを制限するのがセオリーだとメンターから言われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "行の長さが長すぎると視線の移動距離が大きくなり、読み続けるうちに目が疲れてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "イラストの凹凸に沿って一行の長さが伸びたり縮んだりするレイアウトを見ると、オレの頭は今でも自然と垂れる。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "催馬楽・朗詠・今様でこなされて、漢詞章と日本歌謡との音脚・休止から、行の長さまで調節せられる様になつた。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
