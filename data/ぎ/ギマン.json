[
  {
    "uuid": "769eb9d6-63c9-56c2-be07-f26e01d93ae2",
    "entry": "欺瞞",
    "reading": {
      "primary": "ぎまん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
