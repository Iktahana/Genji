        "examples": {
          "standard": [
            {
              "text": "「ざあざあ」や「ぴかぴか」は日本語を代表する擬音語で、外国人学習者には難しいと言われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "子ども向けの絵本には擬音語がふんだんに使われており、読み聞かせを盛り上げる効果がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "日本語の擬音語は英語に訳しにくく、翻訳者を長年悩ませてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ダッポンといふ擬音語は、新潟市民の忘れられない、親しみのこもつた方言だつた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつたいに、擬音語の豊富な土地だつた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
