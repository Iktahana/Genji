          "literary": [
            {
              "text": "ある夜ギイーとその戸が開いた。",
              "citation": {
                "source": "柳営秘録かつえ蔵",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると三尺の開口がギイーと開き、内から出て来ました女はお小姓姿、文金の高髷、模様は確と分りませんが、華美な振袖で、大和錦の帯を締め、はこせこと云うものを帯へ挟んで居ります。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "中へギイーッと扉を押しあけてしまえばよろしいのです。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "その讃辞を述べ終りますとギイーとその門が開かれるのです。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階の御納戸に、あけしめするのにギイーッとなるたんすがあり、その中に紺地にうさぎの絵のついた御召があった。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そっと、ギイーツとたんすをあけてみたけれど、中にはいっていない。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　陰気な、力なげな機の音がギイーシャン、コトン！",
              "citation": {
                "source": "櫛",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギイーッと、ドアの開く音がして、ピカッと、大きな目だまのような光が、あらわれました。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギイーと裏門が二尺ばかり開いた。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お願いでござる……」「うるさい奴じゃ、何者か名を申さぬうちは開門ならん」「足軽、秋山大助でござる……」「秋山大助、また飲んだくれて帰りおったか」　口叱言を呟きながら、潜り門をギイーと開けた。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅梅河岸までお客を迎えに参りますところで」「船の焼印は」「丸に金の字」「よし、行け」「御苦労様でございます」　ギイーとわかれて、一方は両国橋の脚の蔭へ、率八という男の櫓は、そこから舳を曲げて幅の狭い神田川の中へすべり込んで行く。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　運転手が答えますと、はじめて門のとびらがギイーとひらきました。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ギイーと開き戸の軋む音。",
              "citation": {
                "source": "悪魔の紋章",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
