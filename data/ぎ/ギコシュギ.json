        "examples": {
          "standard": [
            {
              "text": "擬古主義の作家たちは古典的な文体を現代文学に蘇らせようと試みた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "その建築には擬古主義の影響が色濃く表れており、古代神殿を模した柱が並んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "擬古主義は復古への憧れから生まれた思想だが、時代錯誤と批判されることも少なくない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "広義の擬古主義が蒼古的様式の古拙性を尊ぶ理由もそこにある。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
