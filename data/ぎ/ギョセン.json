[
  {
    "uuid": "2a1d44a6-3eb8-57cc-85b2-5510ca880453",
    "entry": "漁船",
    "reading": {
      "primary": "ぎょせん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
