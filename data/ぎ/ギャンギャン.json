        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あれほど、ぎゃんぎゃんやかましいことをいった蟻田博士が、その後うんともすんともいってこないことだった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、毎晩寝つきのわるい赤ん坊が、いつものとおりぎゃんぎゃん泣き出しました。",
              "citation": {
                "source": "曲馬団の「トッテンカン」",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "新吉は、かさぶた頭の赤ん坊をおぶって、耳もとでぎゃんぎゃん泣かれながら、その声のしずまるまで、店の前を何十ぺんでも行ったり来たりしていなければなりませんでした。",
              "citation": {
                "source": "曲馬団の「トッテンカン」",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "いい加減というよりも寧ろミジメな位の混合種ばかりが、尻尾振り合うも他生の縁という訳でギャンギャンキャンキャン吠え合っていたものだが、そいつが吾輩の顔を見ると一斉に吠えるのを止めて、尻尾を振り振り金網に立ちかかって来た。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、すぐ前をギャンギャンと、途方もない大きな声で、獣かなにかのように泣き叫んでいる女の子が通りかかったからだ。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "川村は犬殺しの檻の中へ投げ込まれた野犬の様に、ギャンギャンと狂わしく泣き叫んだ。",
              "citation": {
                "source": "白髪鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギャンギャン悲鳴を上げ、もがき苦しむ動物を、鋭いメスで切りさいなんだ。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
