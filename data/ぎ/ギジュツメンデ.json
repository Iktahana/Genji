        "examples": {
          "standard": [
            {
              "text": "技術面で見ると、このシステムは高度なセキュリティを備えています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "技術面で申し上げますと、この実装方法が最も効率的です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "技術面で優れているだけでなく、ユーザー体験も大幅に改善しました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ただ、写真と印刷とが同一の技術面で合致すべきだという久保の説を、ちょっと面白く思っただけでした。",
              "citation": {
                "source": "落雷のあと",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はここまでラジオがそれ以上に期待できる媒体であると示唆し、特に詩人側から見たラジオの技術面での利点について指摘してきた。",
              "citation": {
                "source": "詩とマイクロホン",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
