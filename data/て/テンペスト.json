        "examples": {
          "standard": [
            {
              "text": "シェイクスピアの『テンペスト』は、魔術と許しをテーマにした傑作だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ベートーヴェンのピアノソナタ第17番は、『テンペスト』という愛称で親しまれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "激しい嵐の中、海に浮かぶ孤島での出来事を描いたのが『テンペスト』だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "上野の山の中であれに会ってはテムペスト的風景すぎて、きっとこわかったでしょう、どんなにか。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへばストラットフォオドの子供たちの為にお伽噺を書けと云はれたとすれば、シエクスピイアは多少の効果を欠いても、「テムペスト」をお伽噺に書直しさうである。",
              "citation": {
                "source": "小説の戯曲化",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に、トーキーの、治安風俗カットを色々見る、ジョン・バリの「テムペスト」やディトリヒの裸、それからワイ映画を見た、ひどいものであった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
