[
  {
    "uuid": "e980dfc7-e094-5f0d-8aba-d5b35ed1033b",
    "entry": "天ぷら",
    "reading": {
      "primary": "てんぷら",
      "alternatives": [
        "テンプラ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
