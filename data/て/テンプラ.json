      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "tempura",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日の夕食は、揚げたて熱々の海老天ぷらを堪能しよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "海外からの観光客にも、日本の天ぷらは非常に人気が高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は自宅で本格的な天ぷらを揚げるのが趣味だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "空気はムンムンして、人々は天ぷらの油煙を吸い込んでいた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その下にどこかの天ぷら屋の宣伝札らしいものがある。",
              "citation": {
                "source": "浅間山麓より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "火山に天ぷらは縁があると思えば可笑しい。",
              "citation": {
                "source": "浅間山麓より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前なんか気の毒な鼠の天ぷらだ。",
              "citation": {
                "source": "電車",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂屋の隣りの天ぷら屋はまだ起きていた。",
              "citation": {
                "source": "泥濘",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう言われて私もまんざらでなく、うふふと笑ってやにさがり、いもの天ぷらを頬張ったら、私の女が、お前、百姓の子だね、と冷く言います。",
              "citation": {
                "source": "男女同権",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは天国の天ぷらというもんですぜ。",
              "citation": {
                "source": "貝の火",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "体のことが無かったのは単に機会の問題だったのだと腹の中で残念がっているそんな田中の問責にお君はふに落ちぬ顔であったが、さすがに、日焼けした顔にあり／＼と浮んでいる彼の悲しい表情に憐れを催し、彼のために天ぷら丼を注文した。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そばやへはいって、ぬるい天ぷらそばを食べながら、「どうしたんだろう、今夜は。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京庵の天ぷら蕎麦も油くさくて食えないし、ブラザー軒のカツレツは固くて靴の裏と来ているし、どうも仙台には、うまいものがなくて困るね。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "津田さんの説に拠ると、この東京庵の天ぷら蕎麦は、油くさくて食えないそうです。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、宮城野の天ぷらだって油くさいでしょう。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "油くさくない天ぷらは、にせものです。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その油くさい天ぷら蕎麦をたべてみましょう。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と周さんは、少からずその油くさい天ぷらに興味を感じている様子であった。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　天ぷら蕎麦とお酒を注文した。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そんな事を語りながら、「油くさい」天ぷら蕎麦を、おいしく食べて、私たちは東京庵を出た。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "次にはタチツボスミレの天ぷらである。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたたかい飯から立騰る水蒸氣と天ぷらの香ばしいにほひとが柔かに予の顏を撫でた。",
              "citation": {
                "source": "A LETTER FROM PRISON",
                "author": "‘V NAROD’ SERIES’",
                "note": "青空文庫"
              }
            },
            {
              "text": "「胡麻油を買って天ぷらの用意をしときなさい。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は「世相」という小説はありゃみな嘘の話だ、公判記録なんか読んだこともない、阿部定を妾にしていた天ぷら屋の主人も、「十銭芸者」の原稿も、復員軍人の話も、酒場のマダムも、あの中に出て来る「私」もみんな虚構だと、くどくど説明したが、その大学教授は納得しないのである。",
              "citation": {
                "source": "可能性の文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「天ぷらが喰べたい」と伯父が言出した。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和七年五月、渋柿）曙町より（九）　白木屋七階食堂で、天ぷらの昼飯を食っていた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、箸で僕の膳の上の天ぷらを指ざし、また自分の皿の上の肉を指ざし、そうして皿をたたきながら何かしら不平を言っているようである。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は天ぷら蕎麦をあつらえて、同じく腰をかけた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大阪屋花鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はやがて運んで来た天ぷら蕎麦を食ってしまって、更にあられ蕎麦を註文した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大阪屋花鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "お店者の小僧のくせに、蕎麦屋へ来て天ぷらに霰とは、ばかに贅沢をきめるじゃあねえか。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大阪屋花鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは天ぷらにしても、煮つけても美味かつた。",
              "citation": {
                "source": "万福追想",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ああ天ぷらが食いたい。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時に寒くなって――たださえ沸上り湧立ってる大阪が、あのまた境内に、おでん屋、てんぷら屋、煎豆屋、とかっかっぐらぐらと、煮立て、蒸立て、焼立てて、それが天火に曝されているんだからね――びっしょり汗になったのが、お庇ですっかり冷くなった。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
