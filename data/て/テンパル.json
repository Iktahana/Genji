        "examples": {
          "standard": [
            {
              "text": "東一局、親の彼はあっという間にテンパった。和了れば満貫だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あと一枚でテンパるというところで、対面からリーチがかかった。これは勝負だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今日はツキがない。なかなかテンパらないし、上がれる気がしない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
