[
  {
    "uuid": "ae4a6c1f-211c-56b5-88ea-ddca5000ec96",
    "entry": "低回",
    "reading": {
      "primary": "ていかい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
