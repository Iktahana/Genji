    "definitions": [
      {
        "index": 1,
        "gloss": "pacing back and forth meditatively",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は名案が浮かぶのを待つように、静かな書斎の中を何度も低回していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夏目漱樹の小説を読みながら、主人公の心象風景を追体験するように低回する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "哲学的な問いに対する答えを探し求め、公園の並木道を一人で低回した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "終日わが友は部屋のうちを低回しつつ項垂れては眉根を寄せて、一等きつい黒煙草をパイプに詰め替え詰め替えするばかりで、こちらから何か問いや話をかけても耳を貸さなかった。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　探偵小説に限らず、一般の通俗小説においても、アメリカの小説は、イギリスやヨーロッパ大陸の小説に比べて、馬鹿げた筋や、剣撃的なテンポや、千編一律なハッピー・エンドにいつまでも低回していて、芸術的価値の乏しいものが多い。",
              "citation": {
                "source": "ヴアン・ダインの作風",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "才女と言はれた宮内卿の如きは、新古今の発足点に低回してゐた。",
              "citation": {
                "source": "短歌本質成立の時代",
                "author": "万葉集以後の歌風の見わたし",
                "note": "青空文庫"
              }
            },
            {
              "text": "併、考へれば、私までが、簡単な論理に低回してゐたのであつた。",
              "citation": {
                "source": "短歌様式の発生に絡んだある疑念",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "本居一流の和魂の作用の二方面を幸魂・奇魂と説く見方は、従つて第二義に低回して、愈究めれば、益循環することを悟るであらう。",
              "citation": {
                "source": "小栗外伝（餓鬼阿弥蘇生譚の二）",
                "author": "魂と姿との関係",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがどういう作家であったか、所謂低回趣味や何かの作家であったかどうか、又ヨーロッパ大戦後まで生きていたならば日本の思想的変動からどういう風な影響を受け取ったろうか、というようなことは今の処論外としておこう。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "とかく名に興ずる私としては、かういふ低回趣味に堕して困る。",
              "citation": {
                "source": "連翹の花",
                "author": "新村出",
                "note": "青空文庫"
              }
            },
            {
              "text": "神の御社を下に見ながら大きな御館の上を越して飛んでまいるうちに天気が急にかわっていかい大風になって参ったので小鳥はそのかくれ家を求めて居るとすぐそばに己れの飛んで居るより高い所にその梢のある大木が見つかったのでそこの葉かげに美くしい身をかくいた。",
              "citation": {
                "source": "胚胎（二幕四場）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うそ、うそ、つれていかいで、なあ克」　克子はごっくり唾をのみこみ、もう押さえることのできない表情のやわらぎの中で、きまりわるげに、「お母さん、ごめん」と、唇だけ動くほどの小さい声でいった。",
              "citation": {
                "source": "赤いステッキ",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが裏街の芥捨場や、雑草の生える埋立地で、詩人の心を低徊させ、人間生活の廃跡に対する或る種の物侘しい、人なつかしい、晩春の日和のような、アンニュイに似た孤独の詩情を抱かせるのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ我れ故郷に低徊して此所に思へることは寂しきかな。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我れ此所を低徊して、始めて更らに上州の蕭殺たる自然を知れり。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "唄をききつつ低徊し、天井を仰ぎ、廻廊を窺い、やがて燈の影を視て、やや驚く。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "渠の心は激動して、渠の身は波に盪るる小舟のごとく、安んじかねて行きつ、還りつ、塀ぎわに低徊せり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然主義運動に対立して平行線的に進行をつゞけた写生派、余裕派、低徊派等の諸文学（夏目漱石などその門下、高浜虚子、長塚節、永井荷風、谷崎潤一郎等）については、森鴎外が、軍医総監であったことゝ、後に芥川龍之介が「将軍」を書いている以外、軍事的なものは見あたらない。",
              "citation": {
                "source": "明治の戦争文学",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、それは、この写生派、余裕派、低徊派等が戦争に対して反対であったからではなく、多くが無関心だったからである。",
              "citation": {
                "source": "明治の戦争文学",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然主義文学が、資本主義的生産関係を反映し、あるがまゝに現実を描こうと企図したのに対して、この写生派、余裕派、低徊派等は支配階級の中に根強く巣喰っている封建主義を多分に反映して逃避的唯美的傾向に走っていた。",
              "citation": {
                "source": "明治の戦争文学",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "されどわれは猶低徊して此方數尺の地を去ること能はざりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "時はすでに遠く過ぎ去っていることも解っていたが、それだけに低徊の情も断ち切りがたいものであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "その途中に思索や反省や低徊のひまはない。",
              "citation": {
                "source": "悟浄出世",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "文章に低徊趣味と云う一種の趣味がある。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから低徊趣味と云わないでも依々趣味、恋々趣味と云ってもよい。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ってセッパ詰って低徊趣味は減じて来る。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで低徊趣味も客観的とか主観的とか区別すれば色々になるが、それは面倒だから暫らく云わぬとしても、虚子の小説には此余裕から生ずる低徊趣味が多いかと思う。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂低徊趣味は長篇ならば兎に角、こんな短かいものにそんな趣味のあらわれる訳がないと。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝敗は多少意味が違うが兎に角腕白な子供と爺さんの対話其物に低徊拍掌の感を起さなくては意味さえ分らなくなる。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々が気の付かない所や言い得ない様な所に低徊趣味を発揮して居る。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しここには低徊趣味が全然欠乏している。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それであれ程の頁で済んで居るから低徊趣味のないのも無理はない。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "取扱の上にすでに社会性が喪失してゐるし、絵を描く本能があゝしたテーマに動くとすれば低徊な趣味といふより他はない。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
