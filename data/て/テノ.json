        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "妾のテノアは東京へ逃げてしまったんです。",
              "citation": {
                "source": "飛行機から墜ちるまで",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日、一日、カク手ガ氾濫シテ来テ、何ヲ書イテモ、ドンナニ行儀ワルク書イテモ、ドンナニ甘ッタレテ書イテモ、ソレガ、ソンナニ悪イ文章デナシ、ヒトトオリ、マトマリ、ドウニカ小説、佳品、トシテノ体ヲ為シテイル様、コレハ危イ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "スベテノ言、正シク、スベテノ言、嘘デアル。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いいテノールだねえ。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いいテノールだねえ、いいテノールだねえ、うまいねえ、うまいねえ、わあわあ。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "頬青き僧ら清らなるテノールなし、　　老いし請僧時々に、バスなすことはさながらに、　　風葱嶺に鳴るがごとし。",
              "citation": {
                "source": "文語詩稿　五十篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔鷺はひかりのそらに餓ゑ〕宮沢賢治鷺はひかりのそらに餓ゑ羊歯にはそゝぐきりさめをあしきテノールうちなして二人の紳士　森を来る",
              "citation": {
                "source": "〔鷺はひかりのそらに餓ゑ〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いゝテノールだねえ。",
              "citation": {
                "source": "かしはばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いゝテノールだねえ、いゝテノールだねえ、うまいねえ、うまいねえ、わあわあ。",
              "citation": {
                "source": "かしはばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで昼食後に少し寝たいと思うと、今度はまたテノルの唱歌で睡眠を妨げられた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "美しいテノルで歌い出すと、今まで謙遜であった彼とは別人のように、燃えるような目を輝かせ肩をそびやかして勇ましい一曲を歌った。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "せんだんの花のこぼれる南国の真夏の炎天の下を、こうした、当時の人の目にはスマートな姿でゆっくり練り歩きながら、声をテノルに張り上げて歌う文句はおおよそ次のようなものであった、「エーエ、ホンケーワーア、サンシューノーオー、コトヒーラーアヨ。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルナルドオは祭の王のよしなき戲を無禮しといきどほり、そのまゝ樓を走り降りて筈ち懲らさばやといひしを、樂長は餘のひと／″＼と共になだめ止むるほどに、「テノオレ」うたひの頭なる男おとづれ來ぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのふ絃歌の中にて「テノオレ」の聲のいと善きを聞きつといふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、当時、ひと頃はずいぶんと人気を呼んだ暁星歌劇団のテノール歌手をやっていたのですが、戦争終局と共に、ばたばたとやって来た大不景気のために最も有力な金主を失ってしまった結果、おまけに肝心な客足はゲッソリと減るし、到頭一座はご多聞に洩れず、何れあじけない旅烏とならなければなりませんでした。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ　ウグヒスハ　オカアサンウグヒスデ、センダツテノ　コト、ボウヤノ　ウグヒスヲ　ナクシタノデ、タイヘン　カナシンデ　ヰタノデシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　トキ　ムカウノ　ムギバタケカラ　コトシニ　ナツテカラ　ハジメテノ　ヒバリガ　ソラニ　マヒアガリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イフト、ヒヤクシヨウハ、「イイトモ、ホラ、ヤキタテノ　パンヲ　五ツ　アゲヨウ」ト　イツテ　セナカノ　フクロカラ　パンヲ　ダシマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "此間理論上天皇ハ凡テノ土地ト人民トヲ私有財産トシテ所有シ生殺與奪ノ權ヲ有シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ天皇ハ第一期ノ意義ニ代フルニ、此等小君主ノ盟主タル幕府ニ光榮ヲ加冠スル羅馬法王トシテ、國民信仰ノ傳統的中心トシテノ意義ヲ以テシタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ原則ト云フ者アラバ、只國家ノ保護ニヨリテノミ各人ノ土地所有權ヲ享受セシムルガ故ニ、最高ノ所有者タル國家ガ國有トモ民有トモ決定シ得ベシト云フコト是レノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ日本ガ小農法ノ國情ナルニ考ヘテ之ヲ自作農ノ所有權ニ移シ以テ土地民有制ヲ取ルコトモ、日本トシテノ物質生活ヨリ築カルベキ幾多ノ理論ヲ有ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡テノ物價問題悉く茲ニ發ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鑛山土地等其者ハ全ク自然ノ存在ニシテ其レヲ所有セシムル凡テノ力ハ國家ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "事業ニ對スル分擔者トシテノ當然ナル權利ニ基キテ制定サルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
