  {
    "uuid": "de3b9713-022f-5b94-b808-b83ad5f420c3",
    "entry": "テイナイ",
    "reading": {
      "primary": "ていない",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "然シ我工場ハ幸イニシテ、皆サンノ勤勉努力にヨッテ、ソノ些々タル影響モ受ケテイナイノデアリマス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在ノ活字ハ、ソノ美シクナイヒラガナヲソノママ活字ニ移シタモノデ、活字ニ必要ナ様式化サエ行ワレテイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間ハオロカ、猿ダッテコンナ醜悪ナ顔ハシテイナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ステージダンサーデモ幾分カソウナルケレドモ、アタシハ幸イニシテナラナカッタワ」浄吉ガ彼女ニ魅セラレタノハ彼女ノ姿態ニアルコトハ確カダガ、ロク／＼学校モ出テイナイノニ、頭モ悪クハナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ静ガ部屋ヲ出テ行コウトスル時、「今日ハ春久ハ来テイナイノカネ」ト、何気ナク聞イテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ要スルニ今デハ愛シテイナイノネ」「君ニ愛人ガ出来タトシタラドウスル？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四五日剃ッテイナイノデ顔ジュウ髯ダラケニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、昨日モ申シ上ゲタヨウニ博士ハ今マデニ何十人トナクコノ患者ヲ扱イ、コノ方法デ簡単ニ成功シテイルノデ、ソンナ神業ナンテ云ワレル程ノムズカシイモノトハ思ッテイナイ、患者モ格別不安ガッタリ恐レタリシタ者ハナカッタ、皆気軽ニ注射シテ貰イ、直グ良クナッテ大喜ビデ帰ッテ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰宅シテ見ルト、颯子ハマダ帰ッテイナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡庸ノ作家ノ技術デハ容易ニ出来ル仕事デハナイガ、予ハ不幸ニシテ彫刻家ニ一人ノ友人モ持ッテイナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシモ僕以外ノ男性ガ彼女ノアノ長所ヲ知ッタナラバ、ソシテ僕ガソノ天与ノ幸運ニ十分｜酬イテイナイガ起ルデアロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ敏子ハコノ縁談ニハドウモ気乗リガシテイナイラシイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少クトモ妻ハ、自分デハ意識シテイナイノカモ知レナイガ、自分デハ若イ二人ヲ監督シテイルツモリカモ知レナイガ、実際ハ木村ヲ愛シテイルヨウニ思エテナラナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトニ足首ノトコロガ十分ニ細ク括レテイナイノガ缺点ダケレヲ許サレテイタダケデ、コノ素晴ラシイ肉体ヲ眼デ視ルヲ得ル夫ハ、今カラ新シイ結婚ヲ始メルノト同ジダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "目下ノトコロ好事ノ士ガ稀ニ用イルノミデ一般ニ普及シテイナイガ、普通ノ手札型ノロールフィルムニ印画紙ガ重ネテアルモノデ、容易ニ日本デハ手ニ入ラズ、一々アメリカカラ取リ寄セルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ写真機ハレンズガ暗ク、レンジ・ファインダーガ付イテイナイノデ、目測デ写サナケレバナラズ、僕ノヨウナ未熟ナモノガ撮ッタノデハピンボケニナリヤスイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洞院ヲ超エタトコロデ、僕ハ彼女ニモウ尾行シテイナイ※ヲ知ラセルタメニ電車通リヲ北側ヘ渡ッテ、ワザト彼女ニ見エルヨウニ彼女ヲ追イ越シテ進ンダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不恰好デ背ノ低イ河合女史ニ比ベルト、優雅ナ体ツキノ妻ノ方ガ似合イソウナモノダケレドモ、身ニツイテイナイ感ジデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハ、アノイヤリングヤレースノ手袋ガ、和服デ着ケテイタ時ノヨウニハ似合ッテイナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエハ自分ノコトシカ考エテイナイ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
