        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それで昼食後に少し寝たいと思うと、今度はまたテノルの唱歌で睡眠を妨げられた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "美しいテノルで歌い出すと、今まで謙遜であった彼とは別人のように、燃えるような目を輝かせ肩をそびやかして勇ましい一曲を歌った。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "せんだんの花のこぼれる南国の真夏の炎天の下を、こうした、当時の人の目にはスマートな姿でゆっくり練り歩きながら、声をテノルに張り上げて歌う文句はおおよそ次のようなものであった、「エーエ、ホンケーワーア、サンシューノーオー、コトヒーラーアヨ。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その声は不断テノル調であるのにこの時はヂスカント調になつてゐる。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前はロッキー専属のテノルで相当のところだったよ」「いい声ね……」「ええ。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女の図」その他と云ひ、これと云ひ、慈眼山先生のたんげいすべからざるテノルドラムには正しく颯々と耳を打たれ眼をそばだてずには居られないのだ。",
              "citation": {
                "source": "月評",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "香水の表情の音色を譬へてみると、私語、口笛、草笛、銀笛、朝鮮｜鐘の夕暮｜余音、バイオリン、クラリネツト、バス、テノル、蝶の羽ばたき、木の葉のかすれ、雛のふくみごゑ等がある。",
              "citation": {
                "source": "「香水の表情」に就いて",
                "author": "――漫談的無駄話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま倫敦のドルウリイ・レイン座は、エドナ・ファウバアの小説からとった、亜米利加渡来の楽劇「芝居舟」を演して大当りを取っているが、そのなかでポウル・ロウブスンという黒人のテノルが歌う「河の唄」が人気を博して、ここでこの真珠王と女王がうたっているのもその「芝居舟」の一節だった。",
              "citation": {
                "source": "踊る地平線",
                "author": "テムズに聴く",
                "note": "青空文庫"
              }
            },
            {
              "text": "町の人々の事は彼は毎も輕蔑して、無教育の徒、禽獸的生活と罵つて、テノルの高聲で燥立つてゐる。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "狹い廊下で人に出遇ふと、先づ道を除けて立留り、『失敬』と、さも太い聲で云ひさうだが、細いテノルで然う挨拶する。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "町の人々のことは彼はいつも軽蔑して、無教育の徒、禽獣的生活と罵って、テノルの高声で燥立っている。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "狭い廊下で人に出遇うと、まず道を除けて立留り、『失敬』と、さも太い声で云いそうだが、細いテノルでそう挨拶する。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘルモジェヌスはシャン・ゼリゼーのテノル歌手とも言い得べく、そのまわりには乞食のトラジウスがボベーシュ流の服を着て金を集めている。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
