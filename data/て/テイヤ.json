[
  {
    "uuid": "30d04b66-a6ea-524a-b190-98d37c513d53",
    "entry": "丁夜",
    "reading": {
      "primary": "ていや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
