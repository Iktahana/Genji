          "literary": [
            {
              "text": "昔エジプトのテエベという町にメムノンという神様の石像があって、毎朝朝日が石像の額に当ると鼻唄のようなものを唄い出す。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝は其處にて死してあらん、かのダビテの輩や、槍投げするテエベびとの死すごとく。",
              "citation": {
                "source": "生けるものと死せるものと",
                "author": "ノワイユ夫人　Comtesse de Noailles",
                "note": "青空文庫"
              }
            }
