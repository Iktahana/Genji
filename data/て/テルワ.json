          "literary": [
            {
              "text": "オカアサン、ホラ　オチチノ　ニホヒガ　シテルワ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "リギ　Rigi　ルツァーンの湖は、ウリ Uri 、シュウィーツ Schwyz、ウンテルワルデン Unterwalden、ルツァーン Lucern の四つのカントンに囲まれているから、フィールワルト・シュテッテル・ゼー 〔Vierwaldsta:tter See〕 と呼ばれておる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギンザヲトホルト、クマノ　トムクント　メリーサンハココハ　ボクシッテヰルアタシモ　シッテルワトオホキナコヱヲ　　　　　ダシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウインクスル時ノ感ジガ殊ニ似テルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アタシバカリジャナイ、女ガ沢山見ニ来テルワ」「ワタクシダッタラ気絶シチマイマスワ」「血ヲ見ルト多少興奮スルワネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間モモウコウナッチャ哀レナモノサ」「自分ニ希望ガ持テナイカラ焼ケ糞気味ニナルノネ」「岡焼キ気味デモアルサ、不便ト思ッテクレ給エ」「巧ク云ッテルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホラ、佐々木サンガ縁側カラ見テルワヨ」路ハ二人ガヨウ／＼並ンデ歩ケルホドノ廣サデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コヽ締メルワヨ」ト云ウ代リニ、「コヽ開イテルワヨ」ト云ウ声ガシテ、珍シク彼女ガ朗カナ顔ヲ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハ帝国ホテルノアーケードノ店ニアルノヲ見付ケテアルノヨ、ドウシテモコレニシヨウト思ッテ」「イクラダ」「三百萬圓」「何ダッテ」「三百萬圓」「冗談ジャナイ」「冗談ジャナイワヨ」「差当リソンナ金ハナイ」「知ッテルワヨアタシ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「明日ハ日曜ダゼ」「エヽ分ッテルワ、ソレガ何ダッテ云ウノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "きげんのいいロオラが、大きな籠の中をグロテスクな足と嘴とで這いまわり、籠の天井にぶらさがったまま、「ワタシ、オトナシクマッテルワヨ」　そうやさしい女の子の声で言い出した時には、不釣合な様子と言葉とがわたしを笑わせました。",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだ――「ワタシ、オトナシクマッテルワヨ」――　子供たちはお父さんにそういうのです。",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
