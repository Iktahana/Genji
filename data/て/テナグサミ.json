[
  {
    "uuid": "62901005-64a8-5d0a-aaeb-8e05effabfd3",
    "entry": "手慰み",
    "reading": {
      "primary": "てなぐさみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
