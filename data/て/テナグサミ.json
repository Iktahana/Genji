        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "休日の午後は、小さな賭け事で手慰みをするのが彼の習慣だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はパチンコを手慰み程度の娯楽と割り切って楽しんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "仲間内で手慰みに花札をするのは、昔からの楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
