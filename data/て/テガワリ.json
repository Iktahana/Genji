        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一方では凄いほどに山おろしが松の梢を鳴らしていたりなどして、不断経の僧の交替の時間が来て鐘を打つと、終わって立つ僧の唱える声と、新しい手代わりの僧の声とがいっしょになって、一時に高く経声の起こるのも尊い感じのすることであった。",
              "citation": {
                "source": "源氏物語",
                "author": "夕霧一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃の客は船頭の手代わり位は誰でもしたものらしい。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "その荷物のまわりには手代りの人足が大勢付き添って、一番先に『御松茸御用』という木の札を押し立てて、わっしょいわっしょいと駈けて来る。",
              "citation": {
                "source": "半七捕物帳",
                "author": "松茸",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「水沢さんが刀でもぬくあいだ、女が手代りに櫂を持っていたのかも知れません。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "お節はこの力強い手代りをいかほどよろこんだか知れない。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大名やその他身分の高い者の乗る駕籠は長棒駕籠といって、棒が長く、八人で手代りに舁くことになっている。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "切棒は実際においては三人で舁き、一人は手代りで休む。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "手代り四人も茫然とした。",
              "citation": {
                "source": "怪異黒姫おろし",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「然だ／＼、手代りでやるだな。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三千両の小判は三つの千両箱に詰められ、主人治兵衛の手で封印を施し、番頭の源助と鳶頭の辰蔵が宰領で、手代りの人足ども総勢六人、柳橋に掛ったのはちょうど昼時分でした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "濡れた千両箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、阿波屋の一行、主人夫婦に娘お由利、手代の宗次郎、鳶頭の銀次に、手代りを加えて人足四人の同勢、春徳寺に着いた時は、出迎えに出たのは、水も垂れそうな寺小姓が一人、「お早いお着きでございます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "群盗",
                "note": "青空文庫"
              }
            },
            {
              "text": "三千兩の小判は三つの千兩箱に詰められ、主人治兵衞の手で封印を施し、番頭の源助と鳶頭の辰藏が宰領で、手代りの人足共總勢六人、柳橋に掛つたのは丁度晝時分でした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "濡れた千兩箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊佐の右太吉、評判はよくないが、そんな惡い人間ぢやございません」「手代りに、その右太吉とやらを頼んで下さい。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "江戸の夜光石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、阿波屋の一行、主人夫婦に娘お由利、手代の宗次郎、鳶頭の銀次に、手代りを加へて人足四人の同勢、春徳寺に着いた時は、出迎へに出たのは、水も垂れさうな寺小姓が一人。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "群盗",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴次郎の一行　加州の家来｜奥村主殿、若党四人に大唐櫃を舁がせ、手代りの人足二人を従え、外に侍姿の若い男――大野の鶴次郎と連れ立って茶店の縁台にドカドカと腰をおろしました。",
              "citation": {
                "source": "天保の飛行術",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "長谷川君は六目だって言っていたぜ」「それは一面手代りだから、六目になることもあるが、矢っ張り関君と同じことで四目は動かない」「両方で主張するところが宜いんだね。",
              "citation": {
                "source": "好人物",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "多力の者を選んで一人で持たせ、三四人の手代りが付添うてあるいたというから、あるいは新潟の夜七夕よりも壮大だったかと思う。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
