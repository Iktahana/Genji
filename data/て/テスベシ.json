          "literary": [
            {
              "text": "且ツ下掲ノ如ク日本國民ハ永久ニ兵役ノ義務ヲ有シ、且ツ一年志願兵特權ハ此等ノ訓練アルヲ一理由トナスヲ以テ其レヲモ廢止スルガ故ニ、兵役ニ於テスベキコトハ凡テ兵營ニ於テスベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "期ハ当ニ九日ヲ以テスベシト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカレドモ将トシテハ、マサニ勇ヲモッテ本トナシ、コレヲ行ウニ智計ヲ以テスベシ。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
