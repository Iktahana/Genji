          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "独裁政権による不当な弾圧に対し、民衆は粘り強い抵抗を続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "警察官の静止を振り切って逃走しようとした男は、公務執行妨害と抵抗の罪で逮捕された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "周囲の激しい抵抗に遭い、計画されていた再開発事業は白紙撤回となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "川楊の大木が、嵐にも洪水にも抵抗し抜いて、力も何も尽き果てたというように、ぐったりと根こそぎに、岸から川の中へ打ち倒れているのを、橋代りにして渡ったが、向う岸に着くまでには、三度ばかり冷たい水の徒渉をしないわけには行かなかった。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然の中でも、比較的に抵抗力の微弱なる森林から初まった。",
              "citation": {
                "source": "上高地風景保護論",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "蠅がばいきんをまきちらす、そうしてわれわれは知らずに、年中少しずつそれらのばいきんを吸い込みのみ込んでいるために、自然にそれらに対する抵抗力をわれわれの体中に養成しているのかもしれない。",
              "citation": {
                "source": "蛆の効用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一に、船底にビルジキールと名づくる鰭のような物を着けると、その抵抗でよほど揺れが少なくなる。",
              "citation": {
                "source": "汽船の改良",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるにセレニウムの奇妙な性質として、その電気抵抗はこれを照らす光の強弱に応じてあるいは減じあるいは増すので、目的地に通ずる電流もまたこれに応じて増減するのである。",
              "citation": {
                "source": "写真電送の新法",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると遠くから来た電波がアンテナからこのデテクターに伝わると同時に白金の間の抵抗が減じ、従って電流が強くなって電話器で音を発する。",
              "citation": {
                "source": "無線電信の近状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "原始的状態にあった昔の日本が外来語を入れたからといって、現代の日本も外来語に対して無抵抗主義を取れという理窟は立たない。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "シーメンスが提出した白金抵抗寒暖計はいったん放棄されて、二十年後にカレンダー、グリフィスの手によって復活した。",
              "citation": {
                "source": "科学上の骨董趣味と温故知新",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば「落体がある場所で九・八メートル／秒秒の加速度をもって垂直に落下する」というのでも、実は地球の重力のみ働き空気の抵抗や電気磁気などの作用がないとした場合の事である。",
              "citation": {
                "source": "物理学実験の教授について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際重力加速度ｇを定めるにはこのような直接の方法によらず、却って間接に振子の週期と長さから定め、空気の抵抗の影響は必要に応じて理論から計算した補正で除去する事が出来るのである。",
              "citation": {
                "source": "物理学実験の教授について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "各種の網糸の強弱弾性やその温度湿度によっての変化とか、網に付ける浮標の浮力、浸水の度やその耐圧度とか、あるいは網面に当る潮流の抵抗の研究とか、いずれも物理学、力学の応用によって解決せらるべき問題である。",
              "citation": {
                "source": "物理学の応用について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "空気の抵抗や、風の横圧や、周囲の物体より起る不定な影響を除去した時に始めて厳密に適用さるべきものである。",
              "citation": {
                "source": "漫画と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルムコルフコイル、グローヴ電池、無定位電流計、大きな電磁石、タムソンの高抵抗ガルヴァなどを買入れた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここの設備は極めて貧弱で、例えば標準抵抗一つさえなかった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "襲撃者は鳶以上であるのに爆撃される市民は芋虫以下に無抵抗である。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "流行の初期に慌てて罹る人は元来抵抗力の弱い人ではないかと思う。",
              "citation": {
                "source": "変った話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、抵抗力の強い人は罹病の確率が少ないから統計上自然に跡廻しになりやすい、そうしてそういう人は罹っても少々のことではなかなか最初から降参してしまわない。",
              "citation": {
                "source": "変った話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "尊氏は夢窓國師に就いて禪を學び、その深奧を究めて居たが、この無抵抗主義の佛教哲學が、彼の場合に於ては、その武人としての境遇と一致せず絶えず深刻な矛盾に苦しんで居た。",
              "citation": {
                "source": "足利尊氏",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニをするんだと抵抗する遊び人の懐から紙入れを取り出した浪人が、　「憎い奴！",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女たちが抵抗して暴れながら振りあげる手の下で、太鼓が目を覺ます。",
              "citation": {
                "source": "旗手クリストフ・リルケ抄",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は恐怖に對して多少抵抗を試みて見た。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "小初は気のない顔をして少しずつ集って来る生徒達に応待していたが、助手格の貝原が平気な顔で見張船の用意に出かけたりする働き振りに妙な抵抗するような気持が出て、不自然なほど快活になった。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾は抵抗することの出来ない程、精神に疲労をうけて、偶像のようにモデル台に立っていたのですが、それから間もなく気を失ってしまいました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "捕虜は生きのがれようとあるだけの力を搾って抵抗したのだろう。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その少年は、もう一度、上唇のさきが無くなった口を哀れげに拡げた、「こんなにおとなしい無抵抗な者を殺してもいゝんですか！",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "疲労と空腹は、寒さに対する抵抗力を奪い去ってしまうものだ。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "戀は力である、人の抵抗することの出來ない力である。",
              "citation": {
                "source": "湯ヶ原より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは地震や台風や火事に対しては申しぶんのない抵抗力をもっているのであるが、しかし一つ困ることはあの厚い壁が熱の伝導をおそくするためにだいたいにおいて夏の初半は屋内の湿度が高く冬の半分は乾燥がはげしいという結果になる。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "小娘の藤江は勿論なんの抵抗もなしに引っ立てられた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "幹太郎は王の眼から、眉間を打たれた瞬間の屠殺される去勢牛のように、人のいい、無抵抗なものを感じた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
