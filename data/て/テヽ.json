        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "△放浪によりてえたる貧しき収穫より――旧作□美しき人を泣かして酒飲みて調子ばづれのステヽコ踊る旅籠屋の二階にまろび一枚の新聞よみて一夜をあかす酒飲めど酔ひえぬ人はたゞ一人欄干つかみて遠き雲みる酔覚の水飲む如く一人に足らひうる身は嬉しからまし　　　　　　　△　△　△△先日の句会では愉快でした。",
              "citation": {
                "source": "雑信（二）",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　カゴノ　中ヘ　ステヽ　キタ　カタナヲ　ワタシマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナンダ　カナヅチカ、オンナジヤウナ　カタチヲ　シテ　ヰルガ、フエハ　ヨイ　オトヲ　タテヽ　ナルノニ、カナヅチハ　ナンニモ　ナラナイ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スコシ　ユクト、オカノ　上ニ　ダイクガ　オホゼイデ　大キナ　ウチヲ　タテヽ　ヰマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "新渡ヲ棄テヽ古渡ヲ取ルハ余モ同意ナレド、其ノ形ニ就テ、新渡ノ価五十銭ナルニ、古渡ハ一百円以上ニ価スル者有リ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "近比外国人ハ競テ日本古物ヲ買求ムレバ、此マヽニテ本邦ノ人ガ我ガ古物ヲ愛重スルコトヲ務メズハ、二三十年ノ後、泰西ニテ必ズ日本古物館ヲ建テヽ、却テ我邦ニテハ自国上代ノ物ヲ観ルコト難キニ至ラン。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "刀ヲ薪トシ玉ヲ石トシ、金ハ泥ノ如ク銀ハ土ノ如ク、投ウチ棄テヽ狼藉タリ。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "深ク我ガ社運ノ隆昌ヲ喜ビ、将ニ尽ク社員ノ前過ヲ棄テヽ新タニ其ノ勲功ヲ録セントス。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "たヾ、まる／＼とふとり、今や夢見中で、夢の中では鉢巻をしめてステヽコを踊つてゐる様子であつた。",
              "citation": {
                "source": "古都",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ヤ惰夫ニシテ徳行ヲ修メ立テヽ以テ令聞ヲ祖考ニ加フルコト能ハズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ヲ寝室ニ送リ込ンデシマウト、「今スグ来マスカラ、チョット待ッテヽネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何ダ、モウ起キテタノカ」「アタシコソ昨夜ハ寝ラレナカッタワ」予ガ窓ノブラインドヲ上ゲルト、寝起キノ顔ヲ見ラレタクナイラシク、慌テヽ浴室ヘ逃ゲテ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前立腺肥大ノ手術ハ七十五六歳マデハ可能デアルカラ、思イ切ッテシテオ貰イナサイ、手術シタ後ノ快感ハ何トモ云エナイ、若イ時ノヨウニ尿ガシャー／＼ト音ヲ立テヽ走ッテ出マス、モウ一度青春時代ニ戻ッタ気ガシマスト、ソウ云ッテクレタ人モアッタガ、困難デ不愉快ナ手術ダカラオ止シナサイト云ウ人モアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ春久ノ開襟シャツトズボント靴下ガ籠ニ入レテ脱ギ捨テヽアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "服ガ籠ニ捨テヽアル以上、彼ハシャワーヲ浴ビテカラ浴衣ニ着カエテイルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「葉ガ繁ッテヽ絡ミツクワヨ、アタシニ掴マッテラッシャイ」「腕ヲ組マセテクレルトイヽガナ」「ソンナコト無理ダワヨ、オ爺チャンハ背ガ低インダカラ」予ノ左側ニ並ンデイタ彼女ハ、突然右側ニ廻ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "慌テヽドルシンヲ三錠呑ム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「少シハ痛クッテモコンナコトヲシテイル方ガ気ガ紛レルヨ、痛クテ溜ラナクナッタラ止メル、今ノウチハ仕事シテイル方ガイヽ、アッチヘ行ッテヽクレ給エ」午後一時ヨリ午睡、一時間ホドトロ／＼トスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハソノ涙ヲゴマカスタメニ慌テヽ眼鏡ヲ取ッテカケタガ、忽チ眼鏡ガ曇ッタノデ、一層工合ガ悪カッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓際ニ予、ソノ隣ニ颯子、通路ヲ隔テヽ佐々木、ト云ウ目算デアッタガ、動キ出シテ見ルト窓際ハ風ガスウ／＼スルカラト云ワレテ颯子ト入レ代リ、通路ニ寄ッタ方ノ席ニ掛ケサセラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「隣ニ佐々木サンガ寝テヽクレヽバ何カアッタッテ安心ジャナイカ、ネエ、颯チャンハコッチデ寝テオクレヨ」「煙草ガ吸エナイノガ困ルワ」「吸ッタライヽサ、イクラデモ吸ッテオクレ」「ソンナコトヲシタラ佐々木サンニ叱ラレチャウワ」「オ咳ガヒドクッテイラッシャイマスカラネ」ト、佐々木ガアトヲ引キ受ケル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらば／＼おさらばの、声も涙に掻き曇り、別れてこそは出て行く」「テヽン」　とお師匠さんは弾き終った。",
              "citation": {
                "source": "ガラマサどん",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいつもこのテヽンで愁眉を開く。",
              "citation": {
                "source": "ガラマサどん",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
