        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ウィスタフカ、或ものはスタティーチェスキー〔統計〕の材料が古く或画は一寸 1905 年時代のハイカラー（つまりワフタンゴフ）があるが、アボルトについてのダイアグラム随分面白かった。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――本名エドワード・ティーチ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "管弦団も合唱団も誇りと名誉を持ったもので、指揮者のティーチェンはどんな人か知らないが、相当の人物だろうと思う。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "指揮者ハインツ・ティーチェンは日本では新顔であったが、ドイツでは有名な人で、歌手もバイロイトに出演するということが即ち第一流ということになると言われている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一人、ドイツで注目される指揮者はハインツ・ティーチェンだ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
