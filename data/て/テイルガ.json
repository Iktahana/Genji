        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "腰椎モ変形シテイルガ、コノ方ハ頸程デナイト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルコール類ト刺戟物ト塩カライ物トハ禁ジラレテイルガ、食慾ハ常人以上デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ガ心配シテ毎日予ヲ仰向ケニ臥カセ、膝ヲ交互ニ組ミ合ワサセテ脚気ノ検査ヲシテイルガ、脚気デモナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレデハ風邪ヲオ引キニナリマス」佐々木ガ又這入ッテ来テ汗デ濡レテイルガーゼノ肌着ヲ着カエサセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟻走感ト云ウノニ似テイルガ、アンナ生ヤサシイモノデハナク、モット強ク激シイ痛ミデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（地味ナスーツヲ着テイルガ、ブラウスガ派手ナノト、フランス製ラシイ模造宝石ノ五聯ノネックレスヲ頸カラ胸ヘ垂ラシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このやうに一尊を台座・光背共に一石で作り出した石佛としては全国的に最も古い年号をもつ像で、また鎌倉時代石佛の様式の基準をこれによつて求め得る点で貴重な遺品である」ト記サレテイルガ、予ハコノ写真ヲ見テ、フト思イ付イタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "如来ノ坐像ハイズレモ男性的ニ結跏趺坐シテイルガ、コノ勢至菩薩ハ女性ラシク両膝ヲ揃エテ坐ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ足ノ形ヲ石ニ刻ンダモノガ支那ニモ朝鮮ニモ保存サレテイルガ、日本ニハ奈良ノ薬師寺ニアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「気狂イ沙汰ダワ」ト、口デハ云ウニ決ッテイルガ、心デハドンナニ喜ブデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ヨリモ、僕ガ彼女ヲ心カラ愛シテイルハ前ニモタビタビ書イテイルガ、ソレハ偽リノナイニハ疲レヤスクナッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハマタ僕ガ足ノ fetishist デアルヲ知ッテイナガラ、イヤ知ッテイルガユエニ、メッタニソノ足ヲ僕ニ見セヨウトシナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ、「コノゴロ僕ノ在宅ノ時ニ妻ガ外出シテイルガアルカラ彼女ヲ連レ出シテ二三時間過シテ来テクレ」ト云ッタカラダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ重ナリ工合ヤ歪ミ工合ハゴク僅カデ、動作ニ不便ヲ感ズルホドノコトハナク、人ニ気付カレルコトモナイノデ、今日マデソノママニシテイルガ、アノ日カラズット、今モソノ状態ガツヅイテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "左ノ手ニハンドバッグト一緒ニ、今ノ商店ノ包ミ紙ラシイモノニ包ンダ、細長イ平ベッタイ包ミヲ持ッテイルガ、中身ハ何デアルカ分ラナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼ハ書物ノ上ニ注ガレテイルガ、何モ読ンデイルノデハナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ト漢中王トハ、養父子ノ間ニナッテイルガ、元々、君ハ羅侯子ノ子デアル。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
