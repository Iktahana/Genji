  {
    "uuid": "88844805-6a2e-56ac-bf07-c2b6b40174f1",
    "entry": "掌",
    "reading": {
      "primary": "てのひら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
