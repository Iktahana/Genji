  {
    "uuid": "966f6833-f3db-50d1-9828-9ae15c9fb2da",
    "entry": "展転",
    "reading": {
      "primary": "てんでん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
