    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」ト　ムスコニ　テガミヲ　ヤリマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランス……ノ……チチ……ニ……テガミ……デ……シラセ……マス……」　という無邪気な日本語が殿下の唇から洩れた。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際、まだ退院後一年にもなるが無想庵にさえ一度もテガミをやらない始末だ。",
              "citation": {
                "source": "だだをこねる",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シュジュツゴ、ガーゼヲトッテ、テガミヲミヨ」「手術後、ガーゼを取って、手紙を見よ」この信号は、繰返し発信されたのだった。",
              "citation": {
                "source": "西湖の屍人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分犬の仔のような心持で、うれしく、しかし恋病にかかって Post へゆき、　テガミアリガトウ　タスカッタ　モヤモゲンキダセ　と打った。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタ、ホントニアタシガカワイイナラ、コノテガミツキシダイ、ヨルノ七時マデニ、イツモノトコロヘキテチョウダイ、キット、キットヨ、デワ　サヨナラ　　　　コイシキコイシキペテロフサマ　シブヤにてアナタノトヨ子※」　それは、いかにも滅多に手紙など書く必要のない女の字であった。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "グッとそッくりかえったり、前かがみになってタテガミをふったりしながら、片足を踏みあげて、太鼓をうつ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "タローサンハ　モシモ　トチウデ、コマルコトガデキ、タラト、バスケツトノナカヘ　デンシヨバトヲイレテキマシタノデ、テガミヲツケテ、ハナシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オテガミクダサラナイノデ……ワタクシタチ……マイニチシンパイシテオリマス……ドウナサツタノ……デスカ……」と判じ判じ読んで、オホホホホホホホと、母は笑い出しました。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "胴体もしっぽも鉄でできているらしく、背中からしっぽにかけて、鳥のトサカのような、動物のタテガミのような、とんがったギザギザのものが、ずっと、つづいていました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもなくなりゃ、お互いの尻尾やタテガミを食って生きてる」　まさか――俺が言うと、尻尾やタテガミのない馬が実際にいるのがその証拠だと言う。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はこの馬の話を――雪に埋れた馬がお互いのタテガミや尻尾を食って生きて行くという話と一緒に波子にした。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
