    "definitions": [
      {
        "index": 1,
        "gloss": "piling up high (food in a bowl)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
