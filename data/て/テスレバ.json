          "literary": [
            {
              "text": "「フランソア・ザビエル師ノ曰ク、予ノ見ル所ヲ以テスレバ、善良ナル性質ヲ有スルコト日本人ノ如キハ、世界ノ国民ノウチ甚ダ稀ナリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "要スルニ餘リ大事ヲ取リ過ギタノガ失敗ノ原因ダッタ、萬々一ノ場合ニ備エテ仰山ナ準備ナドヲセズ、イツモノヨウニ手軽ニ考エテスレバヨカッタ、博士自身ガ神経過敏ニナッテイタノガイケナカッタノダ、ト云ウ点デハ二人ノ意見ガ一致スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
