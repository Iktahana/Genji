        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お嬢さんももう十七八におなりになっていましたが、テニスがお好きで、昔と変らずに同じ年頃のお友達を集めては、庭の一隅にあったテニスコオトで愉快そうに球を打ち合っていらっしゃるのが、往来からもダリヤやフランス菊なぞの咲き乱れた間に垣間見えました。",
              "citation": {
                "source": "朴の咲く頃",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "テニスコオトの附近は、毎日｜賑やかで、まるで戸外舞踏会が催されているようだった。",
              "citation": {
                "source": "麦藁帽子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "テニスコオトの附近は、毎日賑やかで、まるで戸外舞踏會が催されてゐるやうだつた。",
              "citation": {
                "source": "麥藁帽子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
