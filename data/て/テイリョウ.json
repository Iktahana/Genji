        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日本の帝陵は、厳かに歴史を物語っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "考古学者たちは、未だ発掘されていない帝陵に大きな関心を寄せている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は帝陵を訪れ、古代の歴史に思いを馳せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "七　帝陵の丘をあばいて発掘した莫大な重宝を、先に長安へ輸送して任を果たし終った呂布軍も、一足あとから※陽の地を通りかけた。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
