        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日ゴロ愛惜シタ樹木ヤ草花ナドガ、イツトハナク落葉シテシマッテイル。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ニ逢ウタラ鰹節一本贈ルナドトイウテ居タガ、モーソンナ者ハ食ウテシマッテアルマイ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモハジメノウチデ、工場ノ人モダンダンコナクナッテ、死ンダトキニハ、ミンナハモウ君チャンノオ父ッチャノコトヲワスレテシマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンガ行ッテシマッテカラ一人デ静カニ考エテ見ルト、アンナニ怒ラナイデモヨカッタ、颯子ガ婆サンカラ聞イテドンナ風ニ取ッタカト、シキリニ気ニナッテ仕様ガナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ガ短イカラ暗クナラナイウチニ見テシマッテ、奈良ホテルデ夜ノ食事ヲシタヽメテ帰ッテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ、日記帳ヲ入レテアル抽出ノ鍵ハイツモ某所ニ隠シテアルノダガ、ソシテ時々ソノ隠シ場所ヲ変エテイルノダガ、詮索好キノ彼女ハ事ニヨルト過去ノアラユル隠シ場所ヲ知ッテシマッテイルカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際｜此処マデ来テシマッテハ外ニ道ハナサソウデス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
