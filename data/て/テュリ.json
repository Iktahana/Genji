        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オデッサのドルスキィ事件やモンペリエのレテュリエ事件が毒物に詳しい者ならすぐに思い浮かぶだろう。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故なら、公教でも猶太教でも、乳香にはボスウェリア種とテュリフェラの二種しかないからで、勿論混種の香料は宗儀上許されていないからです。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルプスの山脈には常にジュラの小脈がついており、ピレネー山脈には常にアステュリーの小脈がついている。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレン・ギンズバーグ、ゲイリー・スナイダー、ローレンス・ファリンゲティ、ローレンス・リプトン、テュリ・カプファバーグ、マイケル・マクルーアなど、みな、生きのこっている。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "（マルティアリス）＊　ペトロニウスの『サテュリコン』に出て来る売春婦の名。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
