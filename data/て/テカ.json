    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "テカ／＼した靴屋の店や、ヤケに澄ました洋品店や、玩具屋や、男性美や、――なんで此の世が忘らりよか。",
              "citation": {
                "source": "散歩生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒のサージの背広を着て、テカテカに光るネクタイを締めてゐる。",
              "citation": {
                "source": "三等車の中（スケッチ）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐野は始終｜俯むきがちで、モンテカルロに着くまで殆ど誰とも言葉を交しませんでした。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『セイユウカイハツイニカイサンカイヒウンドウヲステテカンブカイハ、ウンヌン。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "太宰イツマデモ病人ノ感覚ダケニ興ジテ、高邁ノ精神ワスレテハイナイカ、コンナ水族館ノめだかミタイナ、片仮名、読ミニククテカナワヌ、ナドト佐藤ジイサン、言葉ハ怒リ、内心ウレシク、ドレドレ、ト眼鏡カケナオシテ、エエト、ナニナニ？",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリツク怒濤、実ハ楽シキ小波、スベテ、コレ、ワガ命、シバラクモ生キ伸ビテミタイ下心ノ所為、東京ノオリンピック見テカラ死ニタイ、読者ソウカト軽クウナズキ、深キトガメダテ、シテハナラヌゾ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫女人ノ身ハ、五障三從トテ、オトコニマサリテカカルフカキツミノアルナリ、コノユヘニ一切ノ女人ヲバ、――馬鹿らしい。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネネムは起きあがって見ますとお「キレ」さまはすっかりふだんの様になっておまけにテカテカして何でも今朝あたり顔をきれいに剃ったらしいのです。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、コンネクテカット州だ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和六年五月、文芸春秋）　　　　　　　三「青い天使」と同日に「モンテカルロ」を見たのもおもしろい取り合わせであった。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、ルービッチの「モンテカルロ」で突進する機関車のエンジンの運動と汽笛の音と伴奏音楽との合成的律動や、「自由をわれらに」における工場の鎚の音、「人生案内」の線路工事の鉄挺の音の使用などのようなのがそれである。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "始終私に失礼な目つきをして、――下品な膨れっ面の、赤い髭をした、テカテカ光らせた髪を、額の両側に垂れ下げた、いやらしい奴ったらありませんでしたわ。",
              "citation": {
                "source": "自転車嬢の危難",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭を横截って二人で上がって行くと、書棚や椅子や額や、雑書雑誌などの雑然と積み重ねられたなかで、子供の庸太郎が、喫茶台の上と下に積んであるレコオドのなかから、彼女に向きそうなチャイコフスキイのアンダンテカンタビレイをかけてくれた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカあなたニ絵ヲ見テモライマシテカラ故郷デ貧乏漁夫デアル私ハ、毎日忙シイ仕事ト激シイ労働ニ追ワレテイルノデ、ツイコトシマデ絵ヲカイテミタカッタノデスガ、ツイカケナカッタノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「今の先、青テカ坊主が黙ッておいていったわ」「なるほど。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "春吉君は、古手屋の遠助のあほうが、そんなろくでもないことを、手がら顔して語るのを聞きながら、それらのすべてのことを、あかぬけのした、頭をテカテカになでつけられた藤井先生が、どんなにけいべつされるかと思って、じつにやりきれなかったのである。",
              "citation": {
                "source": "屁",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　トキ　ムカウノ　ムギバタケカラ　コトシニ　ナツテカラ　ハジメテノ　ヒバリガ　ソラニ　マヒアガリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ヨルニ　ナツテカラ　ネシヅマツタ　ヒトツノ　ムラニ　ツキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ　イロイロ　カンガヘテカラ、マタ　マエノ　ラツパト　オナジ　ラツパヲ　オクツテ、「コノ　ラツパヲ　ミミニ　ツケルト　ワタシノ　コヱガ　キコエマス。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "柔和な双顎の上は、何から何まで円みをおびていて、皮膚はテカテカ蝋色に光沢ばんでいる。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
