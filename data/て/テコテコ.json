        "examples": {
          "standard": [
            {
              "text": "「ほら、あの子犬がてこてこ歩いてこっちに来るよ。可愛いね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「お昼休みに公園を散歩してたら、鳩がてこてこ足元を横切っていったわ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「幼児が一生懸命にてこてこ歩く姿は、見ていて飽きないものだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "驢は、てこてこと、軽い蹄をただ運んでいた。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
