    },
    "definitions": [
      {
        "index": 1,
        "gloss": "handwoven",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この絨毯は、職人の手織りによるもので、非常に高価だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は趣味で手織りのマフラーを作っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "手織りの生地は、独特の風合いと温かみがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "どんなにいゝ着物をきせても、百姓が手織りの木綿を着たようにしか見えない。",
              "citation": {
                "source": "自画像",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "またことしの初夏には松坂屋の展覧会で昔の手織り縞のコレクションを見て同じようななつかしさを感じた。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "話は脱線するが、最近に見た新発明の方法によると称する有色発声映画「クカラッチャ」のあの「叫ぶがごとき色彩」などと比べると、昔の手織り縞の色彩はまさしく「歌う色彩」であり「思考する色彩」であるかと思われるのである。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよその時代が来るころには、あるいは草木染めの手織り木綿が最もスマートな都人士の新しい流行趣味の対象となるという奇現象が起こらないとも限らない。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀座で草木染めが展観されデパートで手織り木綿が陳列されるという現象がその前兆であるかもわからないのである。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦心惨澹して、手織りのみすぼらしい貧弱な着物を着ているよりは、どうも昔の着物の方が立派にはちがいありません。",
              "citation": {
                "source": "猫と杓子について",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和十年九月、渋柿）曙町より（二十七）　子供のときから夜具といえば手織り木綿の蒲団にあまり柔らかくない綿のはいったのに馴らされて来たせいか今でもあまり上等の絹夜具はどうもからだに適しない、それでなるべくごつごつした紬か何かに少し堅く綿をつめたのを掛け蒲団にしている。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は手織り縞の綿衣をきて、鉄色木綿の石持の羽織をかさねていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "雪達磨",
                "note": "青空文庫"
              }
            },
            {
              "text": "筒袖かとも思われるような袂のせまい袷の上に、手織り縞のような綿入れの袖無し半纒をきて、片褄を端折って藁草履をはいているが、その草履の音がいやにびしゃびしゃと響くということであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "あま酒売",
                "note": "青空文庫"
              }
            },
            {
              "text": "背の高い頬骨の出た男で、手織りの綿衣に絣の羽織を着ていた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紡ぎの糸を手織りにした頑丈な地質で、背中の処におそろしく大きな三柏の定紋が染め抜かれてゐた。",
              "citation": {
                "source": "夏蚕時",
                "author": "金田千鶴",
                "note": "青空文庫"
              }
            },
            {
              "text": "手織り縞でこそあれ、当時の風俗のように割合に長くひいた裾の着物は彼女に似合って見える。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな状態にあったので、「どうぞお茶を──」の声にふりむいた目の前に、手織り木綿のかすりもにおう乙女が涼しいほおえみをたたえて手をついているのを見てつい「あら、乙姫さま」と私は言ってしまったのであった。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "破れ行燈の灯を受けて、手織りのゴツゴツした縞｜木綿、模様もさだかならぬ帯をまいて、見るかげもない田舎娘ですが……その顔の美しさ！",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "入口に近い、南洋杉の鉢植えのそばの椅子には、恰幅のいい切下げ髪のご隠居さまと、ゴツゴツした手織り木綿の着物に、時代のついた斜子の黒紋付きの羽織りを着た、能面の翁のような雅致のある顔つきの老人が、おだやかな口調でボツボツと話し合っている。",
              "citation": {
                "source": "キャラコさん",
                "author": "新しき出発",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、娘らしい心づかいが田舎じみた衣しようのはし／″＼にもみえてあらい手織りじまのモンペがよく似合うのも、ほゝえましかつた。",
              "citation": {
                "source": "火の扉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、自分は手織りのヴァーモント灰色｜地の服を着ているが、これはよい、といった。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "衣服なども苧麻を染めて手織りで作っているが、非常にいいものが出来る。",
              "citation": {
                "source": "台湾の民藝について",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなことで何かわかる人柄で、手織りの紬のようだが、孝作のようにその味だけの人でもなく近代の精神ももっているらしいが、大規模の人柄ではなくて、妻はやはりうちをキチンとしていくらかは風情あるこころも解するという程度の人がいいらしいのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "全員が地味な青い羊毛服を短く着て、スカートをはき、丈夫な靴と、手織りの黒いストッキングを履き、頭には堅い縁取りで扇風機のような丸帽子を優雅にかぶっている。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "手織りはどうかしら」　ルースが熱く見上げた。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの上に、ナオミ手織りの白いレース編みベールをかけた。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "布団は、郷里の妹が手織りで作ったのを送って来たが、机は夜店で一閑張りを買った。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "磯吉のほうも見なれぬ鳥打帽を右手にもち、手織り縞の着物の膝のところを行儀よくおさえていた。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は千筋の手織り木綿の袷に双子縞の羽折、小倉の角帯をしめ、麻裏草履をはいていた。",
              "citation": {
                "source": "さぶ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "褐色の荒い手織りのマントを着、麻の長衣をつけ、粗末な靴をはいていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "裾短に括っている山繭の腰帯もそれも自身の手織りなのである。",
              "citation": {
                "source": "日本名婦伝",
                "author": "大楠公夫人",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪は麻糸でそッけなくうしろへ結び、なりは手織りの筒袖に、黒のもんぺときまッていて、腰の短い山刀が、この小童の風采を、すこし異様に光らせています。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてかれらの手織りには、そんな薄い布は入用がなかった。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、その手紙の差出人のＭ・Ｔという男のひとを知っております。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
