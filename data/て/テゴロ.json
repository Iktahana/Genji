        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "駅から徒歩5分でこの家賃なら、一人暮らしにはかなり手ごろな物件だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "週末の小旅行には、片道二時間程度の距離が時間的にも手ごろである。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ちょっとしたお返しとして贈るのに、千円前後の手ごろな菓子を探している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
