[
  {
    "uuid": "f68eee21-8fd4-5006-abc4-86a6520a7322",
    "entry": "手ごろ",
    "reading": {
      "primary": "てごろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
