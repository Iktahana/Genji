        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「埋木」OSSIP SCHUBIN「アルフォンス・ド・ステルニイ氏は十一月にブルクセルに来て、自ら新曲悪魔の合奏を指揮すべし」と白耳義独立新聞の紙上に出でしとき、府民は目を側だてたり。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝ネピを發してテルニイに抵りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "賊はサビノの山のものなりといへど、羅馬のテルニイとの間に出沒して、人その踪蹤を審にすること能はず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウファ映画「会議が踊る」の中で、メテルニッヒがウエリントンの会話などを盗み聴くあれがそうである。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "歐羅巴の平和はタルラン、メツテルニヒが手にのみ握られたりしにあらず。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "八　天才　十九世紀には随分すぐれた外交家が出たが、そのうちでも墺国のメッテルニッヒはわけても傑物であったと思う。",
              "citation": {
                "source": "今昔茶話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後、長い年が経って、ナポレオンは仏国の皇帝となり、メッテルニッヒは墺国の駐仏大使としてパリに駐在した。",
              "citation": {
                "source": "今昔茶話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう国際関係の渦中にあって、しかも敵国ともいうべき仏蘭西の首府パリに在って、外交手段を揮わなければならないのであるから、メッテルニッヒの位置は、きわめて困難であったといわなければならない。",
              "citation": {
                "source": "今昔茶話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに、後世、権謀術数の権化のようにいわれているメッテルニッヒは、その高い家柄と勝れた教養と、まれに見る美貌と、端麗な風采とを以って、堂々と振舞い、談笑の間に折衝し着々と自国の利益を計りながら各国使臣の間に嶄然頭角をあらわし、尊敬のマトとなった。",
              "citation": {
                "source": "今昔茶話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "卒然とメッテルニッヒはいった。",
              "citation": {
                "source": "今昔茶話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "メッテルニッヒは云いつづけた。",
              "citation": {
                "source": "今昔茶話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このナポレオンの心情を洞察して、ナポレオンを駆って、露国征伐の暴挙をさせようと、裏から策動したのが、墺国の大外交家で、梟雄ともいうべきメッテルニッヒであった。",
              "citation": {
                "source": "今昔茶話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それへ付けこんだのがメッテルニッヒで、「新皇后のお心をよろこばせるためにも、一つ、はなばなしく露国をたたきつけて……」などと焚きつけた。",
              "citation": {
                "source": "今昔茶話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタミホテルニ来遊ノ旨、歓迎ト答ウ。",
              "citation": {
                "source": "父の手帳",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇敢な連中とは、皇帝ナポレオン三世、皇后ウージェニイ、学問自慢の貴族と少数の大官連、それに、文学者側から、アレクサンドル・ヂュマ・フィス、オクタアヴ・フウイエ、その外、メッテルニッヒ公爵とその夫人ポオリイヌ、などであつた。",
              "citation": {
                "source": "アカデミイの書取",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "メッテルニッヒ公爵夫人、四十二……。",
              "citation": {
                "source": "アカデミイの書取",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "メッテルニッヒ公爵閣下、三……。",
              "citation": {
                "source": "アカデミイの書取",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、アレクサンドル・ヂュマは、つと起ち上つて、最も年少の外国貴賓メッテルニッヒ公爵の前に進み出で、恭しく、「公爵、アカデミイで、綴字法の御講義を何時お願ひできませうか」　と云つた。",
              "citation": {
                "source": "アカデミイの書取",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローマ法皇もツァールも、メッテルニヒもギゾウも、フランスの急進黨もドイツの探偵も。",
              "citation": {
                "source": "共産黨宣言",
                "author": "カール・マルクス",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔譯者註〕メッテルニヒはオーストリーの宰相、ギゾウはフランスの首相。",
              "citation": {
                "source": "共産黨宣言",
                "author": "カール・マルクス",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は侯を目して東洋のビスマークなりと信ずるほどに侯を崇拜せざるのみならず、侯を以てメツテルニヒの惡血を混じたる奸雄なりとも思はず。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "侯はビスマークの大膽雄略なく、又メツテルニヒの隱險佞惡なしと雖も、其專制主義を喜び、宮廷的攻略に長ずるに至ては、侯は稍此二人に類似したる所あり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は侯を目して東洋のビスマークなりと信ずるほどに侯を崇拝せざるのみならず、侯を以てメツテルニヒの悪血を混じたる奸雄なりとも思はず。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "侯はビスマークの大胆雄略なく、又メツテルニヒの隠険佞悪なしと雖も、其専制主義を喜び、宮廷的攻略に長ずるに至ては、侯は稍此二人に類似したる所あり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月にはテルニに行って、大瀑布の霧にうつれる虹を見たが、このとき虹の円形の全体を見ることができた。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "というわけで、そのスケッチ・ブックには、百姓家や、風景や、名もない廃墟がぎっしりつまっているのだが、セントピータース寺院とか、ローマ円形劇場とか、テルニ瀑布とか、ナポリ湾は描かずにしまった。",
              "citation": {
                "source": "わたくし自身について",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            },
            {
              "text": "またルイ・フィリップの息子のうちのふたりは、メッテルニッヒをして次の平民的賛辞を発せさした。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "メッテルニッヒは進んでこの王位に臀革を施さんとした。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の学校に在るや、恒に黒衣を纏えり、曰く、「これ我邦のために喪服を着るなり」と（蓋し当時伊国の、如何に憐れなる形勢に陥りしやは、彼の圧制の権化、旧主義の本尊メテルニヒが、伊国は地理学的の名目にして、国家的称号にあらずと言して曰く、「革命は人民のために、人民の手に依りて成就せざるべからず。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
