          "literary": [
            {
              "text": "茶代ノ少キ客トイエドモ軽ク取リ扱ワズ、況ンヤ多ク恵ム者ニオイテヲヤ。",
              "citation": {
                "source": "一枚絵の女",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤ、ラファエルニオイテヲヤ……未ダカツテ……ジョットーヨリ純正偉大ナル宗教画家ハナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "況ヤ高尚ナル學理ニテ論ズル、其關係組織ノ殊ニ極ル者ニ於テヲヤ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤソノ師ニオイテヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "況ンヤ御贔屓ノ訥升ガ見ラレルニ於テヲヤ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
