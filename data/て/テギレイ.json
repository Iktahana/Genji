[
  {
    "uuid": "784e5975-9f56-5d82-a744-a4e0551823da",
    "entry": "手綺麗",
    "reading": {
      "primary": "てぎれい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
