        "examples": {
          "standard": [
            {
              "text": "目にゴミが入ったときのために、いつも点眼水を携帯している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "洗眼カップを使って、優しく点眼水で目を洗い流してください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長時間のデスクワークで目が疲れたら、この点眼水でリフレッシュするのが一番だね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "眼を洗ったり点眼水を挿したりしても良くならないので、宿の番頭に近所の眼医者へ案内して貰い、眼の中の物を除いて貰ったが、医者は今日一日だけこれを外さないようにと云って、右の眼に眼帯をさせ、明日もう一度いらっしゃいと云うのであった。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
