          "literary": [
            {
              "text": "『倶舎論』に、「譬如灯焔雖刹那滅、而能相続転至余方、諸蘊亦然。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに寛文六年の序ある『会津風土記』には、只見川源出会津小瀬沼、北流過山間数十里、東転至田子倉村、云々。",
              "citation": {
                "source": "尾瀬雑談",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又星野博士は『史學雜誌』に於て、神功紀に「轉至山門縣、則誅土蜘蛛田油津媛」とある山門縣、即ち筑後の山門郡を以て邪馬臺國と考定せり。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
