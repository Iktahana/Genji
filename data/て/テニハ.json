        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "トコロガ　ミルト　カジヤノ　テニハ、カナヅチガ　ニギラレテ　ヰマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オモテニハ　タタミガ　ズラリト　ナラベテ、タテカケテアツテ、　トン　トン、バタ　バタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれはお前、皆吉って男なんだ」「そいつは驚いた」「それでなきゃア、テニハの合わない事ばかりさ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "八人芸の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いくら大黄だって、そんなに急に腹が痛くなるわけはないし、怪しい安倍川を川へ捨てたというのもテニハの合わない話だ、――これはやはり二人で逢引するための拵え事だろう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "金の鯉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんな事を言わずに、ちょいと行ってやって下さいよ、――仙太兄哥は、与母吉を縛ってしまいましたよ」「俺が行ったところで、それより解る道理はない、誰か下手人を庇っているんだ」「ヘエ――、そんな事がどうして解るんで」「テニハの合わない殺しがあったら、そう思え。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "どんど焼き",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤三郎は武家出だというから、そんな仕事にかけては胆もすわっているだろう」「見ていたようだね、親分」「まア、そうでも考えなきゃア、テニハが合わねえ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "人肌地蔵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
