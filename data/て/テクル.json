          "literary": [
            {
              "text": "高原でひとまず人夫を返し、荷馬車に大荷物を頼んでテクル事にした。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツテクルヨ、ランランラン　こう私は小田原の妻子へ打電するように弟に頼んだが、船が出ると船員が私の前に「電報がまいっております。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ問題ハ活字ト関係ガナサソウデアルガ、原稿ヲ書ク場合ニ関係ガ生ジテクルノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノ茶碗ヲアノ机ノ上ニオイテ、ソノ机ノ上ノ窓ヲ閉メ、椅子ノ上ノ本ヲココニ持ッテクル――んだ」　おそろしく生まじめな眼を輝かした教師に、川上忠一はへへら笑いを見せて簡単にその動作をやってのけた。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテカラ二人ノ様子ガオカシイト感ジテ居リマシタカラ、其ノ時何トナク気ニナリマシタノデ暫ク経テカラ私モ便所ニ行ッテクルカラト申シテ室外ニ出マシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "作中、Ｔ市長ダノ銀座ダノトイウ名詞ガ出テクルガ、コレハ決シテ何処カノ帝都ニアッタ実話ナドヲもでるニシタモノデハゴザイマセン。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イワハ十三ニチフネデトウキョウニカエッテクルゾ。",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フネデトウキョウヘカエッテクルゾ……東京へ帰るというからには、芝浦へ着くのか、それとも横浜に着いて東京へ入るのか」　課長は大いに迷った。",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――関門海峡ニハ、タクサンノ外国船ガ入ッテクルコトトナッテ、沖ノ仕事モ増スバカリトナッテ、組デハ、若クテヨイ働キ手ヲサガシテオル。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ前ガ出テクルノヲ待ツ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
