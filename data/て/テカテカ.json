[
  {
    "uuid": "e1ce05c0-aac0-5c4d-a5e6-2b4de3c60986",
    "entry": "テカテカ",
    "reading": {
      "primary": "テカテカ",
      "alternatives": [
        "てかてか",
        "テッカテカ",
        "てっかてか"
      ],
      "is_heteronym": false
    },
    "grammar": {
