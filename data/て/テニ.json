        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三人が一塊になつて砂ほじりでもしてゐるかと思ふと、テニス・コートをてん／″＼ばら／＼に駈け※つて、腹を抱へて笑ひ合ふ姿も見える。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々こっそり、裏のテニスコートなどに降りてみる事はあっても、正々堂々の外出の許可を得たのは、僕がここへ来てからはじめての事であった。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と大声で言って、「テニスコートで、お江戸日本橋を歌っていらっしゃったのは、どなたです。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は眼を大きく※って、洗面所の窓からテニスコートの黄ばみはじめた銀杏を黙って眺めていた。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と僕と並んで洗面所の窓からテニスコートのほうを眺めながら、ひとり言のように、「ひばりが来てから、道場も変っちゃったなあ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏は散歩の代りにローンテニスもやった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "テニスの上手な来客でもこの羽根の生えたボールでは少し見当が違うらしい。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫が見たら人間のテニスやベースボールは定めて間だるっこくて滑稽なものだろうという気がするのである。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "テニス競技の場面の挿入は、物語としては主要なものでないが、映画の中の挿話として見ると不思議な心理的な効果をあげている。",
              "citation": {
                "source": "映画雑感６",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋にはこういう事にも熱心な学者が多く、玉突、テニス、砲丸投等の技術を力学的に研究した例は乏しくない。",
              "citation": {
                "source": "相撲と力学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は彼と別れにのぞんで、ミケルド・モンテニュの「社会の計画の中庸を持し、運命的施設を待つ」の一句を彼に進呈した。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "海原、離宮、車輛、工場のテニスコート、僕が彼女の乳房のあたりを見つめているうちに、八時四十分、大阪着。",
              "citation": {
                "source": "飛行機から墜ちるまで",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テニスだよ、テニスと言えば可い。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "帽子は、スフのテニス帽。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちはお寺の前の広場で、ランニングをしたり、テニスをしたり、また日曜には弁当を持つて近くの山へ遊びに行つた。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんどの遊びは、テニスやランニングではなかつた。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「テニスコートがあって、看護婦さんとあそんで、ゆっくり御静養できますわよ。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と鍵の束持てるポマアドの悪臭たかき一看守に背押されて、昨夜あこがれ見しテニスコートに降り立ちぬ。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまで人一倍、がんばって勉強して、それからテニスも、水泳もお上手だったのだもの、いまの寂しさ、苦しさはどんなだろう。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "中学の終りからテニスを始めていたぼくは、テニスのおかげで一夜に二寸ずつ伸びる思いで、長身、肥満、Ｗ高等学院、自涜の一年を消費した後、Ｗ大学ボート部に入りました。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗匠頭巾をかぶって、『どうも此頃の青年はテニヲハの使用が滅茶で恐れ入りやす。",
              "citation": {
                "source": "或る忠告",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "式場は、教会の広庭に、大きな曲馬用の天幕を張って、テニスコートなどもそのまま中に取り込んでいたようでした。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "留学の序を憤り、　　　　　　　中庭にテニス拍つ人。",
              "citation": {
                "source": "文語詩稿　五十篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "肖像朝のテニスを慨ひて、　　　額は貢し　雪の風。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たった二人でぬれた運動場の朝のテニスもさびしいだらう。",
              "citation": {
                "source": "山地の稜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "午后はみんなでテニスコートを直したりした。",
              "citation": {
                "source": "或る農学生の日誌",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
