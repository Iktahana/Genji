          "literary": [
            {
              "text": "またも密やかで音楽的な笛音が聞こえてきた――「テケリ・リ！",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "またしてもあの邪悪な、幅広い音調に渉る吹鳴が聞こえた――「テケリ・リ！",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "再びショッキングな広い音調に渉る吹鳴が聞こえた――「テケリ・リ！",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "またしても無気味な嘲りの叫びが聞こえた――「テケリ・リ！",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時彼が叫んだ言葉は、余りに明白な源から発した、単純かつ気違いじみた単語の繰り返しに終始していた：(*42)「テケリ・リ！",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
