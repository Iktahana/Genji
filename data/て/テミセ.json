          "literary": [
            {
              "text": "彼女はその感情をかくして、「一寸、あんたの手見せてごらんなさい」と云った。",
              "citation": {
                "source": "高台寺",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸者に手見せの試験あり。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の大辻君代演の一夜はたまたま吉本への手見せとなり、吉本でもどうにか潰しの利く高座だと思ってくれたのか、来月、京都の新京極の富貴で金語楼、小春團治、九里丸とあんたで新人会を演るさかい出演しなはらんかと言われた。",
              "citation": {
                "source": "わが寄席青春録",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
