        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「モシオ前ノ友ダチガウッカリシテイテオ前ノ足ヲ踏ンダラオ前ハドウスルカ？",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "下手な鉛筆の走り書きで、今スグ行キマス　ムコウノポストノソバデマツテイテ下サイ　と記されてある。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ一年ニナルノニ、彼奴ハ故郷ニジットシテイテ、ドコニモ働キニ行コウトシナイ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「出勤ガシタイト兄ヘ云ッタラ、手前ガ手段デ、勤道具、衣服モ出来ルナラ、勝手ニシロ、オレハ、イカイコト手前ニハイリ上ゲタ故、今度ハ構ワヌトイッタ故、ソノ時ハオレガホホノ下ニハレ物ガ出テイテ寝テ居タガ、少シモ苦労ヲカケマイトイウ書附ヲ出シテ、檻ヲ出デ――」　出たな！",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在の中にある矛盾と不安とに押し出されて永久に前進の努力を續ける生活こそ自然であつて、テーゼに甘んじてアンテイテーゼを通過しジユンテーゼに到達する努力を缺く生活は不自然である。",
              "citation": {
                "source": "三太郎の日記　第三",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルベク今ノ程度ニハ太ッテイテ貰イタイナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "石膏デ出来テイテ、頸カラ頤ヲ突キ上ゲルヨウニシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手ノ痛ミデ眼ガ覚メルコトモタマニハアルガ大概半分ハ寝惚ケテイテ、痛イナト思イナガライツカ寝テシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日ノ諍ガマダ頭ニ残ッテイテ、少シイツモヨリ萎ゲテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ浴槽デ足ヲ伸バシテイテ、急ニ起キ上ロウトシテ浴室ノ縁ニ手ヲカケタラ、手ガ滑ッテ起キラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――舌デ触ラナイデ唇ダケ着ケルノヨ」膝カラ上ハ顔マデスッカリ隠レテイテ、バス・カーテンノ裂ケ目カラ脛ト足ノ先ダケ出タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸ハ締マッテイテ動カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツマリ彼等ハ、午後二時半カラ四時半マデハ予ガ治療ヲ受ケテイテ寝室カラ出ル筈ガナイト、考エタノニ違イナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "萩ガ両側カラ伸ビテイテ歩キニクイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サッキノ土蹈マズノ感触ガ、マダ唇ニ残ッテイテ忘レヨウトシテモ忘レラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ家ノ庭ニモ稀ニ蟋蟀ガ鳴クコトハアルガ、コノ寝室ノベッドニ寝テイテ聞エルノハオカシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガオカシイノハ、母ダケガ若キ日ノ姿ヲシテイテ、予ハ現在ノ老人ノマヽデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母ハ明治十六年ニ生ンダ我ガ子ノ督助ガ、ナオモコノ世ニ生存シテイテ、コノ颯子ノヨウナ女、而モ彼女ノ義理ノ孫、彼女ノ孫ノ正妻デアル女―――ニ浅マシキ魅力ヲ感ジ、彼女ニイジメラレルコトヲ楽シミ、自分ノ妻、自分ノ子供達ヲ犠牲ニシテモ彼女ノ愛ヲ得ヨウトスルノヲ、何ト思ウデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツメタイ餘リ無感覚ニナッテイテ、ソレデイテ痛イ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "川勝氏ノ著書ヲ見ルト、上京区千本上立売上ルニ石像寺ノ阿弥陀三尊石佛ト云ウモノガアッテ、中尊ニ定印弥陀坐像、ソノ向ッテ右ニ観音、左ニ勢至ノ二脇侍立像ガ侍立シテイテ、ソレラ三尊ノ写真ガ各別々ニ載ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那人ハコノ技ニ甚ダ熟達シテイテ、風ノ吹ク中デモ平気デブラシニ水ヲ含マセ、碑面ニ白イ紙ヲ伸バシテ傍カラパタ／＼叩イタリシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガ石ヲ蹈ミ着ケテ、「アタシハ今アノ老耄レ爺ノ骨ヲコノ地面ノ下デ蹈ンデイル」ト感ジル時、予ノ魂モ何処カシラニ生キテイテ、彼女ノ全身ノ重ミヲ感ジ、痛サヲ感ジ、足ノ裏ノ肌理ノツル／＼シタ滑ラカサヲ感ジル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "椅子ニ掛ケテイテモ予ハ眼ガ晦ンデ倒レソウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思イモ寄ラヌ秘密ヲ不意ニ彼女ニ発カレタヽメカ、自分デモ疾ウカラ内々ハ気ヅイテイテ、強イテ気ヅカヌ振リヲシテイタノニ、コノ古狸ニ突如素ッ破抜カレタヽメカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏子ガ門ノ前ニ立ッテイテ、庭カラスグニ離レ座敷ヘ案内シ、「デハ私ハ留守番ニ行ッテイマス」ト云ッテ出テ行ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ノ方カラモソノハ、髪ガ解ケテ乱レテイテ襦袢ノ襟ガヒドク濡レテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ガ去ッテカラ、敏子ガ留守番ヲシテイテクレタノヲ思イ出シテ、茶ノ間ヤ敏子ノ部屋ヘ行ッテミタガモウイナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（脚ノ力モ弱ッテイテ歩キ過ギルトジキニ疲レル）………　………今日散歩カラ戻ッテ来ルト妻ガ洋裁ノ河合女史ト茶ノ間デ話シテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階ヘ行ッテイテ下サイ」ト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オ京サンハ、前カラ、金五郎サント出来テイテ、ドウシテモ、ウン、トイイマセン。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
