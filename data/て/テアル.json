        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君ニ逢ウタラ鰹節一本贈ルナドトイウテ居タガ、モーソンナ者ハ食ウテシマッテアルマイ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ノ日記ニハ「古白曰来」ノ四字ガ特書シテアル処ガアル。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラダガナオッタラ、＊＊＊＊＊＊＊＊＊ニナッテ、＊ヲ＊＊テアルキタイナアッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "急ニ轟々タル音響ガ聞エテ西南ノ方聖天町邊（書信ニハ圖ガ添ヘテアルガ略スル）ニ旋風ノ起ツテヰルノヲ認メタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ南々西ニ向ケ、雷門吾妻橋ノ方ヘ（書信ニハ地圖ニ矢ヲ記入シテ方向ヲ示シテアル）進ンデ行クヤウニ見エタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "［第三図］※　　　　　　　８　　　＿＿＿＿＿＿＿７４□）□□□□□□　　　　□□□２　　　　―――――　　　　　□９□□※ハ沼津市駅前、菊屋食堂ノ「ロンドン」塔ノ写真ヲ焼付ケテアル鏡ノ裏面。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "貝原益軒の『大和本草』に『仙覚抄』を引いて「浜ユフハ芭蕉ニ似テチイサキ草也茎ノ幾重トモナクカサナリタル也ヘギテ見レバ白クテ紙ナドノヤウニヘダテアルナリ大臣ノ大饗ナドニハ鳥ノ別足ツヽマンレウニ三熊野浦ヨリシテノボラルヽトイヘリ」とある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ予ノ部屋ニ青磁ノ水盤ニ縞スヽキト三白草ト泡盛草ガ活ケテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "石膏デ出来テイテ、頸カラ頤ヲ突キ上ゲルヨウニシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナ黒人ノ俳優バカリ使ッテアルノ」「ソレガソンナニイヽノカネ」「ブレノ・メロッテノハサッカーノ選手上リデ、素人ナンデスッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ニ読マレテハ困ルカラ手提金庫ニ入レテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ浴室ト寝室ノ間モ行ケ／＼ニシタガ、コレハ必要ニ応ジテ浴室ノ内部カラ締マリガ出来ルヨウニシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツイデニ記スト、便所ノ右隣ガ予ノ書斎（コノ間モ行ケ／＼ニシテアル）、ソノ右ガ看護婦ノ部屋。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若夫婦ノ居間ハ可ナリ豪華ニ飾ッテアルラシイガ、階段ノ中途ガ螺旋ニナッテイルノデ、足モトノ悪イ予ハタマニシカ上ッタコトガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木看護婦ハ子持チナノデ、月ニ一二回子供ノ顔ヲ見ルタメニ子供ヲ預ケテアル親戚ノ家ニ泊リニ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ノイナイ夜ハドウスルカト云ウト、婆サンガ代リニ佐々木ノベッドニ寝ルコトニシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ寝室ニハ極メテ微カニ、手ニ痛ミヲ与エナイ程度ニ冷房ガ施シテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "税金ハ計理士ニ任セテアルガ、計理士トノ応対ハ彼女ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハ帝国ホテルノアーケードノ店ニアルノヲ見付ケテアルノヨ、ドウシテモコレニシヨウト思ッテ」「イクラダ」「三百萬圓」「何ダッテ」「三百萬圓」「冗談ジャナイ」「冗談ジャナイワヨ」「差当リソンナ金ハナイ」「知ッテルワヨアタシ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「経助ノコトナンゾ考エテヤルヨウナマヽジャナインダカラネ、学校ノ宿題ダッテアルバイトノ学生ニ任セッキリナンダカラ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "草履ハ銀ノ綴デ三段ノ高サノモノ、鼻緒ノ裏ダケニピンクガ使ッテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ニ手ヲ曳カレテ庭ヲ散歩シテイルト、囲イノ中ノ犬舎ニ入レテアル筈ノコリーガドウシタ間違イカ飛ビ出シテ来テ突然予ニ跳リカヽッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事ノ世話、入浴ノ世話、ブラッシングノ世話ナド手ガカヽルコト夥シイノデ、婆サンカラ女中達マデ不平ガ絶エナカッタガ、何ト云ッテモ浄吉ガ実行サセタコトハ当時ノ日記ニ記シテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸子ハ泣イテマシタガネ」「何ヲ泣クコトガアルンダ」「五子モ出テ来ルッテ云ッテマシタカラ固ク止メテアルンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ノコトハ何モ云ウナト云ッテアルノデ、颯子ハ知ラナイ筈ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「卯木督助殿」ト記シタ名札ガ掛ケテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日一日ダケコヽニ入院シタ形式ニシテアルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "床ノ活ケ花ガ変エテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
