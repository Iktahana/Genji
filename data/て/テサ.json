        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アラ磯ニ浪ノヨルヲ見テヨメル大海ノ磯モトドロニヨスル波ワレテクダケテサケテ散ルカモ　一言の説明も不要かと存じます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタクシ、オブッテサシアゲマス」云いながら、その菰包みに腕をかけて、ヤッとばかりに持ち上げようとしたんだけど、さてビクともしないじゃありませんか。",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "納税資格ガ選擧權ノ有無ヲ決スル各國ノ制度ハ議會ノ濫觴ガ皇家ノ徴税ニ對シテ其ノ費途ヲ監視セントシタル英國ニ發スト雖モ、日本國自身ノ原則トシテハ國民タル權利ノ上ニ立テサルヘカラス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "暹羅の南、交趾支那の北、これぞ王国柬埔寨の位置で、メコン河の下流、トッテサップ湖の砂洲に、首都プノンペン市は出来ていた。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "数多い「恋人」の一人でもっとも熱烈な彼女の讃美者ピエル・ドュ・モルテサックが、ひそかにマタ・アリに吹き込んだのだという。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "死刑場には、ピエル・ドュ・モルテサックはじめ彼女の騎士連が多勢詰めていた。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の精霊　サテサテマア、何と云うあったかな事だ、飛切りにアポロー殿が上機嫌だと見えるワ。",
              "citation": {
                "source": "葦笛（一幕）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二の精霊　その様な事をたのむとはサテサテ――ほんとうに御主にはこの精女殿が美くしすぎたのじゃ。",
              "citation": {
                "source": "葦笛（一幕）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして国王のムテサから使者が来て、スタンレーはその案内で、賓客としての正式の謁見を許されました。",
              "citation": {
                "source": "アフリカのスタンレー",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムテサは大勢力をもつてゐる王で、三千人の軍隊をひきゐ、とゝのつた法令でこの地方を治めてゐました。",
              "citation": {
                "source": "アフリカのスタンレー",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "スタンレーは、更に附近の探検を続け、ウガンダのムテサ王に頼んで多数の護衛兵をつけてもらひ、西方のアルバート・エドワード湖を探り、附近の山脈の模様をも調べました。",
              "citation": {
                "source": "アフリカのスタンレー",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "金星天を司る天使〔首天便〕テサロニケ前書四・一六等。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日、使ニ来リシ犬ハ、最モ愛スベキ忠犬ナレバ、ヨクイタハリ、カヘルトモ、留マルトモ、犬ノ意志ニ任セテサシツカヘナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "余計なところにグズグズと手間どってると、山キの血統が根絶やしになる」「ですが、コマ五郎は牢屋にいるじゃアありませんか」「ハテサテ、衰えたものだア！",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし夢も幻覚も意志によって見ることができないのだから、ハテサテ、人間の能力というものは窮屈なものだね。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その三　精神病診断書",
                "note": "青空文庫"
              }
            },
            {
              "text": "25　ウーリュンポスは神々の居として天と混同さるることあり、テサリアにある實際の山なれどもしか宣んすれば諸の神明默し靜まりぬ、威風するどき宣告を諸神等しく驚きぬ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "本腰にかゝるや、業を昼夜兼行に急いで、本多佐渡守の如き明け七ツに「御普請所御出候ツルママ諸大名衆不残提灯御タテサセ丁場々々ヘ御出被成候」といふ、盛観のことだつた。",
              "citation": {
                "source": "東京の風俗",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼をして『新約』の「テサロニケ前書」四章の三を読ましめよ、次の言葉に出あうだろう、「それ神のみ旨は、なんじらの清からんことにして、すなわち淫行をつつしみ、云々」そればかりではない。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は元来テサリアの首長であり、息子であるマカオンとポダレイリオスは有名な医師になり、トロイ戦争で戦った。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "）ヒポクラテスは紀元前460年に生まれ、アスクレピアドの名門に属し、広範囲な旅行をしてトラキア、テサリアなどギリシアの各地を訪れ、コス島に戻ってこの時代の最も有名な医師になり、紀元前約375年に死去したことになっている。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、ナカ／＼別レル気ナンカアルマイ、萬一彼女ニ疑ワシイ行為ガアッタトシテモ、見テ見ナイ振リヲスルカモ知レナイ、上手ニ振舞ッテサエクレヽバ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウデスカ、少シハイヽ方デスカ」「イヽドコロカ、マス／＼悪クナル一方ダ」「ダッテ、髯ナンカ剃ッテサッパリシテルジャアリマセンカ」予ハ実ノトコロ、手ガ痛ムノデ剃刀ヲ使ウノモ不自由ナンダガ、ソレヲ怺エテ今朝剃ッタバカリデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうしたのようトリステサ、ホホホホホホ駄目じゃないの、ホホホホホホあらまあ！",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリステサと戯れていると人には思わせつつ、その実妻は男を引っ張り込んでいたのだ。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔色を失って、「ト…リス…テサ……ト…リス…テサ！",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ト…リス…テサ！",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと大きく……」「トリステサ！",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼にはテサロスとドラコンの２人の息子および多数の弟子がいた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "トラレス（トルコ南西部）のテサロスはネロ時代の方法学派の１人で６ヶ月で医師を育成できると称していた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
