  {
    "uuid": "4211644a-23e9-5abc-87c2-cae363aef903",
    "entry": "テッテ",
    "reading": {
      "primary": "てって",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おう、勤する身のままならぬテッテチチンテッテチチンリンリン＝＝いつぞや主の居続に寝衣のままに引寄せて＝＝を聞かしねえ、後生だ。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレいく、テッテ的に打ちこんでやる、とワラが笑う。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "みなさんも、心してドンチャン騒ぎをくりひろげ、いまどきのガキなんか、メじゃないことを証明してください」　最前列から、テッテ的にやったろうじゃねえか、寮の屋根を吹き飛ばしてやる、どうせぶっ壊すんだろ、と声がかかり、また笑いにつつまれた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの私がよく行く京橋の家に三階から『テッテケテ』なんかってうたいながら、二階の私の居る部屋にいつでも降りて来る女が居るんですよ、二十位でネ、いい様子じゃあないけれ共、自分をいい様子に見たがって一寸椅子に腰かけるにもまっすぐにはかけない人なんです。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎はカゼがなおって遊びに来て、「アッコオバチャン、おぽんぽが痛くなくなったらアボチャン、トシマエンヘツレテッテヤルヨ」と大いに慰めてくれました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "リギ　Rigi　ルツァーンの湖は、ウリ Uri 、シュウィーツ Schwyz、ウンテルワルデン Unterwalden、ルツァーン Lucern の四つのカントンに囲まれているから、フィールワルト・シュテッテル・ゼー 〔Vierwaldsta:tter See〕 と呼ばれておる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕がきふに愉しさうに小包をほどき出してゐるのを、傍で野村君がうらやましさうな顏をして見てゐたので、折角のお心盡しの品ですが、その中から奮發してシュテッテルの鉛筆を一本分けてやりました。",
              "citation": {
                "source": "七つの手紙",
                "author": "或女友達に",
                "note": "青空文庫"
              }
            },
            {
              "text": "その、その、このことは今後の日本を平和的文化国家として、真に革命し、再建して行く――なんだ――つまり――テッテイ的にこれまでの映画界から戦犯を追放することは、われわれの手でなすべきである！",
              "citation": {
                "source": "猿の図",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "良心をごまかしていれば、永遠にテッテイ的にわれわれは腐敗します！",
              "citation": {
                "source": "猿の図",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "摘発はテッテイ的に冷静無慈悲なものでなければならぬ！",
              "citation": {
                "source": "猿の図",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オ前ガモ一度連レテッテクレルカ」「アタシガオ供スレバ見テ下サル？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャンノ癖ニ生意気ダワ」「コノクライハ許シテクレルンダト思ッタンダ」「ソンナコト絶対ニ許サナイワヨ、浄吉ニ云附ケテヤルカラ」「御免々々」「出テッテ頂戴！",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてステッテン(24)は重窒素で標識したコリンおよびエタノールアミンを使って実験を行った。",
              "citation": {
                "source": "生体構成物質の動的状態",
                "author": "THE DYNAMIC STATE OF BODY CONSTITUENTS (1942)",
                "note": "青空文庫"
              }
            },
            {
              "text": "コリンの重要な性質はメチル基にだけ存在し、ステッテン(24)が示したようにこの分子の他の部分はアミノエタノールまたはグリシンから作ることができるようであった。",
              "citation": {
                "source": "生体構成物質の動的状態",
                "author": "THE DYNAMIC STATE OF BODY CONSTITUENTS (1942)",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
