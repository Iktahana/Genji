    "definitions": [
      {
        "index": 1,
        "gloss": "handcuffs",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "容疑者は警察官によって手錠をかけられ、静かにパトカーへと連行された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "映画の脱獄シーンで、主人公が針金一本で手錠を外す場面には驚かされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冷たい手錠の感触が肌に伝わり、彼は自分の犯した過ちの重さを実感した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし奉行所の方でも大事を取って、一応念のために京都へ問いあわせたのですが、日野家では一切知らぬという返事であったので、結局お琴は重追放、善兵衛は手錠を申し渡されて、この一件は落着しました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "編笠を脱がせられて、手錠をとかれて、看守の指図通り、極めて従順なる被告人は、書記席の下の桝の中へ、目白押しに二列になつて押しこめられた。",
              "citation": {
                "source": "公判",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "其後法廷に於て天日の下に手錠をとかれて、兎に角にも文明の形式を以て事実の真相を語ることの自由を与へられたとき、少しく冷静になつて追懐して見れば、余りに意気地のなかつた、余りに恐怖に過ぎた、余りに無人格的であつたことに気がつく。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "手錠、腰縄、審問場、捜査官。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "新に手錠をさへ嵌められた。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "やけに手錠を外して了はうとして、両足をかけてぐつと押した。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなことで手錠が外れさうのことはない。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "押した力で手錠の鉄が彼の肉や骨に喰入るやうに痛むのであつた。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "手錠を箝められ、腰縄がつけられた。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は手錠の儘の手でかゞんで、編笠をとつた。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "手錠を掛けられて、警察へ連れられて行くのであろう、しょんぼりうなだれて、顔が半分かくれていたが、しかし、その美しく整った顔には、見覚えがあった。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪子の白い手には手錠が痛々しく掛けられている。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "豹吉はその手からじっと眼をはなさず、「まず、あの手錠を切ることやな！",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――しかし、あの手錠を切ることは、袂を切るよりは、ちょっとむつかしいぞ！",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「恨ましやすんな、諦めなされ、　日の眼拜まぬ牢屋の中で、　　手錠、足械悲しいけれど、　長い命ぢやもうあるまいに　何うせ自暴だよ……」　皺嗄れた殆ど聴取れない程の聲で、恁う唄ふのが何處ともなく聽えた。",
              "citation": {
                "source": "虚弱",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてあの少女が白い服のまま手錠をはめられて、警官に突き飛ばされている姿をマザマザと眼の前に幻視しながら、彼はもう少しで……「貴方がたは人違いをしてるのじゃないですか」……と口走るところであったが、しかし、その言葉は、すぐに咽喉の奥へ嚥み込まれてしまった。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、一夜、転輾、わが胸の奥底ふかく秘め置きし、かの、それでもやっと一つ残し得たかなしい自矜、若きいのち破るとも孤城、まもり抜きますとバイロン卿に誓った掟、苦しき手錠、重い鉄鎖、いま豁然一笑、投げ捨てた。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二回の裁判には編笠に手錠を篏められた儘他の犯罪人と一緒にぞろぞろ曳かれて出なければなりませんでした。",
              "citation": {
                "source": "わが敬愛する人々に",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "衷心から気心の優しそうな名前の人間が、最後に手錠をかけられるような事を書くと、前にも述べたような理由で読者は何となく欺むかれたような不満を感ずる虞があるのだからそのヤヤコシイ事一通りでない。",
              "citation": {
                "source": "創作人物の名前について",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "題は「十銭芸者」――書きながら、ふとこの小説もまた「風俗壊乱」の理由で闇に葬られるかも知れないと思ったが、手錠をはめられた江戸時代の戯作者のことを思えば、いっそ天邪鬼な快感があった。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから検察官、手錠が入りますよ。",
              "citation": {
                "source": "暗号舞踏人の謎",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、――思う中に、ホームズはピストルをその男の頭に狙いつけ、マーティンは素早く、手錠をはめてしまった。",
              "citation": {
                "source": "暗号舞踏人の謎",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「彼の女は死んだ夫の側に、ひどく怪我をしているのを発見されたのだ」　彼は深い呻吟声を上げながら、腕椅子に崩れるように腰かけて、手錠のかかった両手で顔を蔽うた。",
              "citation": {
                "source": "暗号舞踏人の謎",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "手錠も必要です、警部。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思ううちに、ホームズが拳銃を男の頭に狙いつけ、マーティンが素早く手錠をはめた。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　男は深いうめき声を上げながら、長椅子にへたり込み、手錠のかかった両手で顔を覆った。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そして手錠のはまるカチャリという音。",
              "citation": {
                "source": "瀕死の探偵",
                "author": "THE ADVENTURE OF THE DYING DETECTIVE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、引き出しの中から鋼の手錠を取り出す。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "かねてじょうぶであった娘の健康が、嫁にいってしばらくすると、目につくように衰えだした時に、彼らはもう相応に胸を傷めた。",
              "citation": {
                "source": "手紙",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "千世子は病気の時いつもする様にきれいな様子をして居たけれ共先よりは重いと見えてじょうだん口もきかずにぶい目で天井の木目を見て居たり人の立ち働くのを見たりして居るのが多かった。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "confinement in chains (Edo-era judicial corporal punishment)",
