  {
    "uuid": "82c617fa-db58-5d0b-bb67-ce87b253df5d",
    "entry": "手鎖",
    "reading": {
      "primary": "てじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
