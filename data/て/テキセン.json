[
  {
    "uuid": "8d6e909a-68da-5aaa-8291-8b7d1e1e0594",
    "entry": "敵船",
    "reading": {
      "primary": "てきせん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "enemy ship",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "水平線の向こうに敵船の影を確認し、艦内に警戒警報が響き渡った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "嵐の中で敵船を見失ってしまい、我々は周囲の警戒を強めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "敵船からの激しい砲撃を受け、我々の船体は大きく傾いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "敵船右より襲へば右舷の速射砲之を追ひ、賊船左より來れば左舷の機關砲之を撃つ。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖国ギリシャの敗戦のとき、シラクサの城壁に迫るローマの大艦隊を、錨で釣り上げ投げつける起重機や、敵船体を焼きつける鏡の発明に夢中になったアルキメデスの姿を梶はその青年｜栖方の姿に似せて空想した。",
              "citation": {
                "source": "微笑",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "君をめぐりて戰鬪の環は火の如く燃え立てり、　735敵の壘壁、越せる後わが勇猛のトロイア勢、あるひは武具を携へて休み、あるひは敵船のほとり、多數を敵として寡勢ながらに戰へり。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「敵船団三千隻見ユ。",
              "citation": {
                "source": "桜島",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「敵船団の電報です」　当直士官の眠たげな顔に、一瞬緊張の色が走った。",
              "citation": {
                "source": "桜島",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サキノ敵船団ハ夜光虫ノ誤リナリ。",
              "citation": {
                "source": "桜島",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "遂にポルトガル人襲撃が行われ、艦隊は二三の敵船を撃沈しただけで引き上げた。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時敵船三十余艘を捕獲したらしい。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "オランダがスペインからの独立のために戦っていたこと、海上で敵船の捕獲や掠奪をやっていたことは、いずれも事実である。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "――九鬼右馬允は九艘の大船に、無数の小舟を相添へ、山のごとく飾りたて、敵船まぢかく寄せつけ、やにはに大鉄砲をいちどに放ち懸る。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "物見の舟を放って、とつこうつ敵船をさぐっているうちに夜があけた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "近々と寄せては、敵船へ松明を投げこみ、退いては、大鉄砲をうちこむのだった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "韓当、周泰のふたりが、「仰せ、承りました」　と、すぐ江岸から十数艘の牛革船を解き放ち、左右から鼓を鳴らして敵船へ迫って行った。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "火の鳥の如く水を翔けて、敵船の巨体へ喰いついた小艇は、どうしても、離れなかった。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "後で分ったことであるが、それらの小艇の舳には、槍のような釘が植えならべてあり、敵船の横腹へ深く突きこんだと見ると、呉兵はすぐ木の葉のような小舟を降ろして逃げ散ったのであった。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして小舟のへさきが、敵船の横へ勢いよくぶつかった瞬間に、「おおうッ。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
