        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは、マレク・アデルがマティルダを奪い去るところだったが、――ちょうどその途端に、まだらな大きなキツツキが現われて、ほっそりした白樺の幹をせかせかと登り始めたので、すっかりそのほうに気を取られてしまった。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "当社はマティルダ・ブリッグス案件でのご活躍を記憶するものにて。",
              "citation": {
                "source": "サセックスの吸血鬼",
                "author": "THE ADVENTURE OF THE SUSSEX VAMPIRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "敬具モリソン＝モリソン＆ドッド　ＥＪＣ拝「マティルダ・ブリッグスとは妙齢の女の名ではないよ、ワトソン。",
              "citation": {
                "source": "サセックスの吸血鬼",
                "author": "THE ADVENTURE OF THE SUSSEX VAMPIRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しはずれて、パニオロの奥さん、マティルダが、巨体を椅子に預け、音楽に聴き入っていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "テラスに入って来た僕を見て、マティルダは足もとのアイスボックスを示した。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親のマティルダに似たポリネシア美人だ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マティルダが全員にビールを配った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとにあなたは、そんな音を聞いたの」　マティルダが僕とラインハートの前まで来て訊いた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　あの音から想像出来るイメージを、僕はマティルダに語った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥さんのマティルダに頼まれたのだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マティルダが部屋に入って来た。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＬＰの録音のために自分の家に人の出入りが急に増えたから、マティルダはうれしくてたまらない。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マティルダは、「おいで」　と、ジェニファーを招き寄せた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "グレンがマティルダの耳に口を近づけて言った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マティルダ、きみの口紅とタヒチで買ったフランス製のパンツを貸してくれ」　パニオロの言葉に全員が笑った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "量も種類もある朝食をマティルダは作りたがったのだが、朝食はそれだけで簡単にすませた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄い扉を突き抜けてはっきり聞こえてきたのは、中でメリッサが一心不乱に掃除中らしく大騒ぎしており、ティルダがよっこらしょとベルの所へ行かざるを得なかった。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "ティルダは顔にイライラの表情を浮かべ、面白くもない用件を聞いた。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "スリム氏の問い合わせに対し、人見知りのティルダが答え、ウェイクフィールドさまはご在宅で、こちらの方へ来て下さいと言うことなので、直ちに魅惑的な声に従い、隠れ部屋へ案内された。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "スリム氏の名前をテキパキ聞いて、用件を承り、魔女ティルダが消え、どうやら階段の踊り場で、何かの詩を大声で歌っているようだ。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "後者の会話は聞き取れないが、魔女ティルダの声はスリム氏にはっきりと聞こえ、こんな風に歌っている。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウェイクフィールドさま、あーあー、お客様が、あーあー、男の方が、あーあー、とても背の高い方が、あー、紳士ではありません、あーあー、かしこまりました」　それからティルダが現れて、ウェイクフィールド叔母がすぐ降りてくると告げた。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
