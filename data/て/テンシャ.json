  {
    "uuid": "4b3aeff1-6be4-5c81-bad4-135d1a3db4f4",
    "entry": "転者",
    "reading": {
      "primary": "てんしゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
