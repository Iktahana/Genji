        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二限わがなさん、　　公　五時を補ひてんや、火をあらぬひのきづくりは、　　神祝にどよもすべけれ。",
              "citation": {
                "source": "文語詩稿　五十篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "言や言うもんの、お前、もう足掛け六年やで」「いま帰ったとこや」　他吉はちょっと固垂をのみ、「――ところで、皆どこイ行きよってんやろ。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんまにどこイ行きよってんやろなア。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "お八ツ時分になると、甘党の松島は卓上電話で紅谷から生菓子を取り寄せ、玉露を煎れて呑んでいたが、晩餐には姐さんのためにてんやものの料理が決まって二三品食卓に並び、楽しい食事が始まるのだったが、彼自身は口がきわめて質素で、ひじきや煮豆で済ますのであった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "はた如何にして病の牀のつれづれを慰めてんや。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "一夜我が仮住居をおとづれて共に虫の音を愛づるついでに、我も発句といふものを詠まんとはすれどたよるべきすぢもなし、君わがために心得となるべきくだりくだりを書きてんやとせつに請ふ。",
              "citation": {
                "source": "俳諧大要",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏のことですから、その佐竹さまの塀の下に、ところ天の荷がおりていて、みがきぬいた真鍮のたがをはめた小桶をそばに、九つか十ばかりの小僧がひとり、ぼんやりしゃがんで、「ところてんや、てんやア……」　と、睡そうな声で呼んでいる。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんな、阿房な事あるもんか、　でも、わしに来い云うてんやが、実際困って仕舞うなあ。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の前を通る人たちも、まだたいていは、しるしばんてんや、青い職工服をきて、べんとう箱のつつみをぶらさげた人たちです。",
              "citation": {
                "source": "水菓子屋の要吉",
                "author": "木内高音",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな処へ来ても、人ぎらいをしない祖母は、てんやから食物をとって、みんなで会食した。",
              "citation": {
                "source": "旧聞日本橋",
                "author": "蕎麦屋の利久",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもお酒は大好きで、たべものはてんやものばかりとっていた。",
              "citation": {
                "source": "大門通り界隈一束",
                "author": "続旧聞日本橋・その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑多の者が集まっててんやわんやの生活様式を作り出してる不思議な町である。",
              "citation": {
                "source": "七重文化の都市",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて更めていへるやう、「知らぬ疇昔は是非もなけれど、かくわが親に仇敵あること、承はりて知る上は、黙して過すは本意ならず、それにつき、爰に一件の願ひあり、聞入れてたびてんや」「願ひとは何事ぞ、聞し上にて許しもせん」「そは余の事にも候はず、某に暇を賜はれかし。",
              "citation": {
                "source": "こがね丸",
                "author": "巌谷小波",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名な羽衣せんべいも、加賀屋横町にあったので、この辺はゴッタ返しのてんやわんやの騒でした。",
              "citation": {
                "source": "江戸か東京か",
                "author": "淡島寒月",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからのことは、風聞やら、揉消し運動やら、てんやわんやでいちいち書いてはおられぬ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じゃ先生、おいらは先に関ヶ原へ行ってるよ」　かくて、てんやわんやの野上駅の騒ぎをあとにして、米友一人はまた馬に跨って、関ヶ原へ向けて出発しました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方、土間の方では相変らず、てんやわんやで、鬼を、鬼を――とさわぎひしめいている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうでなければてんやわんやだよ。",
              "citation": {
                "source": "対話",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時まだ小学生であった安雄も、餅搗きには印ばんてんや「あつし」を着て配達の手伝いをしました。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "砲のまわりで世話をやくのに忙がしい将校があるかと思えば、馬を飛ばして協会の柵のほとりの広場へ集合して、宿舎係の説明に聴き耳を立てている将校もあるという、てんやわんやの真最中に、教会のかげから、馬にまたがった平服の男が一人姿を現わしたが、その乗っている馬がまた一風変った代物だった。",
              "citation": {
                "source": "接吻",
                "author": "ПОЦЕЛУЙ",
                "note": "青空文庫"
              }
            },
            {
              "text": "てんやわんや」「サブちゃん、凄いのよ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "よう、勝てんやないか。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "曰く、犂牛の子、※くして且つ角よくば、用うること勿からんと欲すといえども、山川其れ諸を舎てんやと。",
              "citation": {
                "source": "論語物語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "食物は時折電話でてんや物を取寄せ、掃除は月に一、二度派出婦を呼んでさせるので、台処の流しや戸棚の中は家族の多い貧乏世帯よりはかえって奇麗になっている。",
              "citation": {
                "source": "ひかげの花",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "自信のある娘っ子どもがみな顔に鍋墨を塗って田舎へ逃げだすという、てんやわんや騒ぎのなかに、フロックなんか着こんですっとぼけているというんだから、気でもちがったかと思うのも無理はない。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "足を踏んだ、踏まぬという埓もない酔漢同士のつかみあいだったが、このてんやわんやの騒ぎの最中に、どこからともなく、こんな呼び声がきこえてきた。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "御代参の乗物",
                "note": "青空文庫"
              }
            },
            {
              "text": "てんやわんやのうち、空しく日が経って十六日。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "萩寺の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「爾ノ知ラザル所ハ、人ソレ諸ヲ舎テンヤ」である。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこいら中がトタンだらけになっちゃって、何がどうして、どうなったんだかテンヤワンヤわからない状態に陥ってしまった。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親の云う事はテンヤワンヤのゴチャゴチャだらけであるが、それでも吾輩の笑い顔だけはハッキリと記憶に残して死んでいるらしいのだから頗る気味が悪い。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
