        "examples": {
          "standard": [
            {
              "text": "注文した商品が、ようやく手元に届いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "報告書が手元に届き次第、すぐに確認します。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼からの手紙が手元に届き、懐かしい気持ちになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "私は先刻辞職願を投函いたしましたから、遅くも明朝までにはお手元に届くことだろうと思いますが、いささか考える次第がありますから保留して頂きます」　局長は引き取って、「よく判った。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は丸善に連絡をとっておいて、手元に届くたびに土曜会の連中に紹介した。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "其で、この何時お手元に届くか今のところ未だ見当のつかない手紙をこのようにポツポツと書きためることを思いついたのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
