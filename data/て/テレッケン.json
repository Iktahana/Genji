          "literary": [
            {
              "text": "アーンテレッケンと申す言葉がござる。",
              "citation": {
                "source": "蘭学事始",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレッケンとは、引くという意でござる。",
              "citation": {
                "source": "蘭学事始",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーンテレッケンとは、向うのものを手元へ引きたいと思う意でござる。",
              "citation": {
                "source": "蘭学事始",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "故郷をアーンテレッケンするとは、故郷を手元へ引き寄せたいほど、懐しむという意でござる。",
              "citation": {
                "source": "蘭学事始",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
