        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "早朝、門ニ立チテオ待チ申シテイマス。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼女はテイマの意味もよく解らないながらに、筋だけでも興味は尽きず、ある時は寝床のなかに縮こまりながら、障子が白々するのも気づかずに読み耽り、四五日で読んでしまった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "筋やテイマを話しながら、彼女は草稿を見せた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "野原ハ、毎日ノヨウニツメタイ風ガ吹イテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年ノ多クハ小サクサカシクオサマッテイルモノカ、ツマラナク時ヲ無為ニ送ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "山ハ絵ノ具ヲドッシリ付ケテ、山ガ地上カラ空ヘモレアガッテイルヨウニカイテミタイモノダト思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "色ヲツケテミタラヨカロウト考エテイマスガ、時間ト金ガナイノデ、コンナモノデ腹イセヲシテイルノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ忙シイあなたニコンナ無遠リョヲカケテタイヘンスマナク思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『竹林高士』といつた古淡無慾な主人公を、竹林の下に静坐させるといつた、東洋的雰囲気は、一見無感情にみえながら、東洋独特の悲劇的なテイマなのである。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクタチ兄ダイハ、ナカヨク、タッシャニ、コノシマニ、クラシテイマス。",
              "citation": {
                "source": "瓶詰地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日八時、石切山ノ下デマッテイマス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツヅイテ刺スヨウナ痛ミヲオボエマシタノデハット思ッテ目ヲ開クト要之助ガ悪鬼ノヨウナ相ヲシテ白イ光ルモノヲモッテ私ニ馬乗リニナッテイマス。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンノ、タヨリアリマスカ、ナニゴトモ、トキノクルマデ、ノンキニシテイナサイ、ワタシモ、コトシハ、アクネンユエ、タダジットシテイマス。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンノ、タヨリアリマスカ、ナニゴトモ、トキノクルマデ、ノンキニシテイナサイ、ワタシモ、コトシワ、アクネンユエ、ジツトシテイマス。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケイサツニツゲタリ、コノハナカゴヲウゴカスト、スグバクハツサセマス、ワタクシタチノブカガ、イツモチャントミテイマス。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "再ビ生キテ皆サマニオ目ニカカレナイコトト覚悟ヲシテイマス。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "中里介山さんや白柳秀湖さん、それから時々テイマ小説のような、そういう作をする土師清二さんも、その一人として数えられましょう」問「だが併し他の作家も、思想は織り込んでいるのですが、旨く人情でボカしているので、目立たないのではないでしょうか？",
              "citation": {
                "source": "大衆文芸問答",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌｜朝六時に船は港口に入り、暹羅の戴冠式に列せられる伏見｜若宮殿下の一行を載せて伊吹、淀の二艦と広東から来た警備艦宇治の碇泊して居る間を過ぎ、維新｜前｜馬関砲撃に参加した英艦テイマア号が武装を解いて白く塗られ記念品として繋留してあるのを左弦に見つつ港内の中央に碇着した。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても純然たる竊盗かも知れないが――くだらないテイマでね、うっかり書いてしまうものなら子供じみたモラル風の味の外はでそうにもない、それともそんな味さえ消えてなくなるかも知れない。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サキニプールヘ行ッテイマス七月十日午後三時　この筆跡は乱暴で大きくて、不そろいで、秋夫の手であった。",
              "citation": {
                "source": "アンゴウ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "足ヲビルニ喰ワレテ立ッテイマス。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――家ガ仲ノ町デ、引手茶屋ヲシテイマシタカラ……　――ソレガ、ドウシテ、後ニ、赤坂ダノ、葭町ダノヽ住人ニナリマシタカ？",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キットソウニ違イナイヨ、アタシニハチャント分ッテイマス」「アハハハハ、ソンナラ颯子ニ聴イテ御覧ナサイ」「笑ウ人ガアリマスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士ガ君ハ今何シテイルカト問ウノデ、コレ／＼云ウオ邸デ御病人ノ看護ヲシテイマスト答エタラ、ソンナコトカラ旦那様ノ手ノオ痛ミノコトガ話ニ出タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏子ガ門ノ前ニ立ッテイテ、庭カラスグニ離レ座敷ヘ案内シ、「デハ私ハ留守番ニ行ッテイマス」ト云ッテ出テ行ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥サンハ先生ニ対シテイマダニ貞節ヲ保ッテオイデデスト、アノ人ガ云ウノヨ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御注文ノ広東犬ハコノ間カラ捜シテイマスガナカナカ見ツカラナイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジ支那デモ上海ト広東トハマルデ国ガ違ウヨウニ離レテイマス、目下当地デハ「グレイハウンド」ガ流行デス、ソレデヨケレバ持ッテ行キマス、ドウイウ犬カ君ハ多分知ッテイルデショウガ、参考ノタメ「グレイハウンド」ノ写真ヲ此処ニ入レテ置キマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハツクヅク、斯波君モ我ガ儘ダガアナタモ我ガ儘ダ、今日ノ事ハ二人ノ我ガ儘ガ当然招イタ報イダト云ウ感ヲ深クシテイマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
