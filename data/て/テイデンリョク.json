        "examples": {
          "standard": [
            {
              "text": "IoTデバイスの多くは、バッテリーで長時間動作するため低電力設計が重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このセンサーは低電力で動作するため、太陽光発電で賄える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "低電力モードに切り替えることで、スマートフォンの使用時間を延ばせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "インテルはノートブック型にターゲットを置いた高集積度、低電力消費の３８６ＳＬの発表を、今回の社長の来日にタイミングを合わせて行なった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして実際に３８６上に競争が生まれ、低電力消費といった新しい特長を備えたチップが登場してくると、ゾンビ化したＰＣの姿形に関する妄想がふつふつと沸いてくる。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
