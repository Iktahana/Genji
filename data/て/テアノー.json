          "literary": [
            {
              "text": "220そはイフィダマス其父はアンテーノール――勇にして魁偉なるもの、育ちしは羊に富めるトレーケー、幼き時に母方の祖父＊キッセイス――紅頬の佳人テアノーうめる祖父其屋に彼を養へり。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "223　V 70, VI 298 以下、テアノーはアンテーノールの妻、アテーネー殿堂の祭司。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "226　テアノーの妹即ち叔母に當るもの、叔母と婚せるヂオメーデース V 412 參照。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
