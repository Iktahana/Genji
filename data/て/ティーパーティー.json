        "examples": {
          "standard": [
            {
              "text": "娘の5歳の誕生日にぬいぐるみを並べてティーパーティーを開いてやった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "近所の子どもたちを集めてガーデンでティーパーティーを開くのが夏の恒例行事になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "絵本の主人公がうさぎたちとティーパーティーを楽しむ場面に娘は目を輝かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "十一月三日（金曜）晴　元の天長節、ツーさんが三四日前に帰京して居るので、およろこびのティーパーティーをかね林町へ行き、会う。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが芸術のことは後にして、会食やティーパーティーやダンスパーティーは、明らかに社交的娯楽の意味を有っている。",
              "citation": {
                "source": "娯楽論",
                "author": "――民衆と娯楽・その積極性と社会性・――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
