        "examples": {
          "standard": [
            {
              "text": "パーティーの準備は完璧で、参加者への細やかな配慮まで手が回っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "イベントの成功には、細かい部分にまで手が回る周到な準備が不可欠だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "式の前日に会場の隅々まで手が回るよう、スタッフ総出で最終確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "このぶんなら、あっちのほうの玉にも手が回るぜ」「回りゃ――」「そうよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「じれってえな、今やつらが、あっちのほうの玉にも手が回るぜといったじゃねえか。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            }
          ]
        }
