          "literary": [
            {
              "text": "」「‥‥」かの女は、渠をふり棄てるやうにして、反對の側に足を運ばせたので、渠は椅子に腰かけて、圓テブルの上のマチを取りあげた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンフォルテブル・エンド・コンヴェニエント・シンプル・ライフ！",
              "citation": {
                "source": "獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンステブル発行で、コンステブル式に高価だが、それでも私の貧弱な「山の図書」が一冊増したと思えばうれしい。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベヂテブル・ディッシュを食べる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリルでポタアジュとシャリアピンとベヂテブル・ディナー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
