        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "トリツク怒濤、実ハ楽シキ小波、スベテ、コレ、ワガ命、シバラクモ生キ伸ビテミタイ下心ノ所為、東京ノオリンピック見テカラ死ニタイ、読者ソウカト軽クウナズキ、深キトガメダテ、シテハナラヌゾ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカあなたニ絵ヲ見テモライマシテカラ故郷デ貧乏漁夫デアル私ハ、毎日忙シイ仕事ト激シイ労働ニ追ワレテイルノデ、ツイコトシマデ絵ヲカイテミタカッタノデスガ、ツイカケナカッタノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　トキ　ムカウノ　ムギバタケカラ　コトシニ　ナツテカラ　ハジメテノ　ヒバリガ　ソラニ　マヒアガリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ヨルニ　ナツテカラ　ネシヅマツタ　ヒトツノ　ムラニ　ツキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ　イロイロ　カンガヘテカラ、マタ　マエノ　ラツパト　オナジ　ラツパヲ　オクツテ、「コノ　ラツパヲ　ミミニ　ツケルト　ワタシノ　コヱガ　キコエマス。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ、アノ新聞記事ヲ見マシテカラ、ヤット昨晩、家ニ帰ッテ見マシタラ、祖母ハ蚊帳ノ釣手ニ、妻ノ赤イ細帯ヲカケテ、首ヲククッテ死ンデオリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　私ガ道子ヲ殺ス気ニナッタノハ、今マデ私ニ親切デアッタノニ心変リヲシテカラ全ク私ニ冷淡ニナリ、友田ヲ愛スルヨウニナッタカラデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテカラ二人ノ様子ガオカシイト感ジテ居リマシタカラ、其ノ時何トナク気ニナリマシタノデ暫ク経テカラ私モ便所ニ行ッテクルカラト申シテ室外ニ出マシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長良川博士ノ意見ヲ聞イテカラニセヨ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテオ前ハ俺ノ行動ニツイテ、昼間飛行島デ別レテカラ後ノコトハ、スベテミナ忘レルノダ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「金のウシの錦の手綱おらも曳きたい、ハアカラメテカラメテ、シッカリカラメテ、掘った手綱はうっかり放すな」というのや、また本話の小松長者の黄金のウシを曳くときに歌わせたのは、「金のウシこに錦の手綱、おらも曳きたい曳かせたい」といったと言います。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田、石原、富永、平川、魚住、村瀬、奥屋、鬼頭ナドハ、何レモ特別ニ眼ヲカケタト云フ訳デモナイノニ、士官学校又ハ兵学校ニ入学シテカラモズツト遊ビニ来ルシ、古イトコロデハ退職後マデ機嫌ハドウカトタヅネニ来テクレル有様ダ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラブラドンドン　トユラレテカラダヂウガイタミマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "内地ニ帰ッテカラモ親兄弟ハ勿論ドンナ親シイ人ニモ話サヌコトヲ誓イマス。",
              "citation": {
                "source": "恐怖の幻兵団員",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山崎長之輔ノ一座ニ属シ中洲ノ真砂座ニ出テイタガ、ヤヽ老イテカラハ六代目ノ面差ニ似テイタ先代嵐芳三郎ノ相手役トシテ宮戸座ニ出テイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ七十七歳ノ今日ニナリ、既ニ左様ナ能力ヲ喪失シタ状態ニナッテカラ、男装ノ麗人ナラヌ女装ノ美少年ニ魅力ヲ感ジ出シタノハナゼカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ若サデソンナ意気地ノナイコトデドウスル」「陸子ハ嫁ニ行ッテカラ今マデ一度モコンナ話ヲ持ッテ来タコトハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜寝ル時ニ義歯ヲ外シテカラ鏡デ見ルト実ニ不思議ナ顔ヲシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガトウダンスノ胼胝ノオ蔭デスッカリ穢クナッチャッタンデ、トウヲ止メテカラ一生懸命モトノヨウニシヨウト思ッテ、毎日々々軽石ダノ鑢ダノイロンナモノデ擦ッタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "負ケズ嫌イナノデ、家ヘ来テカラ勉強シテフランス語ヤ英語モ片言グライハシャベレルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ知ッタノハ数エ年七十七歳デ喜寿ヲ祝ッテカラデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハソレ以前カラモ時々自分ダケ茶ノ間デ寝テイタガ、ベッドニシテカラハ完全ニ別レ／＼ニ寝ルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハソレヨリモ、春久ト颯子トガドンナ工合ニ接触スルカ、ソノ様子ガ見タカッタノデアルガ、団欒ノ中ニ加ワッテカラ三四十分モシタ時分、次第ニ脚カラ腰ノ周リガ冷エテ来ルノニ心ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ガヒドク心配スルノデ、又三十分ホド粘ッテカラ漸ク立チ上ッテ部屋ニ帰ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ソウ云ッテカラ、浴ビセテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――イヤ、コレハオ邪魔ヲイタシマシタ、コレカラ伯母サンニ御挨拶ヲシテ怱々退散イタシマス」「暑イノニ大変ダネ、ユックリ休ンデ行キナサイ」「有難ウ存ジマス、ナカ／＼ソウシテモオラレマセンデ」春久ガ出テ行ッテカラ暫クスルト、オ静ガ二人分ノ茶ト菓子ヲ盆ニ載セテ持ッテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ始メテカラ一カ月ニモナラナインダカラ、今止メルノハ惜シイヨ」「ソレジャ、今年ハイラッシャラナイオ積リ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "服ガ籠ニ捨テヽアル以上、彼ハシャワーヲ浴ビテカラ浴衣ニ着カエテイルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
