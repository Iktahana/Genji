        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイヘン突拍子モナイコトヲ言イ出シタヨウニ思ワレルカモシレナイガ、少シ落着イテ考エテミルナラ、別ニ奇抜ナコトデモ何デモナイコトガワカル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、コツチノ気持ハ第二トシテ、軍人ダケガ、ナゼ当節サウイフ感情ヲ尊重シテヰルカニツイテ考ヘテミルト、「モンテェニュ」デハナイガ、世ノ中ニ軍職グラヰ愉快ナ職ハナイノカモ知レヌ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　シバラクシテ　モウ　ウマク　ヤケタラウト　オモツテ　オマンヂウヲ　オイタトコロヘ　カヘツテキテミルト　オマンヂウハ　一ツモ　アリマセン。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタ　メガサメテミルト、オホソウヂハ　モウドコヘイツタカ　カゲモカタチモアリマセンデシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "与惣兵衛は腹をたてて、「ケッコンスルナ　フラチ　カンドウ」　と打ってやると、シヨウチシタ　サガシテミルという電報がきた。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "往年ノ軽微ナ脳溢血ノ痕跡ガマダ残ッテイ、脳中枢ニ僅カナ変化ガアルノデ、ソレガ脚ニ影響シテイルノダトモ云イ、又レントゲンデ検ベテミルト頸椎ト腰椎トガ曲ッテイルカラデアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ外ニ書クコトモナイカラ、コンナ時ニ少シ心ニアルコトヲ記シテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………試シニ頸ノコルセットヲ篏メテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ静ガ部屋ヲ出テ行コウトスル時、「今日ハ春久ハ来テイナイノカネ」ト、何気ナク聞イテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チョット失礼イタシマス」ト、予ハ寝台ヲ下リテ浴室ノ戸ノ前ニ行キ、把手ヲ廻シテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "念ノタメ予ハ手洗イニ行ク振リヲシテ便所ニ入リ、便所カラ外ノ廊下ニ出、廊下カラ浴室ノ戸ヲ開ケテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯殿ノガラス戸ヲ開ケテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何度モ何度モ聞キ直シテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ試ミニ息ヲ吸ッタリ吐イタリシテミルト、ヤッパリ間違イナクピイピイト鳴ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "面白クナッテ何度モ試シテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ヲ買イ物シテイタノカト、彼女ノ出テ来タ商店ノ前ヲ通リカカリニ覗イテミル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "覗イテミルト妻ガ洋服ヲ着セテ貰ッテイルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
