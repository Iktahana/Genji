        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "故ニ第十三潜水戦隊ハハワイト、パナマ運河トヲ結ブ海面附近ニ出動シ、途中ニオイテコレヲ撃滅スベシ。",
              "citation": {
                "source": "太平洋雷撃戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この祇園の算額につき『増修日本数学史』には東海坊なる人の奉納なるごとくいい、元禄四年……東海坊、山本宗信ノ奉額題ヲ解シテコレヲ京ノ祇園神社ニ掲グ……東海坊、其姓名ヲ知ラズ、蓋シ逸号ナラム……と見えているが、これは誤りであって、明らかに署名されている通りに長谷川鄰完の奉額である。",
              "citation": {
                "source": "芸術と数学及び科学",
                "author": "三上義夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "好事家ハ宜シク斎藤昌三氏ノ『現代日本文学大年表』ニ就イテコレヲ正シ給エトイウ。",
              "citation": {
                "source": "正宗谷崎両氏の批評に答う",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "独寒駅ノ泊リ壁ヲ隔テテコレヲ聞ケバ大ニ趣ヲ成ス。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "今水ヲ隔テテコレヲ聴ク。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "亭中ニ棋｜一中ノ装ヲ傾ケ匍匐シテコレヲ救ヒソノ家ヲ処分ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐藤一斎の記に、「黝堊ヲ舎テ、ニ倚ツテコレヲ径ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "子寿｜欣然トシテコレヲ受ケ改メズンバ措カザルナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "乃上人ノ詩ノ尤モ傑スル者百有余篇ヲ採リ、マサニ併セテコレヲ梓セントス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "君泣イテコレヲ拝シ、伊勢ニ赴キ敬所猪飼氏ニ従ツテ学ブ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "元微之ハ玉磬ノ声声ニシテ徹シ金鈴ノ箇箇円ナルヲ以テ二ナガラ聯ネテコレヲ称ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "予乃チ抄シテコレヲ梓ニ付シ題シテ『聖武記採要』トイヒ以テ世ニ問フ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "辺疆ノ責ニ任ズル者能クコノ篇ヲ熟読シ以テ斟酌シテコレヲ用レバ則チソノ実用アルイハ孫呉ニ倍セン。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽ今ノ兵ヲ説ク者コノ篇ノ晩出ヲ以テコレヲ軽ンズルコトナクンバ則可ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "因テ二、三ノ従游スルモノト相謀リ諸家ノ麗藻ヲ選ンデ梓シテコレヲ伝ヘントシタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余｜展ベテコレヲ観ルニ一集ノ中、各体具備シ光彩｜爛然トシテ殆遺珠ナシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "星巌の忌日を或書には九月四日となしているが、鈴木松塘の『房山楼詩稿』に「横山舒公ノ信ニ接シ星巌先生九月二日ヲ以テ館舎ヲ捐ツト聞キ位ヲ設ケテコレヲ哭ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "爾後十数日ノ間相続イテコレヲ得ル者マタ一百余首。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "今出シテコレヲ閲スレバ頗遼豕ナルヲ覚ユ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "今渡辺生ニ托シテコレヲ還ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余ニ詩ヲ賦シテコレヲ贈ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "乃命シテコレヲ延ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽チ声ノ中空ヨリ落ルモノアルヲ聞キ、窓ヲ推シテコレヲ視ルニ、天｜陰リ月黒ク、鴻雁※喨トシテ乍チ遠ク乍チ近シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶長中｜伊達政宗攻メテコレヲ抜ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余｜微恙アリ藤森少参事ヲシテ代ツテコレヲ収メシム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "因ツテコレヲ借覧シ私淑スル所アリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "儀衛兵ヲ賜ハリテコレヲ送ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ニ国ニ帰リ『西藩見聞録』ヲ作ツテコレヲ上ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十三年中野知事ノ嘱ヲ受ケ勅語述義ヲ編シテコレヲ闔県ニ敷ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ハカク信ジテコレヲ行動ニ移シタノデアル。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
