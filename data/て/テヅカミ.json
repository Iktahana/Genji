[
  {
    "uuid": "e5bb3052-4019-5b90-93a0-0457f3ea16ed",
    "entry": "手づかみ",
    "reading": {
      "primary": "てづかみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "grasping (with one's bare hands)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "離乳食を始めたばかりの息子が、ブロッコリーを一生懸命に手づかみで食べている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "豪快なシーフードレストランでは、エビやカニをワイルドに手づかみで楽しむのが流儀だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "泥んこ遊びに夢中になった子供たちは、川の小魚を手づかみしようと必死になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "素裸で村の川や溝へ這入っては、鮒鰌をすくったり、蛙を呑んでいる蛇などを見つけては、尻尾を手づかみにして叩き殺す位なことは、平凡ないたずらの方であった。",
              "citation": {
                "source": "井戸",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "とか言って、腹が空いているんですから、五つ紋も、仙台｜平も、手づかみの、がつがつ喰。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "安成子も早速に水の中へ手を突つ込んで首尾よく手づかみにしたのは、時に取つての無邪氣な餘興であつた。",
              "citation": {
                "source": "華嚴瀧",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、どろぼうを手づかみにした。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "学生は皿に盛った肉を手づかみにして、座敷の壁へたたきつける。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨の降った次の日運動に出たとき、俺は泥をソッと手づかみにして、何ベンも機会を覗ったが、ウマク行かなかった。",
              "citation": {
                "source": "独房",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹だけが大きくふくれて、眼のギョロッとした子供が、炉の中の灰を手づかみにして、口へ持って行っていた。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供はちらつと駿介の顏を見上げると、手づかみで、泥鰌をとらへ、バケツのなかに放り込んで、後を振り向き振り向き走つて去つた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はその時計を、うっかりしてそのまま手づかみで拾い上げてしまったのだった。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから後も、僕は何度となくその時計を手づかみにした。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "山姥はおはちのふたをあけて、手づかみでせっせと御飯をつめこみながら、たくあんをまるごと、もりもりかじっていました。",
              "citation": {
                "source": "山姥の話",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　親爺は棚から紙袋を降ろして、手づかみでとろゝ昆布を新聞紙の上にあけた。",
              "citation": {
                "source": "雨",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わしは、どうしても、手づかみでとつた大きな鯉が、たべたくなつた。",
              "citation": {
                "source": "木曾の一平",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾日かかつてもよいから、大きな鯉を、手づかみでとつてきてはくれまいか。",
              "citation": {
                "source": "木曾の一平",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、大きな鯉を手づかみでとることは、なかなかよういではありません。",
              "citation": {
                "source": "木曾の一平",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "たうとう、ある日、大きな鯉を、手づかみでとることができました。",
              "citation": {
                "source": "木曾の一平",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな鯉を手づかみにするとは、日本一の若者だ。",
              "citation": {
                "source": "木曾の一平",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わしは、どうしても、手づかみでとつた兎が、たべたくなつた。",
              "citation": {
                "source": "木曾の一平",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾日かかつてもよいから、兎を一匹、手づかみでとつてきてはくれまいか。",
              "citation": {
                "source": "木曾の一平",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、兎を手づかみでつかまへるのは、鯉をつかまへるより、いつそうむづかしいことでした。",
              "citation": {
                "source": "木曾の一平",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎を手づかみでとらへるとは、日本一の若者だ。",
              "citation": {
                "source": "木曾の一平",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "話をきいてみると、彼等は黒い船からおりてきたわたしたちを海賊だと思つて、手向ひしたのだが、弓の矢は手づかみにされるし、大きな岩を投げつけられるし、とてもかなはないから降参するといふんです。",
              "citation": {
                "source": "スミトラ物語",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "従つて、自分は、フオークで肉を刺すぐらゐのことは心得てゐながら、わざわざ手づかみで食ひ、それが却つて、「えらい」と思ふ、さういふ手合が、まだその辺にゐるやうですが、さういふ気もちもわかるにはわかるが、あまり大人げない。",
              "citation": {
                "source": "島国的僻見",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮎の寝床も知つてゐて、夜河で岩から岩へつたひながら、手づかみする位は造作もないことだつた。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙太は例の五円のぼろ札を手づかみにして突っ立っていたが、容易に売場へ近づくことが出来ないとともに、一方にはその負けた人間の顔が、自分自身の顔でもあるかのように怖ろしくなってきていた。",
              "citation": {
                "source": "競馬",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしたのか、その日はいいぐあいに酔いが発しないらしく、折敷の下物を手づかみで食い、夜が更けるまで調子をはずした妙な飲みかたをしていたが、夜半近く、杯を投げだすと、そこへ酔い倒れてすさまじい鼾をかきだした。",
              "citation": {
                "source": "無月物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからか玄米の握飯を持って来て、手づかみでそれを分配して、「僕らもそれを喰べているのだから君らもそれで辛抱し給え」となかなか親切だ。",
              "citation": {
                "source": "震災日誌",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らもそれを感謝して、バラバラする奴を手づかみで頬ばっている。",
              "citation": {
                "source": "震災日誌",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鳥には羽があるが、人間にはないものを、なんで、手づかみができるものか。",
              "citation": {
                "source": "心の芽",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "女学生が通るので、さすがに手づかみにするのが恥かしく、近くの紙きれを使う。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
