    "definitions": [
      {
        "index": 1,
        "gloss": "planting personally",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖父は毎年、田んぼの苗を手植えしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "手植えされた小さな花が、庭を彩っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この地域の米は、手間暇かけた手植えで育てられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それに寺からのお願い出もあったので、暫く御くつろぎの上記念の落葉松をお手植えになって、八時十五分に御出発になる。",
              "citation": {
                "source": "朝香宮殿下に侍して南アルプスの旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたかもわが国の古刹にて、袈裟掛けの松、手植えの梅、何上人の袈裟・珠数等を保存せるに異ならず。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "越後の寺泊に近い野積浦の高津家にも、やはり人魚を食った八百比丘尼はこの家から出たといい、今も手植えの老松が残っている。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、ぐずぐずしていてはならぬので、ついに七月一日に天然痘患者のうみを取ってうえたのであります。",
              "citation": {
                "source": "ジェンナー伝",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜ人はそんなにしっかりと地中に根をおろしたのか、それに比例してうえなる天に立ちあがらんがためにほかならないではないか。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて次には手甲（てうえ）をはめる。",
              "citation": {
                "source": "陸中雑記",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬の間には河鹿を大きな瓶の中に入れてうえから海綿をかぶせ蓋をして湯殿の隅に置いた。",
              "citation": {
                "source": "生い立ちの記",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "軒端に草の茂った、その裡に、古道具をごつごつと積んだ、暗い中に、赤絵の茶碗、皿の交った形は、大木の空洞に茨の実の溢れたような風情のある、小さな店を指して、「あの裏に、旦那、弁慶手植の松があるで――御覧になるかな。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　その手植の松より、直接に弁慶にお目に掛った。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "国史国文学の研究家であり、好事家である村瀬君助が小野の小町の手植ゑと言ひ伝へられるこの芍薬の傍へ来たときにはかなり疲れて汗を垂らしてゐた。",
              "citation": {
                "source": "小町の芍薬",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつの昔か――傍の農家の老人は樹齢から察して多分六百年以上は経っていると言いますが――お角という少女があって、桜の苗木を手植にしました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "六百年の久しき後にまで人の肩になまめかしくしなだれかゝる老木の桜の一念を見るにつけ、手植の主の少女の、否、なべての女の永劫に見果てぬいのちの夢が今更に想い遣られます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮は、報徳神社といふ、彼の二宮尊徳翁を祭れるもの、石段の南北に畏くも、宮樣御手植の對の榊、四邊に塵も留めず、高きあたり靜に鳥の聲鳴きかはす。",
              "citation": {
                "source": "城の石垣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小包の中からは彼女が谷中の方で手植にしたという秋海棠の根が四つ出て来た。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一つ遺憾なのは、久しぶり即ち十七年目に帰省したのだから一度は城山の絶頂に登って眺望をしたいと思ったが、それも出来ず、道後の公園さえ私の碑の建った場所を見たのみで、山上の陛下の御手植の松さえ見る事が出来ず、温泉の町も昼の光景は見る事が出来なかった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "先住の手植らしい縁日物の植木や、素人の手でつくられたに違いない瓢箪池は、古びた煉瓦の下敷になってしまった。",
              "citation": {
                "source": "遺産",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからここを立ち出でて東照宮の方へ行く途中天海大僧正お手植の槙、樹高――七十一尺、周囲――九尺七寸、樹齢――二百七十五年寛永十六年本院再築の時植付　とある、この位の槙の大木は関東では珍しいものに属する。",
              "citation": {
                "source": "武州喜多院",
                "author": "中里介山",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのミュゾオの館の庭には、いまでも詩人の手植の薔薇が咲いているそうである。",
              "citation": {
                "source": "雉子日記",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "小石川久堅町なる光円寺の大銀杏、また麻布善福寺にある親鸞上人手植の銀杏と称せられるものの如き、いずれも数百年の老樹である。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治になって新田義貞を祀った新田神社が創設され、側に今上陛下が皇太子殿下であらせられたころ、御登攀遊ばされた記念のお手植の松がある。",
              "citation": {
                "source": "山と村",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "神社に御参拝の後、記念の松を御手植になって、お休みの御暇もなく直に御出発になった。",
              "citation": {
                "source": "朝香宮殿下に侍して南アルプスの旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中特に有明小学校に御立寄になって、天蚕飼育の状況や、天蚕糸を原料とした各種の製品を仔細に御覧になり、校庭には記念の松を御手植になった。",
              "citation": {
                "source": "秩父宮殿下に侍して槍ヶ岳へ",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三代将軍手植の松ウ！",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
