        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "玩具屋の飾窓には大きなテッディ熊が飾ってあります。",
              "citation": {
                "source": "街の子",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると大きな、玩具屋があって、そこの飾窓に、テッディ熊がいるだろう。",
              "citation": {
                "source": "街の子",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやになるねえ、いつまでも寒くて、この大雪じゃ、わしのぼろ靴で歩くのはこたえまさあね」と、大声でいいながら、戸口でぶるぶるっと雪をはらって、時計屋のテッディ・ヘンフリイが寒そうにはいってきた。",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、テッディさん！",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、（テッディといっしょにあの客のところへゆく）ということだった。",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、「テッディさん、いいところへきてくださったわ、ちょうど、お客部屋の時計を見てもらいたいと思っていたのよ。",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「へんだねえ、ちょっくら、見てみましょう」　テッディは首をかしげながら言った。",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「では、テッディさん、ちょっと、待っててください。",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいては、時計屋のテッディ・ヘンフリイともうひとりの村の男だった。",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
