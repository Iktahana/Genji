        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "暗闇の中で、スイッチの場所を手弄りで探した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "鞄の中の小銭を、手弄りで探り当てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は壁を手弄りしながら、ゆっくりと進んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
