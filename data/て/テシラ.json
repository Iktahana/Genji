          "literary": [
            {
              "text": "ピュラコスの子イヒクロス牧羊多く持てるもの、　705ポダルケースを産みなせり、プロ，テシラ，オス老練の武人即ち其義兄、プロ，テシラ，オス英豪に齡も勇も優れりき、亡きを繼ぎたる將あれど部下の民族過ぎさりし名將軍を今思ふ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "698　プローテシラーオスを縮む。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "テラモニデース、甲板に立ちヘクトールが燒かんとするプロテシラオスの舟を防ぐ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "海上迅く走る船、＊プロテシラオス乘せ來り、　705トロイアの地につきしもの、されど故郷に勇將をのせ歸さざる迅き船、其艫をつかむヘクトール、船を※りてアカイアとトロイア勢と密接の戰なして相うてり。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "パートロクロスまつ先きに耀く槍を投げ飛ばし、プロテシラオス乘りし船、黒き船尾の傍に　285敵の軍勢亂れたるそのただ中に抛げ飛ばし、おほいなる川アキシオス、流るるほとりアミドーン郷より、騎馬のパイオニア勢を率ゐし剛勇の、＊ピュライクメ，スの右の肩打てば、呻めきて塵の中、あをのけ樣に打ちたほる。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "（兄より妹へ）　ユカレヌ、イサイ、フミニテシラセ、シンブン、オクレ。",
              "citation": {
                "source": "偽悪病患者",
                "author": "大下宇陀児",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
