        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コルトーは必ずしもテクニシアンではないと野村光一氏は言う。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "単純なテクニシアンに、ショパンやシューマンが、そんな具合に弾ける道理はないからである。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "バックハウスは決して単なるテクニシアンではない。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "演奏家としては無類のテクニシアンで、〔Ele'gant〕 の一語に尽きると言われている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一言にして尽せば、スレザークは練達無比のテクニシアンだ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
