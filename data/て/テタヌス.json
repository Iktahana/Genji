        "examples": {
          "standard": [
            {
              "text": "破傷風菌に感染すると、テタヌスを発症する可能性がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "さびた釘を踏んだ後、医師にテタヌスの予防接種を強く勧められた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "途上国では今もテタヌスによる死者が報告されており、ワクチン普及が急務とされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "知られているうちでもっとも恐ろしいは破傷風すなわちテタヌスであって1884年にニコライエル（1862-1942）が発見したものである。",
              "citation": {
                "source": "簡約医学史",
                "author": "A Concise History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "観察の正確さは、大便および尿のいろいろな構成、眩暈、皮膚病、性疾患、卒中、テンカン、偏頭痛、テタヌス、リューマチ、精神異常、その他、の記載に示される。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
