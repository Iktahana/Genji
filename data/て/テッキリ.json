    "definitions": [
      {
        "index": 1,
        "gloss": "surely",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「あ、田中さん！今日は休みだとてっきり思い込んでいました」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "鍵を失くしたと慌てて探したが、てっきりカバンの底にあると思っていたのに。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はまだ独身だとてっきり信じていたので、結婚していると聞いて驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "Ｔ「てっきり彼奴」　と独り言、Ｔ「朝ッぱらから一稼ぎしてやがるかも知れ無えぞ」　其辺で鉄五郎クルッと踵を反して走り去る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "フト彼方を見れば、てっきり鉄五郎がのこのこやって来る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓ＝附近　尾行して来たてっきり鉄五郎、立ち止って素早く物蔭にかくれる。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓ＝通り――　てっきり鉄がのこのこ歩いて来る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）Ｔ「翌る朝」Ｓ＝ファーストシーンの町角　てっきり鉄と三次が今日も亦ばったり出会った。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓ＝附近の通り　屋根の上からひらりと跳び下りた三次、その儘立ち去ろうとしてバッタリ急ぎ足にやって来たてっきり鉄と出合わした。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄が、Ｔ「俺は又てっきりお前と思ってやって来たが」　三次が「飛んでも無い。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "と肩を叩かれて振り返ると、　何時の間に来たか、てっきり鉄五郎。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「わかったよお絹ちゃん」　てっきり鉄が辺りを見廻し乍ら戻って来た。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "てっきり僕は北方の田舎者だと思われてしまったのです。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその女は自分が咳をしてから庭の方を向いたのを勘違いして、てっきりこれは「心臓へ来た」と思ってしまったのだと吉田は悟ることができた。",
              "citation": {
                "source": "のんきな患者",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに小平さんが、松吉の耳をつまんで、二どばかり、耳の毛をそったときには、松吉は、てっきり、小平さんが、むかしのいたずらをはじめたと、思いました。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊にアムモニアの議論のことまで出てゐましたから、私はもうてっきりあの紳士のことだと考へました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "てっきり蔵元屋騒動のかかり合いと察しました私ども一家の驚きと悲歎のほど御察し下さいませ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "イフヒムといがみ合った様な噂もちょくちょく聞くから、貢ぐのは野郎じゃ無くって、これはてっきり外に出来たなとそう思ったんだ。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "目がお見えなさらないというだけは不吉じゃあござりましたが、東京の方だというし、お年の比なり御様子なり、てっきり貴方に違いないと、直ぐこちらへ飛んで参り、向うのあの荒物屋で聞いてお尋ね申しました。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」二十一「それが談話に来たんだもの、私はもうてっきり。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "てっきりこいつ大詐欺に極まった。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "白魚の指の尖の、ちらちらと髪を潜って動いたのも、思えば見えよう道理はないのに、てっきり耳が動いたようで。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　この明さんと、御自分の令室が、てっきり不義に極った、と最早その時は言訳立たず。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、小郷が殺されているのを見ると、てっきり三好だと思って、三好をかばうつもりで、自分だと言ったんですね。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中に聞くと、昨夜三人が出掛けた後でこっそり外出されましたとのことで、てっきり吉原か玉の井辺りへ出掛けたのだろうと推測された。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ァまたてっきりそうだと思ったんですが…』『恐れ入ります。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど郁子の姉が監視に来ていたところで、廻り縁を渡って行く二人の後ろ姿を見、てっきり均平の情人が、均平の子供を背負いこんで来たものと推断し、わざとひそかに庭へおりて、植込みの隙間から、二人の坐っている座敷の方を覗いて見たりした。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "このあいだ、ひとりで退屈まぎれに火箸の曲ったのを直そうと思ってかちんかちん火鉢のふちにたたきつけていたら、あなた、女房が洗濯を止し眼つきをかえて私の部屋へかけこんで来ましてねえ、てっきり気ちがいになったと思った、そう言うのですよ。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "新吉はてっきりリサの送った娘と見て取った。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでクロはてっきり、団長がいつものように、ほんとにおこって、正坊を竹の刀でなぐりつけるのだと思いました。",
              "citation": {
                "source": "正坊とクロ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "てっきり、この界隈と見込みをつけ、一軒一軒さがして、いやもう大骨折さ。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
