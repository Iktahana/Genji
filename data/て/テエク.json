        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "けふ着きたまひしことなれば、『ピナコテエク』、また美術会の画堂なども、まだ見玉はじ。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのをりは『ピナコテエク』に懸けたる画を見しのみにて、学校の人々などに、交を結ぶことを得ざりき。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ピナコテエク』の館出でし時は、雪いま晴れて、街の中道なる並木の枝は、一つ一つ薄き氷にてつつまれたるが、今点ぜし街燈に映じたり。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "デルブロオのビブリオテエク・オリアンタアルを見ると、「さまよえる猶太人」は、十六世紀の初期に当って、ファディラの率いるアラビアの騎兵が、エルヴァンの市を陥れた時に、その陣中に現れて、Allah akubar（神は大いなるかな）の祈祷を、ファディラと共にしたと云う事が書いてある。",
              "citation": {
                "source": "さまよえる猶太人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人前三十銭のビイフ・ステエクの上にもかすかに匂つてゐる阿蘭陀芹を。",
              "citation": {
                "source": "或阿呆の一生",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は焼パンに野菜スウプ、卵を添えたビイフステエク、砂糖漬の果物と葡萄酒、緑色のゴルゴンツォラのチイズの一片と梨を半分食べた。",
              "citation": {
                "source": "衣裳戸棚",
                "author": "DER KLEIDERSCHRANK",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゆっくりお歩き、ガブリエレ、テエク・ケヤア、いいかい。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
