          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今回のテストは点取りに執着せず、自分の苦手な分野を把握することに重点を置いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は趣味で点取り占いをコレクションしており、古いお菓子の付録を大切にしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「そんなに点取りばかり気にして勉強して、本当に理解できているのかい？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "やがて、中から何か二三点取り出して、それを畳の上へ置いて考えた。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは間に合せの、ごまかしの、「点取り主義」の新劇舞台に馴らされた眼には、至極もつともなことで、文学座の現在行ひつゝあるトレイニング、基本練習にはさぞかし興味がもてまいと察せられるのです。",
              "citation": {
                "source": "文学座第二回試演に際して",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　点取りの表を覗き込んだ俊子の細そりした頸筋が、彼の眼の前に滑らかな皮膚を差伸べた。",
              "citation": {
                "source": "月明",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういうわけで、天狗連が点取りを争うのだから、ともすれば荒っぽくなる。",
              "citation": {
                "source": "寛永相合傘",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年時代の苦学、点取り勉強、官吏生活、政略結婚、子供の教育、放蕩、事業慾、それから少しばかりの蓄財……と、こゝまで来て、あとなにが残る？",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "この二人は、どうやら俳諧師といったような風流人であるらしいが、それは二人ともに被布を着ているから、それで俳諧師という見立てではなく、また俳諧によって点取り生活をしている営業の人という意味でもなく、正風とか、檀林とかいうまでもなく、一種の俳諧味を多量に持った道づれの旅人と見ればそれでよろしい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまり深く聞くのも失礼だと思いましたから、無邪気なおりんと単純な次郎と、世間見ずなお嬢様とが、そこでまたかれの望みに任せて、投扇の点取りをやって遊びはじめました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "てんとりむしと言はれずに首席になることは困難であつたが、私はそのやうな嘲りを受けなかつた許りか、級友を手ならす術まで心得てゐた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "てんとりむしと言はれずに首席となることは困難であつたが、私はそのやうな嘲りを受けなかつた許りか、級友を手ならす術まで心得てゐた。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「勉強のことなんかいうのは、てんとり虫のいうことだ。",
              "citation": {
                "source": "赤土へくる子供たち",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "白痴五十人、点取虫十人、オポチュニスト五人、暴力派五人、と僕は始業式の時に、早くもクラスの学生を分類してしまったのである。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "点取虫だと言われて、はっと気がつくと、豹一はもう「首席」という渾名に芸もなくやに下っていられなくなり、自分が勉強もろくろくせずに首席になれたことを皆に思いこませようとした。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日の放課後、クラスの者たち全部からとりまかれ、点取虫のくせに生意気やぞと鉄拳制裁をされた。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中、法科志望の点取虫の多いのには、げっそりさせられた。",
              "citation": {
                "source": "髪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "点取虫だといわれて、初めてはっと気が付くと、豹一はもう首席という綽名に芸もなくやに下って居られなくなり、自分が余り勉強もせずに首席になれたことを思いこませようとして、試験の前日には必ず新世界の第一朝日劇場に出掛けてマキノ映画を見、試験の日にそのプログラムの紙をもって来て見せるのだった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日の放課後、クラスの者たち全部からとりまかれ、点取虫の癖に生意気やぞと鉄拳制裁をされた。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あいつはたかが点取虫だ」　一学期の試験の前日、豹一は新世界の第一朝日劇場へ出掛けた。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "沼井は点取虫だということになっていた。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ところが俺も点取虫と言われたことがある。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、秀才とは暗記力の少し良い、点取虫の謂いではないか？",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "教師が教室で講義に飽いて雑談すると、「それ試験に出ますか」と質問するていの点取虫だ。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗匠を張る時は紋着で巻莨、色と点取発句が一斉に出来るのであるから、ついこう下駄を懐に入れるような事にもなる。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その話は浪人になつて大阪にゐた時、点取と云ふことを人に勧められてしたが、宗匠に不服なのと、どうも無学な人にかなはないのとで、すぐに廃めたと云ふことであつたさうだ。",
              "citation": {
                "source": "俳句と云ふもの",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "級の上にいるものを見て、なんだ点取がと云って威張っていたくらいである。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "三たび我が行きし時に、蒼海は幾多の少年壮士を率ゐて朝鮮の挙に与らんとし、老畸人も亦た各国の点取に雷名を轟かしたる秀逸の吟咏を廃して、自村の興廃に関るべき大事に眉をひそむるを見たり。",
              "citation": {
                "source": "三日幻境",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、運座点取など人と競争するも善し。",
              "citation": {
                "source": "俳諧大要",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初は普通の標的の点取射撃で、どちらも名人のことだから、無造作に満点で、勝負なしに終つた。",
              "citation": {
                "source": "風変りな決闘",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俳諧は大阪にいた頃｜点取ということを人から勧められたけれど、宗匠の人物に不服だったのと、無学の人にも叶わなかったりするので廃めたのだそうです。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "七十点取れたでしょう」　と判定した。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにいる連中にそんなことを頼んだら、頼まれぬ襖や屏風にまで、よい気になって塗りたくられるぞ』『いえ何、そんな高価な物はございませんから、安心でございまする』『おまえも、俳諧でもやるのか』『へい、店の暇に、冠附の点取の取次ぎなどやっておりますので、何やら下手の真似事を』『それは面白い。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
