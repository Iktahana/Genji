        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "職人が手彫りした木像は、息をのむほど美しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この表札は、手彫りの温かみが感じられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "手彫りの指輪は、機械で作られたものとは違う味がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "この扉がロッビアだろうが左甚五郎の手彫りだろうが、僕は是が非でも叩き破るんだ」　そうして斧が取り寄せられて、まず最初の一撃が、把手の上のあたり――羽目を目がけて加えられた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "煖炉棚には、なまなましい木目込人形、アイヌの手彫りの木箱、さびくちた古い鉄の五重塔、其他。",
              "citation": {
                "source": "坂田の場合",
                "author": "――「小悪魔の記録」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃のきたない絵もやはり自分のきたなさは感じないがその癢さを感じてぼりぼりブラシで引掻いたような痕が見える。",
              "citation": {
                "source": "二科展院展急行瞥見記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "障子の外では庭で傭人が陸稲を扱きはじめたと見えてぼり／＼と懶相な音が聞える。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に入ってかき餅などを焼いてもらってぼりぼり噛んだ。",
              "citation": {
                "source": "こころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "上手には、頑丈な、手彫模様のついた木製の長卓子、腰掛、櫃等置かれている。",
              "citation": {
                "source": "猿",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "手彫の刳鉢や曲物の手桶や、風雅な趣きさえ感じます。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、最初の男が手に持った犬の食器というのは、幅約26センチ、長さ約２メートル60センチの、丸太を二つ割にして手彫した舟型の木器であります。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
