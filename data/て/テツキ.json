[
  {
    "uuid": "e09e714a-223b-597c-81f8-78a4673cf235",
    "entry": "手つき",
    "reading": {
      "primary": "てつき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
