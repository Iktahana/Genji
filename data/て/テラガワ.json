        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "死して寺側に埋めし上に白蓮花を生じ、花謝して泉水涌き出づ。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "泉岳寺側に住居を構へ、破婚の寂しさを紛らはさん爲に知人や朋友を集めて文學談話會をこしらへると、永井君は二度ばかり出席してくれた。",
              "citation": {
                "source": "永井荷風といふ男",
                "author": "生田葵山",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　まだ築地本願寺側の僑居にあった時、わたしは大に奮励して長篇の小説に筆をつけたことがあった。",
              "citation": {
                "source": "十日の菊",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがってひとり法隆寺側の誤解をのみ責める訳には行かぬ。",
              "citation": {
                "source": "法隆寺再建非再建論の回顧",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らく本願寺側の必死の働きかけが利いたのであらう。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "勅命を奏請して、まず、「事なきように」　と、本願寺側を諭した。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やがて、信長が来て、検分のとき、醜しくも、取り乱したるものかな――などといわれては恥辱ぞ」　と、本願寺側でも、その以前に、あらゆる什物宝器を展列して、いちいち目録を添え、塵を払い、欄を浄め、立つ鳥水を濁さず――のことばの通りきれいにして去っていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "恵林寺側は、そのたびに、言を左右にして、（畏りました）　と、いわない。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜んだ寺側はただちに法輪院に御所をしつらえ、心身ともに疲れた宮に食事を差しあげたのであった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第四巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "見らるる通り寺側の勢いきわめて少く、これで六波羅へ押し寄せるのは無謀の極みと愚僧思案いたします。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第四巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "日が暮れ夜に入っても戦は激しくなるばかり、すでに三百余人が討死した寺側の防備のうすいところを狙って夜襲を敢行した攻略軍は、遂に寺に攻めこんだ。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第四巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "また鰐淵寺の頼源や大社の孝時らの、つまり武士でない社寺側と船上山との往来も、公然とひらかれて来て、「春は来た」　との実感が、日ましに行宮の装いを厚くしていた。",
              "citation": {
                "source": "私本太平記",
                "author": "八荒帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
