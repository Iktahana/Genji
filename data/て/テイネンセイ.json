        "examples": {
          "standard": [
            {
              "text": "近年、多くの企業で定年制の見直しが進んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "定年制の導入により、高齢者の雇用機会が減少するという意見もある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「うちの会社、定年制は60歳だけど、希望すれば延長できるんだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "大学に定年制のできたおもな理由は、老教授の発言権を封じ、新進に道を開くためであった。",
              "citation": {
                "source": "非名誉教授の弁",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
