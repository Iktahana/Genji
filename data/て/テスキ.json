        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "仕事の手透きを見つけては、趣味の読書に耽るのが私の日課だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "子育ての合間のわずかな手透きを利用して、資格試験の勉強に励んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "父は定年退職後、手透きな時間が増えたので家庭菜園を始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
