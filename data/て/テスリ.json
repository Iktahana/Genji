  {
    "uuid": "bc3fe88e-8980-5df1-a54e-1f1a2c7ff97b",
    "entry": "手摺",
    "reading": {
      "primary": "てすり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
