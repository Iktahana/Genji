    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "手摺窓の障子を明けて頭を出すと、椎の枝が青空を遮って北を掩うている。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "背廣の輕裝に薄色の鳥打を被つて、甲板の手摺にそつと身を凭せてゐる。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "種彦と云へば、アノ、「文字手摺昔人形」と云ふ本の中に、女が出陣する所がある。",
              "citation": {
                "source": "いろ扱ひ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……あすこに人が一人立っているね、縁台を少し離れて、手摺に寄掛って。",
              "citation": {
                "source": "古狢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "磴たるや、山賊の構えた巌の砦の火見の階子と云ってもいい、縦横町条の家ごとの屋根、辻の柳、遠近の森に隠顕しても、十町三方、城下を往来の人々が目を欹れば皆見える、見たその容子は、中空の手摺にかけた色小袖に外套の熊蝉が留ったにそのままだろう。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓ＝その二階　手摺りに凭れて、下の様子を見て居る、武蔵と団九郎である。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方の宿場の混乱の中に遂に二人を捕えると、宿の二階を見上げて、敬四郎ペコペコ頭を下げて、Ｔ「これで嬶ァに威張れます」　浪之助とお類、上を見ると宿の二階の手摺りに右門と伝六おふみに伊吉。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは彼の田舎の家の前を通っている街道に一つ見窄らしい商人宿があって、その二階の手摺の向こうに、よく朝など出立の前の朝餉を食べていたりする旅人の姿が街道から見えるのだった。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その隣の窓では一人の男がぼんやり手摺から身体を乗り出していた。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と落着いて、静に秋波に視ていいながら、ちょいと、仰向いて　端を引いた、奉納の手拭、いまだ手摺もなく新しい。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "手摺の靄が一｜面に、浸の形が樺太の図に浮ぶ。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吃驚して文三がフッと貌を振揚げて見ると、手摺れて垢光りに光ッた洋服、しかも二三カ所｜手痍を負うた奴を着た壮年の男が、余程｜酩酊していると見えて、鼻持のならぬ程の熟柿臭い香をさせながら、何時の間にか目前に突立ッていた。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "この後、彼は私の存在を忘れたように、黙って船尾の手摺りによりかかって、一部分は暗く、一部分は月の光りにおぼろに輝いている大氷原のあなたを、まじろぎもせずに見詰めていたのである。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　渋皮のむけた二十二三の女中が、半分繰り出されてあった板戸を開けて、肱掛窓の手摺や何かを拭いていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "無数の真鯉緋鯉が、ひたひた水の浸して来る手摺の下を苦もなげに游泳していた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "見あげると手摺に両手をついて、下を見ながら笑っていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "庸三はにわかに興奮を感じ、なお硝子戸の引いてある手摺に靠れて、順々に荷物の積まれるのを見ていたが、小池の采配ですっかり積みこまれ縄がかけられるのを見澄ましてから、煙草を一本取り出して喫しはじめ、車の引き出されるのを待っていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　女中は廊下の手摺りに凭れながらお庄に言って聞かせた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」お庄は橋の手摺りに倚りかかって、あっちを向いている弟の傍へ寄り添いながら訊いたが、弟はやはり厭がった。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして拭き掃除がすんでしまうと、手摺りにもたれて、お互いに髪を讃め合ったり、櫛や簪の話をしていた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｏ氏は二階の手摺り際へ籐椅子を持ち出して、午後からの創作に疲れた頭を安めていたが、本をぎっしり詰め込んだ大きな書棚や、古い装飾品のこてこて飾られた部屋が入りつけている笹村の目には、寂しい自分の書斎よりも一層懐かしかった。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お銀は手摺りに干してある座蒲団の柄合いなどから、その人柄を嗅ぎつけようとしていた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "笹村は四、五歳のおり、父親につれられて行って、それらの家の一軒の二階の手摺り際から眺めた盆踊りのさまや、祭の日にこっちの家の二階から向かいの家の二階へかかった床に催される手踊りなどを思い出していた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後三時頃の懶い眠に襲われて、日影の薄い部屋に、うつらうつらしていた頭脳が急にせいせいして来て、お島は手摺ぎわへ出て、美しい雨脚を眺めていた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名な家です」桂三郎は縁側の手摺にもたれながら言った。",
              "citation": {
                "source": "蒼白い月",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は羽織をぬいで、梁や手摺などの伐倒した雑木で造られた無造作な、しかしがつしりした其の建築に興味を感じた。",
              "citation": {
                "source": "芭蕉と歯朶",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理場から料理を持出す窓をもつた食堂でもあり応接室でもあり遊戯室でもある二十坪ばかりの広間には、これも素材のまゝの手摺をもつた段梯子があつた。",
              "citation": {
                "source": "芭蕉と歯朶",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "両側に手スリのようなのはあるが、足場は板が一枚だから、踏み外せば、谷底へズリ落ちてしまう。",
              "citation": {
                "source": "発掘した美女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンクリートの階段と手摺りとがあり、階段の上がり口には蘇鉄や寒菊や葉蘭などの鉢が四つ五つ置いてあった。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」義雄はその理由を感づいてゐないではないが、今更ら見られたことを取り消すわけには行かないと覺悟して、わざと平氣で手摺りにもたれたまま、縁がはに足を投げ出してゐた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
