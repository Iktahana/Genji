    "definitions": [
      {
        "index": 1,
        "gloss": "handrail",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "階段の手すりにしっかりつかまって、ゆっくり降りてください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "船のデッキでは、荒波に備えて手すりが頑丈に設置されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「危ない！」子どもがバランスを崩しそうになったので、私はとっさに手すりを掴ませた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そして橋の手すりに肘をついて浚渫船をボンヤリ眺めた。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "さゝやかなる庭の池水にゆられて見ゆるかげ物いふやうにて、手すりめきたる所に寄りて久しう見入るれば、はじめは浮きたるやうなりしも次第に底ふかく、この池の深さいくばくとも量られぬ心地になりて、月はそのそこの底のいと深くに住らん物のやうに思はれぬ。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、そこを、上等兵につれられて、垢に汚れた手すりを伝って階段を登った。",
              "citation": {
                "source": "穴",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）７７＝（Ｆ・Ｉ）宿の表　朝、二階の手すりから浪之助とお類が見送る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）77＝（Ｆ・Ｉ）宿の表　朝、二階の手すりから浪之助とお類が見送る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "二つの時計――その一つは小形の置き時計で、右側の壁にくっつけた戸棚の上にある、もう一つは懐中時計でベットの頭の手すりにつるしてある――この二つの時計の秒を刻む音と、足もとのほうから聞こえて来る付添看護婦の静かな寝息のほかには何もない。",
              "citation": {
                "source": "病院の夜明けの物音",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの手すりの上をすべって行くゴムの帯もなんだか蛇のようで気味が悪いと言った人もある。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲板の手すりにもたれて銃口をそろえた船員の群れがいる。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり二人とも出ていたねえ、子供は高い処なもんだからもうぶるぶる顫えて手すりにとりついているんだ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」鶴雄に坐蒲団をすすめて置いて、小田は窓側の手すりに洗濯したワイシャツをひっ掛けると、机の前へ戻って来た。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし堂島は既に遥か下の一階の手すりのところを滑るように降りて行くのを見ては彼女らは追つけそうもないので「無茶だ、無茶だ」と興奮して罵りながら、加奈江のところへ戻って来た。",
              "citation": {
                "source": "越年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼんやりと手すりに倚りかかつたり、寢ころんだりして、その荷車や客車の通るのは何十分置き毎だらうと、勘定して見る氣になつたこともあつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "各国の国旗で通風管や巻き上げ器械などを包みかくし、手すりにも旗を掛け連ねた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "柱や手すりを白樺の丸太で作り、天井の周縁の軒ばからは、海水浴場のテントなどにあるようなびらびらした波形の布切れをたれただけで、車上の客席は高原の野天の涼風が自由に吹き抜けられるようにできている。",
              "citation": {
                "source": "軽井沢",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "徐々に道幅が広がり、やがて手すりのついた広い橋に差し掛かって、ゆっくりと流れるよどんだ川を越える。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲鳴はやんでいたが、夫人は気を失って長椅子の上にのびており、もうひとりの方は片足を肘掛椅子の手すりへだらんと懸け、頭を炉格子の端近くの地面に転がしたまま、血だまりのなか、あいにく事切れていた。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　やがて平野橋、一本二本蘆の中に交ったのが次第に洲崎のこの辺土手は一面の薄原、穂の中から二十日近くの月を遠く沖合の空に眺めて、潮が高いから、人家の座敷下の手すりとすれずれの処をゆらりと漕いだ、河岸についてるのは川蒸汽で縦に七｜艘ばかり。",
              "citation": {
                "source": "葛飾砂子",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）それで、今、だれの仕事着も洗いすすがれて、汽罐場の手すりに、かわかされてあった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "三尺四方ばかり横に張り出して、手すりもあり。",
              "citation": {
                "source": "多摩川冒險記",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまも、ひとりでオレンジジュースを飲みながら、テラスをめぐる手すりをかかえこみ、幼児期の細部をひとつひとつ思いだそうとしている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なーに」　慶一は、手すりの上で寝返りでもするように、もたれかかったまま、サロンの方向へ躰を一八〇度回転させた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちゃんといっておいてくれれば、もうちょっと、マシな準備ができたんだけどな」　ヴェランダに出した折り畳みイスに坐り、高志は、手すりの下に走る桟に足を投げだした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そろそろ、メシだよ」　ワラが手すりにもたれて、パイナプルを食べながらいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "メシ、いくか」　高志が立ち上がって、手すりに引っかけてあった真っ白なＴシャツをとり、頭からかぶった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "13だから、いいつづけるだろういつまでもここで暮らすと〈フェリー・アクロス・ザ・マージー〉ジェリー＆ザ・ペイスメイカーズ「あれ、まったくおなじ形なんだね」　ワラが、ヴェランダの手すりにもたれて、三階部分の工事に入った、新しい寮を見ながらいった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうなると思ってたんだよ」　高志が、デッキチェアの背を、四〇一の外壁にななめにもたせかけ、手すりのたての細い鉄棒に脚をかけて、頭のうしろに両手を組みながら、ふんぞりかえってこたえた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえ、高志」　慶一は、腕を組んで塔の手すりによりかかり、その上にアゴをのせ、東の空を見つめている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥溜めさえ見えなければ、日本とは思えない」　といいながら、高志も慶一のとなりにきて、手すりにもたれかかった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、日本じゃないなら、どこの国だろう」「さあな……」　ふたりは手すりにもたれ、まったくおなじ姿勢で、黙りこくって、空とその下の寮を見つめる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "無視して歌いつづけ、弾きつづける慶一と柾生を見て、ワラをとめ、高志は階段の手すりに背中をあずけて、観客になった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
