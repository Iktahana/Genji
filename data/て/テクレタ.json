        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イツカヨコシテクレタ君ノ手紙ハ非常ニ面白カッタ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　モシ私ノ云ッタ事ニ対シテ、清三ガ少シデモ耳ヲ傾ケテクレタラ、私ハ清三ヲ殺サズニスンダカモシレナイノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰カ来テクレタ人ニ云ウヨウスデシテ、決シテ一郎トイウ名ヲタダヨンダノデハナカッタト思イマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノウチ、親父ヨリ度々書取リニシテ、イケンヲ云ッテクレタ、ソノ時、隠居ヲシテ、息子ガ三ツニナルカラ家督ヲヤリタイトイッタラ、ソレハ悪イ了簡ダ……」　悪イ了簡ではない、図々しいというものだ、と神尾が呆れました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」アヒルノオマワリサンガカウイツテクレタノデ、玉ネギサント、ジヤガイモサンハ、ドンナニウレシカツタデセウ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　女ノ子ノオマワリサンガ、カウホメテクレタノデスカラ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシタノアサハ　ジヤガイモサンニモサウ言ツテ二人デ一シヨニ、キツト　オミオクリニキテクレタマヘ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ、ボンコチヤンヲコサヘテクレタバウシヤサンノ「バウシノオ父サン」ノ所へ行キマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノウサギハアル人ガ「オヂヤウチヤンニサシ上ゲマス」トイツテ、モツテキテクレタウサギデス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "冗談ニソンナコトヲ云ッタラ、オ望ミナラサセテアゲマスト云ッテクレタ或ル待合ノ女将ガイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナコトヲ繰リ返スコト四五回ニ及ンダガ、佐々木ガシノミンヲ四錠スヽメ、尿道ヲ湯タンポデ温メテクレタノデ、ヤット鎮マリカケル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前立腺肥大ノ手術ハ七十五六歳マデハ可能デアルカラ、思イ切ッテシテオ貰イナサイ、手術シタ後ノ快感ハ何トモ云エナイ、若イ時ノヨウニ尿ガシャー／＼ト音ヲ立テヽ走ッテ出マス、モウ一度青春時代ニ戻ッタ気ガシマスト、ソウ云ッテクレタ人モアッタガ、困難デ不愉快ナ手術ダカラオ止シナサイト云ウ人モアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ鏡ノ中ノ顔ガモット醜悪デアッテクレタラ、颯子ガ尚コノ上ニモ優秀ニ見エタヾロウニト残念ニ思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ颯子モイルコトダシ、―――颯子ハ南禅寺ヘ泊ルノハ懲リ／＼ダカラ、ソレダケハ堪忍シテクレト云ッテルンダ」「ドッチニシタッテ颯子ガ行ッタラ又喧嘩デスヨ」「掴ミ合イデモ始メテクレタラ面白イサ」婆サントソンナ遣リ取リヲスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アタシ一人デ寝カシテ戴クワ、オ爺チャンハ佐々木サントオ休ミナサイヨ」「ナゼサ、一緒ニ寝テクレタッテイヽジャナイカ、東京デモ時々ソウシテクレテルジャナイカ」五子ニ聞カセルタメニ予ハワザト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ足ノ指ノ股マデモキレイニ拭イチテヤリ、「君、ソノ手ノ指ノ股ヲ拭イテヤッテクレタマエ」ト木村ニモ命ジタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜マタ飲ミニ来テクレタマエ」ト云ッタラ、「トンデモナイ、一昨夜ノ晩ハビックリシマシタ、少シ先生モ慎ンデ下サイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ意ヲ決シテ木村ニ云ッタ、「デハコレノ現像ヲ頼ム、絶対ニ誰ニモ見セナイデスベテヲ君自身デシテクレタマエ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ガ去ッテカラ、敏子ガ留守番ヲシテイテクレタノヲ思イ出シテ、茶ノ間ヤ敏子ノ部屋ヘ行ッテミタガモウイナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
