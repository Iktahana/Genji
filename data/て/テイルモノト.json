          "standard": [],
          "literary": [
            {
              "text": "朝食ノ時ニ食堂ニ見エナカッタノハ、朝寝坊ノ彼女ノ常デアルカラ、予ハマダ颯子ハ寝テイルモノト思ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今後ハ僕ハ、彼女ガコレヲ実際ニ盗ミ読ミシテイルト否トニカカワラズ、シテイルモノト考エテ、間接ニ彼女ニ話シカケル気持デコノ日記ヲツケル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ハヨクヨクワレワレ夫婦ノ間ノ秘密ヲ知ッテイルモノト思ワナケレバナラナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
