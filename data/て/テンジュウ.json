[
  {
    "uuid": "1232c61e-cac8-5065-9140-20093f983a86",
    "entry": "転住",
    "reading": {
      "primary": "てんじゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "changing residence",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供の学校に合わせて、家族で地方へ転住することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の仕事は転住が多く、数年おきに住む場所を変えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "転住先での新しい生活には、期待と不安が入り混じっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "昭和十二年十一月、眼疾いよいよ昂じて、駿河台の杏雲堂病院に入院して以来、同十五年四月、砧の成城よりこの杉並の阿佐ヶ谷に転住するに至る、約二年有半の期間に於ける薄明吟の集成が之である。",
              "citation": {
                "source": "黒檜",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち『白南風』が、大正十五年暮春、小田原より東京谷中天王寺墓畔に転住して以来、馬込緑ヶ丘、世田ヶ谷若林、砧村大蔵、等に亘る東京生活の所産であるに対し、本集は、殆同時代の覊旅の旅を主として採録した。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十五年より昭和八年に至る作品の中、天王寺墓畔、馬込緑ヶ丘、世田ヶ谷若林、砧村、此の四ヶ所に於ける、東京転住以来の生活を主としたる短歌及長歌。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そののち大掃除をすると鼠の巣から見出した、浪人は償却しおわると直ぐ転住して行衛知れず、家主一生悔恨したとあった。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後再び東京へ転住したと聞いて、一度｜人伝に聞いた浅草の七曲の住居を最寄へ行ったついでに尋ねたが、ドウしても解らなかった。",
              "citation": {
                "source": "斎藤緑雨",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し今後何等かの事情で他に転住しなければならぬようなことがあるならば、私は恰も父祖伝来の墳墓の地を捨てて、遠い異国に移住する者の如き大なる勇気を要すると同時に、またその者と同じい深い離愁を味わわねばならないだろう。",
              "citation": {
                "source": "早稲田神楽坂",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに味をしめて、神田内に転住した時に、再び放火を企てた。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて旧臘中一寸申上候東京表へ転住の義、其後色々の事情にて捗どりかね候所、此程に至り諸事好都合に埓あき、いよいよ近日中に断行の運びに至り候はずにつき左様御承知｜被下度候。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御承知の通小夜は五年｜前当地に呼び寄せ候迄、東京にて学校教育を受け候事とて切に転住の速かなる事を希望致し居候。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏猿楽町二｜番地へ御転住になつたといふ事でございますから、一寸お家見舞にあがるんですが、どうも何も貴方のお座敷へ出すやうな話がないので、つい御無沙汰致しました。",
              "citation": {
                "source": "塩原多助旅日記",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "――拝啓、承り候えば、貴下も今回、故郷上州へ転住帰農遊ばされ候由、時節柄よき才覚と存じ上申候。",
              "citation": {
                "source": "わが童心",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、親戚や友人があちこちへ疎開転住をするけれど、自分は東京から草鞋をはく気持ちになれない。",
              "citation": {
                "source": "わが童心",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、昨年の三月故郷の村へ転住してからというもの、一回も魚類や油類の配給を受けなかった。",
              "citation": {
                "source": "岡ふぐ談",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月上旬に転住してきて以来、ただ僅かに一回、一人当たり生鰊が半身とお茶の葉が少量だけ。",
              "citation": {
                "source": "食べもの",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅痴は弘化三年丙午の冬下総飯沼にある同名の弘経寺に転住するに莅んで、「双林投老閲六年。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは僧位進んで小石川極楽水の是照院へ転住した。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "この中の慈眼院は深川から移つて来たもの、他の二つの寺院も都市の繁栄に連れて都心から転住して来たものではなからうか。",
              "citation": {
                "source": "巣鴨菊",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃あたかも故ありて上総の大原へ転住することとなり、そのままになったのであるが、どうしてもこの書に対する未練が棄てられかねて、やっと四円の金を工面し、在京の友人に托して買ってもらった。",
              "citation": {
                "source": "数学史の研究に就きて",
                "author": "三上義夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかして、このインディアンは、アジア地方よりベーリング海峡を渡り、アラスカ地方に転住せしとのことなれば、その像の起源は、わが国の天狗に関係あるやも知り難し。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝の雪畑を荒らすと思ふなよ生ひ立つ麦の根固めとなる苦にするな荒しの後に日和あり火に焼かれ風にたをされ又人に伐られてもなほ枯れぬ若桐伐ればなほ太く生ひ立つ桐林二一、バルレー村に転住す　十二日より英国地方の実況を視察せんために、ロンドンをさること北方二百マイル、リーズ市近在バルレー村に転寓す。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月十二日、英国北部バルレー村に転住せし以来、もっぱら民間の風俗、習慣、教育、宗教の状態を視察し、大いに得るところあり。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのせいばかりでもあるまいが、そういう騒ぎがあった半月ほど後、筆記によれば十月の四日、蘆屋道益は小田原の事業を人知れず手仕舞いにして、金｜筐と財宝を荷駄につけて京都へ転住を決行している。",
              "citation": {
                "source": "うすゆき抄",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地に住むものが一人も残らず、その土地を転住するとかなんとかでなければ、これを安寧に害ありと認めないのであるか」　正造の口調はまたしても激越を帯びてきた。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "流々転住　ここに哀れをとどめたのは、紐の男――仲間の宅助だった。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど、あの……新世帯みたいに」「流々転住の舟住居。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "つぎには、ごてんじゅうの役人をよびました。",
              "citation": {
                "source": "銀の笛と金の毛皮",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "このことは姓と結び合せて自分を宮城縣人と思ふ人もあるらしいが、たゞ生誕の地といふだけで、三ヶ月後には仙臺を去り、それから土木技師である父の轉勤につれて東京・神戸・熊本・博多・長崎と轉住した。",
              "citation": {
                "source": "自分のこと",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十五年より昭和八年に至る作品の中、天王寺墓畔、馬込緑ヶ丘、世田ヶ谷若林、砧村、此の四ヶ所に於ける、東京轉住以來の生活を主としたる短歌及長歌。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼時父母に伴はれて三重縣に轉住。",
              "citation": {
                "source": "「孔雀船」解説",
                "author": "中山省三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍人であり外交官でもあつた彼は、神戸の領事館に勤めてゐた時分に親しんだ女性に心惹かれて、彼女の故郷の徳島に轉住したのである。",
              "citation": {
                "source": "心の故郷",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
