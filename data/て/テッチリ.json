        "examples": {
          "standard": [
            {
              "text": "冬のボーナスが出たので、奮発して老舗の店で鉄ちりをいただいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "鉄ちりの締めは、フグの旨味が凝縮された雑炊に限る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "今夜は家族の祝宴なので、豪華な鉄ちり鍋を囲んで乾杯した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "いやそうばかりでもない、天青は倍くらい元気になった、金もなかなか持っているらしい、勘定で飲めるところは勘定で飲んだが、これまではいったことのない鉄ちり屋だの関東煮などの赤い大提灯のぶら下がった家などへもはいり、そこでは金を出してちゃんと支払いをした。",
              "citation": {
                "source": "陽気な客",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
