[
  {
    "uuid": "f05e5dfe-c994-58d9-b616-684a40c5478a",
    "entry": "手はず",
    "reading": {
      "primary": "てはず",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
