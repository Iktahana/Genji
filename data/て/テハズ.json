    },
    "definitions": [
      {
        "index": 1,
        "gloss": "arrangements",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "パーティーの手はずは整った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "全ての手はず通りに事が運んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は周到に手はずを整えていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "大学にはいって物理学を専攻する人はさらに深き第三段第四段の「理解」に進むべき手はずになっている。",
              "citation": {
                "source": "相対性原理側面観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "命は、かしこまって、「それでは、これからすぐにくだってまいります」とおっしゃって、急いでそのお手はずをなさいました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "若郎子はそれを聞くとびっくりなすって、大急ぎでいろいろの手はずをなさいました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この件については手はずが整えられていて、何か絞首台の代わりになる木材なり滑車なりを持ってきたのだと思われます。",
              "citation": {
                "source": "患者兼同居人",
                "author": "THE RESIDENT PATIENT",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こっちもする手はずなんだよ、坊や。",
              "citation": {
                "source": "グローリア・スコット号",
                "author": "THE \"GLORIA SCOTT\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "キングス・クロス近くの聖セイヴィアでして、そのあと聖パンクラス・ホテルで朝食を取る手はずでした。",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "君はあの若いご婦人を雇い入れ、そこへウッドリが口説きに来るという手はずだった。",
              "citation": {
                "source": "自転車乗りの影",
                "author": "THE ADVENTURE OF THE SOLITARY CYCLIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　この男の様子がずいぶん前のめりなので女中も怖くなり、すり抜けるようにいつも食事を渡す手はずの厩舎の窓のところへ駆けていった。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "月曜には一網打尽の手はずなのだ。",
              "citation": {
                "source": "最後の事件",
                "author": "THE FINAL PROBLEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国警察をも回避した氏は、我々の動向を絶えず仕入れていたその手はずを、さきほどまで手短に語ってくれていた。",
              "citation": {
                "source": "最後の事件",
                "author": "THE FINAL PROBLEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし殺害がルール関門で行われたものならば、そのような手はずの必要はなかったろう。",
              "citation": {
                "source": "マリー・ロジェエの怪事件",
                "author": "『モルグ街の殺人事件』続編",
                "note": "青空文庫"
              }
            },
            {
              "text": "小君の所へは昼のうちからこんな手はずにすると源氏は言ってやってあって、約束ができていたのである。",
              "citation": {
                "source": "源氏物語",
                "author": "帚木",
                "note": "青空文庫"
              }
            },
            {
              "text": "名高い秋篠寺のそれとは異つて、これは定つた型のやうに左手に天華を捧げ、右手はずつと膝に垂れて、心もち裾をからげてゐる。",
              "citation": {
                "source": "西大寺の伎藝天女",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お手はず万端整いましてござります」　やがてのことに、ご奏者番からご老中職へ、ご老中からご公方さままで、道々のご警備その他ぬかりのない旨、ご言上が終わると、「お成りイ――」　の声があって、ご開門と同時にお出ましがかっきり明け七ツ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "とした元氣で、すぐ地主に掛け合ふことに、手はずがきめられてしまつた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、警察では、こんど、三人が何処かの邸宅にはいって宝石を盗んだならば、すぐこの根城を襲って彼等を取り押える手はずになっていたのであります。",
              "citation": {
                "source": "稀有の犯罪",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "左手はずっと砂丘つづきで、ぼんやり灰色にかすんでいる。",
              "citation": {
                "source": "静かな日曜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "心細いこの山荘にいて源中納言だけを唯一の庇護者と信じてたよる心のある女房たちは、弁からの話を聞いて、この結婚を成立させることほどよいことはないと皆言いあわせ、どんなにしても姫君の寝室へ薫を導こうと手はずを決めていた。",
              "citation": {
                "source": "源氏物語",
                "author": "総角",
                "note": "青空文庫"
              }
            },
            {
              "text": "足し引きに加え、掛け算や割り算の機能を備えた計算機作りに取り組んでいたウォズニアックを見て、マッカラムは軍用の電子装置を作っていた会社のコンピューター室で勉強できるように、手はずを整えてくれた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "天子さまの仰せ付けを受けますと、田村麻呂はかしこまって、さっそく兵隊を揃える手はずをしました。",
              "citation": {
                "source": "田村将軍",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "手はずしてあった個処で、合図を忘れるので、ファン連は、困りきって、演説を暗誦しておこうと努力したが父は面倒くさがっていた。",
              "citation": {
                "source": "大丸呉服店",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "「用と言うほどの用じゃないが、今夜の手はずも、まだ聞かないからな。",
              "citation": {
                "source": "偸盗",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「なに、手はずに変わりがあるものかね。",
              "citation": {
                "source": "偸盗",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時も早く東京へ帰って、何彼の手はずを極めねばならぬ。",
              "citation": {
                "source": "書記官",
                "author": "川上眉山",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、今となっては、彼自身の意志｜如何にかかわらず手はずは進められているのであった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジプシーのような、脊の低い区役所の吏員が、帳面と引合わせて、一人一人罹災民諸君を呼び出すのを、僕たちが一枚一枚、猿股を渡すという手はずであった。",
              "citation": {
                "source": "水の三日",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんぼ春だと云うて御主のはげはやっぱりかがやいてあるのに、口元に関所を置いてとび出すならずものは遠慮なくからめとる様に手はずをなされ――そう思わぬか？",
              "citation": {
                "source": "葦笛（一幕）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "執行官は、手はずのとおり、死刑囚の死体をおろすように信号を送った。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしもこの怪女がへんな行動をしそうだったら、ただちにとりおさえる手はずになっていた。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が結婚致しましたのは、松江に来てからのことで、二十四の秋でございますから、当時としてはずいぶん遅い結婚でございました。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
