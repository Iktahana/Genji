        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "けれども将軍家は、例のあの、何もかも御洞察なさつて居られるやうな、また、なんにもご存じなさらぬやうな、ゆつたりした御態度で、すこしお笑ひになつて、世ヲ捨テタ人ノオ気持ハ　と更にお尋ねになりました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ忙シイあなたニコンナ無遠リョヲカケテタイヘンスマナク思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノライヌメガ　ウルサク　ツイテ　キタノデ、タニガワヘ　ホリコマウト　イツテタンデスヨ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トテチテタアをきいたら、みんな、ほれ報恩講がはじまると思って出かけりゃええ。",
              "citation": {
                "source": "ごんごろ鐘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と、思う胸騒ぎを、じっと抑えて、読み下すと、アスマデニ三〇〇エンツゴウシテクレ、イノチガケニテタノム、アネ　と、いう電文だった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなときに後からくっ付いて行って膝の上へ乗ると、大変な目に逢わされるから、そっと庭から廻って書斎の椽側へ上って障子の隙から覗いて見ると、主人はエピクテタスとか云う人の本を披いて見ておった。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "エピクテタスにそんな事をしろと書いてあるのか知らん。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾輩は猫だけれど、エピクテタスを読んで机の上へ叩きつけるくらいな学者の家に寄寓する猫で、世間一般の痴猫、愚猫とは少しく撰を殊にしている。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "エピクテタスなどを鵜呑にして学者ぶるよりも遥かにましだと思う。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "米人ノ「デモクラシー」トハ社會ハ個人ノ自由意志ニヨル自由契約ニ成ルト云ヒシ當時ノ幼稚極マル時代思想ニヨリテ、各歐洲本國ヨリ離脱シタル個々人が村落的結合ヲナシテ國ヲ建テタル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者様――アノ鯉幟ノ棹ハ、私ガ酔ッタ勢イデ立テタモノデスガ、ソレガ記者様ノオ眼ニ止マッテ、コンナ不孝ナ恥ヲ晒ソウトハ夢ニモ思イマセンデシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　八代龍太へ――「ヘンジデンニテタノム」（一九三三、十、十九、相州夜見村にて）",
              "citation": {
                "source": "水車小屋の日誌",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イアイダ、タベモノヲ見タコトモナカッタトコロヘ、ハジメテソウシキノオソナエモノヲミルト、モウ矢モタテモタマラズ、目ガクラクラットシテ、ソレニ小サイ弟ヤ妹ナノデ、死ンダオ母ッチャニワルイトオモイナガラ、スキヲネラッテ、ミンナデムチュウニナッテタベテシマッタンダッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "チッテ、チッテタ、トッテッ、チッチッ、トッテッチ」　ところが、みっちゃんの方は、朝、目をさまして見ると、リボンと鉛筆とナイフとだけしかありませんでした。",
              "citation": {
                "source": "クリスマスの贈物",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃になっては身体の動きのとれない事は段々甚しくなるが、やや局部の疼痛を感ずることが少くなったので、復た例の写生をして見ようかと思いついてふとそこにあった蔓草の花（この花の本名は知らぬが予の郷里では子供などがタテタテコンポと呼ぶ花である）を書いて見た。",
              "citation": {
                "source": "病牀苦語",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして赤椿黄色山吹紫ニムレテ咲ケルハタテタテノ花という一首の歌を書きその横に年月を書き、それで出来上った。",
              "citation": {
                "source": "病牀苦語",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "このタテタテの花というのは紫色の小さな袋のような花で、その中にある蕊を取ってそれを掌の上に並べ置き、手の脈所のところをトントンと叩くとその小さな蕊が縦に立って掌にひっついて居るのが面白いので、子供の中にこの花を見つけるといつでもこういう遊びをして居たのである。",
              "citation": {
                "source": "病牀苦語",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄サンガ何故殺害サレタカ分リマセンガ、其ノ殺害ヲ一番早ク云イ当テタノハ動坂三郎氏デス。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ亦ラジオヲ以テ長年ノ趣味トスルモノニシテ、予ガ組立テタル愛機『スーパーヘテロダイン』ヲ携エテ今回｜此途ニノボレリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワレワレ通信技術者ガワレワレノ組立テタ器械ニヨッテ放出シテイル通信用電波ノ外ニ此ノ空間ニハ現ニ多種多様ナ未知ノ電波ガ飛ビ交ッテイルノダ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はエピクテタスやトマス・ア・ケンピスなどのように天の感じを文章の味に泌み出させようと努めました。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "北海道ハ、タイヘン寒イトユフコトヲキイテタマゲマシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると、急に娘の言葉が甘ったるくなって、「ねえ、マドロスさん」「エ」「そんなに苛めなくてもいいことよ」「ワタシ、チットモ、アナタイジメルコトアリマセン、アナタ可愛クテタマラナイデス」「可愛がって頂戴。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "二カハイイ　山羊サン　ハオヒゲ　ガ生エテタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは実際｜詐りなくウルサクテタマラナイ存在ですから。",
              "citation": {
                "source": "帆影",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムクンガアンマリサワグノデ、マタタロー　　サンニシカラレマシタ、ガマタ　スグウレシクテタマラナイノデサワギダシマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "貝塚ハ石器時代人民ガ食余ノ貝殼ヲ捨テタル所、竪穴ハ石器時代人民ガ住居セシ跡ナル事、是等ノ中ヨリ發見サルヽ遺物ニ由リテ推知スルヲ得ベシ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリストや釈迦は云ふに及ばず、ヱピクテタスも、アウガスチンも、スピノザも、ライプニツツも、カントも、ヒユームも、ロツクも、ミル、シヨウペンハウエルも。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "「セミマルノオカミトジョチュウ、ヨテイノトオリ、イチバンニテタツ」　巨勢博士はつぶやいた。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "知られているうちでもっとも恐ろしいは破傷風すなわちテタヌスであって1884年にニコライエル（1862-1942）が発見したものである。",
              "citation": {
                "source": "簡約医学史",
                "author": "A Concise History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
