        "examples": {
          "standard": [
            {
              "text": "Ｔ字路を左に曲がると、目的のスーパーがすぐに見えてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "夜間のＴ字路で一時停止を怠り、対向車と接触しそうになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "古い住宅街のＴ字路の角に、何十年も続く豆腐屋が店を構えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "目的の家はＴ字路の一角に建った格子造りの二階家だった。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
