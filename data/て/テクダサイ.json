        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "絵ヲ、ミセテクダサイ。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナツマラナイ素描帳ヲ見テクダサイト言ウノハタイヘンツライノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハヤク、タスケニ、キテクダサイ。",
              "citation": {
                "source": "瓶詰地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ビョウキシテ、コマッテ、イルカラ、三円クメンシテ、オクッテクダサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノアイダ、オクッテ、クダサッタ、ハナノクスリ、オツイデノトキニ、スコシオクッテクダサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノアイダ、オクツテ、クダサツタ、ハナノクスリ、オツイデノトキ、スコシオクツテクダサイ、センジテノムト、ノボセガ、ナオツテ、カホリガ、ヨロシイ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――ライヨウマルノコトヲ、オモイダシテクダサイ。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……中に、ステパンの会話の力で判断してだろう、片仮名で、「オナツカシキペテロフサマ、ソノゴオカワリモアリマセンカ、ユウベ、マテイタノニキテクダサイマセン、ナゼデスカ、シドイシト、ワタシノココロモシラナイデ。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "親類中　ノ山羊サンタチ　ヘ大事件、スグニ来テクダサイ　トネ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その葉書には、いつものように、ゼヒゼヒイラシテクダサイ、オマチシテオリマス……と書いてあったのです。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、その瞬間、また突然頭に閃いたのは、ゼヒゼヒイラシテクダサイ、オマチシテオリマスという葉書も、そのまた前の葉書も手紙も、ことごとく東京で、ジーナやスパセニアの姿を見た以前のものばかりで、それ以来は何にも受け取っていないということだったのです。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、吉雄さんは、もし自分が番をしなかったら、だれか、考えなしに、この家の前で、大きな声を出して、正ちゃんの目をさまさないものでもないと考えたから、大急ぎで、自分の家へ帰って、半紙に、「コノ家ノ、小サイ正チャンガ、ビョウキデスカラ、シズカニ前ヲトオッテクダサイ。",
              "citation": {
                "source": "幼き日",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カアサマ、ボクヲ、カイモドシテクダサイ。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "民部サマカラ若君ヘ申シアゲテクダサイマシ。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノナマエモ、Ｒトシテクダサイ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
