          "literary": [
            {
              "text": "電火、地火、劫火、敵火、爆火、手一つでも消しますでしゅ、ごめん。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵火の下ではたちまち混乱に陥ることは明らかであり、また地形の影響を受くる事は極めて大きい。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            }
          ]
