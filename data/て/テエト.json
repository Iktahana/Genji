        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自分はナシヨナル博物館で伊太利や西班牙の昔の諸大家の絵を観、テエト博物館で英国近代の名家の絵を観た事に幸ひを感じた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロセツチ初めラフアエル前派の逸品や、数室に亘るタアナアの大作などは到底テエト博物館ならでは観難い物である。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナシヨナル、テエト、サウスケンシントンの三大博物館を観たことは就中感謝せざるを得ない。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「彼」にステエトメントをしようと思う。",
              "citation": {
                "source": "青べか日記",
                "author": "――吾が生活　し・さ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
