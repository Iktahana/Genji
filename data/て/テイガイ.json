[
  {
    "uuid": "529d84b7-5c95-5390-8901-c9e4c74ae62d",
    "entry": "丁亥",
    "reading": {
      "primary": "ていがい",
      "alternatives": [
        "ひのとい"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
