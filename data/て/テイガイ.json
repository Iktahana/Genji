      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "Fire Boar (24th term of the sexagenary cycle, e.g. 1947, 2007, 2067)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は丁亥の年に生まれ、穏やかな性格だと母は言っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "丁亥の年は、干支の組み合わせとしても珍しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "祖父は、丁亥の年に新しい事業を始めたそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "二十年（丁亥）　一八八七○三月、中村福助の人気頂上に達し、新富、市村、千歳の三座かけ持ちにて出勤。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六日、丁亥、天晴、安念法師の白状に依りて、謀叛の輩を、所々に於て生虜らる、凡そ張本百三十余人、伴類二百人に及ぶと云々、此事、濫觴を尋ぬれば、信濃国の住人泉小次郎親平、去々年以後謀逆を企て、輩を相語らひ、故左衛門督殿の若君を以て大将軍と為し、相州を度り奉らんと欲すと云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二日、丁亥、晴、寅刻地震。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十日、丁亥、晴、晩頭将軍家桜花を覧んが為、永福寺に御出、御台所御同車、先づ御礼仏、次に花林の下を逍遥し給ふ、其後大夫判官行村の宅に入御、和歌の御会有り、亥の四点に及び、月に乗じて還御。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三日、丁亥、将軍家海辺の月を御覧ぜんが為、三浦に渡御、左衛門尉義村殊に結構すと云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "正保四年｜丁亥十二月｜朔日興津弥五右衛門景吉｜華押　　　　興津才右衛門殿　正保四年十二月二日、興津弥五右衛門景吉は高桐院の墓に詣でて、船岡山の麓に建てられた仮屋に入った。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十年丁亥、四十一歳。",
              "citation": {
                "source": "能久親王年譜",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜野氏所蔵の「朴斎詩鈔初編」に拠るに、朴斎は文政庚辰より丁亥に至る八年間、菅氏の養子になつてゐた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「丁亥元日、客歳冬暖、園中梅柳、頗有春色、故詩中及之。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "歳首の二篇は集に「元日二首、丁亥」と題する作で、上にわたくしの句を摘んだものと同じである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その百七十六　菅茶山の丁亥歳首の書には、蘭軒の家族四人を除く外八人の名が見えてゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "客歳は此年丁亥で、其十一月に榛軒信厚は長女をまうけた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは此の如くにして、榛軒の婦を迎へた時の、此年丁亥正月なるべきことを推定した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "是に由つて観れば丁亥に来り嫁した新婦は横田氏勇であらう。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘭軒の書が丁亥の三月二十二日のものであつたことは、丁亥三月既望の詩を寄示したるに由つて知ることが出来る。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして既に此書が丁亥の書なるを知れば、榛軒の星期が丁亥の初にあつたことも亦自ら明になるのである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "脈式の序は末に「文政丁亥清和月伊沢信恬記」と署してある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "関藤々陰の「菅自牧斎先生墓碣銘」に「茶山先生以儒顕、本藩賜爵禄優待之、比歿、樗平君子孫独先生（自牧斎惟繩）在焉、以姪孫承其後、主郷校、藩給廩米五口、事在文政丁亥」と云つてある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁亥に生れた女子はその何人なるを詳にしない。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁亥に生れた女子は名をれんと云つたさうである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "文政十一年の蘭軒歳首の詩は、前年丁亥の事を叙せむがために、上に其註を引いたが、今此に全篇を録する。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "又文政辛巳と丁亥とには、平生多く詠物の詩を作らぬのに、草花を詠ずること前後十六種に及んだ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "家譜に「文政十丁亥八月十五朝出生、名俶、よし、小久原権九郎奥方幼名を贈らる」と云つてある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "十年丁亥　平八郎三十五歳。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "『新唐書』玄宗本紀に、天寶元年二月丁亥、群臣上尊號、曰開元天寶聖文神武皇帝。",
              "citation": {
                "source": "創建清眞寺碑",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、明治二十｜丁亥年六月二日。",
              "citation": {
                "source": "念珠集",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "天武紀に、七年夏四月、丁亥朔、欲幸斎宮、卜之、癸巳食卜、仍取平旦時、警蹕既動、百寮成列、乗輿命蓋、以未及出行、十市皇女、卒然病発、薨於宮中、由此鹵簿既停、不得幸行、遂不祭神祇矣とある。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "台石の横側に、○永四歳（丁亥）十月二日と彫ってある。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにをいうにも狭いところに大勢ごたごたしているのと、他の人達はみな自分たちが係り合いの踊り子にばかり気を配っていたのとで、おていがいつの間にどうしたのか誰も知っている者はなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "少年少女の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村さんが、きみをしんようしているのをいいことにして、ふたりの子どもをさらってしまったのだ」　あけちたんていがいいますと、四十めんそうの林さんはせせらわらって……。",
              "citation": {
                "source": "ふしぎな人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
