        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "手の筋肉に疲労が残っている。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手の筋肉に疲勞が殘つてゐる。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――恐れ入りますが、先生の手の筋を拝見さして頂き度いのですが………記念の為めに」　余り宮坂の唐突な言葉に景子もやや呆れた。",
              "citation": {
                "source": "ガルスワーシーの家",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮坂のそのあまり熱心な様子が夫人に却って気軽な興味を覚えさせたらしく、夫人は一層乗出して来て夫の手の筋の説明を求めた。",
              "citation": {
                "source": "ガルスワーシーの家",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついぞ、おいでになりもせぬのに、そんなことが、といいますとね、手をお出しさない、手の筋を見てあげましょう。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……お庇でね、おおん、お庇もおかしいですが、手の筋で、妻と握合いました。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハハハ、お手の筋だ。",
              "citation": {
                "source": "貧乏",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、察するに鷹揚なところを見ると、その子せがれは万事がきっと上品で、顔なぞも割合にやさ形だな」「お手の筋、お手の筋。",
              "citation": {
                "source": "右門捕物帖",
                "author": "青眉の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほしが当たったらしいな」「お手の筋、お手の筋。",
              "citation": {
                "source": "右門捕物帖",
                "author": "笛の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "このお位牌もお武家筋、おまえの手の筋もお武家筋、――やまがら使いじつは武家の娘、ゆえあって世間を忍ぶかりの姿のお駒とにらんだが、違うかえ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "やまがら美人影絵",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し其の次の日は過激な勞働から俗にそら手というて手の筋が痛んだので二三｜日仕事に出られなかつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "朽ちた低い竹の垣根は其の強い手の筋力を以て破壤するに何の造作もない筈であるが、手の先端を觸れしめることさへ出來ないで居るのである。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お手の筋」だとでも云いたい程適中したので、末造はぎくりとしたが、反対に呆れたような顔をして見せた。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうだい、お手の筋だろう」「楽屋番さんにして置くのは惜しいね」「売卜者になっても見料五十文は確かに取れる」と、豊吉はいつもの癖でそり返って笑った。",
              "citation": {
                "source": "両国の秋",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "両国橋が御普請だというので、どんな様子か拝見に出て来たんですよ」「と云うのは、世を忍ぶ仮の名で、占い者にお手の筋を見て貰って……。",
              "citation": {
                "source": "半七捕物帳",
                "author": "金の蝋燭",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷物の行く先はお手の筋やさかい……」　そんな事をつぶやくうちに千六はもう二十日鼠のようにクルクルと活躍し初めていた。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは土曜日の日記の中に、「平日の課業を正直にすませ、満足に事務を取り、温かき晩餐ののち、その日の新聞をよみ終はりて、さて一日の反省になんらもだゆることなく、安息すべき明日の日曜を思へば、テニスの運動の影響とて、右手の筋肉の筆とるにふるへるのほかたえて平和ならざるなし」と書いた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ご覧の通りの旅侍さ」「ちっとばかり骨がありそうだね」「アッハッハッハッ、そう見えるかな」「容易に金は置いてはゆくまい」「お手の筋だ。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホ、ホ、ホ、ホ、お手の筋だろうねえ」　女の声は暫く絶えた。",
              "citation": {
                "source": "天主閣の音",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「お手の筋でさあ。",
              "citation": {
                "source": "助五郎余罪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ははは、こいつあお手の筋だ」「まあ、そんなところかね」「他人ごとみてえにいってやあがる。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯灌場買いね」「口が悪いな」「ほほほ、けどお手の筋でしょ？",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "手の筋肉は疲れないですんだ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッハハハ、お手の筋だ。",
              "citation": {
                "source": "村井長庵記名の傘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「へい、お手の筋でございます」「ううむ、そうか、鼓賊であったか」「相済みませんでございます」「おれに謝る必要はない」銀之丞は笑ったが、「どうだ鼓賊、儲かるかな？",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "火難、盗難、待ち人、失せ物、お手の筋から人相家相、嫁取り婿取り養子の口、昨夜の夢見がどうだとか明日の天気はこうだとか、ないしは狐狸の憑から天狗様の祟りまで、聞かしてやろうってえ心意気さ！",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「うっかり俺が礼を云うと、そこへお前は付け込んで、口説くだろうと思うからさ」「お手の筋よ」と組紐のお仙、面白そうに笑ったが、「相変らずの宗さんね。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
