    },
    "definitions": [
      {
        "index": 1,
        "gloss": "teriyaki (meat or fish marinated in sweet soy sauce and broiled)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日の夕食は、熱々の「照り焼き」ハンバーグだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は日本食の中でも特に「照り焼き」チキンが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お弁当には、甘辛い味付けの「照り焼き」が入っていると嬉しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "また赤蛙の照り焼きは、牛肉よりもおいしいと思ってきたのである。",
              "citation": {
                "source": "ザザ虫の佃煮",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "刺身、塩焼き、照り焼き、潮汁、うま煮など。",
              "citation": {
                "source": "魔味洗心",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、山鯨のすき焼き、なめくじらの照り焼きなどは大そうおいしいけれど、海豚の肉はどうも感服しかねる。",
              "citation": {
                "source": "海豚と河豚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで料理屋はこれにタレをつけて照り焼きに仕上げるのである。",
              "citation": {
                "source": "インチキ鮎",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "醤油をつけて照り焼きなどにすれば、醤油の香りや味醂に邪魔され、その天稟の香気は、たちまち滅してしまう。",
              "citation": {
                "source": "鮎を食う",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお、ついでだから言うが、岐阜のような鮎どころでは、客の顔をみると、待ってましたとばかり、その鮎を塩焼き、魚田、照り焼き、煮びたし、雑炊、フライと、無闇に料理の建前を変えて、鮎びたりにさす悪風がある。",
              "citation": {
                "source": "鮎を食う",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "甘だいの大きな照り焼きの残ったものなど、菜っ葉や豆腐といっしょに煮て食べるといったように、一家を楽園にする道もある。",
              "citation": {
                "source": "残肴の処理",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "四、五寸のものを丸ごと照り焼きにして、皿に盛る際、頭と尾を切り落とし、棒状形にして膳にのぼす。",
              "citation": {
                "source": "一癖あるどじょう",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "男だって、鮎は照り焼きにかぎるとか、にしんや棒だらなんて人間の食うもんでない肥料だ、なんていう向きもなきにしもあらずだから。",
              "citation": {
                "source": "鮪を食う話",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きの悪いのは照り焼き。",
              "citation": {
                "source": "料理メモ",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも照り焼きになるのが嫌いで命乞いに来たのだろうか」と、神秘的なことをいう。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "乱視の奈翁　――アルル牛角力の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎の掛け物に、置き物は竜を置いたり、うなぎの蒲焼きと一緒にはもの照り焼きを出してみたり……すべて調和か統一かが大切だ。",
              "citation": {
                "source": "梅にうぐいす",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "サラダ付きの照り焼きチキンはどう？",
              "citation": {
                "source": "四風の街",
                "author": "The Street of Four Winds",
                "note": "青空文庫"
              }
            },
            {
              "text": "わらさの照焼はとにかくとして、ふっと煙の立つ厚焼の玉子に、椀が真白な半ぺんの葛かけ。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と心得たもので、「照焼にして下さい。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「照焼にせいという、お誂ですがなあ。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理は鮪の刺身、照焼の魚、鴫焼の茄子、ひややつこ、薩摩汁などに候ひき。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "良吉は、飯の時に新らしい魚をつけろの、好い酒を燗しろのと云って居たけれ共、長火鉢の傍にそろった四つの膳は至極淋しいもので「鰤」の照焼に、盛りっきりの豆腐汁があるばかりであった。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大豆のみにて製したればその味濃厚にて刺身照焼煮物等によし。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ほんのり赤味を帯びた鱒の照焼きや鶉の料理に舌鼓をうたせながら謎のような眼つきをして、自分に媚る若い男の囁きに耳を傾けていたらばなどと、例の空想をほしいままにしながら夫の言葉など上の空できき流していた。",
              "citation": {
                "source": "頸飾り",
                "author": "モウパンサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方がないから誂えに往くと間もなくお椀に塩焼とか照焼が来ます。",
              "citation": {
                "source": "霧陰伊香保湯煙",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事は一汁一菜と定っているが客膳には、なにかほかに一と皿付く、そのとき平八の膳には、なにかの切身の照焼が付いていた。",
              "citation": {
                "source": "花も刀も",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚をさいたり、蛇をさいたり、イナゴのテリヤキ、なんでもできますよ」「そんな荒つぽい料理はいけない」「いえ、学問の精神は応用の心がまへなんで、わけはないです」「心がまへと経験は違ふよ。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕がいちばん好きなのはテリヤキ・チキンだ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "存分に大きいチキンのテリヤキに、あの味の濃いまっ茶色のたれ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてテリヤキ・チキンの隣に、容器を叩きつけるようにして盛る。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブロイルド・テリヤキ・バターフィッシュ。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "テリヤキ・ステーキ。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マカロニ・サラダにテリヤキ・チキンか。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "中に入ってテリヤキチキンバーガーとモスチーズバーガーを注文し、オレンジ色の番号札をもらって空いているスツールに坐り、ハンバーガーが焼き上がるまで待った。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
