        "examples": {
          "standard": [
            {
              "text": "この棒は先端に向かって緩やかにテーパーがついている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "家具の脚に美しいテーパー加工を施す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "瓶の首の部分には、なめらかなテーパーがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "端から端まで二メートル弱、中央部の直径一メートル強、両端はテーパ状に三十センチまで細まる。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "筋肉質をした一・二メートルの腕、徐々にテーパし、径は基部十一センチ先端部六センチ。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "海星形構造の内角からは六十センチの赤い管が生え、徐々にテーパし、径は基部八センチ先端部三センチ。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
