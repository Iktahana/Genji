          "literary": [
            {
              "text": "テルシテス、ツォイロスの合体いやはや。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに容貌醜悪なテルシテスと雖も、我々と同じ人間である以上、憐愍の情を起さずには居られないと云う議論なんだ。",
              "citation": {
                "source": "金色の死",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きて居てさえ可笑しなテルシテスの顔が滅茶々々に叩き潰されて血だらけになって蠢いて居る所を想像すると、実際滑稽に思われるじゃないか。",
              "citation": {
                "source": "金色の死",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
