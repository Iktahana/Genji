        "examples": {
          "standard": [
            {
              "text": "週末に家族と天文館へ行き、美しい星空を鑑賞した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "天文館のプラネタリウムで、宇宙の壮大さに感動した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは天文館の体験プログラムで、宇宙について楽しく学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その四五日前、私は「ダイス」のマダムから四ツ橋の天文館のプラネタリュウム見物を誘われた。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿は九州の縣知事が集まるといふので、一日で追はれて、天文館通りに近い、小さい旅館に變つた。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕暮れの通りを、賑やかな天文館通りへ出て、富岡は、映画館の一つ一つを眺めてまはつた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
