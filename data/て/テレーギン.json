        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "話し声がきこえて、庭の奥から、散歩帰りのセレブリャコーフ、エレーナ、ソーニャ、テレーギンが出る。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン　すばらしい眺めですよ、御前さま。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギンはテーブルに近づき、乳母の傍に坐る。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン　ねえ、マリーナさん。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン　（泣き声で）ワーニャ、それを言わないでおくれよ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン　まあ、お聞きよ、ワーニャ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン　サモワールの温度は、非常に低下しております。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン　失礼ですが……。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……イリヤ・イリイーチ・テレーギン、一名、ワッフルと申しますのは、このとおりのあばた面だもので、口の悪い人がつけた仇名なのでございます。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーニャ　テレーギンさんは、よく私たちの仕事をすけてくだすって、大切な片腕なんですのよ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……テレーギン、ギターの調子を合せる。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……鴉にさらわれなけりゃいいが……（退場）テレーギン、ポルカを弾く。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人とテレーギンが、テーブルのそばに残る。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（二人、家の中へ消える）テレーギン、ギターの弦を打って、ポルカを弾く。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとからテレーギンが、ギターをかかえて出る。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン　皆さん、おやすみじゃないか。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン、そっと弾く。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（テレーギンに）ワッフル、弾けよ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン　そりゃ、あんたの頼みだから、わたしゃ喜んで弾くけどね、まあ考えてもごらん、――家じゅうみんな寝てらっしゃるじゃないか。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギンあとに従う）ソーニャ　まあ、ワーニャ伯父さん、またドクトルとお飲みになったのね。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "セレブリャコーフ、ソーニャ、テレーギン、マリーナ登場。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン　閣下さま、わたくしもどうやら、からだの具合がはっきり致しませんです。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "セレブリャコーフ　（テレーギンに）からだの具合のわるいのは、なんとかまだ我慢のしようがあるが、この田舎の暮しぶりときた日にゃ、わたしにはまったく歯が立たんね。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでこの際、世情に通じておられる皆様の知恵を拝借せずには、とても切り抜けることができないので、ワーニャ君をはじめ、そこにおられるテレーギン君にも、またお母さん、あなたにも、どうか相談に乗って頂きたいのです。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（間）テレーギン　（はらはらして）御前さま、わたしは学問というものにゃ、ただ敬意を抱いているばかりじゃござんせんで、何かこう、親しみとでもいったような感じを抱いておりますので、はい。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン　（はらはらして）ねえワーニャ、およしよ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン　およしよ、ワーニャ、およしよ……。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギン　聞いちゃいられない……聞いちゃいられない。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレーギンとマリーナ、向い合せに腰かけ、靴下の毛糸を巻いている。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
