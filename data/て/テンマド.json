[
  {
    "uuid": "3a440324-97ab-561b-a451-fe18ab94ae76",
    "entry": "天窓",
    "reading": {
      "primary": "てんまど",
      "alternatives": [
        "てんそう"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
