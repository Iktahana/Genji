      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "descendant of a god",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "伝説によると、この地の支配者は天孫の末裔として民衆から崇められていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "天孫が天から降り立ったとされる山には、今も荘厳な神社が建っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は神話に登場する天孫の物語を読み、古代日本への想像を膨らませた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "天孫民族が渡って来た頃の本土のさま、また朝鮮の一民族が移って来た頃の武蔵野のさまを想像する参考になりそうである。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だが、出雲系と天孫民族とはどうしても僕も同種属ではないと思う。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを人類学的に分類致しますと、「アイヌ型」「コーカサス型」「モンゴリア型」「天孫型」「アレイ型」なぞの数種になる。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ず天狗道の開山として、天孫を導き奉った猿田彦の尊の流れとしては、鞍馬山の大僧正が何といっても日本天狗道の管長格でありましょう。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ一、二例を挙ぐると、『古事記』に、天孫降下の折随い参らせた諸神を列ねて、天児屋根命は中臣連等の祖などいった内に天宇受売命は猿女君の祖で伊斯許理度売命は鏡作連の祖と書いた。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ昔天孫降下ましましし時、衢神猿田彦大神長さ七｜咫の高鼻をひこつかせて天の八達之衢に立ち、八十万の神皆｜目勝って相問を得ず。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "此神果して天穗日命の孫ならんには年代合はざるの嫌あれど、出雲國造系圖、中臣系圖、舊事紀の天孫本紀、物部、尾張二氏の系圖すべて帝系に比しては、太だ世數の少きを常とすれば、伊佐我命の年代も必ずしも天穗日命を標準とすべからず。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "舊事紀天孫本紀に出石心大臣命あり此命は固より田道間守と何の縁故もあるにあらざれども、出石心といへることが人名として用ひられたる例とする事を得べし。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "心は紀の神代卷に田心姫とある例にて、牛利に當るを得べければ、天孫本紀とは別人としても出石心、即｜都志牛利といふ人名は、有り得べし。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "大雷の後胤は、出雲氏となって出雲に伝わり、出雲朝廷から天孫に仕え、さらに子孫相継いで大和朝廷に歴仕した。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々が新聞や演説に常に天孫民族ということを聞くは、あたかも排外的米人がアングロ・サクソン民族とかノールディックとかを振りまわすように、耳ざわりとなるほど多いのである。",
              "citation": {
                "source": "民族優勢説の危険",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "天孫を記念するささやかな碑がある。",
              "citation": {
                "source": "高千穂に思う",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "之は大和朝廷の天孫民族にも知られてゐなかつたし、先住民族の土蜘蛛やアイヌ族にも知られてゐなかつた。",
              "citation": {
                "source": "淡路人形座訪問",
                "author": "竹内勝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "事代主が天孫の使ひに留守をあけて、美保の崎に出かけて居たのは、此事の為だと謂はれて居る。",
              "citation": {
                "source": "鷹狩りと操り芝居と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本紀にも見えて居るが、国語表現をしてゐる古事記の方が、もつと我々には近しい親しみを持たせるから、其天孫降臨のくだりを引く。",
              "citation": {
                "source": "日本文学における一つの象徴",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうした意味から考へると、日本紀天孫降臨章にある、天孫又問曰、其於秀起浪穂之上、起八尋殿而、手玉玲瓏織※之｜少女者、是誰｜之女子耶。",
              "citation": {
                "source": "たなばたと盆祭りと",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとといひ、玉のみすまるといひ、すべて、天孫降臨の章の説明になるではないか。",
              "citation": {
                "source": "たなばたと盆祭りと",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "天孫又問ひて曰はく、「其秀起たる浪の穂の上に、八尋殿起てゝ、手玉もゆらに織※る少女は、是誰が子女ぞ。",
              "citation": {
                "source": "水の女",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "天孫降臨の時、真床襲衾を被つて来られたとあるが、大嘗宮の衾も、此形式を執る為のものであると思ふ。",
              "citation": {
                "source": "古代人の思考の基礎",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "神武天皇の大和入りより前に、既に降つてゐて、天孫は御一人である筈なのに、神武天皇の大和入りの時に、ひよつくり出て来て、弓矢を証拠に、天から降つたことを主張してゐる。",
              "citation": {
                "source": "古代人の思考の基礎",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "天孫降臨の章は、大切な所であるが、尚、古事記・日本紀・日本紀一書皆、おなじ言葉の伝へが、区々である。",
              "citation": {
                "source": "古代人の思考の基礎",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本紀は、漢文で書いたものであるが、其天孫が、日向へ下られた道筋の大切なところは、日本語でうつしてゐる位である。",
              "citation": {
                "source": "古代人の思考の基礎",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで協力して、天孫降臨以前の葦原の中つ国を作つたといふ。",
              "citation": {
                "source": "古代人の思考の基礎",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も此｜天窟戸の物語を中心にした鎮魂の呪言に、其誘因として語られた天つ罪及び祓へ・贖ひの起原を説く物語、更に魂戦の女軍の由来に関聯した天孫降臨の大事などが、一つの体系に組織だてられて来た。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "開闢の叙事詩よりも、天孫降臨を主題とする呪言の、栄えて行くのは当然である。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "天孫降臨を主題にした叙事詩は猿女系統の口頭伝承に根ざしてゐるのである。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬へてみますと、天孫降臨の処に日本紀では二通り――古事記では一通りです――書き方に違つた処があります。",
              "citation": {
                "source": "国語と民俗学",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "天孫が降臨せられる処に、「｜立於浮渚在平処」と言ふ文句があるのです。",
              "citation": {
                "source": "国語と民俗学",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "みことをお出しになるのは、神がもとであるから、最初のみこともちは、天の命令で此土地に出て来られた天孫すめみまであらせられる。",
              "citation": {
                "source": "古代中世言語論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
