[
  {
    "uuid": "e65eb5d0-c790-5ec8-88f4-4c60d18a7aa3",
    "entry": "天孫",
    "reading": {
      "primary": "てんそん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
