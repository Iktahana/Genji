      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "達者ニ在ッテハ何ゾ必ズシモ其｜遽カニ至ルヲ驚カン哉。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田ノ詮議モ終ラヌサキカラ、ソノヤウニ騒ギタテテハ、モノノ順序ガドウナリマス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "太宰イツマデモ病人ノ感覚ダケニ興ジテ、高邁ノ精神ワスレテハイナイカ、コンナ水族館ノめだかミタイナ、片仮名、読ミニククテカナワヌ、ナドト佐藤ジイサン、言葉ハ怒リ、内心ウレシク、ドレドレ、ト眼鏡カケナオシテ、エエト、ナニナニ？",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "流レ、澱ミテ淵、怒リテハ沸々ノ瀬、懸リテハ滝、果ハ、ミナ一。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリツク怒濤、実ハ楽シキ小波、スベテ、コレ、ワガ命、シバラクモ生キ伸ビテミタイ下心ノ所為、東京ノオリンピック見テカラ死ニタイ、読者ソウカト軽クウナズキ、深キトガメダテ、シテハナラヌゾ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ハラガヘッテハ、イクサガデキヌ。",
              "citation": {
                "source": "古典竜頭蛇尾",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "思イ見ヨ、諸君ハ、現ニ、商埠遙ニ散在シテイル貧窮セル居留民達ノ生命ヲモ財産ヲモ保護シテハイナイノデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、居留民ノ生命財産ノ保護、国旗ノ尊厳トイウガ如キ言葉ニ迷ワサレテハナラヌ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、日本国内ニ於テハ、農村ヤ工場ニ於テ、資本家ヤ地主カラ搾取セラレ、支那ニキテハ帝国主義ブルジョアジーノタメニ命ガケノ血ナマグサイ戦争ヲサセラレヨウトシテイル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓ＝元へ返って　三次サテハ尾行に気付いた。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄五郎勝坊と三次を見比べてサテハと気附いた。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　大吉、ウヌ――サテハと白眼むいて怒った時！",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　――オマエハ、モウ、ソレヨリ、オオキクナッテハ、イケマセンヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子は黙って、書いては消し書いては消しする字をたどって見ると、「ネーサマハイイコダカラ『アメリカ』ニイツテハイケマセンヨヨヨヨ」　と読まれた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹、シダ、コケ、花、鳥、ヘビ、ルリタテハもアゲハもカブトムシもみんな、それから山もだ」　いよいよ話がわからなくなって、慶一は高志の横顔を見なおす。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、マイニチ　イツテモ　イツテモ　ヒロイ　ノハラデ　タベモノガ　ナイノデ　サルヲ　コロシテ　タベナクテハ　ナラナク　ナリマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンノ　オトウサンハ　ソレヲ　キクト、タキクンノ　ハウヲ　キツト　ミテ、「タキ、イジメタリ　シテハ　イケナイヂヤ　ナイカ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "加之、甚シキニ至リテハ、其事ノ故誤ヲ問ハズ、其ノ理ノ当否ヲ顧ミズ、復讐ノ名義ヲ挟ミ、濫リニ相構害スルノ弊往往有之、甚ダ以テ相不済事ニ候。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "今後不幸至親ヲ害セラルル者有之ニ於テハ、事実ヲ詳ニシ、速ニ其筋へ訴へ出ヅ可ク侯。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ其儀無ク、旧習ニ泥ミ擅殺スルニ於テハ相当ノ罪科ニ処ス可ク候条、心得違ヒ之レ無キ様致スベキ事。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ノ元首が賣名的多辯ヲ弄シ下級俳優ノ如キ身振ヲ晒シテ當選ヲ爭フ制度ハ、沈默ハ金ナリヲ信條トシ謙遜ハ美徳ヲ教養セラレタル日本民族ニ取リテハ一ニ奇異ナル風俗トシテ傍觀スレバ足ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "納税資格ガ選擧權ノ有無ヲ決スル各國ノ制度ハ議會ノ濫觴ガ皇家ノ徴税ニ對シテ其ノ費途ヲ監視セントシタル英國ニ發スト雖モ、日本國自身ノ原則トシテハ國民タル權利ノ上ニ立テサルヘカラス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ母國民ノ妻タル權利ヲ擁護シ得ル制度ノ改造ヲナサバ日本ノ婦人問題ノ凡テハ解決セラル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義的議論ノ多クガ大地主ノ土地兼併ヲ移シテ國家其者ヲ一大地主トナシ以テ國民ハ國家所有ノ土地ヲ借耕スル平等ノ小作人タルベシト云フハ原理トシテハ非難ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "都市ト限リテ町村住宅地ヲ除外セル所以ハ、公有トスベキ理由ガ町村ノ程度ニ於テハ完成セザルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ガ日本ニ於テハ國民生活ノ基礎タル土地ノ國際的分配ニ於テ將來大領土ヲ取得セザルベカラザル運命ニ在リ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地ノ國際的分配ニ於テ不法過多ナル所有者ノ存在スルコトニ革命的理論ヲ擴張セズシテハ、言論行動一瞥ノ價値ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ安寧秩序ヲ保持スルコトガ國家ノ唯一任務ナリトセバ、國民ノ死活榮辱ヲ日夜ニ亘リ終生ヲ通ジテ脅威シツツアル此等ヲ處分セズシテハ國家ナキニ同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
