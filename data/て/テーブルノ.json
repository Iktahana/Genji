          "literary": [
            {
              "text": "―――」予ハ寝台カラ立チ上ッテ彼女ノ前ニ行キ、面ト向ッテ先ズ顎附ノ総入レ歯ヲ上下共ニ外シ、ナイト・テーブルノ入レ歯ノ箱ノ中ニ入レタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハジットソノ顔ヲ見ツメテイタガ、ナイト・テーブルノ抽斗カラ手鏡ヲ出シテソレヲ予ニ突キ付ケテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ早ウゴザイマス、オ爺チャンハ朝ハイツモオ早イノネ」ソウ云ッテ、竹ノ皮ニ包ンダモノヲ二本、風呂敷ヲ解イテナイトテーブルノ上ニ置ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ足音ヲ忍バセテイッタン寝室ヲ出、二階ノ書斎ノデスクカラ螢光燈ランプヲ外シテ、ソレヲ持ッテ戻ッテ来、ナイトテーブルノ上ニ置イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
