        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は強烈な手わざを繰り出し、相手の体勢を崩して見事に一本を奪った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "柔道の稽古では、足わざだけでなく手わざの正確さも厳格に指導される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "小柄な選手が大柄な相手を手わざで投げ飛ばすシーンは、会場を大いに沸かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
