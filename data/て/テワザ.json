          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖母が丁寧に刺繍を施したハンカチには、熟練した手わざが光っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "機械化が進む現代だからこそ、職人による繊細な手わざが改めて高く評価されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "竹細工の見事な仕上がりを見て、日本の伝統的な手わざの素晴らしさに感動した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "潮は今ソコリになっていてこれから引返そうというところであるから、水も動かず浮子も流れないが、見るとその浮子も売物浮子ではない、木の箸か何ぞのようなものを、明らかに少年の手わざで、釣糸に徳利むすびにしたのに過ぎなかった。",
              "citation": {
                "source": "蘆声",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほふしのなすや手わざを。",
              "citation": {
                "source": "長塚節歌集　上",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "菅沼というにかかる頃、暑さ堪えがたければ、鍛冶する片手わざに菓子などならべて売れる家あるを見て立寄りて憩う。",
              "citation": {
                "source": "知々夫紀行",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "鞋を解き足を洗ひ楼上に臥し晴間をも待たで早乙女の早苗取る手わざなど見やる折柄はした女あわただしく来りて汽車はや来れりいそぎ下り給へと云ふ。",
              "citation": {
                "source": "かけはしの記",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "よき母でありたき願ひ夜半の冬　　　せん女極月や婢やさしく己が幸　　　同　何らの技巧もなく、松の樹の如き性格の一面に優しさをしみ出させ、母が手わざの葛布をそめて着たりけり　　　せん女わが編みて古手袋となりにけり　　　同　この二句浮華軽佻ならぬ性格を確りと出している。",
              "citation": {
                "source": "大正女流俳句の近代的特色",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "網むすぶ手わざに、夜をや　ふかすなるらむ※、行路雨雨ふれば、泥踏みなづむ大津道。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "織りと染めとは、やまとでも、王朝の昔から、家庭の女、殊に主婦の手わざの第一義的なものであつた。",
              "citation": {
                "source": "沖縄を憶ふ",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "尠くとも、優れた新進作家の發見を、片手わざとする月評擔當者風な、忠實な氣分にはなれない。",
              "citation": {
                "source": "詩と散文との間を行く發想法",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "気分は極めていいが、身体の痛みは昨日よりも又更にはげしい、片手わざで顔を洗う間も、踵には釘を打たれるような疼痛を覚える。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "此物忌みの衣と、村の男となる前――恐らくは、第一次の元服なる袴着の際――に行うた母の手わざの印象とが相俟つて、衣服と皮膚との間に、蛇子の本身・化身の関係を絡めて居るのではないか。",
              "citation": {
                "source": "小栗外伝（餓鬼阿弥蘇生譚の二）",
                "author": "魂と姿との関係",
                "note": "青空文庫"
              }
            },
            {
              "text": "女たちも、唯姫の手わざを見て居るほかはなかつた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "女たちも、唯姫の手わざを見て居るばかりであつた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "女たちも、唯姫の手わざを見て居るほかはなかった。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、こうなってみると、どちらも市が栄えたというもので、彼等は僅少の犠牲で原価を取戻し、こちらは少々の手わざ足芸でうまく要領を外したという取柄があるのであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子の生れながらのさま見れば、手わざに似たれば。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "運送の如きも主として此連中が、片手わざに引受けて居たかと思はれます。",
              "citation": {
                "source": "蒼海を望みて思ふ",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、像なり、建物なり、または墓なり何なり、凡そ人間の手わざで、遠い時代から遺つてゐるものはある。",
              "citation": {
                "source": "一片の石",
                "author": "會津八一",
                "note": "青空文庫"
              }
            },
            {
              "text": "三本の手杵で調子を取り唄を歌って、儀式の日の米を精げ、それをさらに小搗いて粉にはたくのも、彼女らの手わざであった。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから糸にしてからも、紺は手染めができないので、あの頃ぽつぽつできていた職業の紺屋に誂えて染めさせ、機を立てる段になって始めて女の手わざに移ったのである。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが中央の文化がすすんでから、優良な麻布を織りだすので名高くなった土地がほうぼうにできて、これを租税の代りにまたは商品として、有利な生産をするふうがはじまり、紡織の手わざはまずそういった地方において、おいおいと発達してきたのである。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてわざと丁寧な挙手をした。",
              "citation": {
                "source": "街頭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕だつてわざとならもつと大きく吐けるよ。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "せっかく先生に上げようと思ってわざわざ国から取寄せて持ってきたものを気に入ってるこの敏子のところへすぐもうやってしまったと見えるな。",
              "citation": {
                "source": "かれいの贈物",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後軽井沢に避暑している友人の手紙の中に、彼地でランプを売っている店を見たと云ってわざわざ知らせてくれた。",
              "citation": {
                "source": "石油ランプ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつてのかゝりつけの安斎医学博士の栄養説によると、台湾に住んでいてわざ／＼内地米を取りよせて食っていた者があったそうだが、内地米が如何にすぐれていようともそんなのは栄養上からよくないそうである。",
              "citation": {
                "source": "外米と農民",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　線路を、どうしてわざと曲りくねらすのか、それが変だった。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど小学校の読本の村のことを書いたところのようにじつにうそらしくてわざとらしくていやなところがあるのだ。",
              "citation": {
                "source": "或る農学生の日誌",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とまるで怒ったような声で云ってわざと頭に実を投げつけるようにして泣かせて帰しました。",
              "citation": {
                "source": "手紙　四",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には嘲笑的にそしてわざと下品に。",
              "citation": {
                "source": "橡の花",
                "author": "――或る私信――",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋のおとぎ話に「ゾッとする」とはどんな事か知りたいというばか者があってわざわざ化け物屋敷へ探険に出かける話があるが、あの話を聞いてあの豪傑をうらやましいと感ずべきか、あるいはかわいそうと感ずべきか、これも疑問である。",
              "citation": {
                "source": "化け物の進化",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
