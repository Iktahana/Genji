        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ご自身が人を、許す許さぬで、てんてこ舞いしているだけではないか。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとりで、てんてこ舞いしている様が、よくわかるのである。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、それが恥ずかしくて、てんてこ舞いをしているのだ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちのものを、あっちへ持ち運び、あっちのものを、こっちへ持ち運び、まるで同じ事を繰り返して、独りで、てんてこ舞いをしているのである。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから一週間、妻は仕度にてんてこ舞いの様子であった。",
              "citation": {
                "source": "故郷",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "老夫婦ふたりきりで子供もなかったようだし、それでも三つの部屋がたまにふさがることもあって、そんなときには老夫婦てんてこまいで、かず枝も台所で手伝いやら邪魔やらしていたようであった。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕もね、きょうから生田組の撮影がはじまっているので、てんてこ舞いさ。",
              "citation": {
                "source": "花燭",
                "author": "燭をともして昼を継がむ。",
                "note": "青空文庫"
              }
            },
            {
              "text": "」言いながら落ちつきなく手を振り足踏みして、てんてこ舞いをしてみせた。",
              "citation": {
                "source": "花燭",
                "author": "燭をともして昼を継がむ。",
                "note": "青空文庫"
              }
            },
            {
              "text": "男爵は、まじめになり、その男のてんてこ舞いを見つめ、一種の感動を以て、「はり切っていますね。",
              "citation": {
                "source": "花燭",
                "author": "燭をともして昼を継がむ。",
                "note": "青空文庫"
              }
            },
            {
              "text": "淋しそうな人の姿を見ると、私は、自分に何も出来ないのがわかっていながら、何かしてやりたくて、てんてこ舞いしてしまうのです。",
              "citation": {
                "source": "風の便り",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」私は、てんてこ舞いをしていました。",
              "citation": {
                "source": "風の便り",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は恥ずかしさに、てんてこ舞いした。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の中をアシと黄色いスイレンの花でかざるのにてんてこまいでした。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いやどうも馴れないことでてんてこまいしてしまった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "今行ったかと思うと、すぐ後口がかかり、箱丁もてんてこまいしていたが、三時ごろにやっと切りあげ、帰ってお茶漬を食べて話していると、すぐに五時が鳴り、やがて白々明けて来た。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、台所では、モルジアナが、夕ごはんのしたくに、てんてこまいをしていました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "三、アリ・ババと四十人のどろぼう",
                "note": "青空文庫"
              }
            },
            {
              "text": "係りの者は今ごろまだてんてこまいで忙しがってる時分だ」「やっぱり警察じゃまだわからんのだねえ。",
              "citation": {
                "source": "少年探偵　呉田博士と与一",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし私はてんてこ舞ひをし乍らも、只管失業地獄に呻吟する人達に思ひ較べて自分を督励し、反面では眼に立つ身体の衰弱を意識して半ば宿命に服するやうな投遣りな気持で働いた。",
              "citation": {
                "source": "途上",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "余りに激しい力を一時に受けたので針がてんてこ舞いをし始めた。",
              "citation": {
                "source": "光の中に",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまりわっちも嬉しまぎれに、とてものついでに、大老なんぞと、これからそろそろむほんと出かけて、出入りの按摩を取り立て、お医者とこしらえ、玉川上水、印旛の新田、吉野の金掘り、む性に上納、御益のおための、なんのかのとて、さまざま名をつけ、おごってみたれば、天の憎しみ、今こそ現われ、てんてこ舞いやら。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "てんてこ舞いの昼夜がつづき、どうなることかと思っていると、それも間もなく下火となりやがて夜業は廃止された。",
              "citation": {
                "source": "昔の店",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "本所法恩寺まえの鈴川の屋敷に常連が集まってお勘定と称してひとしきりいたずらが盛ったあとは、こうして先刻からにわか酒宴がはじまって、一人きりの召使おさよ婆さんが、一升徳利をそのまま燗をして持ち出すやら、台所をさらえて食えそうな物ならなんでも運びこむやら、てんてこまいをしている騒ぎ。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "早く、その、釜のふたをとってくれ」　帰るやいなや、栄三郎も手伝って、ふたりの男がてんてこまいを演じたのち、ようように小豆も煮えて、どうやら赤の御飯らしいものができあがる。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "河童頭にじんじんはしょり、五つ六つの男の子が、てんてこてん、てんてこてん座敷の縁ではねている。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、今では主人の玄鶯院が新坊でなくては夜も日も明けないありさまで、夜中に咳の一つもしようものなら守人と平兵衛を起こしまわっててんてこまいを演ずるという騒ぎ。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　安はてんてこまいだ。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　炊事当番はシャツの上に胸掛前垂をあてゝ、テンテコまいをしていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "道頓堀の夜景は丁どこれから、といふ時刻で、筋向うの芝居は幕間になつたらしく、讃岐屋の店は一時に立て込んで、二階からの通し物や、芝居の本家や前茶屋からの出前で、銀場も板場もテンテコ舞をする程であつた。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小剣",
                "note": "青空文庫"
              }
            },
            {
              "text": "道頓堀の夜景は丁どこれから、といふ時刻で、筋向うの芝居は幕間になつたらしく、讚岐屋の店は一時に立て込んで、二階からの通し物や、芝居の本家や前茶屋からの出前で、銀場も板場もテンテコ舞をする程であつた。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "女護の島へ十人も荒くれ男を泊めるんで、今朝から二人がテンテコ舞をしてるやおまへんか。",
              "citation": {
                "source": "兵隊の宿",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
