[
  {
    "uuid": "9da614ec-93f3-5fea-b59e-caac45d1a80a",
    "entry": "手ひどい",
    "reading": {
      "primary": "てひどい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
