        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭園の静かな一角に、趣のある**手洗い鉢**が置かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "茶室には、風情のある**手洗い鉢**が据えられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この寺院の入口にある**手洗い鉢**は、歴史を感じさせる逸品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "外には春風が白い埃をあげて、土の乾いた庭の手洗い鉢の側に、斑入りの椿の花が咲いていた。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "盗難を防ぐマジナイに、手洗い鉢を家の中に伏せて置けばよいというのがある。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "山芋の蔓や、夕顔の蔓が、垣から手洗い鉢の脚にまでからみついている。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして空家の中の手洗鉢のように腐っていた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "スーと傘をすぼめて、手洗鉢へ寄った時は、衣服の色が、美しく湛えた水に映るか、とこの欄干から遥かな心に見て取られた。",
              "citation": {
                "source": "妖術",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "手洗鉢の氷は解けていなかった。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の家の小庭の手洗鉢の水流しのたゝきに五六条の白髪を落して、おさな顔のおみちが身じまいをしている姿が見える。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼過から少し出て来た生温い風が稍騒いで、横になつて見てゐると、何処かの庭の桜が、早や霏々と散つて、手洗鉢の周の、つは蕗の葉の上まで舞つて来る。",
              "citation": {
                "source": "背負揚",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "離れとおも屋の長い裏廊下の一部との間に、背の高い手洗鉢の根元まで廣がつた小さいたたき造りの池があつて、金魚が泳いでゐる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから手洗鉢の手杓を取り、手を洗ひながら、半ば冗談に、「何を云つてやがるんだい、馬鹿！",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頓狂な聲に驚いたのだらう、脊の高い丸太を立てた上に載せた手洗鉢のわきの枯れ竹に、一羽とまつてゐた雀が、ちゆツと啼いて飛んだ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸の山の手に住んでいる侍の一人が、某日の黄昏便所へ往って手を洗っていると手洗鉢の下の葉蘭の間から鬼魅の悪い紫色をした小さな顔がにゅっと出た。",
              "citation": {
                "source": "通魔",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その庭にばかり近所の猫が入り込むのを見ると、お徳は縁先にある手洗鉢の水でもぶッかけてやりたいほど、「うるさい、うるさい。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "物置の戸口と柱一つを界にして小窓が切つてある其外には手洗鉢が置いてある。",
              "citation": {
                "source": "出発",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方の隅には水の出るパイプがあって、その下にチョイとした手洗鉢がとりつけてある。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "伯母さんは手洗鉢の方へ手をやった。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "伯母さんは再び手洗鉢の方へ手をやった。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "這ひのぼりてゆけば、その極まる處、社寺に見るが如き手洗鉢の形を成し、穴の幅三寸ばかり、水之に滿つ、巖中より滴り出づるにや、手を入るれば、水、肱に及ぶ。",
              "citation": {
                "source": "妙義山の五日",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、私はよく勝手を知っていたので、庭の目隠しの下から手を差し込んで木戸の鍵を外し、便所の手洗鉢の傍から家の中に這入った。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗面器は売ってしまったので顔を洗うことが出来ないから、顔は途中にある湯島公園の便所の出口の手洗鉢で洗った。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭の土塀のくつがへつた脇に、大きな楓の幹が中途からポツクリ折られて、梢を手洗鉢の上に投出してゐる。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "火の手が見えだして、そこから逃げだすとき、庭の隅に根元から、ぽっくり折れ曲って青い枝を手洗鉢に突込んでいた楓の生々しい姿は、あの家の最後のイメージとして彼の目に残っている。",
              "citation": {
                "source": "永遠のみどり",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭の土塀のくつがえった脇に、大きな楓の幹が中途からポックリ折られて、梢を手洗鉢の上に投出している。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "火の手が見えだして、そこから逃げだすとき、庭の隅に根元から、ぽつくり折れ曲つて青い枝を手洗鉢に突込んでゐた楓の生々しい姿は、あの家の最後のイメージとして彼の目に残つてゐる。",
              "citation": {
                "source": "永遠のみどり",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る夜、兄が正三に便所の手洗鉢の側にある訳のわからない植物を指差して、「あそこは怖いぞお。",
              "citation": {
                "source": "恐怖教育",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう考えたので、彼は、一応、屋敷のぐるりを見て置こうと決心し、幸いに、手洗鉢のそばの沓脱ぎに、庭下駄が一足あったので、それを突っかけて、奥庭の上に出た。",
              "citation": {
                "source": "好色破邪顕正",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきは石の大手洗鉢の水の中に奇麗に浮いていた。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい時分はよく祖母につれられてこの墓詣りをしたが、千賀子という名であったその祖母は、この墓に向ってさえ何となく恐縮したような表情で、丸い石の手洗鉢の水を新しくするのも、どこか生きている人にきせた袴の襞を畳の上へ膝をついて直してやっているような様子であった。",
              "citation": {
                "source": "繻珍のズボン",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二間半と、鍵の手に曲って一間の縁側は東南に面して居るのだが、午後になると、手洗鉢を中心とした三尺ばかりの処にしか、暖い日光は耀らない。",
              "citation": {
                "source": "餌",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月八日（金曜）晴　今朝は手洗鉢にあつい氷が張って居た由。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
