    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（空を仰ぎながら）こりゃとても明るい月明り、お上人さま足元をお気を附け遊ばしませ』蓮如『幸子坊が何のてんごうを申すことやら、………然し此の世の中は辛いところだ。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのようなてんごうお言いなんすなら――」　くねりと身をくねらせて吉三郎の奥州が、やさしく主水之介を睨めながら、チクリと膝のあたりをつねりました。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何の、てんごうを云うてなるものか、人妻に云い寄るからは、命を投げ出しての恋じゃ」と、いうかと思うと、藤十郎の顔も、さっと蒼白に変じてしまった。",
              "citation": {
                "source": "藤十郎の恋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "お梶　藤様としたことが、また真面目な顔をしてなんぞ、てんごうでもいうのじゃろう。",
              "citation": {
                "source": "藤十郎の恋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤十郎　（さすがに必死な蒼白な面をしながら）なんの、てんごうをいうてなるものか。",
              "citation": {
                "source": "藤十郎の恋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「奈良枝、てんごしいなや。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "「※言ひなや、いかいこと待たしといて、それからあんなてんごしても、吃驚しえへんで。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これ」といったが旗二郎、「てんごうはよせ、とんでもない奴らだ！",
              "citation": {
                "source": "怪しの館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何をではない、てんごうは止めろ」「何を！",
              "citation": {
                "source": "怪しの館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかも行きしなに妹呉服の、咽喉を締めるという悪てんごうをして……」「気絶させたということではないか！",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "師匠の又助に頼まれたればこそ、こんなてんごうもしたのであるが、見れば本職のヤクザらしい二人に、怪我でもさせられては一大事と、「退散！",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこか田舎へ行ったときそこにいた駄馬に関雪さんが乗らはったところを、てんご半分に写生しといたのです。",
              "citation": {
                "source": "絵だけ",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "淺間山には天狗（てんごと發音する）が住んでゐて、現に自分も若い時に見た事、近頃もゐるにはゐるが、あまり里には出て來なくなつた事などを、一人ではなし、一人でうなづいて倦きなかつた。",
              "citation": {
                "source": "山を想ふ",
                "author": "水上瀧太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○てんごお・てんご・てご　浄瑠璃に屡見るてんごおと言ふ語は、今も京阪に生きてゐる。",
              "citation": {
                "source": "方言",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの場合、てんご・てごなど短くつめられるを常とする。",
              "citation": {
                "source": "方言",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ふ存分人にあらがひ、罵倒することであるが、てんごおほどには、書物の上に残されずに、もう亡びかゝつてゐる。",
              "citation": {
                "source": "方言",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "扨、かのてんごおもやはり、此と同じく、手強の義で手｜強うする＞てごわうする＞てごお（する）＞てごお＞てんごお、と言ふ風に、名詞化して来たと見るべきであらう。",
              "citation": {
                "source": "方言",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がわかりかねた様子をしたもので「いや昔からこういうところではてんご様や神様がきてお話しくださるということを承っておりますで」という。",
              "citation": {
                "source": "島守",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
