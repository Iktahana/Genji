        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鞍馬から貴船に行つた事があつたが、確か鞍馬で百姓馬や大原女を写したりしてると其頃塾に入り立ての橋本関雪さんが、僕が乗つて見せてやるさけ皆で写しとき、と言はれてその百姓馬に乗られ、馬には恁ふして乗るものやで皆覚えとき、どや色男振りは、などとテンゴ言ひもてそこらを乗廻してゐられた。",
              "citation": {
                "source": "写生帖の思ひ出",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハルハ地方の外蒙兵越境事件に就いて満州帝国が外蒙古と交渉中の処を、又々ハイラステンゴールに於ける同様な事件が惹き起こされた。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
