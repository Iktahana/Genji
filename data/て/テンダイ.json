[
  {
    "uuid": "a9ba6b73-b6e4-5f9e-ba48-f2add1f36c44",
    "entry": "天台",
    "reading": {
      "primary": "てんだい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "Tendai sect (of Buddhism)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は比叡山に登り、天台の教えの真髄に触れるべく厳しい修行に参加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "天台の思想は、すべての存在に仏性が宿るという壮大な哲学に基づいている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "日本仏教の母山と呼ばれる比叡山には、天台の歴史を伝える貴重な宝物が数多く残されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "鉄腸｜居士を父とし、天台道士を師とし、木堂翁に私淑していたかと思われる末広君には一面気鋒の鋭い点があり痛烈な皮肉もあった。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "天台、ジェームスその他によれば！",
              "citation": {
                "source": "春と修羅　第二集",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "註釈を読んでみればさすがに、一々もっともな理由があり、十如是の文によって支那の天台智者大師が天台哲学を組織し、勧持品の文によって日蓮上人のあの超人的な行業が誘発された能力に就いてのおよその見当がつく。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず元祖の釈尊が工夫し出された「四諦」「十二因縁」の法をはじめ、支那へ来ては天台大師の天台宗の教義とか、達磨大師の禅法とかいうものであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本では平安朝の伝教大師の日本天台、弘法大師の真言密教をはじめ、鎌倉期になって法然、親鸞、日蓮、道元らの諸祖の新興仏教の出たのもこのためであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずっと前の平安朝時代から伝統が続いて来ている伝教大師の天台宗、弘法大師の真言密教は、さとりの修業と信仰の安心立命と兼用であります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "成熟した大乗仏教は、ちょうど、この四十年間ほどの間に、支那大陸で、天台大師がしきりに研鑽講述しつつあったときで、日本にはまだあからさまに、その影響はなかったときであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に平安朝に興った二大新仏教は、伝教大師の日本天台、弘法大師の真言密教であります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝教大師が支那へ留学して持ち帰られた仏教は、支那天台宗の外に禅宗、密教、律宗もありました。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの四宗の長所を摂り、比叡山を開いて日本天台を創められたのですが、大師の独創として日本天台の宗義の中心となるものは、大乗円頓戒というものであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかし行簡禪師は天台智大師の徒弟たり。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "潜渓が方生の天台に還るを送るの詩の序に記して曰く、晩に天台の方生｜希直を得たり、其の人となりや凝重にして物に遷らず、穎鋭にして以て諸を理に燭す、間発して文を為す、水の湧いて山の出づるが如し、喧啾たる百鳥の中、此の孤鳳皇を見る、いかんぞ喜びざらんと。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "留まりたもうこと三日、杭州、天台、雁蕩の遊をなして、又雲南に帰りたもう。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち彬とゝもに江南に下り、彬の家に至り、やがて天台山に登りたもう。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "実に断岸絶壁、近より難い、天台禅ではありながら、祖師禅のような気味のある人であった。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "止観は隋の天台智者大師の所説にして門人｜灌頂の記したものである。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "釈迦牟尼は畢竟愚人、苦労性なる摩訶陀の王子、天台智者は大法螺吹、まつた伝教は山師の支店。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天台乃至伝教はわが胸中のこの宝を盗みたる、いはば物取強盗ぢや。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを区別するために、一方を天台龍宝寺といい、一方を浄土龍宝寺と呼んでいるが、鯉の一件は天台龍宝寺で、この鯉塚は明治以後どうなったか、わたしも知らない。",
              "citation": {
                "source": "鯉",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなはち此の寺の相を観るに、是れまことの天台宗の寺に非ず。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "天台寺の住寺とは佯り。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ先生に就いて学んでいた気のあった友達があって天台県の令となっていたが、それが手紙をよこして、来いと言ってきたので、はるばる往ったところで、おりもおりその友達の県令が亡くなった。",
              "citation": {
                "source": "嬌娜",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「このお蔭に因りまして、わたくし一人の命ばかりでなく、南方ぜんたいの人間が永く毒類の禍いを逃がれることになりましたのは、一に聖徳、二に神亀の力でございます」　　　異洞　乾符年中の事、天台の僧が台山の東、臨海県のさかいに一つの洞穴を発見したので、同志の僧と二人連れで、その奥を探りにはいった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "録異記",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしたってんだい」　ロープは腐っていた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「なんだうるさい、帰れ」「兵隊さん、いねむりしてんだい。",
              "citation": {
                "source": "ありときのこ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「何だうるさい、帰れ」「兵隊さん、ゐねむりしてんだい。",
              "citation": {
                "source": "朝に就ての童話的構図",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……その紅、何てんだい？",
              "citation": {
                "source": "兵士と女優",
                "author": "オン・ワタナベ（渡辺温）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いくらのこってんだい？",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえは一たい僕をなんだと思ってんだい。",
              "citation": {
                "source": "花燭",
                "author": "燭をともして昼を継がむ。",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そこで、その小豆を喰いながら、私らが、売女なら、どうしよってんだい、小姐さん、内々の紐が、ぶら下ったり、爪の掃除をしない方が、余程汚れた、頽れた、浅ましい。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
