    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まだ、チーフメートは、何らの手当てもしには来なかった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、黙って、早く手当てを済ますに限ると思ったので、その手当てを急いだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　安井の手当てがすむと、水夫たちは、改めて、食卓についた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、どうしてこの男が母の薬代や妻のあと始末、それから子供への手当て、産婆への報礼などをすることができよう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボーイ長の負傷の手当てをするために、室蘭公立病院へやっていただきたい、というのだそうでございます」「ボーイ長！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、それは手当てをしなければならないであろう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦場で負傷したきずに手当てをする余裕がなくて打っちゃらかしておくと、化膿してそれに蛆が繁殖する。",
              "citation": {
                "source": "蛆の効用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "跡取りの娘であるからそちらへ差し上げるわけには行かないと、歌女寿はわざと焦らすように一旦ことわると、相手はいよいよ乗り出して来て、いわゆる囲い者として毎月相当の手当てをやる。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お化け師匠",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御約束の御手当ては二百両、封のままで唯今お渡し申します。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "町内の医者もすぐに来たが、お作は何者にか喉笛を啖い破られているので、もう手当てを加える術もなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鬼娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろんどっと倒れてしまうほどの怪我じゃあねえから、医者にひと通りの手当てをして貰って、駕籠で江戸へ帰るに相違あるめえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大森の鶏",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの茶屋へ行って訊いてみると、あれから医者が来て手当てをして、女は駕籠に乗って帰ったそうです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大森の鶏",
                "note": "青空文庫"
              }
            },
            {
              "text": "跛足をひきながら金造の家へ転げ込んで、疵を洗って手当てをして、その晩はともかくも寝てしまったが、明くる朝になると疵口がいよいよ痛む。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大森の鶏",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした手当てには馴れているので、半七は河童を奥の小座敷へかつぎ込んで介抱すると、長吉はやがて息を吹き返した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お照の父",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那から月々の手当てを貰う上に、いい弟子が相当にあるので、師匠はなかなか内福であるらしいと云った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "唐人飴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆうべのうちに手当てを頼みに行ったに相違ねえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "唐人飴",
                "note": "青空文庫"
              }
            },
            {
              "text": "取りあえず近所の心やすい医者を呼んで手当てをしたが、これは外科でないから本当の療治は出来ない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "唐人飴",
                "note": "青空文庫"
              }
            },
            {
              "text": "碌々に手当てをしなかった岩蔵が助かり、外科医の手当てを受けた角兵衛が死ぬ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "唐人飴",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇吉は半死半生の体であったが、これは手当ての後に正気にかえった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "結び慣れてゐた洋髪から島田｜髷に結ひ直すために、かの女は暫く髪癖を直す手当てをしなければならなかつた。",
              "citation": {
                "source": "川",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち酷寒酷暑に於ける従事、或いは虫害その他についての繁雑な手当て、緻密な観察、時間的に不規則な労働に服す等の種々の場合に、努力しなければ中途で止める状態になることも間々ある理屈で、換言すれば好んで為すと云っても、その間には好ましくない事情が生じるようなことは人生に有りがちな事である。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "風邪かと思うのでその手当てなどを今日はしています。",
              "citation": {
                "source": "源氏物語",
                "author": "椎が本",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪我を負った人の手当てに忙しく立ち働いている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "差し当りて其処此処に宿泊せしめ置きたる壮士の手当てを如何にせんとの先決問題起り、直ちに東都に打電したる上、石塚氏を使いとしてその状を具陳せしめ、ひたすらに重井の来阪を促しけるに、頓て来りて善後策を整え、また帰京して金策に従事したり。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士は産後の出血は最も危険なこと、手当てに一刻の猶予もできないことなどを語って帰った。",
              "citation": {
                "source": "去年",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そっちが来て手当てしてくれと言った。",
              "citation": {
                "source": "瀕死の探偵",
                "author": "THE ADVENTURE OF THE DYING DETECTIVE",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人科の若い医者が時々廻って来ては、その方の手当てをしていた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し血脚気の気味もあるようだし、産褥熱の出たのも気にくわぬが、これでどうかこうか余病さえ惹き起さなければ、大して心配することもなさそうだと言って局部へ手当てを施し、新しい処方などを書きつけて置いて行った。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、俊は手あてを受けた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　一ツのトラックの負傷者が、それぞれベッドに運ばれて、一時担架卒のがたがた出入する靴音が消えたかと思うと、まだ、軍医の傷の手あてが、みんなの三分の一にも行き渡らないうちに、次のトラックが病庭へ唸りこんできた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
