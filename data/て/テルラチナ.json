        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "目の暮れぬ内にテルラチナに着き給ふべしといひぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "山脈の黄なる巖は漸く迫り近づきて、南國の風光に富めるテルラチナの市は、忽ち我前に横りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "こはテルラチナの驛舍にして、羅馬拿破里の間第一と稱へらる。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日は夜のまだ明けぬに、車に乘りてテルラチナを立ちぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "一行はテルラチナに宿りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "橄欖の茂き林、石走る瀧津瀬など、自然の豐かに美しき景色の我心を動すことは、嘗てテルラチナに來て始て海を觀つる時と殊なることなかりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "大澤の畔の如くならず、テルラチナなる橄欖の林の棕櫚を交へたるが如くならず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
