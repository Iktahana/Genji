          "literary": [
            {
              "text": "」日本、古来ノコノ日常語ガ、スベテヲ語リツクシテイル。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「メクラソウシニテヲアワセル。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "地ノ果テヲ行ク、参照スベシ×月十五日「儂の拳骨は鉄砲の弾丸だ　武士の情けだ」　モンモンの兵、鉢巻をするあり。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤア　ウグヒスガ　アソビニ　ヤツテ　キタ」ト、イヒナガラ、コドモタチハ　テヲ　ウツテ　コロコビマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "併シ乍ラ斯ル物質的生活ノ問題ハ或ル劃一ノ原則ヲ豫斷シテ凡テヲ演繹スベキ者ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "要スルニ凡テヲ通ジテ公的所有ト私的所有ノ併立ヲ根本原則トス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "固ヨリ敢テ凡テヲ事業家ノ公共的動機ニ要メズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶代ノ少キ客トイエドモ軽ク取リ扱ワズ、況ンヤ多ク恵ム者ニオイテヲヤ。",
              "citation": {
                "source": "一枚絵の女",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤ、ラファエルニオイテヲヤ……未ダカツテ……ジョットーヨリ純正偉大ナル宗教画家ハナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト、一匹ノコグマサンガ、パントテヲウツテイヒマシタ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、ミンナカラタイソウ　ホメラレテヲリマシタ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "況ヤ高尚ナル學理ニテ論ズル、其關係組織ノ殊ニ極ル者ニ於テヲヤ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤソノ師ニオイテヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "況ンヤ御贔屓ノ訥升ガ見ラレルニ於テヲヤ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ意ヲ決シテ木村ニ云ッタ、「デハコレノ現像ヲ頼ム、絶対ニ誰ニモ見セナイデスベテヲ君自身デシテクレタマエ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダッタラ何故オマエモ諦メテヲ体カラ生ヤソウトシナイノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "在府中、ソモジトノ永キ縁モ、マタ江戸出立ノミギリ、観音堂ニテ綱女ノ顔ヲ見オサメ申シ候｜夜ノコトモ、今ナオマザマザシク覚エ候エド、コノタビコソハ、阿波ニテステベキ一命、ソモジニハ、スベテヲ忘レクルルコソ、何ヨリモヨキ餞別ニコソ……。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
