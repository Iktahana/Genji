        "examples": {
          "standard": [
            {
              "text": "彼は敵歩の突き捨てを利用して、こちらの歩を動かし、王の守りを薄くしようとしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "敵歩が一段目まで入り込み、「と金」に成るのを阻止するために必死で防衛する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "将棋の終盤、わずか一枚の敵歩の配置が勝敗を分ける決定打になることもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "彼はよく透る声を振りしぼりながら、「二千メートル、敵歩兵の集団」と元気よく号令していた。",
              "citation": {
                "source": "ゼラール中尉",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そしてきふに強い声で、「あやしいことがあつたらこれだぞ。",
              "citation": {
                "source": "シロ・クロ物語",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
