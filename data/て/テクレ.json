        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "乙吉ハ二人ヲ大事ニシテクレマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、タカ　ニ、ドウカ　アソコヘ　ツレテ　イッテクレ　ト、タノミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハコネ、ユモト、タマヤ、デビョウキ、アスアサキテクレ」　受取って玄関で開いた千歳は、しばらく何が何やら判らなかった。",
              "citation": {
                "source": "呼ばれし乙女",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ誰ノ子デアルカ教ヘテクレ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒトノ後ヲ尾行シタリ隣室ヘハイツテ散々俺ノ悪口ヲ言ツタリ、俺ノ生活ヲ覗イタリスルコトハ、今後絶対ニヤメテクレ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一座が鎮まると貴女は薔薇の話は放りやって、父や母とロスタンのシャンテクレールの噂を始めだした。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカヨコシテクレタ君ノ手紙ハ非常ニ面白カッタ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ書ケルナラ僕ノ目ノ明イテル内ニ今一便ヨコシテクレヌカ（無理ナ注文ダガ）　画ハガキモ慥ニ受取タ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "書キタイ※ハ多イガ苦シイカラ許シテクレ玉エ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と、思う胸騒ぎを、じっと抑えて、読み下すと、アスマデニ三〇〇エンツゴウシテクレ、イノチガケニテタノム、アネ　と、いう電文だった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル日、オ母ッチャガ、君チャンニ、マイバン目ヲサマシタラ、オ母ッチャヲユリオコシテミテクレ、イツソノママ死ンデルカ分ラナイカラ、ト云ッタ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシキハソコノ人ガタクサンアツマッテ、ドウニカヤッテクレルコトニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゼヒアイタイ、スグキテクレ」　としてあった。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホンヤクノコトデ　タノミアルスグ　キテクレ」　彼は、わたしの部屋の壁、ライフル銃もロビンソンもオルゴールも、ペナントも、昆虫標本の額も、みんなどこかへ棄てられて、それらのものゝかゝつてゐた痕だけ白い壁に、途徹もない論文の抜き書ばかりが落書されてゐるのを発見した。",
              "citation": {
                "source": "幽霊の出る宮殿",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテノ考エ通リニモハヤ仕方ガナイト思ッテ、　「僕ハアナタニハ大変スマナイ事ヲシテ居タンダ、許シテクレ、君ニ謝ラナケレバナラナインダ」　ト云イマスト清三ハ床ノ上ニ起キ上リナガラ、　「何ダ、君ハ大寺君ジャナイカ、今頃人ノ寝室ニハイリコンデ何ヲシヨウトスルンダ」　ト申シマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　モシ私ノ云ッタ事ニ対シテ、清三ガ少シデモ耳ヲ傾ケテクレタラ、私ハ清三ヲ殺サズニスンダカモシレナイノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰カ来テクレタ人ニ云ウヨウスデシテ、決シテ一郎トイウ名ヲタダヨンダノデハナカッタト思イマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二）コノ品物ハスグチャントシマッテクレ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が日本語が解るというので僕が極めて簡単の日本語で、「ランテイさん、アナタワ、ベッピンサンデスネ、ボクヲ、アイシテクレマスカ」　と話しかけると、彼女は日本語で返事をせずに、中華民国語で返事をするのさ。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノウチ、親父ヨリ度々書取リニシテ、イケンヲ云ッテクレタ、ソノ時、隠居ヲシテ、息子ガ三ツニナルカラ家督ヲヤリタイトイッタラ、ソレハ悪イ了簡ダ……」　悪イ了簡ではない、図々しいというものだ、と神尾が呆れました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田、石原、富永、平川、魚住、村瀬、奥屋、鬼頭ナドハ、何レモ特別ニ眼ヲカケタト云フ訳デモナイノニ、士官学校又ハ兵学校ニ入学シテカラモズツト遊ビニ来ルシ、古イトコロデハ退職後マデ機嫌ハドウカトタヅネニ来テクレル有様ダ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "交番ニユキマスト、カワイラシイ女ノ子ノオマワリサンガヰテ、帳面ヲシラベテクレマシタガ、サツパリ玉ネギサンノスンデヰル村トイフノガ分リマセンデシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」アヒルノオマワリサンガカウイツテクレタノデ、玉ネギサント、ジヤガイモサンハ、ドンナニウレシカツタデセウ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　女ノ子ノオマワリサンガ、カウホメテクレタノデスカラ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、毎日、ダレカヌツテクレソウナ人ガ通ラナイカトミテヰルノデス。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　ソコヘ車掌サンガキテ、三匹ヲ　コシカケニ　コシカケサセテクレマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
