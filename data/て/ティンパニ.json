        "examples": {
          "standard": [
            {
              "text": "オーケストラの演奏で、ティンパニの音が会場に響き渡った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は高校の吹奏楽部でティンパニを担当している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ティンパニのロール奏法は、曲に壮大さを与える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "指揮者のヘンデルは、その争いを急速に終らせるために、盛んにティンパニを叩かせた。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてクリストフは、昏迷のうちにもがきながら、無意味な文句を口にして、想像の管弦楽を、トロンボーン、トランペット、シンバル、チンパニー、バスーン、コントラバス……などを指揮し演奏し、熱狂的にひき吹き打ちたたいた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
