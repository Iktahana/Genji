          "literary": [
            {
              "text": "けどテクラさんどうでしょう。",
              "citation": {
                "source": "ひのきとひなげし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女王のテクラが、もう非常な勇気で云いました。",
              "citation": {
                "source": "ひのきとひなげし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　賢いテクラがドキドキしながら云いました。",
              "citation": {
                "source": "ひのきとひなげし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "テクラがたずねました。",
              "citation": {
                "source": "ひのきとひなげし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただし天主教のテクラ尊者は蛇坑に投げられ、英国中古の物語に回主がサー・ベヴィス・オブ・ハムプタウンを竜の牢に入れたなどいう事あれば、ローマ人のほかに蛇で人を刑した例は西洋に少なからぬじゃ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "テクラの娘カタリナは「お母さん、もう目が見えない」と叫び、母親は小さなルシヤを胸にしつかと抱いてゐたが、必死に娘の方を向いて「マリヤ様にお願ひなさい」と叫びつゞけた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "テクラは余りしつかと小さなルシヤを抱きしめてゐたので、死後、その胸から幼女の屍体を離すことができなかつた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ニスヽメラレテクラッカー二個ニクラフトチーズ少量ヲ添エテ食ベ、紅茶一杯飲ム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
