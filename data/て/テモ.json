    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "新約聖書はいう「それ神は一位なり、また神と人との間には一位の仲保あり、すなわち人なるキリストイエスなり」と（テモテ前書二の五）。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ都所ノ別当ニダケハ、ナツテモヨイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と要らざる出しやばり口をきいたやうな次第でございましたけれども、将軍家はちよつとお考へになつて、それから一言、ドコヘ行ツテモ、同ジコトカモ知レマセン。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人は予を凝視むるやらむ、一種の電気を身体に感じて一際毛穴の弥立てる時、彼は得もいはれぬ声を以て「藪にて見しは此人なり、テモ暖かに寝たる事よ」と呟けるが、まざ／＼と聞ゆるにぞ、気も魂も身に添はで、予は一竦に縮みたり。",
              "citation": {
                "source": "妖怪年代記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日、一日、カク手ガ氾濫シテ来テ、何ヲ書イテモ、ドンナニ行儀ワルク書イテモ、ドンナニ甘ッタレテ書イテモ、ソレガ、ソンナニ悪イ文章デナシ、ヒトトオリ、マトマリ、ドウニカ小説、佳品、トシテノ体ヲ為シテイル様、コレハ危イ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自省直ケレバ千万人ト言エドモ、――イヤ、握手ハマダマダ、ソノ楯ノウラノ言葉ヲコソ、「自省直カラザレバ、乞食ト会ッテモ、赤面狼狽、被告、罪人、酒屋ニ飛ビ込ム。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さう言へば、綾足のぼつてりした重量感には、もう少しどうかするとゲテモノに落ちさうな不安もある。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲドリノ　スキナ　オヂイサンスグニ　トビダシ　ヲドツタラコブガ　フラフラ　ユレルノデトテモ　ヲカシイ　オモシロイ　お爺さんには、ほろ酔ひの勇気がある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "テモテ前書の第二章。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲドリノ　スキナ　オヂイサンスグニ　トビダシ　ヲドツタラコブガ　フラフラ　ユレルノデトテモ　ヲカシイ　オモシロイ　お爺さんには、ほろ醉ひの勇氣がある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "莫大ナル出兵費ハ誰カラ出ルカ、諸君ガ一本ノ煙草ヲ喫ンデモ、半斤ノ砂糖ヲ使ッテモ、一足ノサル又ヲ買ッテモ、必ズ間接ニ徴収セラレル税金カラ出テイルノダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈍感なものだけはトテモ堪らない。",
              "citation": {
                "source": "現代若き女性気質集",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "座長は大阪の三流どこの俳優で幹部二三人の外はアメリカで仕込んだ素人だから見ていてトテモはらはらした。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカあなたニ絵ヲ見テモライマシテカラ故郷デ貧乏漁夫デアル私ハ、毎日忙シイ仕事ト激シイ労働ニ追ワレテイルノデ、ツイコトシマデ絵ヲカイテミタカッタノデスガ、ツイカケナカッタノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハナントナクコンナツマラヌモノヲあなたニ見テモラウノガハズカシイノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "万一出来タトシテモ其時ハ話モ出来ナクナッテルデアロー。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ前タチ、デンデンムシノ　ウタ　シラナイカ」ト、オソバノ　モノニ　キイテモ、「シリマセン」ト　イツテ　クビヲ　カシゲテ　ヰマス。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヂイサン、マア　オキヽヨ、オレノ　フエハ　トテモ　スバラシインダゼ。",
              "citation": {
                "source": "カナヅチ",
