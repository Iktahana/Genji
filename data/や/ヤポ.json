        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "が中には図星日本人と看て取て、ヤポーシカが通るといふ。",
              "citation": {
                "source": "露都雑記",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤポーシカとは我国の露助と同格で、日本人の賤称だ。",
              "citation": {
                "source": "露都雑記",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "複数だとヤポーシキとなる。",
              "citation": {
                "source": "露都雑記",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "之をヤポンスキイと間違へて単に日本人の事だと思ふ人が露語を知らぬ人に多いやうだが、大間違で、ヤポンスキイとは日本のといふ形容詞で日本人の事でない、日本人の事は露語ではヤポーネツといふのだ。",
              "citation": {
                "source": "露都雑記",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来あの成分と云うのが、ヤポランジイの葉の中に含まれているんだからね。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、間もなく灯の中へ、ちょっと馬蓼に似た、見なれない形の葉が現われて、それを法水はヤポランジイだと云った。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですが、このヤポランジイの葉だけは、仰言られるまでいっこうに気がつきませんでした」　矮樹ヤポランジイの枝に、二つの花が咲いた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）三、あかめがしははマルロツス、ヤポニクスである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "不図思ひ立ちてキリストの踏みし土を踏み、またヤスナヤポリヤナにトルストイ翁を訪はむと巡礼の途に上り申候。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "片々にはシヤポオ・クラツクを腋挾んで、片々には自分の丈の五倍もあるヰオリンを抱いてゐる。",
              "citation": {
                "source": "十三時",
                "author": "THE DEVIL IN THE BELFRY",
                "note": "青空文庫"
              }
            },
            {
              "text": "外道奴は番人の鼻を撮んで、右左にゆすぶつて、前へ引つ張つて、それから腋挾んでゐた大きなシヤポオ・クラツクを番人の頭に被せた。",
              "citation": {
                "source": "十三時",
                "author": "THE DEVIL IN THE BELFRY",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「實際、俺の嬶シヤポだ。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤポンスキーホテル・ホクマン」　これだけでロシヤ人の運転手に通じるのですから剛気なものです。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論隣室のピエルミ君の上のワゴンに寝るんでせうが、来るとすぐ私の部屋にはいつて来て、ヤポンスキーと呼びかけて来るのです。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰊くさい漁師が一人ゐて、ヤポンスキーの函館はよく知つてゐると云つて、日本を説明するのでせう。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "実さい、一二度の事ならば、何でもないのですが、私が食べる頃を見計らつては、「ヤポンスキーマドマゼール、ブーリキ」なんぞと云つて、腹をおさへて悲しげにしてみせます。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんもりした老樹で、自動車をとめて休んでゐると、子供達が、トンボ・ヤポネーゼつて寄つて来たわね。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤポン国では、鼠のテンプラといって賞味してるそうですぜ。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "サル・ジヤポネエ（日本室）と名づけられて居るが、実は少しの日本趣味も無く、全く支那趣味ばかりである。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此間ガウチエと云ふ人が新しく書いた「ル・ジヤポン」と云ふ薄片な本を、アカデミイの一員ジヤン・エカアルの推称した序文に絆されて読んで見たが、「支那の始皇帝の侍医であつた徐福が童｜男童｜女六百人を伴れて行つて日本の文明を開いた」と斯う云ふ調子で凡てが書かれて居たのでがつかりした。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が下車すると、例の様に、「ジヤポネエズ、ジヤポネエズ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのときの憔悴というものは、全くひどくて今迄申しませんでしたけれど、あなたの濃い髪の色が赤っぽく変って、生えぎわから浮いてポヤポヤに見えました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "保健大臣氏に奉仕するためヤポンキ〔日本女〕は出て貰う、この方が原因だ。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "知らないうちに、昔の御大名の毛鎗の様な「けいとう」だの、何とあれは云ったか知らんポヤポヤした狐の尾の様な草も沢山断りなしにはびこって居る。",
              "citation": {
                "source": "後庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは生れつきほんとにお酒がのめないたちなんだからって――でも、十分陽気にはなれますから安心して下さいって……」　内海がそれをつたえると、ポリニャークは、「残念なことだ」　ほんとに残念そうに赫っぽい髪がポヤポヤ生えた大きい頭をふった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人と同じように大きい体つきで、灰色がかって赫っぽい軽い髪をポヤポヤさせている真面目なアレクサンドロフも、伸子を見て、笑いながら好意的にうなずいた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
