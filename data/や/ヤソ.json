[
  {
    "uuid": "21bca071-8ec1-5171-9316-79102366fd73",
    "entry": "耶蘇",
    "reading": {
      "primary": "やそ",
      "alternatives": [
        "ヤソ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
