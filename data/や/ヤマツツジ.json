    "definitions": [
      {
        "index": 1,
        "gloss": "Rhododendron kaempferi (species of rhododendron)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "春が来ると山躑躅の鮮やかな花が咲き始める",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "庭に植えた山躑躅が今年も見事に開花した",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "山躑躅にはアルカロイドが含まれているので食用にはできない",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "山躑躅こはやまつつじ丘丘の、　　栗また楢にまじはりて、　　熱き日ざしに咲きほこる。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふり仰ぐ絶壁の中腹などに僅に深山躑躅の散り殘つてゐるのを見る所もあつた。",
              "citation": {
                "source": "鳳來寺紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "硝子戸を四面にはめた明るい好い別荘で、藪の中には、赤い山躑躅などが咲いてゐた。",
              "citation": {
                "source": "スケツチ",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤く咲いた山躑躅の花は私の眼にある……　凄まじい叫び声が起つた。",
              "citation": {
                "source": "突貫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い山躑躅などの咲いた、その崖の下には、迅い水の瀬が、ごろごろ転がっている石や岩に砕けて、水沫を散しながら流れていた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "花木考に「山躑躅一名映山紅」と云つてある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕日かげかがやく色にまばゆくもわが山躑躅花さきにけり橘のかをれる庭は風ながらはた雨ながら塵ながら見ん夢さめて清きみ山の蝉きけばかはりたる世のここちこそすれ夕立は麓すぐれど高嶺よりあらしの払ふ宇多の中山折にふれて、み仏のめぐみのかたじけなさに詠める、かずかずの歌。",
              "citation": {
                "source": "禮嚴法師歌集",
                "author": "與謝野禮嚴",
                "note": "青空文庫"
              }
            },
            {
              "text": "山躑躅は、多くの草木の中に、牛の食はないものとして、反つて一面に繁茂して居るのであるが、それも今は霜枯れて見る影が無い。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは牛の角の癢くなるといふ頃で、斯の枯々な山躑躅が黄や赤に咲乱れて居たことを思出した。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "木曾の村々でも家の戸口に山躑躅を打付けてあるのを自分は目撃した。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "さは云へまことやまつつじ、　　日影くもりて丘ぬるみ、　　ねむたきひるはかくてやすけき。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」映山紅はやまつつじである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "松、柏、栗、どん栗、山つつじ、篠笹などが密生してゐる。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "山を歩いて山つつじを採つて戻る、野の草といつしよに、――花瓶に活けて飽かず眺める。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "――山を歩く、山つつじがうつくしい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしたちの来る途中には、紫色の山つつじがたくさん咲いていましたっけね。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "檜欅にまじる雑木のさわやかな緑がまたよみがえって、その間には木曾路らしいむらさきいろの山つつじが咲き乱れていた。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "路傍に咲く山つつじでも、菫でも、都会育ちの末子を楽しませた。",
              "citation": {
                "source": "嵐",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫くは小山に沿ふて歩めば山つつじ小松のもとに咲きまじりて細き谷川の水さら／＼と心よく流る。",
              "citation": {
                "source": "かけはしの記",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "きれいになっていて、ぐるりの林の中には山つつじの薄紫の花が満開です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ等の地獄を縁づけている丘陵には、地獄の煙のなびきかかるところに、岩石をはうようにして、葉のこまかい、園芸品種としても名高い雲仙つつじが、一面にはびこっていて、上の方へのぼるに従い、山つつじ、瑶珞つつじが、赤松の間に茂っている。",
              "citation": {
                "source": "雲仙岳",
                "author": "菊池幽芳",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしそれが五月であるならばこの辺は谷といわず、岨といわず、見渡す限り、色さまざまに咲き誇る各種のつつじが、大群落をなしているのであるが、今は花がなく、ただ遅れ咲きに咲いている赤花の山つつじが、点々見出されるだけである。",
              "citation": {
                "source": "雲仙岳",
                "author": "菊池幽芳",
                "note": "青空文庫"
              }
            },
            {
              "text": "山つつじの花が満開だった時もある。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "木の芽の叢、浅みどりの谷々には、所々、燃ゆるような山つつじや山桜の盛りが眺められる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "灌木帯の浅みどりも、岩間をつづる山つつじも、一瞬、嵐のように揺れ騒いだ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くは、灌木帯を目がけて跳び降り、その上にまた跳び降り、跳び降り、青葉をかすめる槍の光や差物が、山つつじの花と共に、一瞬、あらゆる色彩の卍を描いた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "山つつじ　たれは、あの山鼻に。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "金扇の馬簾が、ゆらりゆらり、そこから少し山蔭へかくされた頃――仏ヶ｜根の山腹から裾にかけて、井伊兵部直政の赤一色の旗さし物や人数が、岩間岩間を山つつじの花が染めるように、展開していた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしちょうど、中門の上の新陰堂の池の畔には、燕子花がさいているし、山つつじの花もぼつぼつ紅くなっている。",
              "citation": {
                "source": "宮本武蔵",
                "author": "水の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "山つつじが真っ紅に燃えている。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
