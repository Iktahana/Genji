        "examples": {
          "standard": [
            {
              "text": "夏場は土が乾きやすいので、朝夕の二回、庭の盆栽に遣り水をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "出張の間、隣の住人に鉢植えへの遣り水をお願いしておいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "祖父は毎朝の日課として、縁側に並べた蘭の鉢に丁寧な遣り水を行う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
