        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "釉薬を使わない焼き締めの器は、使うほどに味が出てくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "焼き締めの花瓶に、庭で摘んだ野花を生ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "土の力強さを感じさせる焼き締めの鉢が、リビングの棚に飾られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "妙なことに、心に浮かんだ例えは、見事な焼き物がきれいに絵付けされているが、まだ窯の中で焼き締められていない。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "上に釉薬を施さず焼締めたもので、色は茶褐色を呈します。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "手法は焼締め、鉄流し釉。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "形正しく整い、焼締められし素地も、歳月の恵みを受けて色深くくすぶる。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
