        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「日が暮れてから踊り出すのですが、夜なかまで休み無しに踊っているのじゃあない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "地蔵は踊る",
                "note": "青空文庫"
              }
            },
            {
              "text": "踊り手も休み無しにぐるぐる廻っている。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「彼らはしばしば日の出とともに踊り出しそしてある者は午前11時頃まで休み無しに続ける。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとうにもう休みなしでかけるんだ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、ピリケンの三階にある舞踏場でも休みなしに蓄音機を鳴らしていた。",
              "citation": {
                "source": "雪の夜",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の五枚寸延びという大安売、四十回ばかり休みなしに書いたのである。",
              "citation": {
                "source": "おばけずきのいわれ少々と処女作",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑誌分の作業では別個に十万円程度の報酬を得ましたが、それを足したとしても三か月休みなしの集中した作業で、報酬は九十万円ほどでした。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁夫たちはあけ方まで休みなしに鰊汲をつづけ舟に一杯になるとそれを枠網にうつすのであった。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前後から夜晝休みなしの葉の選別作業が始まる。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "四人は休みなしに續けてゐる。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "休みなしに繰り返す仕事を急に止めたので、眩しさを覺えるらしい眼を据ゑて、そこに立つ駿介を見た。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は年から年中休みなしに何かしら働いてゐた。",
              "citation": {
                "source": "余震の一夜",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "印半纒を着た威勢のいい若い衆の二、三人が詰めていて、糸目を付けるやら鳴弓を張るやら、朝から晩まで休みなしに忙がしい。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "笛と太鼓はほとんど休みなしに囃しつづける。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪はすこし衰えたが、それでも休みなしに白い影を飛ばしているのが、二階の硝子戸越しにうかがわれた。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎月休みなしの興行にあわただしく追い立てられて、観客の鑑賞力も記憶力も麻痺してしまうのであろう。",
              "citation": {
                "source": "寄席と芝居と",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "両国と奥山は定打で、ほとんど一年じゅう休みなしに興行を続けているのだから、いつも、同じ物を観せてはいられない。",
              "citation": {
                "source": "虎",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "団十郎の口の重いのに引きかえて、彼は極めて流暢な江戸弁でそれからそれへと休みなしに話しつづけた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈍帳芝居は休みなしであるから碌々に稽古もしないというのが、鈍帳役者の軽蔑される一つの原因であった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "この狂言では、団十郎が清正と太閤と船頭与次兵衛の三役を勤めて、殆んど休みなしに登場していたのである。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "印半纏を着た威勢の好い若衆の二、三人が詰めていて、糸目を付けるやら、鳴弓を張るやら、朝から晩まで休みなしに忙しい。",
              "citation": {
                "source": "思い出草",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイユランドのバリポールトリー城をデーン人が建た時、四方から工夫を集め日夜休みなし物食はずに苦役せしめ、仆るれば壁上に其體をなげかけ其上に壁を築かしめた。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "街路から街路を休みなしに往ったが、旅館がないのかちっとも止まらなかった。",
              "citation": {
                "source": "港の妖婦",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　強雨はやまないばかりか、しきりに雲が騒いで、夕方まで休みなしに吹き通すような強風も出て来た。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "相変わらず休みなしで、騒ぎ回っているのは子供ばかり。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "おうちに帰って柱の古い時計を見ますと、時計は昼も夜も休みなしに、いつでも同じように動いているではありませんか。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "潮の流れが東と西から押しよせて、逆立ちあって、崩れて、休みなしに騒いでいる。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "休みなしに降りつづけた雪は、一夜のうちに地表を数尺たかめていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはホールでも激しく休みなしに踊つた。",
              "citation": {
                "source": "淪落",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧野も彼もまだ旅姿のままで、一度神戸で脱いだ旅の着物を復た身に着けて、汽車中｜殆ど休みなしに硝子窓の側に立ちつづけて行った。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
