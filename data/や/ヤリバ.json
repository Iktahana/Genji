          "standard": [
            {
              "text": "荷物が多すぎて、やり場に困る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この大きな家具のやり場がない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "本が増えすぎて、本棚もやり場がないくらいだ。",
              "citation": {
