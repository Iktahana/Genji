    "definitions": [
      {
        "index": 1,
        "gloss": "yakiniku",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "週末は、家族みんなでホットプレートを囲んで焼肉を楽しむのが恒例だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "やっぱり焼肉には冷たいビールが最高だね！至福の瞬間だよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "奮発して、有名店の高級焼肉を食べに行ったら、とろけるような美味しさだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "これを食物に譬えて云えば、諸種の材料を混和した調味と、刺身の如き焼肉の如き、材料その物の味いとの如きものである。",
              "citation": {
                "source": "歌の潤い",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "刺身と焼肉、それを予は決して嫌ではない。",
              "citation": {
                "source": "歌の潤い",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども刺身と焼肉が何より美味いという人には、到底真の料理を語ることは出来ない如く、芸術の潤いを感取し得ないような人に詩趣を語ることは出来ないと思ってる。",
              "citation": {
                "source": "歌の潤い",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ガチョウの焼肉のおいしそうなにおいが、通りまで、ぷんぷんとにおっています。",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "雉の焼肉みたいな味の藻があるかね。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その鰹の肉片が片側藁火に焙られて、不透明な焼肉の色から急速に生身の石竹色に暈けてゐるのをまじ／＼と見詰めながら、桑子は師匠に云つた。",
              "citation": {
                "source": "花は勁し",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "極楽にも、あの湯気の立つ羹をフウフウ吹きながら吸う楽しみや、こりこり皮の焦げた香ばしい焼肉を頬張る楽しみがあるのだろうか？",
              "citation": {
                "source": "悟浄歎異",
                "author": "―沙門悟浄の手記―",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間に棚の上にかくれてゐた工兵隊が、フライパンの上に飛び降りて、煙りのたつてゐる焼肉をさつさつと占領して行つてしまふのです。",
              "citation": {
                "source": "船の中の鼠",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジヤツク・ロンドンといへば名高い『野性の声』で狗や狼の生活をかいた作家で、原始的生活が好きな余りから自分でも焼肉の代りに、血だらけな生の肉を噛つたり、取り立ての蝸牛をその儘鵜飲みにしたりした男だ。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マルクス家の軸」であるレンシェンが腕に下げて来るドイツ風の大籠の中の大きい焼肉のかたまり。",
              "citation": {
                "source": "カール・マルクスとその夫人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩飯を部屋へ取ったので、その時ついて来た焼肉用の鋭い小刀が、床に落ちていた。",
              "citation": {
                "source": "ロウモン街の自殺ホテル",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "エサウは焼肉のために長子権を抛ち、保吉はパンのために教師になった。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ひたすらに沈黙して僅かに生々しい焼肉を食っていた平一郎は尾沢の瞳に真珠のように小粒な涙滴を見ることが出来た。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉太郎がのぞくと、空缶の中には、りんごとオレンジが四つ五つ、肉の缶詰のあいたのが二つばかり、それに骨のついた焼肉がころがっていた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして三人は、パンや、焼肉や、果物などをまん中にならべて、食事をしているのです。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁師や山男のサシミ、焼魚、焼肉の類でも料理で通用するのが日本料理であるが、西郷どんの大好物はそれらに比べて手がこんでいるけれども、料理といってよいのかどうか、乱暴千万な食べ物だった。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "かはいそうに、空腹が焼肉の夢をみさせたのですね、満月の夜に鶴は饑える、自分の影ときらきら光る水を恐れて。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "羊や猪や、牛や豚、狐の焼肉など及びもつかない。",
              "citation": {
                "source": "食指談",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、憐れなるかな網焼肉の命乞い。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "乱視の奈翁　――アルル牛角力の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひる頃一人の女が牛乳と麋の焼肉を持って来てくれた。",
              "citation": {
                "source": "かなしき女王",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから菓子が出た、調合葡萄酒が出た、それから大きな一片の冷えた焼肉が出た、それから大きな一片の冷えた煮物が出た。",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、当夜第一の喚び物は焼肉や煮物の出た後で、提琴手が（巧者な奴ですよ、まあ聴いて下さい！",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日お午になると、中庭はもとより門のそとの往来へまで、｜甜菜スープだの羊や鴨の焼肉だののおいしそうな匂いが漂い、それが精進日だと魚料理の匂いにかわって、門前に差しかかる人は、食欲をそそられずに行き過ぎるわけにはいかなかった。",
              "citation": {
                "source": "可愛い女",
                "author": "DUSHECHKA",
                "note": "青空文庫"
              }
            },
            {
              "text": "……一番沢山食べたひとには、王様からご褒賞が出るという話」「ノン」「さあ、さあ、あちらには鵞鳥の焼肉羮とモカのクレエム。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "八人の小悪魔",
                "note": "青空文庫"
              }
            },
            {
              "text": "その料理の仕方は生肉、乾肉、煮肉の三種で焼肉は礼式の時に用うることを許さない。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜂蜜ケーキおよび焼肉を祭壇に捧げた後で祈願者たちはベッドに横たわった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "また広間のもう一つの端からは、ほとんど舞台に達するまで、花で飾られた長いテエブルがいくつも並んでいて、そのテエブルでヤコビイ弁護士の賓客たちが、春のビイルと子牛の焼肉とを味わっている――法律家、将校、紳商、芸術家、高級官吏たちと、その夫人令嬢たちとで、たしかに百五十人以上の紳士淑女である。",
              "citation": {
                "source": "ルイスヒェン",
                "author": "LUISCHEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理当番が、島にいた正覚坊の、潮煮と焼肉を出した。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝飯は、正覚坊の焼肉と、潮煮。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、昼飯のこんだては、カツオのさしみに、島に生えたワサビ、タカセ貝のつぼ焼、かめの焼肉である。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
