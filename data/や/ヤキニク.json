        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "キャンプの夜、焚き火で串に刺した肉を焼肉にして食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お昼ご飯に、冷蔵庫にあった豚肉をフライパンで焼肉にした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このレシピでは、オーブンでじっくりと塊肉を焼肉にするので、とても柔らかく仕上がる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
