        "examples": {
          "standard": [
            {
              "text": "ケーキの表面にきれいな焼き色がついたら、オーブンから取り出す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "グラタンのチーズに美味しそうな焼き色がついて、食欲をそそる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "トーストの焼き色が薄かったので、もう一分加熱した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「こぶ泥、いや、泥斎」「はッ」「いい焼き色だな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "所が三月十四日のこと、前夜の濃霧の名残りで、まだ焼色の靄が上空を漂うている正午頃に、その橋を、実に憂欝な顔をして法水麟太郎が渡っていた。",
              "citation": {
                "source": "失楽園殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぞっとする感情が皆に走り、皆の顔が日焼色の下で青ざめた。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと、そっちも探してみろ」　その言葉の終らないうちに、彼の見廻している谷間の岩も水も雪崩の草も、いちめんに夕焼色にぱっと明るく染まった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
