        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "無論、あの孃ちやんや雇女達の用ゐる奴ぢやない。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "平凡な雇女は呼びようもなくて雇主の五人を一々旦那様と呼んだ。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "加特力教信ずる養父母は、英吉利人に使はるるを嫌ひぬれど、わが物読むことなど覚えしは、彼家なりし雇女教師の恵なり。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は元と縦覧所を出している男の雇女で、年の三十も違う主人に、脅迫せられて身を任せて、妾の様になっていた。",
              "citation": {
                "source": "ヰタ・セクスアリス",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても考えてみれば、四谷左門の娘御が、楊枝店の雇女になるなんどは、これも時世時節と諦めるか。",
              "citation": {
                "source": "南北の東海道四谷怪談",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三本目の銚子を取り換へてから小一時間にもなる二階の二人連れは、勘定が危さうで、雇女は一人二人づゝ、抜き足して階子段を上つて行つた。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小剣",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　新まいの雇女にお客と間違へられて、お文の叔父の源太郎が入つて来た。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小剣",
                "note": "青空文庫"
              }
            },
            {
              "text": "お文はあがつた蒲焼と玉子焼とを一寸｜検めて、十六番の紙札につけると、雇女に二階へ持たしてやつた。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小剣",
                "note": "青空文庫"
              }
            },
            {
              "text": "雇女が一人三畳へ入つて来て、濡れ縁へ出て対岸の紅い灯を眺めながら、欄干を叩いて低く喇叭節を唄つてゐたが、藪から棒に、「上町の旦那はん、……八千代はん、えらうおまんな。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小剣",
                "note": "青空文庫"
              }
            },
            {
              "text": "名妓の噂を始めた縮れ毛の、色の黒い、足の大きな雇女は、源太郎が何とも言はぬので、また欄干を叩いて喇叭節をやり出した。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小剣",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紙を前に披げて、ヂツと腕組をしてゐた源太郎は、稍暫くしてから、空になつた食器が籠に入つて雇女の手で河の中から迫り上つて来たのを見たので、突然銀場の方を向いて、「これ、何んぼになるんやな。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小剣",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　算盤を弾きながら、お文が向うむいたまゝで言つたのと、殆んど同時に、総てを心得てゐる雇女は、濡れ縁から下を覗き込んで、「よろしおます、お序の時で。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小剣",
                "note": "青空文庫"
              }
            },
            {
              "text": "三本目の銚子を取り換へてから小一時間にもなる二階の二人連れは、勘定が危さうで、雇女は一人二人づゝ、拔き足して階子段を上つて行つた。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　新まいの雇女にお客と間違へられて、お文の叔父の源太郎が入つて來た。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "お文はあがつた蒲燒と玉子燒とを一寸｜檢めて、十六番の紙札につけると、雇女に二階へ持たしてやつた。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "雇女が一人三疊へ入つて來て、濡れ縁へ出て對岸の紅い灯を眺めながら、欄干を叩いて低く喇叭節を唄つてゐたが、藪から棒に、「上町の旦那はん、……八千代はん、えらうおまんな。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紙を前に披げて、ヂツと腕組をしてゐた源太郎は、稍暫くしてから、空になつた食器が籠に入つて雇女の手で河の中から迫り上つて來たのを見たので、突然銀場の方を向いて、「これ、何んぼになるんやな。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　算盤を彈きながら、お文が向うむいたまゝで言つたのと、殆んど同時に、總てを心得てゐる雇女は、濡れ縁から下を覗き込んで、「よろしおます、お序の時で。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人義哉が出かけて行った後、小間使のお花は雇女と一緒に、台所で炊事を手伝っていた。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある朝雇女の一人が顔色を変えて主婦に向って言った。",
              "citation": {
                "source": "怪談綺談",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうなさるの」　大平は、その通りをずっと墓地を抜けた処に、年とった雇女と暮しているのであった。",
              "citation": {
                "source": "一本の花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パン屋の店員でも女市民とよんでいるのに、ルイバコフ夫婦が夏の休暇に南方へでも出かけたとき見つけて連れて来たらしいニューラの、雇女としての境遇は古くさくて淋しかった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧農、雇女の子供は中学にさえ入れなかった。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どかりと腰をおろした縁台に、小腰をかがめて近寄ったのは、肝腎のおせんではなくて、雇女のおきぬだった。",
              "citation": {
                "source": "おせん",
                "author": "邦枝完二",
                "note": "青空文庫"
              }
            },
            {
              "text": "伜の彌吉は二十七八の典型的な若旦那で、一番下手人の可能性は濃厚ですが、棺へ穴を開けてまでもいろ／＼な細工をして親を殺す筈がなく、あとは下女二人、雇女五六人、男達七八人、いづれもお勝手や庭に居て、祭壇には近付いた者もありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "生き葬ひ",
                "note": "青空文庫"
              }
            },
            {
              "text": "おしげは末吉が常連であった酒場の雇女であった。",
              "citation": {
                "source": "日日の麺麭",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹立ちに薄暗い石段の、石よりも堆い青苔の中に、あの蛍袋という、薄紫の差俯向いた桔梗科の花の早咲を見るにつけても、何となく湿っぽい気がして、しかも湯滝のあとを踏むように熱く汗ばんだのが、颯と一風、ひやひやとなった。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸がもやもやとなり、はや、人が変り、うわべはおだやかに笑いながら、「ごめんね、もう要らないわよ。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "文子はおやとなつかしそうに、十吉つあんやおまへんか、久しぶりだしたなアと、さすがに笠屋町の上級生の顔を覚えていてくれました。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく、馬面の仏像が、日本に来りて、丸ぼちやとなりたる所以を知るものは、晶子が大仏に向ひて、美男と呼ぶの理由を知るべき也。",
              "citation": {
                "source": "鎌倉大仏論",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
