        "examples": {
          "standard": [
            {
              "text": "試合中、観客が選手に向かって野次った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼のスピーチがあまりにもつまらなかったので、つい野次ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「おい、もっと声出せ！」と、応援団が相手チームを野次った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「貴方のことを、妾の恋人だらう――つて、さかんに野次るんですわ。",
              "citation": {
                "source": "街角",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしも世界を田螺や蟹の理想をもって導くならば、我らがごとき空手空拳の無産者は、ただ飢死するより仕方がないのである」「それで〈めだか〉を食うのだろう」と源五郎虫が野次る。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時競漕中敵の艇を野次るので有名であった農科の舵手が、「敵艇を抜くこと約半艇身！",
              "citation": {
                "source": "競漕",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "人混みの中でもいつかしら際だった一つの声の云うことは聴いていて、野次る。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トルアデック」に於ては、訳者はなんと云ふか、私は、あの翻訳でこそ、あれだけに行つたといふ感が深かつただけで、ジュウル・ロマンの詩的諷刺は、教師をやじる中学生のやうに浅薄なものとなつてゐた。",
              "citation": {
                "source": "テアトル・コメディイの二喜劇",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台に上がった途端に皆がやじるような奴や。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
