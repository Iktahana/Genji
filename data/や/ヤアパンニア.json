        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三十六歳のとき、本師キレイメンス十二世からヤアパンニアに伝道するよう言いつけられた。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤアパンニアは近いのである。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤアパンニアでは黄金を重宝にするという噂話を聞いたからであった。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうしてシロオテは、ヤアパンニアの土を踏むか踏まぬかのうちに、その変装を見破られ、島の役人に捕えられた。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤアパンニアの牢のなかで一年をすごしたシロオテは、日本の言葉がすこし上手になっていたのである。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
