          "literary": [
            {
              "text": "サツキヨリ、マダヤカマシクナツタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、オバアサンハヨイネコデスカラ、ケツシテコドモガドンナニヤカマシクシテモ、ドナリツケタリハイタシマセン。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらくそれは、私の親が私のこととなると人一倍ヤカマシクてユーゴのどんな名流であろうとも、九州の片田舎に住む混血児の娘との結婚なぞを、許してくれるはずがないという諦めが、私の心のどこかに巣食っていたからかも知れません。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "気候がよくなってから、やっと東京へ戻って来ましたが、医者がヤカマシクいうものですから、その翌年の四月頃までも、寝ていましたでしょうか？",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
