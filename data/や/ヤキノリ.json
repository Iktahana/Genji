    "definitions": [
      {
        "index": 1,
        "gloss": "baked seaweed",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "磯の香りがするパリパリの焼き海苔は、温かいご飯のお供に最高だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "おにぎりには、香ばしい焼き海苔を巻くと一層美味しくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "焼き海苔を細かく刻んで、ラーメンやうどんのトッピングにするのもおすすめだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "焼き海苔、柚味噌、それに牡蠣の三杯酢ぐらいの箸休めで、盃のやりとりもはじまった。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "惨酷な冗談　Ａ、やきのりの罐をいじって居る。",
              "citation": {
                "source": "一九二三年夏",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と盆の上に茶呑茶碗……不心服な二人分……焼海苔にはりはりは心意気ながら、極めて恭しからず押附ものに粗雑に持って、お蔦が台所へ顕れて、「お客様は、め組の事を、何か文句を言ったんですか。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、茶の間らしい、中の間の真中に、卓子台を据えて、いま、まだ焼海苔の皿ばかり。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "読者知るや、さんが、オムレツを啣んで、あゝ、うまい、と嘆じ、冴返る身に沁々とほつき貝と、芥川さんが詠じて以来、――東京府の心ある女連は、東北へ旅行する亭主の為に鰹のでんぶと、焼海苔と、梅干と、氷砂糖を調へることを、陰膳とゝもに忘れない事に成つた。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのでんぶ、焼海苔など称ふるものをしたゝか入れた大バスケツトがあるゆゑんである。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "保吉は未だに食物の色彩――※脯だの焼海苔だの酢蠣だの辣薑だのの色彩を愛している。",
              "citation": {
                "source": "少年",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そは餅を小さく切りこんがりと焼き湯に漬けて柔になし椀に盛りて大根｜卸しを懸け砂糖を少しく振り焼海苔を細く揉みてかけ醤油を少しく滴して食す。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを炊きたての熱い御飯へかけて薬味には葱に陳皮に焼海苔に紅生姜なぞの細かく刻んだものと紫蘇の実なぞを入れよく掻き混ぜて食べますとどんなに美味しゅうございましょう。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "別に美味い鰹節の煎汁を拵えておいて薬味には大根卸しに刻み葱焼海苔の揉んだもの卸し山葵なぞを牡蠣の上へ載せて今の煎汁をかけます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "炊きたての熱い御飯へ刻み葱焼海苔｜紅生姜その外何でも沢山の薬味を載せて今の鮪を汁ともにかけて出します。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はチーズの缶と平皿とを食卓の上に並べ、前からあったピーナツや焼海苔の皿を片方へ押しやり、ナイフでチーズを小さく切りはじめた。",
              "citation": {
                "source": "紫の壜",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼海苔に銚子を運んだ後、おかみさんはお寒いじゃ御在ませんかと親し気な調子で、置火燵を持出してくれた。",
              "citation": {
                "source": "雪の日",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "何れも、西洋人相手の晩餐会にスープの音さする気兼もないと見えて、閉切つた広い食堂内には、此の多人数がニチヤ／＼噛む餅の音、汁を啜る音、さては、ごまめ、かづのこの響、焼海苔の舌打なぞ、恐しく鳴り渡るにつれて、『どうだ、君｜一杯。",
              "citation": {
                "source": "一月一日",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼海苔に銚子を運んだ後、おかみさんはお寒いぢや御在ませんかと親し気な調子で、置火燵を持出してくれた。",
              "citation": {
                "source": "雪の日",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼飯の残りを蒸返し、てっか味噌と焼海苔とを菜にして、独り夕飯を食べてしまってから、重吉は昨日の午後お千代を呼んだ芳沢旅館へ電話をかけて問い合わすと、その日の夕方まで其処にいたことは分ったが、それから後の行先がわからない。",
              "citation": {
                "source": "ひかげの花",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも気転をきかして焼海苔を持って来た。",
              "citation": {
                "source": "写況雑記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついでにあなた方は、焼海苔や米に奢りし裏長屋　　龍雨　という句の意をおもいだして下されば、もうそれでいいのである。",
              "citation": {
                "source": "我が圓朝研究",
                "author": "「怪談牡丹燈籠」「江島屋騒動」「怪談乳房榎」「文七元結」「真景累ヶ淵」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、のりは良質のもの――焼きのりでもよい――を、細かく揉んでかける。",
              "citation": {
                "source": "雑煮",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼きのりはかきとよく出合う。",
              "citation": {
                "source": "夜寒に火を囲んで懐しい雑炊",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼きのり、炒りごま、七味、薬味ねぎなどを、好みに応じて加えれば申し分なしといえる。",
              "citation": {
                "source": "夜寒に火を囲んで懐しい雑炊",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、いいのりをうまく焼いたものか、焼きのりのうんと上等のを、熱い御飯の上に揉みかけ、その上に醤油をたらし、適当にわさびを入れて、茶を注げばよろしい。",
              "citation": {
                "source": "海苔の茶漬け",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼きのりの専門家は、昔は備長炭であったが、今では電熱器で焼いていることと思う。",
              "citation": {
                "source": "海苔の茶漬け",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
