        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アルヒ、ヤマキチ　ノ　トモダチデ、イチワ　ノ　オオキナ　タカ　ガ、ヤマキチ　ヲ　ヒロイ　ツバサ　ニ　ノセ、ヒコウキ　ノ　ヨウニ　ソラ　ヲ　トンデ、シバラク　タカイ　キ　ノ　ウエデ、ヤスミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ、ウマレテ　ハジメテ　コンナ　メズラシイ　ケシキ　ヲ　ミマシタノデ、フシギ　デ　タマリマセン。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、アソコニハ、サカナ　ト　イウ　キレイナ　オヨグ　モノ　ガ　イテ、ソレハ、ソレハ、オモシロイ　トコロダ　ト　タカ　ハ、ヤマキチ　ヘ　オシエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ、ソノ　ハナシヲ　キイテ、スグニ、ウミ　ト　イウトコロ　ヘ　ユキタクテ　タマラナク　ナリマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タカ　モ　トウトウ　コトワリカネテ、ソノママ　ツバサ　ニ　ヤマキチ　ヲ　ノセ、ウミ　ヲ　サシテ　トンデ　ユキマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タカ　ハ、ヤマキチ　ヲ　ソコ　ヘ　オロシ、シバラク　ソラ　ヲ　トンデカラ、マタ　ヨウス　ヲ　ミニクル　ヤクソク　ヲ　シマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ、ソコラニ　タノシソウニ　オヨイデ　イル　サカナ　ニ　イイマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　サカナタチ　ハ、ソレデハ　ココマデ　オヨイデ　キナサイ、ト　ヤマキチ　ニ　イイマス。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ　コマッテ、ボク　ハ　ヤマニ　ソダッテ　オヨギ　ハ　シラナイ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト　モウシマス　ト、サカナタチ　ハ、サモサモ　バカ　ニ　スルヨウニ、ワラッテ　オヨギ　モ　シラナイデ　ウミ　ニ　クルナンテ、キミ　ハ　オオバカサンダ　ト　イッテ　アイテ　ニ　シテ　クレマセンノデ、ヤマキチ　ハ　コンド　ハ　ナミ　ニ　ムカッテ、ボク　ヲ　オヨガセテ　クダサイ　ト　タノミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ナミ　ハ、ヤマ　ノ　コドモ　ガ　ウミ　ニ　クルナンテ　ナマイキダ　ト　オコッテ、ヤマキチ　ヲ　ヒトマキ　マイテ　イワ　ノ　ウエ　ヘ　タタキツケマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ　イタクテ　オイオイ　ナイテ　イマスト、タカ　ガ　ムカイ　ニ　キマシタノデ、イソイデ　ヤマ　ヘ　ツレテ　カエッテ　モライマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマデハ　ヤマキチ　ノ　ナカヨシ　ノ　イロイロ　ノ、トリ　ヤ　ケモノ　ガ、ヤマキチ　ノ　カエリ　ヲ、タイソウ　ヨロコビマシテ、ウタ　ヲ　ウタウヤラ、オドリ　ヲ　オドルヤラシテ　カンゲイ　シマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
