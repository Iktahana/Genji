        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女はいつも柔らかい笑顔で周りを和ませる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "柔らかい日差しが窓から差し込み、心地よい朝だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "先生の柔らかい口調に、生徒たちは安心して質問した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
