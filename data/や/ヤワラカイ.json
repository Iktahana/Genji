        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は柔らかい考え方をするので、新しいアイデアをすぐに受け入れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "柔らかい頭で問題解決にあたるべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
