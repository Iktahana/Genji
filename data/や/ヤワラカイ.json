        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "食事中に、私たちは柔らかい話題で会話を楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今日は疲れているから、何か柔らかい本を読みたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女はいつも柔らかい文体で記事を書く。",
              "citation": {
