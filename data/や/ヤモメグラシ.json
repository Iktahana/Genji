      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鰯の煮物を作るにも、しそと土しょうがをいれ、酢と醤油以外に水を使わず、些も生臭味の出ない様に煮るこつを心得ているといった風で、やもめ暮しに重宝であった。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻に死なれたあとずつとやもめ暮しの父の身の廻りのことを、一切やつて来たといふひとである。",
              "citation": {
                "source": "聴雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "早くに夫を失って、母はやもめ暮しの手ひとつで娘をこれまでに育て上げたのであるが、貧しい暮しの都合から、たった一人の娘を奉公に出すことになった。",
              "citation": {
                "source": "番町皿屋敷",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがに、久しぶりの寝酒が、まわって来て、髯だらけの顔が、赤黒く酔い染っているのに当人は、まだまだ、どうして飲み足りない――血濁った目で、あたりを睨め廻すようにして、独り言――　――だからよ、やもめ暮しはやり切れねえってことよ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は目下やもめ暮しであった。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "丹七はそれを天罰だと思い込み、爾来、やもめ暮しをしながら、あさ子を育てて来たのであるが、こうして再びあさ子の身の上に悲運が落ちかかって来たのも、やはり、自分の犯した罪のむくいであると考えざるを得なかった。",
              "citation": {
                "source": "血の盃",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "面白いことには、ね、先生の家族は細君の実家の田舎へ疎開して行って、今たった一人のやもめ暮しです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　気がついて見るとこの部落にはやもめ暮しの者が多かった。",
              "citation": {
                "source": "夏蚕時",
                "author": "金田千鶴",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏以来やもめ暮しの老いた父の消息も気がかりだった。",
              "citation": {
                "source": "父の出郷",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "良人なき者は縁談が纏まらず、やもめ暮しをするというのであった。",
              "citation": {
                "source": "壁の眼の怪",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲斐性のない、ひよわな奴めらは、悲しそうな眼つきで他人の寝室を偸み見ながら、すこし離れた砂浜の隅に集って、しょんぼりとやもめ暮しをすることになる。",
              "citation": {
                "source": "海豹島",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それに、近いうちに、伊勢屋の旦那と祝言するはずでございました」　飯田町の酒屋で、ちょっと知られた物持の伊勢屋治三郎は、三年前女房に死なれてから、三十五の男盛りをやもめ暮しをつづけ、お由良が懐へ飛び込んで来るのを、長いあいだ待っていたのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お由良の罪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それに、近いうちに、伊勢屋の旦那と祝言する筈でございました」　飯田町の酒屋で、一寸知られた物持の伊勢屋治三郎は、三年前女房に死なれてから、三十五の男盛りをやもめ暮しを續け、お由良が懷ろへ飛び込んで來るのを、長い間待つてゐたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お由良の罪",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸ひ寒さに向つて蛆も湧かず、無精でだらしがなくて、呑氣で贅澤な、男やもめ暮しをして居るのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お長屋碁會",
                "note": "青空文庫"
              }
            },
            {
              "text": "野村のやもめ暮しが、あわれをとどめているような、敷きっぱなしの布団をそのまま二つに折って部屋の隅に押しやっているのなどを見ると、ミネは貰った手紙に返事をしていないことも気になり、思いきって閑子のことをしゃべった。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "やもめ暮しのみじめさのようなものが、部屋一ぱいにみなぎっているようだった。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "階下で加藤伯父上らしき咳払ひがきこえて眼がさめる、伯父上、やもめ暮しの淋しさの朝散歩。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "やもめ暮しの味もいいものだね。",
              "citation": {
                "source": "メフィスト",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
