  {
    "uuid": "e2c1a471-9ddb-5361-80da-1f3170664d0d",
    "entry": "寡暮らし",
    "reading": {
      "primary": "やもめぐらし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
