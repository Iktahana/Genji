          "literary": [
            {
              "text": "オムレツと焼玉子の合の子のようなものが、メニューの中にあった。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "口取は焼玉子、栄螺（？",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが焼玉エンジンですよ。",
              "citation": {
                "source": "水鳥亭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後は定期船がないから、漁師のチッチャな焼玉エンジンで大島へのりこむツモリであった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
