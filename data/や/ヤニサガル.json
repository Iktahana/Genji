        "examples": {
          "standard": [
            {
              "text": "成功にやに下がるのではなく、常に向上心を持つべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は少し褒められただけですぐにやに下がってしまう癖がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "競争の激しいこの業界では、やに下がっている暇はない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "わしは酒飲みの馬鹿ですが、御一同にだまされて、金が子を産んだと、やにさがるほど耄碌はしていません。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何者か実は訣らないものでも、さう言はれゝばやにさがる心持ちになる。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
