        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "突然の高熱で、彼は床に病み付いてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女はストレスから、心身ともに病み付いてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "季節の変わり目に病み付くことが多いので、体調管理には気を付けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "聽いたまゝ、元金をきつての話ですよ――そこで病みつくほどお袖に惚れてゐる彦太郎は、影法師に取り憑かれたのも、無理はないぢやありませんか。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "影法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚お郊外散歩の積りで再三足を運ぶ中に好いところばかり目に映ってクリーム色の文化住宅に病みつく。",
              "citation": {
                "source": "好人物",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山下家の子供は病みつくのも早いが、手当が早いから直るのも早い。",
              "citation": {
                "source": "嫁取婿取",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうどのくらい行ったろう、箱根はぶじに越したろうか、馴れない土地は水にあたり易いという、病みつくようなことはないかしらん、そして、よく人の話に聞く道中の恐ろしい出来事や、思いがけない災難があれこれと想像されて、ぞっと寒くなるようなことも度たびだった。",
              "citation": {
                "source": "柳橋物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――私やあなたが病みつくにしろ、死ぬにしろ、それは巡儀だけれど」　不吉な予感に、並川元子の声はふるえだしていた。",
              "citation": {
                "source": "日めくり",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼としては充分に病みつくだけの理由はある。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
