        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "法師の納涼はヤヽ大なり。",
              "citation": {
                "source": "大野人",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ誠に納涼のヤヽ大なるものなり。",
              "citation": {
                "source": "大野人",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "「縁談などゝいうものはマトモすぎるからヤヽコシクて、これがあなた、当世のヤミ商談なら、公定千円の紙、ヤミに流して二千五百円、これを百レン買って二十五万円、これを一万何千部かの本にして一冊七十円、七カケで売ってザッと七十万、諸がゝりをひいて、二十万はもうかる。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤヽ意ニ当ラザレバ則チ狂呼｜怒罵シテソノ座人ヲ凌辱ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "山崎長之輔ノ一座ニ属シ中洲ノ真砂座ニ出テイタガ、ヤヽ老イテカラハ六代目ノ面差ニ似テイタ先代嵐芳三郎ノ相手役トシテ宮戸座ニ出テイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ間ニ十五分ヲ二十分ニ伸バシ、滑リ台ノ傾斜ヲヤヽ急ニシテ頤ヲ一層引ッ張リ上ゲルヨウニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤヽ接吻ニ似タ味ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤヽ拍子抜ケガシタ感ジ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤヽ小サイ目ニ締メテ、垂レヲ普通ヨリ長イ目ニ垂ラシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ヤヽ長時間湯ニ漬カッタオ蔭デ手ノ痛ミ少シ和ギ安眠スルコトヲ得タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬ハイロ／＼ゴザイマスカラ、ドルシンモオイヤ、ノブロンモオイヤデシタラ、取リ敢エズパロチンノ注射デモシテ見マショウ、一時ノ苦痛ハ凌ゲルト存ジマス」注射ノ結果ヤヽ軽快ニ赴ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハソレデモヤヽ元気ナノデ少シ書ク気ニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
