        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十｜年相見ぬ間に彼には立派な八字髯も生へ、其風采も餘程變つて居るが相變らず洒々落々の男『ヤァ、柳川君か、これは珍らしい、珍らしい。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "その三いヤァハレ海原や青海原。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤァハレ青雲やそのそぎ立、その極み、こをば。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ろヤァハレ潮※のとどまるかぎり、舟の舳の行き行くきはみ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤァハレ島かけて、八十嶋かけて、大海に舟満ちつづけて。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はヤァハレ国土や、大国土。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤァハレ国の壁そのそぎ立、その極み、こをば。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "にヤァハレ青雲のそぎ立つきはみ、白雲の向伏すかぎり。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤァハレ谷蟆のさわたるきはみ、馬の爪とどまるかぎり。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤァハレ島かけて、八十嶋かけて、大海に舟滿ちつづけて。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はヤァハレ國土や、大國土。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤァハレ國の壁そのそぎ立、その極み、こをば。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "』は二度目だけど、『ヤァ！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたしは、やっぱり『ヤァ！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　厭がる綾子を無理に引き捕へて座敷の真中に突ッ立たせると、彼はまた「ヤァ！",
              "citation": {
                "source": "眠い一日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の菜の中で予輩の一番閉口したのは、輪切大根と菜葉とのときで「ヤァ今日は輪大か」と嘆息するのが常であった。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――僕のマドロス・パイプはブライヤァだ。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでブライヤァとは薔薇の根であり、薔薇の根で作ったパイプは上等だと、始めて教えてくれたのは清岡さんだったわけだ、と。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブロンティの作品は、この作のほかに三つ――中に就いて、「シヤァリ」は、手工業時代が機械工業時代に入らうとするその革命的雰圍氣を背景にしたスケールの大きな、野心的な長大篇で、部分部分に、素晴らしい描寫があるが、未完成の謗りは免れない。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "解説",
                "note": "青空文庫"
              }
            },
            {
              "text": "この悲慘を極めし中にあつて、大作「シヤァリ」執筆出版。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "解説",
                "note": "青空文庫"
              }
            },
            {
              "text": "米の大袋を背負い、両手に十羽の鶏をぶら下げて大道せましと歩いても、ヤァお相撲さんか、腹がへるだろう、とお巡りさんが全然可愛がってくれるのである。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後三時頃、スミス先生が、二ヤァドばかしのモスリンの端切を、針や指輪と一緒に私に渡して、教室の靜かな隅つこの方へ引つぱつて行つて、この縁をとるようにと指圖してくれた時は嬉しかつた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
