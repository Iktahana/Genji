    "definitions": [
      {
        "index": 1,
        "gloss": "escape from evil",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "悪いことが続いたので、景気づけにパーッとお酒を飲んで厄落としをしよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "節分の日に豆をまき、大きな声で「鬼は外」と言うのが我が家の厄落としだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "お気に入りの食器が割れてしまったが、「身代わりになってくれた」と厄落としに捉える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そんなには要らないから、包を破いて、自分で一つだけ取って、ああ、厄落し、と出よう、とすると、しっかりこの、」　と片手を下に、袖をかさねた袂を揺ったが、気味悪そうに、胸をかわして密と払い、「袂をつかまえたのに、引張られて動けないじゃありませんか。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "話をするうちに、さく／＼と雪を分ける音がして、おん厄拂ひましよな、厄落し。",
              "citation": {
                "source": "火の用心の事",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おん厄拂ひましよな、厄落し。",
              "citation": {
                "source": "火の用心の事",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがの文三も遂には肝癪を起して、厳しく談じ付けて、不愉快不平な思いをして漸くの事で食事を済まして、勘定を済まして、「毎度｜難有御座い」の声を聞流して戸外へ出た時には、厄落しでもしたような心地がした。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十二の古ふんどしや厄落し（二月六日）　我国語の字書は『言海』の著述以後やうやうに進みつつあれどもなほ完全ならざるはいふに及ばず。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "年占・祈年・左義長・鳥追ひ・道祖神祭・厄落しは、何の日に行うてもよいわけである。",
              "citation": {
                "source": "髯籠の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "大晦日と、十四日年越しと、節分とは、半月内外の遅速はあるが、考へ方によつては、同じ意味の日で、年占・祈年・左義長・道祖神祭・厄落しなどは、何の日に行うてもよい訣である。",
              "citation": {
                "source": "盆踊りと祭屋台と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "余銀座の支店に少しばかり貯金あれど、今更如何ともすべき道なければ、本年厄落しのつもりにて棄てゝ顧ず。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "万年青が枯れたのが厄落しになろう。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "稲荷の使",
                "note": "青空文庫"
              }
            },
            {
              "text": "厄落しということがある。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧乏人の怨みの塊り見たいな金だ、盜られたら飛んだ厄落しだらうと思ふと大違ひ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "三軒長屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君、君、どうです一杯」「やあ、そう飲まされちゃ、空き腹だからこたえますなあ」「まあいいでしょう、今夜は僕の厄落しだから、一つ祝杯を挙げて下さい。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
