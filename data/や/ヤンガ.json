        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "但し、ギラ・コシサンがキッパリとあのモゴルの女と切れた上で、自ら遥々カヤンガル島に渡り、其の地の名産たるタマナ樹で豪勢な舞踊台を作らせ、それを持帰った上で、其の披露｜旁々二人の夫婦固めの式を行うという条件つきである。",
              "citation": {
                "source": "南島譚",
                "author": "夫婦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はなけなしの珠貨を残らず携えてカヤンガル島に渡った。",
              "citation": {
                "source": "南島譚",
                "author": "夫婦",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の間カヤンガルの浜辺の小舎に起臥しながら、ギラ・コシサンは時々懐かしいリメイのことを心細く思い浮べた。",
              "citation": {
                "source": "南島譚",
                "author": "夫婦",
                "note": "青空文庫"
              }
            },
            {
              "text": "程経て、例のカヤンガル出来の舞踊台を村の衆に披露し、旁々盛大な｜夫婦固めの式を挙げたことは言う迄もない。",
              "citation": {
                "source": "南島譚",
                "author": "夫婦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方、エビルは、夫がまだカヤンガルで舞踊台の出来上りを待っているとのみ思って、日夜数人の未婚の青年を集めて痴情に耽っていた。",
              "citation": {
                "source": "南島譚",
                "author": "夫婦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この結社は北はカヤンガル島から南はペリリュウ島に至る迄相当根強く喰込んでいたが、当局は島民間の勢力争いや個人的反感などを巧みに利用して、着々と摘発検挙をすすめて行った。",
              "citation": {
                "source": "南島譚",
                "author": "※",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の家には、昔その祖先の一人がカヤンガル島を討った時敵の大将を唯の一突きに仕留めたという誉れの投槍が蔵されている。",
              "citation": {
                "source": "南島譚",
                "author": "幸福",
                "note": "青空文庫"
              }
            },
            {
              "text": "――樹明君近来の口癖はブチコワスゾである、何カヲブチコワサズニハヰラレナイホド、君は悩み苦しみ焦立つてゐる、そこで、私が先づ茶碗をぶちこはす、樹明君喜んで皿を投げつける、ガチヤンガラガラ、どうやら胸がすいたらしい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカチヤンガ　ノツテ　ヰテ、カキマハシタノデシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンノ　ウデニ、オチチクサイ、シロイ　パヂヤマノ　カハイラシイ　アカチヤンガ、ダカレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストライキから掴まって転向、というヤンガアジェネレェション一通りの経過をへたぼくが、狂熱的な文学青年になったのは、オリムピックの翌々年の春でした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る者はそれを知識の開明に帰し、或る者は勇しき偶像破壊と呼び、モラールの名を無みすることは、ヤンガー・ゼネレーションの一つの旗号の如くにさへ見える。",
              "citation": {
                "source": "善くならうとする祈り",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある者はそれを知識の開明に帰し、ある者は勇ましき偶像破壊と呼び、モラールの名をなみすることは、ヤンガー・ゼネレーションの一つの旗号のごとくにさえ見ゆる。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤンガー・ゼネレーションのこうした気風は私を嘆かしめる。",
              "citation": {
                "source": "学生と生活",
                "author": "――恋愛――",
                "note": "青空文庫"
              }
            },
            {
              "text": "資本主義が日本よりも遙かに後れている中国に於ては、ヤンガージェネレーションの女性インテリの社会的地位は、平均して日本よりも確かに高いと云わねばならぬ。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤントワンコチヤンノナキゴヱヲキイテ、オ母サンハ、キツト、ワンコチヤンガモンコチヤンニホエツイタノダラウトオモヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンノオ父サンハボンコチヤンガカハイサウニナリマシタカラ、クワイ中電燈ヲモツテ、ワンコチヤンヲツレテ、ボンコチヤンヲサガシニユキマシタケレド、アタリハマツクラ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルノボーイサンハボンコチヤンガトテモ美シカツタノデトテモヨイオ部屋ニアンナイシテクレマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラタチノ　カキノナカカラ　タカヲチヤンガ　ヨンデル。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々がヤンガー・ジェネレーションの為に、アルプスの冬季の魅力と富源とを発見して教えたことは事実だが、復活祭の休暇に於けるアルプスは僅かなアトラクションと多くの危険とを持っている。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシネエチヤンガ足ヲオハナシニナルト、ソツチノミミハマタパタリトタオレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――………ネエチヤンモウサギノミミヲツマンデ、立テテオヤリニナリマシタガ、ネエチヤンガソノミミヲオハナシニナルト、マタパタリトタフレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エヴリタイム・アイ・シー・ヨ・マザー、シー・ルックス・ヤンガ。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホワッツ・ザ・シークレット」「イッツ・ヨ・アイボールズ・ザット・ゲット・ヤンガ。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルー・ヨ・アイボールズ・シー・ルックス・ヤンガ・ザッツ・ザ・シークレット。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤンガー・ゼネレエション拍手｜喝采というところであるが、発声撮影でないのが遺憾の極み。",
              "citation": {
                "source": "メフィスト",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
