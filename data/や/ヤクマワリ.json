        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今回のプロジェクトでは、私はリーダーの役回りを務めることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は常に縁の下の力持ちのような役回りを選んで引き受ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その俳優は悪役の役回りが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "この紳士を見つけ、このささやかな謎でどういう役回りを演じているのか確かめること。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "役回りが違うよな、それじゃあ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "雄吉は、そう考えると、その日学校から帰ると、自分が家庭教師兼書生といったような役回りをしている近藤家の主人に、涙を流さんばかりに青木の救済を頼んだ。",
              "citation": {
                "source": "青木の出京",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかな旧｜組頭の庄助もこの役回りには当惑した。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがっていわゆる長吏の輩は、警察吏として相当の権力を有し、ことに社会の必要な役回りをつとめる者として重んぜられ、もちろん生活上には何不足のない身分ではありましたが、不幸にして身が穢れているとの迷信から、普通民との交際は拒絶せられたのです。",
              "citation": {
                "source": "融和促進",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕はまた馬鹿な役回りを勤めちゃったんだ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの男はそんな役回りにはあまり善人すぎますからね。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はあたかもマリアのようでよい役回りをもっていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに、この男は我々の社会の巨大な歯車の中で間抜けな役回りを演じてきたと思われ、自分を散々利用してきた相手が誰だかにさえ気づかない、よくいる頓馬なパリジャンで、どの回転軸が、不運とか世の汚物の方向に人を向かわせるのかも勿論分からない。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪のうえはけものの足跡縦横に、ひとところ、これはあたらしいというより猟師がすばやくまわりこんだ大木の根かたから、ぱっと金光をはなってとびさったものがあった、テンマル（貂）だという。",
              "citation": {
                "source": "山岳浄土",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ自首をすすめるのでも、おれの方は悪い役まわりや」　しょんぼりした声だが、しかしふとえくぼが泛び、したたるような微笑をたたえながら豹吉は言った。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ――」　しかたなく、封筒といっしょに、イヤな役まわりまで引き受けることになってしまった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "村川君の役まわりからいって、きっとそうだ。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "便所掃除のごとき汚い役まわりもあれば、炊所係のごとき摘み食いのできる役廻りもある。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山川君もほぼわたしと同じような役まわりを勤めていたらしい。",
              "citation": {
                "source": "赤旗事件の回顧",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "家から出しさえせねばよいのじゃから、遊び半分の楽な役まわりをおおせつかったというものじゃテ」　草むらにあぐらをかいた下役どもは、ひなたぼっこと雑談を仕事と心得て、こうガヤガヤ話しこんでいる。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺人宣告書は誰がもっているのか分らないが、一体誰が殺される役まわりになっているのだろうか。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "海を泳いだり、つるつる卵をかかえたり、それからよ、恐竜にいやな目でながめられたり、いい役まわりじゃねえ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前、これから、戦車の隅から隅までさがして、幽霊がいないかどうか、たしかめてみろ」「そ、そんな役まわりは、ごめんです」「なに、お前は、上官の命令に背くのか」「いえ、そんな精神は、ないであります。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで自分のつとめていた滑稽な役まわりが、この時｜忽然として新しい光に、照される事になったからである。",
              "citation": {
                "source": "西郷隆盛",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢の中の妻は気の毒にもうまらない役まわりを勤めている。",
              "citation": {
                "source": "死後",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "埋まらない役まわりは僕一人さ。",
              "citation": {
                "source": "一夕話",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう場合の役まわりは、宇治山田の米友ならば適任かも知れないが、駒井甚三郎ではあまりに痛々しい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "豪傑連は、この豪胆な貴公子の意気を喜びましたけれども、その豪胆通りに実際が行われるものでないことを、懇々と説諭しなければならぬ役まわりになりました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "この役まわりがえりにえって秀吉公にわりあてられましたのは、笑止と申しましょうか、おきのどくと申しましょうか。",
              "citation": {
                "source": "盲目物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "富子さえいなかったら、おれはこんないやな役まわりをおしつけられることもなかったんだ。",
              "citation": {
                "source": "演技の果て",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
