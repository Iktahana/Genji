  {
    "uuid": "6a8510a3-a621-50ca-8b8a-4f594cb8a75c",
    "entry": "野気",
    "reading": {
      "primary": "やき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "野は一面に野気の陽炎。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "野気は多けれど塵気は少し。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "海潮の気を潮気といい、山岳の気を山気というように、河気といい、沢気といい、野気といい、泉気といい、虹気といい、暈気といい、塵気といい、雲気といい、日輪の両傍に現われるものを珥気という類で、実に数限りもないが、これ等もまた皆その物より発するその微分子のようなものを称すると理解して差支えない。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "今彼が得て帰つた「医師高間房一」としての地位は、河原町に対する彼の野気を示すに恰好なものであつた。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、あの身うちから溢れるやうに頭を持上げて来る野気を失つたわけでもない。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
