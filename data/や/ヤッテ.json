        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ノッソリ出テ来テ、蠅タタキノ如ク、バタットヤッテ、ウムヲ言ワサヌ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋ハ夏ト同時ニヤッテ来ル。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシタイテイハ風トイッショニ雨ガバラバラヤッテ来テ道ヲ悪クシテイルノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、君チャンハヨナカニ目ヲサマスト、ブルブルフルエナガラ、何ンダカオッカナクテ、オ母ッチャトコエモ出セズニ、ソート手ダケヲノバシテヤッテ、ユスルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "イソイデ、オ母ッチャノ方ニ手ヲノバシテヤッテ、ヨナカニコエヲ出スノガオッカナイノデ、ハジメダマッテユスッテイタガ、オ母ッチャハナカナカ目ヲサマサナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシキハソコノ人ガタクサンアツマッテ、ドウニカヤッテクレルコトニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビンボウ人ッテ、ミンナコウヤッテ、オ父ッチャガ死ニ、オ母ッチャモ死ニ、ジブンモ死ナサレテユクモノダナンテ、何ントイウコトダロウ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボルシェビキ的積極性で、ヤッテ来イ※職場アジプロ委員　全体赤い字のところへ、「食糧問題」とだけ黒だ。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マモナクブルル……トイサマシイ　オトヲタテテアカイヒカウキ　ガタスケニヤッテキマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ暑イノニ、予ハトテモソンナコトヲスル気ハナカッタガ、外ニコレト云ウ治療法モナイカラ、マアヤッテゴランナサイト杉田氏ハスヽメル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コルセットト滑リ台ガ出来テ参リマシタカラ、思イ切ッテヤッテ御覧ニナリマスカ」気ハスヽマナイガ、コノ調子デハ試験的ニシテ見ヨウカト云ウ気ニモナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――近頃ハ伯父サン、オ見受ケシタトコロ大層オ元気デ」「ナーニダン／＼老イ惚レガ激シクナッテネ、毎日颯子ニ叱ラレテバカリイルヨ」「イヤ、イツマデモオ若イッテ、颯チャンガ感心シテマスガ」「飛ンデモナイ、今日モコウヤッテ鍼ナンカシテ貰ッテ、辛ウジテ露命ヲツナイデルノサ」「ソンナコトガアルモンデスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンガ颯子トノ結婚ニ反対シタ当時、「踊リ子上リナンゾッテ云ウケレド、キット彼女ハ家政ノ切リ盛リナンカモ上手ニヤッテ行キマスヨ、ソウ云ウ才能ノアルコトヲ僕ハ見抜イテルンデス」ト浄吉ハ云ッタガ、アノ時ハ恐ラク当寸法ヲ云ッタノデ、先見ノ明ガアッタ訳デハアルマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アンマリ大事ヲ取リ過ギルンダワ、アノクライ血ガ出タッテ、何モソンナニ恐ガラナイデヤッテ下サル訳ニ行カナイノカシラ」ト、佐々木ガヒソ／＼声デ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヤ、ソコガアノ方ノ偉イトコロデスヨ、麻酔ドクターマデ呼ンデ十分ノ用意ヲシテカヽッタンダカラ、誰デモヤッテシマイタクナルトコロダガ、僅カ一滴ノ血ヲ見タヾケデモ大事ヲ取ッテ中止スルト云ウコトハ、ナカ／＼出来憎イコトデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "車ノ中デモ杉田氏ハ頻ニ博士ノ態度ヲ賞讃シテ已マナイ、佐々木ハ「思イ切ッテヤッテシマエバヨカッタンジャナイデショウカ」ヲ繰リ返ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ足ノ指ノ股マデモキレイニ拭イチテヤリ、「君、ソノ手ノ指ノ股ヲ拭イテヤッテクレタマエ」ト木村ニモ命ジタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分二人トモ打撃ニ堪エテヤッテ行ケルト思イマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
