        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "綿菓子、焼きソバ、お好み焼きなどのにおいが、鼻を打った。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "リリーが何か食べたいというので、入って、私のためにはチキンカレー、リリーのためには、焼そばと卵のスープを取った。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひる終って、又マーブルへでも行きたかったが部屋にゐて、チキングリルと来々軒の焼そば。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼そばをとってかっ込む。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
