        "examples": {
          "standard": [
            {
              "text": "お祭りの屋台で食べるソースの香ばしい焼きそばは、夏の風物詩だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "家で手軽に作れる焼きそばは、忙しい日のランチに最適だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "定番の具材だけでなく、シーフードや豚肉を入れた焼きそばも美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "例によって、映画館のすぐそばの中華料理屋でも、焼きそばを食べたい、という慶一に、カイリの呪いをかけて、三枚肉を柔らかく煮こんだものと、エビのチリソース炒めにしろと強制し、最後に、骨付き肉を唐揚げにしたものがのったラーメンを食べさせた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "給仕女に注文を聞かれて、富岡は焼きそばを頼んだ。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（お前は、俺にていよく殺される事も知らないで、にこにこ笑つてゐるンだよ……）富岡は、猛烈な食慾で、焼きそばを食べてゐるゆき子を見てゐた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "富岡は冷えた焼きそばの上に散らかつてゐる、葱や筍を肴に、酒を飲んでゐる。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "黙って五仙の「やきそば」を、ながいことかかって食っていた。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "○神田×月楼のやきそば――東洋キネマ横の小支那そば屋のやきそば。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "上海亭で一人でやきそばなど食ひ、座へ帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一本刀土俵入」を見て、又井口の自動車で神田へ寄り、杏花楼でやきそば食って上野へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "山水楼のやきそばだけで腹をこしらへ、夜十時頃から「ハリキリボーイ」にかゝった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかげで夕食は楽亭のやきそばと五目めしで済んじまった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "１番から焼売とやきそば取って食ひ終るともう五時すぎ、夜の「荒神山」眠くて弱った、「楽天」よく受ける、気持よし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
