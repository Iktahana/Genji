        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "家捜しが手間どったら寄らずに帰る」切り取った回数券はじかに細君の手へ渡してやりながら、彼は六ヶ敷い顔でそう言った。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人を雇い、押し込んで家捜しをさせたのが二度。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつ警察が私の身体を探ったり、家捜しをするか分かったもんじゃない。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんなら、ゆうべたたいた鼓を家捜ししてやってもいいぜ」「…………」「黙ってたんじゃわからねえよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "袈裟切り太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "家捜し穴捜しとなりゃ、伝六様も日本一なんだからね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのひょろひょろとした長っぽそい二階家がそうだというんですよ」　家捜しとなれば伝六自慢の一つの芸です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かいわくがあって江戸紫の命を断ったにちげえねえから、家捜しやってみな」「ちくしょうッ、なんとも気に入ったことをおっしゃいましたね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて納屋方では兩夫人を内藏に入れ、又家捜しをせられた時の用心に、主人小左衞門が寢所の板敷を疊一疊の幅だけ穿つて、床下に疊を敷き、藏からそこへ移すことの出來るやうにして置いた。",
              "citation": {
                "source": "栗山大膳",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで相談の上あらためて家捜しをすることになって、念のために床下までもあらためると、台所の揚板の下には炭俵が二、三俵押し込んである。",
              "citation": {
                "source": "半七捕物帳",
                "author": "蝶合戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼児は正直者ですから、他から嫌疑を受けて家捜しをされたなどと聞くと、必然憤るに相違ありませんから……。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうして学校を休んだかと聞くと、貸家捜しで学校どころじゃないそうである。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなに忙しがるくせに、きのうは散歩だか、貸家捜しだかわからないようにぶらぶらつぶしていた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "平生から締まりのないうえに、きょうは家捜しで少しせきこんでいる。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから組頭が捕まえられると同時に家捜しをされて、当人はそのまま伝馬町に入牢さ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫れから脇屋を捕まえると同時に家捜しをして、そうしてその儘当人は伝馬町に入牢を申付けられ、何かタワイもない吟味の末、牢中で切腹を申付られた。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "又その後明治二十年頃かと思う、井上角五郎が朝鮮で何とやらしたと云うので捕えられて、その時の騒動と云うものは大変で、警察の役人が来て私方の家捜しサ。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "おやじが口へ手拭を押こまれて、菰で簀巻にされてふるえているあいだに、竜神とその使女はどこからどこまで家捜しして、あくる朝、家族と店の連中が帰ってきた時には、現金はもちろん金目の物は何一つ残っていなかったという、まことにさっぱりしたはなし。",
              "citation": {
                "source": "早耳三次捕物聞書",
                "author": "海へ帰る女",
                "note": "青空文庫"
              }
            },
            {
              "text": "家捜ししなよ、俺の家を、きっとどこかにあるだろう。",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝飯を済まして、書留だったらこれを出せと云って子供に認印を預けて置いて、貸家捜しに出かけようとしている処へ、三百が、格子外から声かけた。",
              "citation": {
                "source": "子をつれて",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日の家捜しの時にはなかった三千円だ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「暁子のほうは、じぶんに会いにきてくれると思いこんでいるので、愛一郎がいるあいだじゅう、そばを離れないから、家捜しをすることができない。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘘だとお思いならば家捜しでも何でもなされませ。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "踏込んで家捜しすれば、川越屋の音次郎が、諸方の寺々から盗み出した、宝物の三つや四つは、この屋敷から出るはず、免れっこはありませんよ、旦那」「…………」「川越屋を殺したのは、わけのあることでしょう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お染の歎き",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまり馬鹿馬鹿しいから断ると、目安箱へ一本｜抛り込んで、佐野屋の家捜しをさせる。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お染の歎き",
                "note": "青空文庫"
              }
            },
            {
              "text": "「居ない、――そんなはずはないが」　もう一度くり返して家捜しするところへ、「親分、骨を折らせやがったぜ」　女を滅茶滅茶に縛って、八五郎は帰って来ました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "百物語",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐ろしく行届いた奴だ」「お六婆アは本当に金を持っていたんだろうか」「三十年後家を通して、烏婆アとか何とか言われながら、溜めたんだから、三十両や五十両じゃあるまいと思うが、天井裏も床下も、糠味噌の瓶の中まで見たがないよ」「六軒長屋の家捜しは？",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "六軒長屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三輪の親分が乗り込んで来て、丸山町の直助の家を根気よく家捜ししましたぜ」「何か出たかい」「何にも出ないから不思議で、――出たのは真物の小判が三両ばかり」「それから」「三輪の親分もすごすごと引揚げましたよ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "二枚の小判",
                "note": "青空文庫"
              }
            },
            {
              "text": "「このあいだ三輪の親分が来たそうだな」「ヘエ――、家捜しには驚きました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "二枚の小判",
                "note": "青空文庫"
              }
            },
            {
              "text": "四「何にもない」　鋳掛屋権次の家へ踏込んで、一とわたり家捜しした平次は、さすがに呆れ返って埃だらけになった手を叩きました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
