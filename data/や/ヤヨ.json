        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのそばから、小倉と三上との声で、エンヤヨイヤ、エンヤヨイヤ、と聞こえて来るのだった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「新聞に書いちゃイヤヨ。",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんつくどんつくドッコイショどんつくどんつくドッコイショヨンヤヨンヤヨンヤヨンヤ　どうも一向面白くない。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このヤヨイ号には、ある特別な用事をおびて、ヨーロッパへわたる特使団の一行がのっていた。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤヨイ号は、仏領インドシナ某地点で、多量のガソリンやオイルを積みこんでから、ふわりと空へまいあがったのであった。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤヨイ号は、ついに、この大難所にさしかかった。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "機の前面には、今にもぶつかりそうな峰々が、一つまた一つ、ヤヨイ号をおどかすようにあらわれる。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思いませんか」　ヤヨイ号には、四つの発動機がついて、さっきまでは、ゴーンゴーンとこころよい響をだしていたのが、ここへ来て、急に調子がわるくなって、ときに、するするッととまる。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、ヤヨイ号は、かたい雪の斜面に、ななめにかしいだまま、腹ばいになっているのであった。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "石斧をもったまま、手をヤヨイ号の残骸の方へのばし、「あれは一体なんだ。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤヨイ号じゃないか」「ああ、やっぱりヤヨイ号か。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ああ、よかった」「なにが、よかったって」　博士にきかれて、やむなく道彦は、ヤヨイ号の遭難のことや、氷河期の怪人があらわれたことなどを話した。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤヨイ号は、ぶじに雲をぬけて、ヒマラヤ山脈は、もうはるかうしろになってしまったよ。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵便配達ノダテウサンハ、キシヤヨリモハヤクカケテ、ソレヲ、モンコチヤンノオ家ヘトドケマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき入口をあがりこんだ中也が急に大きな声で、「ヤヨ、女はをらぬか、女は」　と叫んで、キョロ／＼すると、「何を言つてるのさ。",
              "citation": {
                "source": "二十七歳",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき入口をあがりこんだ中也が急に大きな声で、「ヤヨ、女はおらぬか、女は」　と叫んで、キョロキョロすると、「何を言ってるのさ。",
              "citation": {
                "source": "二十七歳",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "下の門までお迎いに出ますわ」　てな猫撫で声でフンワリと誘いかけたが、むこうも並の頭でないから、たちまち感づかれて、「イヤヨ」　と、はっきりと断わられてしまった。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その点、ミドリさまのほうもおかしいので、出なければ出なくともすむのに、イヤヨというひと言をいうために、根気よく電話に出る。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんであっちの方にゃ、」と今度は左の肉球をふって、「ヤヨイウサギ。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリスはどうせまた出てくると思ってしばらく待ったんだけど、どうも出てこないので、ものの数分するとヤヨイウサギが住んでると言われた方へと進み出してね。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぼうし屋は見たことあるから、」とひとりごと、「ヤヨイウサギの方がきっともっとずっと面白いはず、でもまあ今は５月だから、そこまでおかしくはないかも――少なくとも３月ほどおかしくないかな。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そんなに歩くわけでもなくすぐにヤヨイウサギのおうちが目に入ってくる。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」７　おかしなお茶会　なんとひとつのテーブルが家のまん前の木かげにもうけられてあってね、ヤヨイウサギとぼうし屋がそこでお茶のまっ最中。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と景気づけにヤヨイウサギ。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とたたみかけるヤヨイウサギ。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ほかにも、」と付け加えるヤヨイウサギ、「『ものになるってことは好きだ』と『好きだってことはものになる』、これも同じか！",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
