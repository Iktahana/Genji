        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それからお母さんへは毎日お菓子やなんか沢山あげるんだ。",
              "citation": {
                "source": "いてふの実",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばペレクローエフとかなんとか……　とにかく、いろんな地主の名前を沢山あげましたがね。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人は我々以上に紙鳶あげをするので、大人も沢山あげている。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "」その他精神力を集中させるために冗談に賭けをしかけたり、子供には懸賞の御褒美を約束したりして、異常な好成績をあげた例が、断片的に沢山あげられている。",
              "citation": {
                "source": "心霊現象と科学",
                "author": "――『心の領域』について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏の足、深山あげ、深山茶づけ、皆うまく大いに食った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の終り、鳴瀬の鳥の山やき、深山あげ、茶漬を食ひに行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼終って、鳴瀬へ又行く、山やきと深山あげ、それに深山茶漬。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の部終ると、又鳴瀬へ鳥の足と深山あげを食ひに出かける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼終りには、鳴瀬へ鳥のあしをかぢりに行く、深山あげと茶漬。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "終ると、腹は減るし、ものかなしい、京都の町へ出てギルビイで一杯のみ、鳴瀬へ行って、深山あげで海苔茶漬を食ひ、腹が張って苦しい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほかオカルティズムの大家イリー・スタアの著書「実存の神秘」などには面白い実例が沢山あげてあるが、いま言及しているいとまがない。",
              "citation": {
                "source": "探偵小説の「謎」",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
