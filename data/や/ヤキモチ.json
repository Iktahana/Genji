        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "正月の残りの餅をストーブの上で焼きもちにして、砂糖醤油で食べるのが楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ぷっくりと膨らんだ焼きもちに、パリパリの海苔を巻いて磯辺焼きにする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "寒い冬の日に、縁側でハフハフ言いながら焼きもちを頬張る幸せ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
