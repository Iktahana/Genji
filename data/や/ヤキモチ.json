      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "jealousy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女が他の男性と親しげに話しているのを見て、思わず焼きもちを焼いてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は独占欲が強く、些細なことですぐに焼きもちを焼くタイプだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「そんなに焼きもちを焼かないでよ、ただの同僚なんだから」となだめられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "相も変らず酔いどれて、女房に焼きもちを焼いて、破廉恥の口争いをしたりして、まるで地獄だ。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "かねて、こんな時にこそ焼きもちを焼いてもらうために望んでめとった女房ではあったが、さて、実際こんな工合いに騒がしく悋気を起されてみると、あまりいい気持のものでない。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "七ツなんでも焼きもち焼いて。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこんな頑丈な身体をしておりますけれど、ひどい焼きもちやきなんです。",
              "citation": {
                "source": "アパートの殺人",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "お角としては、この頃中、とかく、がんりきが焼きもちを焼きたがるのに、うんざりしないでもありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へば、頑固、吝嗇、焼きもちやき、いつかう苦になりません。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたは焼きもちを焼いてるのよ。",
              "citation": {
                "source": "速水女塾",
                "author": "四幕と声のみの一場よりなる喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は、僕に焼きもちを焼かせて、よろこんでるんだ。",
              "citation": {
                "source": "速水女塾",
                "author": "四幕と声のみの一場よりなる喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "――もし堺屋さんのお上さん、つまらねえ焼きもちは、焼かねえ方がようがすぜ」「なにいいなはる」「なにも蟹もあったもんじゃねえ。",
              "citation": {
                "source": "おせん",
                "author": "邦枝完二",
                "note": "青空文庫"
              }
            },
            {
              "text": "父の注意がこっちに向かないのに焼きもちを焼いて、腕を引っ張ったのです。",
              "citation": {
                "source": "ドラムガニョールの白い猫",
                "author": "Ｊ. Ｓ. レ・ファニュ　J.S.Le Fanu",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「やきもちだらう。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あら、あなたこそ、やきもちを燒いてゐるんぢやない？",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「やきもちを燒くなんてそんな下品な事をするおれではない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまり不実だとか薄情だとか云うんで、手前は師匠とやきもち喧嘩をしたろう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お化け師匠",
                "note": "青空文庫"
              }
            },
            {
              "text": "禰宜　箒で、そのやきもちの頬を敲くぞ、立ちませい。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あら、あなたこそ、やきもちを焼いてゐるんぢやない？",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「やきもちを焼くなんてそんな下品な事をするおれではない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "正直に白状すればとてもやきもちが妬けますの。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "正直に言わなけりゃ、もっとやきもちが、ひどくなりそうなの。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "津田氏よりも私のほうが、もっとやきもちやきなのかも知れないと思ったからである。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "異人さんはやきもちやきよ。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇気、失望、狡猾、落胆、負け惜しみ、慰め――その間には叩かれた女の掌のやきもち筋も見えるよ。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほほほほほ、私がやきもちなんか焼いているとお考えになると、それは貴君の誤解ですわよ。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "私、あんな人に対して、やきもちを焼くほど、自分をみじめたらしく考えたくないんですの。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、素直に、正面からやきもちを焼くなどということは、彼女の誇が絶対にさせないことである。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「綺麗な方だわ、だけど、どうも人間にあんな綺麗な方はないと思ったら、やっぱり狐ですよ、私は蓮香さんが帰るとき、後からつけて往くと、南の山の穴へ入ったのですもの」　桑はそれは李のやきもちだろうと思ったので、いいかげんにあしらっていた。",
              "citation": {
                "source": "蓮香",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなた、大変ですよ、やっぱり人間じゃありません、疑わずに早く関係を絶つ方がよござんす、あなたは冥途が近いのです」　桑は蓮香のやきもちだと思ったので、黙って何も言わなかった。",
              "citation": {
                "source": "蓮香",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「病が骨に入っては、どうすることもできないのです、私はちょっとあがりましたが、もうこれでお別れします、私はこれでやきもちでなかったことが解ればいいのです」　桑はひどく悲しんで言った。",
              "citation": {
                "source": "蓮香",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なうにね、和尚が、やきもちを焼いででがす。",
              "citation": {
                "source": "再度生老人",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、大変やきもちで――南国生まれの激情がなせるわざです。",
              "citation": {
                "source": "サセックスの吸血鬼",
                "author": "THE ADVENTURE OF THE SUSSEX VAMPIRE",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "yakimochi (roasted rice cake)",
