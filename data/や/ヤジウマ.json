[
  {
    "uuid": "7b7fd77e-23bc-5c06-9077-75ce1bc465eb",
    "entry": "野次馬",
    "reading": {
      "primary": "やじうま",
      "alternatives": [
        "ヤジうま",
        "ヤジウマ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "curious onlookers",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "事故現場には、すぐに多くの野次馬が集まってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "野次馬たちが集まりすぎて、消防車の通行の妨げになっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "テレビのニュースで映る事件現場には、いつも野次馬が映り込んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "製作の経験も何もない野次馬たちが、どうもあの作家には飛躍が無い、十年一日の如しだね、なんて生意気な事を言っていますが、その十年一日が、どれだけの修業に依って持ち堪えられているものかまるでご存じがないのです。",
              "citation": {
                "source": "炎天汗談",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "果して、その電話のおかげで、主人や女給はひどく申訳のないような顔をしてひたあやまりに、井深君と水兵服の少女とにあやまるし、入口に立っていた野次馬もこそこそとそれぞれ散らばってしまった。",
              "citation": {
                "source": "少女",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "この噂は何人云うとなしに外へ漏れて大評判になったので、野次馬が集まって来た。",
              "citation": {
                "source": "室の中を歩く石",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その周りで幾人かの野次馬が首を伸ばして目を凝らし、中の様子を垣間見ようとしていたのだが、無理そうだった。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "偶々チョッカイを出しても火傷をするだけで、動やともすると野次馬扱いされて突飛ばされたりドヤされたりしている。",
              "citation": {
                "source": "二葉亭追録",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "また事実、爆弾事件発生以来も彼は全然無関心な顔をしていたし野次馬連中が争ってヘルナー山頂へ急いだときも、彼はその仲間には加わらず、相変わらず屋根裏に近い彼の部屋にくすぶっていたことをドレゴは知っていた。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ものすごい物音に起きてきた野次馬の一人が、気をきかしたつもりで、その釦を押したのだろう。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼是百人近くはあつたらう、尤も野次馬の一群も立交つて居たが、口々に歌つて居るのが乃ち斯く申す新田耕助先生新作の校友歌であつたのである。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト悪戯な妄想奴が野次馬に飛出して来て、アアでは無いかこうでは無いかと、真赤な贋物、宛事も無い邪推を掴ませる。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "火事だと叫けば、大勢の野次馬が同調してくれるだろう。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "大理石の膚の各国女奴隷・その売買所と仲買人の椰子の鞭・宗教裁判と火刑広場の野次馬・海賊｜来の銅鑼と吊橋の轆轤を捲く大男の筋肉――そして今は、不潔と無智と猥雑と、海犬の群と考古学的価値のほか何一つ近代文明への関点を有たないりすぼあ！",
              "citation": {
                "source": "踊る地平線",
                "author": "しっぷ・あほうい！",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角、人間中年過ぎになると、恋愛も結婚も露骨に打算的に形をとるのだろうが、言ってみれば、まあ一つ小当りに当ってやれ――そんな野次馬めいた気分から、ヘルグライン、止せばいいのに――ほんとによせば好いのに――この未知の「美貌の寡婦」宛てに早速一筆啓上したものだ。",
              "citation": {
                "source": "斧を持った夫人の像",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが街頭の昂奮性野次馬が絶大の勢力を有つ米国辺りでは、この解り切った理窟を運行することが、実際になると仲なか至難な許りでなく、時として、護送中などに、群集に犯人を奪われて、あっと言う間に私刑にされて終うことも珍らしくない。",
              "citation": {
                "source": "双面獣",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬のことで、早い夕闇と緒に、刑務所の前の野次馬は刻一刻人を加え気勢を増して来る。",
              "citation": {
                "source": "双面獣",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "好奇な人間がわいわい詰め掛けて、一日中引きも切らず野次馬の河が屍体の前を流れた。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこも同じ野次馬風景である。",
              "citation": {
                "source": "余齢初旅",
                "author": "――中支遊記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "高等野次馬の數、無慮百｜餘名と註せられた。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "お穴樣の探檢",
                "note": "青空文庫"
              }
            },
            {
              "text": "『出た』　忽ち全山の高等野次馬は、我おくれじと馳付けて見ると、博士は笑ひながら、古靴の片足を、洋杖の先に懸けて示された。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "お穴樣の探檢",
                "note": "青空文庫"
              }
            },
            {
              "text": "一｜時は天井から骨がぶら下つて居るの、セメントで内部が塗つて有るのと、高等野次馬の騷ぎと云つたら無かつた。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "お穴樣の探檢",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し、高等野次馬は非常に多い。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "お穴樣の探檢",
                "note": "青空文庫"
              }
            },
            {
              "text": "主墳では有るまいが、人氣の緩んで居る折柄とて、學者も、記者も、高等野次馬も、警官も、悉く此所へ集まつて、作業の邪魔となる事夥多しい。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "お穴樣の探檢",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時、余は、俵形の土器を兩手に持つて、眞先きに穴から飛出すと、高等野次馬は聲を揃へて。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "お穴樣の探檢",
                "note": "青空文庫"
              }
            },
            {
              "text": "野次馬は、この完壁なものの風懐に触れるよりも、まづ自分はあの泥河にまではまり込まなかつた幸福感を味つてゐるに違ひない。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "野次馬に覗かれないように表の板戸を卸しかけていた博奕打の藤六という宿屋の親仁がヒョコリと頭を下げて通してくれた。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに後から寄り集まった大勢の野次馬が加わって、油売り半分の面白半分といった調子で、ワイワイ騒ぎ立てたので、狭い坑道の中が芋を洗うようにゴッタ返したが、その中に、浮上った炭車の車輪の下から、思いがけない安全燈の光りと一緒に、古靴を穿いた福太郎の片足が発見されたのでイヨイヨ大騒ぎになったものだという。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トタンに通りかかった野次馬がワアーと取巻く。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この調子なら吾輩が仕出かした事とは誰も気付くまい……と思ったから何喰わぬ顔で野次馬を押分けた。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "急所だから……トテモ……」　何かと云っているところを見ると野次馬の連中も巡査と同感らしい。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おめえたちやじうまを乗せるためにこいでいる伝馬じゃねえや！",
              "citation": {
                "source": "右門捕物帖",
                "author": "へび使い小町",
                "note": "青空文庫"
              }
            },
            {
              "text": "やじうまたあ何をぬかしゃがるんでえ！",
              "citation": {
                "source": "右門捕物帖",
                "author": "へび使い小町",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
