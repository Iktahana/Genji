    "definitions": [
      {
        "index": 1,
        "gloss": "ruins of a fire",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "かつての繁華街は、大火事のせいで一面の焼け跡となり、黒焦げた柱だけが立っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "焼け跡から家族の思い出の品を探し出そうと、人々は懸命に灰をかき分けていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "終戦直後の焼け跡の中で、たくましく生き抜く子供たちの姿が写真に記録されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "準備が整って予定の時刻が迫ると、見物人らは一定の距離に画した非常線の外まで退去を命ぜられたので、自分らも花屋敷の鉄檻の裏手の焼け跡へ行って、合図のラッパの鳴るのを待っていた。",
              "citation": {
                "source": "LIBER STUDIORUM",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、一匹の小さなのら犬がトボトボと、人間には許されぬ警戒線を越えて、今にも倒壊する塔のほうへ、そんなことも知らずにうそうそひもじそうに焼け跡の土をかぎながら近寄って行くのが見えた。",
              "citation": {
                "source": "LIBER STUDIORUM",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "本郷の方にちょっと用事があったので、それへ廻り道をして大学の正門前へ出、それから電車通りを往って、二日の日に一度見ている本郷の焼け跡の灰を見ながら、若竹の前を通って順天堂の手前へ出た。",
              "citation": {
                "source": "死体の匂い",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "教育博物館の前になった河縁の鳥屋の焼け跡には、まだ石油のカンらしい物が燃えていた。",
              "citation": {
                "source": "死体の匂い",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は荒漠たる焼け跡を通って本石町の方へ往き、そこから新常盤橋を渡って東京駅へと往った。",
              "citation": {
                "source": "死体の匂い",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "左側の本石町の書肆の焼け跡はすぐ見つかった。",
              "citation": {
                "source": "死体の匂い",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼け跡で鍬を持って掘っていたり、トタンの半焼けになったのを持って来て、仮小屋をこしらえていたりする者が多くなった。",
              "citation": {
                "source": "死体の匂い",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の方には両国の汽車の線路が、焼け跡の灰の中に浮いて連なっていた。",
              "citation": {
                "source": "死体の匂い",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は被服廠はその奥らしいと思ったので、兵士の方へは往かずに手前から焼け跡を切れて往って、兵士のいる方から来ている小路へ出た。",
              "citation": {
                "source": "死体の匂い",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "花屋敷の焼け跡には一疋の猿が金網の中にきょとんとしており、十二階は地震のために上の三階が堕ちて九階になっていた。",
              "citation": {
                "source": "死体の匂い",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その焼け跡は長さ二里十九町で幅が二町余であった。",
              "citation": {
                "source": "日本天変地異記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼け跡の区画整理は片付いて邦原君一家は旧宅地へ立ち戻って来たので、知人や出入りの者などについて心あたりを一々聞きただしてみたが、誰も届けた者はないという。",
              "citation": {
                "source": "兜",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "八幡の本社はこの二月の火事に類焼して、雪の下の町もまだ焼け跡の整理が届かないのであるが、江の島開帳を当て込みに仮普請のままで商売を始めている店も多かった。",
              "citation": {
                "source": "恨みの蠑螺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正十二年九月、渋柿）　　　　　　　＊　震災の火事の焼け跡の煙がまだ消えやらぬころ、黒焦げになった樹の幹に鉛丹色のかびのようなものが生え始めて、それが驚くべき速度で繁殖した。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、その丹色が、焔にあぶられた電車の架空線の電柱の赤さびの色や、焼け跡一面に散らばった煉瓦や、焼けた瓦の赤い色と映え合っていた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが焼け跡に燃え盛る練炭の山を見つけた途端、冷水でも浴びせられたように失ったものの大きさにうたれ、突き上げる悔しさに胸を焼かれました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "煤けた顔をして縄襷を掛けてるのや、チョッキ一つで泥だらけになってるのや、意気地の無いダラシの無い扮装をして足だけ泥にしているのや、テンヤワンヤの姿をした働き手が裏口から焼け跡へと出たり入ったりしていた。",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "爰を通って新築の裏口から賄い場へ抜けると、其先きは焼け跡であった。",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "後から昇って来るお客達だって皆私のなよやかな肩の線を視てゐるのだ、私の肩には男達の燃える視線の焼け跡が、ホラ、一つ二つ三つ……数へて行くうちにそれはジャズに紛れてしまった。",
              "citation": {
                "source": "街の断片",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月八日、焼け跡の灰かきに行った人たちが、わずかに五つ六つの焦げた人形を掘り出して来てくれた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "又そのあいだには旧宅の焼け跡の整理もしなければならない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは焼け跡の灰の中から自分の財を拾い出したように感じたのであった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザッと浅草大火の焼け跡を略図にして見れば下の如し。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "その頃の消防夫のことなど",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、翌朝になり、焼け跡はどうなったか。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "焼け跡の身惨なはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼け跡に、神田の塗師重の兄弟と、ほかに三人ばかり手伝いがボオンヤリと立っている。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "焼け跡の身惨なはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "「家族はまだ、焼け跡へはかえって来てないらしい。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめは、焼け跡に立ちかけている本物のバラック建の家や、河や溝の中を探しまわっていたが、そのうちにそんなところよりもむしろ罹災者あての配給品が集まってくるところの方に、物資が豊かであることに気がついた。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "商会は焼け跡に、仮事務所を作り、再び商売に打って出ることになったからである。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "工兵隊は引つづき毎日爆薬で、やけあとのたてもののだん片なぞを、どんどんこわしていました。",
              "citation": {
                "source": "大震火災記",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌る朝、鼻をつくやけあとの匂いとまだ低く立ちこめている煙の間に、思いがけず鴎外の大理石胸像がのこっていた。",
              "citation": {
                "source": "田端の汽車そのほか",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
