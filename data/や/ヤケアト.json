      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そりゃ、ひとりで行ったほうがいいの」「ひとりで行くわ」　それからお咲さんは、焼跡の整理を少し手伝って下さった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼跡の隅のわずかな青草でも美しく歌ってくれる詩人がいないものでしょうか。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしならば、広島の焼跡をかくんだがなあ。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、二月もたって近辺にぽつぽつバラックが建ち並ぶようになった頃に、思い出して行ってみたが、その店はまだ焼跡のままであった。",
              "citation": {
                "source": "雑記（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "声は梟、山伏の吹く貝、磔場の夜半の竹法螺、焼跡の呻唸声。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前、焼跡で引火奴を捜すような、変な事をするから、一つ素引いてみたまでのもんさね。",
              "citation": {
                "source": "菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "青森の中学校を出て、それから横浜の或る軍需工場の事務員になって、三年勤め、それから軍隊で四年間暮し、無条件降伏と同時に、生れた土地へ帰って来ましたが、既に家は焼かれ、父と兄と嫂と三人、その焼跡にあわれな小屋を建てて暮していました。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがに私は、その焼跡の小さい住宅にもぐり込むのは、父にも兄夫婦にも気の毒で、父や兄とも相談の上、このＡという青森市から二里ほど離れた海岸の部落の三等郵便局に勤める事になったのです。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼けたら、焼けたで、皆して力を合せ、焼跡に小屋でも建てて頑張って見ようじゃないか。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼跡に義妹が、顔を真黒にして立っている。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて妻が下の子を背負い、義妹が上の女の子の手をひいて焼跡にやって来た。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼跡の穴から掘り出した食料やお鍋などを、みんなでそのお家に運んだ。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はただやたらに、よかった、よかったを連発し、そうして早速、家の焼跡を見せにつれて行った。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この頃学校じゃあ講堂の焼跡を毀してるんだ。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがね、労働者が鶴嘴を持って焼跡の煉瓦壁へ登って……」　その現に自分の乗っている煉瓦壁へ鶴嘴を揮っている労働者の姿を、折田は身振りをまぜて描き出した。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮨までなつかしくなるんだよ」　二人の坐っている病院の焼跡のひとところに支えの朽ちた藤棚があって、おどろのように藤蔓が宙から地上に這い下り、それでも蔓の尖の方には若葉を一ぱいつけ、その間から痩せたうす紫の花房が雫のように咲き垂れている。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、こちらから訪ねても行けず病院の焼跡へ暫く佇んだり、あたりを見廻し乍ら石に腰かけて湊のことを考え時々は眼にうすく涙さえためてまた茫然として店へ帰って来るのであったが、やがてともよのそうした行為も止んで仕舞った。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒びすさんだ焼跡の仮小屋の慰藉になるものは金魚以外にはない。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どことも覚えない大溝が通つてゐて小橋がまばらに架り、火事の焼跡に休業の小さい劇場の建物が一つ黝み、河沿ひの青白い道には燐光を放つ虫のやうにひしやげた小家が並んでゐる。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "残されたかの女の視線は、墓地に隣接するＳ病院の焼跡に落ちた。",
              "citation": {
                "source": "かの女の朝",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう、そのときは、父親を除いて私たち家族一同、焼跡の上に立って、たゞ、ぽかんとして、何だか来るべきものが来てしまったという気持だけでした。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その儘に居れば熱く重苦しい負担を覚え、振り放そうとすれば、あとに世にも残酷な焼跡を残しそうで、思い切れなかった。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
