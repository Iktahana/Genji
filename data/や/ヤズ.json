        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その荒物屋というのは、ばけもの歯みがきや、ばけもの楊子や、手拭やずぼん、前掛などまで、すべてばけもの用具一式を売っているのでした。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもあの崖はほんたうの嫩い緑や、灰いろの芽や、樺の木の青やずゐぶん立派だ。",
              "citation": {
                "source": "台川",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは忙しく靴やずぼんを脱ぎ、その冷たい少し濁った水へ次から次と飛び込みました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもあの崖はほんとうの嫩い緑や、灰いろの芽や、樺の木の青やずいぶん立派だ。",
              "citation": {
                "source": "台川",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "羽織なしの引かけ帯、ゆるやかな袷の着こなしが、いまの身じろぎで、片前下りに友染の紅匂いこぼれて、水色縮緬の扱帯の端、ややずり下った風情さえ、杖には似合わないだけ、あたかも人質に取られた形――可哀や、お主の身がわりに、恋の重荷でへし折れよう。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりさ、雨が降るだらう、大雨や長雨の時、土のなかに浸んだ水が、四方から井戸側に押し寄せる力てえものは、こりやずゐぶん強いものらしい。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「時にね、順吉つあん、おまへさんもさ、考へてみりやずゐぶんつまらんことになつたもんぢやないか、ええ？",
              "citation": {
                "source": "第一義の道",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも去年から見りやずツと見えんやうになつたがのう。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は石三だからこりやずゐぶんまかることになる。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し長くかかるけれど、チフスの死亡率は此頃ぢやずつと減つて來てゐるんだ。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だつて一人ぢやずゐぶん忙しいでせう？",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやずんと楽しい話になって参ったわい。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやずんとうれしいぞ。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがだね」　止まっていた水が吹きあげでもしたように、伝六がまたにわかに活気づいて、珍しやずぼしをさしました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから先に秀吉が駿府城に迎えられた時、率直な秀吉は馬から下るやずかずかと進み、信雄、家康逆心ありと聞く、立上がれ、一太刀参らうと、冗談半分に、一本、釘を打って居るのである。",
              "citation": {
                "source": "小田原陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "マデリン嬢の病には、熟練した医師たちもはやずっと前から匙を投げていた。",
              "citation": {
                "source": "アッシャー家の崩壊",
                "author": "THE FALL OF HOUSE OF USHER",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふざけちやずるいよ。",
              "citation": {
                "source": "〔編輯余話〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "月四回の日曜やずるけ休みを勘定すると、大抵三十円ばかりにしかならぬ、いや、その三十円も自分はどうも家計に繰入れる気がしないから不思議だ。",
              "citation": {
                "source": "現代詩",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親はもはやずつと以前から、誰が何と言つても、顏を押しつけて呼ぶやうにしても、更に答へようともしなかつたがこの時ひよつくりと眼を明けて、そして驚いたやうに、一度立去つた元の世界にまたもどつてでも來たやうに窕子の顏をじつと見詰めた。",
              "citation": {
                "source": "道綱の母",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "堺がまさに半白ならんとするその大頭をふり立てて、先頭になって、一二、一二と歩調をとって行くさまは、それやずいぶん見ものだ。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "何にしても百姓なんかしているよりやずっと楽な生活ができるに違いない」　叔父が慧林寺の小僧となったのはそれから間もなくであった。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "月の光がみなぎっているので、空へ向かって顔を仰向けた時には、細まった頬やずっこけた頤が、際立って蒼白く眺められたが、落ちくぼんだ眼窩がその代わりに、髑髏のそれのように黒く見えた。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……恐ろしい処へ来てしまった）　漢権守はこの時代における――いやずっと上代から、そうしてずっと後世にまでも、謎の人物として恐れられ、また憎まれている怪物であった。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、翌日の晩、奴をやっつけた同じ時刻になると、右の眼が又もやずきんずきんと痛み出しました。",
              "citation": {
                "source": "按摩",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎には、伯父さんやずっと年上の兄さんがいるけれど、一度も行ったことはない。",
              "citation": {
                "source": "白木蓮",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯中には、かうした形を文章の技巧と意識し過ぎて、一種のじやず・ばんどを作らうと考へてゐるらしい作家もあるのには困る。",
              "citation": {
                "source": "詩と散文との間を行く發想法",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりやずつと弱蟲だけれど。",
              "citation": {
                "source": "醫師と旅行鞄の話",
                "author": "ロバート・ルイス・スティーヴンソン",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
