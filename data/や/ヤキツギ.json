        "examples": {
          "standard": [
            {
              "text": "割れてしまったお気に入りの陶器を、焼き接ぎの技術で丁寧に修復してもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "焼き接ぎは、金継ぎと同様に、日本の伝統的な陶磁器の修復技法として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "破損した器の破片を特殊な接着剤で繋ぎ合わせ、窯で焼き接ぎをして強度を高めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "※びた鉄瓶、焼き接ぎの痕のある皿なんぞが、それぞれの生涯のruineを語る。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "※びた鉄瓶、焼き接ぎの痕のある皿なんぞが、それぞれの生涯の ruine を語る。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒物屋、煎餅屋、煙草屋、建具屋、そういう店に交って、出窓に万年青を置いたしもた屋の、古風な潜りのある格子戸には、「焼きつぎ」という古い看板を掛けた家がある。",
              "citation": {
                "source": "寺町",
                "author": "岩本素白",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
