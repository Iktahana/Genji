        "examples": {
          "standard": [
            {
              "text": "八つ目鰻は、滋養強壮に良いと昔から言われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "北国の清流で捕れる八つ目鰻は、希少価値が高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "八つ目鰻の蒲焼きは、独特の風味があり食通にはたまらない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それはまるで八つ目鰻の腮のように見えたが、その窓枠はよく見ると臙脂色に塗ってあった。",
              "citation": {
                "source": "宇宙女囚第一号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは八つ目鰻や、蝶々魚の一種の四つ目魚とはちがう。",
              "citation": {
                "source": "異魚",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
