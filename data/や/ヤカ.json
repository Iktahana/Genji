  {
    "uuid": "279a72c3-87d8-5b0c-bdef-0367496f16cb",
    "entry": "ヤカ",
    "reading": {
      "primary": "やか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ニイチエの如く、ド翁の如く、シヤカの如く。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋し、物質のキラビヤカさが人々の卑しさを刺戟するので、卑屈になつたからなのだ。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "この町では、いまも昔と変らず、毎朝、さかなやがリヤカーにさかなを一ぱい積んで、イカにサバだぢやあ、アンカウにアオバだぢやあ、スズキにホツケだぢやあ、と怒つてゐるやうな大声で叫んで、売り歩いてゐるのである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "曳いてゐるリヤカーには、さまざまのさかなが一ぱい積まれてゐる。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "リヤカアに、サイダアの空瓶を一ぱい積んで曳いて歩いている四十くらいの男のひとに、最後に、おたずねしたら、そのひとは淋しそうに笑って、立ちどまり、だくだく流れる顔の汗を鼠いろに汚れているタオルで拭きながら、春日町、春日町、と何度も呟いて考えて下さいました。",
              "citation": {
                "source": "千代女",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日から君枝は、病院へ便利屋の電話が掛ると、いそいそと出掛け、リヤカーをつけて配達にまわった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日から君枝は、病院へ便利屋の電話が掛ると、いそいそと出掛け、リヤカーをつけて配達に廻った。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "休むわけには行かず、夜おそく新聞を畳んで、郵便局までリヤカーにのせて持って行くのだった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――アノ、ニギヤカナ、マチデサ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "畠より根こじあがなひ、リヤカーに山ほども積みもて來さしつ。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ハ光レリ、鏡ノ中ニ、冷ヤカニ照リカガヤケリ。",
              "citation": {
                "source": "光ノミ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "畠より根こじあがなひ、リヤカーに山ほども積みもて来さしつ。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫情濃ヤカニ致サバ、男子十一人出生セム。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺命ニ、吾レ死スルノ後、速ヤカニ火化ヲ行ヒ骨灰ヲ太平洋ニ散ゼヨ。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥さんに嫁の事を頼んで、さんざヒヤカされた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分をゴマカすな、アマヤカすな。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は忘れてしまいましたが、希臘の歴史を教える時、その先生がカッパードシヤカッパードシヤと一時間の内幾回となく繰り返す。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この長沢先生の時間と覚えておりますが、その先生がカッパードシヤカッパードシヤとボールドへ書くので、そのカッパードシヤを書こうとしてチョークを捜すために抽斗を明けると、その抽斗の中から豆ががらがらと出て来たというような話がある。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナデ　イツシヨニ　ニギヤカニ　フキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、ウグヒスタチハ　ミンナデ　イツシヨニ、キカラ　キヘ　ツタハリナガラ、ニギヤカニ　コドモタチノ　ハウヘ　アソビニ　ユキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アザヤカな淡紅色を帯びて、噎せかえるほど深刻に匂う白い花ビラの大群を、静かに少女の枕元に置き直すと、ポキンポキンと音を立てる腰骨を一生懸命に伸ばしながら、長い長いふるえた溜め息を吐いた。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヤカヤ……カヤカヤカヤカヤカヤ……」",
              "citation": {
                "source": "髪切虫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとで何やらマヤカシ物をば。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで思い切って吾輩の精神科学の研究発表の原稿を全部焼き棄ててしまって、あとにその内容の概略を書いたヒヤカシ半分の遺言書を残しておけば、彼奴、若林は嫌でも応でもその著述の中に、この遺言書を組み込まなければ研究発表の筋が立たなくなる訳だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
