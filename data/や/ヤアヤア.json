  {
    "uuid": "93237aa2-8697-5637-9ab3-cd142f00b623",
    "entry": "ヤアヤア",
    "reading": {
      "primary": "やあやあ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――以上――　　空前絶後の遺言書　　　　　　――大正十五年十月十九日夜――キチガイ博士手記　ヤアヤア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤアヤア、それなる御方に物申す。",
              "citation": {
                "source": "「生活」＋「戦争」＋「競技」÷０＝能",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀ちやんの傍では、清ちやんと敏ちやんがまだ一所懸命に「ヤアヤア」と掛声をしながら戦つてゐましたが、どうしたはづみか、清ちやんが握つてふりまはしてゐた槍がポカンと、秀ちやんの頭を打つてしまひました。",
              "citation": {
                "source": "泣き笑ひ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤアヤア」と閃いた白刃を「何を小癪なツ。",
              "citation": {
                "source": "蚊",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑誌記者は木魚をたたきながら、「それはそうとも、これで寺の小僧を三年したんだから」こう言って、トラヤアヤアヤアヤアとお経を読む真似をした。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "定まらぬ腰ではあるが、主人大事と、遠くから「ヤアヤア」位で迫ってくる。",
              "citation": {
                "source": "鍵屋の辻",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤアヤアというような懸声で舟のまわりにとりついてそれを押し出してゆくときの海辺の妻や娘たちの声々。",
              "citation": {
                "source": "漁村の婦人の生活",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤアヤア水夫ども帆を下ろせ！",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは私が勝手に呼んだ名であって、原名を何んというのか知らないが、とにかく一人の男が泥絵具と金紙で作った張ぼての蛸を頭から被るのだ、その相棒の男は、大刀を振翳しつつ、これも張ぼての金紙づくりの鎧を着用に及んで張ぼての馬を腰へぶら下げてヤアヤアといいながら蛸を追い廻すのである。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "馭者はヤアヤアと合点して動き出し道を向かい側へ横切ったかと思うと急に馬車は止まってしまった。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしたのでしょうね、本当に）　十二時すこし前になって、ヤアヤアとかえって来ました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "気のきいた船頭が、幕や苫で囲いをして用をたさせると、まるで、源平両陣から那須与一の扇の的でも見るように、は入る人が代るたびごとにヤアヤアと囃す。",
              "citation": {
                "source": "牢屋の原",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤアヤアなんだか書きちらかしてある。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤアヤアだれかここに宿ったやつがあるぞ」　見れば大樹の下にたき火のあとが、黒々とのこって、燃えさしの枝が散乱している。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "運ばれた枝はゴルドンの指揮で、厩舎、養禽小舎、洞門にうちかけられ、即成の茂林となった「ヤアヤア、山賊のかくれ家だな」「いや、もぐらの巣だ」　と幼年組がはしゃいだ。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "その医書のうちの会心のところ、道庵からいえばかなり手前味噌になりそうなところを二三カ所、朗々として読み上げて来たのですけれど、それは職業の手前｜咎める由は無いが、ここに来って急に、「ナムカラカンノトラヤアヤア」と言い出したのは、どう考えても理窟に合わないことです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
