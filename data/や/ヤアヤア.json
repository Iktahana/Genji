    "definitions": [
      {
        "index": 1,
        "gloss": "hi",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「やあやあ、皆さんお揃いで。今夜は楽しいパーティーになりそうですね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「やあやあ、遠路はるばるよく来てくれたね。まあ、中へ入ってくれ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「やあやあ、元気そうで何よりだ。しばらく見ない間にたくましくなったね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "蟹五郎　やあやあやあ！",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなに野次られて顔を赤くしながらも、それでもまんざらでもなさそうに、にやにやしているＫもＫだが、それを、やあやあと言って野次っている学生は、いったい、何のつもりなんだろう。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やあやあ、しっしっ、吹くやら、払いますやら、静として赤蜻蛉が動かねえとなると、はい、時代違いで、何の気もねえ若い徒も、さてこの働きに掛ってみれば、記念碑糸塚の因縁さ、よく聞いて知ってるもんだで。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　今は仕方なしという風、それで、どかどかと這入って、何処だ何処だと、梯子段から上って、やあやあやあである。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあやあワトソン。",
              "citation": {
                "source": "サセックスの吸血鬼",
                "author": "THE ADVENTURE OF THE SUSSEX VAMPIRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢を驚かした本尊は、やあやあその中に鎮座まします――しかも婦の骸骨で、その真白な蔽の中に、襟脚を釣るようにして、ぶら下げた、足をすっと垂れて、がっくりと俯向いたのが、腰、肩、蒼白く繋がって、こればかり冷たそうに、夕陽を受けた庭の紫陽花の影を浴びて、怪しい色を染めたのを見た。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「やあやあ、」「それに、貴下が打棄っておいでなすったと聞きました、その金剛杖まで、一揃、驚いたものの目には、何か面当らしく飾りつけたもののように置いてある。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「やあやあ、どちらの御婦人で。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び、相見た時に、やあやあ！",
              "citation": {
                "source": "新興芸術派に就いての雑談",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と米屋への不平めかしい言葉を仄めかすと二人の酒商は、やあやあ！",
              "citation": {
                "source": "心象風景（続篇）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがほんとうの勇士ってんだの、百万の敵中へ、たんだ一騎、やあやあ近くば耳にも聞け、遠くば鼻で嗅いでみよ――」「ほほう、大胆な仁だのう」　侍が、呟くと「一番手合せなすったら？",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあやあ勇敢勇敢」と森君は喝采した、千三は球が石のどぶ端を伝って泥の中へ落ちこもうとするやつをやっとおさえようとした、てんびん棒が土塀にがたんとつきあたったと思うとかれははねかえされて豆腐おけもろとも尻餅をついた。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあやあ、近藤勇だ、やあやあ」　かれは「幕末烈士近藤勇」という標題を見て拍手したのであった。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は患者をことわっておおかみのような声で謡をうたう、母は三味線を弾いてチントンシャンとおどる、そうして手塚は箒をふるって、やあやあ者共と目玉をむき出す。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあやあ、天下の名馬！",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあやあ、くさいくさい」　年少組は鼻をつまんで逃げだした。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあやあここでしたか」　とモコウがとんできた。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあやあ、ぼくの料理よりはずっとうまい」　とモコウがいった。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあやあかっぱの胴ぶるいに河童のくしゃみだ」　とモコウが水玉をかけられていった。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふしぎだねえ」「博士におたずねしようかしら」「やあやあ、ヒトミちゃん。",
              "citation": {
                "source": "ふしぎ国探検",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんにちは」「やあやあ、君たち、きましたね。",
              "citation": {
                "source": "ふしぎ国探検",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "やあやあ、骨を折らせやがった。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち今彼に向って「やあやあ汝は人間の性か河童のたぐいか」とどなっているのは、鬼河原家の三太夫氏の声にちがいない。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで宇治川の先陣の一席を、「やあやあ我こそは……」と声高らかにやって馬を走らせ、刀をひらめかせて、鮮洌な印象の中にそれが展開されて、彼等の口がポカンとほほえみと共に開けられて来なければ、こちらから投げ込むものは腹の底までは届かない。",
              "citation": {
                "source": "聴衆０の講演会",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "競輪という近代機械が、国定忠次ばりの繩張りの周囲を走り回わるように、近代知識人がその派閥性で、「やあやあ我こそは……」と声高らかにお互いに仁王立ちに立上っていないとはいえないのである。",
              "citation": {
                "source": "聴衆０の講演会",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあやあ、この豆戦車を明けようと思って、ずいぶん騒いだらしいぞ」　この豆戦車は、某国大使館の一室に、えんこしているのであった。",
              "citation": {
                "source": "大使館の始末機関",
                "author": "――金博士シリーズ・７――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあやあそこに渡らせられるは……」　と、わたくしがものをいいかけるうちにも、かの特使閣下はわたくしの姿を認め、手に持っていたステッキもウォッカの壜も、鋪道の上に華々しく放り出して、ものも得いわず、いきなりわたくしの小さい身体に抱きついたものである。",
              "citation": {
                "source": "地軸作戦",
                "author": "――金博士シリーズ・９――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
