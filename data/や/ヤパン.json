        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヤパンでは男女混浴だというがほんとうかなどと聞いたりした。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "余はいとも怪し気なる手つきにて得々然と茶をいれ一同にすゝめたるにジヤパン茶よりも甘しと称して各々四杯も代へたり。",
              "citation": {
                "source": "サフランの花",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "当地に発売のジヤパン茶なるものは混合物が多量にてミルク砂糖を交ぜて飲用するが余は口にしたるためしもなし。",
              "citation": {
                "source": "サフランの花",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "剪花屋、ロシヤパン、ドラ焼屋、魚の干物屋、野菜屋、古本屋、久々で見る散歩道だ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "水中花、ナフタリンの花、サスペンダー、ロシヤパン、万能大根刻み、玉子の泡立器、古本屋の赤い表紙のクロポトキン、青い表紙の人形の家。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "逢初の夜店で、ロシヤ人が油で揚げて白砂糖のついたロシヤパンを売っていた。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "剪花屋、ロシヤパン、ドラ焼屋、魚の干物屋、野菜屋、古本屋、久々で見る楽しい路上風景だ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "根津のごんげんさまにもよくお參りしたもンだし、逢初橋の夜店のロシヤパンなンて、お客さん知るめえなア……。",
              "citation": {
                "source": "雪の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "本の名は「ジヤパン」で、発行されたのは一八五二年である。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジヤパン」は、この人が、ラテン、ポルトガル、スペイン、イタリイ、フランス、オランダ、ドイツ、イギリス等の文献から、日本に関する記事をあつめ、それを集大成したものである。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "著者はそれ等の談話をも参照して、この「ジヤパン」といふ本を書きあげたのである。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジヤパン」の著者マツクフアレエンによれば、これは、ランドオルの追憶記といふものにある話だといふことである。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジヤパン」の著者マツクフアレエンの伝へた日本の女は、殆んどユウトピアの女である。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間も何かの新聞に何んとか女史が、アメリカの女学生の生活を天使の生活のやうに吹聴してゐたが、あの記事なども、半世紀後のアメリカ人の目に触れたらば、やはり、マツクフアレエンの「ジヤパン」と同じやうに、一笑に附せられるに相違ない。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて日露戦争直後、東京で最初にロシヤパンを売り出し、珍しいので相当繁昌した店があった。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがたちまち十数店の同業者が同じロシヤパンを売り出し、競争となって共に没落してしまった。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは曾つてわが輩が「國語尊重」の題下でわが國の國號は日本であるのに、外人の訛傳に追從して自らジヤパンと名乘るのは國辱であると論じたのと同じ筆法で、姓名轉倒は矢張り一つの國辱であると思ふのである。",
              "citation": {
                "source": "誤まれる姓名の逆列",
                "author": "伊東忠太",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米人の前には「ジヤパン」と稱し、佛人に逢へば「ジヤポン」と唱へ、獨人に對しては「ヤパン」といふは何たる陋態ぞや。",
              "citation": {
                "source": "國語尊重",
                "author": "伊東忠太",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
