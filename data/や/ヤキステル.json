[
  {
    "uuid": "7664cdd8-ff60-56a2-a9b5-2c783c94da4e",
    "entry": "焼き捨てる",
    "reading": {
      "primary": "やきすてる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
