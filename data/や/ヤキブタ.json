        "examples": {
          "standard": [
            {
              "text": "ネット掲示板で野球ファンを「焼き豚」と呼んで煽るのは、見ていて気持ちの良いものではない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は熱狂的な巨人ファンだが、自虐的に自分のことを焼き豚だと言っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "スポーツニュースのコメント欄が、焼き豚とサカ豚（サッカーファン）の言い争いで荒れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
