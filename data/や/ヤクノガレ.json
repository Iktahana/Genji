        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "甚作、厄逃れのお祝いに、神棚へお灯明であげいよ。",
              "citation": {
                "source": "義民甚兵衛",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから今年はもうこれで、厄のがれをしたとよろこんで居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　弟ぎみはその床屋の面々を、首っ玉つらまえて早々に追い出せと下知しましたが、こっちは却って厄のがれをしてほくほくものでした。",
              "citation": {
                "source": "かもじの美術家",
                "author": "TUPEJNYJ HUDOZHNIK",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや結構、男らしくはっきりとよく云って呉れた、これで娘も納得したであろうし、わしもわしの妻もひと安心というものだ、いや忝なかった」　右衛門としては「しめた、厄のがれだ」と叫びたかったろう、だがそれは胸にたたんで、きげんよくその縁談をうち切った。",
              "citation": {
                "source": "思い違い物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、これで厄のがれした。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が上方へ来たのは、厄のがれをしたようなもので、その代りにおさんが独りで厄を背負った、というふうな感じがし始めたのだ。",
              "citation": {
                "source": "おさん",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
