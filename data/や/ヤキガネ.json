[
  {
    "uuid": "c2eddfbb-e2ae-5a62-a36b-eec9e0fb6c33",
    "entry": "焼き金",
    "reading": {
      "primary": "やきがね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "branding iron",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "焼き金を火で真っ赤に熱し、家紋の印を付けていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "熱した焼き金が木に触れると、白い煙と共に独特の匂いがした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "その職人は、代々受け継がれてきた焼き金を大切に使っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "右手には新身の一刀、灯を受けて焼き金のごとく凄まじく光ります。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "大盗懺悔",
                "note": "青空文庫"
              }
            },
            {
              "text": "常陸・尾張両小萩とも、やきがね攻めにあふのは、奴隷のしるしをつけたのだ。",
              "citation": {
                "source": "小栗判官論の計画",
                "author": "「餓鬼阿弥蘇生譚」終篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "嬶も因果な奴さ、と卯平の云った言葉がぴんと胸にひびき、彼は、苦労させつづけている自分の女房と子供達のことを思い出し、今更のことではないけれども、日頃鼻柱の強い卯平が何時になくしんみりと述懐した様子が、やきがねのごとく彼の心を弾いたのである。",
              "citation": {
                "source": "糞尿譚",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "かすかにおとよさんの呼吸の音の聞き取れた時、省作はなんだかにわかに腹のどこかへ焼金を刺されたようにじりじりっと胸に響いた。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "半年のうちには大難があると言った占い者の予言は、焼金のように女の胸をじりじりとただらして来た。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日はカラリと晴れた上天気で、陽はカンカンと焼金くさい復興市街の上を照らしていた。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやいや見せないばかりではなく、その胸の上へ焼金をあて、火傷をさせたということである。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "梨子地には、焼金、小判、銀、錫、鉛（この類は梨子地の材料で金と銀とはちょっと見て分り兼ねる）。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "彫刻修行のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "廃帝の最後の場所を探していると、森の竪穴から勲章のかたちをした焼金が出てきた。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝気なお秀は、激情と悲嘆を押し包んで、焼金のような猛烈な復讐心を眼一パイに燃やしつづけているのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お秀の父",
                "note": "青空文庫"
              }
            },
            {
              "text": "挫いた足首は、焼金を当てるように痛みますが、今はそんな事を言っている揚合ではありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "金色の処女",
                "note": "青空文庫"
              }
            },
            {
              "text": "目出度く酔っ払った一座だ、借金取の大軍が車掛りで押して来たって、滅多に驚くこっちゃねえが、火事と聴くと江戸っ子は気が早えや、それッと縁側から首を出すまでもない、何処からともなくクワッと挙がった火の手が、酔った額を焼金で叩くように照りつけた。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "春宵",
                "note": "青空文庫"
              }
            },
            {
              "text": "鞘は大｜禿げちょろですが、中味は思いの外物凄く、夕陽を受けて、焼金のようにギラギラと光ります。",
              "citation": {
                "source": "大江戸黄金狂",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭へ下り立った英山公の手には、つい近頃二つ胴を試したばかりの新身の一刀が、夕陽を受けて焼金の如く光りました。",
              "citation": {
                "source": "新奇談クラブ",
                "author": "第五夜　悪魔の反魂香",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥の方から眼に焼金を当てるような、大幅の焔が、カッと氾濫して来たのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "不死の霊薬",
                "note": "青空文庫"
              }
            },
            {
              "text": "武士にとって最大な良心である恥辱という忍び得ないものが、内匠頭のあたまを焼金のように貫いた。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　ふと、彼は、焼金で頭を突きとおされたように、思い出した。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "触れたがさいご、焼金からシューッと青い火花が飛ぶ――火花は生命の目ばたきだ。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "木曾の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼金をたたく金敷のうえに、ぽろぽろと、涙がこぼれた。",
              "citation": {
                "source": "野槌の百",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "待っていたのは金だろう」「ほんとに、むりな工面をたのんで、わたしゃ後で済まないと思っていたんだよ」「そのうめえ口が、刀鍛冶の焼金まで熔かしたか。",
              "citation": {
                "source": "野槌の百",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "外記は、ふたつの眼が、二つとも焼金に突き貫かれたような痛みを感じて、「残念ッ。",
              "citation": {
                "source": "雲霧閻魔帳",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
