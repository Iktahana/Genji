      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "way (of doing)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "巧妙に言葉巧みに高齢者を騙す詐欺グループのやり口に、強い憤りを感じる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "競合他社の顧客リストを不正に入手するなんて、いかにもあの男らしい卑劣なやり口だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "いつも自分のミスを部下になすりつける上司のやり口には、もううんざりしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "レーリーが深くヤングに私淑していたであろうということは、二人の仕事の一体のやり口を比較すれば自ずから首肯されるであろう。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "台湾の蕃人に対しては、日本帝国主義のやり口は一層ひどかったのだ。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「張大人だって、北京の東安市場へ行く途中で、ちょっと見た別嬪を早速、自動車へかっぱらって、タイタイとしちゃったじゃないか、俺等にゃ結婚申込なんて、お上品なやり口は、性に合わねえんだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはその極端な悪魔的な精神に於て、近代の戦争のやり口をリードしているのみならず、遥かにソンナものを超越した偉いところがあった。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく銀子は、いろいろの人のやり口と、自身の苦い経験から割り出して抱えはすべて仕込みから仕上げることに方針を決めてしまい、それが一人二人順潮に行ったところから、親父の顔のひろい下町の場末へ手をまわして、見つかり次第、健康さえ取れれば、顔はそんなによくなくても取ることにした。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "新規開店に先立ち、法善寺境内の正弁丹吾亭や道頓堀のたこ福をはじめ、行き当りばったりに関東煮屋の暖簾をくぐって、味加減や銚子の中身の工合、商売のやり口を覚えた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月の間に板場のやり口をちゃんと見覚えていたから、訳もなかった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "自身攻撃されるのを防ぐために、有名人を攻撃するという、いわば相手の武器をとって、これを逆用するにも似た、そんなやり口を見て、おれは、さすがに考えやがったと思ったが、しかし、その攻撃文に「国士川那子丹造」という署名があるのを見て、正直なところ泪が出た。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "新規開店に先立ち、法善寺境内の正弁丹吾亭や道頓堀のたこ梅をはじめ、行き当りばったりに関東煮屋の暖簾をくぐって、味加減や銚子の中身の工合、商売のやり口などを調べた。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、実際のやり口は周到ではなかったな。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご存じ僕のやり口だ、ワトソン。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まったく、僕のやり口は知ってるだろうに。",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "「忘れないでください、我々の扱っている強盗は一風変わった男で、独特のやり口で仕事をしています。",
              "citation": {
                "source": "ライギット・パズル",
                "author": "THE REIGATE PUZZLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのやり口が実に露骨で表層的。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "犯罪者のやり口じゃあるまい。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたが切れ者で独自のやり口をお持ちだとは誰しも認めるところですが、吾輩どもが欲しいのは、やり口なり今の説法なりの先なんです。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "政治的な暗殺にしては仕事のやり口も逃げ方も生ぬるすぎる。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてファーガソンさん、僕も引く手あまたのせわしい身、やり口は単刀直入を旨としております。",
              "citation": {
                "source": "サセックスの吸血鬼",
                "author": "THE ADVENTURE OF THE SUSSEX VAMPIRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "奴さんのやり口というのは『｜あるものを否定し、ないものを説明する』（原注）というのさ」原注　ルソーの“〔Nouvelle He'loi:ses〕.”（１）Sir Thomas Browne（一六〇五―八二）――イギリスの医師、著作家。",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは私たちが、こんな恥ずかしい商売をするよりも、もっともっと恥ずかしい、堕落した、外道のやり口よ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは実際陰険きわまるやり口ですよ。",
              "citation": {
                "source": "坑鬼",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "利他本位の内容を利己本位でみたすというむずかしいやり口なんだが、君そんな人に出会ったですか」「どんなのです」「ほかの言葉でいうと、偽善を行うに露悪をもってする。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはこれまでの我が輩のやり口を見てもわかるだろう。",
              "citation": {
                "source": "探偵戯曲　仮面の男",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま手もとに集めている書画の掛け物はおおかた二、三百幅もあるんでしょうが、一本だっててめえが金を出して買った品はねえんですよ」「では、いずれも盗みとった品物じゃと申すのか」「いいえ、もっと根のふけえやり口で巻きあげるんですがね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "身代わり花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "二つの事件に必ず連絡があるとにらみましたので、あるとすれば、犯罪のやり口からいって一筋なわではいかない犯人に相違あるまいとめぼしをつけたので、将を射んとする者ほまず馬を射よのたとえに従って、三百両事件を先にほじってみようと思いたちました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なめくぢのやりくちなんてまづいもんさ。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ひとつには、あの牧さんをお直さんに取られたつて気持ちなンでせうが、根がゲスなやりくちだから――駄目なこと判りきつてツぢやないの」　百合子もサトミも、思はずお粒の方を振り返つた。",
              "citation": {
                "source": "「リラ」の女達",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうした矛盾に悩んで居られる博士は、私にとつては、森大人のやりくちよりも、遥かに心の底に触れる所がある様に感じます。",
              "citation": {
                "source": "芝居に出た名残星月夜",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーリキのやりくちは露西亜ならほとんど問題にならないくらい些細な事件なんでしょうがね。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "貫之の糸によるものならなくにわかれ路の心ぼそくもおもほゆるかなを解いては、別れ路のこゝろといふものは、糸による片糸のやうなものぢやないけれど、心細いものであるわい、といふやうなやりくちである。",
              "citation": {
                "source": "古歌新釈",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
