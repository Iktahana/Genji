[
  {
    "uuid": "7dc81482-aef1-5b34-ad91-9f690f1a5cb8",
    "entry": "やり口",
    "reading": {
      "primary": "やりくち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
