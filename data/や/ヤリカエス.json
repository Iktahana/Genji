        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "刺繍の模様がわずかに歪んでしまったため、彼女は一度糸を全て解いて最初から根気よく遣り返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "設計図の寸法にミスが見つかり、基礎工事の段階から全て遣り返さなければならなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "納得のいく音色が響くまで、ピアニストは何度も同じフレーズを遣り返して練習に励んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
