    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to answer",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "取引先の担当者から嫌味を言われたので、こちらも負けじと理論武装して痛烈に遣り返してやった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "相手チームの巧妙な攻撃を冷静に防ぎ、隙を突いた鋭いカウンター攻撃で鮮やかに遣り返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "やられたら遣り返すという報復の連鎖をどこかで断ち切らなければ、決して円満な解決には至らない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」　と遣り返す資格がある。",
              "citation": {
                "source": "女婿",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして二度三度四度とやりかえすために、本書にインキで書き込むことは控えて、なるべく軟い鉛筆で記入されたいものである。",
              "citation": {
                "source": "虫喰い算大会",
                "author": "佐野昌一",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾呂利が、一つ男らしく立って、口先だけでも、トラ十をがーんとやりかえすといいと思うのだったが、曾呂利本馬は、いつも無口で、小学一年生のように、えんりょぶかく、よわよわしい性格のように見え一度もやりかえしたことはなかった。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様みたいに、戦闘をはじめる途端に数値のことを忘れてしまうようじゃ、どうせ碌でもない敵兵に横腹を竹槍でぶすりとやられるあたりが落ちさ」　と、やりかえすのであった。",
              "citation": {
                "source": "空中漂流一週間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……もっと優しい足にしておいで」　三十郎は、笑いながら、「馬子足で悪かったな、これは生れつきだ」　と、やりかえすと、女狐は、「あら、人並らしく言うわね……あまり横着をするのはよしなさい。",
              "citation": {
                "source": "生霊",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがまたまるで見かけ倒しだなぞと、上州縮の唄にまでなぞらえて愚弄するものがあるかと思えば、一方ではそれでも友軍の態度かとやりかえす。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねこは　おどろきのあまり　やりかえすことも　できません。",
              "citation": {
                "source": "ばにばにベンジャミンのはなし",
                "author": "THE TALE OF BENJAMIN BUNNY",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめ女性は乱暴な男のいいなりになっていたが、そのうちに霊感を受けて女性の地位を自覚し、いままでやられていたとおりのことを男性にやりかえすというような寓意的なダンスらしい。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "（那須が笑いながら、やりかえす）……葵はね、西貝さん。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「べつに、問題になんかしていませんわ」　イヴォンヌさんが、勇ましく、やりかえす。",
              "citation": {
                "source": "キャラコさん",
                "author": "鴎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんたは、あたしの顎をいやというほど蹴っ飛ばしたわ」　と、やりかえす。",
              "citation": {
                "source": "キャラコさん",
                "author": "海の刷画",
                "note": "青空文庫"
              }
            },
            {
              "text": "船頭は、いまいましげに、しかし、心から怒っているわけでなく、自分も笑いながら、また、仲仕をからかう文句を歌ってやりかえす。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちがクロなら、そっちはアカイヌ（放火）……」　やりかえすと、またどこからか、「アカはアカでも、アカ（凶器）を持ったアカデ（強盗）もいる……」「アカが三枚……アカタンときたね」　これはアカイヌだった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いゝから羨むなえ」　兼次はすぐにやり返す。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたにも似ない、大変な弱音ですね」　と片隅のほうで嗤うような声がすると、「そうとも、化物氷河と闘えるもんじゃない」　と、折竹が即座にやり返す。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供も又やり返すと、今度は素早く背を向けて駈け出した。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はそんな莫迦気たことがと排斥していたのが、そもそも大間違いではなかったかと考え直し、それからもう一度一切の整理をやり返すと、始めてすこし事情が判って来た。",
              "citation": {
                "source": "赤外線男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "理窟を云って追い払おうとすれば、なかなか負けずにやり返す。",
              "citation": {
                "source": "風に乗って来るコロポックル",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると一座の中から、突然に、「御冗談でしょう」とひやかし気味に、やり返すものがある。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲からくすぐられた乙は、甲へやり返すと共に、丙の襲撃に備えなければならぬ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕は西洋へ行つたことがある」と云ふと、「西洋へ行つたらどこがえらい」とやり返す。",
              "citation": {
                "source": "島国的僻見",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もちろん、なかには良くないものもある」と云ふと、アルガン君すかさず、「皆良くない」とやり返す。",
              "citation": {
                "source": "仏国議会に於ける脚本検閲問題",
                "author": "――ゴンクウルの『娼婦エリザ』――",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には、勘にさはつて、やり返す。",
              "citation": {
                "source": "女人渇仰",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "升田八段にオカブをとられて、何を小癪な、とやり返す。",
              "citation": {
                "source": "将棋の鬼",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供時代に負けた相手をたちまちやり返すようになりうるものだ。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "王の犬よ、王の前に行つて尾を振つてゐろ、詩人がやり返すので軍人は剣を抜く。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "負けずにピチョ・ピチョとやり返す、そのうちに月が出て引分けってことになるんです。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "タラノ音頭　――コルシカ島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "此半次の野郎が、師匠に振り飛ばされて、うんと怨んでゐたことは、親分も知つての通りだ」　と助七、「何をツ、師匠を死ぬほど怨んでゐたのはうぬぢやないか」　とやり返す半次。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "佛喜三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この半次の野郎が、師匠に振り飛ばされて、うんと怨んでいたことは、親分も知っての通りだ」　と助七、「何をッ、師匠を死ぬほど怨んでいたのはうぬじゃないか」　とやり返す半次。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "仏喜三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで彼は同じ方法でやり返すことに決め、両手を化け物の頚に伸ばした。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
