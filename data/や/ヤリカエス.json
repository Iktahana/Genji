[
  {
    "uuid": "425b775f-d09b-5aeb-8bbf-a830c15edf1b",
    "entry": "遣り返す",
    "reading": {
      "primary": "やりかえす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
