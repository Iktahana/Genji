        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その三いヤァハレ海原や青海原。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤァハレ青雲やそのそぎ立、その極み、こをば。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ろヤァハレ潮※のとどまるかぎり、舟の舳の行き行くきはみ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤァハレ島かけて、八十嶋かけて、大海に舟満ちつづけて。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はヤァハレ国土や、大国土。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤァハレ国の壁そのそぎ立、その極み、こをば。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "にヤァハレ青雲のそぎ立つきはみ、白雲の向伏すかぎり。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤァハレ谷蟆のさわたるきはみ、馬の爪とどまるかぎり。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤァハレ島かけて、八十嶋かけて、大海に舟滿ちつづけて。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はヤァハレ國土や、大國土。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤァハレ國の壁そのそぎ立、その極み、こをば。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
