        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "食卓でちょっと持出されたダンテ魔術団の話と、友人と合奏のときに出たフォイヤーマンのセロ演奏会の噂とでこの夢の西洋人が説明される。",
              "citation": {
                "source": "夢判断",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして驚くような大きな声で「ターカイヤーマーカーラアヽ」と歌いだした。",
              "citation": {
                "source": "蓄音機",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "友だちと連れ立って夜ふけた田んぼ道でも歩いているときだれの口からともなく「キーターヤーマー、ヤーケール、シシーガデゥヨ」と歌うと他のものがこれに和する。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "糊の抜けた三畳づりの木綿の蚊帳の中に、伸び伸びと手足を投げ出してクープリンの「ヤーマ」を読む。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サーニンのようなものを云うのだろうか、エルテルの悩みのようなものだろうか、それとも、みれん、女の一生、復活、春の目ざめ、ヤーマ、色々な恋愛もあるけれども、どれもこれも古くさくてぼろぼろのようだが、また、考えれば、どれもこれも新らしいとも云える。",
              "citation": {
                "source": "恋愛の微醺",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "糊の抜けた三畳の木綿の蚊帳の中に、伸び伸びと手足を投げ出してヤーマを読む。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ミストル・アサヤーマ』。",
              "citation": {
                "source": "検疫と荷物検査",
                "author": "杉村楚人冠",
                "note": "青空文庫"
              }
            },
            {
              "text": "元帥の英霊に対しては失礼かも知れないが、フジヤーマやゲイシャやサムライやハラキーリは、他の国にはないからニッポン的だと彼等は思っているのである。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジヤーマン・ベーカリイ……。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "吠神話は此神を称して、多くの者の為めに途を求めつつ、かの河に達せしはじめの人なりと云い、死せし者のはじめと云い天国に行きしはじめの者と云い、名づけてヤーマー王と云う。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "其途を求めしと云点に於ては、「ソロモン」群島の神話に見ゆるタンガロは、ヤーマーと比較す可きなり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "のちのジヤーマン・ベーカリイのところにもユーロウプと呼ぶ茶館があつて、そこの二階は気の利いてゐるくせにおよそ狭くて天井が低く、宛らそのころ評判だつたアメリカ探偵映画に見る悪漢の巣窟とでもいひ度げの風景が、大きに私たちの猟奇心を満足させた。",
              "citation": {
                "source": "旧東京と蝙蝠",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「念のため、果し合ひに使つたといふ、毒を見せて貰ひ度いが」「いと易いこと」　平次の語に應じて、打越金彌は二階の凉庵の部屋から、ギヤーマンの小さい瓶に入つた、油のやうな水藥を持つて來て見せました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "百草園の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「戸板を背負はせて寢かした横井の口を、鑿か何かで無理にコジ開け、あのギヤーマンの瓶から毒藥を横井の口中に滴し込んだに違ひあるまい、横井の前齒が二本缺けて居たのはその爲だ」「へツ、隨分ひどい事をやつたものですね」　爲ることの殘酷さに、八五郎も膽をつぶしました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "百草園の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギヤーマンの瓶に入つた、赤黒い酒、透して見ると、まだ半分は殘つて居るでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "花見の留守",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃ギヤーマンに水銀を塗つた鏡も無いではありませんが、非常に珍らしくて高價で、ザラに町人の手に入るものではなく、一般の鏡の上等の品と言つても白銅製のもので、それも甚だ不完全で、人間の背中一面を完全に映すやうなものはまだ出來て居なかつたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "系圖の刺青",
                "note": "青空文庫"
              }
            },
            {
              "text": "伯爵と一緒に死に度い奴は皆な一緒に集まるんだ」　青白い幽鬱な顔も、少し上気せて、半殺にされた毒虫のように、ワナワナ慄える唇、美しい頬の肉は醜く引吊って、眼は魔神の像のギヤーマンの眼玉のように、ギラギラと虚ろな光を投げます。",
              "citation": {
                "source": "死の予告",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく見ると、それは悉くギヤーマンを張つた穴で、この天井裏から、下の樣子を覗く爲に出來たのでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "金色の處女",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪奇な舞踊を思ひ出して、嘔氣を催すやうな不愉快な心持になりましたが、お靜の安否が心もとないので、もう一度ギヤーマンの穴から覗くと、廣間は廣々と取片付けられて、白日の光が一杯にさし込み、忌はしい物など影も形もありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "金色の處女",
                "note": "青空文庫"
              }
            },
            {
              "text": "五助や柾次は飮み足りなくて神樂坂で一杯やつてゐたさうだし、困つたことに、川波勝彌を殺しさうなのは一人もありませんよ」「死骸の側に懷ろ鏡があつたといふぢやないか」「ギヤーマンの懷ろ鏡で、こいつは二朱や一分で買へる代物ぢやありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "懷ろ鏡",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はあの男の腕つ節が怖いんぢやない、――死骸の側に落ちてゐたギヤーマンの懷ろ鏡が怖いんだ」「すると矢つ張り幽靈？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "懷ろ鏡",
                "note": "青空文庫"
              }
            },
            {
              "text": "絹行燈を部屋の隅に、青磁の香爐が、名香の餘薫を殘して、ギヤーマンの水呑が、括り枕の側の盆に載せてあります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "猿蟹合戰",
                "note": "青空文庫"
              }
            },
            {
              "text": "「卯八、あの酒を持つて來い」　大盡の貫兵衞が手を擧げると、「へエ――」　爺やの卯八――その夜のお燗番――は、その頃は飛切り珍しかつたギヤーマンの徳利を捧げて艫から現はれました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "笑ひ茸",
                "note": "青空文庫"
              }
            },
            {
              "text": "さア、年頭の七平から」　貫兵衞はさう言ひ乍ら、同じギヤーマンの腰高盃を取つて、取卷の七平に差すのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "笑ひ茸",
                "note": "青空文庫"
              }
            },
            {
              "text": "珠玉、細工物、ギヤーマン、羅紗、それに南蠻物の生藥の數々。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "棟梁の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ「冬夜の田園詩」に民族的記憶の名残を止めた「キータヤーマ・ヤーケタ」の北山だけが、その向うに、昔ながらの姿を見せている。",
              "citation": {
                "source": "寅彦の遺跡",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
