        "examples": {
          "standard": [
            {
              "text": "夏の夜、野外音楽堂で開かれるコンサートは、星空の下で格別だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "緑に囲まれた野外音楽堂は、心地よい響きで知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供向けの音楽教室が、地元の野外音楽堂で開催された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "一九五四年の七月、この野外音楽堂に出演したエルヴィスは、出たばかりのレコードの二曲、『ザッツ・オールライト・ママ』と『ブルー・ムーン・オヴ・ケンタッキー』を歌った。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは、公園などにある野外音楽堂のようなところでした。",
              "citation": {
                "source": "電人Ｍ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
