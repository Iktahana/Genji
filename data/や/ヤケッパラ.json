        "examples": {
          "standard": [
            {
              "text": "理不尽な理由で解雇され、自棄っ腹になった彼は会社の前で抗議の声を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「勝手にしろ！」と自棄っ腹になって部屋を飛び出し、夜の街をあてもなく歩き回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "自棄っ腹で始めた事業が、思わぬ幸運に恵まれて軌道に乗ることもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "人を殺すのに名乗りをかけてからやるやつもないもんだが、しかし、そんな気狂いじみたあぶれ者ということなら、やけっ腹になってどんなことをしでかさないともかぎらない。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "猫眼の男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
