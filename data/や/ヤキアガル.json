        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "オーブンからクッキーが甘い香りと共に焼きあがった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "パンが焼きあがるのを、トースターの前でじっと待つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ちょうどピザが焼きあがったところなので、熱いうちに食べよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "やがてドラムの中に焼きあがる写真は、そもどんな顔をしているであろう。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼きあがる少しまえに、辻村又之助が来て、隠居所に客があるからゆくように、という帯刀の言葉を伝えた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あとはつねに任せろとのことです」「これは仙台のお屋敷へお届けするのだそうですから」と宇乃はためらい顔に云った、「それに、もうまもなく焼きあがるのですけれど、それまで待っていただけませんでしょうか」「あとはつねに任せろとの仰せでした」　ではまいります、と、宇乃は答えた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "バタートーストが　やきあがるまでの　やっかいばらいの　つもりだったのですが。",
              "citation": {
                "source": "ねこぬこタムのはなし",
                "author": "THE TALE OF TOM KITTEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
