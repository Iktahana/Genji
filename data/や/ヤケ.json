  {
    "uuid": "5352fa6e-3bf7-5b6e-a2c5-515d59e3a889",
    "entry": "焼",
    "reading": {
      "primary": "やけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
