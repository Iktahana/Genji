        "形容動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "desperation",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「もうどうにでもなれ！」と、彼は自棄になって大切な書類を破り捨てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "連敗続きで自棄になったファンたちが、球場の外で騒ぎを起こしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "あまりの不運に自棄を起こしそうになったが、友人の励ましでなんとか踏みとどまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "――額をみ給へ――一度は神も客観してやりました――不合理にも存在価値はありませうよだが不合理は僕につらい――こんなに先端に速度のある自棄　々々　々々下駄の歯は僕の重力を何といつて土に訴へます「空は興味だが役に立たないことが淋しい――精神の除外例にも物理現象に変化ない」ガラスを舐めて蠅を気にかけぬ",
              "citation": {
                "source": "（古る摺れた）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "自棄のない詩は神の詩か凡人の詩かそのどつちかと僕が決めたげます",
              "citation": {
                "source": "（テンピにかけて）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "謝源はもうシツカリ自暴自棄に陥つて居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、壊われなかったので、此の世の中でも踏みつぶす気になって、自棄に踏みつけた。",
              "citation": {
                "source": "セメント樽の中の手紙",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな自棄を云うもんじゃないよ。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "凍る深夜の白い息吐きが――そしてたちまちはげしい自棄の嘆きが荒く飛んで聴衆はほとんど腸を露出するまでに彼女の唄の句切りに切りさいなまれると、其処に抉出される人々の心のうずきはうら寂びた巴里の裏街の割栗石の上へ引き廻され、恥かしめられ、おもちゃにされる。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして自暴自棄になり、毎夜の如く市中の酒場を飮み※り、無茶苦茶にバカの浪費をして、自殺の場所を探してゐる。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自棄的な言葉が唇をもれる。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　自棄に投げる足も、しかし、すぼまつて、園は寒いよりも悚気とした。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな天変地異をも平気で受け入れ得た彼自身の自棄が淋しかったのだ。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに叔父さんもその希望が全くなくなったがために、ほとんど自棄を起こして酒も飲めば遊猟にもふける、どことなく自分までが狂気じみたふうになられた。",
              "citation": {
                "source": "鹿狩り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼れの心は眞底から哀愁に搖り動かされ、自暴自棄にさいなみ苦しめられた。",
              "citation": {
                "source": "實驗室",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前のニヒリスチックの気持の時は全く灰のように冷えてしまって、それは神経衰弱的な恐迫観念がときどき槍尖のように自分を襲って来たが、しかし、最後の落ち着きどころは空虚と見究めがついていたので、まだ自暴自棄の痛快味があった。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが人間がある激烈な心の衝動をうけてその心が四分五裂の苦に苛まれるとき、これを逃れるには自暴自棄の態度が一番宜いのです。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自棄だから序に言うが、……私は、はじめて逢った時、二十三の年、……高等学校を出ると、祝だと云って連出して、村田屋で御飯を驕ったものがある。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の顔は全く無気力と自暴自棄との色に曇っているのだ。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はやはり恐怖、自棄、反抗の気分から脱け出すことが出来ないのだ。",
              "citation": {
                "source": "計画",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "昏憊と自棄とが彼をして強情と我慢とを失はせてしまつた。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い弁護人は彼等の失望、落胆が忿懣に変じ、若くは自棄となつて、どんな無分別を起さぬとも限るまいと思つたから、慰藉とある希望とを与へたいと考へて、静に被告の席近く進んだのであつた。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はやはり恐怖、自棄、反抗の氣分から脱け出すことが出來ないのだ。",
              "citation": {
                "source": "計畫",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　脱いで提げたる道中笠、一寸左手に持換えて、紺の風呂敷、桐油包、振分けの荷を両方、蝙蝠の憑物めかいて、振落しそうに掛けた肩を、自棄に前に突いて最一つ蹌踉ける。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まあ、随分、ほほほ、もう自棄でございますわね、こんなに暑くっちゃ。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "潮煮の鯛の目、鮑の蒸したのが涼しそうで、熱燗の酒がヒヤリと舌に冷いくらい――貴女が云った自棄ですか――　夕方、今しがた一時は、凪の絶頂で口も利けない。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、色氣も聊か自棄で、穩かならぬものであつた。",
              "citation": {
                "source": "麻を刈る",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――皆もう半ば自棄に成つた。",
              "citation": {
                "source": "露宿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴方を抱いて、ちゃんと起きて、居直って、あいそづかしをきっぱり言って、夜中に直ぐに飛出して、溜飲を下げてやろうと思ったけれど……どんな発機で、自棄腹の、あの人たちの乱暴に、貴方に怪我でもさせた日にゃ、取返しがつかないから、といま胸に手を置いて、分別をしたんですよ。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――誰に習っていつ覚えた遣繰だか、小皿の小鳥に紙を蔽うて、煽って散らないように杉箸をおもしに置いたのを取出して、自棄に茶碗で呷った処へ――あの、跫音は――お澄が来た。",
              "citation": {
                "source": "鷭狩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "自棄まぎれに飛出したんで、両親には勘当はされても、位牌に面目のあるような男じゃない。",
              "citation": {
                "source": "鷭狩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫉妬だ、そねみだ、自棄なんです。",
              "citation": {
                "source": "鷭狩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "処で、自棄じゃ、賽の目が十に見えて、わいらの頭が五十ある、浜がぐるぐる廻るわ廻るわ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
