[
  {
    "uuid": "26abece7-e71b-5e36-8265-b511fb7e36d0",
    "entry": "自棄",
    "reading": {
      "primary": "やけ",
      "alternatives": [
        "ヤケ"
      ],
      "is_heteronym": false
    },
    "grammar": {
