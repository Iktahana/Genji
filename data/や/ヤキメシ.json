    "definitions": [
      {
        "index": 1,
        "gloss": "fried rice",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "休日の昼食は、冷蔵庫の残り物で作ったパラパラの焼き飯が定番だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昔ながらの中華料理店で食べる、ラードが香る焼き飯は格別の味だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "母が作る焼き飯には、決まって細かく刻んだ紅生姜が添えられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "もう既に焼き飯も焼けているのに、菊枝が起きてこないと言うだけのことで、魚を漁りに行く時間が遅くなるのに、まだ朝飯にならないのだから。",
              "citation": {
                "source": "緑の芽",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その祭日に祠を常緑葉と花で飾り、石造の神像を丹と油で塗り替え、花鬘をその頸にかけ、果を供え、樟脳に点火して薫らせ廻り、香を焼き飯餅を奉る、祠官神前に供えた椰子を砕き一、二片を信徒に与う。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹助いふやう、我はほりの内より十日町へゆくものなり、あすはこゝをかへるべし、又やきめしをとらすべし、いそぎのつかひなればゆくぞとて、おろしおきたる荷物をせおはんとせしに、かのもの荷物をとりてかる／″＼とかたにかけさきに立てゆく。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹助さてはやきめしの礼にわれをたすくるならんとあとにつきてゆくに、かのものはかたにものなきがごとし。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "はかなきオムレツとやきめしなど食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の終り、山水楼のやきめしと古肉、まづし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、朝食、焼飯にて仕り候て、梅干相添｜申、先づ梅干を先へ給候て、後に焼飯給申すべく候。",
              "citation": {
                "source": "厳島合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "またいわく伊豆国下田の近郷、中の瀬村の鎮守を子の聖権現といえり、この神、餅を忌み嫌いたもうとて、中の瀬一郷、年の終りに餅を搗かず、焼飯に青菜を交えて羮となし、三ヶ日の雑煮に易えるとぞ、これも珍しと。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪を溶かして水を作り、もうぼろぼろになりかけている持参の焼飯を手早く流し込んで、闇との息苦しい神経戦から免れるためにすぐ眠りにかかった。",
              "citation": {
                "source": "春の遠山入り",
                "author": "松濤明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンヤクと云う事は飯を煮なおして、焼飯にする事かな。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁の鏡のそばで、学生が二人夕刊を読みながら、焼飯を食べている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カツレツ、カキフライ、焼飯、それに十何本かの酒。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝美さんは酔って火鉢の中へ、焼飯をあけている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒を飲み、焼飯を食って、平和な表情だった。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝を待って、僧房の芋粥をすすり、焼飯の糧は釘勘の腰につけて、三人はまた芦ヶ｜久保の山村を立ちました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "血どめ薬、餅、焼飯なども少しずつ腰へ。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "石の上に置いた焼飯をしきりに指さすので、一つ投げてくれると悦んで食った。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "『想山著聞奇集』などに詳しく説いた美濃・信濃の山々の狗賓餅、或いは御幣餅・五兵衛餅とも称する串に刺した焼飯のごときも、今では山の神を祭る一方式のように考えているが、始めてこの食物を供えた人の心持は、やはりまたもっと現実的な、山男との妥協方法であったかも知れぬ。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "少なくとも焼飯の香気には、引寄せられる者が山にはいた。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "他国はしらず、その山言語とは、○米を草の実○味噌をつぶら○塩をかへなめ○焼飯をざわう○雑水をぞろ○天気の好をたかゞいゝ○風をそよ○雨も雪もそよがもふといふ。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "○　雪吹に焼飯を売　雪国にて悚懼物は、冬の○雪吹○ホウラ、春の雪頽なり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "農夫は貧乏の者なりしゆゑ六百ときゝて大によろこび、焼飯二ツを出して六百の銭に替けり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "商人は懐にありて温のさめざる焼飯の大なるを二ツ食し、雪に咽を潤して精心健になり前にすゝんで雪をこぎけり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時にいたりて焼飯を売たる農夫は肚減て労れ、商人は焼飯に腹満足をすゝめて往。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "樵夫はこれをしらず、今日の生業はこれにてたれり、いざや焼飯にせんとて打より見れば一｜粒ものこさず、烏どもは樹上にありて啼。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて途も梢々半にいたるころ、日ざしは七ツにちかし、竹助しばしとてみちのかたはらの石に腰かけ焼飯をくひゐたるに、谷間の根笹をおしわけて来る者あり、ちかくよりたるを見れば猿に似て猿にもあらず。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹助は心｜剛なる者ゆゑ用心にさしたる山刀を提、よらば斬んと身がまへけるに、此ものはさる気色もなく、竹助が石の上におきたる焼飯に指しくれよと乞ふさまなり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時すぎたので打ち切り、藤山・サトウ・石田を連れてサンボアへ、ウイをのみ、帰りにヤキメシを食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
