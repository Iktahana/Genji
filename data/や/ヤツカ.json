        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "高氏の部下が矢を納めたという矢塚も遠くない。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥後｜飽託郡島崎村大字島崎に遠矢塚がある。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
