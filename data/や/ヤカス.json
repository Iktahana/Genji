        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "激昂の反動は太く渠をして落胆せしめて、お通は張もなく崩折れつつ、といきをつきて、悲しげに、「老夫や、世話を焼かすねえ。",
              "citation": {
                "source": "琵琶伝",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――妻に世話を焼かす運命が手筋に出てはいませんか」　ガルスワーシーの座興的なうけ答えのように一見其の場の光景はやはりちょっとした座興的なもののようには違いないが然し景子には笑えなかった。",
              "citation": {
                "source": "ガルスワーシーの家",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この忙しいのにどんなに世話を焼かすか知れぬと頭ごなし。",
              "citation": {
                "source": "高知がえり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何んなに眠いときでも、蓮見がおこすと、渋くりながらも便所へも立つのであつたが、圭子では世話を焼かすばかりであつた。",
              "citation": {
                "source": "チビの魂",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえ、支倉君、世話を焼かすじゃないか。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これというのも、みんなこのコーリャがわからずやだからです、世話ばかり焼かすからです！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "いい加減に、友達に世話を焼かすなよ」　その言葉には、義平太も、いッぺんに顔じゅうを涙にしてしまった。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなに、手を焼かすかと思いのほか、ひとたび、父越前守に会わせてやるというたッた一つの希望を与えただけで、その日から、まったく、素直な、純情な、そして善を楽しむよい娘になってしまった。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「郷を焼かすな」　と、将門は、新治まで、駈け出して、陣をした。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蔡九の前へ出たら、あらぬ口走りと狂態をつくして、ひとまず吟味の手を焼かすのだ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、よくこの李逵をお叱りなさるが、先生くらい、人に世話を焼かすお方もありませんぜ」　と、李逵は例のごとき打ッつけ調子で、ざっと次のようなわけを話した。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "傅役の長谷川、前田、乳人たちは、遠い末座に、ただひれ伏しているのみで、ほとんど、その人たちの手を焼かすこともない。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供のような世話は焼かすな」　それから彼はすぐ、供の兵と安間了現の名を大きく呼んで、元の下り道へ急いでしまった。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな無駄な世話を焼かすもんじゃない。",
              "citation": {
                "source": "牢獄の花嫁",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
