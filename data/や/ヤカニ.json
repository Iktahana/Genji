          "literary": [
            {
              "text": "日ハ光レリ、鏡ノ中ニ、冷ヤカニ照リカガヤケリ。",
              "citation": {
                "source": "光ノミ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫情濃ヤカニ致サバ、男子十一人出生セム。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺命ニ、吾レ死スルノ後、速ヤカニ火化ヲ行ヒ骨灰ヲ太平洋ニ散ゼヨ。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナデ　イツシヨニ　ニギヤカニ　フキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、ウグヒスタチハ　ミンナデ　イツシヨニ、キカラ　キヘ　ツタハリナガラ、ニギヤカニ　コドモタチノ　ハウヘ　アソビニ　ユキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "“U. S. R. S. Flanklyn”フランクリン号ナル、レシービングシツプデアル、大概港ノ中ニ碇ヲ降シテヰルノデ危険ノ憂ヒハナイガ、僕ニハヤハリ水雷艇ノ方ガ面白イ、君ノ冒険心ガ健ヤカニ成長スルコトヲ望ンデヰル。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鞭ヲ鳴ラシテ酒肆ヲ過リ服ヲアザヤカニシテ倡門ニ遊ブ――」　他の者は世話ものを歌つたが、雷音は人々の聞き慣れぬ類ひの漢詩ばかりを次々に朗吟するのが癖だつた。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――海上ハ波オダヤカニシテ、晴天ナレド雲アリ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "マサヤカニコソ（沢瀉久孝）等の諸訓がある。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "心ヲ、平ニシテ、敵ノ上方勢ヲ見ルニ、武具馬具光リ輝キ、将卒ノ気ハミナ暢ビヤカニ、陣装燦爛、馬ハ長大ニシテ、悍気高ク、海外ヨリ得タル新兵器ト火薬ナドノ物智ニ長ケ、武者立チ、厳シク、軍律ヨク行ハレテ、遠ク大坂ト海ヲ隔ツト雖モ、前線、常ニ秀吉ノ在ルガ如シ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "盗、畏震シテ、速ヤカニ坑ヲ出デ、相顧ミテ、モノヲ云ワントスレバ、唇ハ皆、漆ニ閉ジラレテ開カズ、手ノ玉帯ヲ見レバ、各※、怖ロシゲナル巨蛇ヲ掴ミテアリシト。",
              "citation": {
                "source": "三国志",
                "author": "篇外余録",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
