[
  {
    "uuid": "062d626b-1c85-5a7e-8a1d-33bceec91e34",
    "entry": "矢鱈",
    "reading": {
      "primary": "やたら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "副詞-と"
      ],
