      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "indiscriminately",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は矢鱈に物を買い漁り、部屋はあっという間に散らかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その店は矢鱈めったら客引きをしていて、少し迷惑だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試験前だというのに、矢鱈に眠気が襲ってくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "本を読んだら理性を恢復するかと思つて、滅多｜矢鱈に本を読んだ。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁一重隔てた校長室で、校長は矢鱈にその方に気を取られてゐた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　父も、私も漫然とそんなことを言ひ合つてる時、ヒツとした瞬間、私は一生に一度しかない此の夏休みを、旅行しないといふことがとても尊い物でも取り逃がす様な気持が矢鱈に湧き上つて来た。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何いふものか癖になつてゐる、「English at the Commercial School」といふ文句を矢鱈に原稿紙の上に並べてゐる中にポツとこんなことを思つた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "背後の扉のトップの金属が、たゞ矢鱈に冷たく鈍く光つてゐた。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "何のかのと、ろくでも無い料理をうるさくすすめて、くだらないお世辭を交換し、をかしくもないのに、矢鱈におほほと笑ひ、まあ！",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "格別の用事でも無い限り、どんな親しい身内の家にでも、矢鱈に訪問などすべきものでは無いかも知れない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりピアノ線の両端に重錘をつけたようなものを矢鱈と空中に打ち上げれば襲撃飛行機隊は多少の迷惑を感じそうな気がする。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナ・ニコロが私を引ずって矢鱈に接吻する。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち輪講をして窘められて、帳面に黒玉ばかりつけられて、矢鱈に閉口させられてばかり居たぎりで、終に他人を閉口させるところまでには至らずに退塾って仕舞いましたのです。",
              "citation": {
                "source": "学生時代",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前と違って、矢鱈に私にお追従ばかりおっしゃるので、私は、まごついて、それから苦しくなりました。",
              "citation": {
                "source": "千代女",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんど、どこか旱魃の土地の噂でも聞いた時には、私はこの着物を着てその土地に出掛け、ぶらぶら矢鱈に歩き廻って見ようと思っている。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ手を矢鱈に使われちゃやり切れませんや。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車が矢鱈に殖えましたからナ。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "亨一は矢鱈に激昂した。",
              "citation": {
                "source": "計画",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗黒で固より見当は付かぬが、市郎は勝つに乗って滅多矢鱈に蹴飛ばす中に、靴の尖には応えがあった。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "『当夜、私は非常に亢奮して家を飛び出ましたが、街へは行かずに近所の沼の辺や林の中を夜風に吹かれながら矢鱈に歩き廻っていました。",
              "citation": {
                "source": "遺書に就て",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢鱈に後悔したり、詑びたりし度がるのは、悪い癖だ。",
              "citation": {
                "source": "花嫁の訂正",
                "author": "――夫婦哲学――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、三鞭酒を矢鱈に抜かせた。",
              "citation": {
                "source": "浪漫趣味者として",
                "author": "―― Ibi omnis effusus labor ! ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し、その倶楽部は恐しいと云っても決して見境もなく無闇矢鱈と恐ろしい事を企てるのではなくて、ただ倶楽部で決められた則をやぶった者に対してだけ少しの容赦もなくその法外にきびしい制裁を下すと云うのであって、彼等倶楽部員は皆、極端なる、「不正を悪くむ紳士方」であるのです。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "兼の野郎が私を馬と間違えたと思うと矢鱈に腹が立ちましたので……」「アハハハハ……イヨイヨ馬鹿だナ貴様は……」「ヘエ……でも私は恥を掻かされると承知出来ない性分で……」「ウーン。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何のかのと、ろくでも無い料理をうるさくすすめて、くだらないお世辞を交換し、をかしくもないのに、矢鱈におほほと笑ひ、まあ！",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "テツさんは、窓縁につつましく並べて置いた丸い十本の指を矢鱈にかがめたり伸ばしたりしながら、ひとつ処をじっと見つめているのであった。",
              "citation": {
                "source": "列車",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "テツさんは、窓縁につつましく並べて置いた丸い十本の指を矢鱈にかがめたり伸ばしたりしながら、ひとつ處をじつと見つめてゐるのであつた。",
              "citation": {
                "source": "列車",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と王子は病床の枕もとを、うろうろ歩き廻って、矢鱈に反対しましたが、内心は、途方にくれていたのです。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事をすませてから応接室に行き、つッ立ったまま、ピアノのキイを矢鱈にたたいた。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中で話の緒口を忘れた余は、再びそれを取り上げて、矢鱈な区切から改めて読み出す勇気を鼓舞しにくかったので、つい夫限に打ち遣ったようなものの、腹のなかでは私かに作者の根気と精力に驚ろいていた。",
              "citation": {
                "source": "『土』に就て",
                "author": "――長塚節著『土』序――",
                "note": "青空文庫"
              }
            },
            {
              "text": "『吹くのが面白いものだから、自分でわざと火を消しては、やたらに吹いた』と、夫人が追想談で話しているが、おそらくそういう場合、ヘルンの筆が行き渋り、感興が中断した時であったろう。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただもう、やたらに天下国家ばかり論じて、そうして私を叱るのです。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度目はまだ好い所へゆくつて気もあつたから元気だつたが、今度はもう目的地が一通りや二通り分つてゐるためでもあつて、やたらに家のことが後から後から頭に出て来た。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
