        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この神がアシナダカの神、またの名はヤガハエ姫と結婚して生んだ子は、ツラミカノタケサハヤヂヌミの神です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "また天皇、ワニノヒフレのオホミの女のミヤヌシヤガハエ姫と結婚してお生みになつた御子は、ウヂの若郎子・ヤタの若郎女・メトリの王のお三方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "またそのヤガハエ姫の妹ヲナベの郎女と結婚してお生みになつた御子は、ウヂの若郎女お一方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで天皇がその孃子に、「あなたは誰の子か」とお尋ねになりましたから、お答え申し上げるには、「ワニノヒフレのオホミの女のミヤヌシヤガハエ姫でございます」と申しました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでヤガハエ姫がその父に詳しくお話しました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで御馳走を奉る時に、そのヤガハエ姫にお酒盞を取らせて獻りました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
