          "literary": [
            {
              "text": "カジヤハ　マツカニ　ヤケタ　カネカラ　クワヲ　ツクツテ　ヰマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝っぱらから何の用事かと封を切って見ると、『ケサミセヤケタ。",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、怎う読直しても、ケサミセヤケタ！",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒点ガ見エ、強イ光デ網膜ガヤケタトキノ感ジガアリ、且ツチラチラト電線ノ雑音ミタイナモノガ盛ンニ動クノデアル。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　シバラクシテ　モウ　ウマク　ヤケタラウト　オモツテ　オマンヂウヲ　オイタトコロヘ　カヘツテキテミルト　オマンヂウハ　一ツモ　アリマセン。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
