        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "骨組の逞しい大男で、頭に烏帽子を戴き、身に直垂を著、奴袴を穿いて、太刀を弔つてゐる。",
              "citation": {
                "source": "津下四郎左衛門",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "水青の清らかな狩衣に白い奴袴をはいて、立烏帽子をかぶって、見るから尊げな人柄であった。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はわざと拗ねたのであろう、きょうの華やかな宴の莚に浄衣めいた白の直衣を着て、同じく白い奴袴をはいていた。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだこの上に何事をたくもうも知れぬ」と、頼長も奴袴の膝を強く掴んだ。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷え性ださうで、腰へ綿の入つた奴袴のやうなものを當てて、肥つた身體をえごちやらと自分を追ひつて逃げた。",
              "citation": {
                "source": "父の婚禮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "かう言ふさしぬきにしてつける袴（穿く裳でなく、絡佩裳である）を、奴袴と書くも、故がある。",
              "citation": {
                "source": "小栗判官論の計画",
                "author": "「餓鬼阿弥蘇生譚」終篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "千草を染めだした藍摺りの、元禄袖の着物に、葛布らしい、白の奴袴をつけて、素足に半之助のとよく似た、革草履をはいていた。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜は白地に秋草模様を染めた着物で、珍しく奴袴は着けず、はでな竜胆色の帯を、うしろで大きく結び、素足に草履をはいていた。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奴袴をはいた男たちや、烏帽子を汗によごしてゆく町の者や、子どもや、老人や、髪をつかねた女や――中には太刀を厳かに横たえた武士とか、良家の女房らしい姿も、まじってみえた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
