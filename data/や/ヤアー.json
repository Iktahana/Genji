        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "天下泰平、徃生安楽国、ムニヤムニヤアーメン。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "と唾液を嚥み込み嚥み込み相手の顔を白眼み付けたが、その瞬間に……ヤアーッ……と叫んで天井に飛び上りたくなった。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "不図私は、私の身近かに、「ギヤアーツ！",
              "citation": {
                "source": "驚いた話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に私も爆弾のやうに仰天して、「ギヤアーツ！",
              "citation": {
                "source": "驚いた話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、皆は一度にヤアーと笑い出してしまう。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "須曾麻呂が、ヤアーッという大声をかけたと思うと、ピンと威儀を正してハッタと甚八を睨みすえ、「時刻であるぞ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方が無いからビヤアーと云つたといふ話をして、よく皆を笑はせたことがありました。",
              "citation": {
                "source": "物貰ひの話",
                "author": "三田村鳶魚",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
