[
  {
    "uuid": "aada11b1-290b-5684-9ba8-861513cfc5fe",
    "entry": "野草",
    "reading": {
      "primary": "やそう",
      "alternatives": [
        "のぐさ"
      ],
      "is_heteronym": false
    },
    "grammar": {
