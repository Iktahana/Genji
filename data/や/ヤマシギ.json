        "examples": {
          "standard": [
            {
              "text": "猟師が茂みから飛び出した山鷸を、鋭い目で見つめている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "山鷸は非常に警戒心が強く、夕暮れ時によく活動する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "落ち葉に紛れるような保護色を持つ山鷸を、森の中で見つけるのは難しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "山鷸を血のしたたるまま、十五分間煮る。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山鷸は程よく肉を切りパンの間に挟みパンの表面には装飾かたがた股の肉と翼の肉を載せて皿に置き附け合せて側に盛る。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
