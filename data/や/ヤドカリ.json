        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "潮だまりで小さな宿借りを見つけ、子供たちは大喜びした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "宿借りは、大きくなると新しい貝殻を探して引っ越しをする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "水槽の中で、宿借りが空き缶を背負って歩いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「きのふあるを知らずあすあるをあげつらはず、夜こそ物は樂しけれ、草の根に宿借りて歌とは知らず歌うたふ。",
              "citation": {
                "source": "北村透谷詩集",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "前人の型を踏襲するのは一つの面白い試みであって、卑怯でもなければ安易の道でもなく尚又宿借り主義でもない。",
              "citation": {
                "source": "日本探偵小説界寸評",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて埋葬のまだ終らざるうち、彼の弓持一番に立帰り、家に至り大音にて、『宿借り申そう』と云えば、留守居の者が内より、『三日あとに人質に取られて、宿貸すことは出来申さぬ』と答うれば、又弓持、『然らば艮鬼門の方へ、世直り中直りの弓を引く』と言いつつ矢を番い、家の棟を射越し弓を踏み折りて投げ越すなり。",
              "citation": {
                "source": "本朝変態葬礼史",
                "author": "中山太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは、不相応の大きい貝殻の中に住んでいるヤドカリのようなもので、すぽりと貝殻から抜け出ると、丸裸のあわれな虫で、夫婦と二人の子供は、特配の毛布と蚊帳をかかえて、うろうろ戸外を這いまわらなければならなくなるのだ。",
              "citation": {
                "source": "親友交歓",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "渚の岩蔭に潜んで、波が来ると驚いて窓を閉ぢ、引けばまたこつそりと顔を現してあたりを眺めたり、産れて以来それを続けてゐるにも関はらず一向波に慣れない愚かな「ヤドカリ」が、稍大きな波にさらはれて、アツといふ間もなく岩間から転落して、眼を閉ぢて、ころころと水の底に沈んで行く心細さだつた。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あゝ、厭だな……」と、怠惰なヤドカリは呟いだ。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、「ヤドカリ」は叫んだ。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そればかりでなく彼は、二三日前から切りにヤドカリの痴夢に耽つて来た阿呆らしさを、こんな風に喋舌ることで払つてしまひたかつた。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も、こんな事をやるのは古い生徒ばかりだが、すると小使は、法螺貝の中から追ひ出されたヤドカリと云ふ見えで、傍にシヨンボリと、斑になつた小倉服を衣て、寒さうに立つて見てゐる。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "だん／＼堅くなり、せまく、ヤドカリみたいに殻の中へひつこんで行くので、どうにも意外だ。",
              "citation": {
                "source": "戯作者文学論",
                "author": "――平野謙へ・手紙に代へて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん堅くなり、せまく、ヤドカリみたいに殻の中へひっこんで行くので、どうにも意外だ。",
              "citation": {
                "source": "戯作者文学論",
                "author": "――平野謙へ・手紙に代えて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "動物学では二種の異なる動物が一所に仲よく生活することを共生といい、ヤドカリとイソギンチャクやナマコとその尻の穴の中にすんでいるカクレウオなどはその例である。",
              "citation": {
                "source": "地震なまず",
                "author": "武者金吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるでヤドカリが、かいがらの中からかおを出すように、それが、にゅっとくびを出しました。",
              "citation": {
                "source": "赤いカブトムシ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "やどかりはうようよ数珠形に、其処ら暗い処に蠢いたが、声のありそうなものは形もなかった。",
              "citation": {
                "source": "海の使者",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……やどかりも、うようよいる。",
              "citation": {
                "source": "海の使者",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "濕つた渚に踏入ると、無數のやどかり共、青と赤の玩具のやうな小蟹共が一齊に逃げ出す。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "湿った渚に踏入ると、無数のやどかりども、青と赤の玩具のような小蟹どもが一斉に逃げ出す。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――彼は、二階で、和英字引を引いたり、Hermit といふ名詞をワザと英文の字引で引いて、“one who retires from society and lives in solitude or in the desert.”などと口吟んだり、また「やどかり――蟹の類。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "やどかりが小さい貝の中に住むのもきっと自分の身の程を弁えての事で、やどかりには小さい貝が相応した住家なのである、又みさごが人を恐れるのあまりに浪の荒い海岸にいて人々を近づけないのである。",
              "citation": {
                "source": "現代語訳　方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            },
            {
              "text": "やどかりやみさごの様に自分は自分なりの小さい住家に住み、そうして世の中の果敢なさ、自分の運命の哀れを知って世を離れてこうした山の中に住み、富も求めず、位も求めずに、まして俗世間と交際ある様な事もなく、みさごや、やどかりが自分自身だけの平安を楽しむ様に唯一人で何の不安もなく暮しているのである。",
              "citation": {
                "source": "現代語訳　方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            },
            {
              "text": "『心ある人に一夜のやどかりて、慣るゝもつらし明日の故里』と詠じけむ、宿のあるじの情のみならで、自然の風致も世になつかしき處かな。",
              "citation": {
                "source": "冬の榛名山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、手にとってみると、それは一枚貝を自分の家として住んでいるやどかりだった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "やどかりか」　やどかりは、玉太郎の手のひらの上で、しばらくじっとしていたが、やがて急に足をだして、あわててはった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉太郎は、草の中からそのやどかりをさがしだして、波うちぎわへほうってやった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この島にはやどかりもいる蠅もいる。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "本郷と駒込の郵便局が一つになって駒込中学にやどかりして居ります、切手類一切なしよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時ハ伏見の寺田やでやどかり、伏見奉行をおそれさしてやろふとぞんじおり候。",
              "citation": {
                "source": "手紙",
                "author": "慶応三年四月七日　坂本乙女あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢田津世子「やどかり」（『改造』四月）などもこのカテゴリーにはいる部類だろう。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、やどかりのはいった、箱をござの上へ置いて、売っているのでした。",
              "citation": {
                "source": "ある夜の姉と弟",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "やどかりは、小さなはしごの上へ登ったり、たがいに組み打ちをやったり、転げ合ったりしていました。",
              "citation": {
                "source": "ある夜の姉と弟",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
