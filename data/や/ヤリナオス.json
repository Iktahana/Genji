[
  {
    "uuid": "04a75830-9e4f-5e27-ab8b-ff2191992ab5",
    "entry": "やり直す",
    "reading": {
      "primary": "やりなおす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
