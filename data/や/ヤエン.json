[
  {
    "uuid": "3a429e7f-02ea-5447-bf4e-0b9367759a00",
    "entry": "野猿",
    "reading": {
      "primary": "やえん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
