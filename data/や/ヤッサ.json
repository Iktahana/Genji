        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そうしてヤッサモッサやっているうちに、どうした拍子か袋の口が解けて、両足が腰の処までスッポンと外へ脱け出した事がわかったの……。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤッサ、モッサと話が片付かぬ中に二人は、代る代る手を出して背後の小丼の中味を抓んだ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうしたヤッサモッサに対して、その筋は断乎たる方針を取った。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「砂書きのオヤッサン！",
              "citation": {
                "source": "砂書きの老人",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サト子さん、あなたはなにも知らないでしょうが、ことしの春から、これでもう一年近く、あなたのためにヤッサモッサやっていたんですぜ……だから、どうしてくれというんじゃない。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こういうわけで、ヤッサモッサやっていたんです。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな事でモツレがひどくなつて、しばらく前からヤッサモッサもんでいたやつがこの一週間ばかり急に手荒い加減になつて來たんです。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオ、番屋の戸板を外してきねえ」　気転のいいのが三尺を解いて、傷口を押さえているまに、持ってきた戸板へ怪我人をのせ、祭りのように、ヤッサヤッサと五十間を急ぎだした。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
