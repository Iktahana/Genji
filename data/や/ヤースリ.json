        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "○イギリスのナース階級の者はモスク※ではヤースリー〔託児所〕、デーツキー・サード〔幼稚園〕で働いて居る。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここでは児童のための読みもの選択、忠告、並にヤースリ〔託児所〕の仕事までやって居る。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラブ〔集会所〕、ヤースリ等。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○ヤースリが子供のはしかで五〇人になってる。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前達んところにはこうやってちゃんと独立した室があって、職業があって、しかも工場にあんないいヤースリ（托児所）があるのに――。",
              "citation": {
                "source": "三月八日は女の日だ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
