        "examples": {
          "standard": [
            {
              "text": "手作り石鹸の材料として、保湿効果の高いヤシ油をベースに使用する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ヤシ油は低温で固まる性質があるため、冬場は湯煎して溶かす必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "近年、健康志向の高まりから調理にヤシ油を取り入れる家庭が増えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "小屋の真ん中に小さな台が置かれ、ヤシ油を入れたランプがあった。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
