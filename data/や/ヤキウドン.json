        "examples": {
          "standard": [
            {
              "text": "余った野菜を全部入れて、ソース味の焼きうどんを作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "お祭りの屋台で買った焼きうどんは、鉄板の香ばしい匂いがした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "醤油ベースの焼きうどんに、削り節をたっぷりとかける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "○わすれて行った本　届ける　つい　そこだって○なべやきうどんを云いつけにゆく○待っている　約束のハガキのよみちがい○お菓子のこと「あら　それをみんなたべちゃっちゃ駄目よ」○気持よさそうなので　そうすると　ローソクの灯が　急にぱっと明るくなったように　くつろいで楽に居心地よくなった。",
              "citation": {
                "source": "無題（十三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "うどんと言えば、関西の鍋やきうどんを思い出す。",
              "citation": {
                "source": "うどんのお化け",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "浪花座の前で、あきれたぼういずが出てゐるので、呼び出し、ニューパレスでソーダ水を飲み、木の実でやきうどんなど食って劇場へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
