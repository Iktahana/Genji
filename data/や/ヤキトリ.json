[
  {
    "uuid": "328575c8-4a8d-583e-bd50-4e427fe2b5c6",
    "entry": "焼き鳥",
    "reading": {
      "primary": "やきとり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
