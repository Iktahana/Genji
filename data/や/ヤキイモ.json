[
  {
    "uuid": "de81170d-c3cc-521f-ac4e-043cbd8cf0f4",
    "entry": "焼き芋",
    "reading": {
      "primary": "やきいも",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
