  {
    "uuid": "e9ca3e5a-f68c-5bd0-8845-44fe70478708",
    "entry": "焼芋",
    "reading": {
      "primary": "やきいも",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
