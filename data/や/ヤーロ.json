        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――バーカーヤーロー。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "これあ同じ渡世の競争相手のヤーロの奴じゃないか。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだってもう捕えたというのかいヤーロの奴を。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「犯人ヤーロが待ち疲れています。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "加害者のヤーロが先だ。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここへ引立ててこい」　チェリーを一｜服喫っているところへ、ヤーロ親分が留置場から連れられてきた。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "レッドを呼ぶのだ」　ヤーロはそれを聞くと椅子から立ち上った。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やッ、ヤーロ奴、ここにいたな」「こらッ、静まれ、喧嘩をしちゃいかん。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっしを殺したこのヤーロの奴を、ウンと罰してやっておくんなさい。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤーロはレッドを殺害したる罪により、金五万円也の罰金に処す。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ホイ、また流行ったか」「レッドがヤーロをバラバラにしてしまいました。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなったのもヤーロのせいだというので、ヤーロの肩の肉をナイフで切り、その序にバラバラにしてしまったのです」「仕方がない。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後の手を用いて、総監の鼻を明してやろう……）　彼は机上のマイクロフォンを取りあげて、レッドとヤーロの逮捕を電命した。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　レッドとヤーロが手術室の中に姿を消してから、約一時間の後｜扉が明いて、一人の人間が出て来た。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "レッドのようでもあり、ヤーロのようでもあった。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "右がレッドで、左がヤーロ。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすれば元々どおり、レッドはレッド、ヤーロはヤーロの身体にしてやる。",
              "citation": {
                "source": "一九五〇年の殺人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊夜つかれていやだったが、十時すぎから МОСПС〔モスクワ地方職業組合ソビエト劇場、現在のモスソビエト劇場〕へヤーロスチを見に行った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八一六年、著者シヤーロット誕生、當時一家は、ソオントンに住す。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "解説",
                "note": "青空文庫"
              }
            },
            {
              "text": "錢形平次は居ながらにして、江戸八百八町に起る、もろ／＼の事件をかぎ知り、シヤーロツク・ホームズのやうな叡智を働かせて、それを分類し、考察し、市井に湧き起る、もろ／＼の事件を解決して行つたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "死の祕薬",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「財布の紐が懷からはみ出して、その上あわてて居るところを見ると、その邊で飮んだ末、割前勘定が拂へなくて、友達に何んか嫌なことを言はれたんだらう」　平次はニヤリニヤリと、シヤーロツク・ホームズ見たいなことを言ふのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美しき人質",
                "note": "青空文庫"
              }
            },
            {
              "text": "数名の船員が、クレーンを動かして、ワイヤーロープで、船倉から潜水機をつりあげ、その中へ、技師がはいりました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにワイヤーロープをくくりつけて、クレーンで海の底におろし、金塊の箱を鉄のくさりの網にいれて、引きあげようというのです。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
