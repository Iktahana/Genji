    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いつか父親がスワを抱いて炭窯の番をしながら語ってくれたが、それは、三郎と八郎というきこりの兄弟があって、弟の八郎が或る日、谷川でやまべというさかなを取って家へ持って来たが、兄の三郎がまだ山からかえらぬうちに、其のさかなをまず一匹焼いてたべた。",
              "citation": {
                "source": "魚服記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "『今日はとれた、やまべをとって来たんだぜ。",
              "citation": {
                "source": "咲いてゆく花",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "大箱とて、左右の石柱の絶壁、相距ること、ほぼ一町ばかりとなれる処に至り、釣り得たる「やまべ」を下物として、上戸は飲み、下戸は食す。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩谷温泉より上は径なくして、ただ「やまべ」釣りの踏みたる跡、右岸にあり。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "諏訪湖へ注ぐ川へ、春情稍動くを感じて、やまべを釣りに行くと、二三十尾のやまべと十尾内外の公魚がかゝる。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月　春遅い山国信濃も桜桃｜李一時に咲き一時に散つてやまべとなる。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "この土地で云ふハヤは実はやまべであつて、俗称人絹なのだ。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "やまべは学名おいかはで春になると、雄魚は頭がとげ／＼しくなり青い地に赤と紫のお化粧を凝らす、それを土地であかずと云ひ、化粧せぬ雌魚ははやで通して居る。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で文出部落を流れる本流がやまべ釣の川であつて、四五｜尋の深さがあるので、釣り上げる迄のたのしみも深い。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "上川と云ふのは茅野駅から東方四五里の蓼科高原から出る滝湯川と、八ヶ岳の渋の湯から出る渋川の合流したもので、上流は山女魚岩魚の釣場で、下流は六斗川となつて湖水に注ぐ、この六斗本流と、お白狐神社前から諏訪の競馬場うらを流れる支流がやまべの居る水筋である、文出の宮川より浅く流れは急である。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "上川筋は稍急流で浅場なので、足で釣らなくてはならぬが、やまべらしく案外｜魚籠は重くなる。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからなら、ヤマベ、ハヤ、アユ、川エビ、フナ、海ではカサゴ、メバル、カイヅ、キス、スズキ、と、五月は海が開く、地球が若がへつて、たつぷり水を持ち、熱を持ち、美しい魚を自由に釣らしてくれる。",
              "citation": {
                "source": "釣心魚心",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "川では鮎、鱒、鯉、鮒、ニゴヒ、ハヤ、モロコ、ヤマベ、イハナ、ヤマメ、タナゴ、鰻、鯰、鰌、ハゼ、イナ、などが釣れ、海では、鯛、鱸、鯒、鰈、鰺、鱚、烏賊、蛸、カサゴ、アイナメ、ソイ、平目、小松魚、サバ、ボラ、メナダ、太刀魚、ベラ、イシモチ、その他所によつて、百種以上のものが釣れる。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "傍らに土人の小屋を立ててヤマベを捕るあり。",
              "citation": {
                "source": "関牧塲創業記事",
                "author": "関寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマベを釣り、味噌汁に五升芋とヤマベを入れて煮たる汁を喰す。",
              "citation": {
                "source": "関牧塲創業記事",
                "author": "関寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京では正しくヤマメと言っているけれど、栃木県と群馬県の桐生地方ではヤモと呼び、福島県、宮城県、北海道などではヤマベと称している。",
              "citation": {
                "source": "雪代山女魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、釣道具も、この宿で売ってる最下級の安物だから、アユだのヤマベだのイワナをつるには無理ですよ」「釣れたら、見せてちょうだいね。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰り道、今年こそ利根のスズキとヤマベをやってみたいと話しながら、四時半に木内氏宅へ寄ると、神崎釣友会の連中が集まっている。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "何によらず上には上があるもので木内氏の家ではヤマベに使うサシからキジ、ボッタまで囲ってある。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十六尾だが型がよく、六寸ぐらいのハヤとヤマベが一尾ずつ出たのもおもしろい。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "春のヤマメ・ハヤ・ヤマベ〈四月〉　大正の末期から昭和の初めごろまで、夢中になったぼくの魚釣りも、重病人が紙一枚ずつはがすように全快するごとく、釣り道具の手入れもしなくなっていたが、太平洋戦争が夜店の植木屋みたいに大負けに負けたあげく、ぼくも焼け出されて玉川の尾山台にしばらくいたことがあった。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハヤとヤマベを釣って、八時ごろに納竿して家へ帰ると、ちょうど家の者が起きだしたところだ。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "四、五月ごろを最盛期にする川のイワシといわれるヤマベとハヤが、毎朝の食膳を飾る。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "川のイワシとあだ名される関東のヤマベも、学名を「追河」というそうだが、大阪で「ハス」、中京・名古屋で「白ハエ」、相模で「ガンガラ」、信州で「人絹」。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪で紀の川、紀伊清水でも寒ハス釣りをしたが、東京の釣り師は寒中、タナゴ、ワカサギは釣るが、ヤマベを釣る人はほとんどいない。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正の十四年ごろ、葛西の船堀、三角あたりでよい型のヤマベが出た。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "笹にごりの流れに舟をもやって、唐辛子ウキで打ち返し釣るヤマベも楽しみだが、ぼくは酒匂川、相模川、多摩川の清流、二尺くらいの浅場でコブシ大ぐらいのアカつきの石を目あてに、白の玉ウキ、川虫をとって釣るヤマベにほんとうの魅力を感じる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "一尺ぐらいのザラ場で三尺ぐらいのウキ下、オモリを取ってのふかし釣り――流れるウキが流れよりおくれたり、流れより早くなったり、横にツンと五寸ぐらい寄ったときに竿先を軽く合わせると、のめるようなヤマベ特有の引き。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "浅場のヤマベは、あとを散らさないように川下へ引いてきてあげるのだが、あまり大きな動きをしないで釣れば、一尺五寸、二尺ぐらいの浅場も、あらかたそこにいるだけのものは釣れてしまう。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "サシを使う場合でも、サシのしっぽがだらんとして汁の出たふやけたのは、ヤマベに、「おまえはへただなあ」と教えられているようなもので面目ないが、早めに取り替える。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
