        "examples": {
          "standard": [
            {
              "text": "長引く病気で、体はやせ細ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "飢饉のため、人々はやせ細り、力尽きていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの木は水をやらないと、どんどんやせ細っていくよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "だが少年の日の私は、この一冊の小説のために、やせ細るほどの思いを続けた。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ盗難を予告された品物が、国家の宝物というのですから、捜査課長や、ちょくせつ二十面相の事件に関係している中村係長などは、心配のためにやせほそる思いでした。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
