          "literary": [
            {
              "text": "群衆がちょっとしんみりしたところをねらって、チョビ安大声に、「ヤイヤイッ！",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "出あいがしら……よろめきながら、「ヤイッ、気をつけろい！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤイ、ヤイ、ヤイッ」酔払いが呶鳴った。",
              "citation": {
                "source": "間諜座事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "途端に、荒く障子をグッと開けて全身を乗り出した総江が――「ヤイッ――」「ウ。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤイッてどなりつけてやると、そいつが木の上から、おいらを睨みつけやがった」「こんな顔だったか」「そうよ。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
