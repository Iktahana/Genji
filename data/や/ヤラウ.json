          "literary": [
            {
              "text": "」ト、ウシロノ　ハウガ　イヒマスト、マヘノ　ハウガ、「モウ　スコシ　サキノ　ガケノ　上カラ　タニ川ヘ　ホリコンデ　ヤラウ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ　フトコロニ　コヒツジヲ　イレテ、「シカタガ　ナイカラ、コノ　コヒツジハ　オレガ　ソダテテ　ヤラウ」ト　ヒトリゴトヲ　イヒナガラ　ヤツテ　ユクウチ　トツプリ　ヒガ　クレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コマツタ　ヤツダナ、オレニハ　オチチガ　デナイカラ　ヤツパリ　モトノ　マキバヘ　ツレテツテ　ヤラウ」ト　イツテ、ヌスビトハ　ペコペコノ　オナカヲ　オサヘナガラ　マタ　モト　キタ　ミチヲ　カヘツテ　ユキマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハテ、コンナ　ウツクシイ　花バタヲ　ダレガ　アラシタノダラウ」ト　ヲトコガ　タホサレタ　イツポンノ　ケシノ　花ヲ　オコシテ　ヤラウト　スルト、ソノ　ネモトニ　シンチユウノ　ラツパガ　ヒトツ　オチテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエノコヒビトヲヨンデヤラウ　アトレスモシツテイル",
              "citation": {
                "source": "朝",
                "author": "李箱",
                "note": "青空文庫"
              }
            }
          ]
        }
