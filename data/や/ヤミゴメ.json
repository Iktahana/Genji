        "examples": {
          "standard": [
            {
              "text": "戦中戦後、食料不足の時代にはヤミ米が重宝された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "闇市では、正規の流通ルートに乗らないヤミ米が売られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は家族を養うため、ヤミ米の販売で生計を立てていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "大衆は正直　街頭録音の農林大臣が、私もヤミ米を食べていますと言って群集の歓呼をうけた。",
              "citation": {
                "source": "ヤミ論語",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
