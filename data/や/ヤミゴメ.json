  {
    "uuid": "37d3cfb0-191c-501f-a0e3-9520b253d8db",
    "entry": "闇米",
    "reading": {
      "primary": "やみごめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
