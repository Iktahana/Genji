        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すると外の者等が覗込んで、『ヤマク（山鯨）を持って来た。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもヤマクを持って行くという事は私どもの誇であった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる有様であるから、ヤマクを弁当の菜に持って行って、皆が騒ぐのも無理はない。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "次にオホヤマクヒの神、またの名はスヱノオホヌシの神です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてハヤマトの神が、オホゲツ姫の神と結婚して生んだ子は、ワカヤマクヒの神、次にワカトシの神、次に女神のワカサナメの神、次にミヅマキの神、次にナツノタカツヒの神、またの名はナツノメの神、次にアキ姫の神、次にククトシの神、次にククキワカムロツナネの神です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上ハヤマトの神の子のワカヤマクヒの神からワカムロツナネの神まで合わせて八神です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
