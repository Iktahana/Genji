    "definitions": [
      {
        "index": 1,
        "gloss": "suffix for familiar person",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "おばあちゃん、元気しとるやん？",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "なにしてるん、たかしやん？",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "また会ったやん、元気？",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "汽車が箱根を越える頃、降りやんでゐた雨は再び降り出して来て、窓硝子の上に斜めの線を引きはじめた。",
              "citation": {
                "source": "三等車の中（スケッチ）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君ちやん（僕の名、実は君介、どうもブラ公みたいな名ですよ）どうも遅くなつて御免よ、富田の奥さんがいろんな話をしなさるから、あとからあとから話しなさるから。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "）５　私が彼を訪問した時、私が訴へんとするすべてのことを、彼は前からちやんと知つてた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初の年には三ちやんが一等賞になる。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "二年目には五※ちやんが一等賞をとる。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初の年の一等賞の三ちやんがゐたので、二年目の五※ちやんは何か得をするのである。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "短歌や俳句がちやんとした娘ならば、詩の多くは云つてみればおひきずりであつた。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」良子の家に毎日やつてくる真つ赤な顔や手の魚屋の小僧は、いまお祖母ちやんが鉢を出しに奥へ行つたと思ふとそんなことを云つた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「お嬢ちやんのばーかやい。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「良子ちやん、おさらひをするんだよ。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「だつて先生は、はやく読むんですもの……」　お祖母ちやんは黙つて笑ひさうにしてゐた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "お祖母ちやんは、忽ち起つて、干物を入れるために庭に下りた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "お祖母ちやんには、この柿の樹と、塀とに渡してある重さうな干物竿が却々持扱へなかつた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あのう、赤ちやんが咽喉にお餠を引つ掛けて、呼吸が止りかけてゐます。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――耕ちやんはキャプテンなんだつて。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あのパツタパツタいつてるのは何かおまへ知らないかい、耕ちやんの部屋らしいが。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「耕ちやんがまりでさせてんの。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「耕ちやんは怠けるのなんのと言つてもまだ家｜嗣ではないのだからなんだが、あんたが………。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんたは怠けて出来ないんだし、耕ちやんのは好い頭でないのとそれに欲気がまだ出ないんだから………。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでちやんと人間になつて帰るのですから。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「正ちやん、人が笑ひますよ、そんなことを言ふと。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "『あれ、芳ちやん』此の時女は耐り兼ねて、紳士の背後から躍り出た。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『芳ちやん、お待ちツてば、アレ、そんな手荒なことを』纖弱い腕を延べて、男の右手に搦み付く。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『芳……芳ちやん』群集を振り返た時にはおろおろ聲で眼が血走つて居る。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "背後から靠掛る樣に抱きついて密接顏を押し附けると、切なげに身を悶えて『堪忍してよ、芳ちやん………』『………』男は何か言はうとして、僅に手先を動かしたが『阿※』と一｜唸呻、言下に反繰返つて仰樣に僵れた。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "過ぎ去った様々の不幸を女々しく悔やんだり、意気地のない今の境遇に愛想をつかすのもこの頃の事である。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "船の進むにつれて最早気味悪き音はやんで動揺はようやく始まりて早や胸悪きをじっと腹をしめて専ら小説に気を取られるように勉むればよう／＼に胸静まり、さきの葡萄酒の酔心。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃は男の子と女の子が遊んでいると、他の遊び仲間から「おとことおなごとおにやんべ、やんがておややができやんしょ」と云って囃し立てられるのであった。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
