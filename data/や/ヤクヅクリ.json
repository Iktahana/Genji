        "examples": {
          "standard": [
            {
              "text": "新作映画で難しい役を演じるため、彼は役作りに3ヶ月を費やした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "役作りのために、その俳優は実際に同じ職業で1週間働いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "時代劇での役作りに必要な剣術の稽古を毎日続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "何が大変だったかと言えばキャロルの役作り（訳作りではなく）でした。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "役者が演じるキャラの役作りをするように、私も（役者でもあったので）作家に合わせて役作りをするのですが、とんでもない縛りが多くてそれなりに苦労しました。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "一般公募から選ばれたザ・モンキーズの四人は、役づくりまでビートルズに似せてあり、才能は四人のいずれにもほとんどなかったのだが、テレビと広告キャンペーンのおかげで、サブ・ティーンたちのあいだに一時的な人気があった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
