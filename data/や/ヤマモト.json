    "definitions": [
      {
        "index": 1,
        "gloss": "foot of a mountain",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔話によく出てくる「山元」には、不思議なことが起こると言われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、山元にある小さな小屋でひっそりと暮らしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "山元には、地元の人が大切にしている小さな祠があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "私は南伝馬町の幸菱と申します紙問屋の支配人を致してをりまして、狭山元輔と申しまする。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほかに元園町に堀江小学、山元町に中村小学というのがあって、いわゆる代用小学校であるが、その当時は私立小学校と呼ばれていた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "広谷君は私の家から遠くもない麹町｜山元町に住んでいるのである。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから半年ほどの後、円朝が近所（麹町区山元町）の万長亭という寄席へ出て、かの「牡丹燈籠」を口演するというので、私はその怪談の夜を選んで聴きに行った。",
              "citation": {
                "source": "寄席と芝居と",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は麹町区元園町（此頃は麹町二丁目に編入されてしまった）に生長したが、近所の寄席は元園町の青柳亭、麹町二丁目の万よし、山元町の万長亭で、これらの寄席へ行った時に、顔を見識っている人に逢わなかった例は一度もなかった。",
              "citation": {
                "source": "寄席と芝居と",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの姉は長唄の稽古以外に、山元町の藤間｜大奴という師匠のところへ踊りの稽古に通っていた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "広谷君は私の家から遠くもない麹町山元町に住んでいるのである。",
              "citation": {
                "source": "火に追われて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "山元春挙氏と石３・７（夕）　朝鮮人が何か夢をみてゐるやうだが、その朝鮮人や唖の真似をして、遊び友達や舞妓をきやつきやつ言はせる事の好きな人に、京都の画家山元春挙氏がある。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "春挙氏に画を頼むには３・18（夕）　江州膳所の別荘に籠つてゐる山元春挙氏が、石集めに余念もない事は、こなひだ書いた通りだ。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "数多い山元春挙氏の門弟のなかで、誰の眼にも一番光つて見えるのは川村曼舟氏である。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "永寿院は藍渓元徳、安長は桂山元簡である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "安長は桂山元簡、楽真院はである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その諸友は、渡辺庫輔（与茂平）、村田利明、鵜木保、鹿児島寿蔵、竹内治三郎、森路※平（高谷寛）、赤星信一、村田敏夫、山根浩、加納美代、佐藤峰人、遠藤勝、畠山元三郎、結城健三、三田澪人、志村沿之助、我謝秀昌の諸氏で、この集を編むことの出来たのも、皆此諸氏のたまものである。",
              "citation": {
                "source": "つゆじも",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "気がついてみると、学生や労働者や勤人なんかが、実に沢山元気よく忙しそうに通っていました。",
              "citation": {
                "source": "香奠",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞の軍へのオベンチャラ世辞の代表的なもの――「やがてこれが終ると、杉山元帥ともども新聞社のカメラに收ったが、つと立上った杉山元帥は『身体を大事にして呉れ給え』と犒う。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたわる杉山元帥、元気な東條さん、そこに無敵陸軍の崇高な精神の流れが、ひしと感ぜられる」　挨拶をすることが「崇高な精神」なのである。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "青山元不動、白雲自去来、私はいつもあの三ツ山を仰いで黙想をつづけています」　客は心機一転して去る。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "大山巌さん（後の大山元帥）などもよく往来で「今夜来ないか、鶏を食わせてやる」という招待を受けられた由。",
              "citation": {
                "source": "牧野伸顕伯の思い出",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「佐原屋といふのは、深川の材木問屋でも一二と言はれた家柄で、店の株、諸國の山元への貸金、材木置場に積んである材木などの外に小判で一萬兩以上も持つて居るといふ評判だつたが、今から五年前、主人の甚五兵衞は何を考へたか、その現金を一人でコソコソと隱し始めた。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "幽靈の手紙",
                "note": "青空文庫"
              }
            },
            {
              "text": "「佐原屋の身上がどうなつて居るか、現金の融通、材木、山元との取引など、仲間に訊いたら判るだらう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "幽靈の手紙",
                "note": "青空文庫"
              }
            },
            {
              "text": "越えて十二月、父なる山元椿荘氏から一封の手紙をうけとった。",
              "citation": {
                "source": "或る少女の死まで",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の四十八の峠はとても鉄道と競争するほどの捷路ではないから、身が軽く日を急ぐ者は、山元の山民でも出て来て汽車に乗る。",
              "citation": {
                "source": "峠に関する二、三の考察",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "やまもとの鳥の聲より明け初めて、花もむら／＼　色ぞ見え行く何となき草の花咲く野べの春。",
              "citation": {
                "source": "歌の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "見わたせばやまもとかすむ水無瀬川ゆふべは秋となにおもひけむ、わたしは院のこの御歌がすきであった。",
              "citation": {
                "source": "蘆刈",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして水のほとりの楼のうえからかまたはお庭をそぞろあるきなさりながらか川上の方を御覧になって「やまもとかすむみなせ川」の感興をおもらしになったのであろう。",
              "citation": {
                "source": "蘆刈",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "山もとより少なからず、しかも変幻出没して雲表に豪然たる偉容を作れるは少なし。",
              "citation": {
                "source": "文学に現れたる東北地方の地方色",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後は近郊散策、私の好きな石蕗が咲いてゐた、龍膽はたづねあてなかつた、野も山もところ／″＼紅葉してゐる、百姓は田畝でいそがしく、たいがい留守であつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのふけふしぐれの雨ともみぢ葉とあらそひふれる山もとの里　こんな歌が宮村の仮寓でできたのも前年の冬のことであり、同じ年の夏には次ぎのようなものもできた。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "寸馬豆人のみぞ、かれかと許り疑はれて、つゝら折幾重の峯をわたりきて雲間にひくき山もとの里　日もやゝ暮れかゝれば四方濛々として山とも知らず海とも知らず。",
              "citation": {
                "source": "かけはしの記",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二百五十九　一名案　中川の帰りしよりお登和嬢も小山もともに台所を飛出したり。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "mine",
