[
  {
    "uuid": "082726fe-3609-5832-acf1-7059d354a067",
    "entry": "ヤブ医者",
    "reading": {
      "primary": "やぶいしゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "inept doctor",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "誤診の多いヤブ医者として、その医師は評判が悪かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「もしヤブ医者だったらどうしよう…」と彼女は心配そうに言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は症状が改善しないため、別のヤブ医者ではない病院を探した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "病気で死にたくないならばヤブ医者を頼みません。",
              "citation": {
                "source": "今度の選挙と婦人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんのためにその来館へアンタというヤブ医者が現れてお客を診察する必要があるのさ。",
              "citation": {
                "source": "影のない犯人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと近いところに二三医者がいたが、ヤブ医者のくせに、未明の往診に応じてくれなかった。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙庵先生のウチの者だが、アンマを一匹さしむけてくれ」「自分で脈がとれねえかよ、ヤブ医者野郎め」　稲吉は流しにでているから、二階に売れ残っているのは角平ひとり。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙庵があんまりはやらないヤブ医者だから、その代診の仙友は、実は下男代りのようなもの。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は付近のヤブ医者にひどい目にあわされているので、種痘は自分などの頃が始めのように思っていた。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしのこの全身を大手を振つて通行し、能く有終の美を成すもののみが真の美味であるとする小論は、ヤブ医者でない限り天下の医家によつても賛成してもらへるに足る名論卓説であると自讃して擱筆する。",
              "citation": {
                "source": "黄金綺譚",
                "author": "潔癖の人必ず読むべからず",
                "note": "青空文庫"
              }
            },
            {
              "text": "診断したヤブ医者によれば、あばら骨が折れて、肺にささり、失血死するとか。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
