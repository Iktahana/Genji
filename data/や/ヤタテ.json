        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "弓道家は、矢立から一本の矢を素早く取り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "戦場で矢立が空になるまで矢を放ち続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "訓練された兵士は、矢立から矢を取り出す動作も無駄がない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
