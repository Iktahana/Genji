        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "車夫は必死となりて、やわか後れじと焦れども、馬車はさながら月を負いたる自家の影のごとく、一歩を進むるごとに一歩を進めて、追えども追えども先んじがたく、ようよう力衰え、息｜逼りて、今や殪れぬべく覚ゆるころ、高岡より一里を隔つる立野の駅に来たりぬ。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、――ほんたうのことは、大庭でなくちやわからんよ。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、ふんふん、いやわかりました。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかわりそんなきれを鼻緒に巻いた藁草履やわかめなどを置いて行ってくれる。",
              "citation": {
                "source": "海　断片",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やわか功徳の無いことがあろうか。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "我も少し力ありて、やわか座頭に劣るまじい大力のほどが想はれる。",
              "citation": {
                "source": "怪力",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私どものような老人でさえ経験したことのないような苦しみをなめて今日までお待ちになったのでございますよ」　女たちは惟光にもっともっと話したいというふうであったが、惟光は迷惑に思って、「いやわかりました。",
              "citation": {
                "source": "源氏物語",
                "author": "蓬生",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でも當つて見なけりやわからない。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつて見にやわからんことなら今から心配しても無駄ぢやし……、それにわしの考へでは分裂しても案外石川なんぞについて行くものはないといふ氣がします。",
              "citation": {
                "source": "一過程",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と訊いたとき、看病夫が、「俺たちにやわからねえよ」といつた。",
              "citation": {
                "source": "盲目",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そりやわかります。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さア、そりやわかりませんね。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷が勝ち過ぎるかどうかはやつて見にやわからん。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あなたは共産党の方でしょう」「どうしてそれを知っているんです」「そりやわかります。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒めが、やわか別嬪逃がすまじと、ほら、のう、あの通り今もなおしきりと弾んでいるわ、わはははは、わはははは、のう、どうじゃ、畜生のあさましさとはまさしくあれじゃわ。",
              "citation": {
                "source": "旗本退屈男　第五話",
                "author": "三河に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "篠崎流奥義の腕にかけても、やわか許すまじと、真に颯爽としながら打ち乗って、一路、美作守上屋敷なる麻布六本木へ急がせました。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見ると私はあまりにその處女心を亂したのが氣の毒にもなつて、「何もそんなに心配する程のものぢやないわ、どうせいたづらですもの……まあ今日の××新聞を見て御覽なさいよ、見りやわかるわ！",
              "citation": {
                "source": "嘘をつく日",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんでもかんでも聽いてもらあなくつちやなんねえんだよ」「解らねえなひどく」「いやわかつてもわからねえでも世間態もよくねえんだ。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ははあなるほど、昔の友達だなどと当人は申して居りますが……ははあ、いやわかりました。",
              "citation": {
                "source": "都の眼",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "居士が病気になつて後｜頻りに義太夫を聞いて、義太夫語りの評をして居る処などはややわかりかけたやうであるが、まだ十分にわからぬ処がある。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "その松浦屋、そなたの手引きで、奸しまの人々の陥穽に陥り、生きながら、怨念の鬼となり、冥府に下って、小やみもなく、修羅の炎に焼かれての、この苦しみ――おのれ、この怨み、やわか、晴らさで置こうや！",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "おのれ、そのうらみを、やわか、やわか、忘れようか！",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんぶやわかめなどの海草の林が見え、岩の上にはなまこがはっている。",
              "citation": {
                "source": "三十年後の東京",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、飛行機のかっこうから考えて、どこの国の飛行機かわかるだろうに」「そうですね――いやわかりません。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
