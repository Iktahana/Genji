        "examples": {
          "standard": [
            {
              "text": "夕方から吹き始めた山背風が、家々の隙間をヒューヒューと通り抜ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "山背風に当たると風邪を引くと、村の古老が注意を促した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "山背風を避けるために、この集落の家々は南向きに建てられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "○山背風ア七日吹く。",
              "citation": {
                "source": "津軽地方特有の俚諺",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この俚諺は単にこの警戒すべき山背風なるものに対する気象上の観察を述べたものとして今解釈して置く。",
              "citation": {
                "source": "津軽地方特有の俚諺",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩秋の冷たい山背風の吹いている夕方、額から玉のような汗を流し、火のついたような赤い顔をして、「…… amo …… amas …… amat ……」　私は愛す、……汝は愛す、……彼は愛す、―― amare の第一変化を、はちきれるばかりに鼻翼を膨らませ、息も絶え絶えに繰りかえす。",
              "citation": {
                "source": "葡萄蔓の束",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
