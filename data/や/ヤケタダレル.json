    "entry": "焼け爛れる",
    "reading": {
      "primary": "やけただれる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "下一段-ラ行",
      "inflections": null,
      "ctype_source": "existing",
