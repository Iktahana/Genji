        "examples": {
          "standard": [
            {
              "text": "翻訳者からの訳注によると、この箇所は原文でも解釈が分かれるという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "読者は、訳注を読むことで、作者の意図や文化的背景をより深く理解できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、自身の訳注で、専門用語の解説を補足した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
