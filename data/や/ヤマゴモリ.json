        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "会社の研修として、全員で山ごもり合宿に参加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は新しいプロジェクトのアイデアを練るために、山ごもりを行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ストレスが多い現代社会において、山ごもりは有効なリフレッシュ方法かもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
