        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大体の雰囲気で「山勘」を頼りに、このプロジェクトを進めるしかない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "確証はないが、私の山勘では、この方向で間違っていないはずだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼はいつも、直感や山勘で物事を判断する癖がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "八　蓮子は十七歳の夏、姉の寛子の所をたよって上京して来ると、すぐ姉の良人、松山勘三の友人瀬良三石と結婚してしまって、三人の姉達に呆れた女だと叱られてしまった。",
              "citation": {
                "source": "泣虫小僧",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はやがて丸の内の山勘横町へ来た。",
              "citation": {
                "source": "黒白ストーリー",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――16――　徳市はボンヤリと山勘横町へ来た。",
              "citation": {
                "source": "黒白ストーリー",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "差添は別府新八で、曲者は森山勘八と申す者で、神原五郎治の家来であります。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "また砂利の上に莚を敷きまして、其の上に高手小手に縛されて森山勘八が居りますお目付が席を進みて。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "稽古が済むと、脱兎何のそのという勢いでいきなり稽古場を飛び出したが、途中で父の組下の烏山勘左衛門に出遇ッた。",
              "citation": {
                "source": "初恋",
                "author": "矢崎嵯峨の舎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「山勘も、たまには成功さしてやらないと、可哀そうじゃないの。",
              "citation": {
                "source": "自由人",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「山勘というのは、自分の能力に自信がなくて、お姉さんのように、ひたすら天運を当にすることだ。",
              "citation": {
                "source": "自由人",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはいいとして、この山勘口上で第一におもしろいことは、この興行に決まった入場料のなかったことであった。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに博士が力説しても、元日の午前九時十二分に噴水の鶴が鳴くなどというのは、一分の偶然は期待出来るにしてもあとの九分は山勘である。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "山勘の兵法學者が、妾の一人や二人蓄へたところで、當時の低い道徳通念では、非難する者もある筈は無く、その石女の内儀が、妾を殺す氣になるといふことも、當時の物の考へ方には、無いことです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "軍學者の妾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この女房というのがすなわちお万殿で、もとは、美濃国岩村の城主遠山勘太郎が妻、信長のためには実の伯母です。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸家老灰野内蔵助――これは助左衛門の盟友だった人の子である――植原主水、灰野六郎右衛門、時山勘兵衛、以上四名の老臣がとつぜん職を解かれて禁固、またかれら腹心の者三十余人も検挙のうえ拘束された。",
              "citation": {
                "source": "落ち梅記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは四月のことであるが、その後、伊東の家従である高野兵右衛門、斎藤徳右衛門らが、徒目付の横山勘右衛門を通じて「伊東家再興」の嘆願をつづけていた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠山勘解由は、奥山大学の弟であった。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠山勘解由はまだ忿懣がおさまらないとみえ、肩肱を張ってむっとふくれていた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは山勘さ、どうせ早川の様な男だ、只で三千円は貸さんからね。",
              "citation": {
                "source": "雪",
                "author": "楠田匡介",
                "note": "青空文庫"
              }
            },
            {
              "text": "信長は桶狭間という狭隘の土地で今川義元を短兵急に襲って、首級をあげたが、併しそのやり方はいくらか、やまかんで僥倖だ。",
              "citation": {
                "source": "厳島合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ひろれ」は蓑草で、本名は「みやまかんすげ」だというが、越後、羽後あたりでは「ひろろ」とか「ひろら」とかいう言葉を使う。",
              "citation": {
                "source": "蓑のこと",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマカン会社で、地方のなにも知らん慾ばりの爺さんどもを、一カ年五割の配当をすると釣って金を出させ、そいつをかき集めて、使いこんで行くというやり方だった。",
              "citation": {
                "source": "自伝",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小癪なヤマカン吐きおるな。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナーニ何うだって構うものか、どうせヤマカンでやっていることだ。",
              "citation": {
                "source": "首頂戴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが轟君の手に渡り、それが又今度倉川の手に渡るとか渡らぬとか言ふ事になつて来ると、そいだけ金がかゝれば結果として又そいだけの利益をあげなければならん道理で、やつぱりヤマカン事業になつて来るんだなあ。",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜約二千｜米突以上は、雑木次第に減じ、ミヤマカンバ、ミヤマハンノキ、ミヤマナナカマド等の粗く生えたる土地、ここをぬけると上宮川原「信濃、上宮川原、嘉門次」、左の方数丁には、南穂高の南東隅に当る赭色の絶嶂。",
              "citation": {
                "source": "穂高岳槍ヶ岳縦走記",
                "author": "鵜殿正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一休して、この川原を斜めに右方に進み、ベニハナイチゴ、ミヤマナナカマド、ミヤマカンバの小柴を踏み、午前八時には前記の鞍部、高さ約二千二百六十米突、ここに、長さ十間幅四間深さ三尺ばかりの小池がある、中ほどがくびれて瓢形をなしているから、瓢箪池といおう。",
              "citation": {
                "source": "穂高岳槍ヶ岳縦走記",
                "author": "鵜殿正雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
