[
  {
    "uuid": "0f52887a-0b8d-5ff1-aa90-f9a4045a192c",
    "entry": "焼け付く",
    "reading": {
      "primary": "やけつく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
