          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お正月には、子供たちが公園で奴を揚げて遊んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "カラフルな奴が、青空に高く舞い上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の部屋には、手作りの奴が飾ってある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
