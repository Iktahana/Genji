  {
    "uuid": "c4294cc3-1a25-5394-8010-39ffc5676d29",
    "entry": "薬壺",
    "reading": {
      "primary": "やっこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "非常な大きな薬棚で、無数の薬壺が置かれてあった。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は薬壺を取り出した。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、薬壺を棚へ載せ、襖を立てて寝る用意をした。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "喇嘛僧形の薬壺がある。",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬壺、湯飲み等を載せた盆。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一に、吾々の乗り込んでいた薬壺のような小さいボートは非常に積み込み過ぎていた。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "左手は結跏趺坐した膝の上にゆるやかにおかれているが、おそらくその上に薬壺を載せていたのであろう。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来あの茶入は、支那から渡った薬壺であったと云われます。",
              "citation": {
                "source": "民藝とは何か",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
