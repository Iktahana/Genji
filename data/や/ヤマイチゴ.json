          "literary": [
            {
              "text": "林の中でお辨当を食べる、山苺がデザートだ。",
              "citation": {
                "source": "行乞記",
                "author": "大田",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴れた日に童子をつれた阿闍利さまはいつも山の路のないところで、山苺の実や、秋はあけびを摘んで食べておられました故、童子の亡くなったことはどんなに阿闍利さまの気をくるわせたかも判りません。",
              "citation": {
                "source": "あじゃり",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "又た無邪気の友と共に山いちごの実を拾ひて楽みしところなり。",
              "citation": {
                "source": "鬼心非鬼心",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
