[
  {
    "uuid": "1eb41a01-ec92-5e69-9b2c-4263241a1fdb",
    "entry": "焼き栗",
    "reading": {
      "primary": "やきぐり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
