        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何かしらシテヤラレタという感じに打たれながらベルを押すと、ボーイが来ないで、支配人が、魔法瓶と新聞を両手に持って這入って来た。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ギャアッ……ヤラレタッ……」　と云う悲鳴がどこからか聞こえたように思ったが、全く夢うつつだったね。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤラレタ……」　と云ううちに見る見る青くなってドッカリと尻餅を突いた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤラレタ……ツヤ子の怨みだ……畜生……ツヤ子だ、ツヤ子だ、ツヤ子だ」　って言った切りコトキレたって言う話よ。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アッ」　正宗菊松は、ヤラレタカとすくんだが、ドサリと蹴られる音がしたのは、だいぶ離れたところである。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンハ早起キナンダカラ、ソレカラ彼ノ所ヘ行クワ」「寝込ミニ蹈ン込ンデ眼ヲ覚マサセルノモ可哀ソウダナ」「ナアニ寝ナイデ待ッテルデショウヨ」「コイツハヤラレタ」夜九時半入浴、十時就寝。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
