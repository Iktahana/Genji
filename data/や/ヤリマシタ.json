          "literary": [
            {
              "text": "パパハ乙吉ニヤリマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　王サマハ、カタツムリヲ　ツブサナイデ、青イ　ハノ　上ニ　ソツト　ノセテ　ヤリマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ミツルクンヲ　オツカケテ　イツテ　三ツ四ツ　ナグリツケテ　ヤリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヘノ　ナカニハ　フタリノ　トシヨリガ　ヰテ　チヨウド　ヒトツノ　パンヲ　フタツニ　キラウト　シテ　ヰル　トコロデシタガ、ハラノ　スイタ　ヲトコヲ　キノドクニ　オモツテ　パンヲ　ミツツニ　キリ、ソノ　ヒトキレヲ　ヲトコニ　メグンデ　ヤリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　コトリヲ　ミセテ　ヤリマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イツテ　ヤリマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ムスコニ　テガミヲ　ヤリマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレハ　カンザシト　イツテ、アタマニ　サスモノデス」ト　ヲンナノ　コハ　オシヘテ　ヤリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイキナリ道子ノ髪ヲツカミ清三ノ持ッテ居タナイフヲ突キツケテ声ヲ立テルト殺スゾト云ッテヤリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ急所ヲサケテ右ノ乳ノアタリヲ突イテヤリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ彼女ガ自由ガキカズタダ苦シミモダエテ居ル間、アラユル呪イヲ浴セテヤリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ、ハジメニモ申シ上ゲタ通リ、モンコチヤンハ大ヘンモノヲ大切ニスル子デスカラ、ボンコチヤンニツイテヰタホコリヲ、テイネイニブラツシデハイテヤリマシタカラ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ「ソンナラ私ガ立テテ上ゲヨウ」トイツテ、手デ立テテヤリマシタガ、手ヲハナスト、スグマタパタリトタオレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
