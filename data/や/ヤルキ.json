[
  {
    "uuid": "b48839f5-9df4-57ba-bfec-9d6784277dcb",
    "entry": "やる気",
    "reading": {
      "primary": "やるき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
