          "literary": [
            {
              "text": "その灰ふるいを手あぶりにかけて、釣ったワカサギを焼き、これもヤキジューにして食べる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣り師はこれを「ヤキジュー」という。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "フナ刺身気のへるほどにアラを出し　三センチから五センチぐらいまでのフナは、ヤキジューの雀焼きか、あっさり煮つけてコブ巻きの中に入れる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
