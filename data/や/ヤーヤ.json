        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "前方で例の通り、文六、団九郎がヤーヤー珍しや、をやって居る。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ庭先の鶏舎の朝鮮人の長屋で子供がヤーヤーヤーとないていて、母親が、パアパア何とかとこわいような優しいような声を出して薪をわっています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "まっぴるま、そとを見るのもまぼしいようなときに、かなり下手な三味線と、時々、ヤーヤーコラサーッとはりあげる女の声は、何の情味も持って居ないのみならず、却って悲惨なような心持がする。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカナー　ヤーヤ　ヤキタン　ドー　ハークガ　ヤンムチ　コーティ　タックワー　シー　夕焼があると、何時でも子供達が意味の解らぬなりに面白がって歌ふ謡である。",
              "citation": {
                "source": "奥間巡査",
                "author": "池宮城積宝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤーヤーヤー………　タッタ、ヂャンヂャン、ドン、ヂャラン、ヂャン。",
              "citation": {
                "source": "阿Ｑ正伝",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤーヤーそれへ来りしはなんの某ならずや。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
