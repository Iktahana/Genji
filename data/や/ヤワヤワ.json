          "literary": [
            {
              "text": "ハハハハハハ」「ドッコイドッコイ……どうでえこの腹部のヤワヤワふっくりとした事は……トテモ千金こてえられねえや」「アイテッ。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、そのワヤワヤワヤはまだいいので、こまるのは体操。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おふたりはヤワヤワともんで、最後の私に引きわたしてもらいたいな。",
              "citation": {
                "source": "幻術天魔太郎",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "お嬢様をどこへ隠した――とヤワヤワと訊くと、『私が浜路でございます』と、ニコニコしているんだから手の付けようはねえ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "二人浜路",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
