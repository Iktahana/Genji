        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "秩父地方では子供が行方不明になるのを、隠れ座頭に連れて行かれたといい、またはヤドウカイに捕られたというそうだが、これなどは単純な誤解であった。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからヤドウカイはまたヤドウケと呼ぶ人もあった。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして夕方には村の辻に立って、ヤドウカと大きな声でわめき、誰も宿を貸しましょと言わぬ場合には、また次の村に向って去った。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
