[
  {
    "uuid": "898381aa-04eb-5d65-90c5-69925c48d4ed",
    "entry": "やり取り",
    "reading": {
      "primary": "やりとり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
