    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その時に待合所の女中か何かが見覚えのない小さな鞄を持って来たのを、「おれのじゃない」　と押し問答したあげく、やっと昨夜鶴原家を出がけに兄が自動車の中に入れてくれたものであることを思い出して受け取った。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜鶴原未亡人に丸うつしと思ったのが、あくる朝は似ても似つかぬ顔になっていたこともあった。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は昨夜鶴岡の多介屋で一泊させて貰ったが、そのとき主人の佐々木氏が岸田劉生の果物図の軸物を懸けてくれた。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "これこそ乃ちあの女が当夜鶴彌に毒を盛ったことを示唆している。",
              "citation": {
                "source": "地獄の使者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜鶴さんが保田からかえって来て、すっかり皮膚をやいて皮をはがしてかえって来ました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　西岡邦之介は鉾田から小川に脱したが、九月七日雨に遭ひて夜鶴田の原に宿つた者は六十人に足らなかつた。",
              "citation": {
                "source": "天狗塚",
                "author": "横瀬夜雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜鶴屋南北の脚本集を読む。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
