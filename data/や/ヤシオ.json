          "literary": [
            {
              "text": "めざすは八塩の温泉を越えて秩父路へ、そして江戸へ、日輪のさしのぼる東へ、東へ。",
              "citation": {
                "source": "夜明けの辻",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セイゲン、ヤシオなど云う血紅色、紅褐色の春モミジはもとより、槭、楓、楢、欅、ソロなどの新芽は、とり／″＼に花より美しい。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此山の特産ではないけれども、赤城｜躑躅の俗称あるアカヤシオは、元は古木が多く、花時には頗る美観を呈したものであるが、濫りに伐採した結果今は岩崖などの到り易からぬ所に残存するのみで、昔の面影は失われてしまった。",
              "citation": {
                "source": "那須、尾瀬、赤城、志賀高原",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これと関東の山々で野州花、またはヤシオというものと、色は同じだが形だけに違いがある。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
