        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "吉田は蜜柑を手に持ちポケットにも入れ、「みんなボヤーツと見とつちや駄目やないか」と生徒等に叱言を言ひながら、又登つて來た。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉は三重子を抱き寄せようとすると、三重子は姉の胸を押しながら背を曲げて、「ヤーツ、ヤーツ」と声を立てた。",
              "citation": {
                "source": "悲しめる顔",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦車の轟音のなかから突然、キヤーツと叫ぶ婦人の声をきいた僕は、まるで腸に針を突刺されたやうな感覚をおぼえた。",
              "citation": {
                "source": "戦争について",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、二匹はお客さまの顔を見ると、「いらつしやいませ」とも云はず「キヤーツ」と声を出してお部屋へにげてかへりました。",
              "citation": {
                "source": "お猫さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると山の中から五疋も十疋も、親猿小猿が、キヤーツ！",
              "citation": {
                "source": "山さち川さち",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく霧の様な、なんかボヤーツとした雰囲気が立ちこめてゐるだけで、そん中から誰か好きな人間を捜さうと思つても見付かりやしないよ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "留吉　（出しぬけにギヤーツと言う様な叫声を上げて、手足をもがいて跳ね起きる）な、な、何をするんだ！",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれ、鞄を縁の下へでも放り込んどいて、ひとつ、鴨子嬢のところへ遊びに行つて来よう。",
              "citation": {
                "source": "世帯休業",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩人　　あ、鴨子嬢だ。",
              "citation": {
                "source": "世帯休業",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻　　（夫の方に行き）ねえ、貴方、お聞きになつて……鴨子さんのお話。",
              "citation": {
                "source": "世帯休業",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴨子さん」で、遂に綿のはみ出したかけ蒲団が麻雀卓のそばへころがり落ちて来る。",
              "citation": {
                "source": "世帯休業",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴨子さん、あなたも何か仰つしやい。",
              "citation": {
                "source": "世帯休業",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴨子　　あら、本当ですの。",
              "citation": {
                "source": "世帯休業",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴨子　　あたしの差上げた栞だけ、お持ちになつてね。",
              "citation": {
                "source": "世帯休業",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩人は玄関の方に去る）鴨子　　本当に引越すの、あの方。",
              "citation": {
                "source": "世帯休業",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴨子　　あたしなんだか、気の毒になつて来たわ。",
              "citation": {
                "source": "世帯休業",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥羽、茶木、鴨子何れも唖然としてこの話を聞いてゐる。",
              "citation": {
                "source": "世帯休業",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
