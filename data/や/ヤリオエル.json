        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "週末までに終わらせる予定だった膨大な資料の整理をようやくやり終え、彼は深い安堵のため息をついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "どんなに困難な課題であっても、最後まで責任を持ってやり終えることがプロフェッショナルとしての矜持だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は十年という歳月を費やして研究し続けてきた論文を、ついに今日、全てやり終えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "仕事をやり終えると急いで逃げて、玄関は共犯者に内側から閂をかけてもらった、というわけです。",
              "citation": {
                "source": "患者兼同居人",
                "author": "THE RESIDENT PATIENT",
                "note": "青空文庫"
              }
            },
            {
              "text": "」だんなさんも、ぜひにということで、その夜、仕事をやり終えると、裁ち切った皮のかわりに、心づくしのおくりものを、つくえにそろえておいて、小人たちがどうふるまうのか、見とどけることにしました。",
              "citation": {
                "source": "小人のくつ屋さん",
                "author": "グリム兄弟",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親はただ二、三杯のバケツの水を使うことだけでその掃除をやり終えることができた。",
              "citation": {
                "source": "変身",
                "author": "DIE VERWANDLUNG",
                "note": "青空文庫"
              }
            },
            {
              "text": "回転をやり終えると、すぐにまっすぐにはいもどり始めた。",
              "citation": {
                "source": "変身",
                "author": "DIE VERWANDLUNG",
                "note": "青空文庫"
              }
            },
            {
              "text": "手にとってやりおえるまでの時間は、あらゆる縮約形を用いたとして……少なくとも一五分。",
              "citation": {
                "source": "三枚の学生",
                "author": "THE ADVENTURE OF THE THREE STUDENTS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
