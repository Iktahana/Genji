      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "fresh made",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "パン屋さんから焼きたてのパンの甘い香りが漂ってきて、思わず立ち止まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "焼きたてのピザはチーズがとろけていて、熱々を食べるのが一番美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「わあ、このクッキー焼きたてだ！まだ温かくてサクサクしてるよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「源ちゃんにあげて下さいな、今夜焼きたてが食べさせたいことねエ、そら熱いですよ。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしお客よりさきに、茶店のおかみさんが、焼きたてのほかほかの大餡巻をつくってあらわれました。",
              "citation": {
                "source": "牛をつないだ椿の木",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "と見れば、豆板屋、金米糖、ぶっ切り飴もガラスの蓋の下にはいっており、その隣は鯛焼屋、尻尾まで餡がはいっている焼きたてで、新聞紙に包んでも持てぬくらい熱い。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂のテーブルに向い合った僅な時間のひまにも、この子はおぼつかないながら、ナイフとフオクとは確に自分の物として、焼きたてのパンや黄色いバタや塩っぱいオムレツの上にのぞんで、決して自分を取り乱さなかった。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "大神はそれを見すまして、ふいに、その野のまわりへぐるりと火をつけて、どんどんお焼きたてになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "命はそれをまにお受けになって、その野原の中へはいっておいでになりますと、国造は、ふいにその野へ火をつけて、どんどん四方から焼きたてました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "命はそれで、急いでお宝物の御剣を抜いて、あたりの草をどんどんおなぎ払いになり、今の火打でもって、その草へ向かい火をつけて、あべこべに向こうへ向かってお焼きたてになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂のテーブルに対ひ合つた僅な時間のひまにも、この子はおぼつかないながら、ナイフとフオクは確に自分の物として、焼きたてのパンや黄色いバタや塩つぱいオムレツの上にのぞんで、決して自分を取り乱さなかつた。",
              "citation": {
                "source": "白帝城",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかあかと燃える焚火の側で、焼きたての熱い蕎麦餅に大根おろしを添えて、皆なで一緒に食う事を楽みにした広い炉辺の方へ帰って行った。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときには、紙袋をもったとき、手にあったかさのつたわって来るほど焼きたてだった。",
              "citation": {
                "source": "菊人形",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "油だらけの新聞紙をほごすと、焼きたてのロースビーフが、碁盤のように転がり出た。",
              "citation": {
                "source": "放浪の宿",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とチチコフは、新らしく持ち出された焼きたてのに手をつけながら、言った。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そのかわり、焼きたてのパンに葱をつけて食べたいね。",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "小僧たちが部屋の掃除をしたり、椅子をならべたりしているだけで、中には寝呆け眼をして、焼きたてのケーキを盆にのせて運び出している者もあった。",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「跡が、まるで焼きたてのパン・ケーキみたいにつるつるしてますねえ。",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　上甲板に出ると、焼きたてのビスケットを私は両の袂にいっぱいもらった。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里では、朝々、近くのキャフェで三日月パンの焼きたてに、香ばしいコオフィを私は愉しみにしていたものである。",
              "citation": {
                "source": "朝御飯",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　上甲板に出ると、焼きたての、ビスケットを両の袂にいっぱいもらった。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこまで歩いたか知らないがとにかく暗に火が見へるおあつらへ向きに腹がへつてそこは支那料理店だつた焼きたての豚肉がいつぱい盛られて一皿八銭目の光る支那人のコツクに私は熱い思ひをしたぢつとふれあつてゐる腕に支那人のコツクは蛇を巻きつかせてヘツヘツ……長い髪を上へかき上げたら私の可愛い恋人であつた。",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　　　　　　　　二　焼きたてのパンの熱気と押し合う人いきれで、三方棚に囲まれたパン販売店の中はムンムンしている。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日の朝飯は何んだろう」「白い牛乳に、焼きたてのトーストパン、それに香りの高いコーヒーか」「何をくだらんことをいっているんだ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかほかの焼きたて……面白いじゃないか。",
              "citation": {
                "source": "悲しい誤解",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかほかの焼きたて、幸福そのものじゃないか。",
              "citation": {
                "source": "悲しい誤解",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その汁を焼きたての熱いパンへかけたのだ。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "私どもはそのまま飲んでも味が大層好いようですが兄は牛乳かあるいはクリームを加えて飲みます」大原「六日目は」お登和「ジャーマン・トーストと申して牛乳と玉子をよく溶き混ぜて塩とお砂糖を加えてそれへ焼きたてのパンを浸しておきますと十分間ほどで大きく膨れます。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを焼きたての熱いトースへかけて出します。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それへ玉子を一つ入れてよく掻き廻すと一層｜美味くなりますが焼きたてのトースを小さくちぎってその上へかけて朝の食事に致します。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方はツブだらけ、私のにはツブがなく、ひッぱればアメのようにのびる」「一方は焼きたてだからのびる。",
              "citation": {
                "source": "餅のタタリ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼きたてのアツイうちに、というような必然的な要求に応じているのかも知れん。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "道頓堀罷り通る",
                "note": "青空文庫"
              }
            },
            {
              "text": "煮たて、焼きたてが食べられるからである。",
              "citation": {
                "source": "鍋料理の話",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
