          "standard": [],
          "literary": [
            {
              "text": "家移り、北小路というところ、小さい教授連の家らしいもの多くあるところ、令嬢嫁し、博士全く独り、雇人と暮される由、或感動を与えられた。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから蒙古人は時々水草を逐うて家移りをします。",
              "citation": {
                "source": "元時代の蒙古人",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "是れで家移りをする。",
              "citation": {
                "source": "元時代の蒙古人",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "住み慣れた老屋と永別して、その上また住み慣れた故郷に遠く離れて、今食い繋ぎをしているよそ国に家移りするのである。",
              "citation": {
                "source": "故郷",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしどもはとうとう家移りのことを話した。",
              "citation": {
                "source": "故郷",
                "author": "魯迅",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
