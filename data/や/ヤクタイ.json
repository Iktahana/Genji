        "examples": {
          "standard": [
            {
              "text": "昔の火縄銃の時代には、薬袋に火薬を入れて持ち運んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "祭りの衣装には、小さな薬袋がいくつかぶら下がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "隠密行動のため、彼は薬袋に少量の火薬を忍ばせていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
