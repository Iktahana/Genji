[
  {
    "uuid": "187cf743-e44d-5255-92d9-1017d1939dd6",
    "entry": "藪鶯",
    "reading": {
      "primary": "やぶうぐいす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
