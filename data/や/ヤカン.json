[
  {
    "uuid": "2fd0ce6b-084d-5ca0-ba43-7180a2e8e05b",
    "entry": "夜間",
    "reading": {
      "primary": "やかん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
