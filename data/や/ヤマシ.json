[
  {
    "uuid": "f93dd6f4-216b-5a15-95f3-3c1fc7297436",
    "entry": "山師",
    "reading": {
      "primary": "やまし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
