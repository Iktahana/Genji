    "definitions": [
      {
        "index": 1,
        "gloss": "sewing needle",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "裁縫箱から細い縫い針を取り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "縫い針の扱いは、慣れるまで少し時間がかかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は新しいデザインの縫い針をコレクションしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "私もお母様のお忙がしさを見るにつけて、お手伝いをして差し上げたいのは山々でしたが、どうしたわけか同じ指を持ちながら、お母様のような縫い針やお洗濯が一つも出来ず、ただ、字を書く事と、お琴を弾くことが人並外れて好きなだけでした。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ませているようでもまだ十六の彼は、冗談半分にこうして障子の紙をやぶった時に、内からそれを見ていたお此は、これも冗談半分に、自分の持っている縫い針でその舌の先をちょいと突いた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "弁天娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから縫い針千本に瓢箪に水銀をいっぱい詰めたものを父親からもらい受けて、翌朝迎えにきたヘビの男に連れられてゆく。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "「つつがなく彼の地へ渡れるならば、この先へ魚かかるべし」　と、のたまいて、裳のすそのとじ糸に、縫い針を曲げて、食後のめし粒を餌にして……、と書いてある。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれが目的に應じて利用出來ぬのだ、分散所藏せられて、これを求むることは枯草の中で縫い針を探すよりも厄介なのだ。",
              "citation": {
                "source": "素人圖書館人の手記",
                "author": "金森徳次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでは縫い針も教えていて、お豊は毎日かよっていた筈だ。",
              "citation": {
                "source": "花も刀も",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……三度の食事｜拵えも、濯ぎ物も縫い針も、決して吉村の母の手は藉りなかったし、「いいから」と云われるのを押して、毎夜より女の肩腰を揉んだ。",
              "citation": {
                "source": "日本婦道記",
                "author": "萱笠",
                "note": "青空文庫"
              }
            },
            {
              "text": "お伽噺の「一寸法師」は縫い針を刀にして、お椀の舟に乗る。",
              "citation": {
                "source": "探偵小説の「謎」",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬいばり　はさみ　ゆびぬきで　てしごと　ちゃんと　できました。",
              "citation": {
                "source": "ねっこうまれのこびとたち",
                "author": "ETWAS VON DEN WURZELKINDERN",
                "note": "青空文庫"
              }
            },
            {
              "text": "まずどうするとお思いなさる、……後で聞くとこの蝋燭の絵は、その婦が、隙さえあれば、自分で剳青のように縫針で彫って、彩色をするんだそうで。",
              "citation": {
                "source": "菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お珊は既に、襟に秘し持った縫針で、裏を透して、左の手首の動脈を刺し貫いていたのである。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　縫針のさきでさえ、身のうち響きますわ。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "からだをくねらせて私の片頬へ縫針を突き刺した。",
              "citation": {
                "source": "玩具",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "縫針の針孔に糸はたやすく通ります。",
              "citation": {
                "source": "愛",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて皮削ぎ庖丁や縫針で、胼胝の出来た手で、鼓や太鼓の撥をもち、踊りも、梅にも春や藤娘、お座敷を間に合わせるくらいに仕込まれた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "園が何か深く考えこみながら、無意識にその辺にあった縫針でいたずらをしたものに違いない。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶えず顫へていそしめるお菊夫人の縫針の、人形ミシンのさざめごと。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "午餐過からおつぎは縫針へ絲を透して竿へ附けて與吉に持たせた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤尾の指は爪先の紅を抜け出でて縫針の尖がれるに終る。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｋはお嬢さんが学問以外に稽古している縫針だの琴だの活花だのを、まるで眼中に置いていないようでした。",
              "citation": {
                "source": "こころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日｜欝陶しい思いをして、縫針にばかり気をとられていた細君は、縁鼻へ出てこの蒼い空を見上げた。",
              "citation": {
                "source": "道草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに彼女は縫針の道を心得ていなかった。",
              "citation": {
                "source": "道草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "大まかな百姓仕事や、飯爨や、副食物の世話ぐらいは、どうにかこうにか人間並に出来るには出来たが、その外の読み書き算盤はもとより、縫針なんか一つも出来なかった。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "古風な中二階の危ふさ、欄干のそばに赤い果の萬年青を置いて、柳河のしをらしい縫針の娘が物指を頬にあてて考へてる。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "悟空の身が滅びた時には、天地を破る此如意棒も棄てられた縫針にならねばなりません――。",
              "citation": {
                "source": "闘戦勝仏",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうして私は始めて縫針をもつことを教へられた。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば人類が最初の火を自分たちの生活のなかにとらえて来たときのことについても、縫針というものを発明したきっかけなどについても、極めて活々とした人間の実験の精神・偉大な創意の導きとしての日常のささやかな思いつき、精神のこまやかな敏活さなどが、大切に評価されて描かれている。",
              "citation": {
                "source": "世代の価値",
                "author": "――世界と日本の文化史の知識――",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国の教師夫婦を雇い、夫は男子を集めて英語を授け、婦人は児女をあずかりて、英語の外にかねてまた縫針の芸を教えり。",
              "citation": {
                "source": "京都学校の記",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "このかみさんは旅の着物のほころびでも縫えと言って、紅白の糸をわざわざ亭主と二人して糸巻に巻いて、それに縫針を添えて岸本に餞別としたほど細く届いた上方風の婦人であった。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "半紙をめいめい一枚づつ出し合つて疊の上に積み重ね、一本の縫針に二三寸の絲を附け、針のさきを唇にくはへ、絲を烈しく引いて疊の上の紙にその針をつき立てる樣に打ちおろします。",
              "citation": {
                "source": "樹木とその葉",
                "author": "故郷の正月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
