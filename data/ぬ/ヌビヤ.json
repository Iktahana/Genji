          "literary": [
            {
              "text": "煙草ばかり吹かしている洪牙利人や、顔色の黒いヌビヤ人や、身長の高くない日本人や、喧嘩早い墨西哥の商人などが、黄金の威力に圧迫され、血眼になって歩いている。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニスのような皮膚をしたヌビヤ人、ターバンを巻いた亜剌比亜人。",
              "citation": {
                "source": "死の航海",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
