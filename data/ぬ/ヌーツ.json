          "literary": [
            {
              "text": "其時の幕間にいきなり小母さんの座つてゐる前にヌーツと立つた人があります。",
              "citation": {
                "source": "妾の会つた男の人人",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "さんざ悦惚とさせておいて、「さてそれに引代へまして、相手の次郎左衛門はと申しますと、とんと私のやうな顔で」　と、ヌーツと自分の菊石面を突出し、今度はギヨツと寒がらせたと云ふ。",
              "citation": {
                "source": "吉原百人斬",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「荒野の決闘」のヘンリー・フォンダが、床屋で香水をつけて来て、ヌーツと立つている――あれだな、ジョン・フォードのえらいのは。",
              "citation": {
                "source": "性格と表情",
                "author": "小津安二郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
