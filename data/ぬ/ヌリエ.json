    "definitions": [
      {
        "index": 1,
        "gloss": "picture for coloring in (colouring)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供の頃、休みの日はよく塗り絵をして遊んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "最近は大人向けの複雑な塗り絵も人気を集めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "塗り絵は、集中力を高める効果があると言われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "泥色をした浅草紙を型にたたきつけ布海苔で堅めた表面へ胡粉を塗り絵の具をつけた至って粗末な仮面である。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒塗り絵散らしの文机に向かわれて、燭台を引きよせ、何やら読書をしていらっしゃる。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽しい塗り絵がちょうどいい。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "正午まで塗り絵をすると、背中は痛くなり、指は固まりブラシを持てなくなった。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃幼稚園でぬり絵をやります、印刷した輪廓に色をぬるのですが、色感がよくて面白いので、かざったりしています、あの位の子の絵はなかなかおもしろい、小学へ入ると凡化します。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵画ではなく、ぬり絵だ。",
              "citation": {
                "source": "海の青と空の青",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "この塗絵帳のことは、かすかに、かすかに思い出せる。",
              "citation": {
                "source": "中條精一郎の「家信抄」まえがきおよび註",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
