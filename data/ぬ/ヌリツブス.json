  {
    "uuid": "9916a15b-f481-510a-94c0-493473f36589",
    "entry": "塗り潰す",
    "reading": {
      "primary": "ぬりつぶす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "五段-サ行",
      "inflections": null,
