[
  {
    "uuid": "1f769f68-fcad-5a38-b962-3db2b36408bd",
    "entry": "拭い",
    "reading": {
      "primary": "ぬぐい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
