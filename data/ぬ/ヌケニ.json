        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これを上氷瀬という、バロメートルを見ると、実に海抜二千三百｜米突、あまり高過ぎるから多分狂っているのであろう。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜二千四百五十米、寒暖計六十二度、ここで大宮口の旧道と、一つになるのだと強力はいう。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜二千尺、山峡を流るる川は、吹雪の唸りと声を合せて、泡を噛んでいた。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜二百メートルくらいの山脈をへだてて三里もさきの海浜を轟かす土用波の音が山を越えて響いてくるのである。",
              "citation": {
                "source": "夕凪と夕風",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜二千九百六十六｜米。",
              "citation": {
                "source": "八十八夜",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて只今のご論旨ではビジテリアンたるものすべからく無菌の水と岩石ぐらいを喰べて海抜二千尺以上ぐらいの高い処に生活すべしというのでありましたが、なるほど私共の中には一酸化炭素と水とから砂糖を合成する事をしきりに研究している人もあります。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は昨晩和歌の浦へ泊りましたが、和歌の浦へ行って見ると、さがり松だの権現様だの紀三井寺だのいろいろのものがありますが、その中に東洋第一海抜二百尺と書いたエレヴェーターが宿の裏から小高い石山の巓へ絶えず見物を上げたり下げたりしているのを見ました。",
              "citation": {
                "source": "現代日本の開化",
                "author": "――明治四十四年八月和歌山において述――",
                "note": "青空文庫"
              }
            },
            {
              "text": "水晶山すなわち黒岳は本コースの最高峰で海抜二九七八メートルです。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鷲羽岳は池のある海抜二九二四メートル二の岳で地図鷲羽岳は三俣蓮華岳といい、蓮華岳と書いてあるのが双六岳だそうです。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜二八〇〇メートルの高所に着のみ着のまま寝たのですが、合羽を大沢小屋に乾しておいて忘れ一層寒く、一晩中凄い月が黒部谷を照らして立山の上へ移るまで、殆んど寝ないで眺めていました。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜二千五百尺の地の如何に寒いかといふことは、是で想像し得るであらう。",
              "citation": {
                "source": "諏訪湖畔冬の生活",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜二千八百尺のところでも、おお自動車の便利さよで、こういう光景が展開される。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "町は海岸の停車場から五キロほど山道を曲りくねって登った所に嶮しい階段のように造られ、海抜二〇〇米の懸崖の上に家が家を負んぶしたような奇観を呈している。",
              "citation": {
                "source": "エトナ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シラクーザにもネアポリスの丘の上に大きな円形劇場が遺っているが、タオルミーナにも町の北東の高台（海抜二一三米）に見事な円形劇場が遺っている。",
              "citation": {
                "source": "エトナ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜二千九百尺、これからまだ登りになるんだ。",
              "citation": {
                "source": "村で一番の栗の木（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜二千尺の高地にあり、アプト式にて山を登る。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜二一〇〇｜米ぐらゐの地点にあるらしい。",
              "citation": {
                "source": "流浪の追憶",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "千町歩ちかい田地を持っている上に、山林や海抜二千｜米ほどの山岳までいくつとなく所有している。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その五　万引家族",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜二一〇〇｜米ぐらいの地点にあるらしい。",
              "citation": {
                "source": "流浪の追憶",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ見れば平地であるが、実は海抜二千メートル以上の高地である。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々は海抜二六〇〇メートル程の地点におり、試験採掘によって雪と氷の僅か三・六メートル下に土の層があることが判明した幾つかの箇所において、小型融氷装置を駆使して発破用の小穴をあけ、ダイナマイトで爆破した。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜二千八百三米の山巓に立ちて、かくまでに冴え渡った展望観を恣にすることは、登山の最大快事であるというてよい。",
              "citation": {
                "source": "大井川奥山の話",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "メキシコ王国の中心地はアナワクの高原で、海抜二千米位、首府メキシコのある谷は二千二百米に達する。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "日光は海抜二千フィート、中禅寺は四千フィート。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここは海抜二千フィート、湖の水は冷くて澄み、空気は清新で人を元気にする。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "エリコは地中海の水面より約一千百尺低く、これに対しエルサレムの神殿は海抜二千六百尺ぐらい、オリブ山は約二千八百尺ですから、相当の登りです。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、車室から降りたのは自分一人だつた彼に、海拔二千｜尺の峰に於けるプラツトフオームは、恰も雲の上に拵へた白き瑪瑙の棧敷であるが如く思はれたから、驛員に對する挨拶も、客が歡迎する主人に對して、感謝の意を表するが如きものであつた。",
              "citation": {
                "source": "魔法罎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
