        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "満員電車の中を、彼は器用に体を縫うようにして進んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "人ごみの中を縫うように歩き、目的地を目指した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は狭い道も車を巧みに縫うように運転していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
