    "definitions": [
      {
        "index": 1,
        "gloss": "premature joy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "宝くじに当たったとぬか喜びしたが、よく見たら番号が一つ違っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "まだ確定していないのに、合格したとぬか喜びするのはやめておこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "期待が大きかっただけに、ぬか喜びに終わった時の落胆は大きかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "葉子が来たならばと金の上にも心の上にもあてにしていたのがみごとにはずれてしまって、葉子が帰るにつけては、なけなしの所からまたまたなんとかしなければならないはめに立った木村は、二三日のうちに、ぬか喜びも一時の間で、孤独と冬とに囲まれなければならなかったのだ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸福――自分が夢想していた幸福がとうとう来たと誇りがに喜んだその喜びはさもしいぬか喜びに過ぎなかったらしい。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとうに人をぬか喜びさせるにもほどがあるじゃごわせんか。",
              "citation": {
                "source": "右門捕物帖",
                "author": "生首の進物",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえ、だんな、このとおりにわか天気じゃござんすが、きのうまでの梅雨で往来はまだぬかるみだから、ひとっ走りまたつじ駕籠でも仕立てますかね」　けれども、右門の行動のうちに、伝六のそのひとりよがりを、しだいしだいにぬか喜びとさせるがごとき節が見えだしましたものでしたから、少々不思議でありました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "青眉の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちぇッ、ぬか喜びさせるにもほどがあるじゃごわせんかッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒色のくちびる",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでしたら、あなたは本当に罪人ですとも」「あなたに善人とよばれるよりは、罪人とよばれることを喜びますよ」「あなたは私をぬか喜びさせ、期待にふるえる思いをさせて、ドン底へ突き落したのです。",
              "citation": {
                "source": "水鳥亭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は、はっきり決まらないうちに話して、ぬか喜びをさせるのもどうかと思って、ひかえていたんだが、私がかねて考えていたことが近く実現しそうになったのでね。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "警視庁をあげての、凶賊逮捕の喜びも、ぬか喜びに終わってしまいました。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただちょっとのあいだ、あいつにぬか喜びをさせてやるだけです」　明智はなんの頼むところあってか、自信に満ちた力強い口調で、こともなげに言い切るのであった。",
              "citation": {
                "source": "黒蜥蜴",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "天神様や観音様にお礼を申し上げたいところだが、あのお光の場合は、ぬかよろこびであったのだし、あんな事もあるのだから、やっと百五十一枚を書き上げたくらいで、気もいそいその馬鹿騒ぎは慎しまなければならぬ。",
              "citation": {
                "source": "鉄面皮",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
