    "definitions": [
      {
        "index": 1,
        "gloss": "to paint over heavily",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
