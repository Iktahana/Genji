          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の着物には、家紋の縫い紋が誇らしげに施されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "縫い紋は、伝統的な着物や羽織によく見られる装飾だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "紋付袴を仕立てる際、どの位置に縫い紋を入れるか相談した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」　うなるようにいって、背広の人に手をひかれながら、自動車からあらわれたのは、縫い紋の羽織にセルの袴といういでたちの、でっぷり肥った、背丈も人並以上の老人だった。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フリッツさん、今日はえらい大人しおまんな」と、白襟に裾模様のある縫い紋を着たおさく師匠が、舞台の金屏風の蔭から出て来てフリッツに云った。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "縫い上がって来たのを見ると、けばけばしい、小袖と、その上になる裃に袴は、おあつらえの浅黄繻子に金糸の縫い紋です。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "最上等の麻の着物と、縫紋の羽織と夏袴と、角帯、長襦袢、白足袋、全部そろえて下さいと願ったのだが、中畑さんも当惑の様子であった。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の客も、そのままではすまされなくなり、次に大竹が立って縫紋の夏羽織をふるい、半襦絆を振って、それから馬乗袴を脱いで、ふんどしをしていない事を暴露し、けれどもにこりともせず、袴をさかさにしてふるって、部屋の雰囲気が次第に殺気立って物凄くなって来た。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども流石に背中のリユツクサツクには、母の形見を縫ひ直して仕立てた縫紋の一重羽織と大島の袷、それから仙台平の袴を忍ばせてゐた。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と申しますのは、私の婆様は、それはそれは粋なお方で、ついに一度も縮緬の縫紋の御羽織をお離しになったことがございませんでした。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "縫紋の、ぞろりとした和服が、よく似合つて、望月圭介に似てゐた。",
              "citation": {
                "source": "校長三代",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子はそんな家へ来ると、貰われた猫のように温順しくなって、黒の地紋に白の縫紋のある羽織姿で末席にじっと坐っているのだったが、昔から、その作品を読んだり、東京でも、一度｜逢ったことのある青年が一人いたので、庸三は手持｜無沙汰ではなかった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "縫紋の羽織にごわごわした袴で、博士がやって来たのは、間もなくであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは真新しい黒羽二重で、しやれた縫紋の剣かたばみがしつとりと光つてゐました。",
              "citation": {
                "source": "質屋の通帳",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "サアそれはハッキリおぼえませんけども、神様の垂れ幕だの、半襟だの、袱紗だの、着物の裾模様だの、羽織の縫紋だのいろんなものがあったように思います。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "三越の番頭が見立ててくれた青い色の袷に縫紋、白の博多帯、黄色く光る袴、紫がかった羽織、白足袋にフェルト草履、上品な紺羅紗のマントに同じ色の白リボンの中折れという馬鹿馬鹿しくニヤケた服装が、不思議に似合って神妙な遊芸の若先生に見えた。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が、ふと鶴村の羽織を見るとそれには目立たぬやうな縫紋が施してあつた。",
              "citation": {
                "source": "眠い一日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "久江は小柄な女で、茶と黒の大名縞のお召に、くすんだ茄子紺の縫紋の羽織を着てゐた。",
              "citation": {
                "source": "夜福",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "御車は無紋の黒塗、海老染模様の厚毛布を掛けて、蹴込には緋の毛皮を敷き、五人の車夫は大縫紋の半被を着まして、前後に随いました。",
              "citation": {
                "source": "藁草履",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶縞のお召に羽織は黒の小紋錦紗に藍のぼかし糸をつかった縫紋の背が品よくみえたが、ふと、その紋が家の麻の葉ぐるまだと気付いて紀久子はこみあげてくる屈辱感からさっと顔色を変えた。",
              "citation": {
                "source": "父",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな時はきまって渋ごのみの縞ものに縫紋のある黒の羽織を重ねている。",
              "citation": {
                "source": "父",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "縫紋の羽織袴、ステッキついてね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃三十になるやならずの若い男が日本服袴の（羽織縫紋にきわまったり）流行があって、この間小山書店の若い男余りキチンと袴はいて、そのヒダのような形して玄関に立っているので、どこの何者かと、思わずキッとなって、あとで大笑いしてしまいました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "背中に大きい縫紋のついた羽織に、うしろ下りの袴姿で、弁当などつかっている。",
              "citation": {
                "source": "待呆け議会風景",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "縫紋の絽の羽織が上布の単衣の肩をすべっているのは、膝をくずしているからであろう。",
              "citation": {
                "source": "傷痕の背景",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "手入の届いた頭髪、口髭、ネクタイピン、勲章、胸のポケットから覗いてるハンカチ、折目の正しいズボン、とも糸の縫紋の羽織、軍服、絽の袴……そういうものの中にあって、彼の皺の多い古い合服が、変に目立っていた――それが、彼自身の意識にもうつって……。",
              "citation": {
                "source": "傷痕の背景",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "金紗の着物も縫紋の羽織も、もう何度か水をくぐったらしい萎びかたをしていたが、その粗末なみなりがしっくり身体につくほど、彼女は肥って世帯じみていた。",
              "citation": {
                "source": "道化役",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "明るい縞のお召の着物に縫紋の黒の一重羽織をつけてる後ろ姿は、肩が少しいかついが、立派な夫人姿だった。",
              "citation": {
                "source": "道化役",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "トキエは、世帯をもってから殆んどつけなかったはでな着物に、縫紋の羽織なんかひっかけて、にっこり笑ってはいって来ました。",
              "citation": {
                "source": "肉体",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "大島の着物に縫紋の羽織を重ねたじみな姿に、薄桃色の半襟がくっきりと目立っていた。",
              "citation": {
                "source": "非情の愛",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "真黒に染めた髪を小さく束ねて、縫紋の渋い色の羽織を着ていた。",
              "citation": {
                "source": "二つの途",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "背中一面に赤かなにかでとてつもない大きな縫紋をして、クルリと高座で後向きになったとたん、ドーッと受けさせる。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "豹、虎の革の半袴は捨てて、正式の折目袴に、白綾の小袖、金糸の縫紋、そして濃い紫地に桐もようの裃を着け、帯びた小さ刀も、提げた太刀も、華奢な風雅男のすがただった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
