        "examples": {
          "standard": [
            {
              "text": "子供の成長に合わせて、ズボンの裾の縫い揚げを伸ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "着物の縫い揚げは、体型に合わせて調整する重要な部分だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "スカートの丈を短くするために、大胆に縫い揚げをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ぬいあげを下ろしてあげます。",
              "citation": {
                "source": "病む子の祭",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そこで、仕立屋さんはおおいそぎで、帯を一本｜裁って、ぬいあげました。",
              "citation": {
                "source": "いさましい　ちびの仕立屋さん",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
