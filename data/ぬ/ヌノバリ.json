        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "豪華な布張りのソファがリビングに置かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この椅子の座面は布張りだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "布張りの壁は、部屋を暖かく見せる効果がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その上から紫｜扱帯の古ぼけたのが一すじ、グルグルと巻き付けてあるきりであったが、そのふくらんだ自分の胸に取り縋るように、両方の掌をシッカリと押し当てて、素足のまま寝床を降りると、スラスラと畳の上を渡って、芭蕉布張りの襖に手をかけた。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この部屋の隅には、この家を建てた者が、住むだら仏壇にでも仕様と思つたらしい左右に開く布張りの扉がついた袋戸棚のやうな場所があつた。",
              "citation": {
                "source": "村のストア派",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寸見ると青年団員か何かかと思われるカーキ色ずくめのその若い男は、汽車が古河という小さい駅に停った時、どうしたわけかグズグズに繩のゆるんだ白布張りの行李を自分でかついで乗り込んで来た。",
              "citation": {
                "source": "東京へ近づく一時間",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして事務室の隅から隅へずしずしと足早に歩き廻って、探るような眼つきで書類のはいった古戸棚や油布張りの椅子をじろじろ眺めたり、時には護送人の方をちらりと見たりする。",
              "citation": {
                "source": "紅い花",
                "author": "КРАСНЫЙ ЦВЕТОК",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから約束通り噴水の横でチイ嬢に会って、演芸館の裏で夜間出勤のサンドウィチマンを二人買収して、チイ嬢と二人で薄い布張りの四角い箱の中に這入って、入口の看守にテケツだけ見せて会場を抜け出しました。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒油布張りの扉を開けるなり入ったナースチャは、首をのばし、「ヘーイ、シューロチカ！",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "濃茶色の布張りのソファにかけて、瑛子はその時も上気して、肌理の濃やかさの一層匂うように美しい風で喋っていた。",
              "citation": {
                "source": "海流",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁ぎはに立てた大きな薬戸棚、油布張りの固い患者用の寝椅子、青いビロードのふつくり盛り上つた廻転椅子、縁枠を白く塗つた医療器具棚の中には真新しいメスや鋏、鉗子などがぴかぴか光つて、大事さうに並べてあつた。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらを布張りの洒落た菓子折の中へ入れておいた。",
              "citation": {
                "source": "菓子の譜",
                "author": "岩本素白",
                "note": "青空文庫"
              }
            },
            {
              "text": "布張りの小型なやつで、時にはペンで時には鉛筆で書いてある。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁は布張りで、特殊の加工がしてあるらしく、声は壁に吸い取られて反響がなかった。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "書斎の会話をすべて聞くためには、布張りの扉を開く必要があった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "そっと、布張りの観音扉を押し広げて、覗きこんだ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の毒な少女はグルグル廻転しながら、刻々加速度を加えて、まるで赤い棒の様になって、忽ち菊人形の天井の、青い布張りにぶつかり、砲弾の様にそれを打破ったかと思うと、パチャンと不気味な音が聞こえて来た。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "可笑しいことには、古来の屋根の一型式に従ってこけら葺の上に石ころを並べたのは案外平気でいるそのすぐ隣に、当世風のトタン葺や、油布張の屋根がべろべろに剥がれて醜骸を曝しているのであった。",
              "citation": {
                "source": "颱風雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "觀棚は内壁の布張汚れ裂けて、天井は鬱悒きまで低し。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのクリーム色に塗られた近代風のドアが開くと、その一間住宅であるアパートメントの瀟洒な布張のアーム・チェアに細君がかけて編物をしています。",
              "citation": {
                "source": "よろこびの挨拶",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどい一の衣類棚、机、赤い粗末な布張のソファー一つ、椅子二つ三つ。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝ナースチャが、彼の茶碗に茶を入れて運んで行くと、「バルザック」とレッテルの貼ってある白葡萄酒の瓶の横にそのコップがあって、オルロフ自身は山羊髯をなで、布張の椅子にいる。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そろそろやけて来たらしいね」「……もうすこうしね」「そっちの、こげやしないか」「そうかしら」　実験用テーブルの端へもたれのある布張椅子をひきよせて、いものやけるのをのぞいているのは、重吉であった。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きい三つの窓に、極く薄い肉桂色の窓帷が、黒い鮮やかな飾紐で片よせられ、簡素な形のマホガニーの円卓子、布張の椅子、たっぷり薔薇を盛った花壺等が置かれている。",
              "citation": {
                "source": "火のついた踵",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソヴェト市民が、その中へパンでも修繕にやる靴でも入れて歩いているところの茶色布張の小鞄一つが彼女の荷物だ。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "室内にはやや色のさめた更紗張の椅子、同じ布張のテーブルがおいてある。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからは当分、この連続的に退屈な低音階と、ぺいんとの香と、飛魚と布張椅子と、雲の峰だけの世界である。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
