        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日本の伝統的な塗り物は、海外の観光客にも人気が高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "祖母は、特別な日にしか使わない美しい蒔絵の塗り物を持っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "漆の塗り物は、使い込むほどに味わいが増していくのが魅力だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "したがって、それに附属する塗り物、金具類に至っても上等なものを使うこと故、その方へも自然私の目が行き届く。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "年季あけ前後のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "朱雀院のは塗り物でない浅香の懸盤の上で、鉢へ御飯を盛る仏家の式のものであった。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（上）",
                "note": "青空文庫"
              }
            },
            {
              "text": "四尺許りの長提灯を貫いて、殆ど其三倍の長さの塗り物の竿が通つてゐて、其頭には鳥毛の代りに馬の尾か何かの白い毛を垂した、其上へ更に千成瓢箪・奔馬などの形の附いてゐるものである。",
              "citation": {
                "source": "髯籠の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ええお人形さんどっすやろ」　私は「うう」と、ただ答えたが、その人形や塗り物の菓子器の彼方にいろいろな男の影が見えるような気がした。",
              "citation": {
                "source": "黒髪",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、まれびとを迎ふるあるじの苦勞の幾代の印象が、かうした傳説となつたので、椀貸し塚から出した木具が皆塗り物であつた點が、とりわけ朱器・臺盤との脈絡を思はせるものがある。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "食べ物でなくっても、きれ類とか塗り物とか、すべてほこりがおいては一そう困るようなものは先にかたづけること。",
              "citation": {
                "source": "女中訓",
                "author": "羽仁もと子",
                "note": "青空文庫"
              }
            },
            {
              "text": "檜木笠、めんぱ（木製｜割籠）、お六櫛、諸種の塗り物――村民がこの森林に仰いでいる生活の資本もかなり多い。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "耕地も少なく、農業も難渋で、そうかと言って塗り物渡世の材料も手に入れがたいところでは、「御免の檜物」と称えて、毎年千数百｜駄ずつの檜木を申し受けている村もある。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それを一層暗い燭台に改めて、その穂のゆら／＼とまたゝく蔭にある膳や椀を視詰めていると、それらの塗り物の沼のような深さと厚みとを持ったつやが、全く今までとは違った魅力を帯び出して来るのを発見する。",
              "citation": {
                "source": "陰翳礼讃",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人サバルワル君の話に、印度では現在でも食器に陶器を使うことを卑しみ、多くは塗り物を用いると云う。",
              "citation": {
                "source": "陰翳礼讃",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吸い物椀に今も塗り物が用いられるのは全く理由のあることであって、陶器の容れ物ではあゝは行かない。",
              "citation": {
                "source": "陰翳礼讃",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがその羊羹の色あいも、あれを塗り物の菓子器に入れて、肌の色が辛うじて見分けられる暗がりへ沈めると、ひとしお瞑想的になる。",
              "citation": {
                "source": "陰翳礼讃",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人は近頃「酒は塗り物に限る」と云い出して、その杯も朱塗りに東海道五十三次の蒔絵のある三つ組のうちの一つであった。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "みれば左の手に瓢箪を持ち右の手にちいさな塗り物の盃を持ってわたしに突きつけているのである。",
              "citation": {
                "source": "蘆刈",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が買い物をした他の店をヒダの名折れであるとか、その店のためにヒダの塗り物全体が汚名を蒙ってしまうというような聞くにたえぬ悪罵を、私がそれに耳を傾けるフリをすれば恐らく半日は喋りまくるかも知れない。",
              "citation": {
                "source": "飛騨の顔",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "気取った塗り物の円卓を中にはさんで、座につくと、やがて運ばれるお茶、お菓子、そして、お酒。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三「今に最う一人此処へ来て寝るさうぢやが、お前様と同国ぢやの、若狭の者で塗物の旅商人。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時の駒の女の一人が今ブヱイの通りの塗物屋の女房に片づいて黒くなつて働いてゐる。",
              "citation": {
                "source": "雪",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに、梓は旧仙台の生で、土地の塗物師の子であったが、豊なる家計の下に育ったものではなかった。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、お肴には何がある、錦手の鉢と、塗物の食籠に、綺麗に飾って、水天宮前の小饅頭と、蠣殻町の煎豌豆、先生を困らせると昼間いったその日の土産はこれで。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三「今にもう一人ここへ来て寝るそうじゃが、お前様と同国じゃの、若狭の者で塗物の旅商人。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子は桑と塗物の二つか三つある中から、かなり上等な桑の鏡台を買ったが、そこの紹介で大通りの店で箪笥も一棹買った。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十五歳の姉｜安は四年前に阿部家を辞して、横山町の塗物問屋長尾宗右衛門に嫁していた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "五百の姉安を娶った長尾宗右衛門は、兄の歿した跡を襲いでから、終日｜手杯を釈かず、塗物問屋の帳場は番頭に任せて顧みなかった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "次で十一月十五日の火災に、横山町の店も本町の宅も皆焼けたので、塗物問屋の業はここに廃絶した。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "渋江抽斎の妻五百の姉夫塗物｜問屋会津屋宗右衛門方の通番頭は首席を庄太郎と云つて、年給四十両であつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国へ此方の塗物を売込む会社。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「冗談にも程がある、第一縁儀が悪いよ、塗物に顔を写すと気狂ひになるツ！",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄の病気の為によくないから、と云つて母は家中の鏡と顔の写る塗物類などを秘して仕舞つた、彼の凸面鏡もその一つとして選ばれた時、彼は妙な寂しさを感じて、「阿母さん、そんなことは迷信ですよ。",
              "citation": {
                "source": "凸面鏡",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜻蛉の翼は銀色に輝き、胴体は精巧な塗物のやうにピカピカと光つてゐた。",
              "citation": {
                "source": "四郎と口笛",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
