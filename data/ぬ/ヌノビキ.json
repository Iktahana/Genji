[
  {
    "uuid": "3a98e676-0616-5775-a7d7-5de325a73169",
    "entry": "布引き",
    "reading": {
      "primary": "ぬのびき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
