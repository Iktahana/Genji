        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もう間もなく入用になる子供の袷の縫い掛けてあるのも縫わなくてはならない。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この御天気にそんな厚いものを着て出るなんて」「何、日が暮れたら寒いだろうと思って」と小六は云訳を半分しながら、嫂の後に跟いて、茶の間へ通ったが、縫い掛けてある着物へ眼を着けて、「相変らず精が出ますね」と云ったなり、長火鉢の前へ胡坐をかいた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　兄さんはそう言って屈託なく笑って帰りましたけれど、私は勝手口に立ったままぼんやり見送り、それからお部屋へ引返して、母の物問いたげな顔にも気づかぬふりして、静かに坐り、縫いかけの袖を二針三針すすめました。",
              "citation": {
                "source": "誰も知らぬ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、また縫いかけの仕事を始めた。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻は枕元の火鉢の傍で縫いかけの子供の春着を膝へのせたまま、向うの唐紙の更紗模様をボンヤリ見詰めて何か考えていたが、思い出したように、針を動かし始める。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子はこのごろの貞世はほんとうに変だと思いながら、愛子の縫いかけの布を取り上げて見た。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……またゆっくりね……あ、愛さん、あなたお二階に行って縫いかけを大急ぎで仕上げて置いてちょうだい、ねえさんがあらかたしてしまってあるけれども……」　そういって先刻から逐一｜二人の争論をきいていたらしい愛子を階上に追い上げた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま縫いかけている春着はあしたでなければ仕立てあがらないから、どうかあさってに延ばしてもらいたいと言った。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこいらには、針仕事の好きな姑が孫娘のために縫いかけた長襦袢のきれなぞも取りちらしてあって、そこにもお粂が結婚の日取りの近づいたことを語っている。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "お民を前に置いて、おまんは縫いかけた長襦袢のきれを取り上げながら、また話しつづけた。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしたちの風呂敷包みには、汚れたシュミイズに、手製のパン、縫いかけのブラウス、読みかけの汚れた小説本か雑誌しかはいつていない。",
              "citation": {
                "source": "淪落",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　こう鈴江はいって来たが、膝の上へ置いていた縫いかけの袖を、しずかに取り上げると畳の上へ敷いて、縫い目を爪先でこするようにした。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "麻痺した心の臓のところに、縫いかけた晴れ着をしっかり抱き締めたりしてな。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "前夜、久しぶりで晴ればれした顔で牀の上に起きなおって、「もう、大ぶんに快いから、きょうは一枚縫い上げるよ」　と、きかぬ気をみせて、絽縮緬の座敷着を手にとっていたが、片袖を縫いかけて、針をおいた。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばらさんというのは男の子よ、お恭ちゃんが桃色の布、水色の布でおくりものを縫いかけて居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "野上さん来、鼓の袋を縫いかけ、エンジ色に黒と白で海棠か何かの模様があるのをいじって居られた。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "針箱や縫いかけを入れた風呂敷づつみなど、お針子の誰かによってちゃんと座布団の前に揃えられていた。",
              "citation": {
                "source": "縫子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "出征の人で電車がこんでこんで……」　事務員らしいてきぱきさで、小枝子はすぐ仕事机の隅の風呂敷包みをひろげ、三尺の押入れを衣裳箪笥まがいにしたところに吊ってある縫いかけのスーツの上着を出した。",
              "citation": {
                "source": "二人いるとき",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "亀田の細君の膝の上では、縫いかけの婦人帽の蕊がいじられていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "縫いかけのワイシャツの片そでがぶら下がっている。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前には縫いかけの何かの布が放り出されていた。",
              "citation": {
                "source": "囚われ",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "室の隅には、赤ん坊の小さな着物が、縫いかけのまま放り出されていた。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "おきくさんはほんとにかはいらしい人、私はつく／″＼思った……縫いかけの単衣を頭からかぶってねむってるおきくさんの側でお伽噺の本を読みながらつく／″＼思った。",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "或時｜紺飛白の筒袖の著物の縫いかけが、お嫂様のお部屋にあったのを見かけました。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝台のそばに立っている抽斗戸棚の上には絹の古いハンカチーフがあって、その綻びを縫いかけの針が残っていた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "貸家",
                "note": "青空文庫"
              }
            },
            {
              "text": "品子は二三度、「リリー」と呼んでみたけれども、彼女の方へはチラリとそっけない流眄を与えたきりで、先ず出入口と押入の閾際へ行って匂を嗅いで見、次ぎには窓の所へ行ってガラス障子を一枚ずつ嗅いで見、針箱、座布団、物差、縫いかけの衣類など、その辺にあるものを一々丹念に嗅いで廻った。",
              "citation": {
                "source": "猫と庄造と二人のおんな",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕餉のあと始末を終って、縫いかけた母の肌着をひろげたとき、あたりを憚るように宇之吉が訪ねて来た。",
              "citation": {
                "source": "追いついた夢",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日まえの夜、おひさが縫いかけの袷を持って来て、ひとところどうしてもうまくいかないからと、母の手を借りていた。",
              "citation": {
                "source": "落葉の隣り",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さえの母親が茶と菓子を運んで来て、先月むすめの招かれた礼を述べて去ると、間もなくさえが縫いかけの着物を持って上って来た。",
              "citation": {
                "source": "彩虹",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし眠れそうでもないし、ことによると良人が帰るかもしれないと思い、居間へ戻って火をかき起し、茶を濃く淹れて、縫いかけの物をとり出して坐った。",
              "citation": {
                "source": "めおと蝶",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
