        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "火山の変形　昨年四月イタリアのヴェスヴィアス山がやや烈しい噴火をやったが、その後同国陸軍地理局で測量を行った結果によると、噴火前における最高点の高さ海抜千三百三十五メートルあったのが千二百二十三メートルに減じている。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "御坂峠、海抜千三百｜米。",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三ツ峠、海抜千七百米。",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜千三百｜呎、シトロンやたこの木に取囲まれた山頂の空地である。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一九二六・九）兵庫立山登山　私は兵庫県と鳥取及び岡山県界の山脈を兵庫アルプスといい、海抜千五百メートル一の氷ノ山を兵庫槍、三室山を兵庫乗鞍、一番南の一三四四メートル六の山を兵庫御嶽と呼んでいます。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しここは既に海抜千メートル以上の高地で、高千穂河原という。",
              "citation": {
                "source": "高千穂に思う",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜千四百メートルの御鉢火口である。",
              "citation": {
                "source": "高千穂に思う",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜千五百七十四メートルは山としてはさほど高くはない。",
              "citation": {
                "source": "高千穂に思う",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、海抜千メートル以上のアンデス山脈をこえ、昼なお暗い深林を通り、パタゴニアの荒漠たる草原を横断せねばならない。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔は樹木ありしと云ふも、今は赭禿の山海抜千六七百尺に過ぎず。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "事件そのものが甚だ意外であつたばかりでなく、事件の原因をなしたところのものが実に奇想天外――いや、これも亦凡太の意識内に於ける不屈な好奇心の説明であるが、とにかく奇抜千万であつたために、凡太はひどく奇異を感じた。",
              "citation": {
                "source": "黒谷村",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜千百｜米、戸数十五戸の山腹の密林にある小部落で、鉱泉宿が一軒ある。",
              "citation": {
                "source": "ラムネ氏のこと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯のある所は海抜千七百米に近い。",
              "citation": {
                "source": "黒部峡谷",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "菅沼は上野国利根郡片品村大字東小川村の地内にある山湖にして、湖面は海抜千七百十九米の高さを有す。",
              "citation": {
                "source": "古図の信じ得可き程度",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "白馬尻は海抜千五百七十二米約五千二百尺であるから、四ツ家より高きこと二千八百七十尺余り、距離は直径にして二里半に六町ほど足りない。",
              "citation": {
                "source": "白馬岳",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "温泉の在る所は海抜千四百六十米を超えている。",
              "citation": {
                "source": "秩父宮殿下に侍して槍ヶ岳へ",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾瀬沼は海抜千六百六十五米、日光の中禅寺湖よりも四百米近く高いが大さは約五分の一で、深さは三十分の一に過ぎない六米弱である。",
              "citation": {
                "source": "那須、尾瀬、赤城、志賀高原",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その屋敷野（海抜千余メートル）からは、実に御岳東面（この山の表側と見なされる）のほとんど全貌が仰がれ、南は三笠山から北は継子岳にわたり、蜿蜒一連の山脈の勢いをなしている。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
