[
  {
    "uuid": "c5be84c7-86b7-5f2c-9dbd-f799bb63ae71",
    "entry": "ぬるま湯",
    "reading": {
      "primary": "ぬるまゆ",
      "alternatives": [
        "びおんとう",
        "ぬるゆ"
      ],
      "is_heteronym": true
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "tepid water",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ぬるま湯に浸かって、今日の疲れをゆっくりと癒やした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "赤ちゃんをお風呂に入れるときは、ぬるま湯がちょうどいい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "コーヒーが冷めてぬるま湯になってしまったので、電子レンジで温め直した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "黒塀の、溝端の茣蓙へ、然も疲れたやうに、ほつと、くの字に膝をついて、婦連がいたはつて汲んで出した、ぬるま湯で、輕く胸をさすつた。",
              "citation": {
                "source": "露宿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると僕の母はそれを見て、そっとその掻餅を箸で摘み取り、ぬるま湯で洗って、改めて生醤油をつけて、僕に与えました。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、曇り日の夜明の色とぬるま湯の感触とを帯びて、拡がり拡がり、私の世界を包んでしまう。",
              "citation": {
                "source": "情意の干満",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら、このぬるま湯の温気が常に悪くばかり役立っているとは思えない。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "医局から貰って来た硼酸水を小さな罨法鍋に移し、火をかけてぬるま湯にすると、それをガーゼに浸して眼球の上に載せて置くのである。",
              "citation": {
                "source": "眼帯記",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして度重るにつれて、私の心は、ぬるま湯にでもつかるように、彼女に囚われていきました。",
              "citation": {
                "source": "肉体",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く、ぬるま湯でした。",
              "citation": {
                "source": "肉体",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬缶に湯を沸かし、洗面器でぬるま湯にして、運んで来た。",
              "citation": {
                "source": "擬体",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ぬるま湯のような静かな時間がたった。",
              "citation": {
                "source": "波多野邸",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "底知れぬぬるま湯の深淵、だが何の奇異も生気もない深淵、ただなま温いだけで、眠れ眠れとすべてのものを誘う盲目の淵、その中におれはもぐり込んだ。",
              "citation": {
                "source": "朝やけ",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きるためにはぬるま湯に限るものだ。",
              "citation": {
                "source": "中庸",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "万年筆は、ぬるま湯で時々掃除することです。",
              "citation": {
                "source": "鉛筆のしん",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "決して急にあひたくて耐らなくなるといふ強烈さはなかつたが、ひとりでにからだの温まるやうなところが、苦勞したらしい彼女から、ぬるま湯に長くつかつて心からあつためられるといふ感じがするのであつた。",
              "citation": {
                "source": "蒼白き巣窟",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるでぬるま湯にひたっているようなもので、しじゅう風邪をひきそうな気持でいますからね。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分はぬるま湯にひたっているようなもので、飛び出せばなお寒い、と歎いた教育家の言葉。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "この自覚を持ち、この喜びをもって教育にあたっている人なら、忘れても自分をぬるま湯にはいっているようなものだとは言わぬはずです。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてロシア人の目に赤い光が満ち、耳に海鳴りが響き、忘却のぬるま湯に落ちて行った。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "この快感はあたかも明るい湯槽の中で、肌はこころよいぬるま湯に漬かっているのに似ている。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「騒ぐな」と喜兵衛は眼をつむったまま云った、「薬はいらない、ぬるま湯に塩を入れて来てくれ、おしのを起こすな」　喀血は初めてではないが、そんなに多量に吐いたことはなかった。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "声が出ないので、徳次郎に眼で頷き、茶の間へいって塩のぬるま湯を作った。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "喉の力がなくなっているので、渇きを訴えるときは、綿にぬるま湯を含ませて、そっと吸わせるほかはなかった。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はすぐに家に帰り暗い部屋に閉じこもり１日中そこに居て時々ぬるま湯で洗う。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども私がぬるま湯がすきですから、たのしかったのですわ」「あそこの泉質は何ですか」「存じませんけど、白く濁っているのです」　私も毎日はいっているが、実は何泉だか、知らないのである。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は片膝を立て、手拭をぬるま湯に浸しては、そろそろと躯をしめした。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが証人が断言するところによると、病人の細君は時々費用を倹約するために（まったく病人は本当の灌腸をうけたつもりで払っていたのである）、ただのぬるま湯でやらせて見たが、そういうごまかしはすぐにばれ、結局それでは駄目だということになって、やっぱり始めのやり方に戻ったそうだ。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして死を瞑想する暇をもつために、彼はあらゆる食物を絶った後、三日目にその身にぬるま湯をそそがせ、少しずつ失神状態に入った。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "七時起き、新長崎ホテルのバスは、熱い湯が出ないので、くさってぬるま湯でヒゲを剃り、グリルで朝食、八時二十分の汽車で佐世保へ向ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "comfortable",
        "register": "standard",
