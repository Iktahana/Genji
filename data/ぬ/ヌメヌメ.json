[
  {
    "uuid": "23499c99-e09f-5281-be44-f0d3c89458e3",
    "entry": "滑々",
    "reading": {
      "primary": "ぬめぬめ",
      "alternatives": [
        "ヌメヌメ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "副詞-と",
        "動詞-サ変"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "wet and glistening",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長く放置された風呂場は、床がぬめぬめしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "深海魚は、体がぬめぬめして捕まえにくい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "湿気の多い場所では、壁がぬめぬめとしてカビが生えやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その真赤な宝石の色の鮮かさは、真白い滑々の象牙の中に埋まって不気味な迄に生き／＼として――何故かそんな感じがしました――燦っているのでした。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "加之肌が眞ツ白で滑々してゐる。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "その蝋燭が滑々と手に触る、……扱帯の下に五六本、襟の裏にも、乳の下にも、幾本となく忍ばしてあるので、ぎょっとしました。",
              "citation": {
                "source": "菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（柿があるか、剥けやい、）と涎で滑々した口を切って、絹も膚にくい込もう、長い間枕した、妾の膝で、真赤な目を※くと、手代をじろり、さも軽蔑したように見て、（何しとる？",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの龍のような不格好な老樹が、もし滑々した肌をもっていたら、それはとても見られたものではないでしょう。",
              "citation": {
                "source": "季節の植物帳",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い頬が、滑々と寄つた時、嘴が触れたのであらう、……沢は見る／＼鼻のあたりから、あの女の乳房を開く、鍵のやうな、鸚鵡の嘴に変つて行く美女の顔を見ながら、甘さ、得も言はれぬ其の餅を含んだ、心消々と成る。",
              "citation": {
                "source": "貴婦人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "青黒く、滑々とした背膚の濡色に、星の影のチラ／＼と映す状は、大鯰が藻の花を刺青したやうである。",
              "citation": {
                "source": "妖魔の辻占",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして滑々した樹の肌をひとしきり手で撫でまわした後、私はそっと自分の背を幹にもたせかけた。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "所で、その鉢というのが、相当目方のある上に滑々していて扱い悪い代物と来ている。",
              "citation": {
                "source": "赤い手",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　侍医は怯々もので言つて、円い滑々した頭を下げた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは漆喰で固めてあるらしく、滑々した表面を持っていたが、果然指先に、壁の面から飛びだした固いものを探りあてた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごく軽くて、滑々して、いい手触りだ。",
              "citation": {
                "source": "ピストルの蠱惑",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "小函に鉋を嵌めてゴリ／＼とかくのは、普通の鰹節削りと違つてゐないけれど、其の函は滑々した桑の木で小形に造られ、四隅に銀金具が光つてゐた。",
              "citation": {
                "source": "太政官",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、その感じから暗澹たる色彩を奪ったのは、ほとんど美しいとでも形容したい、光滑々たる先生の禿げ頭で、これまた後頭部のあたりに、種々たる胡麻塩の髪の毛が、わずかに残喘を保っていたが、大部分は博物の教科書に画が出ている駝鳥の卵なるものと相違はない。",
              "citation": {
                "source": "毛利先生",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "青黒い滑々したあの長細い体が、生き縄の様に眼の前に伸びたり縮んだりするのは、見て居て気もちの好いものではない。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "硝子を透いて明かにそれが見えてるので、愛ちやんは一｜心に洋卓の一｜脚に攀登らうとしましたが滑々してゝ駄目でした。",
              "citation": {
                "source": "愛ちやんの夢物語",
                "author": "ALICE'S ADVENTURES IN WONDERLAND.",
                "note": "青空文庫"
              }
            },
            {
              "text": "周囲は高くて滑々で登る事の出来ない塀にとりかこまれて、塀の上には盗難よけの釘が列をつくっている。",
              "citation": {
                "source": "秘密の庭",
                "author": "THE SECRET GARDEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳の下まで長々と生え下っている揉み上げの代りにそこには滑々した青年らしい美しい皮膚が現れ出た。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ黄色な菓子でも飴のやうに滑つこいのはぬめぬめした油絵や水で洗ひあげたやうな水彩画と同様に近代人の繊細な感覚に快い反応を起しうる事は到底不可能である。",
              "citation": {
                "source": "桐の花とカステラ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは白いぬめぬめするかがやきを持った眼であった。",
              "citation": {
                "source": "蛇性の婬",
                "author": "雷峯怪蹟",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは白いぬめぬめする輝きを持った眼であった。",
              "citation": {
                "source": "雷峯塔物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃はどういうものか、ものを言うにさえ、唾がねばって、舌がぬめぬめして心地の悪さといったらなかったんですが、まあ、体が半分水になって、それが解けて行くようで、月の雫で洗ったようです。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしのあをじろむ指のさきからにげてゆく月夜の雨、毛ばだつた秋の果物のやうなふといぬめぬめとした頸をねぢらせ、なまめく頸をねぢらせ、秋のこゑをつぶやき、秋のつめたさをおさへつける。",
              "citation": {
                "source": "藍色の蟇",
                "author": "大手拓次",
                "note": "青空文庫"
              }
            },
            {
              "text": "河のようにぬめぬめした海の向うには、柔かい島があった。",
              "citation": {
                "source": "風琴と魚の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る川底では、水流が二つになつてゐたり、ぬめぬめした藻が、晝の陽を寫して、みどりの水面に白い影を寫してゐたりした。",
              "citation": {
                "source": "多摩川",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "このぬめぬめの粘液体が厚くじゅんさいの新芽に付着しているために、じゅんさいは美食としての価値がある。",
              "citation": {
                "source": "洛北深泥池の蓴菜",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "編下が蛇のようにぬめぬめする。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かぬめぬめした巨体が、ドアにぶつかっているような音だ。",
              "citation": {
                "source": "ダゴン",
                "author": "DAGON",
                "note": "青空文庫"
              }
            },
            {
              "text": "不気味にもぬめぬめとした物質からなる広大な平面が彼の上下から迫り、互いに接近して――一瞬の譫妄状態と未知の光とともに終結した。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "くちびるとくちびるとがぬめぬめと交錯した。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
