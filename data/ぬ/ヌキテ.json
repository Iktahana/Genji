    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "前後の分別に遑無く、用人の素頭、抜手も見せず、ころりと落しぬ。",
              "citation": {
                "source": "妖怪年代記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇み立って列の中で抜手を切る生徒があると貝原が大声で怒鳴った。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「くたびれるから抜手を切っちゃいかん」　河口西側の蘆洲をかすめて靄の隙から市の汚水処分場が見え出した。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に滝太郎の姿も水に沈んだが、たちまち水烟を立てて抜手を切ったのである。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "抜手を切って行く若者の頭も段々小さくなりまして、妹との距たりが見る見る近よって行きました。",
              "citation": {
                "source": "溺れかけた兄妹",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互いの顔を見合う日は最も気分のいい日で、私は病児の髪の伸びたのも苦にするほど何か楽しい母ごころに、不幸な濁流に抜手をきっているような、さなかの逼苦も柔らげられるのであった。",
              "citation": {
                "source": "窓",
                "author": "鷹野つぎ",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は浅い水を頭の上まで跳かして相当の深さの所まで来て、そこから先生を目標に抜手を切った。",
              "citation": {
                "source": "こころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "道具袋を海にタタッ込んで、抜手を切って沖合いの小舟に泳ぎ付いた。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾輩は沖の水舟を拾うべく、抜手を切って泳ぎ出した……あの時の話なんだ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――男達は忽ち波の彼方に整列して、ワイワイと騒ぎながら見ごとな抜手を切つて進んでゐた。",
              "citation": {
                "source": "渚",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "平泳ぎ、背泳ぎ、両抜手、片抜手、競泳、立ち泳ぎ――等を悉く試みた。",
              "citation": {
                "source": "「或る日の運動」の続き",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は達者な泳ぎ手で、難なく向岸へ抜手を切って泳ぎついたが、とぼとぼと手ぶらで引あげて行った折の姿は、思い出すも無惨な光景で私は目を掩わずには居られなかった。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は達者な泳ぎ手で、難なく向岸へ抜手を切つて泳ぎついたが、とぼ／＼と手ぶらで引あげて行つた折の姿は、思ひ出すも無惨な光景で私は目を掩はずには居られなかつた。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮田は、鮮やかな抜手を切つて頻りに泳いでゐた。",
              "citation": {
                "source": "スプリングコート",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "抜手を切って泳ぎ着いた三次、心得があるから頓には近寄らない。",
              "citation": {
                "source": "早耳三次捕物聞書",
                "author": "うし紅珊瑚",
                "note": "青空文庫"
              }
            },
            {
              "text": "左手で握ってぐっと引き寄せ、肘を相手の腋の下へ挾むようにして持ち上げながら、右手で切る片抜手竜宮覗き。",
              "citation": {
                "source": "早耳三次捕物聞書",
                "author": "うし紅珊瑚",
                "note": "青空文庫"
              }
            },
            {
              "text": "金魚のように尾鰭だけは立派に身につけて大勢と踊るのであったが、朋輩の誰彼が抜手を切って彼女達の彼岸近くへ泳いで行っているのに、下手なダイビングで立ち遅れたのか、伊代は不器用にうろうろして誰からも声をあびせかけられなかった。",
              "citation": {
                "source": "帯広まで",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロールや、抜手にくらべるとはなやかではないが、この水府流の両輪伸こそは遠泳にはもってこいの泳法だ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう十分ほどすると、丁度このそばを日本汽船が通りますから間違いなく……」　中野ソックリの男はそういって立上ると、二人に一揖して海に飛込み、そのまま抜手を切って泳ぎ去ってしまった。",
              "citation": {
                "source": "地図にない島",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "作家よ、そして、作家たらんとする人々よ、文壇を蹴って、颯爽と大衆の海へ抜手を切れ、と呼ぶことは、おのずからそこに風の吹きわたるような空気の動きを予想させるのである。",
              "citation": {
                "source": "文学の大衆化論について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとの硝子窓に寄りて足ずりする時、第三のわが影、艫の方の渦巻く浪にまじり、青白く長き手に抜手きつて泳ぎつつ、「は、は、は、は、そは皆物好きなるわが夫の君のわれを試めす戯れぞ」と笑ひき。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人喰い藻が何んだえ」　小虎は華手に抜手まで切って見せた。",
              "citation": {
                "source": "死剣と生縄",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらゆる危険に飛び込んで抜手をきって切り抜けて見せたい。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "おみおつけの海に抜手を切るべく、お米の御飯の山を跋渉すべく、はたまたお醤油の滝に浴みすべく――。",
              "citation": {
                "source": "踊る地平線",
                "author": "黄と白の群像",
                "note": "青空文庫"
              }
            },
            {
              "text": "之が博士の非常時的「イデオロギー」なのであり、そして博士によれば、異った立場にある人はその人々で、各々のイデオロギー実現のために、生の激流に投じて抜手を切って進むことが勧められる。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "深いところはあんなにして抜手を切り、中辺のところは乳あたりまで浸して悠々と横行し、浅瀬はしゃんしゃんと飛沫を切り、かくて河を三分の一あたりまで突破して来た時に、後ろから、かなりの狼狽と怒罵とを含んだ叫び声が起りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、梨枝子と菊子とが見てゐる前で嶺太郎が、颯爽と抜手を切るのをみて、彼もはじめは敵はぬと思つたが、つい、負けん気を出し、一つ変つたところをと、こつちはうろ覚えの背泳をやつてみせた。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が中学一年のとき、佐渡出身の斎藤兼吉といふ人が始めてオリンピックの水泳に自由型へ出場して片抜手で泳いだ。",
              "citation": {
                "source": "わが戦争に対処せる工夫の数々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が中学一年の時、そのころ高師の生徒で佐渡出身の斎藤兼吉といふ人がオリムピックに出場して、片抜手で自由型を泳いで、カワナモクのクロールに惨敗して、クロールを習ひ覚えて帰つてきた。",
              "citation": {
                "source": "ぐうたら戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "拔手を切つて雨中を泳ぐ一人の若者。",
              "citation": {
                "source": "榛名",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
