  {
    "uuid": "6e546be2-c200-5769-b36a-484fd123df87",
    "entry": "抜手",
    "reading": {
      "primary": "ぬきて",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
