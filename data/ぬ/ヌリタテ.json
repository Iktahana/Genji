[
  {
    "uuid": "5ca9ca3b-58e3-5c7b-819d-52a39fce0d81",
    "entry": "塗りたて",
    "reading": {
      "primary": "ぬりたて",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-の形容詞",
