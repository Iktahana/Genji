        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二十六　然うすると、心に刻んで、想像に製り上げた……城の俘虜を模型と為た彫像が、一団の雪の如く、沼縁にすらりと立つ。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "沼べりわたしは眺めてゆく、沼べりの葦のさびれを。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "三疋を彼に分けてやると礼を云いながら木の枝にそれをさして、やがて沼べりの路をもと来た方へ帰って行った。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜の約束通り私が老番人を連れてその沼べりの家を出かけようとすると、急にＭ―老人の部屋の戸があいて老人が顔を出した。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢代は沼べりの木の長椅子に腰を降ろした。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "三疋を彼に分けてやると禮を言ひながら木の枝にそれをさして、やがて沼べりの路をもと來た方へ歸つて行つた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜の約束通り私が老番人を連れてその沼べりの家を出かけようとすると、急にＭ―老人の部屋の戸があいて老人が顏を出した。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            }
