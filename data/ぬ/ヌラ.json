[
  {
    "uuid": "ca888d32-f9e9-57a1-b950-3d7a46020360",
    "entry": "ぬら",
    "reading": {
      "primary": "ぬら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
