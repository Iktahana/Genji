      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "糟谷は本所へ越してきて、生活の道が確立したかというに、まだそうはいかぬらしい。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "明ぬれば月は空に帰りて余波もとゞめぬを、硯はいかさまになりぬらん、夜な／＼影や待とるらんと哀なり。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふわふわしてしまりがなく、薄弱で、微温的で、ぬらぬらして、そして要するに全く散文的である。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとより我等のかたらひはいとうすきびいどろの玉をなづるがごとしこの白き鋪石をぬらしつつみどり葉のそよげる影をみつめゐれば君やわれやさびしくもふたりの涙はながれ出でにけり。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしてべにがらいろにぬられた恐怖の谷では獸のやうな榛の木が腕を突き出しあるいはその根にいろいろな祭壇が乾からびてる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの象徴派のぬらぬらした、メロディアスで柔軟な自由律は、最近詩派の趣味性から手きびしく反感される。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅津玉枝の御二方は、西施の顰をみそかに開かせ給ひぬらん。",
              "citation": {
                "source": "花あやめ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "月蝕皆既萩原朔太郎みなそこに魚の哀傷、われに涙のいちじるく、きみはきみとて、ましろき乳房をぬらさむとする。",
              "citation": {
                "source": "月蝕皆既",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "暑さはもう私の胸のあたりをぬら／＼させずにはおかなかつた。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "別に邪魔になる程に、大声で笑つたわけでもなかつたし、それにしてもだ、先生がカン／＼になつてたことは事実だし、先生自身何をそんなに怒るのか知つてゐぬらしいことも事実だし、俺としたつて意地やふざけで笑つたわけではなかつたのだ。",
              "citation": {
                "source": "夏と悲運",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "痕を残さない、濃さと淡さの碧が、谷から舞い上る霧のほむらに、ぬらりと光る。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、幹には苔が蒸して、皮は土より柔く、ぼろぼろに腐っているから、生あるものの肌のようで、ぬらりと滑り、ぐちゃりと触れて、いやな気持がする。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、けさからのワシデッキとハッチの密閉とで水夫たちは、その着物の大部分をぬらしてしまった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "（波田、三上のごときは、その全部を二重にぬらした、つまり一そろいの服を二度ぬらした。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "なめこというぬらぬらした豆きのこは大変ねだんがよかった。",
              "citation": {
                "source": "魚服記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨は私のレインコートをとおして、上衣にしみて来て、やがて肌着までぬらしたほどであった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "疱瘡が御平癒とは申しても、あれほどの御大病でございましたので、さすがに御余気が去らぬらしく時々わづかながらお熱も出ますので、そのとしは、鶴岳宮の一切経会、放生会、またその他のお祭りにも将軍家のおいでは無く、もつぱら御ところの御奥におひきこもりでございました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小僧は彼こそ著者であることを知らぬらしかつた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小僧は彼こそ著者であることを知らぬらしかった。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "船の中に大きな重い振子を吊し、その周囲に粘い油を入れるというのであるが、まだ実際の試験をするところまで行かぬらしい。",
              "citation": {
                "source": "汽船の改良",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "女政客も、女実業家も、映画女優も、成金も、文学者も男性を象徴した酒杯に満ちた、白色の酒で唇をぬらした。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "途端に引込めた、年紀の若い半纏着の手ッ首を、即座の冷汗と取って置きの膏汗で、ぬらめいた手で、夢中にしっかと引掴んだ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「では……」　茶店の婆さんというのが、式のごとく古ぼけて、ごほん、と咳くのが聞えるから、夫人は余り気が進まぬらしかったが、二三人｜子守女に、きょろきょろ見られながら、ずッと入る。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "梭を投げた娘の目も、山の方へ瞳が通い、足踏みをした女房の胸にも、海の波は映らぬらしい。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニコニコとそれを見い、見い、身のぬらめきに、手唾して、……漁師が網を繕うでしゅ……あの真似をして遊んでいたでしゅ。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "裸身の色の白さに、つい、とろとろとなって、面目なや、ぬらり、くらりと鰭を滑らかいてまつわりましたが、フトお目触りとなって、われら若君、もっての外の御機嫌じゃ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "斬った男は、真赤な顔をして、刀を振り上げて、悪鬼のように、眼を剥き出して「こらっ、うぬらっ」　と、叫んで、三人に、走りかかった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うぬらっ、早くやらぬと、これだぞ」　最先の一人が、一人の人足の肩へ白刃を当てた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬらっとして、油をまいたような平かな海面がくずれて、一体に動揺を始めたようでした。",
              "citation": {
                "source": "少年と海",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どどどどっ――と、刑部は縁に馳け出して、「うぬらっ」　もの凄い眼光を、追いしたう捕手たちに、かッと投げた。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
