        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヌックリと海から陸へ上がり、ノシノシと岩へ上がって行こうとした。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「怪しいとは僕のことですか」　ヌックリと青谷の前に立ったのは、長身の髭だらけの工夫体の男だった。",
              "citation": {
                "source": "人間灰",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "小暗いレールを踏み越えて、ヒラリとプラットホームに飛びあがった大江山警部の鼻先に、ヌックリ突立った男があった。",
              "citation": {
                "source": "省線電車の射撃手",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
