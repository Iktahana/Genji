        "examples": {
          "standard": [
            {
              "text": "このスカートには、デザインとしていくつかの縫い込みがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ジャケットの肩の部分に、シルエットを整えるための縫い込みがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "縫い込みを調整することで、服のフィット感を変更できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "大化けします、たとえば刺繍をここに入れたり、色物の水玉をあちらに縫い込みます。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トラックに乗ってる間に、浴衣の縫込みへこっそり入れといたってン」　チマ子はペロリと舌を出して、素早く陽子に飴玉を渡した。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、凹地づたひに崖下に降りて石垣と石垣にはさまれた露地を駆け抜けようとすると、角の物置の蔭では、吉良方の一隊が縫込みの稽古着に袴の股立ちをとつて、互ひに清水一角に扮するのを争つてゐる最中だつた。",
              "citation": {
                "source": "泉岳寺附近",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は白鉢巻に縫込みを着け、白地袴の股立ちをとらされて、無論木刀が授かるものと待ち構へてゐたところに、意外にもそんな宣告を受けたので隆々と鳴る腕のもつてゆき場がなくなつて何時もの癖のやうに咳払ひを挙げ、憤つとして頤を撫でゝゐた。",
              "citation": {
                "source": "天狗洞食客記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧式な曲った、けば立ったシルクハットと、窮屈そうな、古さで光っているフロックコオトと、裾のほうがささくれていて、半長靴のゴムの縫込みが見えるほど短かい、これも劣らず見すぼらしいズボンとを着けている。",
              "citation": {
                "source": "トビアス・ミンデルニッケル",
                "author": "TOBIAS MINDERNICKEL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
