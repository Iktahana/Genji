        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大垣停車場から、伊吹山頂、海抜一三七七メートルの点までの距離が、ほとんどちょうど二十キロメートル、すなわちざっと五里である。",
              "citation": {
                "source": "伊吹山の句について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜一万六千フィートのここはなんの湿気もない。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿帳を御覧、東京｜間抜一人と附けて在る」「その傍に小く、下女塩原間抜一人と、ぢや附けさせて戴きませう」「面白い事を言ふなあ、おまへは」「やつぱり少し抜けてゐる所為で御座います」　彼は食事を了りて湯浴し、少焉ありて九時を聞きけれど、かの客は未だ帰らず。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "今強いてかかる物を求むれば、キャングは極寒の高地、海抜一万四千フィートまで棲む故、旄牛と等しく厚い茸毛を被るから、正しく旄馬と呼んで差しつかえぬ。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし海抜一〇〇〇メートルあたりから道は通れぬようになりました。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実にこの頂上こそ海抜一三四四メートル六の標高を有し、兵庫アルプス南方の重鎮兵庫御嶽の絶頂であります。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは実に海抜一三五八メートル兵庫県第二の高峰乗鞍の絶頂であります。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてここから縦走する予定でした海抜一二四四・二メートルの俚称三国ヶ山は大森林やスズ竹の突破がなかなか苦しいのであきらめて下山することにしました。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオこれが海抜一二一六メートル四の俚称赤谷の絶頂兵庫焼の絶頂です。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜一一〇〇メートルくらいまでは割合楽でしたが、それからはボサが多く、スキーが下手なのでなかなか時間がかかりました。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お糸を懲らすつもりの青竹獄門も、屍骸のやり場に困じての壁才覚も、結局は、釘抜一座の幽霊仕掛に乗って、いたずらに発覚を早めただけの自繩自縛に終った。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "怨霊首人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜一○○○から一五○○米の山腹に屋久杉の繁茂。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "木地師の道中　海抜一千一百尺、ここは笹子の山道である。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜一万尺に近い連峰を前にして、それらの連峰の一つ一つを呼ぶに、例えば、槍ヶ岳、穂高岳、などと云うことと、槍、穂高、などと云うこととの間には、云う気持に大なる違いがある。",
              "citation": {
                "source": "霊気",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達は汗もかかずに三十町を上って、海抜一千八十｜米（三五六五尺）の仁田峠へ来た。",
              "citation": {
                "source": "雲仙岳",
                "author": "菊池幽芳",
                "note": "青空文庫"
              }
            },
            {
              "text": "名づけてホテル・ユンクフラウヨッホは少々大袈裟な名前で、寝室は二室しかない、寝台が三つずつ、先ず小屋が正直な命名であるが、海抜一万一千三百余呎、しかも冬の真中のことであるから、高くて（標高ではない）まずくとも、あえて食事に不足を云うべきではない。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "狩勝停車場　海抜一千七百五十六｜呎、一二狩勝トンネル　延長参千九｜呎六｜吋釧路百十九｜哩八｜分旭川七十二哩三分札幌百五十八哩六分函館三百三十七哩五分室蘭二百二十哩　三千｜呎の隧道を、汽車は石狩から入って十勝へ出た。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "狩勝停車場　海抜一千七百五十六｜呎、一二狩勝トンネル　延長參千九｜呎六｜吋釧路百十九｜哩八｜分旭川七十二哩三分札幌百五十八哩六分函館三百三十七哩五分室蘭二百二十哩　三千｜呎の隧道を、汽車は石狩から入つて十勝へ出た。",
              "citation": {
                "source": "熊の足跡",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日の天気模様は朝から曇っていたものですから、肝腎の峠の上から諏訪湖をへだてた富士の姿が見えず、あたら絶景の半ばを損じたもののようで、ことに寒気が思いのほか強く、風こそないけれども、海抜一千メートルのここは、今にも雪を催してくるかとばかりです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "この島は全く高山によりて成り、その最高峰はわが富士山と同じく海抜一万二千尺ありというも、雲煙に閉じられて望むことを得ざるは遺憾なりとす。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "その高さ海抜一千尺ないし二千尺くらいに過ぎざるも、峰頂残雪の点在するを認む。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "その岬頭の最高点は海抜一千十七尺あり、山上には岩石あるのみ。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに、その海抜一千四十八尺の岩山聳立す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "坐礁　海抜一メートルほどの岩礁が東西に長く伸び、立山丸は船首をのしあげて二十度位の傾斜で右舷へ傾いていた。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃都市計画を実行しました結果、海抜一千尺の荒尾山というのが市の中へ入りました。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガリラヤの海から北へ十里余、地中海の海抜一千二百六十尺、ガリラヤ湖の水面より高きこと約二千尺の山地で、背後には雪を戴くヘルモンの峰そびえ、樹木｜鬱蒼として、水清き仙郷でありました。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "海抜一万尺、頂は三つの峰に分かれ、四時白雪をいただくシリヤ随一の名山であり、ピリポ・カイザリヤからは三、四日間にて達しうる近距離にありました。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "然而人劣教廣、未拔一毫、衣鉢竭盡、不能雇人、忘食寢勞書寫（『性靈集』卷五）。",
              "citation": {
                "source": "大師の入唐",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月十一日の稽古始めにも、吉例の勝拔一本勝負をやり、見事大原幸内、岸松太郎、林彦三郎の三人を叩き伏せて、優勝をかちえ、心ある者から代稽古ともあるものが、大人氣ない――と思はれたりしてゐたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "懷ろ鏡",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝからは岩石と砂礫の道を一歩々々踏みすゝんで、つひに海拔一萬二千餘尺の絶頂へたどりつくわけです。",
              "citation": {
                "source": "森林と樹木と動物",
                "author": "本多靜六",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
