        "examples": {
          "standard": [
            {
              "text": "今日の歌舞伎の演目には、扇情的な濡れ事の場面があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "若手の役者が、初めて濡れ事に挑戦するとあって話題になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その濡れ事は、観客の心を見事に捉え、大きな拍手喝采を浴びた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
