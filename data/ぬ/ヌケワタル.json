          "literary": [
            {
              "text": "十日間山野を抜渉し、二十日間に十万里の空を往復して漸く烏金丸を作ることが出来た。",
              "citation": {
                "source": "闘戦勝仏",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し私等の今取らうといふのは、此峻嶺拔渉ではない、烈しい白雲の中を衝いて所謂裏山を飛騨の國へ下りやうといふのである。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            }
          ]
        }
