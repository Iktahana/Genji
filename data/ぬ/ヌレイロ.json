[
  {
    "uuid": "509337fb-963b-5d08-8925-a2ef18b32e3e",
    "entry": "濡れ色",
    "reading": {
      "primary": "ぬれいろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
