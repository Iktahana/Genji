[
  {
    "uuid": "d7e1efdf-f399-56cb-a474-2269d89fa0e4",
    "entry": "脱ぐ",
    "reading": {
      "primary": "ぬぐ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ガ行",
        "動詞-他動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to take off (clothes, shoes, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "家に帰ったら、まずコートを脱いでリラックスする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "暑かったので、上着を脱いでTシャツ一枚になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "日本では、他人の家に入る時、靴を脱ぐのがマナーだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "折釘に烏帽子かけたり宵の春春の夜に尊き御所を守る身かな春雨や同車の君がさざめ言ほととぎす平安朝を筋かひにさしぬきを足で脱ぐ夜や朧月　引例を見ても解るように、特に春の句においてそれが多いのは、平安朝の優美でエロチックな文化や風俗やが、春宵の悩ましい主観において、特にイメージを強く与えるためなのだろう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "着物を一枚ずつ脱ぐ。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "連れの男がそれを脱ぐと、皆眞白な肌を出した。",
              "citation": {
                "source": "ラムネ・他四編",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩や両脇を太紐で荒くかがって風の抜けるようにしてある陣羽織式の青海流の水着を脱ぐと下から黒の水泳シャツの張り付いた小初の雄勁な身体が剥き出された。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――平常自分が女、女、と想っている、そしてこのような場所へ来て女を買うが、女が部屋へ入って来る、それまではまだいい、女が着物を脱ぐ、それまでもまだいい、それからそれ以上は、何が平常から想っていた女だろう。",
              "citation": {
                "source": "ある心の風景",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出水だ危い、と人々此方の岸から呼ばゝつたが、強情にものともしないで、下駄を脱ぐと杖を通し、帯を解いて素裸で、ざぶ／＼と渉りかける。",
              "citation": {
                "source": "怪力",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帽子を脱ぐと髪の毛を吹き乱す。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋服を脱ぐのもめんどうくさいらしい。",
              "citation": {
                "source": "疲労",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　見ればなるほど三畳敷の一間に名ばかりの板の間と、上がり口にようやく下駄を脱ぐだけの土間とがあるばかり、その三畳敷に寝床が二つ敷いてあって、豆ランプが板の間の箱の上に載せてある。",
              "citation": {
                "source": "窮死",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "井田が黒の二重マントを式臺に脱ぐ中に出面は机を卸しにかゝる。",
              "citation": {
                "source": "半日",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――小兒たちが、また惡く暖いので寢苦しいか、變に二人とも寢そびれて、踏脱ぐ、泣き出す、着せかける、賺す。",
              "citation": {
                "source": "夜釣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓で、彼が帽を脱ぐのに、驛員は擧手して一揖した。",
              "citation": {
                "source": "魔法罎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（かつ面を脱ぐ）おっとあるわい。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――小児たちが、また悪く暖いので寝苦しいか、変に二人とも寝そびれて、踏脱ぐ、泣き出す、着せかける、賺す。",
              "citation": {
                "source": "夜釣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒服の親仁は、すっぽりと中山高を脱ぐ。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "またその足袋を脱ぐのが、怪しい仕掛のあると云う、寮構へ踏込むのに、人住まぬ空屋以上に不気味だから、無造作に草履ばきでは下立たないで、余程ものずきなのが、下駄のあくのを待って一人、二人ずつでないと、怪しい席へ入らなかった、――そのために事が起ったのである。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……渠は金釦の制服だし、此方は袴なしの鳥打だから、女中も一向に構はなかつたが、いや、何しても、靴は羊皮の上等品でも自分で脱ぐ方が可ささうである。",
              "citation": {
                "source": "麻を刈る",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛脚が草鞋を脱ぐうちに、女房は褄をおろした。",
              "citation": {
                "source": "みつ柏",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とゞろ／＼と踏鳴らしもしない、輕い靴の音も、其の筈で、ぽかりと帽子を脱ぐやうに角の生えた面を取つて、一寸壁の釘へ掛けた、顏を見ると、何と！",
              "citation": {
                "source": "みつ柏",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（帽子を脱ぐ、ほとんど剃髪したるごとき一分刈の額を撫でて）や、西瓜と云えば、内に甜瓜でもありますまいか。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が脱ぐと、ステッキの片手の荷になる。",
              "citation": {
                "source": "若菜のうち",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "話の中には――この男が外套を脱ぐ必要もなさそうだから、いけぞんざいだけれども、懇意ずく、御免をこうむって、外套氏としておく。",
              "citation": {
                "source": "古狢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪子はふらふらとその部屋にはいると、著物を盗んで、自分の部屋に帰って寝巻を脱ぐと、その著物を素早く身につけた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザバタスはそれから、そのすべての宝石を差し出している侯爵夫人に対して、いとも慇懃に帽子を脱ぐとさて「いやいや、奥さま。",
              "citation": {
                "source": "薔薇の女",
                "author": "渡邊温",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、靴下を脱ぐところも見ます。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから提灯を消して傍の壁にかけて、ボロボロ浴衣を脱ぐと、くの字なりに歪んだ右足に、黒い膏薬をベタベタと貼りつけたのを、さも痛そうにラムプの下に突き出して撫でまわした。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "忙がしい我々は毎日々々｜蛇が衣を脱ぐように、我々の過去を未練なく脱いで、ひたすら先へ先へと進むようですが、たまには落ち付いて今迄通って来た途を振り向きたくなるものです。",
              "citation": {
                "source": "岡本一平著並画『探訪画趣』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "和服の人は着物をみな脱がなければならないが、洋服の人は単に上衣を脱ぐだけでよろしいという事であって、僕たちの組の人は全部洋服だったので、身支度にも手間がかからず、すぐに体操が始まった。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にちょっとお洒落なのもいて、制帽のいただきが尖らないように辮髪を後頭部の方に平たく巻いて油でぴったり押えつけるという新工夫を案出して、その御苦心は察するにあまりあったが、帽子を脱ぐと、男だか女だかわからない奇怪な感じで、うしろ姿などいやになまめかしくて、思わずぞっとする体のものであった。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し下駄を脱ぐ事に徹底すれば、何時でも黒闇で穿ける、智炬を燃すには及ばないのである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
