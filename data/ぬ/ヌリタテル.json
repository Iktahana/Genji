          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "油絵の具を厚く塗りたてて、立体感のある作品を仕上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は壁に漆喰を塗りたてて、素朴な風合いを出そうとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "パンにバターをたっぷりと塗りたてて食べるのが好きだ。",
