        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "実は――吹矢も、化ものと名のついたので、幽霊の廂合の幕から倒にぶら下り、見越入道は誂へた穴からヌツと出る。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "神田猿樂町で、幌のまゝ打倒れた、ヌツと這出る事は出たが、氣つけの賓丹を買ふつもりで藥屋と間違へて汁粉屋へ入つた、大分茫としたに違ひない、が怪我なし。",
              "citation": {
                "source": "麻を刈る",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　といふ、案内者の横面へ、出崎の巖をきざんだやうな、徑へ出張つた石段から、馬の顏がヌツと出た、大きな洋犬だ。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "市父並に遠佛のヌツカにアイノの家が十餘戸ある。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処に出迎へてゐる、多数の召使の前に、ヌツとつツ立つてゐる若者が、急に勝平に縋り付くやうにして云つた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヌツと許り髭面が入つて来た。",
              "citation": {
                "source": "菊池君",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、雪白の衣を着た一巨人が、地の底から抜け出でた様にヌツと立つて居る。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私は、口惜し紛れにヌツと立ちあがると、「ぢやほんとうに飲むか。",
              "citation": {
                "source": "妄想患者",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "七人と云ふのはルドヰコ・バルバリゴ、ニコレ・ヲレダン、アントニオ・ピルミアニ、ジユリオ・ボツタロル、オクタヰオ・ヱルヌツチ、それからレオネルロと己とである。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぢやア真平御免なさいやしかハハハハ　うつつたわいもなきままに、上り口といふも一間きりの、框へバタリと倒れたるまま、はや正躰なき様子に、女房はいとどぢれ込みて、ヌツと起き出で、その枕を蹴らぬばかり頭の際に突立ちて足踏み鳴らし、　これサお前そんなところへ寐ツちまツて、どうする気なんだえ。",
              "citation": {
                "source": "磯馴松",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、毎日、ダレカヌツテクレソウナ人ガ通ラナイカトミテヰルノデス。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ仕立屋デ、毎日、コヽデ着物ヲヌツテヰマシタノニ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コホロギサンハ、カウシテ反物ヲトツテキテ、早速立派ニヌツテアゲマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "櫛をつくる材をモチノキ属のイヌツゲだとしているなどは中にもその誤りの大きなものであって、黄楊のツゲすなわちホンツゲが泣いていることが聞えんだろうか。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓から区長の手がヌツと出て、竹の皮包みをスミに握らせる。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "六畳の障子が奥から開いて、頬に傷跡のある杉山の顔だけがヌツと出る。",
              "citation": {
                "source": "疵だらけのお秋（四幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（怒つて志水にかゝつて行く）（そこへ表からヌツと入つて来る留吉。",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「玉吉｜兄哥か、どうしたんだ、大層あわてゝ居るぢやないか」　明神下の平次の家、障子の隙間からヌツと出したのは、その八五郎の長んがい顎だつたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "八五郎の戀人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「つい裏に親方の家があります、此處はあつしと久兵衞だけで」　その久兵衞といふのは鹽辛聲の木戸番で、二十五六の眞つ黒な男、煮締めて燻して、鹽を利かせたやうな顏を、小柄な彌太八の後から、見越入道見たいに、ヌツと出します。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美しき鎌いたち",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し急ぎ足に、とある屋敷の角を曲ると、其處に待ち構へて、ヌツと後から來た男の鼻の先へ姿を現はしました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "からくり屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「眠さうだね」　ヌツと入つた平次。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "蝉丸の香爐",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ガラツ八の八五郎は、庭口からヌツと長い顎を出しました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺がに用事かね」　ヌツと庭口へ來たのは三十前後山出しらしい男です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "死の矢文",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　　　　　　×　　　　　　×「岡つ引奴――よく當つたよ」「あツ」　木立の間から、ヌツと出て來たのは、浪人佐々村佐次郎のニヤリニヤリと笑ふ顏でした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "死の矢文",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御免よ」　湯屋の裏口からヌツと入つた平次、その時はもう薄暗くなつて、腰高障子に釜前の火がほのかに射して居りました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "人肌地藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "錢形の平次が參つた、丁度宜い鹽梅だ、此方にも言ひたいことがある」　一刀を提げて、上り框にヌツと突つ立つたのは、青髯の跡凄まじい中年の浪人です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "くるひ咲",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸ひ危いところで命だけは助かつたが、其時受けたのが此｜疵だ」　顏をヌツと出すと、横疵の珊五郎と綽名にまで言はれた刀の跡が、四十男の額口から頬へかけて、斜に赤い線を引いて居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "大盜懺悔",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝋燭をかゝげると、縛られたお村の顏よりは、自分の醜怪な顏の方が、灯りの眞ん中へヌツと出ます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "人魚の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "浪人者は丸山湯の暖簾を肩で分けて、ヌツト中へ入りました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "幻の民五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御免よ、――誰か居ないのかえ」「へエ――」　ヌツと顏を出したのは、五十年配の人｜摺れのした男。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "八五郎の戀",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
