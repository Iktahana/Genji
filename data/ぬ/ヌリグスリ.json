    "definitions": [
      {
        "index": 1,
        "gloss": "medical cream",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "虫刺されには、この塗り薬がよく効く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お風呂上がりに、乾燥肌用の塗り薬を全身に塗る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "医者から処方された塗り薬を、毎日患部に塗っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "おせんの顔の疵も塗り薬などしてだんだんになおって来た。",
              "citation": {
                "source": "深川の老漁夫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "繃帯を除くとレントゲンの光線｜焦けと塗り薬とで鰐皮色になっている堆いものの中には執拗な反人間の意志の固りが秘められているように思われる。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩蔵はどうしているか判らないが、常磐津の師匠の家に寝込んでいるのではないかと思われるのは、おふくろのお金が赤坂まで金創の塗り薬を買いに行ったことである。",
              "citation": {
                "source": "半七捕物帳",
                "author": "唐人飴",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも、その塗り薬に何かの毒でも混じてありましたか、それはわたくしも存じません。",
              "citation": {
                "source": "半七捕物帳",
                "author": "白蝶怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は間に合わせの塗り薬を用いて、いくらか痛みを緩和していた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "かんたんな火ぶくれなのよ、ねえ、塗り薬でかためて調法であろう……。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の怪我はさっぱり埒があかない、全身打撲で、無事なのは顔と右手だけ、背中や腰に紫色の痣が大分出来てる、Ｘ線の結果、とにかく骨に傷は見えたが、別に折れてるのでは無いそうで、塗り薬でじっと経過を待つ外はない。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「隣町の外科に頼んで、塗り薬か何かで誤魔化し、幸い傷は癒りましたが、今度は――」「…………」　お夏はゴクリと固唾を呑みました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お民の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "１晩のあいだ塗り薬を使ったら翌朝には髪の毛がふさふさになった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "武器膏薬（weapon salve　＊傷を与えた武器に塗って傷を治す膏薬）、交感塗り薬、有名な交感粉薬（powder of sympathy　＊武器膏薬と同じようにも使う）は交感治療の手段であった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それでは、おいとましましょう」「はい」と、ミッツィは村長にいって、早くも塗り薬を準備していた。",
              "citation": {
                "source": "城",
                "author": "DAS SCHLOSS",
                "note": "青空文庫"
              }
            },
            {
              "text": "典医に申して、塗り薬をとって来て進ぜよう」　立ちかけると、「伝右殿、伝右殿、おついでに、十郎左へも、一服お遣わし下されませ」　と、誰かいった。",
              "citation": {
                "source": "べんがら炬燵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "医薬品は煎じ薬、ハップ、湿布、塗り薬、軟膏、膏薬、稀には粉薬、または錠剤として与えられた。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロッパと同じように梅毒の水銀治療は中国で何世紀にわたって行われた（塗り薬には灰色軟膏の代わりに水銀の赤色軟膏、内服には硫酸カルシウムを混ぜた昇華物）。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　少年が、白い塗り薬を出すと、「おまえは、なかなか感心だ。",
              "citation": {
                "source": "薬売りの少年",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは同情して、兎も角医者に見せる様に勧めたが、彼女はそれもいやだと駄々をこね、とうとう強情を通して、売薬の塗り薬かなんかで済ませてしまった。",
              "citation": {
                "source": "白髪鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、最後の一軒で、ようやく蛇毒を消す塗薬を小壜に入れてもらうことができた。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹見は、それで満足したわけではなかったが、ハルクを、あまり永く放りぱなしにしておくこともできないので、ようやくにして得た塗薬の小壜を握ると、再び、倉庫へ引きかえした。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「然し、伯父さんは僕に、医者とか医学とかを信用しないといって、昔風の煎薬と塗薬とだけを頼りにしていられるが、それと、君が今いったことと、どちらが本当だろう。",
              "citation": {
                "source": "碑文",
                "author": "――近代伝説――",
                "note": "青空文庫"
              }
            },
            {
              "text": "山添は取敢えず塗薬を差上げ、宿々の泊で、罨方したり冷したり、思いつく限りの手当をぬかりなくやってみたが、ふぐり玉は一日ごとにふくれむくみ、掛川の宿では、とうとう雁の卵ほどに成上り、この先どれほど大きくなるかと思えば、心も身に添わぬほどであった。",
              "citation": {
                "source": "玉取物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田玄白、前野良沢の「解体新書」が翻刻されてから七十年、その後、「内科撰要」や「医範提綱」というような良知が出て、いよいよ繁栄の趣になったが、蘭方外科は名目ばかりで、膏薬と塗薬のほか何事も得出来ず、華岡流の外科も脱疽、兎脣の手術を行なう底のところに止っている。",
              "citation": {
                "source": "玉取物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "患者は多いのに時間は少ない、で、いつも極く簡単な質問と、塗薬か、※麻子油位の薬を渡して遣るのに留まっている。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンクリートの上の、筵の藁の、どこからか尿のしみ出す編目に埋めた崩れそうな頬の塗薬と、分泌物と、血と、焼け灰のぬらつく死に貌のかげでや、や、うごいた眼が、ほろりと透明な液をこぼしめくれた唇で血泡の歯がおれの名を、噛むように呼んでいる。",
              "citation": {
                "source": "原爆詩集",
                "author": "峠三吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "時雨堂の縁先では、銀五郎が、多市に薬風呂をつかわせて、傷の塗薬や浴衣の世話をみてやっているところだった。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」４しらがふりわけ、じいさん言った、「わかいころには、しなやかじゃった、このぬり薬のおかげでな――ひと箱５シル、どうじゃふた箱。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
