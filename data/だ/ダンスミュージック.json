        "examples": {
          "standard": [
            {
              "text": "パーティーでは、アップテンポなダンスミュージックが流れ、場を盛り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼はDJとして、最新のダンスミュージックを披露した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ダンスミュージックに合わせて、みんなが体を揺らしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "音楽にも軽音楽やダンス・ミュージック、みんなが口ずさむようないろいろな歌。",
              "citation": {
                "source": "質問へのお答え",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、ぼんやり右往左往に入れ乱れ、房々、涼しそうな葉をつけた梧桐を見ながら、隣家から聞えて来るダンス・ミュージックを聞いた。",
              "citation": {
                "source": "一九二三年夏",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「うんそうだ、プリシラ・ディーンだ」「ラ、ラ、ラ、ラ」と浜田が再びダンス・ミュージックを唄いながら、踊り出した時でした。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
