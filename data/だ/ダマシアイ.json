        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "友達とトランプで遊んでいたが、いつの間にか真剣な騙し合いになっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ビジネスの世界では、時には容赦ない騙し合いが繰り広げられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「もう騙し合いはうんざりだ。正々堂々やりたい。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "灯の煌めくときは周囲の夜闇を深夜のように圧し黒め、消ゆるときは一色の闇の中にも川―河岸―空と三段の区別を淡く透して宵のうちに返る灯と闇との関係は妙に互いに反対の効果を狙い合って騙し合い／＼しているようでございます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "思想の価値は、表現方法を舞台とする巧妙なかけ引きと、騙し合いと、を経た後に、一つの契約として登場する。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛し合うことは騙し合うことよりもよっぽど悲痛な騙し合いだ。",
              "citation": {
                "source": "おみな",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、若しこれが、双方のだましあいの喜劇に終らず、一方だけがだまされる悲劇に終ったとしたならば、御仲人様の責任は決して軽くはないと思います。",
              "citation": {
                "source": "秘密の相似",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に、その愛という言葉が、人間同士の思いちがいや、だましあいの媒介物となったのは、いつの頃からでしょう。",
              "citation": {
                "source": "愛",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だましあい、より美しくより愛らしく見せようとし、実質的に自分の魅力のなかで相手を生活させようとする。",
              "citation": {
                "source": "デカダン文学論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "案外、そんなところに、君たちと民衆とのだまし合いが成立しているのではないか。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳川を相手にするには、どこまでも狐と狸のだまし合いのようなものじゃ」　人に聞かれては容易ならぬ言葉！",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "与えないのみならず、あらゆる野卑と、悪戯と、不行作と、かけごと勝負と、だまし合いとを奨励して興がるかの如く見ゆる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽天的で子供らしいところのあるロシア人のことであるから、二、三日前から趣向を凝らしておいて、当日になるとさかんにだまし合いをやる。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間が私有財産を獲んとして日夜だまし合い、たたき合い、ののしり合い、殺し合うていることは今日の世の中の常態で、誰も目前に見ている事実であるが、他の動物とても理屈は少しも違わぬ。",
              "citation": {
                "source": "動物の私有財産",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後の史家には、後醍醐と尊氏との講和を、どちらも、謀略と謀略との、だまし合いであったと説く者もあるが、後醍醐とて、初めから、好んであんな冒険的な脱走をもくろんでおられたものでは決してあるまい。",
              "citation": {
                "source": "私本太平記",
                "author": "黒白帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
