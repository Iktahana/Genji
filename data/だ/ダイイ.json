[
  {
    "uuid": "684e90f6-4b60-512b-83b7-252784c659d7",
    "entry": "代位",
    "reading": {
      "primary": "だいい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
