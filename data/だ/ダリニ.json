          "literary": [
            {
              "text": "＊51　夢のうちの贅りの花のひらきぬるダリニの市はわが遊びどころ森　鴎外　大連よ。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「他ノ珍宝ヲ数エテ何ノ益カアルト、従来ソウトウトシテ、ミダリニ行ズルヲ覚ウ……」と神尾主膳が柄にもないことを呟きました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち万葉時代の人々が其等をミダリニと訓んでいただろう。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
