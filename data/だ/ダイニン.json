  {
    "uuid": "9fe60c8e-b2d1-5b10-acda-ae6e2b476f9c",
    "entry": "大人",
    "reading": {
      "primary": "だいにん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "adult",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "もうあなたは大人なのだから、自分の行動に責任を持ちなさい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "漢籍の一節に「大人の徳は天地に配す」とあり、成熟した人格者の在り方が説かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "古い法令の条文には「大人たる者は自らの行為に責任を負う」という記述が見られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "大人となつた今日でさへ、さうした悲運はやみはせぬ。",
              "citation": {
                "source": "夏と悲運",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり大人の芸術とはなることは出来ない。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいわい、山崎氏には、浅見、尾崎両氏の真の良友あり、両氏共に高潔俊爽の得難き大人物にして帷幕の陰より機に臨み変に応じて順義妥当の優策を授け、また傍に、宮内、佐伯両氏の新英｜惇徳の二人物あり、やさしく彼に助勢してくれている様でありますから、まずこのぶんでは、以後も不安なかるべしと思います。",
              "citation": {
                "source": "砂子屋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人の目にも、俗人の目にも、ともに大人しい人といふ印象を与へて、富永は逝つた。",
              "citation": {
                "source": "夭折した富永",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰の目にも大人しい人として映つた。",
              "citation": {
                "source": "夭折した富永",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども出左張屋でなく奇麗な口をムツチリ噤んで大人しくしてゐれば、それがまた妻君には癪なんだらうから………。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の科學智識が一般的に發達してゐることは、一昔前に育つた僕等の大人が、しばしば唖然として舌を卷くほどでさへもある。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の知つてる世界は、大人の知る「現實」の世界とはちがふのである。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大人にとつて荒唐無稽のことは、彼等にとつて皆「眞實」のことなのである。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし思ふに、さうした話は事實でなく、事實であらせたいと望むところの、大人の子供に對する――特に教育者の子供に對する――意志表示を語るのだらう。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして此處に、昔から日本の教育界に普及してゐる、大人の根本的な誤謬がある。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな子供が大人になつたら、乾からびた侏儒のやうな人間になり、無意味に機械いぢりでもする以外に、何の創造的才能もない小俗物になるであらう。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが眞に憂ふべきことは、かうした間ちがへたイデーによつて、子供をより善く教育できると考へ、その眞に「憂ふべき現象」を以て、却つて逆に「悦ばしい現象」と考へてるところの、日本の大人や教育者たちの思想である。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時三つ斗りなる兒の、小く太りたるが、大きなる大人の下駄を引きずりて、縁先近く參りたる、覺束なき足もとなり。",
              "citation": {
                "source": "花あやめ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の方が大人より上手である。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして大人になるまで生きるかどうかと気遣われた自分が、これらの先生方のおかげでどうにか生き延びて、そうしてこれらの人達よりも永生きをしているわけである。",
              "citation": {
                "source": "追憶の医師達",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬でもなかなか大人しくのまぬ。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "又は、それこそ、「社會の一員」として、仔細らしい顏をし、世間の大人の口吻を猿眞似して、大人の生活の要らざる手助けに努めるのがいいのか。",
              "citation": {
                "source": "諸君の位置",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君は、子供でも無ければ、大人でも無い。",
              "citation": {
                "source": "諸君の位置",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どだい、男らしくないぢやないか、と子供でも、また大人でも、いやしくも正義にあこがれてゐる人間ならば、誰でもこれに就いてはいささか不快の情を覺えるのではあるまいか。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいはひ、山崎氏には、淺見、尾崎兩氏の眞の良友あり、兩氏共に高潔俊爽の得難き大人物にして帷幕の陰より機に臨み變に應じて順義妥當の優策を授け、また傍に、宮内、佐伯兩氏の新英惇徳の二人物あり、やさしく彼に助勢してくれてゐる樣でありますから、まづこのぶんでは、以後も不安なかるべしと思ひます。",
              "citation": {
                "source": "砂子屋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "港の市の秋の日は、　　大人しい発狂。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで大人も子供のやうにである。",
              "citation": {
                "source": "運動会の風景",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "といへば、私たちの村では、大人も子供のやうに淳朴である。",
              "citation": {
                "source": "運動会の風景",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "五人の子供等と、四人の大人にとつて、二ヶ月以上も、井戸から水を取り上げた事実は、この二人の借家人の、左まで鋭からざる神経にも相当な影響を及ぼした。",
              "citation": {
                "source": "井戸の底に埃の溜つた話",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくのごとく我儘であるくせにまた甚だしく臆病な彼は、自分で断然年賀端書を廃して悠然｜炬燵にあたりながら彼の好む愚書濫読に耽るだけの勇気もないので、表面だけは大人しく人並に毎年この年中行事を遂行して来た。",
              "citation": {
                "source": "年賀状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その下に小さな子供が二、三十人も集まって大人しく坐っている。",
              "citation": {
                "source": "静岡地震被害見学記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "近在の人らしい両親に連れられた十歳位の水兵服の女の子が車に酔うて何度ももどしたりして苦しさうであるが、苦しいとも云はずに大人しく我慢してゐるのが可愛想であつた。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が其處へ來る前から、中學の一年か二年位と見える子供が唯一人材木の上に腰をかけて居たが、私が描き始めると傍へ來て大人しく見て居た。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
