[
  {
    "uuid": "1f93909b-60a5-591c-b020-178ae1644991",
    "entry": "代人",
    "reading": {
      "primary": "だいにん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "substitute",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "会議に急遽出席できなくなったため、同僚に代人をお願いした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "体調が優れない彼の代わりに代人が式典に出席した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「代人を立てることは認められません」と係員から告げられ、本人が直接手続きに来ることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "聖書の綱が性慾のコマを廻す原始人の礼儀は外界物に目も呉れないで目前のものだけを見ることでしただがだが現代文明が筆を生みました筆は外界物です現代人は目前のものに対するにその筆を用ひました発明して出来たものが不可なかつたのですだが好いとも言へますから――僕は筆を折りませうか？",
              "citation": {
                "source": "迷つてゐます",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も、近代人が、自力をばかり恃む傾向があり、それにはそれの必然性があることを、私とて知らないのではない。",
              "citation": {
                "source": "詩壇への願ひ",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その天才が閃くのは思ひがけない発見の中にであり、その点では同時代人の中にも先人の中にも彼女に如くものはないのである。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして近代人といふのは、多いか少いかこのむしなのではないか？",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代人中の極くもう愚劣な、へ理窟屋共が全然人造的なものを作りたいと企図したりする。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "不断の満たされた食事と、立派な暖房装置の家を持ち、外出に自動車を有する近代人は、あの蕭条とした自然の中にをののいている原始の恐怖を、もはや全く意識の表象から忘れてしまつた。",
              "citation": {
                "source": "冬の情緒",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれが近代人の伝統破壊を喜ぶ一種の心理に適合するために、見当違いに痛快がられているようである。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界的太宰治　ヨーロツパの近代人が書いた「キリスト傳」を二、三册讀んでみて、あまり感服できなかつた。",
              "citation": {
                "source": "世界的",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然に対しても、近代人は近江八景や、二見ヶ浦の日の出のような、伝習に囚われた名所や風光で満足が出来ないのである。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "下つ瀬には網代人が州の小屋に籠って網代に鱸のかかるのを待っている。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち「いき」とは「西洋においても日本においても」「現代人の好む」何ものかに過ぎないことになる。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "知識とは少しちがう「智恵」については第三十八段に「智恵出でては偽あり」とか「学びてしるは、まことの智にあらず」などと云っているのは現代人にも思い当たるふしがあるであろう。",
              "citation": {
                "source": "徒然草の鑑賞",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしあれは茶の湯や禪味と關聯した「侘しさ」のあはれであつて、現代人たる僕等の氣分とはぴつたりしない。",
              "citation": {
                "source": "田端に居た頃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見無技巧のやうな言葉の中にこそ、近代人の鋭どい感性が働いてゐるのだ。",
              "citation": {
                "source": "室生犀星の印象",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い民謡と、新民謡新流行歌とを対比する様に、現代人の言葉には非常に粉飾が多いが、昔の人の言葉には余分のものがない。",
              "citation": {
                "source": "気まま者の日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが出来ましたなら、現代人の芸術の能事畢れりではございますまいか。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなら現代人の要求とでも申しましょうか。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とミサコは艶然とわらうと、「妾の困難な仕事も妾の道徳的な突進も妾の女馬鹿もいつもカリタの近代人らしい截断によって世間に通用するんだわ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏教的な無常観から解放された現代人にとっては、積極的な「風流」、能動的な「さび」はいくらでも可能であると思われる。",
              "citation": {
                "source": "俳句の精神",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういうところから出た伝説だか、あるいは才女の空想から生み出された事だか、とにかく現代人の思いも付かないような事を考えたものである。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これもおそらく多くの現代人にはあまりに消極的な唱歌のように思われるかもしれない。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "科学的な客観的な言葉を用いたがる現代人は「空気がちがって来た」というのである。",
              "citation": {
                "source": "浅間山麓より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「帯刀の廃止、決闘の禁制が生んだ近代人の特典は、なんらの罰なしに自分の気に入らない人に不当な侮辱を与えうる事である。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間のほうが器械の声よりもどんなに美しいか到底比較にならないのであるが、しかしいわゆる現代人にはこの雑音だらけの拡声器の音でないと現代の気分が出ないというのであろう。",
              "citation": {
                "source": "沓掛より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "手早く言えば一種の骨董芸術で、現代人に呼びかける処は一つもない。",
              "citation": {
                "source": "能ぎらい／能好き／能という名前",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代人は相生、調和の美しさはもはや眠けを誘うだけであって、相剋争闘の爆音のほうが古典的｜和弦などよりもはるかに快く聞かれるのであろう。",
              "citation": {
                "source": "カメラをさげて",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこれがかえっていわゆる近代人の闘争趣味には合うのかもしれないと思われるのであった。",
              "citation": {
                "source": "「手首」の問題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "連句はその末流の廃頽期に当たって当時のプチブルジョア的有閑階級の玩弄物となったために、そういうものとしてしか現代人の目には映らないことになった。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
