        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イハンヤ、ラファエルニオイテヲヤ……未ダカツテ……ジョットーヨリ純正偉大ナル宗教画家ハナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊ニ有隣舎所在ノ地ノ風土人物ニ関スルヤ予ハイマダカツテソノ地ニ抵リシ事ナキヲ以テ鄙著ノ遺脱｜謬誤最甚シキモノアルガ如シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生射ヲ善クシ、四矢反セズトイヘドモイマダカツテ※ヲ出デズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イマダカツテ面識アラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "観ル者歎息シテ儒者イマダカツテアラザルノ栄トイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏子モ、妻モ、僕モ、イマダカツテ口ニ出シタヲ僕ハ知ッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
