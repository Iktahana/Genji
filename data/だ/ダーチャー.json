        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "休養所、コンラッド氏　ダーチャー〔別荘〕の主人六月十八日（月曜）　ジェノトジェルにゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダーチャー〔別荘〕のことは見込みなし。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後急に思い立ってダーチャーへ行った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダーチャーというもの初めて知って、のん気で休むに適当なのでびっくりした。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかなか景色のよいところに、ダーチャーが散在して居る。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
