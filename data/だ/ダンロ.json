  {
    "uuid": "befba58f-c7f9-505d-904f-0403693070b8",
    "entry": "断路",
    "reading": {
      "primary": "だんろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "disconnection (of a wire)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "回路の点検のため、一時的に断路する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "漏電を防ぐために、この区間の電線を断路した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "作業員は、断路作業の安全を確認してから次の工程に移った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "これは当の作字者を地下に喚び起して、其説明を聞かなければ判然しないことであるが、本来たむけの音便であるたうげに宛てたものであるならば、作字者の意図はどうあろうと、矢張り山稜横断路の最高所を指すものと見てよろしかろう。",
              "citation": {
                "source": "峠",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨が、たきのように降ってきましたが、おじいさんの詩人は、部屋の中のだんろのそばで、気持よく暖まっていました。",
              "citation": {
                "source": "いたずらっ子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんろでは、火が赤々と、燃えていました。",
              "citation": {
                "source": "いたずらっ子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "おじいさんの詩人は、だんろの前に腰をおろして、ひざの上に男の子をだきあげました。",
              "citation": {
                "source": "いたずらっ子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんろでは、火があかあかと燃えていました。",
              "citation": {
                "source": "家じゅうの人たちの言ったこと",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、ちいさい男の子のひとりが、すずの兵隊をつかんで、いきなりだんろのなかへなげこみました。",
              "citation": {
                "source": "しっかり者のすずの兵隊",
                "author": "DEN STANDHAFTIGE TINSOLDAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹きこんだ風が踊ッ子をさらいますと、それはまるで空をとぶ魔女のようにふらふらと空をとびながら、だんろのなかの、ちょうど兵隊のいるところへ、まっしぐらにとびこんで来ました。",
              "citation": {
                "source": "しっかり者のすずの兵隊",
                "author": "DEN STANDHAFTIGE TINSOLDAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなとき、こどもたちは、だんろの上で銅貨をあたためて、こおった窓ガラスに、この銅貨をおしつけました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイルばりの大きなだんろのそばには、ししのふたのついた、青磁のかめが、おいてありました。",
              "citation": {
                "source": "もみの木",
                "author": "GRANTRAEET",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬼のお上さんは、大あわてにあわてて、ジャックを、だんろの中にかくしてしまいました。",
              "citation": {
                "source": "ジャックと豆の木",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャックは、鬼のすっかりねむったのを見すまして、ちょうど鬼のお上さんが、台所へ行っているのをさいわい、そっとだんろの中からぬけだしました。",
              "citation": {
                "source": "ジャックと豆の木",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう時、私は西洋室の方にうつって、だんろに薪をどしどしたきます。",
              "citation": {
                "source": "山の別荘の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕がよく知ってる人だが、どんな人だかはわからない、そういうへんな人が、やって来るような気がしますよ」　私はだんろに薪をくべて、さかんにもやしました。",
              "citation": {
                "source": "山の別荘の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうだんろの火はほそくなっていました。",
              "citation": {
                "source": "山の別荘の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんろの火がぱっともえたっていました。",
              "citation": {
                "source": "山の別荘の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから　だんろから　べつの　アイロンを　とってきまして。",
              "citation": {
                "source": "チギウィンクルおばさんのはなし",
                "author": "THE TALE OF MRS. TIGGY-WINKLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりは　だんろまえの　ながいすに　こしかけ、　おたがい　よこめを　むけあって。",
              "citation": {
                "source": "チギウィンクルおばさんのはなし",
                "author": "THE TALE OF MRS. TIGGY-WINKLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあと　どろのすみで　だんろを　もえあがらせて、　そとへ　でると　とじまりして　かぎを　しきいの　したに　かくしました。",
              "citation": {
                "source": "チギウィンクルおばさんのはなし",
                "author": "THE TALE OF MRS. TIGGY-WINKLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "モペットちゃん、　じぶんの　あたまを　ふきんで　くるんで、　だんろのまえに　おすわりします。",
              "citation": {
                "source": "モペットちゃんのものがたり",
                "author": "THE STORY OF MISS MOPPET",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちいさな　ゆりいすを　はみださんばかりに　すわりながら、　おやゆびを　いじいじ、　だんろの　さくに　あしを　かけて、　にたにたしているのです。",
              "citation": {
                "source": "おねずみおばさんのはなし",
                "author": "THE TALE OF MRS. TITTLEMOUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "かごいりチミーは　だんろのしたで　みじめに　よるを　こしたほうが　まだましだと　おもいました。",
              "citation": {
                "source": "まちねずジョニーのはなし",
                "author": "THE TALE OF JOHNNY TOWN-MOUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　リービは　石炭を　つんで、　だんろのそこを　きれいに。",
              "citation": {
                "source": "パイとやきがたのはなし",
                "author": "THE TALE OF THE PIE AND THE PATTY-PAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "げんかん口で　しきものを　ひとつひとつ　ぱたぱたしたあと、　きっちりと　しきなおしまして、　だんろ前に　しくのは　ウサギのけがわ。",
              "citation": {
                "source": "パイとやきがたのはなし",
                "author": "THE TALE OF THE PIE AND THE PATTY-PAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんろ上の　時計や　おきものの　ほこりを　はらい、　テーブルや　いすも　みがいたり　こすったり。",
              "citation": {
                "source": "パイとやきがたのはなし",
                "author": "THE TALE OF THE PIE AND THE PATTY-PAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいて　あらいたての　まっ白な　テーブルクロスを　ひろげ、　とっておきの　せとものの　ティーセットの　したく、　だんろそばの　つり戸だなから　とりだします。",
              "citation": {
                "source": "パイとやきがたのはなし",
                "author": "THE TALE OF THE PIE AND THE PATTY-PAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんろ前に　こしを　おろして、　子犬を　まつ　リービ。",
              "citation": {
                "source": "パイとやきがたのはなし",
                "author": "THE TALE OF THE PIE AND THE PATTY-PAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　リービは　だんろ前の　ソファに　ダッチェスを　おちつけると、　外へ　出て　先生を　さがしに　村へと　いそぎます。",
              "citation": {
                "source": "パイとやきがたのはなし",
                "author": "THE TALE OF THE PIE AND THE PATTY-PAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　また　こしを　おろして、　しょげながら　だんろを　じーっ。",
              "citation": {
                "source": "パイとやきがたのはなし",
                "author": "THE TALE OF THE PIE AND THE PATTY-PAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と　うら口の外に　おいてから、　また　だんろわきに　すわりこんで　目を　つむりました。",
              "citation": {
                "source": "パイとやきがたのはなし",
                "author": "THE TALE OF THE PIE AND THE PATTY-PAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほどなく　かさこそ　がりがり　かすかな　ものおとが　だんろそばの　すみっこから。",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
