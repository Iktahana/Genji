[
  {
    "uuid": "f6ea26eb-6803-5733-adcc-0e7571893720",
    "entry": "暖炉",
    "reading": {
      "primary": "だんろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "fireplace",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "冬の夜は、暖炉のそばで読書をするのが至福の時だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しい家を建てるなら、リビングに大きな暖炉が欲しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "暖炉の火がパチパチと音を立てて燃えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "歩道へ半分ほどもテーブルを並べ出して、角隅を硝子屏風で囲ってあるテラスのまん中に置いた円い暖炉が背中にだけ熱い。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "短い秋を見限ってテラスの真ん中の丸暖炉と、角隅を囲う硝子屏風はもう季節の冬に対しての武装だ。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三日前に百花園からつるの手をつけてある目籠に長命菊つくし石竹の苗其他数種の青草を植込にしたやつを買って来て置いたのを持って往ったのであるきょうは暖炉の掃除をやったとの事で先生は八畳の座敷に石油暖炉をたき東向になってねていられた。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "患者がいなくなるので朝から焚かなかった暖炉は、冷え切っていた。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　吉原は暖炉のそばでほざいていた。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "焔の光に照らされて、大きな暖炉の煤けた空洞が現われる。",
              "citation": {
                "source": "ある幻想曲の序",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムンムンと蒸れかえる瓦斯仕掛の大暖炉の蘊気と一緒に、早くも彼女の濃厚な化粧と、旺盛な肌の匂いが漂い初めていた。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがそんなひどい吹雪でも夜の八時になつて停車場に行つて見ますと暖炉の火は愉快に赤く燃えあがり、ベーリング行の最大急行に乗る人たちはもうその前にまつ黒に立つてゐました。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋では煙管に好みを有って、大小長短色々｜取り交ぜた一組を綺麗に暖炉の上などに並べて愉快がる人がある。",
              "citation": {
                "source": "余と万年筆",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "とう／＼其の彫像を――何です――父が暖炉に燻べて焼いたまでも分らなかつたんです。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "烈々と燃える暖炉のほてりで、赤い顔の、小刀を持つたまゝ頤杖をついて、仰向いて、ひよいと此方を向いた父の顔が真蒼に成つた。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は、父が、其の木像の胴を挫折つた――其が又脆く折れた――のを突然頭から暖炉へ突込んだのを見たが、折口に偶と目が着くと、内臓がすつかり刻込んであつた。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あゝ、それぢや、木彫の美人が、父のナイフに突刺されて、暖炉の中に焼かれた時まで、些とも其の秘密を明かさなかつた、微妙な音のしたものは、同一、此の采であつたかも知れない。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思はず彫像を焼いた暖炉の火に心着いて、何故か、急に女の身が危ぶまれて来た。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "焙き出したばかりの暖炉の前で加奈子が土の底冷えをしみじみ床を通して感じた独逸の思い出である。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたたかき暖炉はしばし息をひそめ、ふる雪のつかれはほのかにも雨をさそひぬ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その入口に面した向側の大暖炉の上に巨大な鏡が懸かって、血相の変った私の顔がハッキリと映っている。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大暖炉の横の紫檀の台の上に両手をブラ下げて天を仰いだ裸体の少年像（後から聞いたところによるとこれはロダンの傑作の青銅像で雲月斎玉兎女史の巴里土産であったという）がタッタ一つ立っているきりである。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、そこの暖炉棚の上に、私の妻の等身大の肖像画が飾ってあるのを見つけた時、私の疑念は一時にムラムラと燃え上がりました。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "いないとなると僕の非常な思い違いになるんだが……」「とすると脅喝している奴は何者だろう」「無論、その離れ家の例の気持ちよく飾った寝室だけに住んでる、あの男の妻の肖像を暖炉棚の上に飾っとく男さ。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは気持ちよさそうに飾られた部屋で、テーブルの上に二本、暖炉棚の上に二本、ローソクが灯されていた。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして彼が立ち上るまで暖炉にかざしていた彼の痩せた白い手は、外科医の手と云うよりはむしろ芸術家の手と云うほうがふさわしいくらいであった。",
              "citation": {
                "source": "入院患者",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに暖炉の中からひろい出した葉巻の吸いさしが四つあります」「ふーむ」　ホームズは云った。",
              "citation": {
                "source": "入院患者",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "また寝台も敷ものも椅子も暖炉も死体も綱も、順々にみんなしらべてみた。",
              "citation": {
                "source": "入院患者",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あの暖炉の上のブレシントンの肖像をとりおろしてもいいでしょう。",
              "citation": {
                "source": "入院患者",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、その鵞鳥は今頃、ピータソンの家の暖炉の前で、あぶり焼きにされているに違いない。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、椅子を暖炉にお寄せください、ベイカーさん。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「外がこうでは、暖炉がいちばんです。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「足下をしっかり、でないと暖炉に落ちるぞ！",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨が、たきのように降ってきましたが、おじいさんの詩人は、部屋の中のだんろのそばで、気持よく暖まっていました。",
              "citation": {
                "source": "いたずらっ子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
