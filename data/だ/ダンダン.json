  {
    "uuid": "0be281eb-5707-535c-b2c8-726cbea11d60",
    "entry": "だんだん",
    "reading": {
      "primary": "だんだん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "感動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "thank you",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「手伝ってくれて、だんだんね！」と彼女は笑顔で言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「たくさんのお土産、だんだんでした」と、おばあちゃんが何度も頭を下げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "困っている時に助けてもらって、「だんだん」と心から感謝した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」とやがてだんだん愚痴になる。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめにはイヤな奴だと思つてゐたが、だんだん見てゐると気の毒になつた。",
              "citation": {
                "source": "三等車の中（スケッチ）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん夕暮が近づく）男　もう怒るまいよ、怒らないことにしよう。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが慣れるにしたがつて、だんだんかうした新宿が嫌ひになつた。",
              "citation": {
                "source": "悲しい新宿",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん薄暗くなって色々の灯でいろどられてゆく上野広小路の雑沓の様子を見おろしていたのである。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん茶店の人たちも、あのお客は、ただ口が重いだけで、別段に惡だくみのある者でないといふことが判つた樣子で、お客さんのお嫁さんになるひと仕合せですね、世話が燒けなくて、とをばさんに冗談言はれて、私は苦笑して、やつと打ち解けて來たころには、はや十一月、峠の寒氣、堪へがたくなつた。",
              "citation": {
                "source": "九月十月十一月",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリスト教の問題に限らず、このごろの日本人は、だんだん意気込んで来て、外国人の思想を、たいした事はないようだと、ひそひそ囁き交すようになったのは、たいへん進歩である。",
              "citation": {
                "source": "世界的",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり彼は、だんだん、社交家であるのみの社交家に陥れられてゆくのだ。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "蹴り出されたお皿は庭の土の上で、だんだん雨に濡れてゐた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日迄大変暑かつたのにも今日はボンヤリした日が射してゐて、時々夕立でも降らせさうな雲の塊が乾き切つた庭の土を薄暗くしたり、そして稀々しくも地面を匍ふやうな微風が所々に生えた雑草などを揺るので、私の心は思ひ出を巡るに似合はしい気分になつて、その蛇の思ひ出はだんだん拡がつていつた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体に病身であった娘は、その後だんだんに弱くなって、とうとう二十歳でこんな事になったと話して聞かせた。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで聴いたキービッツという若いプリバート・ドチェントの空中電気の講義は始め十人くらいの聴講者がだんだん減ってとうとう二、三人になってしまった、そのせいか数時間でおしまいになった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一端に火をつけて「火渡し」と云って次の人に渡すと、次の人は「しりつぎ」と答えて次へ廻す、それからだんだんに東京でいわゆる「尻取り」をするのであるが、言葉に窮して考えている間に火が消えるとその人は何かしら罰として道化た隠し芸を提供実演しなければならないのである。",
              "citation": {
                "source": "追憶の冬夜",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん近付いて来る車の音が宿の前で止まるかと思っているとただそのまま行過ぎて消えてしまう。",
              "citation": {
                "source": "追憶の冬夜",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の両側から掘って行くトンネルがだんだん互いに近づいて最後のつるはしの一撃でぽこりと相通ずるような日がいつ来るか全く見当がつかない。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃になって、自分に親しかった、そうして自分の生涯に決定的な影響を及ぼしたと考えらるるような旧師や旧友がだんだんに亡くなって行く、その追憶の余勢は自然に昔へ昔へと遡って幼時の環境の中から馴染の顔を物色するようになる。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人間の廻転する円の半径がだんだん小さくなるに従って、鳥から見たそれの角速度は半径と逆比例して急激に増大して来るのであるから、鳥の注意と緊張もそれに応じて急激にしかし連続的加速度的に増大を要求されるであろう。",
              "citation": {
                "source": "鴫突き",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "写生文を鼓吹した子規、「草花の一枝を枕元に置いて、それを正直に写生していると造化の秘密がだんだん分って来るような気がする」と云った子規が自然科学に多少興味を有つという事は当然であったかも知れない。",
              "citation": {
                "source": "子規の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃始めて国の聯隊が出来て、兵隊や将校の姿が物珍しく、剣や勲章の目につくうちは好かったが、だんだん厭な事が子供の目に見えて来た。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱はだんだん上がるらしい。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん、よくなつて行くのでせう。",
              "citation": {
                "source": "知らない人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん、事情が分明して來て、それから、「おい、おい。",
              "citation": {
                "source": "當選の日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩きながら、だんだん嬉しくなつて來た。",
              "citation": {
                "source": "當選の日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん故郷の龍宮城にも居にくくなりましてね。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほうら、魚の脊中もだんだんまばらになつて來たでせう。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリスト教の問題に限らず、このごろ日本人は、だんだん意氣込んで來て、外國人の思想を、たいした事はないやうだと、ひそひそ囁き交すやうになつたのは、たいへんな進歩である。",
              "citation": {
                "source": "世界的",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "正しく風に動力を借りるオランダ低地の風車は美でもあり、経済的でもあったろうが、レムブラントの名手に油絵、またはエッチングに取り入れられたあの風車の風景も、近来は電気工業に取って代られ、引き合わないために、風車はだんだん取り毀たれ、オランダ風物の代表は、全く失われんとしているとも聞いた。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん（仕事）は大きく、大胆になって行った。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん強く降つて来た雨で、私たちは濡れてゐた。",
              "citation": {
                "source": "氷雨",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして飲みたくない酒を嘗めさせられ、食いたくない雑煮や数の子を無理強いに食わせられる事に対する恐怖の念をだんだんに蓄積して来たものであるらしい。",
              "citation": {
                "source": "年賀状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
