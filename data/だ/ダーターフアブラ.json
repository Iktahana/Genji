        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ダーターフアブラ、沙翁の使つた字数が何万字だの、イブセンの白髪の数が何千｜本だのと云つてたつて仕方がない。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "与次郎の隣りにゐたものが、「ダーターフアブラの為に祝盃を挙げやう」と云ひ出した。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーターフアブラとは何の事だ」「希臘語だ」　与次郎はそれより外に答へなかつた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて与次郎に尋ねたら、恐らくダーターフアブラの類だらうと云つてゐた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダーターフアブラは躍るべき性質のものと思へる。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
