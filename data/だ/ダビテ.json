          "standard": [],
          "literary": [
            {
              "text": "今まで毎日神戸海上に精勤した調子で彼は聖書物語を何冊も著述したいと思つて、先づ『ダビテとヨナタン』の友情の物語に筆をつけた。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝は其處にて死してあらん、かのダビテの輩や、槍投げするテエベびとの死すごとく。",
              "citation": {
                "source": "生けるものと死せるものと",
                "author": "ノワイユ夫人　Comtesse de Noailles",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの図の１つは２つの三角形が組み合っているダビテの星であった。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "憂鬱症に音楽が有効なことは、ダビテがサウル王の前でハープを奏したことで理解される。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
