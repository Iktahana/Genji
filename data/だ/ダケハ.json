        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノ都所ノ別当ニダケハ、ナツテモヨイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ、ドウシタ　コトカ、ゲタニ　バケル　コトダケハ　タイヘン　ウマイ　モノデ　アリマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシ人間ダケハ植物ダト思フワ。",
              "citation": {
                "source": "骨片ニ関スル無題",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "「株ヲ持ッテル筈ジャナイカ、アレヲ売ル訳ニ行カナイノカ」「アレヲ売ッタラ、ソレコソアタシタチ一文ナシニナッチャウワ」「ソウヨホントニ、アレダケハ手ヲツケナイ方ガイヽヨ」ト、婆サンガ助ケ舟ヲ出ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ウ予ノ心境ヲ、颯子ダケハオボロゲニ察知シテイルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハ支度ダケハ甲斐々々シイガ、離レタトコロカラ見テイルダケデ、ロクニ何モシテクレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食ダケハ寝室デ取ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦災ノ時ニ又モウ一度改築シタガ、隠居所ダケハ奇蹟的ニ火災ヲ免レタノデ、今モナオ父母アリシ日ノ姿ノマヽニ保存サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ソウ云エバ夢ノ中ノ母ハ黒縮緬ノ羽織ヲ着ナガラ足ダケハ足袋ヲ穿イテイナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾコノ髯ダケハ剃ッテ置キタイナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ颯子モイルコトダシ、―――颯子ハ南禅寺ヘ泊ルノハ懲リ／＼ダカラ、ソレダケハ堪忍シテクレト云ッテルンダ」「ドッチニシタッテ颯子ガ行ッタラ又喧嘩デスヨ」「掴ミ合イデモ始メテクレタラ面白イサ」婆サントソンナ遣リ取リヲスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来得レバ他ノ何者ニモ気付カレズ、予一人ニダケ、全ク予一人ニダケハッキリト感ジ取ラレルヨウニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体妻ハ来客ニ対シテハ不愛想デ、コトニ男ノ客人ニハ会イタガラナイノデアルガ、木村ニダケハ親シムノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダ敏子ダケハ、三人デ酒ガ始マルト必ズ嫌ナ顔ヲシテ自分ダケサッサト切リ上ゲテ出テ行ッテシマウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピアノダケハ運搬ノ都合デ二三日｜後レルガ、他ノ荷物ハ木村ガ手伝イニ来テ大体運ンダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ニダケハ見ラレテモ仕方ガナイ」ト云ッタラ、「場所ハナイ※モアリマセン、宿ノ主人ニ話シテ見マショウ」ト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ癖長イ間ノ習慣デ机ニ向ッテダケハイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いま出て来るぞ」と、言い終らぬ間に、船底から大きく、「助ケテ下サイ、手向イシマセン」「命ダケハ、助ケテ下サイ」という英語の悲鳴が聞えて来た。",
              "citation": {
                "source": "流血船西へ行く",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレダケハイケマセン。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレダケハヤメテ下サイ」炎のような球体が十億年ぶりにあなたに思念を送ってくる。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
