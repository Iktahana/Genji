  {
    "uuid": "735991f5-9d1c-5271-8724-e3d153a00fb8",
    "entry": "ダケ",
    "reading": {
      "primary": "だけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "浴衣一枚の胸をハダケて、恐らく我々が来るまで、彼は頭をカカへてゐたに違ひなかつた。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンニモシナイ、コレダケノモノ、キレイデショ？",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イマ、イチドダケ、オユルシ下サイ。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」無理カモ知レマセヌガ　とまた、うつむいて、低く呟くやうにおつしやつて、ソレダケガ生キル道デス　尼御台さまは、すつと細い頸をお伸ばしになり素早くあたりを見廻しました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラ磯ニ浪ノヨルヲ見テヨメル大海ノ磯モトドロニヨスル波ワレテクダケテサケテ散ルカモ　一言の説明も不要かと存じます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ都所ノ別当ニダケハ、ナツテモヨイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "異人ハタヨルベカラズ、就イテ少シク学ブダケデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "太宰イツマデモ病人ノ感覚ダケニ興ジテ、高邁ノ精神ワスレテハイナイカ、コンナ水族館ノめだかミタイナ、片仮名、読ミニククテカナワヌ、ナドト佐藤ジイサン、言葉ハ怒リ、内心ウレシク、ドレドレ、ト眼鏡カケナオシテ、エエト、ナニナニ？",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　無理カモ知レマセヌガ　とまた、うつむいて、低く呟くようにおっしゃって、　ソレダケガ生キル道デス",
              "citation": {
                "source": "鉄面皮",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、工場ヤ、銀行ヤ、病院ヲ守ッテイルダケデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "満洲ハタダ大資本家大地主ヲ太ラセルダケダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイロイロナ構図デ頭ガイッパイニナッテイルノデスガ、ナニシロマダカクダケノ腕ガナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オンナジヤウナ　カタチヲ　シテ　ヰテモ、フエナンカ　ピロ　ピロト　ナクダケヂヤ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、イタチダケヲ　ヨバナイト　イタチハ　キツト　オコルニ　チガヒ　アリマセン。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
