        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日はバイキングだから、好きなものを好きなだけ食べていいよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "努力しただけ結果がついてくると信じて、最後まで走り抜ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "できるだけ早く対応してください",
