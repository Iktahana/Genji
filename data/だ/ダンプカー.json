        "examples": {
          "standard": [
            {
              "text": "工事現場の前に大型のダンプカーが止まり、荷台を上げて砂利を一気に落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ダンプカーが左折するとき、後続の自転車が巻き込まれそうになって肝を冷やした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "山の造成工事で、ダンプカーが夜明けから日暮れまで土砂を運び続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが東海道は、わけて濃尾平野の街道ときては、いまやここも団地とダンプカーと新工場建設などの花ざかりで、春のドライヴというには少々縁の遠いものだった。",
              "citation": {
                "source": "随筆　私本太平記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "近年トラック輸送やダンプカーや、また私たちのような自動車旅行者のふえたおかげというしかない。",
              "citation": {
                "source": "随筆　私本太平記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
