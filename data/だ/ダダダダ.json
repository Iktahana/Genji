        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "便所は、階段を降りて、すぐ右だ」　だだだだと階段からころげ落ちるように騒々しく下へ降りて行って、それっきり、しんとなった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "朱の盤　だだだだだ。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘリコプターから、とつぜん、だだだだッ、だだだだッと、はげしい機関銃が鳴りだした。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに、それがきっかけでもあるかのように、戸外で、だだだだだン、だだだだンと、はげしい銃声がきこえた。",
              "citation": {
                "source": "人造人間の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに、高声器から、だだだだンと、はげしい機関銃の音が聞え、画面で見ていると、扉と向いあった壁から濠々と煙が出て来た。",
              "citation": {
                "source": "大使館の始末機関",
                "author": "――金博士シリーズ・７――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だだだだッと、「赤毛のゴリラ」は銃丸のために後に吹きとばされドターンと仰向けに斃れてしまった。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "武太夫の体は飜筋斗を切って、だだだだだと梯子段を転げ落ちた。",
              "citation": {
                "source": "松林蝙也",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうもうと立ちこめる硝煙、だだだだあーんととどろく銃声、剣は槍とあい打ち、騎馬ととびかい、あい組み、あい討ち、おしつかえしつもみあううち、どうしたことか、長曾我部勢の一角がどっとくずれたった。",
              "citation": {
                "source": "だんまり伝九",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だだだだっと、ひどい音を立てて、尻もちをついたなり、身うごきもしないで痛さをこらえている悠吉が、やっといきをつきながら最初にいった言葉は、「お前でなくてよかったなあ！",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "――と思うと、　だだだだッと、堂のすぐうしろ辺りで、峰道から人の足音が雪崩れて来た。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいて、盤の駒が、一面に飛んだような物音と共に、大廊下のほうへ、だだだだと、逃げてゆく跫音がした。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのまま、二つの体が弓形になって、だだだだと、後へよろめいた。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、その山伏が、「あっ」　といったのと、伊織が渓流の瀬で、畜生っとさけんだのと、同時であって、山伏の足は五、六歩ほどそのまま、だだだだと土橋を往来のほうへ踏み退いた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "曹軍の麾下にも張飛以上の者あることを、今ぞ確とご覧あれ」　と喚きながら、馬の蹄をあげて、だだだだっと、橋板を踏み鳴らして、張飛のそばへ迫りかけた。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "だだだだっと、双方の駒がうしろへよろめく。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「なにッ」「ごめん」　在房は、とつぜん、手の脂燭を捨てて、だだだだッと、逃げまろんだ。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "があっーん、　だだだだっ、　というような地崩れとも砲声ともつかない音響に交じって、人馬の声と、金属的な響きとが、絶えず鼓膜を圧してくる。",
              "citation": {
                "source": "大谷刑部",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "昇る時は、ドスンドスン、降りる時はころげ落ちるみたいに、ダダダダダ。",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやになりますよ、ダダダダダと降りてそのまま御不浄に飛び込んで扉をピシャリッでしょう。",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯痛には、あのドスンドスンもダダダダも、ひびきますよ。",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダダダダッと銃丸は天井に向けられ、シャンデリアに当って、硝子の砕片がバラバラと墜ちてきた。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、思うと、　ダダダダダダ！",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘクザ館のありかを探しているのだ」　戸倉老人が叫んだとき、ダダダダダと物凄い音を立てて、機関銃がうなりだした。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダダダダダダダダダ！",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダダダン、ダダダダン。",
              "citation": {
                "source": "大空魔艦",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこをつづいて、ダダダダンとうつ。",
              "citation": {
                "source": "大空魔艦",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「撃ち方ァ始めッ」　ダダダダダダダダーン。",
              "citation": {
                "source": "崩れる鬼影",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒューンといなないては宙返りをうち、ダダダダダーンと、敵機にいどみかかるわが防空戦闘機。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうわけで、田端の駅は、その高台からまるで燈台の螺旋階段のように急な三折ほどの坂道で、ダダダダと駈けおりたところに在った。",
              "citation": {
                "source": "田端の汽車そのほか",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "降りきってしまうと、降りた姿で、つまり後向きのまま、にわかにダダダダッとこの急坂を駈け登るというんですなア。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
