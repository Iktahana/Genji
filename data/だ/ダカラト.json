          "literary": [
            {
              "text": "九十ニナッテモ子ヲ産ンデミセルト云ウ久原房之助ノヨウナ精力ハナク、既ニ全ク無能力者デハアルガ、ダカラト云ッテイロ／＼ノ変形的間接的方法デ性ノ魅力ヲ感ジルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ彼ガ、イクラ親父ノ髯ダカラト云ッテ、大事ナ女房ニ本気デ剃ラセル気ガアルンダロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、ダカラト云ッテ、二人ノ間ニ不倫ナ関係ガ成リ立ッテイルト云ウ證拠ハナイシ、ソンナコトヲ信ジル者ハ一人モイナイヨト、ソウ云ウト、本当ニ一人モイナイデショウカ、ト、五子ハ妙ナ笑イ方ヲシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
