        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ダニエル・ダリュウじゃないの。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダニエル・ダリュウ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ダリュシカ、昼食でも遣りたいものだな。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、時々厨房の戸が開いて、ダリュシカの赤い寐惚顔が顕われる。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ダリュシカ、ビールでも欲しいな。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "厨房からダリュシカが鈍い浮かぬ顔で出て来て、片手で頬杖をして、話を聞こうと戸口に立留っている。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、ダリュシカは感心して聞いている。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもなら院長は自分の室から室へと歩いていると、ダリュシカが、麦酒は旦那様如何ですか、と問う刻限。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダリュシカは旦那が近頃は定刻に麦酒を呑まず、中食までも晩れることが度々なので困却っている。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒店には麦酒の払が三十二｜円も滞る、家賃とてもその通り、ダリュシカは密に古服やら、書物などを売っている。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いてダリュシカも来、何とも云えぬ悲しそうな顔をして、一｜時間も旦那の寐台の傍にじっと立たままで、それからハバトフもブローミウム加里の壜を持って、やはり見舞に来たのである。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "その祈祷式に預ったのは、ただミハイル、アウエリヤヌイチと、ダリュシカとで。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレクシスの遺骸はダリュ街のソポール（露国寺院）の附属墓地へ葬りました。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "（と、そう云ってお春は、そうそう、そのレコードはあれでございます、ほら、あの、ダニエル・ダリュウが「暁に帰る」の中で謡いました、あの唄でございます、と云ったりした）で、自分がその家を見に行ったのはその時だけである。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
