    "definitions": [
      {
        "index": 1,
        "gloss": "waiting in place of someone else",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "人気ラーメン店の行列で、夫が先に並んで私の分の代待ちをしてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「代待ちは禁止です」と看板に書かれているので、全員揃ってから並ぶ必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "駐車場が満車だったので、入り口で代待ちをして空きが出るのを待った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ただいまちょうど五時でございます」　「うん、わしはゆうべ一晩ねむらなかった。",
              "citation": {
                "source": "四又の百合",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとまりは、ただいまちょうどお風呂が口あきでございます。",
              "citation": {
                "source": "口笛を吹く武士",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、上方で、こやつは何と申しておったか、ただいまちょっと失念いたしたが、むこうで会うたこともあるし、わしは、人の顔を見違うことはない。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただいまちょうど青年叢書という叢書物を作っています。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
