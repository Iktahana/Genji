        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "時々ダーターファブラと言う。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "与次郎はますます得意になって、ダーターファブラ我々新時代の青年は……とやっている。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーターファブラ、シェクスピヤの使った字数が何万字だの、イブセンの白髪の数が何千本だのと言ってたってしかたがない。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "与次郎の隣にいた者が、「ダーターファブラのために祝盃をあげよう」と言いだした。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーターファブラとはなんの事だ」「ギリシア語だ」　与次郎はそれよりほかに答えなかった。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四郎が、小さな声で、「ちと、ダーターファブラをやらないか」と言うと、「きょうはいけない」と答えたが、すぐ横を向いて、隣の男と話を始めた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて与次郎に尋ねたら、おそらくダーターファブラのたぐいだろうと言っていた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダーターファブラはおどるべき性質のものと思える。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
