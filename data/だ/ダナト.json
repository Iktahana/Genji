        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大砲をうつとき、片脚をぷんとうしろへ挙げる艦は、この前のニダナトラの戦役での負傷兵で、音がまだ脚の神経にひびくのです。",
              "citation": {
                "source": "烏の北斗七星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ　テツキリ、ジブンヲ　コロシテ　カネヲ　トルノダナト　オモヒマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、カワイイ　テダナト　オモヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカアサンハ、ミチコサンハ　イヽ　コダナト　オモイマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢ガコンナニ生々シイ色ヲ帯ビテ見エルノハ神経衰弱ガヨホドヒドイ証拠ダナト、夢ノ中デハッキリトソウ思イナガラ、僕ハジーットソノ夢ヲ視ツメテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
