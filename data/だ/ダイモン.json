[
  {
    "uuid": "adf69ad9-48d5-5f33-b245-2a52c325ccd5",
    "entry": "大門",
    "reading": {
      "primary": "だいもん",
      "alternatives": [
        "おおもん"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
