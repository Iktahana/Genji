          "literary": [
            {
              "text": "固より法然は天台門から出た人ではあるが、今は自ら浄土の法門を開いた別宗の人の形になっている。",
              "citation": {
                "source": "法然行伝",
                "author": "中里介山",
                "note": "青空文庫"
              }
            },
            {
              "text": "松岡家の本山は妙徳山神積寺というやや格式の高い天台門の寺院だったから問題になり、親孝行のためとはいいながらも本山から訴訟されて追放になり、娘（私の祖母）をつれて京都へ引き移った。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十一　其日の夕方車ががら／＼と三臺門前に止つたと思つたらそれは文太郎と嫂のお金と四人の子供とであつた。",
              "citation": {
                "source": "續俳諧師",
                "author": "――文太郎の死――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
