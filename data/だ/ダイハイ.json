          "literary": [
            {
              "text": "無坪さんから酒代拝受。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙさんから句集代拝受、感謝々々。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "素此祠は阿部家に於て由緒あるものであつたので、祭日には阿部侯の代拝者が来た。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして土井家の菩提寺たる浅草の誓願寺へ、土井家の代拝として参詣した。",
              "citation": {
                "source": "『雪華図説』の研究後日譚",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "国主の代拝もあり、諸士会葬して、藩葬ともいえるような盛儀であったという。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
