    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "次はラクシャン第三子やさしい眼をせはしくまたたきいちばん左はラクシャンの第｜四子、末っ子だ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」しづかなラクシャン第三子が兄をなだめて斯う云った。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第三子が少し笑って弟に云ふ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第三子はしばらく考へて云ふ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第三子もつい大声で笑ってしまふ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しづかなラクシャン第三子がラクシャンの第｜四子に云ふ「空が大へん軽くなったね、あしたの朝はきっと晴れるよ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」兄のラクシャン第三子が「よせよせいたづらするなよ」と止めたがいたづらの弟はそれを聞かずに光る大きな長い舌を出して大学士の額をべろりと嘗めた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "次はラクシャン第三子やさしい眼をせわしくまたたきいちばん左はラクシャンの第｜四子、末っ子だ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」しずかなラクシャン第三子が兄をなだめて斯う云った。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第三子が少し笑って弟に云う。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第三子はしばらく考えて云う。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第三子もつい大声で笑ってしまう。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しずかなラクシャン第三子がラクシャンの第｜四子に云う「空が大へん軽くなったね、あしたの朝はきっと晴れるよ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」兄のラクシャン第三子が「よせよせいたずらするなよ」と止めたがいたずらの弟はそれを聞かずに光る大きな長い舌を出して大学士の額をべろりと嘗めた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大日本史は系図に拠つたと見えて第三子としてゐるが、第二子としてゐる人もある。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "長子将持、次子将弘、第三子将門、第四子将平、第五子将文、第六子将武、第七子将為と系図には見えるが、将門の兄将弘は将軍太郎と称したとある。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "国香は既に老衰して居た事だらう、何故といへば、国香の弟の弟の第二子若くは第三子の将門が既に三十三歳なのであるから。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三子（男であつた）も同じ病氣であつたが、母に抱かれながら、なぜこんな苦しい目に會はせるのかと云ふやうな目附きを殘して死んだ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一子の時は初めての子でもあるし、二年二ヶ月も生きた記念があるので、殘念に思つたが、第三子は自分からの子として二度目の死でもあるし、たツた九ヶ月をさう抱きもしなかつたから、惜しくはなかつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、第三子の時は、滋賀縣の大津で無式で濟ませた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "直賢に素直道、直温の二子があつて、其次の第三子が直養である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その三百十一　此年文久辛酉に柏軒の第三子平三郎が生れた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "正方は伊予守正寧庶出の第三子で正教の弟である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それゆゑ兄芸庵の第三子円庵を養つて子としたが早世した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十三年二月四日磐の第三子｜玄隆が生れて夭した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十年二月二十五日徳の第三子｜信道が生れた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十三年八月二十三日徳の第三子信道が四歳にして夭した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "九州天草大矢野郷越野浦の郷士であり曾ては小西行長の右筆まで為た増田甚兵衛の第三子でありましたが何より人を驚かせたのは其珠のような容貌で、倫を絶した美貌のため男色流行の寛永年間として諸人に渇仰されたことは沙汰の限りでありました。",
              "citation": {
                "source": "天草四郎の妖術",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄塔はその第三子なり。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ジョージ二世の第三子、イギリスの将軍であるウィリヤム・オーガスタス（一七二一――一七六五）。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
