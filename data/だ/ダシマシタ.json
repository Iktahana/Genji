        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレデ、コノ　ウグヒスハ、オカアサンヲ　ナクシタ　コドモノ　フク、カナシイ　ウグヒスブエノ　オトヲ　キクト、ナクシタ　ボウヤノ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "中ノ　サムライハ　マツサヲニ　ナツテ　フルヒダシマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カタツムリガ　ツノヲ　フツテルノヲ　ミテ　ヰルト、王サマハ、子ドモノ　ジブン、何ダカ、カタツムリノ　ウタヲ　ヨク　ウタツタ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレト　一シヨニ、ソノ　ウタヲ、ヨク　ウタツテ　下サツタ、ヤサシイ　オ母サンノ　コトモ　オモヒダシマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ホソイ　メヲ、アタマノ　ウエニ　ソーツト　ダシマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イフト、ヒヤクシヨウハ、「イイトモ、ホラ、ヤキタテノ　パンヲ　五ツ　アゲヨウ」ト　イツテ　セナカノ　フクロカラ　パンヲ　ダシマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コドモダヌキハ、イマニモ　ツブレサウデ、オモハズ、「グツ　グツ」ト　コヱヲ　ダシマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「グツグツグツ、カアチヤン」　コドモダヌキハ　タマラズ　トウトウ　オホキナ　コヱヲ　ダシテ　ナキダシマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トオネコサンハアカダラケノ洋服ヲダシマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジロウハ　ナキダシマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ジロウハ　トビアガツテ　オホキナコエデ　ウタツテ　ワラヒダシマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チビスケハ　ビツクリシテ　ナキダシマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギンザヲトホルト、クマノ　トムクント　メリーサンハココハ　ボクシッテヰルアタシモ　シッテルワトオホキナコヱヲ　　　　　ダシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "サァ　コレカラドウシテ　オウチヘ　カヘロウカト、ミンナハ　シクシク　ナキダシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
