        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供が父親のことを親しみを込めて「ダディー」と呼ぶ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女はダディーに買ってもらったプレゼントを大切にしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「ダディー、遊んで！」と子供が駆け寄ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ダディーは長野宇平治氏と話し、オーケストラは鳴る。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダディーはかえらず。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダディーの手紙は、理智的で、何か心がつめたく成るようなものが在る。",
              "citation": {
                "source": "日記",
                "author": "一九二〇年（大正九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "グルグル廻る戸から出た彼の印象、妻沼さんのダディへのインビテーションをホールできき、いそいで、オムレットをたべて出かけた。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十九日　ホテルで一緒に食事をし、夜はグランパがダディの packing を手伝う。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十日　ダディを二時四十分の汽車に見送り、三人で（三浦鍋太郎、矢野）サブに乗り、村川氏に会いたいと云うので、送ろうとするＡを強いて一〇三町目でおろす。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五日　ダディよりの報知、帰ると決心する。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女房の手紙によると、子供は汽車がダディを連れて行ったと思っている。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから汽車がダディを連れて帰って来るといって、汽車が通るたびごとに窓の所へ走って行く……という話から、兄弟のこと、細君の兄弟のこと、誰かと喧嘩したことなど、およそ三十分も、南部なまりで喋った。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "初期の『クローダディ』や『フュージョン』がぼくをどれだけ力づけてくれたかは、言葉で書くことができない。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
