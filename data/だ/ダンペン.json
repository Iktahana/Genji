  {
    "uuid": "5e359d45-5929-5190-b187-838bb5f783c0",
    "entry": "弾片",
    "reading": {
      "primary": "だんぺん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
