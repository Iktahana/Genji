        "examples": {
          "standard": [
            {
              "text": "スポーツ外来の医師に「第四趾の付け根に炎症があります」と診断された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "シューズのサイズが合わず、第四趾にマメができてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "足の骨折を疑いレントゲンを撮ると、第四趾の基節骨にひびが入っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "僕は十八日に右足第四趾切斷、十二年の一月四日に足頸から落して、病み臥せばあけくれなくてをりをりに窓邊にいづる月は浮べり、といふ長い病院生活をしてゐた。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "左足ノ第四趾ト第五趾ガ全ク麻痺シテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
