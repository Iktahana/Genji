        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "留紅草、樽形の花、その底にダナウスの娘たちが落ちてゐさうな花、人間の弱い心臟の血を皆｜關はずに吸いこむため、おまへの唇には痍がある。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はどんな堅い書物とも交わりを結びませんでしたが、プルタルコスとセネカだけは例外＊で、私はここに、まるでダナウスの娘＊＊たちみたいに、満たしたりこぼしたり致しながら、始終汲んでおります。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊＊　アルゴスの王ダナウスに五十人の娘があり、いずれも結婚の夜、その夫をきらってこれを殺した。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
