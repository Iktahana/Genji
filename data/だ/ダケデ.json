        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "異人ハタヨルベカラズ、就イテ少シク学ブダケデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、工場ヤ、銀行ヤ、病院ヲ守ッテイルダケデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシマズ最初ニ新聞ダケデモカタカナニナツテシマエバアトハ割合ラクデアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ニハ清三ガ道子ノ夫ダトイウ事ダケデ、清三ノ存在ガ呪ワシイモノダッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "清三ノ方ハ病人デスカラ頭ヲ殴ッタダケデモ何トカ始末ガツクト考エタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "當時近隣デハ隅田川添ノ今戸橋白髯橋間ノ狹イ地帶ニ火ノ手ガ見エナイダケデ、西ハ龜岡町、吉野町、山谷町、玉姫町イヅレモ火ノ手ガ盛デアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩一晩ダケデス、明日コノ川下ルト海ニ出マス、海ニ出ルトソノ黒船ガ待ッテイルデス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレダケデモ来タ甲斐ガアルト思ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ハアノ揚巻ノ顔ヲ見テルダケデモイクラカ痛ミヲ忘レルンダ」予ハ婆サンニ窘メラレテ一層｜依怙地ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハコルセットヨリ柔イ布デ頤ヲ吊ルダケデアルカラ、コルセットホド窮屈デハナイガ、首ヲ動カセナイコトハ同ジデ、天井ヲ睨ンダマヽデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ顔ノ女ヲ見ルト、顔ダケデナク、性質モ残虐デアルカノヨウニ思イ、又ソウデアルコトヲ希望スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "看護婦ガ予ノ隣ノベッドニ寝ルノハ夜間ダケデ、晝間ハ普通自分ノ部屋ニイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハ支度ダケハ甲斐々々シイガ、離レタトコロカラ見テイルダケデ、ロクニ何モシテクレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "首ダケデ他ノ部分ハ見エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガソレダケデハ済マナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "正午食堂デ晝餐、大概素麺一杯ト果物一箇ダケデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ唇ダケデナクッテモイヽ、舌ヲ着ケテモイヽ」予ハ七月二十八日ト同ジ姿勢デ、彼女ノ脹脛ノ同ジ位置ヲ唇デ吸ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ左足ダケデナク、左右両方デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨デ庭ニハ出ラレナイガ、廊下ヲ散歩スルダケデモ容易デナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "掌ダケデナク、手頸ノ方ニカケテ、小指ニツヾク尺骨ノ茎状突起、及ビ橈骨ノ突起マデ痛ミ、手頸ヲグルリト廻ソウトスルト殊ニ痛ンデ巧ク廻ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウソノ緊迫シタ雰囲気ニ包マレルダケデモ死ニハシナイカナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤリ損ッタッテ死ニハシナイヨ」「死ニハシナイデモ、気絶シテ今ニモ死ニソウニオナリニナッタリシタラ、ソレヲ見テルダケデモイヤダワ」「コンナ思イヲシテ生キテルクライナラ死ンダッテイヽサ」予ハ殊更ニ悲壮ラシク云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ爺サンハ発狂シテルノデハナイカト、思ワレルダケデモ極マリガ悪イ）予ハコヽマデ思イ詰メテ、コヽニ一ツノ可能ナ方法ガアルカモ知レナイコトニ気ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ノ足ヲモデルニシタ佛足石ノ存在ヲ考エタダケデ、ソノ石ノ下ノ骨ガ泣クノヲ聞ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "連レ添ウテ二十何年ニモナリ、嫁入リ前ノ娘サエアル身デアリナガラ、寝床ニハイッテモイマダニタダ黙々ト事ヲ行ウダケデ、ツイゾシンミリトシタ睦言ヲ取リ交ソウトシナイノハ、ソレデモ夫婦トイエルデアロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ニソウイウ自覚ヲ与エルヲ禁ジ得ナイノデハナカロウカ）僕ハ彼女ノアノ長所ヲ考エタダケデモ嫉妬ヲ感ズル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトニ足首ノトコロガ十分ニ細ク括レテイナイノガ缺点ダケレヲ許サレテイタダケデ、コノ素晴ラシイ肉体ヲ眼デ視ルヲ得ル夫ハ、今カラ新シイ結婚ヲ始メルノト同ジダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ上僕ハ精力ノ補給ヲスルタメニ相馬博士ニ相談シ、大体月ニ一回男性ホルモンノデポヲ用イテイルノダガ、ソレダケデハマダ不足ナ気ガシ、脳下垂体前葉ホルモンノ五百単位ヲ三日カ四日オキニ注射シテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "滅多に顔を見たことのない伯父さんから届いた電報は、「タノンダカネハンブンダケデンポウデスグネガウ」　とあった。",
              "citation": {
                "source": "或良人の惨敗",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "サエ生ヤセバオマエハ何モ考エルコトモ悩ムコトモナク、タダ私ノ命令二従ッテイルダケデ生キラレルノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
