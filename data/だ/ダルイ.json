[
  {
    "uuid": "594f9daa-6511-5f96-8cfc-a55633294855",
    "entry": "怠い",
    "reading": {
      "primary": "だるい",
      "alternatives": [
        "ダルい",
        "たるい"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
      ],
      "ctype": "形容詞",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "sluggish",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "風邪で熱があるので、体がだるい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昨日の運動のせいで、今日は全身がだるい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "朝起きても、なぜか体がだるい日が続く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "気分すぐれず、身心の倦怠いかんともしがたし、行乞もやめて終日独居、ぼんやりして一句もなし。",
              "citation": {
                "source": "行乞記",
                "author": "仙崎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのなよなよした姿のほほえみが血球となって、僕の血管を循環するのか、僕は筋肉がゆるんで、がッかり疲労し、手も不断よりは重く、足も常よりは倦怠いのをおぼえた。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上、寒気はする、頭は重し、いや、耐らぬほど体が怠い。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "魂を激しい愛――愛と云うものを理解した愛――でインスパイアしてくれるどころか、只怠いくつな寄生虫となって、無表情の顔を永遠の墓場まで並べて行かなければならない――。",
              "citation": {
                "source": "Ｃ先生への手紙",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅と桜　何事にも走りを好む江戸ッ児の気性では、花咲かば告げんといいし使いの者を待つほどの悠長はなく、雪の降る中から亀戸の江東梅のとさわぎまわって蕾一つ綻びたのを見つけてきても、それで寒い怠いも言わず、鬼の首を取りもしたかのように独り北叟笑んで、探梅の清興を恣にする。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼も起ちあがって勘定をはらってそこを出たが、ひどく倦怠いような気持になって、げっそりしていた。",
              "citation": {
                "source": "孤独",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "解き放されたような気怠い疲労の眼で女神の顔を見ているうち沈み加減なその横顔の美しさに彼は胸が不思議に波立つのを感じた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "食卓の上が片づいてから気怠い満腹のままコーヒーになった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるだけ快活にしていることに努めてみても、ともすると、黙り込むことが多くなり、疲労のような気怠い重味を胸に覚えてときどき雪の中へ立った。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "倦怠いような、銷沈いような、頭の血がすっと下ったという感じで、まるで夢見るような気持で、彼は手に持った二つの名を、ぼんやりと見詰めているのだ。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九日　六時頃まで眠つたり覚めたりして居たが今日も身体は怠い。",
              "citation": {
                "source": "六日間",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……だが何うも体が怠い」寝台の上へ起き上った。",
              "citation": {
                "source": "天主閣の音",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……だが何うも体が怠い」「そいつあ何うも仕方がねえ。",
              "citation": {
                "source": "天主閣の音",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "乱れた紙は、静なるうちに、惓怠い伸をしながら、下から暖められて来る。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "幌馬車が倦怠い埃を立てゝ走る。",
              "citation": {
                "source": "八月の星座",
                "author": "吉田絃二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間のうちに悠に二番ぐらいは始末ができるくらいだから、見ていても局に対っていても、間怠い思いはけっしてないのです。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "為事するあいだは熱のあるように妙に怠い躯が乗物で須磨へ近づくと次第に元気を恢復するようだった、朱筆を持って努めて睡気と戦っていた眼が、家の門を入るとはっきり醒める気がした。",
              "citation": {
                "source": "須磨寺附近",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その条件とは、「兵庫｜事は、天性、御奉公を懈怠いたすようなものではござらぬが、何といっても、若年者、それに短慮のところもありますゆえ、落度あっても、死罪三たびまでは、お宥しありたい」　ということであった。",
              "citation": {
                "source": "剣の四君子",
                "author": "柳生石舟斎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だるい、ものうい、眠い、真夜中のうだるような暑さの中に、それと似てもつかない渦巻が起った。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "けだるい雨がぽつりぽつり降って来た。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「下駄は足がだるい。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃は体がだるいと見えてお惰けさんになんなすったよ。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてしきりに、頭の工合のよくなって息のはあはあや、からだのだるいのが治ってそしてもっと物を沢山おいしくたべるやうな薬をさがしてゐましたがなかなか容易に見つかりませんでした。",
              "citation": {
                "source": "よく利く薬とえらい薬",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その心持ちには、やれ手を使って与えようとか手を使わずに与えようとかそんなまだるい考えの這入る余地は無い筈です。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、手がだるい、まだ？",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "前後一週間の間に、五円の資本が山分けして八倍になり、もうこの婆さんさえしっかり掴えて居れば一儲け出来ると、腰が抜けそうにだるいという婆さんの足腰を温泉で揉んでやったり、晩には酒の一本も振舞ってやったりして丁重に扱っていたが、湯崎へ来てから丁度五日目、ほんまに腰が抜けたと寝こんでしまった。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝のうちは伊佐行乞、それから麦川へ、途中あまりだるいから村の鎮守の宮で昼寝、涼しい社殿だつたが、村の悪童共の集合所でもあつたので騒々しかつた、それでも二時間ぐらゐは寝たらう。",
              "citation": {
                "source": "行乞記",
                "author": "大田から下関",
                "note": "青空文庫"
              }
            },
            {
              "text": "街へ、飲みすぎ食べすぎのたたりてきめん、身心がだるい、熱い溢れる湯にはいりたくなり湯田へ行かうかとも思つたが止めにして戻る。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大の男がそんなまだるいことがしていられますか。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後、さまざま画いてみても、その思い出の中の逸品には、遠く遠く及ばず、自分はいつも、胸がからっぽになるような、だるい喪失感になやまされ続けて来たのでした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
