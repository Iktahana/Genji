        "examples": {
          "standard": [
            {
              "text": "このドレスは、深みのあるダークブルーで、夜空のような上品な色合いだね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "寝室の壁をダークブルーにしたら、とても落ち着いた、リラックスできる空間になったよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "夜の海は、深いダークブルーに染まり、静かで神秘的な雰囲気だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ダークブルーの天地、紫のような地面にホッサリとしげって居る麦の若い体が、一吹風が渡るごとに何とも云えないかおりを立ててサヤサヤとそよぐ。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            }
          ]
