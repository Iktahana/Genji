[
  {
    "uuid": "e5db0298-8797-5525-9e4b-10f762d3bba6",
    "entry": "だぼ鯊",
    "reading": {
      "primary": "だぼはぜ",
      "alternatives": [
        "ダボハゼ"
      ],
      "is_heteronym": false
    },
    "grammar": {
