[
  {
    "uuid": "43e6c634-720c-52df-b600-7ab1444b1c27",
    "entry": "断書",
    "reading": {
      "primary": "だんしょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "寄ってくれた人たちは当然のこととして、診断書のこと、死亡届のこと、埋葬証のこと、寺のことなど忠実に話してくれる。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「医者に診断書をとりに行つたんだ」　とにかく、死人の父の意嚮に従つて葬式を出さねばならなかつたので、医者の待合室に待つてゐるだらう万福の父に相談して、それから川向ひの製材所に行つて、棺桶の板を持つて来よう、と云ふことにして、私たちは歩き出した。",
              "citation": {
                "source": "万福追想",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "診断書を書いて上げようかね」といって、医者は、診断書を書いて渡した。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "診断書が、百通あってもだめだろうとは思ったが、とにかく、それは、一つの有力な味方であった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "今では、実際の負傷や疾病よりも、診断書の方が、重大な意義を持っているのだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場医は、資本家の診断によって診断書を書く、という役目だけを勤める場合が多かった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それの診断書だけに驚くのであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、この診断書は、幾分なりとも、何らかの衝動を与えまいものでもない、と三人は空頼みにした。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "検事は、机の上の医師の診断書に眼を落しながら、「君は、肺がわるいのだね？",
              "citation": {
                "source": "あさましきもの",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じゃ、先生、この森と柴田の死亡診断書にゃ、坑内で即死したと書いて呉れますね。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで医者の診断書を取ってくる。",
              "citation": {
                "source": "外米と農民",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "初は一週間の病気届、これは正規で別に診断書が要らない、其次は診断書が付て五週間の欠勤。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "＝暗転＝「――そんなわけで、私が手にかけて殺したわけではなく、医者の死亡診断書の通りなので御座いますが、その髪を抜いたり眉毛を抜いたり、その上に八つに切り刻むなど、随分と残酷なことをいたしました。",
              "citation": {
                "source": "三稜鏡",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者の診断書から心臓痲痺を、新聞記事から神経衰弱が抹殺されて、民衆の死因の公平なる発表がされるのはいつたい何時のことだらう。",
              "citation": {
                "source": "小熊秀雄全集-6",
                "author": "詩集（５）飛ぶ橇",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれ」　自分は右の手に握っていた診断書を、つい忘れて、おやどこへやったろうかと、始めて気がついた。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかの病気の診断書付きで。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつが吾輩と同様｜独身者の晩酌で、羽化登仙しかけているところへ、友吉の屍体を担ぎ込んで、何でもいいから黙って死亡診断書を書いてくれと云うと、鶴髪童顔先生フラフラの大ニコニコで念入りに診察していたが、そのうちに大声で笑い出したものだ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と思っている者等は、医者に「診断書」を書いて貰うように頼むことにした。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時の抗議のために診断書は必要だった。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "診断書を作って貰いたいんですけれどもと、一人が切り出した。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、診断書はねえ……」「この通りに書いて下さればいいんですが」　はがゆかった。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この前、浅川君になぐられて、耳が聞えなくなった漁夫が来たので、何気なく診断書を書いてやったら、飛んでもないことになってしまってね。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "医師は診断書に肺結核と書いたが、父母はそんな病気が家の血統にあるわけがないと言って、その医師の診断書を信じなかった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてその返事が来て埼玉県令十号の十三条に六十日の病気欠席は全俸（願書診断書付き）その以後二か月半俸としてあることを報じて来た。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "お医者さんの診断書貰うて、役場へ死亡届出さにゃ叱られるわして。",
              "citation": {
                "source": "南北",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者の死亡診断書もここへきとる」「その診断書をちょっと拝見できませんか？",
              "citation": {
                "source": "私はかうして死んだ！",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄つてくれた人達は當然の事として、診斷書の事、死亡屆の事、埋葬證の事、寺の事など忠實に話してくれる。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "某町に着いた三名の辯護士は、先づ手はじめに醫師を訪ねてその意見と診斷書を取つた。",
              "citation": {
                "source": "女",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "但馬守が玄竹を愛したのは、玄竹が岡部美濃守の頓死を披露するに最も必要な診斷書を、何の求むるところもなく、淡白に書き與へたといふ心の潔白を知つたのが第一の原因である。",
              "citation": {
                "source": "死刑",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺方が埋葬を斷るのは、検屍を受けない變死人の場合で、醫者の死亡診斷書といふものゝない時代には、これが犯罪｜摘發の最後の手段に用ゐられたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "黒い巾着",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
