          "literary": [
            {
              "text": "昔の人は月を見て、嫦娥やダイヤナのような美人が住んでる、天界の理想国を想像していた。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "使女Ａ　夜を遊ぶダイヤナと申す水鳥でござります。",
              "citation": {
                "source": "レモンの花の咲く丘へ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子　ダイヤナにしては形が大きすぎるじゃないか。",
              "citation": {
                "source": "レモンの花の咲く丘へ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダイヤナはよくあのように列を作って夜を海上で遊びます。",
              "citation": {
                "source": "レモンの花の咲く丘へ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "使女Ｂ　ダイヤナの五六羽が空を翔けたのでござります。",
              "citation": {
                "source": "レモンの花の咲く丘へ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
