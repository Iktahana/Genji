    "definitions": [
      {
        "index": 1,
        "gloss": "diving",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は趣味で週末にスキューバダイビングを楽しんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちはプールで楽しそうにダイビングしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は水中に深くダイビングしていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "加けに私は空力があまつて肩を滑らし、あはやと云ふ間もなく真つさかさまに水中目がけて不慮のダイビングを試み、危うく溺死しかゝつたところを雪五郎に救助された。",
              "citation": {
                "source": "バラルダ物語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この間の晩のダイビングは面白かつた？",
              "citation": {
                "source": "ダイアナの馬",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "溢れんばかりの陽光と雷鳴のようにダイビングする一瞬の身構え、それに波を砕く海風の勝ち鬨のすべてが、この一枚の中にある。",
              "citation": {
                "source": "夏の日の夢",
                "author": "THE DREAM OF A SUMMER DAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "金魚のように尾鰭だけは立派に身につけて大勢と踊るのであったが、朋輩の誰彼が抜手を切って彼女達の彼岸近くへ泳いで行っているのに、下手なダイビングで立ち遅れたのか、伊代は不器用にうろうろして誰からも声をあびせかけられなかった。",
              "citation": {
                "source": "帯広まで",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「行って見ようや」とぼくは村川を誘い、ＫＯの二番の柴山、補欠の河堀とも一緒になって、デッキを降り、食堂に入って行きますと、映画は始まっていて、代表選手の練習を集めた実写物らしく女子選手のダイビングが、空中に美しい弓なりの弧を描いているところでした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、上の甲板からは、ダイビングの女子選手が、胴のまわりを、吊鐶で押えたまま、空中に、さッと飛びこむ。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "死にものぐるいの勢いで無我夢中のダイビング。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、コンビネーション・ダイビングというものを、みなさん知ってますか。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "――高さ一〇メートルの跳び込み台に立って、初めてダイビングをしようとする人間のような顔つきであった。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、そうして、できるだけふりこを大きくして、最後にはパッと手をはなし、隅田川の中へダイビングをするつもりなのです。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ダイビング＝ベルかね。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ダイビング＝ベルというのは、あつい鉄でできた大きな玉のような潜水機です。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばりばりと音たててＫの傘が、バスの車輪にひったくられて、つづいてＫのからだが、水泳のダイヴィングのようにすらっと白く一直線に車輪の下に引きずりこまれ、くるくるっと花の車。",
              "citation": {
                "source": "秋風記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番面白いのは、三艘の大飛行船が船首を並べて断雲の間を飛行している、その上空に追い迫った一隊の爆撃機が急速なダイヴィングで礫のごとく落下して来て、飛行船の横腹と横腹との間の狭い空間を電光のごとくかすめては滝壷の燕のごとく舞上がる光景である。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちばんおもしろいのは、三｜艘の大飛行船が船首を並べて断雲の間を飛行している、その上空に追い迫った一隊の爆撃機が急速なダイヴィングで小石のごとく落下して来て、飛行船の横腹と横腹との間の狭い空間を電光のごとくかすめては滝壺のつばめのごとく舞い上がる光景である。",
              "citation": {
                "source": "からすうりの花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、飛んでいるうちに突然強い腐肉臭に遭遇したとすれば、そこから直ちにダイヴィングを始めて、その臭気の流れを取りはずさないようにその同じ流線束をどこまでも追究することさえできれば、いつかは必ず臭気の発源地に到達することが確実であって、もしそれができるならば視覚などはなくてもいいわけである。",
              "citation": {
                "source": "とんびと油揚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "舟橋聖一氏の作品「ダイヴィング」芹沢光治良氏「塩壺」等、いずれも能動精神を作品において具体化しようと試みられて、当時問題作とされたものであり、三田文学に連載中であった石坂洋次郎氏の「若い人」もやはりその作品のもつ行動性という点で、（行動の方向は評価に際しぬきにされて）注目をひいたのであった。",
              "citation": {
                "source": "今日の文学の展望",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして実際、リッケルトは自然科学に就いて彼が発見したこの方法の規定を、ダイヴィング・ボードとして、その対立物の歴史学（文化科学）の方法を規定したのだったから、その限り、之は歴史学方法に就いての彼の認識の不充分さに対する、間接の批難にもならないではない。",
              "citation": {
                "source": "科学論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の子や、女の子が、二人か三人で、一しょにダイヴィングするのである。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダイヴィングといえば、むかし、立教の原君というのが、なんでもかんでも逆立ちして跳びこみたがる先生で、フンドシ一つでいつもプール際をうろうろしているお行儀の悪い選手であった。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "御利益あらたかであるから、ふとッちょはダイヴィングを見物に行きたまえ。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、こんなにふとッちょのダイヴィング選手というのは、世界になかったことだろうな。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンビネーション・ダイヴィングというのをやると、やっぱり彼が一番早く水面に到着する。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の見てきた女子ダイヴィングではこの選手のフォームが一番よろしいようだ。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "これもコンビネーション・ダイヴィングをやる。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶賀すべき戦後派健全風景で、ダイヴィングがはじまるや、見物衆、「わア。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はストリップ・ファンに改宗をおすすめするが、ぜひダイヴィングを見物して、健康児童になりたまえ。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし、ダイヴィングの選手は短命でしょうな。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人はダイヴィングの要領ですって。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私だったら、ダイヴィングでやるなア」　二人はそんな話をしたことがあった。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
