        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "又、聖徳太子の制定になつた十二階の冠に、改正を加へて、最高の大織冠から最低の立身冠まで、十九階として、血統や家柄に依ることなく、官位を授けられた。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぢやが、大織冠さまの代どころでは、ありは致しませぬ。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳面刀自と申す、大織冠のお娘御でおざります。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "淡海公の孫、大織冠には曾孫。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "淡海公の孫、大織冠の曾孫藤氏南家の族長太宰、帥豊成、其｜第一嬢子なる姫である。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、大織冠さまの代どころではありは致しませぬ。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳面刀自と申す大織冠のお娘御の事で御座ります。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "淡海公の孫、大織冠には曽孫。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃが、大織冠さまの代どころでは、ありは致しませぬ。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳面ノ刀自と申す、大織冠のお娘御でおざります。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "系図の上から申しても、安倍氏は崇神天皇朝四道将軍の一人なる大彦命の後裔、清原氏は天武天皇の皇子舎人親王の後裔、藤原氏は申すまでもなく大織冠鎌足の子孫田原藤太秀郷の後裔ということになっているのです。",
              "citation": {
                "source": "本州における蝦夷の末路",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "是為祈大織冠御影云云。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅若太夫が、大織冠、田歌の二番を舞った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「関白には大織冠鎌足公の御子孫藤原氏の公達がなられるのが定めにございます。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第八巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
