    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一番右はたしかラクシャン第一子まっ黒な髪をふり乱し大きな眼をぎろぎろ空に向けしきりに口をぱくぱくして何かどなってゐる様だがその声は少しも聞えなかった。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "楢ノ木大学士がもっとよく四人を見ようと起き上ったら俄かにラクシャン第一子が雷のやうに怒鳴り出した。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜならラクシャン第一子はやっぱり空へ向いたまゝ素敵などなりを続けたのだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの狂暴な第一子も少ししづまって弟を見る。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」暴っぽいラクシャンの第一子が金粉の怒鳴り声を夜の空高く吹きあげた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第一子は尚更怒って立派な金粉のどなりをまるで火のやうにあげた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」暴っぽいラクシャン第一子がこのときまるできらきら笑った。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "暴っぽいラクシャンの第一子がずゐぶんしばらく光ってからやっとしづまって斯う云った。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ところがラクシャン第一子は案外に怒り出しもしなかった。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャン第一子がびっくりして叫ぶ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」するとラクシャンの第一子がちょっと意地悪さうにわらひ手をばたばたと振って見せて「石だ、火だ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番右はたしかラクシャン第一子まっ黒な髪をふり乱し大きな眼をぎろぎろ空に向けしきりに口をぱくぱくして何かどなっている様だがその声は少しも聞えなかった。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "楢ノ木大学士がもっとよく四人を見ようと起き上ったら俄かにラクシャン第一子が雷のように怒鳴り出した。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜならラクシャン第一子はやっぱり空へ向いたまま素敵などなりを続けたのだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの狂暴な第一子も少ししずまって弟を見る。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ラクシャンの第一子は尚更怒って立派な金粉のどなりをまるで火のようにあげた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "暴っぽいラクシャンの第一子がずいぶんしばらく光ってからやっとしずまって斯う云った。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」するとラクシャンの第一子がちょっと意地悪そうにわらい手をばたばたと振って見せて「石だ、火だ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一子供の時の寫眞から見ると、二十頃の寫眞はまるつきり人相が變つてゐます。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一子供の時の写真から見ると、二十ごろの写真はまるっきり人相が変っています。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そりやア、行くが、ね――」考へて見ると、第一子（女であつた）もヂフテリヤの苦しみに枕もとの小ランプを攫まうとしながら死んだ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一子の時は初めての子でもあるし、二年二ヶ月も生きた記念があるので、殘念に思つたが、第三子は自分からの子として二度目の死でもあるし、たツた九ヶ月をさう抱きもしなかつたから、惜しくはなかつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年の父の葬式は父の信仰に從ひ佛式でやつたし、一昔以上前の第一子の時は、千代子の望みにまかせて耶蘇教式であつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一子供をいじめるほどの強い人では無いと書いてよこした。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一子供が可哀そうで、人道問題やありませんか。",
              "citation": {
                "source": "卍（まんじ）",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンバーワン・ボーイとは、男の第一子つまり長男のことだ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
