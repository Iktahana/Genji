          "standard": [
            {
              "text": "冷戦期の国際秩序は第一世界・第二世界・第三世界という三極構造で語られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "第二世界の国々は独自の経済圏を形成し、西側諸国とは異なる発展路線をたどった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "国際政治学の授業で、第二世界の崩壊が世界秩序に与えた影響を論じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "印度獨立問題ハ來ルベキ第二世界大戰ノ「サラヱウオ」ナリト覺悟スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
