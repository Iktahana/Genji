[
  {
    "uuid": "57183067-9d76-5993-b0f6-a4423aa32e74",
    "entry": "抱き抱える",
    "reading": {
      "primary": "だきかかえる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
