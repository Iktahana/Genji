[
  {
    "uuid": "40aef377-7b38-5e9f-b0e6-cd09f2340bd0",
    "entry": "大悲",
    "reading": {
      "primary": "だいひ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
