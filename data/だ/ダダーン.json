          "literary": [
            {
              "text": "――」　監守の怒号する声、――それにつづいて乱暴にも、ダダーン、ダダーンと拳銃の響き！",
              "citation": {
                "source": "鍵から抜け出した女",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダダーン、ヒューッと、発射された銃弾は帆村たちのいる室内に撃ちこまれた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「撃ち方ァ始めッ」　ダダダダダダダダーン。",
              "citation": {
                "source": "崩れる鬼影",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「中隊長どの、平気の平左であります……」　タダダダーン。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒューンといなないては宙返りをうち、ダダダダダーンと、敵機にいどみかかるわが防空戦闘機。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（左手ばかりをピキピキさせている）友吉　……（壁に顔を押しあてて、ジッとしている）（ダダーンと、かなり遠い所で投弾の地響き。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ダダーンと、さらに近い第四弾。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいじゃ――（その紙包を両手で持って、泣きながら、横丁を走って去る）遠くで、ダダーンと高射砲の音。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くで、ダダーン、ダダーン、ダダーンと、無駄に乱射される高射砲のひびき）金吾　金太、何ともなかったかや？",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くで、ダダーン、ダダーン、ダダーンと続けざまに高射砲の音。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガガ……Ｂ29の大編隊、南方洋上より帝都に侵入しつつあり、ガ、ガ、キイキイ」言ってるそばから、ダダーンダダーンと高射砲のひびきがはじまる）てへへへ、だしぬけだぜ。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダーン、ガラガラガラ、ズシン、　　　ダダーンとすべての物音を叩きつぶすように爆音が鳴りはためく。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダーンと、爆弾が投下されたような、おそろしい水けむり。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
