  {
    "uuid": "18e1006a-7a2c-567c-a79e-931cf48744c1",
    "entry": "ダケレドモ",
    "reading": {
      "primary": "だけれども",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
