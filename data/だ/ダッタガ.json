        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "紳士用ノ特選売場ハ三階ダッタガ、生憎好マシイステッキハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "隙ヲ狙ッテ出タ積リダッタガ、ワタクシモオ供イタシマスト、看護婦ガ見ツケテ附イテ来タノデ一向面白クナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ薬ガ利イタト見セカケテ寝タフリヲスル積リダッタガ、ツイ本当ニ寝テシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭デバーベキューガ始マッタノハ夕刻六時半頃ダッタガ、賑カデ景気ガヨサソウナノデ、予モツイ若イ者タチノ中ヘ参加スル気ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンノチラリト見タヾケダッタガ、変ニ冷イ無愛想ナ顔ヲシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トコロデプールヲ作ル費用ハドノクライカヽルンデス」当然コノ質問ガ来ルコトヲ覚悟シテイタノダッタガ、大婆サンモ小婆サンモツイ取リ紛レテコノ大切ナ質問ヲスルコトヲ忘レテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヽ、直キナオルヨ、………早ク二階ヘ行ッテオ寝、………」予ハソウ云ッタ積リダッタガ、「早ク二階ヘ」アタリカラハ妙ナ濁声ニナッテ何ヲ云ッテルノカ自分デモ分ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年ノ秋、書斎ノスタンドヲ螢光燈ニ改メタノモ、実ハイツカハコウイウ機会ガ来ルデアロウヲ理由ニ螢光燈ニ変エタノダッタガ、―――事実読書ノタメトイウヨリモ僕ハ、イツカハ螢光燈ノ明リノ下ニ妻ノ全裸体ヲ曝シテ見タイトイウ慾望ニ燃エテイタノダッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
