          "literary": [
            {
              "text": "満洲ハタダ大資本家大地主ヲ太ラセルダケダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ家ノ中デ、ソレヲ知ッテイルノハ颯子ダケダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五子トウマク行ク筈ガナイカラ、ドウセホンノ泊メテ貰ウダケダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "来ルトスレバ子供達ダケダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「医者ガ内診スルミタイダ」「馬鹿ネ」「舌ヲ使ワズニ接吻シロナンテ、随分無理ナ註文ダナ」「接吻ジャナイモノ、タヾ唇デ触ラセルダケダモノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「絶対ニ着物ニハ附ケナイ、朱墨ヲ塗ルノハ君ノ足ノ裏ダケダ」彼女ハ云ワレル通リニシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
