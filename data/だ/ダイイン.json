        "examples": {
          "standard": [
            {
              "text": "代表が欠席したため、代員がその役割を代わりに務めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "会議にどうしても出席できないため、同僚に代員として出席してもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "選挙では、投票できない市民のために代員制度が設けられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "係りの者は、沿岸警備出張所のそばに泊っているブラウンという交代員にも手紙をだし、土曜日の朝、出張所の船で燈台へゆけと命令し、また出張所にも手紙を出して、ブラウンという男を燈台まで送りとどけてくれといってやった。",
              "citation": {
                "source": "歌う白骨",
                "author": "THE ECHO OF A MUTINY",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、それだけならまだいいんですが、二十七日の晩には金造が隣りの空家へ忍んで行って、手足の利かないお千恵さんを匕首で嚇し付けて、どうで女郎に売られる体だから、置土産におれの云うことを肯けなどと迫ったそうです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大森の鶏",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それでもぼくはまだいいんだが、里見恭助ときたら、まるで形無しだからね。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その猫が逃げたんじゃあねえか」「逃げたのならまだいいんですけど……」と、女房は小声で云った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "三河万歳",
                "note": "青空文庫"
              }
            },
            {
              "text": "すつかり信用をおとしてしまいました」「でも先生は、まだいいんでございますわ。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その建て直すたびに、これでいいんだいいんだと一生懸命になる、また壊れる。",
              "citation": {
                "source": "生活と一枚の宗教",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「然し、」と此度は真面目な調子で中村は云った、「偶然だからまだいいんで、初めから殺意があったらなおいけないじゃありませんか。",
              "citation": {
                "source": "変な男",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（退場）房子　　（手塚と共に退場）留雄　　（待ち遠しさうに室内を歩きまはる）房子　　（いそいそと入り来り）留雄さん、ほんとにまだいいんでせう。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さういふ風に、癇癪をおこすくらゐなら、まだいいんですよ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（それまで、窓の外から、のぞいていた顔が、見えなくなっている）小笠原　はあ、いえ、まだいいんですの。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいんだいいんだおんめちゃん」と芳造は手を振った、「青海亀ってのはねおばさん、赤海亀っていう駄物と違って、※瑁にいちばん近い甲羅を持ってるんだ」　でも青海亀の甲羅は斑の形も、たいまいとはまるで違うじゃないの。",
              "citation": {
                "source": "枡落し",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それではお作文の宿題を拝見いたしましょう」「あれは来週の月曜までですから、まだいいんです」「そうでございますか」　と有本先生はおだやかだ。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけなら、まだいいんだよ。",
              "citation": {
                "source": "暗黒星",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "……小五｜哥いも、目が出ねえらしいが、どうも早や、あっしら兄弟は、みんな、ばくち好きの、ばくち下手ってやつでしてね」「近ごろ、いけませんかな」「近ごろなら、先生、まだいいんですがね、もう一年以上も、取られっ放しの、素寒貧つづきですよ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
