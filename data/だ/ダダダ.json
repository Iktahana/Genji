        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "昇る時は、ドスンドスン、降りる時はころげ落ちるみたいに、ダダダダダ。",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやになりますよ、ダダダダダと降りてそのまま御不浄に飛び込んで扉をピシャリッでしょう。",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯痛には、あのドスンドスンもダダダダも、ひびきますよ。",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "跳び上った春藤幾久馬をはじめ、一同ダダダッ！",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダダダダッと銃丸は天井に向けられ、シャンデリアに当って、硝子の砕片がバラバラと墜ちてきた。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダダーン、ヒューッと、発射された銃弾は帆村たちのいる室内に撃ちこまれた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "蠅男がアメリカのギャングのように機関銃を小脇にかかえてダダダッとやったときの光景はいかがでした」「ウン、なかなか勇壮なものだったそうだ。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなインチキ銃に撃たれてたまるものか」「よオし、これを喰って往生しろッ」　と蠅男の大喝と共に長い黒マントの肩先がブルブルと痙攣するより早く、ダダダッと耳をつん裂くような激しい銃声！",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、思うと、　ダダダダダダ！",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘクザ館のありかを探しているのだ」　戸倉老人が叫んだとき、ダダダダダと物凄い音を立てて、機関銃がうなりだした。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダダダダダダダダダ！",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
