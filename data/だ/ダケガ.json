        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」無理カモ知レマセヌガ　とまた、うつむいて、低く呟くやうにおつしやつて、ソレダケガ生キル道デス　尼御台さまは、すつと細い頸をお伸ばしになり素早くあたりを見廻しました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　無理カモ知レマセヌガ　とまた、うつむいて、低く呟くようにおっしゃって、　ソレダケガ生キル道デス",
              "citation": {
                "source": "鉄面皮",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエダケガヨナカニヒビイテ、オ母ッチャハウゴカナイ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、コツチノ気持ハ第二トシテ、軍人ダケガ、ナゼ当節サウイフ感情ヲ尊重シテヰルカニツイテ考ヘテミルト、「モンテェニュ」デハナイガ、世ノ中ニ軍職グラヰ愉快ナ職ハナイノカモ知レヌ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "出シ物ハ「恩讐の彼方へ」「彦市ばなし」「助六曲輪菊」デアルガ他ノモノハ見ズ、助六ダケガ目的デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼キ物ハ予一人ダケガ鱧ノ附焼、他ノ三人ハ鮎ノ塩焼、吸物ハ四人トモ早松ノ土瓶蒸シ、外ニ茄子ノ鴫焼。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガオカシイノハ、母ダケガ若キ日ノ姿ヲシテイテ、予ハ現在ノ老人ノマヽデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "当人ダケガ耐エ難クツメタク感ジルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
