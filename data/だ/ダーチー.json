          "literary": [
            {
              "text": "「もし嫌いじゃなかったら、頼みがある」「ダーチー、よせよ」鏡に見入りながら兄がいった。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は皆に、米兵たちからと同様にダーチーと呼ばれている。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もうすぐ冬だぞ、ダーチー、腕をふるってこんどからはバスでもオーダーしてくんなきゃ、たまんねえや」小林がいった。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「坊や、これからはおれのこと、ダーチーって呼びなよ、友だちのダーチー」と彼はいった。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ダーチーにいくら渡している」「百五十円だね」「折半かい」「そういうことになっている」「お前のことだ。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ひとつも本気じゃない、ダーチーの御機嫌とりさ。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダーチーの話とちがうな」電車通りに出ながら、白マフラアの荻村は首をまげた。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーチーの話はね、またちがうんだ。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーチーには、考えさせて下さいってぼかしてあるんですが」「そうなの。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でも、ダーチーには、まだはっきりとはいわないでおくよ、その方が都合いいんだろう？",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーチーの昔を思い出したよ、やつもちょうどあんなふうに、よく殺気立ったみたいにやったもんだ」「小林」と荻村が低くいった。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じょうだんじゃない、おれたちのなかで戦争を知ってるのは、ダーチーだけだよ」「ダーチーが？",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーチーがいてくれりゃ、締まっていたのになあ」荻村は兄と同じことをいった。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうですかね」　信二は、彼らにとってのダーチーには興味が湧かなかった。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
