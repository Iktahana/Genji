        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ハネると、ダッシー八田氏京都より出張、大阪中いゝとこが無いからとて、何と天六の八田氏の親類の家、磯辺セメント店の奥座敷へ、北から芸妓をよんでの饗宴、時節柄の大珍景。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダッシー八田氏来訪。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダシの味「ダッシー」てのゝ所長八田といふ男がぜひ一席と申し込んで来てるので、祇園の東二軒茶屋てのへ行った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "京都のダッシー所長八田が見物、ＰＣＬ大谷が「ハリキリボーイ」のシナリオ持って来た。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はダッシーの八田社長の招待で、座員大ぜいで琵琶湖へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "石山寺へ参拝（僕は階段の下から遙拝）料亭へ戻ると、ダッシー苦心の福引があり、古川緑波の十八番でヘイタイムシャと、兵隊と武者人形などは秀逸。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、ダッシーの八田などは特別扱いだ、此う力を入れられては仕方がない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時に、ダッシー社長の一家を、アラスカへ招いてゐるので、道子と共に朝日ビルへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネると、ダッシーの招きで冷房の支那料理ハマムラへ、宿で千恵蔵一党が待ってるので一時半大急ぎで帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「金色」で、ダッシーの八田と約束なので「ダッシー／＼」と叫んだりして朗らか。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "入浴し、近くの三島へ、ダッシーの招待、座員三十何名、いつも実によくして呉れる、二次会は八坂の方へ行き、そこで又のむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダッシー八田氏の招待で顔見世を見物。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネてから又ダッシー八田氏に招かれ、祇園の広千代てふうちへ行き、今日南京陥落を祝してのむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜はダッシー八田氏を、此の前招かれた祇園の広千代てうちへ招き返し、沖すきでウイをのむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "八田ダッシー氏上京、柳・伊東・大庭でルパンから柳ばしへのした。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "八田ダッシー氏をこっちから招待してある。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダッシーの八田氏来る、京都で又歓迎の網打ち会をやって呉れる由で、その相談。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、肥田増雄氏も同道、八田ダッシーの招待で京都松そのへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "京都着、麩屋町の炭屋旅館に落ちつく、一時二十分京都駅前集合、ダンシングチーム、女優一同と男の幹部、山野や菊田も加はり、ダッシー八田氏の招待で琵琶湖行き。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガンばって芝居は何の支障もなくやれたが、何ともハヤ大へんな労れ、今夜はダッシー八田氏の招待、五人ばかりで音羽てふ京料理へ、こゝはとても気持よく又うまかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜は又ダッシー氏の招待、ハマムラ、冷房の支那料理（うまくはない）から、祇園で二時まで。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "折柄見物に来てたダッシー八田氏と共に行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "京都から八田ダッシー氏が来た、招待しなくてはと思ったが、元気が出ない、柳を代りに立てることにして帰宅。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダッシー八田氏の一行見物なので「青春」のピアノは、ダッシー作曲タコの子守唄と言ったので大受け。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ後、柳・大庭・石田・伊東・山野・渡辺・サトウと揃って京都へ、ダッシー八田氏の招待で松そのである。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時すぎ、理髪屋、例の五十嵐てのへ行き、それからダッシー八田氏を二条の佐藤食料研究所へ訪れたが、五日節季で急しさうだからすぐ辞して、四条の長崎屋で洋食を食ひ、鈴木静一と朝日ビルの講堂で映画を見る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダッシー八田氏、横尾泥海男来訪。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダッシー八田氏の招待で、ハマムラの支那料理、それから祇園の広千代へ行き、ヘゞレケになり、二時すぎ宿へ帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
