        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "コンプリートまであと1枚なのに、ガチャを回してもダブりばかりが出てくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "本棚を整理していたら、同じタイトルを2冊買っていたというダブりが見つかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「カードのダブりがあるなら、僕のと交換してくれない？」と友達に頼んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
