[
  {
    "uuid": "7fe3f8c8-4c6c-50cf-aab8-c67dd9fb1549",
    "entry": "大福",
    "reading": {
      "primary": "だいふく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
