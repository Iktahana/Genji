        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "家鴨料理のツール・ダルジャンでゆっくりした晩餐をとった後、新吉とリサとは直ぐ前のセーヌ河の河岸に沿って河下へ歩き出した。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "家鴨料理ツール・ダルジャン　家鴨の番号数二万――八。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツール・ダルジャンの酒倉は世界の食通の一度は見学すべき博物館になっている。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里のトウダルジャン、あそこはうまいですな。",
              "citation": {
                "source": "踊る地平線",
                "author": "黄と白の群像",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴨料理の店「ツール・ダルジャン」のように堂々とした造りで、正装のボーイが鷹揚に構えているようなお店では、声も出ないのだろう。",
              "citation": {
                "source": "すき焼きと鴨料理――洋食雑感――",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が「ツール・ダルジャン」を訪ねたのは、画家の荻須高徳氏夫妻、それに小説家大岡昇平氏といっしょの時であった。",
              "citation": {
                "source": "すき焼きと鴨料理――洋食雑感――",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツール・ダルジャンの鴨も実は家鴨なのである。",
              "citation": {
                "source": "すき焼きと鴨料理――洋食雑感――",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし気があったら、今晩ティヤック・ダルジャンの宿屋においでな、私はそこにいるから。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩ティヤック・ダルジャンの宿屋に待っていると言ったわ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
