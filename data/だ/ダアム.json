        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アムステルダアム　測候所を尋ねて場末の堀河に沿って歩いて行った。",
              "citation": {
                "source": "異郷",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁草、吟味して雅びた物言ばかりなさるマダアム・プレシウズ。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里にノオトル・ダアムがある。",
              "citation": {
                "source": "伝通院",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしが子供くさくばかりしていたので、パパの眼に収差が出来、どこもかしこも完成して結婚をまつばかりになっているこのユヌ・ダアムが、這い這いをしている赤ん坊のようにしか見えないのだ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは十二月八日、漁夫達の護神、ノオトル・ダアム、ドゥ・ボンヌ・ヌウヴェルの祭日で、――行列が濟んだ少し後であつた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
