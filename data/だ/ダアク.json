        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "また、馬に乗ったジャンダアクを忘れかねた。",
              "citation": {
                "source": "俗天使",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころの東京には、モナ・リザをはだかにしてみたり、政岡の亭主について考えてみたり、ジャンヌ・ダアクや一葉など、すべてを女体として扱う疲れ果てた好色が、一群の男たちの間に流行していた。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころの東京には、モナ・リザをはだかにしてみたり、政岡の亭主について考へてみたり、ジヤンヌ・ダアクや一葉など、すべてを女体として扱ふ疲れ果てた好色が、一群の男たちの間に流行してゐた。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダアクの操り人形然と妙な内鰐の足どりでシャナリシャナリと蓮歩を運ぶものもあったが、中には今よりもハイカラな風をして、その頃｜流行った横乗りで夫婦｜轡を駢べて行くものもあった。",
              "citation": {
                "source": "四十年前",
                "author": "――新文学の曙光――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の周囲には死んだジャン・ダアクすら、もう一度仏蘭西人の胸に活きかえりつつあった。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三　ダアク一座　僕は当時｜回向院の境内にいろいろの見世物を見たものである。",
              "citation": {
                "source": "追憶",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしいちばんおもしろかったのはダアク一座の操り人形である。",
              "citation": {
                "source": "追憶",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジアン・ダアクでなければ破れない城を。",
              "citation": {
                "source": "続文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し看守さへゐなければ、馬に乗つたジアン・ダアクの飛び出すのに遇つても驚かないかも知れない。",
              "citation": {
                "source": "都会で",
                "author": "――或は千九百十六年の東京――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし正直に白状すれば、僕はアナトオル・フランスの「ジアン・ダアク」よりも寧ろボオドレエルの一行を残したいと思つてゐる一人である。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ仏蘭西のやうな国でさへ、丁度昔のジアン・ダアクのやうに、クレエル・フエルシヨオと云ふ女が出て、基督や天使を目のあたりに見る。",
              "citation": {
                "source": "近頃の幽霊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "……しかし正直に白状すれは、僕はアナトオル・フランスの「ジヤン・ダアク」よりも寧ろボオドレエルの一行を殘したいと思つてゐる一人である」と書いてゐるのである。",
              "citation": {
                "source": "芥川龍之介論",
                "author": "――藝術家としての彼を論ず――",
                "note": "青空文庫"
              }
            },
            {
              "text": "どつちからともなく、ジヤンダアクの名が口にされました。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダアク・キャットのピッチャーの二股長半ねーエ。",
              "citation": {
                "source": "お魚女史",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
