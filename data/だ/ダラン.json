        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――くだらんことを言うな。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（野中）（ちょっと本気に怒ったみたいに顔をしかめ）くだらん事を言っちゃいけない。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でも、ずいぶん時代が、――」「くだらんお世辞はやめ給え。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、あれは、くだらん言葉だ。",
              "citation": {
                "source": "断崖の錯覚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「くだらん話なんだよ。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "中学校へはいってからは、校規のきびしい学校でしたので、おしゃれも仲々むずかしく、やけくそになって、ズボンの寝押しも怠り、靴も磨かず、胴乱をだらんとさげて、わざと猫背になって歩きました。",
              "citation": {
                "source": "おしゃれ童子",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "くだらん事、いろ／＼と書いた。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も後には藤吉の家に出掛けて夜の十二時までもくだらん話をして遊ぶようになりました。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　口からふき出している泡の間から、だらんと垂れた舌の先が見え、――茉莉はかすかに唸っていた。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「姉ちゃん、一口吸わしたげよか」　浴衣をだらんと着たその若い娘は、陽子へ話し掛けて来た。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だらんとはだけた浴衣の裾は立てた膝にまきつけていても、すぐみだれ勝ちになるのだが、それが案外だらしなく見えなかったのは、白粉気のない皮膚の清潔さと、青み勝ちに澄んだ眼の、怜悧そうな光のせいであろう。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だらんと着物をひろげて、首を突き出し、じじむさい恰好で板の上に坐っている日が何日も続くともう泣く元気もなかった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だらんと伸びた足が黒足袋をはいて階段に掛っている。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐伯は張子のように首をだらんと突きだしたじじむさい恰好で視線を泳がせる。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だらんと伸びて、血まみれの腸がはみだしていた。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガマンの針助の袂は、中へ入れたものの重みで、だらんと下へ垂れていた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒲団の中からだらんと首をつきだしたじじむさい恰好で、永いことそうやっていると、ふと異様な影が鏡を横切った。",
              "citation": {
                "source": "秋深き",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だらんと着物をひろげて、首を突き出し、じゝむさい恰好で板の上に坐っている日が何日も続くともう泣く元気もなかった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オイ、『アクーリナ』、おまえだッてばかじゃあるまい」トまた話しだした、「そんなくだらんことをいうのは置いてもらおうぜ。",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何をくだらんことを考へてるんだ。",
              "citation": {
                "source": "一過程",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "くだらん警戒で間をへだててゐたのは向ふではなくてこつちぢやないか。",
              "citation": {
                "source": "黎明",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩をだらんとさせ、膝を曲げ、頭を後ろにそらして、顎を上向きにしている。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲鳴はやんでいたが、夫人は気を失って長椅子の上にのびており、もうひとりの方は片足を肘掛椅子の手すりへだらんと懸け、頭を炉格子の端近くの地面に転がしたまま、血だまりのなか、あいにく事切れていた。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "またあちこちで壁紙は裂け、だらんと剥がれていたため、下の黄色い壁土があらわになっていた。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見ると事務長は苦い顔と笑った顔とを一緒にして、「なんだいくだらん」　といって、電燈の近所に椅子をよせて、大きな長い足を投げ出して、夕刊新聞を大きく開いて目を通し始めた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仁右衛門はだらんと下げた右手に斧をぶらさげたまま、妻は雑巾のように汚い布巾を胸の所に押しあてたまま、憚るように顔を見合せて突立っていた。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "相島は低い力のある聲で半ばまで歌つたが「くだらん」と思ふと本を閉ぢて坐つて仕舞つた。",
              "citation": {
                "source": "半日",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、自分の姓が松田というところから、自分の製品にマツダ電球というマークをつけていたが、本物のマツダランプは一流品で、町工場の製品が一個十銭とすれば、少くとも一個三十銭の価値がある。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、当然、マツダランプから松田に抗議があった。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "松田が訴訟を起されて負け、マツダランプから製品を押えに来たが、権右衛門の抵当物品故手を触れる訳に行かなかった。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
