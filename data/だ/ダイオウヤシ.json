        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "南国の庭園に植えられた大王椰子が、優雅にそよ風に揺れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この公園のシンボルツリーは、樹高25メートルを超える大王椰子である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大王椰子の実は直径が15センチほどあり、非常に重い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "大きさはわが四国くらいの島で、熱帯の海に近いから、海岸の砂浜には、大王椰子の樹が、緑の葉をひろげている。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "大王椰子の葉がざわざわとゆれて、遠くの方で、かすかに、海鳴の音がしている。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
