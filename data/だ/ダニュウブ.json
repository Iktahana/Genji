          "literary": [
            {
              "text": "」　塩辛声の番頭を前にして、矢代は、ハンガリアのダニュウブ河の岸にあった温泉を思い出し、そこがここに一番似ていたと思った。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "匈牙利の南、ダニュウブ沿岸のツイモニイ地方は、昔から美人の産地で有名な処だ。",
              "citation": {
                "source": "生きている戦死者",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダニュウブ沿岸セメンドリアの戦いの後、同地の陣営から出したキスの手紙がツインコタに残っているリットマンに届いた。",
              "citation": {
                "source": "生きている戦死者",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダニュウブに面したフランツ・ヨセフ河岸に住んでいるちょっとした人の奥さんで、日曜日にテレツファロス教会でふと相識になったという。",
              "citation": {
                "source": "生きている戦死者",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            }
          ]
        }
