          "literary": [
            {
              "text": "時にこの花、何という名前だったかな」「ダチュラ」　女はすぐに答えた。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダチュラ」　五郎はまだ考えていた。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの棺の中に、このダチュラの花を、いっぱい詰めてやった。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきのダチュラの樹が眼下にあり、湾がそこからひろがっていた。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "しめった掌を離すと、女は道を降り、ダチュラの花を四つ五つ摘んで来た。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "この花をぼくの部屋に――」　ダチュラはもう萎び始めていた。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "真中にちゃぶ台があり、ダチュラの花が瓶にさしてある。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう、しおれましたな」　主人はダチュラを指でつついた。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "大陸に行ったり、沖縄や南西諸島に行ったり、ああ、このダチュラも、種子が船に乗ってやって来たんでしょう。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダチュラの匂いは、まだただよっている。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
