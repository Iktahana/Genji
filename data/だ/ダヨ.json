        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノ、イヤラシイ、オトコハ、オマエダヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ、オオキイウチハ、ミンナキライダヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエハ、ウチデ、オトナシク、ルスバンヲシテイレバ、ソレデ、イイノダヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コドモタチヤ、コノ　バシヤハネ、オマエタチガ　マダ　ウマレナカツタ　ジブン、マダ　ジドウシヤト　イフ　モノガ　ナカツタ　トキ、ムラカラ　マチノ　テイシヤバマデ　マイニチ　カヨツタ　モノダヨ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤア、チヒサイネ」「コドモデスカラネ」「コレデハ、オトナニ　ナツテモ　アマリ　オホキク　ナリマスマイ」「イヤイヤ　オトナニ　ナツタラ、コヤクラヰノ　オホキサニ　ナル」「ダマサウタツテ　ダメダヨ」「ホントウデスヨ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オテラノ　コゾウサンニ　バケル　トキハ　コロモヲ　ツケテ　デルノダヨ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　オサムラヒニ　バケル　トキダヨ」　オカアサンノ　タヌキハ　ガツカリシテ　イヒマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガイトウノ　カゲナラ、ガイトウノ　ウシロニ　アル　ソノ　ヒヨロヒヨロシタノガ　サウダヨ」ト　ケイキキユウハ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月二十五日天野朱雲拜新田耕サン　そして、上部の餘白へ横に（獨眼龍ダヨ。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "朱雲の手紙に「獨眼龍ダヨ」と頭註がついてあつたが、自分はたゞ單に、ヲートルローの大戰で誤つて一眼を失つたのだらう位に考へて、敢て其爲めに千古の眞骨頭ナポレオン・ボナパルトの颯爽たる威風が、一毫たりとも損ぜられたものとは信じなんだのである。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月二十五日天野朱雲拝新田耕サン　そして、上部の余白へ横に（独眼竜ダヨ。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "朱雲の手紙に「独眼竜ダヨ」と頭註がついてあつたが、自分はたゞ単に、ヲートルローの大戦で誤つて一眼を失つたのだらう位に考へて、敢て其為めに千古の真骨頭ナポレオン・ボナパルトの颯爽たる威風が、一毫たりとも損ぜられたものとは信じなんだのである。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……オレダヨオ――オ――」",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ガ主人ヲ抱キ起シタ時、主人ハサキ申シタ通リ殆ド死ンダヨウニナッテ居リマシタガ、私ガ旦那様旦那様トクリ返シマスト、カスカニ目ヲアキマシタガ、不意ニ思イガケナイ位大キナ声デ、「大寺……大寺ダ」ト申サレマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人ノ言葉ヲキクト今マデ死ンダヨウニナッテ居タ奥様ガ何カ云イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰カ来テクレタ人ニ云ウヨウスデシテ、決シテ一郎トイウ名ヲタダヨンダノデハナカッタト思イマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ神ガ乗リ移ッテイル間中、死ンダヨウニナッテイルノデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ「ソラ、タマガトンダヨ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トツテキテ、ハヤクナゲルンダヨ――」ト、トラ三ガドナツテヰタノデ、オバアサンハビツクリシマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルトミンナガ、「ザウサンハ　アシモ　テモツカヘナイカラ、ハナデトルノダヨ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オマンヂウハ　ナミガ　ミンナ　タベテシマツタノダヨ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ　イマハ　マダ　チツポケナ　コイヌダヨ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゲガドンナニ　オホキクナツテモ　キミハ　ヤツパリ　コイヌ　ナンダヨ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「テキガ　セメテキタンダヨ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　スルト　ポチハ　ボンヤリシタ　メヲアケテ「ナアニ、アレハ　オホソウヂダヨ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チョーセイ、チョーセイ、フノ字ノ番ダヨ、チョーセイ、チョーセイ」　こう唱えてやらせる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、はじめの二ツのヒヤローが各々「モウイイカイ」と「マアダダヨー」に当るのである。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう考えて改めて笛の音にきき入ると、モウイイカイ、マアダダヨオ、という子供たちの隠れんぼの声が、この笛の音律と舞いの内容に深いツナガリがあって民族のハラワタをしぼるようにして沁みでてきたものではないかと思われ、そう信じても不当ではないと言いきりたいような大きな感動に私はひきこまれていたのであった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ヤ、ヤ、山ナンカ、キョウガ、ハ、ハ、ハジメテナンダ……アタシニハ……カミサンモ……コ、コ、小供モアルンダヨー。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネオンサインダツテアンナニジーツトシテイル様ニ見ヘテモ実ハ不断ニネオンガスガ流レテイルンダヨ。",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
