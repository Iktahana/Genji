    },
    "definitions": [
      {
        "index": 1,
        "gloss": "godfather",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の代父は、彼の幼少期から精神的な支えとなってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は、友人の子供の代父に選ばれたことを光栄に思った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "代父は、洗礼式で子供の信仰を保証する役割を担う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "働く女は近代父権下の lady のような隷属はしていないというようなことを、この複雑な今日の現実の中で、ある種の考えに役立てられる危険をもって云っているし上代神話と結びつけているし。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "姫君も見つけ出さなきゃならねえし、ひょっとするてえと、きょうだいふたりゃ風をくらってずらかったかもしれねえんだから、急いで追っかけましょうよ」「せくな！",
              "citation": {
                "source": "右門捕物帖",
                "author": "因縁の女夫雛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほら、これを首にでも巻いていな」　おのが羽織をぬぎ取りながら、きょうだいふたりのえりもとへふんわりかけてやると、黙々としてややしばしじいっとふたりの面を見守っていましたが、じわり、その目に涙をためながら、やさしくいたわるようにいいました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいじな赤ん坊にかぜでもひかしちゃならねえから、てつだってあっちへ運んでいきな」　いいつけておいて、いたわりながら、おびえおののいているきょうだいふたりを橋向こうのその自身番小屋へいざなっていきました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の静まるまでというように、じいっと名人は静かにきょうだいふたりを見守ったままでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼奴はね、僕が女房の偽の弟だいふことを好く知つてゐるんだ、それをわざと知らん振りをして……」　いひかけて彼は喉を詰らせた。",
              "citation": {
                "source": "街角",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "右兵衛だいふどのも最初は安土にろうじょうのかくごでおられましたけれども、こゝではこゝろもとないとおもわれましたか、また急に模様がえになりまして、御台やお局さまがたを早々におつれ申し上げて御自分の居城日野谷へたちのかれました。",
              "citation": {
                "source": "盲目物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [
        "乃父"
      ],
      "synonyms": [
