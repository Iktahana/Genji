        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "京子の手紙六　加奈子のダンナサンが今夜、加奈子に優星学（作者註、優生学の間違いならん）の話をしてました。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "加奈子のダンナサンは私を馬鹿だと思ってるんでしょうか。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "加奈子のダンナサン何故へんな画ばかりかくんでしょう。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは誰だと、若い女に聞けば、ワタシノダンナサンノオ母サンと答へた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは誰だと、若い女に聞けば、ワタシノダンナサンノオ母サンと答えた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            }
          ]
        }
