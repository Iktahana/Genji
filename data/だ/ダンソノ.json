          "literary": [
            {
              "text": "其靈が不斷其柱の邊にさまよひ近付く者を害するより全市を無事にすと信ぜられたのだ。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "或男子則止斷其雙腿。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "則以法刑斷其兩足而黥之。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "孫子呉起列傳第五",
                "note": "青空文庫"
              }
