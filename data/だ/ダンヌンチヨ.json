        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "女は何か思ひ出したらしく莞爾しながら、おれと並んで長椅子へ腰を掛けて、――ダンヌンチヨが先の週に或｜珈琲店で或女優に言つた話があるの。",
              "citation": {
                "source": "素描",
                "author": "與謝野寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ダンヌンチヨはこれまで沢山の胡桃を壊したんだらう。",
              "citation": {
                "source": "素描",
                "author": "與謝野寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "――仏蘭西の今の文学者にダンヌンチヨのやうな奢侈家は居ません。",
              "citation": {
                "source": "素描",
                "author": "與謝野寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンヌンチヨは作物と奢侈と借金とで名高くなつた文学者ですわ。",
              "citation": {
                "source": "素描",
                "author": "與謝野寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はダンヌンチヨが黒奴や其他の野蛮人を下部に使つて得意になつて居ると云ふことを話した。",
              "citation": {
                "source": "素描",
                "author": "與謝野寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
