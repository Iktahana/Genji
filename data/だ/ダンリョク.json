[
  {
    "uuid": "3f2dc426-c6f1-5e02-b47f-736f1560decd",
    "entry": "弾力",
    "reading": {
      "primary": "だんりょく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
