        "examples": {
          "standard": [
            {
              "text": "壇ノ浦の合戦は1185年に源平合戦の最終局面として勃発した",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "壇ノ浦の合戦で平家は滅亡に至った",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "源義経は壇ノ浦の合戦で八艘飛びで活躍した",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、男達はすぐに墓地へと急いで行った、そして提灯の明かりで、一同はそこに芳一を見つけた――雨の中に、安徳天皇の記念の墓の前に独り坐って、琵琶をならし、壇ノ浦の合戦の曲を高く誦して。",
              "citation": {
                "source": "耳無芳一の話",
                "author": "THE STORY OF MIMI-NASHI-HOICHI",
                "note": "青空文庫"
              }
            },
            {
              "text": "力を籠めて芳一は琵琶を錚錚と鳴らしていた――ますます烈しく壇ノ浦の合戦の曲を誦した。",
              "citation": {
                "source": "耳無芳一の話",
                "author": "THE STORY OF MIMI-NASHI-HOICHI",
                "note": "青空文庫"
              }
            }
          ]
        }
