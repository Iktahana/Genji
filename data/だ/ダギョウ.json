  {
    "uuid": "5d566514-d8d6-5914-b884-c0a6314e2f80",
    "entry": "だ行",
    "reading": {
      "primary": "だぎょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まだ行っていないのである。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "漢方の先生だけに仕込んだ行儀もございます。",
              "citation": {
                "source": "政談十二社",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬の心理を計りかねて、ただ行き当りばったり、むやみやたらに御機嫌とっているうちに、ここに意外の現象が現われた。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "てるも追々お嫁さんになれるとしごろになったのだから、ただ行儀見習いだけのつもりで、ひとつ立派なお屋敷に奉公してみる気はないか、と老母にすすめられ、親の言う事には素直なてるは、ほんとうに、毎日こうしてうちで遊んでいるよりは、と機嫌よく承知した。",
              "citation": {
                "source": "古典風",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの神戸で頼んだ行李は盗まれやせんのじゃろうかな？",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は武蔵野の跡のわずかに残っている処とは定めてこの古戦場あたりではあるまいかと思って、一度行ってみるつもりでいてまだ行かないが実際は今もやはりそのとおりであろうかと危ぶんでいる。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイド・パークの青芝の広場に幾筋もの汗ばんだ行進隊が吸ひ寄せられて行く。",
              "citation": {
                "source": "英国メーデーの記",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕にも一緒に行こうって云ったけれどもね、僕なんかまだ行かなくてもいいんだよ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、恋人に言うならまだしも、おれはただ行きずりの男に過ぎないじゃないか」　小沢は間抜けた顔をして、芸もなくなっていたが、やがて口をひらくと、「本当に、何をされても平気なのか。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正十年五月、渋柿）　　　　　　　＊「あらゆる結婚の儀式の中で、最も神聖で、最もサブライムなものは、未開民族の間に今日でもまだ行なわれている掠奪結婚のそれである。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人より先に人のまだ行かない所へ行き着くこともできる代わりに、途中の道ばたあるいはちょっとしたわき道にある肝心なものを見落とす恐れがある。",
              "citation": {
                "source": "科学者とあたま",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがこのあいだ行って見ると、もうこの自分の好きな花瓶も見えなくなっていた。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "盆踊りのまだ行なわれている所があればそこにはどこかに奈良朝以前の民族の血が若い人たちのからだに流れているような気がしてしかたがない。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者は、あの時以来、一本松へはまだ行って見ないで居る。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "雁坂の路は後北条氏頃には往来絶えざりしところにて、秩父と甲斐の武田氏との関係浅からざりしに考うるも、甚だ行き通いし難からざりし路なりしこと推測らる。",
              "citation": {
                "source": "知々夫紀行",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "忘れもしない、わたしは勉強しようと思って、カイダノーフを読み始めたが――結局この有名な教科書のぱらりと組んだ行やページが、眼の前にちらちらするばかりで、なんにもならなかった。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぞろりとした半元服、一夫数妻論の未だ行われる証拠に上りそうな婦人も出た。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボールは兩方の列の間をただ行つたり來たりするだけだが、轉がつて來るボールをとらへる時は我を忘れた嬉しがりやうだ。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかあさんだって、まだ行ったことがないくらいなのさ！",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の上からは、まだ行ったこともない、何マイルも何マイルも遠くのほうまで、見わたすことができました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「楽しみてえところへは、まだまだ行かねえ。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "それならば社会政策的の施設する未だ行なわれようとはしなかった時代に、何を苦しんで社会主義の思想は説かれねばならなかったか。",
              "citation": {
                "source": "広津氏に答う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうだ行くか」　おんつぁんが杯にかじりついたまゝで詰問した。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺ら朝つぱら出掛つちやつてまあだ行逢えもしねえから、どうするつちんだか分んねえが、どうせ甘え面付もしちや居らんめえな、此んで怪我なんぞさせてえゝ心持ぢやあんめえな、さうぢやねえけ」勘次はだん／＼勢ひがついていつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "二二　拂曉の光はまだ行き渡らぬ。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして「ツアヽ」　と一聲大きくいつて「おれも三春へ行つて見てえ積だが、こんだ行く時にや一緒にすべえぢやねえか。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんでは、汝あ、まだ行ぐのがあ？",
              "citation": {
                "source": "土竜",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの女の浅はかな性質としては、もう、国府津に足を洗うのは――はたしてきょう、あすのことだか、どうだか分りもしないのに――大丈夫と思い込み、跡は野となれ、山となれ的に楽観していて、田島に対しもし未練がありとすれば、ただ行きがけの駄賃として二十円なり、三十円なりの餞別を貰ってやろうぐらいだろう。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "其｜後一寸礼に行かうと思つて、まだ行かない」　平岡の言葉は言訳と云はんより寧ろ挑｜戦の調子を帯びてゐる様に聞こえた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
