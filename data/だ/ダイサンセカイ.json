        "examples": {
          "standard": [
            {
              "text": "第三世界の発展途上国の多くは、資本不足と技術基盤の欠如に直面している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "国際開発機関は、第三世界の経済成長を支援するため資金を提供している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "第三世界の国々の中には、天然資源が豊富で経済成長の可能性が高い地域がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "世界暦千九百九十九年四月一日　第三世界戦争が勃発する。",
              "citation": {
                "source": "予報省告示",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "前には“世界のタンパク質問題”を強調していた国際連合（UNO）は、1974年の世界食糧会議（World Food Conference）では何も述べることはしなかった（103）.　第三世界で第一制限アミノ酸になる必須アミノ酸の合成も、1960年代に推進された（104）。",
              "citation": {
                "source": "栄養学小史",
                "author": "A Short History of Nutritional Science",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
