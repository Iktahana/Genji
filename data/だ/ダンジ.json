        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はまさに快男児と呼ぶにふさわしい、清々しい気風を持った青年だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "日本男児としての誇りを胸に、彼は単身海外の戦地へと赴いた。",
              "citation": {
