[
  {
    "uuid": "5370b9c1-8360-5a60-ac63-b23aeafc7e31",
    "entry": "男児",
    "reading": {
      "primary": "だんじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "boy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "元気な男児が誕生したという知らせを聞き、家族全員が喜びの声を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は幼い頃から、近所でも評判のわんぱくな男児として知られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "公園では、数人の男児が泥だらけになってサッカーボールを追いかけていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "汚れ易く、破れ易く、着くづれし易く、こんな服装を讃へなければならない我々日本男児は、なんとなく不幸であるやうに思へる。",
              "citation": {
                "source": "三等車の中（スケッチ）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚十数年、ヘルン既に五十｜歳を過ぎ、二人の男児と一人の女児の親となってる晩年の手紙である。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、傍で砂いじりしている子はおいたさんと呼ばれるほどの一くせありげないたずらっ子の男児だ。",
              "citation": {
                "source": "巴里の秋",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "誠に天晴な大和男児の姿である。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば男児だけについて見ても、二室のものの子は四室の者の子に比べて平均十一ボンド七分軽く、四・七インチ丈が低い。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これこそ日本男児ですわね。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあこれこそ、本当に日本男児ですわね。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、いやしくも神州男児で、殊に戦地にある御互だ。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやしくも神州男児だ、膓を掴み出して、敵のしゃッ面へたたきつけてやるべき処だ。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "出征する年少の友人の旗に、男児｜畢生危機一髪、と書いてやりました。",
              "citation": {
                "source": "春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、私も若干｜馬齢を加えるに及び、そのような風変りの位置が、一個の男児としてどのように不面目、破廉恥なものであるかに気づいていたたまらなくなりまして、「こぞの道徳いまいずこ」という題の、多少、分別顔の詩集を出版いたしましたところ、一ぺんで私は完全にダメになりました。",
              "citation": {
                "source": "男女同権",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、彼は客のなきままに、自分で勝手なことを書いては消し、ワット、ステブンソン、などいう名を書いていると、八歳ばかりの男児を連れた衣装のよい婦人が前に立った。",
              "citation": {
                "source": "非凡なる凡人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の日本は、千の平凡人よりも一人の快男児を要し、十万百万の平凡人よりも、一人の英雄豪傑を要する時代なり、大英雄、大豪傑出でずんば、日本は世界の大舞台に立つて、宇内の第一等国となる能はず。",
              "citation": {
                "source": "警戒すべき日本",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "（と高笑いして）君たち、おい、いやしくも国のためには、妻子を刺殺して、戦争に出るというが、男児たるものの本分じゃ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "瘤取り、浦島さん、カチカチ山、その次に、桃太郎と、舌切雀を書いて、一応この「お伽草紙」を完結させようと私は思つてゐたのであるが、桃太郎のお話は、あれはもう、ぎりぎりに単純化せられて、日本男児の象徴のやうになつてゐて、物語といふよりは詩や歌の趣きさへ呈してゐる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六歳から二十歳までの健康の男児に限る。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが数え年で二十四の男児である。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが男児たる者の立派な根性で無くて何で有ろう。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろ、乱暴はしましたが同情なすつても宜いではありませんか、あなたには御気の毒だが、男児として仕方が無いぢやありませんか、といふ調子で、将門が我武者一方で無いことを現はしてゐて愛す可きである。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども匡衡も鳶肩倔強の男児だ、斯様なると話が学問がかったところで推出されじまいになるのには堪えられなかった。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し定基は流石に快男児だった、愛も痴もここまでに到れば突当りまで行ったものだった。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、おれは男だ、おれは男だ、一婦人のために心を労していつまで泣こうかと思い返して、女々しい心を捨ててしきりに男児がって諦めてしまった。",
              "citation": {
                "source": "太郎坊",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "説を為すものあり、曰く、桐楊の桐は男児に較べ、楊は令嬢たちに擬えたのであろう。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "五人の従同胞の中の唯一人の男児は、名を巡吉といつて、私より年少、顳※に火傷の痕の大きい禿のある児であつたが、村の駐在所にゐた木下といふ巡査の種だとかいふので、叔父は故意と巡吉と命名けたのださうな。",
              "citation": {
                "source": "刑余の叔父",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、苟も神州男児で、殊に戦地にある御互だ。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやしくも神州男児だ、腸を掴み出して、敵のしやツ面へたたきつけて遣るべき処だ。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "淡泊洗ふが如き孤剣の快男児（蒼海）この席の談笑を共にせざるこそ終生の恨なり。",
              "citation": {
                "source": "三日幻境",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し推して言ふ事を得せしめば、紅葉は露伴の長所に、少くとも乗入らんとせしなり、而して露伴も亦た「対髑髏」、「奇男児」等の鋭利なる奇想を廻り遠しとや思ひけむ、紅葉独得の写実界にまぐれ込まむとの野心を抱きしなり。",
              "citation": {
                "source": "「伽羅枕」及び「新葉末集」",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋し理想詩人の性として必らず人生を其或る一面相より観察する者なる故に、道也が「奇男児」を作りたる詩人の懐裡に宿りたるは無理ならぬ事なり。",
              "citation": {
                "source": "「伽羅枕」及び「新葉末集」",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はあ、僕等と一緒にすんだんじゃが、谷元はまだほかを受ける云いよった。",
              "citation": {
                "source": "電報",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
