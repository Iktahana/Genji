        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "昇る時は、ドスンドスン、降りる時はころげ落ちるみたいに、ダダダダダ。",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやになりますよ、ダダダダダと降りてそのまま御不浄に飛び込んで扉をピシャリッでしょう。",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダダダダッと銃丸は天井に向けられ、シャンデリアに当って、硝子の砕片がバラバラと墜ちてきた。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、思うと、　ダダダダダダ！",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘクザ館のありかを探しているのだ」　戸倉老人が叫んだとき、ダダダダダと物凄い音を立てて、機関銃がうなりだした。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダダダダダダダダダ！",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「撃ち方ァ始めッ」　ダダダダダダダダーン。",
              "citation": {
                "source": "崩れる鬼影",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒューンといなないては宙返りをうち、ダダダダダーンと、敵機にいどみかかるわが防空戦闘機。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「山へ逃げろ」などの叫び声と、ダダダダダと走る足音だけ）春子　金吾さん！",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今も隠し芸のお仕度にちょいと座をお外しなすったくらいなんだ」　言わせも果たせず、ダダダダダと廊下でけたたましく足音がして、「オーイ。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく、道路工事などで、労働者が長ぼそい機械を地面に立て、上から両手でおさえつけて、ダダダダダ……と、コンクリートをこわしているでしょう。",
              "citation": {
                "source": "妖人ゴング",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダダダダッ――大地はとたんに狂震し出した。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダダダダダダダ……ン。",
              "citation": {
                "source": "奇面城の秘密",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
