          "literary": [
            {
              "text": "団匪事件の時、陸軍通訳として招集され、従軍中しばしば清廷の宗室大官と親近する中に計らずも粛親王の知遇を得たのが青雲の機縁となった。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "第八章　この年の六月頃から、清国義和団匪の暴動がますます猖獗をきわめてきた。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "また団匪の乱に乗じて全く満州を軍事的に占領した。",
              "citation": {
                "source": "東亜の平和を論ず",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
