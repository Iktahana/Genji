    "definitions": [
      {
        "index": 1,
        "gloss": "broken stone monument",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古い寺院の境内には風化した断碑が残されていた",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "断碑から当時の文字や人物の痕跡を読み取った",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "考古学者たちは断碑を丹念に調査している",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "わたくしは戦後人心の赴くところを観るにつけ、たまたま田舎の路傍に残された断碑を見て、その行末を思い、ここにこれを識した。",
              "citation": {
                "source": "葛飾土産",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "或日、深川の町はずれを処定めず、やがて扇橋のあたりから釜屋堀の岸づたいに歩みを運ぶ中、わたくしはふと路傍の朽廃した小祠の前に一片の断碑を見た。",
              "citation": {
                "source": "放水路",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "雅典は荒草斷碑の中にあり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "當時、圓光上人、怨魂を慰めむとて、湖水のほりに、龍體院殿自山貞性大姉と題する墓を立てたる由なるが、斷碑、今何づれの處にか存する。",
              "citation": {
                "source": "冬の榛名山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
