        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼は彼のために選ばれたダルトワ通のアパルトマンを思い出した、その直ぐ近くにデルフィーヌは住んでいるのだ。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬車はダルトワ通で止まった。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は朝食の時にゴリオ爺さんに彼の衣類などを新居に持って行ってくれるように頼んでいて、その際、四時にはダルトワ通でまた会おうと話していた。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は誰にも増してあなたの家、ダルトワ通の方を気にかけることでしょう。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
