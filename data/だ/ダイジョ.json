[
  {
    "uuid": "0dcf8996-2c64-5cb6-a71f-d729aef7e9d3",
    "entry": "大薯",
    "reading": {
      "primary": "だいじょ",
      "alternatives": [
        "ダイジョ"
      ],
      "is_heteronym": false
    },
    "grammar": {
