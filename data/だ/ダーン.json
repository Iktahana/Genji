          "literary": [
            {
              "text": "だだーん、だだーん。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だだだーん、ひゅーっ、どどどん。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこをまた、だーんと一発！",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だーん、だんだだーん。",
              "citation": {
                "source": "大空魔艦",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしないと、こっちがやられてしまいます」「じゃあ、……」　局長の言葉半ばにして、だーんと銃声がひびいた。",
              "citation": {
                "source": "幽霊船の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だだーん、どどーん。",
              "citation": {
                "source": "幽霊船の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然だだだーんと、ピストルが鳴った。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "撃つぞ」　だだーん。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こら、待たんか」　ぱぱーん、だだーん。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だだだーん、ぱぱぱーんとはげしい銃声が波紋の中の人間に集中された。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あっ、敵機だ」「どこだ」「あれあれ、あそこだ」「おや、なにか黒いものを落したぞ」　その時、　だだだーん、だだん、だだだーん。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だだだーん、がががーん。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「な、なにを――」　だーん！",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お雪は氷を一匙口へ入れては外を見ながら、無意識に、「ちょっと、ちょっと、だーんな。",
              "citation": {
                "source": "※東綺譚",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "だーん、という銃声と共に、鉄炮は火と煙を噴いたが、銃口は脇へそれていた。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だーん、だーん、だーん。",
              "citation": {
                "source": "殺生谷の鬼火",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンクスのからだは空中でぐるッと一回転すると、だーんとあおむけにたたきつけられた。",
              "citation": {
                "source": "柔道と拳闘の転がり試合",
                "author": "富田常雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "――今は余つぽど好くなつた方だが、まだあんたの生れない頃Ｆ町にゐる時なんかは、それはそれはお母さんのお友達といふお友達が、とても貴方は体が続くまいから出て行け出て行けつてさへ言つたものですよ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "女　まだあんなこと言つてるよ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "一郎やみんなは、河原のねむの木の間をまるで徒競走のように走って、いきなりきものをぬぐとすぐどぶんどぶんと水に飛び込んで両足をかわるがわる曲げて、だあんだあんと水をたたくようにしながら斜めにならんで向こう岸へ泳ぎはじめました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「先生、けれどもこの仕事はまだあんまり不確かです。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（お駒の顔を見て、なんだあんな女という眼をしやがった！",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」「まだ、まだまだあんな事を。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "淫奔をしておって我儘をとおすのだから不埒なのだ」「まだあんな事を言ってる、理屈をいう人に似合わず解らない老人だ。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まだあんな事を言つていらつしやる。",
              "citation": {
                "source": "質物",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "私、はじめてここに来た時、あなたなんて、黙りこくって醜男な人、いるんだかいないんだかわからなかったんですけど、だんだん、だんだあん好きになってきてしまいましたわ。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ厭あだあんなの、あんな平凡なのよりこの方がいきでいゝわ、私こんなのがすきよ。",
              "citation": {
                "source": "神樂阪の半襟",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「文學でこそ、田村義雄君と云つたら、一方の大家であるけれど、實業にかけては僕よりもまだあんこぢや、それが一躍して、千金を握らうとしたのはそも／＼無理であつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜ人殺しをしたかと云うに人殺しが目的ではない、ほんの方便で、人殺しをしたあとの心持ちを痛切に味わってみたいというような芸術家が出て来たとするならば――まだあんまり出ないようですが――どうでしょう。",
              "citation": {
                "source": "創作家の態度",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもまだあんなである。",
              "citation": {
                "source": "鈴木三重吉宛書簡―明治三十九年",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
