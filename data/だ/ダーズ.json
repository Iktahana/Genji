        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "山吹教授は部屋の隅の「ライフ」や「リーダーズ・ダイジェスト」や「ヴァニティ・フェア」等、近着のアメリカ雑誌がうず高く積まれた傍のソファに掛けて、校正用のゲラ刷に眼を通していた。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉井正太郎は、こんどは誰をつかまえて、リーダーズ・ダイジェスト仕込みの話をしかけようかと一同の顔を見ていたが、男はみなだめだと判ると、稲福という舞妓をつかまえて、「君、ええ話教えたげよか。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "普段英語を読むときは、研究社の『リーダーズ英和辞典』が離せません。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、『岩波国語辞典』と『リーダーズ英和辞典』という最も使用頻度の高い二つは、マシンで引いています。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "我が家の愛用の辞書は、研究社の『リーダーズ英和辞典』です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく、研究社のホームページで、電子化された『リーダーズ英和辞典』を引けると知りました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その筆者にとって、読む環境の整備という点での当面の願いは、研究社の「リーダーズ英和辞典」が電子化され、ディスプレイ上の英単語をクリックすれば一発で意味と用例が出てくる事である。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "シーダーズ荘にある僕用の部屋には、寝台がふたつあったな。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこがシーダーズ荘だ。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　我々は地下鉄でオルダーズゲイト駅まで行った。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤードバーズ〈フォー・ユア・ラヴ〉、アウトサイダーズ〈タイム・ウォント・レット・ミー〉、ナシュヴィル・ティーンズ〈タバコ・ロード〉、ビーチボーイズ〈アミューズメント・パークス・ＵＳＡ〉、それに、ナンシー・シナトラやレズリー・ゴーアなんてものまである。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "高志が見ている列のわきには、ジョニー・リヴァーズのＬＰと、マインドベンダーズの〈グルーヴィー・カインド・オヴ・ラヴ〉、シェールの〈バン・バン〉がおいてある。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓を開け放った室内からは、ヴォリュームをしぼったラジオでかかる、ポール・リヴィア＆ザ・レイダーズの〈ハングリー〉が、蜩の乾いた声のあいだを縫って流れてくる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはリーダーズ・ダイジェストの編輯方針と全く同じである。",
              "citation": {
                "source": "文学と生活",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この編集者は非常に多くリーダーズ・ダイジェストから学ぼうとしているらしく見受けられる。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リーダーズ・ダイジェストをはじめ、日本人が日本で出す新聞や雑誌でも、アメリカの世論統計を引用する場合には、しばしばギャラップの世論調査をつかい、ギャラップの調査の科学性と確実性とが語られた。",
              "citation": {
                "source": "現代史の蝶つがい",
                "author": "――大統領選挙の感想――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニューヨーク・タイムズ東京支局長リンゼー・パロット氏、ＡＰ東京支局長ラッセル・ブラインズ氏に対して日本人として鈴木文史朗氏が出席している、肩書はリーダーズ・ダイジェスト日本版編集長とある。",
              "citation": {
                "source": "鬼畜の言葉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『中央公論』をよむ人はまたリーダーズ・ダイジェストもよんでいる。",
              "citation": {
                "source": "鬼畜の言葉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木文史朗はついこの間アメリカへ行ってリーダーズ・ダイジェスト本社の立派なことを日本に吹聴したが、彼はアメリカで何を学び、どう語ることを学んで帰ったというのだろう。",
              "citation": {
                "source": "鬼畜の言葉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ肋骨ハ２ダーズ（ン）。",
              "citation": {
                "source": "内科",
                "author": "――自家用福音――　――或ハ　エリエリラマサバクタニ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリスにはウィリアム・サウンダーズがガイ病院に伝えた。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ブラジルボク、赤サンダーズ、赤ビートは色をつけ、酢酸鉛で赤色の沈殿を作る。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "トミー・ドーシーという白人、そして彼のジャズ・バンドは知っていても、ロイアル・サンセット・セリネイダーズという、黒人のジャズ・バンドのことは誰も知らない。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九四五年九月のリーダーズ・ダイジェストに、退役大佐ボナー・フェラーズの名をもつてかかげられた「降伏のためにたたかつた天皇裕仁」と題する論文が出ている。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            },
            {
              "text": "リーダーズ・ダイジェストなどにも紹介され、日本でも大分注目をひいている話である。",
              "citation": {
                "source": "雨を降らす話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニュー・メキシコ州での実験は、リーダーズ・ダイジェストの九月号に紹介されているが、この時は、沃化銀の粉を撒いたのである。",
              "citation": {
                "source": "雨を降らす話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
