          "literary": [
            {
              "text": "だだつ子だだつ子こねただだこねた靴屋の店でだだこねた。",
              "citation": {
                "source": "歌時計",
                "author": "童謠集",
                "note": "青空文庫"
              }
            },
            {
              "text": "これもいやだよあれもいや顏をしかめてだだこねた。",
              "citation": {
                "source": "歌時計",
                "author": "童謠集",
                "note": "青空文庫"
              }
            },
            {
              "text": "やさしくかあさんきいたけどだだつ子こねただだこねた頭ふりふりだだこねた。",
              "citation": {
                "source": "歌時計",
                "author": "童謠集",
                "note": "青空文庫"
              }
            },
            {
              "text": "うわべはいかにもやんちゃ装うて、都合の悪い時はだだこねたり甘えたりして、お腹の中では、ふん、人を子供や思てええ気イになってる、あんたこそお人好しのぼんぼんやないか。",
              "citation": {
                "source": "卍（まんじ）",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
