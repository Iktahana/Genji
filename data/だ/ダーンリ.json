        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ダーンリさん、ここで会うとは思いもよりませんでした。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふふふ、ここの邸宅が自宅なのですから」　普通に事実を述べただけなのに、ラルフ・ダーンリの心にぐさりと刺さったようだった。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "すてきなお方です」　だが、ダーンリは上の空だ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーンリさん、なんだか悲しそうですね」「夢が消えたからだよ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ええ、でもダーンリさん、あれで終ったのよ」「違う。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は投資が好きですが、仕事仲間を家へ入れることはありません」　ダーンリが苦笑い。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダーンリがとても穏やかに優しく言った。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラルフ・ダーンリは深呼吸して、華麗な景観と静寂を眺めた。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーンリさん、娘にすべて聞きました。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここでお目にかかれて嬉しいです」　ダーンリがそつなく返した。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでダーンリ君、今晩夕食を一緒にどうですか」　辞退せねば。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラルフ・ダーンリさん、近くご相談をおかけする場合は、是非お願いします」「心からきみが好きだ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダーンリ君、これからどうするのじゃ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ダーンリが申し出を断った。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はカリフォルニアで優良銀山を所有するダーンリのせがれに過ぎなかった。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラルフ・ダーンリとして愛を勝ち取りたい、そのあとで真実を話せばいい。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういうことですか、ダーンリさん」第七章　唯一の方法　一瞬、ラルフは言うに言われぬ不条理な怒りに襲われた。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "これこそラルフ・ダーンリが探して驚かせようとしていたものだ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "本能的にラルフ・ダーンリのことを考えた。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにおられたら是非お礼を……」「こちらがラルフ・ダーンリ氏です。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダーンリ氏を紹介します」　ラルフが会釈して、レディ・ダッシュウッドの方へ行った。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダーンリ氏がご一緒してくだされば嬉しいですね。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしかメアリが言うに、ラルフ・ダーンリさんとか」「その通りです。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダーンリさん、見せるものがあります。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、おっしゃい、なぜラルフ・ダーンリと自称するのですか」「ほかの名前は知りません。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "「分かりますよ、当分ラルフ・ダーンリで通しなさい。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのご希望は……」「ラルフ・ダーンリとして愛して欲しいのです。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから今日はただのラルフ・ダーンリとして話します。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "メアリがラルフ・ダーンリを愛し、一族の自尊心よりいいと思ったとき、真実を話します。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「こちらはラルフ・ダーンリ氏です。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            }
          ]
        }
