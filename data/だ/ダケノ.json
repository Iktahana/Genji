        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンニモシナイ、コレダケノモノ、キレイデショ？",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイロイロナ構図デ頭ガイッパイニナッテイルノデスガ、ナニシロマダカクダケノ腕ガナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春久ガシャワーヲ浴ビニ来サセテクレト云ウノハ、タヾソレダケノコトデナク、何カ魂胆ガアルノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "用心探イ医師ハ必ズソレダケノ注意ヲ怠ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "福島博士モ殊ニ重大ナ場合デアルカラ当然ソレダケノ手順ヲ蹈ンダ訳デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "医師ハ皆アレダケノ心ガケガナケレバイケナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "正面ニ菩薩ヲ刻ムダケノ、適当ナ厚ミヲ持ツ石ヲ用イレバ足リル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレダケノ準備ガ整ッタ時、予ハ先ズ第一ノタンポニ朱ヲ含マセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテソレダケノ間隔ヲ保チナガラ二人ハ進ンダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……アナタノ今ノ良人ノコト、及ビ弘君ノコトハ、御依頼ガナクトモ親戚ノ一人トシテ、親子ノ性質ヲ最モ良ク理解シテイル友人トシテ、及バズナガラ出来ルダケノ事ハスル積リデスカラ、決シテ心配シナイデ下サイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ、二人ダケノ事ナラ、マダ善カツタノデスガ、今度ノ様ナ事ニナルト、困ツテシマイマス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
