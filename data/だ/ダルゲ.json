        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この巨きな室にダルゲが居るんだ。",
              "citation": {
                "source": "圖書館幻想",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "室の中はガランとしてつめたく、せいの低いダルゲが手を額にかざしてそこの巨きな窓から西のそらをじっと眺めてゐた。",
              "citation": {
                "source": "圖書館幻想",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダルゲは灰色で腰には硝子の蓑を厚くまとってゐた。",
              "citation": {
                "source": "圖書館幻想",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダルゲが俄かにつめたいすきとほった聲で高く歌ひ出した。",
              "citation": {
                "source": "圖書館幻想",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダルゲは又じっと額に手をかざしたまま動かなかった。",
              "citation": {
                "source": "圖書館幻想",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ダルゲは振り向いて冷やかにわらった。",
              "citation": {
                "source": "圖書館幻想",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "『あゝポダルゲー生むところ、しるき譽のクサントス、　400及びバリオス心せよ、わが戰をやめん後、ダナオイ陣に安らかに騎乘のわれを引き返せ、パトロクロスを見る如く戰死の我を捨てなせそ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "此試合は得点に於てこそ接戦であるが、両軍共に当らず、極めて単調なるダルゲームであつた。",
              "citation": {
                "source": "野球界奇怪事　早慶紛爭囘顧録",
                "author": "吉岡信敬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
