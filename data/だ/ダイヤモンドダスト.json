        "examples": {
          "standard": [
            {
              "text": "冬の朝、ダイヤモンドダストが空を舞って、幻想的な光景が広がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ダイヤモンドダストは北国の厳寒期にのみ見られる現象だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "カメラに収めたダイヤモンドダストの写真は、本当に美しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "辺りは一面の新雪で、ダイヤモンドダストのようにキラキラと光を放ち、私は目がくらんでしまった。",
              "citation": {
                "source": "千里眼の村",
                "author": "クリスマス・ストーリー",
                "note": "青空文庫"
              }
            },
            {
              "text": "明るく鮮やかな二月の朝、凍てつく空気、ダイヤモンドダストが陽光にきらきら輝いている。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
