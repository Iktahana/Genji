    "definitions": [
      {
        "index": 1,
        "gloss": "daka-",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ふと耳にしたダカという響きに、思わず振り返った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その物語には、古代のダカという伝説の生き物が登場する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私はダカのような、力強いリズムに魅了された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "金魚鉢のメダカが、鉢の底から二寸くらいの個所にうかんで、じっと静止して、そうしておのずから身ごもっているように、私も、ぼんやり暮しながら、いつとはなしに、どうやら、羞ずかしい恋をはじめていたのでした。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "』といひつゝ、染々と吾等兩人の姿を打瞻め『此處は印度洋もズツト南方に偏した無人島で、一番に近いマダカツスル群島へも一千哩以上、亞細亞大陸や、歐羅巴洲までは、幾千幾百哩あるか分らぬ程で、到底尋常では人の來るべき島ではありませんが。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "數日以來の風は、隨分悽まじいものであつたが、颶風の常として、吾が輕氣球は幾度も同じ空に吹き廻されて居つた樣だから、左迄遠方へ飛ぶ氣遣はない、私の考では、下方に見ゆるのは矢張印度洋の波で、事によつたらマダカツスル島の西方か、アデン灣の沖か、兎に角歐羅巴邊の沿岸には、左程遠い所ではあるまいと思はれた。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "△夏はうれしや、プロの楽園、ルンペンの浄土、浴衣があれば蚊帳があればゆつくり暮らせる、ハダカで暮らせ、身も心も、君も僕も。",
              "citation": {
                "source": "行乞記",
                "author": "伊佐行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "風が強い、吹きとばされさうだつた、樹明君を途中まで送つて、それから局まで行つてハガキを投凾、そしてフラ／＼しながら戻る、戻つて茶を沸かし飯を食べる、なか／＼酔が醒めない、ハダカで寝る、アブラムシに笑はれた。",
              "citation": {
                "source": "行乞記",
                "author": "大田",
                "note": "青空文庫"
              }
            },
            {
              "text": "――オマエハ、バカダカラ、シラナイノダ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "カタツムリガ　ツノヲ　フツテルノヲ　ミテ　ヰルト、王サマハ、子ドモノ　ジブン、何ダカ、カタツムリノ　ウタヲ　ヨク　ウタツタ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ、アサダカラ、メヲ　ダシナサイ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンノ　ウデニ、オチチクサイ、シロイ　パヂヤマノ　カハイラシイ　アカチヤンガ、ダカレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハモーダメニナッテシマッタ、毎日訳モナク号泣シテ居ルヨウナ次第ダ、ソレダカラ新聞雑誌ヘモ少シモ書カヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレダカラ御無沙汰シテマス。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫ガ病人ニナッテシマッタノダカラ残念デタマラナイノダガ、君ノ手紙ヲ見テ西洋ヘ往タヨウナ気ニナッテ愉快デタマラヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボク　ドコヘ　イクンダカ　ワカラナイカラ、テフテフサン　モウ　オカヘリヨ」ト　フウセンダマハ　イヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "理智や、打算や策略には、それこそ愛の魚メダカ一匹住み得ぬのだ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラ愚論でないのサ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラ希臘の哲学者はまず哲学を学ぶ前に数学をやれと弟子達に教たのだよ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラ甘く天地を包含したようの事を示せるのサ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダカレケダカ、ダカレケダカ。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ダカレケダカ、と云ってるじゃあないか。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、翌日の夜、楢雄から速達が来て「俺ハ世間カラキラハレタ人間ダカラ、世間カラキラハレタレプラ療養所デ働ク決心ヲシタ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一部しじゅうをメダカたちが水の中で泳ぎながら聞いていました。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            },
            {
              "text": "メダカたちはおやゆび姫を見てみようと水面に頭を出しました。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな子がみにくいヒキガエルたちと暮らすなんてあんまりだ、とメダカたちは思いました。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
