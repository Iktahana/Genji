[
  {
    "uuid": "3818c09b-93d9-5af5-b9e0-17da79dc7f13",
    "entry": "大黒",
    "reading": {
      "primary": "だいこく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
