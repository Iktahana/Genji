        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "時々ダーター、フアブラと云ふ。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "与次郎は益得意になつて、ダーター、フアブラ我々新時代の青年は……とやつてゐる。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーターフアブラ、沙翁の使つた字数が何万字だの、イブセンの白髪の数が何千｜本だのと云つてたつて仕方がない。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "与次郎の隣りにゐたものが、「ダーターフアブラの為に祝盃を挙げやう」と云ひ出した。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーターフアブラとは何の事だ」「希臘語だ」　与次郎はそれより外に答へなかつた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四郎が、小さな声で、「些と、ダーター、フアブラを遣らないか」と云ふと、「今日は不可ない」と答へたが、すぐ横を向いて、隣りの男と話を始めた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて与次郎に尋ねたら、恐らくダーターフアブラの類だらうと云つてゐた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダーターフアブラは躍るべき性質のものと思へる。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々ダーターファブラと言う。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "与次郎はますます得意になって、ダーターファブラ我々新時代の青年は……とやっている。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーターファブラ、シェクスピヤの使った字数が何万字だの、イブセンの白髪の数が何千本だのと言ってたってしかたがない。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "与次郎の隣にいた者が、「ダーターファブラのために祝盃をあげよう」と言いだした。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダーターファブラとはなんの事だ」「ギリシア語だ」　与次郎はそれよりほかに答えなかった。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四郎が、小さな声で、「ちと、ダーターファブラをやらないか」と言うと、「きょうはいけない」と答えたが、すぐ横を向いて、隣の男と話を始めた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて与次郎に尋ねたら、おそらくダーターファブラのたぐいだろうと言っていた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダーターファブラはおどるべき性質のものと思える。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
