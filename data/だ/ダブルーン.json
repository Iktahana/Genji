        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "なぜなら、その貨幣はいろいろの国のさまざまの大きさのもので、――ダブルーン金貨や、ルイドール金貨や、ギニー金貨や、八銀貨や、その他私の知らないものなどが、みんなめちゃくちゃに詰め込んであったのだから。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ちぇっ、ピュー、己たちぁダブルーン金貨を手に入れたんだぞ！",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、ダブルーン金貨を探しに前進だ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九　ダブルーン金貨や、…………。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「ダブルーン金貨」は往時のスペインの金貨。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
