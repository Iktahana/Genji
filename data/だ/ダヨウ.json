        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私ガ主人ヲ抱キ起シタ時、主人ハサキ申シタ通リ殆ド死ンダヨウニナッテ居リマシタガ、私ガ旦那様旦那様トクリ返シマスト、カスカニ目ヲアキマシタガ、不意ニ思イガケナイ位大キナ声デ、「大寺……大寺ダ」ト申サレマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人ノ言葉ヲキクト今マデ死ンダヨウニナッテ居タ奥様ガ何カ云イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ神ガ乗リ移ッテイル間中、死ンダヨウニナッテイルノデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「痛インダヨウ、助ケテオクレヨウ！",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「接吻シテクレヽバ痛イノヲ忘レルヨウ」「足ナンカジャ駄目ダヨウ」「ネッキングデモ駄目ダヨウ」「ホントノ接吻デナクッチャイヤダヨウ」コンナ工合ニ散々駄々ヲ捏ネテ泣キ声ヲ立テ、悲鳴ヲ上ゲテ見タラドウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテチョウド糠味噌ノ中ヘ突ッ込ンダヨウニ手ガツメタイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏子ガ「大阪ヨ」ト素ッ破抜イタ時、僕ハ鳩尾ノ辺ガピクント凹ンダヨウナ気ガシタガ、イツマデモソノ感ジガ続イテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
