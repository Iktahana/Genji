        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "父母共ニナキ兒童ヲ孤兒院ニ收容セザル所以ハ、孤兒院ノ弊害甚ダシキト、兒童ノ保護者トシテ血族長者ノ保護ニ優ル者ナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ強ヒテ此ノ日本改造法案大綱ヲ名ケテ日本民族ノ社會革命論ナリト云フ者アラバ甚ダシキ不可ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ今甚ダシキ危険ニ臨ミ居レリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "李時珍がその著『本草綱目』の蒜の条下でいうには「家蒜ニ二種アリ、根茎倶ニ小ニシテ弁少ナク辣甚ダシキ者ハ蒜ナリ小蒜ナリ、根茎倶ニ大ニシテ辣多ク辛シテ甘ヲ帯ブル者ハ葫ナリ大蒜ナリ」（漢文）と述べている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日の午後飛んで帰ってきたＹ君の話によると、何でも家から「テラダシキキヨウマツスクカヘレ」という電報が郷里へ行って、それが丁度Ｙ君が親類の結婚披露とかの席に列っている所へ配達され、それという勢いでＹ君は今朝の三時に起きて一番で帰ってきたという話なのである。",
              "citation": {
                "source": "先生を囲る話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
