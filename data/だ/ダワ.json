        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ポストノ　ウエニ　トマツテ　ヰタ　スズメガ、「アレハ　ワタシノ　カゲダワ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたは、アフガニスタンのダワダールで降りて、『大地軸孔』へゆくつもり……ねえ」「いや、大変なちがいだ。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "何をしていても、それがコダワって来る。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンダワラ一名神馬草、神功皇后征韓の船中｜秣に事欠き、この海藻を採って馬に飼うた故名づくと（『下学集』下）。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "邦俗ホンダワラてふ藻を神馬草というは、その波に揺れながら枝葉間に諸生物を安住せしむる状を件の神馬王の長毛に比して学僧輩が名づけたのかも知れぬ。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "……こう気が付いて来るに連れて、今まで私の頭の中一パイにコダワっていた疑問だの、迷いだの、驚ろきだのいうものが、みるみるうちにスースーと頭の中から蒸発して行った。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お人好しの福太郎は源次に対しても、他の者と同様に何のコダワリもないニコニコ顔を見せる一方に、お作は又お作で、「あの腰抜けの源次に何が出来ようかい」　と云わぬ半分の大ザッパな調子でタカを括っているらしかった。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時には太郎もシクシク泣いていたが、元来｜柔順な児だったので、何のコダワリもなく彼の言葉を受け入れて、心からうなずいていたようであった。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭のまん丸いホンダワラのような楕円形をした……その根元の縊れたところから細い紐で海底に繋がっている。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "電話でいいから掛けといてくれ給え」　それはイツモの気軽い彼女には似合わない、妙にコダワッた薄暗い応対であった。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（東京の美しい、義理堅い花柳界を知つたならば、幾分かオダワラ育ちの野卑の教養にもなるだらう。",
              "citation": {
                "source": "蝉",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノアナタガ私ガ今誰ヲ又愛シヨウト、何モ云ウ権利ハナイ筈ダワ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ馬鹿サンネ、私がアナタニ身ヲ任セタノハカラカッタカラダワ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そうさなア、俺にしても、どうやらお前に助けられるより、土をかけられた方がよかったようだ」一向コダワラずにズバズバ云う。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今健康ダワシをたのんであります、これ迄ずっとお風呂のときつかっていたのですが。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩哨の兵士のきているのによく似た裏毛の防寒外套の胸をはだけたまま、不精ひげの生えた頬っぺたの両側に防寒帽のたれをばたつかせたまま、馬子は、「ダワイ！",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダワイということばは、呉れ、という意味だとならった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬子は、いかにも元気の出そうな調子でダワイ、ダワイと叫んだけれど、それはどういう意味なのだろう。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ダワイ）」「…………」「どうして？",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いいえ、一滴も」「家族の誰か、癌をわずらっていますか」「いいえ、誰も」「ハラショー」　フロムゴリド教授は椅子から立ち上って、伸子に、「じきましになりますよ」と云い、わきに立っていた助手のボリスにダワイ何とかとロシア語にドイツ語をまぜて指図した。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "部落の男の子たちが、そこへかたまって、サンダワラを尻の下に敷いて、ウォータ・シュートのように辷りっこをしている。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モンコチヤン　アナタガボンコチヤンヲカブツテヰルカツカウハトテモヘンダワ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨシヲサンノオ母サンハ、オカシクナツテ「アラ、マア、何テヘンナオ子サンダラウ、マルデ、カツパノオバケミタイダワ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくせ、彼は、亀井勝一郎が何かの中で自ら名門の子弟を名乗ったら、ゲッ、名門、笑わせるな、名門なんて、イヤな言葉、そう言ったが、なぜ、名門がおかしいのか、つまり太宰が、それにコダワッているのだ。",
              "citation": {
                "source": "不良少年とキリスト",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウダワ、とか、ダワヨ、アソバセ、というような女性語は流行の衣裳や化粧と同じような、一種の装飾的な自己表現でもある。",
              "citation": {
                "source": "敬語論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "実家はどこか、と問うと、オダワラ、と片仮名で書いて示したそうです。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、熱海駅ですれちがった時にも、何か都合があるのだろうと思い、汽車の時間があるので急いで行ってしまったのだろうと、なんのコダワリもなく考えていた。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなコダワリがあったようには思われないが、張りつめた気が弛んだ時には、そんな気がした。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
