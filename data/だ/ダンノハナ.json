        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一一一　山口、飯豊、附馬牛の字荒川東禅寺および火渡、青笹の字中沢ならびに土淵村の字土淵に、ともにダンノハナという地名あり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "○ダンノハナは壇の塙なるべし。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一一二　ダンノハナは昔｜館のありし時代に囚人を斬りし場所なるべしという。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "山口のダンノハナは大洞へ越ゆる丘の上にて館址よりの続きなり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "東はすなわちダンノハナとの間の低地、南の方を星谷という。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一一四　山口のダンノハナは今は共同墓地なり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
