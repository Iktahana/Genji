  {
    "uuid": "8712d90f-35eb-5e9d-9677-fd5a20860a88",
    "entry": "ダラケ",
    "reading": {
      "primary": "だらけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「まったく、ダラケきって、エラそうに、こんなイスでふんぞりかえりやがって」　山崎は、イス越しに高志の背中を軽く蹴飛ばした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母チャマ……ソウチタラネ……お部屋の中が泥ダラケなのよ……」「……エ……」　若い女性は顔の色をなくした。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾が青年名探偵アンポンタン・ポカン博士は、タッタ今地上にタタキ付けたばかりの泥ダラケの脳髄を指して、コンナ論証を続けているのだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな馬鹿な事がといったって、木乃伊の親方は、総立ちの見物人と、楽屋総出の介抱と、吾輩の泣きの涙の中に、ホコリダラケの板張りの上で息を引取ったのだから仕方がない。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろそこいら中反射鏡ダラケの部屋に、天井一パイの花電燈が点いたんですからね。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとその私の前をスレスレに、一台の泥ダラケのフォードが近づいて来たと思うと、私の鼻の先へ汚れた手袋の三本指があらわれた。",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（探偵小説……小説としても……事実としても……何だか間違ダラケのような危なっかしい気がしますなあ。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ずアンナ風に何も知らない人間を、昨夜みたいに麻酔さしておいて、スコポラミンと阿片の合剤を注射して、一層深い、奇妙な、変ダラケの昏睡に陥れる。",
              "citation": {
                "source": "人間レコード",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "万平はお尻を泥ダラケにしたまま、腕を組んで考え考え歩いた。",
              "citation": {
                "source": "芝居狂冒険",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼓でも似たものですが、いくらか楽なのでその方にして、「焼けあとの二つの死骸」を最初に持って来て又十枚ばかり書きますと、とても骨が折れて筋が運べない上に、あとの説明が私の力ではどうしてもダラケそうに思われます。",
              "citation": {
                "source": "所感",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁は旧友から貰ったという竹製のカンカン帽に、手織｜木綿縞の羽織着流し、青竹の杖、素足に古い泥ダラケの桐下駄、筆者は五リン刈の坊主頭に略法衣、素足に新しい麻裏という扮装である。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "絹ずくめの振袖でも十両仕立ての袢纏でもタッタ一度で泥ダラケにして惜しい顔もせずに着棄て脱ぎ棄てだ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "通ったにも通らぬにも甲の上ダラケの優等生で……ヘエ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "商売物の箒が泥ダラケになってしまった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局、娘の親たちへ知らせなければなるまい……というので、とりあえず青年会員が二人、娘のうちへ自転車を乗りつけると、晴れ着をホコリダラケにしたその娘が、おやじに引き据えられて、泣きながら打たれている。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は自分の肉体と精神の弾力が、日に日にダラケて消え失せて行くのを感じた。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日毎日、何の目的も楽しみもないカラッポの世の中を、切れるような風に吹かれたり、ゴミダラケの太陽に焼かれたりして、生命がけで駈けずりまわるようなもんよ。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "見かけだけ美しくて、内容の乱れ腐れて行く東京を見ながら、どうする事も出来ない人々のダラケタ頽廃した哀愁がこもっていた。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
