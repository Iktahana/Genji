        "examples": {
          "standard": [
            {
              "text": "転んで泥だらけになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "事故で全身血だらけの人が運ばれてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は汗だらけになりながらも、仕事を続けた。",
