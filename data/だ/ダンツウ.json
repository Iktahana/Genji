    },
    "definitions": [
      {
        "index": 1,
        "gloss": "cotton carpet",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……　此の陽氣で、障子を開放した中には、毛氈も見えれば、緞通も見える。",
              "citation": {
                "source": "飯坂ゆき",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちおさやんの家が蔵を壊して其処で緞通を織り初めたと云ふことを出入の人などが噂しました。",
              "citation": {
                "source": "私の生ひ立ち",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "龍源さんでは嬢さんも職工と一所に緞通を織つておいでになります。",
              "citation": {
                "source": "私の生ひ立ち",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方が無いので、新見はそれを大きな天幕の中の緞通の上に坐らせた。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの「堺緞通」は、昔から「鍋島緞通」などと共に有名なものであります。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故幾種かある日本の緞通は大切に保護されてよいでありましょう。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "播州の赤穂は四十七士の物語で誰も想い起す所でありますが、また「赤穂緞通」でもその名が知られます。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "敷物では別に「倉敷緞通」があります。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃盛になった品でありますが、織方は特許で、巻くのに易く、それに緞通としては値も格安であります。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二蕎麦の花――秋はやい山間の、白茶けた手織木綿の緞通。",
              "citation": {
                "source": "独楽",
                "author": "高祖保",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
