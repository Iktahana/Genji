        "examples": {
          "standard": [
            {
              "text": "駄目で元々だから、一度告白してみようと思う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しいプロジェクトに挑戦するのは、駄目で元々くらいの気持ちで。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "駄目で元々と腹をくくって社長に直談判したら、意外にも話を聞いてもらえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "その日の午後、最奥の謎を知りかつ尋ねうる唯一の相手からその謎に関してわずかなりとも情報を得ようと、駄目で元々で、父親と医師は湾を下り病院のウォード青年を訪ねた。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
