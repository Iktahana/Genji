        "examples": {
          "standard": [
            {
              "text": "靴がきつくて、第五趾が痛くなってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "スポーツをする際、足の第五趾までしっかりと保護してくれる靴が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "外反母趾気味なので、第五趾に負担のかからない靴を選んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "左足ノ第四趾ト第五趾ガ全ク麻痺シテイル。",
