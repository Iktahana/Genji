[
  {
    "uuid": "f2b368c7-49f2-50cf-8ead-bbe7c8d91c83",
    "entry": "抱きとめる",
    "reading": {
      "primary": "だきとめる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
