        "examples": {
          "standard": [
            {
              "text": "堕落坊主として、彼は村人から軽蔑されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "物語の中には、金に目がくらんだ堕落坊主が登場する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "堕落坊主の振る舞いは、宗教への信頼を失わせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "この寺の覚光という青坊主がまたお話にならない堕落坊主で、酒は飲む、博奕は打つ、女狂いはするという奴だから堪まらない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "蝶合戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし善昌も堕落坊主を思い切ることは出来ない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "蝶合戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "破戒無残なる堕落坊主。",
              "citation": {
                "source": "死剣と生縄",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
