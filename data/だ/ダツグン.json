          "literary": [
            {
              "text": "兵の脱軍が続出する。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "村重もまた、毎日、散々に脱軍する部下を恨むこともならなかった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、久我｜畷から淀をこえ、伏見の里に来るまでに、ほとんど、散々に脱軍して、残るは腹心の者ばかりわずか十三騎とまでなってしまった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            }
          ]
