        "examples": {
          "standard": [
            {
              "text": "親が子どもの法的手続きに対して代理権を持つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "契約書に代理権の範囲を明確に記載することが重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼は会社の代理権を与えられ、契約交渉を一任された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "わがヤクーツク造船所の販売代理権を極めて好条件で貴君の手に委ねることにつき、余は用意がある。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼らの一人カリクセノスがその五日後に他界し、いよいよ相続の代理権がアレテウスの手に帰するや、このアレテウスは、エウダミダスの母をねんごろに扶養した上、その財産五タレントのうち二タレント半を自分の娘に、残る二タレント半をエウダミダスの娘に与え、二人の少女を同じ日に嫁入りさせた。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
