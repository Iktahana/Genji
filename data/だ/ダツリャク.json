        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "戦乱に乗じて略奪を繰り返す兵士たちは、村々の穀物や家財道具をことごとく奪掠していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「かつての海賊は、沿岸の町を襲っては金銀財宝を奪掠し、海の彼方へ消え去ったという」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "外国軍の侵攻によって、博物館の貴重な展示品が奪掠されるという悲劇が起きた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "将門背走相防ぐ能はざるの間、良兼の為に人物を殺損奪掠せらるゝの由は、具さに下総国の解文に注し、官に言上しぬ、爰に朝家諸国に勢を合して良兼等を追捕す可きの官符を下され了んぬ。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "占領、奪掠、突撃、死守、　悶絶、再襲、　ああ、しかもまだ彼等が争闘の主因たる成牝（カウ）たちは遥かな遥かな水平線の向うにいるのだ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "強姦奪掠憚らねば、市街の商人は武裝して、我が暴行を防がむとす。",
              "citation": {
                "source": "長塚節歌集　中",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまり評判のよくないほうで有名なローマの最後の王様タルキヌスがほうぼうで攻め落とした敵の市街からの奪掠物で寺院を建てた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "げにや当年の己は空恐ろしくも信心無く、或日｜精舎の奪掠に負けじ心の意気張づよく神壇近き御燈に煙草つけたる乱行者、上反鬚に気負みせ、一歩も譲らぬ気象のわれも、たゞ此僧の髪白く白く神寂びたるに畏みぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "げにや当年の己は空恐ろしくも信心無く、或日精舎の奪掠に負けじ心の意気張づよく神壇近き御燈に煙草つけたる乱行者、上反鬚に気負みせ、一歩も譲らぬ気象のわれも、たゞ此僧の髪白く白く神寂びたるに畏みぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏訳詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "げにや當年の己は空恐ろしくも信心無く、或日｜精舍の奪掠に負けじ心の意氣張づよく神壇近き御燈に煙草つけたる亂行者、上反鬢に氣負みせ、一歩も讓らぬ氣象のわれも、たゞ此僧の髮白く白く神寂びたるに畏みぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼女達のために音楽を奏し、狩猟のお供をし、奪掠者から彼女達を護った。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "中世の女性達は女としての奇智の限りを尽して、非道な奪掠者と闘った。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "初め鉱山師の徒、地方官と結托して堤防を脆弱ならしめたるを第一着とし、明治三十二年間牒を村村民を貧弱ならしめ以て全村を奪掠せんことを企てたるを第二着とし、明治三十六年一月十六日臨時県会を召集して買収案を議せしめ否決せられて事の破れたるを第三着とせり。",
              "citation": {
                "source": "非常歎願書",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾等村民ハ日に同胞の毒手に誘惑せられて困頓窮厄に艱み、郷閭の地より誘拐せられて異村の山河に悲み、家庭ハ冷かに墳墓ハ乱るゝの惨状に沈淪して哭天慟地の血涙に咽ぶの時に当り、人道上残虐の不幸に遭逢せる者を救ハれ豊饒なる吾等の居村を保持して財産を奪掠せらるゝの災厄を免るゝを得バ、衷心の歓喜何物か之ニ如かん。",
              "citation": {
                "source": "非常歎願書",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前は、強欲者の酒倉を襲って酒樽を奪掠するこの泥棒詩人の、ブセハラスではなかったか！",
              "citation": {
                "source": "ゼーロン",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うの男は愛子を一種の奪掠手段で貧しい本当の親元から結婚の許しを得たにせよ、僕の方には真実の愛子を愛する心も愛子を想う心もあるわけです。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "奪掠婚というが、これは近世ばかりか、今も、その形式は内地にも残っている。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ古代の奪掠法とも見える結婚の記録も、巫女生活の記念という側から見ると、そう一概にも定められぬところがある。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "奪掠婚に対して、逃走婚という方法を考えに入れねば、奪掠の真意義もわかりにくかろうと思う。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には呪咀もし、奪掠もした。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "とうてみずむと、外婚とを聯絡させて考へてゐるふれいざあ教授は、奪掠せられて異族の村に来た女が、きまつた数だけの子どもを生めば、村から逐ひ出される例を挙げて居る。",
              "citation": {
                "source": "信太妻の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "奪掠婚と言ふが、此は近世ばかりか、今も、其形式は内地にも残つて居る。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯古代の奪掠法とも見える結婚の記録も、巫女生活の記念と言ふ側から見ると、さう一概にも定められぬところがある。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "奪掠婚に対して、逃走婚と言ふ方法を考へに入れねば、奪掠の真意義もわかりにくからうと思ふ。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "これみなただローマ人の腕力をもって各地より掠奪し来たるものにして、ローマの都府雄麗天下に冠たりといえども、一の特有産物とてはなく、ローマ人はただその奪掠し来たりし金銀をもって、その奪掠せられたる各邦の産物と交易〔もしこれを交易というを得ば〕したるのみ。",
              "citation": {
                "source": "将来の日本",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれにもせよ四百年前｜回々教徒のために奪掠せられたる旧都はふたたびその旧主人たるキリスト教徒の手に回復すべきはすでに歴史の眼中に髣髴たるを見るなり。",
              "citation": {
                "source": "将来の日本",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが王わが宰相の奪掠を好む。",
              "citation": {
                "source": "将来の日本",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにがゆえにその大奪掠家たる資格に加うるに商業家の性質をもってせんと欲するか。",
              "citation": {
                "source": "将来の日本",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れども人類の原始は、甚だ遼遠なり、歴史のはじまりし以前、太古※遠の時代に於て、奴隷奪掠、婦女奪掠等の風習は、時としては間接に、神話伝播の媒介となりしやも知る可からず。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにをするかとみていると、煙草の入った箱とマッチとを、だつりゃくした。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
