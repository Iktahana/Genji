        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「明日までに終わらせるよ。」「だから、ちゃんと頼んだぞ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「もう言ったでしょ？」「だから、もう一度教えてほしいの。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「何回言ったらわかるんだ？」「だから、わかってるって言ってるじゃないか。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
