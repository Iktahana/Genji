        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "次から次へ、だあだあと出る水をもって、大調子な構えでもって拵える。",
              "citation": {
                "source": "洗いづくりの世界",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてちらと又四郎のほうを見て、なにか気にいらぬとでもいったふうな顔をし、「だあ、ぷう、だあだあ」　こう怒ったうえ、おかね嬢の膝へ這いあがった。",
              "citation": {
                "source": "百足ちがい",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
