          "literary": [
            {
              "text": "」「そりやア、行くが、ね――」考へて見ると、第一子（女であつた）もヂフテリヤの苦しみに枕もとの小ランプを攫まうとしながら死んだ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "富美子のはその祖父の死因と等しく腎臟が惡いのであつて、ヂフテリヤではなかつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夏――　Ｓ子はヂフテリヤに罹つた――三度目の注射。",
              "citation": {
                "source": "女七歳",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
