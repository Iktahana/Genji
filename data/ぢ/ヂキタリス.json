        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "築山を繞つて覗かれる花畑にはヂキタリスの細い頸の花が夢の焔のやうに冷たくいく筋もゆらめいてゐた。",
              "citation": {
                "source": "汗",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　油蝉の方言　螢夏の日なかのヂキタリス、釣鐘状に汗つけて光るこころもいとほしや。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い日なかのヂキタリス。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　油蝉の方言螢夏の日なかのヂキタリス、釣鐘状に汗つけて光るこころもいとほしや。",
              "citation": {
                "source": "思ひ出",
                "author": "抒情小曲集",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故なら、妖精なんてヂキタリスの花や葉の間や蕈のかげや、古壁の隅を匍つた連錢草の下を探したけれど、どこにも見附からないので結局、そんなものはもうみんな英吉利を立退いてもつと自然のまゝに森が生茂つて人氣の少い未開の蠻地へ行つたに違ひないと云ふ悲しい諦めを信ずるやうになつたから。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者はヂキタリスを用ゐてゐたので、もう其れが今日位から利くだらうと言つた。",
              "citation": {
                "source": "落葉降る下にて",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
