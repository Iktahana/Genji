          "literary": [
            {
              "text": "味噌汁、トースト、山羊の乳、それから浅間葡萄のヂャミ。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヂャミパンでも貰ふかな」　彼は店頭でパンを噛つたが、全然味がわからなかつた。",
              "citation": {
                "source": "麓",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この協会の創立は一七九九年で、有名なルムフォード伯すなわちベンヂャミン・トンプソンの建てたものである。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "附記ルムフォード伯　名はベンヂャミン・トンプソン。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベンヂャミン・フランクリンと同名であり、時代も近いし、両方ともアメリカのボストンに近い所で生れた。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名の医者サー・ベンヂャミン・ブロージー（人）Sir Benjamin Brodie. 一七八三―一八六三。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            }
          ]
        }
