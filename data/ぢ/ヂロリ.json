        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "俊男はヂロリ妻の顏を見て、「別に何も考へてゐやしないさ。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　昌作はヂロリと其方を見た。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "盗賊と称ふ形容は、無稽に過ぎるかも知れないが、それは何気なく云ふ藤井ではあつたが、それに依つてヲダハラの母の話に触れて、ヂロリと猜疑の聴耳を立てる彼の心は目的を定めて、姿を窶して日夜目的の家の周囲を探偵してゐる仕事準備中の泥棒のそれに比べるより他に、比較するものはなかつた。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀田は二人の傍を素通りして、ヂロリと卓上の壜を眺めながら、「僕にもその酒が飲めると好いんだがね。",
              "citation": {
                "source": "街角",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "大抵の知らない宿屋へ行つては、ヂロリと一ぺん見られて、体よくお断りを喰つたもんだ。",
              "citation": {
                "source": "本因坊と私",
                "author": "関根金次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "看守は五六人の人を廊下に呼び上げると、その小さな鼻の上に乗せた眼鏡ごしに、ヂロリと不快な一瞥を残された者の上に投げてその儘皆んなの後をおふて奥の方に這入つて行つた。",
              "citation": {
                "source": "監獄挿話　面会人控所",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷たい、底意地の悪い眼で何かをさがすやうにヂロリと控所の中をねめまはして行く。",
              "citation": {
                "source": "監獄挿話　面会人控所",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　父親の紋七は、荒々しく上りかまちに腰をかけ、息子の顔を、ヂロリとにらみつけた。",
              "citation": {
                "source": "山形屋の青春",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "〆切に追ひまくられ女房が鍋の音をガチャリとさせてもギラギラした目を三角にしてヂロリと睨むくせに、マダムが先生チョットと呼びにくると困りきつた顔半分相好くづしていそいそと出たまゝ夜更けまで帰らずベロ／＼になつて戻つて小説は間に合はず、貧窮身にせまる。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村、三七桂（十四分）パチリと打ち下して、タバコをグッと吸ひながら、記録係の方をヂロリと睨む。",
              "citation": {
                "source": "勝負師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生字が読めないのだと分つたから、読んでごらん、と言ふと、ヂロリと睨んでアッサリ原稿を投げすてて、蟇口の中から十銭玉を畳の上へ幾つかころがした。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "五郎　いや……（ヂロリヂロリと京子の姿を眼で舐めまわしてゐる）京子　どうなすつたのよ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に視線を移して、ズツと離れて一番向ふの隅に陣取つた刑事と青年の方をヂロリヂロリと睨む。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君あ、なにか……」　返事をしないでヂロリと見る土方。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ヂロリと留吉を見て）へん！",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハ……お辻、修へヂロリと眼をやり、テレかくしに頭髪の根を櫛でゴシゴシ掻いてゐる。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
