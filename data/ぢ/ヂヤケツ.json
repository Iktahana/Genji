          "literary": [
            {
              "text": "鼠いろのヂヤケツの青年がすぐその前に顏を出した。",
              "citation": {
                "source": "一過程",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうかと思ふと、急に、しんみりした科で、初瀬の毛糸のヂヤケツをつまんでみながら、黙り込んでしまつた。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "左手から、ヂヤケツに白ズボンを穿いた青年が、ゆつくり歩いて来る。",
              "citation": {
                "source": "秘密の代償",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（オーケストラの音が再び起る）留雄　　（ルイーズのヂヤケツトを持ちて出で来る）これでいいんですか。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（立ち上る）留雄　　（ヂヤケツトをルイーズに着せかける）ルイーズ　　（着終りて、留雄の手を握る）熱い手、熱があるんぢやない。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
