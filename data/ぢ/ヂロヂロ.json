        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "』と菊池君は吃る樣に答へて、變な笑ひを浮べ乍ら、ヂロヂロ一座を見※したが、私とは斜に一番遠い、末席の空席に悠然と胡坐をかく。",
              "citation": {
                "source": "菊池君",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやにヂロヂロと物を見るやうな観察。",
              "citation": {
                "source": "三月の創作",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "小學校歸りの兒童が五人八人ぐらゐづつ一塊になつて來て、二人の姿をヂロヂロ見やつては、不思議さうな顏をして駈け去つた。",
              "citation": {
                "source": "東光院",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけがわからず、スミと楽士達を見較べて黙つてヂロヂロ見てゐる土方。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "土方は、「警察」と言つた相手の顔をヂロヂロ見てゐるだけでだまつてゐる。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かを捜す様に室の中をヂロヂロ見廻した後、引込む。",
              "citation": {
                "source": "疵だらけのお秋（四幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉山、沢子をヂロヂロ見てゐる。",
              "citation": {
                "source": "疵だらけのお秋（四幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中の二人をヂロヂロ見る）洋服　……あんた等も妻恋行きかね？",
              "citation": {
                "source": "妻恋行",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし此れなどは非常識でも愛矯のある部だが、これも矢張り同じ風呂場で、或る朝私が湯槽の縁にしやがみながら、湯を浴びてゐると、中に漬つてゐる二人連れの男が、つい鼻の先で、此方を無遠慮にヂロヂロ見つめては話をしてゐる。",
              "citation": {
                "source": "阪神見聞録",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
