          "literary": [
            {
              "text": "庭の池の水が緑黒くドロドロになつて、囲りの木の葉が動かずにヂツトそれを覗き込んでゐた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は其様子を見て、兼て母の申聞かせもあることですから、ヂツト辛抱して黙つて坐つて居り升た。",
              "citation": {
                "source": "黄金機会",
                "author": "若松賤子",
                "note": "青空文庫"
              }
            },
            {
              "text": "阪井　（それまでヂツト隅の椅子から自分を見詰めてゐたお秋に）――もう一杯。",
              "citation": {
                "source": "疵だらけのお秋（四幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その側にヂツト正面を向いて坐つている阪井の姿。",
              "citation": {
                "source": "疵だらけのお秋（四幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お稻荷樣だつて默つちや居なさるめえ」　こんな噂を平次はヂツト聽いて居りました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "鈴を慕ふ女",
                "note": "青空文庫"
              }
            },
            {
              "text": "○アングロチエイニイズ、システムのゼスフイルド公園ローングラスの上に静かに立つた水兵服の少女ホツプの頭、黄色のハンカチーフが目立つヂツト見たら逃げ出してしまつた。",
              "citation": {
                "source": "上海の絵本",
                "author": "三岸好太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
