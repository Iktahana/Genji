            {
              "text": "タッタ、ヂャンヂャン。",
              "citation": {
                "source": "阿Ｑ正伝",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤーヤーヤー………　タッタ、ヂャンヂャン、ドン、ヂャラン、ヂャン。",
              "citation": {
                "source": "阿Ｑ正伝",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヂャンヂャン」阿Ｑは彼の名前の下に、「さま」という字が繋がって来ようとは、まさか思いも依らなかった。",
              "citation": {
                "source": "阿Ｑ正伝",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは外の話で自分と関係がないと思ったから、ただ「ドンチャン、ドンチャン、ヂャラン、ヂャンヂャン」と言っていた。",
              "citation": {
                "source": "阿Ｑ正伝",
                "author": "魯迅",
                "note": "青空文庫"
              }
            }
          ]
        }
