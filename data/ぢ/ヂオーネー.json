          "literary": [
            {
              "text": "ヂオーネー之を慰めて傷を治す。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時神母＊ヂオーネー、アプロヂイテー聲あげて、　370膝に倒るをかき抱き、玉手靜かに艶麗の愛兒を撫でゝ口開き之に向ひて宣んし曰ふ、370　ヂオーネーはホメーロスの作中只單にアプロヂーテーの母神としてのみ記され、局面中何らの行動に加はらず。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "※アプロヂィテー（キュプリス）（ラテン名ヴェーヌス）ヂュウスとヂオーネーとの子、アイネーアスの母神。",
              "citation": {
                "source": "「イーリアス」例言",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            }
          ]
        }
