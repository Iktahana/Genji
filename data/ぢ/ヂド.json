        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ヂド」（カルタゴ女王の名にて又｜樂劇の名となれり）を興行すといふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "是れヂドが戀の始なるべし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "去りてヂドを棄てんとす。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "憐むべしヂドはおのれが榮譽と平和とを捧げて、これを無情の人におくり、その夢猶未だ醒めざるなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヂドは舞臺に上りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めわれこのヂドといふ役を我心に畫きしときは、その姿いたく今見るところに殊なりしかど、この歌女の意外なる態度はすこしも我興を損ふことなかりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヂドは戀の歡を歌へり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "この詞を聞きたるときの心をば、ヂドいかに巧にその眉目の間に畫き出しゝ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヂドは今｜主なる單吟に入りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "これヂドとエネエアスとの對歌なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヂドは無情なる夫のせめては啓行の日を緩うせんことを願へり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヂドは色を喪ひて凝立すること少らくなりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ最早ヂドならず、戀人なるヂド、棄婦なるヂドならず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヂドは夫の遺れたる武器を取りて立てり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヂドが初めて場に上りし時、單吟に入りし時、對歌せし時より、曲終りし時まで、一々肝に銘じて、其間の一節だに忘れざりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヌンチヤタがヂドは妙藝なり、その歌女は美質なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヌンチヤタは再びヂドとなりて出でぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "されどヂドの役にては、姫が全幅の精神を見るべし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "始て君がヂドに扮し給へるを見しとき、われは直ちにこの事をベルナルドオに語りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "その曲は偶※アヌンチヤタがヂドに扮して唱ひしものと同じけれども、その力を用ゐる多少と人を動す深淺とは、固より日を同うして語るべきならず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
