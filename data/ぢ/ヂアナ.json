          "literary": [
            {
              "text": "こゝには古きヂアナの祠の址あり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "前壁には、ヂアナとアクテオンとの大圖を畫けり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "（アクテオンは、希臘の男神の名なり、女神ヂアナを垣間見て、罰のために鹿に變ぜられ、畜ふ所の群犬に噬まる。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがために文化諸領域――思想、宗教、教育、科学、技術、文芸、出版、ヂアナリズム、体育、医療施設、娯楽等――における革進的な識者を総動員して建設的な企画を作ることが重要であり、これは目下着々進捗してゐる。",
              "citation": {
                "source": "文化政策展開の方向",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "※アルテミス　狩を好む神女（ラテン名ヂアナ）。",
              "citation": {
                "source": "「イーリアス」例言",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
