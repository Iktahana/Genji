          "literary": [
            {
              "text": "向うのストックブリッヂには、歴史や小説を山ほど書いて、世に名高いヂェイムズさんもいる。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年の夏、バークシアで知合いになった人だが、出版もやれば、詩も書くというヂェイ・ティー・フィールヅ氏は、一目で僕の話のすぐれた価値が分るだろう。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "古くても面白くためになるのはヂェイムズの『心理學』今田譯、大正十五年、岩波書店）である。",
              "citation": {
                "source": "心理學",
                "author": "矢田部達郎",
                "note": "青空文庫"
              }
            }
          ]
        }
