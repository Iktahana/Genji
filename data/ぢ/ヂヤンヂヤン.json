        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私の胸は戦きのために気たたましい半鐘がヂヤンヂヤンと鳴り響き、足は地を踏む心地すらなかつたにも拘はらず、身動きもせずに屋内の様子を窺つてゐたのである。",
              "citation": {
                "source": "変装綺譚",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がよろこべば、私を愛してくれる若い女たちがヂヤンヂヤン宣傳してくれるにきまつてゐる。",
              "citation": {
                "source": "あるとき",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "金を出さうとすると、彼女は、そこにおいてある呼鈴をヂヤンヂヤン鳴らしだした。",
              "citation": {
                "source": "北支物情",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
