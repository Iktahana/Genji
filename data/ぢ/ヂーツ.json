          "literary": [
            {
              "text": "それでわたしはよくヂーツゲン（ディーツゲン）の言葉を引用して、社会主義と無政府主義の差異をできるだけ少なくすることに努め、社会主義はどこまでも無政府主義を包容していくべきだと考えていた。",
              "citation": {
                "source": "赤旗事件の回顧",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と旦那の顏をヂーツと見つめた。",
              "citation": {
                "source": "兵隊の宿",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヂーツと鳴つてゐるのは壊れかゝつたこの家の呼鈴ぢやなからうか。",
              "citation": {
                "source": "南京六月祭",
                "author": "犬養健",
                "note": "青空文庫"
              }
            }
          ]
        }
