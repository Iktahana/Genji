        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "）「フレデリツク、シイズ、パアル、ラ、グラアス、ド、ヂヨオ、ロア、ド、ダンマルク、デ、ワンダル、デ、ゴオト。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「紫式部、清少納言、ヂヨオヂ・エリオツト、クリスチナ・ロセツチ……成程ほんとやわ、みんな髯があらへん。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロイド・ヂヨオヂを軽蔑するのは好い。",
              "citation": {
                "source": "僻見",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、そこにも一枚のポスタアの中には聖ヂヨオヂらしい騎士が一人翼のある竜を刺し殺してゐた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一匹の毒竜はその谷底に、白馬へ跨つた聖ヂヨオヂと、もう半日も戦つてゐる。",
              "citation": {
                "source": "LOS CAPRICHOS",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖ヂヨオヂは槍を揮ひながら、縦横に馬を跳らせてゐる。",
              "citation": {
                "source": "LOS CAPRICHOS",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽快な蹄の音、花々しい槍の閃き、それから毒竜の炎の中に、※々と靡いた兜の乱れ毛、……　トムは遠い崖の下に、勇ましい聖ヂヨオヂの姿を見ると、苦々しさうに舌打ちをした。",
              "citation": {
                "source": "LOS CAPRICHOS",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の如く骨董鑑賞家がその秘蔵品を競売に附するの方法は一時巴里好事家の間に流行し、ヂヨオ、バルブットオ諸家の蒐集品もまた同じく散逸したりき。",
              "citation": {
                "source": "江戸芸術論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
