          "literary": [
            {
              "text": "クツヤノ　ヂイサンハ　一リデ　セツセト　クツヲ　ツクツテ　ヰテ、フエフキガ　フエヲ　フキハジメルト、「ウルサイカラ　イツテ　オクレ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　フエフキガ　ヒトリゴトヲ　イフト　ヂイサンハ　カホヲ　アゲテ、「サウサ、カナヅチハ　ナンデモ　ツクルンダ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラツパ新美南吉　オヂイサンハ　イナカニ　ヒトリボツチデ　クラシテ　ヰマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハ、ソノ　ラツパヲ　ヨロコンデ　ツカツテ　ヰマシタガ、ミミハ　ドンドン　トホク　ナツテ、トウトウ　ツンボニ　ナリマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ　オヂイサンハ、「アノ　ラツパデハ　キコエナク　ナツタカラ、モツト　ヨク　キコエルノヲ　オクツテ　クレ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハ、ソノ　ラツパヲ　ミミニ　アテテ　ミマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハボンコチヤンノクシヤミガドウシテモ、トマラナイノデ、町デ、有名ナ「モノシリウササン」トイフ、オイシヤサマヲヨビマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハ大ヘンヨロコンデ、ボンコチヤンノリボンヲ前ヨリモモツトモツトキレイナノニトリカヘテ、キレイナ桃色ノ箱ニイレテ、空色ノリボンデソノ箱ヲシバリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、オヂイサンハ、ソノ箱ニモンコチヤンノオトコロトナマヘヲカイテ、郵便局ニモツテイツテ、切手ヲハリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
