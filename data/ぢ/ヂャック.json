          "literary": [
            {
              "text": "一本のヂャックナイフ。",
              "citation": {
                "source": "狼園",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳鳴りがして動悸が高鳴り、私の手はヂャックナイフを握りしめたい衝動のためにぶるぶる顫えるやうに思はれた。",
              "citation": {
                "source": "狼園",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "凜然としてヂャックナイフを購めた時の武者振りは、この際諸君の記憶から洗ひ流してもらひたい。",
              "citation": {
                "source": "狼園",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヂャックはひどく惨めであつた。",
              "citation": {
                "source": "狼園",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
