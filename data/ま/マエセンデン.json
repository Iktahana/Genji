        "examples": {
          "standard": [
            {
              "text": "新作映画は公開前から大規模な前宣伝を展開し、話題を集めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ド派手な前宣伝の効果もあって、発売初日のゲームショップには長蛇の列ができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "莫大な費用をかけた前宣伝の割には、肝心の内容が伴っていないという批判もあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "以前宣伝部に机を並べていて最も懇意の間柄だ。",
              "citation": {
                "source": "ガラマサどん",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ほら、月世界旅行の見世物が、前宣伝に使ったやつですよ。",
              "citation": {
                "source": "電人Ｍ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
