  {
    "uuid": "a2038c8b-4245-5109-b008-997b5bfb4163",
    "entry": "前屈み",
    "reading": {
      "primary": "まえかがみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
