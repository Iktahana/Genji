        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレヲ　キイタ　コノ　マヅシイ　ヲトコノ　ヒトハ、「ヨシ、ソレデハ　ジブンモ　センサウノ　アル　トコロヘ　イツテ、リツパナ　テガラヲ　タテ　タイシヨウニ　ナラウ」ト　ヒトリゴトヲ　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『座談会も終つたからいゝが、実際こんなことは書いてもらつてはこまるがね―』　などと身をふるはすことで深刻さうな電気ナマヅ氏が話を切りだすと、それはそれは面白い魚達の内輪話が始まり、さて酒が廻つてくると、話に拍車をかけて女の話やら、猥談やらそれはそれは賑やかになつた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノミは多くの場合私より迅くて、とりにがし、ペコペコとイマヅをまいて又坐りこむ私。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "北京の中央公園で飼育されてるさまざまの奇怪豪華な金魚も、この一匹のウマヅラハギの姿態には及ばない。",
              "citation": {
                "source": "北支点描",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この木の下にウマヅラハギを泳がしてみたら、面白かろう。",
              "citation": {
                "source": "北支点描",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その内に天候、風と雨、月と潮の関係が解り、大潮の上ゲ、小潮の下ゲ、南風の時は何処、東風では釣れぬ、そよそよ北風がよい、その他雨上り、水の濁り、曇り工合、又朝夕のマヅメ時――といつた状況が会得されてくる。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も荒れ日を狙ふ釣りもあるが、何といつても大潮の上げ、そして朝夕のマヅメ（薄明）軟風といつた工合の時がよい。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "目ヲトジテヰルジヤガイモサンハ、石ニツマヅイテ、何度モコロンデ、コブダラケニナツテモ　マダマダ、目ガサメナイデ、「何ダ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくの――今見ると汚ない悪い版のものである――十竹斎本に基づいて試作に描いた岸田の古い日本画も、そのまゝ「売つちまつた」ものかも知れなかつたが、それを今所蔵してゐる人は、ぼく思ふにそこに絵のウマイ、マヅイよりも、美術を所詮感じて、いゝものを持つてゐる喜びにきつと満足してゐることだらう。",
              "citation": {
                "source": "岸田劉生の日本画",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "面は鐵魚（ナマヅ）の如く極めて多脂なり。",
              "citation": {
                "source": "他計甚※（竹島）雜誌",
                "author": "松浦武四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その場にいたマヅと小西隆佐の一子とは、この日の法華宗徒の敗北が曽てない甚だしいものであったことをオルガンチノに向って証言したのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルガンチノはそれをマヅとか隆佐の子とかの如きその場にいた人々から聞いたのであるから、信用してよいであろう。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "この神がヒヒラギのソノハナマヅミの神の女のイクタマサキタマ姫の神と結婚して生んだ子は、ミロナミの神です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "――筑前守、孝高ニ会ヒ給ヒ、其手ヲ取リテ、顔ニ当テ、マヅ今生ノ対面コソ悦シケレ。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
