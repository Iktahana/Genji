        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "熱いうちにバタを溶いて食塩で食べたり、マアマレイドで味つけしたり、砂糖とミルクを混ぜて食べたりしたものだった。",
              "citation": {
                "source": "朝御飯",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアマレイドは、たいてい自分の家でつくる。",
              "citation": {
                "source": "朝御飯",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は缶詰くさいマアマレイドをあまり好かないので、買うときは瓶詰めを求めるようにしている。",
              "citation": {
                "source": "朝御飯",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パンで思い出すのは、北京の北京飯店の朝のマアマレイド。",
              "citation": {
                "source": "朝御飯",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
