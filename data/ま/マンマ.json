  {
    "uuid": "afa6ba91-18fa-5d9c-8741-c8ab67d3c483",
    "entry": "マンマ",
    "reading": {
      "primary": "まんま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "家にいる時は、五つか六つの子供が着るような大きい絣の着物を着て、ごはんの事を、おマンマなんて言いやがる。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日ぶりにオマンマにありついたのである。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "キレイデセウ」「キレイダナア、キレイダナア、マンマルダナア。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノ　カゲカラ　コノ　ヤウスヲ　ウカガツテ　ヰタ　オカアサンダヌキハ　タイヘンナ　コトニ　ナツタト、メヲ　マンマルクシテ　オドロキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワグネルが『タンホイゼル』の第三｜齣、『フアウスト』歌劇中のローマンマーチ、さてはかの名高き『ウヰルヘルム・テル』の管絃楽『ローヘングリン』の花嫁の進行曲もありき。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれあアノマンマサ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "折角あり付きかけた明日のオマンマがフイになる。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二にコンナ気の小さい、苦労性な老爺は、儲けた金を銀行や郵便局へ預けるほかに、よく現金のマンマで、どこか人の知らない処にシコ溜めている例があるものだ。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンマに有付くか、付かないかの境い目だ。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そのキチガイ先生の騒ぎが、マンマと首尾よく成功した暁には、先生のお望み通りに精神科学が、この地上に於ける最高の学問となって来るのです。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は若林のペテンにマンマと首尾よく引っかかってしまっているんだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしマンマと首尾よく乗り移れたらお手拍子喝采どころじゃない。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "むろん荷物は今のマンマで結構だ。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンマと首尾よく女を欺し上げた事を喜ぶ以上の深刻な或る意味が含まれているようで、今まで見た芝居の悪党笑いのドレにも当てはまらないものである事を万平はハッキリと見て取っていた。",
              "citation": {
                "source": "芝居狂冒険",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生をドウかして一パイ引っかけて、マンマと首尾よく退院してくれようと思いましてね。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度のイタリーとエチオピアの戦争ってものは、元来イギリスの資本家筋が欧州の勢力の平衡を破り、エチオピアの利権を掴みたいばっかりに巧みに双方を煽動して始めさせたものですが、そいつがマンマと首尾よくイギリスの都合の宜い解決しちゃたまりません。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は彼女……姫草ユリ子の不可思議な脳髄のカラクリ細工にマンマと首尾よく嵌め込まれかけている私の立場を、この時にチラリと自覚したように思ったのであった。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがマンマと首尾よく図に当ったので、あんなに皆して笑ったのかも知れない。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへもってきて、船一艘でマンマと何拾万円が手に入る蟹工船、――彼等の夢中になるのは無理がない。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで――この手で、露西亜が日本をマンマと騙すんだ、と思った。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、そして、その事を巧みに「国家的」富源の開発ということに結びつけて、マンマと合理化していた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "イ、二度目の、完全な「サボ」は、マンマと成功したということ。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "道路や灌漑溝の修繕工事をすると云って、日雇賃を地主から出さして置いて、小作人を無償で働かし、それをマンマと自分のものにしてしまった。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤いマンマという花をつまんで列におくれるものもあれば、蜻蛉を追いかけて畑の中にはいって行くものもある。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたって貧乏なケチな店だったが、『金毘羅利生記』を出版してマンマと失敗した面胞だらけの息子が少しばかり貸本屋学問をして都々逸や川柳の咄ぐらいは出来た。",
              "citation": {
                "source": "硯友社の勃興と道程",
                "author": "――尾崎紅葉――",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅客の持っている手荷物、乃至は手荷物を持っている旅客のお蔭で、オマンマを食べている赤帽の伝さんである。",
              "citation": {
                "source": "三の字旅行会",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その比露子夫人が、仮令多少の距離があったにしろ、そして又、仮令もう一人の百姓の証人――彼はダンスのイロハも知らない素朴な農夫だ――が、そう言っているにしろ、ダンスをし始めるのと、喧嘩をし始めるのとを、見間違えるなんて事は、そのかみダンスでオマンマを食べていた彼女の申立として、断然信じられない話だ。",
              "citation": {
                "source": "花束の虫",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この書を写すに幾日かゝったか能く覚えないが、何でも二十日以上三十日足らずの間に写して仕舞うて、原書の主人に毛頭疑うような顔色もなく、マンマとその宝物の正味を偸み取て私の物にしたのは、悪漢が宝蔵に忍び入たようだ。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に僕という泥棒がマンマと忍びいったではないか。",
              "citation": {
                "source": "振動魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで彼は殺意を生じたが、マンマとやり損じた。",
              "citation": {
                "source": "省線電車の射撃手",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
