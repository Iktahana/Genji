        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "方眼紙のマス目は、グラフを描くのに便利だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "文字を大きく書くと、すぐにマス目がいっぱいになってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この表は、縦横のマス目がきっちり揃っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それから、絵で描いたら頭部が半分しかないような人たちが集って、ゴの手でも評定するように、妙な形のマス目で、国際のいきさつ、動きをああこう喋り合っている光景、これはブリューゲルの世界に近いし。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "原稿紙のマス目はまだ駄目です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "square (e.g. of graph paper or Japanese manuscript paper)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
