        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――私は見ていたが――妙なもので、ここで鯨を売ればといっても、山車に載せて裃で曳きもしまいし、あの、おいらんと渾名のある海豚を売ればといって、身を切って客に抱かせもしないであろうが、飯蛸なぞもそうである……栄螺、黄螺、生の馬刀貝などというと、張出した軒並を引込んで、異に薄暗い軒下の穴から、こう覗く。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬刀貝を食べつゝ旦浦時代の追憶にふける。",
              "citation": {
                "source": "行乞記",
                "author": "室積行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "丘のごとくに堆かく、積み上げられた、貝殻は牡蠣か、馬鹿か、馬刀貝か。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかなご、まて貝、がどう、そんなものを煮て貰ってたべた。",
              "citation": {
                "source": "田舎がえり",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
