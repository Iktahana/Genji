          "literary": [
            {
              "text": "ところで、その五人の善玉の三人目に、マッキントン博士というのがあった。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後の三時頃、ガフがこのマッキントン博士の診察室に現れて、来意を告げた後、例の医師表を拡げて何人かの悪玉の個別評を聞き出そうとしていると、マッキントン博士は急に思い出したように、「実は、鳥渡変な話しを聞いています。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "新たに其処に療養所でも開かれたのかしら――マッキントン博士の妹は、そう思ったと言う。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "番地は、マッキントン博士が知っていた。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
