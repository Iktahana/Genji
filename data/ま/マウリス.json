        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "此人の名はマウリス・レツセル氏である。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マウリス氏は此時も其影を見て又何か事が起つたかと降りて来て呉れた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "環境には目に見えない魂があつて、それがその環境の人間のする如何なものにも現はれてゐるといひ、これを離れると個人はその生活の活力を失ふと、地方主義者のマウリス・バレエスはいふ。",
              "citation": {
                "source": "地方主義篇",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マウリス氏は此時も其影を見て又何か事が起つたかと降りて來て呉れた。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は全くトインビーやフレデリツク・マウリスや、チヤールス・キングスレーの基督教社会主義に傾いて行つた。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
