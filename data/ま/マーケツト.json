        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「オークシヨン・マーケツトの悪商人が、烏の嘴を絵具で染めて、九官鳥に見せかけたが声を出されると大変だつたからギユツと喉笛を握つてゐると、苦悶の烏がしやがれた叫びを挙げた――そのやうな声だ。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "軒ばかり揃つて、まだ開かれてゐない、マーケツトもあつた。",
              "citation": {
                "source": "氷花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いて、背の高いマーケツト者らしい男がのそつと部屋に上つて来る。",
              "citation": {
                "source": "災厄の日",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうした人間たちは、混乱の電車の中やマーケツトに、お互の符牒と動物力で僕と無関係に生存してゐる。",
              "citation": {
                "source": "災厄の日",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂フリーマーケツトです。",
              "citation": {
                "source": "日本の眞の姿",
                "author": "竹越與三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんと云つても、事務所の管理下にある購買組合が一番重要なマーケツトである。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
