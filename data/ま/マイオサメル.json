        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大歓声が沸き起こる中、主役の踊り手が見事に最後の一舞を舞い納めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "一年の締めくくりとして、神社で奉納の舞を厳かに舞い納める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "拍手に見送られながら舞台を去る彼女の表情には、舞い納めた充実感が漂っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "もとより一言も私たちに口をきかず、舞い納めると簾の奥に静かにかくれてしまった。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
