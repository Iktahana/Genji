[
  {
    "uuid": "c5f29368-ee26-5566-95b0-af802b851266",
    "entry": "祭り",
    "reading": {
      "primary": "まつり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
