          "standard": [
            {
              "text": "大自然が作り出した雄大な景色を目の当たりにすると、自分の悩みがちっぽけに思えてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "」　我が人生において、このような光景を目の当たりにすることは、もう二度とないだろう。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴方は女達の腐敗がどれほど深いかを測り、虚栄に満ちた男達の悲惨の大きさも目の当たりにすることでしょう。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
