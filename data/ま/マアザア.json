        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（滋）親父にはまだ云はないけれど、マアザアにはちよいと話をして見たんだ。",
              "citation": {
                "source": "戯曲体小説　真夏の夜の恋",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………さうしてね、お前に断つて置くが、僕は今夜マアザアを掴まへて是非許してくれるやうにもう一遍頼まうと思つて居るんだ。",
              "citation": {
                "source": "戯曲体小説　真夏の夜の恋",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の事なら、マアザアが承知をすれば親父は何とも云はないんだから。",
              "citation": {
                "source": "戯曲体小説　真夏の夜の恋",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（滋）ところがマアザアはさうでもないらしいんだ。",
              "citation": {
                "source": "戯曲体小説　真夏の夜の恋",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は今夜此の手紙を見せて是非ともマアザアを説き伏せてしまはうと思つて居る。",
              "citation": {
                "source": "戯曲体小説　真夏の夜の恋",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
