        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしながら蕪村の本領は、かえってこれらの俳句に尽され、アマチュアの方がよく知るのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上での作品でない限り、アマチュア芸だし、民族の詩となる日は来ないのである。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "とまれ、フォルムに就いての理念が生ぜざる限り、アマチュアであり、またアマチュアとしてさへが、文学芸術に興じたのではなく、知ることの喜びを文学に於ても得てゐるといふに過ぎないことを分らねばならない。",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう少し数を減らせて、そして絵は下手でもいいから何かしら味のあるアマチュウアの絵でも加えたらどうであろうか。",
              "citation": {
                "source": "二科会その他",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマチュアには、こわいもの知らずの糞度胸があるからかなわねえ。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "念の為め主人と私の関係を話して置くと、私の父は幼時に維新の匆騒を越えて来たアマチュアの有職故実家であったが、斯道に熱心で、研究の手傅けのため一人娘の私に絵画を習わせた。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "御当人はもちろんであるが、その細君もまたおかあさんもそれぞれ熱心なアマチュア芸術家である。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくして幼稚なるアマチュアはパトロンを得たのである。",
              "citation": {
                "source": "高浜さんと私",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞の科学記事で往々世界的「大発明」として報ぜられるものの中には、専門家でないアマチュアの多年の苦心の結果と称するものが往々ある。",
              "citation": {
                "source": "ジャーナリズム雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマチュア昆虫生態学者にとっては好個のテーマになりはしないかという気がしたのであった。",
              "citation": {
                "source": "三斜晶系",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "魔法修行のアマチュアは。",
              "citation": {
                "source": "魔法修行者",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "キットそれ自体はアマチュアっぽい代物であっても、あくまでプロ用。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そろそろマイコンクラブの走りのようなアマチュアのクラブが生まれており、ネクタイにはまったく縁のなさそうなひげ面の連中が、仕事ではなく好き好んでマイクロコンピューターの使い方に頭を悩ませている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "たくさんのアマチュアたちが、マイクロコンピューターに何をやらせるのか、勝手に考えはじめていたのである。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロの技術者としての経験を積んでもいい意味でのアマチュアリズムを失わない男で、こんなオモチャじみたものの設計となると、他の人間ならふくれかねないものを、後藤はかえって嬉々としてアイディアをひねってくる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ＴＫ―80に群がったアマチュアたち一人ひとりは、自分なりの使いこなしに頭を悩ませはじめた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやむしろ、ＴＫ―80を買い求めたアマチュアの多くは、胸をときめかせてプラモデルめいたキットを持ち帰り、目を輝かせてはんだごて片手に組み立て、それから絶望を味わって八万八五〇〇円のむだ遣いを悔いていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし家電感覚を多少なりとも引きずったアマチュアにとってみれば、電源のないことは失望の対象以外の何ものでもない。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "標準的なＴＫ―80のアマチュアユーザーのたどった道を再現してみよう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにかかわるすべての人間が、偉大なアマチュアだったのである。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "欲求不満が募る中で、ドンピアはアルテアをきっかけにしてアマチュアのコンピュータークラブが作られるというニュースを耳にした。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマチュアのパイロットの資格を持っていたドンピアは、低い周波数の電波を受信できる小さなトランジスターラジオで天気情報を聞きながら、入力した数値を大小の順に従って並べ替える、ソートと呼ばれる作業のためのプログラムをスイッチから入れていった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "後藤の回想によれば、高校時代からラジオ製作に凝っていた彼はアマチュアラジオ雑誌でフェライトを使ったオキサイドコアを知って興味を持ち、買い求めて遊んだ経験を持っていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "本書でのちに詳述する安田寿明は『マイ・コンピュータ入門』（講談社ブルーバックス、一九七七年）で、「昭和初期、はじまったばかりのラジオ放送を聴くため、数多くの人々が、ラジオ受信機を自作し、ラジオ・アマチュアというあたらしい趣味のジャンルをひらいた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本でも、半年か一年遅れてアマチュア活動が活発になってきた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマチュア用のマイコン組立キットが市販され始めてから急激に盛んになり、東京秋葉原の電気街に、マイコンの専門サービスセンターやショップが開店して連日大勢の人で賑わっているし、クラブもいくつか誕生した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "数年後にはアマチュア無線の人口（現在は約四十万人といわれている）をオーバーするほど、マイコンアマチュアはふえるだろうという人もいる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマチュア無線とマイコンとの組み合わせで友人のプログラムを無線を通して楽しんだり、モールス符号の自動解読やコールサインの判別、アンテナの調整等への応用も始まっているようだ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
