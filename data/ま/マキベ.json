        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "肥前　なあに、この、マキベえの、くたばりぞこねえめ！",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……マキベえは近頃、俺にばっかついて来るが、なぜだ？",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥前　そりゃしかし、マキベえの事を心配して言ってくれるんだ。",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥前　そいじゃ、マキベえも早く死んだ方がいいのか？",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんじゃマキベえ、二人でここからドボンと飛び込んでしまおうか？",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マキベえ、お前、拾いな。",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（とこれもゴム長をひっかけてカゴに拾い入れて、又歩きだす）肥前　マキベえ、お前、ひるは何か食ったかよ？",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そうよなあ、全くマキベえの言う通り、もう死んでもいいようなもんだなあ。",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
