          "literary": [
            {
              "text": "漸く結末へ来た時は、手に持つた手紙を巻き納める勇気もなかつた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸く結末へ来た時は、手に持った手紙を巻き納める勇気もなかった。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "力なく巻き納める恩人の手紙のなかから妙な臭が立ち上る。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "クルクルと絵絹を巻き納めると用意して置いた白木の箱へ、静かに入れて封をした。",
              "citation": {
                "source": "北斎と幽霊",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し家へ帰つて見ると、彼の妻はホヤのすすけた吊りランプの影で、里の母からでも来たらしい手紙を読んで居たが、彼には見せたくないらしく、遽にそれを長々と巻き納めると、不興極まる顔をして、その吐息を彼に吹きかけでもするかのやうに彼をまともに見上げて、涙で光らせた瞳で彼を見上げた。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            }
          ]
        }
