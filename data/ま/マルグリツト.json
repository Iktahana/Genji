          "literary": [
            {
              "text": "・マルグリツト　オオドウウ　孤児マリア　光ほのか十月十四日　曇――晴。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが先年小説家ヴイクトオル・マルグリツトが、「ギヤルソンヌ」といふ小説を発表したら、その小説が仏国の体面に関するものであるといふ理由で、賞勲局は、マルグリツトのコンマンドウウル（勲三等）を取上げた。",
              "citation": {
                "source": "文功章",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女マルグリツトの家の戸口に悪魔が呼出す魔界の天使に御座候。",
              "citation": {
                "source": "夜あるき",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は已に小春の可憐、椿姫マルグリツトの幽愁のみには満足致し得ず候。",
              "citation": {
                "source": "夜あるき",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰宅の後枕上マルセルブーランヂヱーの小説マルグリツトを読む。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉手箱のふたあけて珠のかざりを取出す乙女の如くにマルグリツトの如くに。",
              "citation": {
                "source": "偏奇館吟草",
                "author": "永井壮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルグリツトが家の門口にフオーストも入りかねてためらひし罪なく打明けし心の愛らしさ。",
              "citation": {
                "source": "偏奇館吟草",
                "author": "永井壮吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
