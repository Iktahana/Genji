        "examples": {
          "standard": [
            {
              "text": "彼女は平安美人に憧れて、眉を剃って麿のようなメイクを試した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昔の肖像画に描かれた貴族は、みな麿眉をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「その麿のような眉毛、個性的で面白いね」と友人に言われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
