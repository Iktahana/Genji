  {
    "uuid": "343b36dc-2b37-59d8-b9e3-8138e0b239f2",
    "entry": "マシタ",
    "reading": {
      "primary": "ました",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヨク来タト申シタイアナタノ可愛イ手紙、今朝参リマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "口デ言エナイホド喜ビマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝成田様ノオマモリガ参リマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "パパハ乙吉ニヤリマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト大変喜ビマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシモウ皆スマセマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "海デ沢山遊ビ黒クナリマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田モ老イマシタカラ　将軍家は老忠臣の和田左衛門尉さまを、それまでも何かとごひいきになさつて居られました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "相州さまがその年来の郎従の中で、特に功労のあつたものをこんど侍に取り立てたい、それに就いておゆるしを得たく参上いたしましたと気軽に将軍家へ申し上げたところが、将軍家はにつこりお笑ひになつて、考ヘテミマシタカ「え、何事でございませう。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一切ノ放下　と微笑んで御首肯なされ、デキマシタカ　ややお口早におつしやいました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども将軍家は、お破りになりながらも別段けはしいお顔をなさるわけではなく、例のやうに、白く光るお歯をちらと覗かせて美しくお笑ひになり、コノゴロ和歌ガワカツテ来マシタ　などとおつしやつて、またぼんやり物案じにふけるのでございました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも、考へ考へぽつりぽつりと申し上げるのでございますから、その長つたらしい事、将軍家もたうとう途中に於いてお笑ひになり、ワカリマシタ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子息ハ宥免ノツモリデヰマシタ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "六年前の建暦元年六月三日丑剋、将軍家御寝の際、高僧一人御夢の中にあらはれて、汝はもと宋朝医王山の長老たり、とお告げになつたのださうで、誰ニモ言ハズニ居リマシタガ、ソナタノ物語ト符合シテヰルトハ面白イ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ホンジツヲモツテキンユシユツハカイキンサレマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『センダガヤノシヨウジヨゴロシノハンニンケンキヨサレマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『ゾウワイジケンノタメシユウヨウチユウノ××ハフキソトケツテイシマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "實はなくなりました父が、其の危篤の時、東京から歸りますのに、（タダイマココマデキマシタ）と此の町から發信した……偶とそれを口實に――時間は遲くはありませんが、目口もあかない、此の吹雪に、何と言つて外へ出ようと、放火か強盜、人殺に疑はれはしまいかと危むまでに、さんざん思ひ惑つたあとです。",
              "citation": {
                "source": "雪靈續記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "実はなくなりました父が、その危篤の時、東京から帰りますのに、（タダイマココマデキマシタ）とこの町から発信した……偶とそれを口実に――時間は遅くはありませんが、目口もあかない、この吹雪に、何と言って外へ出ようと、放火か強盗、人殺に疑われはしまいかと危むまでに、さんざん思い惑ったあとです。",
              "citation": {
                "source": "雪霊続記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼失ワズ　ケサ、六時、林房雄氏ノ一文、読ンデ、私カカナケレバナルマイト存ジマシタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "多少ノ悲痛ト、決断、カノ小論ノ行間ヲ洗イ流レテ清潔ニ存ジマシタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "葛西善蔵先生ハ、旦那芸ト言ウテ深ク苦慮シテ居マシタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「売レマシタカ」　眼をまるくして答えた。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニハカニ　クラク　ナリマシタカゼガ　ゴウゴウ　フイテキテアメモ　ザアザア　フリマシタ　春の夕立ちは、珍しい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフダチ　ヤムノヲ　マツウチニツカレガ　デタカ　オヂイサンイツカ　グツスリ　ネムリマスオヤマハ　ハレテ　クモモナクアカルイ　ツキヨニ　ナリマシタ　この月は、春の下弦の月である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサデス　ツユノ　ヒカルミチコブヲ　トラレタ　オヂイサンツマラナサウニ　ホホヲ　ナデオヤマヲ　オリテ　ユキマシタ　瘤は孤独のお爺さんにとつて、唯一の話相手だつたのだから、その瘤を取られて、お爺さんは少し淋しい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　実に、気の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
