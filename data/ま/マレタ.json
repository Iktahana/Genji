        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大破壞ノ後ニ狂亂狼狽スル者ニ完備セル建築圖ヲ求ム可ラザルハ勿論ノ事、之ト相反シテ、我ガ日本ハ彼ニ於テ破壞ノ五ヶ年ヲ充實ノ五ヶ年トシテ惠マレタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「手ハモウスッカリオ直リニナッタンデスカ」来ルトイキナリ気ヲ呑マレタ形デ眼ヲ白黒サセテイタ五子ハ、コヽデ辛ウジテ嘴ヲ入レル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "川勝氏ノ著書ニ依ッテ仕込マレタ石像美術ノ知識ダケヲ物識リ顔ニ披露シタニ過ギナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ白イ美シイ皮膚ニ包マレタ一個ノ女体ガ、マルデ死骸ノヨウニ僕ノ動カスママニ動キナガラ、実ハ生キテ何モカモ意識シテイルノダト思ウヲ日記ニ書カナイ方ガヨイノデハアルマイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
