  {
    "uuid": "40caf417-b02a-5fe5-a6e0-ef0cca3a71a2",
    "entry": "まあ",
    "reading": {
      "primary": "まあ",
      "alternatives": [
        "まー",
        "まぁ",
        "ま"
      ],
