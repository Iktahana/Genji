        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の描く絵は、まあ見られるレベルにはなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "この店のラーメンは、まあ美味しい方だと思う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "まあ満足できる結果だったので、良しとしよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "well ...",
        "register": "standard",
        "nuance": null,
