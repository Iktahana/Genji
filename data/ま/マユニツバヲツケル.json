        "examples": {
          "standard": [
            {
              "text": "彼の調子のいい言葉を鵜呑みにせず、眉に唾をつけて話半分に聞いておいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「これはここだけの秘密だよ」という言葉には、眉に唾をつける必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "詐欺被害に遭わないためには、知らない相手からの連絡には眉に唾をつけるべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "だが、読もうとする前に、眉に唾をつけるくらいな戒心で、「こいつあ、あぶねえ」　と小首をかしげた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
