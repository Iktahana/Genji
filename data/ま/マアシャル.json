        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "時は前年八月二十一日、ところは川崎駅に近い生麦村、香港在留の英国商人リチャアドソン、同じ香港より来た商人の妻ボロオデル、横浜在留の英国商人マアシャル、およびクラアク、この四人のものが横浜から川崎方面に馬を駆って、おりから江戸より帰西の途にある薩摩の島津久光が一行に行きあった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "カマアシャル街あたりの店員か下級事務員どころと踏んだ。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "裁判長はスクラトン氏、検事がアウチボルド・ボドキン卿、弁護人は故エドワアド・マアシャル・ホウル卿という花形ぞろいの顔ぶれであったが、ホウル卿の弁護がいかに巧みであっても、鋼鉄のような事実は曲げることができない。",
              "citation": {
                "source": "浴槽の花嫁",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "――大通からコムマアシャル街へ入ると人通りもへった。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――日本に於ても、ハアバアト・マアシャルやクロオデット・コルベエルぐらゐの男女は、ざらにゐると思ふ。",
              "citation": {
                "source": "周囲に聴く",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人のハアバアト・マアシャル、一人のクロオデット・コルベエルで沢山だ。",
              "citation": {
                "source": "なんとかせねばならぬ",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
