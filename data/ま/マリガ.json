        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソシテ浴室ト寝室ノ間モ行ケ／＼ニシタガ、コレハ必要ニ応ジテ浴室ノ内部カラ締マリガ出来ルヨウニシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "果シテ戸ニハ締マリガシテナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イツモ締マリガシテナイト云ッタカラ、ホントカドウカ試シテ見タノサ」云イナガラ予モ浴室ノ方ヘ首ダケ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸締マリガシテナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ情ナイ姿ノトコロヲ彼女ニ見ラレテハ極マリガ悪イ、ト、思ッタ途端ニコノ言葉ガ出タノデアルガ、正直ヲ云ウト来テ貰イタクナイコトモナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ爺サンハ発狂シテルノデハナイカト、思ワレルダケデモ極マリガ悪イ）予ハコヽマデ思イ詰メテ、コヽニ一ツノ可能ナ方法ガアルカモ知レナイコトニ気ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ好イ加減キマリガツイタ時分ダト思ッテイタノニ、先達淡路カラ絵端書ヲ貰ッテマダソンナコトカト驚イタ次第デス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
