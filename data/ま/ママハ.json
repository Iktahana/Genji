          "literary": [
            {
              "text": "けれども、私の方、ママハハというのは少しひどすぎます。",
              "citation": {
                "source": "女心の強ければ",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも、いまだにゲイシャやゲイシャのダンナやママハハやコンジキヤシャなどが主なるテーマであるシバイだから、小学六年以下では、なんのことやらわからんだろう。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日午後二時過ギ敏子ガヒョッコリ顔ヲ出シテ、「ママハ」ト尋ネタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「パパ、ママハドコヘ行カハルノカ分ッテハルノ」ト、膳ニ向ウト敏子ガ始メタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウ思ウッテ、ドウイウガアルノカ」「ママハシヤハリマセン、木村サンカラ聞イタノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
