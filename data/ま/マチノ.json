        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「アツ、ヰルヨ」「エ、ドコニ」「ホラ、アソコニ」　ズーツト　下ノ　ハウノ　アル　マチノ　ホソイ　ミチノ　上ニ　キラキラト　ヒカル　モノガ　アリマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イツテ　ミヨウ」「ウン」　二ツノ　ホシハ　タカイ　タカイ　ソラカラ　コガラシノ　フク　マチノ　ナカヘ　オリテ　イツタノデシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コドモタチヤ、コノ　バシヤハネ、オマエタチガ　マダ　ウマレナカツタ　ジブン、マダ　ジドウシヤト　イフ　モノガ　ナカツタ　トキ、ムラカラ　マチノ　テイシヤバマデ　マイニチ　カヨツタ　モノダヨ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タレノ　カゲ新美南吉　マチノ　マンナカニ　ヒロツパガ　アリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　アル日、人参サンノ所ヘ、人参サント　ジヤガイモサンノオ友達ノ玉ネギサンガ　タヅネテキテ、「ボクモ、コンナニ大キクナツタノデ、トウトウ、アシタノアサ、六ジニ　キシヤデ　マチノイチバヘ行クコトニ　キマツタヨ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒカウキニ　ノッテ、ウミノ　ウヘヤヤマノ　ウヘヤモリノ　ウヘヤマチノ　ウヘヲ　トンデ、レンペイジヨウヘ　オリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
