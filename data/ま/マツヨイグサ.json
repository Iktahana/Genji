        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "黄色の待宵草が、夏の夜の道端でひっそりと花を開き始めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「竹久夢二の詩にも出てくる待宵草は、どこか寂しげな美しさがあるよね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夕暮れ時に散歩をしていると、甘い香りを漂わせる待宵草の群生に出会った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "朝旱割れそめにし稲沼に、　　いまころころと水鳴りて、待宵草に置く露も、　　　　睡たき風に萎むなり。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "fragrant evening primrose (Oenothera stricta)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "砂浜に自生している待宵草が、海風に揺れながら大輪の黄色い花を咲かせている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "月光を浴びて輝く待宵草の姿は、まるで夜の妖精が舞い降りたかのようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「待宵草は夜に咲いて朝には萎んでしまうから、今のうちに見ておきなさい。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
