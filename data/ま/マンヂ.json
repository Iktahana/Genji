        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（五日ぶりですね、）その間にマンヂユウ、チクワ、クワシ等々々。",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「スナマンヂウヲ　ツクラウ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジラウハ　アツイスナノトコロヘ　モドツテ　スナトミヅヲ　マゼテ　オマンヂウヲ　コシラヘマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒニ　テラサレテ　オマンヂウガ　ウマク　ヤケルマデ　ジロウハ　ウマニナツテ　スナノウヘヲ　トホクマデ　カケテユキマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツイ　アツイデキタテノ　スナマンヂウ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スナマンヂウガ　デキタラ　パカ、パカピヨン、ピヨン、パカ、パカオウマニ　ツンデマチヘ　ウリニ　ユキマセウ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　シバラクシテ　モウ　ウマク　ヤケタラウト　オモツテ　オマンヂウヲ　オイタトコロヘ　カヘツテキテミルト　オマンヂウハ　一ツモ　アリマセン。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンヂウハ　ドコヘイツタノデセウ？",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オマンヂウハ　ナミガ　ミンナ　タベテシマツタノダヨ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チイサナ　ナミガ　ボクノ　スナマンヂウヲ　タベチヤツタ　ワツハツハ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チイサナ　ナミガ　ボクノ　スナマンヂウヲ　タベチヤツタ、ワツハツハ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジヤブリ、サラ、サラ、スナマンヂウハ　ダイスキダ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジヤブリ、サラ、サラ、スナマンヂウハ　ダイスキダ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから税関の騒擾に吃驚したり、馬車の御者が膝の上にも達する長い靴をはき、鞭をとり、革嚢を持っているのを不思議がったり、初めてミミズを見たり、ノルマンヂイの痩せた豚で驚いたりした。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "この町はマンヂ州にあるが、君主の首府のあるカタイ州はその隣州である。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
