        "examples": {
          "standard": [
            {
              "text": "実験室の学生は、装置内の圧力を確認するためマノメーターの数値を記録した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "配管内のガスの圧力を正確に測定するために、高感度のマノメーターが取り付けられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "このマノメーターは、微小な圧力変化もリアルタイムで表示することができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "片方の仕切りにはテプラーポンプや附属のマノメーターなどを置いた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
