        "examples": {
          "standard": [
            {
              "text": "隣の部屋でこっそり話していた秘密の相談が、壁が薄くて丸聞こえだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "イヤホンから漏れる音楽が丸聞こえですよと、電車で注意されてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "内緒話のつもりだったのに、声が大きすぎて周囲に丸聞こえになっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "とはいっても、一人の女中の尻を追っていったのだった――ガルディーナはそれでも注意深くて、ここで話すことは台所にまる聞こえだと見て取った。",
              "citation": {
                "source": "城",
                "author": "DAS SCHLOSS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
