[
  {
    "uuid": "c2c563b4-c881-5ab2-a2e9-960f71439f5d",
    "entry": "マツチ",
    "reading": {
      "primary": "まつち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
