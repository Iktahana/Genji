        "examples": {
          "standard": [
            {
              "text": "図書館の禁書庫の奥深くに、世界を滅ぼす魔法が記された魔道書が眠っているらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は古びた古本屋で、不思議な文字がびっしりと書かれた一冊の魔道書を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ボスを倒すためには、このダンジョンに隠された古代の魔道書を解読する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "魔道書の著者も一部実在の人物です。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
