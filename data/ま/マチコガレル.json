    "definitions": [
      {
        "index": 1,
        "gloss": "to be impatient for",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "卒業旅行を待ち焦がれる学生たちの声が聞こえる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "息子からの手紙を毎日待ち焦がれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は待ち焦がれた再会を喜び合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "いとけないのに尼さんにされるほどの運命を持った人の子というものには、どうせ温かい親というものの観念からは遠かろうと思われるのに、父を待ちこがれるらしいこの子のそぶりを異様に感じながら、お銀様は桑名戻りの船を見ている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "待ちこがれる弁信は容易に来らざるのに、そこへ口笛高く吹き鳴らしながら、またしても一箇の怪漢が姿を現わしました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "水に至っては、淡々として無味、何人も手を放すことの出来ない必要品であるごとくに、彼の通信は待ちこがれる水であったのである。",
              "citation": {
                "source": "アーニイ・パイルの前に立ちて",
                "author": "小林一三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の組織的プログラムの整然としてバラエティに富み、その内容の充実したる、何曜日何時には何か聴けると待ちこがれる音楽の楽しさ。",
              "citation": {
                "source": "アーニイ・パイルの前に立ちて",
                "author": "小林一三",
                "note": "青空文庫"
              }
            },
            {
              "text": "また心配して待ちこがれる一夏！",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "しまいには、ごく自然に病気かなにかで死んでくれたら、と彼女の死を待ちこがれるような気さえしてきた。",
              "citation": {
                "source": "演技の果て",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は實際待ち焦れるやうにして今日と云ふ約束の火曜日を待つて、築地なる米人フオオト氏の邸宅に赴いた。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それも日と共に薄れて、やがては、尼法師の訪ずれるのを、夜となく昼となく待ち焦れるようにさえなってしまいました。",
              "citation": {
                "source": "新奇談クラブ",
                "author": "第五夜　悪魔の反魂香",
                "note": "青空文庫"
              }
            },
            {
              "text": "翡翠の耳環が充血した頸で小さく揺れ、その眦のものは、喜悦を待ち焦れる感涙に濡れ光り、一種の恐怖と甘い涙の滴りが、グッショリと、もみあげの毛まで濡らしている。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――大正十五年三月二十六日上京中、深川に於て雪の回想１　春の季節をわたし等雪國人種の特に待焦れることは、雪に半年もとざされるからだと云ふぐらゐの事では足りない。",
              "citation": {
                "source": "地方主義篇",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
