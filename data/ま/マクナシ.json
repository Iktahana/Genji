        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「右の如く謡曲会、俳句会、短歌会、新体詩会等、会の連発にて当分の間は、のべつ幕無しに出勤致し候為め、不得已賀状を以て拝趨の礼に易え候段不悪御宥恕被下度候。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "大袈裟な言葉をのべつ幕無しふんだんに飛び出させる京伝の口を、寧ろ皮肉な眼付きをして、じろじろ見遣るばかりであった。",
              "citation": {
                "source": "戯作者",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理人のかはりが來ないので、おかみさん自身重たい體で臺所の土間に立ち、たゞさへてんてこ舞して居る女中にのべつ幕無しの小言を浴せかけながら働いてゐた。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤いおたまやは井伊かもんの守』かういふことを幕無しに云つて除けた。",
              "citation": {
                "source": "仏法僧鳥",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤いおたまやは井伊かもんの守』こういうことを幕無しに云って除けた。",
              "citation": {
                "source": "仏法僧鳥",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、しきりに心配していたが、興奮しながらも、兵隊がのべつ幕無しに使用するスウェアの言葉をただの一つも出さない。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "のべつ幕無しの雄辯は疲れる。",
              "citation": {
                "source": "パスカルの言葉",
                "author": "パスカル",
                "note": "青空文庫"
              }
            },
            {
              "text": "三年まえ、私は中村地平という少し気のきいた男と、のべつまくなしに議論していて半年ほどをむだに費やしたことがございます。",
              "citation": {
                "source": "喝采",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの人達は、のべつまくなしに戦争をしたり、殺し合ひをしてゐるわけでもあるまい。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "キットでもマア、えたいの分らない妙な娘さ、何、たかが女だもの、そんなにビクビクする事はありゃあしないさ、こんな事をのべつまくなしに考えた。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この康子は夜遅くまで二階の正三の部屋にやって来ては、のべつまくなしに、いろんなことを喋った。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "この康子は夜遅くまで二階の部屋にやつて来ては、のべつまくなしに、いろんなことを喋つた。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "こどもさんは大割引のたった十円」　観音堂のうらにあたる空地に、本堂そこのけの背の高い大きな小屋がけをし、サーカスそっくりのけばけばしいどんちょうやら大看板、それに昔のジンタを拡大したような吹奏楽団が、のべつまくなしに、ぶかぶかどんどん。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで大統領はこの成功せる音楽浴をラジオをかけはなしにするように、二十四時のべつまくなしに国民に聞かせよと言ったけれど、それはコハク博士の反対によってとりやめとなった。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、彼の女房は、彼の耳もとで、のべつまくなしにがなりたてて、やれぐうたらだ、やれのんきすぎる、いまに一家が路頭に迷うようなことになる、と言って責めたのである。",
              "citation": {
                "source": "リップ・ヴァン・ウィンクル",
                "author": "ディードリッヒ・ニッカボッカーの遺稿",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは自分でもなにを言っているのかわからないほど、のべつまくなしに話をした。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理もこれじゃうまくなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまりうまくなし、山水楼は一流とは言ひがたい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上一向にうまくなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "馴れるともう大してうまくなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座談会も此う続くと、いゝネタはない、陶々亭あんまりうまくなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時に家を出て、祖母上等道子も共に晩翠軒で夕食する、あまりうまくなし、掛炉焼鴨の味噌が油っぽすぎる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕刻、南京町へ出て、第一楼で食事、八宝全鴨が去年ほどうまくなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "之が終ると、Ｂ・Ｒで上山と食事して――うまくなし――座へ出ると、今日も満員である。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュうまくなし、鶏のコーン詰揚げうまし、栗のパンケーキ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛肉すきやき、うまくなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは期待しすぎて、あんまりうまくなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "橘・大黒と話し、ダービンその他の原画を貰って、晩翠軒で道子と食事、あんまりうまくなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の終り、北のグリル京松へ、うまくなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "すきやきうまくなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
