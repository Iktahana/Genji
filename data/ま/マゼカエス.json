[
  {
    "uuid": "50f2e6bc-e7c3-5100-a911-06d44ff8e99e",
    "entry": "混ぜ返す",
    "reading": {
      "primary": "まぜかえす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
