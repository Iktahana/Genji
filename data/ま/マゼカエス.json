    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to stir well",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "焦げ付かないように、鍋の中のルーを絶えず混ぜ返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ケーキの生地を滑らかになるまで、丁寧に混ぜ返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この料理は、時々混ぜ返して味を均一にする必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その同じ鍋に洗ってから、ちょっと焙った膩肉の小片二十四を加えて混ぜ返す。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と誰やら若い人が混ぜ返す。",
              "citation": {
                "source": "鎖ペンを握って",
                "author": "――三月十九日夜――　　山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私達の側にはこんなことをいつて話を混ぜ返すものもある。",
              "citation": {
                "source": "山陰土産",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪の商売人の息子で、銀行員を経験していた父は、「生徒が一人減れば授業料が減るやないか」と混ぜ返す。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂利を混ぜ返す音がじりじり髄にこたえる向うの坂路を、バスが傾きながら流れて来た。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのそばに立っていて、混ぜ返すような声をかけるのは、寿平次から見れば小父さんのような得右衛門である。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と混ぜ返すものがある。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、三郎は混ぜ返すように笑い出した。",
              "citation": {
                "source": "嵐",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、ある人物が登場する時機は、それぞれ自由なるも、故意に舞台を混ぜ返すやうな出方は慎むべきこと。",
              "citation": {
                "source": "職業（教訓劇）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　今度は、民子が、混ぜ返すやうに言葉を挟んだ。",
              "citation": {
                "source": "花問答",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "金が欲しければ町人の所へ持って行くよりほかに致し方はない」「金が欲しい」とまぜかえす奴が出る。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの弁当箱、今だって持ってますから、大事に」　そういって、ハンカチーフを目にあてるのを見ると、マスノはまぜかえすような調子で、「なーにをマッちゃんがまた、酒ものまんうちにひとりでくだまいてるの。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その健の声をまぜかえすように、克子は自分の遊んでいた積木をおっぽりだして、「サイタサイタ、ウメノハナガサイタ」と、甲高な声を上げた。",
              "citation": {
                "source": "赤いステッキ",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やはり同日同刻じゃないか」と迷亭がまぜ返す。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅人の従者どもからかい半分、きっとそうだろうとまぜ返すを、旅人は真面目に止まって占いを立て、かの女を呼び出し、汝の親は易の占いをしたかと尋ねると、何か知らねど今君がしたようなことをした、と答う。",
              "citation": {
                "source": "易の占いして金取り出だしたること",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "若人たちは、又例の蠱物姥の古語りであらう、とまぜ返す。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "若人たちは、又例の蠱物姥の古語りであらうとまぜ返す。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "若人たちは、又例の蠱物姥の古語りであろう、とまぜ返す。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "おのれらの緩怠を棚にあげて置いて、人を責むるのが不届きじゃ、人を責むるならば責むるように、己れの怠慢から見てせい」「わや、わや、わや」　川破りが抗弁すると、それを取巻いた渡頭守の味方が土音方言をもって、わや、わや、わやとまぜ返すのです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ひとの真面目な議論をまぜ返すのはよくないです」　芳衛さんは、みなにやり込められて黙ってしまった。",
              "citation": {
                "source": "キャラコさん",
                "author": "海の刷画",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あいつはこの間から、少し様子が変っている、今度姿を見せやがったら、片輪になるほど打ちのめしてくれなきゃならぬ」「と言う口が、いつもお延さんの姿を見ると、がらりと、打って変ってしまうのだから怖ろしい」　久八がまぜ返すと、あとの四人が、憚りもない高声でどッと笑った。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとの心配をまぜ返すものではないよ」「いえいえ、心配ごとというのは、一番悪い成り行きを先に考えておけば、たいがい安心のなるものでな」　――すると、垣の外に、人影がさした。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まぜっ返すなよ」と、半七は横目で睨んだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大森の鶏",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、その頃僕は酔っ払うと、しきりに椎の木の話をはじめ、ハラゴンに対する憤慨をのべ、どこのどいつだというような調子だったものだから、それは「椎の木の先生のハラゴンさん」みたいな話だとまぜっ返す者がでてきて、彼女はつい、竹山という実際の人だと口を滑らしたらしい。",
              "citation": {
                "source": "椎の木",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "まぜっ返す者もなかった。",
              "citation": {
                "source": "自由人",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「綾の野郎、急に商売気を出したもんだね、女でも引摺り込む心算じゃないのか」　誰かが、交ぜっ返す調子で、卑しい笑いを笑っております。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "綾吉殺し",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも」「交ぜっ返すなよ」　と清水君が制した。",
              "citation": {
                "source": "冠婚葬祭博士",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもこう真面目に出られて見ると、もう交ぜ返す勇気もなかった。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "演舌家はもっと上品な詞を使って貰いたいね」と迷亭先生また交ぜ返す。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「能く交ぜ返す奴ぢや。",
              "citation": {
                "source": "貧書生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to interrupt (with a joke, sarcastic remark, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
