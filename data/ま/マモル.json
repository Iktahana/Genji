[
  {
    "uuid": "f029b842-6f05-5ed0-8c19-9a3c579cfd78",
    "entry": "守る",
    "reading": {
      "primary": "まもる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-他動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to protect",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "法律は、弱者の権利と不当な暴力から市民の自由を守るために存在している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "絶滅の危機に瀕しているトキを、国を挙げて環境整備し守る必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は自分の体を投げ出して、背後にいた幼い子供を飛んできたボールから守った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "若し自分自身の言語或ひは心象でパンセされて出来た主義なら、その主義は彼自身なのだから、その主義を守るも守らないもないものだ！",
              "citation": {
                "source": "詩と詩人",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "春雨や同車の君がさざめ言筋かひにふとん敷たり宵の春誰が為の低き枕ぞ春の暮春の夜に尊き御所を守る身かな　注意すべきは、これらの句（最後の一句は少し別の情趣であるが）を見ても解る如く、蕪村のエロチック・センチメントが、すべてみな主観の内景する表象であって、現実の恋愛実感でないことである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "折釘に烏帽子かけたり宵の春春の夜に尊き御所を守る身かな春雨や同車の君がさざめ言ほととぎす平安朝を筋かひにさしぬきを足で脱ぐ夜や朧月　引例を見ても解るように、特に春の句においてそれが多いのは、平安朝の優美でエロチックな文化や風俗やが、春宵の悩ましい主観において、特にイメージを強く与えるためなのだろう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『あれ』屍を守る見樣で、棒の如く突立つた女は、軈て俄然と身を投て、伏重なつたと思ふと、熟と僵れて身動も仕無い。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "交通の便利な今のわれわれにはちょっと想像し難いほどの長い留守を明けたものであるが、若い時から半分以上は他国を奔走してばかりいた父には五年くらいの留守は何でもないことであり、留守を守る祖母や母も当り前の事と思っていたものらしい。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "百萬圓きづきあげるよりも、百萬圓守るのが、むづかしいのだ。",
              "citation": {
                "source": "人物に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "守るちからは、はたからは、絶對に見えぬ。",
              "citation": {
                "source": "人物に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これこそプロ文学を守る道（下）　Ｎに、私は、この「遺言文学」を奨めたのである。",
              "citation": {
                "source": "遺言文学",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁はこの山には人身の岳神が住み守ると聞いたが、それにしたら、その岳神は結婚していて、恐らくその妻は良人より年長のいわゆる姉女房であるであろうと山占いをした。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い瞳がうち看守る八つの湖、春を敷妙の床の花原。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、この個人的な経験はおそらく一般的には応用が利かないであろうし、ましてや、科学の神殿を守る祭祀の司になろうと志す人、また科学の階段を登って栄達と権勢の花の山に遊ぼうと望む人達にはあまり参考になりそうに思われないのである。",
              "citation": {
                "source": "科学に志す人へ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "呆然と殿様を見守る。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそれを恐れ厭ふやうに、また美しくも忘れ難い印象を自分の胸裡に守るやうにして、妹の待つ湯の川の宿へと急ぎ歸つた。",
              "citation": {
                "source": "處女作の思ひ出",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち銃を愛し守る立派な精神を示したのだ‥‥」と、軍曹は咳一｜咳した。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソビエットを守るパルチザンの襲撃は鋭利になりだした。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤牛は、じいっと鞍を背負って子供を見守るように立っていた。",
              "citation": {
                "source": "二銭銅貨",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまたの手を経るまにまに、さきざきの考えの上をなおよく考えきわむるからに、次々にくわしくなりもて行くわざなれば、師の説なりとて必ずなずみ守るべきにもあらず。",
              "citation": {
                "source": "人の言葉――自分の言葉",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "よきあしきをいわず、ひたぶるに古きを守るは、学問の道には、いうかいなきわざなり。",
              "citation": {
                "source": "人の言葉――自分の言葉",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしも時代と場所がちがっていて、人が自分の生命に賭けても Honour を守るような場合であったらこれはただではすみそうもない。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代りに、蔭ながらお前たち夫婦の身の上を守るとも云った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "むらさき鯉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら口止めをして置いても、果たして秘密を守るかどうか頗る不安心である。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、二人の巡警は、棺車を守る七八人の屈強な男の敵じゃなかった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番最後に歌った意味は、『老母は愛児の帰りを待ちわび、紅粧の新妻淋しく空閨を守る。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが、俺れたちの工場を守るための武装だったらなア！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、自分の身を守るだけに力いっぱいだった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「俺等が、わざわざここまでよこされて、本当の親がいるとしてもだ、その親を守ることさえ出来ないんだぞ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつらの利益を守るためには、あらゆるものを犠牲にしてかえりみないのだ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔老いては冬の孔雀守る〕老いては冬の孔雀守る、　　　　蒲の脛巾とかはごろも、園の広場の午后二時は、　　　　湯｜管のむせびたゞほのか。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは豪雨のときに氾濫する虞れの多い溪の水からこの温泉を守る防壁で、片側はその壁、片側は崖の壁で、その上に人々が衣服を脱いだり一服したりする三十畳敷くらいの木造建築がとりつけてあった。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "消ゆるかに見えて、また立つ漣……」　岳麓にできた八つの湖、その一つ一つを見まもる八人の河神の若い瞳。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to keep (i.e. a promise)",
