        "examples": {
          "standard": [
            {
              "text": "インドの豪華絢爛な宮殿は、かつてこの地を治めたマハラジャの住居だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "物語に登場するマハラジャは、たくさんの宝石と黄金を所有していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼はまるでマハラジャのように、毎日贅沢な暮らしを楽しんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "「わたくしがラホレのマハラジャの宮殿にいました時の事ですが」なんと云う。",
              "citation": {
                "source": "世界漫遊",
                "author": "ダウィット　Jacob Julius David",
                "note": "青空文庫"
              }
            }
