  {
    "uuid": "3017a608-61b1-51c2-8906-a2f737ec3055",
    "entry": "将行",
    "reading": {
      "primary": "まさゆき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "天皇祇‐承夢訓、依以将行。",
              "citation": {
                "source": "日本文学の発生",
                "author": "――その基礎論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "引張つて上様へ将行きて、八省に将入りぬ。",
              "citation": {
                "source": "放免考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "公卿では花山院｜師賢、あぜちの大納言｜公敏、北畠｜具行、侍従の公明、別当｜実世、烏丸ノ成輔、さえもんの督為明、左中将行房、ちぐさ忠顕、少将｜能定。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつまた一徹な部下ども、荒くれども、これらも、何をしでかすか、自暴の極には分りませぬぞ」「あいや、貞満」　頭ノ中将行房が、大床の端から諭した。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "本朝の部卷第十六「利仁將軍若時從京敦賀將行五位語第十七」がそれである。",
              "citation": {
                "source": "芥川龍之介論",
                "author": "――藝術家としての彼を論ず――",
                "note": "青空文庫"
              }
            },
            {
              "text": "送｜木尾君、日高君、救仁郷君三子之佛國序三子者將行。",
              "citation": {
                "source": "遺篇",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
