[
  {
    "uuid": "2ed22bfd-164f-5560-a71e-cbb0365833d1",
    "entry": "万寿",
    "reading": {
      "primary": "まんじゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
