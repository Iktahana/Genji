        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "西側なら、カアナパリからマアラエアにかけて、そして東側ならマアラエアからさらにマケナあたりまで、鯨を見るために有利な場所はいくらでもある。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「レイモンド」「やあ、バリー」「どうなんだ、マアラエアの波は」「まだ待ち続けているよ」　太い男性的な声で、レイモンドは低く笑った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アランのポスターを見て、絶対にこの男だ、とふたりは言っている」「よし」「どうしたらいいだろう」「僕がマウイへ出向こう」「そうしてくれるか」「アランを探している女性をつれていく」「俺たちは、マアラエアの、ファーマー・ジョーのところにいる」「いくよ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その胸像の顎のすぐ下、喉もとにあたる部分が、マアラエア湾だ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアラエア湾のすぐ近く、歩いても十五分とかからないところに、ジョーというサーファーが住んでいる。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアラエアで農業にうちこむかたわら、めったに来ないことで有名なこの湾のサーフで波乗りをしている男だ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアラエア湾にも、猿がたくさんいたからなあ」　反射的に僕は両足をダッシュボードから降ろした。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "湾の猿たちと分けて食うよ」　そう言って車を発進させ、僕はマアラエア湾に向かった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ近くにカフーラウェ島が見える湾の海いっぱいに、マアラエアのサーフが走っていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前中の時間が経過するにしたがって、マアラエアの波はパワーを増した。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラリー・デイヴィスたちは、マアラエアに波が来た知らせを電話で受け、飛行機で飛んで来た。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "半日がかりで完全にノック・アウトをくらった僕は、夕陽の砂浜でマアラエアの波を見ながら、からっぽの置き物のようになっていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
