        "examples": {
          "standard": [
            {
              "text": "蜜で重くなったのか、丸花蜂がゆっくりとした動作で次の花へと移動した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "畑の片隅で、丸花蜂が巣を作るのに適した場所を探して地面を這っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "窓を叩く羽音に気づいて見ると、大きな丸花蜂が外に出ようともがいていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "おかの　てっぺんぺんにある　まるはなばちの　すから　かっぱらってきた　ものでした。",
              "citation": {
                "source": "きたりすナトキンのはなし",
                "author": "THE TALE OF SQUIRREL NUTKIN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と　まるはなばちの　おんなのこが　しゃべります。",
              "citation": {
                "source": "おねずみおばさんのはなし",
                "author": "THE TALE OF MRS. TITTLEMOUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まるはなばちは　すっきゃない。",
              "citation": {
