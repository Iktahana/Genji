        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お前の代りに澄子という女を買うよ、だからマネージヤーに交渉してくれ――こう私が頼んだところ、厭な顔もせずに頼みに応じ、マネージャーに交渉してくれた程でした。",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "島津と云ふものは其莊園のマネージヤーに過ぎなかつたのです。",
              "citation": {
                "source": "日本の眞の姿",
                "author": "竹越與三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち莊園のマネージヤーです。",
              "citation": {
                "source": "日本の眞の姿",
                "author": "竹越與三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マネージヤーらしき男が、扉を開けてはひつて来る。",
              "citation": {
                "source": "音の世界",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、マネージヤーが飛んで来ら。",
              "citation": {
                "source": "音の世界",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
