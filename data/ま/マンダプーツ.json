        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今回は恩師のハスカル・ヴァン・マンダプーツ物理学の老教授に会える機会だった。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の週、マンダプーツ老教授と約束できた。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃあ、ほかは誰だ」「えー、コベイル、ヘースティング、シュリムスキー」「ばか、マンダプーツさまの名前を言って、その舌の根も乾かぬうちに奴らをあげるとは。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま前世記へ戻って、アインシュタインとかド・ジッターと言えば、名声はおそらくマンダプーツさまに並ぶか、ちょっと下だ」　俺はおかしくなってまた笑った。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこのマンダプーツさまこそが初めて時間をつかみ研究室へ引きずり込み、実験を行った」「本当ですか。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "その過ちを正すにマンダプーツさまは要らない。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "ディクソン、君はマンダプーツさまのところで研究したろう」　教授は感情が高ぶり真っ赤になったあと、厳粛になった。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすれば限定秒だが、このマンダプーツさまが未来へ旅行できることを認めよう。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「マンダプーツさまでも不可能なことはできない」　今度は少し楽しそうに言った。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンダプーツさまは常に最短、最も論理的な道を選ぶ。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「マンダプーツさまなら簡単だ。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあちょっと現金化するのが遅れましたが」　マンダプーツ教授がのたもうた。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンダプーツ教授が部品を指さした。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンダプーツ教授が光源スイッチを入れると、影が動き始めた。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フーッ」　俺はマンダプーツ教授を見た。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これこそマンダプーツさまの大貢献だ。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "なあディック君、マンダプーツさまが示した正当な読みはこうだ。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "何にも」　マンダプーツ教授との会話を思い出した。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしという言葉でマンダプーツ教授と仮想機を思い出した。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンダプーツ教授に電話してアポを取るしかない。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついに、奔放でユーモアがあり知的なマンダプーツ教授が、朝の講義途中で電話口に出た。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくマンダプーツ教授には強烈な印象となった。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりマンダプーツさまの自伝にほかならぬ」　教授は感に堪えかねて一息いれた。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンダプーツさまは戦争の当り外れの要因を排除した」　教授がもったいぶって眉をひそめた。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンダプーツさまの自伝だ。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "友達に送ります」　マンダプーツ教授が屈託なく言った。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンダプーツさまをよく表わしておる。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "「行こう」　マンダプーツ教授が地声で言った。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンダプーツ教授に合図を送った。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は、ショックでこわばった眼を仮想機から離し、マンダプーツ教授を見た。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
