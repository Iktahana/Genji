    "definitions": [
      {
        "index": 1,
        "gloss": "rise of the curtain",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「いよいよ幕開きだ！ドキドキするな！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "厳かな音楽とともに、静かに幕開きが始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供たちは、初めて見る劇場の幕開きに目を輝かせていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "空しく窓下に戻つて来ると、また別の紙芝居がさかんに拍子木を鳴らして「幕開き」を報じてゐた。",
              "citation": {
                "source": "真夏の朝のひとゝき",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一言、附け足して置く次第だが、紙芝居の拍子木はどれもこれも「幕開き」の合図が物々しいのに引き代へて、「幕引き」の木の音を聞いた験しがない。",
              "citation": {
                "source": "真夏の朝のひとゝき",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の中は――白い布を、扉の半開きだけあげた店の中は、幕開き前とでもいうように混沌としている。",
              "citation": {
                "source": "一世お鯉",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "義経に関係のない狂言にも、幕開きはまづ舞台空虚の、上手の障子屋台から、判官義経現れ、「一間の内より義経公悠々として出で給ひしが、さして用事もなかりければ、再一間に入り給ふ」と語る浄瑠璃に連れて、影を消す。",
              "citation": {
                "source": "芸能民習",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕開きの「しだし」の出入り・せりふを聞き外しても残念に思ふ位だ。",
              "citation": {
                "source": "芝居見の芝居知らず",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "今思えばあれは私にとって、三浦の生涯の悲劇に立ち合った最初の幕開きだったのですが、当時は勿論私にしても、ほんの不安の影ばかりが際どく頭を掠めただけで、後はまた元の如く、三浦を相手に賑な盃のやりとりを始めました。",
              "citation": {
                "source": "開化の良人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしか戰後の作春情鳩の町の幕開きに、この烟は使はれてゐたやうに思ふ。",
              "citation": {
                "source": "荷風翁の發句",
                "author": "心猿",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は漸くカワレリヤ、ルスチカナの幕開きに淋しい立琴を合方にして歌ふシチリヤナの一節を思付いた。",
              "citation": {
                "source": "黄昏の地中海",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕開き幕切れは、いつもの通り、自分が手を叩く。",
              "citation": {
                "source": "職業（教訓劇）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "街路の両側の小屋からは、幕開きの銅鑼の賑やかな音が笛や太鼓や鉦に混じって騒々しいまでに聞こえて来る。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕開き間際に、この學校の學生と覺しき學生が、興もなげに入つて來て席を埋めるだけであつた。",
              "citation": {
                "source": "心の故郷",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャペックの『虫の世界』の幕開きに登場する、あのベルトラン先生のような超俗なすがたである。",
              "citation": {
                "source": "キャラコさん",
                "author": "ぬすびと",
                "note": "青空文庫"
              }
            },
            {
              "text": "……オルゴールが三味線に変っただけで、全部が第一場の幕開きと同じ情景である）　（庭の樹々に陽が照り、明るく、静まっている）（終わり）（昭和十六年六月作）",
              "citation": {
                "source": "好日",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "魔術師　そして、間もなく、復讐鬼のいわゆる第二幕目の幕開きの日がやって来た。",
              "citation": {
                "source": "悪魔の紋章",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝居茶屋もブル階級には見得と便利と半分半分、身のまわりを一切預けて幕開きまでは座敷で一服、へい、明きます、と出方のお迎え、食事の世話からお手水の催促までうるさいほど行き届く。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の部の「金剛」の幕開きで豆撒きをした。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ来て、三の「凸凹レヴィウ団」の幕開きを見て、いさゝか寒くなった、エライ芝居をやってゐる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕あきに間もなさそうで、急足になる往来の中を、また竹の扉からひょいと出たのは、娘を世話した男衆でね。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "危いと思った時、幕あきの鳴ものが、チャンと入って、下座の三味線が、ト手首を口へ取って、湿をくれたのが、ちらりと見える。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて幕あきのしやぎりの鳴物が耳に近く響いて来た。",
              "citation": {
                "source": "二黒の巳",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "而してオペラの幕あきの合図の電鈴のやうにとりとめもなく逍遥うてゐる私の夕暮の感覚をひき戻す。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は寺院の鐘の音では夢を破られなかつたが、直ぐの窓下で芝居の幕あきの調子で鳴る紙芝居師の拍子木の響で、毎朝目を醒されると、別に自分を役者にも観客にもなぞらへるわけでもないのであつたが、やはり何かしら遊戯的気分に誘はれるのであつた。",
              "citation": {
                "source": "真夏の朝のひとゝき",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝のうちに二度、午さがりに一度、黄昏へかけて更に二度と、次々に現れるのであるが、いづれも幕あきの景気だけが花々しい。",
              "citation": {
                "source": "真夏の朝のひとゝき",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬば玉の闇汁會はいよ／＼幕あきとなりぬ。",
              "citation": {
                "source": "闇汁圖解",
                "author": "子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは不幸なできごとの幕あきのベルをならしたようなものだった。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどバレイの幕あきのような照明効果をもって、コロンボはいま私達のまえに出現しようとしている。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕あきを今や遅しと待ちかねているものは、米友一人ではありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "半四郎は、師匠のいられた楽屋附近へは、幕あきの前に近よっていません。",
              "citation": {
                "source": "京鹿子娘道成寺",
                "author": "酒井嘉七",
                "note": "青空文庫"
              }
            },
            {
              "text": "一列目には幕あき前のひと時を、土地の伊達者連中が両手をうしろへまわして立っていた。",
              "citation": {
                "source": "犬を連れた奥さん",
                "author": "DAMA S SOBACHKOI",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕あきは、きっかり八時半。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
