        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソマトーゼを服用した人としなかった人が十年振りで逢ったようなところもあると、誰かが云った。",
              "citation": {
                "source": "帝展を見ざるの記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "六円五十銭もするソマトーゼを服ませたり、一切五銭もする鯛のさしみをたべさせたり、お前だって忘れはすまい。",
              "citation": {
                "source": "草藪",
                "author": "鷹野つぎ",
                "note": "青空文庫"
              }
            },
            {
              "text": "このソマトーゼはもとは六円五十銭でしたが、只今は十円近いでしたよ。",
              "citation": {
                "source": "草藪",
                "author": "鷹野つぎ",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝手口の井戸の傍に、トマトーが植えてあります。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、「ソマトーゼ飲まぬ人」の如く細く、万太郎氏はその反対なのに。",
              "citation": {
                "source": "足袋のこと",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "（それを書くについては、メーテルリンク氏の夫人のジョルジェット・ルブランさんの書いた「子供のための青い鳥」、メーテルリンク氏の全作品の專門飜譯家としてきこえたアレグザンダ・デ・マトーズ氏のおなじく「子供のためのチルチル」といふ二つの本がもとになりました。",
              "citation": {
                "source": "はじめに",
                "author": "「青い鳥」訳者序",
                "note": "青空文庫"
              }
            },
            {
              "text": "かういふ話を私ひとりでがんばつて受けつけないでゐれば、一億一心といふマトーにはづれるのだから、町会から少しぐらゐ意地わるの事をされても仕方がなかつた、もうすぐそこに一つ別の問題が起りかけてゐた。",
              "citation": {
                "source": "池を掘る",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
