[
  {
    "uuid": "adcc9395-0a3f-538b-9e07-65e04e479191",
    "entry": "狸穴",
    "reading": {
      "primary": "まみあな",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
