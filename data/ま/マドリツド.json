        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "星眼｜長へに秋波を浮べて、「悪の華」の詩人が臨終を見る、猶往年マドリツドの宮廷に、黄面の侏儒が筋斗の戯を傍観するが如くなりしと云ふ。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "マドリツドへ、リオへ、サマルカンドへ、……　そのうちに或店の軒に吊つた、白い小型の看板は突然僕を不安にした。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "マドリツドへ、リオへ、サマルカンドへ、――僕はかう云ふ僕の夢を嘲笑はない訣には行かなかつた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "マドリツドで首を切られた後、十年間義務不履行といふ時代があつたんだ。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
