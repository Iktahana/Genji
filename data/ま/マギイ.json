        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "廊下｜越しの部屋から椅子直しのマギイ婆さんがやって来た。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マギイ婆さんが何か食物を心配しようと云い出すのを押えてリゼットは云った。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マギイ婆さんが顔の筋一つ動かさずに云った。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マギイ婆さんは保証した。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マギイ婆さんとおいぼれがやって来た。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リゼットはマギイ婆さんに向っても同様に盃を挙げた。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "うしろから行くマギイ婆さんは何となく嫉妬を感じ始めた。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パパの鋸楽師と、ママンのマギイ婆さんが珍らしそうに英語名前の食ものを食っている間に入り代り立ち代り獲ものは罠の座についた。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マギイ婆さんは鋸楽師のおいぼれを連れて自分の部屋へ引きとった。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ままよ、どうあろうと　　74マギイ＊の酒に酔うたとならば、正にそうさ。",
              "citation": {
                "source": "ルバイヤート",
                "author": "RUBA'IYAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "（85）法官よ、マギイの酒にこれほど酔ってもおれの心はなおたしかだよ、君よりも。",
              "citation": {
                "source": "ルバイヤート",
                "author": "RUBA'IYAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "74　マギイ――拝火教の司祭。",
              "citation": {
                "source": "ルバイヤート",
                "author": "RUBA'IYAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『陛下、女王はコマギイナの王と密室で謁見して居られます』とメンケラが答へた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "女王の寝室に近づくと王は、コマギイナの王が来るのに遇つた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてシバの都に自分の国も忘れてうかうかと時を過してゐたコマギイナの王の所へ駈けて行つた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　とコマギイナの王が答へた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
