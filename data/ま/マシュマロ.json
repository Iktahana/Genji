        "examples": {
          "standard": [
            {
              "text": "キャンプの夜、焚き火の枝に刺したマシュマロをほんのり焦げ目がつくまで焼いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "温かいココアに小さなマシュマロを浮かべると、甘く溶けてとても美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼女はふわふわのマシュマロを頬張りながら、幸せそうに微笑んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "マシマロのように豊かな顔の輪廓に思い切り短く刈り上げてしまったお河童がちっとも不自然でなくよくうつっていた。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "マシマロのように白っぽい一寸面白そうな女なり。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マシマロのように白っぽい一寸面白そうな女。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七八の頃、自分の小遣で菓子を買ふやうになつて、僕は、しきりにマシマロを買つた。",
              "citation": {
                "source": "甘い話",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "父のシャボンは、マシマロのやうな甘い匂ひがする。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫いろのマシマロみたいな匂ひである。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "マシマロの匂ひが一きは濃くなつて、少年はほとんど窒息感をおぼえる。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゾベイダといふ名が、マシマロのやうに匂つてゐたことに思ひ当る。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "『戻つてくる時には、マシマロの匂ひがしみこんでゐるだらう。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
