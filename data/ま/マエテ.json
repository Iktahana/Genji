        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ナマメカシイト云ッタライヽノカ、色ッポイト云ッタライヽノカ、己ハ今マデニアンナ妖艶ナ女ヲ見タコトガナイ、妖婦ト云ウノハ正シクアンナ女ノコトヲ云ウンダロウナ、アンナ女ニナラ殺サレタッテイヽト思ッタト、湿ノ父親ハイツモ忰ヲ掴マエテヨク／＼感ニ耐エタヨウニ云イ暮ラシタソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御馳走サマ、久シ振ニオイシカッタワ」茶ヲ飲ンデイル颯子ヲ掴マエテ予ハオモムロニ話シカケタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夕食後、二人ガ妻ヲ映画ニ誘ウト称シテ連レ出シニ来、十一時過ギテモ戻ラナイノデ、アルイハソンナデ掴マエテ来マシタ」彼女ハ独得ノ意地ノ悪イ眼デ僕ノ眼ヲ覗イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
