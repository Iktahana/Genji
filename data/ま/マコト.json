[
  {
    "uuid": "31bf01e9-576f-50cb-928e-93d613827060",
    "entry": "誠",
    "reading": {
      "primary": "まこと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
