          "literary": [
            {
              "text": "右の眉骨を打ったと見えて眼瞼がまんじゅうのようにふくれ上がった。",
              "citation": {
                "source": "鎖骨",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見｜飄乎とした旅の坊さんでしかないが、眉骨｜隆く、口は大きく、どこか異相なところがある。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉骨は隆く、鼻ばしらは太い。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "油蝉みたいな黒い皮膚をし、かなつぼ眼というのか、眼のくぼが凹んでいて、高い眉骨の下から、眸がぴかぴかしている。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
