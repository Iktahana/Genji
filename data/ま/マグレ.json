[
  {
    "uuid": "2e53794b-4fb0-534e-b892-c1b3af12c561",
    "entry": "紛れ",
    "reading": {
      "primary": "まぐれ",
      "alternatives": [
        "マグレ"
      ],
      "is_heteronym": false
    },
    "grammar": {
