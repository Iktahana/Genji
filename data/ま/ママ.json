        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "路地裏にあるスナックのママは、客の悩みを聞くのがとても上手だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ママ、いつものお願い」と、常連客がカウンターに座った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "着物姿のママが、優雅な所作でお酒を作ってくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
