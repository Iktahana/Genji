[
  {
    "uuid": "63b05baa-2c07-5807-9355-5cd84c00a973",
    "entry": "巻き起こす",
    "reading": {
      "primary": "まきおこす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
