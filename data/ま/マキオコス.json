          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "強風が地面の枯れ葉を巻き起こし、視界が悪くなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "車の走行で、未舗装の道から土埃が巻き起こされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "竜巻が、あっという間に大量の砂を巻き起こした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
