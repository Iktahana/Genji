        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「そうですね、グラント・マンロウさん――」　とホームズが話し出すと、依頼人は椅子から飛び上がり、「えっ！",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「早く次第を聞かせてください、マンロウさん。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」グラント・マンロウ氏を戸のところまで見送り、戻ってくると我が友人はそのように言った。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "グラント・マンロウ氏は、せかせかと先へ進み、我々もよろめきつつ何とかあとを追った。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とグラント・マンロウが叫ぶ。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "グラント・マンロウは、二階の明かりのついた部屋に飛び込んだので、我々も続いて中に入った。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、グラント・マンロウは手で自分ののどをつかんだまま立ちつくしている。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてグラント・マンロウ氏は沈黙を破った。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
