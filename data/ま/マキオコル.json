        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "小さな火花から、瞬く間に大きな炎が巻き起こった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "嵐の中で、砂浜には砂が巻き起こり、視界を遮った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼のパフォーマンスに、会場全体に熱狂的な拍手が巻き起こった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "あくる朝、みなが目覚めるとその月影の覆いは天空へと浮かび上がり勢い増してつむじ風も巻き起こる。",
              "citation": {
                "source": "ポオ異界詩集",
                "author": "エドガー・Ａ・ポオ　Edger A. Poe",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、その翌日から、フローラをめぐって、この島には激しい情欲の渦が巻き起こることになった。",
              "citation": {
                "source": "紅毛傾城",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗礼を受け、つつましく生活していた娘達が、若い男の気配だけに上気して小さな葛藤がまきおこるといふ話。",
              "citation": {
                "source": "悲願に就て",
                "author": "――「文芸」の作品批評に関聯して――",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗礼を受け、つつましく生活していた娘達が、若い男の気配だけに上気して小さな葛藤がまきおこるという話。",
              "citation": {
                "source": "悲願に就て",
                "author": "――「文芸」の作品批評に関聯して――",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の日にまきおこる雲に燃え、陽光がさんさんと輝く、この国の大空。",
              "citation": {
                "source": "わたくし自身について",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それッ」　いまぞ最後とふりかぶった一刀、またもまきおこる砂塵、しばらくそのしずまるのをまって、見なおすと、「や、や、猿！",
              "citation": {
                "source": "幻術天魔太郎",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　群衆の中にまきおこる歓声の中を、警官と賊とは、追跡してきた車に同乗して、警視庁へと急ぎます。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "――序のしらべ絶えつ続きつ、いつしかに黒き悩の旋律ぞ渦巻き起る。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありがたや……とキョロキョロチョロチョロと駈けまわる間もなく、今度は世界が消え失せるばかりの大地震、大噴火、大海嘯が四方八方から渦巻き起る。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして次第次第に早く……遂には眼にも止まらぬ鉄の眩覚が私の周囲から一時に渦巻き起る。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今もまた、その考えで、人通りのほとんどないほどの朝まだきに番町を出て、こうして、下町方面へ、無意識に急いでゆくうちに、むらむらと巻き起る考えが、駒井の足の向きを変えさせてしまいました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の頭に巻き起るさまざまの幻想を、いちいち事実と混合してしまうこともあれば、不断の脅迫感に襲われて、あらぬ敵を有るように妄信していることも限りはないのだから、狂人のいうことを、そのままに取り上げるわけにはゆかないが、さきほど言ったことの浅ましさが、こうして見ると、いよいよ身にこたえる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、谷から捲き起こる風の叫びであったか、また、山を越えて、あちらの海からうめき起こる波の音であったかしれないが、たえず、すさまじい、魂を戦かせるような響きをきいて、花弁を震わせながら咲いていたのでした。",
              "citation": {
                "source": "みつばちのきた日",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラーゲ旋風が果して国難的旋風であるか、楽壇啓蒙の薫風であるか――それとも国辱的旋風であるか――の正体を掴み、其の捲き起こる原因を究明して、之に対処していたならば、今頃は旋風一過して太陽の慈光が遍照していよう筈なのに、旋風が益々力を加えつつある所を見ると、日本楽壇に人無きの嘆に堪えぬ。",
              "citation": {
                "source": "「プラーゲ旋風」の話",
                "author": "山下博章",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもいつどこから嵐が巻起こるかもわからない今、それを捨てて国へ帰る勇気は彼にもなかった。",
              "citation": {
                "source": "落ち梅記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
