          "literary": [
            {
              "text": "――青くけぶって、西北の彼方に見えるのがマシケの山々。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "濶く湾入したイシカリの海を、その北方の口にあたって区切るマシケあたりの岬であった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "行く手――マシケ連山から流れて来た尾根のはずれに、白い煙がごッと舞いあがった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            }
          ]
        }
