        "examples": {
          "standard": [
            {
              "text": "モーツァルトの歌劇「魔笛」の中で、夜の女王が歌う超絶技巧のアリアには圧倒される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「今夜はオペラハウスで『魔笛』の公演があるから、とびきりのお洒落をして行こう。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "音楽の授業で『魔笛』のあらすじを学び、パパゲーノという愉快なキャラクターが気に入った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
