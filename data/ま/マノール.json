          "literary": [
            {
              "text": "それで英吉利の如きは丁度同じ時代に奴隷が段々少くなつて來てマノール・ハウスが出て來た。",
              "citation": {
                "source": "日本の眞の姿",
                "author": "竹越與三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マノール・ハウスは日本の莊園見たいなものである。",
              "citation": {
                "source": "日本の眞の姿",
                "author": "竹越與三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "封建制度の前身でありますが、マノール・ランドと言ひまして別莊地と言ふのです。",
              "citation": {
                "source": "日本の眞の姿",
                "author": "竹越與三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "英吉利のマノール・ランドも其通りです。",
              "citation": {
                "source": "日本の眞の姿",
                "author": "竹越與三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マノール・ランドにどん／″＼人が入り込んでしまつて、其のときの王樣とか何とかの苦役を離れてしまひますから奴隷が何時の間にか分らなく消えてしまつた。",
              "citation": {
                "source": "日本の眞の姿",
                "author": "竹越與三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
