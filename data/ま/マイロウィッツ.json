        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "幻想交響曲、その他の管弦楽曲　このベルリオーズの代表作のレコードは、モントゥー、マイロウィッツ、ピエルネ、ワルターがそれぞれ指揮した全曲あるいは全曲近いレコードが四種まで入っている。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他マイロウィッツ（コロムビア）、オルマンディー（ビクター）、クライバー（テレフンケン）の指揮したレコードもある。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "レコードはコロムビアにマイロウィッツがパリ交響楽団とヴラソフ合唱団を指揮したのがある（ＪＷ五六三―九）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "意図も、技巧も、コロムビアのキレニー（ピアノ）マイロウィッツ指揮、パリ交響楽団が名演だ（ＪＷ五四〇―一）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
