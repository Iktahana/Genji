          "literary": [
            {
              "text": "日本潜入を願ひでゝ、一六三〇年二月二日乗船、マリベレス島で難船したが助かり、日本逆潜入に成功した。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "一六三〇年（寛永七年）二月二日フィリッピンより船出して、マリベレス島で難船したが、彼は奇蹟的に助かり、首尾よく日本潜入に成功した。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリベレス島で難船して奇蹟的に助かったという一節によっても、水泳なども甚だ達者であったように思われますね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
