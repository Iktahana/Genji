        "examples": {
          "standard": [
            {
              "text": "この時期は真河豚が旬で、刺身で食べるのが美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "冬の味覚である真河豚の刺身は、透き通るような美しさだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "地元の漁師から、獲れたての立派な真河豚を分けてもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "有馬の小娘ひとりのことでも、酔余の癇癪にまかせて、切支丹教師追放を思ひ立つてしまふぐらゐ、有り得ない話ではなかつた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいたいが自分を最も無責任に投りだしてしまふぐらゐ容易なことはないのである。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
