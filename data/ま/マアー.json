          "literary": [
            {
              "text": "マアー、コトモアロウニ、ジブンタチノ死ンダオ母ッチャニアゲタモノヲ、君チャンヤ弟ヤ妹ガ、ムチウニナッテ、タベテイルデハナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「マアー」　と言つて、例の媚びるやうな耻しさうな笑ひかたをして、母と私と杯とを活々した輝く瞳で等分に見る。",
              "citation": {
                "source": "姉妹",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マアー素敵」　ラキ子ちゃんは思わず僕の肩を握りしめのびあがった。",
              "citation": {
                "source": "花模様女剣戟",
                "author": "小野佐世男",
                "note": "青空文庫"
              }
            },
            {
              "text": "盗んだんです」「マアーっ」　婦人は息を引いて見せたが、その実、大して驚いているようでもなかった。",
              "citation": {
                "source": "薔薇夫人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
