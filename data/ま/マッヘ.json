        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ああ、僕はシュライエルマッヘルじゃないがね。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗教でも、もうだいぶ古くシュライエルマッヘルが神を父であるかのように考えると云っている。",
              "citation": {
                "source": "かのように",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィヒテ、シェリング、シュライエルマッヘルなどの大思想家たちが、鮮かな人生観と世界観との上に立つて大学の本分に就いて論じてくれたことは、独逸の大学にとつてどれほど幸福な事実であつたでせう。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュライエルマッヘルの『宗教的講演』や『独語録』は感激をもって読んだ。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏は『宗教的意識』のなかにシュライエルマッヘルを引いて、宗教の認識論的研究の必要を説いているが、まことに氏の宗教は認識論をもって終始している。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月一日（土曜）　朝（髪を洗ったので、おとといの晩Ｙのところで）パリクマッヘル〔床屋〕に出かける。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まず当分はシュライエルマッヘルどころの騒ぎじゃなさそうだ。",
              "citation": {
                "source": "路上",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「シュライエルマッヘル？",
              "citation": {
                "source": "路上",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「有限性の眞中において無限者と一になり、一瞬時において永遠的である――宗教の不死性はこれ」といふ、人口に膾炙するシュライエルマッヘルの言は、同じ思想を簡潔に印象深く言ひ表はしたものに過ぎぬ（三）。",
              "citation": {
                "source": "時と永遠",
                "author": "波多野精一",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学の教授で、偉い医学博士の先生たちが、皆そう言われたので、方々の温泉地では、当温泉の放射能は、何十マッヘなどと、大いに宣伝したものである。",
              "citation": {
                "source": "科学ブームへの苦言",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "哲学者たるとともにまた傑れた古典文学者であったシュライエルマッヘルは、クセノフォンのソクラテス描写とプラトン、アリストテレスのそれとを比較検討して、クセノフォンはだめだという結果に達した。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ライン川地方の医師ラーデマッヘルはパラケルススの教えをシステムにして「実験医学」と名付けた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
