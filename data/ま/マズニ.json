          "literary": [
            {
              "text": "予ハ土蹈マズニ唇ヲ着ケル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "盛リ上ッテイル部分カラ土蹈マズニ移ル部分ノ、継ギ目ガナカ／＼ムズカシカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭ニ浮カブノハ妻ト寝ルハナカッタノニ、終日何モ読マズニイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
