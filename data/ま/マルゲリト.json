        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「マルゲリトの小さな花が一面に咲いて居る。",
              "citation": {
                "source": "土民生活",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "清らかな、純白な、野菊に似た無数のマルゲリトは、柔かい青芝生の広庭一面に、浮織の様に咲き揃ふて居る。",
              "citation": {
                "source": "土民生活",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「稚い緑りの草の葉は、時々微風に戦いで幽かに私語くことさへあるが、マルゲリトは何時も静かに深い沈黙に耽つて居る。",
              "citation": {
                "source": "土民生活",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の際涯無き大空に対して、アの細やかなマルゲリトは抑も何事を語るであろう」。",
              "citation": {
                "source": "土民生活",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マルゲリトの沈黙の深いこと！",
              "citation": {
                "source": "土民生活",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルゲリトは地の子である。",
              "citation": {
                "source": "土民生活",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "門口でわしは、前にわしの護衛兵だつた、あの黒人の扈従のマルゲリトンを見た。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女に貧乏生活の教えとでもいうべきものを与えてくれた婆さんは、マルグリットという聖い独身者で、りっぱな信仰を持ち、貧乏ではあるが、貧しい者のみでなく金持ちに対してまで恵み深く、マルゲリトと署名するだけのことはりっぱに知っており、また学問としては神を信ずることを知っていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
