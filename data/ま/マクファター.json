          "literary": [
            {
              "text": "しかし、リズム・アンド・ブルース・アーティストの選択としては、ジョー・ターナー、クライド・マクファター、ファッツ・ドミノ、ウイリー・メイ・ソーントンなどよりは、白人世間一般の人に対する戦術としてはまさっている。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラッキー・ミリンダー、アイヴォリー・ジョー・ハンター、ブルムース・ジャクスン、ザ・ドミノスのクライド・マクファター、あとでツイストのスタートをつくった、ミッドナイターズのリーダー、ハンク・バラード。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジーン・ヴィンセントとまちがえたのがもっとも多く、チャック・ベリー、ファッツ・ドミノ、クライド・マクファター、ビル・ヘイリー、ジョー・ターナーなどの名が、あげてあった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
