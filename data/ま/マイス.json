[
  {
    "uuid": "ad758802-7a1d-5fca-a756-6944e77a9e1f",
    "entry": "売僧",
    "reading": {
      "primary": "まいす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
