      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "corrupt monk",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "高額な祈祷料を要求し、豪遊を繰り返すその僧侶は、近隣住民から売僧と蔑まれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "仏の道を説きながら裏で悪事を働く売僧のような輩に、先祖の供養を任せるわけにはいかない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "かつての清廉な寺院も、今や金儲け主義の売僧たちの巣窟と化してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「ところが違わない」「違わないことがあるものか、ちがわないと云うなら、お前さんは、邸の名を騙る売僧じゃ」　用人は憤りだした。",
              "citation": {
                "source": "貧乏神物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「売僧、その袖の首は、何としたものじゃ、僧侶の身にあるまじき曲事、有体に申せばよし、偽り申すとためにならぬぞ」　怪量は役人を見て笑った。",
              "citation": {
                "source": "轆轤首",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「売僧、そのような無稽な申し立て、此処では通らぬぞ、察するにその方、僧侶の身にあるまじき殺生を犯した故、死者の妄執晴れやらず、それへ止まっておるに相違あるまい、処の法に照らして所刑する」「いや待たれい」　その時まで控席に黙々としていた年老いた役人が進み出た。",
              "citation": {
                "source": "轆轤首",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が再びこの店先に立たないのをみると、やはりそれは真実の予言で、彼は夫がひと口に貶してしまったような商売ずくの卑しい売僧ではないと思われた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "何がな金にせんと目論み、一つの鐘に二つまで瑕の由来を作った売僧輩の所行微笑の至りだが、欧州の耶蘇寺にも、愚昧な善男女を宛て込んで、何とも沙汰の限りな聖蹟霊宝を、捏造保在した事無数だ。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "禅は思想上のキューリオ、精神上の催眠剤であって、今日の紛糾錯綜入乱れた文化の葛藤を解決し制馭する威力のないものであるというのが二葉亭の禅に対する断案で、何かの茶咄のついでに一休は売僧、白隠は落語家、桃水和尚はモーズレーの研究資料だと茶かした事があった。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの念日様が嘘を言う気づかいござりませぬゆえ、本当のことに相違ござりませぬ」「売僧めッ、よくも化かしおッたなッ。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「売僧、ちん鴨の座興にしては折檻が過ぎようぞ、眉間傷が夜鳴き致して見参じゃ。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "お慈悲深い仏様さへ手の届かなかつた売僧を一人助けた上に、自分の書が田舎の房州路でさへ旅籠銭の代りになるといふ事を知つたのだから。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ売僧、よく聞くがいい。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女性によって開拓された宗教――売僧俗僧の多くが仮面をかぶりきれなかった時において、女流に一派の始祖を出したのは、天理教といわず大本教といわず、いずれにしても異なる事であった。",
              "citation": {
                "source": "明治美人伝",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "五代将軍綱吉は、聡明の人ではあったけれど、愛子を喪った悲嘆の余りにわかに迷信深くなり、売僧の言葉を真に受けて、非常識に畜類を憐れむようになり、自身｜戌年というところから取り分け犬を大事に掛けた。",
              "citation": {
                "source": "紅白縮緬組",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "売僧をも無双の名僧智識に仕立てることができたであろう長井の門地はいま彼自身である。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そもそも彼女には禁酒論や廃妾論などゝ並んで売僧亡国論とか宗教改革論などというものがすでにあったのだから、祖母の葬儀を汚したオナラへの怒りは大きかった。",
              "citation": {
                "source": "お奈良さま",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "乞食坊主、売僧坊主、オゲ坊主、チャンチャン坊主、糞坊主、スッタラ坊主、ハッチ坊主、横着坊主、毛坊主、カッタイ坊主などこれである。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "往年｜売僧有て毘沙門経を誦して門戸に立て物を乞。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "また祇園の弦売僧の如きも、犬神人として類似の職務に服し、かねて唱門師と呼ばれていたのをもってみれば、またもって一つの散所法師であったと言わねばならぬ。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "黙れ、売僧　二人は見合ったまま黙っている。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何んと売僧驚いたか！",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まいす」とは「売僧」の意で、商売する僧侶を罵っていう言葉である。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは恐しい邪悪な売僧であったにしても、もう一度京姫の顔が見度いという外は、何の望みもない村松金之助に取っては兎にも角にも救いの神でした。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "夢幻の恋",
                "note": "青空文庫"
              }
            },
            {
              "text": "病人を聖餐のそばへ連れて行くやいなや、今まで荒れ狂ったり、じたばたもがいていたものが、不意にけろりとなおる不思議な事実も、それはただのお芝居で、ことによったら『売僧ども』の手品かもしれぬ、とのことだったけれど、これもたぶんきわめて自然に生じたことであろうと思う。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれ末世における売僧の仕業であるが、質屋の壁で風に吹かれている有様は、涅槃会ならぬ日の事と解したい。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは売僧の巧み凡ならずさ。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜘蛛太、てめえの見たことを、この売僧に話してやれ」「へい」待ち構えていたように、蜘蛛太は手下の中から怪異な顔を出した。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "われらは、熟慮しなければならない秋にぶつかっているのじゃ」「わかりきっている」「――売僧法然ひとりに対して、叡山三塔の者が、かくものものしく騒いだとあっては、大人げない。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "社会のために、戦うのでなければいかん」「もっとももっとも」「肉食はする、酒はのむ、あまつさえ弟子善信には、妻帯の媒立ちまでしたという売僧法然、口賢く、女人｜教化などと申しおるが、その実いかがやら、まさしく仏教の賊、末法の悪魔」「いかんぞするっ、その法賊を！",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おお、こやつは、元叡山におって、今では吉水の門下で実性とか呼ばれている売僧じゃ」「さては、法然にいいふくめられわれらの動静を間諜しにうせたな」「いうまでもない、隠密じゃ」「どうしてくれよう」「懲らしめのため、ぶち殺せ」この殺気の中で見つかったのであるから堪ろうはずはない。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と猫大将はその一匹を追いかけましたが、もうせまいすきまへずうっと深くもぐり込んでしまったので、いくら猫大将が手をのばしてもとどきませんでした。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おちやまいすたれるやうに思はれるのも、いやだからねえ。",
              "citation": {
                "source": "瘢痕",
                "author": "平出修",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "liar",
