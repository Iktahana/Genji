        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "部屋の曲がり目に、猫が丸まって寝ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "壁の曲がり目に、埃が溜まっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "テーブルの曲がり目に、子供がぶつかってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "鐙の雉子のもゝのまがりめ二ツ三ツに張砕けたり。",
              "citation": {
                "source": "怪力",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "稻妻形の屈折した曲り目になると、四つに偃つて手探りに道を求める。",
              "citation": {
                "source": "痍のあと",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の膝小僧の曲り目の処が、不意にキリキリと疼み出したので、私はビックリして跳ね起きた。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……その膝っ小僧の曲り目の処へ、小さなミットの形をした肉腫が、血の気を無くしたまま、シッカリと獅噛み付いている。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でもない暑中見舞のペン字の曲り目から、必死的な殺人の呪いが分析され、新しいハンカチの折目から持主の不倫行為の現場が映写し現わされ得る筈だ。",
              "citation": {
                "source": "探偵小説の真使命",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは、河の曲り目などで、水流の關係で、砂洲になつてゐた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "いづこの曲り目にてか道をあやまりしものならんと、案内の娘に尋ぬれば、娘笑ひてむつちりとして行く。",
              "citation": {
                "source": "山家ものがたり",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "此二つの上り口の間が半円形に突き出て居て、右と左の曲り目に二つの窓が一階｜毎に附けられてある。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "×三たび曲つて上る路、曲り目ごとに木立より青い入江の見える路、椿に歌ふ山の鳥花踏みちらす苔の路。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此二つの上り口の間が半圓形に突き出て居て、右と左の曲り目に二つの窓が一階毎に附けられてある。",
              "citation": {
                "source": "巴里にて",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シラチブチは舊の小貝川がＳの字形に流れた曲り目の名で、渦を卷いて澱んでゐる頃は一｜房の繩が下まで屆かぬと言はれた。",
              "citation": {
                "source": "筑波ねのほとり",
                "author": "横瀬夜雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "先へ行く二人は、道の曲り目ごとに立止つて彼女の追ひつくのを待つ。",
              "citation": {
                "source": "火の扉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "とある道路の曲り目とか、とつぜん眼に入ってくる目新しいものが、過ぎ去った日のことを思い出させ、少年時代ののびのびした楽しさを聯想させた。",
              "citation": {
                "source": "フランケンシュタイン",
                "author": "FRANKENSTEIN, OR THE MODERN PROMETHEUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし曲り目に競爭者凌ぎて驅くることを得ば、汝に誰も追ひ付かじ、況んや汝を凌がんや。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は気持がわるくなったので、うんと馬力をかけて五つ曲り目を駈け上ると、丁度六曲り目というところに、男と女が番傘一本を相合傘にして、上ってゆくのを見た。",
              "citation": {
                "source": "怪談",
                "author": "平山蘆江",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時中央山脈の斜面に沿うて堆積してゐた土砂が全體として山骨を離れ、それが斜面を流れ下る際曲り目の所に於て、雪崩れの表面が或は開いたり、或は閉ぢたりしたものゝようであるが、此開き口に人畜が陷つて見えなくなつたことが記されてある。",
              "citation": {
                "source": "地震の話",
                "author": "今村明恒",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はすらりすらりと歩きながら八百屋の角や小路の曲り目などでは、凡ての西洋人の持つところの軽快な歩行と、しかもかなりな繊細さをもってくるりと八百屋の角をまがってゆくことである。",
              "citation": {
                "source": "幻影の都市",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "村を出離れようとする路の三つ股、野を横ぎって行く路の曲り目、または坂の口や峠の頂上などにも、時々はこれとよく似た石の集合があって、そういう地点を繋いで見ると、だんだんに古い頃の交通路が、はっきりとして来るように思われる。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "たった一つの名で漠然と呼ばれていた広野でも、家が建ち小路が通れば曲り目ごとに、小さな区劃ごとに字というものが入用になる。",
              "citation": {
                "source": "和州地名談",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "手の指が岩の曲り目を捉えた。",
              "citation": {
                "source": "烏帽子岳の頂上",
                "author": "窪田空穂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
