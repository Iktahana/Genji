        "examples": {
          "standard": [
            {
              "text": "貴重な音源は、デジタル化される前にマスターテープに記録されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このアルバムのマスターテープは、何十年も大切に保管されてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "マスターテープの損傷を防ぐため、湿度管理された特別な部屋で保存されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "トム・パーカーの売りこみとうまくかさなりあい、サン・レコードでつくったマスター・テープとともに、エルヴィスの専属料は三万五〇〇〇ドルでヴィクターに買いとられ、エルヴィスはヴィクターの歌手になった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「うん」「聴いてみたい」「マスター・テープまで作るって言ってたから、春さきには聴けるな」　ぼくたちは、『アランフェス協奏曲』を最後まで聴いた。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
