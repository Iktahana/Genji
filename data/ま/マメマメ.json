          "literary": [
            {
              "text": "しかつめらしい顔をして、マメマメしく、次ぎから次ぎと忙しそうに、シンケンに、しかし、けっきょくは、遊ぶ。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛乳屋の落第生は悪いことがバレて叱られそうな気配が近づいているのを察しると、ひどくマメマメしく働きだすのである。",
              "citation": {
                "source": "風と光と二十の私と",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時もマメマメしくやりだしたので、私はおかしくて仕方がない。",
              "citation": {
                "source": "風と光と二十の私と",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
