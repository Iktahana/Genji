        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お腫だらけの迷い犬に三度三度めしをやっているうち、覚えてくる愛情に、それは似ていた。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかの子たちがみんなでからかって、石をぶつけたり、迷い犬を追って遊ぶように追い回したりした。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "迷い犬にだれも加勢する者がないのだ。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一度親方は呼び子をふいて、迷い犬を呼びたてた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ真ッ白な夜の道を、彼の影は、迷い犬のように歩いていた。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
