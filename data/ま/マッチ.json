        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかるに、「あまっちょ」「甘ったるい物の言い方」「甘い文学」などいう場合には、甘味によって明らかに反価値性が言表されている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は、お前が菜っ葉を着て、ブル達の間を全で大臣のような顔をして、恥しがりもしないで歩いていたから、附けて行ったのさ、誰にでも打っつかったら、それこさ一度で取っ捕まっちまわあな」「お前はどう思う。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "病院の義兄は養子だし、大勢の兄弟｜中に、やっと学位の取れた、かけ替えのない人を、そんなにしてしまっちゃ、それは家でもほんとうに困るのよ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「枝まで、折っちまっちゃア、駄目じゃないか！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁は狼狽てて懐中よりまっち取りだし、一摺りすれば一間のうちにわかに明くなりつ、人らしきもの見えず、しばししてまた暗し。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いやいや、とってしまっちゃいけない、ただある場所をさがして教えてさえくれればいいんだ。",
              "citation": {
                "source": "二人の役人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――このあまっちょだな。",
              "citation": {
                "source": "橋",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いやいや、とってしまっちゃいけない、たゞある場所をさがして教へてさへ呉れればいゝんだ。",
              "citation": {
                "source": "二人の役人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はてさて、」「………………」「じゃ、やっぱり、死ぬのを思い止まっちゃ下さらん。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝にすっかり棚おろしをされちまっちゃ、江戸中は構わねえが、こちら様ばかしゃ、面が出せねえ、やい。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前さん、また酒と間違えて飲んじまっちゃ不可ませんよ。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）――喧嘩にもならず、こまっちまいます。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "君にかまっちゃあいられないんだ。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえなんか、ネコにでもつかまっちまえばいいんだ！",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああなってしまっちゃ、あの人ももう駄目よ」おゆうは鶴さんに愛相がつきたように言った。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "（おっかぶせるように）じつは君にはたびたび迷惑をかけているのですまないんだが、またすっかり行きつまっちゃったもんだから……西山か星野でもいるとどうにかさせるんだが（こりゃ少しうそがすぎたかなと思ったが園がその言葉には無関心らしく見えるのですぐ追っかけて）ちょうどいないもんだから切羽つまったのさ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな訳で話も何も他愛なく纏まっちゃって、己れのこね上げた腸詰はグリゴリー・ペトニコフの皿の上に乘っかったのよ。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひっこぬいて、たもとの中へしまっちまいなよ！",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵双紙でみた名古屋｜山三そっくりなんだもの――」　この少しこまっちゃくれた下町娘は、もうよほど右門とはなじみとおぼしく、いささかもはにかみを見せないですぐと答えましたものでしたから、右門がいよいよ伝六の目を丸くするようなことを平然としていいました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "なぞの八卦見",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊、そちは泣いているな」　図星をさされてか、はッとして、慌てながら一層面をそむけましたが、途端にほろほろと大きな雫が、その丸まっちく肉の熟れ盛った膝がしらに落ち散ったので、退屈男の不審は当然のごとくに高まりました。",
              "citation": {
                "source": "旗本退屈男　第一話",
                "author": "旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう暮れが押しつまっちゃ、人づきあいをよくしておかねえと、どこでだれに借銭しなくちゃならねえともかぎらねえからね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "左刺しの匕首",
                "note": "青空文庫"
              }
            },
            {
              "text": "このなまっちろい野郎をしょっぴいていって、ひとり牢へぶち込みな」「ね……！",
              "citation": {
                "source": "右門捕物帖",
                "author": "左刺しの匕首",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なまっちろい顔をして、だいそれたことをするやつだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "村正騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "うるせえから、あごをはずして、ふところの中へでもしまっちまえッ」　しかられているまに、八ツ山下をこちらへ回って、葵の金紋打ったるおはさみ箱がまず目にはいりました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            }
          ]
        }
