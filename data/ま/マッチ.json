[
  {
    "uuid": "12b7437e-47ab-5097-8ba2-17d0d005fa2e",
    "entry": "燐寸",
    "reading": {
      "primary": "マッチ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
