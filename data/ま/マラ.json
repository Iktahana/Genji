[
  {
    "uuid": "44b6b653-515d-5e9b-8c33-11cb95501318",
    "entry": "魔羅",
    "reading": {
      "primary": "まら",
      "alternatives": [
        "マラ"
      ],
      "is_heteronym": false
    },
    "grammar": {
