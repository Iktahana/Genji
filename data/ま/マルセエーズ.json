        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "国歌はマルセエーズじゃなくて、人民戦線の歌だというのだ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そういう久慈に矢代は、「右翼のマルセエーズが革命歌じゃないか。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、またそれがすぐ国歌に変ってマルセエーズが放じられた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルセエーズの合唱が街路樹の下からつづいて起って来た。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "カフェーの一角が急に衝撃を受けて動き停ったと思うと、まだマルセエーズの合唱に揺れているそちこちの群衆の上を、ひと薙ぎその衝撃が薙ぎ通してから、次第にざわざわと揺れ出した。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
