          "literary": [
            {
              "text": "また丹後国竹野郡にも同じ名の郷があって、刊本には右側にハシウト、左側にマムトを傍訓してある。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハシウトはすなわちハシヒトの転で、マムトはすなわちマヒトの転たることは云うまでもない。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "またこれをマムトと云い、マウトまたはモート、モオト（門男）など呼ぶに至ったのが、単にその語の転訛たるは言うまでもない。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
