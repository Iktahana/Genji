          "literary": [
            {
              "text": "マァシュ・エンドは唯一軒の家であつた頃からリヴァズ家の所有だつた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども彼等はマァシュ・エンドやモオトンやこの邊りの沼地や丘が大變に好きで、倫敦にも他の方々の大きな街にも住んだことがあるのに、家庭ほどいゝ處は無いと何時も云つてゐる。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "マァシュ・グレンの彼方の丘が微かに答へ返した――「何處にゐらつしやるのです？",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
        }
