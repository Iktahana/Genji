          "literary": [
            {
              "text": "ひる終って外出する元気もなく、マリダンゲームで遊ぶ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリダンゲームで遊ぶ、皆相当上達した。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひるの部終って、マリダンで遊び、折詰を食ひ、事務所へ行って、配役。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の部をすませると部屋で一寸又マリダンして、友田等とみや古へ行った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
