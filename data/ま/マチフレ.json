        "examples": {
          "standard": [
            {
              "text": "町触れによって、新しい法令が町民に知らされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "江戸時代の町触れは、町の運営に不可欠だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "町触れの内容は、高札場に掲示された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "今夜も開場いたしますの町触れだろう。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "元禄二年五月二十一日の町触に、この踊子の屋敷方はいうに及ばず、いずれへも出入法度たるべく取締られたのは、全く私娼を営んで、風俗を紊乱したからで、して見ると落語家のいい草じゃないが、女ならでは夜のあけぬ国だけに、いつの時世にも女で苦労することが多いのかも知れぬ。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "武士｜僧侶までが植木屋と立交り集会を催し万年青の売買をなして損益を争うようになったので、これを禁ずる町触が出た。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
