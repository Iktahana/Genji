[
  {
    "uuid": "490c10fd-c84d-505a-bb28-6020f94ac639",
    "entry": "混じる",
    "reading": {
      "primary": "まじる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to be mixed",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "静かな住宅街にも、遠くから車の音が「混じり」聞こえてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "庭には、色とりどりの花が「混じり」合って植えられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "そのカフェは、地元の人々と観光客が「混じり」合って賑わっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "老女らしい御様子で咳が多くお言葉に混じるのである。",
              "citation": {
                "source": "源氏物語",
                "author": "朝顔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウッドワード氏の云うには、それが若し水と混じる様な事があると、直ぐに赤くなるのだそうだ。",
              "citation": {
                "source": "赤い手",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "沈澱素というのは人間の血をたびたび兎に注射しますと、兎の血液の中に、人間の血と混じると白い沈澱を起こすものが生じますから、その兎の血を取って、血清を分け、腐らぬようにガラス管の中へ保存したものです。",
              "citation": {
                "source": "髭の謎",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上は二者の区別なるも読者はこれをかの世俗にいわゆる個人主義および国家主義の関係と混じるなかれ、この対語は国家と個人との関係を意味するに似たり。",
              "citation": {
                "source": "近時政論考",
                "author": "陸羯南",
                "note": "青空文庫"
              }
            },
            {
              "text": "漢字は上手に書けますが、仮名には時々力の抜けた字の混じる欠点はありますね」　などとも源氏は言っていて、書かない無地の草紙もまた何帳か新しく綴じさせた。",
              "citation": {
                "source": "源氏物語",
                "author": "梅が枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖人の宮のお住居はここから船ですぐに渡って行けるような場所に位置していたから、追い風に混じる琴笛の音を聞いておいでになりながら昔のことがお心に浮かんできて、「笛を非常におもしろく吹く。",
              "citation": {
                "source": "源氏物語",
                "author": "椎が本",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢代は始めは皆から離れひとり出発するのをさみしく感じたが、落ちついて旧蹟を観るのは、やはり一人か二人の方が良いと思い、また父の骨を持った身で皆の歓びの中に混じるのは気もひけることとて、予定を変更して滞まる気にはならず、翌朝そのまま出かけることに決めた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "感情は意志や思想に力をつけるものであるゆえ、誤った思想に感情が混じると、その誤りがいっそう恐ろしくなる。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "その酸い水が混じると、魚の族は真黒になるほど群がつて川下へ川下へとくだる。",
              "citation": {
                "source": "念珠集",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときどきヤポンスキイといふ言葉が混じる。",
              "citation": {
                "source": "旅の繪",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、野州の那須の山奥から出て湊の海門橋で海水と混じる那珂川にも、今年は大そう鮎が多い。",
              "citation": {
                "source": "香魚の讃",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときどきヤポンスキイという言葉が混じる。",
              "citation": {
                "source": "旅の絵",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし数日後になり、人々の呑む水にこれらの患者の排泄物が混じるようになったときに、追加例の多くが殆ど同時に始まった。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが過飽和水蒸気が冷い空気と混じる時には、これよりも一桁小さい極微水滴が出来る。",
              "citation": {
                "source": "低温室だより",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある脂肪分子から遊離型になった脂肪酸は他の分子からのものと混じるに違いない。",
              "citation": {
                "source": "生体構成物質の動的状態",
                "author": "THE DYNAMIC STATE OF BODY CONSTITUENTS (1942)",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『その蝮の、手や唇や舌の上で別に何んともない毒が、血に混じると、ひどく恐ろしいものなんですか？",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "船出を心待ちにしている子供の群れに、初老に差しかかった大人が一人っきりで混じるのは多少気が引けた。",
              "citation": {
                "source": "湯けむり",
                "author": "澤西祐典",
                "note": "青空文庫"
              }
            },
            {
              "text": "うち、一尺三寸というボラギスも混じる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "慣れた手つきで青菜を洗う規則正しい音に混じるぼくの足音が異物のように感じられる。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "惱み亡べるもろ／＼の靈はわが身を追ひのけて、しかして我の＊河を過ぎ、共に混じるを喜ばず、かくて冥府のおほいなる門のほとりにわれ迷ふ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "90神に混じるをわれ恐る、われの心に惱あり、さはれ行くべし、おほ神の述べん言句は空ならず。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "編むことは痛み、喜び、感動であり、それに苦悩と喜びが入り混じるのは珍品創造に伴うものであり、メアリはただ喜びに満ちて、編み物を押し戴き、美しさを鑑賞するばかりであった。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "客席からの悲鳴に近い歓声や曲のリズムに合わせた手拍子が溶け混じる。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝国ホテルが近いから夕方にでもなれば華やかに装った富豪の妻や娘もそれに混じるであろう。",
              "citation": {
                "source": "蝸牛の角",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "建物も衣服も食物も、そうして用いる言葉さえも、どんなに多く外から来たものが混じるでありましょう。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の問題は、可視的または可触的な物を除去した暗黒または運動が、可視的または可触的なある物と混じるときに、真空観念を伝えることができるかどうかである。",
              "citation": {
                "source": "人間本性論（人性論）",
                "author": "A Treatise of Human Nature",
                "note": "青空文庫"
              }
            },
            {
              "text": "美代が宿入りの夜など、木枯らしの音にまじる隣室のさびしい寝息を聞きながら机の前にすわって、ランプを見つめたまま、長い息をすることもあった。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋愛に憐憫の情がまじると、その感情はいっそうひろがり高まるものらしい。",
              "citation": {
                "source": "断崖の錯覚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六年十八年や秋の露　三十日、所用ありて浅草の近所まで出で行きたれど、混雑のなかに立ちまじるも楽しからねば公園へは立寄らずして帰る。",
              "citation": {
                "source": "叔父と甥と",
                "author": "――甲字楼日記の一節――",
                "note": "青空文庫"
              }
            },
            {
              "text": "学童たちの声にまじって、菊代らしき女の声もまじる。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to associate with",
