  {
    "uuid": "0ca8aa25-feb1-5095-930b-88a7f0b645d1",
    "entry": "真拆",
    "reading": {
      "primary": "まさき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "Asiatic jasmine (Trachelospermum asiaticum)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "石垣には、まさきの蔓がびっしりと絡みついていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "まさきの花は小さくても、甘い香りをあたりに漂わせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "まさきをグランドカバーとして利用すると、美しい緑の絨毯ができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ばくてりやの手は左右十文字に生え、手のつまさきが根のやうにわかれ、そこからするどい爪が生え、毛細血管の類はべたいちめんにひろがつてゐる。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ころげそうになる娘を支えて、アメリカ兵は靴のつまさきに注意を集中して丘を下った。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまさきで立ち上らずに、カーテンの隙間から部屋の中が見えた。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪の長いさっきの男は、じっと、彼のつまさきから、頭の髪まで丹念に、ちびる程執拗に睨めながら、もう一度、タフト先生に、どんな用事かときゝ直した。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五人の、犬にしゃぶられた遺骸を見ようとつまさきで立ちあがっている。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ショールに眼から下をすっかり包んで、ややともすると足をさらおうとする雪の坂道を、つまさきに力を入れながらおせいはせっせと登っていった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おなじ廓へ、第一歩、三人のつまさきが六つ入交った時である。",
              "citation": {
                "source": "古狢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまさき投げ出して行った金も、大晦日の身を切るような金ではなかったかと、坂田の黒い後姿が眼に浮びあがって、なにか熱かった。",
              "citation": {
                "source": "雪の夜",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その眼付きを見ると、嫉妬深い男だと言った女の言葉が、改めて思いだされて、いまさきまで女と向い合っていたということが急に強く頭に来た。",
              "citation": {
                "source": "秋深き",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘さんは、あいもかわらず、つまさきでまっすぐ立って両腕を高く高くあげていました。",
              "citation": {
                "source": "すずの兵隊さん",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たちは、つまさきで立ちあがって、ばんざい、とさけんだり、指を口にあてて、口笛をふいたりしました。",
              "citation": {
                "source": "空とぶトランク",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "あくる日になると、ゲルダは頭のさきから、つまさきまで、絹とビロードの着物につつんでもらいました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの橋の手前の河岸縁の家にまさきか何かむくむくと繁つた常緑の樹があつて、それに夏からの風鈴が雨に濡れたままに弔されて居た事を記憶してゐる。",
              "citation": {
                "source": "京阪聞見録",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "挑み掛るようにじっとこちらを睨んでいる二つの眼、――いまさき煙草の銀紙をまるめて投げた男だ。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿部定――東京尾久町の待合「まさき」で情夫の石田吉蔵を殺害して、その肉体の一部を斬り取って逃亡したという稀代の妖婦の情痴事件が世をさわがせたのは、たしか昭和十一年五月であったが、丁度その頃私はカフェ美人座の照井静子という女に、二十四歳の年少多感の胸を焦がしていた。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の仲はすぐ細君に知れて、彼女は暇を取り、尾久町の待合「まさき」で石田に会った。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "むすめは片足のつまさきでまっすぐに立って、両手をまえにひろげていました。",
              "citation": {
                "source": "しっかり者のすずの兵隊",
                "author": "DEN STANDHAFTIGE TINSOLDAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い小父さんは、つまさきで立つて、空にむかつて棒のやうな体にしたり、からだをくる／＼と石ころのやうに小さくしてしまつたり、沼岸の柳の枝にからだを巻つけたり、それはさまざまな舞踊やら曲芸やらをやりました。",
              "citation": {
                "source": "小熊秀雄全集-14",
                "author": "童話集",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩きながら考えると、いまさき庭のうちで、野々宮と美禰子が話していた談柄が近因である。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "女達二人は極く注意した歩き振りでどんな時でも少し体をうかす様につまさきで歩く。",
              "citation": {
                "source": "胚胎（二幕四場）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やゝ寒い、足のつまさきが冷たい、裏藪で鶲が啼く。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、よくよく軽部も腹が立ったと見えてあるとき軽部の使っていた穴ほぎ用のペルスを私が使おうとすると急に見えなくなったので君がいまさきまで使っていたではないかというと、使っていたってなくなるものはなくなるのだ、なければ見附かるまで自分で捜せば良いではないかと軽部はいう。",
              "citation": {
                "source": "機械",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "白皮に此も雪白のうさぎの毛を飾って、つまさきは、美くしいビーズで一寸した模様を置いてある。",
              "citation": {
                "source": "無題（一）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "犯人は塀外よりよじて庭に下り兇行後、再びもとの道から出て行つたらしく塀の外側に、素足のつまさきについていたらしい土が附着していた。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "直ぐ傍には外山と云う山があるのであるが、この山への道にはまさきかずらが、一面に生い茂っていて、全くその道を埋めてしまって登るのには少し困難を感ずる様である。",
              "citation": {
                "source": "現代語訳　方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
