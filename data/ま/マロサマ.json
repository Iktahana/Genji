        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いつでもマロサマは、おしめにのこされるのだずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "マロサマ、たかまどのお寺の坊主こで、からだつきこ細くてかそぺないはでし、みんなみんな、やしめていたのだずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきほどよりし、マロサマ、着物ばはだけて、歌っていたずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかの雀このタキ、野火の黄色え黄色え焔ごしに、悪だまなくこでマロサマば睨めたずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "マロサマ、おっとらとした声こで、また歌ったずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "マロサマは、タキのぱおぱおて飛んで来るのば、とっけらとして待づていたずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "マロサマ、首こかしげて、分別したずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "マロサマは、また首こかしげて分別したのだずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "――マロサマの愛ごこや。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてし、雪だまにぎて、マロサマさぶつけたずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪だま、マロサマの右りの肩さ当り、ぱららて白く砕けたずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "マロサマ、どってんして、泣くのばやめてし、雪こ溶けかけた黄はだの色のふろ野ば、どんどん逃げていったとせえ。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
