        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それで私は、「ソマーセットや木曜島の物資は、みな土人が刳舟でポートモレスビーへ運んでいるのです。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも彼の特別に好んだのは科学の書物で、なかでもその頃一般に読まれたマーセット夫人の『物化学の話』や、百科全書のなかの電気に関する部分が非常におもしろかったと、後に彼自身が述べています。",
              "citation": {
                "source": "マイケル・ファラデイ",
                "author": "石原純",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェリントンはなおその上、ソマーセットの近衛竜騎兵千四百騎をあるくぼ地に有していた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンソンビーは粉砕されたが、ソマーセットは残っていたのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "前には方陣があり、後ろにはソマーセットがあった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソマーセットは千四百の近衛竜騎兵を率いていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
