[
  {
    "uuid": "6730a460-a207-56fc-9698-ee9fba01ec1d",
    "entry": "禍々しい",
    "reading": {
      "primary": "まがまがしい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
