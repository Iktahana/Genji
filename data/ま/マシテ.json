        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日本語もろくに話せないのに、況して英語なんて理解できるわけがない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "自室の掃除すらしない彼が、況して庭の手入れなどするはずがない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "小銭さえ持っていないのに、況してそんな高価な時計を買えるわけがない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      }
