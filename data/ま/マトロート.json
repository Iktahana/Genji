        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マトロート（魚料理）にジブロット（肉料理）という名だけで知られてるふたりの女中が、ユシュルー上さんを助けて、青葡萄酒の壜や、瀬戸の皿に入れて空腹な客に出す種々な薄ソップなどを、テーブルの上に並べた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "マトロートは肥った、丸々した、顔の赤い騒々しい女で、故ユシュルーの気に入りだったが、神話に出て来るどんな怪物よりも更に醜いかと思われるほどだった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "マトロートとジブロットが彼らを迎えた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は鹿爪らしく左の拳を膝につき、腕を直角にまげ、首飾りを解き、腰掛けにどっかとまたがり、なみなみとついだ杯を右手に持ち、そして肥った女中のマトロートにこういう荘厳な言葉を浴びせかけた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "マトロートとジブロットも、人々の間に交じって働いた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "マトロートが二階に上がってくると、彼女の腰をとらえて、盛んな笑い声を窓から外に送った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マトロートは醜い。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マトロートは醜悪の夢だ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "マトロートは一つの幻だ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は愛の神に願ってそれに生命を与えてもらい、かくてマトロートができたのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "マトロート、僕を抱け。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "球突場の広間では、ユシュルー上さんとマトロートとジブロットとが、恐怖のため三様の変化を受けて、ひとりは惘然としひとりは息をはずましひとりはほんとに目をさまし、古布巾を引き裂いて綿撒糸をこしらえていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
