    "definitions": [
      {
        "index": 1,
        "gloss": "round face",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は優しそうな丸顔のおかげで、初対面の人からもすぐに好かれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "丸顔をすっきり見せるために、Ｖネックのトップスを選ぶようにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "鏡を見ると、正月太りのせいで以前よりもさらに丸顔になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "一度、基督教の伝導婦を妻君に持つ、丸顔の、袴など高く穿くが何だか自堕落な感じの、植物課の教師が訪ねて行つた時、校長は、妻が酷いヒステリーなので、随分私も学校で嫌な顔をしてゐる日があるに違ひないがと話した。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "基体としての顔面、すなわち顔面の構造の上からは、一般的にいえば丸顔よりも細おもての方が「いき」に適合している。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "「当世顔は少し丸く」と西鶴が言った元禄の理想の豊麗な丸顔に対して、文化文政が細面の瀟洒を善しとしたことは、それを証している。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "生白い丸顔の、目のぎょろりとした様子までが、ただの子供でないと私はすぐ見て取りました。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで相手の顔は見ないで、月を仰だ目元は其丸顔に適好しく、品の好い愛嬌のある小躯の女である。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "麻服の上着なしで、五分刈り頭にひげのない丸顔にはおよそ屈託や気取りの影といったものがない。",
              "citation": {
                "source": "破片",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "目鼻立の愛くるしい、罪の無い丸顔、五分刈に向顱巻、三尺帯を前で結んで、南の字を大く染抜いた半被を着て居る、これは此処の大家の仕着で、挽いてる樟もその持分。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔のとおりの丸顔に昔のとおりのめがねをかけている。",
              "citation": {
                "source": "三斜晶系",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どちらかと言えば丸顔の色のくっきり白い、肩つきの按排は西洋婦人のように肉附が佳くってしかもなだらかで、眼は少し眠むいような風の、パチリとはしないが物思に沈んでるという気味があるこの眼に愛嬌を含めて凝然と睇視られるなら大概の鉄腸漢も軟化しますなア。",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "がらす砕け失せし鏡の、額縁めきたるを拾いて、これを焼くは惜しき心地すという児の丸顔、色黒けれど愛らし。",
              "citation": {
                "source": "たき火",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その丸太は燃えじと丸顔の子いう。",
              "citation": {
                "source": "たき火",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の口から言うも変ですが、里子は美人というほどでなくとも随分人目を引く程の容色で、丸顔の愛嬌のある女です。",
              "citation": {
                "source": "運命論者",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "売卜者の顔はよく憶えております、丸顔の眼の深く落ちこんだ小さな老人で、顔つきは薄気味悪うございましたが母と話をするその言葉つきは大変に優しくって丁寧で、『アアさようかな、それは心配なことで、ごもっともごもっとも、よく私が卜て進ぜます』という調子でございました。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "左の眼の下にはその隈の中に、更に色の濃い大きなほくろが一つ指先きで押した様に付いて居るので、一層陰惨に険悪に見えたけれども、むっくりと延びた形の宜い鼻が、丸顔の筋肉や皮膚の皺を程よく調節して、小さく結んだ唇にはまだ若い女の様な、艶を持って居た。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "繻子の帯もきりりとして、胸をしっかと下〆に女｜扇子を差し、余所行の装、顔も丸顔で派手だけれども、気が済まぬか悄然しているのであった。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "浅草に餓鬼大将をやってお在の時とは違って、品もよくおなりだし、丸顔も長くなってさ、争われない、どう見ても若殿様だ。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "切禿で、白い袖を着た、色白の、丸顔の、あれは、いくつぐらいだろう、這うのだから二つ三つと思う弱々しい女の子で、かさかさと衣ものの膝ずれがする。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　奥から続いて出て来たのは、お清という酌婦、色白の丸顔で、お葉よりも二三歳若く見えた。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "目のくりくりした丸顔で、玉も撞くし映画も見るが、浪曲は何よりも好きで、機嫌のいい時は楽燕張りの節廻しで、独りで南部坂を唸ったりしていた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸顔の健康そうな頬をした少女であった。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "貞子は丸顔で、そうしてただ騒ぎ廻っている。",
              "citation": {
                "source": "律子と貞子",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯カスリの袷にキチンと袴を穿いて、少しよごれた一高の制帽の白線が色の黒い兄の丸顔と可愛らしく対照して居ました。",
              "citation": {
                "source": "処女時代の追憶",
                "author": "断片三種",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁は、頭なりに黄帽子を仰向け、髯のない円顔の、鼻の皺深く、すぐにむぐむぐと、日向に白い唇を動かして、「このの、私がいま来た、この縦筋を真直ぐに、ずいずいと行かっしゃると、松原について畑を横に曲る処があるでの。",
              "citation": {
                "source": "小春の狐",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "またなんという画家の手に成ったものか、角のないその字体と感じのまるで似た、子供といえば円顔の優等生のような顔をしているといったふうの、挿画のこと。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "円顔のむつちりとした可愛らしい子で、額付が今の菊五郎に似て居たので、おとはやおとはやと呼んで居た。",
              "citation": {
                "source": "二黒の巳",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "一小間硝子を張って、小形の仏龕、塔のうつし、その祖師の像などを並べた下に、年紀はまだ若そうだが、額のぬけ上った、そして円顔で、眉の濃い、目の柔和な男が、道の向うさがりに大きな塵塚に対しつつ、口をへの字｜形に結んで泰然として、胡坐で細工盤に向っていた。",
              "citation": {
                "source": "夫人利生記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "はてな、盗られる物はなし、戸締りはして置かないから、店から用があって来たのかしらと、ひょいと見ると、どう仕り……床屋の妹というのはちょいと娘柄は佳うございましたけれど、左の頬辺に痣があって第一円顔なんで。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな、笑うと目元に小皺の寄る、豊頬した如何にも愛嬌のある円顔で、形も大柄だったが、何処か円味が有り、心も其通り角が無かった。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "美髪のどちらかといえば円顔の眉の凛々しくつまって、聡明な眼の、如何にも切れそうな態度でいい。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛嬌のある円顔の髭をちょっとひねって、仰向いて目を細めた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
