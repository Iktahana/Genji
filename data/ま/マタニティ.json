        "examples": {
          "standard": [
            {
              "text": "友人の結婚式に着ていくための、上品なレースのマタニティを新調した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "お腹が大きくなってきたので、普段着としてゆったりしたマタニティを何着か買った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
