        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかし、その葬儀に列なったものは、宮廷合唱長のアントニオ・サリエリー、友人ジュスマイエルほか四人に過ぎなかったが、柩が墓地門に着いた頃は、それ等の人も一人去り二人去りして、残ったのは、僅かに柩車を駆る馭者一人のみ。",
              "citation": {
                "source": "「黒死館殺人事件」著者之序",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スピリチズムの研究をもって有名であったマイエルはたしかにこう信じていたらしい。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのマイエルに自己の著述を捧げたロッジも同じ考えのように思われる。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエル「えゝ騒がしい、綿をもつて来て呉れ、野郎共僕の鼓膜を破りやがる。",
              "citation": {
                "source": "喜劇考",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの時酒場のジーベルやアルトマイエルは、メフイストの科白に憤慨をして決闘を申し込んだが、俺にはそんな生気が皆無で、後悔と憂鬱ばかりなんだから悲惨だ。",
              "citation": {
                "source": "ひとりごと",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがこのフィンセン灯なるものは装置が少し大袈裟でありますから、後にクローマイエルという人は、もっと簡単に紫外線を発生する装置を考えたのであります。",
              "citation": {
                "source": "紫外線",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "小生の名はアンドレアス、タアマイエルと申候。",
              "citation": {
                "source": "アンドレアス・タアマイエルが遺書",
                "author": "ANDREAS THAMEYERS LETZTER BRIEF",
                "note": "青空文庫"
              }
            },
            {
              "text": "小生の生存し居る限は、如何に学術的に此事実を証明せむとするも、世人は嘲罵の声を断たざる可く、仮令面前にては小生の言葉に首肯すとも、背後に於いては矢張り嘲笑し、遂にはタアマイエル発狂せりとまで申すに至ることと存じ候。",
              "citation": {
                "source": "アンドレアス・タアマイエルが遺書",
                "author": "ANDREAS THAMEYERS LETZTER BRIEF",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に彼が、千七百二十一年六月二十二日、ムウニッヒの市に現れた事は、ホオルマイエルのタッシェン・ブウフの中に書いてある。",
              "citation": {
                "source": "さまよえる猶太人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエル　　　　　　　　　　　　　　　溜らない。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエルアア。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエル太っ腹の禿頭奴。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエルそうかも知れないなあ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエル君達は大ぶ口が奢っていると見えますね。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　　　　アルトマイエル（小声にて。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエル何か一つ歌い給え。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエル自由万歳だ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "2255　　　　アルトマイエル（小声にて。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエルそれ、あそこの背後に亭主が道具箱を置いている。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエル（フロッシュに。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエルははあ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエルねえ、君達、僕の方を真っ直に見て返事をし給え。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエルなんでも宜しい。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエル僕はこっそりあいつ等を追っ払ってしまおうと思うのだが。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "2310　　　　アルトマイエル（残りたる一つの栓を抜けば、火※面を撲つ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　　　　アルトマイエルここはどこだ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエル　　　　　　これはどうだ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエルなんだかこうぴりっと来て、節々に響いたようだ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトマイエルあいつが酒樽に騎って、この店の戸を出て行くのを僕はこの目で見たよ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "2335　　　　アルトマイエルどうだい。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
