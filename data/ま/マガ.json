  {
    "uuid": "e7835cd9-773c-5631-a9f6-b264a9a6cf6c",
    "entry": "マガ",
    "reading": {
      "primary": "まが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして、寢臺の側の臺の上や、窓敷居にパンジイや、フリイジヤや、釣鐘草や、撫子や、マガレツトの花などの順順に變つて行くのを、やつと首だけ動かしながら見て樂しんだ。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が学校で古いフィロソフィカル・マガジンを見ていたらレヴェレンド・ハウトンという人の「首つりの力学」を論じた珍しい論文が見つかったので先生に報告したら、それはおもしろいから見せろというので学校から借りて来て用立てた。",
              "citation": {
                "source": "夏目漱石先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "創刊以来、世話になってきた『ザ・コンピュータ』とコラムを載せてもらった『パソコン・マガジン』も同時に廃刊になった。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九九〇年一月号から一九九二年三月号にかけて、同社の『パソコン・マガジン』に「インサイドウォッチャー」と題して連載していたコラムを、まとめたものだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "本書はソフトバンク刊の『パソコン・マガジン』に「インサイドウォッチャー」と題して連載した時評コラムを、まとめ直したものだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "『パソコン・マガジン』第一回日米共同セミナーのパネル・ディスカッションの末席に加わることを、発病以前のオレは約束してしまっていたのである。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さすが決戦だ、未来だ、新潮流だとあれやこれや思い付くかぎりのネタで大騒ぎしてきた高血圧マガジン！",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "本来なら引き続いて、両親の離婚騒動に胸を痛める全世界のまるちゃんへのメッセージなども書きたいところだが、今回ベスト１を書かずに終われば『パソコン・マガジン』にオレの席はない。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊とこう書いた直後、世話になっていた『パソコン・マガジン』の編集部と大喧嘩して（一方的にオレが怒り狂っていただけだという噂もあったが）、読者への挨拶もなく本書のもとになった連載を打ち切った。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "創刊以来、世話になってきた『Ｔｈｅ　ＣＯＭＰＵＴＥＲ』とコラムを載せてもらった『パソコン・マガジン』も同時に休刊になった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "『パソコン・マガジン』への連載中は、同誌編集部の宮島淑子さんの励ましと助力を得た。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校に通う途中、妾は常に蛮貊小僧らのために「マガイ」が通る「マガイ」が通ると罵られき。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この評言の適切なる、今こそ思い当りたれ、当時｜妾は実に「マガイ」なりしなり。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マガイ」とは馬爪を鼈甲に似たらしめたるにて、現今の護謨を象牙に擬せると同じく似て非なるものなれば、これを以て妾を呼びしことの如何ばかり名言なりしかを知るべし。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "近所の小供らのこれを観て異様の感を抱き、さてこそ男子とも女子ともつかぬ、いわゆる「マガイ」が通るよとは罵りしなるべし。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカオヒマガアッタラ御教示ヲ願イマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二学期までは、この寮で漫画雑誌を見かけることはなかったが、最近はあちこちの部屋に、「サンデー」や「マガジン」が転がっている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ　ツボミタチハ　ウマガ　ドンナ　モノデ　アルカモ　シツテ　ヰマセン。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ア、カアチヤン、ハツパノ　サキニ　タマガ　ヒカツテル」「ソレハ　アサツユツテ　モノ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "山雀の歌私はよく囀るヤマガラである、私は自由を愛するヤマガラである、私の野のヤマガラであつて、自然の秩序を愛す、天空に突入する一本の樹、私はそのするどい尖端にとまつて鳴く、私はするどい叫びにふさはしい世界を求めて新しい野と、新しい林へゆく、なんといふ私の小鳥と周囲の調和の美しさよ。",
              "citation": {
                "source": "小熊秀雄全集",
                "author": "―３―",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由よ、お前の正体は何か自由と言ひ、自由の束縛と言ひ町のヤマガラよ、お前はその正体を知つてゐるか、お前はそれを具体的に語ることができるか、をそらく、それはお前には出来ないだらう、ただ自由に囀り、自由に飛び廻るものが、これらのすべてを知り、これらのすべてを語るだらう。",
              "citation": {
                "source": "小熊秀雄全集",
                "author": "―３―",
                "note": "青空文庫"
              }
            },
            {
              "text": "町のヤマガラ、お前の芸当よ、お前は人間の手に捕へられた、そして怖るべき訓練が与へられた、鳥籠の蓋をひらくとお前はチュンチュンと鳴きながらここを飛びだして小さな神殿の扉を嘴であける、中からオミクジを咬へてこれを人間の掌の上に渡しそしてお前は又もとの鳥籠の中へ帰つてしまふ。",
              "citation": {
                "source": "小熊秀雄全集",
                "author": "―３―",
                "note": "青空文庫"
              }
            },
            {
              "text": "『コチラノオクサマガ、サクバンオナクナリニ、ナリマシタカラ、オシラセシマス』彼は、こうした文句から激動を受けながら、差出人の名を探ったが、夫は何処にも書いてなかった。",
              "citation": {
                "source": "大島が出来る話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……イヤラッサナア……マアホンニ……タマガッタガ……トッケムナカア……ゾウタンノゴト……イヒヒヒヒヒ……」　……そのあとから追いかけるように、私の腹の中でグーグーと胃袋が、よろこびまわる音……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこに鯖がいるんだ」　とキョロキョロする者もいれば、眼の前の山々に猥雑な名前を附けながら活弁マガイの潰れ声で説明するヒョーキン者もいる。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「新古御時計」と書いた看板の蔭に、怪しげな色の金銀細工、マガイ金剛石、猫目石、ルビー、サファイヤの類が、塵に蔽われたまま並んで光っている。",
              "citation": {
                "source": "塵",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
