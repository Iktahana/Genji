[
  {
    "uuid": "526fb028-4691-57c2-b0f1-8d22c0db2e9a",
    "entry": "禍",
    "reading": {
      "primary": "まが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "wickedness",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古の言い伝えでは、日食は禍の訪れを知らせる不吉な兆候とされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼の心に巣食う禍が、今回の悲劇的な事件を引き起こしたのかもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "村人たちは、災いと禍を払うために、古くから伝わる儀式を執り行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "――ヴ※ルレエヌも随分いまいふ言葉に禍ひされてるといはれる所もあることを私は思ふ。",
              "citation": {
                "source": "小詩論",
                "author": "小林秀雄に",
                "note": "青空文庫"
              }
            },
            {
              "text": "それといふのが我が国では、とかく散文よりも詩を容易だと思ふ世間常識が禍ひしてゐるとも云へるであらう。",
              "citation": {
                "source": "よもやまの話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "さはいへ、禍を隣人に及ぼすといふにもあらず。",
              "citation": {
                "source": "花あやめ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとこの龍宮のお土産も、あの人間のもろもろの禍の種の充滿したパンドラの箱の如く、乙姫の深刻な復讐、或ひは懲罰の意を祕めた贈り物であつたのか。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い沫が、その上を回転して、両崖の森林を振りかえりながら、何か、禍の身に迫るのを、一刻も早く遁げたいというように、後から後から、押し合って、飛んで行く。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上は自分が今日までに感じた随筆難のありのままの記録で、云わば甚だ他愛のない「筆禍事件」の報告と愚痴のいたずら書に過ぎないが、こんなことまで書くようになるのもやはり随筆難の一つであるかもしれないのである。",
              "citation": {
                "source": "随筆難",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "目前の災禍に驚いて急いで研究機関を設置しただけでは遂げられると保証の出来ない仕事である。",
              "citation": {
                "source": "颱風雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "応仁の乱は細川勝元、山名宗全の両頭目の死によって一時、中央では小康を得たようなものの、戦禍はかえって四方へ撒き散された形となって、今度は地方地方で小競合いが始まりました。",
              "citation": {
                "source": "鯉魚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "教春の一人娘｜早百合姫は三年前、京都の戦禍がやや鎮まっていたとき、京都｜滞陣の父の館に呼び寄せられ、まだ十四｜歳の少女であったが、以来日々、茶の湯、学問、舞、鼓など師匠を取って勉強していました。",
              "citation": {
                "source": "鯉魚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "禍ひの神といふ者もしあらば、正しく我身さそはれしなり、此時の心何を思ひけん、善とも知らず悪しとも知らず、唯懐かしの念に迫まられて身は前後無差別に、免がれ出しなり薄井の家を。",
              "citation": {
                "source": "雪の日",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがほとんどいつでも禍の源になるのである。",
              "citation": {
                "source": "アインシュタインの教育観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この日の薄暮ごろに奈々子の身には不測の禍があった。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "――しあわせなことに汽車がブルガリア領に入れば商人は伊太利人の武士気質に禍いされなくて思うままに我意を通すことができるのです。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンナイ河に翩々と帆かけた米穀輸出船は彼の指揮によって饑饉と、戦禍の彼の本国に積出された。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それによって彼らは海の恩恵を受けつつ海の禍を避けることを学んでいるであろう。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴨長明の方丈記を引用するまでもなく地震や風水の災禍の頻繁でしかも全く予測し難い国土に住むものにとっては天然の無常は遠い遠い祖先からの遺伝的記憶となって五臓六腑にしみ渡っているからである。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "四面に海をめぐらす大八州国に数千年住み着いた民族の遠い祖先からの数限りもない海の幸いと海の禍いとの記憶でいろどられた無始無終の絵巻物である。",
              "citation": {
                "source": "俳句の精神",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれか一方の勢力がまされば禍である。",
              "citation": {
                "source": "神田を散歩して",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな化け猫を生かして置くと、どんな禍いをするか知れない」　家主の発議で、猫は幾つかの空き俵に詰め込まれ、これに大きい石を縛りつけて芝浦の海へ沈められることになった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "御亭主を持つてゐられると、今に御命にもかゝはるやうな禍が來る。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は兎もあれ、せめて娘だけでも災難を逃れる工夫はございますまいかと押返して伺ひますと、和尚様は『お氣の毒であるが、母子は一體、あなたが禍を避ける工夫をしない限りは、お嬢様も所詮逃れることはできない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな禍が降りかゝつて來やうとも自分だけは前世の約束とも諦めよう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし可愛い娘にまでまきぞへの禍を着せると云ふことは、母の身として考へることさへも怖ろしかつた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "呪はれた母と娘とは何方が先に禍を受けるのであらうか。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして、これが彼の恐ろしい禍の來る前觸れではないかとも恐れられた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔館は台地のはななれば〕宮沢賢治館は台地のはななれば鳥は岬の火とも見つ香魚釣る人は藪と瀬を低くすかしてわきまへぬ鳥をまがへる赤き蛾は鱗粉きらとうちながし緑の蝦を僭しつゝ浮塵子あかりをめぐりけり",
              "citation": {
                "source": "〔館は台地のはななれば〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅長宮沢賢治ことことと行く汽車のはて温石いしの萱山の上にひとつの松ありてあるいは雷にうたれしや三角標にまがへりと大上段に真鍮の棒をかざしてさまよへりごみのごとくにあきつとぶ高圧線のま下にて秋をさびしき白服の酒くせあしき土木技手いましも汽車を避け了へてこなたへ来るといまははた急ぎガラスを入りにけり",
              "citation": {
                "source": "駅長",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまが、だいじのところである。",
              "citation": {
                "source": "九月十月十一月",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "四方八方に、幾久しゅう、幾久しゅうとばかり言うのも、まがぬけているような気がして、こんどは、「末永くお願い申します。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そりゃもう、皆さまが、もったいないほど、――」口ごもった。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
