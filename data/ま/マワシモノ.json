          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「お前、敵の回し者ではないだろうな」と剣客が怪しげに睨んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はライバル企業の回し者として、極秘プロジェクトに潜入していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "会議の内容が外部に漏れているのは、内部に回し者がいるからに違いない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "仮面の男――ははあ、君らは警察の回し者だな。",
              "citation": {
                "source": "探偵戯曲　仮面の男",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "べつに、なにもあっしゃ江戸屋の親類でも回し者でもねえんですが、あかの他人だっても同じ江戸っ子なら、贅六ふぜいにおひざもとっ子が、ほんとうにやったかどうかわかりもしねえことをかれこれいわれて、いいようにひねられていると聞いちゃ黙っていられねえんです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっき、そこのそでがきの陰で聞いていたら、おめえは江戸屋江戸五郎の回し者でもねえ、親類でもねえとりっぱな口をきいたようだが、その三味線糸のあんべえじゃ、おそらく江戸五郎一座の浄瑠璃語りか、下座でも勤めている芸人だろう。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は清水の回し者かしらと思ったわ。",
              "citation": {
                "source": "ニッケルの文鎮",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一方からは部落民のヒイキをしすぎると言われたのと正反対に、いわゆる部落の側の人からは、「喜田は御用学者だ、その筋の回し者だ」などと呼ばれたこともありまして、なるほど世人が疑い深いと批評するのも、まんざら無理のないことだと、感ぜざるをえない場合もないではありませんでした。",
              "citation": {
                "source": "融和促進",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "要はあの男が回し者で山師だからです。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "回し者かぐるの奴さんに、一杯くわせられたのかも知れねえ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あいつは回し者だ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし裁判で、ルッベがナチスのまわしものとしての正体が明かにされドイツ共産党幹部トルグラーやデミトロフは無罪となった。",
              "citation": {
                "source": "「推理小説」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハア、きさま、羽柴家のまわしものだな。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな七つかそこいらの、小さな女の子が、悪人のまわしものだなんて、どうしても考えられないことです。",
              "citation": {
                "source": "怪奇四十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつが、敵のまわしものだったかもしれない。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生、こいつは、敵のまわしものですぜ。",
              "citation": {
                "source": "魔法人形",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは軍鶏屋の廻し者じゃあねえ、そこら中の鶏を取って歩くものか。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鬼娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は中央新聞の廻し者とちがうやろ？",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "御領主様の廻し者に違えねえんだ。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは無事に通って反物を貰ったなぞと云い触らすのは、興行師の方の廻し者が多かったようです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "幽霊の観世物",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつらは狐の廻し者だ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "小女郎狐",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの髯だらけのルンペンみたいな紳士が、きっと反対党の廻し者か何かだったに違いない。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "実はあの上海亭の二階で貴方のお話を聞いているうちによっぽど飛出してお礼を申上げようかと思ったんですが、万一貴方が、親爺の廻し者だったら大変と思って……プッ……」　小伯爵は慌てて口に手を当てた。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はい、若い、御大身らしい方で、御座りますが」「客間へ通しておけ」　大作は、そういって（奉行所からの廻し者であろう）　と、思った。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "無器用な手つきといい人を見るときの鋭い眼つきといい職人らしくはしているがこれは職人ではなくてもしかしたら製作所の秘密を盗みに来た廻し者ではないかと思ったのだ。",
              "citation": {
                "source": "機械",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵の廻し者と信じたのも、決して無理とは云われない。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前は空魔艦の廻し者だ。",
              "citation": {
                "source": "大空魔艦",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "大佐は自分のことを空魔艦の廻し者だと思って、気をゆるさないのだ。",
              "citation": {
                "source": "大空魔艦",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いえあいつは廻し者よ！",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の悪党の広告主、ええ、そいつの廻し者よ！",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "田沼あたりの廻し者、……ではあるまいかとも存ぜられます、とな。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふゝん、やっぱりきゃつは廻し者だ。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの男は、確かにクイリナアレの廻し者です！",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
