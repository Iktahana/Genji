        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ノ理性ハ制御ヲ命ジタトシテモ、彼女ノ飽クナキ肉体ハ理性ノ言ニ耳ヲ貸サズ、僕ヲ破滅ニ追イ込ムマデモ満足ヲ求メテ已マナイデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカシナヲ自分ノ日記ニ書イテイルカドウカ知ラナイガ、書イテイタトシテモ僕ガソレヲ読マナイデ（アルイハ読マナイフリヲシテ）イルヲ認メサセルタメニ敏子ヲ使ッタ？",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
