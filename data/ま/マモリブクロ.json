  {
    "uuid": "ad8e3c83-db41-5bf5-910b-b3970369d48e",
    "entry": "守袋",
    "reading": {
      "primary": "まもりぶくろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
