      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "四季の花はもとよりで、人形の着もの、守袋、巾着もありましょう、そんなものを一条の房につないで、柱、天井から掛けるので。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "安寿はすぐに起き直って、肌の守袋を取り出した。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "お作はいきなり起って地炉の傍へ往くとともに、懐の守袋の中に入れてある木札を執ろうとしたが手が顫えて執れないので、その紐を引きちぎって袋ごと火の中へ投げ入れた。",
              "citation": {
                "source": "妖怪記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "七瀬と、綱手とは、お守袋を、床の間へ置いて、掌を合せて、夫と子供の無事と、自分ら二人の道中の無事を、祈っていた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしのお守袋の中に、あの手箱と同じ梅に鶯の模様のメリンスのきれで作った小さい袋が入っているのを思いだしたのよ」「それ、ほんとう。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃ、見せてごらんなさい」「あ、そのお守袋は、ここにはないのよ」「じゃ、しょうがないじゃないの。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんとか持ち直すようにと、あのお守袋を胸にかけてあげたのよ。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "はたして、そのお守袋の中にあるものは、あの小箱と同じきれであるか。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはりスミ枝の手を借りて、お守袋を開き、中からうすよごれた小袋をとりだした。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分このお守袋は、彼女がミマツ団員の誰かに拾いあげられた当時、気のきいた女団員が、後日のために、ひそかに二重のお守袋をつくって、房枝の膚につけ、きせておいたものらしい。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞けば澄江は小太刀を使うとのこと、足手まといなどにはならぬであろう」　さらに奥方よりは澄江に対して、守袋と金一封をさえ、使者を以て下された。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日頃信じて読誦し奉る、観音経を入れた守袋に、矢の立った痕があらわれていた。",
              "citation": {
                "source": "赤坂城の謀略",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御武運ひらきますでござります」　云い云い正成は守袋を取り出し、敵に射かけられた矢が身にあたらず、これにあたったことをお物語りした。",
              "citation": {
                "source": "赤坂城の謀略",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "内房の女達は、やがて黙って、折々不安の吐息を洩し、眼頭に涙をためながら守袋を縫ったり、鞍布の刺繍にとりかかり始めた。",
              "citation": {
                "source": "古き小画",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "父が見に行きました時、下むきになっていましたが、丁字髷は乱れて、小肥りの肩から、守袋の銀ぐさりをかけていたということで御座います。",
              "citation": {
                "source": "人魂火",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "元より隣座敷で覗いて居りましたから包の中から出た物をよく視ると、親の形見に貰った萠黄金襴の守袋、それが出たから何うしてこれが貴方の手に有ると云われ、よもやそれ程の金入とも存じませんから好加減に胡麻化し掛けたを問詰められ、流石の悪人も顔色が変って返答に差詰りました。",
              "citation": {
                "source": "松の操美人の生埋",
                "author": "侠骨今に馨く賊胆猶お腥し",
                "note": "青空文庫"
              }
            },
            {
              "text": "南洲翁の墓の裏の参考館では、わたくしたちは会津戦争に於いて戦死した一薩摩隼人の守袋を見た。",
              "citation": {
                "source": "八月の霧島",
                "author": "吉田絃二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大抵は折襟のシャツに腹掛をしているが、中にはこの寒空に素っ裸で守袋一つひっ背負ったのもいる。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さいころ、鈴のついたお守袋を落した時のことを思ひだす。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを本丸へ差しだすときは、老中の用部屋まで六人の目付が附添い、老中から用部屋坊主、時計の間坊主、側用取次というふうに順々に手渡しされ、将軍は人払いの上、首に掛けている守袋から目安箱の鍵を取りだして、手ずから箱をひらくという厳重なもの。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "捨公方",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃はやり物のひとつになった黄縞格子の薄物に、菊菱の模様のある緋呉羅の帯を締めて、首から胸へ、紅絹の守袋の紐をのぞかせたおせんは、洗い髪に結いあげた島田髷も清々しく、正しく座った膝の上に、両の手を置いたまま、駕籠の中から池のおもてに視線を移した。",
              "citation": {
                "source": "おせん",
                "author": "邦枝完二",
                "note": "青空文庫"
              }
            },
            {
              "text": "いとほし、と涙もろに、叔母ぎみは守袋をてづからにやさしうかけて、わが背をそと撫でましぬ。",
              "citation": {
                "source": "おもひで",
                "author": "末吉安持",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうした、八」「見えませんよ、掛け守りの紐だけあつて、ぶら下がつて居る守袋は引き千切られて居ますよ」「そんな事だらうよ、お前の話は少し面白過ぎた」「どうしたんでせう、親分」「盜られたにきまつて居るぢやないか。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "苫三七の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "平次にさう言はれると、守袋を盜られた自責の心持もあつたのでせう、其儘、夜の町に飛出してしまつたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "苫三七の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何んだ、八」「あつしの守袋が、縁側に抛り出してありましたよ」「何、お前の盜られた守袋が？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "苫三七の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "三度目の此路地の外で、たうとう守袋を盜つたのは女に化けた世之松さ」「へエ、あの野郎が」「芝居氣があるし、女形になれる男だよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "苫三七の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何んにも見えないのか」「何んにもありませんね、垣根の向うを雀が飛んで居る丈けで」「よし／＼それぢや、暫らく此守袋を豫つてくれ、女の素姓がわかるだらう」「へエ」　八五郎に別れた平次は、下女のお近に頼んで娘のお清を呼んで貰ひました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "旅に病む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "唐棧の胸をはだけて、掛け守袋の紐と、腹帶に呑んだ匕首の脹らみを見せようと言つた種類の人間です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "兵庫の眼玉",
                "note": "青空文庫"
              }
            }
          ]
        }
