        "examples": {
          "standard": [
            {
              "text": "海岸で美しい巻き貝をたくさん拾った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "巻き貝の殻には、自然が作り出した不思議な模様がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この巻き貝は食用になり、酒蒸しにすると美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それは、煙管貝のような格好で全体灰色をした一種の巻き貝であって、長さはせいぜい五六｜分ぐらいであったかと思う。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "島原から山本さんがトッポという大きな巻き貝をおみやげに持って来られた。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "小屋の中はまきがいっぱいはいっていた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "渚の浅いところには、海｜百合や腕足類や、さまざまの巻貝。",
              "citation": {
                "source": "地底獣国",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅花うつぎと巻貝とが煖炉の棚をかざり、その上には色さまざまな鳥の卵が紐に通してさげてあって、大きな駝鳥の卵が部屋の中央にさがっていた。",
              "citation": {
                "source": "スリーピー・ホローの伝説",
                "author": "故ディードリッヒ・ニッカボッカーの遺稿より",
                "note": "青空文庫"
              }
            },
            {
              "text": "貝殻は巻貝や小安貝のたぐい。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "巻貝、笠貝、雲がた貝。",
              "citation": {
                "source": "小品四つ",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺が腰かけた岩の周囲には、小さな巻貝がいっぱいくっついていた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "この巻貝を漁夫はイソダマと呼んでいた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "その巻貝の子供が、まだ小さいために取られずに放置されて、俺の周囲の岩に群がっていた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
