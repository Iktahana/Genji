        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山の奥深くで湧き出る冷たい真清水をすくい上げ、乾いた喉を潤した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "岩肌から滴り落ちる真清水は、驚くほど透明で甘みすら感じられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "村人たちは古くからこの真清水を神聖なものとして守り続けてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "久に経てわが後の世をとへよ松あとしのぶべき人も無き身ぞ　　　　　　　其二　真清水の世に出づべしともおもはねば見る眼寒げにすむ我を、慰め顔の一つ松よ。",
              "citation": {
                "source": "二日物語",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほゝゑみは口のさうび花、もつれ髪、髷にゆふべく、真清水やいつも澄みたる。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "源中納言、なれこそは岩もるあるじ見し人の行くへは知るや宿の真清水　夫人、なき人は影だに見えずつれなくて心をやれるいさらゐの水　などと言い合っている時に、太政大臣は宮中から出た帰途にこの家の前を通って、紅葉の色に促されて立ち寄った。",
              "citation": {
                "source": "源氏物語",
                "author": "藤のうら葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「嘘も仕掛けもねえ真清水だ。",
              "citation": {
                "source": "柳営秘録かつえ蔵",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――古河のにごれる水を真清水に誰がかきまぜてしらず顔なる。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな極悪といわれる人間にも、古井戸のようなもので、悪い水を汲み尽せば、やがて底のほうから真清水が湧いてくる例を、幾たびも見ているからである。",
              "citation": {
                "source": "鍋島甲斐守",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "腐敗しきった数百年の濠水の底にも、なお一脈の真清水は涸れていなかった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
