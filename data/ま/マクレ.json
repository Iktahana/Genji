      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……トタンに額を打って、鼻頭に浸んだ、大粒なのに、むっくと起き、枕を取って掻遣りながら、立膝で、じりりと寄って、肩まで捲れた寝衣の袖を引伸ばしながら、「もし、大分漏りますが、もし葉越さん。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "唇が娘時代のように捲れ気味に、片隅へ寄ると其処に微笑が泛ぶ。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処か寂然として、瓢逸な街路便所や古塀の壁面にいつ誰が貼って行ったともしれないフラテリニ兄弟の喜劇座のビラなどが、少し捲れたビラじりを風に動かしていたりする。",
              "citation": {
                "source": "巴里の秋",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さも貴女と御新造さんが烟に捲れて赤い舌で嘗められていなさるようで、私あ身体へ火がつくようだ。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "箪笥や鏡台なんか並んでいる店の方では、昨夜お座敷の帰りが遅かったとみえて、女が二人まだいぎたなく熟睡していて、一人｜肥っちょうの銀杏返しが、根からがっくり崩れたようになって、肉づいた両手が捲れた掻巻を抱えこむようにしていた。",
              "citation": {
                "source": "挿話",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "おつぎは「おゝ冷てえ」といひながら竈の口から捲れて出る※へ手を翳して「今朝は芋の水氷つたんだよ」とお袋の方を向いていつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "天葢というても兩端が蕨のやうに捲れた狹い松板を二｜枚十｜字に合せたまでのものに過ない簡單なものである。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁を塗る時格子目から内側へ捲くれ出た泥の一つ／＼がだん／＼に白つぽく乾いて明るく成つた時勘次は又内側から塗つて捲れて出た一つ／＼を一｜帶に隱した。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄色な光が快よく鮮かに滿ちて居る晩秋の水のやうな淡い霜が竊におりる以前から其の葉は悉くくる／＼と其の周圍が捲れ始めて、他の雜木は其の葉をからりと落して其の梢よりも遙に低く垂れて居る西の空の明るい入日を透して見せるやうに疎に成るのに、確乎としがみついて離れない。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の爲に平生殆んど半以上を無駄に使はれて居る焔が竈の口から捲れて立つた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "この標本室を作った斎藤先生も、むろん地下で双手を挙げて賛成して御座ると思うんだがね……」　と云って大笑されましたので、流石老練の塚江事務官も煙に捲れたまま引退ったものだそうです」　こうした若林博士の説明は、極めて平調にスラスラと述べられたのであったが、しかしそれでも私の度胆を抜くのには充分であった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋敷は床の上へ流れ出したニスの中へ片頬を浸したまま起き上ろうとして慄えているのだが、軽部の膝骨が屋敷の背中を突き伏せる度毎にまた直ぐべたべたと崩れてしまって着物の捲れあがった太った赤裸の両足を不恰好に床の上で藻掻かせているだけなのだ。",
              "citation": {
                "source": "機械",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして脇下まで捲れた袖から、ヌラヌラと白い腕を現わし、馬盥で、生首を洗っていた。",
              "citation": {
                "source": "鸚鵡蔵代首伝説",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頁の隅々が捲れ上った月おくれの婦女界がたった一冊あった。",
              "citation": {
                "source": "氷蔵の二階",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やり過して地びたを這って後へ廻った鉄公の手がお鶴の裾にかかったかと思うと紅が翻って高く捲れた着物から真白な脛が見えた。",
              "citation": {
                "source": "山の手の子",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも猿は苦しまぎれに寝衣にかじり付いたから、寝衣はずるりと捲れて、老翁の臀が全く露出したところである。",
              "citation": {
                "source": "ドナウ源流行",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "各管の終端は球形に膨れ、そこで黄色い膜が捲れこみ赤い虹彩を持つガラス質の球を包む。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "お嬢ちゃん、まあ見て御覧、こんな工合に何ぼでも剥がれますねんと云いながら、瘡蓋の端を摘まんで引き剥がすと、ずるずると皮が何処迄でも捲れて行く。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦慄のように激しく身ぶるいをし、すると上唇が捲れて、歯が剥きだしになった。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その顔はまた仮面のように硬ばり、上唇が少しずつ捲れて、歯が剥きだされた。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "着物の裾が捲れ、太腿まであらわになったが、不健康に青白く、むくんだような太腿は、腐りかかった魚の腹のように醜くぶきみで、功兵衛は眉をしかめながら眼をそむけた。",
              "citation": {
                "source": "醜聞",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "袖が捲れて、両の肘があらわれ、きめのこまかな、白い、脂ののった艶つやしい二の腕が覗いた。",
              "citation": {
                "source": "ひとでなし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒い夜風が吹きわたり、腰掛けている木内桜谷の着物の裾が捲れて、痩せた細い脛のあらわになるのが、暗がりの中で、さむざむと見えた。",
              "citation": {
                "source": "へちまの木",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "入口に廻した葭簀の端が捲れていたので、彼はそこから中へ入り、あとをきっちり塞いでおいた。",
              "citation": {
                "source": "雪と泥",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "白くなってかさかさに乾いた唇が捲れあがってるんだ。",
              "citation": {
                "source": "陽気な客",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはあの灰色の唇が捲れあがり、剥きだしになった上と下の歯ががちがちと鳴る形相を眼の前に見るような声であった。",
              "citation": {
                "source": "陽気な客",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "知れたこと、唇が捲れあがって歯が剥きだしになっていた。",
              "citation": {
                "source": "陽気な客",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おみやの両腕が頸に絡みつき、袖が捲れて裸になっているその腕が、自分の膚へじかに触れ、彼女の唇が、自分の唇をぴったりとふさいだとき、それまで辛うじて支えていた自制力が、溶けるように崩れてゆくのを感じた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "裾が捲れて、太腿まで見えるのにも気がつかず、おみやはびっくりしたような眼で、茫然と新八を見あげていた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "……御存じかも知れません、芳年の月百姿の中の、安達ヶ原、縦絵｜二枚続の孤家で、店さきには遠慮をする筈、別の絵を上被りに伏せ込んで、窓の柱に掛けてあったのが、暴風雨で帯を引裂いたようにめくれたんですね。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
