[
  {
    "uuid": "736f197c-52b1-5640-930f-169a2f258113",
    "entry": "捲れ",
    "reading": {
      "primary": "まくれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
