        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "釣り糸の巻き取りがうまくいかない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ホースの巻き取り機を使うと作業が楽になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は長いロープの巻き取り作業を始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "一郎と二郎が、凧の糸をまきとりながら、椎の木の下にやって来ました。",
              "citation": {
                "source": "椎の木",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」といって、その綱のまきとり器のところへ、かけよりました。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "まきとり器をまわして、アドバルーンを、引きおろせばよいのです。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　元刑事のひとりが、大きな声で号令をかけ、じぶんもまきとり器のハンドルにとりついて、エッサ、エッサと、まき始めました。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ハヤブサ丸では、ロープまきとりのエンジンを、いっそうはやく回転させました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　しごいて、引いて、幾重にも巻取るようにした指を、離すと、すっと解けて頬を離れる。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大速力をもつてまはる新聞輪転機、それに噛まれる巻取紙には、片つ端から文字が転写されながら、白い河のやうに流れだす、一切の機械的な操作で刷られる、その処女的な新鮮な、軽い油の匂ひと紙の匂ひをプンと匂はす、それを寝床の中で嗅ぐといふ博士の毎朝の楽しみは、新潟から女中がきてからぶちこはされてしまつた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはあやつり人形と同じような仕掛で、何本かの鎖が下に垂れていて、それを滑車とハンドルのついた巻取車で巻いたり、くり出したりすればいいので、この鎖はマストの中を通って艇内へ入れるようにと注意書きがしてあった。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　小桶の水に漬け置ける綸巻取り出し、そろそろ用意を始む。",
              "citation": {
                "source": "大利根の大物釣",
                "author": "石井研堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいつまでも手工業にあまんじるべきではないと、ドイツから巻取り段ボール機械の輸入を計画し始めた。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "聯合紙器創立　銀座の島田洋紙店主に金を借りたりして、当時の金で三千円の巻取り段ボール機械をドイツから輸入した。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寸、二寸、一尺、二尺、空の風船は、巻取る繩に引かれて、徐々に下降し始めた。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "巻取り作業の人々は、それを聞くと、一層力を加え、速度を早めて、繩を巻取る。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "はずみを食って、巻取器が、ひどい勢いで空廻りをし、それにとりついていた数名の警官ははね飛ばされ、あるものは降ってきた繩にうたれて、ころがった。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
