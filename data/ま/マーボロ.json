          "literary": [
            {
              "text": "そして右側はマーボロのメンソールだ。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーボロの広告をかねたもので、例のカウボーイが投げ縄を持ってポーズしている下に、ストア・アローズが表示してあった。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれは、浅間だろう」　と、マーボロを一本、唇の端から垂らすようにくわえる。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年の女じゃないよ、見たところ」　煙草に火をつけ、マーボロをマッチといっしょに箱ごと、ほうってよこす。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ついては、頼みがある」「なんだ」「たいしたことではない」「二本目のマーボロに、小川は火をつけた。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな強靱な男どもは、サラ・マーボロ公爵夫人のように、神経衰弱がはやる前に生まれたに違いない。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
