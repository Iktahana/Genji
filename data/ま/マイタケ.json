    "definitions": [
      {
        "index": 1,
        "gloss": "hen-of-the-woods (species of polypore mushroom, Grifola frondosa)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
