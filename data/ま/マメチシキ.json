        "examples": {
          "standard": [
            {
              "text": "雑学番組を見ていたら、面白い豆知識をたくさん知った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は歴史に関する豆知識を豊富に持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "そんな豆知識、どこで仕入れてきたの？",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "普通はごく短い記事で、二十年前にこんなことがあったという、ほんとにそれっきりの豆知識みたいな記事になるのが普通なのですが、うちのはそうではなく、囲みは囲みでもいま少し長くて、ふくらみをつけようという試みです。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんの　まめちしきだから！",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで　まめちしきは　おしまい。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            }
          ]
        }
