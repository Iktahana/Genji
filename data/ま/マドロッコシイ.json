        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "まどろっこしい手続きが多くて、申請がなかなか進まない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の遠回しな言い方は、いつもまどろっこしいと感じる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「ああ、もうまどろっこしい話はなしにして、結論だけ教えてくれ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "もう口じゃまどろっこしい、眼の廻る様な奴を鼻梁にがんとくれて逃んだのよ。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどエキスパンドブックそのものをブラウザーの中で操作できるなら、こんなまどろっこしい苦労をする必要はありません。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "★コンピューターについて書こうとすれば、カタカナの氾濫を許容してしまうか、日本語でまどろっこしい説明を重ねるかの判断を繰り返し求められる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "大寺警部をして率直にいわせると、若い長谷戸検事の捜査法と来たら、非常にまどろっこしい。",
              "citation": {
                "source": "地獄の使者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "魔窟の紋也「献酬などはまどろっこしい。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って空に、他所目で見ている時、わずかまどろっこしい感じがされるけれど、この人、六十歳、七十歳にまでなった時、その上演種目の、意外におびただしき数にのぼっているに、人、驚きの目を瞠る、必ずやその時があるだろう。",
              "citation": {
                "source": "随筆　寄席風俗",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　細部までだらだらと説明していったのではまどろっこしいだけだろう。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり三時」　山上からみれば自分はどんなに不決断でまどろっこしい女だろう、と伸子は、きまりわるく思った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉永は十日に一度ぐらいのわりで訪ねて来、たいてい半｜刻か一刻、まどろっこしい筆談をいとわず話してゆきました。",
              "citation": {
                "source": "失蝶記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………ペータアさん」と、幸子は、夫人の日本語ではまどろっこしいので、ペータアに云った。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「帳場の」と栄二は舌が鉛にでもなったような、まどろっこしい口ぶりで云った、「――銭箱ですか」　和助はなにも云わずに、じっと栄二をみつめていた。",
              "citation": {
                "source": "さぶ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の子供たちは咽喉へ嚥み下すのもまどろこしいようにせっせと食べ放って、遊び半ばで置いて来た応接間の方へ駆け出して行きました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こんなまどろこしいことはやめろ。",
              "citation": {
                "source": "人間灰",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうだ、電話をかけよう」　事務室に飛びこんだ課長は、まどろこしい郊外電話に癇癪玉を爆発させながら、それでも漸く警察署を呼び出し、自動車｜取押え方の手配をするとともに、また至急自動車をゴルフ場へ廻すように頼んだ。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなまどろこしいことをいわないで、早く教えてください、一体われわれが遠き未来において、どんな生活をするかを……」「云わないといったが最後、この金博士は絶対に云わないのじゃ。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃の世情の荒っぽさは刻みのこまかいものをまどろこしいとするのよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人が通りかかると、「オヤジ、ちょっと……」　なにか、切迫した表情の甚七が、下駄をつっかけるのもまどろこしいあわてかたで、表に飛びだして来た。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
