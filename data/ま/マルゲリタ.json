          "literary": [
            {
              "text": "日本人としての自分にはベラスケズのインファンタ、マリア、マルゲリタよりもこの方がいい。",
              "citation": {
                "source": "ある日の経験",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "王の后マルゲリタは縹緻自慢の女だつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十五（一九二六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルゲリタ皇后は、ウムベルト王がふだんから身の廻りのことに一向無頓着なのが気になつてならなかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十五（一九二六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マルゲリタ、こんな真似をするのは厭なことだね。",
              "citation": {
                "source": "茶話",
                "author": "大正十五（一九二六）年",
                "note": "青空文庫"
              }
            }
          ]
