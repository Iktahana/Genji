          "literary": [
            {
              "text": "鼻は尋常で、唇は少し厚く、笑うと上唇がきゅっとまくれあがる。",
              "citation": {
                "source": "美少女",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "垂布は火事に燃えてまくれ上がるように消える。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "風強く樹木の裏葉がめくれ上る下に、折からの日光に輝いた波頭が美しい。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリリ、バリリ、片端から網がめくれ上るのが、伸子の坐っているところから見えた。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
