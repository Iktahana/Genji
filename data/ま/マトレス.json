        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私のベッドというと人聞きがよいけれど実は、そのベッドには本式のマトレスはまだついていないのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三五年（昭和十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この次の小説でマトレスは出来るだろうという次第です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三五年（昭和十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこここの床に食客たちが寝泊りするマトレスが敷いてある。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "マトレスの古いのを一枚借りだすのがやっとのことでした」「医者がついているのか」「医者も救急車も、一時間ほど前にひきあげました」　主任の額に暗い稲妻のようなものが走った。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "マトレスの粗木綿のざらりとした感触。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "マトレスの下は冷え冷えとしたコンクリートの床だ。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "マトレスの上に、下着もなしに裸で寝ているらしい。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガレージ……」　ロッジの横手にあるガレージのコンクリートの床の上にマトレスを敷き、裸身にベッド・カヴァーを掛けて寝かされているというのが現実らしい。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪がグッショリと濡れしおり、枕とマトレスに胡散くさい汚点がついている。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
