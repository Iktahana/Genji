          "literary": [
            {
              "text": "たいていの人間は一種のアウトマーテンである。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "俳諧の道は、われわれをアウトマーテンの境界から救い出す一つの、少なくも一つの道でなければならない。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "検察官マーテンは起ち上って、犯人の肩に手をかけた。",
              "citation": {
                "source": "暗号舞踏人の謎",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、友人マーテンなるものから伯の肖像を請い受けて、壁上高く掲げ、間がな隙がな仰ぎ視ていたが、これでもなお満足出来ず、折々伯の散歩場たるケーン・ウードを徘徊して、その威風に接するのを楽しみとし、何時か伯と言葉を交すべき機会もがなと、根気よく附け覘っておった。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "すつきりとした和服に、ストンマーテンの毛皮を軽く肩に巻いてゐた。",
              "citation": {
                "source": "緑の星",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
