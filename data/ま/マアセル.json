        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マアセルというのだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこのマアセルは、怒涛のように日夜「モナコの岸」へ押し寄せてくる常連の誰かれにとって、すこしでも彼女の内生活への覗見を持つことは、そのためには即死をも厭わない聖なる神秘であった。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、二十五、六の豊満な金髪美人マアセルだが――。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋はマアセルの寝室だった。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はマアセルだった。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアセルは今日夕方の番だったので、いま「モナコの岸」から、近処に貸りてる自分の部屋へ帰って来たところである。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたふたと自室へはいってきたマアセルは、うしろの戸をばたんと閉めて鍵をかけると、これで完全に自分ひとりになった安心のため、急に仕事の疲れが出て来たようにすこしぐったりとなった。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアセルは鏡へ顔を近づけたり、離したり、曲げてみたり横から見たりした。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "下着とブルマスとコルセットと靴下だけのマアセルだった。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして顎を引いたマアセルは、ちょこちょこと小走りに急いで、寝台の横へ行った。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとは――マアセルはいま寝台の端に腰を下ろして――　美人マアセルの私生活。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで、マアセルを愕かせないように、しずかに、ごく静かに、いささか話しを後へ戻す必要があるのだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　と、つまり、マアセルに関して、はじめに私が説明した全部は、そっくりこの時の親分の言なんだが、えへん！",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モナコの岸」の美人女給マアセルが、誰も見ていないと思って自分の寝室でいかなる行動に出るか――聖なる神秘はあなた方の行手に！",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "親分の先頭でＭＡＩを含み、跫音を窃取して上って来たのが、三階のこのマアセルの部屋の隣室。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアセルの室内の壁紙に黒いぽちぽちの模様があって、その点々に、眼に見えないほどの小さな穴が開いている。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ外側から一つずつ覗き眼鏡みたいなものが取りつけてあるから、マアセルの有する全部は各人の鼻っ先だ。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そうだ、マアセルは今や寝台に腰かけてするすると靴をぬいでいる――。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっと手を入れてみて、マアセルは、熱う！",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "言われるまでもなく、マアセルは事務的に水を出した。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤くなったマアセルだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁寧にタオルで拭いたマアセルは、浴室をそのままにして寝室へ帰って来た。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑っているマアセル。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "唄っているマアセル。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちらと――どころかすっかり裸身を見せている「モナコの岸」のマアセル。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "とマアセルは伸びをした。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝台が大きく浪をうって、マアセルの全体重を受け取った。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてマアセルは、好きなように安楽な姿態で赤本を読み出した。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく読んでいたが、いつしか本を持つ手が横ちょにさがり、やがてその本がぱったりと床を打つと、マアセルは床覆の上で眠り出した。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
