        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「藤井が番傘もって、山ァいったの見たぜ」　と、マーキーの支柱によりかかった高志がいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーキーの下に入り、目をしばたたいた令子は、ようやく慶一のすがたを認めた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "タクシーがせまい玄関まえできりかえし、マーキーにむかってバックしてきた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "寮玄関のマーキーの下には、在校生らしき女子がふたりいて、受付をつとめていた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「第一回学園祭」と書かれた、校舎玄関の変形マーキー上の横断幕。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二歳の令子は、ちょっとあたりを見まわし、ゆっくりとマーキーの下に入っていく。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、その上に、一つには紅玉一つにはアレキサンドライトが、それぞれ白金の台の上で、百二、三十カラットもあろうと思われる、マーキーズ形の凸刻面を輝かしていた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
