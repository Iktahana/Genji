  {
    "uuid": "5f515918-41c9-53ac-8f50-5ab61c9fd4a0",
    "entry": "豆科",
    "reading": {
      "primary": "まめか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
