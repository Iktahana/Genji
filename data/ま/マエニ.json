          "literary": [
            {
              "text": "――アンナ、オオキイウチガ、オマエニ、コワセルモノカ、ウソツキ！",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　スコシ　イクト　フエフキハ　小サナ　クツヤノ　マエニ　キマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、カネガ　ナツテ　キヨウシツノ　マエニ　ナラビニ　ユクト、ミツルクンハ　マダ　ナイテ　ヰマス。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガコマルナラ、コンヤ十一ジニ、クロカワダンチョウト、ハナガタフサエト、マルノウチ、ネオン・ビルノマエニキナサイ。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハオマエニ関スルコトハ何デモ知ッテイル。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
