        "examples": {
          "standard": [
            {
              "text": "テストの結果が返ってくると、答案用紙には大きな赤い丸印がいくつもついていて、思わずガッツポーズをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「参加を希望する項目には、忘れずに丸印を記入して提出してください」とアンケート用紙に書かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "カレンダーの誕生日の日付に、忘れないように青いマジックで太い丸印をつけておいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "赤い丸い月が出て居る有様を朱肉で丸印が捺してあるものとして、一行の雁字と共に一幅を成して居るかのやうにしやれて見たのであらう。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "因にいふ、丸印は昔から時々用ゐられる、尾形光琳の如きは丸印の方を普通に用ゐたやうだ。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうち人が段々来て、曽根の持っていた帳面の連名の上に大抵丸印が附いた。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして、御覧になる方々の参考に、私の採り方の標準をお目にかけるつもりで、丸印や胡麻印などつけて置いた。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "帆村は、この新聞紙に赤丸印の脅迫状を読んでいるうちに、恐怖を感ずるどころかムラムラと癪にさわって来た。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もってかえって、よく研究してみなければならぬ」　そういうと、大利根博士は、白墨をポケットから出して、通風筒の穴のまわりに、丸印だとか三角印だとかをかきました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯隆の目はたえず、白い丸印、白い丸印。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い丸印をまた見かけた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯隆も丸印を見なかったのである。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一針縫うのに十五秒ないし三十秒かかるであろうし、それに針や糸を渡し受取り、布片を延べたり、○印を一つ選定したりするにもかれこれ此れと同じくらいはかかる。",
              "citation": {
                "source": "千人針",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣の袋町に○印をして「浅井」とあるのは浅井｜忠氏の家であろう。",
              "citation": {
                "source": "子規自筆の根岸地図",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "○魂の詩○印象を離れないで印象を超えたるものの表現――暗示――象徴　七月九日　曇、雨をり／＼。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "川霞薄月の空に匂ひて川ぞひの　　　　柳をぐらく霞たなびく舟魚つりし人は帰りて柳かげ　　　　つなげる舟に月のぼりきぬ○印の歌さし出し可申候。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○印は犯罪に関係ある単語。",
              "citation": {
                "source": "心理試験",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
