        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "恰好は、稍瓠の小形なものに似て、横に割つた截り口が、丸紋らしい形を顕してゐる。",
              "citation": {
                "source": "河童の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "唐草、丸紋、その他の織物模様はどうか。",
              "citation": {
                "source": "古染付の絵付及び模様",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに柴進その人は、巻毛の白馬に覆輪の鞍をすえて跨がり、かしらには紗の簇花巾、袍（上着）はむらさき地に花の丸紋、宝石入りの帯、みどり縞の短袴に朱革の馬上靴といういでたち。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "箱書には「南京古赤絵丸紋」とあり、展観の折は「古九谷」としてあつた。",
              "citation": {
                "source": "赤絵鉢",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに山水や人物や花鳥ではなく、もつと静的な丸紋である。",
              "citation": {
                "source": "赤絵鉢",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
