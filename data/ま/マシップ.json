          "literary": [
            {
              "text": "――ドーヴィル市長、ムッシュウ・マシップ（仮名）です。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――市長マシップ氏にも用があるんですが、何処に居られますか。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お気の毒ですが市長マシップ氏も、ミスター・ジョージも西班牙へ御同行出来ません。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この花は市長マシップ氏と、ミスター・ジョージとの贈物です。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
