          "literary": [
            {
              "text": "フエフキハ　ツギノ　マチヘ　ハイル　ミチデ、ヒロツタ　カナヅチヲ　フリアゲ、クシヤント　フエヲ　クダイテ　シマヒマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　シツカリト　カナヅチヲ　ニギリシメテ、コウババカリノ　マチヘ　マツスグ　アルイテ　ユキマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人ハ　コンナワケデ、一シヨニマチヘ行ツタノデ、ソノ時カラコツチ、人参ト玉ネギトジヤガイモハ　イツモ一シヨニオ料理サレルヤウニナリマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スナマンヂウガ　デキタラ　パカ、パカピヨン、ピヨン、パカ、パカオウマニ　ツンデマチヘ　ウリニ　ユキマセウ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
