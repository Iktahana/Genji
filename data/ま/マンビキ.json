        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "店員が死角で万引きをしている客を見つけ、声をかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "少年は万引きで捕まり、警察署で反省させられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "万引き防止のために、店内には多数の監視カメラが設置されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "かつて何かの雑誌で「万引きの心理」という題目で大いに論じたものを読んだ事がある、その中にもこの虚栄心の事がたいそう長たらしく書いてあったように記憶している。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばいわゆる共産主義を論じる学者たちが現在の社会に行なわれているこの万引きというものをいかに取り扱うかが聞きたいものである。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "三越へ来て、数千円の帯地や数百円の指輪を見たり、あるいは万引きの事を考えたりしているとだれかが言った寝言のようななぞのような言葉に、多少の意味があるような気がする。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘のお節は容貌も好し、見たところは如何にもしとやかな女ですが、どういうものか手癖が悪くって、肩揚げの取れない頃から万引きなどを働いていたんですが、見掛けがおとなしいから誰も気がつかない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大阪屋花鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな処ではなかなか女給と直接交渉（一名万引き）は出来ない。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "喧嘩や恐喝をやる式、泥棒や万引きをやる式、女をたらす式、又はこれ等をまぜこぜにやる式と、大体に於て四通りある。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時は万引きみたいではなはだきまりの悪いおもいをするが私の態度が明らかに間が抜けているとみえて警官を煩わすほどの事件を惹き起したことは幸いにまだ一度もない。",
              "citation": {
                "source": "放心教授",
                "author": "森於菟",
                "note": "青空文庫"
              }
            },
            {
              "text": "疎開でまんびきを習つて来たんだらう」と彼は憎らしいように言つた。",
              "citation": {
                "source": "茄子畑",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "きみにしてみりゃ、おいらはほかのキツネ10まんびきと、なんのかわりもないから。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの子は、ほかのキツネ10まんびきと、なんのかわりもなかった。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "キツネの言葉を借りれば、\"un renard\" といったときのキツネは、「ほかのキツネ１０まんびきと、なんのかわりもない」わけで、どれでもいいのです。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それに　アナ・マライア　どうも　しなもの　まんびきしてる　――　あれだけの　クラッカー　どこいった？",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ、まんびきするほど、おちぶれちゃいないわ。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなかわいい顔をして、あいつ、まんびき少女だったんだな。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まんびき少女が、手紙をのこしていったのかな。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "万引にも三分の理、変質の左翼少女｜滔々と美辞麗句、という見出しでございました。",
              "citation": {
                "source": "燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また万引奨励機関でもある。",
              "citation": {
                "source": "猫の穴掘り",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お兼はいつまでも初心らしく見えるのを種として、これまでに小娘に化けて万引や騙りを働いた兇状がある。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "気位の高い安子はけちくさい脅迫や、しみったれた万引など振りむきもせず、安子が眼をつけた仕事はさすがの折井もふるえる位の大仕事だった。",
              "citation": {
                "source": "妖婦",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "滝太郎がその挙動を、鋭い目で角の屑屋の物置みたような二階の格子窓に、世を憚る監視中の顔をあてて、匍匐になって見ていた、窃盗、万引、詐偽もその時｜二十までに数を知らず、ちょうど先月までくらい込んでいた、巣鴨が十たび目だという凄い女、渾名を白魚のお兼といって、日向では消えそうな華奢姿。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「怪しからん、」　と笑って、気競って、「誰も山賊の棲家だとも、万引の隠場所だとも言わないのに、貴下が聞違えたんではありませんか。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "よくも、悪くも、背中に大蛇の刺青があって、白木屋で万引という題を出すと、同氏御裏方、御後室、いずれも鴨川家集の読人だから堪らない。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "正直な者が生涯に一｜返万引を働いても疑を掛ける知人もないし、冗談を商売にする男が十年に半日｜真面目な事件を担ぎ込んでも誰も相手にするものはない。",
              "citation": {
                "source": "趣味の遺伝",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は発明品への投資者を求めながら、己れの才能に反する万引や窃盗をして歩るくのであつた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "万引なんと云うことをする女も、別に変った木で刻まれたものでは無い。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいつらは今日でいう不良少女で、肩揚げのおりないうちに自分たちの親の家を飛び出して、同気相求むる三人が一つ仲間になって、万引や巾着切りや板の間稼ぎなどをやっていたんですが、下町の方でだんだんに人の眼について来たので、このごろは武家の娘らしい姿に化けて、専ら山の手の方を荒しあるいていたんです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "雷獣と蛇",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらは二、三人または三、四人ずつ幾組にも分れて、馬喰町その他に宿を取って、江戸馴れない旅人の風をして窃盗や辻強盗や万引の悪事を働いていたのであるが、そのなかで証拠の最も歴然たるのは、日本橋人形町の小間物屋忠蔵方で鼈甲の櫛四枚をぬすみ取ったことであった。",
              "citation": {
                "source": "拷問の話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "犯罪に純粋もヘチマも在ったものではないが、つまり何の目的も無しに、殺してみたくなったから殺した、盗んでみたくなったから万引したという、ホントウの慾得を忘れた犯罪心理……生一本の出来心から起った犯罪を純粋犯罪というのだそうで、この種の犯罪は世の中が開けて来るに連れて殖えて来るものである。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "警察に引っぱられたカフェーの女給が、華族の令嬢に見られる事もあれば、いい加減な派出婦が万引したお蔭で、貴婦人と間違えられる事もある世の中だ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその万引の手段てえのが、トリック付きなんですから感心しちゃいまさあ。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
