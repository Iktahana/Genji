        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "部屋の壁と天井の境目には、美しい彫刻が施された回り縁があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "和室の回り縁は、部屋全体に落ち着いた雰囲気を与える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "回り縁の色を変えるだけで、部屋の印象が大きく変わる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "次いで村社三島神社境内にある立石――この立石を祀つた遺習が、今の三島神社建立の因となつたと想像される――を見て、暫く神社の回り縁に腰して休む。",
              "citation": {
                "source": "南予枇杷行",
                "author": "河東碧梧桐",
                "note": "青空文庫"
              }
            },
            {
              "text": "回り縁にて隣の宿直の部屋に通ず。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは方丈から客殿へ続く回り縁になっていて、さらに本堂の裏手、位牌堂までも続いて行っている。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "左右のわき床は紫檀黒檀の棚板、三方の大障子は花櫚の亀甲組白絹張りで、開閉にも重いくらいの頑丈造り、一間幅の回り縁は欅の厚板、天井は三尺角樟の格天井、いや全くお話ですぞ。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "回り縁の八畳の座敷へ通る。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナイフがあればすぐ分かる」　ベナが小さなナイフをポケットから取り出すと、ガードンが巧みに刃先を、回り縁の下に入れた。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "はたして回り縁が動き、すぐ手で取れた。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初石膏かと思ったが、見ての通り、精巧に加工された木材だな」　ベナが回り縁を脇に置いて、かたずをのんで見ていると、ガードンがもう一つに取り掛かった。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "回り縁をすべて取って、ナイフを壁の背後に差し込むと、壁板がとれて、裏に四角い大穴が現れ、誰でも簡単に通れる。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "あと三枚の壁から、回り縁を全部取ったら、広い空間ができて、ここから荷物が運べる。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "回り縁をよこしてくれ、音を立てずにはめなくちゃ。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣家の奴らに疑われる」　運良く、回り縁がぴったりはまり、ガードンはなんとか釘を元の穴にうまく差し込み、職人並に修復できて満足した。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから廻り縁になって、別の一室にも、槍、薙刀、鉄砲などが「なげし」にかけられて、山東京伝的｜草艸紙興味を味わせるのに十分であった。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "工房の外は廻り縁になっていて、矩形の細長い庭には植木も少しはあった。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "四つばかりの階段を上つた処が廻り縁になつて居て、中は四間の奥行二間許りの板敷がある。",
              "citation": {
                "source": "夜烏",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "外面の、印度洋に向いた方の、大理石の廻り縁には、軒から掛けて、床へ敷く……水晶の簾に、星の数々｜鏤めたやうな、ぎやまんの燈籠が、十五、晃々点いて並んで居ます。",
              "citation": {
                "source": "印度更紗",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ、廻り縁の座敷に、畳屋の入つてゐたのも、何となく心ゆく都の時雨に似て、折から縁の端にトントンと敲いた茣蓙から、幽に立つた埃も青い。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど郁子の姉が監視に来ていたところで、廻り縁を渡って行く二人の後ろ姿を見、てっきり均平の情人が、均平の子供を背負いこんで来たものと推断し、わざとひそかに庭へおりて、植込みの隙間から、二人の坐っている座敷の方を覗いて見たりした。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　青木はこの前も通された、廻り縁の角にある一つの部屋に通された。",
              "citation": {
                "source": "二つの失敗",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして玄関から上つて、籐椅子などのある応接室の外に通つてゐる廊下を行くと、その座敷の廻り縁へと出るのであつた。",
              "citation": {
                "source": "草いきれ",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "八畳の間に床の間と廻り縁とがついていて、ほかに四畳半が一間、二畳が一間、それから板の間が少々ある。",
              "citation": {
                "source": "安井夫人",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "食後の運動かたがた、五六間の廻り縁を、あるきながら書見するつもりであった。",
              "citation": {
                "source": "文鳥",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "本堂の左端にある格子扉をあけると、四坪程の土間から黒光りした板敷に続き、次の陰気な茶の間を通って、廻り縁から渡り廊下で連なっているのが、厨川朔郎の室である。",
              "citation": {
                "source": "後光殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳江の書斎は、茶の間から廻り縁に出ず、左折して廊下を少し行った所のドン詰まりの室で、その塀向うが寺男の浪貝久八の台所になっていて、朔郎の室とは小庭を隔てて平行している。",
              "citation": {
                "source": "後光殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、その廊下は、廻り縁になる角から幾つもの室の間を貫通して、本堂の僧侶出入口で行詰まっていた。",
              "citation": {
                "source": "後光殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "上のかたは廻り縁にてあとへ下げて障子をしめたる小座敷あり。",
              "citation": {
                "source": "近松半二の死",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "東南へ廻り縁になっている八畳の座敷のほかに、六畳と三畳の二間が付いているので、座敷には弥太郎、六畳には又次郎、三畳には久助、皆それぞれの塒を定めて、弥太郎の鉄砲は床の間に飾った。",
              "citation": {
                "source": "鷲",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥より廻り縁づたいに半七いず。",
              "citation": {
                "source": "勘平の死",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前は東京朝日新聞社の若菜貞爾が住んでいたとかいうことで、格子作りの入口が三畳、それから右へ廻り縁で八畳の座敷がある。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処にも灯りひとつ見えない長い廻り縁を伝つて行く百合子の姿は恰で宙を駆けてゐるやうに見えた。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
