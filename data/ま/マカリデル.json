    "entry": "罷り出る",
    "reading": {
      "primary": "まかりでる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "下一段-ダ行",
      "inflections": null,
