          "literary": [
            {
              "text": "午前九時すぎにアフリカの東端、サマリランドの一角が左に現れる。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "下の機関室から油だらけになった火夫らしい若者が上って来たのに、サマリランドを指差して、あれは何という島ですかと船客の一人が訊ねた。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "グレン・マーチンというアメリカ屈指の大航空機会社が、マリランドの大学へ、この委託研究を出している、という話なのである。",
              "citation": {
                "source": "あすへの話題",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
