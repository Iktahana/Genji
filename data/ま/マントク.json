          "literary": [
            {
              "text": "われ罵るらく、「悪魔よ、退け、わが心は DS が諸善万徳を映すの鏡なり。",
              "citation": {
                "source": "るしへる",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは名号の中には万徳が備わっているからである。",
              "citation": {
                "source": "法然行伝",
                "author": "中里介山",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは年中第一の有徳の方角にして、万徳の集まる吉方といわれている。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは万徳が互を慕って一堂に相会する姿と見てもよい。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
