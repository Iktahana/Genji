  {
    "uuid": "f1fb2dfd-cd3c-5673-be14-d7dd8d88ed01",
    "entry": "マデニ",
    "reading": {
      "primary": "までに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "青キ朝日ハコノトキニ、　　　　ケブリヲノボリユラメケバ、樹ハサウサウト燃エイデテ、　　カナシキマデニヒカリタツ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と、思う胸騒ぎを、じっと抑えて、読み下すと、アスマデニ三〇〇エンツゴウシテクレ、イノチガケニテタノム、アネ　と、いう電文だった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々ハ今マデニオイテモ行書ノ活字ダノ草書ノ活字ダノトイウモノヲ持タナカツタガ、ソノタメニイササカノ不便モ感ジテハイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二）右ノ報告ヲ本日午後十時マデニ報告シ得ザルトキハ、在京同志ハ悉ク明朝ヲ待タズシテ鏖殺セラルルコトヲ銘記セヨ。",
              "citation": {
                "source": "間諜座事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタ、ホントニアタシガカワイイナラ、コノテガミツキシダイ、ヨルノ七時マデニ、イツモノトコロヘキテチョウダイ、キット、キットヨ、デワ　サヨナラ　　　　コイシキコイシキペテロフサマ　シブヤにてアナタノトヨ子※」　それは、いかにも滅多に手紙など書く必要のない女の字であった。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンゲツスエマデニタイイン。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「動員アリ七日朝マデニ入営セヨ。",
              "citation": {
                "source": "掠奪せられたる男",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "オコタヘハ　クワンセイ　ハガキ　デ　コドモノクニ　ヘ　五月十五日マデニ　ハツペウハ　八月号ノ　コドモノクニ裏表紙",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "セータアノポケツトカラ　イツノマニカ　キヤラメルガ　トビダシテ　ミチノウエマデニゲテヰタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナマメカシイト云ッタライヽノカ、色ッポイト云ッタライヽノカ、己ハ今マデニアンナ妖艶ナ女ヲ見タコトガナイ、妖婦ト云ウノハ正シクアンナ女ノコトヲ云ウンダロウナ、アンナ女ニナラ殺サレタッテイヽト思ッタト、湿ノ父親ハイツモ忰ヲ掴マエテヨク／＼感ニ耐エタヨウニ云イ暮ラシタソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナ所ニ埋メラレタクナインダ」「ソレハ分ッテマスケレド、京都ニナサルニシタッテ、来月ノ大文字マデニハ決メルッテオッシャッテタデショウ」「マダ一カ月アルンダカライヽサ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンクリートヲ乾カスマデニ時間ガカヽルンデ、今カラ工事ヲ始メテモ完成スルノニ四カ月グライカヽルソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "起キ上ロウトシタガ直グニハ起キ上レズ、杖ヲ拾ッテ縋リナガラ立チ上ルマデニ数分ヲ要シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、昨日モ申シ上ゲタヨウニ博士ハ今マデニ何十人トナクコノ患者ヲ扱イ、コノ方法デ簡単ニ成功シテイルノデ、ソンナ神業ナンテ云ワレル程ノムズカシイモノトハ思ッテイナイ、患者モ格別不安ガッタリ恐レタリシタ者ハナカッタ、皆気軽ニ注射シテ貰イ、直グ良クナッテ大喜ビデ帰ッテ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "横浜ヲ通過スルマデニ一回、熱海ヲ通過スルマデニ又一回便所ニ通ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "席カラ便所ガ遠イノデ辿リ着クマデニ度々ヨロケテ倒レソウニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然僕ハ舌ノ尖端ニハ今マデニナイヲ、………僕ノコウイウ不思議ナ心理ヲ、マサカソコマデハ気ガツカズニイルノデアロウガ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――二十日岩波ノ小林來ル○　二十日マデニ石ノ大サキメルコト、　岩波ノ小林は小林勇のこと、二十日豫定の石ノ大サとは芥川の墓石の寸法のことである。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "痩せ型で背が高く、これを「曹瞞伝」の描くところに従っていえば、――佻易ニシテ威ナク、音楽ヲ好ミ、倡優、側に在リ、被服｜軽絹、常ニ手巾細物ヲ入レタル小嚢ヲ懸ケ、人ト語ルニハ戯弄多ク、歓ンデ大笑スルトキハ、頭ヲ几ニ没スルマデニ至リ、膳ノ肴ヲ吹キ飛バスガ如キ態ヲナス。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
