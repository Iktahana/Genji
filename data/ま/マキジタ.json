        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の巻き舌の話し方には独特の魅力がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "フランス語の発音では巻き舌が難しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は演劇の練習で巻き舌のセリフに苦戦している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "いずれも巻き舌のような調子で「ウェル」とかなんとか言っているのです。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつか謡って聞かされたときに、先生の謡は巻き舌だと言ったら、ひどいことを言うやつだと言っていつまでもその事を覚えておられた。",
              "citation": {
                "source": "夏目漱石先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手の酔っぱらいの巻き舌に対して、どっちも負けずに同じような態度と口調で、小気味よくやりとりをしていた。",
              "citation": {
                "source": "夏目漱石先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おいらのだんなが目にはいらねえのかッ」　江戸っ子気性の伝六としてはまた無理のないことでしたが、巻き舌でぽんぽんといいながら食ってかかろうとしましたので、名人があわてて制すると、微笑しいしいいたって物静かにいいました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「…………」「…………」　十手も啖呵もものをいったのではないが、われこそその一の子分と巻き舌でぱんぱんと名のったむっつり右門の名がきいたのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　かう皆がなぶり物にすると、あの越後屋重吉め、ちつとの間は口惜しさうに眼ばかりぱちつかせてゐやがつたが、やがて宿の若え者が、火吹竹を顋の下へやつて、ぐいと面を擡げさせると、急に巻き舌になりやがつて、「やい、やい、やい、こいつらは飛んだ奴ぢやねえかえ。",
              "citation": {
                "source": "鼠小僧次郎吉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "わざと酔っ払いじみた巻き舌でまくし立ててやった。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しこんな田舎者に弱身を見せると癖になると思つたから、成るべく大きな声をして、少々巻き舌で講釈してやつた。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこんな田舎者に弱身を見せると癖になると思ったから、なるべく大きな声をして、少々巻き舌で講釈してやった。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "うせ物じゃああるめえし」「心配するねえっ」文次は急に巻き舌に変わった。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――実際、映画や演劇って奴は、ギリギリまで近代企業でいやがるからね」　眼玉の大きい顔を平手で撫でて、川瀬勇はいまいましそうに巻き舌をつかった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻から煙を吐き出し吐き出し、彼はたえまなく、大きなしゃがれ声で、しかも巻き舌で、そばの連中に話しかけていた。",
              "citation": {
                "source": "なぐり合い",
                "author": "WIE JAPPE UND DO ESCOBAR SICH PRUGELTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と巻き舌でいいながら、まんなかへ歩み出ると、彼は胸を張って肩をゆすり上げた。",
              "citation": {
                "source": "なぐり合い",
                "author": "WIE JAPPE UND DO ESCOBAR SICH PRUGELTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "信じないならボドミンのボリス銀行に聞いてみな」　こう答えた女は巻き舌だ。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらか、巻き舌の、流暢なフランス語で原書の講義をやっていた外人教師が、不意に私の方をみて、「や？",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵にかいたような、巻き舌でポンポンポンとタンカを切るのが聞きたくて、私は、毎日のように日本橋へ通った。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾達はスペイン人の巻舌の中で、真赤な衣裳の影で、恋愛のために歓声をあげたのです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸っ子らしい巻舌で一夜の宿を求め、部屋に案内されるや、すぐさま仰向に寝ころがり、両脚を烈しくばたばたさせ、番頭の持って行った宿帳には、それでもちゃんと正しく住所姓名を記し、酔い覚めの水をたのみ、やたらと飲んで、それから、その水でブロバリン二百錠一気にやった模様である。",
              "citation": {
                "source": "犯人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "坐るが早いか、『サア聞いてくれ、私はもうどうしても勘弁がならんのだ』と、それから巻舌で長々と述べ立てましたところを聞きますと、つまりこうなんです、藤吉がその日仲間の者四五人と一しょにある所で一杯やりますと、仲間の一人がなんかのはずみから藤吉と口論を初めました。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "というさえ今は巻舌にて、泥のごとくに酔うたるを、飲直さむとて連出しぬ。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "千石の大身に成り上がっても、もとの素姓はなかなか洗い切れぬとみえて、言葉のところどころが巻舌がかってもつれました。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　博士はそろそろ巻舌になって来た。",
              "citation": {
                "source": "里芋の芽と不動の目",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士は純粋の江戸子で、何か話をして興に乗じて来ると、巻舌になって来る。",
              "citation": {
                "source": "里芋の芽と不動の目",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「所蔵品目録だつて」平岡氏は出て来る骨董屋の顔をじろりと横目で睨みながら、巻舌で言つた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "少々巻舌じゃないか」「……でしょうね。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そんなことを凡そ屈托のない巻舌の英語で、大いに笑ひながら喋舌りかけたので、私は二の句も告げなかつた。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞くも爽々しい巻舌の江戸弁だつた。",
              "citation": {
                "source": "病状",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめてウヰルソン教授の発音法を応用したならば、そんな失策もなかつたらうに、浮れたわたしの巻舌は、メリケン親爺の口真似になつて、聞くだに野卑で、滑稽なる亡霊の声に過ぎなかつた。",
              "citation": {
                "source": "幽霊の出る宮殿",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺らは此辺の……（凄い巻舌で開きとれなかつた。",
              "citation": {
                "source": "日本橋",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "などゝ巻舌の英語で戯れのプロージットをしたりした。",
              "citation": {
                "source": "籔のほとり",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
