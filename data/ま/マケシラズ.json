        "examples": {
          "standard": [
            {
              "text": "あのチャンピオンは、デビュー以来ずっと負け知らずで、まさに鉄壁の強さを誇る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は伝説の剣士として、数々の決闘で負け知らずの記録を打ち立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「我々は、この戦いで負け知らずの偉業を成し遂げる！」と、兵士たちは士気を高めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その道三は益々快調、負け知らず、美濃衆とよばれて天下の精強をうたわれている彼の部下は充実しつつあるばかりだ。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
