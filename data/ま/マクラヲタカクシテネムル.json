        "examples": {
          "standard": [
            {
              "text": "新しいセキュリティシステムを導入したおかげで、これで枕を高くして眠れるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "全ての準備を終えた彼は、明日の発表を気にすることなく、枕を高くして眠ることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちが健康でいてくれるなら、親は枕を高くして眠れるものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "過ぐる半月あまり安い思いも知らなかった兵庫神戸の住民が全く枕を高くして眠ることのできるようになったのは、この長州兵を迎えてからであった。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            }
          ]
        }
