  {
    "uuid": "953a62cc-2793-542a-8db0-544739a4a6e0",
    "entry": "罷り通る",
    "reading": {
      "primary": "まかりとおる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "五段-ラ行",
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "氏郷の相伴つかまつって苦しい者ではござらぬ、蒲生源左衛門｜罷り通る、蒲生忠右衛門罷り通る、町野左近将監罷り通る、罷り通る、罷り通る、と陣鐘のような声もあれば陣太鼓のような声も有る、陣法螺吹立てるような声も有って、間隔たったる味方の軍勢の耳にも響けかしに勢い猛く挨拶して押通った。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰人にもあれ、山門の内へ罷り通ること暫く御遠慮めされ」　ゆく手をさえぎられて、玉藻の供もむっとした。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔っ払い罷り通るというものだ。",
              "citation": {
                "source": "囚われ人",
                "author": "――寓話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで自分の家ででもあるように横柄な顔で玄関からズカズカと奥へ罷り通る。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "長崎ものがたり",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大儀でござった」　と挨拶して、官兵衛は、「それがしは、跛行でござれば、輿のまま罷り通る。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "御子息権六勝敏様なども加えられ、御幕下のみで御陣幕に籠もられておられまする」「ならば、さしつかえない、そこへ罷り通る」「いや、お取次しましょう」「それには及ばん」　玄蕃允は押通ってしまった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月四日（水曜）曇雨　富士映画「ぼん／″＼罷り通る」セット入り。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊ちゃんシリーズの一、「ぼんぼん罷り通る」。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月六日（金曜）晴「ぼん／″＼罷り通る」了。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "有がたいことには、「ぼん／″＼罷り通る」の僕の出場は、これでもう終ったのである。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二時半、一回目「八五郎罷り通る」の幕開く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
