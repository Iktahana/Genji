        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "五十銭持って、マルーシャのところへ遊びに行ったのだ。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "○マルーシャを描くことにした寺島。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルーシャは確にわれわれに一つのいい実例を話してくれた。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――こわいじゃないかねえ、マルーシャ。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "桃色の布をかぶった大柄なアグーシャが村の共同井戸のところで後家のマルーシャにいった。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルーシャは三十五で、去年亭主に死なれ、三人の小さい子持ちである。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "末っ子を外套の中へ入れて抱いた後家のマルーシャが列の中から、陽気な声でピムキンにいった。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "候補者、後家マルーシャ、青年共産主義同盟員ニーナ。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "後家マルーシャは、笑いながらある日アグーシャにいった。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "輪をあけた村の者たちに押しだされてペーチャが自分の家の入口の前に立ったら、そこの柱の根っこにアグーシャが後家マルーシャに身体を半分抱えられて腰かけている。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルーシャがペーチャを見上げて性急にいった。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルーシャがアグーシャの胴を抱えてひったてながらいった。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "臍まで出して嬉しそうにその上で足をバタバタやってるちびどもの間を、白い上被きて白い布かぶったニーナとマルーシャが、ただ見るよりずっと悧巧そうな顔つきで、笑ったり、しゃべったりしながら動いている。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供を片手に抱きあげ、むつきを代えていたマルーシャが、むこうを見ながら、　――あら、見なアグーシャ！",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルーシャは、しばらく遠くに見えるピムキンの裸の背中を眺めていたが、　――ぷう！",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "のどまで、灰色のスウェーターをきっちり着こんだマルーシャが一段高い声で云った。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルーシャは、みんなより年上だ。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "労農通信員のマルーシャが、みんなにからかわれながら、額におちてくる金髪をふりあげふりあげ上気した顔をして小形写真機を覗いている。",
              "citation": {
                "source": "ソヴェト同盟の三月八日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルーシャは労働者新聞に自分達工場の婦人デーの模様を書き、何とかして、この罪のない、おどけたアガーシャ小母さんの雪の上の踊り姿の写真を插画にしようと熱中しているわけなのだ。",
              "citation": {
                "source": "ソヴェト同盟の三月八日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
