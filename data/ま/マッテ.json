        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "草田サンガ、マッテル。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ　コマッテ、ボク　ハ　ヤマニ　ソダッテ　オヨギ　ハ　シラナイ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "次郎が電報をうつと、スグコイマッテイルとの返事だったので、喜んで行こうとすると、君枝はもじもじしながら、「うちも一しょに行くわ。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ゴロ愛惜シタ樹木ヤ草花ナドガ、イツトハナク落葉シテシマッテイル。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年ノ多クハ小サクサカシクオサマッテイルモノカ、ツマラナク時ヲ無為ニ送ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ニ逢ウタラ鰹節一本贈ルナドトイウテ居タガ、モーソンナ者ハ食ウテシマッテアルマイ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄蘗スナワチ問ウ、古人、アヤマッテ一転語ヲ祗対シテ、五百生、野狐ノ身ニ堕ス。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者様――アノ鯉幟ノ棹ハ、私ガ酔ッタ勢イデ立テタモノデスガ、ソレガ記者様ノオ眼ニ止マッテ、コンナ不孝ナ恥ヲ晒ソウトハ夢ニモ思イマセンデシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日八時、石切山ノ下デマッテイマス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナッテ、又ムネイタイノ、トキクト、ダマッテ目ヲツブッテ、ソレカラムネナンテ何ンデモナイ、ト云ッテ、君チャンノカオヲ見、何ンベンモソットナミダヲフイテルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモハジメノウチデ、工場ノ人モダンダンコナクナッテ、死ンダトキニハ、ミンナハモウ君チャンノオ父ッチャノコトヲワスレテシマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ母ッチャハネタキリデ、目アナガウントヒッコンデ、ダマッテミテイルト、イキヲスルタビニウゴイテイタフトンガ、ダンダン分ラナイグライニナッテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "イソイデ、オ母ッチャノ方ニ手ヲノバシテヤッテ、ヨナカニコエヲ出スノガオッカナイノデ、ハジメダマッテユスッテイタガ、オ母ッチャハナカナカ目ヲサマサナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシキハソコノ人ガタクサンアツマッテ、ドウニカヤッテクレルコトニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンハ青イカオヲシテ、ダマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ビョウキシテ、コマッテ、イルカラ、三円クメンシテ、オクッテクダサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンガ、キュウシュウヘ、ユクノデ、ワタシハ、オマエノトコロヘ、ユクカモシレマセン、タノシミニ、マッテイナサイ――母よりの手紙。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハト、マメ、コマ、タノシミニマッテイナサイか！",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハト、マメ、コマ、タノシミニマッテヰナサイか！",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二）コノ品物ハスグチャントシマッテクレ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この平野は、ブリエンツからトゥーンにそそぐアーレの流れに両分されて、南はインテルラーケンとマッテン Interlaken, Matten、北岸とトゥーンの湖水とにはさまれたウンテルゼーエン Unterseen とに分れておる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼下になだれ落ちるユンクフラウの絶壁の、裾は靄がたなびいて、マッテンか知らず、渓底の小村には、小さい灯火が動きはじめた。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "村のそこここに灯が入って、渓底のマッテンにも、小さいあかりが揺らぎはじめる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィッシャー氏はまだ帰らない、クアザールから、ホョーヘン・マッテの草原を散歩して、帰り途に大通の煙草屋に這入り込む。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンモ　オカアサンモオゲンクワンノ　トコロデ、マッテ　オイデニナリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ　ソレデモ、僕達ワ　田ヲ作ランナランダカラ　皆ワ　ダマッテ黒イ姿デ　水ヲ睨ンデイタ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレマデ　僕達ワダマッテ地蔵サンノヨーニ立ッテ鬼共ノ田ヲ守ッテ土手ノ上カラドブリドブリ　流レルニゴッタ水ヲ見ツメテオリマス。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
