        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の話は真っ当に面白く、時間を忘れて聞き入ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その計画は真っ当に危険で、実行に移すのは難しいと判断された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このレポートは真っ当に時間をかけて書かれた力作だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
