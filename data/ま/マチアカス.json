        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女からの返事を一晩中待ち明かすのはつらいものです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "友人が遠方から来る日、駅で待ち明かす覚悟で始発を待った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試験の結果発表を待ち明かすような、そんな緊張感のある夜だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "越後獅子に「其處のおけさに異なこと言はれ、ねまりねまらず待ち明かす」と言ふのがあります。",
              "citation": {
                "source": "佐渡が島を出て",
                "author": "江南文三",
                "note": "青空文庫"
              }
            },
            {
              "text": "又は今夜の何時、何處其處で待つて居てくれとの會合にも、私は唯だ逢ふと云ふ望みを前にしたゞけで、却て空しく、待ち明かす恨みの方が、一層深い記憶を殘すであらうと思ふ事さへあつた。",
              "citation": {
                "source": "歡樂",
                "author": "永井壯吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
