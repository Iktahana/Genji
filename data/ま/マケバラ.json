          "literary": [
            {
              "text": "」「負け腹を立てるなんか柄でもないわ。",
              "citation": {
                "source": "球突場の一隅",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "……負け腹立っている人間には、かまわぬがよい。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきの隅田、高橋の大敗も見たろうに」「いや、あまりひどい負け方を喫したので、敵は、負け腹立って来たのだろう」　しかし、衆言をよそに、正成の床几の辺では、和田、神宮寺、橋本、安間などの諸将から正季も前において、いつもに変らない正成の低目な声が、なにか諄々といっていた。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "外記　　負腹を立つおまへ樣こそ、近頃御卑怯でござりますぞ。",
              "citation": {
                "source": "箕輪の心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔父さまが負腹を立たれたのだ。",
              "citation": {
                "source": "箕輪の心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる我君の手腕にも恐れず、公綱わずか七百余騎にて二千余騎のわが軍に向うというは、先般の負戦に負腹たて、無二無三に仕掛くるものと存じまする。",
              "citation": {
                "source": "赤坂城の謀略",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
