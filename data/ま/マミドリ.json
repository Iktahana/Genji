          "literary": [
            {
              "text": "……　それがお前様、真緑の、光のある、美しい、珠じゃったげにございます。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに台のスッと細い、浅くてぱッと口の開いた、ひどくハイカラな硝子盃を伏せて、真緑で透通る、美しい液体の入った、共口の壜が添って、――三分ぐらい上が透いていたのでしたっけ。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その小石原いちめんに真緑の山葵が植えつけられているのである。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "言の葉の林のこのまみどりしてももちどり鳴く春は来にけり（昭和三十二年正月十五日）",
              "citation": {
                "source": "『言林』改訂版の序",
                "author": "新村出",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
