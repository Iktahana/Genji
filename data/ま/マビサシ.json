  {
    "uuid": "b924f525-1aec-593d-8de5-feb7214836d2",
    "entry": "目庇",
    "reading": {
      "primary": "まびさし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
