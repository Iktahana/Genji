          "literary": [
            {
              "text": "おり悪しく、その晩に、ひどいあらしが吹いて、海の中は、さながら渦巻きかえるように見られたのでした。",
              "citation": {
                "source": "一本の銀の針",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時、飛行艇の投下した爆弾は、渦巻きかえる海狼の中へ落ちて、山のような水煙をあげながら爆発した。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
