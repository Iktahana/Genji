        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "巻かれた奴あ、ギュッと巻き締められて、息の根を止められちまわあな。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、かの女は笑いに巻き締められるような想いが胸に泛んだ。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからどこまで、幅の広い、分の厚い、頑丈な、馬来半島渡来の竹籐で籠編みにできていて、内部は、箱のようになっているらしかったが、表面は、全体を雲斎織で巻き締めてあって、上から、一めんに何か防水剤のような黒い塗料がきせてあった。",
              "citation": {
                "source": "ヤトラカン・サミ博士の椅子",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "細い紙きれへこまかい字でビッシリ書いて、しっかり中心に巻き締めてありました」「フウム！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "脱げば――フッサリと切り下げた根元、色糸で巻き締めたのが凛としている。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "上をギリギリ巻き締められているのでお弓さんの両手はぼくを抱えていた。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の体は、鼓のように、細紐で巻き締めてあって、左の乳の下に、鮫柄の短刀が、根まで突きとおして、抜かずにある。",
              "citation": {
                "source": "牢獄の花嫁",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「Ｈ・Ｓ製罐工場」では、五ラインの錻刀切断機、胴付機、縁曲機、罐巻締機、漏気試験機がコンクリートで固めた床を震わしながら、耳をろうする音響をトタン張りの天井に反響させていた。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "切断機、胴付機、罐縁曲機、罐巻締機、空気検査機などがその機械で、トップの方は錻力圧搾機、波形切断機、と蓋の溝にゴムを巻きつける護謨塗機がある。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
