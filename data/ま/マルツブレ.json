        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大勢の前で部下に間違いを指摘され、部長の面目は丸つぶれだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "接待の席で無作法な振る舞いをしてしまい、紹介してくれた知人の顔が丸つぶれだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "自分が一番だと豪語していたのに、新人に負けてしまっては威厳も丸つぶれだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
