        "examples": {
          "standard": [
            {
              "text": "1950年代のアメリカでは、マッカーシズムによる赤狩りが猛威を振るった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "根拠のない告発で相手を社会的に抹殺する手法は、現代のマッカーシズムとも言える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "映画監督の彼は、マッカーシズムの標的となりハリウッドから追放されてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "世界にマッカーシズムが跡をたたない今日、決して陳腐な感想としてよみ去ることが出来ない。",
              "citation": {
                "source": "モンテーニュ随想録",
