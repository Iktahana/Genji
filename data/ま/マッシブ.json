        "examples": {
          "standard": [
            {
              "text": "そのロボットは、マッシブなボディで迫力があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の最新作は、マッシブなスケールで描かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このゲームには、マッシブな敵キャラクターが登場する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "すっかり夜になり、自働車を降りて、更に落合楼に下る急な坂路にかかると、思いがけず正面に輪廓丸い二連の山、龍子の墨絵のようにマッシヴに迫り、こわい程遙か底に宿の小さい灯かげ、川瀬の響あり。",
              "citation": {
                "source": "湯ヶ島の数日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "丼を置いてハンカチーを取出そうとしてオーヴァのポケットに手を入れたとき、思いがけなくマッシヴなものが入っているのに愕いた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "車輪が分岐点と噛み合っているらしくガタンガタンと騒々しい音をたてたのと、車輌近くに陸橋のマッシヴな橋桁がグオーッと擦れちがったのとが同時だった。",
              "citation": {
                "source": "省線電車の射撃手",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "処で映画はその動作の選択と背景や情況の選択とが非常に自由で奔放であり得るから、自然とこのユーモアをマッシヴにモリモリと過剰にすることが出来る。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
