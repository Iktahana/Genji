        "examples": {
          "standard": [
            {
              "text": "その法案は、議会の「マジョリティー」によって可決された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「我々は「マジョリティー」の意思を尊重し、建設的な議論を続けるべきだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "選挙結果は、「マジョリティー」が現在の政権に支持を与えたことを示していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "どちらかといえば決して金持ちではないアングロサクソンの世帯持ち、つまり、サイレント・マジョリティの世界が、ここにある。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば個人主義はアメリカのシンボルのひとつなのだが、この個人がまとめられてアメリカ社会としてひとつになると、個人は個人ではなくなり、マジョリティというひとつのあたらしい怪物となる。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が怪物の一部分ではないのか、という新鮮な疑問を持つことは、個人は生まれながらにして平等であるというアメリカ原理にそむくことなので、マジョリティのなかの個人は、疑問を持つことを知らない愚鈍な消費者として、それにふさわしい穴のなかにはめこまれることになる。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親は、サイレント・マジョリティのカリカチュアのひとつみたいな顔をしているが、母親のグラディスはひとめで移民であることがわかる顔立ちであり、なにごとかに対する動物的に鋭い不満を常に持っているような口をしていた。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
