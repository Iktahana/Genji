  {
    "uuid": "631cbd4d-b4f0-5419-b9bb-b65e7aedd1d3",
    "entry": "真っ逆様",
    "reading": {
      "primary": "まっさかさま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
      "ctype": null,
