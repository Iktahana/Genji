          "literary": [
            {
              "text": "トトサン、御無事デ、エエ、マタア、カカサンモ。",
              "citation": {
                "source": "花火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "では、マタアシタ（これは太郎が夕方友達とわかれるあいさつ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシタマタアソバウヨ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "………従来僕ガ妻ノ貞節ヲ信ジテ疑ワナカッタ一ツノ理由ハ、彼女ガドンナ場合ニモ僕トノ情交ヲ拒マナイガ明ラカデアル時ニモ、ソノ夜夫カラ挑マレテ怯ム色ヲ見セタガアッテ夜ニ及ンデマタアッタトシテモ、―――ソウイウ日ガ数日続イタトシテモ平気ナ体質ナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
