        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「このお方は神学博士ヘルシウス・マットン博士でありましてカナダ大学の教授であります。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "マットン博士はしずかにフラスコから水を呑み肩をぶるぶるっとゆすり腹を抱えそれから極めて徐ろに述べ始めました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」咆哮し終ってマットン博士は卓を打ち式場を見廻しました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "落ちついて祭壇に立ってそれから叮寧にさっきのマットン博士に会釈しました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘルシウム・マットン博士の御所説は実に三段論法の典型であります。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをもし私たちから見た善と解釈するとき始めて先刻のマットン博士の所説を生じます。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "神の摂理である善である然るに何故にマットン博士は東洋流に形容するならば怒髪天を衝いてこれを駁撃するか。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに至って畢竟マットン博士の所説は自家撞着に終るものなることを示す。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "終に臨んで勇敢なるマットン博士に深甚なる敬意を寄せます。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マットン博士の神学はクリスト教神学である。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "マットン博士のように誤った摂理論を出さなくてもよろしい。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "警務班長のマットン中佐が先頭にたち、あとにはヨコハマ・ジャックなどの荒くれ男が四、五人つきしたがい、その一行の真中には、半裸体のまま両手に手錠をかけられたわが勇士、杉田二等水兵がひったてられているのだった。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "マットンチャプといって背の肉を薄く切っておきます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
