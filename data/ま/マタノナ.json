    "definitions": [
      {
        "index": 1,
        "gloss": "alias",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その怪盗は、ある時は紳士、またの名を伝説の詐欺師として世間を騒がせていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この植物は「カタバミ」というが、またの名を「鏡草」とも呼ぶ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は売れっ子作家だが、またの名を敏腕経営者としての一面も持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "肩を掴んだのは「ヒンブルのお加代」――またの名「兵古帯のお加代」だ。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっちや」　　　　青蛇団　ヒンブルのお加代――またの名を兵古帯のお加代が、鴈治郎横丁界隈で、大阪の南の空で流星を見て、「――豹吉！",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "但愛のためには必ずしも我といふ一種勝手次第なる観念の起るものにあらず、完全なる愛は「無我」のまたの名なり。",
              "citation": {
                "source": "愛と婚姻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　聞くと……真鍮台、またの名を銀流しの藤助と言う、金箔つきの鋳掛屋で、これが三味線の持ぬしであった。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですからいちばんはじめには、日本のことを、大八島国と呼び、またの名を豊葦原水穂国とも称えていました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その八代目のお孫さまのお子さまに、大国主神、またの名を大穴牟遅神とおっしゃるりっぱな神さまがお生まれになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "火遠理命はまたの名を日子穂穂出見命ともお呼び申しました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇はその仁番、またの名、須須許理のこしらえたお酒をめしあがりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "大郎女は世にまれなお美しい方で、そのきれいなおからだの光がお召物までも通して光っていたほどでしたので、またの名を衣通郎女と呼ばれていらっしゃいました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "野槌は最初神の名で、諾冉二尊が日神より前に生むところ、『古事記』に、野神名｜鹿屋野比売、またの名｜野椎の神という。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "『日本紀』に、草祖草野姫またの名｜野槌と見えて草野の神だ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "またの名を白足和尚と呼ばれただけあつて、足の色が顔よりも白く滑らかで、外を出歩く時雨上りの泥水の中をざぶざぶと徒渉りしても、足はそれがために少しも汚されなかつたといふことだ。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "坪内博士と勲二等10・23（夕）　ラフカヂオ・ハアンまたの名小泉八雲氏が、日本の美しい夢のやうな一面を、立派な作物で世界に紹介して呉れたのは、吾が国民の感謝に堪へない次第である。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "甘草、またの名は忘れ草を活ける、百合よりも野趣がある。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "またの名は庭※、字は飛卿である。",
              "citation": {
                "source": "魚玄機",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "糸は「いわない」またの名を「きんかん」というのが最もよいとしている。",
              "citation": {
                "source": "凧の話",
                "author": "淡島寒月",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はまたの名を扇遊とも云って、英一蝶とは親友であったが、人を殺した事さえある胆の太い兇悪な男である。",
              "citation": {
                "source": "紅白縮緬組",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十四年　五月二十四日）春の暮　庭石菖、またの名は草あやめの真盛りである。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、木曾九万一という、またの名、クマちゃんでとおっている、身体の大きな腕ぷしのつよい少年であった。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この花は、またの名をシュトデンテンともいいます。",
              "citation": {
                "source": "十二人兄弟",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬籠の青山｜庄三郎、またの名｜重長（青山二代目）もまた、徳川｜方に味方し、馬籠の砦にこもって、犬山勢を防いだ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノコの中にはハハキタケ（ホーキタケ）一名ネズミタケ（またの名ネズタケ）の様に叢生している者があるのでそれで草の茸々と叢生する有様に見立てられそこで我邦で茸がキノコという様に成ったに外ならないのである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私、またの名は白……」　新十郎は笑みに応じてさえぎった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳴雪、飄亭の二君は相ついで吉田の虚桐庵またの名双松庵を訪問した。",
              "citation": {
                "source": "子規居士と余",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "出尻伝兵衛、またの名を「チャリ敵」の伝兵衛ともいう、神田｜鍋町の御用聞。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "萩寺の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "口さがなき下女どもはこの人のまたの名を大名縞のお客様といひはやしぬ。",
              "citation": {
                "source": "葛のうら葉",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "□最御崎寺、またの名を“東寺”は、山の上にあつた。",
              "citation": {
                "source": "にはかへんろ記",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我がガラッ八――捕物の名人、銭形平次の子分で、本名を八五郎、またの名をガラッ八という人気男――が、親分の用事で庚申塚の辺まで行った帰り、フト、畑の中の人だかりを見付けて、鼻の下を長くして嗅ぎ廻った挙句、半刻ばかりの間にこれだけのネタを挙げてしまいました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "人肌地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "エルサレムよりサマリヤを経て一路エニンに到る迄、常に山上、または峡谷を過ぎて来り、エニンより一歩北すれば忽ち下ガリラヤの野、パレスタイン第一のエズレル平原、またの名エスドレロン平原に下りぬ。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
