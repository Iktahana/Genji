    "definitions": [
      {
        "index": 1,
        "gloss": "maiko",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "京都の祇園では、華やかな舞妓さんの姿を見かけることができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は、伝統芸能を学ぶために舞妓の道を選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「わあ、本物の舞妓さんだ！すごく綺麗！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "平安朝このかた一千年の伝統をだらりの帯に染め出しているような京の舞妓に「オープンでドライヴおしやしたらどうどす」などといわれると腹の底までくすぐったい感じがする。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は、カンボジヤ女、シソワットの居城、王宮付舞妓であった。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺が初めて愛子の長い髪を撫でたときは、まだ十八の舞妓であつた。",
              "citation": {
                "source": "畜生道",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "室宇宏麗、後房數百人の舞妓、皆綺※を飾り、金翠を珥む。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰どっしゃろ」　と、鼻の低い妓は感に堪えていたが、急に、あ、そや、判ったと膝をたたいて、「――ひょっとしたら、鈴子はんどっせ」　鈴子は「文の家」から出ている十七歳の舞妓で、やがて襟がえをすれば、先斗町をうならせるだろうと言われるくらい、可愛いい顔立ちだった。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて先斗町にからこという舞妓がいて、評判になったが、鈴子には往年のからこにはなかった清楚なういういしさがあった。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉井正太郎は、こんどは誰をつかまえて、リーダーズ・ダイジェスト仕込みの話をしかけようかと一同の顔を見ていたが、男はみなだめだと判ると、稲福という舞妓をつかまえて、「君、ええ話教えたげよか。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君勇もいいが、鈴子もいい」　舞妓を一本にするには、君勇の旦那になるのとは較べものにならぬくらい金がいるが、それぐらいの金は小郷にとっては、何でもなかった。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この男は世の中に怖いものがないのであろうか」　弓子はピシャリと小郷の顔を撲りたい衝動を感じながら、「それから、もう一つ投書が来てるんですが……」「あはは……小郷虎吉ついに投書欄の人気者になったか」「投書の内容は、実は……」　居並ぶ芸者や舞妓の顔を、素早く見廻して、弓子はズバリと言った。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "小郷虎吉が君勇や市龍や鈴子や弓子を連れて、キャバレー歌舞伎のホールへはいって行った時、イブニングドレスとジャズとステップの雰囲気の中で、最も新しい色彩を放ったかと、ふと錯覚を起させたのは、君勇の古風な島田であり、鈴子の舞妓姿であった。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "島田や舞妓姿の時ならぬホールへの侵入という不意打ちの効果は、新スタイルのイブニングドレスさえふと古風に見せたくらい、それほど新しい感じがあった。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいいち、はじめて呼んだ舞妓を、いきなりその夜、いわゆる襟替えさせてしまうなんて、殆んど例のないことである。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ところが、おれは芸者や舞妓を道具に使って儲けた金で悠々と飯を食ってるじゃないか」　だから家庭教師になろうとしたのだ。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、舞妓というものが結局「旦那」というものによって、処女を失い、めでたく一本の芸者にならねばならぬ――という悲しい運命を背負わされていることを知っていた。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、ふだんそんなことを考えもしないくらい、無邪気な人形となって、うかうか暮しているのが、舞妓というものだった。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴子はんのこと……」「…………」「鈴子はん今晩どないなるか知っといやすか」　言いながら、君勇は自分が舞妓の時、はじめて旦那を取った晩のことを想い出して、しびれるような感傷に胸が温まり、声がうるんだ。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸者の子と生れて、自然に舞妓になってしまった自分の運命をただなげくよりほかに、何を恨もうか。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "可憐な舞妓の写真が陳列されているのを見たのだ。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれはなんという舞妓……？",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先斗町の鈴子いう舞妓はんどす」「ふーん」　小田は暫らくその写真を見ていたが、やがて、「これを売ってもらえますか」「どうぞ」　鈴子の写真を買って宿へ帰ると、間もなく女中が夕刊を持って来た。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「鈴子も舞妓をやめてしまいました。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴子は舞妓をよしたんだってね」「いや、いいんです。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――じゃ、餞別にこれをあげよう」　小田は花遊小路で買って来た鈴子の舞妓姿の写真を、鶴雄の前に出した。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰭は神女の裳のように胴を包んでたゆたい、体色は塗り立てのような鮮かな五彩を粧い、別けて必要なのは西班牙の舞妓のボエールのような斑黒点がコケティッシュな間隔で振り撒かれなければならなかった。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "若きうかれ男、舞妓白萩。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ち所化長順群より離れ、舞台の中央に来り、舞妓白萩にすれ違ひ、長順　ふつ、其方は……白萩袖を翳して退く。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞妓白萩をろをろとして之をかばふ。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下の障子の開く音して、すらすらと足袋摺に、一間を過ぎて、また静にこの襖を開けて、「お召し、」　とそこへ手を支いた、裾模様の振袖は、島田の丈長、舞妓にあらず、家から斉眉いて来ている奴であった。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸妓、舞妓は左右に開く。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "白の狩衣、紅梅小袖、灯の影にちらちらと、囃子の舞妓、芸妓など、霧に揺据って、小鼓、八雲琴の調を休むと、後囃子なる素袍の稚児が、浅葱桜を織交ぜて、すり鉦、太鼓の音も憩う。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
