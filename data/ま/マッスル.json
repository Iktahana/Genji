          "standard": [],
          "literary": [
            {
              "text": "下劣なる趣味を拘泥なく一代に塗抹するは学人の恥辱である。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋愛は各人の胸裡に一墨痕を印して、外には見ゆ可からざるも、終生｜抹する事能はざる者となすの奇跡なり。",
              "citation": {
                "source": "厭世詩家と女性",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋愛は各人の胸裡に一墨痕を印して外には見る可らざるも、終生｜抹すること能わざる者となすの奇蹟なり。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ひ切つて塗抹するやうなところが氏の特色だ。",
              "citation": {
                "source": "或新年の小説評",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "木炭はその尖端を使用し、時には木炭の横腹を以て広い部分を一抹する事もよろしい。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            }
          ]
        }
