    },
    "definitions": [
      {
        "index": 1,
        "gloss": "invitation",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "結婚式の招きを受けたので、週末は実家に帰省する予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はパーティーの招きを快く受け、喜んで出席することを伝えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その美術展の招き状は、世界中のコレクターに送られたという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "だが、友達として一言忠告させて貰ふなら、その生活ぶりに、時として余りに野放図なものがあるので、謂はば必要以上に衰弱して居る日があつて、そんな日に出来た詩は、あの感覚と同居しにくい抽象概念を招きすぎて、読者を混乱させる場合がある。",
              "citation": {
                "source": "草野心平詩集『母岩』",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ、乙姫さまのお招きだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、恁う、お招きなさるやうに見えるんですもの。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お招き通りやって来たよ。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとそのアーティストは向ふで手のあいてゐる二人のアーティストを指で招きながら云ひました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "檣の方に身を突きいだして、御問いに答えまいらすはやすし、こなたに進みてまず杯を受けたまえといえば、二郎は、来たれ来たれと手招きせり。",
              "citation": {
                "source": "おとずれ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "柿江は本当に恐ろしがって招き猫のような恰好をした）乱暴はよせよ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る晩、勃凸が大森の方に下宿するから、送別のために出て来ないかといふ招きが来た。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "用事のある客が来たのを招き入れて用談かたがたお茶を飲むときもありますが、どうもあとで、はっきりお茶を飲んだ気がしません。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから二日ばかり経って日比野の母親から、お八つを差上げ度いからお涌に遊びに来るようにと招きがあった。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "袖でうけつつ、手で招きつつ、「花が散るよ、散るよ。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト向直つて、元二の顏をじろりと見るやうにして招き、と云ふ形で蹲んだが、何故か無法に憎かつた。",
              "citation": {
                "source": "二た面",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お雪は細い音に立てて唇を吸って招きながら、つかつかと出て袂を振った、横ぎる光の蛍の火に、細い姿は園生にちらちら、髪も見えた、仄に雪なす顔を向けて、「団扇を下さいなちょいと、あれ、」と打つ。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとその人は向うで手のあいているもう二人の人たちを指で招きながら云いました。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お招きにあずかりまして大へん恐縮です。",
              "citation": {
                "source": "紫紺染について",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭司次長が又祭壇に上って壇の隅の椅子にかけ、それから一寸立って異教徒席の方を軽くさし招きました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると私たちの席から三人ばかり祭司次長の方へ手をあげて立った人がありましたが祭司次長は一番前の老人を招きました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、いふと武村兵曹は小首を捻つて『そこで、私の心配するのは、義侠な大佐閣下は、吾等の大難を助けやうとして、御自身に危險をお招きになる樣な事はあるまいか。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "振返ってみると、なるほど、梅ヶ谷のような大女、顔を真白に塗立てた人三｜化七が、頻りに手招きしながら追っ掛けて来る。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史を繰返して見よ、戦勝の結果却つて亡国の非を招きし国は、古来其実例に乏しからず、戦勝つて士気大いに奮ひ、駿々として驚くべき勃興発展を為す国あり。",
              "citation": {
                "source": "警戒すべき日本",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人が手招きをした。",
              "citation": {
                "source": "怨霊借用",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　婦人は振返りて手招きすれば、待たせたりし一人の車夫、腕車を曳きて近寄りぬ。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と手招きすれば、先より気色を窺いたる、（じゃむこう）衝と来たる。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "美人は渠の言うがままに車を下れば、「どうかこちらへ」と御者はおのれの立てる馬のそばに招きぬ。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中に高い高い大きな大きな金剛石の御殿が建っていて、その中にあのお伽噺の中にある竜宮の乙姫様のような美しいお嬢さんがこちらの方を見て手招きをしております。",
              "citation": {
                "source": "雨ふり坊主・先生の眼玉に・奇妙な遠眼鏡",
                "author": "香倶土三鳥（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "謂わば死に神の手招きに吸い寄せられるように、私は何の理由もなく、佐渡にひかれた。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは何事かを思い詰めると、狂人の如くその一念に凝り固まり、理想に淫して現実を忘却してしまうために、遂には身の破綻を招き、狂気か自殺かの絶対死地に追い詰められる。",
              "citation": {
                "source": "老年と人生",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お酉樣の熊手の裝飾、まねき猫、あんな幼い、悲しくやりきれないものを感じました。",
              "citation": {
                "source": "國技館",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　吉永は、少女にこちらへ来るように手まねきをした。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥った赤ら顔の快活そうな老西洋人が一人おり立って、曲がった泥よけをどうにか引き曲げて直した後に、片手を高くさしあげてわれわれをさしまねきながら大声で「ドモスミマシェン」と言って嫣然一笑した。",
              "citation": {
                "source": "あひると猿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
