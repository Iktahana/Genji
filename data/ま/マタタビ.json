      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "silver vine (Actinidia polygama)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "飼い猫の誕生日に木天蓼をプレゼントしたら、すっかり興奮して床をごろごろ転げ回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "山登りの途中で、白い葉が特徴的な木天蓼の群生を見つけて、思わず足を止めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昔から「猫に木天蓼」と言われるほど、この植物は猫を夢中にさせる不思議な力がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それからまもなくある日縁側で倒れて気息の絶え絶えになっているのを発見して水やまたたびを飲ませたら一時は回復した。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十七　夫人はわずかに語るうちも、あまたたび息を継ぎ、「小児と申しても継しい中で、それでも姉弟とも、真の児とも、賢之助は可愛くッてなりません。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて座敷で介抱して、ようよう正気づくと、仁右衛門は四辺を※し、あまたたび口籠りながら、相済みましねえ、お客様、御出家、宰八｜此方にはなおの事、四十年来の知己が、余り気心を知らんようで、面目もない次第じゃ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、あまたたび額の汗を拭った。",
              "citation": {
                "source": "革鞄の怪",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――たちまち鉄砲の音、あまたたび――薄　それ、皆さん。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと足遅れてのぼり来る姫の息｜促りて苦しげなれば、あまたたび休みて、漸う上にいたりて見るに、ここはおもひの外に広く、めぐりに低き鉄欄干をつくり、中央に大なる切石一つ据ゑたり。",
              "citation": {
                "source": "文づかひ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと足遅れてのぼり来る姫の息せまりて苦しげなれば、あまたたび休みて、ようよう上にいたりて見るに、ここはおもいのほかに広く、めぐりに低き鉄欄干をつくり、中央に大なる切り石一つすえたり。",
              "citation": {
                "source": "文づかい",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "食卓に就きて程經ぬるに、ジエンナロのみ來ざりければ、フランチエスカの君は心を勞し、公子はあまたたび人を馳せて、その歸るを候はせぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　丹平もしめやかに頷くことあまたたび、「成程々々成程。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "からだらしがねえ、またたびだね、鼠のてんぷら、このしろの揚物だ。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "王の昼寝し玉ふときは、近衆みな却けられしが、囈語にマリイといふこと、あまたたびいひたまふを聞きしもありといふ。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "文句というものは、またたびと同じようになかなか調法なものさ。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫にまたたびの諺はかねて聞いていたが、その花を見るのは今が初めであった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "日頃は人の問ひくるもうるさく、人にもまみえじ、人をも招かじと、あまたたび心にちかふなれど、月の夜雪のあしたのみ友の慕はるゝもわりなしや。",
              "citation": {
                "source": "芭蕉",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "またたびたび来ますよ。",
              "citation": {
                "source": "舌切りすずめ",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さればこそあまたたびの対面に人げなき折々はそのことゝもなく打かすめてものいひかけられしことも有しが、知らず顔につれなうのみもてなしつるなり。",
              "citation": {
                "source": "樋口一葉",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "その女が前を横切る度毎に、桐の木の根方に土下座をして、あまたたび礼拝を捧げておりまする髯だらけの大男は、長崎の某小学校の校長で御座います。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨今、著しく一般の注意をひくようになって参っておりますかの果物の方面にしましても、りんごや梨の栽培も決して悪いとは申しませんが、私は「くるみ」とか「くり」とかないしは「さねかずら」「しらくちづる」「またたび」等のいわゆる「山果」とも申すものの栽培に御注意を願ったらと考えているのでございます。",
              "citation": {
                "source": "自力更生より自然力更生へ",
                "author": "三澤勝衛",
                "note": "青空文庫"
              }
            },
            {
              "text": "闇太郎は、あるいは怒りあるいは歎き、悲愴な雪之丞の身の上ばなしに、耳を傾けて、あまたたびうなずいたが、「おお、そういうお前さんだったか？",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "新潟からまたたびの漬けたのを貰った時母が「よくしまったとき。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞けば大層壁紙を破ることが好きで、またたびたび木器の脚を噛る。",
              "citation": {
                "source": "兎と猫",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "という住職の申渡しが、お絹をして、してやったりと心の中で舌を吐いて、うわべに拝むばかりに有難がらせ、あまたたび、住職に拝礼して、いそいそとして千隆寺から帰って来ました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかなかしたたか者でございますぜ、わっしの眼の届く奥州五十四郡のうちには、まずそんなしたたか者はございませんから、つまりそれは、旅烏の、風来者の――といって、またたびで賽の目をちょろまかそうという三下奴の出来損いにやれる芸当じゃございません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、近時猫の奴の少なくなったのには困却したが、今夏は越後国南魚沼郡浅貝付近の山中から、またたびの実を採集して来て、これを塩漬けにして蓄え、毎夜垣の破れ目の内側へ一箇ずつ落として置くと、俄然大いに成績を盛り返したね。",
              "citation": {
                "source": "岡ふぐ談",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "他児を乳し、朝昼夕に変眼、鼻頭常に冷たく、死ぬとき身を隠し、またたびを好み、これをからだに塗りつける。",
              "citation": {
                "source": "岡ふぐ談",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀行賭戯ですか」　そこで二人は、今までの仔細を手短かに述べると、公爵はあまたたびうなずいて聞いていたが、やがて、空を見上げて雲の流れを見、そばの松の樹の幹に掌を当てて、何かしばらく考えていたが、「今日は南が吹いていますね。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "南風吹かば　――モンテ・カルロの巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ふかいつづら笠に面体は隠れて、編目の隙に、きらりと眼が光るだけだが、道中合羽に紺脚絆、あらい滝縞の裾を尻端折って、短い刀を一本ぶっ差した二十七八のまたたび姿。",
              "citation": {
                "source": "煩悩秘文書",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "前にちょっと述べた通り長享二年からの催促には、ひととおりならぬ手数をつくしたもので、義尚将軍薨去につき土岐右京太夫が斎藤越後守を従えて四月入洛し、土岐は芬陀利花院に、斎藤越後守は東福寺に宿営すると、早速にまたたびたび催促の使者を差し向けた。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも政党内閣の代になつて、先生が外務大臣にでもなりや、僕はさしづめ英仏の、公使位には登用されるんだ、その内にやあまたたびたび交迭があつて、いつかは内閣の椅子も、譲られうといふもんだ。",
              "citation": {
                "source": "誰が罪",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "またたびたび左のようなことがあった。",
              "citation": {
                "source": "孔乙己",
                "author": "魯迅",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
