        "examples": {
          "standard": [
            {
              "text": "彼はマスターベーションを恥ずかしい行為だと考えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "マスターベーションは、多くの人にとって自然な行為の一つだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ストレス解消のためにマスターベーションをする人もいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "いずれにしても、己惚れと精神的マスターベーションを捨てること。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから彼の作品はマスターベーションであるにすぎず、真実彼を救ふもの高めるものではなくなつてゐた。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月二十九日（木）推定脳細胞総数　１４９億３９００万個　一番ヶ瀬隼人は窓から差し込むうすくやわらかい日の光で目を覚し、毛布の中で陽子に思いを馳せながら二回マスターベーションに耽った後ようやくベッドから抜け出してシャワーを浴び、それが済むとオーブンにサンドイッチを入れてタイマーを５にセットした。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はその日はじめてマスターベーションを覚えた……。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
