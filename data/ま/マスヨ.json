        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "之以上グズグズイウナラ私今清三ヲ起シテ来マスヨサア放シテ頂戴」　トイッテ、私ヲフリ切ッテ二階ニ上ッテ行ッテ了イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「十方三世ノ諸仏、ナラビニ本師釈迦牟尼仏、本来ノ願望ハ遂ゲザレドモ、父母、朋友、信者ノタメ、イマイチド生レ変ッテ仏法ノ恩ヲ報ズルコトガデキマスヨウニ」――この手が岩角から離れたときが今生の命の終りと、朦朧と偈をとなえていると、テンバが精気の霊薬だというコカの葉を智海の口もとにさしつける。",
              "citation": {
                "source": "新西遊記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンガ颯子トノ結婚ニ反対シタ当時、「踊リ子上リナンゾッテ云ウケレド、キット彼女ハ家政ノ切リ盛リナンカモ上手ニヤッテ行キマスヨ、ソウ云ウ才能ノアルコトヲ僕ハ見抜イテルンデス」ト浄吉ハ云ッタガ、アノ時ハ恐ラク当寸法ヲ云ッタノデ、先見ノ明ガアッタ訳デハアルマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サッキハ上ガ二二三、下ガ一五〇アッタンデゴザイマスヨ」「ソンナコトモタマニハアルデショウナ」「タマニダッテコンナコトガアッチャ大変デゴザイマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト乳母ガ、「ホラ、督チャン、モウ秋デゴザイマスヨ、蟋蟀ガ鳴イテオリマスヨ」ト、ソウ云ッタモノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホラ、アノ声ヲ聞イテルト、『肩｜刺セ裾刺セ、肩刺セ裾刺セ』ト云ッテルヨウニ聞エルデゴザイマショ、モウアノ声ガ聞エ出シタラ秋ナンデゴザイマスヨ」ソウ云ワレルト、気ノセイカ寝間着ノ白地ノ単衣ノ筒袖ヲ肌寒イ風ガ冷エ／″＼ト通リ抜ケルヨウナ気ガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御老人ニハヨクアルコトデゴザイマス」「ジャ、君ハ前カラ知ッテタノカ」「ハア、近頃ハ毎朝伺ッテオリマシタ、ピイピイッテ、オ可愛ラシイオ声デ」「婆サンニモコノ声ヲ聞カシテヤロウ」「知ッテラッシャイマスヨ、ソンナコト」「颯子ガ聞イタラ笑ウダロウナ」「若奥様ダッテ御存知ナイコトガアルモンデスカ」五日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンダッテソウナンダカラ、ウチノ子供ハ可哀ソウダヨ」「ダケドプールガ出来タ以上ハ経チャンダッテ飛ビ込ミマスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヘー、颯子ガ伺ッテハ悪インデスカ」「颯子バカリジャナイ、陸子ナンゾ見舞ニ来ヤガッタラ承知シナイゾ」「ソリャ分ッテマスヨ、イクラ痛イト仰ッシャッテモ手ノコトダカラ心配ハナイ、オ前サンハ遠慮シナサイッテ、コナイダモ陸子ヲ追イ返シタンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何デモ親父ノ云ウ通リニシロッテ」「ヨゴザンストモ、キット申シツケトキマスヨ」………彼ガ彼女ニドンナコトヲドンナ風ニ云イツケタノカ知ラナイ、ソノ晩ノ十時過ギニ颯子ガヒョッコリ這入ッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「佐々木サンカラ伺イマシタガ、大丈夫デスカオ爺チャン、オ痛イコトハオ痛イデショウガ、ソンナコトヲナサラナイデモ今ニキット直リマスヨ」婆サンハ気ガ気デナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニヨクナリマスヨト婆サンハ云ッタガ、ドウヤラコウヤラ少シ楽ニナリカケテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………「少シヨクナルト直グソレダカラオ爺チャンハ困リマスヨ、モウ暫ク様子ヲ見テカラニナスッタラドウ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャン、階段ハ僕ガ負ッテアゲマスヨ」菊太郎ガ予ノ前ニシャガンデ背中ヲ向ケル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソバデ煙草ヲオ吸イニナッタラ、ゴホン／＼オ咳ガ止マラナクナリマスヨ」「ボーイサン、ソノトランクヲコッチノ部屋ヘ運ンデ頂戴」颯子ハ構ワズサッサト隣室ヘ這入ッテ行ッテシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「久シュウオ目ニカヽリマセンデシタガ、相変ラズオ元気デイラッシャイマスナ」「ナアニ、チットモ元気ナコトナンカナイヨ、今度ハ京都ヘ自分ノ墓地ヲ捜シニ来マシタ、イツ死ンデモイヽヨウニネ」「御冗談デショウ、ソノ勢イジャアマダ／＼大丈夫デイラッシャイマスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
