        "examples": {
          "standard": [
            {
              "text": "彼は長年の町住まいから、田舎暮らしに憧れていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "町住まいならではの便利さが魅力だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は町住まいをしながら、週末は自然の中で過ごす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「まだ町住いの事は御存じないのだから、失礼ながらわたしたち夫婦でお指図をいたして上げます」といったのである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉野は勝久の事を町住いに馴れぬといった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「舟宿の亭主も悪くはないだろう」「残念ながらそのようでございます」「うちあけて云えばそれもあったのだ」正篤は紫色に染まった唇で微笑する、「――さっき申したことも事実だが、もう一つはおまえを侍にさせたくなかった、屋敷勤めより、町住いのほうがおまえには似合っている。",
              "citation": {
                "source": "桑の木物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
