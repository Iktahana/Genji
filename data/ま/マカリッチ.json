          "literary": [
            {
              "text": "せんには、お母さんと一しよに、ゐなかの村のマカリッチさまといふ、だんなのうちにおいてもらつてゐました。",
              "citation": {
                "source": "てがみ",
                "author": "アントン・チエーホフ　Anton Chehov",
                "note": "青空文庫"
              }
            },
            {
              "text": "だれよりも大すきな、あのマカリッチのだんなへ出さうとおもひついたのです。",
              "citation": {
                "source": "てがみ",
                "author": "アントン・チエーホフ　Anton Chehov",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンスタンチン、マカリッチのだんなさま。",
              "citation": {
                "source": "てがみ",
                "author": "アントン・チエーホフ　Anton Chehov",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをじつとみてゐると、マカリッチのだんなの姿が、ありありとガラスの中にうかび上つて来ました。",
              "citation": {
                "source": "てがみ",
                "author": "アントン・チエーホフ　Anton Chehov",
                "note": "青空文庫"
              }
            },
            {
              "text": "マカリッチのだんなは、年は六十五です。",
              "citation": {
                "source": "てがみ",
                "author": "アントン・チエーホフ　Anton Chehov",
                "note": "青空文庫"
              }
            },
            {
              "text": "マカリッチのだんなさま、おねがひだから、わたしをまた村へつれてつてください。",
              "citation": {
                "source": "てがみ",
                "author": "アントン・チエーホフ　Anton Chehov",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゐなかの、コンスタンチン・マカリッチの、だんなさま。",
              "citation": {
                "source": "てがみ",
                "author": "アントン・チエーホフ　Anton Chehov",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、あんな上がきでもつて、マカリッチさんのところへつくでせうか。",
              "citation": {
                "source": "てがみ",
                "author": "アントン・チエーホフ　Anton Chehov",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
