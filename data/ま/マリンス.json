        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――前マリンスキー歌劇場の女優、ナデジーダ・クルムスカヤである。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日、マリンスタジアムに練習始め。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と言ったり、剰さえ指をパチパチ鳴らして、彼のまわりを踊りまわりながら、『なんてお前は愛い奴だ、コマリンスクのお百姓！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　これはアンスバッハ市に当時在住した物理学者マリンスの、彼に関する述懐録の一部分である。",
              "citation": {
                "source": "痴酔記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ターニャ・イワノヴナはレーニングラードのマリンスキー劇場の第一舞踊手と結婚した。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリンスキーの舞踊手でどこか他の強靭な子宮の配偶者であった。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリンスキー、踊そのものはクラシックのテクニックで上手だが、眠れる美人、アレンジがつまらず、衣裳も色彩のロー費をして居る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕　夜十二時頃、マリンスキーからかえると、先が見えない雪降り。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本女は、古典的なマリンスキー劇場で、「眠り姫」を見るよりは遙か面白いと正直にいった。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリンスキー劇場のクシンスカヤという首席舞踊手に陶酔しているうちに男の子供が生れた。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "管弦楽曲では「カマリンスカヤ」がある。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
