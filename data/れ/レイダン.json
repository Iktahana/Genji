          "literary": [
            {
              "text": "達麿忌である、廓然無聖、冷暖自知。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "△豆腐の味は水のそれとおなじ、冷暖自知、いひがたし。",
              "citation": {
                "source": "行乞記",
                "author": "伊佐行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒の酔心地、これこそ冷暖自知の境。",
              "citation": {
                "source": "行乞記",
                "author": "伊佐行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "※五十知命、いひかへれば冷暖自知ではあるまいか。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "空を踏むがごとく、雲を行くがごとく、水中に磬を打つがごとく、洞裏に瑟を鼓するがごとく、醍醐の妙味を甞めて言詮のほかに冷暖を自知するがごとし。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局「冷暖自知」してもらうより他はないと思います。",
              "citation": {
                "source": "遺書",
                "author": "尾崎秀実",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の冷暖は古人も言つたやうに飲んで自知する外に仕かたはない。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の冷暖は飲んで自知する外はないと云ふ。",
              "citation": {
                "source": "芸術その他",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋館は階上階下とも冷暖房装置にし、日本間のほうは数寄屋造り。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "築地に、夕ぎりという、これも冷暖房完備の、女中美人多しの、スキヤキ屋が出来た。",
              "citation": {
                "source": "牛鍋からすき焼へ",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
