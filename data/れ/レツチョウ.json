          "literary": [
            {
              "text": "声もなき国の白楊、列長う両側に顫へわななき、色青き蝋の火のほの暗みおびゆるごとく、広きより狭み暮れゆく其果の遠き切目に、仄かなる噴水の香ぞひとり密かに泣ける。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "行列長さだけで二十丁。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "山王祭の大象",
                "note": "青空文庫"
              }
