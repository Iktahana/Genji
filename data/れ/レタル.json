        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "高邁ノ精神ヲ喚起シ兄ガ天稟ノ才能ヲ完成スルハ君ガ天ト人トヨリ賦与サレタル天職ナルヲ自覚サレヨ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、医学、神秘宗教、心理学の部門を過ぎて、古代文献学の書架の前に立ち、フィンランド古詩「カンテレタル」の原本、婆羅門音理字書「サンギータ・ラトナーカラ」、「グートルーン詩篇」サクソ・グラムマチクスの「丁抹史」等に眼を移した時だった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "固ヨリ削除セラレタル一行一句ト雖モ日本ノ法律ニ違反セル文字ニ非ルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "歐米革命論ノ權威等悉ク其ノ淺薄皮相ノ哲學ニ立脚シテ終ニ「劒ノ福音」ヲ悟得スル能ハザル時、高遠ナル亞細亞文明ノ希臘ハ率先其レ自ラノ精神ニ築カレタル國家改造ヲ終ルト共ニ、亞細亞聯盟ノ義旗ヲ飜シテ眞個到來スベキ世界聯邦ノ牛耳ヲ把リ、以テ四海同胞皆是佛子ノ天道ヲ宣布シテ東西ニ其ノ範ヲ垂ルへシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ斯ル建國ニモ非ズ又斯ル低能哲學ニ支配サレタル時代モナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ノ元首が賣名的多辯ヲ弄シ下級俳優ノ如キ身振ヲ晒シテ當選ヲ爭フ制度ハ、沈默ハ金ナリヲ信條トシ謙遜ハ美徳ヲ教養セラレタル日本民族ニ取リテハ一ニ奇異ナル風俗トシテ傍觀スレバ足ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ大西郷等革命精神ノ體現者世ヲ去ルト共ニ單ニ附隨的ニ行動シタル伊藤博文等ハ、進ミタル我ヲ解セズシテ後レタル彼等ノ貴族的中世的特權ノ殘存セルモノヲ模倣シテ輸入シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "則チ如何ナル國民モ間接税ノ負擔者ナラサルハナシト云フ納税資格ノ擴張セラレタル普通選擧ノ義ニ非ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "無償ヲ以テ徴集スル所以ハ、現時大資本家大地主等ノ富ハ其實社會共同ノ進歩ト共同ノ生産ニヨル富が惡制度ノ爲メ彼等少數者ニ停滯シ蓄積セラレタル者ニ係ハルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "既ニ都市ノ私有地ヲ許サザルガ故ニ、設定セラレタル地上權ヨリ利得ヲ計ルコトヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民自由ノ人權ハ生産的活動ノ自由ニ於テ表ハレタル者ニツキテ特ニ保護助長スベキ者ナリト云フモ其四。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ此ノ二者ノ制限ハ現今マデ放任セラレタル道徳性ヲ國家ノ根本法トシテ法律化スルニ過ギザルナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "工業ノ「トラスト」的「カルテル」的組織ハ資本乏シク列強ヨリ後レタル日本ニハ特ニ急務ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "又今囘ノ大戰ニ暴露セラレタル如ク日本ハ自營自給スル能ハザル幾多ノ工業アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人ハ惡用スベキ大資本ヲ奪ハレタルガ故ニ國家ノ物價調節ニ反抗シテ買占メ賣惜ミ等ヲナスコト能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現今ニ於テハ資本制度ノ壓迫ニヨリテ勞働者ハ自由契約ノ名ノ下ニ全然自由ヲ拘束セラレタル賃銀契約ヲナシツツアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ハ已ニ男子ノ能ハザル分科的勞働ヲ十二分ニ負荷シテ生レタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父生存シテ而モ父ニ遺棄セラレタル兒童亦同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父生存シテ遺棄セラレタル兒童亦同ジキハ凡テ此ノ理由ニ依ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只英語ホド普及セズシテ而モ英語思想以上ニ影響ヲ與ヘタル獨乙語ニ依リテ其ノ害毒ノ緩和セラレタル天裕ヲ有スルノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英語國民ノ淺薄ナル思想ヲ通ジテ空洞ナル會堂建築トシテ輸入サレタル基督教。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ最モ急進的ナル羅馬字採用ヲ決行スルトキ、幾分文字ノ不便ハ免ルベキモ言語ノ組織其者ガ思想ノ配列表現ニ於テ悉ク心理的法則ニ背反セルコトハ、英語ヲ譯シ漢文ヲ讀ムニ凡テ日本文ガ顛倒シテ配列セラレタルヲ發見スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等ニ示サルル如ク印度ニ起リタル亞細亞文明ハ世界ヨリ封鎖セラレタル日本ヲ選ビテ天ノ保存シタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵式體操ヲ廢止スル所以ハ、其形式亦實ニ丹田ノ充實ヲ忘レタル外形的整頓ニ捉ハレタルニ依ルモ一理由ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レヲ途方モナキ一夫一婦制ニ對スル反逆ト考フルハ、恰モ政治的特權者ニ向ツテ叫バレタル政治ノ自由ヲ平等ナル國民間ニ脱線セシメテ、相犯サザル各自ノ自由ヲ蹂躙スルコトモ等シク政治ノ自由ナリト云フ低能者ノ昏迷ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ニ對シ又ハ世界ニ對シテ勳功アル者ハ、戰爭政治學術發明生産藝術ヲ差別セズ、一律ニ勳位ヲ受ケ、審議院議員ノ互選資格ヲ得、著シク増額セラレタル年金ヲ給付セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮其者ノ歴史ガ示ス如ク、又清國ガ此レヲ屬國トセンガ爲ニ起リタル日清戰爭、及ビ滿洲ニ來タレル露西亞ガ其ヲ侵略セントセシガタメニ破レタル日露戰爭ニ示ス如ク、其ノ亡國タルベキ内外呼應ノ原因ハ統治者ガ日本タラザル時ハ露支兩國ノ焉レカナリシハ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ亞細亞ニ與ヘラレタル使命ハ英人ノ罪惡ヲ再ビスルヲ許サズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
