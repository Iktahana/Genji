        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "妾は案内された部屋に、レジオン・ド・ヌウルの勲一等の赤い略章をつけた肥大した肉体の恰好の好い一人の老人を見出すのでした。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のレジオン・ド・ヌウルはフランス政府が彼の東洋流の栄養法が人口の味覚を満足さした功労によって、エリゼェの大統領官邸で贈与された（彼は巴里で生物学を研究するかたわら党費を稼ぐために豆腐を製造販売していたので。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（２）　Chevalier ――フランスのレジオン・ドヌール勲位の第五等の勲爵士を言う。",
              "citation": {
                "source": "マリー・ロジェエの怪事件",
                "author": "『モルグ街の殺人事件』続編",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリーの日本人で、一番パリーのために尽した伴野商店の主人は、レジオン・ドヌウルをフランス政府から貰っているほどの人であるが、東京に帰ったとき、フランスの放送をして、ふと話がフランス人の悪い部分に触れたことがある。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "（杯を挙げる）神谷　　（これに応じて）レジオン・ドヌウルの健康を祝す。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "レジオン・ドヌウル！",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寿　　いちいちレジオン・ドヌウルを云ふなよ。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "耽美主義者、超人、居留外国人、社会主義の大臣、などが皆一致して、あのコルシカの将校が制定したレジオン・ドヌールへの叙勲を祝賀していた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらを制御するには、しゃぶるべき骨を、レジオン・ドヌール動章を、餌として投げてやれば十分だった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "態度の堂々たる人物で、レジオン・ドヌールの勲章を所有し、友人としては、二、三の大臣、一人の大司教、多くの上院議員、文芸界や財界の著名な人々、などをもってると言い、ある有力な新聞と懇意だと自称していて、相手の人柄にふさわしい高圧的なまた馴れ馴れしい調子を巧みに取ることができた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇帝の横顔像がレジオン・ドンヌールの勲章から除かれてからは、彼は決して彼のいわゆる制定服を着なかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "審査員の報告によって、国王はその発明者にレジオン・ドンヌールのシュヴァリエ章を付与した。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその胸甲の上に、レジオン・ドンヌールの銀の十字章をつけていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「汝は今より大佐であり、男爵であり、レジオン・ドンヌール勲章のオフィシエ受賞者だぞ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "国王ルイ十八世は一百日（訳者注　ナポレオンの再挙の間のこと）のうちに起こったすべては無効であると考えていたので、彼に対しても、レジオン・ドンヌール勲章のオフィシエ受賞者であることも、大佐の階級も、男爵の肩書きも、少しも認めてはくれなかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして外出する時にはいつも、レジオン・ドンヌール勲章のオフィシエの略綬をそれにつけていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャール十世のように国民軍の服をつけ、ナポレオンのようにレジオン・ドンヌール勲章の大綬をつけていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃はヴァランも、女だてらにレジオン・ドヌールかなんかを貰って、フランスの国宝的な芸術家になりすまし、舞台を退いて、子弟を教えているということだ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
