        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "隣のテエブルでは誰かがケレンスキイを論じ出した。",
              "citation": {
                "source": "饒舌",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレンスキイ一派の第一革命にしても、過激派の今回の暴挙にしても、昔の仏蘭西革命が酸鼻の跡の多いのに反して出来るだけ流血の悲劇を示さずに目的を達することに一致しております。",
              "citation": {
                "source": "三面一体の生活へ",
                "author": "与謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの顔触を見て、戦時の英露二国に、ロイド・ジョオジとケレンスキイとが出現した当時の百分の一の緊張をも感じることが出来ませんでした。",
              "citation": {
                "source": "三面一体の生活へ",
                "author": "与謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中にたった二つの黒い点、オニエギンとレンスキイが、真黒な二羽の鴉のように、不吉な嘴を向き合せていた。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レンスキイの身体が枯木のように雪の中に倒れ伏した。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台では、今死んだはずのレンスキイがむっくりと飛び上った。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
