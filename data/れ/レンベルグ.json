        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "手紙で返事を寄こして、僕、寡聞にして、ヘルベルト・オイレンベルグを知りませず、恥じている。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘルベルト・オイレンベルグさんは、そんな愚かしい家庭のトラブルなど惹き起したお方では無いのであります。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚だ概念的で、また甘ったるく、原作者オイレンベルグ氏の緊密なる写実を汚すこと、おびただしいものであることは私も承知して居ります。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "原作者オイレンベルグ氏は、決して私のこれまで述べて来たような、悪徳の芸術家では、ありません。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二　ウクライナの国境から遠く波蘭を横ぎり、繁華な＊レンベルグの市を越えて、高い連峯が列をなして走つてゐる。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "レンベルグ　墺太利領（現在は波蘭領）ガリシヤの首都。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウドイヒ二世については、一九一九年にジャック・バンヴィルが、二二年にボームが、二六年にウルフが、二九年にエレンベルグが書いているが、誰も、この点に触れていない。",
              "citation": {
                "source": "泡沫の記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
