        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サムライハ　一シヨウケンメイ　ニゲマシタガ　イキガ　キレタノデ、ミチバタヘ　バツタリ　スワツテ　シマヒマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモハ　ナカヨシダツタノデスケレド、アンマリ　マンナカノ　ホシガ　サムイ　サムイト　イフノデ　ホカノ　二ツノ　ホシニ　イジメラレタノデシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」アヒルノオマワリサンガカウイツテクレタノデ、玉ネギサント、ジヤガイモサンハ、ドンナニウレシカツタデセウ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　女ノ子ノオマワリサンガ、カウホメテクレタノデスカラ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘弥ノ助六デハ物足リナイガ、訥升ガ揚巻ヲスルト云ウノデ、ソレガドンナニ美シイカト思イ、助六ヨリモ揚巻ノ方ニ惹カレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ニ行クホド暑クナリマス」正直ノトコロ、予ハ手ノ痛サニ閉口シテ晝ノ部ヲ見ルノハ止メヨウカト思ッテイタノダガ、婆サンニ窘メラレタノデ却ッテ依怙地ニナリ、痛イノヲ怺エテ明日ノ晝ニ又来ヨウカト思ッテイタノダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ウコトガ出来ルノデ予ハ今日マデ生キテ来ラレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ予ハ行カズニシマッタノデ、委シイ様子ハ知ラナイガ、アトデ聞クト、餘リ嫌味ヲ云ワレタノデ却テ颯子ガ反撃シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナコトヲ繰リ返スコト四五回ニ及ンダガ、佐々木ガシノミンヲ四錠スヽメ、尿道ヲ湯タンポデ温メテクレタノデ、ヤット鎮マリカケル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ来ナイノカネ」「エヽ、這入ッテラッシャイ」云ワレタノデ這入ッテ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦災ノ時ニ又モウ一度改築シタガ、隠居所ダケハ奇蹟的ニ火災ヲ免レタノデ、今モナオ父母アリシ日ノ姿ノマヽニ保存サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分ソノタメニ和服ヲ着、ソレヲ見セルベク予ノ面前ニ現ワレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ婆サンニ突然急所ヲ突カレタノデ、明カニ狼狽シテ照レ隠シニ怒ッタノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ先祖ハ遠イ昔ハ江州商人ノ出ラシイガ、四五代前カラ江戸ニ住ミ、予モ本所割下水ニ生レタノデ、生粋ノ江戸ッ子デアルニ違イナイ、ガ、ニモ拘ワラズ予ハ近頃ノ東京ガ面白クナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖父母ノ墓ハ深川ノ小名木川近クノ或ル法華寺ニアッタノダガ、ソノ後間モナクアノ辺一帯ガ工場地帯ニナッタヽメニ寺ハ浅草ノ龍泉寺町ニ移リ、ソコモ大地震デ焼カレタノデ、今デハ多磨墓地ニ移ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "知ッテイルトスレバ、ソレハ以心伝心デアロウカ、アルイハ郁子カラ暗示サレタノデアロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トイッテ、僕ハ全然ソウイウヲ考エナイヨウニシテイタノニ、イキナリハッキリト聞カサレタノデギクリトシタ、トイウノガ偽ラザル気持カモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
