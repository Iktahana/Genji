[
  {
    "uuid": "beb0f926-5c51-5b46-89d4-b8662574fc7d",
    "entry": "連関",
    "reading": {
      "primary": "れんかん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
