          "literary": [
            {
              "text": "彼等ガ牧師ノ一人タルろばとぶらおんノ勧メニ従ヒ、英国教会ヲ離レテソノ同志者トナリケレバ、人呼ンデ、彼等ヲ『分離派』若クハ『ぶらおん派』トナセリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ時暴風進路ヲ遮リテ船危ク、乃チかつど岬ニ還リテソノ付近ノぷろゐんすたんニ難ヲ避ケヌ――今ヤ殖民地ノ位置ヲ選択スルコト何ヨリモ急ニ、探険隊ノ相分レテソノ捜索ニ従事スルコト五週間、或日ノ事数人ヲ載セタルすたんでつしゆノ小艇ハ、じよん・すみすガぷりまうすト命名セシ港ニ入レリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
