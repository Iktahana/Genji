  {
    "uuid": "7798041b-7222-5fa4-840f-e2461882df30",
    "entry": "レイク",
    "reading": {
      "primary": "れいく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
