        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「これもみんなあのレエニンのためですよ。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「レエニンは惡魔です、獸物です……」と、我と我が涙に興奮しながら、女は幾度か繰り返した。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七歳の頃、マルクスとレエニンに心酔しました。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に、あなたのアマゾンヌの様な、トレエニング・パンツの姿が、Ａ甲板の端から此方まで、風をきって疾走してくる。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくがその路を、胸に紅く日の丸のマアクの入ったスエタアを着て、トレエニングパンツのゴムをぱちんぱちんとお腹にはじきながら、ぶらぶら何遍も往復し一体どんな歌をうたっていたと思います。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "幟の中にもここのは明らさまにスターリンやレエニン、それからマルクスなどという本家の似顔絵ばかりを押し立てて、もうフランスという国情の匂いなど少しもなかった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "晶子はレエニ夫人に日本の扇や友禅を捧げた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼にいはせると、あるひはレエニンも政治における超現實主義者だといふことになるかも知れない位だ。",
              "citation": {
                "source": "詩人も計算する",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "釈迦、基督はよし、ダントン、レエニンは佳し。",
              "citation": {
                "source": "一言二言三言",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "近くではレエニンの首が無比である。",
              "citation": {
                "source": "人の首",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レエニンの性格に関する悪口を沢山きくけれども、私は其を信じない。",
              "citation": {
                "source": "人の首",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
