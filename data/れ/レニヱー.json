        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "携へ来りしレニヱーが詩集「｜時間の鏡」を読みつゝ茶を喫す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "レニヱーの新著イストワル・アンセルテン一巻を郵寄せらる。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀口君余がレニヱーを愛読するを知り、其の新著出る毎に巴里の書肆に命じて郵送せらるゝなり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀口大学南米よりレニヱーの新著を郵送せらる。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀口大学レニヱーの著ヱスキツス・ヱニシヱンを郵送し来る。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンヌンチオの詩文、レニヱーのもの、わが荷風文学も亦その時の有力な証左として引用さるべきものであらう。",
              "citation": {
                "source": "永井荷風",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
