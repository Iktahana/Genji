    "definitions": [
      {
        "index": 1,
        "gloss": "lemon",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "紅茶にスライスした檸檬を浮かべると、爽やかな香りが広がる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "焼き魚にきゅっと檸檬を搾ると、味が引き締まっておいしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "梶井基次郎の小説『檸檬』では、一個の檸檬が憂鬱な心を照らす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "然るに梶井君の作品集「檸檬」を讀み、始めて僕は、日本に於ける「文學」の實在觀念を發見した。",
              "citation": {
                "source": "本質的な文學者",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論「檸檬」の作品は、小説といふべきよりは、小品もしくは散文詩の範疇に屬すべきものであるか知れない。",
              "citation": {
                "source": "本質的な文學者",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "檸檬梶井基次郎-------------------------------------------------------【テキスト中に現れる記号について】：ルビ（例）不吉｜：ルビの付く文字列の始まりを特定する記号（例）一人｜取殘された。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "といふのはその店には珍らしい檸檬が出てゐたのだ。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "檸檬など極くありふれてゐる。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一｜體私はあの檸檬が好きだ。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その檸檬の冷たさはたとへやうもなくよかつた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………「あ、さうださうだ」その時私は袂の中の檸檬を憶ひ出した。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本の色彩をゴチヤゴチヤに積みあげて、一度この檸檬で試して見たら。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして輕く跳りあがる心を制しながら、その城壁の頂きに恐る恐る檸檬を据ゑつけた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見わたすと、その檸檬の色彩はガチヤガチヤした色の階調をひつそりと紡錘形の身體の中へ吸收してしまつて、カーンと冴えかへつてゐた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私には埃つぽい丸善の中の空氣が、その檸檬の周圍だけ變に緊張してゐるやうな氣がした。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのはその店には珍しい檸檬が出ていたのだ。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "檸檬などごくありふれている。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いったい私はあの檸檬が好きだ。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その檸檬の冷たさはたとえようもなくよかった。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……「あ、そうだそうだ」その時私は袂の中の檸檬を憶い出した。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本の色彩をゴチャゴチャに積みあげて、一度この檸檬で試してみたら。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして軽く跳りあがる心を制しながら、その城壁の頂きに恐る恐る檸檬を据えつけた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見わたすと、その檸檬の色彩はガチャガチャした色の階調をひっそりと紡錘形の身体の中へ吸収してしまって、カーンと冴えかえっていた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は埃っぽい丸善の中の空気が、その檸檬の周囲だけ変に緊張しているような気がした。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊に圍まれたるは小き馬鈴藷圃にて、そこにはいとすぎ（チプレツソオ）の木二株、檸檬の木一株立てりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "醒めたるときは、寺の園なる檸檬の木の下にて、フラア・マルチノが膝に抱かれ居たり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "この話をば、ほと／＼道の曲りめごとに浚へ行くほどに、賣漿婆はをぢが長物語の酬に、檸檬水｜一杯を白にて與へ、をぢと我とに分ち飮ましめ、又別に臨みて我に核の落ち去りたる松子一つ得させつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "をぢは我を抱き卸して、例の大部屋の側なる狹き一間につれゆき、一隅に玉蜀黍の莢敷きたるを指し示し、あれこそ汝が臥床なれ、さきには善き檸檬水呑ませたれば、まだ喉も乾かざるべく、腹も減らざるべし、と我頬を撫でゝ微笑みたる、その面恐しきこと譬へんに物なし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁に木板の畫を貼したる房に入り、檸檬樹の枝さし入れたる窓を見て、われはきのふの苦を忘れぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "檸檬樹はまだ日の光に黄金色に染められざる、緑の實を垂れたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "こは級ごとに瓶花、盆栽の檸檬樹を据ゑたればなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎週一度｜日景を瞻て、の汗衫を被りたるが、その衫の上に縫附けたる檸檬の殼は大いなる鈕に擬へたるなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに中りたるものは、彩りたる旗、桂の枝の環飾、檸檬の實の皮などを懸けたる小車に乘り遷りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
