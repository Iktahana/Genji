        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「もうこうなればヤブレカブレだ！",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうなってはヤブレカブレ、どいつであろうと誰であろうと、かもうものか切って切って、……この鬱忿を晴らしてやろう）　ひた走り、ひた走った。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ヨーシ、こうなればヤブレカブレだ！",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ヤブレカブレの奴ばらとはいえ、泰平の世に地雷だの鉄砲だのと、だいそれた火器を使いおる）　驚かざるを得なかった。",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫は幼年学校、陸士育ちの生粋の軍人であるから、敗戦にヤブレカブレ、グウタラ、不キゲン、毎日腹を立てゝいる。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "富子はもうヤブレカブレなのだ。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "自殺途中の道草のヤブレカブレといふところだが、ヤブレカブレぐらゐで人間気前がよくなりはしない。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな性質だから、ビンタがなきや兵隊ぐらしも捨てたものぢやないなどゝ内々気楽に思つてゐるところへ、特攻隊、まだ死ぬのは早すぎる、まつたく暗い気持になつたが、ヤケ、ヤブレカブレ、飛行機のりになつた時から時々夜中に淋しさ、やるせなさで、ふいに首を突き起して思ひきり怒鳴りたいやうな気持になることがあつた。",
              "citation": {
                "source": "決闘",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼いころ、母に甘へ、母に怒り、さういふヤブレカブレで。",
              "citation": {
                "source": "決闘",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "信子（トキ子の母）は未亡人のつれづれ、死にゝとびたつ特攻隊員をねぎらつて、まぎれてゐたが、敗戦、一時はどうなることやらヤブレカブレの気持にもなる。",
              "citation": {
                "source": "決闘",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "他のダンスホールの女の子は、女同志で踊るときには、怒ったような顔をして、なんとなくヤブレカブレのように怖しい様子であるが、ここの美姫はノンビリして、充分にニコヤカである。",
              "citation": {
                "source": "安吾巷談",
                "author": "田園ハレム",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤブレカブレの男は何をするか分らない。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、あのころはヤブレカブレで万事につけて表裏一体をなしたものはないのだから、ハ、こんな映画を企画しております、と威勢よく言った方が上司の受けもよくて、ハ、あの辺はもう撮影ができませんから企画をひッこめました、などというと社長はこの敗戦主義者めと軍人にブンなぐられたのかも知れない。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はしかし二千年前の黄河学者ほどヤブレカブレではないのである。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤブレカブレの感なきにしもあらずであった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十八　踊る時計",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤブレカブレには手ごろでしたのでしょう。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "トオサンはそれとなく小夜子サンにも当ってみて、「一時身を隠してみては」「御心配はうれしいんですけど、私、まだ、なんとなくヤブレカブレよ。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "平凡でマトモで穏健着実だったこのような老人たちの何パーセントかが、戦後に至って生まれてはじめてのヤブレカブレ、手のつけられないジジイになっても憎むわけにはいかない。",
              "citation": {
                "source": "親が捨てられる世相",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうヤブレカブレなものではない。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その七　宮様は一級紳士",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせヤブレカブレの世の中じゃないか。",
              "citation": {
                "source": "ヤミ論語",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミデアン地方に住んでいた種族はケニ人と言われるもので、これはエレミヤ記に出てくるレカブ人の先祖であり、後にユダヤ民族の一部として吸収されたのである。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
