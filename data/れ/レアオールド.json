          "literary": [
            {
              "text": "ハネ十一時半、ダメを出しカットをして帰宅、レアオールドをのみ、色々食ってねる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ雨、まっすぐ帰宅し、レアオールドを傾ける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "まっすぐ帰宅、レアオールド少々のみ、ねる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜も涼しい、レアオールドを傾けて、いゝ心持になって寝る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
