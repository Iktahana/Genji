        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ところが、ダンネベルグ様は、果物は後にして何か飲物が欲しいと仰言るので、易介がレモナーデを持ってまいりました。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その折、旗太郎は壁のテレーズの額を取り去り、伸子はレモナーデを毒味せり。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手伝いに来ていたボーイが、冷たいレモナーデのコップを配りました。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき卓子の上に、コップが一つ置かれていましたが、その底には僅かにレモナーデの液体が残っていたそうです。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "百合子は大広間へのレモナーデの準備をお手伝いさんたちとしていたと言いました。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからお姉様の枕頭にはレモナーデのコップがあったのです。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "覚えていらっしゃいますか、お兄様の死体の側にもレモナーデのあったことを。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "周囲の状況から考えますと、綾子夫人は丈太郎氏のところへ、レモナーデを搬んで来たのです。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "丈太郎氏は九時二分過ぎに時報受信の実験をやり、やさしい夫人の捧げるレモナーデを手にとって一口に飲んだのでした。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが丈太郎氏は忽ち身体に異常を覚え、これはてっきり綾子夫人が毒を仕掛けたレモナーデを飲ませたせいであると思い、忽ち夫人に飛びかかって壁際に押しつけはしたものの、其の時、中毒作用は丈太郎氏の心臓を止めてしまったのです。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "開閉器をきり、綾子夫人からレモナーデを受けとる前に、青酸加里は指から口の中へ既に、いとたやすく搬ばれていました。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手でレモナーデのコップをとりあげて一息に飲み下したのだから、何条たまりましょう。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "笛吹川はそのとき自ら口移しに夫人にレモナーデ水を与えました。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのたびにレモナーデだ、ハイボールだなどと、念の入ったことになる。",
              "citation": {
                "source": "暗号音盤事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて『レモナーデがほしい』との事で早速作つていつもの樣に私が一口のませますと『みんなの手からのませて頂戴ね』といふので、其通りに一口づゝ吸呑からのませました處『アヽおいしい／＼』と一口毎に申しました。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　威風堂々と体を揺すりながら、彼はレモナーデのスタンドへ足を向ける。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでのんだレモナーデの一杯が又しみ／″＼とうまかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
