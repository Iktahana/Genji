          "literary": [
            {
              "text": "時々ヨロケテ倒レソウニナルノデ、寒竹ノステッキヲ衝イテルガ、大概颯子カ看護婦カ誰カヾツイテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "直グヨチ／＼シテ倒レソウニナルノデ、縁側カラ落チヤシナイカト心配デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "席カラ便所ガ遠イノデ辿リ着クマデニ度々ヨロケテ倒レソウニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
