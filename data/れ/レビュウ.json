        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "かぐや姫をレビュウにしたそうであるが、失敗したにちがいない。",
              "citation": {
                "source": "古典竜頭蛇尾",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フランスレビュウの大立者の女優で、ミスタンゲットというのがあるがね」「ああそんなら知ってるよ。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フランスレビュウの大立物の女優で、ミスタンゲットというのがあるがね」「ああそんなら知ってるよ。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しでも暇があると浅草のレビュウへ行ったり、日本物の映画を見たり、プロレタリア小説などを読んでいた。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブック・レビュウをして深く感じることは、ただ月二三冊の新刊の本をとりあげていって見ても、読者の本を読んでゆく一貫した方法というものに対しては、大して貢献するところがないであろうという不安である。",
              "citation": {
                "source": "若い婦人のための書棚",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この日比谷公園から程とおからぬ丸ノ内の竜宮劇場では、レビュウ「赤い苺の実」を三ヶ月間も続演しているほどだった。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは一座のプリ・マドンナ赤星ジュリアが歌うかのレビュウの主題歌だった。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたくしは今、車を下りて、真直にここまで歩いたばかりですわ」　ジュリアはまるでレビュウの舞台に立っているかのように、美しい台辞をつかった。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで僕も失業者の仲間から浮び上ることができます」　一郎はジュリアに頼んで、レビュウ団の座員見習として採用してもらうこととなったのであった。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前はいい子だから、あっちへいって、レビュウを見ていらっしゃい。",
              "citation": {
                "source": "二、〇〇〇年戦争",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで自由になったから逃げだすかと思いの外、彼の若者は路上でどこかのレビュウで覚えたらしい怪しげな舞踊を始め、変な節で歌うのであった。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "姿勢はスラリと均斉がとれ、特別、脚線のすばらしさ、レビュウガール、映画女優、これだけの美人がメッタにあるものではない。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "座付作者になるにもインチキ・レビュウとくるとまだ少しまともすぎて、安来節とこないと、どうしてもをさまることが出来ない。",
              "citation": {
                "source": "足のない男と首のない男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "十年前の花田一郎は、浅草のインチキ・レビュウの俳優であった。",
              "citation": {
                "source": "カストリ社事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすれば裸レビュウの如きは、自然に場末の片隅へもぐりこまざるを得なくなるのだ。",
              "citation": {
                "source": "戦争論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "今から三年ほど前、日劇小劇場にヘソ・レビュウというのが現れて人気をさらったのを御記憶かな。",
              "citation": {
                "source": "安吾巷談",
                "author": "ストリップ罵倒",
                "note": "青空文庫"
              }
            },
            {
              "text": "このヘソ・レビュウの発案者、ならびにヘソ脚本の執筆者が淀橋太郎であった。",
              "citation": {
                "source": "安吾巷談",
                "author": "ストリップ罵倒",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミルクホール、浪花節、レビュウ小屋と、たてますたびにデコボコにふくれる。",
              "citation": {
                "source": "安吾巷談",
                "author": "ストリップ罵倒",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとの子は昔ながらの浅草レビュウで、体をなしていない。",
              "citation": {
                "source": "安吾巷談",
                "author": "ストリップ罵倒",
                "note": "青空文庫"
              }
            },
            {
              "text": "かねて僕は戯作を愛し、落語であれ漫才であれ、インチキ・レビュウの脚本でであれ、頼まれれば、白昼も芸術として堂々通用のできるものを書いてみせると大言壮語していたことがあるものだから、紙面をさいてくれる気持になったのである。",
              "citation": {
                "source": "茶番に寄せて",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "かねて僕は戯作を愛し、落語であれ漫才であれ、インチキ・レビュウの脚本であれ、頼まれれば、白昼も芸術として堂々通用のできるものを書いてみせると大言壮語してゐたことがあるものだから、紙面をさいてくれる気持になつたのである。",
              "citation": {
                "source": "茶番に寄せて",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争このかた狂人が主役を演じる御時世なのかも知れないな」「ヘソだしレビュウも論語先生も背中合せの萩と月かね。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂口安吾という先生の小説なぞも、ヘソレビュウと論語先生の抱き合せみたいなものじゃないか。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君は役者もやるのか」「えゝ、男役でも、女役でも、レビュウもやるのよ。",
              "citation": {
                "source": "淪落の青春",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかには全然色気がなくなり、棒のような感じのレビュウガールがいる。",
              "citation": {
                "source": "モンアサクサ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "漫才だか浪花節だか、和服姿の芸人が、レビュウ子らしい姐さんを口説いている。",
              "citation": {
                "source": "モンアサクサ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "レビュウの姐さんは、長崎も五島も、てんで日本地図は御存知ない様子で、そんなことなんでもないや、と気にとめるところがミジンもないから、面白い。",
              "citation": {
                "source": "モンアサクサ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘソを見て、よろこぶんだからネ、ひでえことになりやがったよ」　ちなみに、ヘソレビュウという奴を書いて、日本演劇史に新紀元をつくった脚本書きは、ほかならぬタロちゃんなのである。",
              "citation": {
                "source": "モンアサクサ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "タロちゃんの言う通り、ヘソだしレビュウなどゝは情ない。",
              "citation": {
                "source": "モンアサクサ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
