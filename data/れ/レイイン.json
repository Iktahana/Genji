          "literary": [
            {
              "text": "そのうちに霊隠寺に入って僧となってしまった。",
              "citation": {
                "source": "緑衣人伝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは霊隠寺へ行っていた友人であった。",
              "citation": {
                "source": "荷花公主",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして一ヶ月ばかり後のこと、西湖の西方の山地にある名刹霊隠寺の御堂に、端坐して祈念してる美しい中年の婦人がありました。",
              "citation": {
                "source": "画舫",
                "author": "――近代伝説――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の讀景教碑書後に、廬居靈竺間（杭州府の靈隱寺と天竺寺をいふ）。",
              "citation": {
                "source": "大秦景教流行中國碑に就いて",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
