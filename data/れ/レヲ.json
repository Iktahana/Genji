        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "老子の所謂「谷神不死」「玄ノ玄、牝ノ牝、コレヲ玄牝ト謂フ」の類。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レヲパルディの羽を少し。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメレオンと簑蟲との對話といふレヲパルディ風のものを書いて見度くなる。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "誠ハ天ノ道ナリ、コレヲ誠ニスルハ人ノ道ナリ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　モリヤ　ヤブノ　ナカニ　ヰタ　ウグヒスタチハ　ソレヲ　キキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンノ　オトウサンハ　ソレヲ　キクト、タキクンノ　ハウヲ　キツト　ミテ、「タキ、イジメタリ　シテハ　イケナイヂヤ　ナイカ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ　キイタ　コノ　マヅシイ　ヲトコノ　ヒトハ、「ヨシ、ソレデハ　ジブンモ　センサウノ　アル　トコロヘ　イツテ、リツパナ　テガラヲ　タテ　タイシヨウニ　ナラウ」ト　ヒトリゴトヲ　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヘノ　ナカニハ　フタリノ　トシヨリガ　ヰテ　チヨウド　ヒトツノ　パンヲ　フタツニ　キラウト　シテ　ヰル　トコロデシタガ、ハラノ　スイタ　ヲトコヲ　キノドクニ　オモツテ　パンヲ　ミツツニ　キリ、ソノ　ヒトキレヲ　ヲトコニ　メグンデ　ヤリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　バシヤニ　フトイ　ツナヲ　ツケ、コドモタチハ　ソレヲ　エンヤ　エンヤト　ヒイテ　ユキマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ、イロイロ　サガシタガ、アマリ　ヨイ　キカイガ　ナイノデ、ラツパヲ　カツテ、「コレヲ　サカサマニ　シテ　ミミニ　ツケテ、ラツパノ　シリカラ　キキナサイ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ　ナホスニハ、イタチサンニ　オモヒキリ　オナラヲ　サセルヨリ　シカタハ　アリマセン」　ヤレヤレ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "限度ヲ設ケテ壹百萬圓以下ノ私有財産ヲ認ムルハ、一切ノ其レヲ許サヾランコトヲ終局ノ目的トスル諸種ノ社會革命説ト社會及人性ノ理解ヲ根本ヨリ異ニスルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "個人ノ自由ナル活動又ハ享樂ハ之レヲ其ノ私有財産ニ求メザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鑛山土地等其者ハ全ク自然ノ存在ニシテ其レヲ所有セシムル凡テノ力ハ國家ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ歐米ノ革命的團體ハ大戰ノ遙ニ以前此レヲ以テ國際語トセント決議セシ程ノ者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ下掲ノ如ク日本國民ハ永久ニ兵役ノ義務ヲ有シ、且ツ一年志願兵特權ハ此等ノ訓練アルヲ一理由トナスヲ以テ其レヲモ廢止スルガ故ニ、兵役ニ於テスベキコトハ凡テ兵營ニ於テスベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "無月謝ヨリ生ズル負擔ハ各市町村此レヲ負フベク、教科書ハ國庫ノ經費ヲ以テ全國ノ學校ニ配布スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其不合理ナルコト恰モ現時ノ歐米ニ「キモノ」服ガ普及シタルヲ以テ其レヲ室内ノ制服トシテ強制セント云フト一般ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ不用ナルベキ各地ノ中學女學校舍ハ或ハ此レヲ取リ毀チ、又ハ大學豫備校ノ校舍又ハ單科大學ノ校舍トナスヲ得。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ夫又ハ其子ガ自己ノ勞働ヲ重視シテ婦人ノ分科的勞働ヲ侮蔑スル言動ハ之レヲ婦人々權ノ蹂躙ト認ム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ハ之レヲ告訴シテ其ノ權利ヲ保護セラルル法律ヲ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "賣淫婦ノ罰則ヲ廢止シ其レヲ買フ有婦ノ男子ハ之ヲ拘留シ又ハ罰金ニ處ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レヲ途方モナキ一夫一婦制ニ對スル反逆ト考フルハ、恰モ政治的特權者ニ向ツテ叫バレタル政治ノ自由ヲ平等ナル國民間ニ脱線セシメテ、相犯サザル各自ノ自由ヲ蹂躙スルコトモ等シク政治ノ自由ナリト云フ低能者ノ昏迷ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ之レヲ罰セザル理由ハ、未婚婦人ガ純潔ヲ破ルモ法律ノ干與セザルト等シク道徳的制裁ノ範圍ニ屬スルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡テノ光榮ハ其レヲ維持スベキ物質的條件ヲ缺クベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ現在吾人ノ血液ガ如何ニ多量ニ朝鮮人ノ其レヲ混ジタルカハ人類學上日本民族ハ朝鮮支那南洋及ビ土着人ノ化學的結晶ナリトセラルルニテモ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮其者ノ歴史ガ示ス如ク、又清國ガ此レヲ屬國トセンガ爲ニ起リタル日清戰爭、及ビ滿洲ニ來タレル露西亞ガ其ヲ侵略セントセシガタメニ破レタル日露戰爭ニ示ス如ク、其ノ亡國タルベキ内外呼應ノ原因ハ統治者ガ日本タラザル時ハ露支兩國ノ焉レカナリシハ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "今次ノ大戰ニ於テ若シ白耳義ガ獨乙ト握手シ而シテ英國ノ軍隊ガ其レヲ撃破シテ自耳義ニ滯陣セシトセヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是レヲ民族自決主義ト名クルニ至リテハ人道主義ノ命題ニ代フルニ人間自決主義ト云フガ如キ笑倒ノ沙汰。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
