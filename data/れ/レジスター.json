        "examples": {
          "standard": [
            {
              "text": "「お会計はこちらのレジスターでお願いします。」と店員に案内された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "スーパーのレジスターには、いつも長い行列ができている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は商品をカゴに入れると、一番空いているレジスターへと向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": []
        }
      },
