        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ガタ馬車キタキター、ノレノレ」と僕達は歌つてゐた。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "家郷追放、吹雪ノ中、妻ト子トワレ、三人ヒシト抱キ合イ、行ク手サダマラズ、ヨロヨロ彷徨、衆人蔑視ノ的タル、誠実、小心、含羞ノ徒、オノレノ百ノ美シサ、一モ言イ得ズ、高円寺ウロウロ、コーヒー飲ンデ明日知レヌ命見ツメ、溜息、他ニ手段ナキ、コレラ一万ノ青年ヲ思エ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミノ仕事ノコルヤ、ワレノ仕事ノコルヤ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場ヤ、銀行ヤ、病院ハ誰レノ所有ニ属スルモノデアルカ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツカレノ銀ヲクユラシテ、　　　モロ人谷ヲイデキタリ、ココニ二タビ口ソソギ、　　　　セナナル荷ヲバトトノヘヌ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "フレノロジストの主張の如くに、腦の某部分が某才能某情感の根基若くは寓居であるや否やは猶未確定に屬すると雖も、要するに器分と非器分との間には脱し難き連鎖があり、器分が一を減ずれば非器分が一を減じ、器分が一を増せば非器分が一を増すことは爭ふ可からざる事である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "フレノロジストの主張のように、脳の或る部分が或る才能或る情感の寓居であるか否かは未確定といえども、要するに器分と非器分との間には脱し難い連鎖があり、器分が一を減ずれば非器分が一を減じ、器分が一を増せば非器分が一を増すことは争えない事実である。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの歌う曲のほとんどは、ジョン・レノンとポール・マッカートニーの手になるものでした。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまでは対立的にとらえられていたボブ・ディランの歌とビートルズの歌（これは正確には、ジョン・レノンの歌といった方がよいのかもしれませんが）が互いにひとばけしたところで内省的になり似通ってくる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後は逆に、ビートルズ、特にオノ・ヨーコと出会ったあたりからのジョン・レノンの歌には政治が顔をのぞかせるのに対し、ボブ・ディランの方はしばらくのあいだストレートには政治をテーマとしなくなります。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした時代精神を、ジョン・レノンとボブ・ディランという二人の天才は、多くの若者の半歩先で受けとめ、自らとの格闘を通じて表現していったのではないか。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "『メロディー・メーカー』紙の元編集長で本人とも親交のあったレイ・コールマンの『ジョン・レノン』をだらだら読んでいったこの日の夜、エキスポでもらってきたボイジャージャパンのパンフレットを開いたのは何がきっかけだったのでしょう。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　訳せば「理想のパーソナルコンピューターのイメージを描き、これをダイナブックと名付けたアラン・ケイ（この世界ではボブ・ディランとジョン・レノンを足したよりもなお偉いことになっている）氏は、この事実を知っているの？",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて大衆的なマージー・ビートのうねりにのって出てきたビートルズが『二〇世紀の偉大な音楽家』にされたんじゃ、ジョン・レノンも草葉の陰で泣くだろう。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「とにかく似ているかね」「似ているも何もない、――僕はてっきり君自身と思わされてしまったほどだ」「そうか、しかしこの成功の栄誉は、グレノーブルの、オスカー・ミュニアー氏に帰すべきものだよ、氏は数日を費して模型してくれたのだ。",
              "citation": {
                "source": "空家の冒険",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ここにさ、曲ごとのリードシンガーが書いてあるけれど、いい曲はみんなジョン・レノンだね。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間としてのジョン・レノンは、一九八〇年に死んだが、ロックンローラーとしては、一九六六年には死んでいた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジョンは、ＢＧＭにはしないんだ」「ジョンて、ジョン・レノンのことですか？",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにも説明なしに「ジョン」といったら、レノンであるのは、慶一には自明のことだった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワラさんが、早くコーヒーをもってこいって」39もうメリーゴーラウンドからは降りたんだそうするしかなかっただけさ〈ウォチング・ザ・ウィールズ〉ジョン・レノン　局で、ワラとふたりで楽しそうに笑い声をたてていた令子は、シャワーでも浴びてきたのだろう、すっきりした表情だった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "レノアと云ふ世に亡き乙女を戀して、「あはれ、冴やかに　吾れは　覺ゆ　寒き　師走の　夜中なり、炭の　燃えさし　離れ離れ　床に　その影　落してき。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヂイサン、マア　オキヽヨ、オレノ　フエハ　トテモ　スバラシインダゼ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレノ　カタナハ　ハガ　コボレテ　ヰル。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タレノ　カゲ新美南吉　マチノ　マンナカニ　ヒロツパガ　アリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デハ　ダレノ　カゲ」「ワシノ　カゲサ」ト　ポストハ　ニツコリシマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこと財産に関しては、昔から本来無一物、何レノ処ニカ塵埃ヲ惹カン、といった暢気な気持なのだ。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼食を、所長さんの御招待で頂き、サアビスに踊ってくれたのが、当時のスタア、ロジタ・モレノ嬢でした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
