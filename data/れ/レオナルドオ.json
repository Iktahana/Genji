        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "フイレンツエの博物館に、レオナルドオ・ダ・ヰンチが畫きたるメヅウザ（おそろしき女神）の頭あり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲の主人公はレオナルドオ・ダ・ヰンチなりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオナルドオの住みしは此地なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚だ不倫な言ひざまで恐縮の極であるが、わたくしはレオナルドオのモナ・リザよりは寧ろ其サン・ジエロニモの画を愛する。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオナルドオのあの鋭くして柔軟な素描を残したジエロニモこそ世にもこよない物である。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
