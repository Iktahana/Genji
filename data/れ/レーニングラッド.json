          "literary": [
            {
              "text": "暫くレーニングラッドの讚美。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月三日（火曜）　朝、В・О・К・С〔全ソ対外文化連絡協会〕に行き、レーニングラッドゆきのことを話した。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "レーニングラッドのВОКСの人来、おそくまで喋る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳴海さん来、レーニングラッドの口がきまった由、結構、然し彼大してうれしくない。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の仕事がすんだらレーニングラッドへゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬の頃のようにレーニングラッドにゆくの厭でない。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
