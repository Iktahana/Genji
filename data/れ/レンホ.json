          "literary": [
            {
              "text": "れんほ、れれつれ、消えぬる恋慕ながしの一曲。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その背中の丸さ加減が言うに言われんほど美しい。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時の嬉しさは何とも堪え得られんほど嬉しかった。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "端の者は総掛りですすめてるねんけど、当人はなかなか行こうと云うことを云わへんねん」「そら無理もないわなあ、船場生れの坊々が満洲落ちをしやはるのやよってに」「けど啓ちゃんも、今ではえらいお金に困ってて、もうあの家にも住んでられんほど生活に窮してるねんわ。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その風呂敷包みどうなさるんです」「これかいな、これは古いもんやがな」「古いものなら、綾ちゃんに始末してもらいます」「ほんなもん、手がつけれんほどひどいもんやでな、私がぼつぼつとな」「すると、やっぱり江州へお帰りになるおつもりなんですか」　母の肩はひどく曲っている。",
              "citation": {
                "source": "日を愛しむ",
                "author": "外村繁",
                "note": "青空文庫"
              }
            }
          ]
        }
