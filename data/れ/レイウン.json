          "literary": [
            {
              "text": "あの湯島の大きな霊雲院も焼けた。",
              "citation": {
                "source": "震災日誌",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "四、靈雲院　庫裏からの板廊下が蝕ばんで、その腐蝕の跡が數珠模樣のやうな彫りを見せてゐた。",
              "citation": {
                "source": "京洛日記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "この妙心寺塔頭の靈雲院には珍らしい火防の大團扇が、鳶口や火事繩と一しよに庫裏の入口に立てかけてあつた。",
              "citation": {
                "source": "京洛日記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "長さ七尺くらゐの柄のさきに黒塗の團扇がついてゐて、白い墨で靈雲といふ二字が書かれてあつた。",
              "citation": {
                "source": "京洛日記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
