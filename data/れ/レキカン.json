          "literary": [
            {
              "text": "清水寺中を歴観し台上に休してかへる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "）広東の山よりみれば珠江なる、舟は木の葉の浮ぶかと思ふ　楼を下りて、さらに孔子廟、水時計等、三、四カ所を歴観して帰船す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "三時後、同氏とともに馬車に駕して、コウシノ公園、キンタノルマール公園、サンタルシア山を歴観す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
