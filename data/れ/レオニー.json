        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "石油液化を扱った「オイル・シェール」（小山いと子）、ソヴェトのレオニード・レオーノフの「スクタレフスキー教授」などは、科学者の学問的情熱と社会の歴史的環境を扱っていましたが、素人眼にも科学者は成功的でありませんでした。",
              "citation": {
                "source": "質問へのお答え",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオニード・グレゴリウィッチ・ジェルテルスキーはやっと商業学校を出たばかりの青年であった。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、レオニード・グレゴリウィッチ！",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「レオニード・グレゴリウィッチ、どうか貴方、可哀そうなマリーナ・イワーノヴナの忠実な騎士になって上げて下さい、ね、お拒みなさりはしませんわね」　ジェルテルスキーは、黒い洋袴を穿いた脚を組みながら、丁寧に碧い眼を見開いて対手を見守った。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それでね、レオニード・グレゴリーウィッチ、お願いと申しますのはね、あなた当分、この不幸な方を保護して上げて下さいませんこと？",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオニード・グレゴリウィッチが電車賃を節約するために勤め先と同じ区内にこの貸間を見つけたのであった。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオニード・グレゴリウィッチはひどく背が高い。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオニード・グレゴリウィッチが彼女の夫であると同じそれは不変の事実だ。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女には、レオニード・グレゴリウィッチがこれ以上立身をして、自分達の生活に変りが起ろうとも思えなかった。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あら、これ、家の娘さんですの、悧口そうな眼つきだこと……何ていう名なのお前さん」「我々の言葉を理解しないんですよ、ちっとも」　レオニード・グレゴリウィッチのそれは声だ。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　三時過て、レオニード・グレゴリウィッチは勤め先から帰って来た。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――レオニード・グレゴリウィッチは、愛情をこめ、素早く妻を目がけ接吻を送った。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「レオニード・グレゴリウィッチ、どうぞこのことだけは誰にも云わないで下さい。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、レオニード・グレゴリウィッチ、我々は、キリストを追放しつつレーニンの肖像を祭る。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝る前、マリーナが厠へ降りた間にダーリヤはレオニードを擁き、云った。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「レオニード・グレゴリウィッチにもお気の毒だから、一先ずお帰り、――これこの通り、騙しゃしない、半分だけ兎に角かえして置くから」　エーゴルはジェルテルスキー夫婦の前で卓子の端から端へ十円札を十五枚並べた。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオニード・グレゴリウィッチ、久しぶりでどうです」　ジェルテルスキーは、戸棚からギターを出し一つ一つの響きを貪欲にたのしみながら調子を合わせ始めた。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオニード・レオノフは「のんだくれ」を書くのに、一年間工場生活をしなければならなかった。",
              "citation": {
                "source": "現代小説展望",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あなたも老けたわねえ、レオニード。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……わずかな金高じゃありませんか……ラネーフスカヤ　じゃいいわ、レオニードにたのみましょう。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……出してあげて、レオニード。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラネーフスカヤ　（コーカサスの舞曲を口ずさむ）レオニードは、どうしてこう遅いのだろう？",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（退場）ラネーフスカヤ　でも、レオニードはまだね。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（はげしい不安に駆られて）レオニードはどうしたんだろう？",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオニードはどうしまして？",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はガーエフ役に廻り、ロパーヒン役はレオニードフという荒事を適り役とする若い役者が持った。",
              "citation": {
                "source": "チェーホフ試論",
                "author": "――チェーホフ序説の一部として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "籐テーブルの上に書類をのせ、抑揚も音色もふだんと少しも変らぬ声で、「レオニード、署名を。",
              "citation": {
                "source": "灰色の眼の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は結局ガーエフ役に廻り、ロパーヒン役はレオニードフという若い役者が持った。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオニードフは『ジュリアス・シーザー』のカッシアスとか、『カラマーゾフ』のドミートリイとか、農民一揆のプガチョーフなどを適り役とするいわば荒事師である。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでミュラー教授と庭番のフーベルが、帽子を見つけたという場所からボートを出し、岸に沿って北のほうへ漕いで行くと、十一時すぎ、レオニーという村から二キロほど手前の湖岸、四尺ぐらいの浅瀬に、王と博士が顔を下にして浮んでいるのを発見し、すぐさま岸にひきあげた。",
              "citation": {
                "source": "泡沫の記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
