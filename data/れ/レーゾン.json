        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこにマキァヴェリ的なシュターツ・レーゾンの根拠がある。",
              "citation": {
                "source": "絶対矛盾的自己同一",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランス大ブルジョアジーのモットーたる自由平等がこの悟性（レーゾン）に由来することは断るまでもないだろう。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "猛火とうごめき戦き慄ひ、この手の肉はマルセイェーズを歌ふけれどもエレーゾンなぞ歌はない！",
              "citation": {
                "source": "ランボオ詩集",
                "author": "OEVRES D'ARTHUR RIMBAUD",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろの意味で大した作ではないが、劇の焦点をビュロクラティズム反対に置いたところがレゾン・デテール〔存在理由〕なんだ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
