  {
    "uuid": "89ac3d2a-03c7-54ac-b83b-257066e13852",
    "entry": "霊言",
    "reading": {
      "primary": "れいげん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
