    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "越えて昭和四｜年の春に至り、彼女は或る一つの動機から霊視の他に更に霊言現象を起すことになり、本人とは異った他の人格がその口頭機関を占領して自由自在に言語を発するようになりました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼を通じて起った、主なる心霊の現象を挙ぐれば、（一）大小の敲音、（二）種々の光、（三）種々の香気、（四）種々の楽声、（五）直接書記、（六）卓子、椅子其他物品の浮揚、（七）物品引寄、（八）直接談話、（九）霊言、等を数えることができる。",
              "citation": {
                "source": "霊訓",
                "author": "SPIRIT TEACHINGS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
