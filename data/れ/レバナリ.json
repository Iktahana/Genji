          "literary": [
            {
              "text": "之ヲ再ビスル必要ハ國家組織ヲ根本的ニ改造スル時獨リ宮中ノ建築ヲノミ傾柱壤壁ノマヽニ委スル能ハザレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ハ物質的享樂又ハ物質活動其者ニ就キテ劃一的ナル能ハザレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "何人ガ大經世家タルカ大發明家大哲學者大藝術家タルカハ、彼等ノ立案スル如ク社會ガ認メテ勞働ヲ免除スト云フ事前ニ察知スベカラズシテ悉ク事後ニ認識セラルル者ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ賠償ヲ別途ニ命ジテ同居ヲ父ニ強ヒザル所以ハ、遺棄シタル事情ガ背徳ニセヨ又ハ積極的活動ノ爲ニセヨ干渉スベカラザル別事ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "電源ノ消耗ト、更ニ急報スベキ事件ノ発生ヲ予期スレバナリ」僕「デハ御機嫌ヨウ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ甘ジテ之ヲ為ス所以ノモノハ洵ニ国家生民ノ為ニ図リテ一片ノ耿耿竟ニ忍ブ能ハザルモノ有レバナリ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、私ハコヽニヰナケレバナリマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ、着物ヲコシラヘナケレバナリマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯事物ノ方向ヲ得テ小ヨリ大ニ至リタル者タル可レバナリ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "李時珍の『本草綱目』によれば、仙茅の条下に「始メ西域ナル婆羅門ノ僧、方ヲ玄宗ニ献ズルニ因テノ故ニ、今江南ニテ呼ンデ婆羅門参卜為ス、言フコヽロハ其功ノ補スルコト人参ノ如ケレバナリ」（漢文）と述べている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそこに「動植ノ化石アルヲ見ザレバナリ」、「有機体ノ化石ヲ含ム。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ハ夜デヨカッタケレドモ、コレカラダト時間ガ時間ダカラ、必ズドコカデデモ隊ニ打ツカリマス、米国大使館ト国会議事堂ト南平台ヲ結ブ線ヲドコカデ横切ラナケレバナリマセン、ソノ積リデ早目ニオ出カケニナッテ下サイト、運転手ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ甘ジテ之ヲ為ス所以ノモノハ、洵ニ国家生民ノ為ニ図リテ、一片ノ耿々竟ニ忍ブ能ワザルモノ有レバナリ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
