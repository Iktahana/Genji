        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "タキクンハ　ミツルクンミタイナ　ヨワムシニマデ、バカニ　サレルト　オモウト　ハラガ　タツテ、「ヒゲサンガ　ナンダイ！",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、コヒツジハ　コロサレルトハ　チツトモ　シラズニ　ヌスビトノ　カホヲ　ミアゲテ　ヰルノデ、ヌスビトハ　キウニ　カワイサウニ　ナリマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ツアール」ガ侵略シ來レルト「レニン」ガ幾多ノ謬妄ヲ附帶セル社會革命説ヲ奉ジテ殺到シ來ルベキト、日本ガ國防上朝鮮ニ據リテ戰フコトハ國家ノ國際的權利ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ中学ノ幾多ノ先輩ガ窮屈極マル――ソレハ日露戦争時代ノ軍事教育ヲ旨トシテヰル老曹長ナル学生監ノ圧迫ガ酷イノデアルタメ――学窓ヲ放タレルト同時ニ急ニ不思議ナ紳士ニナツテ数々ノすきやんだるヲ遺シテヰルノヲ見テモ実ニ寒心ニ堪ヘン次第デアリマス。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ次ノ瞬間ニ殺サレルト思イマシタ。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ハアット云ッテ倒レ机ノハシデ頭ヲヒドク打チ、倒レルト同時ニ血ヲハイタヨウデシタガ、ソノママ昏倒シテシマッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハ夫ガ倒レルト悲鳴ヲアゲナガラ夫ノトコロニカケヨッテ介抱シヨウトシマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレルトはどんな音かと開くと、非常に低い調子で、非常に鈍い高低で、とても陰氣で、聞いただけでも陰慘な氣持になる。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　此の日も朝の三時過にアレルトがパリの空に鳴り響いた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、午前十一時頃にもまたアレルトがうなりだして、また高射砲の音が方方で聞こえてゐた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、パリでは諸般の取締が日に日にやかましくなり、アレルトの鳴つてる間、即ち、人人がアブリへ逃げ込んでる間、他人の室内に侵入した者は死刑に處するといふ布令が出たさうだ。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此説話は、忠犬グレルトの話として、欧羅巴の諸国に広く物語らるるものにして、其はじめ、東方より伝わりし者なることは、大抵明かなるも、其本源地の波斯なるや、阿剌比亜なるや、或は印度より、かの二国を経て来りしや、今日より之を判断すること難し。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、土手ガ切レルト又、田ガ　メチャメチャ　ニナルスルト　米ガ　オサメラレンケン地主ノ鬼ガ　イジメル。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエアナタ、ソウシヨウジャナイノ」ソウ云ワレルト婆サンハ二ノ句ガ継ゲナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿閉ハ老人ニハシバ／＼起ル現象ダソウダガ、平生デモ一回ノ排尿ニ時間ガカヽリ、劇場ノ便所ナドデ人ガ大勢ウシロニ列ンデ待ッテイラレルト甚ダ困ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ聞カサレルト、予モ何トカシテ居残ル算段ヲシナケレバナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「葉ガ繁ッテヽ絡ミツクワヨ、アタシニ掴マッテラッシャイ」「腕ヲ組マセテクレルトイヽガナ」「ソンナコト無理ダワヨ、オ爺チャンハ背ガ低インダカラ」予ノ左側ニ並ンデイタ彼女ハ、突然右側ニ廻ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――冗談ミタイニ云ッテタケド、案外本気ラシカッタワ」「誰デモ女房ニソウ云ワレルト、ソンナ負惜ミヲ云ウモノサ」「彼ニモ誰カ好キナ人ガアルラシイノヨ、アタシト同ジヨウナ過去ヲ持ッタ、何処カノキャバレノ人ラシイワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホラ、アノ声ヲ聞イテルト、『肩｜刺セ裾刺セ、肩刺セ裾刺セ』ト云ッテルヨウニ聞エルデゴザイマショ、モウアノ声ガ聞エ出シタラ秋ナンデゴザイマスヨ」ソウ云ワレルト、気ノセイカ寝間着ノ白地ノ単衣ノ筒袖ヲ肌寒イ風ガ冷エ／″＼ト通リ抜ケルヨウナ気ガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「怪我ハナカッタガ、アンナ大キナモノニ飛ビ着カレルト、ヨボ／＼ノ老人ハドウニモナランネ」「オ倒レニナッタノガ芝生ノ上ダッタノデ本当ニヨウゴザイマシタ」予モ浄吉モ元来犬好キノ方ナノデ前ニモ犬ヲ飼ッタコトハアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「当リ前ヨ、アタシ強情ッ張リダカラ、ソンナ芝居ヲサレルト尚更依怙地ニナルワ」モウコレ以上クダ／＼シク書クノハ止メル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若イ時カラ女房ナドニ始終意地悪ヲ云イツヾケテ悪党ガッテイタガ、ソノ女房ニ泣カレルト、カラッキシ意気地ガナク負ケテシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ウ男ナノデアルガ、イタイケナ子供ガ突然現レテ、コンナ優シイ言葉ヲカケラレルト、モウ溜ラナイ、拭イテモ拭イテモ眼鏡ガ濡レテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人ニ知ラレルト、アトガウルサイカラデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラ佛様達ハ東京ニ置イトカレルト、骨ニナッテカラモ始終アッチコッチヘ逃ゲ回ラナケレバナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レルトー夫人のサロンが彼に比較する材料を提供していたので、彼の探究心は一段と好奇心を高めていた。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
