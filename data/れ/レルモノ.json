          "literary": [
            {
              "text": "昔、昔、ギリシャ詩人タチ、ソレカラ、ボオドレエル、ヴェルレエヌ、アノ狡イ爺サンゲエテ閣下モ、アア、忘レルモノカ芥川龍之介先生ハ、イノチ迄。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "スグ馴レルモノデス　このお言葉の有難さ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "米國ノ如キハ確實ニ經濟的諸侯政治ヲ築キ終レルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "深イ注意ヲモッテカカル人間ニ対シ適当ナ電波的保護ヲ急グノデナケレバ、世ノ中ニハ「手ニオエナイ神経病者」トイワレルモノガ年ト共ニ激増スルデアロウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ヤ日ニ従テ新陳代謝シ四方ヨリ風ヲ臨ンデ集リ来レルモノ多シ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
