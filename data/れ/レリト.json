          "literary": [
            {
              "text": "昔者娘ヲシテ其ノ母ニ背カシメンガ爲メニ來レリト云ヘル者アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼レニ從ヘバ男子ノ姦通罪ヲ罰スル法律ノ代リニ女子ノ姦通罪ヲ罰スル現行法律ヲ廢止セバ足レリト云フベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "空疎守舊ノ學説ト薄弱ナル意志ト衆愚ノ喝采ヲ足レリトスル虚榮ト、實ニ通俗政治家ノ標本タル「ウヰルソン」輩ノ通辯ニ得々タリシ所謂學者ナル者ノ反省ヲ要ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "露西亞ノ脅威ガ「ツアール」ノ亡ビタルヲ以テ去レリト考フル如キハ齒牙ニ足ラザル淺慮。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ノ兵役忌避ヲ本旨トスル「クエーカー」宗ノ如キハ、小乘教ノ基督ニ於テスラ天國ノ戰ヲ指シ、地上ニ於テ尚我レ刄ヲ出サンガ爲ニ來レリト宜シテ終ニ羅馬ヲ天火ニ亡シタル一面ヲ有スルニ係ラズ、只其ノ殺ス勿レノ一項ヲ盾トシテ盲守スルニ過ギザル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "士卒ヲ殺シテ士卒ニ赦サルル將軍ハ日本ノ最モ近キ將來ニ於テ千百人ト雖モ足レリトセザル必要アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人ハ古器ヲ好ミ一人ハ新器ヲ好メバ則チ人ハイマダ古器ヲ好ムヲ以テ勝レリトナサズンバアラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ニ隼村及ビ倉科ノ請地租ヨリ租米ヲ入レテ組合トナレリト云西久保ニテ此山奥ヲ東奥仙丈ト云。",
              "citation": {
                "source": "秩父の奥山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "石ヲ抱イテ水ニ入レリト。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大部分はカロリーの計算が主であるが、中に「近年陸軍ニ於テモ胚芽米ヲ使用シアル部隊尠カラザルモ患者統計ニ現レタル脚気発生率ハ之ガ使用ニヨリ特ニ影響ヲ蒙レリトハ認メ難シ」という節があって、添えてある表を見てもその通りである。",
              "citation": {
                "source": "兎の耳",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
