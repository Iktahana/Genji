        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "叙事は謂はば文人画風の型を作り、かくて人間的心情は所謂美――私にとつてはデコレイション――とその余りの部分とに分裂した。",
              "citation": {
                "source": "詩と詩人",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟とはコーポレイション街一二六番地のＢで会えるかと。",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "コーポレイション街一二六番地のＢ。",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜七時、我々は三人してコーポレイション街を下り、その会社の事務所へと向かった。",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "大森は中央階段をのぼり、デコレイション・ケーキのような、屋上出入口の踊り場で立ちどまった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファーストショットは、ちょっとハレイションを起こしたが、逆光のカットでいくことになった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうひとつは、ビーチボーイズの〈グッド・ヴァイブレイションズ〉が、異常な構造と、リズム・チェンジの多用、偏執的ハーモニーといった、ヒットをさまたげる要素を大量にかかえながら、先週、とうとうナンバーワンになったことだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、ここに〈マイ・ジェネレイション〉でいいだろ」「もっとソフトなほうが、つなぎやすいんだけどな」「うーん。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「べつに、かけたっていいけどさ……うん、四月にかけるよ、〈ソウル・アンド・インスピレイション〉」「〈ラヴィン・フィーリング〉にしろよ」「じゃ、あいだをとって、〈ジャスト・ワンス・イン・マイ・ライフ〉」「ま、いいや」　突然、ヴェランダのドアを叩く音がして、服部が素早くポータブルの針をあげる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "画面がハレイションを起こし、そのまま洗面所の光景にディゾルヴする。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "高志だって買っただろ」　六六年の『ペット・サウンズ』と〈グッド・ヴァイブレイションズ〉で、クリエイティヴィティの頂点にかけあがったブライアンは、さらなるものをもとめて、だれも考えもしなかった世界に入りこんだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "豪傑英雄は特に至粋のインスピレイションを享る者にてあれど、シイザルはシイザルにて、拿翁は拿翁たるが如く、至粋を享くる量は同じくとも、其英雄たるの質は本然に一任するのみ。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "バイブレイションがちがうのだ。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆき子はリュックからレイションを二箱出して細君へ土産代りに出した。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな枕や、重い小箱やレイションや菓子を並べた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦痛の中にそのものが描かれてゆくことのなかに、大きい一つのコンソレイションがあるべきです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（哲学的に、ね）文学の面白さとこの人間精神のコンソレイションの関係は面白いこと。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "小説の面白さと精神のコンソレイションの話。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、男性の創る芸術的作品――文学でも美術でも――の中には、夥しく女性に対するアドレイションが表現されている。",
              "citation": {
                "source": "わからないこと",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだのに、女性の作品には、何故同じような男性に対するアドレイションが現されないのだろう、と云うことだ。",
              "citation": {
                "source": "わからないこと",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――僕の尺度――　　　　　＊189　僕はインスピレイションという言葉の気弱い曖昧な味を、もう口にしようとは思わなかった。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "自意識という巨大な機械に注意するがいい、感傷詩人のインスピレイションなど、幾つでも製造できるではないか。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、ジェミエは言つてゐます、人類の最後のゼネレイションに到つて、初めてシェイクスピアの新しい意味が解かれるだらうと。",
              "citation": {
                "source": "フランスに於けるシェイクスピア",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "人類の最後のゼネレイションといふと、何十万年後でありませうか、その時にならなければシェイクスピアが解らない――とも言へますし、また、今日は今日として、よくシェイクスピアが解つてゐても、更に後の時代になれば、シェイクスピアは更に新しい姿になつて生れ代つて来る――といふ風にも解釈されるのです。",
              "citation": {
                "source": "フランスに於けるシェイクスピア",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "記録的要素は作品の中で全体のオーケストレイションを妨げていない。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "京大出身のＴ中尉と東大出身のＷ軍曹とが主になって収容所のアドミニストレイションに当っていたが、二人とも気持のいい人で、愉快に仕事を手伝ってくれた。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　ジャックはこの頃生活気分に一つの行きつまりを感じ、生来の冒険好きからして、船で世界一週を試みて気分の転換と、新たなインスピレイションを求めたい衝動を感じていた。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
