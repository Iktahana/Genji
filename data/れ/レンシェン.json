          "literary": [
            {
              "text": "そして、宝石のようなレンシェンをつれて。",
              "citation": {
                "source": "カール・マルクスとその夫人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛称をレンシェンとよばれたヘレーネ・デムートはイエニーの少女時代からの召使いであった。",
              "citation": {
                "source": "カール・マルクスとその夫人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "レンシェンはこの時以来、一生をマルクス家の悲しみと喜びとの中に費してその勤勉と秩序で一家の軸となった。",
              "citation": {
                "source": "カール・マルクスとその夫人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "丈夫なレンシェンも熱を出しはじめている。",
              "citation": {
                "source": "カール・マルクスとその夫人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マルクス家の軸」であるレンシェンが腕に下げて来るドイツ風の大籠の中の大きい焼肉のかたまり。",
              "citation": {
                "source": "カール・マルクスとその夫人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女と年取ったレンシェンとがカールの命を救った。",
              "citation": {
                "source": "カール・マルクスとその夫人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
