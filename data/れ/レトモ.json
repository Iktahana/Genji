          "literary": [
            {
              "text": "此山ハ村持ナレトモ松洗院ニ託シテ別当ノコトクセリ、明神ノ眷属トテ犬アリ、此犬ヲ乞ヒ借リ、狐ツキ或ハ猪鹿ノ防ヲナスニ応験アリトテ、比隣ノ村郷祈誓シテ参詣スルモノ多シ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレトモ案外泣クカ知ラ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子モ一緒ニ出テ行ッタノカ、ソレトモ流石ニバツガ悪イノデ一人デ二階ニ引ッ込ンデイルノカ、一向姿ヲ現ワサナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレトモコノ花ガ、ヒョットスルト枕花ニナルカモ知レナイト考エテ特ニ念ヲ入レテ活ケタノデモアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレトモ、私になんかかくしてるの？",
              "citation": {
                "source": "赤い手帖",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
