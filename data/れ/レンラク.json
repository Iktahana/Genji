[
  {
    "uuid": "f3b4eb05-b6cc-5cb9-9869-99dfd3c6114e",
    "entry": "連絡",
    "reading": {
      "primary": "れんらく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
