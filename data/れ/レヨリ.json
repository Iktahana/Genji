        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　――オマエハ、モウ、ソレヨリ、オオキクナッテハ、イケマセンヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――ワガ恐竜第六十戦隊ハ、コレヨリ敵艦隊ノユダンニツケイリ、ナルベク早ク所期ノ目的ヲハタシタ上デ、全艦海底要塞ヘヒキアゲント欲ス。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙にはこうあった、ボクノ　大スキナ　オ母アサマキョウ　ボクハ　七ツニナリマシタ　七ツトイウト　モウ　イイ子ニナラナクテハイケナイ年デス　ボクハ　コノ年ヲ　ボクヲ生ンデ下サッタ　オ母アサマニ　オ礼ヲ云ウタメニ　ツカイマスオ母アサマガダレヨリモスキナオ母アサマノ子ロベエル　手紙はこれだけだった。",
              "citation": {
                "source": "ある自殺者の手記",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヨリ（治ヲ）請フ者日ニ多シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヨリ先母氏｜膈ヲ患ヒタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヨリ先朝廷高崎藩ニ命ジテ仮ニ石巻ヲ鎮セシム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヨリ以北ハ仙台藩ノ旧封域ニ係ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヨリ南スルコト四里ニシテ多賀ノ城墟アリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに大槻文彦博士の『大言海』には「ぎョくろ　玉露　製茶ノ銘、上品ナル煎茶ノモノ　文化年中ヨリ、山城宇治ニテ製シ始ム、其葉ヲ蒸ス時、上ニ新藁ヲ覆ヒトシ、ソレヨリ滴ル露ヲ受ケテ、甘味ヲ生ズト云フ」とあって、その玉露の語原がいささか前説とは違っている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ何カ不能ニナッタ老人ノ性生活―――不能ニナッテモ或ル種ノ性生活ハアルノダ―――ト関係ガアルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハソレヨリモ、春久ト颯子トガドンナ工合ニ接触スルカ、ソノ様子ガ見タカッタノデアルガ、団欒ノ中ニ加ワッテカラ三四十分モシタ時分、次第ニ脚カラ腰ノ周リガ冷エテ来ルノニ心ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ忰ハ寧ロ彼女ノ経理ノ才ヲ徳トシテ、彼女ヲ失ッテハ不便デアルト考エテイルノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ、ソレヨリモ、颯子ノ容貌風姿ヲ見タラ母ハ何ト思ウダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ油谷サンノ奥サンガ何ヨリ先ニ眼ニ附イタノハ、颯チャンノ指ニ光ッテイタキャッツ・アイダト云ウンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ一度腎臓ノ検査ヲシテ見ル必要ガアリマスナ」ト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナ顔、アタシニ見セタッテ何デモナイワ、ソレヨリ自分デ自分ノ顔ヲヨク見タコトガオアリニナルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヨリ以後数日間ハ執筆ニ堪エズ、数日後佐々木ノ病床日誌ニ依ッテ記入スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鄭板橋ノ書ガゴザイマスガ御覧ニナッテ下サイマスカ」「ソレヨリ君、突然妙ナオ願イヲスルヨウダガ、アッタラ売ッテ貰イタイモノガアルンダ」「何デゴザイマス」「紅絹ノ裂ヲ二尺バカリト布団綿ヲ一ト塊、分ケテ戴キタインダガネ」「変ッタ御用ヲ承リマスナ、一体何ニナサルンデ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ午後ノ列車ヲ捉エテ颯子ノ跡ヲ追ウコトニ決メ、毎日新聞支局ノ友人ニ依頼シテ無理ニ切符ヲ手ニ入レテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリコノ日記ヲ読ンデサエクレレバソノ内容ニ虚偽ガアルカ否カハ自然明ラカニナルデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ、ソレヨリモ何ヨリモ、今ノトコロ僕自身ガ自分ヲ制御デキナクナッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ僕モ考エルガ、ソレヨリ先ニ彼ラガ考エ出サズニハ措カナイデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ソレヨリ、此附近ニ巨キナ海坊主ガ出マスカラ注意シテ下サイ。",
              "citation": {
                "source": "流血船西へ行く",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其レヨリ漸々、敵味方モ見分ケタリ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
