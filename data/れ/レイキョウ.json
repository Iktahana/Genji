[
  {
    "uuid": "9308bb6c-b218-5231-a6ae-4dc42f3455bf",
    "entry": "礼教",
    "reading": {
      "primary": "れいきょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
