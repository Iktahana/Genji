        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "社員の親睦を深めるため、会社主催でバーベキューなどのレクリエーションが企画された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "地域の公民館では、子供からお年寄りまで楽しめる様々なレクリエーション活動が行われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "キャンプでの一番の楽しみは、夜のキャンプファイヤーを囲んで行うレクリエーションの時間だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "四　レクリエーション　学校では教室や実験室での教育のほかに、レクリエーションとして、運動会や音楽会のたぐいが行なわれる。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "基督教の真理を学ぶについても、それにふさわしいレクリエーションがある。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは一種のレクリエーションであって、先生がコチコチの型にはまった宗教家の弊に陥らないで、聖書の理解が深く広くあったことの一つの原因は、先生の学問的興味の範囲が広くあった点にあると思われる。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に、音楽、絵画等の芸術もまた、キリスト教の真理を学ぶためのレクリエーションでありうる。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に、自然の美を楽しむことが、キリスト教の真理を学ぶについての一大レクリエーションである。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "学問、芸術、自然、すべてキリスト教の真理を学ぶためのレクリエーション的意味をもつが、しかしこれらのものが重んぜられて、聖書を学ぶことが軽んぜられるならば、それは本末顛倒である。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "往々にしてキリスト教会が、説教、音楽、社交、パーティー、ピクニック等に力を注いで、聖書の研究もしくは講義を軽んずるきらいがあるのは、レクリエーションを主として教室や実験室での教育を軽んずる学校のようなものであって、その建て前が根本的に誤っている。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりに世俗的なレクリエーション宗教に対しては、ある程度ピューリタニズム精神への復帰の必要が感ぜられるのである。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "家中そろってのレクリエーションにはもってこいだ。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本全国津々浦々に魚釣りの会があり、各会社、各工場、各学校にそれぞれレクリエーションとして、毎月、魚釣りの会を催している。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとやはりレクリエーションの意味で、ひまをつくってどこかへ出かけることになるだろうが、それもせいぜい日帰りの、まずは梅鉢草や松虫草の山だろう。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "休息とレクリエーションで適度に補償されていない過度の労働は身体と心を消耗させることによって人間の自然の抵抗力を少なくする。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "この悪い影響を打ち消す唯一の方法は労働時間を減らし休息およびレクリエーションのために有給休暇を与えることである。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "予防医学の合理的なプログラムは労働大衆にたいして年次休暇および休息とレクリエーションの方法を前もって準備するだけではない。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "可能なかぎり最良の衛生条件、労働、休息、レクリエーションの正しい釣り合い、しかるべき生活水準を保つことができる給料、これらは公衆衛生にとって基本的な重要な要因である。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デイトってほどのことじゃなくてさ、ちょっとしたリクリエーション」「のぼせあがりやがって」「いいよ、かけて」　差しだされた慶一の頭の上で、高志が桶をかたむける。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "集団的にリクリエーションを愉しむことを学びつつある日本の働く女性たちは、社会的な集団の感覚で、あらゆる職場で働いている同性たちの生活への理解、共力を新鮮に育てて行くべきであろう。",
              "citation": {
                "source": "働く婦人の歌声",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "成人教育　文部省社会教育局は各都府県の社会教育課と連絡をもっていろいろの講習会、公民館運動、リクリエーション運動などに努力してきている。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リクリエーション運動の指導は地方警察と連絡すべしというような反民主的な本質をもっている。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの現代の施設は教育やリクリエーションの設備がよく整っている。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京に出て日本橋の丸善に品物を届けてお金をうけとつて、帰りに銀座をぶらついて、コーヒー店のハシゴをして、友達に会つてしやべつてくるのが、私のリクリエーションです。",
              "citation": {
                "source": "オルゴール",
                "author": "三好達治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は好んでレクリエーシヨン、即ち、楽しみ乃至趣味といふことを説いてゐる。",
              "citation": {
                "source": "趣味としての読書",
                "author": "平田禿木",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
