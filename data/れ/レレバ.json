          "literary": [
            {
              "text": "フタリハ　オタガヒニ、ムカフガ　サキニ　ネムツテ　クレレバヨイニ、トオモヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリコノ日記ヲ読ンデサエクレレバソノ内容ニ虚偽ガアルカ否カハ自然明ラカニナルデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ勧メラレレバ黙ッテカナリノ量ヲ嗜ム。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ガソコマデデ蹈ミトドマッテクレレバヨイガ、ソレ以上ノニナル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
