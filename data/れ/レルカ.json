        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "タケノコタチハ　トホクヘ　イキタガツテ　シヨウガ　ナイノデ、オカアサンノ　タケガ、「ソンナニ　トホクヘ　イツチヤ　イケナイヨ、ヤブノ　ソトニ　デルト　ウマノ　アシニ　フマレルカラ」ト　シカツテ　ヲリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイヘン突拍子モナイコトヲ言イ出シタヨウニ思ワレルカモシレナイガ、少シ落着イテ考エテミルナラ、別ニ奇抜ナコトデモ何デモナイコトガワカル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツコラレルカヘンマツユリコ一〇ヒカヘル。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――恒産ナキ俸給生活者ノ為ノ夏季保健静養地実費提供といふ見出しで、諸君ハ別荘ト云フ言葉ヲ聞イテドウ思ハレルカ。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、政府委員は『「パノラマ」ノヤウナ一ツノ纏ツタモノデアリマスレバ、是ハ疑ナク著作物ト認メラレルカト思フ』と答へてゐる。",
              "citation": {
                "source": "演劇・法律・文化",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔吾ガ俗奇ヲ好ムコト何ゾ此ニ至レルカ／小草大花殆ンド弟兄ナリ／昨日官家俄カニ令ヲ下シ／其ノ尤アル者ヲ罪シ価太ダ軽シ／富家失望シテ諸ヲ市ニ売リ／花戸色｜沮ヒテ品評ヲ厭フ〕云々。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "この第四句は、原文「吾者生鹿」で、旧訓ワレハナリシカ、代匠記ワレハナレルカ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ場合ドチラニ餘計惹カレルカト云エバ、近頃ノ予ハＡヨリＢニ惹カレルコトハ先ズ確カデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ニ墓ナンカ作ッタラ、ドンナ時ニドンナ都合デドンナ所ヘ移転サセラレルカ分ッタモンジャナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日蓮宗ガ嫌イデアル主ナ理由ハ、佛壇ニ、頭ニ綿帽子ヲ載セラレタ泥人形ノヨウナ日蓮上人ノ像ガ飾ッテアッテ、ソレヲ拝マセラレルカラダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オ前ガモ一度連レテッテクレルカ」「アタシガオ供スレバ見テ下サル？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂ヘ出レバ颯子ノ顔ガ見ラレルカモ知レナイト思ッタノダガ、「出テハイケマセン」ト止メラレテ、オトナシク云ウコトヲ聴ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体誰ガコノムズカシイ仕事ヲ引キ受ケテクレルカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ僕ガ木村デアッタトシテ、ドッチニヨケイ惹キ付ケラレルカトイエバ、ソレハ、年ハ取ッテイルケレドモ母ノ方デアルヨリモ、僕自身ハドンナツモリナノダロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ノ目的ハ、コレラヲ僕ノ日記帳ニ貼付シテオクハ希有ノニヨッテ彼女ヲ極度ニ辱カシメ、彼女ガドコマデシラヲ切ッテイラレルカヲ試シテヤリタイノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ母サンニハ緞子ト呉絽ノ帯地ヲ持ッテ行クト云ッテ下サイ、ドウセ僕ノオ見立テダカラ例ニ依ッテ悪口ヲ云ワレルカモ知レナイ、君ノ犬ヨリコノ方ガ心配ダト云ッテ下サイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その長編が非完結的な性格に終ったことについては、最近ある評者（シュトレルカ）が、注目すべき見解を述べている。",
              "citation": {
                "source": "「世界文学大系58　カフカ」解説",
                "author": "原田義人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
