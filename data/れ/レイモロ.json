        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "惟井上金峨の所謂「廃陰陽、排五行、去素霊諸家、直講張仲景書者」たることを欲せなかつたのである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　君――或は心霊諸君は死後も尚名声を欲するや？",
              "citation": {
                "source": "河童",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　心霊諸君の生活は如何？",
              "citation": {
                "source": "河童",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　君――あるいは心霊諸君は死後もなお名声を欲するや？",
              "citation": {
                "source": "河童",
                "author": "どうか Kappa と発音してください。",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
