          "literary": [
            {
              "text": "フレドリック・マーチの小型みたいで……」　新子は、背中一杯に針をさされるような気がした。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからすぐレドリックに向って出発し、その日の午後、家に着き、妻子たちの元気な顔を見ることができました。",
              "citation": {
                "source": "ガリバー旅行記",
                "author": "GULLIVER'S TRAVELS",
                "note": "青空文庫"
              }
            },
            {
              "text": "リン家のヘンリイとフレドリックは、實に、めかしたてゝ意氣な伊達者だ。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "フレドリック・リン氏は、メッリー・イングラムの直ぐ傍に掛けて、立派な書籍の印畫を見せてゐる。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とフレドリック・リンが叫んだ。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
