        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "インド料理店で、スパイスの効いた美味しいレンズ豆のカレーを食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "レンズ豆は栄養価が高く、スープやサラダなど様々な料理に使われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "母は、煮込み料理にレンズ豆をよく加える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "それ故に人々はこの病気を「レンズ豆または小斑点」と呼んだ。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "この斑点は小さなレンズ豆またはノミが刺した跡に似ていたからであった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるものの身体にはレンズ豆の大きさの黒い疱疹が吹き出ていた。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらは俗に「レンティクラエ」（小さなレンズ豆）とか「プンクティクラエ」（小さな刺し傷）と呼ばれている。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "レンズ豆またはノミに刺されたような点を作るからである。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
