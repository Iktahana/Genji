        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "予ハ三十分グライ一人デ寝室ニ待タサレテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ガ先ニシャワーヲ浴ビタト見エテ、ビニールノ帽子カラ水ガタラ／＼滴レテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "早クモ彼女ハバス・カーテンノ中ニ隠レテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………僕ハ今年カラ、今日マデ日記ニ記スコトヲ躊躇シテイタヨウナ事柄ヲモアエテ書キ留メル、自分ト妻トノ関係ニツイテハ、アマリ詳細ナヲ恐レテイタカラデアッタガ、今年カラハソレヲ恐レヌハシソウモナイケレドモ、シカシ必ズシモソウトハ限ラナイ理由モアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "情事ノハアルケレドモ、ソレモ上半身ノ一部ニ限ラレテイタノデアッテ、情事ニ必要ノナイトコロハ絶対ニ見セテクレナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトニ足首ノトコロガ十分ニ細ク括レテイナイノガ缺点ダケレヲ許サレテイタダケデ、コノ素晴ラシイ肉体ヲ眼デ視ルヲ得ル夫ハ、今カラ新シイ結婚ヲ始メルノト同ジダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ今日マデワザトコノニ、中硝子ノ中ヲ覗クト妻ガ不安定ナ姿勢デ食卓ニ靠レテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イニシテソノ麻痺状態ニ置カレテイタ期間ハモノノ二三十分ニ過ギズ、間モナク遮断サレテイタ神経ノ通路ガ復舊シ、失ワレタ記憶ガ戻ッテ来テスベテガ平生ノ通リニナッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ノ方カラモソノハ、髪ガ解ケテ乱レテイテ襦袢ノ襟ガヒドク濡レテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁ノハンガーニハアノ衣裳ガマタダラリト垂レテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷物ガ沢山持チキレナイホドアリマス、犬ヲツレテイタラ電報ヲ打ツカラ誰カ船マデ受ケ取リニ来テ下サイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「盧員外（盧は大員外トモ呼バレテイタ）どの、盧員外どの。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
