        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カメレオンの乘つてゐた書物はショペンハウエルのパレルガ・ウント・パラリポメナ。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノコトハ子規ノ書イタモノニカタカナ文ガ多イコトヤ、宮沢賢治ノ病中作デアル「雨ニモ負ケズ」ノ詩ガカタカナデアルコトナドデ間接ニ証明サレルガ、ナオソレニツイテイササカインチキナガラ力学的ニ考察シタ文章ヲ他ノ場所ニ発表シタカラココニハ書カナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "○方今我諸州｜正シク此ノ難ニ罹レルガ故ニ、政府旧来ノ法ヲ変革スルハ諸州一般止ム得ザルノ急務ナリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "蕨ノ根ニ隠リテカヾマリヲレルガ、春ノ暖気ヲ得テ萌出ルハ、実ニ悦コバシキ譬ナリ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "間脳の方は、ベレルガールで治りますよ。",
              "citation": {
                "source": "ジストマ退治の話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベレルガールというのは、妙な薬である。",
              "citation": {
                "source": "ジストマ退治の話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "車内ノ暑サモ思イヤラレルガ、冷房ガヒトシオ厳シイニ違イナク、手ノ痛サノ方ガ心配デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "団子ノ治兵衛ハ如何ニモ一生懸命デ、全力ヲ盡シテイルコトハ認メラレルガ、餘リ一生懸命過ギ、緊張シ過ギテコチ／＼ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯カラ上ルト、ウシロカラタオルデ拭キ、ベビーパウダーヲ振リカケ、扇風機ヲカケテクレルガ、決シテ前ヘハ廻ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ先刻カラ或ル計画ガ心ニ浮カビツツアッタノデ、内心ハ木村ガ帰ッテクレルガ今夜コソ実行デキルト思イ、ソノ期待デ興奮シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピアノダケハ運搬ノ都合デ二三日｜後レルガ、他ノ荷物ハ木村ガ手伝イニ来テ大体運ンダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
