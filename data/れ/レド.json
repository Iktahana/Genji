        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "太宰イツマデモ病人ノ感覚ダケニ興ジテ、高邁ノ精神ワスレテハイナイカ、コンナ水族館ノめだかミタイナ、片仮名、読ミニククテカナワヌ、ナドト佐藤ジイサン、言葉ハ怒リ、内心ウレシク、ドレドレ、ト眼鏡カケナオシテ、エエト、ナニナニ？",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カクテアシタハヒルトナリ、　　水音イヨヨシゲクシテ、　鳥トキドキニ群レタレド、　　　ヒトノケハヒハナカリケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモマダミンナキマセンゴザイマス。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この西班牙への旅--殊にトレド一帶の何か不安を帶びた風物――は、詩人にはいたく氣に入つたやうに見える。",
              "citation": {
                "source": "トレドの風景",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその地方、――殊にトレドは、ドゥイノ及びヴェニスと共に、晩年のリルケの胸奧にもつとも深く鳴りひびいた三つの大きな諧調ともなつたのである。",
              "citation": {
                "source": "トレドの風景",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "此のトレドがリルケの生涯にはじめて現はれたのは、おそらく一九〇八年の秋ロダンに宛てた次ぎの手紙（丁度「マルテの手記」に筆を下ろさうとしてゐた時分である）で、それもトレドの畫家エル・グレコの鬼氣を帶びた筆を通してであつた。",
              "citation": {
                "source": "トレドの風景",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九〇八年十月十六日、巴里ヴァレンヌ街七十七番地ロダン樣　私は展覽會でグレコの「トレド」の前に一時間ばかり過して歸つて參りました。",
              "citation": {
                "source": "トレドの風景",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドレドレと精は急いで受取って足を握って羽をバタ／＼さす。",
              "citation": {
                "source": "鴫つき",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホズマ――エインジェルさん――は、レドンホール街の事務所で出納係をしていらして――それで――」「業種は？",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いえそれが――レドンホール街とだけ。",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「レドンホール街郵便局へ、留置で。",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "過去レドンホール街の事務所に勤務。",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほら日付もあるが、差出人の住所にはレドンホール街とあるだけで、かなり曖昧だ。",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレドの街の壯觀は我前に横はりぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "羅馬及ミラノにては大街をコルソオと曰ひ、パレルモにてはカツサロと曰ひ、拿破里にてはトレドと曰ふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "コルソオの大路は長しと雖、繁華なるトレドの街と異なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド富貴栄達ノ相アレバ、一国一城ノ｜主タラム。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド道ニ喧嘩口論ヲ挑ム者アリ、手向イ致サバ怪我スル恐レアレバ、逃グルニ如カズ。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド富貴栄達ノ相アレバ、一国一城ノ主タラム。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼間のことなれば、やいの、やいのと、呼ンダレド、呼ンダレド、だれも助けに来ねえとなり。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "春が来て、ヒトリ寝ルノハイヤナレド、花が咲くゆえがまんできけり」「おっといけねえ、いけねえ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "37まだ子どものころよくレドウッドの樹の下にいったものだ雨のにおいと、そしてときには雷のにおいまでしたっけ〈レドウッド・トゥリー〉ヴァン・モリスン（ゼム）　東屋にいれば、住宅密集地は、校舎とグラウンドをはさんだ向こうなので、このキャンパスに、あれほどの大変化があったのを、忘れられないこともない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "手もとにある場合は国内盤の歌詞カードを参照しているが、最終的にはじぶんの耳がたよりなので、あなたがご存じの歌詞とはズレがあるかもしれない（とりわけ〈ホエン〉と〈レドウッド・トゥリー〉）。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
