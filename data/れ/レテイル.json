        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イツカあなたニ絵ヲ見テモライマシテカラ故郷デ貧乏漁夫デアル私ハ、毎日忙シイ仕事ト激シイ労働ニ追ワレテイルノデ、ツイコトシマデ絵ヲカイテミタカッタノデスガ、ツイカケナカッタノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在カタカナガ一般ニ使ワレテイルノハ数学書、法律書、官報、軍関係ノ書類ナドデアルト思ウガ、イズレモ最モ正確ヲ期セナケレバナラヌ種類ノモノバカリデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今マデ愛シニ愛シタ女ガ、ネマキ一ツデ顔ニ傷ヲ受ケテ倒レテイル姿ヲ見テ急ニ惨忍ナ気持デ一杯ニナリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカル未知電波ノウチノアルモノハ、時ニ雑音トイウ名ノモトニワレワレニ知ラレテイル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅イ動脈ダツテアンナニ皮膚ニ埋レテイルト……見ヨ！",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネオンサインダツテアンナニジーツトシテイル様ニ見ヘテモ実ハ不断ニネオンガスガ流レテイルンダヨ。",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――肺病ミガサツクスフオーンヲ吹イタラ危イ血ガ検温計ノ様ニ　――実ハ不断ニ寿命ガ流レテイルンダヨ。",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンマーイタリアンファッションノ陳列ガアッテ、有名ナデザイナーノデザインニ依ルイタリー好ミノオートクチュールノ服ガ沢山飾ラレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「困ッタナ、僕ハトウニ食ベチャッタンデ、梅肉ヲ下ゲテ行ッチャッタンダ」「梅肉ダッテコヽニアルワ」ト、颯子ハ鱧ト一緒ニ自分ノ梅肉ヲ廻シテヨコシナガラ、「梅肉ダケ別ニ取リマショウカ」「ソレニハ及バナイ、コレデ結構」颯子ハタッタ二片ダケシカ食ベナイノニ、梅肉ガワリニ穢ラシク喰イ荒サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅肉以上ニ喰イ散ラサレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩カズニイルト、今ニ本当ニ歩ケナクナリマスト嚇カサレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供ヲ二人連レテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルコール類ト刺戟物ト塩カライ物トハ禁ジラレテイルガ、食慾ハ常人以上デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時ニ依ルト顔ニ一種ノ残虐性ガ現ワレテイル女ガアルガ、ソンナノハ何ヨリ好キダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――ト云ウノハ、タイルニシテ見タラ濡レテイル時ツル／＼滑リ易クッテ、老人ハ危クテ仕方ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビニールノ帽子ヲ被ッタ顔ガ頭カラビショ／＼ニ濡レテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャワーヲ浴ビツヽアル彼女ノ全身ハ白地ニ粗イグリーンノ縦縞ノバス・カーテンデ囲ワレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾ流シ場ノタイルヤ周囲ノ壁ニ夥シク水ガ飛ビ散ッテ濡レテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モット人ノ悪イ邪推ヲスレバ、予ニ疑ワレテイルコトヲ知ッテイル颯子ハ、治療ノ隙間ニ予ガ廊下ヘ出テ様子ヲ探ルコトモアリ得ルト、推量シタノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新シ物好キノ颯子ハ去年台所ヘディスポーザーヲ取リ附ケタガ、彼女ニ依レバ「マダ食ベラレル筈」ノ薩摩薯ヲ放リ込ンダト云ッテ、オ節ガヒドク叱ラレテイルノヲ見タコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦災ノ時ニ又モウ一度改築シタガ、隠居所ダケハ奇蹟的ニ火災ヲ免レタノデ、今モナオ父母アリシ日ノ姿ノマヽニ保存サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "半バ夢ノ中デ自分ガ今モ割下水ノ家ニイルヨウニ感ジ、寝床ノ中デ乳母ニ抱カレテイルヨウニ感ジル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子モ世間カラ美人ト云ワレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレデハ風邪ヲオ引キニナリマス」佐々木ガ又這入ッテ来テ汗デ濡レテイルガーゼノ肌着ヲ着カエサセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ二十分バカリ待タサレテイル間ニ同博士ト談話ヲ交シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "経助ガ犬小屋ノ前デレスリーニ戯レテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖父母ヤ父母ニシタトコロデ、昔最初ニ埋メラレタ場所ニ埋メラレテイル訳デハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒ヲ厳シク禁ジラレテイル予、下戸ノ五子、少シハ行ケル筈ナノニ慎ンデイル佐々木ヲ除イテ、颯子、菊太郎兄弟ノ三人デ調子ガ弾ミ、九時近ク食事ガ終ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少クトモ今日一般ニ行ワレテイル長方形ノノッペラボウノ石ノ表面ニ戒名又ハ俗名ヲ記シ、ソノ下ニ台石ヲ据エテ、ソノ前ニ線香立テノ穴ト手向ケノ水ヲ供エル穴トヲ穿ッテアルアノ形式、アレハイカニモ平凡デ、俗ッポクッテ、何事ニモ旋毛曲リノ予ニハ気ニ入ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "観世音ニハ多少ノ破損ガアルケレドモ勢至像ハ全ク完全ニ保存サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
