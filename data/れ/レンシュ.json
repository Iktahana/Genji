        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "そのテニス選手は、強力なサーブで連続してポイントを連取し、試合の流れを一気に引き寄せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "クイズ番組で、彼は難問を次々と正解してポイントを連取し、トップに躍り出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は重要な局面で連取に成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "いまはれんしゅうだから、火はついていない。",
              "citation": {
                "source": "ふしぎな人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうは、れんしゅうはこれまでにしておこう。",
              "citation": {
                "source": "ふしぎな人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、近いところを、いくども飛ばせて、れんしゅうさせたうえ、きょうの夕がた、ぼくの助手が、こうがいの森の中から、五羽の鳩をはなったのです。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
