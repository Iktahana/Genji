          "literary": [
            {
              "text": "従つてレイゼ・ドラマとしては好いが、やつて見たら、存外印象がはつきりしなくはないか。",
              "citation": {
                "source": "存在",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷泉をレンゼイ（後にはさらにレイゼイと訛る）、定考をコウジョウ、称唯をイショウ、新たしいをアタラシイ、身体をカダラ、茶釜をチャマガ、寝転ぶをネロコブという類みなこれである。",
              "citation": {
                "source": "サンカ者名義考",
                "author": "――サンカモノは坂の者",
                "note": "青空文庫"
              }
            }
          ]
        }
