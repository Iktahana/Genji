        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「クレヨン社の、……」　名前まで言わせる気かい。",
              "citation": {
                "source": "渡り鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いつか、クレヨン社に原稿を持ち込んで、あなたに荷風の猿真似だと言われて引下った男ですよ。",
              "citation": {
                "source": "渡り鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "高邁ノ精神ヲ喚起シ兄ガ天稟ノ才能ヲ完成スルハ君ガ天ト人トヨリ賦与サレタル天職ナルヲ自覚サレヨ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "努メテ厳粛ナル五十枚ヲ完成サレヨ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、日本国内ニ於テハ、農村ヤ工場ニ於テ、資本家ヤ地主カラ搾取セラレ、支那ニキテハ帝国主義ブルジョアジーノタメニ命ガケノ血ナマグサイ戦争ヲサセラレヨウトシテイル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりオレのギターは、ハチャメチャのヨレヨレのドシャドシャだったのである。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　――オマエハ、モウ、ソレヨリ、オオキクナッテハ、イケマセンヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それじゃお父つあん、町へいったらついでに学用品屋で由太に王様クレヨンを買って来てやってな。",
              "citation": {
                "source": "最後の胡弓弾き",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "末っ子の由太のためにたのまれた王様クレヨンを買った。",
              "citation": {
                "source": "最後の胡弓弾き",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "クレヨンの包みを受けとると木之助は慌てて、ゴムの長靴を鳴らしながら、さっきの古物屋の方へひっかえしていった。",
              "citation": {
                "source": "最後の胡弓弾き",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、さっき由太のクレヨンを買うときは、味噌屋で貰ったお銭で払ったのだ。",
              "citation": {
                "source": "最後の胡弓弾き",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ、オモヒダセナイノデ、トウトウ　オコツテ、カタツムリヲ　ツブシテ　シマハウト　シタ　トキ、フツト　オウサマノ　ココロニ、「デンデン　ムシムシ　ツノ　フレヨ、夜アケニ、ヌストガ　ヤツテ　クル」ト　イフ　ウタガ、ウカビマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつが腹の中の体温で発火してアレヨアレヨと驚くトタンに、三町四方の霊魂がフッ飛んだんだから思い残す事は無いだろう。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "殉職した警官や、藻屑になった漁民が何人あるかわからない……といった状態で、アレヨアレヨといううちに、対州鰤をアトカタもなくタタキ付けた連中が、今度は鋒先を転じて南鮮沿海の鯖を逐いまわし始めた。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレヨアレヨといううちに西北の烈風に煽られて、見る間に数十町歩を烏有に帰したので、都の消防が残らず駈けつけるなぞ、一時は大変な騒ぎであったが、幸いに人畜に被害も無く、夜明け方に鎮火した。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "地上の「面目」や「生活」に釘付けにされている親達や教育家は、只アレヨアレヨと騒ぐばかりである。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、サンタクロスのお爺さんに手紙だして、ね」「はい、はい、さあ書きますよ、みっちゃん、いってちょうだい」「ピアノよ、キュピーよ、クレヨンね、スケッチ帖ね、きりぬきに、手袋に、リボンに……ねえかあさん、お家なんかくださらないの」「そうね、お家なんかおもいからねえ。",
              "citation": {
                "source": "クリスマスの贈物",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタリア物も少し買ったが、そのついでに子供たちにやるクレヨンも買い整えてからふと見ると、日本製というマークが這入っていた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレヨアレヨと言うまにあふれあふれて、まわりに立つ人々の足を没せんばかりの勢い……。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "調子のいいことを言って、壺をかついであとについてきていた、そのいなせな若い者が、拍子を見てだしぬけにかけぬけて、ドンドンスッとんでゆくんですから、アレヨアレヨと言うひまもない。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "こわいもの見たさに刻々あつまってくる路前の人出も、あアレヨアレヨ！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレヨ、誰ぞある――」　春藤幾久馬と丹ちゃんは、その間に、手酌でせっせと傾けている。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "遉がに堅きを誇る鋼鉄製の扉も、この高熱火焔に会っては一とたまりもなく、パチパチと火花は四方に飛散し、アレヨアレヨと云っている間に黄金の鍵のさしこまれたまま金庫の鉄扉の真中には大孔が穿たれた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
