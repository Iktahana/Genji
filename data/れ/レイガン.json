[
  {
    "uuid": "7c63074f-89a1-58be-a285-2f5885018a31",
    "entry": "冷眼",
    "reading": {
      "primary": "れいがん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
