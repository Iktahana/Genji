        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "哲学あり、科学あり、人生を研究せんと企つる事久し、客観的詩人あり、主観的詩人あり、千里の天眼鏡を懸て人生を観測すること既に久し、而して哲学を以て、科学を以て、詩人の霊眼を以て、終に説明し尽すべからざるものは夫れ人生なるかな。",
              "citation": {
                "source": "各人心宮内の秘宮",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくするとお爺さんは私が先刻霊眼で見た一人の老人を連れて再びそこへ現われました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "霊眼が開けば目のあたりに亡き人の姿さえ見ることも出来るとのことでした。",
              "citation": {
                "source": "消えた霊媒女",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「十字架につけられ給いしままなるイエス・キリスト」を見て、汝の霊眼開かれ、罪を悔い改めて福音を信ずるならば、その時汝は幸福である。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "イエスの直感的なる霊眼に映ったものは、神殿の興隆ではなくして、かえって崩壊でありました。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
