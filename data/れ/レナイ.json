        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ホントニ、天才カモ知レナイ。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――樹明君近来の口癖はブチコワスゾである、何カヲブチコワサズニハヰラレナイホド、君は悩み苦しみ焦立つてゐる、そこで、私が先づ茶碗をぶちこはす、樹明君喜んで皿を投げつける、ガチヤンガラガラ、どうやら胸がすいたらしい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、コハレナイ　ウチニ、ムカシ、コノ　バシヤガ　マイニチ　カヨツタ　カイドウスヂヲ　ミセテ　ヤツテ、ソレカラ　モヤシテ　シマツタ　ハウガ　ヨイト　オモフ」　コドモタチハ　ミナ　サンセイイタシマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤリキレナイ脳髄の恐怖劇ではないか。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイヘン突拍子モナイコトヲ言イ出シタヨウニ思ワレルカモシレナイガ、少シ落着イテ考エテミルナラ、別ニ奇抜ナコトデモ何デモナイコトガワカル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシモコレヲ不調和ト感ジル人ガアツタラオソラクソノ人ガカタカナヲ見ナレナイセイカ、ソウデナカツタラ数学ノ本デ十分ニ痛メツケラレタ記憶ヲ持ツ人ニチガイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "十、世ノ中ニハ、ソノ気ニナルノハワケハナイガ実行ガ面倒ダトイウ問題ト、実行ハ簡単ダガナカナカソノ気ニナレナイ問題トガアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ夫ニハスマナイト思ウカモ知レナイケレド、アナタカラ文句ヲ云ワレルハズハナイワ」　ト言イ放ッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　モシ私ノ云ッタ事ニ対シテ、清三ガ少シデモ耳ヲ傾ケテクレタラ、私ハ清三ヲ殺サズニスンダカモシレナイノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "入レナイドコロカ、机ノ上ニデモアッタカ、ナイフヲイツノ間ニカ抜イテ、蒼白ニナッテフルエナガラ、突然私ニ斬リツケタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "再ビ生キテ皆サマニオ目ニカカレナイコトト覚悟ヲシテイマス。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ネギサンガ迷子ニナルカモシレナイトオモツテ、アトカラ、オツカケテキタトコロデス。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ヨツピテグツスリネコンダノニ、マダネタイデスガ、メガサメテシマツテネムレナイノデ、ホンヲヒロゲテヨミマセウトシマストキウニ、マドノスグソトデ、パタパタトハシリマハルオトガシマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ココヂヤアネムレナイ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンハイクラオコツテヰテモオ家ノ中ニヰルカライイヤウナモノノ、クライ夜道ヲ一人デトンデイツタボンコチヤンハ、モウ、ケツシテ、オ家ヘカヘツテコラレナイデセウ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「コレガ　センソウト　イフモノカモ　シレナイ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ウン、テキガ　セメコンダノカモ　シレナイ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "事の真相をここまで打ち開けて語るのはツレナイことかも知れないが、石川淳の逃げだした起雲閣という旅館は、隣まで焼けてきたがちゃんと残っているのであった。",
              "citation": {
                "source": "安吾巷談",
                "author": "熱海復興",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワガ旧作執筆ノ年代ニハ記憶ノ誤ガアルカモ知レナイ。",
              "citation": {
                "source": "正宗谷崎両氏の批評に答う",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンモ団十郎ノハ見タコトガアルカモ知レナイガ、記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ家ガ本所割下水ニアッタ時代デ、両国廣小路ノ、アレハ何ト云ッタッケナ、何トカ云ウ有名ナ絵草紙屋ノ店頭ニ助六ト意休ト揚巻ノ三枚続キノ錦絵ガ掲ゲテアッタノヲ今モ忘レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ／＼、ソレデ思イ出シタガ、予ニモ全然ペデラスティーノ趣味ガナイトハ云エナイカモシレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女モ訥升ガ好キナノデハアロウガ、或ハ治兵衛ノ団子ノ方ニヨリ興味ガアルノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ヲ云ウト予モ彼女ノ食イ残シガ廻ッテ来ルコトヲ豫期シテ―――或ハソレガ今夜ノ目的デ―――コヽヘ来タノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事中ノ雑談ニ、浄吉ガ二三日中ニ札幌ヘ出張スルカモ知レナイト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハトテモソンナ窮屈ナ姿勢ニハ耐エラレナイノデ、コノマヽデ我慢シテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ノ意見デ、整形外科ノ方ヘ行ッテ見テ貰ッタラト云ウノデ、先日虎ノ門病院デレントゲンヲ撮ッタノデアルガ、頸椎ノ辺ニ曇リガアルシ、手ノ痛ミガソンナニ激シイノナラ、事ニ依ルト癌カモ知レナイト嚇カサレテ、頸椎ノ断層写真迄モ撮ラセタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "老年ニナルト誰デモソウカモ知レナイガ、近頃予ハ一日トシテ自分ノ死ノコトヲ考エナイ日ハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日虎ノ門病院デ断層写真ヲ撮ラレタ時、癌カモ知レナイト云ワレテ附添ノ婆サンヤ看護婦ハ色ヲ失ッタヨウデアルガ、予ハマッタク平気ダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
