        "examples": {
          "standard": [
            {
              "text": "スモークサーモンは、低い温度でじっくりと時間をかけて煙を当てる冷燻という製法で作られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "チーズの冷燻に挑戦してみたが、温度管理が難しくて少し溶けてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は自作の燻製器を使って、ベーコンや生ハムなどの冷燻を趣味で楽しんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
