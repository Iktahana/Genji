        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヒラガナトカタカナハ相前後シテ生レタラシイガ、前者ハ毛筆ト和紙ニ対シ適合性ヲ持ツテイタタメ今日マデ愛用サレタニ反シ後者ハ適合性ヲ持タナカツタタメ、一千年ノ間カエリミラレルコトガナカツタ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　モシ私ノ云ッタ事ニ対シテ、清三ガ少シデモ耳ヲ傾ケテクレタラ、私ハ清三ヲ殺サズニスンダカモシレナイノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "３オ染サンガ新聞ヲ読ンデクレタラ日本軍ガ合戦ニ勝ッタソーデスネオジサンモ戦ッタノデスカソシテ敵ヲ殺シタノデスカ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時ニ行クカラ浄吉モ来ラレタラ来ルヨウニ云ワセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコレ以上生キナガラエテイタトコロデ格別ノコトモナイノダカラ、モシ今ノ世ニオ伝ノヨウナ女ガ現ワレタラ、ムシロソノ女ノ手ニカヽッテ殺サレタ方ガ幸福カモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ鏡ノ中ノ顔ガモット醜悪デアッテクレタラ、颯子ガ尚コノ上ニモ優秀ニ見エタヾロウニト残念ニ思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ颯子モイルコトダシ、―――颯子ハ南禅寺ヘ泊ルノハ懲リ／＼ダカラ、ソレダケハ堪忍シテクレト云ッテルンダ」「ドッチニシタッテ颯子ガ行ッタラ又喧嘩デスヨ」「掴ミ合イデモ始メテクレタラ面白イサ」婆サントソンナ遣リ取リヲスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
