          "literary": [
            {
              "text": "或日村から出て来て汽車を降りた私は、停車場前の「レゾート」に腰を掛けて、水を呑んでゐた。",
              "citation": {
                "source": "熱い風",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "左う云へばいつかアトリヱの帰りにりら子と、停車場の前のレゾートで晩飯を共にした時だつて、私はもぬけのからのやうにぼんやりしてしまつて小さな失敗ばかりを繰り返した。",
              "citation": {
                "source": "心象風景（続篇）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "三時にレゾートで待合さう。",
              "citation": {
                "source": "心象風景（続篇）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
