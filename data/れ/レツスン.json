          "literary": [
            {
              "text": "予定のレツスンに入つてからも、Ｙ氏の読みにつれて、眼は行を逐ふては行くけれど、頭の中の黒い影が、行と行の間を、字句の間を覆ふて、まるで頭には入つて来なかつた。",
              "citation": {
                "source": "乞食の名誉",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "レツスンが済むと、何時ものやうに熱いお茶が机の上に運ばれた。",
              "citation": {
                "source": "乞食の名誉",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボールと八卦　芝浦にレツスン倶樂部があつた頃である。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
