          "literary": [
            {
              "text": "其ノ屍体ハ油倉庫ノ中ニ投ゲ入レラレ、放火サレタカラ灰ニナリマシタ。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ隣室ニ監禁セラレタル予ノ案内人ノ室ノ更ニ隣室ニシテ、同様物置ナル所ヘ一時｜抛ゲ入レラレタルヲ知リタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ母サン　ニツレラレテ学校ヘ行ツタノヨ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨガ　アケルト　ブチト　シロハ　オユニイレラレテ　ゴシゴシト　アラハレマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "グヅグヅ　シテヰルト、マタ　オユニイレラレルゾ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サッキノ土蹈マズノ感触ガ、マダ唇ニ残ッテイテ忘レヨウトシテモ忘レラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼吸困難ニ陥ッテ息ガハアハア云イ出シ、次第ニ人事不省ニナリ、気管内ニチューブヲ差シ入レラレル時ノ心持ハドンナダロウナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
