          "literary": [
            {
              "text": "卒塔婆の産んだ子供と言ふので、霊童と呼んで居たよしが、見えて居る。",
              "citation": {
                "source": "信太妻の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其夜蛇ノ霊童子トナリ伝雅ノ夢ニ入テ告グ、経文ノ功徳ニヨリテ天ニ生ズル事ヲ得タリ、今ヨリ世ニ疱瘡ヲ患フルモノヲ守護スヘシ、此上ノ芳志ニ我為ニー社ヲ造営シテ与ヘヨトミテ夢覚メタリ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
