        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイヘン突拍子モナイコトヲ言イ出シタヨウニ思ワレルカモシレナイガ、少シ落着イテ考エテミルナラ、別ニ奇抜ナコトデモ何デモナイコトガワカル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンモ団十郎ノハ見タコトガアルカモ知レナイガ、記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "老年ニナルト誰デモソウカモ知レナイガ、近頃予ハ一日トシテ自分ノ死ノコトヲ考エナイ日ハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "外ニ誰カ出来タノカモ知レナイガ、ソノ点ハ確カデナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレラノ婦人達ハ実際ニハ善良ナ婦人ナノカモ知レナイガ、モシ本当ニ悪人デアリ、ソレト同棲―――ハ出来ナイマデモ、セメテ身近ニ住ミ、接近スルコトガ出来タラドンナニ幸福デアロウカト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨デ庭ニハ出ラレナイガ、廊下ヲ散歩スルダケデモ容易デナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ハ恐レナイガ死ニ伴ウ苦痛ト緊迫感ト恐怖感トハ御免ダナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少クトモ妻ハ、自分デハ意識シテイナイノカモ知レナイガ、自分デハ若イ二人ヲ監督シテイルツモリカモ知レナイガ、実際ハ木村ヲ愛シテイルヨウニ思エテナラナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハアルイハ事実デハナク、僕ノ単ナル妄想デアルカモ知レナイガ、デモソノ妄想ヲ僕ハ無理ニモ信ジタカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫉妬ガ醸ス激シイ情熱、妻ノ全裸体ヲ思ウ存分見ルノナカッタ法悦境ニ浸リツツアルノヲ思ッテ、自分ノ幸福ヲ感謝シナイデハイラレナイガ、同時ニマタ、コンナ幸福ガイツマデツヅクハズハナイ、イツカハ報復ガ来ルノデアル、自分ハ刻々ニ命ヲ削リツツアルノデアル、トイウ豫感モシテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "平衡感覚ヲツカサドル神経ハドコヲ通ッテイルノカ知レナイガ、イツモ後頭部ノトコロ、チョウド脊髄ノ真上ノトコロニ空洞ガ生ジタヨウナ感ジガシ、ソコヲ中心ニ体ガ一方ヘ傾クノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………自分ハ今死ヌカモ知レナイガ刹那ガ永遠デアルノヲ感ジタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタガ僕ニ泣キ言ヲ云ウノハイイ、シカシソノ泣キ言ヲ、―――アナタ自身ハ泣キ言ノ積リデハナイカモ知レナイガ、―――何故僕ニ云ウ代リニ夫ニ向ッテ云ワナイノカ、ソレガアナタニ出来ナイト云ウノハ、世ニモ不幸ナ人ガアレバアルモノダト思ッテアナタノタメニ一掬ノ涙ナキヲ得マセン。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
