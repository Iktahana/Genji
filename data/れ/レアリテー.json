          "literary": [
            {
              "text": "一例をいふとサブスタンスのレアリテーはあるかないかといふやうな事がいきなり書いてある。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "レアリテーが何の事だか分らぬにあるかないか分るはずがない。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファンタジーとレアリテートの間に私は主観的ならぬ区別はないかと思います。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            }
          ]
        }
