        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモマダミンナキマセンゴザイマス。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、タイヘンナ　コトニ、コゾウサンガ　ピント　ヒゲヲ　ハヤシテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く同じ造りの二階家が数軒並んで、隣の二階にもわたしと同じやうな姿の若い士官がゐて夜更まで灯りの下で勉強して居り、そのまた隣も海兵の合宿所で時々、今日ハ手ヲ取リ語レドモ　明日ハ雲井ノヨソノ空　行クモ留ルモ国ノタメ　勇ミ進ミテ行ケヨ君――と合唱する聞くだに健やかな血の湧き立つ軍歌が響いた。",
              "citation": {
                "source": "緑の軍港",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイシャハ氷デヒヤセト云ウケレドモ、氷ガカエナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場カラスコシオ金ガキタケレドモ、足リナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く同じ造りの二階家が數軒並んで、隣の二階にもわたしと同じやうな姿の若い士官がゐて夜更まで燈りの下で勉強して居り、そのまた隣も海兵の合宿所で時々、今日ハ手ヲ取リ語レドモ　明日ハ雲井ノヨソノ空　行クモ留ルモ國ノタメ　勇ミ進ミテ行ケヨ君――と合唱する聞くだに健やかな血の湧き立つ軍歌が響いた。",
              "citation": {
                "source": "緑の軍港",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、一字卜為セシ者、皆新様ニ似タレドモ、敢テ古人製字ノ法ヲ倣フニ非ズ、其旁画、動モスレバ疑似ニ渉ルヲ以テ、等ノ片爿ヲ加ヘ、故ラニ字形ヲ乱シ、以テ真字ト分別アルヲ示ス、且此字ニ音無ク義無シ、即原語ノ音ヲ縮メテ、此字ノ音卜為ス者ナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一「リベルチ」トハ、自由ト云フ義ニテ、漢人ノ訳ニ、自主、自尊、自得、自若、自主宰、任意、寛容、従容等ノ字ヲ用ヒタレドモ、未ダ原語ノ意義ヲ尽スニ足ラズ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカレドモ十数年ノ後、全道ノ富貴ハ内地トソノ隆ヲ比スルニ至ルベシ。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "他ハ日本人ナルカト思イタレドモ、後ニ至リテ彼等ハ日本人ニハ非ザルモノノ如キコト判明セリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「野火山ヲ焼クノ後、人帰レドモ火帰ラズ」　県令は苦心してここまで作った。",
              "citation": {
                "source": "岷山の隠士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ竊盗ノ性アリ。",
              "citation": {
                "source": "澄江堂雑記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々ニシテ其ノ好ム所ハ異ナレドモ、書画鼎鐺偶像貨幣ノ類、其ノ質ノ金石木磁絹紙タルヲ問ハズ、古物ホド面白キモノハ有ラジ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ其ノ時代ノ概略ヲ識ルヲ要ス。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ太真罪業甚ダ重シ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ昭君ハ三十六宮第一ノ佳人ニシテ、胡児ノ婦ト為リ、琵琶ヲム。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ吾レ毎ニ一議論ヲ発シ一文章ヲ綴レバ、汝忽チ起ツテ躍々活動シ、以テ吾ガ欲スル所ロニ従フ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ今ヤ柳北ト二子ハ皆青天白日ノ人トナルヲ得テ、高橋子モ亦筆墨ノ勲ヲ奏シテ快ク本社ニ凱旋シ、以テ本日ノ賀筵ニ盍簪相娯ムヲ得レバ、吾徒復タ何ゾ汝ヲ怨ミ汝ヲ責ムルヲ為サンヤ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士ハ魏志文ヲ引クニ、伊都國ヨリ邪馬臺マデノ行程ヲバ略カレタレドモ、コレラノ行程ハ、國々ノ位置ヲ求ムルニ必要ナル者ナレバ、多少ノ誤謬ハ免レズトモ、全クハ棄ツベキ者ニアラズ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノ説、イト巧ニハ辨ゼラレタレドモ、想像ニ成レル事多クテ、確證少ケレバ、慥ナル事ハ知リ難シ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "那珂氏は之に説明を與へて此ノ風俗ハ、イカナル原因ヨリ生ジタルカハ知ルベカラザレドモ、卑彌呼壹與等ガ、國人ニ畏服セラレタルハ、其ノ英略アルガ爲ノミニハアラデ、此ノ風俗アリシニモ由レルナルベシ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒井ノ家ノ系統ヲタヅヌルニ、清和源氏ニ出ヅルモノノ如シ――然レドモ――彼ノ女ニ対スル余ノ愛ガ彼ノ女ヲ殺シ、彼ノ女ノ愛ガマタ余ノ生涯ヲ一変セシメタリトヤイハム。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「白骨ノ温泉ニ到着ス病気コノ地、秋ヨリ冬ニカケテハ、旅宿ハ戸ヲ釘ヅケニシテ里ニ去ル例ナレドモ、今年ハ珍シク冬籠リノ客多数居残リヲレリ……」といった程度の文章で、歌もなければ、発句もない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴慕の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンジェリコ、ミケランゼロ、レオナルドダビンチ、ラファエル及チシアン等ノ描ケル耶蘇ノ面貌ハ皆、荘厳ト優美トヲ兼ネタル秀麗ナル男性ノ典型トシテ描キタレドモ、独リ十四世紀ノジョットーニサカノボレバ然ラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ、彼ニ従フトコロノモノモ、屈強ナル壮年男子ニ限リタレドモ、コノ信神渡航者ノ一行ニハ、オヨソ信仰ヲ共ニスル限リ、老幼男女ノアラユルモノヲ抱容スルコトヲ許サレタリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ皆、祈ルコトヲ知リタレドモ、祈ルコトヲ職業トスルモノハ一人モコレ有ラザリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ、コレ等ノ小農夫及小商人ハ、皆天ヲ敬シ、人ヲ愛スルコトヲ知ルモノナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
