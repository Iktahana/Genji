        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その中の一人、衛律という男は軍人ではなかったが、丁霊王の位を貰って最も重く単于に用いられている。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に法華宗には、諏訪霊王といふものがあるが、甲賀三郎のことである。",
              "citation": {
                "source": "古代人の思考の基礎",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢の靈王の枕上に立ち詐はりてトロイア落城の近きを告ぐ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
