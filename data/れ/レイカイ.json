[
  {
    "uuid": "ce8301c9-7f12-52b0-9cb6-5361be9910f7",
    "entry": "例会",
    "reading": {
      "primary": "れいかい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
