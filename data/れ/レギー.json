        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼はラテン語で主の祈り、アベ・マリア、使徒信経、サルヴェ・レギーナ（処女マリアへの祈祷歌）などを教え、日本語で神の十誡、教会の制令、重大な罪、これに対する徳、慈善の事業などを教えた。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにいるかわいそうなレギーも同じよ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "このレギーが階段の下にいて、宝石所有者の小娘に愛想良くしていたので、自由に仕事ができた。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしレギーがあの小娘を手放すヘマをしなかったら……」　レギーと呼ばれた男が反論した。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆうべレギーがおじけづかなかったなら、大金持ちになったのに」　連れのベリントン大佐が尋ねた。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "慌てて後ろずさりしたのは、足の不自由な小男の指示に従って、レギーと呼ばれた男と、藩王が大広間へ出て来て、向かい側の部屋にはいった時だった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから信頼できるレギーとコーラと組んだ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "向かい側の部屋から誰かが何か重い荷物を動かす音がして、レギーと呼ばれた男と、藩王の二人が大きい箱を引きずってきた。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "レギー、出来れば外へ行って、探してくれ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "テーブルが片付くと、レギーと呼ばれる男の手を借りて、藩王とリッチフォードが荷箱から、動かない物体を持ち上げた。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "中に何人かいるようです」「ああ、策士が二人、レギーとコーラだ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "男がレギー、女がコーラと分かっても別に驚かなかった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "レギーなる男が雄たけびをあげて、ベリントン大佐に飛びかかった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "メアリ・サトーリスがレギーの両ひざにしがみついたけど無駄だった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "レギーやコーラの連中だ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばし、レギーなる男と、コーラなる女がリッチフォードに対して冷たい態度をとっているようだ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "レギーと呼ばれる男が笑って答えた。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "やり方を聞いて、現金化したら、その三分の一を俺に戻してくれ」「要点を言ってくれないか」　レギーはやる気満々だ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし帰っていなければ、宝石は持ったままだよ」「確かめたほうがいい」　とレギーが反射的に言った。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから馬車に乗れば……」　レギーが興奮して飛び上がった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "レギーとコーラが戸口踏段に立って、小声で話している。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "サトーリスの合図で、レギーなる男がビートリスの前に立ちはだかった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "おわかりですか」　レギーなる男がにやり。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "レギーなる男がすごんだ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "レギーが激しくののしった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "レギーなる男がビートリスにかがみこみ、何事かささやいた。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビートリスは目を大きく見開き、レギーの思惑ほど怖がっていなかった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "おわかり」　レギーが笑った。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "レギーは悪党だが、美貌とか勇気を見る目がある。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
