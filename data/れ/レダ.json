        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンニモシナイ、コレダケノモノ、キレイデショ？",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」無理カモ知レマセヌガ　とまた、うつむいて、低く呟くやうにおつしやつて、ソレダケガ生キル道デス　尼御台さまは、すつと細い頸をお伸ばしになり素早くあたりを見廻しました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　無理カモ知レマセヌガ　とまた、うつむいて、低く呟くようにおっしゃって、　ソレダケガ生キル道デス",
              "citation": {
                "source": "鉄面皮",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドレスデンにゆきて、画堂の額うつすべき許を得て、ヱヌス、レダ、マドンナ、ヘレナ、いづれの図に向ひても、不思議や、すみれ売のかほばせ霧の如く、われと画額との間に立ちて障礙をなしつ。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハモーダメニナッテシマッタ、毎日訳モナク号泣シテ居ルヨウナ次第ダ、ソレダカラ新聞雑誌ヘモ少シモ書カヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレダカラ御無沙汰シテマス。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　ラツパヲ　ミルト　花ヲ　オコシテ　ヤル　コトモ　ワスレテ、「アア、コレダ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラントームの『レダムガラント』にスペイン女の三十相を挙げて、膚と歯と手は白きを要し、目と眉と睫毛は黒きを要し、唇と頬と爪は紅きを要し、胴と髪と手は長きを要しとは、手の長い者は盗みすると日本でいうと違う。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら考えてもコレダケが最後の、唯一の疑問として残って行く……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "香港を出てから二日の間、コレダケの人間が皆揃って食堂に出た。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……オレダヨオ――オ――」",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……その人間の仔指の指紋はコレダという事を警官に突き止められたとしたら、ソモソモどんな事になったでしょうか」「……………」「……あなたはそれでも、すべてを夢中遊行のせいにして、知らぬ存ぜぬの一点張りで押し通されるかも知れませんね。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一千……と、ええ、この面倒くさい年号と来た日にやあ、ぶち殺されたつて、すらすら言へるこつちやないが、さて……年に、時の代官レダーチに対して、哥薩克のうちから最も才幹ある者をひとり選び出せといふ命令が下つたのぢや。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手はだまったらしかったが、少ォし大きな声で、　――ダレダ？",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "所ガ私ガアレダケホントウノ事ヲ告白シタノニ不拘清三ハ全ク耳ニモ入レマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔、父の書齋で、私はヴィナスを抱くレダのなまめかしい樣子を見て、暫く心が波打つてゐた記憶があるけれども、どうかすると、鷄介の手がレダの羽根のやうに思へてうつとりとする時がある。",
              "citation": {
                "source": "あひびき",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "七人と云ふのはルドヰコ・バルバリゴ、ニコレ・ヲレダン、アントニオ・ピルミアニ、ジユリオ・ボツタロル、オクタヰオ・ヱルヌツチ、それからレオネルロと己とである。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルバリゴだらうか、ヲレダンだらうか、ピルミアニだらうか、それともボツタロルだらうか。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る日己はヲレダンに逢つた。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲレダンはレオネルロはどうしてゐるかと問うた。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲレダンは己の返事を聞いた後に、毒々しい笑をして、「暗い所では用心してゐ給へよ」と云つた。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　野村は実際困ったような顔をして、しばらくは壁に懸っている写真版へ、順々に眼をくばっていたが、やがてその眼がレオナルドのレダまで行くと、「おや、あれは君、辰子さんに似ているじゃないか。",
              "citation": {
                "source": "路上",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　野村は近眼鏡の下からしばらくレダを仰いでいた後で、今度はその眼を桜草の鉢へやると、腹の底から大きな息をついて、「どうだ。",
              "citation": {
                "source": "路上",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九三一年に入って、ロカフは「モスクワ・ロカフ」「レンバルトロカフ（レーニングラード・バルチック・ロカフ）」の他「タトロカフ（タタール共和国のロカフ）」「セヴカウロカフ（北コーカサス・ロカフ）」「スレダズ・ロカフ（中央アジア・ロカフ）」その他まで拡張した。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "禿鷹ノ盲イテ　飛ビタツ　熱気ノ底ヲ　諸々ノ息吹キニ耳ヲタテテヰル　オレダ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "遂ニ熄ムコトノナイ軋轢ニ　タチクラム濛気ノ中ヲ　荊棘ヲ※ツテ　起チナホル身ヲ震ハスオレダ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
