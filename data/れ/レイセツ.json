  {
    "uuid": "3c736f7f-fd4a-5826-b15c-ddbb01d5d804",
    "entry": "霊説",
    "reading": {
      "primary": "れいせつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
