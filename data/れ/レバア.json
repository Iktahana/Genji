          "literary": [
            {
              "text": "又ソレヲ聞カナケレバアンナニ憤慨ハシナカッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢張り神経障碍の一種で、時々「マシン」のようにポッとふくれて、痒い処が出来て困りますが、これも、追々「レバア」の利目があらわれれば、なおるものだそうです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "時間がアレバアアイウ者デマトマッタモノヲ書キ度候。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンジン・レバアをじりじりと引いて、頃を見計って全開だ。",
              "citation": {
                "source": "旅客機事件",
                "author": "大庭武年",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ心理ハ君ニハ分ルマイ」「分ラナイワネ」「ツマリ、僕ガ醜悪デアレバアルダケ、君ガ途方モナク美シク見エルッテコトサ」予ノ言葉ヲ上ノ空デ聞イテ彼女ハアダリンヲ取リニ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ人ガ優レタ藝術家デアレバアルホド、断乎トシテ刎ネツケハシナイデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタガ僕ニ泣キ言ヲ云ウノハイイ、シカシソノ泣キ言ヲ、―――アナタ自身ハ泣キ言ノ積リデハナイカモ知レナイガ、―――何故僕ニ云ウ代リニ夫ニ向ッテ云ワナイノカ、ソレガアナタニ出来ナイト云ウノハ、世ニモ不幸ナ人ガアレバアルモノダト思ッテアナタノタメニ一掬ノ涙ナキヲ得マセン。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トロリと舌をまどわすポタージュに、カフスレバアの煮込みの味、昼間から美味に酔う。",
              "citation": {
                "source": "このたび大阪",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
