        "examples": {
          "standard": [
            {
              "text": "高級ホテルのレストルームは、間接照明とアロマの香りで非常にリラックスできる空間になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "お客様からのクレームを受け、商業施設のすべての階のレストルームにおむつ交換台を設置した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "フライト中、機内食のサービスが終わると同時にレストルームの前に長い順番待ちの列ができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      },
