        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ト屋根ヤブレルホドノ大｜喝采、ソレモ一瞬ノチニハ跡ナク消エル喝采、ソレガ、ホシクテ、ホシクテ、一万円、二万円、モットタクサン投資シタ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日、一日、カク手ガ氾濫シテ来テ、何ヲ書イテモ、ドンナニ行儀ワルク書イテモ、ドンナニ甘ッタレテ書イテモ、ソレガ、ソンナニ悪イ文章デナシ、ヒトトオリ、マトマリ、ドウニカ小説、佳品、トシテノ体ヲ為シテイル様、コレハ危イ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフダチ　ヤムノヲ　マツウチニツカレガ　デタカ　オヂイサンイツカ　グツスリ　ネムリマスオヤマハ　ハレテ　クモモナクアカルイ　ツキヨニ　ナリマシタ　この月は、春の下弦の月である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "分割センガ為メニ弾圧スル――コレガ支那ニ於ケル帝国主義者共ノ政策デアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ　ヤマ　ノ　オヒサマ　ニ　カガヤイテ、チョウド　クンショウ　ノ　ヨウニ　ミエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまではエレガントな巴里人が指で食物を掴んだ。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "製造コストはかさむが、ジョブズは美しいプラスチックの筺体を用意することで、誰もが触ってみたくなるようなエレガントな道具にアップル※を仕立ててみたかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがエレガントな道具を目指すジョブズは、アップル※を静かなマシンにしたいとこだわった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベンダーさんが最初にお出かけして、それからインディアンのピート、次はマグレガーの奥さん、次はジョニー・ホーンズ、次は、嬢ちゃん、君のママだ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ　フトコロニ　コヒツジヲ　イレテ、「シカタガ　ナイカラ、コノ　コヒツジハ　オレガ　ソダテテ　ヤラウ」ト　ヒトリゴトヲ　イヒナガラ　ヤツテ　ユクウチ　トツプリ　ヒガ　クレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハテ、コンナ　ウツクシイ　花バタヲ　ダレガ　アラシタノダラウ」ト　ヲトコガ　タホサレタ　イツポンノ　ケシノ　花ヲ　オコシテ　ヤラウト　スルト、ソノ　ネモトニ　シンチユウノ　ラツパガ　ヒトツ　オチテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガ　オホキク　ナル　シヨウコデス」　ミルト　ナルホド、ナガイ　ミミガ　フタツ、ニヨツキリ　ハエテ　ヰマス。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガシハ非人ナリ、過去、迦葉仏ノ時ニ於テ、カツテコノ山ニ住ス。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガシ答エテイウ。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人、言下ニオイテ大悟シ、作礼シテイウ、ソレガシ已ニ野狐ノ身ヲ脱ス。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七　オリムピックのなかでも、青リボンと呼ばれる、壮麗なレガッタのなかで、ぼくには、負けて仰いだ、南カルホルニアの無為にして青い空ほど、象徴的に思われたものはありません。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕だつて凡てレガルな行爲は結構だと思ふ。",
              "citation": {
                "source": "ロビンソン・クルソオ",
                "author": "森林太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレガラナハン、家サ來ルヅギモ面白ガタンチェ。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレガラナハン、家サ来ルヅギモ面白ガタンチエ。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ其レガ左傾スルニセヨ右傾スルニセヨ前世紀的頭腦ヨリスル是非善惡ニ對シテ應答ヲ免除サレンコトヲ期ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧困ニシテ實男子又養男子ナキ六十歳以上ノ男女、及ビ父又ハ男子ナクシテ貧困且ツ勞働ニ堪ヘザル不具廢疾ハ國家之レガ扶養ノ義務ヲ負フ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ニ禮式作用ガ必須課目ナラバ男子ニモ男子ノ其レガ然ルベク、茶ノ湯生花ガ然ルナラバ男子ニ謠曲ヲ課セザレバ不可。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上ノ國民教育ノ説明ニヨリテ大學及ビ大學豫備校ノ方針、又其レガ生徒ノ自費タルコト等ハ推想シ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ヲ領有スル結果ヨリ見テ、恰モ百萬圓ヲ貯蓄シタル結果ヨリ見テ、其レガ高利貸ニヨルト忠實ナル勞働ニヨルトヲ考査セズシテ等シク守錢奴ト詈リ侵略者ト誣ユルハ昏迷者ノ狂言ナリ、重大ナル罪惡ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只之レガ彼ノ暗味ナル「ウヰルソン」ノ口ヨリ民族自決主義ト呼バルルニ至リテ空想化シ滑稽化シタルナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ是レガ侵略主義軍國主義ナラバ日本ハ全世界無産階級ノ歡呼聲裏ニ黄金ノ冠トシテ之ヲ頭上ニ加フベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにいえる妖巫、英語でウィッチ、伊語でストレガ、女人殊に老女が、左道を修め鬼魅に事え、悪念を以て人畜を害する者で、中には世襲の妖巫輩出する部落も家族もある。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
