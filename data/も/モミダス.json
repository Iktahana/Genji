    "definitions": [
      {
        "index": 1,
        "gloss": "to squeeze out",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "固まった絵の具のチューブを必死に揉み出して、なんとか色を出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "熟した果実を布で包み、手で揉み出して果汁を抽出する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "リンパの流れを良くするために、老廃物を揉み出すようにマッサージする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "母親は元來が小さい乳首を指先で揉み出すやうにしながら、自分から子供のやうに吸つてやつてそれを茶碗に吐き出した。",
              "citation": {
                "source": "四十餘日",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "面会窓があいた瞬間に、やあ、と笑顔になりながら大きい両肩をゆっくり揉み出すようにのり出してくる重吉の身ぶりや、いつも落ちかかって来る窓ぶたに語尾を押し截られるように、じゃ元気で、という重吉の声の抑揚は忘られなかった。",
              "citation": {
                "source": "乳房",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山椒の皮を春の午の日の暗夜に剥いて土用を二回かけて乾かしうすでよくつく、その目方一｜貫匁を天気のいい日にもみじの木を焼いてこしらえた木灰七百匁とまぜる、それを袋に入れて水の中へ手でもみ出すことです。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山椒の皮を春の午の日の暗夜に剥いて土用を二回かけて乾かしうすでよくつく、その目方一貫匁を天気のいい日にもみじの木を焼いてこしらえた木灰七百匁とまぜる、それを袋に入れて水の中へ手でもみ出すことです。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日置は自分の爲め手古奈の爲めに死人が出來たと聞けば、必ず氣をもみ出す。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
