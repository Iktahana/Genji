        "examples": {
          "standard": [
            {
              "text": "この酒は諸味の状態で出荷され、家庭で熟成を楽しむことができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔ながらの諸味醤油は、香りが豊かで人気がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "諸味のまま瓶詰めされたどぶろくは、独特の風味がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
