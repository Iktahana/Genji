          "literary": [
            {
              "text": "併し貧院に戻り着くと、ペピイが先に部屋に這入つて、偶然の様にコツプに水を入れて窓の縁に置く。",
              "citation": {
                "source": "老人",
                "author": "GREISE",
                "note": "青空文庫"
              }
            },
            {
              "text": "文吾は呆氣ないやうな氣もしたが、色事の二字を、仔細に胸の裡で考へつゝ、また風のやうに源右衞門の家を飛び出すと、先き※りして母よりもズツと早く自分の家へ戻り着くなり、元の樣子で旅支度のものを弄つてゐた。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿に戻り着くと、秀子さんと芳子さんと俊男君が海へ出掛けるところだった。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
