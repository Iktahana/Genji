[
  {
    "uuid": "98f2b446-e8dc-58da-ab14-1ed893b0e5c6",
    "entry": "申し受ける",
    "reading": {
      "primary": "もうしうける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
