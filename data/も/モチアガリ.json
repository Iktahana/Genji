        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "小中高と持ち上がりの名門校、レイクサイドスクールに学んだゲイツは、中学二年のときコンピューターと出会うことになる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々の住宅に隣接して公共の建物を作る計画が持ち上がり、日照や騒音の問題を巡って長くお役所とやり合ったときの仲間です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚いた事が持ち上がりおったもんですね」　と話題を転じようとした。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "突如、真に突如、意外な大珍事がそこに持ち上がりました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "また変なことが一つ持ち上がりましたぜ」　息せき切りながら伝六があとから追っかけてきたので、右門はちょっといろめきたちながら耳をかしました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "しろうと芝居がどうしたんです」「その時に一と騒動持ち上がりましてね。",
              "citation": {
                "source": "半七捕物帳",
                "author": "勘平の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手がそろそろと持ち上がり、頭上へ高く上がったかと思うと、眼に見えない恐ろしい物でも、払い退けるように打ち振った。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、眼前の海の底から、ゴーゴーという音が響き渡り、巨大な岩とばかり思っていた海の面の物象が、見る間に上へ持ち上がり、忽ち居然たる大船が海上へ浮んだではございませんか。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると今度は聳えていた棒が雲の中へ手繰られると見えて岩からスッと持ち上がりました。",
              "citation": {
                "source": "天草四郎の妖術",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「大きな騒動が持ち上がり、コナコナに破壊れてしまうのよ」「ワーッ、そいつあ有難くねえなあ」「つまり何んだ、こう云った方がいい、今の浮世の連中は、コナコナになって破壊れるために、むやみに進んで行くのだとな」銅兵衛という山窩、哲学者らしい。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "グッと押すと予想した通り、大鉄盤が持ち上がり、その後へ円形の穴が出来た。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その細く閉じかけた眼の、厚ぼったい重い瞼がおもむろに持ち上がり、額に幾つもの皺をこさえ、瞳が輝きを含んで微笑んでいた。",
              "citation": {
                "source": "波多野邸",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまた近ごろのこと、この屋敷のなかで大ごとが持ち上がりましてねえ。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐにその庭先で恐ろしい騒ぎが持ち上がりました――マルファ・ペトローヴナはドゥーニャを打ち打擲までして、何一つ耳をかそうとしません。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど何よりも肝要なのは、こうしたいろいろな事のお蔭で、思いがけない話が持ち上がり、わたしたちの運が開けることになった次第です。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば、ある注意すべき事件が持ち上がりました。",
              "citation": {
                "source": "成長が生んだ私の恋愛破綻",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、くわはいって持ち上がりませんでした。",
              "citation": {
                "source": "くわの怒った話",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "終日、風の音と、雨の音と、まれに鳥の声しかしなかった平原が、たちまちの間に、草の木も根こそぎにされて、寸々にちぎられ、空へ吹き飛ばされるような大事件が持ち上がりました。",
              "citation": {
                "source": "戦友",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "火山がかつてない規模で隆起したことで、海底の一部が水面に持ち上がり、底知れぬ深海に何百万年も隠れていた領域が現れたに違いない。",
              "citation": {
                "source": "ダゴン",
                "author": "DAGON",
                "note": "青空文庫"
              }
            },
            {
              "text": "その男に注意されて見ると、南の方に真っ白な入道雲がひときわ高くムクムクと持ち上がり、それが北東の方へ流れて、もう真東の方までちょうど山脈のように続いている。",
              "citation": {
                "source": "地異印象記",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とか、村にはいろいろの話が持ち上がりました。",
              "citation": {
                "source": "金が出ずに、なしの産まれた話",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "その釜の蓋が、持ち上がりそうに今、糊と湯気を噴きこぼしていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然前輪がガタンと持ち上がり、すさまじい音がして、車体が片側にかしいで止まった。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時までには家に帰るべきだが、土壇場で重要問題が持ち上がり、わしに対応しろと言うんだ。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "トンネルが持ち上がり、コンクリート表面が壊れ、鋼製の心壁がねじれ、ピカデリーに黒い蛇がのたくっているようだ。",
              "citation": {
                "source": "見えざる力",
                "author": "THE INVISIBLE FORCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "もつれがうねうねと縄状になり、二十ばかりの平らな頭が持ち上がり、しゅっしゅっと音を出した。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々、緑の海が山のように持ち上がり、山腹の半分がクリーム状の泡で覆われた。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "メアリが見ていると、小舟は高く持ち上がり、それから砂丘を囲む白壁の後ろに消えた。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "500人もの乗客が床から持ち上がり、踏みつぶされ、ぶつかり、大ロケット機と共に、なすすべもなく落下。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
