        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イロイロナモノガ私ノ心ヲオドラセマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノスケッチニ取ルベキトコロノアルモノガアルデショウカ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナニ　ヤサシイ　モノガ　花タチノ　オソロシク　オモツタ　ウマダツタノデシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソンナ　モノガ　ナンニ　ナル。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、マイニチ　イツテモ　イツテモ　ヒロイ　ノハラデ　タベモノガ　ナイノデ　サルヲ　コロシテ　タベナクテハ　ナラナク　ナリマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボウヤノ　アタマノ　トコロニ　大キナ　モノガ　アルデセウ？",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツ、ヰルヨ」「エ、ドコニ」「ホラ、アソコニ」　ズーツト　下ノ　ハウノ　アル　マチノ　ホソイ　ミチノ　上ニ　キラキラト　ヒカル　モノガ　アリマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コドモタチヤ、コノ　バシヤハネ、オマエタチガ　マダ　ウマレナカツタ　ジブン、マダ　ジドウシヤト　イフ　モノガ　ナカツタ　トキ、ムラカラ　マチノ　テイシヤバマデ　マイニチ　カヨツタ　モノダヨ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンタチハ、オ母ッチャガ死ヌ四五日モマエカラ、何ンニモタベルモノガナク、目マイガシ、ムネガヒクヒクシ、ペッタリネタキリダッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒点ガ見エ、強イ光デ網膜ガヤケタトキノ感ジガアリ、且ツチラチラト電線ノ雑音ミタイナモノガ盛ンニ動クノデアル。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "深イ注意ヲモッテカカル人間ニ対シ適当ナ電波的保護ヲ急グノデナケレバ、世ノ中ニハ「手ニオエナイ神経病者」トイワレルモノガ年ト共ニ激増スルデアロウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒褐色ノ煙ノ柱徑一町以上ノモノガ天ニ沖シ、中空以上ハ擴ガツテ雲ノヤウデアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常ナ勢デ廻轉シテヰルコトハ何カ木片板片ノヤウナモノガ飛ビ交フ樣子デ分ツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "無關係ナモノガ間違ツテ入ツタノデス。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ何カ喰ッテモイヽナ」「冗談ジャナイ、ソレデ足リナインデスカ」「足リナイコトハナインダガ、コヽヘ来ルト関西ノモノガ恋シクナルンダ」「グジノ一ト塩ガアリマスゼ」ト浄吉ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンモ年ノ加減デ尿ガ近イノデアルガ、洋式便所デハ出ルモノガ出ナイト云ッテ、夜中二三回遠クノ日本便所ヘ通ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サア勝ッタ、モウイヤダナンテ云ワセヤシナイ」「何ダネ、君ノ要求ハ」「ビックリシテ腰ヲ抜カサナイヨウニ」「何ダヨ一体」「コノ間カラ欲シイト思ッテタモノガアルノ」「ダカラ何ダヨ」「キャッツ・アイ」「キャッツ・アイ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何カ鉄板ノヨウナ重味ノアルモノガ足ノ裏ヘペッタリ貼リ着イテイル感ジデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コリーノ方デハ戯レル積リナノダガ、思イモカケヌモノガ飛ビ着イテ来タノデ予ハ驚イタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナ馬鹿々々シイ真似ガ出来ルト云ウノガ、モウ気狂イニナリカケテル證拠ヨ」声ノ調子ニ、頭カラ水ヲ浴ビセルヨウナ皮肉ナモノガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "川勝氏ノ著書ヲ見ルト、上京区千本上立売上ルニ石像寺ノ阿弥陀三尊石佛ト云ウモノガアッテ、中尊ニ定印弥陀坐像、ソノ向ッテ右ニ観音、左ニ勢至ノ二脇侍立像ガ侍立シテイテ、ソレラ三尊ノ写真ガ各別々ニ載ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鄭板橋ノ書ガゴザイマスガ御覧ニナッテ下サイマスカ」「ソレヨリ君、突然妙ナオ願イヲスルヨウダガ、アッタラ売ッテ貰イタイモノガアルンダ」「何デゴザイマス」「紅絹ノ裂ヲ二尺バカリト布団綿ヲ一ト塊、分ケテ戴キタインダガネ」「変ッタ御用ヲ承リマスナ、一体何ニナサルンデ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ足ノ形ヲ石ニ刻ンダモノガ支那ニモ朝鮮ニモ保存サレテイルガ、日本ニハ奈良ノ薬師寺ニアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテコノ白唐紙ノ色紙ノ上ニ朱デ足ノ裏ノ拓本ヲ作ル」「ソンナモノガ何ニナルノ」「ソノ拓本ニモトヅイテ、颯チャンノ足ノ佛足石ヲ作ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ彼女ハ、「ソンナモノガ何ニナルノ」ト、云ッタヾケダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハ甘イモノガ嫌イデ、酒飲ミノ好クモノガ好キ、ナカンズク鮒鮨ガ好キダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ写真機ハ写シタモノガ即座ニ現像サレテ出テ来ル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
