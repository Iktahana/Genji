          "literary": [
            {
              "text": "茶碗に水漬の飯を盛り皿には一｜撮みの塩も入れてあった。",
              "citation": {
                "source": "義人の姿",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬味のわけぎを小さく刻んで、山盛り皿に入れて出しておいて、戸口に椅子を持ち出し、だしの煮こぼれるまで、由は此椅子に呆んやりかけてゐるのです。",
              "citation": {
                "source": "小さい花",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧しい人たちが家族の個人皿や盛り皿や食品と一緒ではなく、病人や健康者の汚れたリネンを洗うことができる公衆洗濯場は、病気の広がりを防ぐようによく計画されている。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            }
          ]
        }
