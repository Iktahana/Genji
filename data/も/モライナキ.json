[
  {
    "uuid": "c73ad30f-acd2-5d24-bc4b-fb97b0b948f6",
    "entry": "もらい泣き",
    "reading": {
      "primary": "もらいなき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
