        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（「門は」「門を」は「モンナ」「モンノ」となり、「実は」「実を」は「ジッタ」「ジット」となった）四　第三期の音韻　第三期は江戸初期から今日に至る三百三四十年間である。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はその時リオナルドオ・ダア・ヰンチのかいたモンナ・リザの画を思い出した。",
              "citation": {
                "source": "心中",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "メーテルリンクは法律家であつて、その業務の傍ら、論文と作劇とに從事して居たが、『モンナワンナ』を作つてから、その作劇上の資才が見とめられる樣になつたのである。",
              "citation": {
                "source": "神秘的半獸主義",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "島村抱月氏（四）11・10（夕）　確か神戸の聚楽館で芸術座が『モンナ・※ンナ』を上演した当時だと思ふ、そこの食堂で私達が会食してゐると、羽織袴の若い男がすつと入つて来て島村氏に挨拶をした。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一人の男は中田博士の質問に答えて、「モンナ・ヴァンナ」はメーテルリンクの小説だと答えていた。",
              "citation": {
                "source": "無名作家の日記",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンキーは仏語のモンヌ、伊語のモンナなどに小という意を表わすキーを添えたものだそうな。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてモンヌもモンナもアラブ名マイムンに出づという。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あの三番目が「モンナミ」の彩ちゃんだど。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は大通りから入ったカフエー・モンナミを見付けた。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "『モンナンナなども劇の上の人物で、実際から言ふとキヤラクターとしての価値がない。",
              "citation": {
                "source": "社会と自己",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンナ、※ンナなどは、それから比べると、芝居的に効果のあるやうに人物の心理が拵へてあるやうである。",
              "citation": {
                "source": "社会と自己",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンナが夫に貞操を疑はれた時に、「私の眼を見て下さい」と云ふところがあるが、私は彼処を読む時に実に純潔な感じがした。",
              "citation": {
                "source": "善くならうとする祈り",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンナが夫に貞操を疑われたときに、「私の目を見てください」というところがあるが、私はかしこを読むときにじつに純潔な感じがした。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はモンナ・バンナが夫に貞節を証するために、「私の眸を見て下さい」というのを実に純潔な表現と思いました。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術座の「モンナ・ワンナ」公衆劇団の「エレクトラ」近代劇協会の「マクベス」――さうして自由劇場では小山内氏が西洋からかへつて来たところで、三年前に一度やつた「夜の宿」を再演して、われ／＼を十二分に満足させて呉れました。",
              "citation": {
                "source": "井上正夫におくる手紙",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
