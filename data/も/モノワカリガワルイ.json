        "examples": {
          "standard": [
            {
              "text": "何度同じ手順を説明しても理解してくれず、あの新入社員は本当に物わかりが悪い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "自分が物わかりが悪いことは自覚しているので、人の倍は勉強してカバーするつもりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「どうしてそんなに物わかりが悪いの！」と、母親は言うことを聞かない子供を叱りつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "わたしはね、こういう意見なんですが、ロパーヒンさん、民衆は善良だけれど、どうも物わかりが悪いとね。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
