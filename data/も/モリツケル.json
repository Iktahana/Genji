        "examples": {
          "standard": [
            {
              "text": "熱々のスープを深めの皿に盛り付ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "シェフは手際よく料理を盛り付け、次々と客に提供していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ケーキのスポンジに生クリームとフルーツを盛り付けてデコレーションした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "出来た料理を容器にうまく盛り付けることが大事であります。",
              "citation": {
                "source": "料理する心",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻女が盛りつける熱い薯粥の椀が配られると、隼人がまず箸をとり、みんな感動の溢れた表情で、うまそうに喰べはじめた。",
              "citation": {
                "source": "薯粥",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四季おりおりのサラダの種類が異なることから、これは温めて出すとか、これは冷やして出すとか、それらを眼に美しく見せるにはどんなふうに盛りつけるとか。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
