        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "隅田川の濁流、ポンポン蒸汽、伝馬船、モオタアボオト等に囲まれ、せせこましい練習をしていた、ぼく達にとって、文字どおり、ドリイミング・コオスといった感じです。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏期の舟遊の盛んな話を加藤さんから聞いてゐたので、私達も対岸までモオタアボオトを出す積りで来たが、風があつて沖が曇つてゐるので見合せた。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後へ向うから走つて来たのはお客や芸者を乗せたモオタアボオトである。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根船や船宿を知つてゐる老人達は定めしこのモオタアボオトに苦々しい顔をすることであらう。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "従つて又モオタアボオトを無風流と思ふ者ではない。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "島に着いてから一週間半ののちに、快速のモオタアボオトが、かれとかれの荷物を、もやのかかっている朝、水の上をあの軍港へとつれもどした。",
              "citation": {
                "source": "ヴェニスに死す",
                "author": "DER TOD IN VENEDIG",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルからはモオタアボオトで、会社の専用運河をとおって、停車場までお送りする。",
              "citation": {
                "source": "ヴェニスに死す",
                "author": "DER TOD IN VENEDIG",
                "note": "青空文庫"
              }
            },
            {
              "text": "会社のモオタアボオトは停車場のそばにとまっているのか。",
              "citation": {
                "source": "ヴェニスに死す",
                "author": "DER TOD IN VENEDIG",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
