    "definitions": [
      {
        "index": 1,
        "gloss": "to support",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は幼い頃から、家族に守り立てられて成長した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "困難な時も、友人が精神的に守り立ててくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "地域の伝統文化を次の世代に守り立てていく必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "愛したい心は満ち、それは真実なものでも、よってもって自分の生きて居ると思う一点を守り立てるためには、その愛をぐっと耐えて自分の潜精力として行かなければならないこと。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、もし一般的に自由主義なるものを何でもいい守り立てる必要があるとすれば、経済的・政治的・な自由主義の大勢が不利である場合、当然文化的自由主義が、自由主義なるもの一般の最後の依り処とならざるを得ないわけである。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "実篤で、主思いで、分別家のかれは、自己が今日まで尽したことは、秀吉のためにではなく、清洲会議のとき、信長の正嗣として立てた三法師（秀信）をただ守り立てるためとして――自己を劉備玄徳に遺孤を託された諸葛孔明の心事になぞらえ――ひたすら時節を待って来たのであった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "学者が都市に住んで標準語というものを守り立てるまでは、タンポポという草の名の行われていた区域は案外に狭いものであった。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな破滅が激しかろうと、虐げようが厳しかろうと、男女一組の真直な人間がその三方の何処かに逃る隙さえあれば、きっと私の手が待ち受けてい、つつましく根気よく次代の栄をもり立てるのです。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "之を把握することによつて、新しい思想をもり立てる概念を捉へることになる。",
              "citation": {
                "source": "副詞表情の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロッパ大戦に於ける敗北なしには、ナチの民衆的勢力をもり立てるデマゴギーは拠り処を見出し得なかったからだ、だが例えばスペインはどうだろうか。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to revive (e.g. a company)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "会社の業績が低迷していたが、新しい社長が経営を守り立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "地域経済を守り立てるために、新しい産業を誘致する計画が進められている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は倒産寸前だった老舗の旅館を守り立て、再び繁盛させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "to bring up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖父母は貧しいながらも、三人兄弟を立派に守り立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は一人で子供を守り立て、大学まで進学させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "地域全体で子供たちを守り立てていく社会を目指したい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
