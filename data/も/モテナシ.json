        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "散歩の途中に寄ったお寺で、お茶と菓子の持て成しを受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "簡素ではありますが、手作りの持て成しを用意しました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "劇の幕間に、ロビーで冷たい飲み物の持て成しがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
