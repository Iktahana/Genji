  {
    "uuid": "d8299f36-3e00-521b-86ca-5844aa9357e5",
    "entry": "もさ",
    "reading": {
      "primary": "もさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それでもさすがに、ここへ移ってきた夜は、だれにいうとはなく、「引っ越すたびに家が小さくなる」とひとりごとをくりかえしておった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのうは校長まででてきて、いま一｜度芳輔の両親にも話し、本人にもさとしてくれ。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたたび内をのぞいた　下駄もさきに見た通りでかわらない　愈ほんとうの決心がでて門前を東へ過ぎて吾躰を運転した。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "別にかわったことはないがだんだん躰が疲れてゆく　腰の痛背のいたみ少しでもさわるとたまらなく痛む。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもさういふ目的で作歌するといふのではない。",
              "citation": {
                "source": "『悲しき玩具』を読む",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "口で求めず手で引き立てる奈々子の要求に少しもさからうことはできない。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "線香も盛んにともされる。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "民やもさっさと支度して早く行け。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "人にもさる類ひはありけりとをかし。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれ見給へ、飛びゆく姿もさやかなるを」と指さゝれて、あはれこの子規いつも初音をなく物になりぬ。",
              "citation": {
                "source": "すゞろごと",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "御新造は驚きたるやうの惘れ顏して、夫れはまあ何の事やら、成ほどお前が伯父さんの病氣、つゞいて借金の話しも聞ましたが、今が今私しの宅から立換へようとは言はなかつた筈、それはお前が何ぞの聞違へ、私は毛頭も覺えの無き事と、これが此人の十八｜番とはてもさても情なし。",
              "citation": {
                "source": "大つごもり",
                "author": "一葉女史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばかりでなく、我我自身の場合を顧みてもさうである。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもさうでなく、我我の詩に求めてゐるものは實に「内容としての音樂」である。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう追憶の船は港をさりやさしい戀人の捲毛もさらさらに乾いてしまつた草場に昆蟲のひげはふるへて季節は亡靈のやうにほの白くすぎてゆくのです。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よにもさびしい私の人格がおほきな聲で見知らぬ友を呼んでゐるわたしの卑屈で不思議な人格が鴉のやうなみすぼらしい樣子をして人氣のない冬枯れの椅子の片隅にふるへて居る。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十歳になった時に、僕はこれでもう青春の日が終った思い、取り返しのつかない人生を浪費したという悔恨から、泣いても泣ききれない断腸悲嘆の思いをしたが、それでもさすがに、自殺するほどの気は起らなかった。",
              "citation": {
                "source": "老年と人生",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その空家の庭は、いつも植物の日影になつて薄暗いただかすかにながれるものは一筋の小川のみづ夜も晝もさよさよと悲しくひくくながれる水の音またじめじめとした垣根のあたりなめくぢ　へび　かへる　とかげ　のぬたぬたとした氣味のわるいすがたをみる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして色の黒い娘たちとあてもない情熱の戀でもさがしに行かう。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "のらくら息子のわたしの部屋には春さきののどかな光もささず陰鬱な寢床のなかにごろごろとねころんでゐる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すつぱい女どもの愛からのがれてなにかの職業でもさがしてみよう。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この猫の活動する世界、風景が、じつによにもさむしい情緒の景色だ――たましひの奧の奧の奧の幽幻の世界――音律のしづかに流るる地方！",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よにもさむしくふしぎな魅力にみちた「青猫」はかくして生れ出で、かくして人々のたましひをいうわくし、うれしがらせさみしがらせ、むずがゆがらしめる、死ぬまでうれしくむずがゆがらしめる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋晴　牧場の牛が草を食つてゐるのをみて、閑散や怠惰の趣味を解しないほど、それほど近代的になつてしまつた人人にまで、私はいかなる會話をもさけるであらう。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああかの暗い隧路の向うに、天幕の青い幕の影に、いつもさびしい光線のただよひゐる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、まぼろしのかもめどり、渚はとほく砂丘はさんらん、十字の上に耶蘇はさんらん、女の胴は砂金に研がれ、その陰部もさんらん、光り光りてあきらかに眞珠をはらむ。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然もさういふ試驗は理學者にのみ必要である。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やるもやらぬもねえじゃないか、いいつけを守って、やめてるだけのもんじゃないか、ボースンもさっきから大分やめろといわれてるようだが、よさないとあとでまたうるさいだろうぜ」　全くボースンにとっては、どちらにしても、あとでうるさい、面倒な事になったものであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕もさっきの不覚の焦燥などは綺麗に忘れ、ひどく幸福な気持で微笑んだ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "うつらうつらしていたら、ひどく汗が出て、気持もさっぱりして来た。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私もさっそく四人の大学生の間に割込んで、先生の御高説を拝聴したのであるが、このたびの論説はなかなか歯切れがよろしく、山椒魚の講義などに較べて、段違いの出来栄えのようであったから、私は先生から催促されるまでも無く、自発的に懐中から手帖を出して速記をはじめた。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
