    "definitions": [
      {
        "index": 1,
        "gloss": "tough guy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はその道の猛者として知られており、誰もが一目置いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "戦場で数々の死線をくぐり抜けてきた、まさに歴戦の猛者だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このチームには、全国から集められた猛者たちが揃っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "Ｓ＝代官屋敷の夜――　竹垣三郎兵衛の屋敷に乱入した次郎長を始め清水一家の猛者八人。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "所が、何でも久米正雄夫人自身の懷姙中の運勢の素晴しかつたことは今でも鎌倉猛者連の語り草になつてゐるくらゐださうだが、懷に入つてふとるといふ八卦でもあらうか？",
              "citation": {
                "source": "麻雀を語る",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……鹿児島の猛者が羅宇の嵌替は無い図でない。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "且又同じ一國一城の主と成るにも猛者が夜撃朝懸とは質が違ふ。",
              "citation": {
                "source": "二た面",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "髯の旦那は、眉の薄い、頬の脹れた、唇の厚い、目色の嚴い猛者構。",
              "citation": {
                "source": "錢湯",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "言つきで、軍人の猛者か、田舎出の紳士かと思われるが、そうでない。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "武器は武器でも、念流、一刀流などの猛者の手を経たものではない。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから手の者の芸人に猛者を得ることに、彼女等は腐心したのであって、つゞまるところわたしはお品のプロパガンダの道具に使われたに過ぎないが、しかし、わたしをそうしたに就て、下町の名妓の好みもあった。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "哀れなるかな、激烈なる生存競争に敗れて気息｜奄々たる、一頭の成牝若くは処女獣をさえ収め得ず、小なる小なるハーレム一つ創り得ずに止む永遠の孤独者、または昨の英雄、かつてのハーレム中の獰猛者、しかもまた老大奮わぬ今日の悶々者、かつはまた既に煩悩の兆して、未だ力弱き半成牡。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "『管子』に〈虎豹は獣の猛者なり、深林広沢の中に居る、すなわち人その威を畏れてこれを載す、虎豹その幽を去って而して人に近づくすなわち人これを得てその威を易る、故に曰く虎豹幽に託って威載すべきなり〉。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "師直の一家中もその数には洩れないで、かれらが生い立った武蔵野の芒をそのままという髭面をそらせて、坂東声を遠慮｜会釈もなしに振り立てるいわゆる「猛者」の巣窟である中に、かの采女ばかりは都びとにも笑われないような優美の風采を具えていた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂東育ちの猛者と誇るかれらも、眼に見えない怖ろしい礫にはひどく脅かされたらしく、不安ながらに再びあゆみ出すと、そこに脳天を砕かれたのや、真っ向を割られたのが四、五人も倒れていた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは山川君とふたり、錦町の警察に連れて行かれてみると、そこの留置場にはすでに大杉、荒畑、森岡、百瀬、村木、宇都宮、佐藤などの猛者が来ており、外に神川、管野、小暮、大須賀などの婦人連も来ていた。",
              "citation": {
                "source": "赤旗事件の回顧",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "扇谷家第一の猛者｜小幡東良が能登守教経然たる働きをするほかは、里見勢も上杉勢も根ッから動いていない。",
              "citation": {
                "source": "八犬伝談余",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "なまじひに眼ふたぎて、赦るされて、　這ひ行くは憂し、否｜残なく味ひて、かれも人なる　いにしへの猛者たちのやう、矢表に立ち楽世の寒冷、苦痛、暗黒の　貢のあまり捧げてむ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "なまじひに眼ふたぎて、赦るされて、　這ひ行くは憂し、否残なく味ひて、かれも人なる　いにしへの猛者たちのやう、矢表に立ち楽世の寒冷、苦痛、暗黒の　貢のあまり捧げてむ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏訳詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "なまじひに眼ふたぎて、赦るされて、　這ひ行くは憂し、否、殘なく味ひて、かれも人なる　いにしへの猛者たちのやう、矢表に立ち樂世の寒冷、苦痛、暗黒の　貢のあまり捧げてむ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他、有名な闘牛士にはガリト、マチャキト、リカルド・トレスなんかの猛者がいて、すこし古いところではアントニオ・フュエンテがある。",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らはその東洋的な流儀では一種の猛者、蛮カラな人物と呼べよう。",
              "citation": {
                "source": "九州の学生とともに",
                "author": "WITH KYUSHU STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "硯友社の或猛者の如きは「今に見ろ、暗の夜の横町でゝも出ツくはしやア、目に合せてくれる」と豪語してゐたといふ噂があつた。",
              "citation": {
                "source": "斎藤緑雨と内田不知菴",
                "author": "坪内逍遙",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で自分はいかにも最｜猛者のように云いふらした。",
              "citation": {
                "source": "光の中に",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、ロシアで一般に猛者と呼ばれている類いの若者で、父親が獣類の生まれ方について夢中になっている間に、彼の筋骨逞ましい二十歳の肉体は、盛んに羽翼を伸ばしていたのである。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "』彼はこのような父性愛を披瀝して、伜のモーキイ・キーフォヴィッチには相も変らず猛者ぶりを発揮させておいて、自分はまた例のお気に入りの題目にかえって、フイとこんなような問題に頭をひねるのであった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "その二人の像の間で東野は、「これや、どっちも十九世紀初頭の猛者だったんだが、そんなら僕は一つ俳句を作ろう。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "正忠を恋の猛者ぞと友の云ふ戒むるごとそそのかすごと　正忠は山城正忠君の事で、琉球那覇の老歯科医である同君は年一度位上京され、その都度荻窪へも立ち寄られた。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋の猛者とは年老いてなほ若い者に負けない気力を示した意味であるが、大勢の子供があり既に初老を越えた身の何事だといふのが戒むる意味、その純真な態度を知つては大に若返るのもいい事だ少しはやるがよいといふのがそそのかす意味、あなたを恋の猛者だと冷かすがその中には以上二つの意味が這入つてゐるのですよ。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、事の真相を測りかねた各社の猛者連が、翌朝折竹の宿へ目白押しに押しかけてきた。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おお、おれは今夜、かわいそうな人を、生みの家へ届けてやって来たのだが、何しろ先きも、名だたる猛者、ことによると、これがきっかけで、こっちの秘密を、ハッと推量するかも知れぬ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ十字疾行する街路のうへそのするどさに日輪もさけびくるめき群集をこえて落しきたるを感じいのり齒をくひしめ受難の日のひくれがたわれつひに蛇のごとくなりて絶息す。",
              "citation": {
                "source": "受難日",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔われらひとしく丘に立ち〕宮沢賢治われらひとしく丘に立ち青ぐろくしてぶちうてるあやしきもののひろがりを東はてなくのぞみけりそは巨いなる塩の水海とはおのもさとれども伝へてきゝしそのものとあまりにたがふこゝちしてたゞうつゝなるうすれ日にそのわだつみの潮騒のうろこの国の波がしらきほひ寄するをのぞみゐたりき",
              "citation": {
                "source": "〔われらひとしく丘に立ち〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
