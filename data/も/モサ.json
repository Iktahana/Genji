[
  {
    "uuid": "06e2d174-1829-535a-accf-a3632a3aad19",
    "entry": "猛者",
    "reading": {
      "primary": "もさ",
      "alternatives": [
        "もうざ"
      ],
      "is_heteronym": false
    },
    "grammar": {
