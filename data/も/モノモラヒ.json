          "literary": [
            {
              "text": "昨日から右眼にモノモラヒが出来て重っ苦しくて困る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "モノモラヒがまだ治り切らず、憂鬱だ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の眼のモノモラヒ全快。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミス・コロ来り、夫婦と並んで写真を撮り、中根眼科へ行く、モノモラヒを潰して貰ひ薬をさす、昨日が二円、今日五十銭、とは眼医者とは安いものだな。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
