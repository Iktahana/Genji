[
  {
    "uuid": "fd39635f-3173-593d-93af-d9307115d87f",
    "entry": "目今",
    "reading": {
      "primary": "もっこん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "at present",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "目今、その問題は緊急の課題として取り組まれています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "目今、彼女は新しいプロジェクトに集中している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "目今、世界経済は大きな転換期を迎えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "でも、当時此の塾舎の学生として居た者で、目今有要な地位を得ている者が少くない。",
              "citation": {
                "source": "私の経過した学生時代",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は目今失意の境にある。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、目今時勢御聞入候。",
              "citation": {
                "source": "手紙",
                "author": "慶応元年九月七日　坂本権平、乙女、おやべあて",
                "note": "青空文庫"
              }
            },
            {
              "text": "無種の流言して幕府長との中をたがへ、目今将軍大兵を発し大坂ニ来ル、是和蘭の讒より起りし事也。",
              "citation": {
                "source": "手紙",
                "author": "慶応元年九月七日　坂本権平、乙女、おやべあて",
                "note": "青空文庫"
              }
            },
            {
              "text": "小弟ガ論ニ竊ニ大兄に言、目今御かゝりの丹波丹後の一件云々大坂四ツ橋大仏や門前御談の事万｜不可被忘、十分右の所に御心お御用第一なり。",
              "citation": {
                "source": "手紙",
                "author": "慶応三年十月二十二日　陸奥宗光あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "目今大不幸、官吏皆因修、是又天下の不幸――三月――",
              "citation": {
                "source": "続　手紙",
                "author": "幕閣要人あてか（推定、慶応二年三月）",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、目今、本省にてその直轄学校のために費すところ、毎年五十万円なれば、資金五百万円を一時に下附してその共同の私有金となし、この金をもって実価五百万円の公債証書を買うて、これを政府に預け、年々およそ五十万円の利子を収領すべし。",
              "citation": {
                "source": "学問の独立",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "目今その手段を求めて得ざるものなり。",
              "citation": {
                "source": "徳育如何",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "京都の学校は明治二年より基を開きしものにて、目今、中学校と名る者四所、小学校と名るもの六十四所あり。",
              "citation": {
                "source": "京都学校の記",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "目今この類の者、男子八人、女子二人あり。",
              "citation": {
                "source": "京都学校の記",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかれども目今の現状よりこれを見ればあえてことごとく揣摩の見というべからざるがごとしといわざるべからず。",
              "citation": {
                "source": "将来の日本",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の益田さんは、目今天下有数の茶人である。",
              "citation": {
                "source": "現代能書批評",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人答て曰く、團十郎は新富劇に出場せるが、該劇は近日炎帝特に威を恣にするを以て、昨日俄に場を閉じ、圓朝は避暑をかねて、目今静岡地方に遊べりと。",
              "citation": {
                "source": "松の操美人の生埋",
                "author": "序",
                "note": "青空文庫"
              }
            },
            {
              "text": "目今は舶来の仕付糸安き故、麻にてこれをうむもの少なしという）を抱えて立出づるは精米を買いに行くなるべし。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "あに上世の虎は目今の猫のごとく、太古の熊は今日の犬のごとしというべけんや。",
              "citation": {
                "source": "教門論疑問",
                "author": "柏原孝章",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし共産党問題ぐらい目今重大な問題はない。",
              "citation": {
                "source": "マルクス主義は科学にあらず",
                "author": "山川健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "世の人が目今共産党事件などに関し、思想は思想で取締るがよいとよく申しますが、いま共産主義者は学生なるとしからざるとにかかわらず、ただ単に共産主義を信じているというばかりでなく、同志を募り毒悪な宣伝をなしているので、かれらはすでに毒悪主義を実行することに取りかかっているのである。",
              "citation": {
                "source": "マルクス主義は科学にあらず",
                "author": "山川健次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
