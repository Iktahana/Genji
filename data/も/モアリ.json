        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」とおつしやつたのに、間髪をいれず、ソレモアリマス　あざやかなものでございました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ソノ時探シタノデスガ何モアリマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノ中ニハ可也信用ノ置カレルノモアリ、又可也怪シイモノモアルガ、此點ニ就テハ一切私見ヲ加ヘルコトナシニ、其儘ヲ採録シタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "……中に、ステパンの会話の力で判断してだろう、片仮名で、「オナツカシキペテロフサマ、ソノゴオカワリモアリマセンカ、ユウベ、マテイタノニキテクダサイマセン、ナゼデスカ、シドイシト、ワタシノココロモシラナイデ。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナド見エ、又豐後風土記日田郡五馬山ニ、土蜘蛛五馬媛、肥前風土記佐嘉郡ニ、土蜘蛛大山田女、狹山田女ナドモアリ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタ　メガサメテミルト、オホソウヂハ　モウドコヘイツタカ　カゲモカタチモアリマセンデシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウダント　イフノハ　ホカデモアリマセン、モウ一シユウカンスルト　オマツリガ　アルノデス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウダント　イフノハ　ホカデモアリマセン、モウ一シユウカンスルト　オイケデ　オマツリガ　アルノデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（７）便ノ助辭ハ文中多ク直ニノ意ヲアラハセドモ、元來、便ノ字ハ或ハ「遂ニ」ノ意ヲアラハス助辭ニ用ヒラルヽ事モアリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "又蜂蟻ノ類ノ如キハ、人間社會ト同ジク群居スル者ナルヲ以テ、自ラ君臣又ハ役員等ノ順序モアリ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "小野蘭山の『大和本草｜批正』には「三波丁子　一年立ナリ蛮産ナレドモ今ハ多シセンジュギクト称ス秋月苗高五六尺葉互生紅黄草ノ如ニシテ大ナリ花モコウヲウソウノ如ニシテ大サ一寸半許色紅黄単葉モ千葉モアリ葩長ク蔕ハツハノヘタノ如ク又アザミノ如シ九月頃マデ花アリ花鏡ノ万寿菊ニ充ベシ」とある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三度グリについて小野｜蘭山の『本草綱目啓蒙』巻之廿五、栗の条下に「マタ越後ニ三度グリアリ大和本草ニヤマグリト云［牧野いう、『大和本草』にこの名は見えない］石州ニテ　カシハラグリト云｜茅栗ノ類ニシテ年中ニ三度実ノルト云越後ノミナラズ石州予州土州上野下野ニモアリト云」と出ている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ重ミハ膝頭ニ来ルコトモアリ、足ノ甲ヤ足ノ裏ニ来ルコトモアリ、日ニヨッテ違ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿道ノ故障ハ今朝ハ一応良クナッタノデ、行ッテ行カレナイコトハナイノダガ、夜ノ外出ナド飛ンデモアリマセント云ッテ、佐々木ガ承知シナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モット人ノ悪イ邪推ヲスレバ、予ニ疑ワレテイルコトヲ知ッテイル颯子ハ、治療ノ隙間ニ予ガ廊下ヘ出テ様子ヲ探ルコトモアリ得ルト、推量シタノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今オ気持ガオ悪イヨウナコトハゴザイマセンカ」「気持ハドウモアリマセンガネ、血壓ガ高インデスカ」「二百ホドゴザイマス」彼女ガコンナ風ニ云ウ時ハ大概二百以上ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エライ目ニオ会イニナリマシタソウデ」「ナアニ何デモアリマセンヨ」「兎ニ角見セテ戴キマショウ」臥カサレテ手ヤ足腰ヲ委シク検査サレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハソレヲ考エルト不安デモアリ、彼女ニ罪深イヲ好ムノデアル、―――ヲ刺戟シテ、ソレニヨッテ自分ヲ刺戟シヨウトスル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラ嫉妬ハ或ル意味ニオイテ必要デモアリ快感デモアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、何ノ目的デサヨウナヲ分ラセテイルノデアルトシテモ、ソレハ、「私ハセメテ相手ヲアナタト思イタクナイノデス、木村サンダト思イタイノデス、ソウシナケレバ感興ガ湧イテ来ナイノダカラ、結局ハソレガアナタノタメデモアリマス」トイウ意味ナノカ、「コレモヤハリアナタヲ嫉妬サセテ刺戟ヲ与エル手段ナノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハドンナ場合デモ常ニ夫ニ忠実ナル妻デアル以外ノ何者デモアリマセン」トイウ意味ナノカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ニダケハ見ラレテモ仕方ガナイ」ト云ッタラ、「場所ハナイ※モアリマセン、宿ノ主人ニ話シテ見マショウ」ト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この推測が当っていたことは、「僕ハソノ嫉妬ヲ密カニ享楽シツツアッタ」、―――「僕ハ嫉妬ヲ感ジルトアノ方ノ衝動ガ起ル」、―――「ダカラ嫉妬ハ或ル意味ニオイテ必要デモアリ快感デモアル」（一月十三日）―――等々とあるので明らかであるが、もうそのことは一月一日の日記の中でうすうす私には想像できたのであった。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "科人、毎日五十人、三十人ヅツアリ、打首ニナルモアリ、血マブレナル首ヲ俵ヘ入レ、三十荷モ持チ出シテ、大坑ヘ打捨テタリトモ聞エタリ。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "名犬ハ税トシテモ貴マレ、一匹ノ価、百貫ヲ呼ブモアリ、武門｜悉ク、犬ヲ繋ギ、犬ニ仕へ、日、暮ルレバ又、宴楽アルノミ。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナホ外ニ、武蔵ガ念ズル観音ノ小像モアリシガ、近年紛失シタリトモイフ　明白に父の無二斎に連れられて播州へ行ったまま消息不明になった次第などではない。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
