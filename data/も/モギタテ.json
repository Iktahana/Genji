    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もぎ立ての高い香りにむせび乍ら、唇を赤くして飽かず喰べた。",
              "citation": {
                "source": "動かぬ女",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は彼女のエメロオドのような瞳に、またもぎ立ての果物のような頬に、また紅い花模様の上衣の下にふくらんだ胸に、私の命を捨てても惜しくはなかった。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすが御庭のもぎ立てはちがったものだと存じました。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "余等は注文してもぎ立ての玉蜀黍を炉の火で焼いてもらう。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝からもぎ立ての、桃のやうな小娘で、名はお信乃、可愛らしい名でせう」「年は？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "娘の守袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "お雪は貧乏人の娘らしく、何処かませておりますが、年からいえばたった十七で、世辞も愛嬌もない代り、木の上からもぎ立ての果物のような、清純な感じのする娘でした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "妖麗無比な年増と、もぎ立ての桃のやうな美少年が、向ひ合つてほゝ笑み交す圖は、八五郎をすつかり夢中にしてしまつたのも無理のないことでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美少年國",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝からもぎ立ての桃のやうに、銀色のうぶ毛の生えた可愛らしい娘ですがね」　八五郎は拇指で、蝮を拵へて、肩越しに木戸を指すのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "邪戀の償ひ",
                "note": "青空文庫"
              }
            },
            {
              "text": "精々十七八、まだ子供らしさは拔けきれませんが、八五郎が言つたもぎ立ての桃は良い形容詞でした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "邪戀の償ひ",
                "note": "青空文庫"
              }
            },
            {
              "text": "大して美しいといふ程ではないにしても、その新鮮さは、枝からもぎ立ての桃のやうで、誰の眼にも好感が持てます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "三つの菓子",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼は繃帶をして居るし、汚な作りの赤つ黒い娘だけれど、あんなもぎ立ての桃の實のやうな娘は、江戸の眞ん中ぢや見られませんね。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "江戸の夜光石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バナナはもぎ立てはダメで、追熟させないとうまくないと聞いたが――」「いや。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
