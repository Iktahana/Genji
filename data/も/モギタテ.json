    "definitions": [
      {
        "index": 1,
        "gloss": "freshly picked (tomato, apple, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭で採れた捥ぎたてのトマトは、太陽の味がして格別の美味しさだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "道の駅では、地元農家が朝採ったばかりの捥ぎたて野菜を販売している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは果樹園で、捥ぎたての甘いリンゴを頬張っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "今日は朝、昼、晩の三度とももぎたての茄子を食べた、うまい／＼。",
              "citation": {
                "source": "行乞記",
                "author": "伊佐行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "野菜はうまい、そのほんとうのうまさはもぎたてにある。",
              "citation": {
                "source": "行乞記",
                "author": "山口",
                "note": "青空文庫"
              }
            },
            {
              "text": "もぎたての果実のやうに新鮮な軽い味である。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の頭大漢　蔓からもぎたての西瓜が一つ台所の板敷に転がつてゐる。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほのかに残つてゐる酸味は、今もぎたてのフレッシュを裏書きするのである。",
              "citation": {
                "source": "南予枇杷行",
                "author": "河東碧梧桐",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝からもぎたてのしずくのしたたるばかりのようなくだものを味わったことがありますか。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "御覧の通りもぎたてで。",
              "citation": {
                "source": "果物屋の広告文",
                "author": "仲村渠",
                "note": "青空文庫"
              }
            },
            {
              "text": "いとしいあこがれも信頼の籠に盛られれば、それは朝々にもぎたての果物のよう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
