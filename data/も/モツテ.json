        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『ホンジツヲモツテキンユシユツハカイキンサレマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "瘤取りムカシ　ムカシノオ話ヨミギノ　ホホニ　ジヤマツケナコブヲ　モツテル　オヂイサン　このお爺さんは、四国の阿波、剣山のふもとに住んでゐたのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "瘤取りムカシ　ムカシノオ話ヨミギノ　ホホニ　ジヤマツケナコブヲ　モツテル　オヂイサン　このお爺さんは、四國の阿波、劍山のふもとに住んでゐたのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、「オンモハ　ドンナ　トコロデセウ」ト　ドノ　ツボミモ　オモツテ　ヰルノデ　アリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "花タチハ　キイタ　コトノ　アル　コヱダト　オモツテ　ミルト、ウマヤノ　マドニ　大キナ　ヤサシイ　ウマノ　カホガ　ノゾイテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゴノ　中ノ　サムライガ　ナンダラウト　オモツテルト、コンドハ、「タヽキコロサウカ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フエヲ　一ポン　モツテ　イエイエノ　トグチニ　タツテ、ヒロ　ヒロ　ヒート　カナシイ　オトヲ　フルハセ、一セン　二センヲ　モラツテ　タビヲ　シマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヒルノ　ヤスミノ　トキ、ヨシダセンセイニ　イヒツカツテ　タキクンハ、トウサンノ　トコロヘ　ホンヲ　モツテ　イキマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ソレヂヤ　シカタナイト　オモツテ、ハジメノ　デンデンムシハ、ベツノ　オトモダチノ　トコロヘ　イキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カナシミハ　ダレデモ　モツテ　ヰルノダ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、コヒツジヲ　フトコロカラ　トリダシ、ブチコロサウト　オモツテ　イシコロヲ　フリアゲマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイヘン　シヅカナ　ムラデ　イヌノ　ナキゴヱモ　キコエズ、イエイエノ　マドハ　ミナ　カタク　トザサレ、ガイトウニハ　ヒガ　トモツテ　ヰマセンデシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブンガ　リツパナ　タイシヨウニ　ナツテ、ムネニ　ヅラリト　クンシヨウヲ　ナラベ、ピカピカ　ヒカル　ケンヲ　モツテ、ウマノ　上ニ　ソリカヘツテ　ヰル　ユメヲ　ミテ　ヰルト、ヤガテ　ヨガ　アケテ　アサニ　ナリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヘノ　ナカニハ　フタリノ　トシヨリガ　ヰテ　チヨウド　ヒトツノ　パンヲ　フタツニ　キラウト　シテ　ヰル　トコロデシタガ、ハラノ　スイタ　ヲトコヲ　キノドクニ　オモツテ　パンヲ　ミツツニ　キリ、ソノ　ヒトキレヲ　ヲトコニ　メグンデ　ヤリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トテ　トテ　トテ　ト　ミナ　ミナ　オキロ　モウ　アサダ、　トテ　トテ　トテ　ト　クワヲバ　モツテ　ハタニ　デロ、　トテ　トテ　トテ　ト　タネヲバ　マケヨ　ムギノ　タネ　トテ　トテ　トテ　ト　トテ　トテ　トテ　ト」ト　ヲトコハ　フイタノデ　アリマス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウサギノ　ハイツタ　カゴヲ　モツテ　ヲリマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヤウサンハ　チヨウド、ロバガ　イツピキ　ホシイト　オモツテ　ヰタ　トコロデシタノデ、アキナヒノ　モツテ　ヰル　カゴヲ　ノゾイテ　ミマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナハ　イイ　グアイダト　オモツテ　イマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ　シテモ、ケイキキユウハ　ナント　イフ　リツパナ　マルイ　カゲヲ　モツテ　ヰル　コトデセウ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾシ、私ノウチニハ、オ皿トナイフトフオークガ一ツヅヽシカアリマセンカラ、オイデ下サル方ハ、ドウゾ、ゴジブンノオ皿ト、ナイフト、フオークヲモツテイラシツテ下サイ。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ネギサンガ迷子ニナルカモシレナイトオモツテ、アトカラ、オツカケテキタトコロデス。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンノオ父サンハボンコチヤンガカハイサウニナリマシタカラ、クワイ中電燈ヲモツテ、ワンコチヤンヲツレテ、ボンコチヤンヲサガシニユキマシタケレド、アタリハマツクラ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、オヂイサンハ、ソノ箱ニモンコチヤンノオトコロトナマヘヲカイテ、郵便局ニモツテイツテ、切手ヲハリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　シバラクシテ　モウ　ウマク　ヤケタラウト　オモツテ　オマンヂウヲ　オイタトコロヘ　カヘツテキテミルト　オマンヂウハ　一ツモ　アリマセン。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トカイタ大キナハタヲモツテ、小サナ男ノ子ノ手ヲ引イタカイスイヨクジヨウノバン人ガムカフカラ歩イテ来ルノガミエマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ猶｜有縁ノ地タルヲモツテ、吉原回禄ノ災ニ罹ル毎ニ、権ク爰ニ仮肆ヲ設ケテ一時ノ栄ヲ取ルコト也最数回ナリ。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、危急ノ場合ハ護身術（国民戦闘訓、第三、第四）ヲ用ヒ、大声ヲモツテ救助ヲ求メル。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノウサギハアル人ガ「オヂヤウチヤンニサシ上ゲマス」トイツテ、モツテキテクレタウサギデス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今昔物語」などには、“合戦ヲモツテ、業トナス――”人種のようには書いてあるが、匪賊のように、それのみが目的ではない。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
