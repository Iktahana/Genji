        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "で氏郷は忽ち物頭にして二千石を与えたというのである。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "貞固と東堂とは、共に留守居の物頭を兼ねていた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "物頭は詳しくは初手足軽頭といって、藩の諸兵の首領である。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "留守居も物頭も独礼の格式である。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "比良野氏ではこの年同藩の物頭二百石｜稲葉丹下の次男｜房之助を迎えて養子とした。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "加番は各｜物頭五人、徒目付六人、平士九人、徒六人、小頭七人、足軽二百二十四人を率ゐて入城する。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "森は田辺に着いたし、景一に面会して御旨を伝え、景一はまた赤松家の物頭井門亀右衛門と謀り、田辺城の妙庵丸櫓へ矢文を射掛け候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "次いで物頭列にせられて紀姫附になった。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊喜の嫡子衛一郎は後四郎右衛門と改名し、玉名郡代を勤め、物頭列にせられた。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが著くと、福岡城では留守の家老、物頭、諸侍が集まつて評議をした。",
              "citation": {
                "source": "栗山大膳",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "加津佐、堂崎、三会、有馬、串山、布津、有家、深江、安徳、木場、千々岩、上津浦、大矢野、口野津、小浜等十数ヶ村の庄屋三十数名が物頭役として十軍に分った総勢二万七千、老若婦女を合せると三万を越す人数を指揮した。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "平田門人、三輪田綱一郎、師岡正胤なぞのやかましい連中が集まっていたという二条｜衣の棚――それから、同門の野代広助、梅村真一郎、それに正香その人をも従えながら、秋田藩｜物頭役として入京していた平田鉄胤が寓居のあるところだという錦小路――それらの町々の名も、この人の口から出る。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよ水戸浪士がその日の晩に長窪和田両宿へ止宿のはずだという風聞が伝えられるころには、諏訪藩の物頭矢島｜伝左衛門が九人の従者を引き連れ和田峠｜御境目の詰方として出張した。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにこの物頭が馬の口を取る二人の厩の者も随行して来た。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとの人数にも早速出張するようにその言伝てを御使番に頼んで置いて、物頭もまた乗馬で種々な打ち合わせに急いだ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "物頭はまず峠の内の注連掛という場所を選び、一手限りにても防戦しうるようそこに防禦工事を施すことにした。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "物頭が樋橋まで峠を降りて昼飯を認めていると、追い追いと人足も集まって来た。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、諏訪から出張した藩士が樋橋上の砥沢口というところで防戦のことに城中の評議決定の旨を物頭に告げた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "早速、物頭は歓迎の意を表し、及ばずながら諏訪藩では先陣を承るであろうとの意味を松本方の重役に致した。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "物頭は樋橋下の民家を三軒ほど貸し渡して松本勢の宿泊にあてた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "物頭の計らいで、松本方三百五十人への一度分の弁当、白米三俵、味噌二｜樽、漬け物一樽、それに酒二樽を贈った。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "樋橋付近の砦の防備、および配置なぞは、多くこの物頭の考案により、策戦のことは諏訪藩銃隊頭を命ぜられた用人塩原彦七の方略に出た。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何うも、可怪しい、何か、悪い企みがあるのではないか」　と、いう疑いが、まず、お目付兼物頭、名越左源太から起された。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「町奉行兼物頭、近藤隆左衛門か」　百城は、紙へ、認めた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤山は、役は、物頭にすぎなかったが、日置郡、日置郷、八千七百五十四石の一所持の格式者で、城代家老、島津和泉久風の二男であった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "御三家、老若譜代大名、諸番がしら、物頭、お医師まで拝観、とある。",
              "citation": {
                "source": "元禄十三年",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっぱれ右近府の蔵人として、若いながらも武名高く、素破や合戦とある時には、一方の物頭ともなる男が、女房の愛に引かされて、さほどの大事をうかうかと明かし、頼まれたお方を裏切るとは！",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "行衣の下へ腹巻を着、籠手さえつけた範覚は、一方の物頭にでもなった気で、厳めしく物々しく振る舞うのであった。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論同船者は他にもあって、物頭役の戸塚甚五左衛門とか、平士の長野、岡部、伊佐岡とかいう者も乗組んでいて、戸塚はじめ我々の家来なぞもあるから、随分多人数が乗ったのである。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "是れから物頭がまいりまして、段々｜下話をいたし、權六は着慣れもいたさん麻上下を着て、紋附とは云え木綿もので、差図に任せお次まで罷り出で控えて居ります。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
