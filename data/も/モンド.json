[
  {
    "uuid": "36d18825-bb1d-5add-bf4f-e0f0d81804e0",
    "entry": "主水",
    "reading": {
      "primary": "もんど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
