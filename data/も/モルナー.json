        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "九月には、モルナールのものをやることになっていますの、その方が私の柄にあうんじゃないかと思っていますの。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "モルナー、チャペックの作品よろし、感心した。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "モルナーのは「リリオム」。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "モルナールは「ドナウの春は浅く」のなかで、現実生活に敗れた少女をして、ドナウの濁流の中に身を投じさせた。",
              "citation": {
                "source": "風景",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "レナーと同じくブダペストに生れたロート、アンタール、モルナール、ショルツの四人が、この成功を収めるまでの苦心と研鑚は想像するに難くない。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
