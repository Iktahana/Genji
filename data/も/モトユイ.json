[
  {
    "uuid": "e9c17ca9-ca16-55c6-afe9-5b596798c411",
    "entry": "元結い",
    "reading": {
      "primary": "もとゆい",
      "alternatives": [
        "もとい",
        "もっとい"
      ],
      "is_heteronym": false
    },
    "grammar": {
