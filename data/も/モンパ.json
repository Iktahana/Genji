[
  {
    "uuid": "c7e8b46f-b525-5981-b3a2-68f39455792b",
    "entry": "門派",
    "reading": {
      "primary": "もんぱ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
