    "definitions": [
      {
        "index": 1,
        "gloss": "moment (of time)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その決定的なモーメントを、彼は決して忘れることはないだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "人生のいくつかのモーメントは、その後の彼を大きく変えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "予期せぬ出来事が起こった、まさにそのモーメントに、彼は冷静に対応した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「灰汁桶のしずくやみけりきりぎりす」などはイディルレの好点景であり、「物うりの尻声高く名乗りすて」は喜劇中のモーメントである。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「刹那即ちモーメントの出来事を……」と、云ったような言葉遣いが、譲吉の僧侶に対する反感を、一層強めた。",
              "citation": {
                "source": "大島が出来る話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが日本の文学の発達を考えて見るに果してそう云うモーメントが有ったか、有るまい。",
              "citation": {
                "source": "私は懐疑派だ",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "形は小さいが、活々したモーメントを批判し、到るところで、いろんな形で、敵の攻撃と自己批判をやってゆく、独特な文化的武器となるに違いないのである。",
              "citation": {
                "source": "新たなプロレタリア文学",
                "author": "――アレゴリーと諷刺――",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくして地球がいくらかいびつになること、人工竜巻の生ずるモーメント、それと月世界の質量の増加することとが、相重り合って、遂に地軸がかくも廻ったのであった。",
              "citation": {
                "source": "地軸作戦",
                "author": "――金博士シリーズ・９――",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊川がいくらひきうけたって、戦争がはじまるモーメントなんか、誰にだってわかるもんじゃないから」「でしょう？",
              "citation": {
                "source": "川波",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "マックァサーは日本人は戦争に負けたが威厳を失っていないといったが、同感だ……たぶん……いや、かならず調印式まで漕ぎつけるだろう……これだけの大きな戦争をした日本人が冷静に終幕にしたら、日本人の別な一面を理解させるモーメントになるだろう。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに九月のドーラ・カプランのレニン暗殺事件をモーメントにしてチェカの仕事は文字通りのギロチンになり、真赤に血に染んだ革の手袋は乾くひまもなく、二十年の末までに二百万人以上も屠殺してしまった。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり刑罰の主要なモーメントの案配は、受刑者の自由意志に任せるといったぐあいになっている。",
              "citation": {
                "source": "新西遊記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその諸制約を明らかにすると、偶々今日に於ける社会通念としての所謂常識に含まれている諸モーメントが又明らかになって来る。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば『ノクターン』（Ｊ八〇七六）や『モーメント・ミュージカル』（Ｊ八四四四）や『アリア』（Ｊ五三一五）などがその一例だ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この夕陽とサーファーをとらえたワン・ショットは、今回の私たちの映画のなかで重要なモーメントとして使用されます。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この地方の各所に當時まだ殘存してゐた麥年貢撤廢の成功が發展の重要なモメントとなつたのである。",
              "citation": {
                "source": "一過程",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し、外交問題は、幕府倒壊のモメントとなつた。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリイ・オオドゥウは、生活に対して身にしみた感覚の健全さをもっている婦人作家の一人であるが、「孤児マリー」（第一書房・堀口大学氏訳）では、ややいくらかマリーの性格の内面的発達のモメントとして孤児院の苦しい生活を描いている。",
              "citation": {
                "source": "若き精神の成長を描く文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう部分ばかりでなく、ドライサアの現実のみかたには通俗なところがあって、クライドの心理、行動のモメントを肯定している作者としての肯定のしかたにもそういう点が強く感じられる。",
              "citation": {
                "source": "文学の大陸的性格について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう心情のモメントの概括は本質において常識で、土台それでまとまりがつくなら小説はいらないと云えるような種類のものなのだと思う。",
              "citation": {
                "source": "今日の文学の諸相",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォルフのカメラはまるで美感と温さとをもった生きもののようで、独特の生命に流動しながら、対象の極めて自然な、しかも性格的なモメントをとらえている。",
              "citation": {
                "source": "ヴォルフの世界",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "火野氏が『中央公論』七月号に発表している「土鈴」は『改造』の「神話」よりずっとテーマとして高い複雑な人間交渉のモメントが捉えられているのだが、ここでも作者は息子の荘太郎は従において、代官神川平助を中心においている。",
              "citation": {
                "source": "作品の主人公と心理の翳",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その質問も答えも、質問と答えとの限りでされているのだが、もし、あの切抜き遊びと着物を切ったいたずらとの場面で、その叱りかたの生きたモメントが展開されたらどんなに啓蒙的な効果があっただろう。",
              "citation": {
                "source": "「保姆」の印象",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リアリストとしてのバルザックの偉大さと、その偉大なリアリストが無自覚のうちにわが身を一つの檻にとじこめていた微妙なモメントは、この点から今日の読者にときあかされる。",
              "citation": {
                "source": "バルザックについてのノート",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うら紫」は最後の作であって、このなかに一葉の新しい展開のモメントが蔵されているという意見もあるようだけれど、果してどうであろうか。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人達の人生態度として、一応女性の人間性、女性の個性のゆたかで自然な成長を求め、互が人間として高まるモメントとして両性の結合をも見たのは動かせない事実であった。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この青野季吉の論文がモメントとなって、ひきつづき『文芸戦線』『プロレタリア芸術』に発表された谷一、中野重治、鹿地亘、久板栄二郎等の論文は、「ただ青野季吉の政治理論を福本の政治理論によって代えたものにすぎなかったのである。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめは純文学の仕事をする積りだったという関、階級闘争に参加している一方ではギリシャの古詩を愛読しているということを、関の性格を語るモメントとして、作者は描いている。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "思えば、荷風という作家は、彼独特のめぐり合わせで、日本の歴史的モメントにふれて来ている。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一人の人間の性格は他人から見える面だけで構成されていないように、自分から見える面だけでも構成されていないことを」痛感した私という一人の女性について、作者はたくさんの展開のモメントを「こういう女」の中に示した。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "粘りづよい体温のたかいこの作者が、自由に作品の書けてゆく数にしたがってリアリスティックな客観性を深めひろめて、「こういう女」の蔵している真面目な諸モメントを社会的な視野で展開し、描き出して行ったとき、彼女の「施療室にて」が文学としてもった新しい意味は貫徹されるのである。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界の歴史の進展によって、生きている人間の活溌な心は、変らざるを得ない、という、最も人間的な、従って最も文学的なモメントにおいて、日本の読者たちは、検閲の扉で、ぴったりとその興味ある世界から閉め出されてしまったのであった。",
              "citation": {
                "source": "よもの眺め",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間としての不正直さのためか、意識した悪よりも悪い弱さのためか、彼はそういういくつかの人生の発展的モメントを、自分の生涯と文学の道からはずしてしまったのであった。",
              "citation": {
                "source": "歌声よ、おこれ",
                "author": "――新日本文学会の由来――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
