[
  {
    "uuid": "6a91ed5d-2bd3-5267-81ca-56d20808be06",
    "entry": "申し条",
    "reading": {
      "primary": "もうしじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
