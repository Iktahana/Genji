        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこの狭い石段から眺めるシャトウ・モウトン・ロスチルドと名づけられた一八六九年のボルドウ酒やロマネー・コンチという一八七〇年のブルガンディ酒やはその名前の罎を見るだけでフランス人の飲食物に対する執拗な愛慾を観察するに役立つ。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　ミツルクンミタイナ　ヨワムシニマデ、バカニ　サレルト　オモウト　ハラガ　タツテ、「ヒゲサンガ　ナンダイ！",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて徳川時代のマニン、モウトに至るまで、同じ階級のものをすべて中間、ハシタ、マウト、マニンなどと呼んだものであった。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "拒モウトシテモ誘惑ニ打チ克チ得ズ、カエッテソレヲ喜ビ迎エル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "関東の方では大抵スモウトリバナというのは、恐らくは別になお相撲を取らせる草もあったからでしょう。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
