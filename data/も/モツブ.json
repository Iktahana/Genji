        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鑛毒事件は、彼れの專賣問題にして、彼れは此問題の爲めにモツブの巨魁なり、愚民のデマゴーグなりと稱せらるゝをも厭はざるなり※何となれば彼は此問題を以て人情正義の問題と爲すものなればなり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉱毒事件は、彼れの専売問題にして、彼れは此問題の為めにモツブの巨魁なり、愚民のデマゴーグなりと称せらるゝをも厭はざるなり※何となれば彼は此問題を以て人情正義の問題と為すものなればなり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度ノ事ヲエエ機会ニ、小頭組合モ、労働組合モツブシテ見セマス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
