        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供たちは工作の時間に、カラフルな莫臥児を曲げて動物の形を作って遊んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
