          "literary": [
            {
              "text": "山の麓の灯が次第に迫って来て、突堤でモリナガキャラメルのネオンサインが点滅した。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の麓の灯が次第に迫って来て、突堤でモリナガキャラメルのネオンサイン塔が点滅した　船が横づけになり、桟橋にぱっと灯がつくと、あっ！",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月十一日（月曜）〔受信〕電報モリナガシニメンカイシタシキヨウアスニデモ〔欄外に〕　面会　森長氏に電話かける。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "稽古してからツナシマへ行って理髪、モリナガで食事して、座へ帰った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
