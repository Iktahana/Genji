[
  {
    "uuid": "d612ea54-bc1e-580f-a2ef-d30190bdad08",
    "entry": "元より",
    "reading": {
      "primary": "もとより",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
