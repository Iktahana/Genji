        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まるで、男のツツモタセみたいなものだな。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のアパートの隣室が彼らの巣で、主として自分らの情婦をつかってツツモタセの相談をやってる。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのツツモタセのたかってくる金が三円か五円ぐらいで、いちど十円の収穫があったとき、女が、十円札だわねえ、はじめてだわ、とシミジミ云っているのがきこえ、変に悲しい思いにさせられたものである。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれはツツモタセです。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして君たちのことは二度と考えてみるのもイヤになったのさ」　ツツモタセのインネンを、と云わんばかりであったが、青木はそれが気にならないのか、まるで念頭にかからぬ様子で、「あのときは取り乱して、失礼したね。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネズミタケ、コームケ、カワタケ、オヒョウ、ブナモタセ、スズメタケ……　ブナモタセやハンノキモタセなどいう、「もたせ」（もとあし）の類は、いずれも長柄の傘なりの、美しい、いかにも菌らしい形をした菌で、風味もすこぶるいい。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モタセ、持ツの敬語の命令形。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
