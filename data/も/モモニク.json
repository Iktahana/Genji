        "examples": {
          "standard": [
            {
              "text": "「唐揚げを作るなら、ジューシーな鶏のもも肉が一番だ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ローストビーフ用に、牛のもも肉の塊を買ってきた。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「もも肉は脂肪が適度に乗っていて、焼いても硬くなりにくい。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "私どもも肉をいただかず、我らが食卓に血は流れませんのに。",
              "citation": {
                "source": "夢日記",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
