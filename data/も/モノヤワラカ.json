[
  {
    "uuid": "ce2d3f3b-03a2-5fe3-a46d-84e7ab42b5c8",
    "entry": "もの柔らか",
    "reading": {
      "primary": "ものやわらか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
