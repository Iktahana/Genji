    "definitions": [
      {
        "index": 1,
        "gloss": "chilled soba served on a dish (often on a wicker basket or in a shallow steaming basket) with dipping sauce",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "暑い夏の日には、冷たい盛りそばが最高だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この蕎麦屋の盛りそばは、麺の香りがとても良い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "薬味をたっぷり入れて、盛りそばを美味しくいただいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その十三日の午後四時頃に、赤坂の半七老人宅を訪問すると、わたしよりもひと足先に立って、蕎麦屋の出前持ちがもりそばの膳をかついで行く。",
              "citation": {
                "source": "半七捕物帳",
                "author": "吉良の脇指",
                "note": "青空文庫"
              }
            },
            {
              "text": "刈かけし田面の鶴や里の秋岩村田町に着いた時はもう三時、もりそばを味はひ銘酒を味つた。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もりそば」を二つ並木のやぶのような軽く盛ってある家ので、せい／″＼三枚というところですか。",
              "citation": {
                "source": "麺くひ",
                "author": "桂三木助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
