[
  {
    "uuid": "2c1e12b5-3cc5-55c6-9f99-38c6e97576e2",
    "entry": "模擬",
    "reading": {
      "primary": "もぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
