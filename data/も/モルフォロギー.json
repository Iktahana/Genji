          "literary": [
            {
              "text": "モルフォロギーの思想とテュポロギーの思想とはもともと離るべからざるものである。",
              "citation": {
                "source": "ゲーテに於ける自然と歴史",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代の歴史家たちがゲーテから汲み取らうとするのは、特にこのモルフォロギー的思想である。",
              "citation": {
                "source": "ゲーテに於ける自然と歴史",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュペングラーはその書物を「世界史のモルフォロギー」と名付ける。",
              "citation": {
                "source": "ゲーテに於ける自然と歴史",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "モルフォロギーは彼にあつてモナドロギー的である。",
              "citation": {
                "source": "ゲーテに於ける自然と歴史",
                "author": "三木清",
                "note": "青空文庫"
              }
            }
          ]
        }
