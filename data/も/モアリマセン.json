          "literary": [
            {
              "text": "答　ソノ時探シタノデスガ何モアリマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……中に、ステパンの会話の力で判断してだろう、片仮名で、「オナツカシキペテロフサマ、ソノゴオカワリモアリマセンカ、ユウベ、マテイタノニキテクダサイマセン、ナゼデスカ、シドイシト、ワタシノココロモシラナイデ。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタ　メガサメテミルト、オホソウヂハ　モウドコヘイツタカ　カゲモカタチモアリマセンデシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウダント　イフノハ　ホカデモアリマセン、モウ一シユウカンスルト　オマツリガ　アルノデス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウダント　イフノハ　ホカデモアリマセン、モウ一シユウカンスルト　オイケデ　オマツリガ　アルノデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿道ノ故障ハ今朝ハ一応良クナッタノデ、行ッテ行カレナイコトハナイノダガ、夜ノ外出ナド飛ンデモアリマセント云ッテ、佐々木ガ承知シナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今オ気持ガオ悪イヨウナコトハゴザイマセンカ」「気持ハドウモアリマセンガネ、血壓ガ高インデスカ」「二百ホドゴザイマス」彼女ガコンナ風ニ云ウ時ハ大概二百以上ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エライ目ニオ会イニナリマシタソウデ」「ナアニ何デモアリマセンヨ」「兎ニ角見セテ戴キマショウ」臥カサレテ手ヤ足腰ヲ委シク検査サレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハドンナ場合デモ常ニ夫ニ忠実ナル妻デアル以外ノ何者デモアリマセン」トイウ意味ナノカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ニダケハ見ラレテモ仕方ガナイ」ト云ッタラ、「場所ハナイ※モアリマセン、宿ノ主人ニ話シテ見マショウ」ト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
