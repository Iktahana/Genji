      ],
      "ctype": "形容詞",
      "inflections": null,
      "ctype_source": "existing",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "海岸は心騷がしく、山の中は物恐ろしい。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "物恐ろしい戦場が現われる。",
              "citation": {
                "source": "ある幻想曲の序",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸は心騒がしく、山の中は物恐ろしい。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかと思うと、たとえばはげしい颶風があれている最中に、雨戸を少しあけて、物恐ろしい空いっぱいに樹幹の揺れ動き枝葉のちぎれ飛ぶ光景を見ている時、突然に笑いが込みあげて来る。",
              "citation": {
                "source": "笑い",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬になるとよく北の山に山火事があって、夜になるとそれが美しくまた物恐ろしい童話詩的な雰囲気を田園のやみにみなぎらせるのであった。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して暑さに蒸れ切った空気と、夜よりも暗い暗闇とは、物恐ろしい仮睡に総ての人を誘うのである。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "故郷の家の傾斜の急な高い茅葺屋根から、三尺餘も積んだ雪のかたまりがドーツと轟然とした地響を立てて頽れ落ちる物恐ろしい光景が、そして子供が下敷になつた怖ろしい幻影に取つちめられて、無意識に叫び聲をあげた。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし瞬間に彼の一団は、輝かしい日の光の圏内から消えて、暗い寂しい物恐ろしい、森林の奥へ消え込んだ。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どういう機会から飛騨の山中の、こんな寂しい物恐ろしい、丹生川平というような所へ、伯父様はおいでなされたのでござろう？",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼は邪慾の光に物凄く輝き、額には疲れと恐怖の皺がたたみ、口元は色情の罪の歪みに引歪められて、毒々しい真紅な唇が妖怪らしく蒼ざめた顔色と物恐ろしい対照を作り、迚も人の姿とは思われぬ、まるで悪魔の姿でした。",
              "citation": {
                "source": "艶容万年若衆",
                "author": "三上於兎吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "事実この時代の天変地妖は、物恐ろしいほどであって、明和七年から八年にかけ、諸国は非常な旱魃に襲われ、小田原のごときは一日一人に、水一升とされたほどである。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "芳年の三十六怪選の勇ましくも物恐ろしい妖怪変化の絵や、三枚続きの武者絵に、乳母や女中に手を曳かれた坊ちゃんの足は幾度もその前で動かなくなった。",
              "citation": {
                "source": "山の手の子",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "動物と言つても大きな、物恐ろしいやつでは無く、たより無く小さい。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "物恐ろしい無言の人間が二人そこに置かれたきりだ。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じく天才といっても、ドストエフスキーの夢には、物恐ろしいところがある。",
              "citation": {
                "source": "八月三日の夢",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "血の池に亡者どもがひしめき合っている、地獄絵にそっくりの物恐ろしい有様、これがはたしてこの世の現実なのであろうか。",
              "citation": {
                "source": "黒蜥蜴",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "十四日の一時四十分にとうとうさしもの恐しいマッターホルンの頂上、天にもとどくような頂上へ登り得て大に喜んで、それから下山にかかりました。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「吹く風の目にこそ見えね」ということも、一方が聖霊であるだけに、特にもの恐しいような感じを伴っている。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
