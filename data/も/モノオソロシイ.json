    "definitions": [
      {
        "index": 1,
        "gloss": "vaguely frightening",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
