          "literary": [
            {
              "text": "なまえは　それぞれフロプシー、モプシー、カトンテル、ピーターです。",
              "citation": {
                "source": "あなうさピーターのはなし",
                "author": "THE TALE OF PETER RABBIT",
                "note": "青空文庫"
              }
            },
            {
              "text": "フロプシーと　モプシーと　カトンテルは　とっても　いいこでしたので、　こみちを　くだって　クロイチゴつみに　でかけました。",
              "citation": {
                "source": "あなうさピーターのはなし",
                "author": "THE TALE OF PETER RABBIT",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　かたや　フロプシーと　モプシーと　カトンテルは　ばんごはんに　パンと　ぎゅうにゅうと　クロイチゴを　たべました。",
              "citation": {
                "source": "あなうさピーターのはなし",
                "author": "THE TALE OF PETER RABBIT",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのもりには　うさぎあなが　いたるところに　あって、　そのなかでも　いちばん　きちんとしていて　ふかふかなのが　ベンジャミンの　おばと　そのいとこたち　――　フロプシー　モプシー　カトンテル　ピーター　――　の　おうちなのです。",
              "citation": {
                "source": "ばにばにベンジャミンのはなし",
                "author": "THE TALE OF BENJAMIN BUNNY",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
