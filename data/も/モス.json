        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鉄道線路の工事場で、火を燃すと、煙は下に流れる。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝋の継ぎ足しはあるにして、一時に燃すと翌方までの便がないので、手分けをするわけには行きません。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "最も身体を蓋に為て畚の魚を抱いてゞも居れば、如何に畜生に業通が有つても、まさかに骨を徹しては抜くまい、と一心に守つて居れば、沼の真中へひら／＼と火を燃す、はあ、変だわ、と気が散ると、立処に鯉が失せる。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊佐戸の町で燃す火が、赤くゆらいでゐます。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊佐戸の町で燃す火が、赤くゆらいでいます。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪峡宮沢賢治塵のごと小鳥なきすぎほこ杉の峡の奥よりあやしくも鳴るや　み神楽いみじくも鳴るや　み神楽たゞ深し天の青原雲が燃す白金環と白金の黒の窟を日天子奔せ出でたまふ",
              "citation": {
                "source": "雪峡",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗谷〔一〕宮沢賢治まくろなる流れの岸に根株燃すゆふべのけむりこらつどひかたみに舞ひてたんぽゝの白き毛をふく丘の上のスリッパ小屋に媼ゐてむすめらに云ふかくてしも畑みな成りてあらたなる艱苦ひらくと",
              "citation": {
                "source": "宗谷〔一〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いのちを享楽のしめ木にかけ、いのちを消費の火に燃す支度の金だ。",
              "citation": {
                "source": "雪",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　狐が馬にも乗らないで、那須野ヶ｜原を二｜本松へ飛抜けた怪しいのが、車内で焼酎火を燃すのである。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝炭を缸上に積むこと山の如くならしめて之を燃す。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し下駄を脱ぐ事に徹底すれば、何時でも黒闇で穿ける、智炬を燃すには及ばないのである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "竈屋のほうでは、かまだきを燃す音や味噌する音が始まった。",
              "citation": {
                "source": "紅黄録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋し、尋ねようと云う石田の宿所は後門を抜ければツイ其処では有るが、何分にも胸に燃す修羅苦羅の火の手が盛なので、暫らく散歩して余熱を冷ます積りで。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏頭、鶏頭、　記憶に悲哀は再燃する、切迫｜詰つた俺の感覚が四ん匍ひになつて剃刀を拾ひかける、ハツと霊魂が後から呼び返すと意久地もなくパタリと身体が平べつたくなる、苦しい涙がポトリポトリと額を抑えた手の甲に零れる……　轡虫が啼く……唐突に座り直して、ぐいと右の指を二三本白粉の瓶に突つ込む。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆さんは腰をのして強い西風によろける足を踏しめて「此れ干して置いて燃すのさ」と穢い白髮と手拭とを吹かれながら目を蹙めていつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「赤え灰に成つてな、火も弱えのさ、そんでも麁朶買あよりやえゝかんな、松麁朶だちつたつてこつちの方へ來ちや生で卅五｜把だの何だのつて、ちつちえ癖にな、俺らやうな婆でも十｜把位は背負へんだもの、近頃ぢや燃す物が一｜番不自由で仕やうねえのさな」婆さんはいつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺ら川向さ」「そんぢや燃す木は有つ處だね」婆さんは更に勘次の唐鍬を見て「たいした唐鍬だが餘つ程すんだつぺな」「さうさ今打たせちや三十掛は屹度だな」「三十掛ツちや幾らするごつさら、目方もしつかり掛んべな」「一貫目もねえがな」勘次は自慢らしく婆さんへ唐鍬を持たせた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おういや、俺らがにや引つたゝねえやうだ、おめえさん自分で使あのけまあ、何したごつさらよ此んな道具なあ」「毎日木根つ子起してたんだが、唐鍬のひつ痛つちやつたから直し來た處さ」「そんぢやおめえさん燃す物にや不自由なしでえゝな」婆さんは羨まし相にいつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「箆棒、つん燃したくつて、つん燃すもの有るもんか」爺さんは少し激して「過失だもの後で何ちつたつて仕やうあるもんぢやねえ」と獨で力んだ。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "憤怒の情を燃すのには彼は餘に彼れて居た。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、服地をすこし破いて固形アルコールで燃すと、ぐるりがぼんやり分ってきた。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今夜すぐにこの火を燃すのではない。",
              "citation": {
                "source": "影を踏まれた女",
                "author": "――「近代異妖編」",
                "note": "青空文庫"
              }
            },
            {
              "text": "今村鞆君の『朝鮮風俗集』に、正月の一番初めの子の日、農民争うて田野に出で、野原を燃す。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "……爪を燃すと狂ひになつてよ。",
              "citation": {
                "source": "爪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾分お祭り気分的に上ずった、プロレタリア文壇の一部に対する青野季吉の忠告は、勝本氏らによりて簡単に葬り去られたが、この問題も来年度にはきっと再燃するだろう。",
              "citation": {
                "source": "昭和四年の文壇の概観",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本のようについさきごろまで中世的絶対主義が支配していた国、ファシズムに対抗する人民の自主的結集のなかった国柄のところでは、今日、再燃するファシズムとバランス上からも、レフティストの存在は必要である。",
              "citation": {
                "source": "世紀の「分別」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "謹直な教師たちに屈辱感を与えたにちがいないその問題は、しかし、愈物的条件の切迫した来春どんな形で再燃するだろうか。",
              "citation": {
                "source": "女性週評",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――めぐり合せた困難に対して、彼の心は沈潜した火を燃すのであろう。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢で燃す目あての煙はもくもくと立ちあがった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
