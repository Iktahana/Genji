        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（中略）私ノ町ノ知的素養ノイクブンナリトモアル青年デモ、自分トイウモノニツイテ思イヲメグラス人ハ少ナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤガテ　オドロキガ　トマルト、「イマノ　フトイ　コヱハ　ダレデセウ」「キツト　オソロシイ　モノニ　チガヒナイネ」ト　ヒソヒソ　イヒアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ前タチ、デンデンムシノ　ウタ　シラナイカ」ト、オソバノ　モノニ　キイテモ、「シリマセン」ト　イツテ　クビヲ　カシゲテ　ヰマス。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンザシヲ　ジブンノ　モノニ　シタイト　オモヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧富ヲ無視シタル劃一的平等ヲ考フルコトハ誠ニ社會萬能説ニ出發スルモノニシテ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ眞個父兄的愛情ヲ以テ、斯ル短時日間ニ此ノ道義的使命ヲ果タシ、以テ異民族ヲ利得ノ目的トセル白人ノ所謂植民政策ナルモノニ鐵槌一下セザル可カラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米ノ傭兵ト獨逸ノ徴兵トノ優劣ハ實戰ニヨリテ立證セラレタルモノニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ私ハ近ゴロ原稿ヲ書クニモ手紙ヲシタタメルニモヒラガナトイウモノヲ使ツタコトガナイ、ソレハナゼカトイウニ、我々仰臥シタママデモノヲ書クモノニトツテハ些細ナ力ノ消費モ大キナ問題トナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノコトハ子規ノ書イタモノニカタカナ文ガ多イコトヤ、宮沢賢治ノ病中作デアル「雨ニモ負ケズ」ノ詩ガカタカナデアルコトナドデ間接ニ証明サレルガ、ナオソレニツイテイササカインチキナガラ力学的ニ考察シタ文章ヲ他ノ場所ニ発表シタカラココニハ書カナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "）三、ヒラガナトイウモノハソノ素性ヲ探ルト、イズレモ漢字ヲ極端ニ崩シタモノニスギナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ亦ラジオヲ以テ長年ノ趣味トスルモノニシテ、予ガ組立テタル愛機『スーパーヘテロダイン』ヲ携エテ今回｜此途ニノボレリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "マモナクヨコハマジヤツクトイウワルモノニツカマツタ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ、自分の原子ガ別ノモノニナッタトキ、自覚シナイカラツマラナイ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ古銭ハ鑑識頗ル難キモノニテ、古鏡古銅器ヲ観ルノ眼ニテ之ヲ観レバ、必ズ贋品ヲ攫ムニ至ル。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "秦始皇半両銭　此銭ハ天保二年正月八日、三州梅ヶ坪ノ山中ニテ堀出セシモノニテ、径一寸一分、重一銭八分五厘。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "平民自身モマタ奴隷タルベクコノ世ニ生レ出デタルモノニシテ、人格ト権利ヲ没却セラレテモ、之ヲ甘ンジテ屈従スルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "古語に『自ラ求メザルモノニ向ツテハ哀楽ソノ前ニ施スべカラズ』というのがございます、世にこの求めざるの心ほど強いものはございません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ本国いぎりすノ国家ノ強ヒル宗教ヲ信ズルコトヲ肯ンゼザルナリ、制度ハ国ノ制度ヲ遵奉セザル可カラズトイヘドモ、信仰ハ自由也、国家ヨリ賦課セラルベキモノニアラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "石黒氏ノ近業ハソノ名ノ示スガ如ク往昔郷閭ノ私塾ナリシ有隣舎ノ沿革ヲ調査シソレガ師弟ノ伝ヲ述ベタルモノニシテコレスナハチ拙稿『下谷叢話』ノ記述スル所トホボソノ事ヲ同ジクスルモノ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "古墳ノ掃苔ニオケルヤマタ彼ハ専ラ尾陽所在ノモノニノミ精シキコトアタカモ我ノ東都ニ限ラレシニ似タリトイフベシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈故ヲ忘レザルノ最ナルモノニ非ズヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「知ラヌ」ト答エタモノニ鞭打チ（五十回ヨリ二百回）ヲ与エル　鞭ノ種類。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時代ノ人民ハ「ゼウス」神ガとねりこノ木ヨリ造リ出ダセルモノニシテ、青銅ノ家ニ住ヒ、青銅ノ武器ヲ以テ爭鬪シ、青銅ノ農具ヲ以テ耕作セリト云フ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "假令同一人民ニシテ青銅器ト鐵器トヲ用ヰタル事有リトスルモ、鐵器ノ用ハ常ニ青銅器ノ用ニ後ルト定マリタルモノニハアラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "北亞米利加ノ南部ヨリ南亞米利加ノ北部ニ掛ケテ古代開化國ノ存在セシ證跡甚ダ多ク、諸建築諸彫刻ノ外形ノミヲ見ル時ハ殆ト「ヱジプト」ノモノニ亞グガ如キ觀有リ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じく小野蘭山口授の『本草｜訳説』（内題は『本草綱目訳説』）には「恕菴［牧野いう、松岡恕菴］先生秘説（蘭品）ニハ山海経ノ薫草ヲ和ニ麝香草ト称ルモノニ充ツ未的切ナラズ麝香草ハ生ニテ動揺スレバ香気アリ乾セバ香気ナシ漢名麝草（王氏彙宛）」と出ている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……師範學校ノ功用ハ既ニ東京ニ設立セルモノニ於テ、其實驗ヲ表セリ。",
              "citation": {
                "source": "黒板は何処から来たのか",
                "author": "小倉金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレ神号ニヨリテ芋ヲ植シモノニヤ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僂麻質性モシクハ神経痛ノ如キモノニ変化シテイル證拠デアルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「怪我ハナカッタガ、アンナ大キナモノニ飛ビ着カレルト、ヨボ／＼ノ老人ハドウニモナランネ」「オ倒レニナッタノガ芝生ノ上ダッタノデ本当ニヨウゴザイマシタ」予モ浄吉モ元来犬好キノ方ナノデ前ニモ犬ヲ飼ッタコトハアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
