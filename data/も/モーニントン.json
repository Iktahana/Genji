          "literary": [
            {
              "text": "モーニントン・アームズ・ホテルの大理石時計が時を刻んでいる。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "メインはほろ酔い気分で、なんでそんな偉い人物がモーニントンにいるのかといぶかった。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "モーニントン郊外にあった。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌晩、ささやかな夕食をモーニントンで行い、ガンター調教師がみすぼらしい居間に座り、きつい臭いの煙草をくわえ、大コップにジン酒と水を据えていた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
