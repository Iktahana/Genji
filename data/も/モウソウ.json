  {
    "uuid": "f60e01f6-10e0-55a5-add9-755b0018ac2f",
    "entry": "モウソウ",
    "reading": {
      "primary": "もうそう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
