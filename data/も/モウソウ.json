[
  {
    "uuid": "eab1ed0f-17a0-5ef8-84b7-6414b80c6425",
    "entry": "妄想",
    "reading": {
      "primary": "もうそう",
      "alternatives": [
        "ぼうそう"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "delusion",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は自分が世界の支配者だという妄想にとらわれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の言うことは、ただの妄想に過ぎない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "妄想を抱くのは、決して珍しいことではない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "何のことはない妄想家流であつて、ジャズだつてオネガだつてアッターベルヒだつてラヴェルだつてシトラウスだつてマーラーだつて、妄想家流――といつて妥当でなければ幻想家流である。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "何にも聞こえはしませんよ、……お休み、それあおまへの妄想ですよ！",
              "citation": {
                "source": "ヂェラルド・ド・ネルヴァル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの臆測は、蕪村の俳句や長詩に見られる、その超時代的の珍しい新感覚――それは現代の新しい詩の精神にも共通している――を考え、一方にまた近代の浪漫詩人や明治の新体詩人やが、後年に至って象徴的傾向の詩風に入った経過を考える時、少しも誇張の妄想でないことを知るであろう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このような取り止めのない妄想に耽っている間に、老人の淋しい影は何処ともなく消え去った。",
              "citation": {
                "source": "凩",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は頭の中に湧き起つて来る、様々の懸念や妄想を、釣りをする、と云ふ事で追つ払ふ為になるべく人の居ない――たとひ魚は釣れなくとも――処を選んで、来るのが慣はしであつた。",
              "citation": {
                "source": "氷雨",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "主観的な意味を求めてみたが、得たものはただ取り止めの付かぬ妄想に過ぎなかった。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の誇大妄想狂の原因は彼の蒐集した書物にあるから、これを焼き捨てなければいけないというので大勢の役人達が大きな書物をかかえて搬び出す場面がある。",
              "citation": {
                "source": "雑記帳より（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "往々考えが形而上的に走り、罷り違えば誇大妄想狂となんら選む所のないような夢幻的の思索に陥って、いつの間にか科学の領域を逸する虞がある。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "書かせ給ふは何ならん、何事かの御打合せを御朋友の許へか、さらずば御母上に御機嫌うかゞひの御状か、さらずば御胸にうかぶ妄想のすて所、詩か歌か。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり中原君の場合は、強迫觀念や被害妄想の苦痛を忘れようとして酒を飮み、却つて一層病症を惡くしたのだ。",
              "citation": {
                "source": "中原中也君の印象",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戀や結婚と同じやうに、出發の前に荷造りされてる、人生の妄想に充ちた鞄である。",
              "citation": {
                "source": "大船驛で",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人は私の物語を冷笑して、詩人の病的な錯覚であり、愚にもつかない妄想の幻影だと言う。",
              "citation": {
                "source": "猫町",
                "author": "散文詩風な小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "森閑とした浴室、長方形の浴槽、透明つて玉のやうな温泉、これを午後二｜時頃獨占して居ると、くだらない實感からも、夢のやうな妄想からも脱却して了ふ。",
              "citation": {
                "source": "都の友へ、Ｂ生より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまで自分の考えたようないろいろの心配などは畢竟誇大妄想病者の空中に描く幻影のようなものかもしれない。",
              "citation": {
                "source": "神田を散歩して",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが妄想というものでしょうね。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやな妄想がそれだ。",
              "citation": {
                "source": "泥濘",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉親に不吉がありそうな、友達に裏切られているような妄想が不意に頭を擡げる。",
              "citation": {
                "source": "泥濘",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妄想は自分を弱くみじめにした。",
              "citation": {
                "source": "泥濘",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ妄想という怪獣の餌食となりたくないためばかりに、私はここへ逃げ出して来て、少々身体には毒な夜露に打たれるのである。",
              "citation": {
                "source": "交尾",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした心の静けさとかすかな秋の先駆は、彼を部屋の中の書物や妄想にひきとめてはおかなかった。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妄想で自らを卑屈にすることなく、戦うべき相手とこそ戦いたい、そしてその後の調和にこそ安んじたいと願う私の気持をお伝えしたくこの筆をとりました。",
              "citation": {
                "source": "橡の花",
                "author": "――或る私信――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルクレチウスを読みながら私はしばしばこのような妄想に襲われるのである。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "最善の場合において形而上学者であるが最悪の場合には妄想者であり狂者であるかもしれない。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "空想の翼はさらに自分を駆って人間に共通な舞踊のインスティンクトの起原という事までもこの猫の足踏みによって与えられたヒントの光で解釈されそうな妄想に導くのであった。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おぬいさんは渡瀬が今まで妄想していたところよりあまりかけ離れた清いところにいた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も亦奇態な妄想から救はれてゐた。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ瞬間の奇快な妄想ではある。",
              "citation": {
                "source": "實驗室",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうそう時々帰って来るには及ばぬ……とカンカン。",
              "citation": {
                "source": "高知がえり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "学生時代には学期試験とか学年試験とかいうものがやはりそうした峠になっていたが、学校を出ればもうそうしたものはないかと思うと、それどころか、もっともっとけわしい山坂が不規則に意想外に行手に現われて来た。",
              "citation": {
                "source": "初冬の日記から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よし、よし、じゃ、もうそうするでない。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
