    "definitions": [
      {
        "index": 1,
        "gloss": "both bare shoulders",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は興奮して、もろ肌をあらわにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夏の祭りでは、もろ肌姿で神輿を担ぐ男たちの熱気がすごい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "風呂上がりの父は、いつももろ肌のままでくつろいでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "もろ肌ぬぎて、翼を負ひたる、あはれなる小兒等は、高卓の前に立ちて、神の使の歌をうたひて、行列の來るを待てり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さんぴん、よさねえなッ」　ダッと一躍、花道の上へ飛び上がると、パラリぬいだもろ肌いちめん、どくろ首の大｜朱彫り！",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "もろ肌を脱いで石鹸で磨き上げた皮膚がぴかついて黒縮緬の羽織と反映している。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただは、おかんぞっ」「面白れえ」　蟇が、もろ肌を脱いで、守宮のように、玄関へ寝た。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "武蔵は、早速、裏へとびだして、もろ肌をぬぎ出した。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かに、もろ肌をぬぎ、短い刀の鞘を払った。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "石工でも土工でもない、四十がらみの色の黒いさむらいで、炎暑のために、もろ肌をぬぎ、白いさらしの襦袢も、汗と土でうす黒くよごしていた。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……頼むから」　介三郎はもろ肌をぬいで、饅頭山のうえにのぼった。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もろ肌をぬぎ、顔から半裸身まで、流れる汗にうるおされ、その汗までが美しい。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "上着のもろ肌を脱ぎ、下着の袖を片だすきに結んで、多くの門下生を指揮し、いまや屋の下にみちている多くの負傷者を、ひとりひとり手当していた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "じつは病人のはずだからな」　高氏は廊へ出てもろ肌をぬぎ、熱い湯のしぼりで、顔をふき、背を拭わせた。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "そら、野郎ども、手を借しなッ」　言いざまに頭がまずまっさきにもろはだぬぎになりましたから、勇みと侠気と伝法はおよそ江戸鳶の誇りです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "なぞの八卦見",
                "note": "青空文庫"
              }
            },
            {
              "text": "こないだ、だんながこの縁側で、もろはだ脱ぎでいたところを見やしたからね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卍のいれずみ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
