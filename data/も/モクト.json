[
  {
    "uuid": "40fd3f5f-8484-529a-98ef-e6a6a295f00d",
    "entry": "目途",
    "reading": {
      "primary": "もくと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
