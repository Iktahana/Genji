[
  {
    "uuid": "0e25c8fb-6470-5f22-b4a7-811ce5117af2",
    "entry": "もみ消す",
    "reading": {
      "primary": "もみけす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
      ],
      "ctype": "五段-サ行",
      "inflections": null,
