        "examples": {
          "standard": [
            {
              "text": "今日の株式市場は、売買が交錯して一日中持ち合いが続いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "為替相場は先週から大きな動きがなく、持ち合いの状態だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "買い手が様子見姿勢を強め、価格は当面持ち合いとなるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
