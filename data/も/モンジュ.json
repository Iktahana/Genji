[
  {
    "uuid": "eba652de-cba1-5ebf-93f7-587c8d7faed2",
    "entry": "文殊",
    "reading": {
      "primary": "もんじゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "Manjushri",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "文殊菩薩は知恵の仏様として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は学業成就を願って文殊に祈った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "京都には文殊を祀るお寺がいくつかある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "文殊菩薩がある日、善財童子（文殊は智慧の象徴、善財は求道者、両者とも、華厳経中の人物です）に向って、「おまえ、これから世界中を探してみて、もし、薬にならないような草が在ったら持って来い」。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで手持ち無沙汰で帰って来て、文殊にその報告をしたという寓話が「五燈会元」という本に載っております。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方がないので釈尊は文殊菩薩というのを呼び出して、これに使者を命じます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この文殊菩薩というのは実在の人物ではありません。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "智慧の権化である文殊菩薩は、さすがに自信があるものかこれを引受けて出かけます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "智慧の横綱文殊と体験の横綱維摩との立合い問答、これこそ見もの聞きものだというので十大弟子はじめ大勢、文殊について行きます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "文殊と維摩と会いまして病気見舞に事寄せいろいろ人世に対する考え方、生活態度についての問答があります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにおいて文殊師利、維摩詰に問う。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "文殊師利嘆じて曰く善哉善哉。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで文殊は感心して「善き哉」と讃めたのであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "維摩は経の中の問疾品において、文殊の問いに答えて、衆生病む、故にわれ病む。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "釈迦如来を本尊とする仏像の脇士は、左に文殊菩薩、右に普賢菩薩であります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これにはいろいろの意味がありますが、もし文殊が平等を現す場合には、普賢は差別を現すことになっております。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "平等の文殊と、差別の普賢を脇士に控えた中道真理の釈迦如来の仏像。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "釈迦、文殊、普賢、勢至、観音、皆、名があるではありませんか。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "釈迦、文殊、普賢、勢至、観音、御像はありがたい訳ではありませんか。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "最も窮したのは、寒山が文殊で、拾得は普賢だと云つたために、文殊だの普賢だのの事を問はれ、それをどうかかうか答へると、又その文殊が寒山で、普賢が拾得だと云ふのがわからぬと云はれた時である。",
              "citation": {
                "source": "寒山拾得縁起",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供には昔の寒山が文殊であつたのがわからぬと同じく、今の宮崎さんがメツシアスであるのがわからなかつた。",
              "citation": {
                "source": "寒山拾得縁起",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「實はパパアも文殊なのだが、まだ誰も拜みに來ないのだよ。",
              "citation": {
                "source": "寒山拾得縁起",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "最も窮したのは、寒山が文殊で拾得は普賢だと言ったために、文殊だの普賢だののことを問われ、それをどうかこうか答えるとまたその文殊が寒山で、普賢が拾得だというのがわからぬと言われたときである。",
              "citation": {
                "source": "寒山拾得縁起",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供には昔の寒山が文殊であったのがわからぬと同じく、今の宮崎さんがメッシアスであるのがわからなかった。",
              "citation": {
                "source": "寒山拾得縁起",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「実はパパアも文殊なのだが、まだ誰も拝みに来ないのだよ」大正五年一月",
              "citation": {
                "source": "寒山拾得縁起",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "實は文殊でございます。",
              "citation": {
                "source": "寒山拾得",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "心の中では、そんな事をしてゐる寒山、拾得が文殊、普賢なら、虎に騎つた豐干はなんだらうなどと、田舍者が芝居を見て、どの役がどの俳優かと思ひ惑ふ時のやうな氣分になつてゐるのである。",
              "citation": {
                "source": "寒山拾得",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
