          "literary": [
            {
              "text": "モモダチをとって木刀を握って立つと人相がキリリと一変してひきしまる。",
              "citation": {
                "source": "馬庭念流のこと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "面小手も昔のままの珍妙なもので、袴も普通の袴をつけ一々モモダチをとってから木刀を構える。",
              "citation": {
                "source": "安吾武者修業",
                "author": "馬庭念流訪問記",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし老翁は例の残心の心得によってまだ目の玉を光らせ、相手を睨みつけながらモモダチを下して自分の席へもどる。",
              "citation": {
                "source": "安吾武者修業",
                "author": "馬庭念流訪問記",
                "note": "青空文庫"
              }
            },
            {
              "text": "山高帽をかむり、袴を着けてゐるが、どう云ふつもりか、袴の両モモダチを上げてゐる。",
              "citation": {
                "source": "妻恋行",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
