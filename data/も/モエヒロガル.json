[
  {
    "uuid": "29d2530c-2ba0-51fb-9684-d8c7fc078f91",
    "entry": "燃え広がる",
    "reading": {
      "primary": "もえひろがる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-自動詞"
      ],
      "ctype": "五段-ラ行",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to spread (of flames)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "乾燥した森の中で、一度火がつくとあっという間に燃え広がってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その噂は瞬く間に街中に燃え広がり、多くの人々の不安を煽った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "小さなストーブの火が、カーテンに引火して壁一面に燃え広がる恐れがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "また「もぐさ」を平たく板の上にはりつけておいて、その一点に点火すると、炎を上げない火が徐々に燃え広がる。",
              "citation": {
                "source": "自然界の縞模様",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "火が鉄の大皿の上に燃え広がる。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれは、「一隅を照らす」灯のように、点々と次々に燃え広がるやさしい、そして、美しい燎原の火ともなるのである。",
              "citation": {
                "source": "図書館法の成立",
                "author": "――燃えひろがる火は点ぜられた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンプ、バケツ、水槽、元気な人間、消火に必要なものは一瞬になくなっているのだから、ただ火の燃え広がるのに任せるばかり。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ちにそれからそれへと燃えひろがる始末。",
              "citation": {
                "source": "半七捕物帳",
                "author": "熊の死骸",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅人はますますあわてて、木の枝を折って来て叩き消そうとしたが、火はますます燃えひろがるばかりで、手のつけようがなかった。",
              "citation": {
                "source": "火傷した神様",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤ／＼と思ふうちに、咲きも咲いたり、まつたく其処の土堤を埋めて燃えひろがる様に咲いて行つた。",
              "citation": {
                "source": "村住居の秋",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると焼夷弾がクラクラに燃えさかり、はげしい火の子を吹きだそうと、その火の子の落ちたところが濡れていれば、あたりに燃えひろがる心配はなかったのだ。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく水をかけていたが、消える面積よりは燃えひろがるほうが速い。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "図書館法の成立――燃えひろがる火は点ぜられた――中井正一　あの戦争のさ中、或る兵器を造っている人が次のような面白いことをいった。",
              "citation": {
                "source": "図書館法の成立",
                "author": "――燃えひろがる火は点ぜられた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一隅を照らす光のように、一つの火が他の火に呼びかけるように、次々に燃えひろがる火でなくてはならない。",
              "citation": {
                "source": "図書館法の成立",
                "author": "――燃えひろがる火は点ぜられた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つの小さな小さな火が、一つの小さな火に燃えうつり、点々として燃えひろがる火でなくてはならない。",
              "citation": {
                "source": "図書館法の成立",
                "author": "――燃えひろがる火は点ぜられた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "三時間足らずのうちに、燃えひろがる導火線のように、暴徒は各所を襲って占領した。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこまで燃えひろがるか解らない。",
              "citation": {
                "source": "地異印象記",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "野火は燃えひろがるばかりで賊徒らの住む尺地も余さなかった。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、瓦口関の背後、八方から火の手があがり、たちまち燃えひろがる様子。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "燃えひろがる早さも、焼け焦げ独特のジワジワした感じであるが、それが千倍万倍の速さになって、顔面の皮膚を這いひろがるのだ。",
              "citation": {
                "source": "暗黒星",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしうかうかしていると、色々な妙な思想がフィルムの形になって外国から続々入り込んで全国に燃え拡がるのは事実である。",
              "citation": {
                "source": "教育映画について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "火が愈々燃え拡がる許りだ。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　火事が見る見る燃え拡がる。",
              "citation": {
                "source": "前記天満焼",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は命のお指図で、二人ばかりの従者にまもられて、とある丘の頂辺に避けて、命の御身の上を案じわびて居りましたが、その中四｜方から急にめらめらと燃え拡がる野火、やがて見渡す限りはただ一｜面の火の海となって了いました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "類焼は五軒ばかりで熄んだが、風のひどかったせいか、火の燃え拡がる速力は不思議な程早かった。",
              "citation": {
                "source": "恐ろしき錯誤",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
