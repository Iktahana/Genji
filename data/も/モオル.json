        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マルスリーヌ・デボルド―※ルモオルは千七百八十六年七月の二十日にドゥエ（Douai）に生れ、千八百五十九年七月二十三日巴里で死んだ。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "加ふるに黄熱病が猖獗を極めてゐて、ルモオルは船から船に移されて漸くのことで例の親戚の手に渡されたのだが、その親戚は貧乏になりはてちまつてゐたといふわけだ。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "恰度まあいい具合にその時劇場から話があつて、※ルモオルは早速歌ふことを学んだ。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しルモオルと結婚した。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "※ルモオルは却々しつかりした男で、彼女はその妻として実に申し分のない妻だつた。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "※ルモオル夫人の詩業は身を切るやうな感受性の叫びや呻吟である。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "自らその門弟と称したルモオルに於てであつたと告白してゐる。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでその旦那様というのはしかるべきお侍、もうその頃は金モオルの軍人というのじゃ。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "醜き龍に騎りたる、美しきアモオルの神を据ゑたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "その戀の神なるアモオルをこそ、むかしおん身は見つるならめ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "新築の家はすっかり出来あがって、硝子もはまった飾窓に、小野田が柳原から見つけて買って来た古い大礼服の金モオルなどが光っていた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "オデュッセイアと、ルクレティウスと、毛詩｜鄭箋と、それさえ消化しかねるほどの・文字通りの「スモオル・ラティン・アンド・レス・グリイク」と、それだけで生活は足りると思っていた俺は、何という人間知らずだったことであろう！",
              "citation": {
                "source": "狼疾記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大マルズック星（木星）が天界の牧羊者（オリオン）の境を犯せば神々の怒が降るのも、月輪の上部に蝕が現れればフモオル人が禍を蒙るのも、皆、古書に文字として誌されてあればこそじゃ。",
              "citation": {
                "source": "文字禍",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "モオルトンが唱ふる如く、科學的なるべし。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "モオルトンはげに新なるべし。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "モオル廻廊の古院、黒衣僧兵のかばね、天日、石だたみを照らして、紅流に烟たち、朧々たる低き戸の框に、立つや老僧。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "噫けふもなほ俤にして浮びこそすれ、モオル※廊の古院、黒衣僧兵のかばね、天日、石だゝみを照らして、紅流に烟たち、朧々たる低き戸の框に、立つや老僧。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "新公が、――尤も今の新公の体は、駝鳥の羽根の前立だの、厳めしい金モオルの飾緒だの、大小幾つかの勲章だの、いろいろの名誉の標章に埋まつてゐるやうなものだつた。",
              "citation": {
                "source": "お富の貞操",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それは兎も角もモオルと聞えたのに違ひなかつた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしモオルと云ふ言葉だけは妙に気になつてならなかつた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モオル――Mole……」　モオルは※鼠と云ふ英語だつた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラ・モオルは、――死と云ふ仏蘭西語は忽ち僕を不安にした。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それはともかくもモオルと聞えたのに違いなかった。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしモオルと云う言葉だけは妙に気になってならなかった。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モオル――Mole……」　モオルは※鼠と云う英語だった。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
