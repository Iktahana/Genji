[
  {
    "uuid": "d8cb1b94-387b-5799-91f9-eab7aed5885d",
    "entry": "若し",
    "reading": {
      "primary": "もし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
