    "definitions": [
      {
        "index": 1,
        "gloss": "to burn out",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "隕石は大気圏に突入する際の摩擦熱で、地上に届く前に燃え尽きることが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "真っ白な灰になるまで燃え尽きた薪を見て、楽しかったキャンプの終わりを感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "全力を出し切り、試合が終わる頃には心身ともに燃え尽きていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "燃えはじめてから燃え尽きるまで、実に永い時間がかかるものだ。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はちょっと手で摘まみたくなったほど、それは燃え尽きる最後の透明な焔の美しさだったが、見るまにそれも素の入った白骨に変っていった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "卑狗の大兄の幻が彼女の眼から消えてゆくと、彼女は涙に濡れながら、再び燃え尽きる榾柮の上へ新らしく枯枝を盛り上げた。",
              "citation": {
                "source": "日輪",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「無論手燭を下において扉を開けたのだろうが、それには、蝋燭が燃え尽きるまでの時間がない。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "百目蝋燭の燃え尽きるには、まだまだ十分の余裕があるのに、焔がにわかに今にも消えそうに呼吸づきながら痩せたからである。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや二分で、燃え尽きるだろう」「えッ！",
              "citation": {
                "source": "怪奇人造島",
                "author": "寺島柾史",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時はひとり悄然として離れて、その炎の燃えて、燃えて、燃え尽きる時を待つの態度に出づるほかはありませんでした。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈愛されることは燃え尽きることだ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "石油はただそれがある間はそれ自身だけ燃えて、燃え尽きると、あれほど大きかつた炎の塊は幾つかの小さなそれに分れ分れになつて、それの一つ一つは薪の上つらを這つて伝ひながら、青く小さな炎がちらちらとそこを舐めてしまつたかと思ふと、もう消えて居た。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかといって、今大急ぎで養子を迎えることもならず、生命の灯が次第に燃え尽きるのがわかると、勘当した倅が、つくづく恋しくなったのも無理のないことでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "朱塗の筐",
                "note": "青空文庫"
              }
            },
            {
              "text": "別の者ども、救済し得ぬほど道徳的に汚濁した者どもは、下へ下へと潮流をひたすら降り、最後には燃え尽きる。",
              "citation": {
                "source": "夢日記",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "燃え尽きると、すぐあとの附木へまた火を移して、そこらを照らして見ますに、やはり金吾の察しにたがわず、そこは何処の城にも必ずあるべきはずの間道で、殊に、開鑿者の名とおぼしく、岩壁面の一端に、こういう文字が彫られてあるのを見出しました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "心の焔は、火あぶりのたきぎのなかで、もえつきるものでしょうか。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは気づかぬうちに、ジョンが燃えつきる瞬間に立ち会っている、といってもいいくらいだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "確かに重大な、人間の霊肉を根本から震盪するものではあっても、人間の裡にある生活力は多くの場合その恋愛のために燃えつきるようなことはなく、却って酵母としてそれを暖め反芻し、個人の生活全般を豊富にする養液にしてしまいます。",
              "citation": {
                "source": "愛は神秘な修道場",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いのち懸けの恋――燃えつきる恋――万人の女が、夢みながら、思い切ってそこまでは誰もつきつめぬ恋――親も、家も、わが身もすべて捧げた恋――恥かしい恋――苦しい恋――わたしの恋は、蹂み躪られてしまった！",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分のしんが燃えつきるとそれで歴史のともしびも燃えきったように思うおろかしさ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "燃えつきるものではなく、底から何かを生産させる力だ。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "俵が燃えつきると、枯枝を、こんどは少しずつくべた。",
              "citation": {
                "source": "塩花",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして精神が燃えつきるような工合に、突然、静かに死んでいった。",
              "citation": {
                "source": "非情の愛",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの音楽会の晩は、云わば燃えつきる蝋燭の最後の焔みたいなものでした。",
              "citation": {
                "source": "野ざらし",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのことの直中に燃え、燃えつきるということだ。",
              "citation": {
                "source": "ゴッホについて",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリストフは燭台の底に蝋燭の燃えつきるのを、呆然としてながめていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい各時代は、十年足らずのうちに燃えつきるにもかかわらず、自分だけが絶頂に達したものだと同じ意気込みで信じていて、石を投じては先人を打倒していた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "他のいかなるものよりもいっそう早く音楽上の言葉は燃えつきる。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "石油が燃えつきるとともに火の手はみるみる衰えたが、彼れのテーブルも書物もずぶ濡れになってしまった。",
              "citation": {
                "source": "入江のほとり",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊那丸をはじめ、忍剣も龍太郎も、また竹童も、ひとしく松明の燃えつきるのを忘れて、岩上の文字をみつめ予言の意味をときなやんでしまった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
