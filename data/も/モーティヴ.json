        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "先に云った理由によって子爵が行おうとする殺人のモーティヴは決して暴露する危険はない。",
              "citation": {
                "source": "彼は誰を殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不安が真面目にさせる根柢のモーティヴであったと思う。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり体のため、というようなことからだけではモーティヴが強いようで強くない。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはそれだけとして見れば最善のモーティヴによる生命力の発揮の場合やはりそうであるから、深い感想をさそい、一片の感傷ならぬ永い哀れを感じさせました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分でもこの間迄はっきり心持のモーティヴ、知らなかったのですもの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クニッペルに書かれたいろいろ日常茶飯のこと、チェホフが愛情の濃やかさから書いたそれらの日常茶飯の描写に、我々は彼の短篇の種々なモーティヴの潜在を感じる。",
              "citation": {
                "source": "シナーニ書店のベンチ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その番号の周囲に、アメリカン・ロコモーティヴ・カンパニー１９２８と、小さな文字が読めた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
