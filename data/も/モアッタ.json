          "literary": [
            {
              "text": "入レナイドコロカ、机ノ上ニデモアッタカ、ナイフヲイツノ間ニカ抜イテ、蒼白ニナッテフルエナガラ、突然私ニ斬リツケタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ択バレタル霊魂ノ持主ハ、不運デモアッタガ、又、捉エラレルニ適シタホドノ脆弱性ト不安定トヲ持ッテイタ気ノ毒ナ人デアッタ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ外、所々ニテノ喧嘩、幾度モアッタガ、タイガイ忘レタ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "何デモ冬ノ寒イ日デ、羽左衛門ハ熱ガ四十度近クモアッタニ拘ラズ、ブルブル震エナガラ水入リヲシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バレリーナナンテ、足ノコトヲ考エルト見ラレタモンジャナイワ」「レペシンスカヤモソンナ足ヲシテルノカネ」「勿論ヨ、アタシダッテ練習中ハ靴カラタラ／＼血ヲ出シタコトガ何度モアッタワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前立腺肥大ノ手術ハ七十五六歳マデハ可能デアルカラ、思イ切ッテシテオ貰イナサイ、手術シタ後ノ快感ハ何トモ云エナイ、若イ時ノヨウニ尿ガシャー／＼ト音ヲ立テヽ走ッテ出マス、モウ一度青春時代ニ戻ッタ気ガシマスト、ソウ云ッテクレタ人モアッタガ、困難デ不愉快ナ手術ダカラオ止シナサイト云ウ人モアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔ノ化粧ノ方法モ昔ハ甚シク違ッテモイタシ、簡単デモアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピラビタール、イルガピリン、又シテモパロチン、イルガピリン座薬、ドリデン、プロバリン、ノクターン等々、服用シタ様々ノ薬ノ名ヲ佐々木ニ教エテ貰ッタガ、マダコノ外ニモアッタカ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ明日ノコトヲ考エルト、イッソ今直グヤリ直シテ貰ッテ伸ルカ反ルカヲ一挙ニ決シテシマイタクモアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャン、御免ナサイネ、黙ッテ帰ッテ来チマッテ」「誰カト約束デモアッタノカネ」「ソウジャナイノヨ、正直ヲ云ウト、昨日一日オ爺チャンノ相手ヲサセラレタンデ、スッカリ参ッチマッタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ彼女ヲ酔イツブシテ寝カシテシマオウトイウ底意モアッタガ、ドウシテ彼女ハソノ手ニハ乗ラナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "●オタケサン――●ボウヤ――●ア、ココニモアッタワヨ――●ア、アソコニモオチテイルワヨ――●オバサン――●ソオネ――●ワタシオコルワヨ――●ワタシオトナシクマッテ（ナッテ？",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
