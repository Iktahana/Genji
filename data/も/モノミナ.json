        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこで詩人が歌うように、若き日には物皆悲しく、生きることそれ自体が、既に耐えがたい苦悩なのである。",
              "citation": {
                "source": "老年と人生",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一切の物皆然る以上は、人々豈獨り能く理範數疇を脱せんやである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "無機物有機物皆然るので有る。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬は冷ゆるの意で、其の語は直に物皆凝凍收縮の象をあらはして居る。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋の語は明らかなること、空疎清朗なることを語つてゐるので、林空しく天明らかに、氣象清澄の状と、物皆歸するところへ歸せんとするの勢とを示して居るのである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "物皆時あり、至醜のものと雖も小美の時無くばあらず。",
              "citation": {
                "source": "東西伊呂波短歌評釈",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "無機物有機物皆そうなのである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋の語は明らかなこと、空疎清朗なことを語っているので、林｜空しく天明らかに気象｜清澄の状態と、物皆帰するところへ帰ろうとする勢を示しているのである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハテどうしたものだろう」　物皆終あれば古筵も鳶にはなりけり。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "その癖発陽性が著しくなり、見る物聞く物皆面白い。",
              "citation": {
                "source": "殺人行者",
                "author": "村山槐多",
                "note": "青空文庫"
              }
            },
            {
              "text": "で蕭然たるうちに物皆｜萠ゆる生氣は地殼に鬱勃としてゐる。",
              "citation": {
                "source": "解剖室",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、無一物皆無であったにしても、どういう素姓の者かまずそれに眼をつけるのが第一です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本でも釈迦死んで諸動物皆来り悲しみしに、蚯蚓だけは失敬した故罰として足なしにされたというが、紀州には蛇の足に関する昔話あり、西牟婁郡水上てふ山村で聞いたは、トチワビキてふ蛙、昔日本になかったが、トチワの国より蛇に乗って渡り来る。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "セマン人いわく、太古夫婦あれど子を生む事を知らず、他の諸動物皆子あるに我独りなしと恥じ入り、薪を拘えて子を持ったごとく見せかけた。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "然り、俳諧の尤も熟したるもこの時代にて、戯曲の行はれしも、戯作の出でしも、実に此時代にして、而して此等の物皆な平民社界の心骨より出でたるものなることを知らば、余は寧ろ我邦の如き貴族的制度の国に於て、平民社界の初声としては彼等を厚遇するの至当なるを認むるなり。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはれ、この至妙の調和より、万物皆な或一種の声を放ちつゝあるにあらずや。",
              "citation": {
                "source": "万物の声と詩人",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "万ろづの事皆な空にして、法のみ独り実なり、法のみ独り実にして、法に遵ふところの万物皆な実なるを得べし。",
              "citation": {
                "source": "万物の声と詩人",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時は静の屋に隠れていて、静かに見れば物皆自得すと言った古人の言葉を味わおうと思い、ある時は平田篤胤没後の門人がこんなことでいいのかと考え、まだ革新が足りないのだ、破壊も足りないのだと考えるのも、その同じ彼だ。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "物皆が望のかなつたのを謳歌してゐるやうだ。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "自己の性質に従うて働くのが自由であるというならば、万物皆自己の性質に従って働かぬ者はない、水の流れるのも火の燃えるのも皆自己の性質に従うのである。",
              "citation": {
                "source": "善の研究",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（物皆こゝに處を得ず。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "船が進むに従って、群がり飛んでいた水鳥が、ムラムラと船首へ群がって来てまた雪のようにパッと散るのが、物皆な静かな風景の中で唯一つ動くものの姿と云えよう。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が更けて来るにつれて往来の人も杜絶えて、万物皆凍りついたかと思われるようだった。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処に肥大な体の、髪も髭も銀を染めたロダン翁が立迎へて、鼻眼鏡を掛けた目と色艶のよい盛高な二つの頬とに物皆を赤子の様に愛する偉人の微笑を湛へ乍ら、最初に晶子の手を握つて「おお夫人」と言はれた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうもうさんくさし、夕雨降って荷物皆タタキへ入れる。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦惱わたしの心｜惡鬼のやうに物皆かなぐり棄てて髮振り亂し、この人生に立ち迎へ、おお！",
              "citation": {
                "source": "展望",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "別段我が家の海嘯に襲はれし事あるにもあらず、その折家に在りしは予一人なれば登場の人物皆わが構へしところにして所謂もでるを有せざるなり。",
              "citation": {
                "source": "貝殼追放",
                "author": "「その春の頃」の序",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラリと晴れた青空の下に物皆が動いている町へ出ると蘇生ったように胸が躍って全身の血が勢いよく廻る。",
              "citation": {
                "source": "山の手の子",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
