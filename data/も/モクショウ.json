[
  {
    "uuid": "82ecd5da-5ef4-57d9-90ef-b2164cf77462",
    "entry": "木匠",
    "reading": {
      "primary": "もくしょう",
      "alternatives": [
        "ぼくしょう"
      ],
      "is_heteronym": false
    },
    "grammar": {
