        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さういつた関係から、双方無口であり極度の含羞やでありながら、何か黙照し合ふものがあるつもりで頼母しく思つてゐた。",
              "citation": {
                "source": "過去世",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――終日黙照、私の場合では句作三昧。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "門外不出、黙々黙照。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            }
          ]
