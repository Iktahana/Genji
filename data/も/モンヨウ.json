        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この器の表面には、美しい花鳥風月の文様が描かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "日本の伝統工芸品には、それぞれ意味を持つ文様が使われることが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は、着物の文様を選ぶのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "されば自然派の文学論は、それの散文様式の底に於て常にクラシズム――形式のないクラシズム――を精神していた。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろの蛇、殊に台湾の紅、藍、色あざやかなのを雑ぜて気味わるく美しい文様を作らうと思つたが、写生が無くては思ふやうに行かないから断めた。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蔦が伸びていったような文様も、絵師の手仕事です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "せっかく新しく工夫した印刷術を使いながら、イニシャルや文様を手仕事に委ねたのでは、量産というメリットが生かし切れないではないか。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "文様などなしですませてしまえば、それだけ本の製造コストを下げられるはずです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "イニシャルや文様の書き込みにも、確かに念の入った仕事が施してあります。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "本文の手写に専念する工房がある中で、イニシャルや朱書きに特化したところが生まれ、文様や装飾画にはまた、別の工房が専門にあたるといった分業化が進んでいきました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "装丁を簡素化する傾向が広まり、手書きの文様も次第に書き込みの度合いを薄めていきました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "装飾的なイニシャルや文様のかもし出す手写本の工芸的な美しさに、中世の読書人たちは深い愛着を覚えていたでしょう。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「之はアラビヤ文様だ……」「先生はそんな事迄知って居るのですか。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ですが、之には支那文様の趣きがないとは云えませんね。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨の壺に刻まれたアラビヤ文様の幻影であるか？",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭上の剃痕は断続してゐて、残す所の毛が文様をなし、三条の線と蝙蝠の形とが明に認められたからである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は染織文様のみちに明くいられるので現存の繍帳断裂の生地や繍糸についての考察にはとりわけ詳しいお話があった。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "繍のうえでは、写実を象徴に高めたところに至上のものが生まれる、とは師匠の言葉で、その象徴も極致に達すると気韻微妙な文様としての和をみせる、「天寿国繍帳」はこの極みに達していると語られる。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "追記　「曼荼羅繍帳」については主として明石染人氏著「染織文様史の研究」を参考とした。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はしばしばでたらめな文様を施した手製の縁をみたことがあるが、それは非常に嫌味なもので落着かぬものだと思った。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "その室は、雷文様の浮彫にモスク風を加味した｜面取作りで、三つ並びの角張った稜が、壁から天井まで並行な襞をなし、その多くの襞が格子を組んでいる天井の中央からは、十三燭形の古風な装飾灯が下っていた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代狩猟の景観は、銀壺の文様に制約されて、いささか窮屈な憾みなしとしない。",
              "citation": {
                "source": "「草野心平詩集」解説",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "白地に文様のある紙で壁を張り、やはり白地に文様のある布で家具が包んである。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "『お文様』のやうぢやないか？",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "『お文様』のようじゃないか？",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "返辞せんか」「わて優等みたいなもんようならん。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬼ごとするもんようって来い！",
              "citation": {
                "source": "大根の葉",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「へえ、―――蕗のとうがたべたいお云やすけど、京都では市場へ行たかておへん、だあれもあの苦いもんようたべる人おへんよって」「東京だってみんながみんな食べる訳じゃあありませんがね。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
