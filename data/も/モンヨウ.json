    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それが不思議なことには死んだボーヤの小さい時とほとんどそっくりでただ尻尾が長くてその尻尾に雉毛の紋様があるだけの相違である。",
              "citation": {
                "source": "ある探偵事件",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "暁の微光が窓｜硝子を通してシャンデリヤの光とたがい違いの紋様を湯の波に燦めかせる。",
              "citation": {
                "source": "健康三題",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "丹泉はしきりに称讃してその鼎をためつすがめつ熟視し、手をもって大さを度ったり、ふところ紙に鼎の紋様を模したりして、こういう奇品に面した眼福を喜び謝したりして帰った。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "丹泉はしきりに称讃して其鼎をためつすがめつ熟視し、手をもつて大さを度つたり、ふところ紙に鼎の紋様を模したりして、斯様いふ奇品に面した眼福を喜び謝したりして帰つた。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、凡人の凡眼は和氏璧（宝石）『韓非子（和氏篇十三）』を石とし、赤地に白い紋様が入った美しい石（）を宝石（玉）とすることも、当然のこと自然と多いことであろう。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな中で統計技官のヘルマン・ホレリスは、紋様の織り込みを自動化したジャカード織機と自動ピアノから、統計表作りの革新のヒントを得る。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "まともに風の吹払った庭の右手には、砂目の紋様が面白く、塵一つなくきれいだ。",
              "citation": {
                "source": "新万葉物語",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "地上を探して見るが何の紋様もない、土器の破片の外何も落ちて居ない。",
              "citation": {
                "source": "殺人行者",
                "author": "村山槐多",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには推古時代の物と推定し得る紋様がある。",
              "citation": {
                "source": "殺人行者",
                "author": "村山槐多",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて愛の本能に従って、私は他を私の中に同化し、他に愛せらるることによって、私は他の中に投入し、私と他とは巻絹の経緯の如く、そこにおのずから美しい生活の紋様を織りなして行くのだ。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "師僧｜般陀羅の遺示により、はるばるインドから唐土に渡って、河南のほとり崇山に庵室をいとなみながら、よく面壁九年の座禅修業を行ないつづけたと伝えられている、あの達磨禅師をかたどった紋様です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "達磨を好く遊女",
                "note": "青空文庫"
              }
            },
            {
              "text": "竜の紋様を施した、古い石の階段を上って、上級生達は三造を、その崇政殿の後に連れて行った。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし不思議と云うのは、両側の顳※に現われている、紋様状の切り創だった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云うのは、二人とも、双方の足首に上図のような紋様が描かれ、それは――あるいは捺されたと云ったほうが、適切であるかもしれない。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、その創痕と云うのが、皮膚の外部から作った傷ではなくて、斑紋様に、内部から浮き上っているものなのです。",
              "citation": {
                "source": "夢殿殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の運命が、掌中の紋様に現われるなど云うことは考えられないことであるが、しかし人間の身体についているものだけに、まだ易などよりは、信じられる。",
              "citation": {
                "source": "易と手相",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹の細い梢など、あわれにも吹き千切られて、投槍のように飛び、樹の葉はクルクルと、不吉な紋様をえがきながら、舞い上り舞い落ちた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "光背の紋様、絡頸の星章なんど正しく聖母マリアの像なり。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩の亀裂が紋様を織り、悪鬼、菩薩、少年の姿をあらわしているような場所もあった。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナーニ大丈夫だよ、鷺衆なんか」嘲笑うように云ったのは、頭領と覚しい例の美人、「島津の烏組に歯が立つものか」「それはそうともお紋様」こう云ったのは左側の一人、「でも鷺衆のお絹という女は、手利きだということでございますね」「そうさ、妾とはいい相手さ。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはいろいろの紋様を平面の板に彫るので工字紋、麻の葉、七宝、雷紋のような模様を割り出して彫って行く。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "彫刻修行のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯にでもするのだろうか、地紋様の美しい布を買っている日本人もあった。",
              "citation": {
                "source": "余齢初旅",
                "author": "――中支遊記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は沢山必要でないが、とてもいい紋様の布地があったのでそれを五、六寸きって売ってくれと言ったところが、売場の支那人が切るのは困ると言ってどうしても売ってくれない。",
              "citation": {
                "source": "余齢初旅",
                "author": "――中支遊記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "龍や花紋様が刺繍で色美しく入れてあってなかなか美術的なものである。",
              "citation": {
                "source": "余齢初旅",
                "author": "――中支遊記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は言葉を持たないが、その羽ばたきの紋様によって、互に話をし合ってるのではあるまいか。",
              "citation": {
                "source": "好人物",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "霜が窓ガラス一面に紋様をえがいて、そとの景色はほとんどちらりとも見えなかった。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが済むと次は同じく欄間で鉄線蓮唐草の図（鉄線蓮はよく人家にある蔓草で、これも紋様などにして旧くから使われているもので、大変趣のあるもの、葉は三葉で一葉を為し、春分旧根から芽を出し、夏になって一茎に一花を開く。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "皇居御造営の事、鏡縁、欄間を彫ったはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "この手相は掌中の紋様を鑑定するので、わが手筋占いと大同小異である。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "僧等は幾｜襲の美しき衣を脱がせて、姫を柩の上に臥させまつり、下に白き希を覆ひ、上に又｜髑髏の文樣ある黒き布を重ねたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "器の姿は時代を語り、器の質は生産地を語り、裝飾された文樣は時代の文化を語る――ひつくるめていへば一個の器は過去の文化、交通、民族的交渉――あらゆる方面を考察することの出來る史的標本となる。",
              "citation": {
                "source": "やきもの讀本",
                "author": "小野賢一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
