  {
    "uuid": "92ee2645-2bb6-579f-9b84-e5bad097d71f",
    "entry": "紋様",
    "reading": {
      "primary": "もんよう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
