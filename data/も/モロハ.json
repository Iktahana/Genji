[
  {
    "uuid": "673b19b8-e3cc-5e6b-bbdb-4d55097df56e",
    "entry": "諸刃",
    "reading": {
      "primary": "もろは",
      "alternatives": [
        "りょうば"
      ],
      "is_heteronym": true
    },
    "grammar": {
