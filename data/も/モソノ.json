        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "然レドモソノ書ニツイテ窺フニ氏ハ尾張ノ人ニシテ久シク郷党ノ師ト仰ガルル篤学ノ士ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモソノ考証｜研覈ノ如何ニ至ツテハ彼ノ最詳確ニシテ我ノ甚シク杜撰ナルヤ固ヨリ日ヲ同ジクシテ語ルベキニ非ラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモソノ取ツテ以テ今日ニ用フベキ者ヲ求ムレバ僅僅ノミ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽ降誕ト訃来ト五十四年ヲ隔ツトイヘドモソノ地｜相距ルコト百歩ニ過ギズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモソノ幽囚ニアルヲ知ラザル也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "可ナリ激シクテモソノタメニ寝ラレナイト云ウコトハメッタニナイノニ、昨夜ハ夜中ニ眼ガ覚メ、耐エ難イノデ佐々木ヲ起シ、ノブロンヲ注射シテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽエイケマセン、二十八日ニ決メテ下サイ、アタシモソノ日ハツイテ行キマス」「婆サンナンゾ来ナイデモイヽ」「イヽエ参リマス」「ソウシテ戴キマシタ方ガ、私モ安心デゴザイマス」ト、佐々木マデガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハアルイハ事実デハナク、僕ノ単ナル妄想デアルカモ知レナイガ、デモソノ妄想ヲ僕ハ無理ニモ信ジタカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ重ナリ工合ヤ歪ミ工合ハゴク僅カデ、動作ニ不便ヲ感ズルホドノコトハナク、人ニ気付カレルコトモナイノデ、今日マデソノママニシテイルガ、アノ日カラズット、今モソノ状態ガツヅイテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ノ方カラモソノハ、髪ガ解ケテ乱レテイテ襦袢ノ襟ガヒドク濡レテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏子ガ「大阪ヨ」ト素ッ破抜イタ時、僕ハ鳩尾ノ辺ガピクント凹ンダヨウナ気ガシタガ、イツマデモソノ感ジガ続イテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………考エマイトシテモソノ家ノ様子、室内ノ空気、二人ノ寝テイル恰好マデガ浮カンデ来テ仕方ガナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今、師ヲ挙ゲテ遠征シ転運万里、全功ヲ収メント欲シ、呉｜起ツトイエドモソノ規ヲ定ムルコト能ワザラン。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
