    "definitions": [
      {
        "index": 1,
        "gloss": "cowardice",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は大勢の聴衆を前にしても物怖じせず、堂々とスピーチを披露した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "初めての海外旅行だったが、彼女は物怖じせずに現地の人に道を聞いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「そんなに物怖じしなくていいよ、君なら絶対に成功するから」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "メクラ、ツンボ、と言えば、非人情なことには、物怖じしない者の例として持ち出される。",
              "citation": {
                "source": "ジャングル頭",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、物怖じしない代りには、何かに激発されれば、自らは兇器を振り廻すことがある。",
              "citation": {
                "source": "ジャングル頭",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "気持よく伸びてる首、無意味に高い鼻、しまりのない唇から洩れる金歯の光、わりに不活溌な、でも物怖じせぬ眼付、それに綺麗な肌を以てして、彼女は、余りにのんきすぎるか、智恵がまわりかねるか、そういったおおまかさを具えていた。",
              "citation": {
                "source": "操守",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "よほど人に馴れているとみえて、こうして物怖じもせずに平馬の手にとまっているのだ。",
              "citation": {
                "source": "平馬と鶯",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "花は間も無く正気づくと、物怖じしたように長椅子の上に跳起きた。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "青褪めた顔　すると、ドアが細眼に開いて、そこから物怖じしたような二つの眼が覗いた。",
              "citation": {
                "source": "深夜の客",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔を挙げると、少し高くなりかけた朝陽の中に立ったのは、吉五郎の娘お留の、物怖じしない活き活きした顔です。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "縁結び",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるかないかくらいの物怖じしている様子が、弟の眼の中に震えているのを姉は見入った。",
              "citation": {
                "source": "童話",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "あてがわれた弁信は、一議に及ばずその好意を受けてしまったが、遠くて不自由だろうと思いやりながら、ここへ弁信を導いて来た人が、かえって、弁信の物怖じをしないのに舌を捲いたようなあんばいです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "私だって大抵のものは、物怖じしないで、いくらでも馬食する。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "来ればまた、ものおじしないその伝六が、ぼんやりと指をくわえているはずもないのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまらん」牛丸平太郎は生れつきものおじをしない楽天家であったが、このときばかりは、もう死ぬかもしれないと思った。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、それは、いつものおじいさんじゃありませんでした。",
              "citation": {
                "source": "子供の時分の話",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、このおじいさんが、いつものおじいさんと異って、愛嬌があるのにもかかわらず、なんとなく気味悪く思いました。",
              "citation": {
                "source": "子供の時分の話",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄色なくちばし、その鈍重なからだつき、そして、たえずものおじする、つぶらな黒い目を見ると、いじらしいという感じをさせられた。",
              "citation": {
                "source": "自由",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥は、知らぬ場所にきたので、いっそう、ものおじして、目をぱちくりしていました。",
              "citation": {
                "source": "自由",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼こそは、英雄であり、ものおじしない、大胆な人であった。",
              "citation": {
                "source": "少年たち",
                "author": "МАЛЬЧИКИ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それでは――」　と言いかけて、ものおじしたように他の二人の顔を交みに見くらべたのは、お畳奉行別所信濃守。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒場のなかを見まわすと、青年のとなりの椅子にぎこちなく掛けて、ものおじしたようにうつむいてしまった。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はにかんだり、ものおじしたりする女ではないね」「それはそうですよ。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ものおじして、なにになりますか、こんな時代に」「せいぜい鍛えてくれ」　秋の雨の夜、ヨシオがひとりで部屋にいると、部屋の外にある板の間のドアに、ノックのような音が聞こえた。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に物おじする様子の乳母が葉子の前に来て腰をかがめた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前たちの、その物おじしながらも金目をかけた派手作りな衣装や化粧は、社会上の位置に恥じないだけの作りなのか、良人の目に快く見えようためなのか。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、肉感的な頬、愛嬌のある眼付、物おじしたような温厚な風貌は共通していた。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その町はもうかなり煤けて、物おじした建物が多かつた。",
              "citation": {
                "source": "瑪瑙盤",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜風が身にしみてふっと詩人は目をさましました、そして物おじをした様に女の胸にすがりつきました。",
              "citation": {
                "source": "無題（一）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とリーズは物おじるような哀願の調子でこう言った。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "九太夫も小さい時からの奇術師商売、日本はおろか海の外まで廻り歩いて、ちょッとのことでは物おじしないタチであったが、この姉妹には少々ビックリさせられた。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "若僧が上手鐘楼の角により奥の方を伺える間、妙信は物おじたる姿にて中辺に止まり、若僧のものいうをまつ。",
              "citation": {
                "source": "道成寺（一幕劇）",
                "author": "郡虎彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とキングは手をもみもみ、「では今こそ裁判員よ……」「そこのだれかがこのポエムを読みとけたら、」とアリス（このほんの数分でたいへん大きくなっていたので、まったく物おじもせず口をはさんでね）、「銀貨１まいあげてもよくてよ。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
