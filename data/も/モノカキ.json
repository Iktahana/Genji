          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は学生時代から物書きになることを夢見ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "売れっ子の物書きは、締め切りに追われる毎日を送っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "祖父は定年退職後、趣味で物書きをしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ただし、漠然とそんなことを思っていても、どうすれば物書きになれるのかは分かりません。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "手書きの温もりとフォントのそっけなさ『しかし』を出していたころも、大学時代たくさんのビラを書いていた時期も、そして物書きを目指して初めての本に取り組んでいたときも、書くことにこめた願いの本質は変わらなかったと思います。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "物書きとして歩き出して間もなく、小さな文庫本を書いた。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだこのオレは、最近ではパーソナルコンピューターがどうしたこうしたとゴタクを並べているが、そもそも物書きの真似事をはじめたきっかけは何だったのか。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "○蚊帳つれば薄暗きを厭ひて、宵の程は蚊を打ち／＼書読み物書きなどす。",
              "citation": {
                "source": "病牀瑣事",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミュージシャンか物書きか、なにかそうした仕事で食っていきたいと考えていた藤井は、大学の軽音楽部でバンドを組み、放送作家の見習いとしても働きはじめた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば床の間の前なる一閑張の机に物書きゐる人あり筆を擱きて此方に向直らるるに、昨日取次に立出でられし人に瓜二つともいふべきほどよく似たれども、近く対座して重ねてよくよく見れば年も少しく若く身体つきもまたすこし痩せたる別人なり。",
              "citation": {
                "source": "書かでもの記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近では、ペットの一時預かりにまでビジネスを広げているが、魂は、物書きである。",
              "citation": {
                "source": "三重塔にて",
                "author": "福永信",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまでのように下宿人のある者が七月になると彼女にくれていた物書き用の入場券を待つこともない。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の物書きが記した単なる伝説で、現実と言うより空想だろう。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに来ると自分はどういうものかきっと、ドストエフスキーの「イディオット」の死刑場へ引かれる途上の光景を思い出すのである。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば夏の夕に町を歩いていて、ある、ものの酸敗したような特殊なにおいをかぐと、自分はどういうものかきっと三つ四つのころに住んでいた名古屋の町に関するいろいろな記憶をよび起こされる。",
              "citation": {
                "source": "試験管",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すもものかきねのはずれから一人の洋傘直しが荷物をしょって、この月光をちりばめた緑の障壁に沿ってやって来ます。",
              "citation": {
                "source": "チュウリップの幻術",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "縞の前垂をかけて小さい丸髷に結ったセキが、ああなアんだ、そこけ、と近づいて来るのを猛之介はこちらに立って見据えていたが、セキは又どういうものかきょうはいつものように顔の見えたところから大声でがなって来ず、すっかり猛之介のそばへよるまで黙っていて、しかも四辺を憚る気配で囁いた。",
              "citation": {
                "source": "昔の火事",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああこの中に何ものかきれいなもの、ああこの中に何ものかしみとほるもの、ああこの中に魂かがやくアルコール、その泥水を油とし、その腸を油壺とし、暗夜を照らす不斷の燈、不滅の燈、汝の暗い靈を照らす光たらしめよ。",
              "citation": {
                "source": "展望",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年の夏は体の工合は案外にもちそうです、オリザニンもちゃんとよくのんでいるし、眠ること、食物のこと、よく気をつけて居りますから、何しろ、八月から長いものかき出そうといきごんでいるわけですから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからすこし明朝渡すものかきますから、又ね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人は署名帳を出して、私に物書けというから、三、四行したためた。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "その概略は今物書くべき心地もせねば、精しき事の顛末をば、羅馬に到り着きて後にこそ告ぐべけれ、手を握らで別れ去ることの心苦しさを察せよといふ程の意なりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時の留守居役所には、この二人の下に留守居｜下役杉浦多吉、留守居｜物書藤田徳太郎などがいた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "物書松本甲子蔵がこれに随っていた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "世に丸の嘘はないもので、加藤｜咄堂君の『日本風俗志』中巻に、『伊豆日記』を引いていわく、八丈の島人女を恋うても物書かねば文贈らず、小さく作った草履を色々の染糸を添えたる紙にて包み贈る。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日明治文学として残っているものの一半は殆どあの十年間に動いた人達の仕事であるのを見ても、明治二十年代は筆執り物書くものが一斉に進むことの出来たような、若々しい一時代であったことが思われる。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、さておき、今お話ししたように、そもそもわたしが童話を書こうと思い立ったのは遠く国から離れ、自分の子供からも離れている時でありましたが、それから少年のために物書くことの楽しみを知り、書いてみれば自分にも書けてうれしく思いました。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "教養と物書くこととは別の物であるのか、手紙を書くといふことも一つの才能であるのか、舊い技巧や形式を捨てることが反つて人をこだはらせるのか。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "物書く祕訣も、實はそんなところに潜んでゐるのではあるまいか。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "成程、教養と物書くこととは別の物であるかも知れない。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆執り物書くほどのものは、いづれもこの小さな言葉をおろそかにしない。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、こんなに眞情が直敍されたなら、物書くその事が直ちにわたしたちの心を滿たすことであらうとも思はれる。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "年老いてから筆が持てなかつたといふ古人の話をよく持ちだしたのも同君で、その古人は手に筆をしばりつけながらでも書いたと私にいつて見せ、筆執り物書くからにはそこまで行きたいといふ話なぞの出たこともあつたと思ふ。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
