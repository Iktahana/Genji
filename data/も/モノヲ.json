  {
    "uuid": "2adecefa-fb3f-5919-a1a2-7db228adde7f",
    "entry": "モノヲ",
    "reading": {
      "primary": "ものを",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "と幽かにお笑ひになつておつしやつて居られた事もございますし、また、政所、侍所ナドト等シク、都所トイフモノヲ設ケタラドウカ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハナントナクコンナツマラヌモノヲあなたニ見テモラウノガハズカシイノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　花タチハ　ジブンタチノ　スガタヲ　ナガメアヒ、ジブンタチカラ　ナガレデル　ニホヒヲバ　カギアツテ、ジブンタチガ　ミナ　オナジヤウニ　キイロイ　キモノヲ　キテ　ヲリ、ホカノ　木ヤ　クサニ　マケナイホド　ウツクシイノヲ　シツテ　イツソウ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、花タチノ　オドロイタ　コトニハ　ソレハ　花タチノヤウニ　キイロイ　キモノノ　カハリニ　マツシロイ　キモノヲ　キテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ、キヨウシツデ　ヒトリキリ、ナニカ　カキモノヲ　シテ　ヰマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ大西郷等革命精神ノ體現者世ヲ去ルト共ニ單ニ附隨的ニ行動シタル伊藤博文等ハ、進ミタル我ヲ解セズシテ後レタル彼等ノ貴族的中世的特權ノ殘存セルモノヲ模倣シテ輸入シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ノ形式的又特殊的課目ヲ廢止シ小學、高等小學、中學校ニ重複スルモノヲ廢シテ一貫ノ順序ヲ正シクス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアー、コトモアロウニ、ジブンタチノ死ンダオ母ッチャニアゲタモノヲ、君チャンヤ弟ヤ妹ガ、ムチウニナッテ、タベテイルデハナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イアイダ、タベモノヲ見タコトモナカッタトコロヘ、ハジメテソウシキノオソナエモノヲミルト、モウ矢モタテモタマラズ、目ガクラクラットシテ、ソレニ小サイ弟ヤ妹ナノデ、死ンダオ母ッチャニワルイトオモイナガラ、スキヲネラッテ、ミンナデムチュウニナッテタベテシマッタンダッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ私ハ近ゴロ原稿ヲ書クニモ手紙ヲシタタメルニモヒラガナトイウモノヲ使ツタコトガナイ、ソレハナゼカトイウニ、我々仰臥シタママデモノヲ書クモノニトツテハ些細ナ力ノ消費モ大キナ問題トナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々ハ今マデニオイテモ行書ノ活字ダノ草書ノ活字ダノトイウモノヲ持タナカツタガ、ソノタメニイササカノ不便モ感ジテハイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私ハ夜中ニ何ダカ咽喉ニ冷リトシタモノヲ感ジマシタ。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツヅイテ刺スヨウナ痛ミヲオボエマシタノデハット思ッテ目ヲ開クト要之助ガ悪鬼ノヨウナ相ヲシテ白イ光ルモノヲモッテ私ニ馬乗リニナッテイマス。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身ニ毒草ノヨウナモノヲツケタルモ、……」（判読不能）僕「空電妨害ニ悩サル。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身ニ毒草ノヨウナモノヲツケタルモ以下語レ」相手「毒草ノヨウナモノヲツケタルモ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ヲ語レ」相手「……ソノ下ニハ浅黄色ノ軍服ラシキモノヲ着セリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "材料ノ不足ニヨリテ意ノ如キ波長ノモノヲ作ルコトヲ得ザルコトヲ発見シタルトキハ絶望ノ泪ニ暮レタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "多数町村ノ［破壊→頽廃］セルモノヲ恢復スル其五ナリ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ、彼ニ従フトコロノモノモ、屈強ナル壮年男子ニ限リタレドモ、コノ信神渡航者ノ一行ニハ、オヨソ信仰ヲ共ニスル限リ、老幼男女ノアラユルモノヲ抱容スルコトヲ許サレタリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモ、彼等ノ一人モ意気精神ノ阻喪スルモノヲ見ザリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「翌日、拝領屋敷ヘ行ッテ、家主ヘ談ジテ金子二十両借リ出シテイロイロ入用ノモノヲ残ラズ拵エテ、十日目ニ出勤シタ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オネコサン、私ハカゼヲヒイテ、真白ナキモノヲキテネテヰマス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンハ大ヘンモノヲ大切ニスル子デシタカラ、イツモ、ボンコチヤンヲブラツシデ、テイネイニハイテ、テイレヲイタシマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ、ハジメニモ申シ上ゲタ通リ、モンコチヤンハ大ヘンモノヲ大切ニスル子デスカラ、ボンコチヤンニツイテヰタホコリヲ、テイネイニブラツシデハイテヤリマシタカラ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "座ニ一人余ト年相｜若クモノヲ見ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "○「コロボックル」ト「エスキモー」トノ一致ノ點中殊ニ趣味有ルモノヲ擧グレバ次ノ如シ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "安永五年（1776）に刊行せられた松平君山の『本草正譌』には「万寿菊、単葉重葉アリ俗ニ単葉ノモノヲ天林花ト云ヒ重葉ノモノヲ満州菊ト云フ万寿菊ノ訛ナリ」と書いてある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
