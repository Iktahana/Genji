        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ストーブを掃除したら、中から真っ黒な燃え滓がたくさん出てきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "火災現場には、焼け焦げた家具の燃え滓が無残に散らばっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "焚き火の燃え滓が風に舞い、周囲のキャンプサイトを汚してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "煤がふります、脳味噌に、マグネシユームの燃え滓に。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "烈々として燃え滓ひとつ残らないという。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁には油絵や、金縁の写真などが懸けられ、床には家具やピヤノが置いてあって、暖炉棚の下からは、燃え滓や煤の臭いがぷんと来た。",
              "citation": {
                "source": "空家",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "煉瓦工場からは石炭の燃え滓を少年のすぐ近くの傾斜面へトロツコで運んでくるのです。",
              "citation": {
                "source": "動物列車",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年は、燃え滓の中から、まだすつかり燃えきつてゐない石炭を探して出してメリケン袋に入れるのです。",
              "citation": {
                "source": "動物列車",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "『又、火山は燃え滓の雨を降らせる。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、此の噴火口の七つが一つの深い淵のやうになつて、それが四ヶ月間雷鳴したり、唸つたり、燃え滓や熔岩を噴き出した。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "燃え滓は熔岩と一緒に船の上に落ちて来るし、海は怒つて底まで荒れ出すし、岸には山の崩れが積つて邪魔になるし、仲々近寄る事が出来ないのだ。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼れの部屋につゞいた庭はだん／＼燃え滓が一杯になつて、もう少し経つと彼れは逃げ出す事も出来なくなりさうだつた。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "石の雨が……実際小石と火のついた燃え滓とが雨のやうに降つて来る。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "噴火山の熔岩や燃え滓や煙がプリニイを窒息させたのである。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "燃え滓は降つて来る。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶えず二人は立ち上つては、二人を埋めにかゝる燃え滓を払ひ落した。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "何もかも厚い火山灰や燃え滓に埋められて仕舞つて、土は見る事も出来なかつた。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『では、人家は燃え滓に埋められて了つたんですか。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "『山の麓では、噴火山から噴き上げられた灰が高い家よりも深く降つて来るから、町がすつかり燃え滓の下敷になつて了つた。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "眩い稲妻の一閃が見せたのだ、ランプの消えた静かな小部屋全体を、焦げた手紙の燃え滓が散る木の机の上を、鏡を見るかのようにはっきりと。",
              "citation": {
                "source": "犬酸漿",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "霰と風にうち裂かれ、茎と蔓は雷に焼かれ、紫の花は散り散りとなって割れた鉢や荒れた小部屋の床に散らばる燃え滓と入り混じっていた。",
              "citation": {
                "source": "犬酸漿",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "余程経って海が見え始めた時、僕は窓から乗り出して石炭の燃え滓を目に入れた。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "無暗に窓から乗り出す所為だろうか、それとも石炭の燃え滓という奴は特に子供の目が好きなのだろうか？",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "マッチの火は消えて、だるまストーブもパッとなくなってしまい、手の中に残ったのはマッチのもえかすだけでした。",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "THE LITTLE MATCH-SELLER",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女は座ったまま、死んでかたくなっていて、その手の中に、マッチのもえかすの束がにぎりしめられていました。",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "THE LITTLE MATCH-SELLER",
                "note": "青空文庫"
              }
            },
            {
              "text": "抱いていた恐怖もみな燃えかすとなり次は動揺。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだくすぶっている燃えかすから木ぎれをひとつ手にとって、息を吹きかけ火を付け直せば、この狭い野営を調べる役にも立つわけだ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "暁闇を、物々しく立ち騒ぐ風と波との中に、海面低く火花を散らしながら青い炎を放って、燃え上がり燃えかすれるその光は、幾百人の漁夫たちの命を勝手に支配する運命の手だ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ら二人の目は悒鬱な熱に輝きながら、互いに瞳を合わすのをはばかるように、やや燃えかすれたストーブの火をながめ入る。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "倉地の心にもまだ自分に対する愛情は燃えかすれながらも残っている。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻は燃えかすれる囲炉裡火に背を向けて、綿のはみ出た蒲団を柏に着てぐっすり寝込んでいた。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その燐寸の燃えかすは、うっかり小卓子の灰皿の中へ投ぜられかけた。",
              "citation": {
                "source": "地獄の使者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモクリトスは人類に害を加える流行病は天体が破壊されて燃えかすが地面に落ちたためと信じていた。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
