          "literary": [
            {
              "text": "モルビエ　　（黙つて、傍らの新仏蘭西評論を取り上げ、バラバラと頁を繰る。",
              "citation": {
                "source": "序文",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "モルビエ　　われわれの仲間は、ジャック・グランジュといふ男を、文人としてもですが、殊に、画家としてはまるで認めてはゐないんですからね。",
              "citation": {
                "source": "序文",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "プルウスト　　（眉を寄せる）モルビエ　　誰が、その肖像を真面目に批評しました。",
              "citation": {
                "source": "序文",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "プルウスト　　（また顔をしかめる）モルビエ　　（それにかまはず）今度出るつていふ「文字による肖像」ですか、内容は、断片的に知つてるんですが、彼にセザンヌの何処がわかるんです。",
              "citation": {
                "source": "序文",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "モルビエ　　なほさうです。",
              "citation": {
                "source": "序文",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "モルビエ　　幼馴染としてゞすか。",
              "citation": {
                "source": "序文",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "モルビエ　　実は、この間も、その話を開いて、是非それだけは止めて貰はうなんて、こゝへ押しかけて来さうにした連中がゐました。",
              "citation": {
                "source": "序文",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "プルウスト　　モルビエ、君は、また話に来てくれ給へ。",
              "citation": {
                "source": "序文",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "モルビエ　　お大事に…………。",
              "citation": {
                "source": "序文",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
