        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夜中に物凄い雷の音がして、飛び起きた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その映画は物凄い恐怖を描いていて、見るのが辛かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は物凄い剣幕で怒鳴りつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
