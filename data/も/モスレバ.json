          "literary": [
            {
              "text": "一、一字卜為セシ者、皆新様ニ似タレドモ、敢テ古人製字ノ法ヲ倣フニ非ズ、其旁画、動モスレバ疑似ニ渉ルヲ以テ、等ノ片爿ヲ加ヘ、故ラニ字形ヲ乱シ、以テ真字ト分別アルヲ示ス、且此字ニ音無ク義無シ、即原語ノ音ヲ縮メテ、此字ノ音卜為ス者ナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由ト我儘トハ、動モスレバ其義ヲ誤リ易シ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "「九万ハ性放誕｜不羈、嗜酒任侠、動モスレバ輙チ連飲ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈今人ノ韻ヲ逐ヒ字ヲ填メテ動モスレバ千百言ヲ成スノ比ナランヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
