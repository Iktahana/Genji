          "standard": [],
          "literary": [
            {
              "text": "女優と花束４・16東京日日（夕）　女優の舞台生活といふものは、表と裏とちがつて、どこの国でもからくりの多いものだが、女優モウド・アダムスの話しによると、ある時この人の一座で出し物の名はわすれたが、人気のある脚本の一つを演じた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "会員は、目下｜欧羅巴じゅうに七十人あまりですが、そのなかには、あの「｜幸福な白痴」を書いた倫敦の劇作家モウド・ハインもいます。",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタ　メガサメテミルト、オホソウヂハ　モウドコヘイツタカ　カゲモカタチモアリマセンデシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽挙モウドウをいましめるフレはでているのだから、正二郎はフレに反した戦争などはしたくはないが、この連中にこう云われると、否応ない。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワア、ワア、ワア」気ガ狂ッタラ狂ッタデイヽ、モウドウナッタッテ構ウモンカ、予ハソウ思ッタガ、困ッタコトニ、ソウ思ッタ瞬間ニ急ニハット自省心ガ湧キ、気狂イニナルノガ恐クナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
