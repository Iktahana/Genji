          "literary": [
            {
              "text": "＊２　クラースヌイ　スモレンスク県下の町。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "スモレンスキーのように日曜だけ自由商人が出て来る、古物の。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "東部戰線も惡く、スモレンスク方面に激戰つづく。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "11月始めにスモレンスクが再占領されたときに2,000人の騎兵だけが残り２万人の患者が市の病院に居た。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの発疹チフス患者はスモレンスクに残され11月13日に撤退した。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ロレーン男爵と申します」　モレンス所長が歓待した。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "保険をかけたいものは何でしょう」「実はだな、かけたいのはグランビル大統領の生命保険なんだ」「確かに、変わってますね」「いやいや、モレンス所長。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "「個人で見せ物を計画されているそうですが」　とモレンス所長が笑顔で探りを入れた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリ中が何カ月も喪に服するからだ、分かるだろ」　モレンス所長が深くうなずいた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてエロスが世の中をびっくりさせるぞ」　モレンス所長はあわててこの件をグライドに再確認した。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "グライドは時間を置かず保険業者のモレンス所長を訪ねた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "モレンス所長が憮然として厚紙に骸骨を書いているのが見えた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お待ちしておりました」　とモレンス所長がため息まじりに言った。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "モレンス所長が、ぼやいた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "モレンス所長だけが途方に暮れた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "モレンス所長は騙されたことに気づき始め、嘆いた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "風のうわさに、モレンス所長がクルミを食べワインを飲みながら、いかさま取引をぼやいているとか。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
