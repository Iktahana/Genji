        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イマハ山中、イマハ浜、イマハ鉄橋、ワタルゾト思ウ間モナクトンネルノ、闇ヲトオッテ広野ハラ、どんどん過ぎて、ああ、過ぎて行く。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "イマハ山中、イマハ浜、イマハ鉄橋ワタルゾト思ウマモナク、――その童女の歌が、あわれに聞える。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフダチ　ヤムノヲ　マツウチニツカレガ　デタカ　オヂイサンイツカ　グツスリ　ネムリマスオヤマハ　ハレテ　クモモナクアカルイ　ツキヨニ　ナリマシタ　この月は、春の下弦の月である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハモーダメニナッテシマッタ、毎日訳モナク号泣シテ居ルヨウナ次第ダ、ソレダカラ新聞雑誌ヘモ少シモ書カヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "マモナク、アカイ　フウセンダマト　シロイ　テフテフハ　ミエナク　ナツテ　シマヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "云ウマデモナク最近ノ不況ハドシ／＼失業者ヲ街頭ニ投ゲ出シテ居リ、ソレハ全く見ルニ忍ビナイモノサエアルノデス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ父ッチャハ半トシモネテ、ウチノ中ニ何ンニモナクナッタトキニ死ンダノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして休日毎に遥々と故郷の父母を見舞ふと、二人は仲違ひの状態で、阿母は米塩の資だけには事欠ぬと云つてゐたが阿父は西瓜畑の一隅の、漂流者の住みさうな小屋にもぐつて、「俺ニハ一文ノ金モナクナツタヨ。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「煙リモ見エズ　雲モナク……」　彼は全く自己流の怪し気な口調で喚きながら、玄関にのめり込んだ。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "マモナクヨコハマジヤツクトイウワルモノニツカマツタ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "親愛モナク　糧モナク。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ハ、コンゲツ一パイメッタニ雨モフラズ、カゼモナクテ、マイニチマイニチヤケルホドアツクテ、ワタシハモウスコシデ、クタバッテシマフトコロデシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「抑々当流ノ元祖戸田清玄ハ宿願コレ有ルニヨツテ、加賀国白山権現ニ一七日ノ間、毎夜｜参籠致ス所、何処トモナク一人ノ老人来リ御伝授有ルハ夫レコノ流ナリ」　米友は高らかに戸田流の目録を、そら読みに読み上げました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ猶ホ、コノ信神渡航者ノ一行ニハ、一人ノ貴族モナク、イハユル英雄モ豪傑モ、一人モ有ルコトナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "マモナクブルル……トイサマシイ　オトヲタテテアカイヒカウキ　ガタスケニヤッテキマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクバクモナクシテ攘夷ノ事興ルヤ国論｜喧※ノ中に端坐ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクバクモナクシテ亡シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクバクモナクシテ都ニ入ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "貝原益軒の『大和本草』に『仙覚抄』を引いて「浜ユフハ芭蕉ニ似テチイサキ草也茎ノ幾重トモナクカサナリタル也ヘギテ見レバ白クテ紙ナドノヤウニヘダテアルナリ大臣ノ大饗ナドニハ鳥ノ別足ツヽマンレウニ三熊野浦ヨリシテノボラルヽトイヘリ」とある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イ大シタ妨害モナク到着。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "足ノ趾ニ全部｜胼胝ガ出来チャッテ、腫レ上ッテ爪モ何モナクナッチマウノヨ」「今デハ綺麗ナ足ジャナイカ」「ホントウハモット綺麗ナ足ダッタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車ヲ運転シタガッタリ拳闘ヲ愛シタリスル一面、ガラニモナク生花ガ好キデ、京都ノ一草亭ノ娘婿ガ週ニ二回、イロ／＼珍シイ花ヲ持ッテ東京ヘ出テ来テ教エルノデ、ソノ人ニ就イテ去風流ヲ習ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜｜盂蘭盆ノ送リ火ヲ済マスト間モナク颯子ハ出カケテ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アレカラ間モナク」「アレカラトハ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「コカコラヲ飲ムト間モナク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "抵抗スル隙モナク簡単ニ予ハ押シ倒サレテ芝生ニ仰向ケニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何デモ結婚後半年バカリ過ギテカラ、「ボルゾイヲ飼ッテ見タイ」ト浄吉ガ云イ出シテ間モナク素晴ラシイノヲ一匹見付ケテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
