          "literary": [
            {
              "text": "モシコノ注意ヲ守ラナケレバ、現代ノ世界人類ハ最大ノ不幸ニオチイルデアロウ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシコノ大商船隊ヲシテ、ハワイニ到着セシメンカ、ハワイ島ハ一躍、難攻不落ノ要塞トナリ、×軍ノ東洋進出ヲ容易ナラシメ、進ミテ、皇国ノ一大危機ヲ生ズルニ至ルベシ。",
              "citation": {
                "source": "太平洋雷撃戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシコノ状態ガ持続シ、カツソノ程度ガ漸次ニ昂進スルトスレバ、ヤガテ僕ハ大学教授ノ職ニ堪エナクナリハシナイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
