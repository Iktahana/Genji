          "literary": [
            {
              "text": "スルト　モリヤ　ヤブノ　ナカニ　ヰタ　ウグヒスタチハ　ソレヲ　キキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "手に親がモリヤーク〔船乗り〕だったといういかりの入墨がある。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンシンバシラヤ、ハタケヤ、モリヤ、イナカヤヤ、ケシキガ　ドンドンウシロヘ　ハシッテユキマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この原始林をマモリヤマ公園などと称していたが、公園どころか、ただの原始林で、私はここへよく子供をつれて行って遊ばせた。",
              "citation": {
                "source": "風と光と二十の私と",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
