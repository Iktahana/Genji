    "definitions": [
      {
        "index": 1,
        "gloss": "shrike (any bird of family Laniidae)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "秋の澄んだ空に、百舌鳥の高鳴きが鋭く響き渡っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "百舌鳥は他の鳥の鳴き声を真似るのが得意な、非常に器用な鳥だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "庭の生垣に百舌鳥が止まって、鋭い嘴で周囲を警戒している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "高い木のてっぺんで百舌鳥が鳴いているのを見ると、六蔵は口をあんぐりあけて、じっとながめています。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして百舌鳥の飛び立ってゆくあとを茫然と見送るさまは、すこぶる妙で、この子供には空を自由に飛ぶ鳥がよほど不思議らしく思われました。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう暁刻の百舌鳥も来なくなった。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "野末はるかに百舌鳥のあわただしく鳴くが聞こゆ。",
              "citation": {
                "source": "小春",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋になつてから、山から里の方に下つて來たかけすが百舌鳥よりも鈍い、然しある似よりを持つた途切れ／＼の啼聲を立てゝ、その黒い枝から枝へと飛び移りながら、人眼に遠い物蔭に隱れてゆく。",
              "citation": {
                "source": "秋",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "百舌鳥の声、五位鷺の声、或る日は万歳万歳のさけびが聞える。",
              "citation": {
                "source": "草と虫とそして",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "けたたましい百舌鳥の声にふっと四方の平静が破れる。",
              "citation": {
                "source": "夜長ノート",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "百舌鳥が啼いた、これから空が深うなるほどその声も鋭くなる、そして私に秋を痛感せしめる、……そして。",
              "citation": {
                "source": "行乞記",
                "author": "大田から下関",
                "note": "青空文庫"
              }
            },
            {
              "text": "空はからっと晴れていて、百舌鳥の声がきんきん、ひびいていました。",
              "citation": {
                "source": "ごん狐",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "堺の三国を過ぎると、二里の登り道で、朝九時に大阪を出たのに、昼の一時を過ぎても、まだ中百舌鳥であった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "堺の三国を過ぎると、二里の登り道で、朝九時に大阪を出たのに、昼の一時を過ぎても、まだ中百舌鳥村であった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地は百舌鳥の耳原であるから百舌鳥の耳原の中の陵というて居るのである。",
              "citation": {
                "source": "松蟲草",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "女房は山陵のあるあたりは百舌鳥の耳原ではなくて舳の松といふ村だと打ち消すやうにいつた。",
              "citation": {
                "source": "松蟲草",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "さつきの合唱中のあの「無神経質な偽陶酔状態を感ぜしめて身を切らるゝ百舌鳥に似たそぷらの」と形容した女声は、この人だな！",
              "citation": {
                "source": "心象風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "百舌鳥が栗の梢で、寒空を仰いで激しく友を招んでゐた。",
              "citation": {
                "source": "肉桂樹",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、負傷の腕を抱へたまゝ納戸の窓から百舌鳥の鳴いてゐる空を眺めてゐた。",
              "citation": {
                "source": "肉桂樹",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――百舌鳥が高く鳴き、目白が竹籔の間を飛んでゐた。",
              "citation": {
                "source": "肉桂樹",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この位利けば百舌鳥位ゐ落せる。",
              "citation": {
                "source": "周一と空気銃とハーモニカ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僅に其処に常住する鴉――これもこの大きな松の梢の茂みの中に見る時おもひの外の美しい姿となるものである、ことに雨にいゝ――季節によつて往来する山雀、四十雀、松雀、鵯、椋鳥、鶫、百舌鳥、鶯、眼白、頬白等を数ふるに過ぎぬ。",
              "citation": {
                "source": "沼津千本松原",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "百舌鳥もお前に似て喧嘩ずきな鳥だが、あの鳥の慾望は征服の心地よさにあるので、征服出来そうにもない相手には、滅多に争いを仕かけようとはしない。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "馴れし木犀の香やうやく衰へ、裏の栗林に百舌鳥なきしきる。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "沓の代はたられて百舌鳥の声悲し　　　馬の尾をたばねてくゝる薄かな　　　菅笠のそろふて動く芒かな　駄句積もるほどに峠までは来りたり。",
              "citation": {
                "source": "旅の旅の旅",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "まことに好季節、百舌鳥が啼く、萩が蕾んだ、曼珠沙華が咲きだした。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・月がまろい夜を逢うて別れた・百舌鳥がてつぺんに落葉しはじめた樹・秋草ふみつつかりそめの犬とあとさき・月夜の柿がばたりぽとり（改作）・木の葉ちるや犬もわたしもおどろきやすく・サイレン鳴ればさびしい犬なればほえ・ヱスもわたしもさびしがる月のこうろぎも　九月廿四日秋晴、秋季皇霊祭。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月七日晴、百舌鳥の鳴声が鋭い、秋風らしく吹く。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・百舌鳥のするどくその葉のちるや　　　老祖母追憶・熟柿のあまさもおばあさんのおもかげ　南天の実のいろづくもうそさむい朝・空はゆたかな柿のうれたる風のいろ　十月九日酒、酒、そして酒だ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯草あたたかう犬は戻つてきてゐる（Ｓよ）　こころむなしく日向をあるく・もいではすする熟柿のぬくとさは・空のふかさへ変電所の直角形（改作）・あかるくするどく百舌鳥はてつぺんに　十月十五日曇、時々雨となる。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月十六日曇、そして雨、百舌鳥がやたらに啼く。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "……・うらゝかにしてすがれた花にとまるてふちよも　母子で藷掘る暮れ早い百舌鳥の啼く・うらゝかなれば一羽鴉のきてなけば　日あたり水仙もう芽ぶいたか・ことしもこゝに落葉しておなじ蓑虫　　　白船君に　あなたを待つてゐる火のよう燃える　十一月廿四日　けふもうらゝかな日。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "平たい石には今もその忠魂塔の鉄銹があるやうに、雨が降ればその銹は流れ出すやうにさへ思ふのだが、それはその後もずつと肉親を離れて東京にゐる、孤独な男の妙な幻想だけのものなのかも知れぬ。",
              "citation": {
                "source": "一つの境涯",
                "author": "――世の母びと達に捧ぐ――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
