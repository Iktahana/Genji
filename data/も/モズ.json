      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "青ぎった空に翠の松林、百舌もどこかで鳴いている。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京市何区何町の真中に尾花が戦ぎ百舌が鳴き、狐や狸が散歩する事になったのは愉快である。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "百舌が来たが鳴かず。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い木のてっぺんで百舌鳥が鳴いているのを見ると、六蔵は口をあんぐりあけて、じっとながめています。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして百舌鳥の飛び立ってゆくあとを茫然と見送るさまは、すこぶる妙で、この子供には空を自由に飛ぶ鳥がよほど不思議らしく思われました。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "とおくの百舌の声なのか、北上川の瀬の音か、どこかで豆を箕にかけるのか、ふたりでいろいろ考えながら、だまって聴いてみましたが、やっぱりどれでもないようでした。",
              "citation": {
                "source": "ざしき童子のはなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うの楊の木から、まるでまるで百｜疋ばかりの百舌が、一ぺんに飛び立って、一かたまりになって北の方へかけて行くのです。",
              "citation": {
                "source": "鳥をとるやなぎ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "石はその半分も行きませんでしたが、百舌はにわかにがあっと鳴って、まるで音譜をばらまきにしたように飛びあがりました。",
              "citation": {
                "source": "鳥をとるやなぎ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "俄かにそらがやかましくなり、見上げましたら一むれの百舌が私たちの頭の上を過ぎていました。",
              "citation": {
                "source": "鳥をとるやなぎ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "百舌はたしかに私たちを恐れたらしく、一段高く飛びあがって、それから楊を二本越えて、向うの三本目の楊を通るとき、又何かに引っぱられたように、いきなりその中に入ってしまいました。",
              "citation": {
                "source": "鳥をとるやなぎ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶次郎は本気に石を投げたのでしたが、百舌は一ぺんにとびあがりました。",
              "citation": {
                "source": "鳥をとるやなぎ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小禽とは、雀、山雀、四十雀、ひは、百舌、みそさざい、かけす、つぐみ、すべて形小にして、力ないものは、みな小禽ぢゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから渡り鳥のくゎくこうや百舌も、又小さなみそさゞいや目白もみんなこの木に停まりました。",
              "citation": {
                "source": "土神と狐",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小禽とは、雀、山雀、四十雀、ひわ、百舌、みそさざい、かけす、つぐみ、すべて形小にして、力ないものは、みな小禽じゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから渡り鳥のかっこうや百舌も、又小さなみそさざいや目白もみんなこの木に停まりました。",
              "citation": {
                "source": "土神ときつね",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔たゞかたくなのみをわぶる〕宮沢賢治　　……たゞかたくなのみをわぶる　　　　なにをかひとにうらむべき……ましろきそらにはゞたきてましろきそらにたゆたひて百舌はいこひをおもふらし",
              "citation": {
                "source": "〔たゞかたくなのみをわぶる〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう暁刻の百舌鳥も来なくなった。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "野末はるかに百舌鳥のあわただしく鳴くが聞こゆ。",
              "citation": {
                "source": "小春",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "堺の三国を過ぎると、二里の登り道で、朝九時に大阪を出たのに、昼の一時を過ぎても、まだ中百舌鳥であった。",
              "citation": {
                "source": "わが町",
