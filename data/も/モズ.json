        "examples": {
          "standard": [
            {
              "text": "里山の風景の中で、百舌鳥が木のてっぺんで縄張りを主張している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "百舌鳥の雄は、目の横にある黒い筋がはっきりしていて精悍な顔立ちだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬枯れの枝に一羽の百舌鳥が留まり、じっと獲物を探している様子を見守った。",
              "citation": {
