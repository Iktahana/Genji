          "literary": [
            {
              "text": "アルベルトオ・モンタニは菓子商なり。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしかモンタニと云ふ菓子商の申立だつたね。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "サント・モンタニの空に揚つた凧。",
              "citation": {
                "source": "長崎",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓の外には遠いサント・モンタニ。",
              "citation": {
                "source": "長崎",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "他所ではエトナと呼ばれるが、島では単にラ・モンタニュ（お山）と呼び、またサラセン侵入時代からモンジベロ（山の中の山）という呼び方も伝わっている。",
              "citation": {
                "source": "エトナ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヴィケンナ、ガレノス、ラージー、モンタニャナ、メジュス、よ。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            }
          ]
        }
