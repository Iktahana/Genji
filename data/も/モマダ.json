          "literary": [
            {
              "text": "ケレドモマダミンナキマセンゴザイマス。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月ト云ッテモマダ暑イノデ洋装ニスレバイヽノニ、ナゼカ颯子ハ和服デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三年前マデハオ爺チャンモマダ足腰ガイクラカ達者グッタカラ、大キナ犬ニ飛ビ着カレテモ心配ナコトハナカッタガ、今日デハ事情ガ違ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "排尿ニ手間ガカヽルノデ、二回目ノ時ハ丹那トンネルヲ通リ抜ケテモマダ用ガ済マナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕モマダ寝床ニイタガ、彼ノ声ガスルノデ起キテ茶ノ間ニハイルト、「先生、オーケーデス」ト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
