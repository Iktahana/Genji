        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ケサノコノ走リ書モマタ、純粋ノ主観的表白ニアラザルコトハ、皆様承知。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "衆人シリゾケバ老人モマタシリゾク。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタガツテ楷書トヒラガナモマタ同様ニ調和シナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユエニ楷書ノ活字トヒラガナノ活字モマタ調和シナイノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタガツテ楷書ノ活字トカタカナノ活字モマタキワメテ調和ガヨイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "平民自身モマタ奴隷タルベクコノ世ニ生レ出デタルモノニシテ、人格ト権利ヲ没却セラレテモ、之ヲ甘ンジテ屈従スルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　清の名家｜袁随園が『詩話』巻四に「詩ハ淡雅ヲ貴ブトイヘドモマタ郷野ノ気有ルベカラズ。",
              "citation": {
                "source": "小説作法",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ士君子万巻ヲ読破スルモマタ須ラク廟堂ニ登リ山川ヲ看交ヲ海内名流ニ結ブベシ。",
              "citation": {
                "source": "小説作法",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩ニモマタ郷党自好ノ詩アリ。",
              "citation": {
                "source": "小説作法",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶯声ノ耳ニ上ル近キモマタ愛スベシ。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余モマタコノ会ニ参スルコト二十有七度、世ハ殊ナリ事ハ異ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸老｜已ニ異物トナリ二公モマタ逝ケリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩モマタ豪肆ソノ為人ノ若シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余モマタ深クソノ為ス所ヲ惜シムトイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "子寿モマタ推シテ父執トナシ時時来ツテソノ文字ヲ質ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人山崎久卿モマタ斯ニ見ルトコロアリ博ク江戸ノ詩ヲ採リ、命ジテ『江都名家詩選』トイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "衰病ニ由ルトイヘドモマタ賦性ノ然ラシムル所。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余モマタ家慈ニ向ツテ頻ニ阿爺ニ見ユルコト何ノ日ニアルヤヲ問フ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "律詩の題言に「伊賀中将公名士ヲ本邸ニ招飲ス余モマタコレニ与ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩モマタソノ人ノ如シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "丹羽、内藤、岡ノ三士及ビ僧｜円桓モマタ継デ至ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ学業イマダ成ラズシテ数省スルハコレ二親ノ喜バザル所、僕モマタコレヲ愧ヅ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "権弁事モマタコレニ倣フ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝二、三ノ僚佐モマタ余ガ股肱ノ耳目ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "茗ハ甚シク精ナラザルモマタ以テ神ヲ澄スニ足リ、菓ハ甚シク美ナラザルモマタ以テ茗ヲ下スニ足ルベシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼎炉銚碗ハ古キモマタ可ナリ新シキモマタ可ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒モマタ両三｜罎ヲ過サズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁モマタ髪ヲ蓄ヘテ官ニ就ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
