          "literary": [
            {
              "text": "アノイワレハ可愛ラシイモノデス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "早ク見タイモノデス』という焼津の手紙でも解るように、妻と同伴することなしには、どんな旅行も楽しくないほど、夫人を熱愛していたからだった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スグ馴レルモノデス　このお言葉の有難さ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒ハ酔フタメノモノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレハ　カンザシト　イツテ、アタマニ　サスモノデス」ト　ヲンナノ　コハ　オシヘテ　ヤリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダイジナ　モノデスカ」「エエ、ワタシニハ　ダイジナ　モノデス」　ソコデ、サカナハ　ヨクガ　デマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者様――アノ鯉幟ノ棹ハ、私ガ酔ッタ勢イデ立テタモノデスガ、ソレガ記者様ノオ眼ニ止マッテ、コンナ不孝ナ恥ヲ晒ソウトハ夢ニモ思イマセンデシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ嬢サン、アナタ、モウ、ワタシノモノアリマス、逃ゲラレマセン」「ばかにおしでないよ、お前さんなんて、ウスノロのくせに」「アナタ、モウ、ワタシニ許シタデス、ワタシモウ、アナタ離サナイデス」「しつこい奴ね」「アナタ、ワタシノモノデス」「あ、畜生！",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、フシギナコトガアレバ、アルモノデス。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イエ、イエ、ハデダナンテ　ソンナコト　アルモノデスカ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マルコオバサンガ「ソンナコト――アル――モノデスカ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　ナニヲキタライイカ、イロイロト　サウダンシテヰルウチニ、アマリ　ポカポカト　アタタカイモノデスカラ　ダンダント　ネムクナツテキマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　マルコオバサンガ「イエ、イエ、ハデダナンテ　ソンナコト　アルモノデスカ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ガンバリ、　マルコオバサンガ「ソンナコト――アル――モノデスカ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お客をもてなすに、ツマラナイモノデスガ、とか、お口にあいませんでしょうが、とかと、妙に卑屈なことを言う。",
              "citation": {
                "source": "敬語論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチュウノ、ノリモノデス。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
