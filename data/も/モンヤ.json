          "literary": [
            {
              "text": "さあ唄っておみやすな」　そして芸者は、テナモンヤナイカナイカ、道頓堀よ――と唄った。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何チウ妙なモンヤ」　一同が腹をかかえて笑い転げたというが、そうしたサ中にも仁三郎一流のヒョウキンな批判を忘れないところが正に古今独歩と云うべきであろう。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "テンヤモンヤとやつて來て、別に餓死する人もない。",
              "citation": {
                "source": "革命を待つ心",
                "author": "――今の實業家、昔の實業家――",
                "note": "青空文庫"
              }
            },
            {
              "text": "テンヤモンヤとやつていられる間はよろしい。",
              "citation": {
                "source": "革命を待つ心",
                "author": "――今の實業家、昔の實業家――",
                "note": "青空文庫"
              }
            },
            {
              "text": "テンヤモンヤして、わけの判らん所に金を使つていたら、何事も出來はしない。",
              "citation": {
                "source": "革命を待つ心",
                "author": "――今の實業家、昔の實業家――",
                "note": "青空文庫"
              }
            }
          ]
        }
