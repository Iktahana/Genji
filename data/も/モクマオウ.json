        "examples": {
          "standard": [
            {
              "text": "沿岸地域は、塩風に強い丈夫な木麻黄の木を特徴としています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "木麻黄は、その深い根系により、海岸沿いの浸食制御のためにしばしば植えられます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "木麻黄の独特の針のような葉は、それを容易に認識できるようにします。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "木麻黄の並木路を透かして、運河ぞひの苫屋からも、のんびりと炊煙があがつてゐた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "木麻黄とパンダナスがアーチのように日蔭をつくっているカナカ道を行くと、劈くような鋭い叫び声が林をつきぬけてきこえてきた。",
              "citation": {
                "source": "三界万霊塔",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "床材のむかうには、光に酔つた鳥のはばたき、小さな黒奴女のさざめき……夜になれば、私の夢の伴奏をしようとて、音楽的な木立どもが、憂鬱な木麻黄が、物悲しい歌をうたふ！",
              "citation": {
                "source": "計画",
                "author": "ボードレール",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
