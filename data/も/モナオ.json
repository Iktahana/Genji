        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "戦災ノ時ニ又モウ一度改築シタガ、隠居所ダケハ奇蹟的ニ火災ヲ免レタノデ、今モナオ父母アリシ日ノ姿ノマヽニ保存サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ニ彼女ハ、遠カラズ予ガ死ンデシマッタ後モ、「アノ馬鹿ナ老人ハ私ノコノ美シイ足ノ下ニ眠ッテイル、私ハアノ可哀想ナ老人ノ骨ヲ今モナオ地下デ蹈ミツケテイル」ト思ウコトヲ禁ジ得ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハコレマデ決シテ必要以外ノ部分ヲ見タリ触レタリシタハ今モナオ疑問ダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "間モナク僕ハ眠ッタラシカッタガ、夢ノ中デモナオ妻ガ二重ニ見エタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして私には「今日モナオ時代オクレナ舊道徳ヲ重ンズル一面ガアリ、或ル場合ニハソレヲ誇リトスル傾向モア」ったのである。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
