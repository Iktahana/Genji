  {
    "uuid": "a85309a7-864e-5339-95e0-a48c5d3a7a68",
    "entry": "モッケ",
    "reading": {
      "primary": "もっけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
