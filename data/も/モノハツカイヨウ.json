        "examples": {
          "standard": [
            {
              "text": "古くなって捨てようかと思っていた空き瓶も、花瓶にしてみれば綺麗で、まさに物は使いようだね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "この機能は一見不便に思えるが、物は使いようで作業効率を劇的に上げることもできる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "壊れかけの道具でも、物は使いようでまだしばらくは現役で活躍してくれそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "手ぬぐい一筋でも箸一本でも物は使いよう次第で人を殺すこともできれば人を助けることもできるのは言うまでもないことである。",
              "citation": {
                "source": "さるかに合戦と桃太郎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
