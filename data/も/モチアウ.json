        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昼過ぎになっても、日経平均株価は前日終値付近で持ち合っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "午前の為替市場は、1ドル150円台半ばで持ち合う展開となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "売りと買いが拮抗し、相場はしばらく持ち合うと予想される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "to share (e.g. the expense)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
