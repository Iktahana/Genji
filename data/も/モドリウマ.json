        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "阿部街道を戻り馬が、遥に、ヒイインと嘶く声。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、同じ事を、これ、（旦那衆戻り馬乗らんせんか、）となぜ言わぬ。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸大名諸公役が通行のおりの荷物の継立ては言うまでもなく、宿人馬、助郷人馬、何宿の戻り馬、在馬の稼ぎ馬などの数から、商人荷物の馬の数まで、日々の問屋場帳簿に記入しなければならない。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "暑い、この頃の陽の下を旅する人は少いから、戻り馬も通らなかった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "戻り馬らしく、から馬である。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
