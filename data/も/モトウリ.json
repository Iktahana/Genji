        "examples": {
          "standard": [
            {
              "text": "この野菜は、産地からの元売りなので新鮮で安い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "石油の元売り価格が上昇し、ガソリン価格に影響が出ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "農家は、消費者に直接販売する元売りを増やしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "この画、一年に一万二三千元売れると言えば、喇嘛画師の収入も莫迦にならず。",
              "citation": {
                "source": "北京日記抄",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の一つをあげて見ると、数年前のこと都下の某百貨店で、七月の中元売出しを控えて角砂糖の特価販売をした。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "中元売出しを目の前にしてたくさん仕入れた砂糖が、これでは客を百貨店に取られて、どこもみな品を持ち越さねばならない。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "全館中元売リ出シノ最中デ、相当ニ雑踏シテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
