        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "エミール・ベルナールとロートレックとベルト・モリソウ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルト・モリソウは富裕な夫を持った四十四、五歳の女画家で、ハデで上品な身なりと美しい顔のために、三十歳ぐらいにしか見えない。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロートレックさんと、ベルナールさんと、あの奥さんは何とか言ったっけ――タン　モリソウの奥さんだよ、ベルト・モリソウ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンギイその方へ寄って行き）これは、いらっしゃいまし、モリソウの奥さん、良いお天気でございますな。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（モリソウは笑っている）ただで貰っても迷惑と言うしろものさ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（所内を見わたして、ロートレック、ベルナール、ベルト・モリソウ、タンギイなどを目に入れるが、別に目礼もしないで、売台の所のおかみを見て、初めて微笑）やあ今日は、クサンチッペ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "テオ　ありがとうございます、モリソウの奥さん。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（けげんそうにゴーガンを見るが、相手が冗談を言っていると思って、モリソウとタンギイとともに笑い出す）ベルト　でも、なんじゃありません、テオドールさんのお兄さんに対するお気持は、あたし、わかりますわ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡す拍子に、カンバスの表がわきにかけていたベルト・モリソウの肩をこする）ベル　あら！",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィン　どうも、これは、失礼しまして、モリソウさん、あの――ええと――（あわてて、ベルトの肩を掴んで、自分のナッパ服の袖で拭き取ろうとする。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現にロートレックさんもベルナールさんもモリソウさんも、あなたの絵を認めています。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たった今さっきも、この絵を、モリソウの奥さんなど、綺麗だって、そりゃあなた――ヴィン　モリソウさんは、ありゃ君、絵は描くが、結局は金持の奥さんで、僕らの行き方とは違う。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
