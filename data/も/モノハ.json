  {
    "uuid": "6c6e615c-1703-5456-ba8d-c1dfcd8c2922",
    "entry": "モノハ",
    "reading": {
      "primary": "ものは",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カモノハシという動物に酷似していると言った友人がありました。",
              "citation": {
                "source": "小さいアルバム",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人間ノ浮生ナル相ヲツラツラ觀ズルニ、オホヨソハカナキモノハ、コノ世ノ始中終マボロシノゴトクナル一期ナリ、――てれくさくて讀まれるものか。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アソコヘ　ユケバ　タベモノハ　アル。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチノ　上ニ　ヒカツテ　ヰタ　モノハ、ナクナツタ　ホシデハ　ナクツテ、ガラスビンノ　カケラダツタノデス。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロデ、ソノ　ムラハ　アサニ　ナツテモ　ダレモ　オモテニ　デテ　クル　モノハ　ナク、マドサヘ　アケナイノデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "センサウノ　タメニ　ワタクシタチハ　ハタケヲ　アラサレ、タベル　モノハ　ナクナツテ　シマヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナノ　モノハ　タメイキヲ　シテ　カホヲ　ミアハセマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ミンナハ、カゲト　イフ　モノハ　タイヤウガ　ツクルノダト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ此ノ場合ニ於テ國家ハ別途其ノ父ニ對シテ賠償ヲ命ジ、從ハザルモノハ勞働ヲ課シテ賠償ニ充テシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ現時ノ對鮮策ナルモノハ甚ダシク英國ノ植民政策ヲ摸倣シタルガ故ニ、根本精神ヨリシテ日韓合併ノ天道ニ反スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "何トナレバ右ノ九人ノ人間ガ死ンダ事件ノ裏面ニ潜ム恐ロシイ爆弾売買ノ真相ヲオ話シ出来ルモノハ、私一人シカ居リマセンカラ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコノウチノ人ハドレモミンナビンボウ人バカリナノデ、ビンボウナモノハミンナヨリアツマラナケレバ、カワイソウナモノダ、ト云ッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、ヒラガナトイウモノハ、元来毛筆ナラビニ和紙トイウモノトトモニ育ツテキタモノデ、ソレラヲ離レテハホトンド生命ノナイモノト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "）三、ヒラガナトイウモノハソノ素性ヲ探ルト、イズレモ漢字ヲ極端ニ崩シタモノニスギナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニイマ一ツ活字トイウモノハ歯ギレガヨクナクテハイケナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "永イ習慣ノ力トイウモノハバカバカシク強イモノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二読会において延期派の小沢武雄君の発議により、前記の原案に「但シ修正ヲ終リタルモノハ本文期限内ト雖モ之ヲ施行スルコトヲ得」という但書を追加せられ、結局本案に付き採決の結果は、延期を可とする者百二十三、断行を可とする者六十一で、延期派の大勝利に帰した。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが真実に子供たちの運命を予言しうるものとすれば（実験の結果によれば――と当代の心理学者が権威をもって発表する）コノ指数ニ満タザルモノハトウテイ社会有用ノ人間タルコトヲ得ズ。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカル未知電波ノウチノアルモノハ、時ニ雑音トイウ名ノモトニワレワレニ知ラレテイル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「千二ヨ、タズネルモノハ、コノサキニアル。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生はなほこれらの史料を過信することを戒められ、兎モ角モ人間ノ眼デ見タ證據程當テニナラナイモノハナイトイフ、心理學上ノ事實ハ、吾々ノ忘レテナラナイ誡デアル。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（姉サント云ウモノハ怪シカラント思イマス。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ甘ジテ之ヲ為ス所以ノモノハ洵ニ国家生民ノ為ニ図リテ一片ノ耿耿竟ニ忍ブ能ハザルモノ有レバナリ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々ニシテ其ノ好ム所ハ異ナレドモ、書画鼎鐺偶像貨幣ノ類、其ノ質ノ金石木磁絹紙タルヲ問ハズ、古物ホド面白キモノハ有ラジ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "必ズ幾百幾十年、某帝ノ世ニ造リ何人ノ作ニ係ル等ハ、决シテ臆断ス可キニ非ラズ（確証有ルモノハ此例ニ非ズ）。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ我邦ニハ是レ迄公私トモニ、古物館ト云フモノハ一宇モ無シ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ文士才人ヲシテ長ク魂銷シ腸摧ケシムルモノハ特リ馬嵬ト青塚トニ在リ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ニ列スルモノハ古貨幣ナリ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼汝ノ吾徒ニ幸スル所以ノモノハ、即チ吾徒ニ禍スル者ト謂フモ亦タ不可ナル莫ランカ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
