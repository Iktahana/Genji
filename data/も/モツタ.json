          "literary": [
            {
              "text": "……ノンキだね、ゼイタクだね、ホガらかだね、モツタイないね！",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナニ　ヤサシイ　モノガ　花タチノ　オソロシク　オモツタ　ウマダツタノデシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ソコヘ　ヨコブヱヲ　モツタ　ヒトガ　チカヨツテ　キテ、「オヤ、オマヘハ　マヒゴノ　タケノコダネ」ト　イヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミズグルマノ　マワツテ　ヰル　ソバデ　パンヲ　モツタ　ヒトリノ　ヒヤクシヨウニ　アツタノデ、「オイ　コヒツジト　パント　トリカヘツコ　シナイカイ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸開府以來、諸國人が多く集まつたが、これらが尋常なキモツタマでないこと、その人たちのつくつた市井は、デモクラチツクなものであり、むさし野の空つ風は、それらの人を吹き晒しあげた。",
              "citation": {
                "source": "初かつを",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハモンコチヤンヲイヤダナンテオモツタコトヲ心カラコウクワイイタシマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボクハ　オホキナ　カゲヲモツタ　コイヌダ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イマニ　モツト　オホキナ　カゲヲモツタ　オホイヌニ　ナルンダ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンガ　オツムノナカデ　クルクルマハツテ　パチント　コワレタノヂヤナイカト　オモツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            }
          ]
        }
