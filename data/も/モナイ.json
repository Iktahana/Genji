        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十秒三、デモナケレバ、五デモナイ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから蛸と同類で、現世界には化石となってのみ蹟を留むるアンモナイツは、漢名石蛇というほど蟠いた蛇に酷似いる。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "この女の全身の肉体美と、痛々しい黒血を噛み出した乳房とを一所にして、明るい光線の下に晒してみたら……というようなアラレモナイ息苦しい願望が、そこいら中にノタ打ちまわるのを押し止めることが出来なくなったのであった。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "『……シネバ……シネバ……何モイラン……何デモ遣ルガ……何モナイゾ……』『ホンナ事に呉れるか』『……ウム。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナッテ、又ムネイタイノ、トキクト、ダマッテ目ヲツブッテ、ソレカラムネナンテ何ンデモナイ、ト云ッテ、君チャンノカオヲ見、何ンベンモソットナミダヲフイテルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "タトエバ我々ノ映画事業ニシテモ、何カ会ダノ組織ダノガデキルタビニ、ズラリト重要ナ椅子ヲ占メラレルノハ、必ズ、全部ガ全部映画ニハ何ノ関係モナイ人バカリデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイヘン突拍子モナイコトヲ言イ出シタヨウニ思ワレルカモシレナイガ、少シ落着イテ考エテミルナラ、別ニ奇抜ナコトデモ何デモナイコトガワカル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ事実ガ右ノ調和ウンヌンニ深イ関係ヲ持ツコトハイウマデモナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "七、活字ノヒラガナヲ廃止シテモ文化的ニ何ラノ損失モナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ハ蒙昧ノ　露ハナル領域ニサヘ驕ルスベモナイ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田、石原、富永、平川、魚住、村瀬、奥屋、鬼頭ナドハ、何レモ特別ニ眼ヲカケタト云フ訳デモナイノニ、士官学校又ハ兵学校ニ入学シテカラモズツト遊ビニ来ルシ、古イトコロデハ退職後マデ機嫌ハドウカトタヅネニ来テクレル有様ダ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "古風ナ人情トモ云ヘルガ、嬉シクナイコトモナイ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "モーフィリテスやアンモナイトが、のそのそと動きまわっていた。",
              "citation": {
                "source": "地底獣国",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "題は「やまのいもハ薯蕷デモ山薬デモナイ」であって詳しく、その事由を図入りで説明しておいた（『牧野植物学全集』第六巻に転載）。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは昭和二年（1927）十二月三十一日発行の『植物研究雑誌』第四巻第六号での「やまのいもハ薯蕷デモ山薬デモナイ」であった。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何事につけ、異様でミットモナイ事があまり永くつづくことを好まぬ人も、まだかなりいるから。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンナ二流芝居」「イヤソウ云ッタモンデモナイサ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モアノ若サデアノ大役ヲスルノデアルカラ無理モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ暑イノニ、予ハトテモソンナコトヲスル気ハナカッタガ、外ニコレト云ウ治療法モナイカラ、マアヤッテゴランナサイト杉田氏ハスヽメル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモノコトデ珍シクモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ外ニ書クコトモナイカラ、コンナ時ニ少シ心ニアルコトヲ記シテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラ生ニ執着スル気ハ少シモナイガ、デモ生キテイル限リハ、異性ニ惹カレズニハイラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "上顎ト下顎トニ自分ノ歯ハ一本モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "附ケ目ニ乗ジテドウスルト云ウ資格モ実力モナイケレドモ、安心シテ美人ノ傍ニ寄ルコトハ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ッテ尿量ガ多ク、夜中ニ二回カ三回ハ起キルガ、ソノタメニ寝ソビレテ眼ガ冴エルナンテコトハ一度モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコレ以上生キナガラエテイタトコロデ格別ノコトモナイノダカラ、モシ今ノ世ニオ伝ノヨウナ女ガ現ワレタラ、ムシロソノ女ノ手ニカヽッテ殺サレタ方ガ幸福カモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉ニデモ行ッテ貰ウサ」「御自分デ御覧ニナラナクッテモイヽンデスカ」「コノ暑イノニコノ体デハ行ケソウモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰ニ読マセルタメデモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "視力ガ恐シク衰エタノデ、読書モ思ウニマカセズ、他ニ消閑ノ法モナイカラ、ヒマツブシニイクラデモ書ク気ニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
