        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コレカラモアル事デス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「二人殺シタ親モアル。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（中略）私ノ町ノ知的素養ノイクブンナリトモアル青年デモ、自分トイウモノニツイテ思イヲメグラス人ハ少ナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サモアルは空つぽでペチカは燃えず、されば新劇林のごとく静かなる部屋にかかる小沢の喧騒な演技もまた情熱の現れか？",
              "citation": {
                "source": "小熊秀雄全集-13",
                "author": "詩集（12）その他の詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しどこの國にも澤山あるメモアルなんぞといふものは、用心して讀むべきものであらう。",
              "citation": {
                "source": "長谷川辰之助",
                "author": "森林太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家生産ノ勞働者ニ利益配當ヲ用ヒザル所以ハ、國家ハ全生産ノ永遠的經營ヲ本旨トスルガ故ニ、全國家ノ生産的活動ノ爲ニ或省ニハ殊更ニ投賣ヲ行ハシメテ損失ヲ顧ミザルコトアル如ク、或ル省ヲ犧牲トシテ或省ノ對外競爭ヲ專ラナラシムルコトモアルベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ母ッチャハワザワザ三町モアルイドニ、四ドモ五ドモ水ヲクムニユクノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゾラ『アソンモアル』、クロポトキン『パンの略取』、アラトウ『無政府主義の哲学』、『荘子』、『老子』、『家庭雑誌』、『日本エスペラント』。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ見タトコロデモ死骸ハ大概同ジヤウナ形ニナツテヰタ頭ガヒドクフクレ　顔ハマル焦ゲ　胴体モ腕モケイレン的ニフクレ上ツテヰル　火傷者ノ腕ニ蛆ガ湧イタリスル　十三日後ニナツテモ広島市デハマダ整理ノツカヌ死骸ガ一万モアルラシク　夜ハ人魂ガ燃エテヰルト云フ。",
              "citation": {
                "source": "原爆被災時のノート",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "トハ云ウモノノ、女ヲ盗ムニハ姙婦ニ限ルトユウ話モアルカラ、安心ナラン――ほほう、亡くなった貴女さまのお父さまは、この赤沢常造という男を大分気にしていらっしゃるようですが、これはどんな関係の方でございましょうか」「その赤沢というのは、伯父さんだと憶えています。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノ中ニハ可也信用ノ置カレルノモアリ、又可也怪シイモノモアルガ、此點ニ就テハ一切私見ヲ加ヘルコトナシニ、其儘ヲ採録シタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂有名婦人のメモアルなどではなく、例えば病弱者としての生活や何か。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの或ものは、自分のメモアルの一頁に、オーエンと彼のニューナアックに熱中した頃の自分を皮肉に回想していないと、誰が云えよう。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デタラスグカエレイエノヨウイモアル。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "近世人心浮薄ニシテ、父祖ノ詩モアルイハコレヲ刻セズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ヤ、ヤ、山ナンカ、キョウガ、ハ、ハ、ハジメテナンダ……アタシニハ……カミサンモ……コ、コ、小供モアルンダヨー。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいら川ヨリ越中国立山ノ信濃堂ナトイフ所見ユ、山伝ヒニ立山マテ五里許リモアルヘキナリ、是ヨリ越後越中信濃三国界マテノ中モ国境分明ナラス。",
              "citation": {
                "source": "後立山は鹿島槍ヶ岳に非ざる乎",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "入梅中ハ湿気ガ多イノデソノセイモアルガ、去年ノ入梅中ハコンナデハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今デハ女ヨリモ仕事ノ方ガ面白クッテ溜ラナイラシクモアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔ハ随分熱烈ナ仲ダッタ時代モアルノニ、飽キッポイノハ親譲リカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "痛イナンテ嘘デショウ」ト云ウ人モアルガ、嘘デハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾ痛イノガ激シイ時トソウデナイ時トアリ、一定ノ状態デ持続セズ、全ク痛マナイ時モアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少クトモコンナ生殺シノヨウナ手足ノ痛ミヲ怺エナガラ生キテイルヨリ、ヒト思イニ残酷ナ殺サレ方ヲシテ見タクモアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ幾分予ガケシカケテ、左様ニシムケタ気味合イモアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンカラアンナ注意ヲ受ケタタメニ、却テ神経質ニナッテ、気ニシテイタセイデモアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝夕ノ散歩ハ佐々木同伴、時ニハ颯子ノコトモアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階ニハ泊リ客ノタメノ室モアルガ、ドコデ彼等ハ涼ンデイルノカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間モモウコウナッチャ哀レナモノサ」「自分ニ希望ガ持テナイカラ焼ケ糞気味ニナルノネ」「岡焼キ気味デモアルサ、不便ト思ッテクレ給エ」「巧ク云ッテルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ静ニ算盤ヲ弾カセテイルコトモアルガ、大概ハ颯子ガ自ラシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
