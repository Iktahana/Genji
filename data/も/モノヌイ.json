        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お岩はそこで喜兵衛に口を利いてもらって、四谷｜塩町二丁目にいる紙売の又兵衛と云うのを請人に頼んで、三番町の小身な御家人の家へ物縫い奉公に住み込んだ。",
              "citation": {
                "source": "四谷怪談",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "物縫い奉公に住み込んだお岩は、伊右衛門のことを思い出さないこともないが、それでも心は軽かった。",
              "citation": {
                "source": "四谷怪談",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十七日　罹災民に送ろうと思う着物縫いにかかる。",
              "citation": {
                "source": "大正十二年九月一日よりの東京・横浜間大震火災についての記録",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
