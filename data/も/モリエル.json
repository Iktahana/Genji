        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ところが、内容はモリエルの『タルチュフ』なんだよ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し大袈裟な引例ですが、シェクスピアとモリエルとを比べても、何んだかそんなように感じられます。",
              "citation": {
                "source": "又復与太話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モリエルが無智の老嫗に自作の台本を読み聞かせたと云ふは、何も老嫗の批評を正しとしたのではない。",
              "citation": {
                "source": "雑筆",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "成程世のつねの学者や批評家にも、モリエルの喜劇はわかるかも知れぬ。",
              "citation": {
                "source": "雑筆",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな消息に通じるには、おのれの中にモリエルその人を感じてゐなければ駄目である。",
              "citation": {
                "source": "雑筆",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
