        "examples": {
          "standard": [
            {
              "text": "彼のモノマニアックな知識の深さには、専門家ですら驚きを隠せない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "趣味が高じて、最近ではモノマニアックな機材ばかりを集めるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は特定のアイドルの衣装について、モノマニアックなこだわりを持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "おそろしく厳格に――時によってヒステリックにモノマニアックにさえ自分自身だけを愛する。",
              "citation": {
                "source": "恐怖の季節",
