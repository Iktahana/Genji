          "literary": [
            {
              "text": "雨でも降るとスッカリ雨戸を閉切ツて親子｜四人｜微暗い裡に何がなしモゾクサしていじけ込むてゐる。",
              "citation": {
                "source": "昔の女",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親は何やらモゾクサしてゐて、「私もナ、ひよツとすると、此の冬あたりは逝くやも知れンてノ。",
              "citation": {
                "source": "昔の女",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚だ洋燈も灯さずにあツて、母親は暗い臺所で何かモゾクサ動いてゐた。",
              "citation": {
                "source": "昔の女",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前は三度三度無駄飯を食って、毎日毎日モゾクサしてるばかしじゃねえか。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
