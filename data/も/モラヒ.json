        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "キイテ　タイソウ　ヨロコンデ「ヨシヨシ　ワタシモ　コノコブヲゼヒトモ　トツテ　モラヒマセウ」　と勇み立つ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゴカキ新美南吉　ツキヨノ　マツナミキノ　ミチデ　一リノ　サムライガ、ウシロカラ　ハシツテ　キタ　カラノ　カゴニ　ノセテ　モラヒマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ソコデ、カヘルサンハコホロギサンノ足ニ綱ヲツケテ、木ニノボツテモラヒマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクル朝、ボンコチヤンハ、ボーイサンニ「バウシノオ父サン」ノオ家ヲキイテ、トコロトバンチヲカイテモラヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマリヨクニアフノデ、オ母サンハ山羊ノ写真ヤサンヲヨンデ、キネンノ写真ヲトツテモラヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンノ写真　ケンシヤウモンコチヤンハ　ダレニ　シヤシンヲ　トツテ　モラヒマシタカ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "吸付け煙草の風習は、たしかに古来のモラヒ、すなわち共食の心理と関係がある。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち新しい色町のモラヒに該當するもので、之を拒絶しようとする前の客は、それから餘分の花を拂はされる。",
              "citation": {
                "source": "瀬戸内海の島々",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日から右眼にモノモラヒが出来て重っ苦しくて困る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "モノモラヒがまだ治り切らず、憂鬱だ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の眼のモノモラヒ全快。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミス・コロ来り、夫婦と並んで写真を撮り、中根眼科へ行く、モノモラヒを潰して貰ひ薬をさす、昨日が二円、今日五十銭、とは眼医者とは安いものだな。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
