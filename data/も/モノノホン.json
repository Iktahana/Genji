    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかし意地のきたない動物の本能として、絶えず路傍の青草を食ひ散らしながら。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はアリストテレス的没主観の認識で、事物の本相に深く透入しようと考えている。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは動物の本能的な悲哀のように、語るすべもなく訴えるすべもない。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の人物の本質には、何とも言語につくせないナイーヴさがある。",
              "citation": {
                "source": "室生犀星に與ふ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかり万事万物の本源を握る者は神の御手である。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし科学者には没交渉であるはずの物の本性に立ち入ろうとする人間自然の欲求は更に電子は何かという疑問を発して止まぬのである。",
              "citation": {
                "source": "物質とエネルギー",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由に達して始めて物の本末を認識し、第一義と第二義を判別し、末節を放棄して大義に就くを得るということを説いたのには第百十二段、第二百十一段などのようなものがある。",
              "citation": {
                "source": "徒然草の鑑賞",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分に必要なものを選択して摂取し、不用なもの有害なものを拒否し排出するのが、人間のみならずあらゆる生物の本性だということは二千年前のストア哲学者が既に宣言していることである。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "……が、なぜか、物の本の古びた表面へ、――来れや、来れ……と仮名でかきちらす形がある。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは誰でも、人から非難せられたり、怒られたりしていい気持がするものでは無いかも知れませんが、自分は怒っている人間の顔に、獅子よりも鰐よりも竜よりも、もっとおそろしい動物の本性を見るのです。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あなたにお貸しした化物の本のなかに、こんな絵があったのを御存じですか。",
              "citation": {
                "source": "橡の花",
                "author": "――或る私信――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一口に言うと、物の本性を見破る心の働きです。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この万物の本体、本性を突き止める心力、これを「慧」と言います。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらはそういう自我の主観的な感情の動きをさすのではなくて、事物の表面の外殻を破ったその奥底に存在する真の本体を正しく認める時に当然認めらるべき物の本情の相貌をさしていうのである。",
              "citation": {
                "source": "俳諧の本質的概論",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして枯れ枝から古池へと自然のふところに物の本情をもとめた結果、不易なる真の本体は潜在的なるものであってこれを表現すべき唯一のものは流行する象徴による暗示の芸術であるということを悟ったかのように見える。",
              "citation": {
                "source": "俳諧の本質的概論",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この哀れとおかしみとはもはや物象に対する自我の主観の感情ではなくて、認識された物の本情の風姿であり容貌である。",
              "citation": {
                "source": "俳諧の本質的概論",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "芭蕉は万葉から元禄までのあらゆる固有文化を消化し総合して、そうして蒸留された国民思想のエッセンスを森羅万象に映写した映像の中に「物の本情」を認めたのである。",
              "citation": {
                "source": "俳諧の本質的概論",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち之を分類すれば、徳川初期のは強い圧迫に対する強い反抗の体現であつて、其の物の本当の意味からすれば、強い者に当る必要上真実に強きものたるを主とするは勿論であるが、真実に於ては寧ろ啻に強いことを見得として居る様な傾きのあつた、やゝ虚栄的衒耀的のものであつたらしい。",
              "citation": {
                "source": "侠客の種類",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋し其の物の氣は即ち其の物の本體と同一にして、恰も本體の微分子なるが如く、一にして而して二、二にして而も一、氣あれば必らず物あり、物あれば必らず氣あり、氣と物と相離るれば則ち物既に物たらず、物と氣と相失へば則ち氣既に氣たらず、氣は即ち物より生ずるの物にして、物は即ち氣の本づくところの氣である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "その物の気は即ちその物の本体と同じで、まるで本体の微分子ようで、一にして二、二にして一、気あれば必ず物あり、物あれば必ず気がある。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "良知を働かせなければ定規を捨てて長短を測り、コンパスを用いずに方角を測るようになり、道理を究め物の本質の求めても、障害が増すだけである。",
              "citation": {
                "source": "一貫章義（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "書物の本質が決定的に変化するまでには、本を変えることを恐れなかったいく人もの出版人による発見の積み重ねが必要でした。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "書物の本質は、言葉によって綴られるこの物語を、一まとめにしておさめておく器です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで物の本など読んでみると、ＩＢＭのビデオ規格の一つなどと書いてある。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
