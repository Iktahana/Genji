  {
    "uuid": "7d228998-2987-597b-9f15-06beb4295c4f",
    "entry": "物の本",
    "reading": {
      "primary": "もののほん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
