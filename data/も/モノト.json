        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "将軍家も流石に御不興気のお顔をなされ、何もおつしやらず、さつさと御判をたまはり、相州ハ、マダ、死ニタクナイモノト見エル。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその靴底から傳はつてくるモノトナスな響が、みんなの聽覺を擽るやうに刺戟した。",
              "citation": {
                "source": "猫又先生",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイ・ニード・サムバディ」というジョンの声が入り、モノトーンの画面に、大きな指輪をしたリンゴの右手が映しだされると、あちこちから歓声があがり、たいへんなことになった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "真っ白なジャケットに Beatles と書いてあるレコードと、黄色い地に黒インクのみのモノトーンの絵をはりつけたレコードをもって、カウンターに近づこうと悪戦苦闘していた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ母其人ノ生活ハ母自身ノ維持スベキモノトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ女學校特有ノ形式的課目女禮式茶湯生花ノ如キ又女子ノ專科トセル裁縫料理育兒等ノ特殊課目ハ全然廢止スベキモノトナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フカイアサジナルモノトウチニナシ」　課長は呆気にとられて、電報を刑事に渡した。",
              "citation": {
                "source": "鉄の規律",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、ヒラガナトイウモノハ、元来毛筆ナラビニ和紙トイウモノトトモニ育ツテキタモノデ、ソレラヲ離レテハホトンド生命ノナイモノト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ時主人ハチャント私ガワカッテ居タヨウデアリマシタカラ、勿論私ヘ伝エタモノト思イマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やむを得ず杜は、名刺を一枚だして、それに日附と時間とを書きこみ、それから裏面に「横浜税関倉庫ハ全壊シ、着荷ハ三分ノ二以上損傷シタルモノト被存候」と報告を書きつけた。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ金網面ニハ更ニ生芋ヲ入替ウルモノトス。",
              "citation": {
                "source": "発明小僧",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯粒ノ附着セサル弁当箱ハ特許スヘキモノトス。",
              "citation": {
                "source": "科学時潮",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "種を明かして仕舞えば何でもないが、兎も角も「飯粒ノ附着セサル弁当箱ハ特許スヘキモノトス」は愉快な文句ではないか。",
              "citation": {
                "source": "科学時潮",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ犯跡ヲ完全ニ抹殺スベキモノトス。",
              "citation": {
                "source": "人造人間殺害事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "『本願ハ左記理由ニ仍リ拒絶スベキモノト認ム。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "意見アラバ来ル×月×日迄ニ意見書ヲ提出スベシ』　と、あっさり殺し文句があって『左記』のところには、『本願ノ要旨ハ、義手ヲ人体ニ添架スルニ在ルモノト認ム。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ本願出願以前、帝国領土内ニ於テ、義手或ハ義足ガ公然製造使用セラレタルコトハ、例エバ明治三十九年東京市下谷区御徒町仁愛堂発行ノ「義手義足型録」ニ依リテ公知ノ事実ナリ、仍リテ本願ハ特許法第一条ニ該当セザルモノト認ム』　と、拒絶理由が述べてあった。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "愕いて、これを読み下すと、拒絶スベキモノト認ムという主文は同じで、その理由としては、次のようなことが綴られていた。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それによると、『本願ノ要旨ハ、一個ノ人体ニ、三本又ハ三本以上ノ多数ノ腕ヲ添架スルニ在ルモノト認ム。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "仍リテ本願ハ其ノ出願以前ニ於テ、公知ニ属スルヲ以テ、特許法第一条ニ該当セザルモノト認ム』　審査官は、千手観音を持ち出して、この出願を一蹴したのであった。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "仍リテ両者ハ根本的ニ構造ヲ異ニスルモノト謂フベク、従テ本願ハ、援用立像ヲ以テ拒絶セラルル理由ヲ発見シ得ザルモノナリ。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "公告決定通知本願ハ拒絶ノ理由ヲ発見セザルヲ以テ、公告スベキモノト決定セリ　輝かしい日だ、雪は降りしきっているが……。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとは、その点の価値が分らなかったから、彼の描く性格の単調なところ、殆どモノトナスなところ、がひどくいやでしたが。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月九日（水曜）　生活がモノトナスだと云うことがひどく苦しく、頭を疲らせ、仕事の量が少ない。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ並べてあるとややモノトーンなり。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタ、ホントニアタシガカワイイナラ、コノテガミツキシダイ、ヨルノ七時マデニ、イツモノトコロヘキテチョウダイ、キット、キットヨ、デワ　サヨナラ　　　　コイシキコイシキペテロフサマ　シブヤにてアナタノトヨ子※」　それは、いかにも滅多に手紙など書く必要のない女の字であった。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二条　土地ハ一切ノ（公然タル若クハ隠蔽サレタル）賠償ナクシテ今日限リ全労働大衆ノ使用ニ帰スルモノトス。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
