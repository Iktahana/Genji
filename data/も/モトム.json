        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は真理の道を求むべく、生涯を捧げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "多くの探求者が、未知の財宝を求むて荒野を彷徨った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "知識を求むる心は、人間を進歩させる原動力となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
