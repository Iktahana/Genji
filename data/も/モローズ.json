          "literary": [
            {
              "text": "五日　ひどいモローズ　プーシュキン・ブル※ールの樹木が皆真白になった。",
              "citation": {
                "source": "一九二七年八月より",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はひどいモローズ〔厳寒〕の由。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月三日（金曜）モローズ　夜七時から、深い霧がかかった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月四日（土曜）ひどいモローズ。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月五日（日曜）モローズ　中島さん、網野さん、関さん、軽部さんへ手紙ハガキを書いた。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月六日（月曜）モローズ　○Ｙと二人、ニキーチナさんの家に行く。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月七日（水曜）モローズ　夜、痒いので目がさめた。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月二十二日（水曜）モローズ　鞣の手套を（Ｙに御誕生日に貰った）はめて居ると手がかじかんで覚えがなくなる。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "モローズの最後で、寒し。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどいモローズ、迚もひどいモローズ！",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "本物の「赤鼻のモローズ」がモスクワの街へ降りた。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
