          "literary": [
            {
              "text": "『ラ・ドンナ・エ・モビレ』などと来た日には全くたまりませんからね。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ラ・ドンナ・エ・モビレ』でなければ良い歌でないと信じている人や、マッコオマックやスキーパでなければ、興味を感じ得ない人は別だ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "『浄きアイーダ』と『ラ・ドンナ・エ・モビレ』には電気更生盤もある。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「金色」の時稍調子苦しく、ラドンナモビレなどいけなかったので、まっすぐ帰り、吸入する。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
