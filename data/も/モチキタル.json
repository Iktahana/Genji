          "literary": [
            {
              "text": "（春彦は細工場に走り入りて、筆と紙などを持ち来たる。",
              "citation": {
                "source": "修禅寺物語",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "遣ってみ給え」客「色々ドウも忙がしくって食べ切れない」と頭を挙ぐる暇もなきにお登和嬢が台所へ往きてチョコレートと蜜柑のジャムを持ち来たる「小山さん、これはココアでなくって上等のチョコレートへクリームを加えたのですから召上って下さい。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくと知らば旋条銃を持ち来たるべかりしに……」と、われは言いぬ。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "妖物",
                "note": "青空文庫"
              }
            },
            {
              "text": "食物など外より持ち来たるを見れば町へも出ることならん。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "神セト（またはタイフォン）は悪を代表し、疫病を持ち来たる。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
