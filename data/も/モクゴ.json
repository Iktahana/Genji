        "examples": {
          "standard": [
            {
              "text": "騒がしいパーティー会場の片隅で、二人は言葉を交わさず、目語だけで気持ちを伝え合っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "長年連れ添った夫婦は、互いに目語で通じ合うことができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "大事な商談の最中、私たちは目語で合図を送り、作戦を確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "三人は互に目語して身を起し、刀の※に手を掛けて抽斎を囲んだ。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
