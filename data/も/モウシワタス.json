    "definitions": [
      {
        "index": 1,
        "gloss": "to tell",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "裁判官は被告に懲役5年の判決を申し渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "校長は全校生徒に対し、新学期の心構えを申し渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "父は遺言で、財産の分配方法を家族に申し渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "追って、申し渡す事があります。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかしなんといっても、」とゲエテは、エッケルマン氏に溜息ついて結論を申し渡すのである。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「運よく召しとって、奉行所へ突き出せば、奉行はじめ狼狽し、やがてその狼狽をかくすために、やい、首のなき者よ、汝盗賊を働かんとせし罪科軽からず、速刻打ち首に致すとあわてて申し渡すに相違ない。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日各々から申し出た肥後の国守の儀は、近きうちに改めて申し渡すべきは、各々もよく存じ居るべき筈ぢや。",
              "citation": {
                "source": "茶話",
                "author": "初出未詳",
                "note": "青空文庫"
              }
            },
            {
              "text": "所が君、ゆうべ塾生一同に申し渡すことがあると云つて呼んだ、あの時の事だね。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは御隠居様がお直に仰せ渡される筈であるが、御所労のため拙者が御名代として申し渡す。",
              "citation": {
                "source": "堺事件",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "社員一同を廊下にひれ伏させて、事業一切神の手にうつった旨を申しきかせ、社員は同時に信徒たり、下僕たる旨をも申し渡す。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ただいま駿河守は登城中であるから、自分が代理としてこれを申し渡す。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "大判事エガアトンがいうに、自分たちは女王の上使として、この集合はなんのためであるかを聞き、かつ、もしこの集合が、何者かに対するなんらかの不満に発するものならば、その不満の申立てのいっさいを聴取し、相当の判決が与えられなければならぬことを申し渡すためここに派遣されたものであると。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがいよいよ延ばせなくなったわけで、その沙汰を申し渡すことになったのだが、老職たちの中から誰が云いだすともなく、十太夫を江戸へやるなら土田も江戸へやらなければなるまい、という説が出た。",
              "citation": {
                "source": "饒舌り過ぎる",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄さんは、今度こそ幸子ちゃんも私達の側に立って断然たる処置を取って欲しい、折角私達が決心したことだから、今度はぐずぐずにしてしまわないで、東京へ寄越すか、蒔岡家と絶縁を申し渡すか、今月中にどちらかにきめて報告してくれるようにと云っています。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "この裁決は、茂庭｜主水から申し渡す、という報告が来たのは、三月末のことで、甲斐はいちおうほっとした。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "山野の話は、もう明日あたり首を申し渡すのだと言ってゐる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そこで各※へ、改めて、申し渡す儀と、わしの希望を聞いてもらいたい」七　――自分はきょう限り、道場から身を退こうと思う。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――今朝はいらん』二『――修業して来い、両三年』　突然、父の新五左衛門が、親類一同の相談を突きつけて、こう伜の弁馬に申し渡すのであった。",
              "citation": {
                "source": "御鷹",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんでたまろう解兄弟の調べもほんの形ばかり、拷問、爪印の強制、大牢送りの宣告と、わずか二日ほどのうちにかたをつけられ、「いずれ流刑の地は後日申し渡す」　と、揚屋入りに附されてしまった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかのお手筈は」「いまそれぞれに役割を付けて申し渡す。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはり自分から申し渡すのかと、高時は、調法者の道誉を、うつろな中に思っていた。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時にも、将軍家に於いては既に御許容相成らずと決裁がすんでゐるのに、その御決裁を和田氏一族に申渡す憎まれ役だけはごめんなので、かうして何かとつまらぬ事をくどくどとおつしやつて、そのうち誰か、申渡しの役を引受けてくれるだらうとお心待ちになつて居られたのに違ひございませぬ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本一の不所存もの、恩地源三郎が申渡す、向後｜一切、謡を口にすること罷成らん。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍家から特別の御賞美をたまわっているだけに、かれの責任はいよいよ重いことになって、軽くても蟄居閉門、あるいは切腹――将軍家からはさすがに切腹しろとは申渡すまいが、当人自身が申訳の切腹という羽目にならないとも限らない。",
              "citation": {
                "source": "鐘ヶ淵",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "斎藤の後家さんは、その刑事から聞いた話に非常に憤慨して、大急行で帰って来た息子の医学士を、斎藤さんの霊前に引据えると、刑事の面前で、「ソンナ悪人の娘は、お前の嫁に貰う訳に行かぬ」　と涙ながらに申渡すという劇的シインが展開してしまった。",
              "citation": {
                "source": "無系統虎列剌",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし、こんどはもう、断然その絶交をこっちから申渡すんだ。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "県令島惟清（此時県の併合ありて岩手県）厳然訟廷に現はれ予に申渡す事ありとて、『其方儀、明治四年四月某日以来、江刺県大属木村新八郎暗殺の嫌疑を以、入獄申付吟味中に候処、此度証人等申立により、其方の嫌疑は氷解せり、爾来取調に及ばず、今日無罪放免を沙汰す。",
              "citation": {
                "source": "臨終の田中正造",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともかく、談と称し話と称するものは、あなたも喋れば、こちらも喋る、両々相談ずるうちに序論より出発して結論に至るもので、いきなり棒をひつぱるみたいに話のシメククリだけで申渡すんぢや片手落だな。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "万端最上清人の命令でなく、倉田支配人の指図によつて、これより万事店のことは新任の支配人が執り行ふから旧来の仕来りは一新する、店内の作法は支配人の許可なくして何事も行ふことはできない、天妙大神のゴセンタクも支配人にはミミズのタハゴトにすぎないのだから、と申渡す。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鬼が親類一同を集めて申渡すには、ただいまより親子の縁を切って加十を勘当するからには、もしも加十にひそかに情けをかける者はもはや親類ではなくてオレの敵だと思うからお前らもそう思えと云うたそうな。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二十　トンビ男",
                "note": "青空文庫"
              }
            },
            {
              "text": "デカルトの哲學に於ける物と心との關係の樣に、差別される存在と存在とに無限の別離を申渡すことではない。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高価のものの売買も当｜丑年限り停止触出し置きたれば、残りたる物は年内最早三日に相成り、形を替えるか、崩すとも仕舞切にいたすとも、来る寅年元朝よりは急度停止申渡す。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "大名も百万石もあり壱万石もあり差別を心得、これより万事正路質素に相心得、譬え木綿たりとも花美高価のものを取扱い致すまじく、相背く者これ有るにおいては不便ながら政事には替え難く、急度申渡す。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
