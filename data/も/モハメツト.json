        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それはモハメツトの四人の女人たちと交ることを許したのと同じことである。",
              "citation": {
                "source": "西方の人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは基督教、仏教、モハメツト教、拝火教なども行はれてゐます。",
              "citation": {
                "source": "河童",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸ひに我等の間にも基督教、仏教、モハメツト教、拝火教等の諸宗あることを忘るる勿れ。",
              "citation": {
                "source": "河童",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "モハメツト教徒は余りコオランの経文にある戒律なぞには頓着しない。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸上では舊約全書にある出埃及記に見ゆるやうな摩西の樣な人物でなくてはならず、普通世に流布するモハメツトの傳記に於て見るやうな、モハメツトのやうな人物でなくてはなりません。",
              "citation": {
                "source": "金剛智三藏と將軍米准那",
                "author": "榊亮三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
