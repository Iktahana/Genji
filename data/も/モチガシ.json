    "definitions": [
      {
        "index": 1,
        "gloss": "bean-jam cake",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
