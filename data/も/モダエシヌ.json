          "literary": [
            {
              "text": "それがどうもあの男の眼の中には、娘の悶え死ぬ有様が映つてゐないやうなのでございます。",
              "citation": {
                "source": "地獄変",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがどうもあの男の眼の中には、娘の悶え死ぬ有樣が映つてゐないやうなのでございます。",
              "citation": {
                "source": "地獄變",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は煙にまかれたとき悶え死ぬさきに死ぬつもりであり、私はことさら死にたいと考へてもゐなかつたが、煙にまかれて苦しむ不安を漠然といだいてゐた。",
              "citation": {
                "source": "続戦争と一人の女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で、おまえたちはもだえ死ぬのだ。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
