        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これも八ヶ岳山麓の月のある夕の小景で、カルサンといふ洵に響きのよい舶来語を使つて昔のもんぺ姿を抒してゐるのが面白い。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしのもんぺ姿は、丸さはともかくとして好評ですが、御感想いかが？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もんぺ姿でテコテコと出かけ、時間も考えたつもりでしたが、結局二時から三時すぎまで前で待避して、それで帰らなくてはなりませんでした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――すんだらしいわね」　もんぺ姿の小枝が蚊帳からにじり出て来て、さもうるさそうに頭をふり、頸のまわりから防空頭巾の紐をといた。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひろ子は、こまかい紺絣のもんぺ姿で、昔の女学生用編上靴をはいている。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひろ子は、あぶなっかしく床板ばかりになった敷居の上にもんぺ姿で立って、働いているうちは耳につかなかった雨音が、また一段劇しくなったのをきいていた。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "テニスコートをよこぎりながら、こちらへ手をふる二人のもんぺ姿がある。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人とももんぺ姿で、今朝から描いて今帰ったところだという話であった。",
              "citation": {
                "source": "壁画摸写",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新一と京子とはその四阿の板の腰掛けに国民服と甲斐甲斐しい紺飛白のもんぺ姿を並べて、眼前の眺望を擅にしながら語り合っているのである。",
              "citation": {
                "source": "偉大なる夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれほどの時がたったのか、ふと夢がさめたようにわれにかえって見ると、すぐ目の前の林の中に、いつの間に着更えたのか、もんぺ姿の京子の現実の姿があった。",
              "citation": {
                "source": "偉大なる夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時、藪原に入つた、一杯元気で福島へ急ぐ、途上、下げ髪モンペ姿の少女を見たとき、薙刀の一本をあげたいと思つた。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは人物の顔はいつも同じでそして着てゐるものが変つてゐるだけといふことは、さういふことになるのではないか、この化け物は『朱唇』では処女らしく手を膝の上に揃へてアドケなく化け、『麦拒』ではモンペ姿で働く農婦に化けてゐる。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "直吉は久しぶりに美しい花を見る気がして、暫くそこへつゝ立つてゐると、十分ばかりもして、里子が黒地に赤い矢絣のモンペ姿で出て来た。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへまた、燻製の顔をした、モンペ姿の婦人がやつて来ると、ハンドバツクを下に置きぐつたりと膝を伸した。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "溝にうつ伏せになつている死骸を調べ了へた巡査が、モンペ姿の婦人の方へ近づいて来た。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへまた、燻製の顔をした、モンペ姿の婦人がやって来ると、ハンドバッグを下に置きぐったりと膝を伸した。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "溝にうつ伏せになっている死骸を調べ了えた巡査が、モンペ姿の婦人の方へ近づいて来た。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁に凭掛つて汚れたモンペ姿の老婆が二人、脚を投出してゐた。",
              "citation": {
                "source": "災厄の日",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "給仕の女たちは、紺絣にモンペ姿の品行方正な少女だ。",
              "citation": {
                "source": "蛸の如きもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、俺のすぐ後からはいって来て、俺たちの問答を聞いていたらしい、モンペ姿の若い女が、低い声で女中に言った。",
              "citation": {
                "source": "ヘヤーピン一本",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いづれはハイカラなモンペ姿、粋な国民服も出ようといふものである。",
              "citation": {
                "source": "都市文化の危機",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンペ姿の少女が渋茶を注いで出す。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、それは悉くモンペ姿の女であつた。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　小川が、原口さんと呼んだのはたつた一人珍しく白いスーツに紺セルのズボンを穿いた娘で、ほかの連中の鄙びたモンペ姿と面白い対照をなしてゐた。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん古島さんはすつかり怖気をふるつてしまつて、姉さまの紫色のモンペ姿がちらりと見えようものなら、血相かへて自分の部屋へ逃げこんでしまふのでした。",
              "citation": {
                "source": "死児変相",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎から汽車にゆられてきた旅行用のモンペ姿で、白髪の姿をあらはしたのである。",
              "citation": {
                "source": "母の上京",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕立直しのモンペ姿もきちんとして、何やら四角な風呂敷包を背負つた様子は、買出しでなければ、自分と同じやうに行商でもしてゐるのかと思はれた。",
              "citation": {
                "source": "にぎり飯",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕立直しのモンペ姿もきちんとして、何やら四角な風呂敷包を背負った様子は、買出しでなければ、自分と同じように行商でもしているのかと思われた。",
              "citation": {
                "source": "にぎり飯",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "立派といふのは、東京に於ける過去の生活が立派であつたらうと思はせる人で、この日の奥さんは黒いモンペ姿で包を一つしよひ一つはぶらさげてゐた。",
              "citation": {
                "source": "軽井沢の夏と秋",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "老猟師の家をたずねますと、ちょうどおりよく例のモンペ姿の老人が居あわせて、駄菓子などのならべてある店先へ出てきました。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
