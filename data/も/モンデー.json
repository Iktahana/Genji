          "literary": [
            {
              "text": "「サーモンデー」と大きな字で印刷してある。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただこのごろの新聞紙上をにぎわすようないろいろの不祥な社会的現象は、それが大本教事件でも宝塚事件でも、すべてが直接これらの事件とはなんの関係もない南海の村落でこの「ナンモンデー」の廃止された事とどこかで連関していて、むしろそれの当然の帰結であるような気がする。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日になってもう大丈夫と思うと、今度は「イースター・モンデー」だというのでまた店をとじる。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日は「イースター・モンデー」なのでところどころで興行物があった。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
