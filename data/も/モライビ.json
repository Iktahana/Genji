    "definitions": [
      {
        "index": 1,
        "gloss": "catching fire (from a neighbouring house on fire)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
