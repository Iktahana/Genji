        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "隣家から失火し、風に煽られたもらい火で自宅まで全焼してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "商店街で火災が発生したが、迅速な消火活動によりもらい火は最小限に抑えられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「火の用心！もらい火を防ぐためにも、家の周りに燃えやすいものを置かないで」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「もらい火でよかった」と茂次は云った、「自火なら手がうしろへまわるところだ」　そして「魚万」を訪ねた。",
              "citation": {
                "source": "ちいさこべ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
