        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノトキ、ハルカ　トオク　ノ　ホウニ、ミドリ　ノ　ミズ　ガ、カギリナク　ヒロク　ツヅイタ　セカイ　ガ　ミエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜多八、さあ、其の氣で歩ばつしと、今こそ着流で駒下駄なれ、以前は、つかさやをかけたお太刀一本一寸極め、振分の荷物、割合羽、函嶺の夜路をした、内神田の叔父的、名を彌次郎兵衞といふ小田原通、アイお茶代を置いたよ、とヅイと出るのに、旅は早立とあつて午前六時に搖起された眠い目でついて行く。",
              "citation": {
                "source": "城の石垣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ダンダン　センサウノ　アル　トコロニ　チカヅイテ　キタラシク、トキドキ　トホクノ　ハウカラ　カスカニ　タイハウノ　トドロキガ　キコエテ　キマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツヅイテ刺スヨウナ痛ミヲオボエマシタノデハット思ッテ目ヲ開クト要之助ガ悪鬼ノヨウナ相ヲシテ白イ光ルモノヲモッテ私ニ馬乗リニナッテイマス。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　ツヅイテ事件ノ経過ヲ述ベヨ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "目ヲトジテヰルジヤガイモサンハ、石ニツマヅイテ、何度モコロンデ、コブダラケニナツテモ　マダマダ、目ガサメナイデ、「何ダ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "現実の権勢に盲目的に崇拝ツイヅイなさるのは、そしてそのために宇宙のツヂツマまで合せておしまひになるといふ、哲学者ぐらゐ安直重宝な方々はゐないな。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくの――今見ると汚ない悪い版のものである――十竹斎本に基づいて試作に描いた岸田の古い日本画も、そのまゝ「売つちまつた」ものかも知れなかつたが、それを今所蔵してゐる人は、ぼく思ふにそこに絵のウマイ、マヅイよりも、美術を所詮感じて、いゝものを持つてゐる喜びにきつと満足してゐることだらう。",
              "citation": {
                "source": "岸田劉生の日本画",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハソレヨリモ、春久ト颯子トガドンナ工合ニ接触スルカ、ソノ様子ガ見タカッタノデアルガ、団欒ノ中ニ加ワッテカラ三四十分モシタ時分、次第ニ脚カラ腰ノ周リガ冷エテ来ルノニ心ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」戸ハホンノ僅カ、動クカ動カナイクライニ触レタヾケデアッタガ、早クモ彼女ハ気ヅイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ髯ヲ剃ッタノニ心ヅイテ、早クモ何カヲ察シタノカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ爺サンハ発狂シテルノデハナイカト、思ワレルダケデモ極マリガ悪イ）予ハコヽマデ思イ詰メテ、コヽニ一ツノ可能ナ方法ガアルカモ知レナイコトニ気ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテコノ白唐紙ノ色紙ノ上ニ朱デ足ノ裏ノ拓本ヲ作ル」「ソンナモノガ何ニナルノ」「ソノ拓本ニモトヅイテ、颯チャンノ足ノ佛足石ヲ作ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ拓本ニモトヅイテ彼女ノ足ノ佛足石ヲ作ルノデアルコト、予ガ死ンデカラ骨ヲソノ石ノ下ニ埋メテ貰ウノデアルコト、ヲ知ッタ時ニモ、彼女ハ格別ノ意見ヲ述ベハシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ理由ハアタシニハヨク分ラナイガ、オ爺チャンコソ何カシラ感ヅイテイラッシャルノデハナイデショウカト、乙ニ絡ンデ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思イモ寄ラヌ秘密ヲ不意ニ彼女ニ発カレタヽメカ、自分デモ疾ウカラ内々ハ気ヅイテイテ、強イテ気ヅカヌ振リヲシテイタノニ、コノ古狸ニ突如素ッ破抜カレタヽメカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ重ナリ工合ヤ歪ミ工合ハゴク僅カデ、動作ニ不便ヲ感ズルホドノコトハナク、人ニ気付カレルコトモナイノデ、今日マデソノママニシテイルガ、アノ日カラズット、今モソノ状態ガツヅイテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此邊で御墨附を出したら何うだ」　ヅイと出た平次、縁側の下に蹲まる黒助を見下ろして斯う言ふのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "名馬罪あり",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼んで來ませうか」「兎も角逢つて見よう」　平次が引受けると、八五郎は早速格子戸をガタピシさせながら路地に飛び出し、「さア／＼此方へ、ヅイと入つて下さい。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "橋場の人魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "内ノ者共ツヅイテ込入、即時ニ攻破ツテ天主ニ詰メヨスル。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先陣ハ、和田ノ岬ヲ巡ッテ、左岸ニ沿イ、兵庫港（経ヶ島）ヘ、上陸セヨ」　そしてまた、「ツヅイテ、日輪ノ旗ヲ中ニ、本軍ハ紺辺（神戸）ノ東ヘ突進スベシ。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "また黒ダイ釣りをヅイ釣りといって、中京の名物釣りの一つになっている。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "この夜釣りのヅイ釣りで、猛害があって刺されるとひじょうな痛みと四十度からの熱が出るという「ゴンズイ」ばかり釣れて、針をはずすのに困ったこともあった。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
