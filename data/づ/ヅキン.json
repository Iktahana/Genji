          "literary": [
            {
              "text": "――ヅキンヅキンと圧搾されるやうな痛みが、脳天まで響いた。",
              "citation": {
                "source": "妄想患者",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪は外套のどんな隙からでも入りこんで、手の甲や、爪先などは、ヅキン／＼痛んできた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十ばかりの漢でした、頭には浅黄のヅキンをかぶり、身には墨染のキモノをつけ、手も足もカウカケにつヽんでゐました、その眼は、遠い国の藍い海をおもはせるやうにかヾやいてゐました。",
              "citation": {
                "source": "桜さく島",
                "author": "見知らぬ世界",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、セイヨウネコデシタカラ、ナイト・キヤツプトイフヅキンヲカブツテ、ナイト・ガウントイフネマキヲキテ、メガネヲカケテヰマス。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
