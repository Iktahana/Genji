          "literary": [
            {
              "text": "フラゴナアルの技を以太利に修めんとするや、ブウシエその行を送つて曰、「ミシエル・アンジユが作を見ること勿れ。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブウシエを哂つて俗漢と做す。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "遮莫千年の後、天下｜靡然としてブウシエの見に赴く事無しと云ふ可らず。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブウシエの森に囲まれた、ここは遊楽場の喫茶館。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
