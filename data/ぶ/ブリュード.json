          "literary": [
            {
              "text": "七月二十二日　火　ギガントよりウェルブリュードへ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月二十三日　水　ウェルブリュード　ソフホーズ滞在。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月二十四日　木　ウェルブリュード、朝五時過出発、自動車。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ギガント」から一時間ばかり汽車にのっかって行くと、「ウェルブリュード」という国営大耕地の真中に、農業機械専門学校がある。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴族の戦士を円形のなかに描いた下にあるリボンには、まだこの島のビールだった頃には、アイランド・ブリュード（この島での醸造）とうたってあった。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
