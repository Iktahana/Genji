        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "友達が撮った私の寝顔の写真があまりにもブスで、思わずスマホを取り上げて消去した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "朝起きて鏡を見たら、顔がパンパンにむくんでいてすごいブスになっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は「性格がブスなやつとは絶対につきあいたくない」と公言している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      }
    ],
