[
  {
    "uuid": "ae6cda50-9cb6-51cb-90d6-a01fa262a5a0",
    "entry": "分村",
    "reading": {
      "primary": "ぶんそん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
