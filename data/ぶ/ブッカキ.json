          "standard": [],
          "literary": [
            {
              "text": "「姐さん、氷をブッカキにして持って来てくださいな」　娘はかしこまって下りて行く。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘がそこにブッカキを丼に入れて持って来た。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、萬一、萬々一例の恐怖に襲撃された時の要心に、頭を冷す為めの氷のブッカキを買って、其れをハンケチへ二重に包んだ。",
              "citation": {
                "source": "恐怖",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
