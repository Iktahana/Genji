          "literary": [
            {
              "text": "實ニ貴族ノ土地徴集ヲ決行スルニ、大西郷ガ異議ヲ唱フル諸藩アラバ一擧討伐スベキ準備ヲナシタル先哲ノ深慮ニ學ブベシトスル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "劣惡ナル者ガ亡ビテ優秀ナル者ガ殘存スル自然淘汰律ハ日本語ト國際語ノ存亡ヲ決スル如ク、百年ヲ出デズシテ日本領土内ノ歐洲各國語、支那、印度、朝鮮語ハ亦當然ニ國際語ノタメニ亡ブベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "論題ヲ論述スルニ方リ、聊カ其本文ノ大意ヲ譯シ、次ニ余ガ論述ニ及ブベシ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ士君子万巻ヲ読破スルモマタ須ラク廟堂ニ登リ山川ヲ看交ヲ海内名流ニ結ブベシ。",
              "citation": {
                "source": "小説作法",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時文風｜甚盛ニシテ、名士｜踵ヲ接シテ壇ノ百｜囀スルガ如ク、婉約喜ブベシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
