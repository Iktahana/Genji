        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君は外国語は何を遣っています」「フランスを少しばかり習いました」「何を読んでいます」「フロオベル、モオパッサン、それから、ブウルジェエ、ベルジックのマアテルリンクなんぞを些ばかり読みました」「らくに読めますか」「ええ。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "機首はきまった――一直線に巴里ブウルジェへ！",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "その巴里が、２・３０ＰＭのブウルジェが、ふたたび「社会」が人性が生活が、いまぐんぐん機の下に盛れあぶってきている。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上を機は草原の中空へ――ブウルジェ飛行場だ。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩人にして小説家アナトオル・フランスはブウルジェと共に自作の小説を脚色してゐるが、若い頃、「ピエロの化身」といふ韻文劇一幕を書いたことを世人は大方忘れてゐる。",
              "citation": {
                "source": "演劇より文学を排除すべきか",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学の本質を思想に置き、一作家の価値をその哲学的根柢によつて定めるものとしたならば、現代仏国の劇作家中、彼こそは、小説壇に於けるブウルジェ、詩壇に於けるヴァレリイの地位を占むべき作家であらう。",
              "citation": {
                "source": "仏国現代の劇作家",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へば、ロマン・ロオランやブウルジェの戯曲は、共に、われわれに取つて興味はないものである。",
              "citation": {
                "source": "仏国現代の劇作家",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "決してうちとけないひとで、こちらでどんなに愛想をよくしても、ちょっと微笑をかえすだけで、頑固に孤立をまもって、いつも校庭の隅で、ひとりでブウルジェなどの小説を仏蘭西語で読んでいた。",
              "citation": {
                "source": "キャラコさん",
                "author": "鴎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エークス鉱泉駅に約十分滞留したのち、汽車はブウルジェの湖畔の、水陸間一髪という際どいところを走っている。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はダヌンチオやブウルジェエの冗漫に堪え切れない。",
              "citation": {
                "source": "生きること作ること",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
