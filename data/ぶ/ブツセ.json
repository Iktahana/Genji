          "literary": [
            {
              "text": "ブツセ先生の哲学総論であつたが余にはその哲学が少しも分らない。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "もつともブツセといふ先生は落第点はつけないさうだから試験がほんたうに出来たのだかどうだか分つた話ぢやない。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラン以後にも手近い所でフオスタア（Foster）だとかブツセイ（Bussey）だとかいろいろ訳本の無い訣ではない。",
              "citation": {
                "source": "リチヤアド・バアトン訳「一千一夜物語」に就いて",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ショクブツセイ、ビ……」私はつぶやいた。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
