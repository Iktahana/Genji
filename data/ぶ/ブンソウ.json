[
  {
    "uuid": "13af1d7d-ba8b-5c23-a1dd-0bd3f0289b0f",
    "entry": "文藻",
    "reading": {
      "primary": "ぶんそう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
