          "literary": [
            {
              "text": "この式を英国教宗にてはホリー・コミュニオンといい、ローマ宗にてはミサといい、非国教宗にてはローズ・サパーといい、あるいはプリマス・ブレズレン宗にてはブレイキング・ブレッドという。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "日曜日のことをクエーカー宗にては第一日といい、プリマス・ブレズレン宗にては神の日と称するなり。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "第九三、プリマス・ブレズレン宗　クエーカー宗に最も相近きもの、プリマス・ブレズレン宗なり。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
