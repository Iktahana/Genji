[
  {
    "uuid": "ecf17994-8b87-5435-9025-d3e35d6b4390",
    "entry": "ぶらつく",
    "reading": {
      "primary": "ぶらつく",
      "alternatives": [
        "ブラつく"
      ],
      "is_heteronym": false
    },
    "grammar": {
