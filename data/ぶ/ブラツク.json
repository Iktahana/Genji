      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to stroll about",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "待ち合わせの時間までまだ少しあるので、駅前の地下街をあちこちぶらついてウィンドウショッピングを楽しもう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "温泉旅館にチェックインした後、浴衣に着替えて温泉街のお土産屋さんをぶらつくのが旅の醍醐味だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "休日の朝は、犬の散歩も兼ねて近所の公園の周りをのんびりとぶらつくのが日課になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "丸ビルの一階をぶらつく時など、八階のホトトギス社を尋ねて一度昔話でもしてみたいような気のすることがある。",
              "citation": {
                "source": "高浜さんと私",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤土の広場の松の、あちこちには、人のぶらつくのも見え、谷に臨んで、茣蓙毛氈を敷いた一組、二組も、色紙形に遠く視められる。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そこらをぶらつくうちにはまた出会いましょう。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、たゞ、ぶらつくので。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ぶらつく体を杖に突掛くる状、疲切ったる樵夫のごとし。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人は国にいるじぶんの気で、こちらにきても、ついそこらをぶらつくことができるつもりでいました。",
              "citation": {
                "source": "影",
                "author": "SKYGGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "盗賊は月光を浴びて必死に逃げたが、ぶらつく首が邪魔になるらしく、次第に逃げ足が鈍って来た。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "寂しい無縁坂を降りて、藍染川のお歯黒のような水の流れ込む不忍の池の北側を廻って、上野の山をぶらつく。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうかね、ロンドン中をぶらつくのは？",
              "citation": {
                "source": "入院患者",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "主な楽しみといえば、銃猟や魚釣り、あるいは貝殻や昆虫学の標本を捜しながら、なぎさを伝い桃金嬢の林のなかを通ってぶらつくことなどであった。",
              "citation": {
                "source": "黄金虫",
                "author": "THE GOLD-BUG",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ぶらつく体を杖に突掛くる状、疲切つたる樵夫の如し。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "雜木林の間に馬を繋いだ儘で彼は衣物を改めてあてどもなくぶらつくのが好きであつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いったんはき出しましょう」と言いながら、袖の裏から右の手を出して、ぶらつく袂を肩の上へかついだ。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは毎晩日が暮れると、ぶらり家を出て祇園町をぶらつくのだ。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから後といふもの、野尻氏は公園をぶらつく度に、方々から頻りと月の出を調べてみたが、無学なお月様は、仲麿の歌なぞに頓着なく、いつも外つ方から珈琲皿のやうな円い顔をによつきりと覗けた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "日暮に樹明来庵、久しぶりな会飲だつた、酒はキレイ、肴はハム、客は樹明、だから酔うてぶらつくこと例の如し。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶらつくうちに日が暮れた。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつしよに裏山をぶらつく、墓場の徳利を拾つたり、或は竹田小幅を売り飛ばした不孝話を聞く。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "食後の散歩がてら、蕗のとうを探して近在をぶらつく、出てゐた、出てゐた、去年も出たところに出てゐた、よい蕗のとうだ、よい香気だ、さつそく佃煮にする、句にする。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方、さびしいから、そこらをぶらつく、やつぱり慰まない、人間は人間の中、人間には人間がおもしろい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "千日前の盛り場をぶらつく。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "長く銀座をぶらつくということもなく、主人の帰る時刻になると、じきに電車で帰って行った。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの紳士等の淑女は、往来やキャフェをぶらつく若い綺麗な女どもとその容色をきそうためには、決して子供を生んではならない。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "早く起きる、前庭をぶらつく、花柳菜といふ野菜が沢山作つてある、紅足馬さんがやつてくる、話がはづむ、鮎の塩焼を食べた、私には珍らしい御馳走だつた、小さいお嬢さんが馳けまはつて才智を発揮する、私達は日向の縁側で胡座。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来秋の野良仕事はまことにいそがしい、その間をぶらつく私は恥づかしかつた、私はまつたく不生産的人間だ、社会の寄生虫だ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "観音様へ月詣りをしていたので、そのたびに花川戸へ寄ってお初をつれ出してはお詣りをすませて仲見世をぶらつくのが慣しになっている。",
              "citation": {
                "source": "神楽坂",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あちこち、ぶらつく程に、うれしや、一軒の戸あきたり。",
              "citation": {
                "source": "冬の榛名山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "「寄宿の方はいいのかね」「土曜日曜は平気だわ」「相当みんなこの辺をぶらつくんだろう？",
              "citation": {
                "source": "雑沓",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "内藤とよく街をぶらつく。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to dangle",
