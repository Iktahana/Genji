        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "手に持った吾輩の名刺をチラリと見た安島二郎氏はブッスリと唇を動かした。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る時はじめて翁に謡のお稽古を願ったら、翁は一応稽古を附けて後でブッスリと云った。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "三ツ重ねておいて心臓をブッスリ刃の根本まで突き刺す。",
              "citation": {
                "source": "山の神殺人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "うしろから心臓をブッスリ突き刺して、首を斬り落すのだ。",
              "citation": {
                "source": "山の神殺人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩にまたがり、しなびた皮を充分にひっぱってその根本よりブッスリ切り落す。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで身体の中心にブッスリと針をさされたような恋心を感じた。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　懐剣が病人の背中をブッスリ突き刺しているのだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十八　踊る時計",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
