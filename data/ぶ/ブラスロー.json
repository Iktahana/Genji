          "literary": [
            {
              "text": "これはシャリアピンにも、シューマンハインクにも、キプニスにも、ブラスローにも、さらにさらにスレザークにもあることで、年と共に大抵の歌い手は、手の混んだ、細かく分解の出来るものほどよく歌うようになる。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトでは老巧ブラスローがある。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラスロー　（Braslau）　ひところの有名なアルトだが、近頃は電気でコロムビアにも入っている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
