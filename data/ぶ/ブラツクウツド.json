        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ブラツクウツド雑誌に立て籠つて、クリストフア・ノウスといふ雅号で、何でもござれといつた風に、いろんな方面に得意の才筆を振つた男だ。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "キツプリング、ブラツクウツド、ビイアスと数へて来ると、どうも皆｜其机の抽斗には心霊学会の研究報告がはひつてゐさうな心持がする。",
              "citation": {
                "source": "近頃の幽霊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊にブラツクウツドなどは（Algernon Blackwood）御当人が既にセオソフイストだから、どの小説も悉く心霊学的に出来上つてゐる。",
              "citation": {
                "source": "近頃の幽霊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一例を挙げるとブラツクウツドなどには、エレメンタルスと云ふやつが、時々小説の中へ飛び出して来る。",
              "citation": {
                "source": "近頃の幽霊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラツクウツドの「柳」と云ふ小説を読むと、ダニウブ河へボオト旅行に出かけた二人の青年が、河の中の洲に茂つてゐる柳のエレメンタルスに悩まされる。",
              "citation": {
                "source": "近頃の幽霊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
