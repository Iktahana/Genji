        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ブローミウム加里を服めと勸めて行くので。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、ハヾトフは訪問をする度に、屹度ブローミウム加里の入つた壜と、大黄の丸藥とを持つて來る。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると丁度ハヾトフもブローミウム加里の壜を携へて遣つて來た。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドクトルは其後を睨めてゐたが、匆卒ブローミウム加里の壜を取るより早く、發矢と計り其處に投付る、壜は微塵に粉碎して了ふ。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "續いてダリユシカも來、何とも云へぬ悲しそうな顏をして、一｜時間も旦那の寐臺の傍に凝と立た儘で、其れからハヾトフもブローミウム加里の壜を持つて、猶且見舞に來たのである。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブローミウム加里を服めと勧めて行くので。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、ハバトフは訪問をする度に、きっとブローミウム加里の入った壜と、大黄の丸薬とを持って来る。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると丁度ハバトフもブローミウム加里の壜を携えて遣って来た。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドクトルはその後を睨めていたが、ゆきなりブローミウム加里の壜を取るより早く、発矢とばかりそこに投付る、壜は微塵に粉砕してしまう。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いてダリュシカも来、何とも云えぬ悲しそうな顔をして、一｜時間も旦那の寐台の傍にじっと立たままで、それからハバトフもブローミウム加里の壜を持って、やはり見舞に来たのである。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
