        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "またボストンのウェレスレー学校、フィラデルフィアのブリンモアー学校というようなものがございます。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "人のはいらないような茂みの中には美しいフェアリーや滑稽なゴブリンの一大王国があったのである。",
              "citation": {
                "source": "夏",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰途はギリシアからブリンデイシ、ヴェニスを経て一八七三年五月初旬にロンドンに着いた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫の「ボウヤ」が十月に死んでから、妙にさびしくなった家が、これでまた急ににぎやかになったような気がして、それからは、毎朝新しい菜っ葉をやっては、玉をころがすような朗らかなワーブリングを聞くのが楽しみであった。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "八雲氏の夫人が古本屋から掘り出して来たという「狂歌百物語」の中から気に入った四十八首を英訳したのが「ゴブリン・ポエトリー」という題で既刊の著書中に採録されている。",
              "citation": {
                "source": "小泉八雲秘稿画本「妖魔詩話」",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "気がつくとピート・シーガーの「若者と老人」なんてレコードを引っ張りだして、このオレは「♪ブリング・ゼム・ホーム〜」とベトナム反戦のプロテスト・ソング（ああ、こんな言葉を十七年ぶりに思い出しちまったぞ！",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘブリンの一服も飲めば癒るで。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "『タンブリン・マン』はあるから、あとで〈クライ〉をかける」　慶一はあの曲を思いだし、「でも、そんなことは、以前にもなんどもあったこと」だから、「泣かなくてもいいんだ」と考えた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二提琴奏者ガリバルダ・セレナは伊太利ブリンデッシ市鋳金家ガリカリニの六女。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰しもその優雅な姿を見たら、この婦人が、ロムブローゾに激情性犯罪の市と指摘されたところの、南｜伊太利ブリンデッシ市の生れとは気づかぬであろう。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてパリ、イタリアのブリンディッシ、アテネ、アレキサンドリア。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、もし巧みに封鎖を脱することができれば、ヴェネチア、アンコナの両港を襲撃できるばかりではなく、ブリンデッシ、バリーなど無防禦港も、砲火の危険に曝されねばならない。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は米を買う金もないと言いだしたから、私は大切にしていたクロポトキンの「ロシア文学の理想と現実」、ジョイスの「ダブリンの人々」他二、三冊の洋書を、訪ねてきた編集者に頼み、一面識だけある本屋の社長に図々しくも売ってきて貰う。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼、ブリンヂイシイの港を出でゝより、早や二十日あまりを経ぬ。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、ブリンヂイシイの港を出でてより、はや二十日あまりを経ぬ。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼、ブリンヂイシイの港を出でゝより、早や二十日あまりを經ぬ。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンチヘブリンを服まさうかとも思つたが、それにしては熱が少しもなかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワルシャワの左翼を擁護しているルブリンの要塞が危険だという報道が伝わった。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　ルブリンが陥ちたという報道が来た。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "□大阪には文芸同攻会と云ふものが起つた、読売に「母」を書いた石丸梅外氏などの発起で大に関西芸術の振興に努めて大阪を英のダブリンにしようとする計画だ。",
              "citation": {
                "source": "TZSCHALLAPPOKO",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九一一年板ブリンケンベルヒの『宗教民俗上の雷器』八六頁已下）。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "欧州でも、一七二四年ダブリン版、アーロン・クロッスリーの『紋章用諸物の意義』ちゅう、予未見の書に、野猪は角を具えぬが、獣中最強のものだ。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが今日競売の約束固めに槌で案を打つ訳である（一九一一年板ブリンケンベルグの『雷の兵器』六一頁）。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "運命、人生――曽て芳子に教えたツルゲネーフの「プニンとバブリン」が時雄の胸に上った。",
              "citation": {
                "source": "蒲団",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ンナとブリンチ※ルレとの三つの心の活闘も、心理上さう大して深いところまで行つてゐるとは思はれない。",
              "citation": {
                "source": "社会と自己",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばブリントン博士（Du. Brinton）は、北米の氷海海岸に住むエスキモーが、世界の起源ということについて未だかつて考え及んだことすらなかったということを伝えている。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜七時、アリゾナ州フォニックス市から、地方検事ロイド・アンドリウス、捜査課長ジョン・Ｌ・ブリンカホフ、刑事ハアレイ・ジョンスンの一行が、飛行機で来着した。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "キプリングがダブリン大学へ行ったときね、学生に向って第一に云ったことは、私は君等を嫉妬する。",
              "citation": {
                "source": "雑沓",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "村を出てからゴーリキイは裏海の漁業組合で働き、やがてドウブリンク駅の番人として働き、駅夫や人夫に地理や天文の本をよんで聞かせてやりながら、半分歩いてニージュニイにたどり着いた。",
              "citation": {
                "source": "マクシム・ゴーリキイの人及び芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
