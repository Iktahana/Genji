        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "活版印刷の工房で、職人が原稿を見ながら素早い手つきで鉛の活字を拾う文選の作業を見学した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "古い印刷所の棚には何万本もの活字が並んでおり、文選工はそれを迷いなく抜き出していく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "コンピュータでのDTPが普及し、手作業による文選の技術は今や貴重なものとなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "この原稿を受取った私の友人は、いつもの通り内容をロクに見ないまま文選工場へまわすに違いない。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝は高祖｜武帝の第七子にして、誉は武帝の長子にして文選の撰者たる昭明太子統の第二子なり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "正平の十九年に此処の道祐というものの手によって論語が刊出され、其他｜文選等の書が出されたことは、既に民戸の繁栄して文化の豊かな地となっていたことを語っている。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "五経、文選すらすらで、書がまた好い。",
              "citation": {
                "source": "絵本の春",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "活字を使っていた時代には、文選工と呼ばれる印刷所のスタッフが原稿を片手に一字一字活字を拾い、行と行の間に詰め物をはさみながら頁を組んでいきました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と文選の句を大臣は口ずさんで、「琴の感じではないが身にしむ夕方ですね。",
              "citation": {
                "source": "源氏物語",
                "author": "乙女",
                "note": "青空文庫"
              }
            },
            {
              "text": "『文選』の和訓には、支那の悪鬼｜人間にありて怪害を作すてふ野仲をノヅチと訳した。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "李善は唐の顕慶中、『文選』を註した（『四庫全書総目』一八六）。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊楠十歳の頃、『文選』を暗誦して神童と称せられたが、近頃年来多くの女の恨みで耄碌し、件の魚瞰鶏睨てふ王褒の句が、『文選』のどの篇にあるかを臆い出し得ない。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二月二十八日）　追加　前項に、今より千二百七十年ほどの昔、唐の顕慶年間、李善が書いた『文選』の註に、鶏好邪視とあるを、邪視なる語のもっとも早くみえた一例として置いた。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "『風俗｜文選』などいう本をわざわざ東京から取寄せて、幾らか俳文をひねくったりしたこともあった。",
              "citation": {
                "source": "私の父",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "文選も植字も印刷も主がみな一人でやった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "又文選集註と云ふ書物が有る。",
              "citation": {
                "source": "平安朝時代の漢文學",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "文選は平安朝に行はれたものであるが、其の註を集めたものが集註であつて、集註は初め百二十卷としたものであらう。",
              "citation": {
                "source": "平安朝時代の漢文學",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "文選には唐に至るまでに既に多くの註釋が出來て居たが、後多くは無くなつて、李善註、五臣註だけが殘つた。",
              "citation": {
                "source": "平安朝時代の漢文學",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "文選集註は天歴頃のものであるが、支那の著述目録は勿論、當時日本にある支那書籍の總目録たる日本國現在書目にも、其の名は見えないからして、確かに日本人の作つたものであらう。",
              "citation": {
                "source": "平安朝時代の漢文學",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "其外注に本文とをし並べてことの外大切にする注ありとて王弼老子注、郭象莊子注、張湛列子注、※道元水經注、裴松之三國志注、劉義慶世説注、李善文選注、王逸楚辭注、高誘呂氏春秋注、王肅家語注、韋昭國語注を擧げ、皆本文と光を爭ふといひしなども、近世支那學者と同じ程度の識見を有せりといふべし。",
              "citation": {
                "source": "敬首和尚の典籍概見",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは文選に見ゆる張衡の四愁詩に、美人贈我錦繍段。",
              "citation": {
                "source": "染織に關する文獻の研究",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "又文選の李善注などは、本書は文學であるが、その注は多くは歴史の材料を集めて出來たものである。",
              "citation": {
                "source": "支那史學史概要",
                "author": "――史記より清初まで――",
                "note": "青空文庫"
              }
            },
            {
              "text": "文選小僧は「明日の新聞も景気が可えぞ。",
              "citation": {
                "source": "菊池君",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "一段二段の長い記事を字一つ消すでなく、スラスラと淀みなく綺麗な原稿を書くので、文選小僧が先づ一番先に竹山を讃めた。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "文選の小僧共はまだ原稿が下りないので、阿彌陀鬮をやつてお菓子を買はうと云う相談をして居て、自分を見ると「野村さんにも加擔ツて貰ふべか。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "文選小僧は『明日の新聞も景気が可えぞ。",
              "citation": {
                "source": "菊池君",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "文選の小僧共はまだ原稿が下りないので、阿弥陀※をやつてお菓子を買はうと云ふ相談をして居て、自分を見ると、「野村さんにも加担ツて貰ふべか。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサは自分の身の上にかかって来る同じその事情のなかで、愛子の生きかたにもシゲの受動的な日暮しの態度にもあき足りず、困難をしのいで女に例の少い女文選としての技術を身につけ、同時に、女が働くのは嫁に行くまでだという勤労者の常識にさえ滲みこんでいる考えかたを自分で破って行こうとする。",
              "citation": {
                "source": "徳永直の「はたらく人々」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサが文選の仕事を見習いはじめてからの情景、山岸がアサに「お前帰れ――家へ帰れよ」と云う夫婦の心持の縺れの描写のあたりは（五章の三）職場での男対女の感情のしきたりを描いた五章の一のあたりとともに、生彩を放っている。",
              "citation": {
                "source": "徳永直の「はたらく人々」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "文選十六人は彼を入れすぐ立ち、六時の夕飯三十分の休みに、文選十六人はベン当箱をもって一つところに集り、きめた以上の仕事はしないこと、きめた以上は監督のところへ突かえしにゆき残業させぬようにしようと決議して就業。",
              "citation": {
                "source": "大衆闘争についてのノート",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
