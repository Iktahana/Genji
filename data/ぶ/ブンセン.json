          "standard": [
            {
              "text": "図書館の奥の書架で、平安時代の貴族たちが詠んだ和歌の文選を見つけて借りてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼の残した膨大なエッセイの中から、特に評価の高いものだけを集めた文選が出版された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "中国の古い文選を読み解くことで、当時の政治や人々の暮らしの様子が浮かび上がってくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
