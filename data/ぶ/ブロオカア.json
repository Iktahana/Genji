        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "隆吉は京成電車の車掌をしていたが、それも二三年位のもので、あとはずっと、与平に手伝って、百姓をしたり、土地売買のブロオカアのような事をして暮していた。",
              "citation": {
                "source": "河沙魚",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのことにしてもだ、そいから、今、こうしてブロオカアしてるんだって、こいで、つまりが、てめえが大事だからだ。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イントク物資を取り巻いて、ウジのようにたかっているブロオカアどもの手先になってさ、役人のところへ行っちゃワイロをつかませたり、女を当てがったり――知ってるわよ、チャーンと！",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "きさまみたいな闇のブロオカアの毒虫あ、死んだ方がいいんだ！",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
