        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "パウル・ブルジェの短編集『ハステル・オフ・マン』を手にした時には、何ともいえない喜びで、何べんその本のクロオスをなでたか知れなかったことをくり返したい。",
              "citation": {
                "source": "日本橋附近",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "十時ブルジェ飛行場出発であるから、一時間より間がない。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃いやにポール・ブルジェが訳されて、今『愛』というのが送られています、Book レビューしてくれと。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私らは奥様がもてなすメロンやココアを味わいながら、ブルジェの作品を論じたり、電蓄で雑音のないモーツァルトを聞いたりしばらく清談に時を過ごした。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "19世紀の最後の20年間に文学において展開された心理学的傾向の代表者はポール・ブルジェである。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
