          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "バイクのエンジンがぶるんと低く唸り、彼は風を切って走り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼女が首を振ると、豊かな髪がぶるんと揺れて周囲の目を惹きつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "寒さで車のエンジンがなかなかかからず、何度目かでようやくぶるんと始動した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "曰く「われは横綱らしく強いところを見せようとして左の腕を大きくぶるんと振って相手を片手で投げ飛ばそうとしたが、相手は小さすぎて、われの腕はむなしく相手の頭の上を通過し、われはわが力によろめき自ら腰がくだけて敗れたのである。",
              "citation": {
                "source": "男女川と羽左衛門",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大人の狐にあったら急いで目をつぶるんだよ。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ゆるしが出たのでポチは、ぶるんと一つ大きく胴震いして、弾丸のごとく赤犬のふところに飛びこんだ。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐伯は、一言も発せず、ぶるんと大きく全身をゆすぶって私の手から、のがれた。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　その時のことを、北山はなまなましく想い出して、溜息とも叫びともつかぬ、得体の知れぬ声をうめきながら、ぶるんと首を振っていると、電車が来た。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "よかったわね」　彼女はぐったりとしている赤ん坊の頬をぶるんぶるんさせてあやしたけれども、赤ん坊は気持ちよさそうにぐったりと眠りつづけていて、決して笑いだしもしなければ目さえも動かさなかった。",
              "citation": {
                "source": "猟奇の街",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、メロスは、ぶるんと両腕を大きく振って、雨中、矢の如く走り出た。",
              "citation": {
                "source": "走れメロス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後、沼南昵近の或る男に会った時、その話をして、「何だってアンナに貧乏ぶるんだろう、」というと、「アレは沼南の癖だよ、」といった。",
              "citation": {
                "source": "三十年前の島田沼南",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」彼女はまた黙り込んだが、突然ぶるんと身を震わして立ち上がって、「さ、行きましょう。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジガ蜂は引つかかつたなと思ふと、ぶるんと激しく足ぶるひして次の瞬間にはもう器用に抜け出して、そんなことがあつたともいはぬやうな顔で高い夏空さして飛んで行つた。",
              "citation": {
                "source": "ジガ蜂",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶるんぶるんと精悍な胴ぶるいをしているような、脂の満ち張った足並みで繰り出て来たのは、ひと目でこの日の行事の中心団体と目された一群だと分ったが、内臓を立ち割って日に晒し出したようなこれらの光景は、それはすでにもう伝統ではないものが、政治を掴み動かしているのと同じだった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "水で顔をぶるんとするのであるが、二つあるトタンの洗面器は床にかける雑巾を濯ぐのと共同である。",
              "citation": {
                "source": "一九三二年の春",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれは一直線には飛ばないで、ぶるんぶるんと三段跳びみたいな飛び方を空中でしていた。",
              "citation": {
                "source": "ふしぎ国探検",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よし、君の好きなようにしたがいい、そのかわり、もし危険を感じたら、この綱をゆすぶるんだよ。",
              "citation": {
                "source": "時計屋敷の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "岡部伍長の乗った地下戦車が、ぶるぶるんと震えたようである。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶるぶるん、ぶるぶるん。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、一万台の人造人間戦車は、とたんに、ぶるんと一揺れ揺れた。",
              "citation": {
                "source": "人造人間戦車の機密",
                "author": "――金博士シリーズ・２――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなところで誰が働いてやるもんか」　と叫んで、後は「ぶるん、ぶるん」というような音を吐きだしながら、背負枠も牛の綱もそこらに放うりだして、その小柄な肩をすさまじくいからせながら、ちょうど僕は庭先きにいたが、こっちへは眼もくれずに小屋へ入って行った。",
              "citation": {
                "source": "石ころ路",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人はつと立って、例の不恰好な厚着をした身体をぶるんとふるわせると、物もいわずに逃げだした。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして機体はぶるんぶるんとへんに首をふっているのでありました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "全機は、それこそ隼のように猛然と怪塔ロケットのあとを追いましたが、相手はぶるんぶるんと首をふりながら、遂に海中にどぼんとおちてしまいました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶるぶるん、ぶるぶるんと気持のわるい震動音がきこえる。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼠が時に、その上にあがると、糸車は、天井裏でブルン／＼と音をたてた。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あのブルン／＼という音は何ぞいの？",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬殿、鼻をブルンブルンいわせながら、一｜声風に嘶いてヒーン。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルンチェルがバルザックを論じたうちにこんな句があります。",
              "citation": {
                "source": "創作家の態度",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ブルンチェルのバルザック論はもちろん一人の著者についての議論でありますから系統的に理論は述べてありませんが、こういう点に関してはなはだ有益の参考書でありますから御一読を願います。",
              "citation": {
                "source": "創作家の態度",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この意味で（差等をつけると云う意味）、この種の文学ではブルンチェルのいわゆる無取捨と云う事が不可能になるのであります。",
              "citation": {
                "source": "創作家の態度",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ブルンブルン　シュシュシュ）○（ヅドン）すごいぞ！",
              "citation": {
                "source": "小熊秀雄全集−22",
                "author": "火星探検―漫画台本",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの人形は犯人にとると、それこそグンテル王の英雄（ニーベルンゲン譚中、グンテル王の代りに、ブルンヒルト女王と闘ったジーグフリートの事）なんでございますからね。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
