          "literary": [
            {
              "text": "捨てられた鏡のような山中湖は、反射が強くて、ブリッキ色に固く光った。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれでも万事整頓していたら旦那の心持と云う特別な心持になれるかも知れんが、何しろ真鍮の薬缶で湯を沸かしたり、ブリッキの金盥で顔を洗ってる内は主人らしくないからな」と実際のところを白状する。",
              "citation": {
                "source": "琴のそら音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "小供の玩具にするブリッキ製の匙であります。",
              "citation": {
                "source": "創作家の態度",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "箪笥の前にはブリッキの小さなかなだらいの中に。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            }
          ]
        }
