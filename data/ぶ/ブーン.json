        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「ブーン！ ほら、僕の飛行機速いよ！」と子供が模型を手に取って走り回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "バイクが目の前をブーンと風を切る音とともに通り過ぎ、砂埃が舞い上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「今の音、ジェット機かな？ ブーンってすごい迫力だったね」と彼は空を見上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
