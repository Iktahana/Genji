          "literary": [
            {
              "text": "ブフェートで、犢の牛皿90菓子三つ30パン一斤買う。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここのブフェートはきれいで、比較的やすい。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間にブフェートへ行ってハム、フレンチフライのジャガイモ、パンを買う。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルの中もブフェートのところなどからりとして、陽気でカンタンで、よろしい。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
