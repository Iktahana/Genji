          "literary": [
            {
              "text": "『私は、ブリタニイのカルナク――あの「石の兵士」に近い村で、お祖母さん一人の手で育てられたのです。",
              "citation": {
                "source": "踊る地平線",
                "author": "白い謝肉祭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブリタニイの女は、牛に似ています。",
              "citation": {
                "source": "踊る地平線",
                "author": "白い謝肉祭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたは、ブリタニイの雨を御存じですか。",
              "citation": {
                "source": "踊る地平線",
                "author": "白い謝肉祭",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい無敵艦隊がどこに向けて出港するかは、不明だった――目指すはアフリカか、ブリタニイか、またはアイルランドか。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            }
          ]
        }
