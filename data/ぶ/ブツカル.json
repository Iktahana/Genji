    "definitions": [
      {
        "index": 1,
        "gloss": "to bump into",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "脇見運転をしていた自転車が、歩道の電柱にぶつかるのを目撃した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "混雑した通路で前の人とぶつかるのを避けようとして、バランスを崩した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "イワス（岩壁の截り立っているところ）にぶつかると、水が深くて急であるから、森の中へ潜り込む、そうしてまた森から吐き出されては、谷の中へと飛び込む。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に四十八手を分析したら槓杆の原理のみならずあらゆる力学上の原理の応用が見つかるに相違ない、例えば体量の少ない力士が大きい敵手にぶつかる場合には速度の大小でどれだけの効果があるかという事あるいは敵の運動量を利用して強敵を倒す事など物好きな学者の研究によって明らかになりそうな事である。",
              "citation": {
                "source": "相撲と力学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "早く買って来ねえか」　戸に誰かぶつかる音。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、暫くあたりを歩きまはつてゐたが、ちよつとした土の凹みにぶつかると、嘴と前脚で穴を掘り出した。",
              "citation": {
                "source": "畫家とセリセリス",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、實際にさう云ふ事にぶつかると、本能の滿足から一種の快感を感じる。",
              "citation": {
                "source": "探偵小説の魅力",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　一人の女に、二人がぶつかることがあった。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人がぶつかることもあった。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蹄鉄に蹴られた礫が白樺の幹にぶつかる。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし私はそいつが、別にあたりを見廻すというのでもなく、いかにも毎夜のことのように陰鬱な表情で溪からはいって来る姿に、ふと私が隣の湯を覗いた瞬間、私の視線にぶつかるような気がしてならなかったのである。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしているうちに、初めには予期しなかったような重大な結果にぶつかる機会も決して少なくはない。",
              "citation": {
                "source": "科学者とあたま",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずいぶんいろいろの物を覚えいろいろの問題にぶつかる、そしていろいろの人間のいろいろの現象を見せてもらう事ができる。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日同じ顔をいじり回しているうちに時々は要領にうまくぶつかる事もあった。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今までは、何物にもぶつかるという事なしに、遠くからガラスの障子越しにながめるばかりで、それでいろんな事を空想しては恐ろしがってばかりいたが、今日ではもういやでも物にぶつからなければならない。",
              "citation": {
                "source": "亮の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでたとえば前の例について言えば二分以下の間隔に飛び込む機会は三度に一度で、二分以上五分までの長い間隔にぶつかるほうは三度に二度の割合になる。",
              "citation": {
                "source": "電車の混雑について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "世の中の変遷を見守って来た人、達識者は、幾多の経験の末、どうしてもこの力に結論せざるを得ないものにぶつかるらしいのです。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "安下宿の菜に此の一品にぶつかると、「また婆の股だぜ。",
              "citation": {
                "source": "間引菜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大波が船にはげしくぶつかると、そのいきおいで、あつい船板がまがり、海の水が流れこみました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "あくる日からその樫の木はずんずん大きくなりましたが、不思議なことには夜になると風が吹くたんびに、その樫の木の葉の間でチャランチャランとお金のぶつかる音がします。",
              "citation": {
                "source": "ツクツク法師",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまたま閃きかける青年の眼差しに自分の眼がぶつかると、見つけられてはならないと、あわてて後方へ歩き返した。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな人ごみでは、ぶつかるのがあたりまえでございます。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな混雑では、ぶつかるのは、あたりまえのことでございます。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、こちらのがけにぶつかるや、またこだまになって、むこうのがけに帰っていく。",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "垣根をくぐったときにね、頭に気をつけないと、物置からさがってる樋にぶつかるよ。",
              "citation": {
                "source": "病む子の祭",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "上には上があり、強い者には強いものがぶつかる。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから二力が互に異りたる曲線的に来てぶつかる時は、又何千万様の変化を起すか知れないのサ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして拍子を合せるやうに視線がぶつかる。",
              "citation": {
                "source": "Ｓ中尉の話",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）こうして離れているとお互いの生活に対する認識不足が多いので、いろいろ困難なことにぶつかると思います。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、鋸の刃が何か柔らかいものにぶっつかる音がした。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのぶっつかる瞬間に、そいつ手を高く挙げましたぜ。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはあちこちの川の岸や崖の脚には、きっとこの泥岩が顔を出してゐるのでもわかりましたし、又所々で掘り抜き井戸を穿ったりしますと、ぢきこの泥岩層にぶっつかるのでもしれました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
