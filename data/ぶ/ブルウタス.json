          "literary": [
            {
              "text": "わがダンディスム「ブルウタス、汝もまた。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ブルウタスよ、おん身もか」　こんなふうな気取ったようなせりふを彼は云うてみせたものだったが、それだって一度きりのことではなし、その後は殆んど毎晩のようにつながっては飲んだもんなんで、……彼はいつかしらおれにも勘定のきく家を拵えてくれた。",
              "citation": {
                "source": "陽気な客",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてあんまりやかましくって周囲の客たちに悪いと思って、おれがちょっと注意したりすると必ず奇怪な身ぶりをして、ブルウタスよおん身もかといい気持そうに云うわけだった。",
              "citation": {
                "source": "陽気な客",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
