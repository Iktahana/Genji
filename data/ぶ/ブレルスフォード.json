          "literary": [
            {
              "text": "いちはかねて教へを受けた宣教師ブレルスフォードを訪れた。",
              "citation": {
                "source": "母を殺した少年",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "宣教師ブレルスフォードは新潟市中大畑の私宅の一部に英学塾をひらいてゐた。",
              "citation": {
                "source": "母を殺した少年",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちは勘当を許されてのち、ブレルスフォードの塾に通ひ、まもなく助教師に抜擢された。",
              "citation": {
                "source": "母を殺した少年",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして日頃教えを受けてゐた老宣教師ブレルスフォードの家を訪ねた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時ブレルスフォードは中大畑町に小さな私塾をひらいてゐた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            }
