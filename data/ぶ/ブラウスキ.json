          "literary": [
            {
              "text": "彼女は、バガテラからあまり遠くない、ブラウスキ街十二番地にある家に住んでいた。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前は、ブラウスキ街の十二番地を知っているだろう。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラウスキ街の十二番地というのは、彼の新しい情人であるリザベッタの住んでいる建物の所在地に相違なかった。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前は、今後ブラウスキ街十二番地に足踏みをしてはいけないんだ。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
