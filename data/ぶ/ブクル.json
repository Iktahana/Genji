        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すこしじぶくるのは珍しいでしょう？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だかじぶくるようで御免なさい。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしのはじぶくり従順というようなところがあるのね、どうして、とかく初めじぶくるのか、可笑しなわたし。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "満鉄員との話に気をいれている父親は、さっきから、殆ど機械的に一銭玉をいくつか出してはじぶくる娘に握らしていたのであったが、女の児は体をグニャグニャさせるはずみに、手がゆるんでジャリと銭を床の上にばらまいてしまった。",
              "citation": {
                "source": "東京へ近づく一時間",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう書いてあるんだもん」　じぶくるような素子の言葉で、笑いながら磯崎が、「佐々さんは、お話しなさるんでしょう？",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「楽しみたい、ああよし、小遣帳――洒落にもならないわね」　佃は、落着いて小遣帳に日づけを記入しながら、じぶくる伸子に教訓するように云った。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛んでも行きたいくせにして、さあ、その人のいる所が分ったとなると、今度はヘンてこに澄まして、止そうのなんのとしぶくるんだもの」「城太さんのいう通り、飛んでも行きたいほどですけれど」「だから、飛んで行こうというのに」「けれど。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それをてめえ、有り難えと思わず、欝いで、さアあったという段になってから、じぶくるなんざあ吾儘すぎるッてもんだぞっ。",
              "citation": {
                "source": "脚",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
