        "動詞"
      ],
      "ctype": "五段-ラ行",
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「逃げるな、逃げると打った切るぞ。",
              "citation": {
                "source": "あまり者",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "「仙波に、お逢いなされましたか」「煩いっ、ぶった斬るぞ」　振返って睨みつけた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前に汝をぶった斬るんだ」「おれは事は好まん」「き、斬れるぞ源十！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そばへ寄りゃあ、かたっぱしからぶった斬るぞッ！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ば、馬足にかかりたいか、ソソそれとも、柳生の斬っさきにかかりたいか、のかぬと、ぶった斬るぞっ！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "こら、ぶった斬るぞ野郎、武士たる者へ死んだ女なんぞ送りつけやがって」　科白はだんだんへんにくずれてくるがそれだけ危険の度を増すのが内藤伊織だ。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「逃げようとて逃がしはせぬ、無理に逃げればぶった斬るぞ！",
              "citation": {
                "source": "仇討姉妹笠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女をたらす性の悪い若僧を、ぶった斬ること出来ませぬので、代わりといたしまして、殺人鬼めの足をぶった斬りましてござりますよ」「何をお云いだ、殺伐至極な！",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "気合をこめてぶった斬る、あれはな、普通のやり方で、名人となると反対だ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんだ、つまらぬやつ」　千太は、聞えよがしに、「眼の前で『顎』とひと言いうと、かならずぶった斬ると評判だけは高えが、なんのことやら……」　と言って、藤波のうしろから歩き出そうとし、とつぜん、うわッと声をあげ、「旦那！",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "ねずみ",
                "note": "青空文庫"
              }
            },
            {
              "text": "長五　おおよ、ぶった斬るんだ。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私はまだ少年でしたが、貴方の飛魚という秘手はよく噂に聞きましたよ、尋常な人ではないと思ったが、意外ですね」「その口ぶりをやめろ、ぶった斬るぞ」　相手はとつぜん喚いた。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "邪魔すると、ついでに、ぶった斬るぞ」「降りろっ。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやだと申す者は、素首をぶった斬るぞ」　剣把をたたくと、人々は、もう顫えあがって、唯々諾々と、彼の命のままうごくしかなかった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「騒ぐと、ぶった斬るぞっ」刃を突きつけると、堂衆の一人は盲目的に賊へ武者ぶりついた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あれーッ」　乙吉とお三輪が、金切り声をしぼって謝まるのを、お十夜は耳にも貸さないで、「こいつめ、ヒイヒイいうとぶった斬るぞ。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「出さぬと、ぶった斬るぞ。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「踊るやつは、ぶッた斬るぞッ」　おどろくべき乱暴者が、いつのまにやら、この極楽へまぎれこんでいたのだ。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "声をたてると、ぶッた斬るぞ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぶッた斬るぞ」ひっさげている直刃の戒刀を、山伏は、怒っている眼の上にふりかぶって見せた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間に、変な素振りをしやがると、ぶッた斬るぞ。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
