        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "居酒屋で親友相手に、職場への不満を三時間もブチ撒けてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ずっと隠していた過去の過ちを、ついに彼女にすべてブチ撒けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "溜まりに溜まったストレスを、カラオケで大声で歌ってブチ撒けてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
