      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "行きついてみると、なるほど熊仲和尚の報告どおり、南部名物くまの手踊りはいまし興行のさいちゅうでありました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "耳のない浪人",
                "note": "青空文庫"
              }
            },
            {
              "text": "その以外の事実は全部名探偵……すなわち吾輩の推量通りであった。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の神道が、天部名になる外に、漢名を称した事もあつたはずである。",
              "citation": {
                "source": "ほうとする話",
                "author": "祭りの発生　その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "相模國足柄上郡三久留部氏は、元來｜三※部名に居た爲に稱した家名で、又釋迦牟尼佛とも書いて、訓は地名家名の通りである。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "相摸国足柄上郡三久留部氏は、元来｜三廻部名に居た為に称した家名で、又釈迦牟尼仏とも書いて、訓は地名・家名の通りである。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "相摸國足柄上郡三久留部氏は、元來｜三※部名に居た爲に稱した家名で、又釋迦牟尼佛とも書いて、訓は地名・家名の通りである。",
              "citation": {
                "source": "山越しの阿彌陀像の畫因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "相摸国足柄上郡三久留部氏は、元来｜三廻部名に居た為に称した家名で、又｜釈迦牟尼仏とも書いて、訓は地名・家名の通りである。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "かう言ふ風に考へると、磐之媛その他の伝記の長い人々には、さうした子部名部が在つて、新作の叙事詩を伝承して、前期王朝の中期飛鳥藤原時代には、古叙事詩と同様視せられる程になつて居たのだと思ふ。",
              "citation": {
                "source": "語部と叙事詩と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "二「異部名字難必和會」の原則　その外に多くの人が、富永の原則の尊いことに氣の付かないものがあります。",
              "citation": {
                "source": "大阪の町人學者富永仲基",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは「異部名字難必和會」といふ原則です。",
              "citation": {
                "source": "大阪の町人學者富永仲基",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで富永は異部名字必ずしも和會し難しと言うて居る。",
              "citation": {
                "source": "大阪の町人學者富永仲基",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎も角大體この傳説時代の事は一つに極めるといふことが困難だと考へ出したのは、異部名字必ずしも和會し難しといふ原則であります。",
              "citation": {
                "source": "大阪の町人學者富永仲基",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那では之を一家言と申しまして、皆人によつて言ひ傳へが違ふので、即ち異部名字と同じやうなことであります。",
              "citation": {
                "source": "大阪の町人學者富永仲基",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "之と同じ話で段々異部名字式に變つて來た話でございますが、矢張り淨土宗の坊さんが書いた「大日比三師講説集」といふ本がありまして、富永は佛教の惡口を言うたので到頭癩病になつた。",
              "citation": {
                "source": "大阪の町人學者富永仲基",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が古い姓氏だの部名に就ていくらかでも知識のあるのはこの人の伝記を依頼せられて調べたことに由来し、実際この人の郷里に残る字の名や氏神などに氏族の伝統を語る名残りが歴然と有り、茫々二千年三千年、私もいささか感慨があった。",
              "citation": {
                "source": "露の答",
                "author": "ぬばたまのなにかと人の問ひしとき露とこたへて消なましものを",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が古い姓氏だの部名に就ていくらかでも知識のあるのはこの人の伝記を依頼せられて調べたことに由来し、実際この人の郷里に残る字の名や氏神などに氏族の伝統を語る名残りが歴然と有り、茫々二千年三千年、私もいさゝか感慨があつた。",
              "citation": {
                "source": "露の答",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "波越氏は読者も知る、警視庁刑事部名うての鬼刑事だ。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
