  {
    "uuid": "3a18809d-b320-58e6-94df-c6fc4428cf74",
    "entry": "部名",
    "reading": {
      "primary": "ぶめい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
