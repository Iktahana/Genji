    },
    "definitions": [
      {
        "index": 1,
        "gloss": "rudeness",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "目上の方に向かってそのような言葉遣いをするとは、いくら何でも無礼千万である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は酒に酔うと気が大きくなり、周囲の人に対して平気で無礼な振る舞いをするので困っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "取引先の担当者に大変無礼な態度をとってしまったため、急いで菓子折りを持って謝罪に伺わなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ひとがひとの能力を試みるなんてことは、君、容易ならぬ無礼だからね」「そうです」「と言ってみただけのことさ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の無礼な嘲笑に対して、堪忍出来なかった。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "調子に乗って馬鹿な事を言って、無礼者！",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すすめられるままに、ただ阿呆のように、しっかりビイルを飲んで、そうして長押の写真を見て、無礼極まる質問を発して、そうして意気揚々と引上げて来た私の日本一の間抜けた姿を思い、頬が赤くなり、耳が赤くなり、胃腑まで赤くなるような気持であった。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、御無礼」　列車は、食堂車を中に挟んで、二等と三等とに振り分けられていた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その侍、ハハッ、と平伏して「知らぬ事とは申せ無礼の段平に」と謝まった。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「師に向って　無礼の雑言ッ！",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「無礼講」という言葉が残っており、西洋でも「エプリルフール」という事がある。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは当家の伜久次郎どのがお姫様に対して無礼を働いたというのであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしてもたゞ今は又もやとんだ無礼をはたらきました。",
              "citation": {
                "source": "電車",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「無礼者ッ」　と叫んだのが結城左久馬の連中。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「無礼だなあ」　外はみぞれ、何を笑うやレニン像。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この子は、将来きっと百千の人のかしらに立つ人ゆえ、かならず無礼あってはならぬと、わが子ながらも尊敬、つつしみ、つつしみ、奉仕した。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまのあの編輯人の無礼も、かれの全然無警戒のしからしめた外貌にすぎない。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらが何もせぬのに、突然わんといって噛みつくとはなんという無礼、狂暴の仕草であろう。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "わかい女のまえで、白痴に近い無礼を働いたということは、そのころの私にとって、ほとんど致命的でさえあったのである。",
              "citation": {
                "source": "断崖の錯覚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わかい私には、そのような一夜を明して、女をひとりすげなく帰すのは、許しがたい無礼であると考えられたのである。",
              "citation": {
                "source": "断崖の錯覚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄には、決してごめいわくをおかけしません（この辺は真実ならんも、また、あてにすべからず）「太宰がちょっとした失敗をして、困っているから、」と申して（申してとは、あやしき言葉なり、無礼なり）借りて下さい。",
              "citation": {
                "source": "誰",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お金、送るなり、又、兄御自身お遊びがてら御持参くだされたら（かれ自身は更に動く気なきものの如し、かさねて無礼なり）よろこび（よろこびとは、真らしきも、かれも落ちたるものなり）これに過ぎたるは、ございません。",
              "citation": {
                "source": "誰",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は力を感じたので、その二匹の馬が私をすぐ身近に放置してきっぱりと問題外にしている無礼に対し、不満を覚える余裕さえなかった。",
              "citation": {
                "source": "玩具",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「だまれ、無礼もの、その方などの口を出すところでない。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは猫仲間では、目上の人にも無礼なことでも何でもなく、人ならばまづ鬚でもひねるぐらゐのところですから、それはかまひませんけれども、いけないことは、足をふんばつたために、テーブルが少し坂になつて、べんたうばこがするするつと滑つて、たうとうがたつと事務長の前の床に落ちてしまつたのです。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして応接する人間もたぶんはそれほど無作法に無礼でもなさそうに想像される。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「無礼者……とは、かく申す拙者のことですよ……酔っている？",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴女が暇乞いをして立つ時、父は物優しくファニーの無礼をことわって、いちばん美しい薔薇を返してもらった。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "無礼なやつだ君は我輩を知らんか。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッハッハ、失礼、署長さん署長さん、もう斯うなったらいっそのこと無礼講にしませう。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おゝい、みんな無礼講だぞ、そもそもだ、濁密の害悪は国家も保証する、税務署も保証すると、ううぃ。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "感傷の塔萩原朔太郎塔は額にきづかる、螢をもつて窓をあかるくし、塔はするどく青らみ空に立つ、ああ我が塔をきづくの額は血みどろ、肉やぶれいたみふんすゐすれども、なやましき感傷の塔は光に向ひて伸長す、いやさらに伸長し、その愁も青空にとがりたり。",
              "citation": {
                "source": "感傷の塔",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「け、けしからん、そんな、そんなぶれいな詞をつかうのか」　章一は力まかせに蹶た。",
              "citation": {
                "source": "一握の髪の毛",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
