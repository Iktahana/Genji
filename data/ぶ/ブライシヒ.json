        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "近くは『世界史の段階構造及び諸法則』の著者クルト・ブライシヒに於て見られるものの如きがそのひとつの場合である。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度植物の生活に於て芽と蕾、花と實が相次いで現はれ、相承けて發展するやうに、民族の生活に於ても、原始時代の幼年期、古代の少年期、中世の青年期、近世の壯年期、最近世の老年期が互に相從ふ、とブライシヒは云ふ。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくの如くブライシヒは歴史的事象を生物の形態學的構造とのアナロジーに於て觀察した。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがその少年期、青年期、壯年期、老年期を順次に經過すると見られることはブライシヒなどの場合と同樣である。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
