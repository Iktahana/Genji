[
  {
    "uuid": "b6408be0-d3e3-5f0f-8ba3-0b3e6d79874d",
    "entry": "鞦韆",
    "reading": {
      "primary": "ぶらんこ",
      "alternatives": [
        "ブランコ"
      ],
      "is_heteronym": false
    },
    "grammar": {
