      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "swing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "公園の鞦韆に乗って、空に届きそうなほど高く漕ぐのが子供の頃の楽しみだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "誰もいない夕暮れの校庭で、鞦韆が風に吹かれてキーキーと寂しい音を立てていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "お父さんが庭の大きな木の枝にロープを縛り付けて、手作りの鞦韆を作ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "鞦韆に四、五人子供が集まって騒いでいる。",
              "citation": {
                "source": "根岸庵を訪う記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鞦韆を拵えてお遣んなさい。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、鞦韆に乗って、瓢箪ぶっくりこ、なぞは何でもない。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "中の生垣を隔てて、広い芝生があり、周辺には四阿屋、竹に万古焼の狸、鞦韆。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは鞦韆の索であった。",
              "citation": {
                "source": "断橋奇聞",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鞦韆の索を投げて世高の来るのを待っていた秀英は、月の光に世高が牆の上にあがってきて、それから老樹の枝に移ったのを見て喜んだが、喜ぶまもなく世高が墜ちたので、気を顛倒さして走って往った。",
              "citation": {
                "source": "断橋奇聞",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は鞦韆の索を枝に結えなおして泣いた。",
              "citation": {
                "source": "断橋奇聞",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに鞦韆の架があったが、それは雲と同じ高さのもので、その索はひっそりと垂れていた。",
              "citation": {
                "source": "西湖主",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「公主はお馬でお疲れになっておりますのに、それでも鞦韆をあそばされますか」　女郎は笑って頷いた。",
              "citation": {
                "source": "西湖主",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "陳は花苑の中から女達の方を見ているうちに、魂がぬけでたようになっていたが、そのうちに人声がもうしなくなったので、這い出して鞦韆の架の下へ往き、そのあたりを歩きながら女のことを考えていた。",
              "citation": {
                "source": "西湖主",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皮想の見解の輩は、處女膜の存否を、男を知たか否の試金石の如く主張するが、既に支那の小説金瓶梅二五回にも、女兒が鞦韆より滑つて、板に一件をすり付け損じた、後ち人に嫁がしむると、是は素女でないとて逐歸された話あり。",
              "citation": {
                "source": "蓮の花開く音を聽く事",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後は奈々子が一晝寢してからであつた、雪子もお兒も鞦韆に飽き、寢覺めた奈々子を連れて、表の方に居る樣子であつたが、格子戸をからり明けて駈け上りざまに三兒は吾勝ちと父に何か告げんとするのである。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が牛舍の流しを出て臺所へあがり、奧へ通つた内に梅子と女中は夕食の仕度に忙しく、雪子もお兒もうろ／＼遊んでゐた、民子も秋子も鞦韆に遊んでゐた。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "公園の鞦韆は寂しさうに垂れ下つて居りました。",
              "citation": {
                "source": "辞書と新聞紙",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "また機巧あり、ベルトが睹た尾長猴はいかにこんがらがった鎖をも手迅く解き戻し、あるいは旨く鞦韆を御して遠い物を手に取り、また己れを愛撫するに乗じてその持ち物を掏った。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝生の綺麗な傾斜に添って、白い砂利道を行くと、噴水のある滝の前に赤いポストがあり、鞦韆に外国の子供が乗かってゐました。",
              "citation": {
                "source": "絵にそへて",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "明神の華表から右にはいって、溝板を踏み鳴らす細い小路を通って、駄菓子屋の角を左に、それから少し行くと、向こうに大きな二階造りの建物と鞦韆や木馬のある運動場が見えた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階造りの大きな建物で、木馬と金棒と鞦韆とがあった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し行くと二対の鞦韆！",
              "citation": {
                "source": "奥さんの家出",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また鞦韆が出来ていた。",
              "citation": {
                "source": "奥さんの家出",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鞦韆ばかりがあるのである。",
              "citation": {
                "source": "奥さんの家出",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊動円木、機械体操、廻転箱、また鞦韆、……そういうものの揃っている、小運動場の一画へ来た。",
              "citation": {
                "source": "奥さんの家出",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――“No entrance. The body has been identitied.”　額部に古い、微かな傷のあるのは、幼い時｜鞦韆から落ちた痕だと言う。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑や村が車窓をかすめて後へ後へと消え、沿道の電線は、鞦韆からでも眺めるように、目まぐるしく高まったり陥ちこんだりした。",
              "citation": {
                "source": "情状酌量",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと叢の羊歯が沼に対ってたれ下っている水際に桜の弁が溜っていて、右方の繁みの隙から、裾に風を孕んだ鞦韆の高く跳ね上って来る脚が白く見えた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "静三にとっては、この二階からぶらさがって来る綱は、夜、店が退けてから、鞦韆のかわりになった。",
              "citation": {
                "source": "昔の店",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのグーン、グーンと全体に響く、快よい鞦韆の鼓動！",
              "citation": {
                "source": "夢鬼",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女優の鞦韆も下からのぞこう。",
              "citation": {
                "source": "妾宅",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は鞦韆の鉄棒を握るとき右の手は内へ向けて握り、左はいつもそとへ向けた。",
              "citation": {
                "source": "ヒッポドロム",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして緑の中にシーソーや鞦韆の水色のペンキが新しい。",
              "citation": {
                "source": "測量船拾遺",
                "author": "三好達治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
