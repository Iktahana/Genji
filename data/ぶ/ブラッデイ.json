        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "七時八時九時と時計を見入つて登校の思ひに急がれるばかりだがいよ／＼もうブラッデイ氏の講義に間に合はぬとあきらめたら再び熟睡に落ちて十二時に醒めた。",
              "citation": {
                "source": "サフランの花",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕刻ブラッデイ氏帰校の途中来訪せらる。",
              "citation": {
                "source": "サフランの花",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "然らば余もその同罪なればその由ブラッデイ氏に申出でたるに何故か氏は余の言をとりあげざりし。",
              "citation": {
                "source": "サフランの花",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラッデイ夫人へ茶器、令嬢へ縮緬を贈る。",
              "citation": {
                "source": "サフランの花",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕刻雨止みて一同にて手製の食事を終りブラッデイ氏邸へキネスコープの見物に赴く。",
              "citation": {
                "source": "サフランの花",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月十一日（土）　晴、午後よりブラッデイ氏宅へ招かる。",
              "citation": {
                "source": "サフランの花",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "好意は有難いが同様の親切をブラッデイ家からも享けてゐるので進退に迷ひ辞退するより他はなかつた。",
              "citation": {
                "source": "サフランの花",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
