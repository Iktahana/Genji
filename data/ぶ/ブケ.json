[
  {
    "uuid": "2c17dd56-6663-5520-903c-03a3bac468c2",
    "entry": "武家",
    "reading": {
      "primary": "ぶけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
