        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "淡い粉雪　　　　　　Tinka John 作淡い粉雪はブリツキの薄い光に消えてゆく、老孃のさみしさか、青いその日も消えてゆく。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "淡い粉雪Tinka John 作淡い粉雪はブリツキの薄い光に消えてゆく、老孃のさみしさか、青いその日も消えてゆく。",
              "citation": {
                "source": "思ひ出",
                "author": "抒情小曲集",
                "note": "青空文庫"
              }
            },
            {
              "text": "流石にカブリツキは遠慮して、中央の席に坐る。",
              "citation": {
                "source": "間諜座事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云って今さら舞台の前のカブリツキまで出られないし、たとい出てみたところで何しろ小さい眼のことだ。",
              "citation": {
                "source": "間諜座事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度は暫く時間が立つて、火屋のないブリツキの小ランプを手に持つて帰つて来た。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸を這入つて、直ぐ左の所に、浴槽に多少似てゐる、大きいブリツキの盤がある。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして自分はブリツキの盤の側に残つてゐた。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し小屋の持主夫婦は細君にも己にも目を掛けずに、ブリツキの盤に引つ付いて、鎖で繋がれた犬のやうに吠えてゐる。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し我々は兎に角ブリツキの盤の側へ駆け寄つて不審に思ふと同時に敬意を表して、※の腹中に囚はれてゐる気の毒なイワンの詞を敬聴した。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "何れこれからは毎朝新聞記者が群をなして来て、このブリツキの盤の周囲を取り巻いて、最近の海外電報に対する僕の意見を聞くだらう。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは好いが、あのブリツキの入物を座敷に持ち込むには、どうしたものでせうね。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "曩日一外人ありて帝都に生きたるを飼養しあるブリツキ盤に近づき、傍人に一語を交へずしてはその儘彼の人物を口内に置く時は窒息すべきを以て、自営上止むを得ず彼の人物を嚥下せり。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も商売であるから、日劇小劇場では、一番前のカブリツキというところへ陣どり、沈々としてハダカを睨んでいる。",
              "citation": {
                "source": "安吾巷談",
                "author": "ストリップ罵倒",
                "note": "青空文庫"
              }
            },
            {
              "text": "森赫子等がカブリツキで見てるといふので「雛妓」気を入れたが、乗せ損った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "桃や蛤の形の紅白に染めわけたのを背中でふつて楽しみながら帰つてわつてみると紙でこしらへた小鼓やブリツキ製の笛などがでる。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
