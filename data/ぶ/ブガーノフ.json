          "literary": [
            {
              "text": "一、托児所は、村から追放された富農ブガーノフの小舎におくこと。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "真直ぐブガーノフの小舎さか？",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五のグリーシャ、年がら年じゅうブガーノフの耕地さぼいこくられて、聖母さまのお水のんで命つないでた。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あさっての三時から、ブガーノフの小舎へ集まるんだ。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　托児所にするブガーノフの小舎の羽目を二度目に塗りに行ったら、弱虫のリョーリャが、　――俺、やんだ！",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
