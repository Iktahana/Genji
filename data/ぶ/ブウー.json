            {
              "text": "ブウー、ブウー、ブウー……。",
              "citation": {
                "source": "エミリアンの旅",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "マントを頭からかぶつて、ブウー、ブウー、ブウー……と、子豚の鳴き声をまねました。",
              "citation": {
                "source": "エミリアンの旅",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブウー、ウー、ウー、警笛の声です。",
              "citation": {
                "source": "火事",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、たまを　にぎった　手を　たかく　あげると、みんなが　いっしょに　ブウー、と　サイレンの　まねを　しました。",
              "citation": {
                "source": "秋が　きました",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　こんな話をしているところへ、あちらから、自動車のブウ、ブウーという、警笛の音がしました。",
              "citation": {
                "source": "ねずみの冒険",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "魔力はそれをはなった持主の怒気をうけて、ブウーンと独楽の心棒に生命力をよみがえらし、蛾次郎の顔へうなりをあげておどってきた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
