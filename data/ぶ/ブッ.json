[
  {
    "uuid": "62c27527-077b-5653-b5e5-f4f52ce31b1c",
    "entry": "打っ",
    "reading": {
      "primary": "ぶっ",
      "alternatives": [
        "ブッ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
