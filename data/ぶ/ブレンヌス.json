          "literary": [
            {
              "text": "それに対して、ブレンヌス（訳者注　紀元前四世紀にローマを略奪せしゴールの首長）は答える。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "』けれどブレンヌスはローマを奪った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ローマを奪ったブレンヌスは一つの鷲である。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "またブレンヌスその他の者の命令の下に、無数の人々が潮のようにイタリアに侵入した。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
