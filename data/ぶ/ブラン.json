    },
    "grammar": {
      "pos": [
        "副詞-と",
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "hanging loosely",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "眠ってしまった子供の腕が、ベビーカーの横からぶらんと垂れ下がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "交通事故で肩を脱臼し、右腕がぶらんとして全く力が入らない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "古い人形の首が取れかかっており、糸一本でぶらんとしているのが不気味だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "午後は奈々子が一昼寝してからであった、雪子もお児もぶらんこに飽き、寝覚めた奈々子を連れて、表のほうにいるようすであったが、格子戸をからりあけてかけ上がりざまに三児はわれ勝ちと父に何か告げんとするのである。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が牛舎の流しを出て台所へあがり奥へ通ったうちに梅子とお手伝いは夕食のしたくにせわしく、雪子もお児もうろうろ遊んでいた、民子も秋子もぶらんこに遊んでいた。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてゆら／＼ゆら／＼と、ぶらんこみたいに揺られる。",
              "citation": {
                "source": "乳母車",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供らは網の上ですべったり、相撲をとったり、ぶらんこをやったり、それはそれはにぎやかです。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうさうこのときは丁度秋に蒔いた蕎麦の花がいちめん白く咲き出したときであの眼の碧いすがるの群はその四っ角な畑いっぱいうすあかい幹の間をくぐったり花のついたちひさな枝をぶらんこのやうにゆすぶったりしながら今年の終りの蜜をせっせと集めて居りました。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりゃ可いが天窓の上にござるぶらんこがどうもはや、今朝は我が一生の厄難だ。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその時、隣家の淡路館の裏にあります、ぶらんこを掛けました、柱の処で見ていたんですよ、一昨年ですわね、――巽さん。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉妹　…………少年　ぶらんこにものつて遊ばうと思つて来たんだけど。",
              "citation": {
                "source": "ラムプの夜",
                "author": "――学芸会のための一幕劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "｜釜右ヱ門は、穴のあいた鍋をぶらんぶらんとふりながら、また村にはいっていきました。",
              "citation": {
                "source": "花のき村と盗人たち",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "此処よりして見てあれば、織姫の二人の姿は、菜種の花の中ならず、蒼海原に描かれて、浪に泛ぶらん風情ぞかし。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、左の手は、ぶらんと落ちて、草摺の断れたような襤褸の袖の中に、肩から、ぐなりとそげている。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄棒にぶらさがっても、そのまま、ただぶらんとさがっているだけで、なんの曲芸も動作もできない。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "その満開の一枝に寒くぶらんとぶらさがっている縄きれを見つめていた。",
              "citation": {
                "source": "狂言の神",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "椿を突いた京子の右の手は其の儘前方に差し出たなり、左手はぶらんと下って、どちらも小刻みに顫え出した。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "えらいおやかまっさんでした」　他吉が頭を下げると、背中の君枝の頭もぶらんと宙に浮いて、下った。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピクピク動くたびに、ぶらんとした首がそこらじゅう這い廻るようであった。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、高いところで、ぶらんぶらんしていました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "豹一は醜態を見せぬ内にと思い、「お忙しいところをどうも……」ぶらんと頭を下げて、わりに新聞記者らしい言い方でそういうと、ふらふらと「オリンピア」を出て行った。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "この女の子たちよりも、大きい男きょうだいが、そのぶらんこに立ってのっています。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶらんこがゆれて、シャボンだまは、いろんなうつくしい色にかわりながらとんで行きます。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶらんこはとぶようにゆれています。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶらんこはゆれる、黒犬はひっくりかえって、ほえているわ。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ゆれるぶらんこ。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづく下枝の節の処へ、構わない、足が重るまでも一所に踏掛けて、人形の首を、藁苞にさして、打交えた形に、両方から覗いて、咽喉に嵌めて、同時に踏はずして、ぶらんこに釣下ろうという謀反でしてなあ。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのお茶ぴいめ、ついこないだまで竹馬に乗ったり、学校の生徒に引張り出されちゃあ田圃でぶらんこをしていたっけが、どうだい、一番この男とおっこちゃあがって、それ、お歳玉に内証だよ、と遣りゃあがったんだとよ。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "女王のは木綿の片に、そのかみやいかがはありし木綿襷心にかけて忍ぶらんゆゑ　とだけ書いてあった。",
              "citation": {
                "source": "源氏物語",
                "author": "榊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとうのことをいうと、おれはぶらんこをしていたんだよ。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
