          "literary": [
            {
              "text": "しかし職業劇団になつても取上げるものは通俗的なものでなくつて、例へば大したものぢやないけれどもまづブリユウ。",
              "citation": {
                "source": "対話",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏国現代の戯曲家と云へば、日本で、ブリユウや、ロマン・ロオランが、持て囃されたらしい。",
              "citation": {
                "source": "横槍一本",
                "author": "――外国文学の『味』――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブリユウや、ロオランの戯曲が、一体、どこが佳いのか。",
              "citation": {
                "source": "横槍一本",
                "author": "――外国文学の『味』――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブリユウなどが早く紹介されたにした処で。",
              "citation": {
                "source": "過渡時代",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "その傍らで、ブリユウが、腐りきつて頬杖をついてゐる。",
              "citation": {
                "source": "芝居と僕",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
