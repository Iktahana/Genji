        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二月二十日（土曜）　モヤー、ブブノワ。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブブノワ、始めて皮肉で、或娘の写真を見せて、この娘さんは利口だったとか、日本の女は利口で、真面目だが、目的をもたない、と云ったとか云った由。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人、神楽坂で、尾沢食堂で一寸たべ、ブブノワさんのところへ行く。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分をブブノワさん肖像にかくと云う。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "八木さん達、□事課の男　夕方ツーリスト・ビューローへは父上が行って下すったので、自分日露協会へ廻り、それからブブノワさんのところへ紹介状、届けるものなどとりに行った。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "出たついで故、そのまま一寸宿へよって、土産物をもって、ブブノワさんに紹介状をもらった人のところへ行かけた。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月七日（土曜）　朝十二時頃よりクレムリンの中の歴史博物館へ行ったが、ブブノワ女史の紹介して呉れた人居ず。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "シチェプキナさんに会うことが出来、ブブノワさんからの土産を渡し、やっと安心した。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月三日（土曜）　Ｙ、ブブノワ。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月七日（土曜）　博物館の仏画展覧会を※ーリャ・ブブノワと見る。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブブノワ、よき人なれども一向芸術家でない。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、ブブノワ、そのためによんだ、チェホフの短篇を話してくれる。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブブノワ来るかと思い、ちゃんとその仕度をしたが来ず。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
