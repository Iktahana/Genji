          "literary": [
            {
              "text": "一九〇一年三月、彼は、ジェリヤ・ブルマールという二十二歳になる婦人を襲った事がある。",
              "citation": {
                "source": "殺人狂の話",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその日彼女を自分の室にさそいこみ、それから急に乱暴をはじめて女を虐待し、ついにブルマールを床の上に仆して口から出血させるに至った。",
              "citation": {
                "source": "殺人狂の話",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルマールは、従うと見せて、相手の隙を見てほんとうに危い所で身を以って僅かに逃れた。",
              "citation": {
                "source": "殺人狂の話",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
