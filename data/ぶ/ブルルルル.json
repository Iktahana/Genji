        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "がら・がら・がら・がらぶるるるるるるるるる　Ｂｒｒｒｒと唇をふるわして、彼は、金属性の扣鈕を二つ三つコップへ入れて振る。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "街上をあるいていてさえ、どこからともなくいきなり駈けて来て、足下に平伏するやつがあると思うと、すでにそこで二つの真鍮のコップを叩いて「がら・がら・がら・ぶるるるる」を遣り出している。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ぶるるるるるる。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶるるるると云う音は、龍介をのせた飛行機のプロペラの音だったのだ。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、どこからか、ぶるるるるる……という、へんな音が聞こえてきました。",
              "citation": {
                "source": "奇面城の秘密",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、そのとき、ぶるるるん、ぶるるるん、ぶるるるるる……という音が、かすかに聞こえ、スウッとからだが浮きあがるような気がしました。",
              "citation": {
                "source": "奇面城の秘密",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくすると、はるかむこうの空から、ぶるるるる……という音が聞こえ、それが、だんだん大きくなってきました。",
              "citation": {
                "source": "奇面城の秘密",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
