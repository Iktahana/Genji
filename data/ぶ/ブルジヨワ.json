          "literary": [
            {
              "text": "だから「別莊行き」には皮肉な意味を除けば、ブルジヨワの使ふ「休息」さういふ言葉通りの意味も含まつてゐた。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルジヨワ的教育法の根本は――方法論は「錯覺法」だつた。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルジヨワの階級はまだ全く破滅の瀬戸際まで追込められてしまつたのではない。",
              "citation": {
                "source": "羊羹",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
