    },
    "definitions": [
      {
        "index": 1,
        "gloss": "soft",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このゼリーは、触るとブヨブヨしていて、すぐに崩れてしまいそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "長期間運動しなかったせいか、お腹がブヨブヨになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "水たまりに落ちたボールが、ブヨブヨと音を立てて跳ね返った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、腹部は八戒自身に似てブヨブヨ膨れており、短い前肢で二、三歩｜匍うと、なんとも言えない無恰好さであった。",
              "citation": {
                "source": "悟浄歎異",
                "author": "―沙門悟浄の手記―",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつが心臓の出口の大動脈の附根に引っかかると二年か三年か経つうちにそこいらの血管がブヨブヨに弱くなって来る。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "中年以上の男では猶一層のことで、殊にデコボコの多い膏ぎつてブヨブヨした感じのするのなどは見るのもいやです。",
              "citation": {
                "source": "サニンの態度",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがその右腕と並行し、左の腕のあるべき位置に、着物の袖ばかりがブヨブヨと、火気に煽られて戦いでいるのは、いったいどうしたというのだろう？",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ世の中のことを知ったようでまだ知りきれない半じゅく玉子のようなブヨブヨした私の心にはいろいろな不思議な事があり又不安心な事が大沢山ある。",
              "citation": {
                "source": "妙な子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女郎人形なんていうと美しいが、ブヨブヨで汚ねえってね。",
              "citation": {
                "source": "朝散太夫の末裔",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああそうそう、あのブヨブヨした堤灯形の段だらだけは、貴方にはご存知がないはずです。",
              "citation": {
                "source": "白蟻",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幹枝の腹から出た腹水と、膜嚢を容れた大きな硝子盤が、その上に載っていて、褐色をした濁った液体の中に、二十余り鼈の卵みたいに、ブヨブヨしたものが浮いていた。",
              "citation": {
                "source": "失楽園殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四方同じ肉色の壁で、それが変にブヨブヨしている。",
              "citation": {
                "source": "鵞湖仙人",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "岐阜人もなかなか自慢らしいが、瀬が激しくないとみえて身がしまらず、ブヨブヨしていて一流品とはいい難い。",
              "citation": {
                "source": "鮎の名所",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "湿っぽいブヨブヨしたものの上に仰臥しているのだが、虚脱したようになって身動きする気にもならない。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "背が低くて青黒くて、不攝生な生活と酒毒にやられたブヨブヨした身體、昔はいくらか良かつたであらうと思はれる眼鼻立も、この不健康に害ねられて、まともに見る影もありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "用心棒",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒヨロヒヨロの友吉や、ブヨブヨの又五郎では無い」「すると順八」「あの男だよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "用心棒",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかもの喰ひの萬兵衞が、夜鷹か何んかの一番丈夫で脂臭くて、ブヨブヨしたのを拾つて來たんだらうといふ噂ですが、近頃その小汚いのに嫌氣がさしたやうで、出すとか出るとかブスブス燻つてゐるさうです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "棟梁の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかもの喰いの万兵衛が、夜鷹か何かの一番丈夫で脂臭くて、ブヨブヨしたのを拾って来たんだろうという噂ですが、近頃その小汚いのに嫌気がさしたようで、出すとか出るとかブスブス燻っているそうです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "棟梁の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "樵夫の鈍い叫声に調子づけるように、泥がブヨブヨの森の端で、重荷に動きかねる木材を積んだ荷馬を、罵ったり苛責したりする鞭の音が鋭く響く。",
              "citation": {
                "source": "禰宜様宮田",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベニヤのなまくらのはり合わせがふくれてガタガタのブヨブヨというようなのは御免です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのデブデブ肥った肉体が、いまだに生ける時のようにブヨブヨしている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その色が以前よりは白くなったように見えるだけで、ブヨブヨした肉体はちっとも変りがないらしい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "海底の様に藻の林はないけれど、その代りに、木切れ藁束ドロドロの布屑、犬とも猫とも知れぬ小動物の白骨などが、濁った水底にブヨブヨと蠢いている様は、海などよりも一層不気味に物凄かった。",
              "citation": {
                "source": "猟奇の果",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブヨブヨと薄気味悪い手触り。",
              "citation": {
                "source": "猟奇の果",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "人形の肌は、まるで腐った果物のようにブヨブヨと柔かかったからである。",
              "citation": {
                "source": "悪魔の紋章",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブヨブヨと物の怪でも泳いでいそうな感じがした。",
              "citation": {
                "source": "何者",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "皮膚を押して見ると、妙にブヨブヨしていて、少し強く当たれば、ズルリと皮が破れ相なのです。",
              "citation": {
                "source": "パノラマ島綺譚",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
