[
  {
    "uuid": "5501de77-5cf9-5265-b872-0132463e26ef",
    "entry": "ブヨブヨ",
    "reading": {
      "primary": "ブヨブヨ",
      "alternatives": [
        "ぶよぶよ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-の形容詞",
        "形容動詞",
