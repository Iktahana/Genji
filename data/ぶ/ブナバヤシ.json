          "literary": [
            {
              "text": "さて、東海は、デンマルク領のぶな林で――」「いいだしがすてきだわ。",
              "citation": {
                "source": "ひこうかばん",
                "author": "DEN FLYVENDE KOFFERT",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして材木坂のブナ林が新雪で綺麗に飾られていました。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "霧のためにブナ林もぼんやり霞んで遠くは見えない。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼頃ちょっとスキーの練習にブナ林を下ってみる。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小屋を出てだいたい左寄りに広いブナ林の中を登って行く。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なおも称名川を見下しながら同じようなブナ林の中を登って行く。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この平原をしばらく進んで行くとまたブナ林が現われ、その中を一時間も登ると称名ノ滝の音がドウドウと足元から響いてくる。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宙に浮いた鉄棒と執事とのたたかいは、ブナ林をぬけて、なおもつづいた。",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「人見と巨勢さんはブナ林の径へ曲りましたが、僕は裏道を通って、つまり内海の大八車が通ったという道の方を歩いたわけです」「そのとき内海さんに会われたのですね」「どう致しまして。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして再び、今来た間道を駈けぬけて元の道へ現れ、ブナ林の方から何事もなかったように、そして、今鉱泉からマッスグ戻ってきたように御帰館あそばされた次第であります」二十八　ぬきさしならぬ物的証拠　あざやかな推理であった。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
