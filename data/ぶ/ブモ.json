          "literary": [
            {
              "text": "相手「貴局ト通信ガ出来ルコトヲ甚ダシク喜ブモノナリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "疇昔余ノ風流絃歌ノ巷ニ出入セシ時ノコトヲ回顧スルニ、当時都下ノ絃妓ニハ江戸伝来ノ気風ヲ喜ブモノ猶跡ヲ絶タズ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "客ノ至リテ言ノ時事ニ及ブモノアレバ則恠譚以テソノ端ヲ折ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの起源は今ではふつう急性黄色肝萎縮症で排泄されたチロシンやロイシン、および尿中にあるアルブモース（＊変性タンパク質）に起因するとされている。",
              "citation": {
                "source": "先天性代謝異常",
                "author": "INBORN ERRORS OF METABOLISM (1909)",
                "note": "青空文庫"
              }
            },
            {
              "text": "名犬ハ税トシテモ貴マレ、一匹ノ価、百貫ヲ呼ブモアリ、武門｜悉ク、犬ヲ繋ギ、犬ニ仕へ、日、暮ルレバ又、宴楽アルノミ。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            }
          ]
        }
