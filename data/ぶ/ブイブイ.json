          "literary": [
            {
              "text": "五　和太郎さんの年とったおかあさんは、ぶいぶいと糸くり車をまわしては、かた目で柱時計を見あげ見あげ、夜おそくまで待っていました。",
              "citation": {
                "source": "和太郎さんと牛",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "急激に軽くなる川舟は驚いたようにぶいぶいと浮きあがった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯車のついた竹筒をぶいぶいとまはしながら「ほほづきやーい　ほほづき」と呼ぶ。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
