        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナトール・ル・ブラの「ブリトン伝説学」やガウルドの「オールド・ニック」までも渉猟して、性別転換の深奥に潜んでいて犯罪動機に符合するものを、中欧｜死神口碑の中に見出そうとした。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただしエリスの『古英国稗史賦品彙』二版一巻六二頁に、古ブリトン王アーサーの父アサー陣中で竜ごとき尾ある彗星を見、術士より自分が王たるべき瑞兆と聞き、二の金竜を造らせ、一をウィンチェスターの伽藍に納め、今一を毎に軍中に携えた。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "其れから五年後ブリトン王ヴみに變じ、彼れは妾を強辱しかけたと讒言を信じ、大臣を捉えて早速絞殺の上支解せよと命じた所だ。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代ブリトン人の婚姻制度よりも徹底的に優秀な習慣を持つて居る。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは特にその部落を作ったこともあるが、一般人民と混って住み、丁度アングル人、サクソン人その他ピクト人、ブリトン人らが今日英国と称する島に共に住して段々血も混り、今では彼らは、一種確定せる特別な民族たることを誇るに由なく、かえってよく他の長所を吸収する包容力あることを自慢せると同じである。",
              "citation": {
                "source": "民族優勢説の危険",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその当時は古代のブリトン人が造ったような革舟（註六八）をまだ見ていなかったが、その後になって見たことがある。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "言葉はブリトン語でした。",
              "citation": {
                "source": "踊る地平線",
                "author": "白い謝肉祭",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーサー大王は、必ず帰り来る可とは、「ブリトン」人の信ずる所にして、「セルヴィア」人は、今尚其国民的英雄クラルエヴィッチ、マルコの帰り来りて、国民を率いて、立つの日ある可きを信じて之を待つ。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "つぎに彼は遠い北国に行った、北のゲエルどももブリトンの矢鳴りの音をおそるるようになり、山国のピクト族は貢を納めた。",
              "citation": {
                "source": "髪あかきダフウト",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブリトンの王グラッドロンがマルグヴェンと一緒にいるのを人が初めて見たのは遠い北方のアルバンの地であった。",
              "citation": {
                "source": "髪あかきダフウト",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルグヴェンはアルモリカ語を習いおぼえてからブリトンの酋長等にものいうこともあったが、彼女が求める男はただ一人であった、グラッドロンが彼女を愛した如く彼女もグラッドロンを愛していた。",
              "citation": {
                "source": "髪あかきダフウト",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまならブリトン人とか、スコットランド人とか、アイルランド人とかを自慢する男は理解できます。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリガーセン、ブリトン人を困らせるだけではいけません。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブリトン人は強さと意志を持っています。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際、自由の身に生まれた４百人のブリトン人は、そんなに急に回れ右できない。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
