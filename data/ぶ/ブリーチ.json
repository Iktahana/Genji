        "examples": {
          "standard": [
            {
              "text": "洗濯槽の汚れを落とすために、強力な漂白剤（ブリーチ）を使った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "髪の色を明るくするために、美容師は慎重にブリーチ剤を塗布した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「このシミ、普通の洗剤じゃ落ちないから、ブリーチで試してみよう。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "カリフォルニアの太陽で色素がブリーチされてしまったのだと、彼女は言っていた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
