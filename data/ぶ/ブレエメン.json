        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "フリツチイは目下ブレエメンの港なる大商店に奉公し居る男と結婚の約束を為し居り、遠からず彼地に赴く筈に候。",
              "citation": {
                "source": "アンドレアス・タアマイエルが遺書",
                "author": "ANDREAS THAMEYERS LETZTER BRIEF",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し今の儘にて行を改めざる時は、ブレエメンに在る許嫁の良人は定めて不幸に感ずるならむと存じ候。",
              "citation": {
                "source": "アンドレアス・タアマイエルが遺書",
                "author": "ANDREAS THAMEYERS LETZTER BRIEF",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はブレエメンの生れで――それは話をする時、音がなんだかかわいらしくゆがめられたようになるのでもわかる――二年前彼地で、豪商クレエテルヤアンに生涯を委ねた。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あなたはブレエメンでお生れなったのでしたね。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "さながらブレエメンが、比類のない都会、名づけがたい冒険と秘められた美しさとにみちた都会で、そこで生れたということが、ある神秘なけだかさを人に与えるかのようである。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたくしブレエメンの生れですのよ。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
