    },
    "definitions": [
      {
        "index": 1,
        "gloss": "laws of nature",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "どれだけ精神論を振りかざしても、物理の法則を無視して空を飛ぶことはできない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "水は高いところから低いところへ流れるのが物理の摂理だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "魔法のような現象に見えるが、種明かしを聞けばすべて単純な物理に従っているだけだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "――額をみ給へ――一度は神も客観してやりました――不合理にも存在価値はありませうよだが不合理は僕につらい――こんなに先端に速度のある自棄　々々　々々下駄の歯は僕の重力を何といつて土に訴へます「空は興味だが役に立たないことが淋しい――精神の除外例にも物理現象に変化ない」ガラスを舐めて蠅を気にかけぬ",
              "citation": {
                "source": "（古る摺れた）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは恰度、音楽に鈍感な女の人が、オーケストラを聴いてゐて、フリュートなぞが単独に吹奏される部分でだけ、音そのものの物理的な快味にだけ感じ入るのに似てゐて、私は明治以降の殆んど全ての文学者が、外国文学の作品を読む時も、そんなやうなものであつたと云つても、強ち過言とは思はないのである。",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の子供たちの悦ぶ玩具は、物理學を應用した種々の機械類の模型であり、飛行機や、電信機や、潛水艦やのメカニカルな組立玩具である。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――郷土望景詩――虎虎なり曠茫として巨像の如く百貨店上屋階の檻に眠れど汝はもと機械に非ず牙齒もて肉を食ひ裂くともいかんぞ人間の物理を知らむ。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一回の講義の始めに、人間本位の立場から物理学を解放すべきことや物理的世界像の単一性などに関する先生の哲学の一とくさりを聞かせた。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはとにかくシュミット教授についてただ一つ可笑しかった事は、先生が英国の数理物理学の大家 Love のことをローフェと発音していたことである。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "地球物理談話会もほんの五、六人の仲間であったが、その中にまだ若いコールシュッター氏も交じっていた。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "気象や地球物理に比べて地理の方は輪講にも講義にも出席者が多く気分がまるで変っていた。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "気象輪講会は何となく上品にのんびりしていたし、地球物理輪講会は生真面目でしかも家族的な気分であったが、地理の輪講会には何となく物々しい人間臭い気分があった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "河岸に沿うて二、三町先のマルシャル橋の南詰の角に物理教室がある。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "物理学輪講会はルーベンスが座長であったがプランクもほとんどいつも欠かさず出席してこの集会の光彩を添えていた。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "物理の輪講会にはやはりまた特別の雰囲気があるのを面白いと思った。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネルンストの「物理化学」もひやかしに一、二度聴いたことがあったが、西洋人にしては脊の低いずんぐりした体格で、それが高い聴講席をふり仰ぎながら活溌に手を振り身体を動かし頸を曲げてゼスチュアの賑やかな講義をして見せた。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗合わせた農夫農婦などは銘々の大きな荷物に腰かけているからいいが、手ぶらの教授方以下いずれも立ったままでゆられながら、しきりに大気の物理を論じ合っていた。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ぬか、馬鹿になるか、と思われたそうであるが、幸いに死なずにすんでその代り少し馬鹿になったために、力に合わぬ物理学などに志して生涯恥をかくようになったのかもしれない。",
              "citation": {
                "source": "追憶の医師達",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "物理学者や化学者は物質を磨り砕いて原子の内部に運転する電子の系統を探っている。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしそれが成効して生命の物理的説明がついたらどうであろう。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "生命の物理的説明とは生命を抹殺する事ではなくて、逆に「物質の中に瀰漫する生命」を発見する事でなければならない。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローマの大学を訪ねたとき、物理学教室の入口に竹の一叢を見付けてなつかしい想いをした。",
              "citation": {
                "source": "郷土的味覚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもしこれが物理学の教科書か学術論文の中の文句であるとすれば当然改むべきはずであるが、随筆中の用語となると必ずしも間違いとは云われないかもしれない。",
              "citation": {
                "source": "随筆難",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "紺屋の白袴、医者の不養生ということもあるが、物理の学徒等が日常お互いに自由に話し合う場合の用語には存外合理的でないものが多数にあって、問題の「速度のはやい」などもその一例である。",
              "citation": {
                "source": "随筆難",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って、「速度のはやい」なども実感を強めるための俗語として「速度の大なるすなわち運動の速い」の略語として通用を許してもそれがために物理学は何の損害をも受ける心配はないかと思われる。",
              "citation": {
                "source": "随筆難",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、負惜しみのようではあるが、物理学を専攻する人間でも、座談や随筆の中ではいくらか自由な用語の選択を寛容してもらいたいと思うのである。",
              "citation": {
                "source": "随筆難",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "此處にも簡單な物理學が考慮の外に置かれてゐるのであつた。",
              "citation": {
                "source": "伊香保",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常な暴風のために空気中に物理的な発光現象が起るということは全然あり得ないと断定することも今のところ困難である。",
              "citation": {
                "source": "颱風雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "物理教室の窓枠の一つに飛火が付いて燃えかけたのを秋山、小沢両理学士が消していた。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネルンストとはこれを発明したドイツの物理学者の名をそのまま取って付けたのだ。",
              "citation": {
                "source": "ランプのいろいろ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "倶知安で買った弁当の副食物が、物理的には色々ちがった物質を使ってあるがどれにも味というものが欠けていた。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "物理学の方面だけで見ると一体にドイツ学派の仕事は単色で英国派の仕事には色彩の陽炎とでもいったものを伴ったものが多いような気がするが、それは唯そんな気がするだけで具体的の説明は六かしい。",
              "citation": {
                "source": "雑記帳より（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、女の癖に男のように頸の所でぶつりと切った髪の毛を右の手で撫であげながら、いつものとおりのやさしい顔をこちらに向けて、一寸首をかしげただけで何の御用という風をしなさいました。",
              "citation": {
                "source": "一房の葡萄",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
