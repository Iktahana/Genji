        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これはドイツのプロレタリア作家ブレーデルが彼の傑作「ＮウントＫ機械工場」でもやった扱いかたである。",
              "citation": {
                "source": "文芸時評",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハラーと彼の画家からケリーとブレーデルに至るまで、何世紀経った後まで医学者は美術家の助けを受けていることが繰り返して聞かされる。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケリーとブレーデルはジョンスホプキンス大学に立派な学派（＊1911に医学図版製作の学科）を作って半世紀にわたり合衆国に医学図版を描く専門家を供給した。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "メルゲル老人はブレーデの森の幽靈になってしまった。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃母親は、自分の弟の訪問をうけたが、この弟というのはブレーデに住んでいて、姉の馬鹿げた結婚以來、彼女の家の敷居を一度もまたいだことがないという人物であった。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこはブレーデの森が山脈の傾斜をくだって、眞暗な溪谷を埋めている所であった。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あれはブレーデの森だよ。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "粘土壁の小屋や、まれに煉瓦づくりの比較的ましな家を持ったブレーデの村が見えて來た。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の主張によると、彼らはブレーデの森をとおって歸る途中、メルゲル老人の幽靈に追っかけられたというのである。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "歸宅の途中、彼らはブレーデの森でひどい夕立におそわれて、山腹に立っている大きなブナの木のかげに逃げこんだ。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上、あの晩の幽靈話や、ブレーデの森での棒で打ち合う音や、高いところから聞えて來た叫び聲などが有力な證據であった。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後　ある晩方、約六十人のユダヤ人が、彼らの僧侶を先頭に、ブレーデの森にはいって行くのが見られた。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、一つの人影が、ブレーデの山を下りて、ゆっくりと村のほうへよろめいて行った。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前がブレーデの森で道に迷ったんじゃないかと思っていたところだよ。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしてブレーデの森を通らなかったの。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「みんながわたしに、ブレーデの森は伐られてしまって、今ではいろんな道が縱横についているからというものですから、もしかぬけられないと大變だと思ったのです。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨハネスがブレーデの森のはずれに坐って、さじを彫っているのを見かけたという子供があった。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は相變らずブレーデの森のまわりを歩きまわっているらしかった。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "二週間たって、若いブランデスは、彼の受持區域の巡視から、ブレーデの森をとおってもどって來た。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
