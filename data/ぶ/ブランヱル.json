        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "母は、マリヤ・ブランヱル、コオンウオルの商家の女、一八一一年、父が牧師補時代、ヨオクシヤーのハーツヘッドで結婚。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "解説",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八一七年、長男パトリック・ブランヱル生る。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "解説",
                "note": "青空文庫"
              }
            },
            {
              "text": "母の姉、老孃ブランヱル來つて、爾後二十年間、家政を看る。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "解説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後七年間、次妹エミリーは、家に留り、著者と末の妹アンは、諸方に家庭教師を勤めて、彼女等の唯一人の男兄弟パトリック・ブランヱルの爲に學資を稼いだ。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "解説",
                "note": "青空文庫"
              }
            },
            {
              "text": "學費その他は、前記の伯母、亡母の姉、老孃ブランヱルに借りた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "解説",
                "note": "青空文庫"
              }
            },
            {
              "text": "このころ、弟パトリック・ブランヱル、家にあつて酒亂。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "解説",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八四八年、八月、パトリック・ブランヱル肺患に倒る。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "解説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
