          "literary": [
            {
              "text": "彼はその話を警察に報告したし、死んだ百万長者ブレアム・ブルースのさしあたり唯一の代表者――つまり、故人の大へんキビキビした秘書のアンソニイ・テイラーという男にも報告した。",
              "citation": {
                "source": "青君の追跡",
                "author": "THE PURSUIT OF MR. BLUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｊ・ブレアム・ブルース「ヤレヤレ」とブラウンはおだやかに言つた。",
              "citation": {
                "source": "青君の追跡",
                "author": "THE PURSUIT OF MR. BLUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あすこの赤いスカーフをしている死体は百万長者ブレアム・ブルースの死体です。",
              "citation": {
                "source": "青君の追跡",
                "author": "THE PURSUIT OF MR. BLUE",
                "note": "青空文庫"
              }
            }
          ]
        }
