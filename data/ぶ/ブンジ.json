[
  {
    "uuid": "792742c4-456c-551b-9025-21c9fbcfb54b",
    "entry": "文事",
    "reading": {
      "primary": "ぶんじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
