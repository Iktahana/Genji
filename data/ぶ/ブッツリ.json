[
  {
    "uuid": "d2a97cb4-803c-5494-bb60-a9e798b7c715",
    "entry": "ぶっつり",
    "reading": {
      "primary": "ぶっつり",
      "alternatives": [
        "ブッツリ",
        "ぶつり",
        "ブツリ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
