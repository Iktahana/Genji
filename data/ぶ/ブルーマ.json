          "literary": [
            {
              "text": "黒い運動用のブルーマをつけて、赤いプラトークをかぶった三人の少女もまじっていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "島々へ入るすこし手前で、ルックサックからスカートを出して、ブルーマースの上からはいていたりしたが、如何にも山を下りて里へ出る有様をあらわして、私は思わず微笑した。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸子ちゃんのでなくても、雪子ちゃんのでもこいさんのでも、下着類なら何に依らず、ブルーマーなんかでも戴きます。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
