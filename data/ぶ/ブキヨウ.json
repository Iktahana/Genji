[
  {
    "uuid": "59b73b77-0b3e-5641-8e06-6ed02dee51ec",
    "entry": "不器用",
    "reading": {
      "primary": "ぶきよう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
