      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "無器用なお前樣が此子いぢくる譯にも行くまじ、お歸りに成るまで私が乳を上げませうと、有さまを見かねて、隣の妻の子を抱いて行くに、何分お頼み申ますと言ひながら、美尾の行衞に心を取られてお町が事はうはの空に成ぬ。",
              "citation": {
                "source": "われから",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さもなければ、無器用朴訥な愛嬌で助かる。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の方を仰ぐと、赤沢岳が無器用な円頂閣のように、幅びろく突ッ立って、その花崗岩の赤く禿げた截断面が、銅の薬鑵のような色をして、冷めたく荒い空気に煤ぶっている。",
              "citation": {
                "source": "槍ヶ岳第三回登山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲消えて皹も亦拭ひ去らる、山色何の瑠璃ぞ、只だ赭丹赭黄なる熔岩の、奇醜大塊を、至つて無器用に束ねて嶄立せるのみ、その肩を怒らし胸を張れるを見て、淑美なる女性的崇高を知らず。",
              "citation": {
                "source": "霧の不二、月の不二",
                "author": "――明治三十六年八月七日御殿場口にて観察――",
                "note": "青空文庫"
              }
            },
            {
              "text": "無器用ものの、こった一念の強さほど尊いものは無いのだ。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにをさせても無器用なお前が。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も、既に四十ちかくに成りますが、未だ一つも自身に納得の行くような、安心の作品を書いて居りませんし、また私には学問もないし、それに、謂わば口重く舌重い、無器用な田舎者でありますから、濶達な表現の才能に恵まれている筈もございません。",
              "citation": {
                "source": "風の便り",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭はわるし、文章は下手、学問は無し、すべてに無器用、熊の手さながら、おまけに醜貌、たった一つの取り柄は、からだの丈夫なところだけであった。",
              "citation": {
                "source": "答案落第",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし豚は棒を持った男が近づいて来ると、それまでおとなしくしていたやつまでが、急に頭を無器用に振ってはねとびだした。",
              "citation": {
                "source": "豚群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やかましいねえ、お前の足ったら、何て無器用なんだらう。",
              "citation": {
                "source": "黒ぶだう",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "無器用な小供のように卒直に歩く――実は長い洋行後｜駒下駄をまだ克く穿き馴れて居ないのだ。",
              "citation": {
                "source": "かの女の朝",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "荘子は扉を無器用に開けて土間へ入って来た。",
              "citation": {
                "source": "荘子",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "無器用な彼は林檎一つむけず、そんな妓の姿に涙が出るほど感心し、またいじらしくもあり、年期明けたら夫婦になろうと簡単に約束した。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "無器用な彼は林檎一つむけず、そんな妓の姿を見て簡単に夫婦約束をなし、年期明けたら夫婦になろうと誓言をとりかわした。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "無器用にお茶を置くと、黙々と固い姿勢のまま出て行った。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして相変わらず短いしっぽで、無器用なコンダクターのようにいろいろな∞の字を描いていた。",
              "citation": {
                "source": "ねずみと猫",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "器械文明が発達すれば、精密なことは器械がしてくれるから人間はだんだん無器用になってもいいかというに、そうではなくて精密な器械を使うにはやはり精密な感官を要するので、器械の発達につれて人間も発達しなければ間に合わない。",
              "citation": {
                "source": "記録狂時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "少歳が無器用な男で何事をするにも廻りくどい、眞奈は見かねてさうせばよいかうせばよいなどゝいうては時々少歳に叱りつけられる。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "長たらしい茎へ無器用にヒッつけたような薄きたない円葉をうるさく振りたてて――どうも虫が好かぬ。",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　銀子は無器用に抱きかかえ、起ちあがって揺すってやったが、いよいよ渋面作り泣き出した。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お作は無器用な手容で、大きな銚子から酒を注いだ。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と太夫は言っていたが、父親はこんな無器用なものには、芸事はとてもダメだと言って真面目に失望した。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "お庄は母親の髪の弄り方や結い方が無器用だと言って、鏡に向っていながら、頭髪をわざと振りたくったり、手を上げたりした。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "台所には、すべてに無器用な婆さんを助けに、その娘のお銀という若い女も来て、買物をしたり、お汁の加減を見たりした。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "しげしげ足を運んでくる生花の先生は、小野田が段々好いお顧客へ出入りするようになったお島に習わせるつもりで、頼んだのであったが、一度も花活の前に坐ったことのない彼女の代りに、自身二階で時々無器用な手容をして、ずんどのなかへ花を挿しているのを、お島は見かけた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            }
          ]
        }
