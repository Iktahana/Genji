        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "入學早々、ブルウル氏といふ英人の教師が、What is Real Happiness? といふことについて生徒へその所信を書くやう命じたのである。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルウル氏は、その授業はじめに、My Fairyland といふ題目でいつぷう變つた物語をして、その翌る週には、The Real Cause of War について一時間主張し、おとなしい生徒を戰慄させ、やや進歩的な生徒を狂喜させた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルウル氏は、チエホフに似てゐた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのやうに何やら神祕めいた雰圍氣が、ブルウル氏をいつそう魅惑的にした。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのブルウル氏が、三週間目の授業のとき、だまつてボオルドに書きなぐつた文字が What is Real Happiness? であつた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一週間すぎて、ふたたびブルウル氏の時間が來た。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互ひにまだ友人になりきれずにゐる新入生たちは、教室のおのおのの机に坐つてブルウル氏を待ちつつ、敵意に燃える瞳を煙草のけむりのかげからひそかに投げつけ合つた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒さうに細い眉をすぼませて教室へはひつて來たブルウル氏は、やがてほろにがく微笑みつつ、不思議なアクセントでひとつの日本の姓名を呟いた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルウル氏は、彼の顏を見ずに言つた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルウル氏は蒼白の廣い額をさつとあからめて彼のはうを見た。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルウル氏は、それからも生徒へつぎつぎとよい課題を試みた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "入学早々、ブルウル氏という英人の教師が、What is Real Happiness? ということについて生徒へその所信を書くように命じたのである。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルウル氏は、その授業はじめに、My Fairyland という題目でいっぷう変った物語をして、その翌る週には、The Real Cause of War について一時間主張し、おとなしい生徒を戦慄させ、やや進歩的な生徒を狂喜させた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルウル氏は、チエホフに似ていた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのように何やら神秘めいた雰囲気が、ブルウル氏をいっそう魅惑的にした。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのブルウル氏が、三週間目の授業のとき、だまってボオルドに書きなぐった文字が What is Real Happiness? であった。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一週間すぎて、ふたたびブルウル氏の時間が来た。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互いにまだ友人になりきれずにいる新入生たちは、教室のおのおのの机に坐ってブルウル氏を待ちつつ、敵意に燃える瞳を煙草のけむりのかげからひそかに投げつけ合った。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒そうに細い肩をすぼませて教室へはいって来たブルウル氏は、やがてほろにがく微笑みつつ、不思議なアクセントでひとつの日本の姓名を呟いた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルウル氏は、彼の顔を見ずに言った。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルウル氏は蒼白の広い額をさっとあからめて彼のほうを見た。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
