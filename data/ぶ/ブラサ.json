        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソコデ　ヌスビトハ　パント　コヒツジト　トリカヘツコ　シマシタガ、ヒヤクシヨウノ　テニ　ブラサゲラレタ　コヒツジガ　カワイソウニ　ナツタノデ、トリカヘツコヲ　ヤメテ　シマヒマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "亭主も手拭を腰にブラサゲて出て来て、自分の子息が子供｜相撲に弓を取った自慢話なぞを始める。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "第４版およびそれ以降の版にはブラサヴォラによる有用な索引がついている。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も、振り向かれちや大變だ」　八五郎はブラサゲた手拭を早速｜頬被りにしました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "謎の鍵穴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダルメイダは日本の建築が一目して寸法の解るものであることを説いたあとで、大仏殿を間口四十ブラサ（約二九〇尺）、奥行三十ブラサ（約二一八尺）と記している。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らく十一間七面の柱間を各四ブラサと見つもり、正面の柱間を十としたのに対し、側面の柱間を七と数え誤まったのでもあろうか。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも、振り向かれちゃ大変だ」　八五郎はブラサゲた手拭を早速｜頬冠りにしました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "謎の鍵穴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
