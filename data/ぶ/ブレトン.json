          "literary": [
            {
              "text": "これは料理家の間にアンショア・ア・ラ・ブレトンヌと名づけられる前菜なのだ。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "基本のアンショア・ア・ラ・ブレトンヌに加減していた味の数学は漸く割り切れた。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "只アーサー大王の御代とのみ言い伝えたる世に、ブレトンの一士人がブレトンの一女子に懸想した事がある。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはブレトン老人がヴィール夫人に毎年十ポンドずつを給与していてくれたという秘密で、彼女自身もヴィール夫人に言われるまでは全然知らなかった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "ヴィール夫人の亡霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の友達らはバーグレーヴ夫人のことを嘘つきだと言い、彼女は前からブレトン氏が毎年十ポンドずつ送って来ることを知っていたのだと言っているが、私の知っている名望家の間では、かえってそんなふうに言い触らしているご本尊のほうが大嘘つきだという評判が立っている。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "ヴィール夫人の亡霊",
                "note": "青空文庫"
              }
            }
          ]
        }
