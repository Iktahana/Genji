        "examples": {
          "standard": [
            {
              "text": "かつて日本には、高級品や嗜好品に対して課される物品税が存在していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "消費税が導入される前は、自動車を購入する際に高い物品税を支払う必要があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "祖父は昔の税制について語り、「あの頃は宝石を買うと物品税が凄かったんだよ」と笑った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "[以下略]ブランデー、ラム、ジンの混ぜ物処理　現在この国で施行されている物品税法によると種々の程度のブランディ、ラム、アラック、ジン、ウィスキー、その他の、酒精以外は殆ど何も含まない蒸留酒は、強さが知られていない蒸留酒に含まれているアルコールの量によって規定されている。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "この目的で税関および物品税の役人たちが使用している器具はサイクの浮き秤とよばれるもので、これまで使われていたクラークの浮き秤に代わって使われている。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "島の所有者トリガーセンがすべての法律を作り、税金も物品税も国へ納めません。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
