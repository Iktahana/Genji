        "examples": {
          "standard": [
            {
              "text": "妹はかなりの寝ぼすけで、起こすのに一苦労だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「この寝ぼすけめ！」と父が笑って彼を呼んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "寝ぼすけな彼のために、毎朝コーヒーを淹れてあげている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "馬具部屋の二階の乾草の中に眠っている二人の若い者をすぐに呼び起したが、二人とも寝ぼすけな性質なので、夜中に何もきかなかったという。",
              "citation": {
                "source": "白銀の失踪",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            }
          ]
        }
