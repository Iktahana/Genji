[
  {
    "uuid": "9bdd8663-734b-54de-bea4-c9940e5f746b",
    "entry": "年層",
    "reading": {
      "primary": "ねんそう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
