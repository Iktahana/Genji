[
  {
    "uuid": "6b7a526d-e77d-52ed-89df-fe2afe109d83",
    "entry": "寝苦",
    "reading": {
      "primary": "ねく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
