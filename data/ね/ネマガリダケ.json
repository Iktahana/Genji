        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "稈はすなわち竹竿にしてあるいは根茎の節より生ずるあり（例、ハチク、マダケ等）、あるいは根茎の末端直ちにこれを成すあり（例、ネマガリダケ、ホウオウチク等）、以て高く気中に挺出す。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また時々花を出すことある者はメダケ、ハコネダケ、カンチク、スズタケ、チマキザサ、ネマガリダケ等なり。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "またネマガリダケあり、越後にてジンダケという。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャコタンチクもまたネマガリダケの一品にしてその稈に斑紋あり。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
