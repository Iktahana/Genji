        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "涼しい時に虫が鳴いても、かぜを引くなよ、寝冷をするなと念じてやるのが男じゃないか。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……寝冷をしては不可ませんよ。",
              "citation": {
                "source": "湯島の境内",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「貴下、寝冷をしては不可ません。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもまず平穏無事に日が経ちますうち、ちょうど八月の中ごろの馬鹿に熱い日の晩でございます、長屋の者はみんな外に出て涼んでいましたが私だけは前の晩寝冷えをしたので身体の具合が悪く、宵から戸を閉めて床に就きました。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三日前からの寝冷がとう／＼本物になつたらしい、発熱、倦怠、自棄――さういつた気持がきざしてくるのをどうしようもない。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "発熱頭痛、まだ寝冷がよくならないのである、歯がチクチクいたむ、近々また三本ほろ／＼ぬけさうだ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "下痢で弱つた、酒のためか、寝冷のためか、それとも麦飯のためか、とにかく腹工合も悪いし、懐工合はなほさらよくないし、節食断酒の好機である、しばらくさうしよう。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "――気候だって東京より不順に極ってるから、寝冷をして風邪を引いてはいけない。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "油断すると寝冷えするなどと云いながら、四ツの鐘を聞いて寝床にはいると、その夜なかに半七の戸を叩いて、松吉が飛び込んだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "幽霊の観世物",
                "note": "青空文庫"
              }
            },
            {
              "text": "たぶん寝冷えをしたのだろうというので、今朝ほどは立つのを止めました」「そうですか、それはあいにくでしたね。",
              "citation": {
                "source": "半七捕物帳",
                "author": "半七先生",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯今も申す通り、どうも寝冷えをいたしたとみえて、暁方から頭が痛みまして……」「あたまの痛てえのはほかに訳があるだろう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "半七先生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だいち寝冷をしないだけでもあっちの方が得じゃないか」と云った。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝冷えもしていて、きょうは両方で休み（仕事もないので）私共三人は（母上・多賀子、私）徳山まで出かけました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝冷えをなさらないようにね八月四日夜　〔巣鴨拘置所の顕治宛　目白より（封書）〕八月四日　　第三十九信　昨夜から書きかけていた手紙があったのだが、それはやめてしまって別にはじめます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝冷えなさらないように。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めは寝冷えぐらいの事と思い居り候ところ、――ですって。",
              "citation": {
                "source": "母",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "……宵から此が気にかゝつて、むしやくしやと寝られなんだに――、お中（娘の名）も寝冷えせぬやう、よく著て寝よ。",
              "citation": {
                "source": "夏芝居",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "）月紅さして寝冷の顔をつくろひぬ大正十四年六（七？",
              "citation": {
                "source": "五百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なに、寝冷えなんでございますよ。",
              "citation": {
                "source": "幼き日",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「蚊に喰べられたのでございましょう」「蚊ならよいが」「寝ても暴れて、蚊帳の外へ、ころげますので」「寝冷えさすな」「はい」「疱瘡に気をつけよ」「仰せまでもございませぬ」「夫婦が仲の初の児。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それほどの物數寄な心は持たないまでも、寢冷えする心配も割合にすくないところに足を延ばして、思ふさま長くなつた氣持は何とも言はれない。",
              "citation": {
                "source": "短夜の頃",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが内地に歸つて書齋に戻ると、浴衣になつたその晩から寢冷をする、風はひく、下痢はする。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
