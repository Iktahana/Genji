        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "如何にも感情の浅い、粘力のない女だった。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "毒水を被らない方の粉では、團子を拵らへ燒餅を拵らへると云ふことが出來るが、毒水を被つた方のは粉に粘力が無くなつて、團子にも燒餅にもならない。",
              "citation": {
                "source": "公益に有害の鑛業を停止せざる儀に付質問書",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガイモの方には粘力が比較的少なくて劣っている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この樹の材は堅いには堅いが存外脆く粘力に乏しく、決して強靱では無いから、ソノ細かいカナメを作るには固より不適当である。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうした粘力だろう。",
              "citation": {
                "source": "宮本武蔵",
                "author": "水の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分以上の力の者に向えば向うほど、その「粘力」を出すのである。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれはまた、草木の中を歩いて、紫、藍、紅、さまざまな花をもんで試みたが、どれも日光にあえば色を失うのみか、筆にかかる粘力がない。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "木曾の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "豹の四｜肢のごとく、伸縮の自由な孫兵衛の腕ぶしには、一種の粘力があってなかなかあなどり難い。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "木曾の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
