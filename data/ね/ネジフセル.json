    "definitions": [
      {
        "index": 1,
        "gloss": "to twist someone's arm and throw them to the ground",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "相手の腕をねじ伏せて、動きを封じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "警官は暴れる容疑者を巧みにねじ伏せ、手錠をかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "格闘技の試合で、彼は相手をグラウンドにねじ伏せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "（俊寛を地にねじ伏せる）漁夫二　盗人め！",
              "citation": {
                "source": "俊寛",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしも博士が逃げだすようすを見せたら、そのときはすぐうしろからとびついて、その場にねじ伏せる覚悟をしている田口巡査だった。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は悪鬼につかれたようになって、先生を診察台の上へねじ伏せると、かの私の生れついた美しい両脚を珠子づれに譲渡したことを詰った。",
              "citation": {
                "source": "大脳手術",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人は床の方を見て「あの水仙は暮に僕が風呂の帰りがけに買って来て挿したのだが、よく持つじゃないか」と行徳の俎を無理にねじ伏せる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だかまったく折れにくい、そして折れているのが自然でもない若い竹を力ずくでねじ伏せるようなところがあってね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて気持をもて余しながらも、ねじ伏せるようにして、そろそろと梯子段を降りた。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸の中に泡立ってたぎり立つものをいきなりねじ伏せると、ふいに宇治は背を向けて小屋の外に歩き出していた。",
              "citation": {
                "source": "日の果て",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いかなる大戦争も、原子バクダンも、水素バクダンも、今のところ、この風流をねじふせる見込みはとても望みがないだろう」　書斎の観測などは、実世間を相距ること、月とスッポンよりも距りがあるものだ、と観念せざるを得なかったのである。",
              "citation": {
                "source": "風流",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "かのチョーセイ、チョーセイは、十匹の山犬を赤子をねじふせるように易々とねじふせてしまい申した。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "目録十名の使い手にとりまかれて、赤子のようにねじふせる手のうちであるから、その方も油断いたすな」「心得申した」　面小手の用意をととのえ、ホラブンを御前へ召しよせる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "運命にまかせるか、完全にねじふせるか、である。",
              "citation": {
                "source": "武者ぶるい論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "完全にねじふせるのは大変だ。",
              "citation": {
                "source": "武者ぶるい論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "大資本と現代科学の萃を集めれば黄河をねじふせることはできるかも知れないが、貧乏ではとてもやれない。",
              "citation": {
                "source": "武者ぶるい論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の強い情熱をより強い智慧の光がねじふせるように抑止した。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to force (someone) to yield (e.g. an argument)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "議論の末、彼は強引に相手の意見をねじ伏せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "どんなに反対意見が出ても、彼は自分の主張をねじ伏せることなく貫いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "上司の鶴の一声で、全ての異論がねじ伏せられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
