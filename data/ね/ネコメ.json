        "examples": {
          "standard": [
            {
              "text": "そのモデルは、独特のネコ目メイクでファッション雑誌の表紙を飾った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の魅力的なネコ目は、見る者を惹きつける不思議な力を持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ネコ目の人は、目尻が少し上がっていてクールな印象を与えることが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "青びょうたんの鳴きネコめが。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            }
          ]
        }
