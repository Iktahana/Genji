    "definitions": [
      {
        "index": 1,
        "gloss": "to steal another's spouse",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "友人の妻を寝取るという最低な行為をしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は他人の恋人を平気で寝取るような男だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "そのドラマは、主人公が友人の夫を寝取るという衝撃的な展開だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "たとい身腹は分けずとも、仮りにも親と名のつく者の男を寝取るとは何事であると、お福は明け暮れにおらちを責めた。",
              "citation": {
                "source": "馬妖記",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "真実お前が旦那を寝取る。",
              "citation": {
                "source": "したゆく水",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の女を寝取ることにかけては常習犯の彼なのであるが、あの傷々しい、骸骨のように痩せた老翁が、たま／＼若い美しい妻を贏ち得て、後生大事にその人に册き、それに満足しきっているらしい様子を見ては、柄にもなく憐愍の情に似たものを感じていた訳であった。",
              "citation": {
                "source": "少将滋幹の母",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――背中でピリピリするところがおますが、これは金魚が入ってピチピチ跳ねとるのやな」　署長以下、なんのことだと、気の弱い社員のズブ濡れ姿に朗らかな笑声を送った。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "福太郎はどこさ行たかい」「押入の前で死んだごとなって寝とる」「アハハ。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "よね　　（階段を昇りながら）今日はボーイが寝とるもんですけん……。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "己あ、今朝、眼ん覚めつ時、側あ、お前が寝とるもんだるけん、びつくりしたツばい。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「みなし子はよう寝とる」と老婆が言った、「痩せこけて、骨と皮ばかりだ。",
              "citation": {
                "source": "女房ども",
                "author": "БАБЫ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あそこに、女の膝で寝とる人が、小頭の永田杢次さん、わたしの親方じゃ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
