    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to go to bed",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供たちは疲れて、すぐに寝付いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昨晩はなかなか寝付けず、朝まで読書をしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しい環境に慣れるまでは、なかなか寝付けないことが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "今思えば、いっそその時に思い切ってどうかすればよかったんですが、わたくしも両親はあり、弟や妹はあり、それを打捨って駈け落ちをするわけにも行かないので、ともかくも師匠をなだめて無事に帰したんですが、それから間もなく師匠はどっと寝付くようになって、とうとうあんなことになってしまいました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お化け師匠",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎晩、何時頃に寝るのかお前達は……」「両親達はラジオを聴いてから一時間ばかりで寝附きますから、私たちが寝付くのはドウしても十二時過になっておりました。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔孫が寝付く以前に、長子の孟丙のために鐘を鋳させることに決め、その時に言った。",
              "citation": {
                "source": "牛人",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親が中風で寝付くとき忘れずに、銀行の通帳と実印を蒲団の下に隠したので、柳吉も手のつけようがなかった。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ウィリアムも平生その時刻に寝付くと考えても？",
              "citation": {
                "source": "ライギット・パズル",
                "author": "THE REIGATE PUZZLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっと寝付くほどの大病でもないが、なにしろ半病人のすがたで、薙刀のお稽古もこの頃は休み勝になりました。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月二日牢愁の思出春の日のくれゆく空のあはれさはひとりながめて牢にゐし時四月十二日近頃頻りに疲労を覚え、やがて寝付くべきかと思ふほどなり、小詩を賦して自ら慰む弱いからだが段々に弱くなり、残りの力もいよ／＼乏しくなつて来た。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて寝付くやうになるのかも知れない。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "本能的な不安の中にも、疲れと若さに誘われて、ウトウトと寝付くと、岩吉の毛むくじゃらな手が、お鳥の腕を押えて居たり、岩吉の髭面が、お鳥の頬とすれすれに、息と息とが絡み合って居ることさえ稀では無かったのです。",
              "citation": {
                "source": "裸身の女仙",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でもまあ、云ってご覧なさい」　となおねつく訊くと「やっぱり世間通りよ。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でもまあ、云つてご覧なさい」　となほねつく訊くと「やつぱり世間通りよ。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あー　あー」　するとご新造は苦笑して、張合のない手を振りましたが、わたくしが更にねつく訊ね進むのに動かされ、「おまえさん、耳の方はいくらか通じるのかい。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓉子の枕元にはスタンドがおいてあって彼女がねつく時一燭光にしておく習慣だったので、その光でおぼろに不思議な光景が目に入ったのだ。",
              "citation": {
                "source": "黄昏の告白",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この首都の市民性は、大阪ほどねつくないから、恐らくあゝ言ふ形はとることはなかつたらう。",
              "citation": {
                "source": "市村羽左衛門論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　王子くんがねつくと、ぼくはすぐさま、その子をだっこして、またあるきはじめた。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとうに四季をとほして、しぐれ、粉雪、さゞめ雪、さうしたはつ冬の、鈍い、どんよりとあぐねつくしたしゞまの中に置いてみて、一ばん趣深い「松」だつたやう、おもはれてならない。",
              "citation": {
                "source": "下町歳事記",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い精神の本能的な不透明さが遂に此処まで来たのを知って、すべてを何か知らぬが、大きなものの手に委ねつくして、あわてたり、わめいたりしようとしなかった。",
              "citation": {
                "source": "リラの手紙",
                "author": "豊田三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしたちはいよいよここへねむるとすれば、なによりいちばんいいことは、できるだけ早くねつくことであった。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゼルビノはわたしがねつくのを待って、ぬけ出して行った。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "オンドリはねつくまえに、もういちど四方八方を見まわしました。",
              "citation": {
                "source": "ブレーメンの音楽師",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "病気で長く寝つくやうになつてからも、私は夢のなかで赤蛙に逢つた。",
              "citation": {
                "source": "赤蛙",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　風呂で彼女は葉子の足にさわりながら言うのだったが、夜は葉子に寝かしつけられて、やっと寝つくことも多かった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は少し厳格に早く寝つくやうに云つて見たが、駄目だと思つて又床に這入つた。",
              "citation": {
                "source": "An Incident",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも寝苦しい、やつと寝つくと悪夢におそはれる、詰らないことである。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜儀右衛門は、いつまでも寝つくことができなかった。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女房は子供に呼ばれて床にはいって、子供が安心して寝つくと、また大きく目をあいてため息をついているのであった。",
              "citation": {
                "source": "最後の一句",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かに、静かにさすりながら、祥子の寝つくのを待つより外仕方がなかった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "新子も、反感めいた気持で、空っぽの寝床に背を向けて、今夜は美和子の帰らない内に、どうでも寝つこうとし、寝つくために、何か下らない古雑誌でも読もうと、床を這い出して、机の前にいざり寄ると、階下からしのびやかに、母が上って来る足音がした。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが修善寺で病気をして寝つくや否や、頬がざらざらし始めた。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "王様は漸と寝つく事が出来たのだ。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
