        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "風邪をこじらせて、数日間寝付いてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "祖母は病気でしばらく寝付いていたが、ようやく回復に向かっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「ああ、また寝付いてしまったのか…」と彼は力なく呟いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
