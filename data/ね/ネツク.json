[
  {
    "uuid": "b65d670e-fa38-5344-8655-ff67e0fd02ba",
    "entry": "寝付く",
    "reading": {
      "primary": "ねつく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-カ行",
