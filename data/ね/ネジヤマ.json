        "examples": {
          "standard": [
            {
              "text": "このネジはねじ山が潰れてしまっているので、もう使えない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ねじ山のピッチが合わないと、ネジはうまく入らない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "錆びついたねじ山をブラシで綺麗にした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "標準化されているために、ばらばらに作ってもねじ山があって、作ってきたものを買ってきて組み立てることができる」　こうした変化を踏まえた時、どうすれば最も競争力をもって日本で新たにビジネスを展開できるか。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これじゃねじ山は合っていても細いから、挿し込んでもやがてぬけてしまうよ。",
              "citation": {
                "source": "もくねじ",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
