        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山道を歩いていると、特徴的な花を咲かせた捩木を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "捩木の葉は薬草として使われることがあるらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "植物図鑑で捩木の生態について調べている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "子供でもねじきれそうな錠が、ついておるだけです。",
              "citation": {
                "source": "花のき村と盗人たち",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "倉があって、子供でもねじきれそうな錠しかついておらんというほど、こっちのしょうばいに都合のよいことがあるか。",
              "citation": {
                "source": "花のき村と盗人たち",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "何千という一かたまりの焼死体や、コンクリのカケラと一しょにねじきれた血まみれのクビが路にころがっているのを見ても、あのころは全然不感症だった。",
              "citation": {
                "source": "もう軍備はいらない",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "人殺しぐらいはキュウリをねじきるぐらいにしか思っていやしねえ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その一　舞踏会殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "とはいえ　ネズミの　のこりがも　きつくて、　たてぐやジョンは　午前のうち　ずっと　くんくん　わんわん　しっぱなし、　しっぽを　ふりふり　ねじきりのように　頭を　中心に　ぐるぐる。",
              "citation": {
                "source": "ちょびひげサミュエルのはなし",
                "author": "まきまきパンのまき",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は、ついと小戻りをして、治郎吉の袷の袂を、ねじきるようにつかんだ。",
              "citation": {
                "source": "治郎吉格子",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその日爆撃直後に散歩にでて、なぎ倒された民家の間で吹きとばされた女の脚も、腸のとびだした女の腹も、ねじきれた女の首も見たのであった。",
              "citation": {
                "source": "白痴",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、あまりさわぎたてて、相手に、気づかれてはいけないというので、本署の捜査主任が、刑事をふたりだけつけて、五重の塔に近づき一階のとびらをしらべましたが、そこにつけてあったかぎが、ねじきられていることがわかりました。",
              "citation": {
                "source": "鉄人Ｑ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
