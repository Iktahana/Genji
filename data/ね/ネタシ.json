        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "子供のうちから新｜舞踊を習わせられ、レヴュウ・ガールとも近附のある小初は、媚というねたねたしたものを近代的な軽快な魅力に飜訳し、古典的な青海流の飛込みの型にそっと織り込ますことぐらい容易である。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "無病息災であつたきのふは、駄々も捏ねたし、泣いて無理も云つた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "『夫木集抄』三十、読人知らず「いとねたし泳の宮の池にすむ鯉故人に欺かれぬる」とはこれを詠んだのじゃ。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたずねてやって居たけれども、小さい弟共の事などを思うと、思い切って中に入って見る事もしかねたし又骨だった顔を見る事もつらかった。",
              "citation": {
                "source": "黒馬車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、家庭を失った寂寥にも堪えかねたし、また無為な、力の遣り場のない日常にも圧せられた。",
              "citation": {
                "source": "渋谷家の始祖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　何をそんなに怒ってるのか、久子は尋ねかねたし、カヨもそれより口を噤んで、二階にひっこんでしまった。",
              "citation": {
                "source": "蔵の二階",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋し、恋し、はらだたし、ねたし、悲し。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて義父よりかくかくの噂聞き込みたれば、その実否尋ねたしとて呼び寄せたるなりといはれ、お糸はハツと胸轟かせしが、よくよく思ひ定めたる義父の様子に容易くは答らへせず。",
              "citation": {
                "source": "心の鬼",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかみが昼のあいだに二、三度彼の様子をたずねたし、ゲルステッカーもそのあいだに一度彼の様子を見にここへやってきた。",
              "citation": {
                "source": "城",
                "author": "DAS SCHLOSS",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『その樹かげ、夢は花さく、黒髮のわかき手弱女、あらはなる踵もねたし。",
              "citation": {
                "source": "春鳥集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし彼のうち明け話を求むることもなしかねたし、またどういうふうに求めていいかもわからなかった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は延ばしてくれと頼みかねたし、また悲しみを訴えかねた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月革命後、人はもはやグレーヴの刑場で首を切ることをあえてしかねたし、恐れていたし、卑怯だったので、次のようなことがなされた。",
              "citation": {
                "source": "死刑囚最後の日",
                "author": "LE DERNIER JOUR D'UN CONDAMNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "女親分のような年増女がいて、うわまえをはねたし、容赦なくひっぱたかれることもあった。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
