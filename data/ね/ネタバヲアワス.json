        "examples": {
          "standard": [
            {
              "text": "真剣勝負を前に、道場の一角で静かに愛刀の寝刃を合わせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "いざという時に備えて、寝刃を合わせておくのが武士の嗜みだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "研ぎ石の音が響く中、彼は集中して寝刃を合わせていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
