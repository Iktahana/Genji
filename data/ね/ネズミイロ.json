    "definitions": [
      {
        "index": 1,
        "gloss": "dark gray",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "曇り空のねずみ色は、少し憂鬱な気持ちにさせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しいセーターは、どんなボトムスにも合わせやすいねずみ色を選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ねずみ色の外壁は、モダンで落ち着いた印象を与える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "箱根の峠を越した後再び丹沢山大山の影響で吹き上がる風はねずみ色の厚みのある雲をかもしてそれが旗のように斜めになびいていた。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の問答を聞いているのもおもしろいが、見ているのも妙だ、一人は三十前後の痩せがたの、背の高い、きたならしい男、けれどもどこかに野人ならざる風貌を備えている、しかしなんという乱暴な衣装だろう、古ぼけた洋服、ねずみ色のカラー、くしを入れない乱髪！",
              "citation": {
                "source": "号外",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一つはねずみ色の天鵞絨で作った身長わずかに五六寸くらいの縫いぐるみの象であるが、それが横腹の所のネジをねじると、ジャージャーと歯車のすれ合う音を立てながら走りだす、そうしてあの長い鼻を巧みに屈伸して上げたり下げたりしながら勢いよく走るのである。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」貝の火兄弟商会の、鼻の赤いその支配人は、ねずみ色の状袋を、上着の内衣嚢から出した。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "空がまっ白に光って、ぐるぐる回り、そのこちらを薄いねずみ色の雲が、速く速く走っています。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の白いネルの襟巻がよごれてねずみ色になっているのを、きたないからと言って女中にせんたくさせられたこともあったが、とにかく先生は江戸ッ子らしいなかなかのおしゃれで、服装にもいろいろの好みがあり、外出のときなどはずいぶんきちんとしていたものである。",
              "citation": {
                "source": "夏目漱石先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人によっては、ねずみ色の紙をつかめば、病気になるという者がある。",
              "citation": {
                "source": "影",
                "author": "SKYGGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶色のはん点がいっぱいある、赤みがかったつやのよい頭を日に光らせ、洗いふるしたねずみ色の着物の背をまるくしている、年よりの是信さん。",
              "citation": {
                "source": "屁",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、その小さな、ねずみ色をしたものが、私の前をぴょんととんで行きました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "右舷に遠くねずみ色に低い陸地が見える。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一人ねずみ色の地味な服を着た色の白い鼻の高い若い女は沈鬱な顔をしてマンドリンをかき鳴らしている。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが知らぬ間にひどくよごれてねずみ色になっているのを先生が気にしていた。",
              "citation": {
                "source": "俳諧瑣談",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おりて来て見ると、三毛は居間の縁の下で、土ぼこりにまみれたねずみ色の団塊を一生懸命でなめころがしていた。",
              "citation": {
                "source": "子猫",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "机のわきにある木の椅子に、グリムズビ・ロイロット博士が、長いねずみ色の化粧着に身を包み、つきだした素足にかかとのない赤のトルコ・スリッパをつっかけて腰をかけている。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねずみ色の服に赤い先の尖った帽子をかぶる。",
              "citation": {
                "source": "旅なかま",
                "author": "REJSEKAMMERATEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "こがらしがしずかになったと思うと、ねずみ色をした雲が低く空をとじて雪でも降るのかしらと思われる不快な午後であった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "灰色からねずみ色に、ねずみ色から墨色にぼかされた大きな紙を目の前にかけて、上から下へと一気に視線を落として行く時に感ずるような速さで、昼の光は夜の闇に変わって行こうとしていた。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かたわらには年寄りの栗毛までがたたずんで、ねずみ色の耳毛が中から勢いよくはえている大きな片耳を、一座の方へそばだてながら、連中の演説をじっと聞いておりました。",
              "citation": {
                "source": "夢がたり",
                "author": "TO, CHEVO NE BYLO",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろの鳥がふくろうの所へ来ては、赤だの、青だの、ねずみ色だの、るり色だの、黄色だの、いろいろなきれいな色に体を染めてもらいました。",
              "citation": {
                "source": "物のいわれ",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　といいながら、ひょいとうしろを振り向くと驚きました、もう一｜間とへだたっていないうしろに、ねずみ色のぼろぼろの着物を着て、やせっこけて、いやな顔をしたおばあさんが、すっとそこに立っているのです。",
              "citation": {
                "source": "山姥の話",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一通はＮ先生、一通は光郎、あとのはねずみ色の封筒に入った郵便局からのだ、あけて見ると電報為替だ。",
              "citation": {
                "source": "出奔",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ふむ、今日は埃っぽくて、あまりぞっとしない天気だ」「そうですとも」　隣のカンヴァス椅子から、ねずみ色の肩かけを胸の上であわせた肥った女が答えた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかみさん、あなたになにも云いませんでしたか」「いいえ」　ねずみ色と白のひだの多い服を着たその客は肩をすぼめた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねずみ色のショールを頭へかぶりながら彼らのところへ来た女客が足早に下から出て行き、直ぐつれ立って柵のそとへ去った。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十日あまりの月がねぼけたように町の片側をうすねずみ色に明るくしていた。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "二匹の毛の色はだん／＼染がはげて来て、二匹とも、ねずみ色になつてしまひました。",
              "citation": {
                "source": "お猫さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間からいふと、ねずみ色といふ色も、なか／＼よい色ですけれども、猫の世界では、一番いやな色だと思はれてゐます。",
              "citation": {
                "source": "お猫さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "巣の中のかすかな光線にてらされて、ねずみいろの雲雀の卵が四つほどさびしげに光つてゐた。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてなんだかねずみいろの、おかしな形の馬がついています。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "変てこなねずみいろのだぶだぶの上着を着て、白い半ずぼんをはいて、それに赤い革の半靴をはいていたのです。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
