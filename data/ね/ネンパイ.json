[
  {
    "uuid": "b0820437-81ff-5b9d-98ab-31febbac635d",
    "entry": "年配",
    "reading": {
      "primary": "ねんぱい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
