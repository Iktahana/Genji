    "definitions": [
      {
        "index": 1,
        "gloss": "to wrench someone down to the ground",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "柔道の試合で、相手のバランスを崩して一気に畳に捩じ倒した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "酒場で暴れる男を、居合わせた屈強な警備員が腕を捻って捩じ倒した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "猪のような勢いで突っ込んできた選手を、見事な技で捩じ倒す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」「命知らずめ、後悔するなよッ」　もろ手で咽をしめつけながら、足がらみをかけて、ドンとねじたおすと、たおれたとたんに竹童が、さっと下から般若丸の冷光をよこざまにはらった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "物をも云わずにお金の島田をひっ掴んで、往来へ横っ倒しに捻じ倒すと、あいにくに水が撤いてあったので、お金は可哀そうに帯も着物も泥まぶれになる。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "忠作が始末をしている葛籠のところへ来て、黙って忠作の細腕をムズと掴んで捻じ倒すと同時に、一人の男はその葛籠を軽々と背負って立ち上ります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "市中騒動の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、捻じ倒す『｜足挾み』に至っては、誠にもって至妙の術。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "乱視の奈翁　――アルル牛角力の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
