        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "時間が経つにつれて、木の枝が複雑に捩じくれた形になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "老木の幹は、長年の風雪に耐えて捩じくれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "細い道は、山の中をくねくねと捩じくれるように続いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "昨夜、とやかくと言説を弄したのは、賢夫人の側に主張がましいことがあると、かならず反対のほうへねじくれる、石田氏のしつっこい気性を利用しようとしたのにすぎない。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしても、きく、きく、と足が捩くれる。",
              "citation": {
                "source": "思い出すかずかず",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "天気のよい日、磨かれた靴が特に光り、日を照り返して捩くれるのを見ると、私の心は云いようもなく重く悲しく、当のない憤懣を感じずにはいられないのである。",
              "citation": {
                "source": "思い出すかずかず",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to be contrary",
        "register": "standard",
