        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "メロスは跳ね起き、南無三、寝過したか、いや、まだまだ大丈夫、これからすぐに出発すれば、約束の刻限までには十分間に合う。",
              "citation": {
                "source": "走れメロス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すっかり寝過ごしちゃった。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "面会の時間はかなりの早朝だったから、原稿を書く仕事で夜ふかしする癖の私は、寝過さぬ要心に、徹夜して朝を待つことにした。",
              "citation": {
                "source": "面会",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」八「翌朝｜思のほか寝過ごして、朝湯で少しはっきりして、朝飯を取ります頃は、からりと上天気。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "源氏が東の町の西の対へ行った時は、夜の風が恐ろしくて明け方まで眠れなくて、やっと睡眠したあとの寝過ごしをした玉鬘が鏡を見ている時であった。",
              "citation": {
                "source": "源氏物語",
                "author": "野分",
                "note": "青空文庫"
              }
            },
            {
              "text": "融は少し寝過ぎて、時間がおそかつたけれど、約束がしてあつたので、電車で雑煮を祝ひに、わざ／＼家へ帰つた。",
              "citation": {
                "source": "折鞄",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "珍しく、朝鳥の鳴く音にも気付かず寝過ごしたので、家人の一人に酷く叩かれた。",
              "citation": {
                "source": "南島譚",
                "author": "幸福",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月廿四日今日も暑からう、すこし寝過した、昨夜の今朝で、何となく気分がすぐれない。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月廿三日晴、今朝も寝過した、六時に近かつた。",
              "citation": {
                "source": "行乞記",
                "author": "室積行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "長十郎は実際ちょっと寝ようと思ったのだが、覚えず気持よく寝過し、午になったと聞いたので、食事をしようと言ったのである。",
              "citation": {
                "source": "阿部一族",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは寝過したかと思って枕の下から例のニッケルの時計を引きずり出して見るとまだ七時二十分だ。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「気を許して寝ると、寝坊をするつもりはなくっても、つい寝過ごすもんだな」　彼は云い訳らしい事をいって、暦の上にかけてある時計を眺めた。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨戸の隙間から差し込んで来るその光は、明らかに例もより寝過ごした事を彼女に物語っていた。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "怠けて寝過した昨日の償い、それも満足の一つであった。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝過ごしはせぬかと二三度耳を振って家内の容子を窺うと、しんとして昨夜のごとく柱時計の音のみ聞える。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝過しはしないかと狼狽へて、すぐ寝床から飛起きたが、誰も起きた様子がない。",
              "citation": {
                "source": "天鵞絨",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "絞め殺しておいて胡魔化すつもりで寝ていたのが、つい寝過したのじゃないか。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、それよりもモット重大な事実があるんだから呉羽嬢の寝過し問題なんかテンデ問題にならん」「ドンナ事実です」「今話した支配人の笠圭之介ね。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝過したかな……と思ってソッと起上って、出来るだけ静かに階段を降りて、土間を跣足で台所に来てみると十一時半である。",
              "citation": {
                "source": "芝居狂冒険",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "博奕打ちは盗んだ米を町へ売りに行く途中、久し振りに身体を使ってクタビレたので、チョットのつもりで休んだのが、思わず寝過ごしたのであった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘太郎は寝過ぎたと思って、急いで竈の前に行って火を入れようとしましたが、どうしても昨夜の夢が気になってたまりません。",
              "citation": {
                "source": "虫の生命",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は昨晩遅かつたものですから、寝過して了ひまして。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝過ぎと衰弱とから、恐しい苦痛の色を顔に表して、半分は未だ眠り乍ら其処に座つて居るかのやう。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日は母も清三も寝過ごしてしまった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は立って千鶴子に強く握手をしながら、寝過したら電話で起して貰いたいと頼み、「さようなら。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六　反絵は鹿狩りの疲労と酒とのために、計画していた卑弥呼の傍へ行くべき時を寝過した。",
              "citation": {
                "source": "日輪",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うつかり寝過した。",
              "citation": {
                "source": "早春のひところ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「思はず寝過してしまつたよ。",
              "citation": {
                "source": "ダニューヴの花嫁",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "寢過しはしないかと狼狽へて、すぐ寢床から飛起きたが、誰も起きた樣子がない。",
              "citation": {
                "source": "天鵞絨",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ヤ、これは寢過ぎた……』　と私は失策つたやうに言へば、子供等は眼を圓くして、急いで床の間の隅に隱れました。",
              "citation": {
                "source": "幼き日",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
