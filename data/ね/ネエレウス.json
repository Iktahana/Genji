          "literary": [
            {
              "text": "ネエレウス族とトリイトン等と（海の怪物として。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエレウス族とトリイトン等とこゝに来るに先だちて、われ等早く思ふよしありき。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "）お前をネエレウスの爺いさんに紹介するのは造做はない。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "海の神ネエレウス己の耳に聞えるのは人間の声か知らん。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエレウス族とトリイトン等とわれ等の手に載せ、かしづきて来ぬるもの、君等の心を悦ばせざらめや。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエレウス族とトリイトン等と治まれる世の祭せむと、カベイロイの神等を迎へ来ぬ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "8185　　　　ネエレウス族とトリイトン等と三柱をば迎へまつりぬ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエレウス族とトリイトン等と実は七柱の神おはせり。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "8195　　　　ネエレウス族とトリイトン等とわれ等は知らず。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエレウス族とトリイトン等とこの祭執り行ふわれ等の誉8210いかに高く挙がるかを見よ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ネエレウス族とトリイトン等と過ぎ去る。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "憎からず暴れたる、逞しき女等、ネエレウスのたけき族。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "8390　　　　ドオリス族（群をなしてネエレウスの前を過ぐ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
