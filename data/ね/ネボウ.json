    "definitions": [
      {
        "index": 1,
        "gloss": "sleeping in late",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大事な会議に寝坊してしまい、冷や汗をかいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "目覚まし時計をかけ忘れて、また寝坊してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昨夜遅くまで起きていたせいで、今朝は寝坊した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "たいてい私は八時前に起床するのだが、大隅君のお相手をして少し朝寝坊したのだ。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「きょうはじめてお嫁さんと逢うんだというのに、十一時頃まで悠々と朝寝坊しているんですからね。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしていいかわからなくなって、天下国家を論じて君を叱ってみたり、また十一時まで朝寝坊してみたり、さまざま工夫しているのだろうが、どうも、あれは昔から、感覚がいいくせに、表現のまずい男だった。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝は大概寝坊をして、これがために昼飯を抜きにする事があるが、その代りに夜の十時頃から近所の牛肉屋へ上がって腹一杯に食う事も珍しくない。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝は寝坊であったが夜は時には夜半過ぐるまで書斎で仕事をしていたそうである。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝九時家族が集まって祈祷、寝坊して出ないものは睨まれた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "伯父への御恩返しも、こんな私の我儘のために、かえってマイナスになったようでしたが、もはや、私には精魂こめて働く気などは少しもなく、その翌る日には、ひどく朝寝坊をして、そうしてぼんやり私の受持の窓口に坐り、あくびばかりして、たいていの仕事は、隣りの女の局員にまかせきりにしていました。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもの朝寝坊が、けさに限って、こんなに早くからお目覚めになっているとは、不思議である。",
              "citation": {
                "source": "十二月八日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このサ中に何処へ行たもんじゃろか……あの朝寝坊が……」　それから毎日のように晴れ続いた福岡博多の狭い町々に、蔵元屋の騒動の噂が隈もなく行き渡ってしまった三日目……三月十三日の正午下り。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし寝坊をして出勤時間に遅れないように急いで用を足す習慣のものには、これもまた瞑想に適した環境ではない。",
              "citation": {
                "source": "路傍の草",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば朝寝坊の青年に向っても、無暗と朝寝を叱らずに、「随分よく睡眠を取ったね。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……生意気盛りの、あの時分じゃ、朋輩の見得や、世間への外聞で、抱主の台所口へ、見すぼらしい親身のものの姿が見えると、つんと起って、行きもしないお稽古だの、寝坊が朝湯へ行き兼ねないのに、大道さなか、（お爺さん。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕、朝寝坊だから……」「電話で起しますわ」　伊都子の匂いの残っている寝台で、信吉はぐっすり眠った。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はそれを着て遊園地にでも遊びに行こうではないか……』　朝ならば、イワンの兄はそんな事を云って、寝坊なイワンを起こしてくれました。",
              "citation": {
                "source": "イワンとイワンの兄",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな気分のいい朝に寝坊をするなんて不幸の骨頂だよ。",
              "citation": {
                "source": "イワンとイワンの兄",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀子も体に隙がないので、拭き掃除に追い立てられてばかりもいず、夜床についてから読書に耽ったりして、寝坊をすることもあり、時には煩さがって、わざと髪結いさんの家で、雑誌を読みながら時間を潰したりした。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "びっくりするほど、寝坊をしてしまったものです――わたしは、まだ箱の上に腰かけていました。",
              "citation": {
                "source": "人形つかい",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "チエ子が一番わるい癖の朝寝坊でも、叱るどころでなく、かえって手数のかからない児だと云って、自慢の一ツにする位であった。",
              "citation": {
                "source": "人の顔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも朝寝坊は今までの通りにしたので、どうかすると二三日も母親の顔を見ないことがあった。",
              "citation": {
                "source": "人の顔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「久、また朝寝坊したな。",
              "citation": {
                "source": "耳",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもは朝寝坊でも、試験だとなると、ちゃんと早起をして御飯も、たくさん食べる。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいいち、ひどく朝寝坊だ。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この丹三郎ひとりの朝寝坊のために、一行の宿からの出発が、いつもおくれる。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大事な日に、朝寝坊をなさらないやうに。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そうでしょうッて、寝坊をするから、まだ朝御飯を食らないもの。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ちょいと車夫に声を懸けたが、「さぞ寝坊していらっしゃるだろうと思ったの。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉夫人は、余り馴れない会場へ一人で行くのが頼りないので、菅子を誘いに来たのであったが、静かな内へ通って見ると、妹は影も見えず、小児達も、乳母も書生も居ないで、長火鉢の前に主人の理学士がただ一人、下宿屋に居て寝坊をした時のように詰らなそうな顔をして、膳に向って新聞を読んでいた。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "物臭太郎物臭太郎は朝寝坊、お鐘が鳴つても目がさめぬ、鶏が啼いてもまだ知らぬ。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あくる朝、僕は寝坊をして――ふだんでも寝坊だが、この朝は取分けて寝坊をしてしまって、床を離れたのは午前八時過ぎで、裏手の井戸端へ行って顔を洗っていると、兄が裏口の木戸からはいって来た。",
              "citation": {
                "source": "こま犬",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねぼうだなあ、おおい。",
              "citation": {
                "source": "若い木霊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
