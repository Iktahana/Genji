        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祇園祭の山鉾巡行では、豪華絢爛な練り物が都大路を進む光景は圧巻だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "地域のお祭りで、子供たちが飾り付けた手作りの練り物を引いて町内を練り歩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "勇壮な太鼓の音に合わせて、重厚な練り物がゆっくりと進んでいく様子に、観衆は固唾を飲んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
