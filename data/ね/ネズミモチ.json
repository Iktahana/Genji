        "examples": {
          "standard": [
            {
              "text": "生垣に使われているのは、日陰にも強い鼠黐（ねずみもち）だね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "鼠黐の実は鳥がよく食べるから、庭に植えると鳥が集まってくるよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あの塀沿いに植えられた葉が茂っているのは、鼠黐の木かな？」と彼は尋ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ネズミモチの實（炒り粉にしてコオヒイの代用）。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『本草図譜』などは女貞（ネズミモチ）の一名として「ヤブツバキ」を挙げている。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
