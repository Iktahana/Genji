        "examples": {
          "standard": [
            {
              "text": "検査結果がネガティブだったため、病気の心配はなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この報道は、企業イメージにネガティブな影響を与えるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "報告書には、プロジェクトのポジティブな側面とネガティブな側面の両方が記載されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
