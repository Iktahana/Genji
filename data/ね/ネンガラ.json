[
  {
    "uuid": "4d22ee7b-56cc-507b-9046-9bd984bd6f8a",
    "entry": "年がら",
    "reading": {
      "primary": "ねんがら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "来年がらみんな競馬さも出はるのだづぢゃい。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "えい、冷たいままで勝手におれ、年がら年中冷たい雪を冠っておるのがいいのさ。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにこっちには仕事の勤めというものがあるし、年がら年中、そうべたくさする嚊の相手にばかりなっちゃいられませんからなあ。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも年がら年中医者の攻撃ばかしやっていたわけではない。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "年がら年じゅう警察のいすに腰をかけて、ひとが外国行の旅券を受け取っていくのをながめている、これがわたしの持ってうまれた運なのだ。",
              "citation": {
                "source": "幸福のうわおいぐつ",
                "author": "LYKKENS KALOSKER",
                "note": "青空文庫"
              }
            },
            {
              "text": "もの静かな老嬢は、生きているときは、年がら年じゅう家の中の同じ場所だけをゆっくりと動きまわっていましたのに、死んだいまとなって、このひろびろとした国道を真一文字に走って行くのでした。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の兄弟も多勢あるのに、どれもこれもやくざで、年がら年中たかられてばかりいるのよ。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "御名物のお殿様でごぜえますから、直に申しまするが、名前は人好し長次、まとまった金がころがりこむと、じきにうれしくなって人にバラ撒いちまいますんで、この通り年がら年中文なしのヤクザ野郎でごぜえます」「わはは。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまた、私は、どうしてこう、年がら年じゅう貧乏なんだろう。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "また年がら年じゅう寝そべってばかりいて、起たせようと思っても、とても無駄な話で、どんなことがあっても決して起き上ろうとしない無精者もあった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の部屋に独りで落つくといふことも出来ず、年がら年ぢゆう、妻と鼻を突き合はせてゐなければならないなんて！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "年がら年ぢう何んな時にも、憤つても、泣いても、たつたそれだけの半オクターヴほどの間の半音見たいな声しか持たない人なんか、あたし可笑しくつてとても傍に居られないのさ。",
              "citation": {
                "source": "早春のひところ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "年がら年じゅうこづきまわされている彼らは、これだけは自分の自由意志だと思いこんだものがぐわんと阻まれるその刹那に、想像できないほどの敵愾心を煽られるのであった。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "年がら年中そうなんですから、服も地下生活をしているかぎり、年がら年中同じ服でいいわけです」「それはいいですね。",
              "citation": {
                "source": "三十年後の東京",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "花が咲く、という言葉には、深い感じがあって、それこそ花のない町という裏づけがあってこそなのだのに、年がら年じゅう花が赤く黄色く開きぱなしの自然の中では、よろこびの感覚さえ眠ってしまうでしょうね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五のグリーシャ、年がら年じゅうブガーノフの耕地さぼいこくられて、聖母さまのお水のんで命つないでた。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十年も後家を立てて、彼方の嚊ア此方の嚊アから姦男をしたの、亭主を取つたのと呶鳴りこまれて、年がら年中おこらせてゐたつて何になるよ。",
              "citation": {
                "source": "地方主義篇",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからといふものは、夜昼の区別なく、春夏秋冬、年がら年中、のべつ幕なしの大戦争で、お互に敵に打勝つ手段を考へては、その魔法をつかつて戦ひました。",
              "citation": {
                "source": "悪魔の尾",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、年がら年じゅう同じものを繰返し繰返し見ていることが、ちょうど毎晩同じ劇場へはいって芝居を観る者に起きるように、私の心をとうとう倦怠と嫌悪の巣にしてしまった。",
              "citation": {
                "source": "ある自殺者の手記",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "※　といつても、僕は年がら年中、パイプを吹かしてゐるのではない。",
              "citation": {
                "source": "パイプについての雜談",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう、赤まんまの花なんて、お前ぐらいの年頃には、年がら年じゅうあっちにもこっちにも咲いていたような気がするね。",
              "citation": {
                "source": "幼年時代",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はしかし、年がら年中結婚のことばかり念頭に置いてゐるわけではない。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "年がら年ぢうをらんでもえゝから、まあ五月頃から十月いつぺえ、ゐてほしいつていふ話だが……。",
              "citation": {
                "source": "秋の雲",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "『あなたは年がら年中、このブリッジに立って果しもない大海を眺め、潮風に吹かれ、雲の変化を見ているんですね、丁度船長のように。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドアの敷居はなく、そこは年がら年中鶏が出はいりする通路になっていた。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と呼び立てるのを聴けば、年柄もなくそのからくり屋を光子が門前で引き止めていたらしく思われる。",
              "citation": {
                "source": "絶景万国博覧会",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしなんか斯うやつてゐたつて年柄年中、びく／＼してゐて、やりたいと思ふことは何んにも出來やしないしさ――これぢや堪らない。",
              "citation": {
                "source": "痴日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖母は年柄ではさぞ信心っぽい人の様だけれ共案外で別に之と云う宗教も持って居ないので、私達のところへ来ると熱心に「あみださま」の講釈をする。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "年柄年中｜間断なしに仕事を追ひ掛け片付けてそれでやっとどうやら廻って行く事が出来る。",
              "citation": {
                "source": "夏蚕時",
                "author": "金田千鶴",
                "note": "青空文庫"
              }
            },
            {
              "text": "――（此時吉本榮吉演壇に趣きて田中に私語す）――豫ねて前にも申上げて置きました通り、嘸ぞ御迷惑でございませうけれども、何卒當年の如く御休の多い年柄でございますから、幸に此の被害者を御救ひ下さる御思召がございますならば、今暫く御清聽を願ひたう存じます。",
              "citation": {
                "source": "公益に有害の鑛業を停止せざる儀に付質問書",
                "author": "田中正造",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
