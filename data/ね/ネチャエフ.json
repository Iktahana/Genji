          "standard": [],
          "literary": [
            {
              "text": "ネチャエフの伝記だった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドストイェフスキーが小説にかいている事件かしら」　それにとりあわず、山上元は、「ネチャエフという男は、大した男だ」と云った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本のインテリゲンツィアは、あんまりいくじがないから、ひとつ、ネチャエフみたいに、しっかりした男もあるってことを教えてやる必要がある」　ネチャエフは、ヴェーラと同時代の人だった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子のデスクの上に、ネチャエフの伝記がおかれた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネチャエフの伝記は、幼年時代の彼の生いたちから物語られていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "法廷におけるネチャエフのたたかい。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い時間しらべた上、伸子はネチャエフの法廷での陳述の部分だけを訳すことにきめた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――被告ネチャエフが出廷した。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "現にこうして、ネチャエフの法廷記録を訳すことだって、伸子のする仕事の一つであるのだから。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
