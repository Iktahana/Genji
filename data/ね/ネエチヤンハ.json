        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私ハネエチヤンニ、「ネエチヤン、アノウサギノミミヲ立テテ下サイ」トイヒマシタノデ、ネエチヤンハ足デウサギノミミヲツマンデ、立テテオヤリニナリマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエチヤンハ「オカシナミミデスネ」トオツシヤツテ、オワラヒニナリマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪子は慌てて、「ネエチヤンハ足デウサギノミミヲ………」とある「足デ」の二字を鉛筆で消した。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は「ネエチヤンハ足デ」から以下「タオレテシマヒマシタ」までを次のように訂正した。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
