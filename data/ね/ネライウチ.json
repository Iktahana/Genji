        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は目標を狙い撃ちし、見事に事業を成功させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新製品開発では、顧客のニーズを的確に捉え、狙い撃ちする戦略が重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの企業は、市場の隙間を見つけて狙い撃ちでシェアを拡大している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
