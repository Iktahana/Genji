        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「クララの光りの髪」とアッシジで歌われたその髪を、真珠紐で編んで後ろに垂れ、ベネチヤの純白な絹を着た。",
              "citation": {
                "source": "クララの出家",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "クララは床から下り立つと昨日｜堂母に着て行ったベネチヤの白絹を着ようとした。",
              "citation": {
                "source": "クララの出家",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エジプトとかベネチヤとかいふ漂浪者の群のやうにも。",
              "citation": {
                "source": "一少女",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ側のサロン、エネチヤという家にはいると早くも私は知り合いの女給たちに囲まれてしまつた。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉の方が伊太利のホテルの安心のならないことを僕に注意して、※ネチヤでは自分達が先に行つて泊つて居る父の馴染のホテルへ来る様にと言つたが、一等室に乗つて居る二人に書生旅行の僕が附合へ相に無いから其親切を謝して僕はミラノへ降りた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日の晩の、※ネチヤ行の汽車の時間を下部に問うて二十三時二十分と答へられたのには一寸面｜喰つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "※ネチヤ　午前四時にネチヤ美人と云ふのだらう、目の大きく張つた、チチヤノの絵に見る様な若い女が寝巻の上に遽に着けたらしい赤い格子縞の前掛姿で白い蝋燭を手にして門を開けて呉れた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "之がネチヤ女と褒めるけれど目が大きいのと鼻が馬鹿に高い丈で色は青｜黒いし表情は沈んでる。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は※ネチヤが海上の一｜覇王として東洋に迄交通して居た貴族政治の昔を忍ばずに居られなかつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の処女劇作『ヴェネチヤの夜』が、オデオン座に上演された時、見物は冷遇した。",
              "citation": {
                "source": "戯曲時代",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミュッセは、その処女作、「ヴェネチヤの夜」が舞台的失敗に終つた結果、その後、上演を断念して、自ら「書斎で観る芝居」なるものを書き続けたが、これが、作者の死後、今日に至つて、観客の心を酔はす比類なき近代古典の中に数へられてゐるのである。",
              "citation": {
                "source": "近代劇論",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　ヴェネチヤの水の都で、ダニエリの旅館に久しく遊んで居た頃、番頭が何処かのおばあさんに話して居るのを聴くと、此宿の地下室はどら猫の多く居るので有名だそうである。",
              "citation": {
                "source": "どら猫観察記",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェネチヤの穴倉ならば、大抵どの位湿気て居るかも想像し得られるが、その暗い処に何十代以来とも知らず、野獣の如き猫が棲息して、其数幾何なるかも分らぬという。",
              "citation": {
                "source": "どら猫観察記",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕は僕なりに、自分のカヌーに乗って“時”の流れを漕ぎくだりながら、友だちの家の側柱にカヌーをつないでは、中へはいって食事の御相伴にあずかって暮しているよ」「まったくヴェネチヤふうだね」まだ窓の外を眺めながら、ジェム・ベンスンは言った。",
              "citation": {
                "source": "井戸",
                "author": "Ｗ・Ｗ・ジェイコブズ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
