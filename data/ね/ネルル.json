          "literary": [
            {
              "text": "ゲラル・ド・ネルルの死は「夢が人生を殺した」のであつた。",
              "citation": {
                "source": "牧野さんの死",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その深夜ネルルにねばられるのが厭だつたから戸を開けやうとしなかつた。",
              "citation": {
                "source": "牧野さんの死",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲラァル・ド・ネルルの友人達もそれぞれの追憶文で彼の一生を飾つてやつたが、彼等の評語に共通してゐるひとつの言葉は「怠け者」といふことだつた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネルルも亦生き易くて仕方がなかつたにちがひはなかつた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめ東京鉄道事務所の好意になる地図を見た時、湯沢の方のこのトンネルループの存在理由が了解出来なかった。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
