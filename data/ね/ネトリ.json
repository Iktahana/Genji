[
  {
    "uuid": "e842dceb-4f13-530d-82b0-fa09ada0e33a",
    "entry": "寝取",
    "reading": {
      "primary": "ねとり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
