  {
    "uuid": "ebf5e2e4-a8e4-5666-b801-c7b97365f30a",
    "entry": "ネゴト",
    "reading": {
      "primary": "ねごと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
