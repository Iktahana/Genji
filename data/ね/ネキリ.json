        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "害虫の根切りには、専門業者に依頼するのが確実だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この病原菌は、徹底的な根切りでなければ撲滅できない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古い悪習を根切りし、新たな伝統を築くべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
