[
  {
    "uuid": "4732d042-38c6-53f5-a09b-7926b40ed34e",
    "entry": "狙い",
    "reading": {
      "primary": "ねらい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
