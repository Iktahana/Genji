  {
    "uuid": "738e1659-11d3-5abb-b397-c46188a263ae",
    "entry": "ねちねち",
    "reading": {
      "primary": "ねちねち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そう、ねちねちやられて堪るかい。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ねちねち言っているうちに、唇の色も変り、口角には白い泡がたまって、兇悪な顔にさえ見えて来た。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ねちねち言つてゐるうちに、唇の色も変り、口角には白い泡がたまつて、兇悪な顔にさへ見えて来た。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "話がねちねちして理窟が多すぎるし、あまりにも私を意識しているゆえか、スケッチしながらでも話すことが、みんな私のことばかり。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし出来ないことをねちねちしているのも嫌だから早速この手紙を書いた次第。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」青扇はねちねちした調子で言いだした。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "我武者羅に押通さうものなら、默つて聽いてはゐるが、『さういふけどなあ』とねちねちやつて來る。",
              "citation": {
                "source": "知らない人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪弁というものは語り物的に饒舌にそのねちねちした特色も発揮するが、やはり瞬間瞬間の感覚的な表現を、その人物の動きと共にとらえた方が、大阪弁らしい感覚が出るのではなかろうか。",
              "citation": {
                "source": "大阪の可能性",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはは……」　小田の分類によると、三高出身者には、軽佻浮薄派（さしずめ小田がその代表）と、重厚派の二種類あるが、吉井は、「重厚派と見られることを最もいやがっている所の重厚派」であるだけに、ねちねちした口調で、ポツリポツリ語りだした。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "隠さんと言っとくなはれ」　ねちねちとからんで来た。",
              "citation": {
                "source": "秋深き",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "反対されたのは構わなかったが、その時教授の息子である級長の根室が、京都人らしい陰険な眼を眼鏡の奥にぎょろりと光らせながら、ねちねちとした口調で、「毛利君の案は不穏当だと思う。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが済むとねちねちした口調で言った。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてあのねちねちした豆の香をかぐような思いがする。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "家も見窄らしかったが、主人も襟垢の附た、近く寄ったら悪臭い匂が紛としそうな、銘仙か何かの衣服で、銀縁眼鏡で、汚い髯の処斑に生えた、土気色をした、一寸見れば病人のような、陰気な、くすんだ人で、ねちねちとした弁で、面を看合せると急いで俯向いて了う癖がある。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "山本はねちねちした口調で、村での源吉のくらし向きの事なぞについて多く訊いた。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "狭山は躍起となって持前の蛇の様にねちねちした性分で、愈々しつこく弓子にまとわりついて行ったものです。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして日頃｜肚に保っていた色々の場合のおとらの挙動が、ねちねちした調子で詰られるのであった。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの時王子の御父さんは、家へ帰って来るとお島は隅田川へ流してしまったと云って御母さんに話したと云うことは、お前も忘れちゃいない筈だ」養父はねちねちした調子で、そんな事まで言出した。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は行ろうと思ったら、どんな事があっても遣通そうって云う気象ですから、のろのろしている名古屋ものなぞと、気のあう筈がないんです」「そんな人とどうして一緒になったね」女はねちねちした調子で言った。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
