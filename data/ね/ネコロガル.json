    "definitions": [
      {
        "index": 1,
        "gloss": "to lie down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "疲れて帰宅すると、すぐにソファに寝転がり、テレビをつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは芝生の上に寝転がり、空に浮かぶ雲の形を当てっこしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はハンモックに寝転がって、心地よい午後の風を楽しんでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "禹徳淳　（俯向けに寝台に寝転がる）またか――うんざりするなあ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（さう捨白を残して、逃げるやうに立ち去る）底野、あつけに取られ、元の位置に帰り、ごろりと寝転がる。",
              "citation": {
                "source": "運を主義にまかす男",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（寝転がる）夫　　傘をさしてか。",
              "citation": {
                "source": "明日は天気（二場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "小径をぐるぐる廻り、ここという場所を探し、そこで銀貨を「失く」し、踵で押し込み、腹這いに寝転がる。",
              "citation": {
                "source": "にんじん",
                "author": "POIL DE CAROTTE",
                "note": "青空文庫"
              }
            },
            {
              "text": "もはや処刑を見ようとはせず、目をつむって砂の上に寝転がる人もいましたよ。",
              "citation": {
                "source": "処刑の話",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、とある木の下の、青あおとした草原にねころがると、そのまま、ぐうぐうねこんでしまいました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "その土間に足を置いたまま、アーンとアンペラの上にねころがる。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして考える時は、寝ころがるのが、僕の癖だよ。",
              "citation": {
                "source": "聖女人像",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "平造は、食事を終ると、仰向けにごろりと寝ころがる。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（仰向けに寝ころがる）夫人　　そんなに気をおつかひになることはないでせう。",
              "citation": {
                "source": "可児君の面会日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "だれです、そんなところへ寝ころがるのは？",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日はこれだけ……」　時によると、夜の明けはなれる頃、彼は、ぐつたりとなつて、そこへ寝ころがるといつしよに、ズボンのカクシから、紙幣をいく枚か鷲づかみにして、妻の枕もとへ投げ出す。",
              "citation": {
                "source": "秋の雲",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "大坪、斜面の木の根を枕に寝ころがる。",
              "citation": {
                "source": "かへらじと",
                "author": "日本移動演劇連盟のために",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛田は、昨日まで底野がやつてゐたやうに、座蒲団を二枚並べ、その上に寝ころがる。",
              "citation": {
                "source": "運を主義にまかす男",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "帽子を被つたまゝ寝台の上に寝ころがる。",
              "citation": {
                "source": "音の世界",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（さう云ひながら畳の上にごろりと寝ころがる）おさとさん、おれは此処で勘弁してくれ。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "）鵜瀞は再び仰向けに寝ころがる。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（かう云ひ終りて、あふむけに寝ころがる）京作　　（そつと、その顔をのぞく）文六　　（帰り来りて、此の有様を見て驚く）おせい　　廉坊は大丈夫か知ら。",
              "citation": {
                "source": "麺麭屋文六の思案（二場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま彼はオクローシカという氷のように冷たい夏向きのスープを詰めこんで、川岸の熱いほど焼けた砂の上に仰向けに寝ころがる。",
              "citation": {
                "source": "富籤",
                "author": "ВЫИГРЫШНЫЙ　БИЛЕТ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘラヘラ笑いながら自堕落に身体を投げだし、ゴロリと板敷のうえに寝ころがると、いつものように肘枕をつき、「ふふん、これで、どうやら眼鼻がついた」　と、つぶやいた。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "菊香水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから気軽に、草の上に寝ころがることも出来れば、ガサガサと藪の中をくゞることも出来ます。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その下がいちめんの芝生で、生徒はいつもそこへ寝ころがる。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ酒を飲んで寝ころがるか、ぶらぶら歩きまわってむだ話をするだけである。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おもんはそういうことにはなんの興味もないらしい、すてばちな投げた調子で、馬鹿にしたような生返辞ばかりしかせず、ついには欠伸をして寝ころがるのがおちであった。",
              "citation": {
                "source": "柳橋物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雷鳴か』　昼寝をしていた高安平四郎は、顔に乗せていた書籍を落して、むくりと寝転ると、『……襲るかな？",
              "citation": {
                "source": "夏虫行燈",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
