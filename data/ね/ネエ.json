        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「大丈夫ねえお父さん」　十二のが二人の詞を打消す様にそういった。",
              "citation": {
                "source": "大雨の前日",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月の何日頃であったか、表の呉縁に朝日が暖くさしてる所で、自分が一人遊んで居ると、姉が雑巾がけに来て「坊やはねえやが居なくても姉さんが可愛がってあげるからね」と云ったら「ねえやなんか居なくたってえいや」と云ってたけれど、目には涙を溜めてたそうである。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえやは、ようツたアなア、ようツたアなア。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえやはいままでどいってた……」　と繰返し云って、袖にすがられた時に、無口なお松は自分を抱きしめて、暫くは顔を上げ得なかったそうである。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "母はそれから幾度か、ねえやの処へ一度つれてゆくつれてゆくと云った。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「良くまア坊さんきてくれたねえ」と云って母子して自分達を迎えた。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お松は「今夜坊さんはねえやの処へ泊ってください」と頻りに云ってる。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえやのとこへ泊れる」　自分がそういうと「さア極った」と云ってお松は喜んだ。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お松は「仕様がないねえ坊さん」と云って涙ぐんだ。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸女「薄紫といふやうなあんばいで意気だねえ」上方女「いつかう粋ぢや。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前のほつそりした頸すぢお前のながくのばした髮の毛ねえ　やさしい戀びとよ私のみじめな運命をさすつておくれ私はかなしむ私は眺めるそこに苦しげなるひとつの感情病みてひろがる風景の憂鬱をああ　さめざめたる部屋の隅から　つかれて床をさまよふ蠅の幽靈ぶむ　ぶむ　ぶむ　ぶむ　ぶむ　ぶむ。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなた　いつも遲いのねえ。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポオの無韻詩「大鴉」の表現効果は、あのねえばあ・もうあとか、れのああとかいふ言葉の、寂しく遠い、墓場の中から吹いて来る風のやうな、うら悲しくも気味の悪い音韻の繰返す反響にある。",
              "citation": {
                "source": "詩の翻訳について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『エ、おい何とか言はねえか、物を言はねえかよ、唐變朴』『………………』『蹈んだら、蹈んだと言ひねえな、確かに私が、蹈みましたと詫びりや、すむ事ツた。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "己あ其樣に唐人言葉は知らねえ日本人なら日本の言葉で言へ、恁う最う少し胸の透く樣な文句を利いた者だぜ』痛罵しえて意氣昂然たり。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『足を蹈んだのは僕が惡かつた、惡かつたから謝罪る、ねえ君、これは僅かだけれど膏藥代に、な、納めて呉れ玉へ、さあ』對手の心事、酒代にありと見て取つた若紳士は、事の組し易きを喜んで、手早く握つた銀貨、二枚、三枚、光る物手をすべつて男の掌に移るよと見る間に「呵」と叫んで紳士は身を轉換した。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『イヨー、大哥』『えらいぞ』『音羽屋ア』『やつちえねえ、骨はおれが拾つてやる』彌次馬の騷ぐこと、夕立の如し。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『いやにじれつたいな、何うにも、恁うにも、恐かないなら、手を地べたに着いて謝罪んねえ、そこへ坐つて、チエツ、意氣地のない青二才だ』「カツ」と痰を吐いたのが、胸の處へベツタリ絡みつく。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、いづこぞ夢の序樂のぽろねえず、會社は河岸に涙をひたし、花店の飾窓つゆにぬれたり、しばしまたつりがね鳴らむ、あさまだきにほふ葉影に、しろじろとかざし泳がせ、この列をなす少女らあゆむ。",
              "citation": {
                "source": "若き尼たちの歩む路",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "行夫はすぐ嵩にかゝつて、「敏ちやん何云つてるのよ、夜中の汽車だつて今朝パパが仰有つたのに、ねえパパ」と少し意地惡く敏夫を見やつた。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「又起きたの、駄目だねえ。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して、「隨分この心臟は小だねえ」と云つて彼れに示したりした。",
              "citation": {
                "source": "實驗室",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰にも、それは、語れない　ことだけれども、それこそが、いのちだらうぢやないですか、　けれども、それは、示かせない……かくて、人間、ひとりびとり、　こころで感じて、顔見合せればにつこり笑ふといふほどの　ことして、一生、過ぎるんですねえ雨が、あがつて、風が吹く。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤツキリはしてゐねえ。",
              "citation": {
                "source": "散歩生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえ、お祖母さん、あたしお腹が空いたの――」「ぢきに御飯にしてあげるから、勉強してるんですよ。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あれがねぇ君、帝政時代の或る伯爵の娘だと聞いたら驚くだらう。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『いたねぇ、ジェム。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうやってお知りになったかは知らねぇけど。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねぇ、のどがからからなんだけど。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねぇ、この地は主がお作りになったの？",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
