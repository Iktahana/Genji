          "literary": [
            {
              "text": "ダガ　イクラ　ガマンシテモ　ネムタクナルバカリデス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ　イクラ　ガマンシテモ　ネムタクナルバカリデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネブトというと腫物のように聞えるが、なお目的は睡魔を攘うにあって、宇都宮の方ではこれをネムタ流しといい、その際に紙で作った人形を流す風習もあった（同上）。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてこれをまたネムタ流しと称えている（郡誌）。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在知られている南の端は、越中｜滑川のネムタ流し。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
