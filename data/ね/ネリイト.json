        "examples": {
          "standard": [
            {
              "text": "着物の帯には、美しい光沢のある練り糸が使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "練り糸は、高級な刺繍や織物によく用いられる素材だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔ながらの手法で紡がれた練り糸は、独特のしなやかさを持つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "糸も掛けない素の白身、雪の練糸を繰るように、しなやかなものである。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで早くも鉱毒の侵害を知って、新たに井戸を掘り、練糸にも染色にも、いっさい井戸水を汲み上げて使っているのである。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
