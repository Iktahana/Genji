    "definitions": [
      {
        "index": 1,
        "gloss": "short, padded coat that covers someone and a baby on their back",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "寒い冬の夜、おばあちゃんがねんねこを羽織って孫を抱っこしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ねんねこの中から、赤ちゃんの可愛い寝顔が見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の日本では、母親はねんねこで赤ちゃんを背中に背負いながら仕事をしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それも母のきものをなほしたねんねこだつたからそれよりずつとむかし、明治二十年前後の織物だつたかもしれない。",
              "citation": {
                "source": "縮緬のこころ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのねんねこで若いきれいな守女におぶさるのがうれしかつた。",
              "citation": {
                "source": "縮緬のこころ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒繻子のゑりがかゝつたそのねんねこがすらつとした色の白い若い守女と眼の大きな髪の毛の黒々とした茫漠としたやうな女の児をつつんでゐたその頃の――明治三十年代のやや古びたおめしちりめんを想像して下さい。",
              "citation": {
                "source": "縮緬のこころ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の子は、母の真似をして、小さい白いガーゼのマスクをして、そうして白昼、酔ってへんなおばさんと歩いている父のほうへ走って来そうな気配を示し、父は息の根のとまる思いをしたが、母は何気無さそうに、女の子の顔を母のねんねこの袖で覆いかくした。",
              "citation": {
                "source": "父",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊やがねないと乳母車、ねんねこようをきかされる。",
              "citation": {
                "source": "乳母車",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "登三はをかしな調子でねんねこ唄のやうな鼻唄を歌つてゐたが、がり／＼と虻の刺したあとを掻きながら、これもやがて鼾になつてしまつた。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……前に内にゐて手まはりを働いてくれた淺草ツ娘の婿の裁縫屋などは、土地の淺草で丸燒けに燒け出されて、女房には風呂敷を水びたしにして髮にかぶせ、おんぶした嬰兒には、ねんねこを濡らしてきせて、火の雨、火の風の中を上野へ遁がし、あとで持ち出した片手さげの一荷さへ、生命の危ふさに打つちやつた。",
              "citation": {
                "source": "十六夜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔母は誰かをおんぶしてゐるらしく、ねんねこを着て居た。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "右隣は中学生、左隣は、子供背負ってねんねこ着ているおばさん。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔母は誰かをおんぶしているらしく、ねんねこを着ていた。",
              "citation": {
                "source": "苦悩の年鑑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして細帯一つでねんねこ半纏を羽織って、縁側に出て楊枝を使っていた。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊やにねんねこ歌を歌ってきかせたのよ。",
              "citation": {
                "source": "少年・春",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の母親達はそれをねんねこ歌のやうにして小さな子供たちに歌つてきかせてゐるのでした。",
              "citation": {
                "source": "女王",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "※ねんねこや、ころころや、ねんねのお守は何処いった、あの山越えて里いった。",
              "citation": {
                "source": "狂女と犬",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねんねこや、ころころや、……」「もうわかりましたよ」と坊さんは私の言葉を強く遮った。",
              "citation": {
                "source": "狂女と犬",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し奥には、「ねんねこ」おんぶをした女の横姿も見えた。",
              "citation": {
                "source": "一刻",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで提灯の明りと子供の声をたよりにのぞいてみると、すぐ足の下に蜘蛛の巣を被って、若い髪の乱れた女がねんねこに子供を負って打伏していた。",
              "citation": {
                "source": "苦力頭の表情",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまき婆は堪まりかねて、子供のくるまったねんねこを擦ろうとして女の頸に触った。",
              "citation": {
                "source": "苦力頭の表情",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "社殿の縁には、ねんねこ絆纏の中へ赤ん坊を負って、手拭の鉢巻をした小娘が腰を掛けて、寒そうに体を竦めている。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒繻子の領の掛かったねんねこ絆纏を着て、頭を櫛巻にした安の姿を、瀬戸は無遠慮に眺めて、「こんなお上さんの世話を焼いてくれる内があるなら、僕なんぞも借りたいものだ」と云った。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄關の二疊には、小説で讀まされて舊知の感のある、近所の酒屋の爺さんの好意からだと言ふ、銘酒山盛りの菰冠りが一本据ゑてあつて、赤ちやんをねんねこに負ぶつた夫人が、栓をぬいた筒口から酒をぢかに受けた燗徳利を鐵瓶につけ、小蕪の漬物、燒海苔など肴に酒になつた。",
              "citation": {
                "source": "足相撲",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "石橋の姉さんが赤ン坊を背負ふねんねこを借りて、それを着せて帰へらしたが、その濡れた衣類を帯で縛つて、片手にブラ提げ、ポタ／＼雫を垂らしながら、悄然として去つた甚五郎の姿を思ひ出すと、今でも気の毒で耐えられないのだ。",
              "citation": {
                "source": "硯友社と文士劇",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "お糸さんは八端のねんねこで、母の祕藏ツ子だつた弟をおぶつて買もののやうなふりをして出かけた。",
              "citation": {
                "source": "日本橋あたり",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙なところへ東洋風の豪傑と江戸っ子の負け惜しみをもつ父は、かなりな大手術であったであろうに、わざわざ病室から離れまで出張して――枕も上らなかったように思えたのに、八端のねんねこを引っかけて、曲※によりかかり、高脚のお酒を飲みながら腕を裂かれていた。",
              "citation": {
                "source": "西洋の唐茄子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "」というと、これをお着せなさい、川風はさむいわとでもいったのであろう、艶な声がしてフワリと私の上に投りこまれたものは、軽いフワフワした薄綿のねんねこだった。",
              "citation": {
                "source": "牢屋の原",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしは終りの花火なんか、あとがさびしいから見ないで、そのねんねこにふっさりと包まれて父の膝に狸寝をしていた。",
              "citation": {
                "source": "牢屋の原",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "らっこのトルコ型の帽子に、ラクダの頸巻きをして、外国人のような高い鼻をもった大きな人だったが、家にいる時は冬は糸織のねんねこを着、夏は八端の平ぐけを締めて、あんまり話はしないが細かく気のつく人だった。",
              "citation": {
                "source": "神田附木店",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘たちは、夜になるとねんねこを着た襟を、背中の見えるまでグッと抜衣紋にして、真白に塗った頸にマガレットに結って、薔薇の簪を挿したり、結綿島田に結って、赤と水浅黄の鹿の子をねじりがけにしたりして、お酒をのんでいた。",
              "citation": {
                "source": "鉄くそぶとり",
                "author": "続旧聞日本橋・その二",
                "note": "青空文庫"
              }
            },
            {
              "text": "此奴、寝ん寝子の広袖を着ている。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "sleeping",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
