    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "シヱーターきては冬ごもりらしくない（ネンネコ、サル、胴着、追憶ばかり）。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "……何だか甘い、なつかしい夢でも見ているような気もちになってね……ネンネコ歌にあやされて眠って行く赤ん坊みたように、涙が止め度なく出て来たもんだから、妾はとうとう声を出してオイオイ泣き出しちゃったの。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "東洋の君子国とか、日本武士道とかいう鎖国時代のネンネコ歌を歌っていい心持になっていたら日本は勿論、支那、朝鮮は今後百年を出でずして白人の奴隷と化し去るでしょう。",
              "citation": {
                "source": "父杉山茂丸を語る",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼を醒ましかけた子供に乳を飲まして寝かしつけて、ネンネコ袢纏に包んで、隅ッ子の衣類棚の下に置いて、活動のビラを見まわったりしながら、お千代と一所に湯に這入ったが、ちょうど人の来ない時分で、お湯が生温かったので、二人はいい気持になって、お湯の中でコクリコクリと居ねむりを初めた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣の叔母さんは裏庭にある大きな柿の樹の下へ莚を敷いて、ネンネコ半天を着た老婆さんと一緒に大根を乾す用意をしていた。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "着物の上にネンネコをひっかけ、断髪にもその着物の裾にも埃あくたをひきずっている。",
              "citation": {
                "source": "刻々",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は肥つてゐる上に思切り着物を着込み、その上に當歳の赤ン坊をネンネコで負してゐるから、いつもより餘程膨大された恰好になつてゐた。",
              "citation": {
                "source": "地方主義篇",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こどもを抱いて石段をあがるところ、岡部覚弥の役で、そいつが狂女になって着物を着て、絵のすがたのとおり、はじめはネンネコヤネンネコヤとやっていて、終りに気狂いになるところをやる。",
              "citation": {
                "source": "美術学校時代の岡倉先生",
                "author": "板谷波山",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
