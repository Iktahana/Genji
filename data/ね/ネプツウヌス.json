          "literary": [
            {
              "text": "しなやかに、竜の背からネプツウヌスの馬に8140乗り換えて来る。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "この神等の畏く振舞ひ給ふ境には、8180ネプツウヌスの神も平けくまつりごち給はむ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロドス島のテルヒイネス魚尾の馬と竜とに乗り、ネプツウヌスの三尖杖を持ちて登場。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "合唱の群いかなる荒波をも鎮むる、ネプツウヌスの8275三股の杖を鍛ひしはわれ等なり。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "雷の神濃き雲を舒ぶるとき、その恐ろしきはためきにネプツウヌス応ふ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
