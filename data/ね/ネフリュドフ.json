        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "朝子は翼をトルストイの小説「復活」の主人公ネフリュドフに比べてゐる。",
              "citation": {
                "source": "貝殼追放",
                "author": "「八千代集」を讀む",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あのネフリュドフの眞似の出來るのは翼一人だと思つた。",
              "citation": {
                "source": "貝殼追放",
                "author": "「八千代集」を讀む",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネフリュドフには良心の苛責があり、道徳的倫理的思索反省が常にあつた。",
              "citation": {
                "source": "貝殼追放",
                "author": "「八千代集」を讀む",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネフリュドフが、どんな苦しみをも苦しまうとした心には、彼の道徳的意力の伴つてゐる事を忘れてはならない。",
              "citation": {
                "source": "貝殼追放",
                "author": "「八千代集」を讀む",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は、トルストイのネフリュドフに、かゝる男を比較されたのを見て、失笑を禁じる事が出來なかつた。",
              "citation": {
                "source": "貝殼追放",
                "author": "「八千代集」を讀む",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
