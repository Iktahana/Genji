        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "疲れが深い眠を引き、先刻ひと寝入りで寝足りた小田島は再びベッドに横になっても眠くはなかった。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はどんなに寝足りた時でも、眼をさましてから半時間、時に一時間も二時間も、寝床の中でぐずついている癖がなおらない。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝起きて啜る渋茶に立つ煙りの寝足らぬ夢の尾を曳くように感ぜらるる。",
              "citation": {
                "source": "倫敦塔",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は寝足らない頭を枕の上に着けて、夢とも思索とも名のつかない路を辿りながら、時々別種の人間を偸み見るような好奇心をもって、叔父の寝顔を眺めた。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿へ帰って、午前三時頃から疲れて眠って、あくる朝の六時頃、洗面器を裏手の畑へ持ち出して、寝足らない顔を洗っていると、昨夜来わたしを苦しめていた下歯一枚がぽろりと抜け落ちた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝足らない眼に沁みる朝の空気は無数の針を含んでいるようで、店の前の打ち水も白い氷になっていた。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六　朝起きて膳に向った時見ると、四人はことごとく寝足らない顔をしていた。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして四人ともその寝足らない雲を膳の上に打ちひろげてわざと会話を陰気にしているらしかった。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝ても、寝ても、寝足りないといふ風で、斯うして横になれば直に死んだ人のやうに成るのが此頃の丑松の癖である。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "三吉は眠がって、いくら寝ても寝足りないという風である。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝足りた朝のように平凡な雑草まで眼をとめて眺めたいのは、これは自分も一人前に成長して来たからだと思われた。",
              "citation": {
                "source": "厨房日記",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供が婆やと一緒に二階へ上って来た頃は、眼は覚めていたが、いくら寝ても寝ても寝足りないように疲れていた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "舳に立つと、互に離れないように、艫と艫とを太い縄で結びあわせた僚船の姿が、まだ寝足りなそうに浮かんでいるのが見えた。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで寝足りないために神経がぼんやりしているというような日は想像に富んだ文が書ける、イメージネーションは殆ど無限に働く。",
              "citation": {
                "source": "透き徹る秋",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏が鳴いたな、何番鶏か知らん、こちらは眼がさめたけれども、夢を見すぎたせいか、どうも寝足りないような気がしてならぬ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は寝足りた眼をわざとらしくしばたゝいて、障子の硝子越しに青い空を見やると、思ひ切つて一つ大きな伸びをした。",
              "citation": {
                "source": "虎",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はまだ四時位しか眠っていなかったが、もう充分に寝足りたような気持ちだった。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんしろ、此処に戻つて来て以来、永い間のくたびれが出たと見えて、いくら寝ても寝足りねえ。",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「な、な、何の用だえ」　やがて宝生栄之丞は、未だ寝足りないやう、美しい目を充血させて、やさしく訊ねた。",
              "citation": {
                "source": "吉原百人斬",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝っから大笑いなんか持込みやがって」　寝足りない顔の銭形平次は、猿屋の総楊枝をくわえたまま、椽側に立ってぼんやり狭い庭の朝をながめているのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもは三十分程かかったのであるが、満一年間寝足にして置いた割合には存外早かった。",
              "citation": {
                "source": "釜沢行",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ノキャバレノ帰リガ遅カッタノデ寝足リナイノカ、話シカケラレルノガウルサイノデ寝タ振リヲシテイルノカ、ドッチダカ分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾ら眠っても寝足りない年頃の奉公人共は床に這入るとたちまちぐっすり寝入ってしまうから苦情をいう者はいなかったけれども佐助は皆が熟睡するのを待って起き上り布団を出したあとの押入の中で稽古をした。",
              "citation": {
                "source": "春琴抄",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ま、その話は、僕がゆっくりこいさんに聞いて見ますよって、………」病人を中に置いて幸子たちの向う側に、寝足りない、脹れぼったい顔をして、フランネルの寝間着の上に藍鼠の絹のナイトガウンを着て坐っていた奥畑が、狼狽の色を包みきれない様子でそう云いながら、幸子の方へ訴えるような眼差をちらッと向けた。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝すごしたにも拘らず、起きて井戸端へ出て来た旦那は、まだ寝足りないようなふきげんな顔をしていた。",
              "citation": {
                "source": "鵜",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝足らない眼をこすっているうちに、彼は、酒屋の軒から設けの駕籠に乗せられた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし自動車で行ける路でも無いので、昔日の健脚、今の寢足、しかた無いからまた中禪寺へ歸つた。",
              "citation": {
                "source": "華嚴瀧",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ菅原がまだ寢足らぬ顏をして、起きて來た。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "八五郎は寢足らぬ顏を水で洗つて、荒物屋の亭主と飛んで行きました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "神隱し",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
