        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "信州の枕言葉のミスズカル根曲がり竹を切り出してくる土地の人が、後ろに兎の生きたのをぶらさげている。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "根曲り竹も、楊の根も、樅の肌も、はた長くしな垂れるサルオガセも、その柔嫩の手に、一旦は、撫でられぬものはない。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "根曲り竹の藪を三時間もかかりて潜り抜け、偃松帯に取付きて、ほっと一と息つく。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "根曲り竹ならば、押分け押分けて上らるべし。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、はじきかえす根曲り竹の上を、そのばねの反動に送られるように辷って行った。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中偃松は千八百米附近から姿を顕し、陣竹（根曲り竹）と混生していることなどもあった。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "倒木を乗り踰えたり、根曲り竹の密叢を匐い抜けたりする。",
              "citation": {
                "source": "秋の鬼怒沼",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "切り明けがあるので夫を頼りに崖の上を横に搦みながら二町程行くと、太い根曲り竹の藪の中に放り込まれて、後へも先へも出られなくなる、まるで八幡知らずへ入ったようだ。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "深山榛や根曲り竹が一面に叢生して、どう蹈み込んだものか勝手が知れない。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木の根を掴んだり岩角に縋り付いたりして、馬の脊を逆落しに降りた所は根曲り竹の密生した岩壁の窪に過ぎなかった、急直に下ろして来た岩壁はこの窪を作る為に円味を帯びて抉れ込んでいる。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "根曲り竹に足を托して其処まで攀じ登ろうとしたが、滑り落ちる許りで登れそうにもない。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩壁は果てもなく続いているらしい、根曲り竹が夫へ緑の縁をつけたように生えている、そこが私達の唯一の通路なのだ。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "太い根曲り竹の藪が深山榛や樺の類を犇と抱きすくめて、絡み合った小枝が網目よりも細かい。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "山稜は益々急になって、又しても根曲り竹の密叢へ誘き込まれる。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "根曲り笹の密叢に分け入り、九時四十分、偃松帯に達して休憩。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑木や根曲り笹の茂った小高い所を越して、背の矮い笹原を蹂りながら狭い山稜を東に行くと、些かな窪地に水の溜っている草原に出た。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "目指す赤谷山に続く山稜は、此の窪地の西のはずれの根曲り竹や雑木の密生した、夫とも分らないような斜面を可なり登ってからでなければ、尾根らしい形を成していないから、雨か霧にでも閉じ込められた日には、容易に足が出せまいと想われる。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も切明けの跡は全然無い訳ではないが、高さ一丈にも余る根曲り竹の上を歩くことは、人間には出来そうにもない業だ。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西北の縁辺は堤のように小高くなって、いじけた偃松が矮い灌木や根曲り竹の茂った中に押し竦められて、骨ばかりの枝を突き出している。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長次郎が何処からか山独活と根曲り竹の筍を採って来る、晩にそれを味噌汁に作って香りの高い豊脆な味を賞美した。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其中から根曲り竹の筍や行者ニンニクなどが新らしく生えている。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "下には根曲竹や羊歯が多い。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "河の中に淵が続いて通れなくなると、岸に追い上げられて、根曲り竹や灌木につかまりながら、崖の横を搦んだりした。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中｜蕨と独活と筍（根曲り竹）の多いのには一驚した。",
              "citation": {
                "source": "三国山と苗場山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "登るに従って闊葉樹林はいつしか針葉樹林となり、終に根曲り竹の藪となったが、道は何処までも通じている。",
              "citation": {
                "source": "三国山と苗場山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三国峠の下の浅貝の西に筍山というのがありまして、根曲り竹の筍が取れる、それで筍山の名があります。",
              "citation": {
                "source": "望岳都東京",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "秩父や日光や奥上州から奥羽へかけて、丁度それ位の高さの山は、灌木と共に根曲り竹や熊笹などが茂っていて、夏は通過するのに非常に困難であるが、早春の頃三、四尺から五、六尺も雪の積っている時であると、凍結した雪の上を楽に歩き得るので、夏ならば一日を要するであろう行程を二、三時間で通ってしまう。",
              "citation": {
                "source": "冬の山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからは根曲竹の筍が美味になる。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "根曲り竹は一番よくない。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の附近が燧岳を望むに最もよい處で、擡げた二つの頭から偃松根曲竹の緑柔く黒木の密林に入る所、尾瀬沼からは見えぬ高い瀑の懸つてゐるのも見える。",
              "citation": {
                "source": "黒岩山を探る",
                "author": "沼井鐵太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
