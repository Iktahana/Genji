[
  {
    "uuid": "6fa28fa6-6e68-5056-a61a-eddc3dd94860",
    "entry": "寝不",
    "reading": {
      "primary": "ねふ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
