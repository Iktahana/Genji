[
  {
    "uuid": "f15677f3-25b8-5fed-9f40-e81948703184",
    "entry": "寝つき",
    "reading": {
      "primary": "ねつき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "falling asleep",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "最近、寝つきが悪く、毎晩のように夜更かししてしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "心地よい音楽を聴くと、寝つきが良くなると言われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「寝つきを良くするために、寝る前に温かいミルクを飲むことにしたんだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "」　と捻平は火桶の上へ脊くぐまって、そこへ投出した膝栗毛を差覗き、「しかし思いつきじゃ、私はどうもこの寝つきが悪いで、今夜は一つ枕許の行燈で読んでみましょう。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがもとでおたかは暫らく寝つき、病気になったかとひとびとはさすがに同情したが、十日経たぬうちに、しゃんと立ち上り、べつに痩せてもいなかった。",
              "citation": {
                "source": "婚期はずれ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝つきかかっている子供の身体は性なく軟かに、ほっこり温かだった。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがに寝つきが悪かった。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝つきの悪さと、朝の目醒め時の不機嫌さでは小さい頃から樽野は、周囲の人達に酷い迷惑をかけ続けて来た。",
              "citation": {
                "source": "Ｆ村での春",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「…………」　云はれて見れば、次第に朝の目醒め時が伸び夜の寝つきがそれに準じてゐるのに！",
              "citation": {
                "source": "籔のほとり",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、わたくしはどうも寝つきの悪い方で、それにはいつも困るのです。",
              "citation": {
                "source": "身辺打明けの記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうお暇を頂きやしょう」「これこれ闇太郎、――」　と、隠居は制して、「わしは何分、年を取って、寝つきが悪い身体だ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄王のきずはなおりました、けれども、次には病気で寝つきました。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな事をしていて、どっと寝つきでもしたら、どうしたらいいのかしら。",
              "citation": {
                "source": "朴の咲く頃",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はもう、そんなことで、すやすやと寝つきはしませんよ。",
              "citation": {
                "source": "恋愛恐怖病（二場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、毎晩寝つきのわるい赤ん坊が、いつものとおりぎゃんぎゃん泣き出しました。",
              "citation": {
                "source": "曲馬団の「トッテンカン」",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "交代になつて出た頃には子どもはみんな寝しづまつてゐて、寝つきのわるいのが癖の窓ぎはの赤んぼまでが、その晩はふしぎなほど穏やかでした。",
              "citation": {
                "source": "死児変相",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまり嘆いて、ひょっとお前が寝つきでもしようもんなら、姉妹ふたりで他に見る者のねえこの大鍋の身上は、それこそ大変だからのう。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "宙に浮く屍骸",
                "note": "青空文庫"
              }
            },
            {
              "text": "橘中の遊びは、むだごとのやうでも、むだごとを以て、寝つきの悪いむだな時間を助けることもできるから、奇妙なものだといふべきだらうか。",
              "citation": {
                "source": "棋家の文章など",
                "author": "三好達治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところへ主人が、いつになくあまりやかましいので、寝つき掛った眠をさかに扱かれたような心持で、ふらふらと書斎から出て来る。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどく寝つきのいゝ庄造は、布団へ這入つて五分もすれば眠つてしまふのに、そこへ突然氷のやうな足に触られて、起されてしまふのが溜らないから、お前はそつちで寝てくれろと云ふ。",
              "citation": {
                "source": "猫と庄造と二人のをんな",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどく寝つきのいい庄造は、布団へ這入って五分もすれば眠ってしまうのに、そこへ突然氷のような足に触られて、起されてしまうのがたまらないから、お前はそっちで寝てくれろと云う。",
              "citation": {
                "source": "猫と庄造と二人のおんな",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "無為の生活のなかで、人間がだんだん物臭くなって行く経過がわかって面白くもあるが、おかげで寝つきが悪くなり、はやく有江のほうの話がきまって、ほんとうに金持になればいい……などと考えるようになった。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまり寝苦しいなどと思ったことのないキャラコさんなのだが、このごろはなんとなく寝つきがわるい。",
              "citation": {
                "source": "キャラコさん",
                "author": "雁来紅の家",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あの寝つきの悪そうな、ピリピリしているお内儀さんの部屋の前を通って、廊下の方から曲者が来る気遣いはないから、窓から入る外に道はない。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "仏敵",
                "note": "青空文庫"
              }
            },
            {
              "text": "人のいまはの　さびしかりしに安東正胤翁歿すいきのをの絶えつる人を、処女子は、たのむすべなく、あはれ去りにし昭和二年　――二十七首――くだり風村人の寝つきの早さ。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "今、二人ともに、これから寝に就こうとして、その寝つき端をまだ話が持てているらしいのです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "下の間は、寝つきが早く、すぐ静かになったが、上の間では、咳の声がなかなか絶えない。",
              "citation": {
                "source": "べんがら炬燵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝つきがわるいでもなく、眠られないでもないにかかわらず寝るのがつまらなくて　夜がなければ、はやく朝になってくれれば　と念じつつ目をとじる。",
              "citation": {
                "source": "胆石",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが病気で寝つきましたとき、わたくしはその顔をつくづくと見ながら思いました、もしこの人が快くなって起きるようになったらどうしようか？",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "生母は体の弱かったひとで、彼を産むとすぐに寝つき、ようやく治って起きたと思うと、すぐにまた病むというぐあいで、彼が七つの年にとうとう亡くなってしまった。",
              "citation": {
                "source": "契りきぬ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガンたちはすぐに寝つきましたが、ニールスはちっとも眠ることができません。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガンたちはすぐに寝つきましたが、ニールスはどうしても眠ることができません。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどここへ立った時分に、今開けた門の、からからと鳴る、ばねつきの鈴の音が止んで、あたかも可し、玄関へ書生が取次に顕れて、あえてものを言うまでもない。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
