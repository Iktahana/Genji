        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一丁ばかり先の練瓦建の家が、泳いでゐる緋鯉のやうに、ボンヤリトキ色に見える。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれの考へてゐるのは対称はとりながらごく不規則なモザイクにしてその境を一尺のみちに練瓦をジグザグに埋めてそこへまっ白な石灰をつめこむ。",
              "citation": {
                "source": "花壇工作",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日がまはるたびに練瓦のジグザグな影も青く移る。",
              "citation": {
                "source": "花壇工作",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "石神の庄助がさきに立って、そのあとから、練瓦場の人たちが三人ばかり、肌ぬぎになったり、網を持ったりして、河原のねむの木のとこを、こっちへ来るから、ぼくは、きっと発破だとおもった。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "練瓦場の人たちは、みんな水へ入った。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "練瓦場の人たちなんか、三十｜疋ぐらいもとったんだから。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "練瓦場の人たちもついていった。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
