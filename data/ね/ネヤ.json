  {
    "uuid": "710d68d0-be1a-569b-86d6-591390102dc7",
    "entry": "寝屋",
    "reading": {
      "primary": "ねや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "寝屋川のお寺に入れられてたんえ」「逃げて来たのか」「うん」　クリームを塗っていた手をとめて、顔を上げると、ニイッと笑った。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "若者は、寝屋の夢でも屡々この堤を見た。",
              "citation": {
                "source": "パンアテナイア祭の夢",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ひしきもの」は、寝屋具なる引き敷き物すらないから、我が著物をそのまゝ、引き敷き物にして寝るとも悔いまいと言ふ風にとられてゐるが、なる程其である部分までは訣る。",
              "citation": {
                "source": "和歌の発生と諸芸術との関係",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝屋の屏風｜太鼓張の襖なぞ破れたるを、妻と二人して今までは互に秘置きける古き文反古取出して読返しながら張りつくろふ楽しみもまた大厦高楼を家とする富貴の人の窺知るべからざる所なるべし。",
              "citation": {
                "source": "矢はずぐさ",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "いと広き寝屋の如くに、空｜徐に閉さるれば心｜焦立つ人は忽野獣の如くにぞなる……」と。",
              "citation": {
                "source": "夜あるき",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨のふる夜はたゞしん／＼と心さびしき寝屋の内、これ江戸の俗謡なり。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "痴情の寝屋の死の如くに深き唇。",
              "citation": {
                "source": "珊瑚集",
                "author": "仏蘭西近代抒情詩選",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎晩々々寝屋へ這入つて泣かぬことはありませんわ。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "内容の作品は昭和二十三年一月から二十六年七月までの「天狼」に主として発表したもので、私はその間神戸市山本通、兵庫県別府、大阪府寝屋川市と転々と居を移した。",
              "citation": {
                "source": "今日",
                "author": "今日",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時は寝屋川が淀川の支流ででもあったらしく飯盛山下まで船で行けたのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにかを妻と話しているとき、いっしょに食事をするとき、寝屋で抱きあっているとき、自分の眼で見、話しあい、触れあっているのは妻の形骸だけで、本当の妻そのものは遠いところにいる。",
              "citation": {
                "source": "薊",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝屋にはいっても人形を抱くようで、なんの感動もあらわさず、羞らいさえもみせなかった。",
              "citation": {
                "source": "滝口",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一般とは違って仲人夫妻もあとには残らず、しぜん寝屋の盃は二人だけでとり交わすしきたりであった。",
              "citation": {
                "source": "竹柏記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝屋には屏風を（夜具を隠すように）とりまわし、燭台のそばに、作法どおり、盃の支度がしてあった。",
              "citation": {
                "source": "竹柏記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "化粧はしなおしたらしいが、額から頬のあたり、なめらかな皮膚が、蒼ざめて硬ばり、正座した姿勢にも、結ったまま解かない髪（通常は寝屋へ入るときに式の髪は解く）にも、或る激しい意志が、示されているようであった。",
              "citation": {
                "source": "竹柏記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はついに寝屋の盃を交わさずにしまった。",
              "citation": {
                "source": "竹柏記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人だけの対談で、どんな話しが交わされたかわからないが、長い江戸番から帰館したというのに、孫たちも抱かず、妻と寝屋をともにするでもなく、淡々と仙台へ去ってしまった。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めて、甲斐と寝屋を共にしたので、すっかり満足し、安心しているらしい。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第三部",
                "note": "青空文庫"
              }
            },
            {
              "text": "おくみともすでに十一年になるが、寝屋を共にしたのはゆうべが初めてであるし、そうなったいまでも、やはり「自分の女」という感じが少しも涌いてこなかった。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第三部",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころになっても、おくには寝屋ごとがまだわからず、ただ厭わしいのをがまんしているだけであった。",
              "citation": {
                "source": "赤ひげ診療譚",
                "author": "駈込み訴え",
                "note": "青空文庫"
              }
            },
            {
              "text": "むだな夜露に濡れていねえで」　善鬼は、喋舌るだけ喋舌ると、すたすたと、土間のうちへかくれ、隠しておいた寝酒をさげて、自分の寝屋へもぐりこんでしまった。",
              "citation": {
                "source": "剣の四君子",
                "author": "小野忠明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、寝屋に導かれるとき、どこかで、若い娘の声もした。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が更けると、彼らはそれぞれ遊女を抱いて、ほかの寝屋へかくれた。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "深く寝屋に閉じ籠っておりますれば……と」「心得ました。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "国難来　いつもならば奥の主の寝屋の戸はまだ開いている時刻ではないが、母屋も客間も、清掃されているばかりでなく、長屋門の両翼の扉はいっぱいに開かれていた。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜明けごろ、北の寝屋の奥に、朝麿がむずかるのであろう、幼子の泣き声がしばらく洩れていた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、きょうの話題は、牛車のうちでも、寝屋のうちでも、妙に胸に蝕い入ってならなかった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "禅房の戸が、ふくらむように、がたがたと鳴っていたが、そのうちに、上人の寝屋の戸が外れて、車を廻すように、豪雨の庭へころがった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……たのむ、このことはたれにもいうなよ」「……し、しりません」「告げる気か」「い、いいえ」「では早く寝屋へ戻れ。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲間たちのおる寝屋へ戻らぬわけにもゆくまいが」「でも……」と、藤夜叉はその眸に、小むすめの必死を燃やした。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
