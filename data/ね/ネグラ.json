[
  {
    "uuid": "b1ab2454-bbec-58e0-ab01-1327abd49416",
    "entry": "塒",
    "reading": {
      "primary": "ねぐら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
