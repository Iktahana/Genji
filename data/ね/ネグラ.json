        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "友人のアパートは居心地がよく、週末になるといつも彼の塒に集まっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "仕事帰りに立ち寄るいつものバーは、彼にとって唯一落ち着ける心の塒だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "誰も知らない秘密の場所が、私にとっての安らぎの塒だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
