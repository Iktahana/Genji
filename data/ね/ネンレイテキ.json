        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "が、文学の上ではともかく、年齢的には、そういう感じを持っている者が、既に芥川が止りとなったところの年を三ツも四ツも通り越している者がたくさんあるだろう。",
              "citation": {
                "source": "短命長命",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊東氏は四十歳をちよつと出た許りなのである、氏の実力を云々し、将来への期待を抱く人があつたなら、深水氏の年齢的な若さを問題にし、そのことに関心をとどめるべきだと思ふ。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "希望は現在、一つの慌ただしさの中にゐるやうである、それはたしかに年齢的な転換期ともいふべきものであらうし、絵画的な転換期ともいふべきものであらう。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一作者は若い人である筈だ、年齢的若さの究極的な発揮、この一本槍で押していつたら、年をとれば完成されるといふことになるのではあるまいか。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "三岸の場合は須田より年齢的に若いだけに一層その感が適用されるだらう。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "福田、吉岡はこの二人が年齢的にも若いといふこと、その将来性に対する世間の期待と、次には所謂日本画の新しい方向に対して、この二人は何時の場合でも正統な追求の路筋を辿ることを知つてゐるといふ意味から、揺がない世間的な独自の人気を保持してゐるのである。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "年齢的にもむずかしいのだろうし、何か感情の上へショックを受けたことがあるのではないか、という気もします。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故なら、作家野上彌生子の年齢的同時代としては、谷崎潤一郎だの平塚らいてうだの、僅六歳の年長者として永井荷風等があり、それらの人々の生活内容と作品とは、あなたとは全く別様のものです。",
              "citation": {
                "source": "含蓄ある歳月",
                "author": "――野上彌生子さんへの手紙――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「たしなみ」は、道徳と技術との綜合の上に描かれた人間生活の軌範であり、また、それぞれの社会的、性的、年齢的条件に応じて示される力と美との活きたすがたであり、信念と叡智と品位との最も巧まざる表象である。",
              "citation": {
                "source": "妻の日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「嗜み」といふことは、かういふ風にみて来ると、あらゆる日本人を通じて、それが真の日本人である限り、社会的、性的、年齢的条件に応じて、それぞれに示されなければならぬ力と美との活きたすがたであり、信念と叡智と品位との最も巧まざる表象であります。",
              "citation": {
                "source": "青年の矜りと嗜み",
                "author": "――力としての文化　第四話",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのような年齢的、思想的、あるいは肉体的の影響は、この三つの作品にもとりどりの色合いで反映を見せている。",
              "citation": {
                "source": "「可愛い女　犬を連れた奥さん　他一編」あとがき",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう、再びあのやうな嘘のやうな間の抜けた話はめぐりあふことが有り得ない、年齢的に、否、二十八の私は驚くほど子供でもあつた。",
              "citation": {
                "source": "酒のあとさき",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "年齢的なものだつたら、どんな美男子と結婚しても、同じことではないか。",
              "citation": {
                "source": "花火",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のような年配になると、人間世界を若さの世界、年寄の世界、二つにハッキリ区別する年齢的な思想が生れる。",
              "citation": {
                "source": "青鬼の褌を洗う女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "年齢的に劣勢な木村が、覚醒剤を用ひたとて、咎める方が間違つてゐる。",
              "citation": {
                "source": "勝負師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "硬派、軟派の本ヨタは、年齢的には、むしろ普通の中学生に多かった。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚するともしないとも、はっきりしない年月が経過して、やがて年齢的に結婚など諦めねばならぬときとなってしまった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは年齢的にも、詩人としても、ぼくの先輩で、ぼくは殆ど毎日かれを訪ねて、色々と迷惑ばかりかけていた。",
              "citation": {
                "source": "酒友列伝",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月二十七日〔昭和二十一年〕の朝日新聞（大阪）「声」欄の投書中に「年齢的にも知的にも世情に通ずる点でも君より数段上にある部下に単に軍人としての階級の上位というだけの理由で……」という言葉があったが、部下でもない僕に、単に自分が軍人であるというだけの理由で糞威張りをするのであった。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま見ればごく平凡な色と柄の半袖シャツなのですが、敗戦直後の焼け野原から立ち直り、その次の時代へと向かおうとしていた日本に登場した、年齢的に若い人たちによる新しい風俗の、もっともわかりやすい象徴として、アロハ・シャツがあったのです。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "トップ40やコマーシャルなロックンロールを聞く人は、年齢的には一七歳くらいまでだ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさかそれが仕事と関係があろう筈はないのだが、作家としては年齢的にはおそい出発のミネにとって、ペンをにぎるのは相当の労働であった。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "――正しく年齢的に考えてみると、武蔵が、熊本へ行って、細川忠利に客分として遇せられたのが、島原陣の三年後、寛永十七年のことであり、その時武蔵が五十七歳であったと（一説に五十五）いわれているから、この島原役当時、彼はまだ、五十三歳でしかなかったわけだ。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "信二は、その娘たちの好意を、一番年少の自分への年齢的な親愛にすぎないと思っていた。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
