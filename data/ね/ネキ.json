  {
    "uuid": "60e7ef6c-5cfd-57c4-9bc2-9fe4386a962d",
    "entry": "寝起",
    "reading": {
      "primary": "ねき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
