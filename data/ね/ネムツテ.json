          "literary": [
            {
              "text": "仕方ガナク、人参サンハ顔ヲマツカニシテ、半分ネムツテヰルジヤガイモサンノ手ヲウン、ウンヒツパツテ、一里モ先ニアル村ノ停車場ヘカケ出シマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　オタガヒニ、ムカフガ　サキニ　ネムツテ　クレレバヨイニ、トオモヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、ソノママ　ユフガタマデ　ネムツテ　シマヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ　マイニチマイニチ　フタリハ　カウシテ　コウラヲ　ホシナガラ　ネムツテシマヒマス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
