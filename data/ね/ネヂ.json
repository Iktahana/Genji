        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼の人は意地の悪いネヂケた爺さんのやうだからさ。",
              "citation": {
                "source": "いろ扱ひ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身のネヂが、他愛なくゆるんで、之はをかしな言ひかたであるが、帯紐といて笑ふといつたやうな感じである。",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホテル経営といふと、僕がマネヂヤアになるんですか。",
              "citation": {
                "source": "浪の音",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "時の記念日、とまつた時計を時計屋へ持つてゆく、ネヂがゆるんだためで、すぐに直してくれた、タヾで。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "なまけもの、きまぐれもの、ぐうたら、等々と自分を罵つた、どうもこれは直らない、ネヂがゆるんだのではあるまい、ネヂがないのだらう！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネヂを掛ける二つの穴の周囲から羅馬数字を画いたあたりへかけて、手摺れたり剥げ落ちたりした痕が着いて、最早お婆さんのやうな顔の時計であつた。",
              "citation": {
                "source": "出発",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルナチヤルスキーが、「プロレタリアの解放の仕事に助力する」ことを、マルクス主義文学の大前提として規定してゐるのはそのためであり、レーニンが、マルクス主義文学を、社会民主党の「歯車でありネヂである」必要があると言つてゐるのもそのためである。",
              "citation": {
                "source": "諸家の芸術価値理論の批判",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝで私の批判者たちが、文学は形象の文字で語られねばならぬといふ点を重視して、レーニンの歯車とネヂの説を曲解し、この一語によりてマルクス主義文学に於ける政治的優越性が消散してしまふやうに説いてゐるのは甚だしい間違ひである。",
              "citation": {
                "source": "諸家の芸術価値理論の批判",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "○　謙一が、時計を埼子の部屋へ持つて行つてやると、埼子は、人がかはつたやうに、謙一から時計を靜かに受取つて、ゆつくりゆつくり時計のネヂを卷いた。",
              "citation": {
                "source": "就職",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "白いプロペラは、ネヂがきりきりとまはるとみるまに、ぶうんと唸り始めた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "廻轉ハ地上カラ向ツテ右ネヂノ方向デアツタト思フガ確カデナイ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "お彈きのガラス玉、積細工の人形の首、空氣枕のネヂ、コードの切れなど。",
              "citation": {
                "source": "春",
                "author": "横瀬夜雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ白い華車な手が現はれて、ゼンマイのネヂを捲く。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "21ゼンマイのネヂを捲いてゐる大きな白い手。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "15大きな白い手が、ゼンマイのネヂを捲き終つたところである。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "19大きな白い手が、一生懸命にゼンマイのネヂを捲いてゐる。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "生憎ネヂが切れてゐて、相手は足許をみた。",
              "citation": {
                "source": "山形屋の青春",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "果して井上友一郎がさうカン違ひをして、編輯者の権威いづこにありやと云つて大井広介にネヂこんできたさうであるが、井上がさう思ふのは無理もなく、それだけに、矢田津世子が、より以上に、さう思ひこむに相違ないので、私の怒りは、ひどかつたのだ。",
              "citation": {
                "source": "二十七歳",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝには身寄りのない貧窮家族、病人を抱へたのや、子だくさんの寡婦、頭のネヂのゆるんだのや、狂信狐憑きのやうなのや、十一家族もゴチャゴチャと虱と共に雑居して朝晩タイコを叩いて踊つてゐる。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "生涯ろくな目にあはなかつた筈だが、その魂にも外形にも生活苦の陰鬱な刻印がないのは、頭のネヂのゆるんだところがあるせいで、その代り天真ランマン、近代人に欠乏してゐる人生の希望を具現してゐるところがある。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「こゝね、ネヂがねえ、見たつて分りやしないわよ。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "これでネヂがゆるんでゐるとは、大自然といふ奴はまことに意外な細工師ぢやないか！",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞよろしく」　ネヂのゆるんだ声ではないから、最上清人は狼狽して、「あなた、お料理できる？",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "知識は読ませ分らせなければムダにすぎないもので、端坐、ネヂハチマキ、机に向つて読まなければ分らない、それ以外に法がないなら仕方がないが、書き様や表はし様で寝ころんでも読めるやうに工夫のできるものなら、寝ころんで分るやうにした方がいゝ。",
              "citation": {
                "source": "娯楽奉仕の心構へ",
                "author": "――酔つてクダまく職人が心構へを説くこと――",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭のネヂが狂つてゐるか、何べん叱つても無駄なのである。",
              "citation": {
                "source": "朴水の婚礼",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたは自分を玩具のやうに取扱ひ、そして自分でネヂをまいて、自分を踊らして娯しもうとしてゐるのです。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしは貴方のやうなネヂけた人の魂なんか欲しくありませんからね……」「ナ、なぜだ？",
              "citation": {
                "source": "霓博士の廃頽",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "且又これに鍵をかけ、ネヂを差しこみ、閂をかけることを怠ることがないのである。",
              "citation": {
                "source": "総理大臣が貰つた手紙の話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "シローテは之を受取つて暫く工夫してゐたが、このコンパスはネヂが弛んでゐて用に立たないが無いよりはましであらうと言ひ、地図の目盛に合せて測つてゐたが、やがてコンパスを立てゝ此処ですと言ふ。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
