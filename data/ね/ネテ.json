        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "タカ　モ　トウトウ　コトワリカネテ、ソノママ　ツバサ　ニ　ヤマキチ　ヲ　ノセ、ウミ　ヲ　サシテ　トンデ　ユキマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンネテクカット大学校を、最優等で卒業しながら、まだこんなこと私は云ってゐるのですよ。",
              "citation": {
                "source": "葡萄水",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際コンネテクカット大学校で、私の習ってきたことは、「お前はきょろきょろ、自分と人とをばかりくらべてばかりゐてはならん。",
              "citation": {
                "source": "葡萄水",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "次には星の運行の原因を説明するものとして、四つばかりの可能なオルターネティヴを列挙している。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "精密という言葉、量的という標語を持ち出す前にまず考えなければならない出発点の質的のオルターネティヴが案外にしばしば粗略に取り扱われる。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナイルの洪水の問題についても四箇条のオルターネティヴがあげてある。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "カウシテ、オトモダチヲ　ジユンジユンニ　タヅネテ　イキマシタガ、ドノ　トモダチモ　オナジ　コトヲ　イフノデ　アリマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ父ッチャハ半トシモネテ、ウチノ中ニ何ンニモナクナッタトキニ死ンダノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オ母ッチャハソノツギノ日カラネテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ンダオ父ッチャヨリモヤセテ、カミノケガヌケテ、ネテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "はつどつぐデモ捏ネテ売リ出サウカシラ？",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテカラ二人ノ様子ガオカシイト感ジテ居リマシタカラ、其ノ時何トナク気ニナリマシタノデ暫ク経テカラ私モ便所ニ行ッテクルカラト申シテ室外ニ出マシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　道子ノ室ニハ夫ガネテ居ル事ヲ知ッテ居タカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ソノ時ハ何シロ夢中デスカラ詳シクハ考エマセンデシタガ、イキナリハイッテ行ッテネテイル道子ノ咽喉ヲ手デシメル積リデアリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテノ考エ通リニモハヤ仕方ガナイト思ッテ、　「僕ハアナタニハ大変スマナイ事ヲシテ居タンダ、許シテクレ、君ニ謝ラナケレバナラナインダ」　ト云イマスト清三ハ床ノ上ニ起キ上リナガラ、　「何ダ、君ハ大寺君ジャナイカ、今頃人ノ寝室ニハイリコンデ何ヲシヨウトスルンダ」　ト申シマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カネテノ作戦ニ基キ、各艦ハ連絡ヲ失ウコトナク、一挙ニシテ、×船隊ヲ撃滅スベシ」　この命令が旗艦から発せられて間もなく、×の商船隊の先頭にある巡洋艦は、本隊の真上に達しました。",
              "citation": {
                "source": "太平洋雷撃戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして最後に建築物に関しても、松江はその窓と壁と露台とをより美しくながめしむべき大いなる天恵――ヴェネティアをしてヴェネティアたらしむる水を有している。",
              "citation": {
                "source": "松江印象記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は一五三七年ヴェネティアに會合して、將來のヂェズイタ派運動の基礎となるべき盟約を結んだ。",
              "citation": {
                "source": "聖ロヨラ",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャーナリズムでだからイズムであり主義であると思うのも、丁度、マグネティズムを磁石主義と考えるように、滑稽なことだ。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "失恋ノ悩ミニ堪ヘ兼ネテ今月今日此ノ処ニ来レリと、若い男の筆で書いてある。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オネコサン、私ハカゼヲヒイテ、真白ナキモノヲキテネテヰマス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　アル日、人参サンノ所ヘ、人参サント　ジヤガイモサンノオ友達ノ玉ネギサンガ　タヅネテキテ、「ボクモ、コンナニ大キクナツタノデ、トウトウ、アシタノアサ、六ジニ　キシヤデ　マチノイチバヘ行クコトニ　キマツタヨ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレガ　ハジマツタラ　ココヘキテ　ネテヰレバ　イインダ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とふしんに思ひながら、その状箱のやうのやうなものをあけてみますと、　サツキハ、バケソコネテ、ヲカシカツタダロ、コバンハ、カヘシテヤルヨ、コンスケ。",
              "citation": {
                "source": "狐の渡",
                "author": "土田耕平",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは中国人やサンドウィッチ島人ではなく、主としてニューイングランド〔メーン、ニュー・ハンプシア、ヴァーモント、マサチュセッツ、ロード・アイランド、コネティカットの合衆国東北部の六州〕に住んでいると聞く、わたしの書くものを読む諸君に関して、何事かを語りたい。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "空気をつんざく音におどろかされてわたしは本を読んでいる眼をあげて、遠い北の山々で切り出され、グリーン・マウンテンズ地方やコネティカット州を飛び越えて来た大きな松材が、十｜分とかからないうちに矢のようにこの町を飛びすぎるのを見たが、二度目に見たときにはもうほとんど見えなくなってしまった。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は哲学者たちの最後の一人〔アモス・ブロンスン・オールコット（一七九九―一八八三年）を指す〕であり――コネティカット州は彼を世界にあたえた――最初はこの州の物産を行商していたが、後には、彼のいうところによると、自分の頭脳を行商した。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "元微之ハ玉磬ノ声声ニシテ徹シ金鈴ノ箇箇円ナルヲ以テ二ナガラ聯ネテコレヲ称ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
