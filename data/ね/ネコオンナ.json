        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "猫女「あ、あぶない。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしゃ、気が短いからね」「何奴だ、きさまは」「まっくらやみで、目が見える猫女と申す者でござる。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫女のいったように、黄金メダルは空中をゆらゆらと動きだした。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一つは、六天山塞の頭目四馬剣尺の手から猫女の手へ移った。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜなれば、諸君は春木少年のまだ知らない事実――四馬剣尺や猫女のことなどを知っているのだから。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭目が今まで持っていたのは猫女に奪われちまったんだし、さびしいですからねえ。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし頭目の部屋に、頭目が猫女にとられた、扇形の方の半ぺらの写真を持っているなら、それを手に入れたいと思った。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おお、猫女「誰だ、君は！",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしは『猫女』さ。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞよろしく」「えッ、猫女……」机博士のおどろきは、五倍になった。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「猫女が、なぜこんなところに――」「大きな声をおだしでないよ。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「きゅうくつだろうが、手をうしろへまわしてもらいましょう」猫女はおそろしく力強かった。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君は、私をどうしようというんだ」　猫女は、首領から黄金メダルの半ぺらを奪ったことがある。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、猫女は首領の敵だ。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それならば、猫女は自分と手をにぎって、味方同志になってもいいのだと思う。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「猫女よ、なぜ私をいじめるんだ」といいたい、机博士だった。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにがほしいんだ」　机博士が不安なひびきのある声でたずねたのに対し、猫女はこたえなかった。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "室内には、電灯はついていないし、猫女は懐中電灯さえ使わない。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "全くのくらがりの中で猫女は、どしどし自分の仕事をすすめていく。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫女は、猫のように、くらがりの中でも目がきくらしい。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、これなのね、お前さんが鬼の首をとったように思って喜んでいたのは……」　とうとう猫女は、目的物を探しあてたらしく、博士の下着のポケットから、小さいひとまきのフィルムを取出した。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、猫女はそのフィルムを返そうとはしなかった。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからさ、これから神さまのおさばきを受けるように用意をしてあげるよ」　猫女は、へんなことをいった。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん猫女の仕業だった。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫女の手ぎわのよいことはおどろくばかりだった。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから猫女は、机博士の身体に、ロープをぐるぐるまきつけた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前さんのこしらえておいた抜け穴から外へでるのだよ」　なんでも知っている猫女だった。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく彼のところを離れて、向こうでなにかやっていた猫女が、このとき博士のそばへもどってきた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、これから二三秒の間、息をとめているがいいよ」　猫女が、妙なことをいった。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "早いところやってしまうからね」　猫女が机博士の方へ近づいた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
