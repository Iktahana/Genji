          "literary": [
            {
              "text": "誰の目にも、いほが女中はもう根っきり、はっきりやめたのが明になった。",
              "citation": {
                "source": "格子縞の毛布",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで根っきり葉っきり済んでしまう程、現実の階級闘争は単純でない。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "言いたいだけを根っきりしゃべったんだから、さぞききにくいこともあったでしょう。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
