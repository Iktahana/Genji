          "literary": [
            {
              "text": "ネガチヴの気遣いも、骨の折れるものである。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "普段は怠惰なくせに、「浴槽の花嫁」の場合にだけ、異様に敏活巧緻に働くのだから、その点がすでに病的だといえばいえるけれど彼の日常の言動を精査しても、何度専門家が鑑定しても、なんら精神的反応を呈さずに報告はいつもネガチヴだった。",
              "citation": {
                "source": "浴槽の花嫁",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真で云えばネガチヴの方が写っていたのです。",
              "citation": {
                "source": "双生児",
                "author": "――ある死刑囚が教誨師にうちあけた話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが私の場合と同じで、現場の指紋の方がネガチヴだったのです。",
              "citation": {
                "source": "双生児",
                "author": "――ある死刑囚が教誨師にうちあけた話――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
