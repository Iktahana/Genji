          "literary": [
            {
              "text": "ネービー・カットの煙をプウと吹いた切り、軍艦みたいな顎を固定してしまった。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからネービー・カットの煙を私の顔の真正面に吹き付けた。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "船長が他所事のようにネービー・カットの煙を吹いた。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "専売新聞はネービーカット軍をもつ有名な野球新聞だ。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなた、専売新聞のネービーカット軍に移籍しなさい。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ネービーカットへ移籍するのよ。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "粋なネイビイキヤツプを斜めに被つた彼は上甲板の一隅で手風琴を抱えて上眼をつかつてゐた。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
