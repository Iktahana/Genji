        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "モシ、者裏ニ向ッテ、一隻眼ヲ著得セバ、スナワチ、前百丈（野狐ノコト）風流五百生ヲカチ得タルヲ知リ得ン。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "天ノ命、二十世紀ノ第一年ヲ以テ此ノ法案ヲ起草セシメタルヲ拜謝ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ動カスベカラザル原理ハ、都市ノ住宅地ト異ナリテ農業者ノ土地ハ資本ト等シク其經濟生活ノ基本タルヲ以テ、資本ガ限度以内ニ於テ各人ノ所有權ヲ認メラルル如ク、土地亦其限度内ニ於テ確實ナル所有權ヲ設定サルルコトハ國民的人權ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ最モ急進的ナル羅馬字採用ヲ決行スルトキ、幾分文字ノ不便ハ免ルベキモ言語ノ組織其者ガ思想ノ配列表現ニ於テ悉ク心理的法則ニ背反セルコトハ、英語ヲ譯シ漢文ヲ讀ムニ凡テ日本文ガ顛倒シテ配列セラレタルヲ發見スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "體育ヲ丹田本位ト決定スル所以ハ、只肉體ノ一面ノミヲ見ルモ根本的體育タルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其不合理ナルコト恰モ現時ノ歐米ニ「キモノ」服ガ普及シタルヲ以テ其レヲ室内ノ制服トシテ強制セント云フト一般ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "露西亞ノ脅威ガ「ツアール」ノ亡ビタルヲ以テ去レリト考フル如キハ齒牙ニ足ラザル淺慮。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "數百年間ノ半亡國史ハ實ニ朝鮮人ノ道念ヲモ生活ヲモ腐敗シ盡シタルヲ以テ、眞ノ國家的覺醒アル鮮人ハ之ヲ現在新精神ニヨリテ教育セラレツツアル人々ノ生長ニ待ツノ外ナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人ト五人ト角力シテ已ニ三人ヲ倒シタル者ガ他ノ二人ヨリ足ヲ奪ハレタルヲ見テ其ノ人ヲ弱者ナリト云フ能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "開戰當初ヨリ露ノ陸軍ト英ノ海軍トヲ兩分シ得ベキ日本一國ノ向背實ニ世界大戰ノ勝敗ヲ決シタルヲ見ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ隣室ニ監禁セラレタル予ノ案内人ノ室ノ更ニ隣室ニシテ、同様物置ナル所ヘ一時｜抛ゲ入レラレタルヲ知リタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々ニシテ其ノ好ム所ハ異ナレドモ、書画鼎鐺偶像貨幣ノ類、其ノ質ノ金石木磁絹紙タルヲ問ハズ、古物ホド面白キモノハ有ラジ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "一國之魁帥也トハ、筑紫國ノ中ニテ、一地ノ酋長タルヲ云フ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是乎千六百十一年、彼等ハ相図リテ移住ノ儀ヲ定メ、永ク英人タルヲ得、且ツ基督教団ノ基礎ヲ据ヱ得ル処ヲ求メタリケルニ、あめりかハ洵ニ能ク此等ノ目的ニ副フモノナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ、コノ信念ハ外ニ於テハ国家ニ不忠、内ニ於テハ国教ニ不信ナリトノ理由ヲ以テ、彼等ハ自国ニ住ムコトヲ極度ニ圧迫セラレタルヲ以テ、故国ヲ逃レテ和蘭ノ地ニ来リ、更ニ北米ノ天地ヲ求メタルモノナリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "苛刻ノ法令ヲ出ス毎ニ、余輩、言ヲ卑フシ謹テ願訴シタレドモ嘗テ之ヲ聴カズ、随テ願訴スレバ随テ之ニ報ユルニ惨毒ヲ以テシ、一令出ル毎ニ其暴政タルヲ証スルニ足レリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "（８）原文ニハ「自云」トノミアリテ、何人ノ言タルヲ明言セザレドモ、家ノ主人ノ語ト見ルベキヲ以テ「あるじ」ヲ加ヘタリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ聖人賢人ノ智ト雖ドモ、其元行ハ云々ノ源因ニハ云々ノ結果アリト云フコトニテ、之ヲ澤山ニ知リ、且又之ヲ結構組織シテ事ノ全體ニ渉リ、細大トモ一聯絡タルヲ知ルニ外ナラズ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ猶｜有縁ノ地タルヲモツテ、吉原回禄ノ災ニ罹ル毎ニ、権ク爰ニ仮肆ヲ設ケテ一時ノ栄ヲ取ルコト也最数回ナリ。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余｜已ニ沈酣シテ何ノ語タルヲ弁ゼズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "乃チ左右ニイツテ曰クコノ編一タビ出デンカ、海内ノ学者模楷規矩ヲ得テ、ワガ江戸ノ文章ノ淵藪タルヲ知ラン。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "始メテ母氏本月十九日ヲ以テ没シタルヲ知ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊ニ※然タルヲ覚ユ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "家事｜纒擾タルヲ以テ果サズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見シテ旧幕府ノ逸民タルヲ知ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳沢峠の頂上から北正面に見えるのが此山で、『甲斐国志』雁坂の条に西ノ方ハ西沢御林山、南ノ方ハ袴腰ト云、山形ノ似タルヲ以テ名トス。",
              "citation": {
                "source": "秩父の奥山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "草木ヲ分ケ嶮岨ヲ渉ルニ方位ヲ失シ、竟ニ何ノ渓タルヲ知ル能ハズ。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "といえる俗伝を古蹟の都留郡の部に掲げているが、尚お「残簡風土記」の細註に郡留或は連葛とあるに拘泥して、連葛ハ藤蔓ノ如シ、富士山ノ尾サキ長ク連リタルヲ云、皆つるト訓スヘシ。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
