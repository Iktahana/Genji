        "examples": {
          "standard": [
            {
              "text": "兄は運動神経において、弟よりも一段と立ち勝っているようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼の技術は、同年代の誰よりも明らかに立ち勝っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "数ある作品の中でも、この一枚は表現力において他を圧倒して立ち勝っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "現にフォード会社の横浜における組立工場で、日本人の働きは、米国における同じ組立工場に比して、一割方も立ち勝ると聞いている。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "就業時間は百貨店と同様でありますが、販売員一人当りの能率は、著名な百貨店のそれよりも立ち勝ることとなりました。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "早速口を開けてみますと実に美事なもので、味もまた申し分なく、今日世界一の称ある北米産の桃に較べて、かえって立ち勝るくらいでありました。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　堅く膝を合せ、足のうらにお尻を乘せてゐたのが胡坐になると、一層酒の味がたちまさるのであつた。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに近隣の平均に少し立ち優るくらいがその場所には最も多く客を引く程度である。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "その迦陵頻伽の声よりも尚お、一段と立ち優る美しさだったのです。",
              "citation": {
                "source": "法悦クラブ",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
