[
  {
    "uuid": "c9ceb0e6-65c0-5a7a-8eda-88b3e0878cfa",
    "entry": "尋ねる",
    "reading": {
      "primary": "たずねる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
        "動詞-他動詞"
      ],
