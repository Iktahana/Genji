        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "紛失したスマートフォンを尋ねて、今日歩いた道を逆戻りしてみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歴史の謎を尋ねて、各地の古墳や遺跡を調査して回っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "家出した弟の行方を尋ねて、友人の家を一軒ずつ回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
