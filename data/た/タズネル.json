    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　とこんどは、お母さまのほうでたずねる。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と私がたずねると、「だって、お願いしていたのだもの」　と、とてもたまらなく淋しそうに笑っておっしゃった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、実に心配そうな、緊張のお声でたずねる。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関の戸が内からあいて、細おもての古風な匂いのする、私より三つ四つ年上のような女のひとが、玄関の暗闇の中でちらと笑い、「どちらさまでしょうか」　とたずねるその言葉の調子には、なんの悪意も警戒も無かった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と僕に向ってたずねるのである。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と少しも笑わずに僕にたずねる。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しからば、たずねる。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おのれの作品のよしあしをひとにたずねることに就いて　自分の作品のよしあしは自分が最もよく知っている。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "」無心にたずねるＫの眼は、湖水のように澄んでいる。",
              "citation": {
                "source": "秋風記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたはまだごぞんじないかも知れないが明後日、馬場と僕と、それから馬場が音楽学校の或る先輩に紹介されて識った太宰治とかいうわかい作家と、三人であなたの下宿をたずねることになっているのですよ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者は開けたばかりの慰問袋や、その中味や、子供の手紙にどんなことが書いてあるか、そういうことをたずねるのだった。",
              "citation": {
                "source": "前哨",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然パーシの夜の鶏が戸外で鳴き出すと、アダはいらいらして、その他に別に用事はないかと私にたずねる。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……が、私は今それをたずねるのではなかった。",
              "citation": {
                "source": "小春の狐",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしその丘をつくる黒土をたずねるならば、それは緑青か瑠璃であったにちがいありません。",
              "citation": {
                "source": "虹の絵具皿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてこの光の底のしずかな林の向こうから二人をたずねるけらいたちの声が聞こえて参りました。",
              "citation": {
                "source": "虹の絵具皿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども私にこの手紙を云いつけたひとが云っていました「チュンセはポーセをたずねることはむだだ。",
              "citation": {
                "source": "手紙　四",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さァおまえはチュンセやポーセやみんなのために、ポーセをたずねる手紙を出すがいい。",
              "citation": {
                "source": "手紙　四",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぼくはいちばんはじめにあんずの王様のお城をたずねるよ。",
              "citation": {
                "source": "いちょうの実",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑司ヶ谷へゆき着いて、大久保式部の下屋敷をたずねると、さすがは千石取りの隠居所だけに屋敷はなかなか手広そうな構えで、前には小さい溝川が流れていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒屋の裏へはいって、格子の外からおみよの家の様子を一応うかがって、それから家主の酒屋をたずねると、御用で来た人だと聞いて、帳場にいた家主も形をあらためた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちっとばかりの土産物を持って半七老人の家をたずねると、老人は湯から今帰ったところだと云って、縁側の蒲莚のうえに大あぐらで団扇をばさばさ遣っていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "半七はそれから小梅の知己をたずねて、夕七ツ（午後四時）を過ぎた頃に再び庄太の家をたずねると、となりの葬式の時刻はもう近づいて露路のなかは混雑していた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鬼娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "半七はそれを考えながら、熊野権現の社のあたりをひと廻りして、実相寺門前の文字吉の家をたずねると、五十六七の雇い婆らしい女が出て来て、三角な眼をひからせながら無愛想に答えた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "唐人飴",
                "note": "青空文庫"
              }
            },
            {
              "text": "峠を越すのかと女中がたずねると、「峠を越せば、遠く信州を猿飛様にやがて近江（会う）路、日の暮れぬうちに越そうと思います」　という気取った言い方は、大方佐助の感化であろう、それは楓であった。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　先達は怪訝な顔して、「されば、……ところで、その婆さんはどうしましたな、坂下に立ったのを御覧になった時は、傍についていたというお話続きの、」　とかえってたずねる。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "付近の農家でたずねると、その田は山岸巳代蔵なる人物のものであるという。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜそんなに安売りするのかとたずねると、キルドールは「そうすればもっとたくさんの人がＣＰ／Ｍを使うようになるから」と答えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もちろん、まったくできないという話じゃありませんよね」　浜田から打診を受けた情報処理事業グループのソフト開発のベテランは、そう答えてから面を上げ、たずねるような視線を浜田に投げた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "生徒たちを前に講演を終えたあと、「実際にプログラミングを学んでみたいか」とたずねると、三二人の聴衆の全員が手を挙げた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とたずねると、「マイクロソフトが作ったもので、もうすぐ発表になる」のだという。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
