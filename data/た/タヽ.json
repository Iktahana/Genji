        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鏝で勢いよくきゅうとなでて、ちりちりぱっとくくりをつけて、パイプをくわえて考え込んで、モンパリー、チッペラリー、ラタヽパン。",
              "citation": {
                "source": "二科狂想行進曲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォアラ、ネスパ、セッサ、ムシュー、アラマディ、プレンプアン、ラタヽパン。",
              "citation": {
                "source": "二科狂想行進曲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドタヽヽヽバタ／＼ヽヽヽアー。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "笠からも蓆からも流れ出る水がタヽキの上に太い線を描いて其先が少し曲り／＼勢よく先へ行く。",
              "citation": {
                "source": "松蟲草",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゴノ　中ノ　サムライガ　ナンダラウト　オモツテルト、コンドハ、「タヽキコロサウカ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イツテ　クツヲ　タヽイテルノヲ　ミルト　ヤツパリ　カナヅチデス。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまでの彼は見習からタヽキ上げられた、女工の尻を追ったり、白首を買ったり、女の話しかしない金属工でしかなかった。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しそうだとすれば、それは一応労働運動や社会運動やマルクスの経済学を先ず理解させて、然る後組織し、闘争するというあの有名な、陳腐な、そして何時でもシタヽカの失敗と精力の濫費を重ねて来たようなやり方でなしに、――今、その地の労働者は、資本家に対して如何なる不平を持っているか。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "積つた雪を凍つた土の上に集めて、それを下駄の齒でこするうちには、白いタヽキのやうな路が出來上ります。",
              "citation": {
                "source": "ふるさと",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "奧座敷の縁先にはタヽキの池が有りました。",
              "citation": {
                "source": "幼き日",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂の中途の瓢箪屋で、カタヽヽ、カタヽヽと瓢箪の種子を抜いてゐる音が、霜夜の空にでも響くやうに高く冴えて、一層四方の静けさを増してゐた。",
              "citation": {
                "source": "乳の匂ひ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此外に、イヨヽヽ・ウタヽが出てゐる。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "此序に近い行を見ると、輒輒にもタチマチ・スナハチ・ホシイマヽなどある中に、こゝにもウタヽと言ふ註が交つてゐる。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "色葉字類抄には、転にウタヽと訓じた次に、云重詞也とあつて、後は解し難い数字がある。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすれば、此もイヨヽヽ・ウタヽと訓じてよい訣だ。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其にも、転ウタヽテン、とある。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへば、イヨヽヽ・マスヽヽを、ウタヽと言ふ日本語で、其を訳し分けて訓をつけると、全く別の用語例にあるものと見える。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが実は、ウタヽとイヨヽヽとの間には、其ほどの区別はないのである。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も同時にウタヽと訓むだけの内容を持つてゐる事も知れる。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "即、ウタヽとイヨヽヽとがある時期には、一つの意義をめぐる隣接語だつたのである。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして、ウタヽ以外に、あつた形のことなどは忘られてしまつた。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "菟楯（イ）・宇多手（ロ）・得田｜直（ハ）・得田｜価（ニ）・宇多弖（ホ）とあつて、ウタヽと訓まぬ方が正しい。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "後にウタヽと訓まれる字が、ウタテアリに宛てられる理由はあるやうだが、まだしも逆に読み上げて「あしきわざうたてやまず」と改めた方がよい。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "また玄関前のタヽキの上には、下宿の大きな土佐犬が手脚を伸して寝そべっていた。",
              "citation": {
                "source": "子をつれて",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "また玄關前のタヽキの上には、下宿の大きな土佐犬が手脚を伸して寢そべつてゐた。",
              "citation": {
                "source": "子をつれて",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　吐き出すやうな乱暴な口調でさう云ふと日和下駄の歯をタヽキにきしませながら後もふり向かずに荒々しく出て行つた。",
              "citation": {
                "source": "監獄挿話　面会人控所",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而してタヽキは出来て居なかったが、丁度彼の誕生日の十月二十五日に浴室の使用初をして、「日々新」と父が其板壁に書いてくれた。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小指の頭程の青き果ヒシと生れるを、小鳥は上よりつゝき、何処も変わらぬ村の子供等下よりタヽき落して食ふ。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "厳密之間宿ニ召取置金タヽキ、自衆中召返了。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
