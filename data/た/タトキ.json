          "literary": [
            {
              "text": "」「イイヤ、生レタトキハ良カツタ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「イイヤ、生レタトキハ良カッタ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ父ッチャハ半トシモネテ、ウチノ中ニ何ンニモナクナッタトキニ死ンダノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モシオ前ガ何カ他人ノ物ヲコワシタトキニハ、オ前ハドウシナケレバナランカ？",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒点ガ見エ、強イ光デ網膜ガヤケタトキノ感ジガアリ、且ツチラチラト電線ノ雑音ミタイナモノガ盛ンニ動クノデアル。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ昨年ノ暮空襲デクライ外ヘ出タトキ、左ノ眼ガイヤニ暗イ感ジガシタシ、マタ室ニイテモ変デ、左ノマツ毛に目ヤニデモツイテイルノデハナイカト気ニシタ事ガアッタガ、ソノコロカラ悪カッタラシイ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚人々ノ話ヲ綜合スルト田中町小學校ニ旋風ガ發シタト云ハレ、又今戸公園ニ旋風ガ襲ツタトキ待乳山邊迄大イニ荒レタサウデアル。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ、自分の原子ガ別ノモノニナッタトキ、自覚シナイカラツマラナイ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ユウガタ　ヒガ　シヅミサウニ　ナツタトキ　ジヨンハ　チビスケニ　ノハラヘ　サンポニ　ユカウト　イヒマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサ　ミタトキヨリモ、モツト　モツト　カゲハ　オホキク　ナツテヰタノデス。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
