        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "久慈はもうこの夜は真紀子と別れていることの出来ぬ、最後の夜になるだろうと覚悟を決めていたので、夕食のコーヒーになったとき一同に、「どうだね、今夜はこれからみなでタバランへ行こうか。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "タバランというのはパリでは一頭地を抜いて優秀な踊場を兼ねたレビュー館である。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "タバランへ一同の着いたときは九時を少し廻っていた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンマルトルの舞踏場バルタバランなどは、とてもとても、日本から遠めがねででも覗かねばわからないもんだ。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルタバラン、オリンピアなどへ二三べん見に出かけた。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "名高い遊楽の街だけにタバランとかムウラン・ルウジユとか云ふ有名な踊場を初め、贅沢な飲食店や酒場や喫茶店が多い。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今では其部屋に踊場タバランへ出る西班牙の姉妹の踊子が住んで居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
