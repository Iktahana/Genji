        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "諸君ハ、日本居留民ノ生命ヲ保護スルタメニ来タノデアルカ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "居留民ノ財産ヲ守ルタメニ来タノデアルカ？",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ガ関係シタ霊魂第十号モ、カカル雑音ノ中カラ姿ヲ現ワシタノデアル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ハカク信ジテコレヲ行動ニ移シタノデアル。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘弥ノ助六デハ物足リナイガ、訥升ガ揚巻ヲスルト云ウノデ、ソレガドンナニ美シイカト思イ、助六ヨリモ揚巻ノ方ニ惹カレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾ技巧ヲ以テソレヲ感知セシメナカッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ予ガアマリ痛ガルノデ、兎モ角モト佐々木看護婦ガ心配シテ電話シタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ノ意見デ、整形外科ノ方ヘ行ッテ見テ貰ッタラト云ウノデ、先日虎ノ門病院デレントゲンヲ撮ッタノデアルガ、頸椎ノ辺ニ曇リガアルシ、手ノ痛ミガソンナニ激シイノナラ、事ニ依ルト癌カモ知レナイト嚇カサレテ、頸椎ノ断層写真迄モ撮ラセタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ウコトガ出来ルノデ予ハ今日マデ生キテ来ラレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ専ラ颯子ノ註文ニ依ッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ偶然ニソウナッタノデアルガ、午後ノ六時ニ今夜ハオ暇ヲ戴キマスト云ッテ、佐々木ガ子供ノ所ヘ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハソレヨリモ、春久ト颯子トガドンナ工合ニ接触スルカ、ソノ様子ガ見タカッタノデアルガ、団欒ノ中ニ加ワッテカラ三四十分モシタ時分、次第ニ脚カラ腰ノ周リガ冷エテ来ルノニ心ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻トシテ家庭ニ入レテ見ルト、案外ニモソウ云ウ才能ヲ発揮シ始メタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "麻布ノ家ヲ新築シタト云ッタガ、タシカ明治年間政友会ノ長谷場純孝ノ邸宅ガアッタ辺ダトカ云イ、前カラ古イ屋敷ガ建ッテイタノデ、ソノ一部ヲ残シテ大部分ヲ改築シタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ蟋蟀ト聞イタノハ蟋蟀デハナク、予自身ノ呼吸音ダッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ト浄吉トノ結婚ヲ、予ノ妻デサエアンナニ激シク反対シタノデアルカラ、アノ時分マデ母ガ長生キシテイタラ、ドンナニ反対シタコトデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分ソノタメニ和服ヲ着、ソレヲ見セルベク予ノ面前ニ現ワレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日デナクテモヨカッタノダガ、犬ノ事件ヲ早速佐々木ガ知ラセタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "引キ続キ手ノ痛ミ去ラズ、痛ミハ小指ト薬指トガ最モ激シク、親指ノ方ヘ行クホド軽カッタノデアルガ、漸次五本ノ指全体ニ及ビツヽアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ情ナイ姿ノトコロヲ彼女ニ見ラレテハ極マリガ悪イ、ト、思ッタ途端ニコノ言葉ガ出タノデアルガ、正直ヲ云ウト来テ貰イタクナイコトモナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ自分ノ女房ハ踊リ子上リダト云ウ負ケ目ガアルタメニ、自然ソウナッタノデアルガ、ソレガ一層「若奥様」ヲ増長サセル結果ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワア、ワア、ワア、―――予ハ芝居ヲシテルンジャナイ、「颯チャン」ト叫ンダ拍子ニ俄ニ自分ガ腕白盛リノ駄々ッ子ニ返ッテ止メドモナク泣キ喚キ出シ、制シヨウトシテモ制シキレナクナッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ予ガ豫メ左様ニ注文シテ置イタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ今度ノ京都行ヲカネテカラ楽シミニシテイタガ、京都滞在中ニ一日オ暇ヲ戴イテ奈良見物ヲサセテクレト云ッテイタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト云ウノハ、五子モ暫ク奈良ヘ行ッタコトガナイノデ、コノ機会ニ行ッタラドウカト予ガ勧メタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテ奈良ノ寺々グライハ見テ置イタ方ガイヽシ、殊ニ今度ハ予ノ菩提所ヲ定メルニツイテモ、必ズ参考ニナルコトガアロウ、ト、ソウ云ッテヤッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈図ランヤ彼女ハソノ頃ハイヤヲ走ラシテ伊丹ニ向ッテイタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ僕ノ嫉妬カラソンナ風ニ気ガ廻ルノカト思ッテ、ソノ考エヲ努メテ打チ消シテイタノデアルガ、ヤハリソウデハナサソウデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ結婚後始メテ、自分ノ妻ノ全裸体ヲ、ソノ全身像ノ姿ニオイテ見タノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガ睡ル真似ヲスルノニ都合ガヨカロウト思ッテ飲マシテヤッタノデアル）　彼女ガ睡リ込ンダ（モシクハ睡リ込ンダ風ヲシタ）ノヲ見定メテカラ、僕ハ最後ノ目的ヲ果タス行動ヲ開始シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
