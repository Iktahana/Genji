        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "また近頃タンタラムという金属の線を代用したのがぼつぼつ用いられる、この針金を糸枠のようなものに巻きつけてある。",
              "citation": {
                "source": "ランプのいろいろ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔しタンタラスと云う人があった。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンタラスは咽喉が渇く。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンタラスは腹が減る。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンタラスの口が一尺動くと向うでも一尺動く。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "三尺四尺は愚か、千里を行き尽しても、タンタラスは腹が減り通しで、咽喉が渇き続けである。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "――未来の管を覗くたびに、小野さんは、何だかタンタラスの子分のような気がする。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨樋がタンタンタラ・タラタラ鳴っている。",
              "citation": {
                "source": "夏遠き山",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンタラスに淡い二重の虹が見えた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
