          "literary": [
            {
              "text": "若い少佐　タッギングが終ると我々は別の建物に移された。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "またしても道草をくったが、ラロのは本当の仮収容所で、タッギングの終った者は次々にトラックで出て行き日本側としては、病院関係者と、通訳と、Ｔ中尉を指揮者とする十数名の使役兵とが、常住することになった。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラロでの僕の仕事は主としてタッギングであった。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "簡単なタッギングだから直ぐ終り、ジープで送って貰ってラロに帰った。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
