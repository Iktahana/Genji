    "definitions": [
      {
        "index": 1,
        "gloss": "great (quantity, amount, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "多大な努力が必要なプロジェクト。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "多大な費用をかけて完成させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "多大な時間を投資することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "仮りに科学的に信憑すべき根拠よりして、来る六十年ないし七十年間に某火山系に活動を予期し得るとせば、個人に対してはともかく、一県一道の為政者にとりては多大の参考となるべし。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　以上述べたる所に基づき、また現在科学の進歩程度に鑑みて天気予報と地震予報とを対照すれば、その間の多大の差異あるを認めざるを得ず。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "液体静力学の実験例えば浮秤で水や固体の比重を測る時でも、毛管現象が如何に多大の影響を有するかという事を見せるために、液面に石鹸の片を触れて比重系の浮上がる様を見せる事なども必要と思う。",
              "citation": {
                "source": "物理学実験の教授について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二次第三次と進むには多大の努力と時日とを要する事は云うまでもない。",
              "citation": {
                "source": "物理学の応用について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうわけで盲人や聾者の心理というものに多大な興味を感ずるようになった。",
              "citation": {
                "source": "鸚鵡のイズム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ筆法で行けば弘安四年六月三十日から七月一日へかけて玄界灘を通過した低気圧は我邦の存亡に多大の影響があったのである。",
              "citation": {
                "source": "戦争と気象学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、いわゆる科学的常識というものからくる漠然とした概念的の推算をしてみただけでも、それが如何に多大な分量を要するだろうかという想像ぐらいはつくだろうと思われる。",
              "citation": {
                "source": "流言蜚語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に非常に長い時間と多大な費用を節約し得られるのである。",
              "citation": {
                "source": "教育映画について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある人は面目を一新したと云って多大の希望をかけたようであり、またある人は別段の変りもないと云って落着いていた。",
              "citation": {
                "source": "帝展を見ざるの記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十人の研究の中でただの一つでも有利な結果が飛び出せば、それから得られる利益で、学者の五十人くらい一生飼い殺しにしても、なお多大の収益があるからとのことであった。",
              "citation": {
                "source": "学問の自由",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その際もしも、その研究員が、更に進んでその欠点を除去し、その商品を完成するように研究の歩を進めるならば結構であるが、そうでなくて、その欠点を委細構わず天下に発表して、その結果その会社に多大な損失をかけ、事によるとその会社の存在を危うくするような心配が生じたとする。",
              "citation": {
                "source": "学問の自由",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "商賣人の中でも、腕利きと云はれてゐる半七がこの事件をどんな風に扱ふかと、をぢさんは多大の興味を持つて明日を待つことにした。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、何分、事態急迫し、躊躇すれば、暴兵の乱射のため、多大の損害を受けざるを得ぬので、Ｎ大尉は一部隊を以てこれを駆逐せしめた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "実験室における割れ目の問題が地殻に適用されるとなると、そこには地質学や地震学の方面に多大な応用範囲が見いだされる。",
              "citation": {
                "source": "自然界の縞模様",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このように時を空間化して取り扱ったために得られる便利は多大なものであるが、しかし人間の直感する「時」の全部はｔの符号に含まれていない。",
              "citation": {
                "source": "時の観念とエントロピーならびにプロバビリティ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニュース映画はこの意味において人間の頭脳の啓発に多大な役目をつとめるものでなければならない。",
              "citation": {
                "source": "ニュース映画と新聞記事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一つには東京市民が明治以来のいわゆる文明開化中毒のために徳川時代に多大の犠牲を払って修得した火事教育をきれいに忘れてしまって、消防の事は警察の手にさえ任せておけばそれで永久に安心であると思い込み、警察のほうでもまたそうとばかり信じ切っていたために市民の手からその防火の能力を没収してしまった。",
              "citation": {
                "source": "函館の大火について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカでは都市の大火はなくても森林火災が頻繁でその損害も多大である。",
              "citation": {
                "source": "函館の大火について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "書物のなかったあるいは少なかった時代の人間のほうがはるかに利口であったような気もするが、これは疑問として保留するとして、書物の珍しかった時代の人間が書物によって得られた幸福の分量なり強度なりが現代のわれわれのそれよりも多大であったことは確かであろう。",
              "citation": {
                "source": "読書の今昔",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでこの上に多大の苦心をしていわゆる立体映画がようやく成功したとしても、その効能はおそらくそう顕著なものではあるまいという気がする。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本髪用の鼈甲を扱って来た室子の店は、このとき多大の影響を受けた。",
              "citation": {
                "source": "娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "願くは何か峻烈なる刺激を与え、鞭撻激励して彼等を努力せしめたならば、日本の生産力もまた必ず多大の増加を見る事は疑いを容れまい。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "學士は、生物……と謂ツても、上は人間から下は蚯蚓の類まで、都ての動物に多大の興味を持ツて研究してゐる。",
              "citation": {
                "source": "解剖室",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "また活きてゐる間｜溌溂たる意氣に日毎酒を被ツて喧嘩を賣いて多大の希望と抱負とを持ツて空しく路傍に悲慘なる人間の末路を見せた青年もあツたであらう。",
              "citation": {
                "source": "解剖室",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "多大の興味ばかりか、其興味に伴う利益をも受けながら、楽しく読み了ったのです。",
              "citation": {
                "source": "木下杢太郎著『唐草表紙』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから長々しく敍景の筆を弄したものよりも、漢語や俳句などで、一寸一句にその中心點をつまんで書いたものに、多大の聯想をふくんだ、韻致の多いものがあるといふのは、畢竟こゝの消息だらうとおもふ。",
              "citation": {
                "source": "「自然を寫す文章」",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は独逸によつて今日迄｜鼓吹された軍国的精神が、其敵国たる英仏に多大の影響を与へた事を優に認めると同時に、此時代錯誤的精神が、自由と平和を愛する彼等に斯く多大の影響を与へた事を悲しむものである。",
              "citation": {
                "source": "点頭録",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ちょうどそのとき、ラジオのニュースで、きょうも我が荒鷲が敵の○○飛行場を猛爆して多大の戦果を収めたことを報じた。",
              "citation": {
                "source": "ごんごろ鐘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただいま友人、大隅忠太郎君から、結納ならびに華燭の典の次第に就き電報を以て至急の依頼を受けましたが、ただちに貴門を訪れ御相談申上げたく、ついては御都合よろしき日時、ならびに貴門に至る道筋の略図などをお示し下さらば幸甚に存じます、と私も異様に緊張して書き送ってやったのである。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎朝いただいて居る東奧日報に據れば、私の兄は、いま、縣會に於いてたいへん割のわるい役をして居るやうである、私、いま、兄上に叱咤されるのを覺悟のうへで申してゐるのであるが、勘平役者が黒衣にまはつたやうで氣持がよくない。",
              "citation": {
                "source": "人物に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
