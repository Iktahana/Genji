  {
    "uuid": "73d487c8-db41-5768-80d2-4a59f6134371",
    "entry": "対称性",
    "reading": {
      "primary": "たいしょうせい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
