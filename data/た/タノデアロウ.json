        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今日ハ京都ノ花ノ先生ガ来タノデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ颯子ガコノ老人ノタメニ心ヅクシヲ示シタノデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅ト白トノコノ対照ヲ五子ノ前デ見セビラカスノガ目的ダッタノデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長崎人ノ木村モハナイノダガ、今日ハ始メカラ晩ノ食事ヲトモニスル底意ガアッタノデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "知ッテイルトスレバ、ソレハ以心伝心デアロウカ、アルイハ郁子カラ暗示サレタノデアロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ワレテ僕ハ直チニ一ツノ着想ヲ思イツイタガ、シカシ、僕ニソウイウ機械ノアルヲ、ドウシテ木村ハ察シタノデアロウカ、ソレガ不思議ダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕ニソウイウ機械ノアルヲ、ドウシテ木村ハ察シタノデアロウカ、ソレガ不思議ダ」と云っているが、それは私にも不思議であった。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
