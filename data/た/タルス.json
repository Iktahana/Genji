        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "先下女はマタルスの女かと見えて鼠色也。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "５　Niobe ――ギリシア神話のタンタルスの女、テーベ王アンフィオンの妻。",
              "citation": {
                "source": "しめしあわせ",
                "author": "THE ASSIGNATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴局ノ送受信機ハ何処ヨリ手ニ入レタルヤ」相手「予ガ携帯シ来リタルスーパーヘテロダインハ没収セラレタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一例を挙げるとブラツクウツドなどには、エレメンタルスと云ふやつが、時々小説の中へ飛び出して来る。",
              "citation": {
                "source": "近頃の幽霊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "エレメンタルスの名は元よりあつたでせうが、その活動が小説に現れ出したのは、近頃の事に違ひありますまい。",
              "citation": {
                "source": "近頃の幽霊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラツクウツドの「柳」と云ふ小説を読むと、ダニウブ河へボオト旅行に出かけた二人の青年が、河の中の洲に茂つてゐる柳のエレメンタルスに悩まされる。",
              "citation": {
                "source": "近頃の幽霊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "――エレメンタルスの描写は兎も角も、夜営の所は器用に書いてあります。",
              "citation": {
                "source": "近頃の幽霊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イライラする、――tantalizing――Tantalus――Inferno……」　タンタルスは実際硝子戸越しに果物を眺めた僕自身だつた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イライラする、――tantalizing――Tantalus――Inferno……」　タンタルスは実際硝子戸越しに果物を眺めた僕自身だった。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "タタルスカヤで粉雪ふる。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはタンタルスの苦痛に似ていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "一個の母親に適用されたタンタルス（訳者注　永久の飢渇に処刑せられたるギリシャ神話中の人物）の処刑を、あなたは何と言われますか。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、タンタルス（訳者注　永久の飢渇に処せられし神話中の人物）のように彼らが望んでいた二つのことがある。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、過去と呼ばるる大海の底に、世紀と呼ばるる大波のかなたに、すべての暗黒の口から出る恐るべき息吹のために、バビロン、ニニベ、タルス、テーベ、ローマ、などの巨船が沈みゆくのを見ては、我々は自ら一種の戦慄を禁じ得ない。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
