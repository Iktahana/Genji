[
  {
    "uuid": "e3ae3d50-1f12-5724-842a-1a3f7c0f8992",
    "entry": "沢山",
    "reading": {
      "primary": "たくさん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-の形容詞",
        "形容動詞",
