    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ト屋根ヤブレルホドノ大｜喝采、ソレモ一瞬ノチニハ跡ナク消エル喝采、ソレガ、ホシクテ、ホシクテ、一万円、二万円、モットタクサン投資シタ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ツボミガ　タクサン　ツイテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デキアガツタ　クワガ　タクサン　ヘイタイノヤウニ　ナランデ　ヰマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヌスビトト　コヒツヂ新美南吉　ヤワラカイ　クサガ　ミドリノ　モウフノヤウニ　ハヱテ　ヰル　ヒロツパニ　タクサンノ　ヒツジガ　メイメイト　ナキナガラ　アソンデ　ヰマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キイテ　ヰタ　トシヨリハ　フカイ　タメイキヲ　ツイテ、「センサウハ　モウ　タクサンデス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テフテフハ　タクサンノ　フウセンノ　ウチ、イチバン　チヒサイ　アカイ　フウセンダマト、タイヘン　ナカヨシデシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシキハソコノ人ガタクサンアツマッテ、ドウニカヤッテクレルコトニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "漢字ノ活字ガ楷書一ツデタクサンデアルヨウニ、カナノ活字モカタカナ一種類デタクサンデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（タクサンオイワイシテチョウダイナ）戸籍抄本が是非要るのですから、お手数ながら何卒四月の九日までにお送り下さるやうに願上ます。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "コイヌ村山籌子マアイツタイドコカラコンナニタクサンヤツテキタノカシラ。",
              "citation": {
                "source": "コイヌ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアイツタイドコカラコンナニタクサンヤツテキタノカシラ。",
              "citation": {
                "source": "コイヌ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "バカながら、自分のバカを感じることは、もう、タクサンという気持ですな。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのキモノはまだタクサンあるじゃないの。",
              "citation": {
                "source": "遺恨",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけでタクサンだ。",
              "citation": {
                "source": "決闘",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕がお定さんに、なんべん恋をしましたか、と云つたら、たつた一度なんです、それがあの人なんです、三十二で恋なんて、をかしいかも知れないけど、でも一度も恋をしないで死ぬ人だつてタクサンゐるんでせう、と訴へるやうに僕を見た。",
              "citation": {
                "source": "阿部定さんの印象",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "思へば気の毒な人なんであるが、又、お定さんの言ふ通り、でも恋を知らないで死ぬ人だつてタクサンあるんでせう、といふ。",
              "citation": {
                "source": "阿部定さんの印象",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手の山々には小さい入口がタクサンあらア。",
              "citation": {
                "source": "決戦川中島　上杉謙信の巻",
                "author": "――越後守安吾将軍の奮戦記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前、土器のカケラみたいなもの、拾って喜んでいたくせに」「見よう見マネでいくらか興味を持ったことがあるだけだよ」「それだけあればタクサンですよ。",
              "citation": {
                "source": "発掘した美女",
