    "definitions": [
      {
        "index": 1,
        "gloss": "bitterling (any fish of subfamily Acheilognathinae, esp. species Acheilognathus melanogaster)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "淡水魚の鱮を採取して塩漬けにした",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この川に生息する鱮が今年は豊漁だという",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "鱮は東アジアで一般的な食用魚として知られている",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "冬の夜釣りがそもそも時はずれ、ましてやタナゴ釣りは陽のあるうちのもの、いか程横紙破りの御好きな御殿様でござりましょうとも、釣れる筈のない時に釣れる道理はござりませぬ」「わははは。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だのに、釣れぬと知りつつ、こんな冬ざれの寒風をおかしながら、わざわざ夜釣りにやって来たのは、タナゴ釣りの豪奢極まりない清興に心惹かれたからでした。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな感情と感覚で、私もこの秋はマルタに凝り、沖タナゴに凝り、近くは口細の引かけなどをやらうとしてゐる。",
              "citation": {
                "source": "魚美人",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "沖タナゴも私はハヤ鉤で細い綸糸で釣るのであるから、波中の赤金をたのしみ、あの段のついたひらひらと引く味を好むのである。",
              "citation": {
                "source": "魚美人",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからは川タナゴのしもり釣りもよいが、口細を二三喉一度に引かける細竿の味も亦妙である。",
              "citation": {
                "source": "魚美人",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ江戸期からの流行のキス、タナゴが衰へて、今年も亦アユ全盛であらう。",
              "citation": {
                "source": "釣心魚心",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国流に外洋の大物をやるのもよし、池のタナゴや口細から始めるもよし、とにかく子供と違つて、いつぱしのインテリゲンチヤがやることであつたら、何だ釣りかとぐらゐに片づけずに、本気で研究して貰ひたいことだ。",
              "citation": {
                "source": "釣心魚心",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "メバル、アイナメ、海タナゴなどもよく交るが、カイヅは十月池上のお会式まで釣れる。",
              "citation": {
                "source": "夏と魚",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな池でも川でも、そして鮒でもタナゴでも、或はハゼでもイナでも、女子供のピクニツクの好伴侶になる。",
              "citation": {
                "source": "夏と魚",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮒やタナゴ、ハヤなどは釣れてももう匂ひがしてたまらない。",
              "citation": {
                "source": "夏と魚",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハゼやタナゴも釣つてゐるので、釣技といふものは決して珍らしいものではない。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "大江戸の通人は雪の日でもタナゴ釣りをやつた。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして屋形船で雪見酒をやり乍ら、木場あたりの川岸へつけて、障子の蔭から鯨骨と象牙の一尺ばかりの小竿を出し、炬燵にあたりながら、タナゴを釣つて白焼きにし、三杯酢につけて酒の肴にした。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮒を釣るに三里も歩く、その他鮎にしてもハヤにしても、或はイナ、マルタ、川エビ、タナゴにしても、とにかく野原の猫のやうに、草の中を馳け廻つて、魚の棲家を探し、場所を選定してから、徐ろに釣り始める。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "川では鮎、鱒、鯉、鮒、ニゴヒ、ハヤ、モロコ、ヤマベ、イハナ、ヤマメ、タナゴ、鰻、鯰、鰌、ハゼ、イナ、などが釣れ、海では、鯛、鱸、鯒、鰈、鰺、鱚、烏賊、蛸、カサゴ、アイナメ、ソイ、平目、小松魚、サバ、ボラ、メナダ、太刀魚、ベラ、イシモチ、その他所によつて、百種以上のものが釣れる。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸形、袖形、狐、三腰、スレ鈎、鰻、タナゴ、エビといふ分類から、鮎の蚊針などになると、色と糸の巻き方が一色違つても名が違ふ、それに土佐、加賀、と産地があつて、悉く聚めたら千余種にのぼるであらう。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "流れの岸や隅の処に根を張つてゐるスゲの枯れた古葉の傍からは、新しい芽の角が逞しく出てゐるしその根株にかくれたり、そこから走つて泳ぎ出したりする小さいタナゴやハヤの子がすつかり活溌になつてゐる。",
              "citation": {
                "source": "かたくり",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のいる位置などあの方にはタナゴコロをさすようでして、次にどこ、次にはどこへということまで暗闇の中でちゃんとお判りでしたろう。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "目高やタナゴのような小物を釣れば独特な繊細な味があり、マグロやオオハタのような大物を釣れば男性的な豪快な味がある。",
              "citation": {
                "source": "釣場の研究",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "タナゴもそろそろ季節に入る。",
              "citation": {
                "source": "釣場の研究",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さなタナゴも馬鹿には出来ないのである。",
              "citation": {
                "source": "釣場の研究",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寸の麦、三寸の菜種、そのような畑のへりを流れる小川に、モロコやタナゴがピチピチとして、小さなウキの動きにあわせると、仕掛がこまかいから、ピリピリ、存外強く手に来て、よしんば十匹や廿匹でもうれしくなって了う。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "居ながらにして全てタナゴコロをさすが如し、それに比べると、あの若僧のフーテン病みは……」　新十郎一行はアンマ宿の前で馬のクツワを押えていた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も、住んでいる筈の当人、平左衛門の義弟伯次は、花見船なんか馬鹿馬鹿しいと言い出して、諏訪明神裏の寮へ行って、近所の小川でタナゴか何んかを釣って留守。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "花見の留守",
                "note": "青空文庫"
              }
            },
            {
              "text": "川向うの浅草寺の昼の鐘が聴えると、縁側で指を折って勘定しながら、――『爺や、ありゃ九つだね、これから裏の流れでタナゴでも釣って来るから、晩の肴は要らないよ』などと冗談を言いながら出て行きました」　それが本当なら、義弟の伯次はまったく兄殺しの下手人から除外されるわけです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "花見の留守",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も、住んでゐる筈の當人、平左衞門の義弟伯次は、花見船なんか馬鹿々々しいと言ひ出して、諏訪明神裏の寮へ行つて、近所の小川でタナゴか何んかを釣つて留守。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "花見の留守",
                "note": "青空文庫"
              }
            },
            {
              "text": "川向うの淺草寺の晝の鐘が聽えると、縁側で指を折つて勘定し乍ら、――『爺や、ありや九つだね、これから裏の流れでタナゴでも釣つて來るから、晩の肴は要らないよ』などと冗談を言ひ乍ら出て行きました」　それが本當なら、義弟の伯次は全く兄殺しの下手人から除外されるわけです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "花見の留守",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸特有のタナゴ釣り〈二月〉　すべてのものに遺伝という言葉が使えるとしたら、ぼくの魚釣りなども、りっぱに遺伝といえるかもしれない。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
