[
  {
    "uuid": "e858b97f-1c2c-5c9f-a01b-63e52a318555",
    "entry": "炊き出し",
    "reading": {
      "primary": "たきだし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "food distribution (esp. cooked rice)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "地震の被災地でボランティアによる炊き出しが行われ、温かい豚汁が振る舞われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬の寒空の下、ホームレス支援の炊き出しの列には多くの人々が並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "町内会の訓練として、大鍋を使った炊き出しの手順を住民全員で確認する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "竜吐水の水はやっと大屋根に届く位、それも直接｜消火の用を足すというよりは、屋根に登って働いている仕事師の身体を濡らすに用いた位のもの……ゲンバという桶を棒で担い、後から炊き出しの這入ったれんじゃくをつけて駆け出した（これは弁当箱で消防夫の食糧が這入っている）。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "その頃の消防夫のことなど",
                "note": "青空文庫"
              }
            },
            {
              "text": "炊き出しのときおかみさん達の手をはぶくために。",
              "citation": {
                "source": "「乳房」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただその夜、まだ燃えている火事の光を暗い空に望みながら、同僚の一人二人と一しょに、やはり一ひしぎにつぶされた学校の外の仮小屋で、炊き出しの握り飯を手にとった時とめどなく涙が流れた事は、未だにどうしても忘れられません。",
              "citation": {
                "source": "疑惑",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "労働者の同盟罷工や怠業が如何に起ろうとも、信友会の印刷女工たちが如何に炊き出しをして組合の同盟罷工に活動していようとも、それらの事件に対して全く同情も声援を与えられません。",
              "citation": {
                "source": "婦人指導者への抗議",
                "author": "与謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "炊き出しもやり負傷者も労わり、看護もし激励もした。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これこれ百姓ども炊き出しをいたせ！",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男たちは武器の手入れをし、女たちは炊き出しに精出している。",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――○――　林町は大瀧一家族、本田、田舎から来たもの、吉川さん、前の交番への炊き出し、三十人分以上なので、米を用心しなければならず、勘定して、大体、三週間は持つ予定。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "只今、炊き出しを呉れるというから、これで一応報告を切る。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらの炊き出しは豪勢だ。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして夜更けから、炊き出しがはじまった。",
              "citation": {
                "source": "麦藁帽子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "下諏訪から運ぶ兵糧では間に合わないとあって、樋橋には役所も設けられ、炊き出しもそこで始まった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本橋の勤め先が焼けたばかりではなく、押上工場が全焼したので、昨夜来炊き出しその他のことに没頭していたのだという。",
              "citation": {
                "source": "震災日誌",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "セッセと炊き出しをするようにってな。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の廣場は、避難民や炊き出しをしてゐる村の人々でごつた返してゐた。",
              "citation": {
                "source": "顏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして夜更けから、炊き出しがはじまつた。",
              "citation": {
                "source": "麥藁帽子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事の方はどこかでまとめて炊き出しをして、各宿舎に配給したものらしいが、よくは判らない。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は老人と子供たちだけを部屋の中へ入れ、男はみんな屋外へあつめ、炊事係をきめて、すぐ炊き出しにとりかかった。",
              "citation": {
                "source": "十三夜",
                "author": "――マニラ籠城日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "天明の飢饉の折にお粥の炊き出しをしたという大釜の罅の入ったのが残っている。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "穀倉院の在庫高は、洛内の窮民に、施粥の炊き出しをするだけでも、日々、気がひけるほど減ってくる。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "巌はいきなり、そこにある机かけをとって床の上の火炎をたたきだした。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとラツールも笑って、口笛にあわせて空缶のお尻を木片でにぎやかにたたきだした。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "宙にふわりと浮いて而も翔ってるからであろうが、やがて一羽が、ゆるく羽ばたきだしたと見るまに、高く高く、蒼空のうちに昇ってゆき、他の一羽もそれに随い、山の彼方に消えていった。",
              "citation": {
                "source": "鳶と柿と鶏",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　肉屋はおこって、そこにあったほうきの柄をつかむと、いきなりお百姓さんをたたきだしてしまいました。",
              "citation": {
                "source": "うまい商売",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼんやり見ていた喜左衛門の女房はわれに返ったように再び侍の足へ突進して、転ぶようにしゃがむなりまたほこりをたたきだした。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　いよいよ図にのって、減らず口をたたきだした。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
