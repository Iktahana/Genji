        "examples": {
          "standard": [
            {
              "text": "会議では、社長の対決姿勢が明確に表れていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は常に周囲との対決姿勢を崩さないため、孤立しがちだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「もう話し合いは無意味だ。対決姿勢で臨むしかない。」と彼は決断した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "またうって変わって、堅固な要塞に守られた頭脳を備えて厳しい対決姿勢を示すこともある。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
