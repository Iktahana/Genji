[
  {
    "uuid": "83a260d8-1dcf-5b38-91e0-53ec44b7dcb7",
    "entry": "立ち現れる",
    "reading": {
      "primary": "たちあらわれる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
