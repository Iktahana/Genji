    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to manifest itself",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長年の研究の末、その現象の真実が立ち現れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "困難な状況の中で、人間の本質が立ち現れることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の作品には、深い孤独感が立ち現れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ただ、彼が（原文二字缺）の人として立ち現れる瞬間にたちまち否定さるべきものに變るのである。",
              "citation": {
                "source": "第一義の道",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この作品で、都会が農村に対する一般的な破壊力としてだけ立ち現れる旧套にとどまったのは遺憾である。",
              "citation": {
                "source": "文芸時評",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大地」の監督に当ったシドニー・フランクリンは、ムニやライナーを東洋人として演じさせるためにこまかい注意を払っているのであるが、私たち東洋の眼で見ていると、折々パッと異国の花が開いたようにライナーがほかならぬアメリカの最も尖端的な表情で立ち現れる瞬間がある。",
              "citation": {
                "source": "映画の語る現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "全作家同盟の「労働者化」の課題の重要性が、今や新しい光に照らされて、立ち現れるのである。",
              "citation": {
                "source": "前進のために",
                "author": "――決議によせて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然主義の系統から出発して、雑誌『新潮』によりながら、作品活動としては大衆作家として存在しているこの人が、文学の芸術性、その至上性というものについての論議に触れると常にピューリタン的な擁護者として立ち現れることは、一つの芸術の分野ならでは見られない現象であろう。",
              "citation": {
                "source": "昭和の十四年間",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "プルウストは立ち現れると言ひはじめました。",
              "citation": {
                "source": "かげろふ談義",
                "author": "――菱山修三へ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "新中納言知盛は、舟の屋形に立ち現れると、大音声をあげて叫んだ。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は上等のネクタイを締めて、オペラコミック座の二階回廊席の婦人達の目を意識して立ち現れる。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前が私の極印を押された許可状を持たずに、霊から引放した肉だけにお前の身売りをすると、そこに実質のない悪魔というものが、さも厳めしい実質を備えたらしく立ち現われるのだ。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又お前が肉から強いて引き離した霊だけに身売りをすると、そこに実質のない天使というものが、さも厳めしい実質を備えたらしく立ち現われるのだ。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だのに、すこぶる不思議、ふたりの太刀持ち露払いが姿を見せた以上は、当然そのあとに名人右門が、あの秀麗かぎりない面にゆうぜんとあごをなでなで立ち現われるだろうと思われたのに、どうしたことかその姿がないのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "へび使い小町",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてその代りに妖艶な若侍の姿が、スッキリと立ち現われるのを見た。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が持つ精鋭なる武器、斬新なる技巧と鋭角的な機知をさげて立ち現われると我々はそれだけでまず圧倒されてしまう。",
              "citation": {
                "source": "ルネ・クレール私見",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫く歩いて行くと右側に高い昔風の塀が続いて、古色蒼然とした宏壮な大門が立ち現われる。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "「田中君に取り次いで下さい」と彼は帳場の前に立ち現われるなり、十二分に威厳をつくろって口を切った。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "……と、こう繰り返していったところで、おいよと竹之助様が返辞をして、立ち現われるものでもなし。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて正面の出口の彼方、罌粟畑の中より、一人の人影立ち現われる。",
              "citation": {
                "source": "レモンの花の咲く丘へ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、生き霊とは生者の霊であり、どんなときにも立ち現われる。",
              "citation": {
                "source": "石仏",
                "author": "THE STONE BUDDHA",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして全世界は戦き震え、着古した衣をかなぐり棄てて、新しい驚くべき美しさを以て立ち現われる。",
              "citation": {
                "source": "紅い花",
                "author": "КРАСНЫЙ ЦВЕТОК",
                "note": "青空文庫"
              }
            },
            {
              "text": "数年前に亡くなった人、音信も途絶えがちな遠方の人、そんなのが、平素の忘却の淵から浮び上るかのように、意外な時に、ふっと夢の中に立ち現われる。",
              "citation": {
                "source": "復讐",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "親しい友とか身内の者とかが、遠く離れていて死ぬ場合、その人の姿がぼんやりと、枕元に立ち現われる、などという話は嘘だけれど、家の棟に大きな音がしたり、柱が軋り鳴ったりすることは、実際にある。",
              "citation": {
                "source": "女心の強ければ",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを満たすために、清子の姿が立ち現われる。",
              "citation": {
                "source": "聖女人像",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "処がマルクス主義が衰えて、即ち流行しなくなって、ファシズムが流行り出すと、いつの間にか多少ともファッショ的雰囲気を持った言論家として立ち現われる。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学的自由主義者達は、自分のこの懐疑論的な本質を相当よく自覚しているらしく、その証拠には、彼等は意識的無意識的に、一身の利害に関する実際的行為をする段になると、機会主義的な現実主義者となって立ち現われる。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ではどういう風に之に対立するのかと云えば、要するに通俗道徳に対してその批判者として立ち現われるのが、モラルだということに他ならぬ。",
              "citation": {
                "source": "道徳の観念",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時文学的自由主義者は最も理想的な真正のセクト主義者として立ち現われることが極めて容易になる。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は常識の批評家として、人間的理性の批判家として、立ち現われる。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、弟はそのズボンをはいて、こうした服装などの点ではもちろんだましやすいあなたの前に立ち現われることができるというわけです。",
              "citation": {
                "source": "城",
                "author": "DAS SCHLOSS",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっとのことで館内に入った鶴見の面前に、いきなり等身大の仏像が立ち現われる。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく扮装して市場に立ち現われると、若い女や年取った男どもが、それを非常に喜んだ。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
