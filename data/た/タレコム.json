    "definitions": [
      {
        "index": 1,
        "gloss": "to tip off (e.g. the police)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は同僚の不正を上司に垂れ込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「まさか、お前が警察に垂れ込むとはな」と犯人は言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "組織の秘密を外部に垂れ込むことは許されない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "わたしのロシア語なんて、長原さんのオムレツに二三品ふやしたぐらいのところなんだから」「――わたしはいやだよ」　素子はかけている長椅子の背へもたれこむようにして拒絶した。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際柳の成績はおどろくべきものであった、かれの球は速力において五大洲におとっているが、その縦横自在な正奇の球は回が重なるにしたがって熱気をおびてきた、どうかしてかれが敵に打たれこむときには小原がマスクをぬいでダイヤモンドへ進んでくる、そうしてこういう。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中でへたれこむ自分が可笑しくなり、笑うと、その笑いすら半分ほどで消えて、いつのまにかぼくは目を据えたまま短い吐息をくりかえしているのだ。",
              "citation": {
                "source": "煙突",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてやつとすむと、すぐにやつて来てこちらの膝へもたれ込むようにして「何でどすやろ、何でどすやろ」とまちがえたことをさも心外そうにそう言うのであつた。",
              "citation": {
                "source": "私の活動写真傍観史",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこかに一寸もたれ込むものをもっている人々は、暫く風をいなす気でそこにもたれて遂にえらいことになる有様です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう言ってたぞ、良くなったら警察に手紙を書いて一、二件たれ込む。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
