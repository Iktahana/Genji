        "examples": {
          "standard": [
            {
              "text": "このアンティークのドアノブは、握りやすい玉型のデザインが採用されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「玉型にカットされたダイヤモンドが、照明を反射して眩しく輝いている」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は玉型の真珠のピアスを耳に当てて、鏡の前で似合うかどうか確かめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そこで明智は、紙片を片手に、ツカツカと暖炉に近づき、先ず右から始めて六番の玉型の彫刻を、グッと廻して見た。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
