        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "下髪の短いタレイラン式の仮髪に、シュヴェツィンゲン風を模した宮廷楽師の衣裳。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジオヴァーニ・バティスタ・ラムージオ（一五五九）、エル・アルメイダ（一五七六）、マフェノ（一五八八）、タレイラ（一六一〇）らの旅行者たちもまた茶のことを述べている（二）。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏切ったが、自分のために、ツワイクの云い方ですればバクチの情熱のために冷血なので、自分が安穏にはした金で飼われるのが目的ではなく、同じ無節操の標本であるナポレオン時代の外務大臣タレイランが享楽を窮局の目的としたのとは又違う姿がよく描かれています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロベスピエールなど、又ナポレオンの外交、タレイランの外交をあの本はどう見ているでしょうか。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は機知を仕込み、想像の中の会話で発する素早い返答を編み出し、繊細な言葉や、老練な政治家タレイランが言いそうなせりふを準備した。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方でウィーン会議でフランスの分割を回避させたタレイラン王子[52]に向かって皆が石を投げつける。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
