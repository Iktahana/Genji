        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヤマオカマサヨシクンゴフサイガ、シナヘイノギセイトナッタコトヲオクヤミモウシマス、イサイハアトヨリ、ニホンジンクラブ　務の顔色はみるみるかわった。",
              "citation": {
                "source": "白っぽい洋服",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イロイロオセワニナツタコトヲシンシヤス」と書いた。",
              "citation": {
                "source": "海をわたる",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハモンコチヤンヲイヤダナンテオモツタコトヲ心カラコウクワイイタシマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシアレヲ思イ出シチャッタワ」「ボクシングハタッタ一ペンシカ見タコトガナイナ」コヽヘ婆サント看護婦トガ滑リ台ノ時間ガ来タコトヲ知ラセニ来タノデ、颯子ハ一層面当ガマシク誇張的ニ話シ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モアダリンノ利キ目デ、二度便所ヘ行ッタコトヲ辛ウジテ記憶シテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、モシ予トオ静トガ打ツカラナカッタラ、予ニ知レタコトヲ彼等ハ気ヅカズニイタデアロウ、トスルト、オ静ガ予ト行キ遇ッタコトハ、マダシモ仕合セダッタト云エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ新築ノ隠居所ノ空想ガコノ柔カイ掌ノ上ノ一点ト化シ去ッタコトヲ知ラサレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯ヲ染メル時ハ特有ナ鉄漿ノ臭イガシタコトヲ予ハ今デモ覚エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母ノ亡クナッタ昭和三年カラ数エテ三十三年後ニ、忰ガコノヨウナ狂人ニナリ、コノヨウナ嫁ガ我ガ家ニ入リ込ムニ至ッタコトヲ、夢ニモ考エタヾロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……………………………………………………………………………………………………………………………………………………………………十七日ノ朝、颯子ガ何ノ断リモナシニ勝手ニ東京ヘ立ッタコトヲ知ッタノハ、午前十一時頃デアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
