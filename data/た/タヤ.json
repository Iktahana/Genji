        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は生理中なので、今日は他家で休ませてもらっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "友人が他家で過ごす間、彼女の仕事は他の者が手伝った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「おや、今日は他家かい？ゆっくり休むといいよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
