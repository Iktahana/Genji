          "literary": [
            {
              "text": "センセイノ　コ新美南吉　タキクンノ　オトウサンハ　一ネン　ダンシノ　ウケモチデシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ　ハナノ　下ニ　クロイ　ヒゲヲ　ツケテ　ヰタノデ、コドモタチハ　「ヒゲサン」ト　ヨンデ　ヰマシタガ、ヤガテ　タキクンノ　コトモ　「ヒゲサン」ト　ヨブヤウニ　ナリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　タキクンノ　オトウサンガ　ヤサシク　タヅネルト、ミツルクンハ　ナキナガラ、「タキクンガ　イジメタ、アーン。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンノ　オトウサンハ　ソレヲ　キクト、タキクンノ　ハウヲ　キツト　ミテ、「タキ、イジメタリ　シテハ　イケナイヂヤ　ナイカ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ、タキクンノ　カホヲ　ノゾキコミナガラ、「オトナシク　シナキヤ　イケナイヨ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
