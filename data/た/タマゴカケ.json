        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ラムと｜卵かけ塩漬豚肉さえあれぁいいんだ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "入浴、朝食、生卵かけた飯は美味い。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木を誘ひ、ニューグランドへ、ポタージュと、卵かけあほり飯、スウェディシュのミートボール、アイスクリーム。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時までねて、又宿の朝飯をとり卵かけて三杯食った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "卵かけて飯一杯食ったゞけ、すぐ停車場へ、まだ真暗な中を歩く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "入浴、ぬるい湯なので気持悪し、朝食、卵かけて三杯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "別府成天閣の朝、朝食、卵かけて三杯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎朝、豆腐と油揚のみそ汁、生卵かけて、それでも三杯食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "生卵かけて又三杯と行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食、ハム入りの煎り卵、生卵かけて二杯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯、生卵かけて、やはり三杯食った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "生揚げの焼いたの、豆腐の粉々になった味噌汁、海苔（変色して、にほひなどなし）、生卵かけて丼めし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯も、生卵かけて一、二杯食ひ、眠くなりて床に入る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食、はかなき喜多八の朝めしよ、生卵かけて二杯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食、鮭の最小片、しらす干し入りの浸し、生卵かけて軽く二杯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
