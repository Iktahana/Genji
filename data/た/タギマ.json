          "literary": [
            {
              "text": "一一　奈良縣北葛城郡の當麻（古名タギマ）へ越える道で、二上山の南を通る。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "このキヨ彦がタギマノメヒと結婚して生んだ子がスガノモロヲとスガカマユラドミです。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "また當麻の倉の首ヒロの女のイヒの子と結婚してお生みになつた御子はタギマの王、スガシロコの郎女のお二方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
