        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一七二〇年頃ターリング（Terling）に新しく住家を求め、その後 Terling Place の荘園を買った。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この最初の研究実験はターリングの邸宅の古いグランドピアノの上で行われたのである。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅行後ターリングに帰って秋と冬を送った。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八七三年の秋に新しきレーリー卿となった彼はトフツの邸から父祖の荘園ターリングに移った。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして一八七四年から一八七九年までは平穏にターリングの邸で暮していた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その試験問題の討究のために試験官仲間をターリングに招待したが、そのためにソリスベリー卿とディスレリーとの和解の饗宴という歴史的のシーンに出席する機会を逸した。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "郷里ターリングに引上げてから、自分の研究室の準備にかかった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ターリングでやろうと計画していた研究の一つは、主要なガス元素の比重を精密に測定してブラウト方則を験しようというのであった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は家族を挙げてターリングの邸内に移り、死ぬまでここでレーリーの片腕となって働いた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "協会の集会に列席する以外は大抵ターリングに居て書信で用を足した。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "義兄弟のバルフォーア、当時のアイルランド政務総監がターリングへ遊びに来た時は護衛の警官が十二人もついて来たりした。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ターリングにおける日常生活を紹介する。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ターリングの家の来訪者名簿には、内外の一流の学者の名前の外に英国一流政治家の名前も見える。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九〇五年に新しい助手 J. C. Enock を得たが、この人は一九〇八年にターリングを去った。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大戦中ターリングは軍隊の駐屯所となった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしターリングの設備では実行が出来ないのであった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "葬式はターリングで行われた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓はターリング・プレースの花園に隣った寺の墓地の静かな片隅にある。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォルガからスターリングラードへ入る埠頭の景色が思い出された。",
              "citation": {
                "source": "新世界の富",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのドニェプル発電所の再建からはじまって、スターリングラードの名誉ある復興、ウクライナ全地域、ドン全区にわたる生産復興は、短波できくニュースでもわかるとおり世界をおどろかせる能率で捗っている。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スターリングラードでの、彼は、彼の作家としての生涯にとっておそらく最も強烈でまじりけない人類的感銘をうけている。",
              "citation": {
                "source": "心に疼く欲求がある",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「スターリングラードの再建」の最後に彼ののべている感想には、真実の響がある。",
              "citation": {
                "source": "心に疼く欲求がある",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界の元首たちが、スターリングラード市民の名誉のためにおくりものをした品々と云えば、中性の剣とか古代の楯の模造品であり、その記念帳にかかれた文字は、「世界の英雄たち」とか「文明の防衛者達」という字である。",
              "citation": {
                "source": "心に疼く欲求がある",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「スターリングラードが六台の土鋤機を欲しているときに、世界は一個のごまかしの賞牌をその胸に飾ったのである」と。",
              "citation": {
                "source": "心に疼く欲求がある",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スターリングラードのホテルも思い出します。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "スターリングラードもああやって歩いた広い通りなんか今どこにもなくなったでしょうし。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "スターリングラードのトラクター工場へと。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "道標　第二部第一章一　その年の夏の終り近くなってから伸子と素子とはニージュニ・ノヴゴロドからスターリングラードまでヴォルガ河を下った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年の秋伸子と素子が遊覧船でヴォルガ河をスターリングラードまで下ったとき、ヴィヤトカの船つき場をちょっと登ったいら草原のようなところで、三四人の婆さんがショールを売っていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年の夏の末に、ヴォルガの河をニージュニ・ノヴゴロドからスターリングラードまで下って、ウクライナとコーカサスを旅行したとき、伸子たちの乗っている白い遊覧船は、一日のうちに必ず二度三度はカスピ海にそそぐ河口のアストラハンからヴォルガをさかのぼって来る西瓜船とすれちがった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
