    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "男は、自分の作品についてのおそらくはいちばん適確な評論を組みたてはじめる。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども太郎は、それまでは退屈そうにあくびばかりしていたのを、やがて細い眼をはっきりひらいて聞き耳をたてはじめたのである。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、彼の思索や行為はいつの間にか佯りの響をたてはじめ、やがてその滑らかさを失って凝固した。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、それはすぐ日向の匂いをたてはじめるのであった。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにかきこえると聴耳をたてはじめてから、それが一つの可愛いリズムだと思い当てたまでの私の気持は、緊張と云い喜びというにはあまりささやかなものでした。",
              "citation": {
                "source": "橡の花",
                "author": "――或る私信――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな訳で、奉公したては、旦那が感心するくらい忠実に働くのだが、少し飽きてくると、もういたたまれなくなって、奉公先を変えてしまうのです。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "重い大戸のあけたては、冴えた夜空に鳴り響く。",
              "citation": {
                "source": "新万葉物語",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫はごろごろ喉を鳴らし、牝鶏はクックッ鳴きたてはじめました。",
              "citation": {
                "source": "醜い家鴨の子",
                "author": "DEN GRIMME AELING",
                "note": "青空文庫"
              }
            },
            {
              "text": "別れて出たては至極穩かで、白山あたりから通つて來る、或｜大工と懇意になつて、其大工が始終長火鉢の傍に頑張つてゐた。",
              "citation": {
                "source": "絶望",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもどんな時でも、清逸が学問をするために牽き起される近親の不幸（父も母もそのためにたしかに老後の安楽から少なからぬものを奪われてはいるが）は、清逸をますます学問の方に駆りたてはしても、躊躇させるようなことは断じてなかった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏道仏心｜弥陀の極意はこのひとまくらのうちにありといわぬばかりで名人は、求道弘法の経巻を頭の下にしながら、おりから聞こゆるお山の鐘を夢の国への道案内に、すやすやと心よいいびきをたてはじめました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　先生は、音をたてはじめたサーロインの厚さに、ちょっとおびえているようだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "来たては随分｜蒼い顔をしてね、そうして何だか始終おどおどしていたようだが、馴れるとだんだん平気になって……」「性質が柔和いんですよ」「柔和いんだよ。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの錦襴も織りたては、あれほどのゆかしさも無かったろうに、彩色が褪せて、金糸が沈んで、華麗なところが滅り込んで、渋いところがせり出して、あんないい調子になったのだと思う。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どこの子だって生れたては皆なこの通りです」「まさかそうでもなかろう。",
              "citation": {
                "source": "道草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お豆腐のたきたては奈何でごわす」などと言って、内儀さんが大丼に熱い豆腐の露を盛って出す。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "うちかて株内や云うたてはっきりしたことって何一つないのやし、組が引取らんならんのや。",
              "citation": {
                "source": "南北",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "子芋の煮たてはうまきものなり。",
              "citation": {
                "source": "明治卅三年十月十五日記事",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "表の間の税務官吏の話をきれぎれに耳にはさみながら、かうした離れ小島にも、税のとりたてはきびしいものだとうかゞへた。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "儂は、あの日のことを思い出すと、今でも心臓が怪しい鼓動をたてはじめるのじゃよ」　そう云って川波大尉は、額の上に水珠のように浮き出でた油汗を、ソッと拭ったのだった。",
              "citation": {
                "source": "恐しき通夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "痛みますんで、夜もオチオチ睡れません」「睡れないのは、誰でも入りたてはちと睡れぬものさ。",
              "citation": {
                "source": "柿色の紙風船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、それはお手柄のたてはじめであったともいえる。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "巨人ハルクのとじこめられた倉庫の、通風窓にはめられてあった鉄格子が、きいきいとおとをたてはじめた。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "隊長大月大佐は、丁坊の進言によって、空魔艦の根拠地へむけて遠征する計画をたてはじめた。",
              "citation": {
                "source": "大空魔艦",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "機は奇妙な呻りをたてはじめた。",
              "citation": {
                "source": "三重宙返りの記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、カキカキした大きな字の手紙を頬に敷いたまま、いつのまにか安らかな寝息をたてはじめた。",
              "citation": {
                "source": "鴻ノ巣女房",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつものように母の枕元に坐り徐かに髪を梳いてやると、やがて顔から手を落して静かな寝息をたてはじめた。",
              "citation": {
                "source": "父",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の人一　ええ、まあ、御身たちゃあ何をしとるだ。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "開墾地の人たちゃあ、開墾の賃金をほとんど貰ってねえのだからなあ」「無茶なことばかり言って、困るなあ」　敬二郎は溜息を吐くようにして言った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「公方さまが、はばかったって、おれたちゃあ、ちっとも遠慮することはありゃあしねえよ――どうせ天下のお式目、御法度ばかり破って、今日びをくらしている渡世じゃあないか――おめえは知らず、このおれと来ては、どうせ首が、百あっても足りねえからだ――一度、見込んだら、屹度やる。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
