[
  {
    "uuid": "5a34afe9-4b98-56a8-9e3a-a225cb5ad7af",
    "entry": "叩き落とす",
    "reading": {
      "primary": "たたきおとす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行"
      ],
      "ctype": null,
