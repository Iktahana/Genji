    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to knock down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "野球部のエースが、鋭い変化球で打者のバットを叩き落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "飛んできた蚊を、とっさに手で叩き落とす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "高慢な態度を取り続ける彼を、いつか鼻っ柱から叩き落としてやりたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "私は椅子から立ち上がり、パイプの灰を叩き落とす。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、貝十郎の言葉を暗誦し、「わたくしが叩き落とすのでござりますね？",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま叩き落とすから、目を離さないようにネ」「アラ甲虫なの」「さあ、叩き落とすよ」　武夫はなおも身体をのばし、腕にウンと力を入れておいて、竹も折れよとばかり巨大な甲虫をピシリとぶん殴った。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おたがい、センター・ラインすれすれに走ってきて、すれちがいざま、木刀で、相手を叩き落とす。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士が手ににぎっていた、火焔放射器をただの一撃でたたきおとすと、Ｘ号は大手をひろげて博士の上へとびかかった。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "新田先生は、ここぞとガス弾をとばせば、向こうの丸木艇では、怪力線をうちかけて、ガス弾をたたきおとす。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわんや敵の空軍など、まあ、蠅をたたきおとすようなものだ」　リーロフ大佐は、いよいよ鬼神のような好戦的な目をひからせる。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間に巣をたたきおとすのさ。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまたふうわ、ふうわ飛んで來るのを眞ツ暗な中に待伏してゐて笹の葉か何んかで叩き落す。",
              "citation": {
                "source": "水郷",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを手当り次第に叩き落すと、五分か十分のあいだに忽ち数十匹の獲物があった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めは自然に落ちて来るのをおとなしく拾うのであるが、しまいにはだんだんに大胆になって、竹竿を持ち出して叩き落す、あるいは小石に糸を結んで投げつける。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを手当り次第に叩き落すと、五分か十分の間に忽ち数十｜疋の獲物があった。",
              "citation": {
                "source": "思い出草",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを叩き落すと、そばの岩で打ち砕き、思うさま貪り食った。",
              "citation": {
                "source": "俊寛",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "爺奴嚇す氣になつて、「竿持つて來て叩き落すぞつ。",
              "citation": {
                "source": "漂泊",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "爺奴嚇す気になツて、「竿持ツて来て叩き落すぞ。",
              "citation": {
                "source": "漂泊",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "磯釣の餌にする海老を手に入れた喜びで、眼を耀かせ、青竹の長さをくらべては栗の実を叩き落す子供たち。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッと渋団扇で叩き落す。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（と懐中の匕首を抜き放ち、己が胸に突き立てようとする）成吉思汗　（駈け寄ってそれを叩き落す）何をする！",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "石川は、無人島でアメリカへ売り込む鳥の羽毛を叩き落すのをやめてから、或る請負師の下に使われるようになった。",
              "citation": {
                "source": "牡丹",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな椿、その真黒な実、それを竿の先で叩き落すのである。",
              "citation": {
                "source": "春",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "天上に導く力があるものは、また地上に叩き落す力もなければならない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女時代の私は晝の中に二三の友と約束し、夕食をいそいで濟ますやいなや、螢を叩き落す笹と、小さい籠とを持つて町はづれの田圃『かどのもと』へと急いだのであつた。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "（掃除をした銃を振って桜の垂枝を叩き落す）こんなものまで咲いているしよ、まるで物見遊山だあ。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私より年上の権八は毎朝造船部へかん／＼叩き（鉄の錆を叩き落す少年労働者）に出て二十銭｜宛儲けて帰つた。",
              "citation": {
                "source": "ある職工の手記",
                "author": "宮地嘉六",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の少年達が螫されてもめたん子は滅多に螫されないで、威勢宜く、かーん、かちりと叩き落す、かれは巣甕から下りてくる時にもうすでに狙ひを決めてゐて、自分の顏のすぐ前で叩き落すのだ、町でいぢめられてゐる意氣地なしのめたん子とは、別人の落着きと沈勇があつた。",
              "citation": {
                "source": "めたん子傳",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことは一瞬に片付きましたが、八五郎は戸を開けてから、宗之助が灯を叩き落すまでの短かい時間のうちに、見るべきものを見、確かめることを確かめてしまつたことは言ふまでもありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "萬兩分限",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことは一瞬に片付きましたが、八五郎は戸を開けてから、宗之助が灯を叩き落すまでの短い時間のうちに、見るべきものを見、確かめることを確かめてしまったことは言うまでもありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "万両分限",
                "note": "青空文庫"
              }
            },
            {
              "text": "………」　こう云いながら、探偵はちょっと不思議なことをやった、―――持っていた葉巻の灰をトントンと叩き落すような風に見せて、彼は湯河の手頸の辺を二、三度軽く小突いたのである、―――何か無言の裡に注意をでも促すような工合に。",
              "citation": {
                "source": "途上",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女ながら、稲妻小僧と言われた、恐ろしい軽捷さ、しばらく平次も持て余しましたが、やがて匕首を叩き落すと、キリキリと縛り上げます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "百四十四夜",
                "note": "青空文庫"
              }
            },
            {
              "text": "（慌てて振り向く）茂兵衛　（良公、升公が「人殺しい」の叫びにぎょッとする隙に乗じて振り払い、落ちていた得物を拾って、二人を叩き倒し、弥八に向う）弥八　　（得物を投じ、長脇差へ手をかける）抵抗いすると、素ッ首を、叩き落すぞ。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
