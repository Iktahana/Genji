  {
    "uuid": "4ea42537-9f37-522b-a1ae-610edd645d32",
    "entry": "立札",
    "reading": {
      "primary": "たてふだ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
