      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "恰度立札ほどの高さに、骨はしらじらととんがつてゐる。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "煉瓦塀に春を発見した福助人形の影法師孤児の下駄が置き忘れてありました公園の入口ペンキのはげた立札心よ！",
              "citation": {
                "source": "（風船玉の衝突）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "近寄って見たら、小杉未醒原作、農民美術と立札してあった。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥居は六十一年目に立て替える定めだそうで、今のは二十七回だと、立札がしてあるが、そんなことはどうでもいい。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方には自動車道という大きな立札もある。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名な狸小路では到る処投売りの立札が立っていた。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "浅草の親戚を見舞うことは断念して松住町から御茶の水の方へ上がって行くと、女子高等師範の庭は杏雲堂病院の避難所になっていると立札が読まれる。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十里四方には人らしい者もないように、船を纜った大木の松の幹に立札して、渡船銭三文とある。",
              "citation": {
                "source": "薬草取",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、九月の末のある日曜でしたが、朝早く私が慶次郎をさそっていつものように野原の入口にかかりましたら、一本の白い立札がみちばたの栗の木の前に出ていました。",
              "citation": {
                "source": "二人の役人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）Ｔ　ある城下町Ｓ＝街角　立札。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、爾今当城下に於て　仇討の助太刀を　致したる者は金百両也　の恩賞を与う者也　その立札の前に立ち止った、武蔵と団九郎。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "立札の大写（フラッシュ）Ｔ「百両ッ」（少し大きく）　スラッと五人が大刀抜いて、Ｔ「助太刀致すッ」　と団九郎に迫る。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「立札」Ｔ　百両　でズラリと抜刀して、Ｔ「助太刀致す」　と文六に斬り掛かる。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓ＝町　例の立札が、大地に叩き付けられて居る。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "傍に立札が立ててある。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これには少女達も全く困ってしまいましたが、其のうち才はじけた一少女が、心得顔に筆を持って立札の上に、女の言葉をその儘そっくり書きしるして、舞台わきに持って行って立てました。",
              "citation": {
                "source": "気の毒な奥様",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうか、高い渡船銭だな」といいながら、八人前三十二銭渡して岸に上ると、岸上の立札には明かに一人前一銭ずつと書いてある。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、九月の末のある日曜でしたが、朝早く私が慶次郎をさそっていつものやうに野原の入口にかゝりましたら、一本の白い立札がみちばたの栗の木の前に出てゐました。",
              "citation": {
                "source": "二人の役人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルザックの逞しいあらくれの手を忘れ、こそこそと小河で手をみそいでばかりいて皮膚の弱くなる潔癖は、立小便すべからずの立札にも似て、百七十一も変名を持ったスタンダールなどが現れたら、気絶してしまうほどの弱い心臓を持ちながら、冷水摩擦で赤くした貧血の皮膚を健康の色だと思っているのである。",
              "citation": {
                "source": "可能性の文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑中の坂の中途から、巨刹の峰におわす大観音に詣でる広い道が、松の中を上りになる山懐を高く蜒って、枯草葉の径が細く分れて、立札の道しるべ。",
              "citation": {
                "source": "怨霊借用",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "進み進みて下影森を過ぎ上影森村というに至るに、秩父二十八番の観音へ詣らんにはここより入るべしと、道のわかれに立札せるあり。",
              "citation": {
                "source": "知々夫紀行",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "畦には眞新しい木の立札が立つてゐた。",
              "citation": {
                "source": "黎明",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その立札の上に黒々と書かれた文字を不審さうにぢつと見つめてゐる熊吉の横顏を見ながら、ふと思ひ出したやうにおとよがいつた。",
              "citation": {
                "source": "黎明",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼を立札からその繩にうつした熊吉はしばらく無言でつゝ立つたまゝだつた、がすぐに彼は怒氣をふくんだこゑでいつた。",
              "citation": {
                "source": "黎明",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「わしはあなな立札の文字なんぞ讀めんがな。",
              "citation": {
                "source": "黎明",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "久しく目に馴染んでゐる温泉場の広告立札が山の裾に並んでゐるのが見えたりして、熱病患者のやうな融の遊意を刺戟した。",
              "citation": {
                "source": "歯痛",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中、長垂寺といふ景勝の立札があつたけれど、拝登しなかつた、山からの酒造用水を飲ませて貰つたがうまかつた、たゞしちつとも酔はなかつた！",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "諺文の立札がある、それほど鮮人が多いのだらう、檣のうつくしい港として、長崎が灯火の港であることに匹敵する如く。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮮人宛の立札があるのは、諏訪神社に外人向のお※札（英語の）があると好対照だ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "光明村では処々にむつかしい立札を見せつけられた。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
