        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのへんから当然美を純粋に追求すればするほどタブロウにはなり得ないと言った自己矛盾におちいり、ついに描かれない絵――したがって誰の目にも見えない絵――だけがホントの絵だという自己破壊的な結論に到達するに及んで私の遍歴は終りました。",
              "citation": {
                "source": "絵画について",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一枚のタブロウ全体でも、ひとタッチずつの中でも彼は生きている。",
              "citation": {
                "source": "ゴッホについて",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツコツと写生をしデッサンをしてタブロウをつついて描いた絵のことだ。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タブロウは写実と美と純粋だけでは出来あがらない。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僅かであるが、そういうタブロウがあるのだ、武者小路に。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "往々にして、そのタブロウは、彼の「ツクネいも」の絵よりも出来が悪いけれど、しかし、そこにホントの芸術家の態度がある。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてむやみと大きなタブロウなどに岩を様式化したりして、ポスタアを描くでしょう。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タブロウは描かない。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのデッサンやクロッキイを見ていると、この男が本腰をすえてタブロウを描いたら、どんな良い画ができるだろうと思わせる。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、タブロウにかかると、うまく行かない。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして遂に彼はホントの画家――タブロウに全身をかける者――にはなれないでしまった。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
