        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "蘭人達はあまりに変つた王の様子にタヾ恐ろしさの為に震つてばかり居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者が〔以下原稿数枚なし〕　それから「アナタ、タヾノオキャクサンゴザイマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「タヾノオキャクサン」筆者は甚考へた。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝てばかりもゐられないので三時間ばかり町を行乞する、行乞相は満点に近かつた、それはしぼり腹のおかげだ、不健康の賜物だ、春秋の筆法でいへば、シヨウチユウ、サントウカヲタヾシウスだ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "時の記念日、とまつた時計を時計屋へ持つてゆく、ネヂがゆるんだためで、すぐに直してくれた、タヾで。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人達はタヾで入りに來るといふ。",
              "citation": {
                "source": "伊豆の旅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたも東京なんて止めにして此処の隣りに斯んな家でも建てないこと、千円位ゐで出来るつてさ、土地はタヾでやるわ。",
              "citation": {
                "source": "鱗雲",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "感興の機勢で直ぐ筆を揮つたＺ・Ｋ氏は、縱長い鳥子紙の見事な出來榮えにちよつと視入つてゐたが、くる／＼器用に卷いて、では、これを、とＡさんの前に差出したかと思ふと、瞬間、手を引つ込めて、「Ａ君、これタヾかね？",
              "citation": {
                "source": "足相撲",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "『それで姓名は‥‥』『エミタヾカツ』　今度は望生に向ひ。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "深大寺の打石斧",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミタヾカツといふ文士かい。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "深大寺の打石斧",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔からタヾの医者でなかった翁の所謂灌水は単に身体の冷水浴をのみ意味せぬ如く、治術も頗活機に富んだもので、薬でなくてはならぬときめこんだ衆生の為に、徳島に居た頃は不及飲と云う水薬を調合し、今も待効丸と云う丸薬を与えるが、其れが不思議によく利くそうだ。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏山では、タヾでは貰えぬ、と言う。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ首都巴里ノ労働者ニシテ「ブルタアニユ」ヤ「ノルマンデイイ」ノ到ル処ニコノ「田舎ノ家」ヲ所有スルモノ其ノ数オビタヾシキニノボルト云ハレル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾシ、私ノウチニハ、オ皿トナイフトフオークガ一ツヅヽシカアリマセンカラ、オイデ下サル方ハ、ドウゾ、ゴジブンノオ皿ト、ナイフト、フオークヲモツテイラシツテ下サイ。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし旦那、お衣ちやんはタヾの娘ぢやありませんよ。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾ技巧ヲ以テソレヲ感知セシメナカッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ如何ニ技巧ガ巧妙デアッテモ、モト／＼予ノ趣味デハナカッタノデ、タッタ一遍好奇心ヲ満足サセタヾケデ、ソレキリ同性ト関係シタコトハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ残リヲ予ニ食ベサセル積リデ、ホンノ一片カ二片食ベタヾケデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マア考エテオクコトニシヨウ」「今日御返事ガイタヾケナインデスカ」「コノトコロイロ／＼ト出銭ガ多クッテネ」ブツ／＼云イナガラ二人ハ出テ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾ痛イノガ激シイ時トソウデナイ時トアリ、一定ノ状態デ持続セズ、全ク痛マナイ時モアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」戸ハホンノ僅カ、動クカ動カナイクライニ触レタヾケデアッタガ、早クモ彼女ハ気ヅイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「医者ガ内診スルミタイダ」「馬鹿ネ」「舌ヲ使ワズニ接吻シロナンテ、随分無理ナ註文ダナ」「接吻ジャナイモノ、タヾ唇デ触ラセルダケダモノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンニハソレガ相当ヨ」「セメテコウシテル間、シャワーヲ止メテ貰エナイカナ」「止メル訳ニ行カナイ、触ラレタ傍カラ直グト綺麗ニ流シチャワナイト気味ガ悪イ」予ハタヾ水ヲ呑マサレタ気ガシタヾケダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春久ガシャワーヲ浴ビニ来サセテクレト云ウノハ、タヾソレダケノコトデナク、何カ魂胆ガアルノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾ流シ場ノタイルヤ周囲ノ壁ニ夥シク水ガ飛ビ散ッテ濡レテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンノチラリト見タヾケダッタガ、変ニ冷イ無愛想ナ顔ヲシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "割下水ノ家ニ住ンデイタ時分、六ツカ七ツノ頃ダッタヾロウ、乳母ニ抱カレテ寝床ニ横ニナッテイルト、蟋蟀ガヨク縁側ノ外デ鳴イテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母ノ亡クナッタ昭和三年カラ数エテ三十三年後ニ、忰ガコノヨウナ狂人ニナリ、コノヨウナ嫁ガ我ガ家ニ入リ込ムニ至ッタコトヲ、夢ニモ考エタヾロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ誰々サンノ所ノ老人ハ、チョットシェパードガ足元ニ絡ミ着イタヾケデ転ンデ大怪我ヲシ、三カ月モ入院シテ未ダニギプスヲ篏メテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
