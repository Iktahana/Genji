        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新製品の発売がライバル社に立ち後れ、市場シェアを大幅に奪われてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "情報収集の立ち後れが原因で、絶好の投資機会を逃すことになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "デジタル化の立ち後れを解消するため、会社全体でIT研修を導入することにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "亡国的避難民根性　たとい、これを彼等「江戸ッ子」が息を吹き返しつつある一時の現象と見ても、最早非常な立ち後れになっていることはたしかである。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この立ち後れた東亜がヨーロッパまたは米州の生産力以上の生産力を持たなければならない。",
              "citation": {
                "source": "最終戦争論",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい美しい恰好でそれぞれの楽器を熱心に鳴らす音もおもしろく聞かれるために、宮は涙を目にお浮かべになりながら、「打ち捨ててつがひ去りにし水鳥のかりのこの世に立ち後れけん　悲しい運命を負っているものだ」　とお言いになり、その涙をおぬぐいになった。",
              "citation": {
                "source": "源氏物語",
                "author": "橋姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で彼は、立ち後れながらも、あちこちに耕作地を占拠しました。",
              "citation": {
                "source": "土地に還る",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本は、それから立ち後れていったのである。",
              "citation": {
                "source": "図書館協会六十周年に寄せて",
                "author": "――大衆に奉仕する一大組織体へ",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校教育のみでなく、社会教育としての図書館が、いまだ真の意味の民衆のものとしての図書館になっていないことへの奇蹟的立ち後れへの痛感が、これらの企画となったと思われるのである。",
              "citation": {
                "source": "図書館協会六十周年に寄せて",
                "author": "――大衆に奉仕する一大組織体へ",
                "note": "青空文庫"
              }
            },
            {
              "text": "廣く知識を世界に求め、宇内の大勢に立ち後れず、進んでこれに導かうとする以上、世態文明の變遷發展はもとより當然のことである。",
              "citation": {
                "source": "賢所御神樂の儀",
                "author": "羽田亨",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな小さな貧乏な島はなく、島民は文化に立ち後れて、逼迫した生活に悩んでいることを聞かされていました。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この意識は如何に社会によって制約されると考えられていても、制約される意識自身が初めから個人的意識の概念によって制約されているから、社会的という規定はすでにこの意識に加えられるべく余りに立ち後れがしている。",
              "citation": {
                "source": "イデオロギー概論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "処が理論家乃至哲学者はこの委任に役立つにはあまりに不用意であったか、或いはあまりに立ち後れがしていはしなかったか。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代のための進歩的哲学は、この立ち後れを取り戻し、直ちに役立つべき範疇を用意しなければならない。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "――人々は今や、機械論的な確率の概念が如何に科学の進歩に立ち後れたものであるかを知っただろう。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "機械論に於けるこうした困難、特殊科学的認識の実質的な前進に対する哲学の立ち後れは、デボーリン一派の批判に耐えかねて、次第に克服されざるを得なかった。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "「宮崎県は論外として熊本県は万事立ち後れの観がありますよ」　と三輪さんの兄さんが言った。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「然うらしいんだ」「君は立ち後れか？",
              "citation": {
                "source": "求婚三銃士",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんどに限っては、終始、秀吉のほうが何となく、その序戦の前からすべてに立ち後れをとっていたのも事実である。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日民法が改正されて婦人の差別待遇が取り除かれたといっても、それでもまだ実際の社会情勢・日常生活の現実にはたちおくれている。",
              "citation": {
                "source": "人間の結婚",
                "author": "――結婚のモラル――",
                "note": "青空文庫"
              }
            },
            {
              "text": "近世以前には東洋は西洋よりもむしろ高い文明をもっていたのであるが、近世において急速にたちおくれてしまった。",
              "citation": {
                "source": "調査機関",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの点において、東洋諸国は西洋の先進諸国に比して、はるかにたちおくれている。",
              "citation": {
                "source": "調査機関",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "欧米先進国にたちおくれて勃興した、この国の資本主義機構のもとで、殊に欧州大戦を契機として、発展を来した化学工業などの影響をうけた当時の自然科学者は、科学のよるべき世界観などに眼をむける余裕などありえなかった。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれが現実生活での強引な競争に対して、何かたちおくれた弱気な落着の仕方であることだけはたしかであった。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋霧に立ちおくれぬと聞きしより時雨るる空もいかがとぞ思ふ　とだけであった。",
              "citation": {
                "source": "源氏物語",
                "author": "葵",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界は多數の人の自由をますますのばすために統制主義の時代に入つたが、人口多くして土地、資源の貧弱なるイタリア、ドイツ、日本特にドイツのごとき、清新なる氣魄ありしかも立ちおくれた民族は、その惡條件を突破して富裕なる先進國に追つくため、却て多數の人の自由を犧牲にし、瞬間的に能率高き指導精神を採用した。",
              "citation": {
                "source": "新日本の進路",
                "author": "石原莞爾將軍の遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "「魂の技師」として責任ある作家の一人であるゾシチェンコがソヴェト市民の無邪気な意識の立ちおくれを、次第にあくどい嘲弄のための嘲弄の方向へ導いた場合、心ある読者が沈黙していられようか。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "窪川さんから新日本文学会の指導の立ちおくれがいわれました。",
              "citation": {
                "source": "討論に即しての感想",
                "author": "――新日本文学会第四回大会最終日に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳永直は専門家の立ちおくれの克服にふれて、「専門家と現在職場にあるものとが、手を握って共同的にやらなければ」前進的な文学は発展しないと云っている。",
              "citation": {
                "source": "その柵は必要か",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしたちの政治的な能力が低くて、あいまいであったために、民主主義革命そのものの規定についての、立ちおくれた認識にひきずられた。",
              "citation": {
                "source": "人間性・政治・文学（１）",
                "author": "――いかに生きるかの問題――",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、この現象を日本におけるプロレタリア文化運動全般から観察すると、そこにわれわれは、実にはっきりと階級的文化活動における婦人に関する分野の一般的立ちおくれを見ることが出来る。",
              "citation": {
                "source": "国際無産婦人デーに際して",
                "author": "――作家同盟各支部に婦人委員会をつくれ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "くわえ楊子のほろ酔い気分でブラリといまその家を立ちいでて来たところだから、乾雲の一行、まさにひとつ出鼻をどやされた形で、ちょっと立ちおくれざるを得なかった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学の立ちおくれということは、単純でない理由をもっているから、或意味でおくれているのが本当ながら、しかし本質が非常に弱ったものの上におかれているとき、文学のおくれは実にひどいことねえ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
