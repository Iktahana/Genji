          "literary": [
            {
              "text": "約言すると、彼女は戯れ笑うときは一個の快活な少女だった。",
              "citation": {
                "source": "五階の窓",
                "author": "合作の四",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　竇の戯れ笑う声がまだおわらないうちに、一人の宮女があたふたと走って来ていった。",
              "citation": {
                "source": "蓮花公主",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "その戯れ笑う声が毎日のようにやかましく室の中から漏れていたが、王は馬鹿な悴が可愛いので嫁を叱ることができなかった。",
              "citation": {
                "source": "小翠",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
