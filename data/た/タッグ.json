          "literary": [
            {
              "text": "だが出ようとする男をグレグソン、レストレード、ホームズが猟犬スタッグハウンドよろしく飛びかかった。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の蛙の話みたいに、今度は人間を犬扱いにすると憤慨する向きもあるかも知れないが、米国の兵隊は自分達がつけている認識票のことも「ドッグ・タッグ」と呼んでいるので、別に我々を侮辱したのではない。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "値段のタッグが残っている。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
