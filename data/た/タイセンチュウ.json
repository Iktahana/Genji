          "literary": [
            {
              "text": "あれは対戦中の右翼小説ほどひどくは無いが、しかし小うるさい点に於いては、どっちもどっちというところです。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに元和元年、大坂方と対戦中に、「群書治要」を刊行させてゐる。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "一五二六年（大永六年）のクリスマスには、堺市の内外で長年、対戦中の三好党と松永党の両軍が、まる二日間、休戦を約した。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
