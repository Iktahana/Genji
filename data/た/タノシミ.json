  {
    "uuid": "aa59c8f6-22ef-59dc-83c7-87c01ead8818",
    "entry": "タノシミ",
    "reading": {
      "primary": "たのしみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オトウサンガ、キュウシュウヘ、ユクノデ、ワタシハ、オマエノトコロヘ、ユクカモシレマセン、タノシミニ、マッテイナサイ――母よりの手紙。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハト、マメ、コマ、タノシミニマッテイナサイか！",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハト、マメ、コマ、タノシミニマッテヰナサイか！",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よくよくバカだな、この女は」　と寒吉はタンソクしたが、また、可愛い女だと毎朝の訪問が目当てのちがうタノシミになるというダラシのない有様になった。",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからがタノシミだと仰有るのですか。",
              "citation": {
                "source": "影のない犯人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その体力には自信があるなア」　ちかごろは鏡を見るのがタノシミだ。",
              "citation": {
                "source": "影のない犯人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この借金を撃退するのが、また彼の後日のタノシミなのである。",
              "citation": {
                "source": "文化祭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オタノシミだねえ、ハハハア、なんて、ニヤニヤ三時間も腰を上げないんですよウ。",
              "citation": {
                "source": "お魚女史",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "これから東京へ帰って、現像がオタノシミだよ。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "支払う筈のない旦那方に、必ずや支払わせてみせるというタノシミが生れてくるのですな」「そんなの、ヤセ我慢の屁理窟よ。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをきかせてもらうのをタノシミにやって来たのだが」　八雲医師は、ちょッと意外の顔だった。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "フグの日は、マコで一パイやるのがタノシミでね。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "呉八段も今度例の神様からはなれたので、この座談会では気軽に神様の話もできるだらうと、私はそれをタノシミにしてゐたのである。",
              "citation": {
                "source": "勝負師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オタノシミのことですよ」「兄さんは、ねた？",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヌキかトラか、ただのネズミか知らないが、オレは長さんの正体を見とどけるのがタノシミさ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "人為的なタノシミを発見すること。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "何を言わせるにしても大きにタノシミのある話だ」　津右衛門の霊が何を言っても天鬼にカカワリのないことだから、彼は甚だクッタクがないが、当事者には薄気味わるい話である。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "東太成人せば、と、その日をタノシミにすることができたのは、思えば短い年月であった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事の終りに、ユデタコのように赤くなった木々彦が一同によびかけて、「私はちかごろコクリサマという術を会得したから、皆さんに教えてあげたいと思うが、英信さん、あなたは特に学のある人だから、あなたの学がこの魔法をどういう風に解釈するかそれを承るのがタノシミなのさ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰が犯人か、それは明日までのオタノシミ」　新十郎は二人をのこして行ってしまった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "月々貸した金の利息をとりに行って、その日はゆっくりとたゞで傾城の部屋へ坐っていろ／＼と女の話をしたり、手や膝がふれるとか、まアなにかのハズミでいろいろ思わぬタノシミができるであろう。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十　冷笑鬼",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゼゲンと云ったって、本職は炭焼だかキコリをしているウスノロじみた小男ですが、山から山を猿のように渡って歩く妙な早業があって、山奥の村を歩いて女を見て歩くのが人生のタノシミなんだそうですよ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十二　愚妖",
                "note": "青空文庫"
              }
            },
            {
              "text": "大食のオタツはいくら食っても食い足りないらしく、ナガレ目の食物を荒して何かとまきあげて食うのがタノシミらしかったそうだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十二　愚妖",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛭川さんは自分の思いつきですから、読むのをタノシミにその古文書を自宅へ持ち帰った。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーカミイナリは西はずれの秩父との郡界のところに在るのですから、郡内では一番遠い距離に当るのですが、それを物ともせずに出かけたのだから、大そうタノシミにしておられたのです。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "一とまとめでは味もタノシミもないし、第一、全部一とまとめに渡すとなると、とかく善人どもという奴、策をかまえて、手紙の束をまきあげておいて引き換えの金をくれないことが起りがちだが、一束そっくりまきあげられて残りの証拠がないから、もうインネンがつけられない。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "コヤツらは棺桶のフチからまだ足のはなれたガサツ者でタノシミがない悪タレどもだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二十　トンビ男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして一週間目に、あなたと語り合う日が、実にたまらないタノシミですね。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二十　トンビ男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギャングの金のつきるまでお酒をのませてもらえるタノシミが減ったのは遺恨でした。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうことを賭けるのが、職業のタノシミというものですよ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
