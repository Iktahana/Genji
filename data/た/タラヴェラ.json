          "literary": [
            {
              "text": "彼女が自動車から転がり出たとき、タラヴェラ・デ・レイナの闘牛場で、ホウセリトは血と砂にまみれて息を引き取った。",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェリントンはタラヴェラやヴィットーリアやサラマンクなどの昔の戦友たる部下に叫んでいた、「諸子よ！",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "その非凡なる騎兵は、タラヴェラおよびバダホースの戦いに臨んだことのあるクリントンをして色を失わしめた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
