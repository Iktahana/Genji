          "literary": [
            {
              "text": "一貫シタル十年間ノ教育ハ、其ノ終了ト同時ニ完全具足シタル男女タルベク、更ニ其ノ基本ヲ以テ各其ノ使命的啓發ニ向ツテ進ムヲ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "平民自身モマタ奴隷タルベクコノ世ニ生レ出デタルモノニシテ、人格ト権利ヲ没却セラレテモ、之ヲ甘ンジテ屈従スルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ分ニ候ヘバ、侍ノ冥加アリテ、長久タルベク候。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
