[
  {
    "uuid": "c5670728-256c-5408-a32b-3cb29b3d8f83",
    "entry": "たとえ話",
    "reading": {
      "primary": "たとえばなし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
