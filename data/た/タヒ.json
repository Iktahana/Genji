[
  {
    "uuid": "724bbede-673d-59b8-a54f-d38ed416ef63",
    "entry": "多脾",
    "reading": {
      "primary": "たひ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
