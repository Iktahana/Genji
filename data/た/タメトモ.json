        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「タメトモって云いやしなかったこと？",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥サンが岡田の人で、タメトモ心を起しましてな」という話であった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "内地から来た旅行者がアンコの情にほだされ、天下の大事を忘却して島に居ついてしまうのを「タメトモ心ヲ起ス」という由である。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "島にはタメトモが多いそうだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "タメトモの暮しよいところらしいが、ヨシナリ君は特に優秀なタメトモらしいや。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "拙者もはやくタメトモになるべきであったな。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなうたてやな、はタメトモかね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも全般にわたってタメトモの住みよい島にできてるようである。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、旅行者というものを、常に一時的に自分のタメトモにするだけの何かが必要なのだね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "まア、ゴーガンはタヒチのタメトモには相違ないが、しかしタヒチのゴーガンから我々が感じるものは、彼がそこで土人の女と結婚したというタメトモ的なことではなくて「旅」ですよ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
