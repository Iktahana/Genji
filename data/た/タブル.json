        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "よきあしきをいわず、ひたぶるに古きを守るは、学問の道には、いうかいなきわざなり。",
              "citation": {
                "source": "人の言葉――自分の言葉",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、その時は自分でも身に覚えて、がたがたぶるぶると震えてましてな、へい。",
              "citation": {
                "source": "遺稿",
                "author": "遺稿",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひたぶるに嬉しからまし世の中にあらぬ所と思はましかば　と姫君は書いた。",
              "citation": {
                "source": "源氏物語",
                "author": "東屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひたぶるに、祈祷を淨樂として、一念これに醉ひぐれたれば、精舍のつめたき床にたちても、膝より下の、ふくだみて、全身、石柱をあざむくに至るまで、ひるまざりき。",
              "citation": {
                "source": "一僧",
                "author": "トゥルゲニエフ　Ivan Tourguenieff",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョン・フェリアは、やるならひと思いに殺してくれ、じわじわと心をいたぶるような真似は勘弁してくれ、と思う。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "見るがまに焼酎の泡しぶきひたぶる歎くそが街よ、立てつづく尖屋根血ばみ疲れて雲赤くもだゆる日、悩ましく馬車駆るやから霊のありかをぞうち惑ひ窓ふりあふぐ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰りきてわれはきく、ひたぶるに君抱くとき、手力のほこりも尽きて弱心なやむひととき、たちまちに心つらぬく赤き子の高き叫を。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はたやオゾンの香のしめり、渦巻き縺れ、昼も、夜も、間なく、時なく、ひたぶるに暈めき、醸す死の恐怖、列ね立てたる柱には、『触るる者かく死すべし。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "『……かなしきその日の接吻にも、　　　　　　　さまたげ難かる「我」のほこり、　　ひたぶる抱きて涙すれど恐怖と苦悩の………』さあれなほものうき砥石。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "もそろもそろに滞る鉛の電車、一片の命の紙と蝋づけの薄葉鉄の人を吊るしつつ、黒き煉瓦の息づみにひたぶる咽ぶ輪のほめき。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "反歌春｜天城雪の鎮めと伊豆びとは何をもて遊ぶ歌をもて遊ぶ神業ぞ雪祭神業ぞ雪祭、鬼の子の出でて遊ぶは、ひたぶるぞ雪の上の田楽、鎮みこそ四方に響くに、まことのみぞ神と遊ぶに、おもしろとこれをや聴く、をかしとよそをや笑ららぐ。",
              "citation": {
                "source": "黒檜",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにあり、土のうへ、ひたぶるにねむる人。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "突撃、突撃するもの、ひたぶる、ひたぶるなり、生死無し、邪無し、戦ひ、戦ひ恍れ、突き刺し、たたき斃し、声のみ、息あるのみ、我あり、跳ぶあるのみ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "突撃、突撃するもの、ひたぶる、ひたぶるなり、生死無し、邪無し、戰ひ、戰ひ恍れ、突き刺し、たたき斃し、聲のみ、息あるのみ、我あり、跳ぶあるのみ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "反歌米を買へば金は忘れて金を置けばまたも忘れつこれの米の玉犬と鴉一犬の子に白き飯皿、子鴉に青き飯皿、朝夕に同じ飯盛り、おのがじじ食せよと呼べば、犬の子は己が飯惜しと、子鴉は己が飯惜しと、犬の子は子鴉が飯、子鴉は犬の子が飯、ひたぶるに奪ひ取らむと、ひたぶるに盗み食さむと、ただ啼きつ吼えつ噛みつす。",
              "citation": {
                "source": "雀の卵",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "男ごころよひたぶる恋ふと、下ふかく燃ゆる思の、えは堪へね、なほし堪ふると、遊びつつ遊び彫りけむ、くるしくも寂びて寂びけむ、外には見せずも。",
              "citation": {
                "source": "風隠集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "畚に盛り山をかつぐといにしへは笑ひぞめきぬ神楽囃子に里神楽｜笑らぎ浮かるとよく跳ぬる毛脛の本を見らく愛しもこを見よ笑へ笑へとをどりをり笑へざりけりひたぶるなるはおもしろくなつて、今度はこちらも飛び出した。",
              "citation": {
                "source": "海阪",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬と鴉一犬の子に白き飯皿、子鴉に青き飯皿、朝夕に同じ飯盛り、おのがじじ食せよと呼べば、犬の子は己が飯惜しと、子鴉は己が飯惜しと、犬の子は子鴉が飯、子鴉は犬の子が飯、ひたぶるに奪ひ取らむと、ひたぶるに盗み食さむと、ただ啼きつ吼えつ噛みつす。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "男ごころよ、ひたぶる恋ふと、下ふかく燃ゆる思の、えは堪へね、なほし堪ふると、遊びつつ、遊び彫りけむ、くるしくも寂びつつ寂びけむ、外には見せずも。",
              "citation": {
                "source": "篁",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "尻振りざまのをかしさよ、そのペタル縮まりて玩弄品のごとく今は早や踏むにも堪へね、ひたぶるに走り廻れり。",
              "citation": {
                "source": "緑の種子",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネズミをいたぶるネコのような話し方は、高志の十八番だが、慶一には、それがだんだん鼻についてきた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度、十年前憶えたヴェルレエヌの句そのまま、「秋の日のヴィヲロンの、溜息の身にしみて、ひたぶるにうらがなしい」気持に充されながら。",
              "citation": {
                "source": "十年",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "由兵衛はそれを匂わせて、幾らかいたぶるつもりで来たのだ。",
              "citation": {
                "source": "虎",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "住職に対する同情か、或いはこれを枷にして今後の飲み代をいたぶるつもりか、彼は死骸の始末を自分に任せてくれと云って、佐藤の屋敷から中間の鉄造を呼んで来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "白蝶怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "松の前が、鶴の前が生き永らえていたらまた思うようもあるが、今はただひたぶるに、俊寛を死んだものと世の人に思わすようにしてくれ」　そんな意味をいった。",
              "citation": {
                "source": "俊寛",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
