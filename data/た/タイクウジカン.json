          "standard": [
            {
              "text": "模型飛行機の滞空時間は、驚くほど長かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この新しいドローン設計の滞空時間を測定する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ヘリコプターの最大滞空時間は、燃料容量によって制限されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "これ飛行機の滞空時間が長くない事が第一の原因である。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "滞空時間六十三時間二十五分をもって二十日午前八時、加奈陀ヴァンクーバーの飛行場に到着し、征空一万二千キロの新記録を樹立した。",
              "citation": {
                "source": "地底獣国",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
