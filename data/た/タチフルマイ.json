        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "旅立つ息子を送り出すために、近所の人々を招いて盛大な立ち振る舞いを行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昔の風習では、村を離れる際に「立ち振る舞い」として食事を振る舞うことがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "立ち振る舞いの席で、友人たちは彼の前途を祝して乾杯した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
