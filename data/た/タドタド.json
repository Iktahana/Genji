        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "忽ちドタドタドタと椽側を駈けて来る音がする。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと一所に舞い姫の姿はすっかりどこへかフッと消えてしまって、あとにはただ玉雄と照子と二人だけ残りました……………………と思う間もなく、太陽の光りに照らされた雪の塔は見る見るうちに溶け出して、ユラユラと二三遍動いたと見る間に、根元からドタドタドタと一度に崩れ落ちてしまいました。",
              "citation": {
                "source": "雪の塔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドタドタドタと梯子段に尻餅をつきながら転げ落ちてゆくような音、そして、「ウーム」　という呻り声。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その娘は素早く朝子をかわして、ドタドタドタ、階下へ駈け降りた。",
              "citation": {
                "source": "一本の花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほかの三人は、字はタドタドしいが、裏がえしの文字はない。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しきりに物に突当るし、その手さぐりのタドタドしさ、何倍の長時間を要して普請場をようやく通りぬけて行く。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "逃げるときのタドタドしい足どりとは打って変った素早さ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎之介は新十郎のタドタドしい捜査方針が甚しくあきたりないらしく、「重二郎の妾宅なんぞでムダのやりとりをしなくッたッて、心眼で、ピタリ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "憎くは無えが――（と、老農夫に間々ある黙狂と言つたふうの、タドタドしい、すこし辻つまの合わぬような調子で）死ぬよりつらいんでやす、ばさま。",
              "citation": {
                "source": "ぼたもち",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギャァと、すぐに、男の叫び聲がして、あとは、ドタドタドシンと――壕の中にいると、まるで頭の上に、入り亂れる足音が、地響きを打つて聞える。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ドタドタドタと土間をよろけて行き、ヒィッと言って、ドシンとあお向けにひっくりかえる）金吾　……（さっきから、我慢に我慢をしていたのが遂に激発する）春子さまに対しておめえ何をするだ！",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつ迄でもあとのくるまで閉めッ放しにしておけ」　さらに憎さげに隠居はいい放って、「お前っちが上がるよりゃア御簾のほうがよっぽどましだ」　そのまんまドタドタドタと木戸のほうへと足音荒くいってしまった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラガラガラガラン、バリバリドタドタドタドタンピシーン。",
              "citation": {
                "source": "圓太郎馬車",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "その遺書を取上げると、遺書の下、疊の上には血飛沫があり、遺書は粗末な半紙に、提灯屋風に、タドタドしい筆蹟でなすつたもので、その文面は、おくがたはじめ、三人もころしたのは、みんなおれのしわざだ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美しき人質",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに、屋根裏を獣がかけまわるような、すさまじい音が、ドタドタドタ響きまわった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドタドタドタという足音が、嵐のようにくずれ去る、御方は衂られた小太刀を振って一散に追いかけ斬りかけて行った。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小童の鬼面におどされたとは知らず、伊兵衛もスッカリうろたえて、「ちぇッ、何をしやがる」　振り払うや、無我夢中、右手の短刀で縦横に暗を斬りながら、ドタドタドタと石神堂からころがり出す。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドタドタドタと松兵衛のそばへ真ッ蒼になって飛んできたのは手代の新吉。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いざ、急ぎましょうず」　宗良親王についていた中院ノ貞平、四条隆資なども、宮同様なタドタドしい足どりだったが、とにかく笠置をさして、ひたぶる歩いた。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫くすると、鉛筆がタドタドしく動いて、又別の仮名文字が記された。",
              "citation": {
                "source": "妖虫",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
