          "literary": [
            {
              "text": "八朔にも、端午にも、上巳にも、同樣な意味を示す棚飾りと、異風を殘した地方がある。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "霊棚をつくり、苧殻を焚いて、古いしきたりのようにして迎えてやったらどんなによかろうと思うのだが、棚飾りのようすがぼんやりと思いだせるだけで、細かい手続きはなにひとつ知っていないのが口惜しかった。",
              "citation": {
                "source": "黄泉から",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
