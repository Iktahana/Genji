        "examples": {
          "standard": [
            {
              "text": "連休中の観光地はどこも人で立ち込み、歩くのもままならないほどの混雑ぶりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "開店セールに長蛇の列ができ、店内はあっという間に客で立ち込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "通勤時間の駅のホームは、電車を待つ人々で不気味なほど立ち込んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "土用の最中でも、水へ立ち込むと、ひやりとする。",
              "citation": {
                "source": "利根の尺鮎",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その場合における必要、不必要などから離れて私は釣り場へ行くと、流れに立ち込む癖がある。",
              "citation": {
                "source": "瀞",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "五間もある長竿で、一歩踏み誤れば溺れねばならないほどの奔流へ、胸のあたりまで立ち込む利根川の釣りは楽しみよりも苦しみであろう。",
              "citation": {
                "source": "想い出",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」さらばとばかり夕浪も咽ぶ恨のせゝらぎや霧たちこむる谷川は跡見返れどかひぞなき浮世の秋ももろともに流れ／＼て末遠く。",
              "citation": {
                "source": "天地有情",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "とかくして時も移る程に、はや祇園会も初まる時分に候、いざ／″＼御供仕らんとて、又件の鳶の羽に打乗て、虚空をさして飛けるが、刹那がうちに、祇園の廊門のうへにぞ落着ける、まこと神事の最中なれば、都鄙の貴賤上下、東西南北は充満して、人のたちこむこと家々に限りなくぞ見えにけり。",
              "citation": {
                "source": "五右衛門と新左",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "驟雨驟雨そゝげば新墾の、　　　　まづ立ちこむるつちけむり。",
              "citation": {
                "source": "文語詩稿　五十篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "木の葉半ば落ちて大空の透かし見らるる林を秋霧立ちこむる朝｜訪わばいかに心騒がしき人もわれ知らず四辺の静けさに耳そばたつるなるべし。",
              "citation": {
                "source": "わかれ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "三つの川の巴を描くところ、狭霧立ちこむるあの北備の別天地。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘆の枯葉蘆の枯茎蘆の枯穂ももろともにそよげる中の水たまり短き日あし傾きて早や立ちこむる夕霞遠き眺のけぶれるに水のたまりに黄昏の名残の空のたゞよへる鏡のおもに星一ツ宵の明星唯一ツ影あざやかに輝きぬ。",
              "citation": {
                "source": "枯葉の記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘆の枯葉蘆の枯茎蘆の枯穂ももろともにそよげる中の水たまり短き日あし傾きて早や立ちこむる夕霞遠き眺のけぶれるに水のたまりに黄昏の名残の空のたゞよへる鏡のおもに星一ツ宵の明星｜唯一ツ影あざやかに輝きぬ。",
              "citation": {
                "source": "枯葉の記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大阪のごとく、煙の立ちこむる都にてはいみじく美しき恋は遂げらるべくもこれなく候。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            }
          ]
        }
