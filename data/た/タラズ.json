        "examples": {
          "standard": [
            {
              "text": "彼の努力は、成功には少々足らずだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "準備期間が足らず、発表は延期された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "資金が足らず、新しい事業計画は頓挫した。",
