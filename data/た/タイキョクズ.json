        "examples": {
          "standard": [
            {
              "text": "道教の寺院の正面扉には、陰と陽を表す太極図が金色で彫り込まれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "武道の道場の壁に飾られた太極図は、対立するものが互いに補い合うという思想を象徴している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "易経の講義で教授は太極図を指し示しながら、陰陽の相互依存について説明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "即ち『参同契』的の香気が、河図洛書の説、太極図説、先天図などの幽玄思想を宋学へ導入するのに役立ち、それが朱子の静坐持敬の論に流れているのである。",
              "citation": {
                "source": "古代東洋への郷愁",
                "author": "――『仙書参同契』の解説――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
