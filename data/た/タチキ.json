    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ユーゴーの或る小説で、死刑の宣告を受けた男が、ギロチンといふ仏蘭西語のスペルの一字一字が、断頭台の組立木片のやうに見えることを書いているが、欧洲大戦の時、独逸飛行船の空襲を受けたロンドン市民は、ツエツペリンといふ綴字そのものから、直覚的に悪魔を表象したといふことである。",
              "citation": {
                "source": "名前の話",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "火が、ぴしぴし、音を立てて、盛に燃え出すと、樺の立木の葉が、鮮やかに、油紙の屋根に印して、劃然とした印画が炙り出される。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "町外れから、曲り拗ねった路や、立木の暗い下を迂路ついて、与平治茶屋まで来た。",
              "citation": {
                "source": "雪中富士登山記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪い雲が低く傾いて、その欠け間から月を見せる、立木の腹が、夜光の菌でもあるように、ボーツと白く明るくなった。",
              "citation": {
                "source": "雪中富士登山記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "『胸算用』には「仕かけ山伏」が「祈り最中に御幣ゆるぎ出、ともし火かすかになりて消」ゆる手品の種明かし、樹皮下に肉桂を注射して立木を枯らす法などもある。",
              "citation": {
                "source": "西鶴と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "平家ながら天井が、高い処に照々して間数十ばかりもござりますのを、牛車に積んで来て、背後に大な森をひかえて、黒塗の門も立木の奥深う、巨寺のようにお建てなされて、東京の御修業さきから、御子息の喜太郎様が帰らっしゃりましたのに世を譲って、御夫婦一まず御隠居が済みましけ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "道で見た二三本の立木は、大きく、不細工に、この陰気な平地に聳えている。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この蒙古方面から疾駆して来る風は、立木をも、砂土をも、家屋をも、その渦のような速力の中に捲きこんで、捲き上げ、捲き散らかす如く感じられた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこらの林や、立木が遠い山を中心に車窓の前をキリ／＼廻転して行った。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "亀井戸の金糸堀のあたりから木下川辺へかけて、水田と立木と茅屋とが趣をなしているぐあいは武蔵野の一領分である。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦しいのか、面目ないのか、立木につながれた彼は眼を瞑じたまま俯向いていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鬼娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸にしては大きい立木が所どころ繁っている。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生地は紋綸子の黒地を、ほとんど黒地を覗かせないまで括り染の雪の輪模様に、竹のむら垣を置縫いにして、友禅と置縫いで大胆な紅梅立木を全面に花咲かしている。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "地平の線には立木の林が陽を享けて薄の群れのように光っている。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "親という字は、立木に見るという字を書きますな。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご両親はああ見えていても油断なく、立木のような高いところから息子さんのあなたさまを見張っていらっしゃるんですぞ。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "字々の部落は立木に囲まれながら処々に塊まっています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あちこちの松の立木が軽く緑を吹きつけたように浮いている。",
              "citation": {
                "source": "高原の太陽",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人独り居るは好ましきことに非ず、余は他の室に乗換へんかとも思つたが、思い止まつて雨と霧との為めに薄暗くなつて居る室の片隅に身を寄せて、暮近くなつた空の雲の去来や輪をなして回転し去る林の立木を茫然と眺めて居た。",
              "citation": {
                "source": "空知川の岸辺",
                "author": "國木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして、下界との一切の交通を絶ってしまった佐助は、冬眠中の蛇を掘り出して啖うと、にわかに精気がついたその勢いで、朝に猿と遊び、昼は書を読み、夕は檜の立木を相手にひとり木剣を振うている内に三年がたち、アバタの穴が髭にかくれるほどの山男になってしまった。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "立木觀音で艇を出でゝ、立木をきざんだ本尊の古拙ではあるが面白い像を見、勝道上人の所持であつたといふ傳の刀子だの錫杖だのを見た。",
              "citation": {
                "source": "華嚴瀧",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝母は風呂場から引きずり出して裏の立木に縛りつけた。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の借家の庭には、柏やもみじや桜や芭蕉や、そんな数本の立木がある。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "春から青葉の候にかけて、それらの立木の姿は美しく、私はそれらが見える所へまで病床を移して楽しんでいた。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをある時母がそれらの立木の枝々を、惜し気もなく見るもむざんなまでに刈り払い、ある木のごときは、ほとんど丸坊主にされてしまったのだ。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "母とても立木を愛さぬのではない。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこは廣くて子供のためにはいい遊び場だし、立木が多くていい蔭もあるし。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　立木の多い庭園が緩やかな丘に沿って広がり、頂上は深い緑に覆われた森になっていた。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            }
          ]
        }
