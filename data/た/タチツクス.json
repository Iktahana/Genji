    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to keep standing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "恋人に別れを告げられた彼は、雨の中、去っていく背中を見送って立ち尽くした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "荒れ果てた故郷の姿を目の当たりにして、言葉を失い呆然と立ち尽くす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "誰もいない深夜の校庭で、彼は独り夜空を見上げて立ち尽くしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "生まれる前に別れたわが子に三十年後にはじめてめぐり会った人があったとしたら、どんな心持ちがするものか、それは想像はできないが、それといくらか似たものではないかと思われるような不思議な心持ちをいだいてこの絵の前に立ち尽くすのであった。",
              "citation": {
                "source": "庭の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子　いえいえ、少しも云い憎いことはない故に、ありのままを申しておくれ（使女二人は困却せる風にて立ち尽くす。",
              "citation": {
                "source": "レモンの花の咲く丘へ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めて見る本物の鯨に、健一は息を呑み、そのあまりの大きさにただただ茫然と立ち尽くすより他なかった。",
              "citation": {
                "source": "くじらようかん",
                "author": "澤西祐典",
                "note": "青空文庫"
              }
            },
            {
              "text": "立ち尽くす雲の中に、本物の黄蛾がおり、その姿は小さな毛虫で、脂ぎった体に、眼が突き出ている。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私が初めて東洋における白人支配の虚しさ、くだらなさを把握したのは、まさにこのライフルを持って立ち尽くす瞬間だったのだ。",
              "citation": {
                "source": "象を撃つ",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぎこちなく立ち尽くす様子は、場違いで、周囲の豪華さに畏れ多いかのようだった。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "奇妙な笑みがザリの口元に浮かび、じっと立ち尽くす姿は黒い銅像のよう。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、立ちつくす者が創造の喜びを手にしえないことも、松本には明らかだった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがいったん記録されたものはそれ以降は姿を変えることがなく、思いを受け取る側は、ただ受け身で表現の前に立ちつくすしかないという点では、新しいメディアも古いメディアと変わるところはなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "与謝野晶子訳『源氏物語』の提供申し入れもあって、こうした大量のファイルをどうやって校正し、公開に結びつければよいものか、呆然と立ちつくすような気分を味わった。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "ライダーは引きつった顔をして、石をにらみつけたまま立ちつくす。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は茫然と立ちつくすのみであった。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "營庭の老木の櫻過ぎにけりわれは立ちつくす光る眞土に立ち待つと心澄みゐる晝さなか兵あらはれて來り列竝むわが前に歩兵第三聯隊竝び立ち隊歌うたふと聲大いにあがる葉ざくらは風やや強し耳とめて宮の御聲を聽きまつらくは夜宴あり。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "公園のけふのひと日を立ちつくす男の手より、かすり絵板はひるがへり、黄なる日に暫しかがやく。",
              "citation": {
                "source": "浅草哀歌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "営庭の老木の桜過ぎにけりわれは立ちつくす光る真土に立ち待つと心澄みゐる昼さなか兵あらはれて来り列竝むわが前に歩兵第三聯隊竝び立ち隊歌うたふと声大いにあがる葉ざくらは風やや強し耳とめて宮の御声を聴きまつらくは夜宴あり。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "半蔵はそのめっきり冬らしくなった空をながめながら、自分の二十五という歳もむなしく暮れて行くことを思い、街道の片すみに立ちつくす時も多かった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "四人の少年は、声もなく大谿谷の美にうたれて、時間の過ぎ行くもしらず塔上に立ちつくすのであった。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬辺より春も笠きて立ちつくす山田の曽富騰花を守れかし春風三首。",
              "citation": {
                "source": "禮嚴法師歌集",
                "author": "與謝野禮嚴",
                "note": "青空文庫"
              }
            },
            {
              "text": "なべてこれらのものは、僕が立ちつくすたびごとに、僕の身辺に寄り添おうとしてくるのであった。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　信子は眼を大きくし、口を少し開いて、言葉もなく立ちつくす。",
              "citation": {
                "source": "母親",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やっぱり島だ」「うん、島だ」「四方が海だ」「島だからゆきどころがなくなって死んだのだ」「ぼくらもだめかなあ」　ぼうぜんと立ちつくす三人をはげまして、富士男は洞穴を出て、もとのぶなの木の下にきて地をほり、ていねいに白骨を埋葬した。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらくは消防夫が喞筒で硫酸を撒いても、すでにアドルフ・マンジュウを瞥見するためには死を賭して来ている彼女らは、びくともしないで立ちつくすことであろう。",
              "citation": {
                "source": "踊る地平線",
                "author": "黄と白の群像",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした無限定の前に茫然と立ちつくすような真似をしないためには、同じ意欲でも指導力でも行動でもいいから、文芸以外の領域をも含む立場から、決め直さねばならぬ。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして必ず日に一度、彼はその店の筋向いの三角卓子のあるカフェのレコードに聞き惚れて、そこに立ちつくすこともあるからには、その猫の声を味わっていなければならない。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この一個の動かない人体の前に私はいつまでも立ちつくす。",
              "citation": {
                "source": "智恵子抄",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今」「ここに」大衆と共に、歴史を嗣ぎつつあるという満ちたりたる感激の中に立ちつくすがごときカットに、私たちはいかに永く飢えていることか。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "……明日もまた、苧殻を焚いておそくまで門に立ちつくすのかと思うと、それを見るのがいまから辛くてなりませんわ」　高山の奥の、こんな月魄の光の中では、平凡なことも詩のように美しく心を搏つのかもしれない。",
              "citation": {
                "source": "生霊",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ややあれば黒鐵の戸の隙すきて物こそ見ゆれ、立ちつくす女人二人細腕あげて、此時そぞろかに、誘はれよれば、こは昔、宴樂のゆふべ、霞｜焚きし瑪瑙の香爐。",
              "citation": {
                "source": "春鳥集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "港におり立って初めて見る都会の風景に目を奪われ、言いしれぬ心細さにただ立ちつくすばかりだった。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "全速力でそのおうちからかけ出ると、見つかるのは外で立ちつくす小動物のむれ――モルモット、ラッテといったネズミたちにリスどもと、ミドリカナヘビっていうトカゲの〈ビル〉くん、モルモットの１ぴきにかかえられててね、ほかにもびんから何か飲ませてやってるのもいたり。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
