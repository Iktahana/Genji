          "literary": [
            {
              "text": "高い竹梯子の上で宙乘をする消防夫の姿が馬車の上から見えました。",
              "citation": {
                "source": "幼き日",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "周三は、土藏の横手に掛けてあつた竹梯子を外して、二階の窓へ掛け渡した。",
              "citation": {
                "source": "天國の記録",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "追廻しが三、四人飛び出して行って、竹梯子に鳶口、逆目鋸、龕燈提灯などを借りて戻ってくる。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "山王祭の大象",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一度外へ出て土藏の軒下を見ると、この邊と見るあたりに、深々とメリ込んだ梯子の足跡が二つ、間違ひもなくそれは、土藏の軒の下に掛けてある、火事場用の竹梯子で、これならば、隨分役に立ちさうですが、石を運び上げる爲には、矢張り二人以上の男の力を要します。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "正月の香り",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹梯子は元のままになっていた。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
