[
  {
    "uuid": "a662f6cd-87a3-5b89-a28f-a37d2ef77cf4",
    "entry": "他世",
    "reading": {
      "primary": "たせ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
