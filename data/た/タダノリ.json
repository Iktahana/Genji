        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "切符を買わずに電車にただ乗りしたことがバレて、駅員に厳しく叱られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "他人のWi-Fiにただ乗りするのは、セキュリティ上のリスクも大きい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "努力もせずに他人の成果にただ乗りしようとする姿勢は、軽蔑に値する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "木之助はお銭を持っていなかったので、「おれ、一銭もないもん」というと、「馬鹿だな、ただ乗りするんだ」と言った。",
              "citation": {
                "source": "最後の胡弓弾き",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ただ乗り出してみたいの。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車のただ乗りを発明する人と半農主義者とは同じ米を食っている。",
              "citation": {
                "source": "霊的本能主義",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダウンタウンから路面電車にただ乗りして、ワイキキまで来るのさ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
