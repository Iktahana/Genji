        "examples": {
          "standard": [
            {
              "text": "そのような怠怠しき振る舞いは、断じて許されない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、規律を重んじるあまり、少し怠怠しきところがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「主君への仕え方が怠怠しきこと、厳に慎め。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その見え透いた「孤独」や「へんくつ」がやつとわたしには怠怠しい古い日記をひつぺかすやうに過去の雲や霧の中に見えてきて、その根ざすところに不賛成をしたのだつた。",
              "citation": {
                "source": "故郷を辞す",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
