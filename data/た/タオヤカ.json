      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "科学者のＭ君は積分的効果を狙って着実なる戦法をとっているらしく、フランス文学のＮ君はエスプリとエランの恍惚境を望んでドライブしているらしく、Ｍ夫人の球はその近代的闊達と明朗をもってしてもやはりどこか女性らしいやさしさたおやかさをもっているように見えた。",
              "citation": {
                "source": "ゴルフ随行記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "裾を曳いて帳場に起居の女房の、婀娜にたおやかなのがそっくりで、半四郎茶屋と呼ばれた引手茶屋の、大尽は常客だったが、芸妓は小浜屋の姉妹が一の贔屓だったから、その祝宴にも真先に取持った。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　――一昨年か、一昨々年、この人の筆に、かくもの優しい、たおやかな娘に、蝦蟇の面の「べっかっこ。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――一たい狐狸の化けたのは、人間の姿はしていても地に敷く影は正体のままと聞いたが、そなたは影までたおやかな女の影、よほど行亙った化け方と感心して見ていたのさ。",
              "citation": {
                "source": "狐",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度影を隠した銀座の柳は、去年の夏ごろからまた街頭にたおやかな緑の糸をたれたが、昔の夢の鉄道馬車の代わりにことしは地下鉄道が開通して、銀座はますます立体的に生長することであろう。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜなら、すらりとしてたおやかなうら若き美人が夜分遅くにベイカー街に現れ、話を聞いてご助力ご助言くださいましと来たのだから。",
              "citation": {
                "source": "自転車乗りの影",
                "author": "THE ADVENTURE OF THE SOLITARY CYCLIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "外は漸くぽかぽかする風に、軽く砂がたって、いつの間にか芽ぐんで来た柳条が、たおやかに※っていた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "手足のかぼそくたおやかなるは、貧家の女に似ず。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな、たおやかな片足だけが見えていて、地に触れるか触れないくらいであった。",
              "citation": {
                "source": "しめしあわせ",
                "author": "THE ASSIGNATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて若い女が出てきて、スーツ・ケースを持った青年なんて見向きもしないとばかりに、たおやかに歩いていった。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "年も僅かに十五六に見える、袖の長い、髪をおさげにした、たおやかな少女であった。",
              "citation": {
                "source": "蓮香",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大家の庭樹のかげには一本の若竹が伸びて、それに朝風夕風がたおやかに当たって通った。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのたおやかな古文の妙、たとえば真名盤の香を瑰の芳烈なる薫か、ヘリオトロウプの艶に仇めいた移香かと想像してみると、昔読んだままのあの物語の記憶から、処々の忘れ難い句が、念頭に浮ぶ。",
              "citation": {
                "source": "『新訳源氏物語』初版の序",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "」予はたおやかな原文の調が、いたずらに柔軟微温の文体に移されず、かえってきびきびした遒勁の口語脈に変じたことを喜ぶ。",
              "citation": {
                "source": "『新訳源氏物語』初版の序",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁辰の娘お妙――あの、露を持った野百合の花のような、たおやかなお妙のすがたに、人知れず思いを寄せている幸吉である。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしたって、あの大きな黒い顔は、そんな、花やいだ、たおやかさを思わせはしなかったから――　ともかくこの人は、結局女ではなかったのだ。",
              "citation": {
                "source": "明治座今昔",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "その下萌えの片笑靨のわずかに見えたる、情を含む眼のさりとも知らず動きたる、たおやかなる風采のさらに見過ごしがてなる、ああ、辰弥はしばし動き得ず。",
              "citation": {
                "source": "書記官",
                "author": "川上眉山",
                "note": "青空文庫"
              }
            },
            {
              "text": "女史の画中の化政時代の麗人がそこへ浮び出たかと思われるたおやかさであった。",
              "citation": {
                "source": "松園女史の思い出",
                "author": "金子薫園",
                "note": "青空文庫"
              }
            },
            {
              "text": "小柄な体躯をたおやかに、ちょっと欝金色の薔薇釵を気にしながら振り向いて見る。",
              "citation": {
                "source": "駅夫日記",
                "author": "白柳秀湖",
                "note": "青空文庫"
              }
            },
            {
              "text": "……いかにもお美しく、たおやかなお方ですがあまりにもお妬みの心が強く、心変りがするようなことがあったら、お前も相手の女も決して生かしてはおかぬというようなことを、繰返し繰返し仰せられます。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "萩寺の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼少のうちは何事も物珍らしく思われるが、ことに草深い田舎に住んでいると、見る物も聞く物も少ないゆえちょっとしたことも大層面白く思われるもので，母があのように賞めちぎる娘、たおやかな江戸の人、その人と話をする時には言葉使いに気をつけねばならぬという、その大した江戸の人はまアどんな人なのであろうか？",
              "citation": {
                "source": "初恋",
                "author": "矢崎嵯峨の舎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの一種たおやかな風を欠くものであるが、娘はその風をも備えていた。",
              "citation": {
                "source": "初恋",
                "author": "矢崎嵯峨の舎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ皆さん、自分は老年の今日までもその美しい容貌、その優美な清しい目、その光沢のある緑の鬢、なかんずくおとなしやかな、奥ゆかしい、そのたおやかな花の姿を、ありありと心に覚えている……が……悲しいかな、その月と眺められ、花も及ばずと眺められた、その人は今いずこにあるか。",
              "citation": {
                "source": "初恋",
                "author": "矢崎嵯峨の舎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君がたおやかなる腕を取りて共に歩けば、いみじき恋に心楽しきふたり、やさしき四月と麗しき五月との仲よと、道行く人にもわれらは思われぬ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "困窮、淫売、官憲、サン・ラザール拘禁所、そういう所に、あのうるわしい、たおやかな娘らは、あの五月のライラックの花よりもなおさわやかな貞節と温順と美とのもろい宝は、ついに落ちてゆくのだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "四人のうちで幸子と妙子とが父親似であり、鶴子と雪子とが母親似であることは前に書いたが、鶴子の方は背が高く、全体が大柄に出来ているので、顔の感じは京女であるけれども、母が持っていたような繊弱さ、たおやかさに欠けている。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "美青年にも見えるたおやかな凛々しさのなかに、色気とは別物の香気とも言うべきものが、描かれている女性の内部から、絵ぜんたいから漂い出ているように思えた。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "国中に伝えなさい、行く先で歓迎して丁重に扱いなさい」　大いに友好の感情を表わして、みめうるわしい者たちが次々、たおやかに潜水すると、数分後にはまたテルバと三人きりになった。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "――嫋かな女だというから、その容子は想像に難くない。",
              "citation": {
                "source": "古狢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、美しく艶なお局が、白く嫋かな手で、炭びつを取つて引寄せた。",
              "citation": {
                "source": "妖魔の辻占",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
