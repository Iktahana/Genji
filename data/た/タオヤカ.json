    "definitions": [
      {
        "index": 1,
        "gloss": "graceful",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女の嫋やかな所作は、見ている人を穏やかな気持ちにさせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "春風に揺れる柳の枝は、まるで嫋やかな女性の腕のようだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "着物姿の彼女が歩く様子は、非常に嫋やかで美しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "彼処に、尾花が十穂ばかり、例のおなじような兀げた丘の腹に、小草もないのに、すっきりと一輪咲いて、丈も高く莟さえある……その竜胆を、島田髷のその振袖、繻珍の帯を矢の字にしたのが、弱腰を嫋やかに、白い指をそらして折って取った。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「虚無でなければ無限絶対でないにしても嫋やかで魅力が無ければ僕たち人間には訴えて来ません」　規矩男の云うことはだんだん独語的になって、何の意味か、かの女にも判らなくなって来た。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "紺サージの布地を通して何ものかを尋ね迫りつつ尋ねあぐんでいる心臓の無駄な喘ぎを感ずると、何か優しい嫋やかなものに覆い包んで、早くこの若者を靉靆とした気持にさせてやりたい薄霧のような熱情が、かの女の身内から湧きあがった。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五時過ぎて暮ちかき夏の日は血に染みし呼鈴の声のごとくふりそそぎ、嫋やかなる風は蜜蜂の褐色に、蜜蜂のつぶやきはかろく花粉を落す。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十三年七月　　心中あはれなる心中のうはさよりわが霊は泣き濡れてかへりゆく、花つけしアカシヤの並木のかげを、嫋やかなる七月のおとづれのごとく。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはれなる心中のうはさよりわが霊は泣き濡れてかへりゆく、微風の吹くままに過ぎゆく嫋やかなる七月のおとづれのごとく。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "無精で呑気で仇気ない愛嬌があって、嫋やかな背中つきで、恋心に恍惚しながら、クリストフと自分との部屋の境の扉を一旦締めたらもう再び開ける勇気のなかったザビーネ。",
              "citation": {
                "source": "アンネット",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "緑の怒濤のように前後左右で吼え沸き立つのはよいとして、異様な動悸を打たせるのは、竹は嫋やかだからその擾乱の様がいやに動的ぽいことだ。",
              "citation": {
                "source": "雨と子供",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかでも、長身なあなたが、若い鹿のように、嫋やかな、ひき緊った肉体を、リズミカルにゆさぶっているのが、次の一廻り中、眼にちらついています。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "看病婦と申して、どうも婦人の方が手当りが宜しい、男の骨太の手で抱き上げられると痛いが、婦人の嫋やかなむッくりした手や何かですと余程心持が宜いと云います。",
              "citation": {
                "source": "粟田口霑笛竹（澤紫ゆかりの咲分）",
                "author": "粟田口霑笛竹（澤紫ゆかりの咲分）",
                "note": "青空文庫"
              }
            },
            {
              "text": "よくこなれた俗語の適切なる使ひぶりと、よく曲げて嫋やかに撓んで彈力性に富んだ句法とが、互に絡みあつて洗練されて新文體を創めた二葉亭氏の勞力は非常なものであつたらう。",
              "citation": {
                "source": "「あひびき」に就て",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして鼻の孔の正しい輪廓にも、高貴な生れを示す嫋やかさと誇らしさとが見えてゐる。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その葉は浮華な移り気を戒める如く四時青々として緑の色を保ち、亭々と直上した修稈は真直な心を表わし、柔に似て柔ならず、剛に見えて剛ならず、その中庸を得た嫋やかな姿で、それが豪勇な松に配せられて寄り添うているのは剛柔相和して両者誠に相応しく感ずる。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫋やかな、丈長草のやうにいつも地の夢のままになつて、すなほに靡く。",
              "citation": {
                "source": "椰子の樹",
                "author": "ポオル・クロオデル　Paul Claudel",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……竜太郎さん」　暖かな、小さな手がしずかに這いよって来て、細い、嫋やかな指が、すんなりと竜太郎の指に絡みついた。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの嫋やかな手を執り、あの優しい声を聴き、あの夜のようにしっかりと抱き合いながら、その耳へ、（結婚しようね。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、そのほうへ子供のような、小さな、嫋やかな手をさし出した。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "膃肭獣は嫋やかな背を見せて丸くなって眠っている。",
              "citation": {
                "source": "海豹島",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな金剛石の指輪をはめた白い嫋やかな指の間にウイスキー・ソーダのコップを持ちながら、少し反り身になって馬鹿騒ぎを眺めている。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに彼女は海を眺めると、その遠くの方に、ヤンが行つてゐる沖の方を眺めると、生れつき持つてゐた美しい嫋やかな姿をすつきり伸ばした。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがいかにも可哀想に嫋やかに見えるのです。",
              "citation": {
                "source": "不思議な魚",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……貴方のお立場を考えますから、私手をこうやってはいましても」と妻はスタンド台にかけている白魚のように嫋やかな指を動かして見せた。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫋やかな首筋はすんなりと肩へ流れて、純白女神のごとき白絹の綾羅を装うていた。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど昔リヨンで踊り子をしていた時分に、伯爵に見｜初められたというだけあって、水々しい眸、魅力的な潤みを帯びた睫毛、どこか雌豹を偲ばせる嫋やかな脚！",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをあなたへお目にかけましょう」　薙刀の折れでもあるような細い鉈が、彼女の嫋やかな手に振上げられた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――に、ひきかえて、娘の花世は、女性的な上にも女性的な、嫋やかな、可憐な、松の根に咲いた山桔梗にもたとえたいほどに――潔く、ういういしい。",
              "citation": {
                "source": "牢獄の花嫁",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "といって、彼女の嫋やかな腕では、将門の体を、どうしようもない。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、白い手が嫋やかに動いて、雨戸の障子を二尺ばかり押し開けた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "科学者のＭ君は積分的効果を狙って着実なる戦法をとっているらしく、フランス文学のＮ君はエスプリとエランの恍惚境を望んでドライブしているらしく、Ｍ夫人の球はその近代的闊達と明朗をもってしてもやはりどこか女性らしいやさしさたおやかさをもっているように見えた。",
              "citation": {
                "source": "ゴルフ随行記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度影を隠した銀座の柳は、去年の夏ごろからまた街頭にたおやかな緑の糸をたれたが、昔の夢の鉄道馬車の代わりにことしは地下鉄道が開通して、銀座はますます立体的に生長することであろう。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
