        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アルバン、君チャンガ何カニビックリサレタヨウニ、フト目ヲサマシタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイヘン突拍子モナイコトヲ言イ出シタヨウニ思ワレルカモシレナイガ、少シ落着イテ考エテミルナラ、別ニ奇抜ナコトデモ何デモナイコトガワカル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上デ私ノ言イ分ハホボ尽キタワケデアルガ、シカシコノヨウナコトヲ書イタカラトイツテ私ガカタカナ運動デモ開始シタヨウニ思ワレテハ迷惑デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「墨汁ヲ吹イタヨウニ、砲煙ガ波浪ノ上ヲ匐ッテ動キダシタ」　何にも動かぬ。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ頭ト骨ト尾トヲ皿ノ一方ニ片寄セテ、身ヲ一片モ残サズニ猫ガ舐メタヨウニ食ベル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナマメカシイト云ッタライヽノカ、色ッポイト云ッタライヽノカ、己ハ今マデニアンナ妖艶ナ女ヲ見タコトガナイ、妖婦ト云ウノハ正シクアンナ女ノコトヲ云ウンダロウナ、アンナ女ニナラ殺サレタッテイヽト思ッタト、湿ノ父親ハイツモ忰ヲ掴マエテヨク／＼感ニ耐エタヨウニ云イ暮ラシタソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルデ氷ノ中ヘ漬ケタヨウニ無感覚ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "真ッ暗ナ布団ノ闇ノ中デ涙ガ堰ヲ切ッタヨウニパラ／＼パラ／＼ト頬ヲ伝ワル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、昨日モ申シ上ゲタヨウニ博士ハ今マデニ何十人トナクコノ患者ヲ扱イ、コノ方法デ簡単ニ成功シテイルノデ、ソンナ神業ナンテ云ワレル程ノムズカシイモノトハ思ッテイナイ、患者モ格別不安ガッタリ恐レタリシタ者ハナカッタ、皆気軽ニ注射シテ貰イ、直グ良クナッテ大喜ビデ帰ッテ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト、途端ニ博士ハ、「ア、コレハイケナイ」ト、俄ニガッカリシタヨウニ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "郁子ハ近頃酒量ガヤヤ増シタヨウニ思ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
