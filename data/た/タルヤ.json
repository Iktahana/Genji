          "literary": [
            {
              "text": "貴局ノ送受信機ハ何処ヨリ手ニ入レタルヤ」相手「予ガ携帯シ来リタルスーパーヘテロダインハ没収セラレタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ美醜間ニ於ケル眉目ノ寸法配列等ノ差タルヤ極メテ僅少ニ過ギナイ。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何ニシテ之ヲ獲タルヤト問ヒシニ、皆戊辰ノ変、旧家覆滅ノ後、大阪ト横浜トニテ購ヒ得タリ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "則吾ガ為メニ尽候所、則、国家ニ尽ス所タルヤ明カナリ。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十月五日　吉井友実あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "自序に曰く「余カツテイヘラク、詩ノ道タルヤ精ナルヲ貴ビ多ナルヲ貴バズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハ「コロボックル」ト他種族ト混交シテ「エスキモー」ヲ生ジタルヤモ知ルベカラズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハ一大種族ノ一部、先ヅ分カレテ「エスキモー」ノ本ヲ作リ、他部我ガ日本ノ地ニ入リテ「コロボックル」ノ本ヲ作リタルヤモ知ルベカラズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
