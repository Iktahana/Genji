[
  {
    "uuid": "493e272e-3926-51d3-9881-60bde27fadce",
    "entry": "たるや",
    "reading": {
      "primary": "たるや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "表現"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "speaking of ...",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その景色の美しいたるや、言葉では到底表現できないほど神々しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女の怒りたるや凄まじいもので、誰もその部屋に近づくことができなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "合格発表の瞬間の喜びたるや、これまでの苦労が全て報われる思いだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが世間が、不景気だ、ボヤボヤしてはゐられないと云へば云ふ程、インテリにとつてその世間たるや住みにくい世間となる。",
              "citation": {
                "source": "作家と孤独",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで現今精神的渇望だの信念だのの方は微々たるものであるので、所詮現今の社会たるや、卑俗なものといはねばならぬ。",
              "citation": {
                "source": "詩と現代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しその面白さたるや「感覚的」に終止するものであることは争はれない。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "又教養たるや不完全なものだつた。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "而もその不平たるや、独りで文学を思ふ時と、Ｂが面前にある時とだけのものであつて、一般生活、つまり彼の畑に帰れば、あつてなきが如きものでさへあるのだ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前に仮令対策を述べられたとしても、その対策たるや凡そ見当が付くと云へませう。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても我が国婦人の服装たるやなんと脆い感じのするものだらう。",
              "citation": {
                "source": "三等車の中（スケッチ）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、まあどつちにしても好い気持で、而も此の好い気持たるやどうお伝へのしやうもない。",
              "citation": {
                "source": "深夜の峠にて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "所で、私はその愉悦たるや、濃淡の差こそあれ、凡ゆる人間に在ると思ふのである。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "（尤も、その習性たるや、根本的なもので、純粋持続の完全表現は絶対に不可能だといふことに由来してゐる。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、この狸たるや、アルテミス型の少女に惚れる男のごたぶんにもれず、狸仲間でも風采あがらず、ただ團々として、愚鈍大食の野暮天であつたといふに於いては、その悲慘のなり行きは推するに餘りがある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、その水たるや貴重なものである。",
              "citation": {
                "source": "井戸の底に埃の溜つた話",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのマシン油たるや、充分に運転しているジャックハムマーの、蝶バルブや、外部の鉄錆を溶け込ませているのであったから、それは全く、雪と墨と程のよい対照を為した。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "御新造は驚きたるやうの惘れ顏して、夫れはまあ何の事やら、成ほどお前が伯父さんの病氣、つゞいて借金の話しも聞ましたが、今が今私しの宅から立換へようとは言はなかつた筈、それはお前が何ぞの聞違へ、私は毛頭も覺えの無き事と、これが此人の十八｜番とはてもさても情なし。",
              "citation": {
                "source": "大つごもり",
                "author": "一葉女史",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもなお、その普遍性たるや決して絶対的のものではない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "母が心の何方に走れりとも知らで、乳に倦きれば乳房に顔を寄せたるまゝ思ふ事なく寐入し児の、頬は薄絹の紅さしたるやうにて、何事を語らんとや、折々曲ぐる口元の愛らしさ、肥えたる腮の二重なるなど、かかる人さへある身にて、我れは二タ心を持ちて済むべきや。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "みがき立てたるやうの月のかげに尺八の音の聞えたる、上手ならばいとをかしかるべし。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さゝやかなる庭の池水にゆられて見ゆるかげ物いふやうにて、手すりめきたる所に寄りて久しう見入るれば、はじめは浮きたるやうなりしも次第に底ふかく、この池の深さいくばくとも量られぬ心地になりて、月はそのそこの底のいと深くに住らん物のやうに思はれぬ。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの青年たちは、たいてい靜岡や名古屋に住む若い詩人の連中だが、その蒲原氏に對する態度たるや、驚くべく無禮傲慢を極めたものであるさうだ。",
              "citation": {
                "source": "蒲原有明氏の近況を聞いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その度毎に明｜暗、悲喜こもごも至る二人の顏附たるやお察しに任せる次第だ。",
              "citation": {
                "source": "下手の横好き",
                "author": "―將棋いろいろ―",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが大｜概一｜局に一時間乃｜至一時間半、一二度は三時間餘にも及んだことがあるのだが、さう鋭くもなく敢へて奇手｜妙策も弄せず靜かに穩かにもみ合つてゐる光｜景たるやたしかに「櫻かざして」の感なくもない。",
              "citation": {
                "source": "下手の横好き",
                "author": "―將棋いろいろ―",
                "note": "青空文庫"
              }
            },
            {
              "text": "豐島さんのは今はもう忘れてしまつたが、とにかく球突塲といふものはちよつと變つた人｜間的空氣の漂ふもので球の響きの内には時とすると妙に胸底に沁みわたるやうな一｜種の神｜祕感が感じられる。",
              "citation": {
                "source": "文壇球突物語",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも亡くなられるほんの三四ヶ月前に万世｜橋のミカドホテルの球突塲で一｜戰を試みたのだつたが、持｜點も前に擧げた人｜達よりも聊か群をぬいた六十｜點で、その突き振たるや快活奔放、當たるべからずといつた愉快さだつた。",
              "citation": {
                "source": "文壇球突物語",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、ここにも先生の風｜格は現れて、その突き振りたるや悠々｜重厚の感じがある。",
              "citation": {
                "source": "文壇球突物語",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代りその会合たるや極めて古典的で当時温泉に浴してこれを見聞した筆者の無為を慰すること甚大であった。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "物語は皆まことにもあらぬを、おもへば我も彼男に劣らずおろかなる思ひを馳せたるかな、と後に自からあざ笑ひけるも、今またおもへば、それもことさらに我賢からんと願ひたるやうにていよ／＼おろかなることなりけり。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほそまひ雲　布を引きたるやうに白くおだやかに空にわたる雲あり。",
              "citation": {
                "source": "雲のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "かさほこ雲　南の方の天にさしがさを開きたるやうに立つ雲を、かさほこ雲といふとぞ。",
              "citation": {
                "source": "雲のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
