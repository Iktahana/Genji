        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "マラソンを走り終えた選手は、ゴールラインを越えるなり芝生に倒れこんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は帰宅するなり、コートも脱がずにベッドへ倒れこむように寝てしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "爆風を受けた彼は、近くの瓦礫の山に倒れこんで意識を失った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ひとを遊び道具にしてたくせに」　倒れこむようにして、もうひとつのデッキチェアに慶一が躰を沈めた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "小松が幕の中に倒れこむ前、ぎくっと頭をのめらしたが、つまりあれは幕越しに棒かなにかで小松の頭を叩いたんだろう。",
              "citation": {
                "source": "ハムレット",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "両腕を広げ、もう少しで波をなめることが出来そうなほどに倒れこむ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女はその両手のなかへ、たおれこむようにして、博士のひざにすがりつきました。",
              "citation": {
                "source": "怪奇四十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
