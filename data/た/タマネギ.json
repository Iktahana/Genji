    },
    "definitions": [
      {
        "index": 1,
        "gloss": "onion (Allium cepa)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "玉ねぎを飴色になるまで炒めると、カレーに深いコクが出る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "切る時に目が痛くならないよう、玉ねぎを冷やしてから調理する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は玉ねぎが苦手で、ハンバーグの中に入っている微塵切りさえ見逃さない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "年じゅう同じように貯蔵した馬鈴薯や玉ねぎをかじり、干物塩物や、季節にかまわず豚や牛ばかり食っている西洋人やシナ人、あるいはほとんど年じゅう同じような果実を食っている熱帯の住民と、「はしり」を喜び「しゅん」を貴ぶ日本人とはこうした点でもかなりちがった日常生活の内容をもっている。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かえろかえろと何見てかえる、畠の玉ねぎ見い見いかえろ、かえろが鳴くからかえろ。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが或晩、だれかゞその畠へはいりこんで、玉ねぎを十ばかりぬすんでいきました。",
              "citation": {
                "source": "小犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ねぎや馬鈴薯に交じって椰子の実やじゃぼん、それから獣肉も干し魚もある。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋には、肉のあしらひに、玉ねぎが這入る、カイベツ（キヤベツの變名だ）が這入る。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、そこへ、立派な玉ねぎの紳士がやつて来て、ジヤガイモさんに言ひました。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、玉ねぎさんは、朝から遠い道を歩きつゞけて、くたくたにつかれてゐるので、この上歩くことが出来ません。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬さんや、お猫さんならいざ知らず、玉ねぎさんを馬小屋になんぞ泊めたら、いやしんぼの馬が、玉ねぎさんを食べてしまふだらう。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ねぎさんは大変よろこんで、泊めてもらふことにしました。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは、真くらで、何にも見ることが出来ませんでしたので、玉ねぎさんは手さぐりで、小さいベツドを見付けて、そこへ横になるなり、ぐつすり寝込んでしまひました。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、窓ぎはの所まで来ると一緒に、ベツドは、急に、パンとひつくりかへつて、そのはずみに、玉ねぎさんは、窓の外へ投げ出されてしまひました。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ねぎさんは、あつ、と言ふ間もなく、川のなかへ、ざぶんとおつこちて、見てゐるうちに、水のなかへ沈んで見えなくなつてしまひました。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かはいさうに、玉ねぎさんは、野菜の皮を外にすてるために、こしらへてあつた、電気仕かけの箱をベツドとまちがへて、そのなかにはいつて寝てゐたのです。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　　　　　　　　　　　　　×　朝になつたので、ジヤガイモ・ホテルの主人のジヤガイモさんは、地下室へ、パンと紅茶を銀のおぼんにのつけて、来て見ますと、昨日の晩に、とまつた筈の玉ねぎさんの姿は、影も形もありません。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ねぎさんの持つて来たトランクが、のこつてゐるだけでした。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　すると、その日の夕方、ひよつくり、昨日ゐなくなつた玉ねぎさんが帰つて来ました。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言ひましたので、玉ねぎさんは、どんなに、ベツドから川のなかへ落ちたか、そして、どんなに、あわてておよいで岸に這ひ上つたか、そして、岸の上で、新聞の広告をよんだかを話しました。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ねぎさんは笑ひながら言ひました。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、不思議なことに、玉ねぎさんは、ひどく、このジヤガイモ・ホテルが気に入つてしまつて、一生涯、この、ジヤガイモ・ホテルの番頭さんになつて、ジヤガイモさんと一しよに住むことになりました。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それですから皆さん、あなた方のめしあがる洋食で、ジヤガイモのついてゐるお皿には、きつと、玉ねぎがついてゐるでせう。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、二人は大根さんのお友達の玉ねぎさんのお家へ行きました。",
              "citation": {
                "source": "髪床やの大根さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてお父さんが、玉ねぎさんのお父さんの頭を刈つてゐるあひだに、大根さんは玉ねぎさんの頭をはさみで、ぎざ／＼にちよんぎつてしまひました。",
              "citation": {
                "source": "髪床やの大根さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ねぎさんと大根さんはすつかり困つてしまつて、にかわを買つて来て一本一本つぎたしました。",
              "citation": {
                "source": "髪床やの大根さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ねぎさんのお父さんはこれを見てすつかりおこつてしまつて、大根さんとお父さんを門の外へつき出して、「もう、二度と　お前たちには用事はないよ。",
              "citation": {
                "source": "髪床やの大根さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして玉ねぎさんが町を歩いてゐるのを見て、「桑原、桑原。",
              "citation": {
                "source": "髪床やの大根さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてお父さんに、「お父さん、玉ねぎさんの髪の毛が、もとのやうに、伸びたからだよ。",
              "citation": {
                "source": "髪床やの大根さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のためにとっておいた「暁」五袋とキングウイスキー少量、それから野菜は玉ねぎ一貫匁とごぼう二本位、岡東は缶詰四個とバター一｜封度をくれる。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、喉が少しよくなったら、胸に痰がつかえるといって、玉ねぎのおみおつけを食った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他、となかい、こおろぎ、たんてい、たまねぎなど、いろいろあるが、みんな陳腐だ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹さんだけでなく、キントトだって、たまねぎだって、みんなそうなのよ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
