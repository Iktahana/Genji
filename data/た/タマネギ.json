[
  {
    "uuid": "8eb38c49-0d07-5030-967c-acc375e22c4f",
    "entry": "玉ねぎ",
    "reading": {
      "primary": "たまねぎ",
      "alternatives": [
        "タマネギ"
      ],
      "is_heteronym": false
    },
    "grammar": {
