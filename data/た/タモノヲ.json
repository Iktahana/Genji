        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マアー、コトモアロウニ、ジブンタチノ死ンダオ母ッチャニアゲタモノヲ、君チャンヤ弟ヤ妹ガ、ムチウニナッテ、タベテイルデハナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私ハ夜中ニ何ダカ咽喉ニ冷リトシタモノヲ感ジマシタ。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時間がアレバアアイウ者デマトマッタモノヲ書キ度候。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "白ノ一越縮緬ノ裾模様ニ図案化シタ樹木ノ枝ヲ黒ノ濃淡デ現ワシ、周囲ヲ淡イブルーデ影ノヨウニ絵取ッタモノヲ着テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ、無感覚ト云ッタケレドモ、冷エ方モコレホドニナルト、痛ミト似タモノヲ覚エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ先ズ奈良アタリノ絵心ノアル佛工ニ命ジテ、今宮神社ノ四面佛ニ倣ッテ線彫リニシタ勢至菩薩ノ像ニ似タモノヲ描カセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ彼女ハ、モシ僕ガ日記帳ヲ故意ニ彼女ノ眼ニ触レヤスイ所ニ置ケバ、「コレハ私ニ読マセルタメニ書イタ日記ダ」ト思イ、書イテアルヲ聞イテモ、オ前ハ「人ノ書イタモノヲ盗ミ読ミナドイタシマセン」ト答エルニキマッテイルカラ、聞イタトコロデ仕方ガナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
