        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヤガテ　ツヨイ　ヒカリニ　ナレテ　クルト　ナタネノ　花タチハ　アタリヲ　ミマハシテ、木ヤ　ハタケヤ　ミチヤ　イヘヤ　ソラヤ　ミズヲ　ミマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これにはタケヤという小女が係りの女中だ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その五　万引家族",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中のタケヤにきいてみた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その五　万引家族",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケヤはいかにも顔をしかめて、あの男はイヤらしい好かない人物だという表現をするのであるが、その素性については知らない。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その五　万引家族",
                "note": "青空文庫"
              }
            },
            {
              "text": "楠も大方そんなことだろうと同感して特にこだわりもしなかったが、それから二日目、二月五日の午さがりに、用があってタケヤの渡しで向島へ渡り、さて用をすまして渡し舟の戻ってくるのを待つ間、なんとなくドテをブラブラ歩きだすと、また岸の草の中に油紙の包みが流れついているのに気がついた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二十　トンビ男",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンシンバシラヤ、ハタケヤ、モリヤ、イナカヤヤ、ケシキガ　ドンドンウシロヘ　ハシッテユキマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
