[
  {
    "uuid": "c23a6590-f3e2-5805-9047-a56eda9416c6",
    "entry": "竹屋",
    "reading": {
      "primary": "たけや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
