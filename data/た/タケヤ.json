    "definitions": [
      {
        "index": 1,
        "gloss": "bamboo dealer",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古くから続く竹屋では、様々な種類の竹材を扱っており、職人からの信頼も厚い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "竹屋で竹製の茶道具を見てまわった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "竹屋の職人たちは竹細工の技術に優れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "竹屋の渡しを渡船に乗るときには年下の方が柚木に「おにいさん、ちょっと手を取って下さいな」と云った。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "相州小田原の町に電車鐵道待合の、茶店の亭主が言に因れば、土地の鹽辛、蒲鉾、外郎、及び萬年町の竹屋の藤、金格子の東海棲、料理店の天利、城の石垣、及び外廓の梅林は、凡そ日本一也。",
              "citation": {
                "source": "城の石垣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹屋の藤は時節にあらず、金格子の東海樓は通つた道の青樓さの、處で今日の腹工合と、懷中の都合に因つて、天利といふので午餉にしよう、其づ其の城を見て梅とやれ、莟は未だ固くツてもお天氣は此の通り、又此の小田原と來た日には、暖いこと日本一だ、喃、御亭主。",
              "citation": {
                "source": "城の石垣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○竹屋の渡場は牛の御前祠の下流一町ばかりのところより今戸に渡る渡場にして、吾妻橋より上流の渡船場中最もよく人の知れるところなり。",
              "citation": {
                "source": "水の東京",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯と、のんびりした雲から落かかって、目に真蒼に映った、物置の中の竹屋の竹さえ、茂った山吹の葉に見えた。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三日顔を見せませんから案じられます、逢いとうはございます、辛抱がし切れませんでちょっと沢井様のお勝手へ伺いますと、何｜貴方、お米は無事で、奥様も珍しいほど御機嫌のいい処、竹屋の婆さんが来たが、米や、こちらへお通し、とおっしゃると、あの娘もいそいそ、連れられて上りました。",
              "citation": {
                "source": "政談十二社",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛頭山前よりは共にと契りたる寒月子と打連れ立ちて、竹屋の渡りより浅草にかかる。",
              "citation": {
                "source": "知々夫紀行",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "七軒町の取っ附きまでが一丁半位、南北は二丁以上、随分佐竹屋敷は広かったものです。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "佐竹の原繁昌のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　それにも拘らず、竹屋の前を通る時、死んで竿になって了っている竹が、亡霊の様に立っているのを見掛けたとて、彼は何とも思いはしないのである。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日は竹屋へ行って箱根竹を買ってきて、昼の自分の仕事を済ますと、夜なべをやめて、雛形に取り掛りました。",
              "citation": {
                "source": "佐竹の原へ大仏をこしらえたはなし",
                "author": "高村光雲",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、兄は竹屋から竹を買い出してくる。",
              "citation": {
                "source": "佐竹の原へ大仏をこしらえたはなし",
                "author": "高村光雲",
                "note": "青空文庫"
              }
            },
            {
              "text": "「待乳沈んで、梢乗り込む今戸橋」などいったもの、河岸へ出ると向うに竹屋の渡し船があって、隅田川の流れを隔て墨堤の桜が見える。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "名高かった店などの印象",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜の青葉を洩れて来る真昼の日のひかりを、彼はまぶしそうに仰ぎながら、堤のむこうへ下りて竹屋の渡しへむかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "歩兵の髪切り",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれから鮎川のあとを追って行くと、竹屋の渡しを渡って今戸へ越して、それから花川戸の方角へぶらぶらやって来ると、むこうから米吉の野郎が来て、両方がばったりと出逢いました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "歩兵の髪切り",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中で番傘を買って、竹屋の渡しを渡って堤へ着くと、雨はだんだんに強くなって葉桜の堤下はいよいよ暗くなった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "向島の寮",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日は竹屋へ行って箱根竹を買って来て、昼の自分の仕事を済ますと、夜なべをやめて、雛形に取り掛かりました。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "佐竹の原へ大仏を拵えたはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、兄は竹屋から竹を買い出して来る。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "佐竹の原へ大仏を拵えたはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の住ひの竹屋町間之町のあたりに火を発して、その界隈が三、四軒やけた。",
              "citation": {
                "source": "思ひ出",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月十三日　曇、晴れて風が強くなつた、行程六里、途中行乞、再び武雄町泊、竹屋といふ新宿（三〇・下）同宿は若い誓願寺さん、感情家らしかつた、法華宗にはふさはしいものがあつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正三年ごろ京都市中京区間町竹屋町上ルの私の今の住居、画室を建ててから思えばもう二十幾年、当時まだ息子の松篁は十三歳であった。",
              "citation": {
                "source": "画室談義",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹屋町の通りも平田屋町辺もみんな取払われてしまったぞ。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから帰路、竹屋町辺まで差しかかると、昨日まで四十何年間も見馴れた小路が、すっかり歯の抜けたようになっていて、兵隊は滅茶苦茶に鉈を振るっている。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹屋町の通りも平田屋町辺もみんな取払はれてしまつたぞ。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから帰路、竹屋町辺まで差しかかると、昨日まで四十何年間も見馴れた小路が、すつかり歯の抜けたやうになつてゐて、兵隊は滅茶苦茶に鉈を振るつてゐる。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、隅田の渡しで古いのは浜町三丁目から向河岸への安宅の渡し、矢の倉と一ノ橋際間の千歳の渡し、須賀町から横網への御蔵の渡し、待乳山下から向島への竹屋の渡し、橋場、寺島村間の白髭の渡し、橋場、隅田村間の水神の渡し、南千住から綾瀬への汐入りの渡しなぞで、その最も古い歴史を有すのは竹屋の渡しだ。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "この渡し、元は待乳の渡しといったものなのを、いつの頃からか竹屋という船宿の屋号がその通り名となり、百五十年来の名所に二つの呼び名を冠するに至ったのだ。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "花の向島に人の出盛る頃は更にも言わず、春夏秋冬四時客の絶えぬのはこの竹屋の渡しで、花の眺めもここからが一入だ。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "）小竹屋庄兵衛の家に次る。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "器械はやっぱり凍ったはたけや牧草地の雪をふるわせてまわっています。",
              "citation": {
                "source": "耕耘部の時計",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "またわたくしは、はたけや森の中で、ひどいぼろぼろのきものが、いちばんすばらしいびろうどや羅紗や、宝石いりのきものに、かはつてゐるのをたびたび見ました。",
              "citation": {
                "source": "『注文の多い料理店』序",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "house made of bamboo",
        "register": "standard",
