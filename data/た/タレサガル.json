    "definitions": [
      {
        "index": 1,
        "gloss": "to hang",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "物干し竿には、洗い終えたばかりの洗濯物が垂れ下がっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "洞窟の天井からは、無数の鍾乳石が鋭く垂れ下がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の肩には、古びたリュックサックが重そうに垂れ下がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "すると、ポケットはちょうど状差しのような具合に教室の中へ、窓の下の板壁に垂れ下がるのだった。",
              "citation": {
                "source": "錯覚の拷問室",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前にも話したとおり、僕の注意はすぐさま通風口と寝台の上に垂れ下がる綱とに向けられた。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、一枚の菩提樹の葉チューリップの上に落つるを見、更に歩むうち、今度は広々とした池に出会いて、その畔りに咲く撫子を見るに、みな垂れ下がるほど巨いなる瓣を持てり。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、撫子の垂れ下がるほど巨いなる瓣――というところは、第一、撫子には肉化の意味もあり、また、巨きな瓣を取り去ろうとするがなし得ない――というところは、その肉化した瓣が、膨れるのを懼れていたからなんです。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "茎は日に照り赤色を呈して緑葉と相映じ、枝端に垂れ下がる花穂の花は調和よく紅緑相雑わり、それが水辺に穂を垂れている風姿はじつに秋のシンボルであって、他の凡蓼の及ぶところではない。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかと思うと四斗樽ほどの、髪を乱した女の顔が、天井からダラリと垂れ下がる……ほんとに本当に恐ろしい事じゃ」　こう云ったのは老女である。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘴のところに癇癪の皺が垂れ下がる。",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェルギリウスの素晴らしいあの予言、『伸びほうだいのイバラから、赤いブドウの房が垂れ下がるだろう。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "金梨地を見るような日光が、御縁、お窓のかたちなりに射しこんで、欄間の彫刻、金具の葵の御紋、襖の引手に垂れ下がるむらさきの房、ゆら、ゆらと陽の斑を躍らす桧面の艶――漆と木目を選びにえらび、数寄を凝らした城中の一部なので……。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "垂れ下がる衣のひだの、永遠を思わせる静けさのために、下肢の肉づけを度外しているごときは、その一例と見ることができよう。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人は、闇の中にまっすぐに垂れ下がるロープを見つめ、水中にプランクトンが多いことを喜んだ。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "受信した紙は巻紙をほどいたように、ファクシミリが置いてある台へ、そしてそこからフロアに向けて、垂れ下がる。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "真冬　草が茫々として、路が見え、空がたれさがる、……枯れた草が濛々として、白い路に、たれさがる空……。",
              "citation": {
                "source": "小さな庭",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうです、お気に召しましたか、さっき靄のなかの街頭に御覧になった『ヒルミ夫人の冷蔵鞄』の解説は――」　そういって若い男は、広い額にたれさがる長髪をかきあげ、冷えたコーヒーをうまそうにゴクリゴクリと飲み干した。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "甘がきで、秋になると、実の上に白い粉をふいて、枝の先にるいるいとしてみごとにたれさがるのでした。",
              "citation": {
                "source": "僕のかきの木",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "くまざさをわけて、下をのぞくと、水のおもてが、青黒く光って、それへ、まわりの木の枝から、たれさがる、むらさき色のふじの花が、美しいかげをうつしていました。",
              "citation": {
                "source": "水七景",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "深い、深い、水色がかって、たれさがるあちらには、遠く木立の枝が黒く、大きな森の、頭にさしている、かんざしのごとくみえました。",
              "citation": {
                "source": "戦争はぼくをおとなにした",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、夏の晩方、海面へ、たれさがる雲のように、みずみずとして、美しかったので、こんどは、目がその方へ奪われてしまいました。",
              "citation": {
                "source": "太陽と星の下",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "北の方へたれさがる水色の空をながめていると、どこからか、ほそい歌声がきこえるような気がして、ただぼんやりたたずんだ。",
              "citation": {
                "source": "はたらく二少年",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "藁でたばねた髪の解れは、かき上げてもすぐまた顔に垂れ下る。",
              "citation": {
                "source": "千鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その蔓草は麹町区内のＣ国公使館の壁を包んでいるのと同じ外国種の見事なものであったが、生長が馬鹿に早いらしく、二夏ばかり過すうちに絶頂の避雷針の処まで捲き上げてしまって、房々と垂れ下る位になった。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お志保は着物の前を掻合せたり、垂れ下る髪の毛を撫付けたりして、人々の物語に耳を傾けて居たのである。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば木立も枯れ／″＼、細く長く垂れ下る枝と枝とは左右に込合つて、思ひ／＼に延びて、いかにも初冬の風趣を顕して居た。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬣が彼の鈍つた茶色の眼の上へ垂れ下ると、彼は首をもたげて振つた。",
              "citation": {
                "source": "神馬",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それぞれに紙の帽子を冠り、わあわあ騒ぎ立って来るに随って、咲き連っている造花の桜の枝枝にテープが滝のように垂れ下る。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして揺りあげる度にしどけなく裾が乱れて、お由好みの緋縮緬がだらりと地へ垂れ下る。",
              "citation": {
                "source": "白蛇の死",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しきりに、漆黒の髪が額に垂れ下るのを、細い手でかき上げるのが、なんとはなしに美しかった。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "糸は天井より垂れ下る。",
              "citation": {
                "source": "レモンの花の咲く丘へ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この隘路に、夕暮――日の光が消え、而もまだ提灯をつけるには早いという、昼と夜との合間の半端な薄闇の頃、ともすると、上方の茂みを貫いて、中天から、ぶらりと、大きな馬の足が一本垂れ下る……というのである。",
              "citation": {
                "source": "奇怪な話",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方、不気味な隘路のなかに、大きな馬の足が一本、ぶらりと垂れ下る、とただそれだけのことであるが、それが変に、想像の中にはっきりした形をとって現われる。",
              "citation": {
                "source": "奇怪な話",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
