[
  {
    "uuid": "d83ff364-74f4-5447-afa1-6d6d5db43827",
    "entry": "頼りない",
    "reading": {
      "primary": "たよりない",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
