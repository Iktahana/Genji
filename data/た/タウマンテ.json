        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "換言すれば、天よりいでし（即ち神に造られし）魂天に歸ることある時に於てのみかの地震喊聲の如き變異起る四六―四八【階】淨火の門の（淨、九・七六以下參照）四九―五一【タウマンテの女】イリス。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "タウマス（タウマンテ）とオケアノスの間に生る、虹の女神なり（神話）。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "（c）美しいイリス＊はタウマンティス＊の娘である。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その父タウマンティス（正しくはタウマス）はギリシア語で驚嘆を意味する。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
