[
  {
    "uuid": "3dd82eb6-0234-53b5-85a3-78ec10bd2605",
    "entry": "宅地",
    "reading": {
      "primary": "たくち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
