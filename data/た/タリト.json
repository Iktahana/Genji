        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼ノ戰國時代ノ將軍等ガ一州ヲ略セバ一州ヲ領シ一城ヲ拔ケバ一城ノ主タリト云フ私利的經濟的欲望ヲ掲ゲタル爭鬪ヨリ劣ル者ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只一ニ統治國タル日本其者ノ能力問題タリ、責任問題タリ、道義問題タリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ獨逸ノ實戰シタル軍隊ハ徴兵制ノ佛蘭西ト露西亞ニシテ、甲ノ徴兵國ガ乙ノ徴兵國ニ破ラレタリト云ヒ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今ヲ去ル千八百余年前日本武尊御東征ノ砌海上浪高ク激シキ風雨ニ遭セラレルヤ、妃｜弟橘媛命ハ竜神ニ祷リヲ捧ゲ、身ヲ以テ尊ニ代ラントシテ入水シ給ヒシ為御安行ヲ得タリト云フ。",
              "citation": {
                "source": "或るハイカーの記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒井ノ家ノ系統ヲタヅヌルニ、清和源氏ニ出ヅルモノノ如シ――然レドモ――彼ノ女ニ対スル余ノ愛ガ彼ノ女ヲ殺シ、彼ノ女ノ愛ガマタ余ノ生涯ヲ一変セシメタリトヤイハム。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マルコオバサンガ「マア――ソンナ――コト――」　カメコオバサンガ「ダツテ――イイエ――ヤツパリ――」　ソシテ　フタリトモ、コヱガ　ダンダン　チヒサクナリ、クチガマワラナクナリ、ヤガテ　グツスリ　ネムリコンデ　シマヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタニナツテ　メガサメマシタガ、ドツチガ、サキニネムツタノカ　フタリトモ　ワカリマセンデシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ソシテ　フタリトモ、コヱガ　ダンダン　チヒサクナリ、クチガマワラナクナリ、ヤガテ　グツスリ　ネムリコンデ　シマヒマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "古墳ノ掃苔ニオケルヤマタ彼ハ専ラ尾陽所在ノモノニノミ精シキコトアタカモ我ノ東都ニ限ラレシニ似タリトイフベシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "此人民ハ敬神ノ心乏カリシヲ以テ、「ゼウス」神ノ爲ニ絶ヤサレタリト云フ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此すばり越ノ辺マテモ山師杣人ノ外ハ行クコトナシ、夫ヨリ北方ニさら／＼越トイフ所アリ、昔シ天正年中信長公ノ臣佐々内蔵助、越中国ヨリ此さら／＼越ヲ通リテ、当国ヘ来ルコトアリシト云伝ヘタルハ、此辺ヲ越テ加賀川ニ沿ヒ、野口村ノ方ヘ出テタリトカヤ。",
              "citation": {
                "source": "後立山は鹿島槍ヶ岳に非ざる乎",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "八日見という山名の起原に就ては、河原沢村の所伝に従えば八日見山ト申ハ、日本武尊東夷征伐ノ時、東国ノ海陸御巡幸有テ、夷賊追伐ノ御祈トシテ筑波山ニ登ラセタマヒ、遥ニ御覧アツテ、衆山相連ナレル中ニ殊ニ秀タル瞼山戌亥ニ当テ有リ、八日以来、見ヘタリト宣シヨリ、山ノ名ヲ八日見山ト名付ケ給フトナリ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "社傍ニ二間余ノ凹所ヲ生セリ、此土ヲ撮テ少シク田畠ニ散布スレバ、虫害ヲ除クトテ参詣ノ人皆之ヲ取リ帰ルヨリ、斯ノ如キ穴ニハナリタリトイフ。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ「ソンナラ私ガ立テテ上ゲヨウ」トイツテ、手デ立テテヤリマシタガ、手ヲハナスト、スグマタパタリトタオレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシネエチヤンガ足ヲオハナシニナルト、ソツチノミミハマタパタリトタオレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――………ネエチヤンモウサギノミミヲツマンデ、立テテオヤリニナリマシタガ、ネエチヤンガソノミミヲオハナシニナルト、マタパタリトタフレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "口ト口ト合ワセナイデ、互ニ一センチホド離レテ、アーント口ヲ開ケサセテ、予ノ口ノ中ヘ唾液ヲ一滴ポタリト垂ラシ込ンデクレタヾケ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「カツノリ、ミツマル、フタリトモ、モンダイカイケツスルマデ、ソコニカクレトレ――ちゅうてな」「ウフフ、お父さんの芝居のうまいこと」　玄関で、朝刊を投げこむ音がした。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "科人、毎日五十人、三十人ヅツアリ、打首ニナルモアリ、血マブレナル首ヲ俵ヘ入レ、三十荷モ持チ出シテ、大坑ヘ打捨テタリトモ聞エタリ。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "穴ヲ掘テ自ラ埋リタリト。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "按ニ違ハズ、塀越シノ槍、長柄ニテ大イニ利ヲ得タリト。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "曹操は、軍令を出して、一、農家｜耕田ヲ荒ス者ハ斬一、一犬一｜鶏タリト盗ム者ハ斬一、婦女ニ戯ルル者ハ斬一、酒ニミダレ火ヲ弄ブ者ハ斬一、老幼ヲ愛護シ仁徳ヲ施スハ賞ス　と、諸軍に法札を掲げさせた。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "時の記録には、彼の心事を描いて、心ノウチ仕済シタリト打チヨロコビ笑イ楽シンデ、溯江数百里、夏口マデ来リケル。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "各※一国ニ在ルガ故、人以テ曰ウ、蜀ハ龍ヲ得タリ、呉ハ虎ヲ得タリ、而シテ、魏ハソノ狗ヲ得タリト。",
              "citation": {
                "source": "三国志",
                "author": "篇外余録",
                "note": "青空文庫"
              }
            },
            {
              "text": "カツテノ執権、最明寺時頼ノ母スラ、自ラ破レ障子ヲ繕ウテ、勤倹ノ教ヘヲ垂レタリト聞クソノ松下ノ禅尼ノ子孫高時、今ハ数十人ノ妾ヲ蓄へ、妾ニハ領地ヲ分カチ、白拍子、猿楽、田楽俳優ナド、府内二千人ヲ超ユルニイタル。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナホ外ニ、武蔵ガ念ズル観音ノ小像モアリシガ、近年紛失シタリトモイフ　明白に父の無二斎に連れられて播州へ行ったまま消息不明になった次第などではない。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "八代聞書の記載に依ると、武蔵ノ常ニ佩キシ刀ハ、伯耆安綱ナリシ由、然ルニ熊本ニ来リテ後、沢村友好（大学）ノ世話ニナリタリトテソノ刀ヲ礼トシテ贈リタリ。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
