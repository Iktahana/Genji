        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おたまじやくしさへ讀めるかどうか。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちど笑うと、なかなか、真面目な顔に帰れないもので、ねえ、てのひらを二つならべて一｜掬の水を貯え、その掌中の小池には、たくさんのおたまじゃくしが、ぴちゃぴちゃ泳いでいて、どうにも、くすぐったく、仁王立ちのまま、その感触にまいっている、そんな工合いの形である。",
              "citation": {
                "source": "思案の敗北",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥様、おたまじゃくしの真中で、御紋着の御紋も河骨、すっきり花が咲いたような、水際立ってお美しい。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとからちゃんとしたまじめな女中さんだったし、まさか、私をからかっているのでもなかろう。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、ちがった、おたまじゃくしが、一千匹以上うようよしているのだ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おたまじゃくしさえ読めるかどうか。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなもの要らないと私たちは思いましたが役人がまたまじめになって恐くなりましたからだまって受け取りました。",
              "citation": {
                "source": "二人の役人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹村君は前屈みになって硝子箱の中に並べたまじょりか皿をあれかこれかと物色しているが、頭の上の瓦斯の光は薄汚い鼠色の襟巻を隠す所もなく照らしている。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "池のみぎわでおたまじゃくしの行列を見る事もある。",
              "citation": {
                "source": "池",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな欲望も抑制したまじめ顔がその人の全部であってはいやなものですよ」　などと源氏は夫人に言って、息子をかわいく思うふうが見えた。",
              "citation": {
                "source": "源氏物語",
                "author": "初音",
                "note": "青空文庫"
              }
            },
            {
              "text": "おたまじやくしになつたのです。",
              "citation": {
                "source": "ちるちる・みちる",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "・逢うて菜の花わかれて菜の花ざかり　いちめんの菜の花の花ざかりをゆく　さくらちりかゝる旅とたつたよ・旅もいつしかおたまじやくしが泳いでゐる　　途上未定稿（作品そのものは――）未完成稿（芸術家その人は）旅やけ！",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人の才能はさうした飛躍をやつても間違がない『おたまじやくし』を賞めたい。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四郎はいまさら自分の言葉を冗談にすることもできず、またまじめにすることもできなくなった。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分はすぐ重吉の挙止動作がふだんにたいていはまじめであるごとく、この問題に対してもまたまじめであるのを発見した。",
              "citation": {
                "source": "手紙",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "おたまじやくしおたまじやくしがちろちろと、粘りついたり、もつれたり、青い針めく藻のなかに黒く、かなしく、生いきと。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "おたまじやくしの泣き笑ひこゑも得立てね、ちろちろと、けふも痛そに尾を彈く、黒く、かなしく、生いきと。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "おたまじやくしか、わがこころ。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおらかに張り渡した傾斜のうえにはおたまじゃくしに似た薄雲がちらちらと散らばって、如何にも朝明の風を思わしめる。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえて見ると、ちょうどおたまじゃくしに足が二本生えかかったぐらいの程度だろうか。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "エジプトの学者たちは、ある一定の方式の呪文を唱えると河の水をその源へ逆流させ、太陽の運行を止めたりまた早めたり、またまじないを施した蝋製の人間や動物の姿を生かし動かすことができたとされている。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "むろんそれは、ある曲のある楽章のある小節をちぎつてきたものでもいいし、あるいは五線紙に一、二行、だれかが即興的におたまじやくしを並べたのでも何でもいい。",
              "citation": {
                "source": "映画と音楽",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
