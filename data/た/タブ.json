        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ブラウザで複数のウェブページを開くときは、新しいタブを使うと便利だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このソフトウェアは、複数のファイルをタブで切り替えて表示できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "うっかり、間違ったタブを閉じてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "tab (flap or strip of material)",
        "register": "standard",
