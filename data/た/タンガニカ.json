        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――　　　第一話　タンガニカの蠅「あのウ、先生。",
              "citation": {
                "source": "蠅",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それでよろしい、あのタンガニカ地方の砂地の温度が、ちょうどそのくらいなのだ。",
              "citation": {
                "source": "蠅",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（探険隊の一行が、タンガニカを横断したときは……）と博士は、またしても学者としての楽しい憶い出をうかべていた。",
              "citation": {
                "source": "蠅",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンガニカで、博士は奇妙な一つの卵を見付けたのだった。",
              "citation": {
                "source": "蠅",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして他の動物資料と一緒に、タンガニカの砂地と同じ温度を保たせた恒温室の中に二十四時間入れて置いたというわけである。",
              "citation": {
                "source": "蠅",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンガニカには身長が二メートルもある蠅が棲んでいたという記録があるが、あの卵はその蠅の卵だったんだ。",
              "citation": {
                "source": "蠅",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、タンガニカの蠅！",
              "citation": {
                "source": "蠅",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
