      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "復一、お前は鼎造に気に入っているのだから、代りにたんまりふんだくれ」　と宗十郎はこぼしていった。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "政江には四人の娘があり、最近彼女たちの正月の晴着を収めてたんまりもうけた呉服屋は、この正月には一家総出で白浜温泉へ出掛けようと思っている。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "倶利伽羅峠に立籠って――御時節がら怪しからん……いずれその風呂敷包みも、たんまりいたした金目のものでございましょうで。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」たゞでもこの役はつとまる所をしみ／″＼禮をいはれた上に、「たんまり御祝儀を。",
              "citation": {
                "source": "十六夜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村さんからもたんまり来ているはずじゃありませんか。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかわり、晩にはたんまりと酒手を頼んまっせ」　いうと、人足は酒手にほれたもののごとく、表へ向かって歩きだしました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "青眉の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "勤めがなくて、ぽっぽにたんまりおこづけえがあって、べっぴん片手に船遊山、チャカホイ、チャカホイ、チャカチャカチャ――と、いけませんかね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "来いとおっしゃりゃ、土橋へだろうと、石橋へだろうとついてもいくし、お総菜もたんまりとくふうする段じゃねえが、行ってみたところでしようがねえんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからついでに、あたりめ甘露煮、なんでもいいからおまえさんの口に合うようなものをいっしょにたんまり買って、酒も生一本を一升ばかり忘れずに求めてな、ほら、一両だ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "千葉のいなかよりたんまりとやまぶき色をご用意のおだんな衆が三人ほど参り候まま、万障お繰り合わせご入来くだされたく、みなみな首長くしてお待ちいたしおり候。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その足音じゃたんまりとありそうだが、どうだ、わかったか」「…………」　しかし、伝六は駆けあがってきた元気とはうって変わって、しょんぼりとたたずみながら、しきりとまゆをぬらしているのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "やまがら美人影絵",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし不眠のおかげで、千鳥の声をたんまりと聴くことができた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "早く犯人を挙げて、暮にはたんまりと暖まるさ」　そう云って、莨を取り出し、燐寸を摺ったその手を見たとき、巡査は頭から水を浴びせられたような気がした。",
              "citation": {
                "source": "地虫",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死んだ者が生きかえって、本来ならば喜ぶ筈なんですが、この千吉というのが良くない奴で、生かして帰してしまえば倉田屋からたんまりした礼金も貰えない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "半七先生",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう云うと、たいへん忠義者のようですが、実は殿様から御褒美をたんまり頂戴しようという慾心が先に立って、一匹の西洋馬をこっそりと牽き出しました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "菊人形の昔",
                "note": "青空文庫"
              }
            },
            {
              "text": "成程｜腕つ節は勁さうに出来てゐるが、その二十年といふもの、金なぞたんまり握つた事の無ささうな掌面だなと弟子は思つた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手は懐中加減の好い輩だ、たんまり土産も出来ようといふものだ。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "広告新案８・21（夕）　京都に陶器を取扱つてゐる男は随分ゐるが、そのなかで、近頃たんまり懐中を拵へた者に松風嘉定氏がある。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは外でもない、新画｜流行の今日この頃、予て顔｜昵懇の画家達を拝み倒して、資本要らずの画をしこたま駆り集め、その即売会を開いて、たんまり懐中を膨らまさうといふのだ。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "福沢氏は以前慶応義塾の学生だつた頃は、人間は霊魂さへあつたら、女に思はれもするし、世渡りも結構出来るものだと思つてゐたらしいが、氏自身が色々な会社事業に関係して、たんまり懐中が暖まつて来ると、そろ／＼人生観も変つて来て、人は霊魂ばかりで生きるものぢやないと思ひ出したらしい。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いち早く国際問題を嗅ぎつけたら、たんまり金の儲かるすべを知つてゐたからだ。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この男は一週間ばかり前からちょいちょい此店へ来て飯を喰ったり酒を飲んだりする男で、お金もたんまり持っているらしく、此店に来る客人の中では上々の部であった。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "金持で気前のいい地主だろうか、それとも奉職ちゅうにたんまりと財産を拵えたような、親切気のある人間ではなかろうか？",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "かういふお銭をたんまり儲けるのに、仕事といへばたんだ一つきりさ！",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "』さう、うつろな嗄がれ声で老婆がいふと、バサウリュークは犂を渡しながら、『あすこを掘るのぢや、ペトゥロー、あすこにやあな、お主やコールジュが夢にも見たことのないやうな黄金がたんまり埋まつてをるのぢや。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "「京都つて言ふところはお金をたんまり持つて旅人として遊びに來るには好い所だが、住むに好い所ぢあないね、やつぱり東京の方がどんな生活でも出來るし、長く住んだせゐか氣樂だよ」京都へ住むやうになつてから、彼是もう半歳になる。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもよ、見ろ、下さ行けば、漁場の金持の野郎ども、たんまりとりやがるんだ。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてたんまり金が入る。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "地主があつたらこと云ひやがるし、坊主は又坊主の奴で、地主からたんまり貰つたもんだから、何事も佛樣のみ胸のまゝだなんてぬかすもんで、分らないのが、イヨ／＼こんがらがつて分らなくなつたんだ。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
