  {
    "uuid": "422a2c8f-0854-55ae-aa87-e02f96ec3aaa",
    "entry": "たんま",
    "reading": {
      "primary": "たんま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
