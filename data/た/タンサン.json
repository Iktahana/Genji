      "alternatives": [
        "タンサン"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "carbonic acid",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "温泉水には、自然の炭酸ガスが溶け込んでいることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "炭酸は、水に二酸化炭素が溶けることで生成される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "化学の実験で炭酸の性質について学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "蚊帳が幾分でも空気の疎通を妨げるとすれば二、三人も狭い蚊帳に寝ていれば炭酸瓦斯の分量も外よりは多くなるかも知れぬ。",
              "citation": {
                "source": "蚊帳の研究",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちアーク灯の陰極になっている炭の棒を不断廻転させ、陽極には金属の棒を用い、これを水素または炭酸瓦斯で包んでなお強い磁力をアークの光部に作用させる。",
              "citation": {
                "source": "無線電信の近状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また炭酸瓦斯を用うれば太陽の光と同じ純白色となる。",
              "citation": {
                "source": "ムーア灯",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "高いオペラの空気窓から「タイスの」唄が炭酸｜瓦斯にまみれて浮き出ている。",
              "citation": {
                "source": "街頭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭火から出る炭酸｜瓦斯は熱した空気と一緒に天井へ上り障子の紙を透して外へ出るから日本の家屋ではそう恐ろしい害はない。",
              "citation": {
                "source": "歳時記新註",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また炭火の中で炭酸瓦斯が還元して一酸化炭素という恐ろしい毒瓦斯を作る事はあるが、これは大抵青い焔を上げて燃えてしまう。",
              "citation": {
                "source": "歳時記新註",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱も炭酸も湿気も出来る。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭酸瓦斯などは通常の温度でも圧縮すれば液化するが、空気のごときは摂氏零度以下百四十度という極寒に会わぬといくら圧縮しても液体にならぬ。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "金剛石と炭　金剛石はほとんど純粋な炭素から出来たもので、これを空気中で高熱すれば燃えて炭酸瓦斯に変る事は人のよく知るところである。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボーイが炭酸水とウイスキーを籐の卓子に置いて去ると、恋は異なものね、と云うような顔附をして炭酸水にウイスキーを入れたコップを涼しげにのむのであった。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　石炭酸の臭いがプン／＼している病院の手術室へ這入ると、武松は、何気なく先生、こんな片身をそぎ取られて、腹に穴があいて、一分間と生きとれるもんですか、ときいた。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから人間でも脇腹か臍のへんに特別な発声器があってもいけない理由はないのであるが、実際はそんなむだをしないで酸素の取り入れ口、炭酸の吐き出し口としての気管の戸口へ簧を取り付け、それを食道と並べて口腔に導き、そうして舌や歯に二役掛け持ちをさせているのである。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "而してゑがらつぽい炭酸瓦斯が部屋の空氣を暖かく濁してゐる。",
              "citation": {
                "source": "秋",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、わたしたちはね、酒は呑まないんだから炭酸水でもおくれ。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「炭酸水はありません。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "水を呑んでも石灰の多い水、炭酸の入った水、冷たい水、又川の柔らかな水みなしずかにそれを享楽することができるのであります。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先生、気層のなかに炭酸ガスがふえて来れば暖かくなるのですか。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "地球ができてからいままでの気温は、たいてい空気中の炭酸ガスの量できまっていたと言われるくらいだからね。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「カルボナード火山島が、いま爆発したら、この気候を変えるくらいの炭酸ガスを噴くでしょうか。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "解剖臺のテーブルの上には、アルコールの瓶だの石炭酸の瓶だの、ピンセットだの鋸だの鋏だの刀だの、全て解剖に必要な器械や藥品が並べてある。",
              "citation": {
                "source": "解剖室",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも空地に溝がながれて木が生え白き石炭酸の臭ひはぷんぷんたり。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近所の医者の処へ石炭酸水を貰いに遣れと云う人がある。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は当時同車したりし熊の如き髯武者、巡査、田舎婆、芸者らしき女、などの交々吐き出したる炭酸瓦斯も猶幾分か残り居るべし。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時、海に最も近い沖ノ端の漁師原には男も女も半裸体のまま紅い西瓜をむさぼり、石炭酸の強い異臭の中に昼は寝ね、夜は病魔退散のまじなひとして廃れた街の中、或は堀の柳のかげに BANKO（縁台）を持ち出しては盛んに花火を揚げる。",
              "citation": {
                "source": "水郷柳河",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「炭酸水をもらおうかな。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "前川は、ウィスキイと炭酸水とを別々に、口に運びながら、「君達二人とも、初めて？",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっと労働でもして血液中の水素イオン濃度がわずかに一億分一だけ増すとすぐ呼吸が忙しくなって血液中の炭酸ガスを洗滌させる。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者は、やがて腕をまくり上げて、ふと隅にあった石炭酸を見つけだして。",
              "citation": {
                "source": "かなしみの日より",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "『え、石炭酸がたくさんありましたから、それで十分でした。",
              "citation": {
                "source": "かなしみの日より",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "せきたんさんで、あらいよっとじゃが、びょういんにいったほうが、よかあんばいのごとある。",
              "citation": {
                "source": "清貧の書",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
