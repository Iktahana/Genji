        "examples": {
          "standard": [
            {
              "text": "このカメラは単３電池が４本必要です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "災害時には、単３電池が手に入りにくくなることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「ねえ、リモコンの単３電池、切れてない？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "せきたんさんで、あらいよっとじゃが、びょういんにいったほうが、よかあんばいのごとある。",
              "citation": {
                "source": "清貧の書",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェレミーさんは　みなもに　むかって　ぴゅうん、　にげるさまは　まるで　たんさんを　あけたときの　せんと　あわみたいで。",
              "citation": {
                "source": "つりびとジェレミーさんのはなし",
                "author": "THE TALE OF MR. JEREMY FISHER",
                "note": "青空文庫"
              }
            }
          ]
        }
