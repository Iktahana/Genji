        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お菓子のレシピに炭酸を少量加えると、ふっくらと焼き上がる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
