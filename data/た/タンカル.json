        "examples": {
          "standard": [
            {
              "text": "運動会の校庭で、白線を引くために使われる粉の正体は炭カルだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歯磨き粉やサプリメントの成分表を見ると、炭カルの名前がよく出てくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "農業の分野では、土壌の酸性を中和するために炭カルが散布される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "仕方がないからいったんカルカッタの方へ行って、今度帰って来るとちょうどサラット先生もシャブズン・ラマも帰って居られたから手紙を渡した。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            }
          ]
        }
