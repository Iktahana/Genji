        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "歐洲諸國ノ大戰ハ天其ノ驕侈亂倫ヲ罰スルニ「ノア」ノ洪水ヲ以テシタルモノ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴族政治ヲ覆滅シタル維新革命ハ徹底的ニ遂行セラレテ貴族ノ領地ヲモ解決シタルコト、當時ノ一佛國ヲ例外トシタル歐洲ノ各國ガ依然中世的領土ヲ處分スル能ハザリシヨリモ百歩ヲ進メタルモノナリキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本現時ノ大地主ハ其經濟的諸侯タル形ニ於テ中世貴族ノ土地ヲ所有セルニ似タルモ、所有權ノ本質ニ於テ全ク近代的ノ者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "要スルニ凡テノ原因ハ朝鮮ガ日本支那露西亞ノ三大國ニ介在シテ自立スル能ハザリシ地理的約束ト、其ノ道義的廢頽ヨリ一切ノ政治産業學術思想ノ腐敗萎微ヲ來シテ内外相應ジテ亡ビタルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "徴兵制度ノ形式ハ獨佛ニ學ビタルモ、徴兵制度ノ精神タル國民皆兵ノ義務ハ、中世封建ノ期間ヲ除キテ、上世建國時代ニ發源シ更ニ現代ニ復興シテ漲溢シツツアル國民的大信念ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米ノ傭兵ト獨逸ノ徴兵トノ優劣ハ實戰ニヨリテ立證セラレタルモノニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "その場内に大岡越前守｜忠相の遺品が陳列してあったが、その中に子爵大岡忠綱氏の出品に係る鑷四丁があって、その説明書に「大岡越前守忠相ガ奉行所ニ於テ断獄ノ際、常ニ瞑目シテ腮髯ヲ抜クニ用ヒタルモノナリ」と記してあった。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二読会において延期派の小沢武雄君の発議により、前記の原案に「但シ修正ヲ終リタルモノハ本文期限内ト雖モ之ヲ施行スルコトヲ得」という但書を追加せられ、結局本案に付き採決の結果は、延期を可とする者百二十三、断行を可とする者六十一で、延期派の大勝利に帰した。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身ニ毒草ノヨウナモノヲツケタルモ、……」（判読不能）僕「空電妨害ニ悩サル。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身ニ毒草ノヨウナモノヲツケタルモ以下語レ」相手「毒草ノヨウナモノヲツケタルモ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨日マデハ、リベットヲ打ツ「ニュウマチック」ノ音、「コンクリート」混合機ノ音響ヲ時々耳ニシタルモ、其後聞カズ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "前後ノ事情ヨリ推察スルニ怪施設ハ大部分完備ニ向イタルモノノ如シ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、二、ソノ色、黒褐色ノ水甕ニシテ、底ヲ逆ニスルト、赤キ「ペンキ」デ４０８４ノ数字ガ記サレタルモノ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「艦隊ハ午後九時二十分北緯四十度東経百三十七度ノ洋上ニ於テ、高度約二千｜米ヲ保チ、南東ニ飛行中ノ敵超重爆撃機四機ヲ発見セリ、直チニ艦上機ヲ以テ急追攻撃セシメタルモ、天暗ク敵影ヲ逸スルオソレアリ」　これで敵機の強さがわかった。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "やむを得ず杜は、名刺を一枚だして、それに日附と時間とを書きこみ、それから裏面に「横浜税関倉庫ハ全壊シ、着荷ハ三分ノ二以上損傷シタルモノト被存候」と報告を書きつけた。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "往昔羅馬ノ時代ニ、葬ヲ送ル者皆此壺ヲ懐ロニシ、涙ヲ注シテ墓畔ニ埋メタルモノナリト云フ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ガ末廣澤田二子ヲシテ久シク囹圄ノ中ニ貴重ノ光陰ヲ消過セシメタルモ、亦汝ノ罪ニ非ズト謂フヲ得ズ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ吾ガ高橋子ヲシテ数月ノ間櫛風沐雨ノ苦ヲ兵馬ノ地ニ嘗メシメタルモ、亦汝ノ事ニ関セシニ非ズヤ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "平民自身モマタ奴隷タルベクコノ世ニ生レ出デタルモノニシテ、人格ト権利ヲ没却セラレテモ、之ヲ甘ンジテ屈従スルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ、コノ信念ハ外ニ於テハ国家ニ不忠、内ニ於テハ国教ニ不信ナリトノ理由ヲ以テ、彼等ハ自国ニ住ムコトヲ極度ニ圧迫セラレタルヲ以テ、故国ヲ逃レテ和蘭ノ地ニ来リ、更ニ北米ノ天地ヲ求メタルモノナリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ノ欲スルトコロハ領土ニアラズ、物資ニアラズ、己レノ良心ト信仰トノ活路ヲ見出サンガタメニ新天地ニ出デタルモノ也。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "全て意識せらるゝものは、所謂「シツツアル力」に対して「セラレタルモノ」だけの価を有するに止る。",
              "citation": {
                "source": "意識と時間との関係",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の如くにして、「セラレタルモノ」は「セラレタル瞬間」に於て「シツヽアル力」の後に取り残されるに止る。",
              "citation": {
                "source": "意識と時間との関係",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に「意識しつゝある世界」に於て「シツツアル力」の現在と一切の「セラレタルモノ」の過去の外は何者もない。",
              "citation": {
                "source": "意識と時間との関係",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とならば「ハタラカレタルモノ」即ち「意識の対象」を強ひて「過去」と名ける必要はさらにない。",
              "citation": {
                "source": "意識と時間との関係",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "道學先生ナド、心學ノ錬成ヲナスニ初メ苦心ヲナス状態ヨリ大悟ニ至ルマデノ階段ヲ示シタルモノト言フ人アリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "此レハ當ヲ得ザルモ、兩面アルモノト見、「胸すくばかり」ト譯ヲ致シタルモ、ヨリヨキ語ハ無之哉。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
