      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "blue vitriol",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "銅の精錬過程で、胆礬が副産物として生成されることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "胆礬は、農業分野で殺菌剤としても利用される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "化学実験室で、鮮やかな青色の胆礬の結晶を観察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "原始林が風を遮るので湖水の面は漣も立たずちょうど胆礬でも溶かしたように蒼くどろりと透き通っている。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゅっこが、大威張りで、あの青いたんぱんを、淵の中に投げ込んだ。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また明和二年には、源内は武蔵国秩父の中津川に赴いて、そこで金、銀、銅、鉄、緑青、明礬、たんぱん、磁石などを見つけ出し、そこで山金採掘の仕事にとりかかりましたが、それはさほどうまくゆかなかったとのことです。",
              "citation": {
                "source": "平賀源内",
                "author": "石原純",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
