        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あれはきっとタガンローグという彼の生れた町での見聞ですね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "タガンローグの町には小さいチェホフの博物館がありますが、そこの中央ホテルという大ホテルには食堂がなくて、となりの食堂へ行くのよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の生れたタガンローグの町は、アゾフ海のそばで、ロストフのそばで、其処にある家はいかにも小さな屋台店の持主らしい、つつましい四角い小家でした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェホフの父は解放された農奴でタガンローグというアゾフ海の近くのどこかの町で屋台商人として生活していた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドン・バスの炭坑を見学したり、アゾフ海に面したタガンローグの町でチェホフがそこで生れて育ったつましい家などを見物して、二人がモスク※へ帰って来たのは十月であった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すくなくとも、タガンローグの蠅は、ワタシの鼻のあたまを知っている」　アゾフ海に向って下り坂になっている大通りのはずれに公園をもっているタガンローグの町は、チェホフの生れたところだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タガンローグの町に唯一のチェホフ博物館があって、そこにはチェホフに直接関係があってもなくても、とにかく町の住人たちにとって見馴れないもの、あるいは日常生活に用のないものは、みんなもって行って並べることにしてあるらしかった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子と素子とは、タガンローグの住人にとってめずらしい二人の日本婦人として子供に見物されながら町を歩き、メトロポリタンという堂々とした名前のホテルに一晩泊った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――だが、タガンローグの町で、チェホフが一日じゅう蠅をつかまえて暮している退屈な男を主人公にして小説をかいたわけだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「タガンローグの五ヵ年計画には、必ずあの蠅退治がはいっているだろうと思いますね」「わたしたちの村では清潔ですよ」　オリガが、ほこらしげに、単純な満足で目を輝かした。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分と連れとは、その夜タガンローグをさしてバクーを出立した。",
              "citation": {
                "source": "石油の都バクーへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タガンローグはアゾフ海に沿うた小さな町でアントン・チェホフの故郷なのである。",
              "citation": {
                "source": "石油の都バクーへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "父の代になるとロストフに近いタガンローグに定住して、商家の娘を娶った。",
              "citation": {
                "source": "チェーホフ試論",
                "author": "――チェーホフ序説の一部として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　――私アントン・チェーホフは一八六〇年タガンローグに生まれた。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェーホフが卒業したタガンローグ中学校でも、ショーペンハウエルはバックルと並んで生徒必読の書であった。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この祖父がやがて自由を購ってウクライナに移住し、ついで父の代になるとロストフに近い港町タガンローグに居を定めて、食料品店を開いた。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "タガンローグはギリシャの商人なども多数居住する雑居的な商業町であった。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
