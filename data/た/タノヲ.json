          "literary": [
            {
              "text": "」ト　ナキダシタノヲ　ホツタラカシテ　オイテ、ロクボクノ　ハウヘ　トンデ　ユキマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ便所ノ方ニ進ンデ暗イ廊下ヲワザトソット曲ッテ行クト、角デ道子ト友田トガ何カヒソヒソト話シテ居ルノガ聞エマシタ、道子ガアサッテ六時ニイツモノ所デネト云ウ声ガハッキリキコエマシタ、友田ノ声ハヨクキキ取レナカッタノデスガ、私ハソノ時二人ガ手ヲ握リ合ッタノヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシガ、ヨクネムレナカツタノヲシラナイノカ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ家ガ本所割下水ニアッタ時代デ、両国廣小路ノ、アレハ何ト云ッタッケナ、何トカ云ウ有名ナ絵草紙屋ノ店頭ニ助六ト意休ト揚巻ノ三枚続キノ錦絵ガ掲ゲテアッタノヲ今モ忘レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨日ノ日曜日、二十四日ノ午過ギニ、颯子ガ洩ラシタ言葉ガアッタノヲ予ハ忘レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今マデ颯チャンガソンナ石ヲ持ッテタノヲ、オ婆チャンモ見タコトハナイト仰ッシャイマスシ、アタシモ知リマセンケレドモ、イツアンナモノヲ買ッタンデゴザイマショウネ」「………」「ソウ云エバ岸サンガ総理大臣ダッタ時、佛印カ何処カデキャッツ・アイヲ買ッテ問題ニナッタコトガアリマシタッケネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルヘ戻ッテ何シテタンダ」「寒クナリソウダカラ着換エテ来タノヨ、オ爺チャンモ気ヲオ付ケニナラナイト風邪ヲ引クワヨ」四条通リデ買ッテ来タノヲ早速着テ見タカッタノダロウ、白ノブラウスニ、ブリューニ銀ノラメガ繍イ込ンデアルセーターヲ着テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ血相ガ変ッタノヲ見テ五子モ青クナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現像シタノヲ一往見セテ貰ッタ上デ、中カラ面白イモノヲ選ンデ手札型ニ引キ伸バシテ貰ウ」ト。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ガ去ッテカラ、敏子ガ留守番ヲシテイテクレタノヲ思イ出シテ、茶ノ間ヤ敏子ノ部屋ヘ行ッテミタガモウイナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレガ、オ京ヲ今晩世話シロ、ト、アレホド申シコンデオイタノヲ、知ツテ居ルクセニ、玉井トオ京トヲ、逃ガシテシモウタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カヨコサンペイ　コンレイニテ　キサブロウ　ウチニトメタノヲ　ツリニツレダス」八時十八分、大戸着。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
