        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "広い公園で凧揚げをしていたら、糸が隣の木に引っかかって取れなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "正月恒例の凧揚げ大会には、全国から巨大な創作凧が集まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「お父さん、もっと高く揚げて！」と子供が凧揚げを催促している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "凧揚げのあとは酒宴である。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月の遊戯で盛に行われたのは凧揚げであった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "藩邸の凧揚げは右の通りの有様であったが、なお町家でも凧揚げをした。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然、凧揚げも下手ではなかった。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒くはあつたが、風のある良い凧揚げ日和だつたよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "敵の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "日は暮れかゝつて居るのに、子供達はまだ凧揚げに夢中です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "敵の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お諏訪さんのお祭典とお盆と凧揚げに馬鹿々々しい金を使うので、これを三馬鹿と申します」「何、三馬鹿だって？",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「坊ちゃん、此処は凧揚げが名物です。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "切られては買い切られては買い後を引くものと見えて、凧揚げのことをつぶらかしというくらいだ」「身上を潰すのかい？",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "凧揚げをほんのすこし手伝っただけで彼と別れた自分は、なんという馬鹿なことをしたのだろうかと、邦子は自分のうかつさを口惜しく思った。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "代役を相手に、あのときの凧揚げをいまこうして再現している自分にとって、すさまじいまでの胸のときめきをともなった、ひと目惚れによるほんの数分間の初恋は、もはや永遠に失われたのだと、邦子は結論していた。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自転車もなく、たまに年始客の人力車が通るくらい、どこの往来も娘や若衆の追羽子、子供の凧揚げで一杯、これらは江戸時代そのままの風景。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後追い追い山高帽子や洋服の礼者も殖え、足取りも大分せわしく、二十五、六年代には電信電話の線もゆきわたり、交通も繁しくなって、追羽子や凧揚げは横町か空地に限られ、娘子供は大不服。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖父を手古摺らせた私の内気も、三年生になって級長を勤めるようになってからはそれほどでもなくなって、凧揚げやとんぼ採りの仲間入りも一人前に出来るようになるばかりか、大川へ水泳ぎにさえ出かけるようになった。",
              "citation": {
                "source": "桜林",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "「風がなくなったら、たこあげができない」　と善金が心配そうにいった。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "たこあげ天へ上りたかネオルガンの鳴っとる如たる凧の踊っとるもん天へ上りたかネ　　注上りたか…………上りたいごたる……………ようだハタ………………たこ踊っとるもん……踊っているから完全な幸福　真実孤児の道はさみしい。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "決して暢気さうに凧上げをしてゐるのではない。",
              "citation": {
                "source": "西瓜喰ふ人",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "丘の上で大騒ぎの凧上げをしてゐることもあつた。",
              "citation": {
                "source": "西瓜喰ふ人",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――風の吹き荒んでゐる木枯の丘で、相変らず熱心な凧上げをしてゐることが多い。",
              "citation": {
                "source": "西瓜喰ふ人",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは特に凧上げの技巧が不器用とも思はれなかつたが、ムカデ凧を上げるには何時も余程の苦心を余儀なくされた。",
              "citation": {
                "source": "山峡の凧",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "憶ひ出の中では飴色の光りが輝き、青空にくつきりとそびえた山々の青肌に翼を拡げた鶴のやうなかたちの雪の痕が点々と望まれる和やかな冬の日ばかりが続いてゐるが、案外にもこのあたりの朝は、早朝から達磨型の矢倉岳を吹き降す烈風が麓の部落に渦を巻く日が多く、滅多に絶好の凧上げ日和などは見出せなかつた。",
              "citation": {
                "source": "山峡の凧",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "見渡す限り電信柱も見えぬ高原地帯のために、凧上げは昔ながらの古風な方法で、角凧とデルマ凧は糸の中途に、ガンギリと杯ばれる刃物を付けて凄烈な切り合ひを演じた。",
              "citation": {
                "source": "山峡の凧",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "端午の節句には三人の人手をかりて厳かな凧上げ式を挙行したものである。",
              "citation": {
                "source": "鱗雲",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "花々しい凧上げの日の記憶が、たゞ漠然と残つてゐるばかりである。",
              "citation": {
                "source": "鱗雲",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、このＢ村の凧上げ日の朝の光景などもはつきりと覚えてゐる。",
              "citation": {
                "source": "鱗雲",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　冬子が知らない頃に凧上げの場所だつた盆地が、その頃は競馬場に変つてゐた。",
              "citation": {
                "source": "鱗雲",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなた凧上げお上手でしょうね、ふっとそんなこと思いました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この辺ではまだ凧上げていないわ、風がない日ですからかしら。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、相撲も、凧上げも禁じない如く、丁半、ちょぼ一、みつぼの胴を取ることまでも、主膳は喜んで見物する。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "和夫でさえも、骨持っての火葬場の帰途、凧上げている友達に、大声で呼びかけたという。",
              "citation": {
                "source": "夢幻泡影",
                "author": "外村繁",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
