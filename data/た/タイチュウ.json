  {
    "uuid": "dafcd2a1-e055-51a7-8ef2-c4959c34ec96",
    "entry": "台中",
    "reading": {
      "primary": "たいちゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（野中）（舞台中央まで来て、疲れ果てたる者の如く、かたわらの漁師に倒れるように寄りかかり）ああ、頭が痛い。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕、――舞台中毒かも知れない。",
              "citation": {
                "source": "秋風記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「化けた……何だか知らない、荒磯の小屋に小父さんが一人居て、――（目こそ闇けれど）……どうとかして――（寄する波も聞ゆるは）……と言うと、舞台中ざあと音がしてね、庵へ波がしらが立つのが見えた……魔法を使ったようだよ。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "スポットライトを浴びて舞台中央に進み出た浜田をはさみ、渡辺と後藤たちとは上手と下手に切り離された。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "山室は茶山集の詩に、「病中七夕山室子彦、河村士郁来」の七律があつて、其第四に「偶有台中二妙尋」と云つてある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "枳園は紀州藩の医官竹田某の蔵する所の宋板外台中屠蘇の方を載する一｜頁を影刻したのである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "これより先き寛永十三年には、同じ香木の本末を分けて珍重なされ候仙台中納言殿さえ、少林城において御薨去なされ候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついで正保二年松向寺殿も御逝去遊ばされ、これより先き寛永十三年には、同じ香木の本末を分けて珍重なされ候仙台中納言殿さえ、少林城において御逝去なされ候。",
              "citation": {
                "source": "興津弥五右衛門の遺書（初稿）",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日の夕刊を見た人々は皆、当然の休場を予想していたらしく、毎日の定収入になっている御定連の入りすらも半分以下で、最終幕の前に「当劇場主轟九蔵氏急死に就き勝手ながら整理のため向う一箇月間休場いたします」の立看板を舞台中央の幕前に出した時には、無礼にも拍手した奴が居た。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしたら先生がピアノを買った方がいいだろうというすすめで、一台中古を見つけてくれた。",
              "citation": {
                "source": "親子一体の教育法",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台中央に立ち停まり、ひそかにふところから懐剣を取り出して引き抜き、じっと見入る。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕開くと、合爾合姫が舞台中央に上手を向き、うな垂れて立っている。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう世界の声、眼がまぢかに伝えられるのが、一区切りすると、近松門左衛門作忠臣蔵の舞台中継、さもなければ講談などというものがあります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀と赤の飛行服をつけて上空からやって来た、中央からの婦人使節スワーボダに率いられて、チュダコフ一隊はその飛行機に向って、舞台中央に組み立てられたヤグラを一段一段と高くよじのぼってゆく。",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一千にあまる来賓はすべての階級を網羅し、その視線の悉くそそがれている舞台中央には、劇場主川上音二郎が立って、我国新派劇の沿革から、欧米諸国の劇史を論じ、満場の喝采をあびながら挨拶を終った。",
              "citation": {
                "source": "マダム貞奴",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸くの思いで台中港へ着き、河を遡って台南の税関へついた。",
              "citation": {
                "source": "梟啼く",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台中央に一列のベンチ。",
              "citation": {
                "source": "遂に「知らん」文六（三場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台中央に白樺の幹が二本並んでゐる。",
              "citation": {
                "source": "秋の対話",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台中心の演劇という表現は、まさに意味がないようだけれども、ここで言おうとするのは、舞台を含めた劇場の性格が、演劇の「かたち」をいろいろに変える実例についてである。",
              "citation": {
                "source": "演劇の様式――総論",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "……舞台中央には、華麗な御所車が一台止っている。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "室内上手の部分は一段高くなつて畳敷になり、その奥はカーテンで仕切られて見えず、右の隅は押入れ、カーテンと押入れの間は狭い通路（裏梯子へ）、二台の球台中一台だけが正常な位置（下手寄り）に据ゑてあり、他の一台は壊れて使へないか奥上手に片寄せられてゐる。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは古羅馬において貴族の寝室の寝台中よりよく発見せられるものであって――たとえば、ポンペイやヘルクラネウムの廃墟中より発掘せられたものにも、これが多数見出されたのでありますが、寝台の蒲団や枕の中に詰めてあったものは、ことごとくこれとまったく同一物質のものだったのであります。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥ったカルーソーが舞台中をふうふう言いながら追い廻したという逸話も伝わっている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "台中の近所は米の産地だからそろそろ取入れが近づいたというのでその地方へ出張するのだろうか。",
              "citation": {
                "source": "蝗の大旅行",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四段第一場　同じく座敷牢の場舞台中央には藁葺きの辻堂。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台中央には、比叡山の観如上人と従僧三、四人。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "――と今度は、孔雀扇を胸に当てた白衣黒帯の老人が尖ンがり靴をヒョコヒョコ舞台中央まで運ばせて来て、オホンと一つまず客を笑わせ、「あいもかわりませず連日のお運び。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そして鎮台中、生命あるものすべて、声をあげて泣かぬはなかった。",
              "citation": {
                "source": "日本名婦伝",
                "author": "谷干城夫人",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一首は、台南か台中か、生蕃が叛乱して大勢殺された西螺街とかいう所へ行った時、非常に強い印象を受けて、折があったらその悲しみを話したいと思っていたので、「大君は神にしませば民草のかかる嘆きも知ろしめすらし」と吟じた。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "送つて來て呉れた燈臺中の人も、船頭たちも、みな聲を合せて笑つた。",
              "citation": {
                "source": "樹木とその葉",
                "author": "島三題",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
