    "definitions": [
      {
        "index": 1,
        "gloss": "Lethocerus deyrollei (species of giant water bug)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "田んぼの水中で田鼈がじっと隠れていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "田鼈は獰猛な肉食性の水生昆虫として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "採取した田鼈を観察するため水槽に入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「ひどく痛むんですか」「ええかなりひどく」　と答えたがめんどうだと思って、「いいからはいっていてください。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとこの子は学問よりも大そう力が強くって、お弟子に入ったあくる日、自分の体の三｜倍もあるような大きな石をかかえてほうり出しますと、三｜尺も地びたがめり込んだので、和尚さんはびっくりして、この子はただものでないと思いました。",
              "citation": {
                "source": "雷のさずけもの",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう、こんな風な生きかたがめんどうくさいのだ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
