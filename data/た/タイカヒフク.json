          "standard": [
            {
              "text": "鉄骨の耐火被覆を施さないと、火災時に強度が低下する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その建物の耐火被覆が劣化し、補修が必要になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "耐火被覆の厚さは建築基準法で厳密に規定されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "家屋の唯一の耐火被覆物である厚い屋根瓦を、シャベルで落しているのを見ると、如何にも莫迦げているが、これは屋根板をめくり取るのを容易にする為で、かくするとへ火が飛びうつらぬことが観察される。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
