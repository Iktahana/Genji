    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to pull in",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "漁師たちが網をたくるために一列に並んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "皆で綱をたくって船を岸に近づけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ロープをたくりながら荷物を引き上げていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "」カムパネルラが、不思議さうに立ちどまって、岩から黒い細長いさきの尖ったくるみの実のやうなものをひろひました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」鳥捕りは風呂敷を重ねて、またくるくると包んで紐でくくりました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその根株のまわりから、ある時私たちは四十近くの半分｜炭化したくるみの実を拾いました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "湊の対応ぶりに有頂天になった相手客が、なお繰り返して湊に盃をさし、湊も釣り込まれて少し笑声さえたて乍らその盃の遣り取りを始め出したと見るときは、ともよはつかつかと寄って行って「お酒、あんまり呑んじゃ体にいけないって云ってるくせに、もう、よしなさい」　と湊の手から盃をひったくる。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで毎日こうして次の論文の原稿を書いていたのかと思って、その一枚を取り上げてなんの気なしにながめていたら、Ｎ教授がそれに気づくと急いでやって来て自分の手からひったくるようにそれを取り上げてしまった、そうしてボーイを呼んでその原稿いっさいを紙包みにしてひもで縛らせ、それを領事に手渡しした。",
              "citation": {
                "source": "Ｂ教授の死",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」カムパネルラが、不思議そうに立ちどまって、岩から黒い細長いさきの尖ったくるみの実のようなものをひろいました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おや、変なものがあるよ」カムパネルラが、不思議そうに立ちどまって、岩から黒い細長いさきのとがったくるみの実のようなものをひろいました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ね、そうでしょう」鳥捕りは風呂敷を重ねて、またくるくると包んで紐でくくりました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその根株のまはりから、ある時私たちは四十近くの半分炭化したくるみの実を拾ひました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」カムパネルラが、不思議さうに立ちどまつて、岩から黒い細長いさきの尖つたくるみの實のやうなものをひろひました。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と鋭く言い放ってひったくるように籠を取って、水の中に突き込んだ。",
              "citation": {
                "source": "河霧",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はまるで籠を引ったくるようにして、ムシャムシャムシャムシャ、沢山喰べてから、やっと、「おじさんありがとう。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そんではい、夜さり、夜ばいものが、寝床を覗くと、いつでもへい、白蛇の長いのが、嬢様のめぐり廻って、のたくるちッて、現に、はい、目のくり球廻らかいて火を吹いた奴さえあっけえ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "引ったくるようにその一枚を貰って、その足で鶴木検事を裁判所に訪問し、折柄、宣告を澄ましたばかりの検事に裁判所の応接室で面会をすると、その写真を手渡ししながら自分の見込をスッカリ打明けた。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "さんたくるす　さんたくるす　遊樂至上のうみのうへ、岬をめぐる浪のうたかた、浪とほれば鳥禽の眼にも見えず、況んや白日の幽靈は、いと遙かなる地平にかげをけちゆくごとし。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」私の言葉の終らぬさきから、ひったくるように返事して、涙に潤んでいるような細い眼を、精一ぱいに大きく見開いた。",
              "citation": {
                "source": "善蔵を思う",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっと思うと、お蔦は知らぬ顔をして、またくるりと背を向いた。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉さん、そうすると、その火がよ、大方浪の形だんべい、おらが天窓より高くなったり、船底へ崖が出来るように沈んだり、ぶよぶよと転げやあがって、船脚へついて、海蛇ののたくるようについて来るだ。",
              "citation": {
                "source": "海異記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」高須は、傍から、ひったくるようにして、受け取り、顔をしかめて開いて見た。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」高須は、傍から、ひつたくるやうにして、受け取り、顔をしかめて開いて見た。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "我知らず声を潜めて、「知ッてる……生紙の紙袋の口を結えて、中に筋張った動脈のようにのたくる奴を買って帰って、一晩内に寝かしてそれから高津の宮裏の穴へ放すんだってね。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　その、扇子を引ったくると、「あなたよ、こんなものを置いとくだ。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたずらものの野鼠は真二つになって落ち、ぬたくる蛇は寸断になって蠢くほどで、虫、獣も、今は恐れて、床、天井を損わない。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その蚤だか虱だかを捻る片手間に、部屋から下ったという蕎麦の残り、伸びて、蚯蚓のようにのたくるのを撮んじゃ食い、撮んじゃ食う。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も思わず莞爾して、引ッたくるように膝へのせて、しっかり抱しめて頬をおッつけると、嬉しそうに笑ッちゃあ、（父様が居ないと可い）と、それまたお株を言うじゃあないかえ。",
              "citation": {
                "source": "化銀杏",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "とろ／＼と睡つて覚めれば、犬が来てぺろ／＼と嘗めて居る……胴中を蛇が巻く、今穴を出たらしい家守が来て鼻の上を縦にのたくる……やがては作者の身躰を襲ふて、手をゆすぶる、襟頸を取つて引倒す、何者か知れずキチ／＼と啼いて脇の下をこそぐり掛ける。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで狭い堤防上でまたくるりとターンすると再び川上へ向って駆けて行った。",
              "citation": {
                "source": "快走",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
