        "examples": {
          "standard": [
            {
              "text": "「成績が伸び悩んだため、彼は塾を退塾することを決めた。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「多くの生徒が、受験期を終えて静かに退塾していく。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "受験に失敗したため、彼は退塾を決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "即ち輪講をして窘められて、帳面に黒玉ばかりつけられて、矢鱈に閉口させられてばかり居たぎりで、終に他人を閉口させるところまでには至らずに退塾って仕舞いましたのです。",
              "citation": {
                "source": "学生時代",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに去年の暮、例の女丈夫は教師に雇われたとかで退塾してしまい、その手に属したお茶ッぴい連も一人去り二人｜去して残少なになるにつけ、お勢も何となく我宿恋しく成ッたなれど、まさかそうとも言い難ねたか、漢学は荒方出来たと拵らえて、退塾して宿所へ帰ッたは今年の春の暮、桜の花の散る頃の事で。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしそれでいけなかったら、ぼくいつでも退塾するよ。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
