[
  {
    "uuid": "aa9a76d3-9154-5ef0-b028-debdbc606ea0",
    "entry": "立て替える",
    "reading": {
      "primary": "たてかえる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
        "動詞-他動詞"
      ],
