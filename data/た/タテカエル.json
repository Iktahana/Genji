        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "台風で被害を受けた家を、来年中に「建て替え」る予定です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "歴史的建造物を「建て替える」のは、元の姿を忠実に再現することが求められる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "古民家をモダンなデザインに「建て替える」リフォームも人気だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "自分ひとりの場所となったその家を、彼は建て替えることを考える。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一つ、お屋敷風に建てかえるとしますかな？",
              "citation": {
                "source": "都会地図の膨脹",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでアリゾナに新しい塔を建てたというわけだ」「お金はあるのですね、そんなに塔を建てかえるようでは……」「それはあるさ。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
