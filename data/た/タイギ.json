        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは、対義語の当てっこでした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒のアント（対義語の略）は、白。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は、つくづく呆れかえり、「罪ってのは、君、そんなものじゃないだろう」　罪の対義語が、法律とは！",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そして彼は、朝廷へは抗したくないが、対義貞との戦いならば――と、義貞のおびき出しには、むしろ主戦的な構えですらあったのだった。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
