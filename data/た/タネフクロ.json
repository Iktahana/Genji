          "literary": [
            {
              "text": "新城で種袋の口が逆さになつて、皆、こぼれて了うた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "「頭に気をつけてくれ」と清七が云った、「ここは菜種袋を積んで置くところで、幅は九尺しきゃあねえし、頭の上はすぐに天床だ、まあここへ坐ってくれ」　よく来たなぶしゅうとか、外のようすはどうだとか、誰ともわからない声が左右から聞えた。",
              "citation": {
                "source": "さぶ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
