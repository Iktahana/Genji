        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――　このヤマトタケルの命が、垂仁天皇の女、フタヂノイリ姫の命と結婚してお生みになつた御子は、タラシナカツ彦の命お一方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでタラシナカツ彦の命は天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "六、仲哀天皇后妃と皇子女　タラシナカツ彦の天皇（仲哀天皇）、穴門の豐浦の宮また筑紫の香椎の宮においでになつて天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてタラシナカツ彦の天皇の御年は五十二歳、壬戌の年の六月十一日にお隱れになりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
