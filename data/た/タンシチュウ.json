        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "シチュウには牛の舌をお買いになってタンシチュウをお拵えなすっても沢山出来てお徳です。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "先刻持って来て下すったのはタンシチュウとウドの酢煮ですか。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほどこれがタンシチュウですな、これはどうしてお拵えになるのです」お登和「これは先ず牛肉屋から牛の舌を買って十分間ばかり水へ漬けておいて塩をつけてゴシゴシ洗うと牛のヌメリがよく取れます。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "名宝前の小さな、古風な洋食屋だが、ここのタンシチュウは、実にいい。",
              "citation": {
                "source": "八の字づくし",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "小松へ寄って理髪、バッタリ坂本に逢ひ、珍しや八洲亭でポタアジュ、ハムエグス、タンシチュウ、コロッケ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一回の終り、入浴もせず、スコットから、スパゲティとタンシチュウとって食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の終りには、プランタンのオムレツとタンシチュウ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽屋で食事、スエヒロのタンシチュウにハムライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンシチュウとライスカレー、食堂からとったのだが、そのまづいこと。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "払ひをすませ（特別扱ひと見えて五円也）銀座へ出て、不二アイスへ寄り、ハムエグスとタンシチュウを食ひ、アイスクリムソーダを二杯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあと、タンシチュウ、マッシュドポテト、バタライスと行き、雨やんだ中をタクシー帰宅。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "津田と二人だったが、電話して、穂積来り、まあこゝのタンシチュウを食ってみろとすゝめる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕、タンシチュウ一つ平げ、ドビグラスのうまさにたんのうし、お代りを命じたところだった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕、タンシチュウ二の後、赤だしとオムライスと命じる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝなら安心、サントリーハイボール、そして、タンシチュウから、メキシコサラダと行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "メキシコサラダとタンシチュウ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンシチュウから始めて、豚カツを食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、チーズトースト、コールドコンソメ、ピロシキー一、タンシチュウ・マッシュドポテト添。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンシチュウ、マッシュドポテト、バターライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀の塔の鍋、今夜は、タンシチュウがなくて、オックステールとビーフのみ、専らビーフを食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "リゾールパイから、タンシチュウ、マッシュポテト、バタライスを食ひ、サントリーハイボールを又二三杯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンシチュウ、マッシュドポテト。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンシチュウ、バタライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペルメニーと、タンシチュウ、バタライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
