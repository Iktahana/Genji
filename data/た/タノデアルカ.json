          "literary": [
            {
              "text": "諸君ハ、日本居留民ノ生命ヲ保護スルタメニ来タノデアルカ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "居留民ノ財産ヲ守ルタメニ来タノデアルカ？",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ト浄吉トノ結婚ヲ、予ノ妻デサエアンナニ激シク反対シタノデアルカラ、アノ時分マデ母ガ長生キシテイタラ、ドンナニ反対シタコトデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは「ホントウノ譫語ダッタノカ、譫語ノゴトク見セカケテ故意ニ僕ニ聞カセタノデアルカ」どちらであるかといえば、その中間ぐらいであったといえよう。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
