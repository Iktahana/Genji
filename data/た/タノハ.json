        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕ガ昔カラ西洋ヲ見タガッテ居タノハ君モ知ッテルダロー。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "又句読点もないのですが、わかり易い為普通の文にして読みます）問　ソウスルト被告ガ道子ヲ殺ス気ニナッタノハ、道子ガ他ノ男ニ心ヲ移スヨウニナッタカラカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　私ガ道子ヲ殺ス気ニナッタノハ、今マデ私ニ親切デアッタノニ心変リヲシテカラ全ク私ニ冷淡ニナリ、友田ヲ愛スルヨウニナッタカラデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　被告ガ道子ヲ殺ス気ヲ起シタノハイツ頃カ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ馬鹿サンネ、私がアナタニ身ヲ任セタノハカラカッタカラダワ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄サンガ何故殺害サレタカ分リマセンガ、其ノ殺害ヲ一番早ク云イ当テタノハ動坂三郎氏デス。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄サンヲ殺害シロト命令シタノハ動坂三郎ニ違イアリマセン。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒井は続いて紙の上に、「生レタノハ何年ホド昔」「千八百――年、西洋の国では、その年が年号の初めです」「ソレデハ基督ハ西洋ノ王様カ」「いいえ」「ソレデハ猶太ノ王様カ」「いいえ」「ソレデハ基督ハ何者ノ子ダ」「大工さんの子であります」「大工ノ子。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト第一番ニカラカツタノハオネコサンデシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しからばそのアオツヅラフジとは一体どんな植物か、すなわちそれはアオカヅラ（『本草和名』、『本草類編』、『倭名類聚鈔』）、一名アオツヅラ、一名アオツヅラフジ、一名ツヅラカヅラ、一名ツヅラフジ、一名ツヅラ、一名ツタノハカヅラであって普通にはツヅラフジと称える。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ七十七歳ノ今日ニナリ、既ニ左様ナ能力ヲ喪失シタ状態ニナッテカラ、男装ノ麗人ナラヌ女装ノ美少年ニ魅力ヲ感ジ出シタノハナゼカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ステージダンサーデモ幾分カソウナルケレドモ、アタシハ幸イニシテナラナカッタワ」浄吉ガ彼女ニ魅セラレタノハ彼女ノ姿態ニアルコトハ確カダガ、ロク／＼学校モ出テイナイノニ、頭モ悪クハナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ知ッタノハ数エ年七十七歳デ喜寿ヲ祝ッテカラデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ心理状態ニナッタノハ最近デアルガ、ソレガマス／＼極端ニナリツヽアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭デバーベキューガ始マッタノハ夕刻六時半頃ダッタガ、賑カデ景気ガヨサソウナノデ、予モツイ若イ者タチノ中ヘ参加スル気ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモマア、ホンノ一時的ノ現象ダッタンデゴザイマスネ」ホットシタノハ佐々木バカリデハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新築シタノハ予ノ父デアッタガ、父ハ大正十四年、予ガ四十一歳ノ時ニ死ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ蟋蟀ト聞イタノハ蟋蟀デハナク、予自身ノ呼吸音ダッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ、婆サント連レ立ッテ這入ッテ来タノハ何カ仔細ガアルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ油谷サンノ奥サンガ何ヨリ先ニ眼ニ附イタノハ、颯チャンノ指ニ光ッテイタキャッツ・アイダト云ウンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大キナ犬ヲ飼ウヨウニナッタノハ浄吉ガ嫁ヲ迎エテカラデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ晩アンナ涙ガ出タノハ、ヤッパリ心ニ死ノ豫感ガ萌シテイタカラナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マア何ニシテモ彼女ノ顔ガ見ラレタノハ悪クナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヲ止メタノハ医師トシテ実ニ立派ナ心ガケト云ハナケレバナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガコノ家ヲ訪ウノハコレデ二回目デアルト云ウガ、最初ニ訪ウタノハイツノコトデアッタカ殆ド記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ東京ヲコンナ浅マシイ乱脈ナ都会ニシタノハ誰ノ所業ダ、ミンナ田舎者ノ、ポット出ノ、百姓上リノ、昔ノ東京ノ好サヲ知ラナイ政治家ト称スル人間共ノシタコトデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本橋ヤ、鎧橋ヤ、築地橋ヤ、柳橋ノ、アノ綺麗ダッタ河ヲ、オ歯黒溝ノヨウニシチマッタノハミンナ奴等デハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……………………………………………………………………………………………………………………………………………………………………十七日ノ朝、颯子ガ何ノ断リモナシニ勝手ニ東京ヘ立ッタコトヲ知ッタノハ、午前十一時頃デアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
