          "standard": [],
          "literary": [
            {
              "text": "タマシヒ　やつぱり三年位のときだつたんだらう。",
              "citation": {
                "source": "ハナとタマシヒ",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれはタマシヒなのよ」「……？",
              "citation": {
                "source": "ハナとタマシヒ",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれがタマシヒなの」と誰かゞ感に耐えない声を出した。",
              "citation": {
                "source": "ハナとタマシヒ",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから一しきりタマシヒの話でにぎわつた。",
              "citation": {
                "source": "ハナとタマシヒ",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「タマシヒつて眼ン中にあるもんなの？",
              "citation": {
                "source": "ハナとタマシヒ",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とタマシヒを教へてくれたお友達を引張ッて、「変よ、右の眼でやつても左の眼でやつても見えるわよ。",
              "citation": {
                "source": "ハナとタマシヒ",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            },
            {
              "text": "真暗な中でもタマシヒは見えた。",
              "citation": {
                "source": "ハナとタマシヒ",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハナはノーミソの腐つたもの」「タマシヒは眼と眼の真中にある黄色いまるい輪である」と思ひこんでゐた。",
              "citation": {
                "source": "ハナとタマシヒ",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがハナの方を公開したら、大笑ひに笑はれたので、すこぶる自信を失つて、タマシヒの方迄あやしくなつた。",
              "citation": {
                "source": "ハナとタマシヒ",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙覚・契沖・真淵らの霊極の説、即ち、「タマシヒノキハマル内の命」の意とする説は余り有力でないようだが、つまりは其処に落着くのではなかろうか。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
