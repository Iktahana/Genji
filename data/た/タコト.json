        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレハ、夢デ見タコトガアリマス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "文壇、コノ四、五｜年ナカッタコトダ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "道場と知ってか知らずにか、無敵の宅へ盗賊がかかったらしく、真夜中に裏の戸がガタコトと鳴った。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "発汗剤のききめか、漂うような満身の汗を、妻は乾いたタオルで拭うてくれた時、勝手の方から何も知らぬ子供がカタコトと唐紙をあけて半分顔を出してにこにこした。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　妻はもう起きて台所をカタコト響かせている。",
              "citation": {
                "source": "白い路",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマオカマサヨシクンゴフサイガ、シナヘイノギセイトナッタコトヲオクヤミモウシマス、イサイハアトヨリ、ニホンジンクラブ　務の顔色はみるみるかわった。",
              "citation": {
                "source": "白っぽい洋服",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イアイダ、タベモノヲ見タコトモナカッタトコロヘ、ハジメテソウシキノオソナエモノヲミルト、モウ矢モタテモタマラズ、目ガクラクラットシテ、ソレニ小サイ弟ヤ妹ナノデ、死ンダオ母ッチャニワルイトオモイナガラ、スキヲネラッテ、ミンナデムチュウニナッテタベテシマッタンダッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イロイロオセワニナツタコトヲシンシヤス」と書いた。",
              "citation": {
                "source": "海をわたる",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "その留守のある晩に、僕のすぐの妹と女中とが夜なかにふと目がさめてどうしても眠られずにいる間に、台所の方で例のカタカタコトコトが始まった。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕ノ親愛ナル新吉ヨ、僕ハイヨイヨ希ヒガカナツテ勇マシイ水雷艇ノ乗組員ニナツタ、ダガ僕ハ御国ノ士官ニナリ損ツタコトガザンネンダ。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ私ハ近ゴロ原稿ヲ書クニモ手紙ヲシタタメルニモヒラガナトイウモノヲ使ツタコトガナイ、ソレハナゼカトイウニ、我々仰臥シタママデモノヲ書クモノニトツテハ些細ナ力ノ消費モ大キナ問題トナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれ共それも気のつかない内に忘れてしまって単調で有りながら注意味の深い様なカタコト、カタコトと云う音に、どこまでも運ばれて行きたい様になって居た。",
              "citation": {
                "source": "蛋白石",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一歩ごとに濡れつばめの鍔のゆるみが、カタコト鳴るのが、「人が斬りてえ、アア人が斬りてえ」――というように聞こえるので。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "カタコトと桶の転がる音など――女湯の客が、何か異常を知って狼狽しているらしいけはいだった。",
              "citation": {
                "source": "電気風呂の怪死事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "このとき南に面した硝子窓が、カタコトと鳴って、やがてパラパラと高い音をたてて大粒の雨がうち当った。",
              "citation": {
                "source": "恐しき通夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年ノ今頃モ修繕シタコトガアッタッケガ、ソノトキハ赤沢常造ノ奴ガイタカラ、半日デ片付イタモノダ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月八日◯去ル五日ニ気ガ附イタコトデアルガ、イツノ間ニカ左眼ガワルクナッテイルノダ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "音ハ耳ヲ聾スルバカリノグオーツトイフ音デ、生來之ニ比較スベキ音ヲ聞イタコトガナイ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆ンナオレガ悪イカラ起ッタコトダト気ガツイタ……も出来がいい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "六十五　ビタをハリ飛ばしておいてからの神尾主膳は、その足で台所へ行って、膳棚の上から備前徳利を一つ取り下ろして振り試みると、まだカタコトと若干の音がする。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "マア、ナンテカワイイアヒルチヤンニナツタコト。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「玉ネギノヱカキサンナンテキイタコトガナイ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハモンコチヤンヲイヤダナンテオモツタコトヲ心カラコウクワイイタシマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コマツタコトデスネ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ、ヨシヲサンノオカアサンハ、ソノマヒゴヲドコカデ見タコトガアル子ダト思ヒマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜中になると、骨壺がカタコト鳴りやがって、うるさくッて仕様がないんですよ」「気のせいだよ。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の来訪を知るともぞ／＼起き上つてガタコト雨戸を開け放し泪の乾くまで空をぼんやり見てゐるのだ。",
              "citation": {
                "source": "訣れも愉し",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲の途中から、それに合せて踊っている小さな靴音がカタコト、カタコトと混る。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
