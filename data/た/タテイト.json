        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "織物を作るには、まず「縦糸」を機に張る作業から始める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この生地は「縦糸」に絹を使い、横糸に綿を織り交ぜている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "機織り機で「縦糸」をピンと張ることが、織物の仕上がりを左右する重要な工程だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ごくごくわずかな部数の本を出会いの場としても、書き手の与えてくれる縦糸と、読み手の心が紡ぎ出す横糸を編み、大切な人生の一こまを織りあげることはできるのです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "作品の縦糸としては、細川忠利と家臣阿部彌一右衛門との間にある永年の感情的なしこりが、性格と性格との間に生じるさけがたい共感と反撥の姿として周密にとりあげられている。",
              "citation": {
                "source": "鴎外・芥川・菊池の歴史小説",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホバード夫人は、「それが世界に通商をひろめて来た精神」である不屈不撓な事業熱をもっている船長イーベン・ホーレイの多難な生涯と揚子江上の荒々しい回漕事業の盛衰とをこの小説の縦糸にしているのである。",
              "citation": {
                "source": "「揚子江」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "個性の成長とその十分な開花の希望とを人類全体につたえたいからこそ仕事をするのであるという確信は、歴史の縦糸を辿れば、自然主義思潮に洗われて自己の目ざめを経た後でなければ、発生し得なかった動向であった。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この山川雲霧、禽獣虫魚、草木花卉という横糸、春夏秋冬という縦糸、即ちこの経緯の織りなす天地を描き、その天地に情を寄する心が我が俳句への道であります。",
              "citation": {
                "source": "俳句への道",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "思いがその糸で、善行悪行が縦糸横糸、そして人生という機織り機で織られた布こそ人格である汝心を澄ませよ、そうすれば汝の心は豊かで素敵で美しく、不和にも無傷となる。",
              "citation": {
                "source": "朝に想い、夜に省みる",
                "author": "MORNING AND EVENING THOUGHTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "灰色服のご婦人とは、ビートリスの言うくちなしの花だが、この人が物語の縦糸のように謎に絡んでいる。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "縦糸は太いが、横糸は極めて粗い。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "方言うたては、うたていと形容詞に扱はれて、大抵は嫌悪倦怠感を起させる対象に向つての表情となつてゐる。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして今も方言では、うたていとして残り、煩雑・困惑・倦怠などの情調を表す語として用ゐられる地方が、相応にある。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "呉絽というのは経糸に羊の梳毛をつかい、緯糸に駱駝の毛をつかう。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "都鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "尼寺の床下が、広い機織場になっていて、牢造りになった暗い穴蔵で、三十人ばかりの青坊主の女が、馬の落毛の撚糸を経糸にし、自分らの髪の毛を梳きこんで呉絽を織らされていた。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "都鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "経糸の切れた古博多の帯を繩のようにしめ、鞘だけは丹後塗だが中身はたぶん竹光……腰の軽さも思いやられる。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "氷献上",
                "note": "青空文庫"
              }
            },
            {
              "text": "その経糸に十六世紀ロンドンの汚物、野蛮性を習性として持ち、その緯糸に「タンバアレン」の光彩や「ヴィナスとアドニス」の技巧に熱狂的な愛着を持つ、そういう頭脳の織物というものは、いったいどんな種類のものだったであろう。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "『機の上には、経糸と云ふものになる沢山の糸を次ぎ次ぎに順番に並べる。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同時に、織り手は梭の横糸を、左から右、右から左と、半分づつの経糸二つの間を通す。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "経糸の切れし時の外機械を停むる事なし。",
              "citation": {
                "source": "織工",
                "author": "根岸正吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カセは布を織る経糸を束ねたもので、その糸を※枠というやや大ぶりな枠にとってから、染めたり色を合わせたり綜たりするので、糸のかんじょうにつごうのよいように、長さのちゃんときまった大きい輪になっていた。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の頃から編み始め、年端もいかないうちに経糸や編み物に指がうずうずしました。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも白と紺と藍との三色を用い、経糸は必ず麻にして、ひとえに丈夫を心掛けます。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "反動と保守が政府の政策のたて糸であった。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤミ屋の親分、子分、水中の町の顔役、その結たくがたて糸となっていて町のあたりまえの人たちの水中生活の姿が浮び出ないしそこで赤旗をもっている人々の活動も添えものとしてあつかわれていて着実な町の生活とのつながりの現実の場面がわからない。",
              "citation": {
                "source": "予選通過作品選評",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「夜明け前」は或る面から言えば一種の歴史叙事詩であるが、主観的に藤村は歴史の或る時代の或る役割をヘンスーの土地のかくの如きものも負っているということを（即ちマルクシストでない自分だって時代の動きに負わされているものがあるという心持を）たて糸としていることはたしかですね。",
              "citation": {
                "source": "「夜明け前」についての私信",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
