        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "問　被告ハ清三ガ寝テ居ル間ニヒソカニ道子ヲ殺ス事ガ出来ルト思ッタノカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　オ前ハ二人ヲ殺スノニ何モ物ヲ使オウトハシナカッタノカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　ソノ間道子ハ黙ッテキイテイタノカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ないというものがあるんだから、ひとがバカに見える」「人間ぎらいになっちゃったんだから、何でもやめさせてくれってがんばったんだ」〔欄外に〕　黒砂糖になるという話、「純白なのはブタノールでもつくらなけりゃいらないのさ」自分、ブタノカワときこえる、「ブタのカワ？",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ西洋デハ、大工ノ子ノ生レタ年ヲ、年号ノ初メニスルノカ」「左様でございます」「基督トイウ人ハ、ソンナニ豪イ大工デアッタノカ」「大工さんの子としてお生れになりましたけれども、基督様は救世主でございました、神様の一人子でございました」「神様ノ一人子トハ？",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "コイヌ村山籌子マアイツタイドコカラコンナニタクサンヤツテキタノカシラ。",
              "citation": {
                "source": "コイヌ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアイツタイドコカラコンナニタクサンヤツテキタノカシラ。",
              "citation": {
                "source": "コイヌ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタニナツテ　メガサメマシタガ、ドツチガ、サキニネムツタノカ　フタリトモ　ワカリマセンデシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタノカホイロモスヅメノアシノヨホデス。",
              "citation": {
                "source": "AU MAGASIN DE NOUVEAUTES",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年時代ノ若山千鳥ノ記憶ガ今ニ及ンデ甦ッテ来タノカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ヲ云ウト予モ彼女ノ食イ残シガ廻ッテ来ルコトヲ豫期シテ―――或ハソレガ今夜ノ目的デ―――コヽヘ来タノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "経助ヲ生ンデカラ後次第ニ愛情ガ冷メタノカ知ラン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "外ニ誰カ出来タノカモ知レナイガ、ソノ点ハ確カデナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「折角ソコマデ習ッタノニナゼ止メタンダネ」「ダッテ、トテモ足ガ変形シチャッテ醜クヽナルノヨ」「ソレデ止メタノカネ」「アタシ、足ガアンナニナルノハイヤダワ」「ドンナニナルノサ」「ドンナニナルッテ、ソリャヒドイノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――イヤ、結局ハ成功ダッタノカナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ休ミニナルト直グ聞エテ来ルッテ、佐々木サンガ云ッテタケド」「今日ハドウシタノカ寝ツキガ悪イ」「アタシガ傍ニイルカラジャナイ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何ダ、モウ起キテタノカ」「アタシコソ昨夜ハ寝ラレナカッタワ」予ガ窓ノブラインドヲ上ゲルト、寝起キノ顔ヲ見ラレタクナイラシク、慌テヽ浴室ヘ逃ゲテ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャワーモ一人デ浴ビタノカドウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モット人ノ悪イ邪推ヲスレバ、予ニ疑ワレテイルコトヲ知ッテイル颯子ハ、治療ノ隙間ニ予ガ廊下ヘ出テ様子ヲ探ルコトモアリ得ルト、推量シタノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子モ一緒ニ出テ行ッタノカ、ソレトモ流石ニバツガ悪イノデ一人デ二階ニ引ッ込ンデイルノカ、一向姿ヲ現ワサナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナコトヲ今知ッタノカ、君ミタイナ利口ナ人ガ」「ダケド、ドウ云ウ気持カラソンナコトヲ考エルノ」「自分デ恋ノ冒険ヲ楽シムコトガ出来ナクナッタ腹癒セニ、セメテ他人ニ冒険サセテ、ソレヲ見テ楽シム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ行ッテ来タノカ」ソレニハ答エズ、黙ッテ掌ノ上ニ一箇ノ石ヲ載セテ見セル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽソウカ、ソウダッタノカト、漸ク悟ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御老人ニハヨクアルコトデゴザイマス」「ジャ、君ハ前カラ知ッテタノカ」「ハア、近頃ハ毎朝伺ッテオリマシタ、ピイピイッテ、オ可愛ラシイオ声デ」「婆サンニモコノ声ヲ聞カシテヤロウ」「知ッテラッシャイマスヨ、ソンナコト」「颯子ガ聞イタラ笑ウダロウナ」「若奥様ダッテ御存知ナイコトガアルモンデスカ」五日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔ノ人デ、母ハ身ノ丈ガ低ク、五尺ソコ／＼ダッタノデ、頭バカリ見エタノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "話シカケレバ叱ラレソウナ気ガシタノデ黙ッテイタノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテソウ云ウ或ル一日ノ印象ガ、コヽニ蘇ッタノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウ云ウ訳デ怒鳴ル気ニナッタノカ、予自身ニモ分ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
