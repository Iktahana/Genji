        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "辞表を上司の机に叩きつけて、彼は会社を去っていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "突き止めた不倫の証拠写真を、夫の目の前に叩きつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "挑戦状を相手の胸元に叩きつけ、決闘の意思を伝えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
