        "examples": {
          "standard": [
            {
              "text": "日本舞踊において、扇子を手にした時の立ち姿の美しさが重要視される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "バレリーナが爪先立ちで静止する立ち姿は、重力を感じさせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "演目のクライマックスで見せた、力強い立ち姿が目に焼き付いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
