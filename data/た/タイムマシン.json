        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "もしタイムマシンがあったら、古代ローマを訪れたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "発明家は、彼のタイムマシンが未来へ旅できると主張した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「わあ、この古いコンピューターはタイムマシンみたいだね！」と彼女は叫んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "実験で旅行するとか」「その通り」「流行雑誌に載っているタイムマシンのようなものですか。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイム・マシーン　ふしぎなこの地下の器械室に足をふみ入れた僕は、おどろきとめずらしさに、ぼんやりとつっ立っていた。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前へ行ってみると「タイム・マシーン第四号」と真鍮の名札が上にうってあり、その名札の下には、計器が五つばかりと、そして白い大きな時計の指針のようなものが並んでついていた。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはタイム・マシーンとも航時機ともいうがね、君がその中に入ると、僕は外から君を未来の世界へ送ってあげるよ。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、ばたんと閉じこめられたこのタイム・マシーンの中だ。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイム・マシーン　最後の竿頭に立って思いついた僕の一策というのは、どんなことであったろうか。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ほう、ここは見覚えのあるタイム・マシーンの中だ！",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕をこのタイム・マシーンの中に入れてくれた、同級生の辻ヶ谷君だった。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ぬと共に、僕はこの世の中へ戻って来て、タイム・マシーンの中に自分の身体を発見したのである。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから例のとおりタイム・マシーンは働きはじめた。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "気がついてみると、辻ヶ谷君がタイム・マシーンの扉を細目に開いて、こっちをのぞきこんでいる。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "このタイム・マシーンは故障になったといっているじゃないか」「えっ、このタイム・マシーンが故障に。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほら、足許に大きな石っころがあるよ」　僕は、辻ヶ谷君に引立てられてタイム・マシーンの地下室から出て焼野原に立った。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイム・マシーンで遠い過去に帰った気分になる町だ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "リカも、昔のリカだ」「オレンジ・ガムは、タイム・マシーンね」「そう。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その器械は航時器（タイム・マシン）というあれでしょう」「あれとは、ちがう。",
              "citation": {
                "source": "洪水大陸を呑む",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼にとって、それはなにか信じられぬほど遠くて、タイム・マシンにでも乗って溯行しなければ手に入らぬ、古い昔の記憶の中で朽ち果てかけている言葉だった。",
              "citation": {
                "source": "赤い手帖",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、彼女から、月が四つある星の話や、それらの星たちの上での奇妙な習慣、彼女の星では実現されているタイム・マシン、宇宙旅行用のロケットの話など、彼には想像もつかない別世界の話を聞くのだった。",
              "citation": {
                "source": "メリイ・クリスマス",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
