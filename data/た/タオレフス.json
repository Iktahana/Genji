    "definitions": [
      {
        "index": 1,
        "gloss": "to fall flat",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は一太刀浴びせられると、そのまま大地に倒れ伏して動かなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "飢えと寒さに耐えかねた旅人が、雪道に倒れ伏しているのを発見した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "悲報を聞いた彼女は、その場に倒れ伏して激しく泣き崩れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "）お沢　（崩折れて、倒れ伏す。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが枯れ立ち、倒れ伏す、河岸、入江に、わけて寒月の光り冴えて、剃刀の刃の如くこぼるゝ時、大空は遙に蘆葦雜草の八萬坪を透通つて、洲崎の海、永代浦から、蒼波品川に連つて、皎々として凍る時よ。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――その足許に、美女倒れ伏す――疾く既に帰り来れる趣。",
              "citation": {
                "source": "海神別荘",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "長順　（立ち上らむとする如くにして、また倒れ伏す。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "笞にはげまされて振い立つ私を見るのも、打撲に抵抗し切れなくなって倒れ伏す私を見るのも、共に私が生きて行く上に、無くてはならぬものであるのを知る。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "行き／＼て倒れ伏すとも萩の原　　　　　曾良　情の極端を現してかつ萩の美をいへる処に感心せり。",
              "citation": {
                "source": "俳句の初歩",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "首をあげて、立ちあがろうとした武蔵守の背後から敵の童が迫ってきて、その首に斬りつけ、倒れ伏す武蔵守の首を取った。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第九巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お蔦　　（人の倒れ伏すを見て）あッ。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "（おきぬ太郎吉を指さし、柄杓を取落して倒れ伏す。",
              "citation": {
                "source": "沓掛時次郎　三幕十場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "（おなかに突き退けられ踏みとどまる、縄がピンと張る）徳之助　（躍り出してピンと張った縄を切る）政吉　　（はずみで倒れ伏す）文太郎　（よろめいて、縄の端を握ったまま、川の中に落つ）岩の蔭から禽がぱっと立つ、暫くして元の処へ下りる。",
              "citation": {
                "source": "中山七里　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとら　（番傘がその以前から動いている、突き飛ばされて傘を手放し、倒れ伏す）水熊の洗い方藤八、腹を立てて内から出る。",
              "citation": {
                "source": "瞼の母　二幕六場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "槍の名將メゲースは彼に迫りて鋭刄を飛ばして首のくぼみ撃つ、齒牙の間を貫きて、舌を無慘に槍は截り其一命を亡せば、冷めたき刄先噛み乍ら彼れ塵中に倒れ伏す。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "240敵は斯くして＊青銅の睡に入りて倒れ伏す、憐れなるかな、友邦を救ふが爲に恩愛の妻に別れてこゝに逝く、妻に贈與の數多きその感謝をばまだ受けず、先きに與へぬ百の牛、又｜牧場より千頭の山羊と仔羊約したり。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "近より來る敵將をわれ黄銅の槍を以て、打てば塵ぬち倒れ伏す、その兵車の上飛び乘りて、先鋒中に加はりて我は進めり。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "額の眞下つんざきて酷く突き入る鋭刄は、眼※の外に眼球を飛び出でしめつ、頭蓋の裏に通れば手を張りて敵は地上に倒れ伏す。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊ペーネレオース打ち向ふ敵將リュコーン、槍をもて　335おのおの覘過ちて利刄空しく飛び去れば、更に互に劍を取り向へり、リュコーン其時に利劍は柄のもとにして折れとぶ――彼を耳の下、ペーネレオース斬りさげて落す首は一枚の皮に僅に支へたれ、肢體は土に倒れ伏す。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬へば強く若き者、鋭き斧をふりかざし、野に立つ牛の角のもと、打ちて無慚に筋肉を　520つんざき去れば、よろめきて大地にどうと倒れ伏す、その有りさまにアレートスよろめき仰に倒れ伏す。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "※と大地に倒れ伏す彼に叫べるアキリュウス、『オトリュンチューデー、勇猛の汝大地に横はる、こゝに汝の命盡きぬ、＊ギューガイエーの湖の　390岸は汝の生れし場、父祖の莊園あるところ、魚族に富めるヒュルロスと渦のヘルモス程近し。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の勇士帶締めて競技の場に入り來り、　685猛然立ちて相向ひその剛力の手をあげて相打つ、かくて物凄く拳と拳たゝきあひ、又すさまじく齒ぎしりの音は響きて、淋漓たる汗は四肢より流れ落つ、今や勇なるエペーオス、隙を覘へる敵の頬激しく打てば耐へ得ず、　690よろめく脚をとゞめ得ず、どうと大地に倒れ伏す。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二弾にも象は倒れ伏すことなく絶望的な緩慢さで体を起こし、弱々しく立ち上がった。",
              "citation": {
                "source": "象を撃つ",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭司怒りて退きて祈を捧ぐ、かくて見よ、　380アポローン彼を愛すれば其訴を納受しつ、無慘の飛箭射放てばアルゴス人は紛々と共にひとしく斃れ伏す、續きて神の怒の矢、更にアカイア全軍の四方に隈なく降り注ぐ、その時豫言者銀弓の神の御旨を宣り示す、　385その時我は先んじて神意解く可く諫めたり。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬へば山の頂に繁る叢林奧深く、母獸によりて養はれ長ぜし荒き獅子二頭、　555牧牛並に肉肥えし群羊屠り餌食とし、獸欄いたく荒らす後遂に主人の手にかゝり、其青銅の鋭刄に撃たれて斃れ伏す如し、二人正しく斯の如、アイナイアースの手によりて、打たれて伏して、おほいなる樅の倒れを見る如し。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "テラモニデース・チュウクロス長槍振ひ耳の下、彼を貫き其槍を引けば大地に斃れ伏す、山頂高く四方より仰ぎ見るべき喬木の幹を青銅の斧伐りて其葉地上に散る如し、　180彼は斃れて青銅の琢ける武具は鳴りひびく。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど眞先にグローコス、盾持つリキエー軍勢の主將、かへしてカルコーン生める勇將バチュクレス討ちぬ、ヘラスの郷に住み、其財力と資産とはミルミドネスの首たるもの、あと逐ひ來り迫る時、　595不意にかへしてグローコス、その長槍をさしのべて、覘違はず敵將の胸のもなかを貫けば、どうと大地に斃れ伏す。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
