        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はまだ経験の浅い「筍」だが、熱意だけは誰にも負けない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "新米の医師は、しばしば「筍医者」と呼ばれ、指導を受けながら成長していく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この患者さんは、私のような筍（たけのこ）では手に負えないかもしれない」と彼は呟いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
