        "examples": {
          "standard": [
            {
              "text": "考古学博物館でタナグラ人形の貴重な展示を見学した",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "このタナグラ人形の精緻な陶工技術に驚嘆した",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "古代ギリシャから輸入されたタナグラ人形は高い芸術価値がある",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "フランス人形や希臘のタナグラ人形や造花や、中世紀の婦人携帯品が並べてある陳列棚に囲まれ、浮世離れた包装室の雰囲気の中で、美しいものを産むことに身を委ねていればよいのです。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともすれば置き忘れたその青玉の眸は微かなタナグラ人形の陰影から小さな玉虫の眼のやうに顫へて、絶えず移り気な私の心を気遣はしさうに熟視める。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイ第十五世時代に出来た飾箱の中に、何一つ欠点の挙げやうのない、美しい、小さいタナグラ人形があつた。",
              "citation": {
                "source": "クサンチス",
                "author": "XANTHIS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
