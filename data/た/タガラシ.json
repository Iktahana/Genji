        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "林の暗い湿地に小さな白花の田芥が咲いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "田芥は早春の雑木林で最初に開花する草本植物である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "観察路脇の田芥を撮影して図鑑と照らし合わせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
