        "examples": {
          "standard": [
            {
              "text": "春の湿地に黄色い花をつけた田芥が群生していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "田芥の葉は水辺の環境指標として使われることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "田んぼの畔で見かけた田芥を素手で触ると刺激を感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "……若い兵隊が一人、口をあけ帽子もなしで、うなじを田芥子の繁みにひたし、眠つてゐる。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "喰べたがらして置き乍ら、いざ取って喰べようとなると歯にかっちりだ。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
