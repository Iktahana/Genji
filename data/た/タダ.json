        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "只あなただけが頼りなのです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "只待つばかりではどうにもならない。",
              "citation": {
