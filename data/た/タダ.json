        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "やりたい、只体力が続かない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "行きたい気持ちは山々だが、只時間がない。",
              "citation": {
