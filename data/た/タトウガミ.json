    },
    "definitions": [
      {
        "index": 1,
        "gloss": "folding paper-case",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大切な帯はたとう紙に包んで箪笥に保管する",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "着物を買ったときについてくるたとう紙は再利用できる",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "たとう紙に包まれた高級な反物が送られてきた",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "父は夏以外ふだんの職業として反物のたとう紙やペーパアを引受けていた。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の中央にあるたものちゃぶ台には読みさしの英語の本が開いたまま伏せてあったが、その表紙には反物のたとう紙で綿密に上表紙がかけてあった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるときは、大丸（有名な呉服店）へ、明石の単衣物を誂えて出来上ってくると、すぐさま、たとう紙から引出して素肌に引っかけ、鬼眼鏡の目をぬすんで、戸棚の中へはいって昼寝をする。",
              "citation": {
                "source": "鬼眼鏡と鉄屑ぶとり",
                "author": "続旧聞日本橋・その三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその夜の唄をしるしたたとう紙を忘れずにもって帰った。",
              "citation": {
                "source": "小品四つ",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "絹糸の方は小※になっていて色別に束にしたのが厚いたとう紙にくるくる包まれて抽出に入れてある。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "参太はたとう紙の上に並べた小判や小粒をみまもっていたが、油の焦げる匂いに気づいて振返り、手を伸ばして行燈を引きよせた。",
              "citation": {
                "source": "おさん",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "参太はたとう紙の一方を折って、並べてある金を隠した。",
              "citation": {
                "source": "おさん",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ数ならぬめくら法師ではござりますが、なまなかてきにとらえられてなさけを受けるのはいやでござります」すると、なんともおことばはなくて、そっとおんなみだをおふきになったらしゅう、ふところからたとうがみをお出しになるおとがさら／＼ときこえました。",
              "citation": {
                "source": "盲目物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "paper folded and tucked inside the front of one's kimono (esp. for use at the tea ceremony)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "茶会の時、懐紙をたとう紙に入れて持参した",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "帯をたとう紙に折り込むのが着物の正式な保管方法だ",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "着物の前にたとう紙を差し込むのが昔からの作法である",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
    ],
