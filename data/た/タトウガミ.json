[
  {
    "uuid": "f3234c2f-2701-5dd8-9dc4-37025cbb6e06",
    "entry": "たとう紙",
    "reading": {
      "primary": "たとうがみ",
      "alternatives": [
        "たとうし",
        "たたんがみ",
        "たたみがみ"
      ],
      "is_heteronym": true
    },
    "grammar": {
