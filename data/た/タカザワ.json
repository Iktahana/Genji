        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "南に、たしか、タカザワという、うるさい洋食屋があった。",
              "citation": {
                "source": "色町洋食",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "タカザワの名物は、カレーライスだった。",
              "citation": {
                "source": "色町洋食",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月十一日（土曜）　十一時起き、南のタカザワといふ洋食屋へ行く、中々うまい、ハムエグス、エビフライ、ステーキ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋食は結局大阪のタカザワだった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀井・上山を連れて南のタカザワへ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、タカザワへ寄り、スープ、魚、鳥、肉と食った、うまし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネると、又、タカザワへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "又南のタカザワへ行き、ポタージュ、魚のグラタンと肉。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、竹川へ行き、タカザワのライスカレーとって食ひ、山田伸吉も来て「ロッパ自叙伝」打ち合せ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、山野・石田を連れて南のタカザワへ行き、ビフカツとカレーライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "タカザワのカレーライスとって食ふ、うまい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
