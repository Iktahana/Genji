        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "太子は斉から帰ると、側臣の戯陽速を呼んで事を謀った。",
              "citation": {
                "source": "盈虚",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日、太子が南子夫人に挨拶に出た時、戯陽速は既に匕首を呑んで室の一隅の幕の陰に隠れていた。",
              "citation": {
                "source": "盈虚",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "之も矢張衛から出奔した戯陽速が此の言葉を伝え聞いて、斯う酬いた。",
              "citation": {
                "source": "盈虚",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "太子は齊から歸ると、側臣の戲陽速を呼んで事を謀つた。",
              "citation": {
                "source": "盈虚",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日、太子が南子夫人に挨拶に出た時、戲陽速は既に匕首を呑んで室の一隅の幕の陰に隱れてゐた。",
              "citation": {
                "source": "盈虚",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "之も矢張衞から出奔した戲陽速が此の言葉を傳へ聞いて、斯う酬いた。",
              "citation": {
                "source": "盈虚",
                "author": "中島敦",
                "note": "青空文庫"
              }
            }
          ]
        }
