        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "非常に根は虔しやかであるくせに、ヒヨツトした場合に突発的なイタヅラの出来る女だつた。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで先生の草がきを見ると「ヰルナラタヅネル」一字のことだ。",
              "citation": {
                "source": "春着",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　タキクンノ　オトウサンガ　ヤサシク　タヅネルト、ミツルクンハ　ナキナガラ、「タキクンガ　イジメタ、アーン。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カウシテ、オトモダチヲ　ジユンジユンニ　タヅネテ　イキマシタガ、ドノ　トモダチモ　オナジ　コトヲ　イフノデ　アリマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「センサウハ　ドチラデスカ、センサウハ」ト　イク　サキサキデ　タヅネナガラ　コノ　ヒトハ　ヒトツキモ　フタツキモ　タビヲ　シマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタハ　コレカラ　ドチラヘ　イクノデスカ」ト　シンセツナ　トシヨリハ　ワカイ　ヲトコニ　タヅネマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　ウチニ　オバサンハ　スツカリ　ウバグルマノ　ナカヲ　カタヅケテ、「スミマセンデシタ、ホントウニ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "稍暫くたつて――（その間一郎は、用事があるからと呼んで置きながら、来て見れば黙つてゐるとは……とばかげた気持がしてゐた時）――漸く先生は、屹と此方を睨めて、「お前だらう、黒板にイタヅラ書きをしたのは――」と云つた。",
              "citation": {
                "source": "悦べる木の葉",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪我をしてはならぬ、イタヅラをしてはならぬと、一々心配してゐたら手足を縛つて真綿にでもくるんで置かなければなるまい。",
              "citation": {
                "source": "家庭の読書室",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔母が玉井家に嫁いだ明治十一年には、私の父もすでに三十一歳になっていたが、この年の六月十五日に初めて、同族河上又三郎の次女タヅと結婚した。",
              "citation": {
                "source": "御萩と七種粥",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "和英、たけのぶのは大きすぎ、井上のは例えば「イタヅラ」という字をローマ字でひくとすぐ「徒に」の「いたづら」が出て来る、ほかのは悪戯（いたづら）が第一に出る、そういうちがい（日本語感のうちの漢文的要素）がありますが、文例ではやはり井上の方がよく選び出して居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒井ノ家ノ系統ヲタヅヌルニ、清和源氏ニ出ヅルモノノ如シ――然レドモ――彼ノ女ニ対スル余ノ愛ガ彼ノ女ヲ殺シ、彼ノ女ノ愛ガマタ余ノ生涯ヲ一変セシメタリトヤイハム。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田、石原、富永、平川、魚住、村瀬、奥屋、鬼頭ナドハ、何レモ特別ニ眼ヲカケタト云フ訳デモナイノニ、士官学校又ハ兵学校ニ入学シテカラモズツト遊ビニ来ルシ、古イトコロデハ退職後マデ機嫌ハドウカトタヅネニ来テクレル有様ダ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　アル日、人参サンノ所ヘ、人参サント　ジヤガイモサンノオ友達ノ玉ネギサンガ　タヅネテキテ、「ボクモ、コンナニ大キクナツタノデ、トウトウ、アシタノアサ、六ジニ　キシヤデ　マチノイチバヘ行クコトニ　キマツタヨ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、「ワンコヤ、イタヅラシテハイケマセン。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌舞伎の伝統の中で女の躾を身につけたソメちやんだから二の腕を見せてもすくみ羞らふサムライの娘カタギ、それが一そう酔客のイタヅラ心をそゝつて、はては掴へてハダカにする。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと違つて、何の技巧も施さず自然にお客がよつてくるのだから、たゞもう時代の寵児、単なる時代のイタヅラの私生児のやうなものでもあつた。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのことは血を見れば分るけれども、然し血の流れぬやうなイタヅラを誰とどこでしてきたかは、私には分らない。",
              "citation": {
                "source": "私は海をだきしめてゐたい",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そして、あのけちな唐變木の婆さん、何かつてばかう怒鳴つてたつけ『まあ、このイタヅラメ、コドモメ！",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "もと／＼かうした私の余技は少年時代のイタヅラ遊びがその下地なのである。",
              "citation": {
                "source": "老残",
                "author": "宮地嘉六",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタヅラにハンコを刻つて見たい方で……」「あれ、さうおつしやらずに……どうぞ……ではこれは少しでございますけれど、あの、お煙草でも……」　彼女は拾円札を三枚私に押しつけるやうにさし出し、別に外食券を二枚ほどそへて、どうしても受けてくれといふのである。",
              "citation": {
                "source": "老残",
                "author": "宮地嘉六",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に自分などは以前ある田舎に、虎杖をサイタヅマという例があって、偶然にそれが京人に面白がられたとしても、少しも意外には考えぬのであるが、今の所ではまだ確かにそうであったとも言われぬ。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "サイタヅマは見た所複合の形で、かつその中にはイタドリのイタを含んでいる。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマタヅは、樹名今のニワトコで、葉が對生しているから、ムカヘに冠するという。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "が――書籍包のなかにタヅコ、カノウと下手な羅馬字で署名してある英読本の手触りをさぐつて見ると、和作はやはり何か友達を売つたやうな心地になつた。",
              "citation": {
                "source": "朧夜",
                "author": "犬養健",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月十日（火曜）　九時起き、タカリの被害につき「相タヅネタキ」で、象潟警察署へ出頭、柳に任せて有楽座へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ、自分の墨イタヅラなど、さう、世に殘されてゆくはずはない。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
