[
  {
    "uuid": "d6f270da-5028-506c-8ede-a35d99993df3",
    "entry": "魂祭",
    "reading": {
      "primary": "たままつり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
