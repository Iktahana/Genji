      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "ceremony honouring the spirits of ancestors (esp. the Bon festival)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お盆の時期になると、親戚一同が集まって盛大な魂祭を執り行う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "魂祭の提灯が並ぶ小道を歩くと、亡くなった祖母を思い出す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "魂祭のために用意した精霊馬を、玄関先に丁寧に飾り付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "翌年の初夏金沢の招魂祭を当て込みて、白糸の水芸は興行せられたりき。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月の十五日は殊に魂祭の当日なれば、夕涼より家を出でて独り彼処に赴きけり。",
              "citation": {
                "source": "妖僧記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……秋の招魂祭の、それも真昼間。",
              "citation": {
                "source": "革鞄の怪",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アメリカにも、招魂祭があるのかしら。",
              "citation": {
                "source": "フォスフォレッスセンス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっそここへ泊まるほうが楽だろうと思って、じゃあいたへやへ案内してくれと言うと、番頭はまたおじぎを一つして、まことにお気の毒さまでございますが、招魂祭でどのへやもふさがっておりますのでとていねいに断わった。",
              "citation": {
                "source": "手紙",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "給仕に出た女が、招魂祭でどこの宿屋でもこみ合っているとか、町ではいろいろの催しがあるとか、佐野さんも今晩はきっとどこかへお呼ばれなすったんでしょうとか言うのを聞きながら、ビールを一、二はいのんだ。",
              "citation": {
                "source": "手紙",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵隊の行列も招魂祭の賑はいも、すべては古風な絵巻か何かのやうにおもへる。",
              "citation": {
                "source": "広島の牧歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "常設館ができるまでは巡業隊の持つてくる写真を芝居小屋か招魂祭の掛小屋で見ていた。",
              "citation": {
                "source": "私の活動写真傍観史",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "招魂祭の掛小屋で乃木大将の一代記というのを見た覚えがある。",
              "citation": {
                "source": "私の活動写真傍観史",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはむしろ招魂祭の見せ物に近きものである。",
              "citation": {
                "source": "雑文的雑文",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "小郡の招魂祭、ポン／＼花火が鳴る、彼等に平和あれ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯屋でゆつくり、そして酒屋でいつぱい、それから栄山公園の招魂祭へいつた、そこは小郡町唯一の遊覧地である、まづ可もなし不可もなしだらう。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「又もあらじ魂祭るてふ折に逢ひて父兄の仇討ちしたぐひは」幸に太田七左衛門が死んでから十二年程立っているので、もうパロヂイを作って屋代を揶揄うものもなかった。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　陣中の芝居　明治三十八年五月四日の午後、阿吉牛堡に駐っていた、第×軍司令部では、午前に招魂祭を行った後、余興の演芸会を催す事になった。",
              "citation": {
                "source": "将軍",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、同じやうな神遊びをもつてゐる鎮魂祭が、新嘗祭に近く行はれるからです。",
              "citation": {
                "source": "神楽（その二）",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それならば、鎮魂祭の時にどういふものが行はれるかといふと、神遊び、倭舞、此の二つといふことになつてゐます。",
              "citation": {
                "source": "神楽（その二）",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ宮廷にある御神でも神祇官にいらつしやる御神の為には既に鎮魂祭の神遊びがあるのですから、これが内侍所に止まつた理由も察せられます。",
              "citation": {
                "source": "神楽（その二）",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "通説には、天岩戸の神出現に先立つて、天鈿女命の舞踊したのが起源だといふ事になつてゐるが、此は神楽よりも古い鎮魂祭の初めを説くものと思はれる。",
              "citation": {
                "source": "神楽記",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "鎮魂行事のあつたのは冬の事であつたが、収穫祭が秋、其に続く鎮魂祭が冬と言ふ風に、祭りを中心に時の名を称へたので、秋と言つても、冬の中にもなり、又暦の考へが変つて、秋に行ふ祭りだから、暦の上の秋季にすると言ふやうなことにもなつて、秋冬にわたつて、祭の種類が次第に分化して行つた。",
              "citation": {
                "source": "神賑ひ一般",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々の国で、小鳥狩りの行はれた冬の時期は、ほゞ鎮魂祭と同じ頃ほひである。",
              "citation": {
                "source": "鷹狩りと操り芝居と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」碧海島の弔魂祭　この無電をうけとった武田博士は、「よし、Ｂ国艦隊が逃げている間に、きっときっと『富士』をつくり上げて見せるぞッ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "その忙しい作業の間のある夜、槍岳頂上で、聯合艦隊司令長官末山大将以下戦死者一万数千人の弔魂祭が行われた。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが二度になつて、一方は仏教との習合によつて非常に盛んになり、初春の方は、正月の行事が行はれた為に魂祭りとしての信仰は、却つて忘れてしまうたのです。",
              "citation": {
                "source": "門松のはなし",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、此魂祭りなるものが、古い時代のは、今の仏教式のものではなく、暮・初春に、山から――もつと古くは海の彼方から――来訪すると信じた祖先神を祀る事だつたので、さうした神を迎へる祭壇が、即、たな或はくらだつたのです。",
              "citation": {
                "source": "門松のはなし",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬へば、冬の祭り、殊に宮廷の冬祭りなる鎮魂祭に持ち出す桙は、柊で作つたものである。",
              "citation": {
                "source": "花の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "魂を附加するのは、鎮魂祭である。",
              "citation": {
                "source": "花の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
