        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "貴族政治ヲ覆滅シタル維新革命ハ徹底的ニ遂行セラレテ貴族ノ領地ヲモ解決シタルコト、當時ノ一佛國ヲ例外トシタル歐洲ノ各國ガ依然中世的領土ヲ處分スル能ハザリシヨリモ百歩ヲ進メタルモノナリキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "自己ノ私利ヲ目的トスル資本制度ニ依頼シテ晏如タルコトハ、今日及ビ今後日本ノ國際的危機ノ忍ブ能ハサル所ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然シナガラ大多數婦人ノ使命ハ國民ノ母タルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上ノ國民教育ノ説明ニヨリテ大學及ビ大學豫備校ノ方針、又其レガ生徒ノ自費タルコト等ハ推想シ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "人權ヲ蹂躙シテ却テ得々タルコト我國ノ官吏ノ如キハ少ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ハ日本ノ一部タルコト北海道ト等シク正ニ「西海道」タルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ根本原因ハ日本資産家ノ侵略ガ官憲ト相結ビテ彼等ノ土地ヲ奪ヒ財産ヲ掠メテ不安ヲ生活ニ加ヘ怨恨ヲ糊口ノ資ニ結ビタルコトニ存スルヲ知ラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒユース」ガ勞働者出身ナリトモ、「レニン」ガ社會主義者ノ尊敬スベキ同志ナリトモ、國際的對立ヨリ見テ彼等ガ〔大地主〕タルコトハ、昔時魚賣タリシ大倉喜八、貧書生タリシ加藤高明ガ無産階級ヨリ見テ富豪タルト同シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只獨逸ノ社會主義ニ此ノ國際的理解ナク、且ツ中世組織ノ「カイゼル」政府ニ支配セラレタルガ爲ニ、英領分配ノ合理的要求ガ中世的組織ノ破滅ニ殉ジテ不義ノ名ヲ頒チタルコトヲ注意スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "米國ノ十三洲獨立戰ハ其ノ始メ常ニ英兵ニ敗ラレツツ幾年ヲ經過シタル後、最キ有力ナル實力援助ヲ與ヘタル佛蘭西海軍ガ英國海軍ヲ「メーン」岬ニ決定的ニ撃破シテ陸兵輸送ヲ不可能ナラシメタルコトニ存ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ今次ノ大戰中ニ於テ日本ハ獨逸ノ青島ヲ領有シテ支那ニ還附セザランコトヲ企ツルト共ニ、獨逸ノ投資ヲ繼承シ更ニ北支那ニ投資的侵略ヲ學ビタルコト悉ク獨逸ノ跡ヲ追フ者ナラザルハナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが真実に子供たちの運命を予言しうるものとすれば（実験の結果によれば――と当代の心理学者が権威をもって発表する）コノ指数ニ満タザルモノハトウテイ社会有用ノ人間タルコトヲ得ズ。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "証明書勝見伍策明治三十一年九月九日生　右ハ本療養所患者ニシテ七月三十日ハ其ノ病室ニ在リテ正規ノ療養ニ尽シタルコトヲ証明ス「そんなことがあり得るだろうか。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダシ、貴隊ハソ連潜水艦タルコトヲ極力カクスコト。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ之レ皆貴関ヨリ密輸セラレタルコト判明セリ。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ本願出願以前、帝国領土内ニ於テ、義手或ハ義足ガ公然製造使用セラレタルコトハ、例エバ明治三十九年東京市下谷区御徒町仁愛堂発行ノ「義手義足型録」ニ依リテ公知ノ事実ナリ、仍リテ本願ハ特許法第一条ニ該当セザルモノト認ム』　と、拒絶理由が述べてあった。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「福音書ノ何レノ部分ニモ耶蘇ノ面貌ヲ記載シタルコトナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "事ニ臨ミ生疎施スナク、竟ニ西洋ノ學術ト雖ドモ、亦無用ノ長物タルコトヲ免レザルノ弊アルベシ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "乍チニシテ島原ノ妓楼廃止セラレテ那ノ輩這ノ地ニ転ジ、新古互ニ其ノ栄誉ヲ競フニオヨンデ、好声一時ニ騰々タルコトヲ得タリ。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクバクモ亡クシテ彦之ハ房州ニ帰リ彼此訊問｜杳然タルコト数年ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸山ソノ麓ヲ擁シ扶輿磅※タルコトソノ幾十里ナルヲ知ラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ欲スルモノハ進ンデ植物タルコトヲ希望セヨ！",
              "citation": {
                "source": "のんしやらん記録",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
