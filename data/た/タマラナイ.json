    "definitions": [
      {
        "index": 1,
        "gloss": "intolerable",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この蒸し暑さはもう堪らない、早くエアコンをつけてくれ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "満員電車の中で足を踏まれるのは、本当に堪らない苦痛だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "静かな図書館で延々と続く話し声を聞かされるのは堪らない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "間もなくして、何だか堪らないやうに隣室に行く）男　「可愛くもあり、可愛くもなし」………あゝさうか、あれは「鴎」の中の台詞だ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "折々堪らないやうに双眼の切れ目から輻射状の皺を発したが、それでも更にそれらの喫殻に手を下さうとしないのは、明かに彼自身にも得体の知れぬ悶えが、彼の中を横行してゐたからである。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今でも折には矢も楯も堪らない程訓辞の必要を感じたが、そしてまた実際腹案を立てゝ登校したこともあつたが、教員室に覗いて教師達から威勢の好い挨拶をされるともうその勇気はなくなつてゐた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「全く堪らない場面だ」と兄は思つた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は父が自分のさうした昂奮のために放つ言葉を、親が子を諭す言葉だと、習慣的に信じて言つてることが俄かに堪らないことに思へ出した。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥さんが別嬪なのに引き換へて、自分の母親が衰へ顔であることと、如何にかかうにか生活の出来るといふ程度の自分の家を見られることは、とても堪らないことであつた。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈍感なものだけはトテモ堪らない。",
              "citation": {
                "source": "現代若き女性気質集",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "賞めたくて堪らないが賞め場所の見付からない絵は出来得ないものだろうか。",
              "citation": {
                "source": "帝展を見ざるの記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、死んでもあんな奴等に敗けていては堪らない。",
              "citation": {
                "source": "小さき良心",
                "author": "断片",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに婚礼の宴会と来ては堪らない。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな場所で、病氣にでもなつた日には、それこそ堪らないだらう。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、私は水島や助手や看護婦の前に、いやさうして尚ほも脣を動かし續けてゐるお前の前に佇んでゐる堪らない苦痛と、赤面と、恥ぢと、戰きとにあらがつて行く事は出來なくなつた。",
              "citation": {
                "source": "疑惑",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――だが、ハルピンて全く堪らない感じのする町だね。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――何と云ふ堪らない町なんだらう？",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大船を發して了へば最早國府津へ着くのを待つ外、途中何も得ることは出來ないと思ふと、淺間しい事には猶ほ殘念で堪らない。",
              "citation": {
                "source": "湯ヶ原ゆき",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、三日前靴を修繕にやったので古いゴツゴツの靴をはいていたがそれが邪魔で堪らない。",
              "citation": {
                "source": "病中記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は今金がつかんで見度くて堪らないのであつた。",
              "citation": {
                "source": "奎吉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "莊之助が出て行つてから彼は堪らない場面をとうとうやり過したといふ氣がしたが、次々に盛り上つて來る嫌惡の感じにゐたたまらなくなつた。",
              "citation": {
                "source": "奎吉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、僕はね、実際窓というものが好きで堪らないんですよ。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "厭だと思い出すととても堪らない」　黙ってウエイトレスは蓄音器をとめた。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが間もなく彼はだんだん堪らない嫌悪を感じ出した。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなときふと邪慳な娼婦は心に浮かび、喬は堪らない自己｜嫌厭に堕ちるのだった。",
              "citation": {
                "source": "ある心の風景",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思うと堪らない気がした。",
              "citation": {
                "source": "泥濘",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし石鹸の残っている気持悪さを思うと堪らない気になった。",
              "citation": {
                "source": "泥濘",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにか買って帰らないと今夜が堪らないと思う。",
              "citation": {
                "source": "泥濘",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとでそれを家の者が笑って話したとき、吉田は家の者にもやはりそんな気があるのじゃないかと思って、もうちょっとその魚を大きくしてやる必要があると言って悪まれ口を叩いたのだが、吉田はそんなものを飲みながらだんだん死期に近づいてゆく娘のことを想像すると堪らないような憂鬱な気持になるのだった。",
              "citation": {
                "source": "のんきな患者",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の髪も段々｜堪らないのが多くなりました。",
              "citation": {
                "source": "橡の花",
                "author": "――或る私信――",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しなんと云っても堪らないのは梅雨期です。",
              "citation": {
                "source": "橡の花",
                "author": "――或る私信――",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめに逢ったひとには、ちょっとこう、いっぷう変っているように見せたくてたまらないのだ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）それから店頭に出て、一ヶ月間、朝顏を植ゑました、朝顏を植ゑました、と朝から晩まで、雜誌の隅で繰り返し繰り返し言ひつづけてゐるのは、とても、たまらないのである。",
              "citation": {
                "source": "義務",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
