[
  {
    "uuid": "aec4216e-0f35-56f3-837c-378ce4bb631d",
    "entry": "端的",
    "reading": {
      "primary": "たんてき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "frank",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の意見はいつも端的で、分かりやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "端的に言えば、この計画は現状では実行不可能だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は自分の感情を端的に表現するタイプだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "堅く尖った足駄の朴歯が、世界一堅固な伯林の道路面に当って端的な乾いた反動の音をたてた。",
              "citation": {
                "source": "伯林の落葉",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まるで生きものだね、ふーム、物事は万事こういかなくっちゃ……」　その感じから想像に生れて来る、端的で速力的な世界は、彼女に自分のして来た生涯を顧みさせた。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一にはημωνの尖端的強調による民族的自我の自覚である。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし何でも、手を着ければ端的に問題の要点に肉迫した。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "端的に言ふと、僕は實に牧水氏の人物が好きだつたのだ。",
              "citation": {
                "source": "追憶",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "端的に言へば、彼は既に過去の藝術を卒業した。",
              "citation": {
                "source": "室生犀星君の飛躍",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕をして端的に言はせれば、君の一切の敍情詩と小説とは、君の性格の表象下に沈熱してゐる所の、一のイデヤに對するあこがれである。",
              "citation": {
                "source": "室生犀星に與ふ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先には反時代的な詩風であり、珍奇な異端的なものであつた私等の詩のスタイルは、今日では最も有りふれた一般的な詩風となり、正にそれが時代の流行を示す通俗のスタイルとまでなつてしまつて居る。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは即ち端的の現在事実です。",
              "citation": {
                "source": "運命は切り開くもの",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在先端的な問題の一つと考えらるる宇宙線の研究でも、実はこの昔の粗末な実験の後裔であるとも見られなくはないのである。",
              "citation": {
                "source": "物理学圏外の物理的現象",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この日本的の涼しさを、最も端的に表現する文学はやはり俳句にしくものはない。",
              "citation": {
                "source": "涼味数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めのうちは振動の問題や海の色の問題や、ともかくも見たところあまり先端的でない、新しがり屋に言わせれば、いわゆる古色｜蒼然たる問題を、自分だけはおもしろそうにこつこつとやっていた。",
              "citation": {
                "source": "時事雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "多数の人の血眼になっていきせき追っかけるいわゆる先端的前線などは、てんでかまわないような顔をしてのんきそうに骨董いじりをしているように見えていた。",
              "citation": {
                "source": "時事雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "連句に限らずすべての詩歌、ただし近ごろの先端的とか称する奇妙な不規則な詩形の化け物はひとまず除外するとして、普通の古典的の意味においてのすべての詩歌は、皆共通な音楽的要素をもっている。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "先端的なものの流行る世の中で古いものを読むのも気が変わってかえって新鮮味を感じるから不思議である。",
              "citation": {
                "source": "読書の今昔",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今のモボ、モガよりもはるかに先端的な恋をしているのである。",
              "citation": {
                "source": "読書の今昔",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "理屈なし説明なしに端的にすべての人の心を奪う種類のフィルムであり、活動映画というものの独自な領域を鮮明に主張したものである。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし本来はそれどころか実に深刻な時代世相の端的描写であり、そうして支配階級よりはより多く被支配階級の悲痛な忍苦の表現をもそれらの中に看取することができるのである。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "生まれてはじめて見た人形芝居一夕のアドヴェンチュアのあとでのこれらの感想のくどくどしい言葉は、結局十歳の亀さんや、試写会における児童の端的で明晰なリマークに及ばざることはなはだ遠いようである。",
              "citation": {
                "source": "生ける人形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まるで生きものだね、ふーむ、物事は万事こういかなくっちゃ……」　その感じから想像に生れて来る、端的で速力的な世界は、彼女に自分のして来た生涯を顧みさせた。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "白川が例の端的な気性で、ずんずん切込んで行つて、談話を議論にしてしまひやしないかと、危んで居ながらも口をさしいれる隙を見出さなかつた。",
              "citation": {
                "source": "瘢痕",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして第二の念願は、死ぬる時は端的に死にたい。",
              "citation": {
                "source": "私を語る",
                "author": "――（消息に代えて）――",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀座にはうまい珈琲や菓子を食べさす家が出来、勧工場の階上に尖端的なキャヴァレイが出現したりした。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京から来るのもあり、仙台あたりから来るのもあり、尖端的な歌劇の一座ともなれば、前触れに太鼓や喇叭を吹き立て、冬｜籠りの町を車で練り歩くのであった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "（かういふ醜惡な病癖や、異端的の思想が長い長い間、私を苦しめた事は眞に言語に絶して居る。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの異端的快楽主義に惑溺したワイルドの如きも、やはりこの仲間の文学者で「生活のための芸術家」である。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
