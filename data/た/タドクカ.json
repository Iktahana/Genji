          "literary": [
            {
              "text": "ともかく高等学校時代、私は決して多読家ないし博読家でなかった。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "多読家でないような読書家があるであろうか。",
              "citation": {
                "source": "如何に読書すべきか",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "寧ろ読書家とは多読家の別名である。",
              "citation": {
                "source": "如何に読書すべきか",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな多読家でも、流行でもしなかつたら一々古典の隅々まで読めるわけのものでないから、具眼の士が時世の下に隠された宝玉を思ひ出させてくれなければならない。",
              "citation": {
                "source": "想片",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
