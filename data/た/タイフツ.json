        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "友人は芸術を学ぶため、現在フランスに滞仏中です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "そのビザは、フランスでの滞仏期間が最大3ヶ月であることを許可しています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "滞仏中、カルチャーショックも経験しましたが、同時に計り知れない喜びも見出しました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その精神がことごとにあらわれますから、当時の滞仏士官も、さほどの屈辱を受けずにすみました。",
              "citation": {
                "source": "国際射的大競技",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "国立音楽演劇学校（コンセルヴァトワアル）と国立劇場（コメディイ・フランセエズ、オデオン・オペラ、オペラ・コミイク、トロカデロの五座）は私の滞仏中の観察に拠ると、当時の情勢で、十分にその文化的意義を発揮しつつあるやうに思はれた。",
              "citation": {
                "source": "わが演劇文化の水準",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、滞仏中その上演を見てゐない。",
              "citation": {
                "source": "築地小劇場の旗挙",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は滞仏中、劇場はもとより、色々な芸術的団体に接近する機会も少くありませんでしたが、少数の「先駆芸術団体」を除いては、一般公衆の、言ひ換へれば、素人の「芸術研究団体」といふものがあるのを聞きませんでした。",
              "citation": {
                "source": "二つの答",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれにとっても、これはありがたいものだった〉とゲエテが「滞仏陣中記」でいっている。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
