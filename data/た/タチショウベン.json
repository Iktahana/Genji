          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "公園の植え込みで立ち小便をしていたら、警察官に厳重注意された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「立ち小便禁止」の看板があるにもかかわらず、跡が絶えない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "酒に酔った勢いで立ち小便をするのは、大人のマナーとして最低だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "阪を登つて立ち小便をしながら街々を見おろした。",
              "citation": {
                "source": "太郎と街",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼は、そこの礼拝の座に立ち小便を始めた。",
              "citation": {
                "source": "或る部落の五つの話",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時一女子あって人に嫁せんとするに臨み、そもそもこの城の人々こそ怪しからね、自分妻を迎うるとてはまず他人の自由にせしむ、何とかしてこの事を絶ちたいと左思右考の末、白昼衆人中に裸で立ち小便した。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "立ち小便については別に諸方の例を挙げ置いたが（立小便と蹲踞小便）、その後見出でたは、慶安元年板『千句独吟之俳諧』に「佐保姫ごぜや前すゑて立つ」、「余寒にはしばしはしゝを怺へかね」、まずこれが日本で女人立ち尿の最古の文献だ。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ち解けて人に聞かるるほど垂れ流したのだから、これは宮女立ち小便の証拠らしくもある。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "われら女人は将軍の前でこそ裸で小便がなるものか、だが汝ら女同前の輩の前で立ち小便しても何の恥かあるべきと。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕等は発行所へはいる前にあの空罎を山のように積んだ露路の左側へ立ち小便をした。",
              "citation": {
                "source": "島木赤彦氏",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　Ｏ君は杖を小脇にしたまま、或大きい別荘の裏のコンクリイトの塀に立ち小便をしてゐた。",
              "citation": {
                "source": "Ｏ君の新秋",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "（武さんは立ち小便をする時にも草木のない所にしたことはない。",
              "citation": {
                "source": "素描三題",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "Victoria Park　ひどい子供　往来に向って立ち小便をする男の子。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆえに、夜中は男女ともに路傍に立ち小便をなすために、往々臭気のはなはだしきを感ず。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから街を歩いている時など、僕は他人のようにあっさりとは立ち小便の出来ない質である。",
              "citation": {
                "source": "ダルマ船日記",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            },
            {
              "text": "思う存分にあくびも立ち小便もできない。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でも言える、何でも表現できる、こう吾儘気儘のいえる社会では、もう落書き根性も立ち小便も催す壁も見あたるまい。",
              "citation": {
                "source": "美しい日本の歴史",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "群集からこぼれ出て路端に傍若無人に立小便をしている男も見逃してやりたい。",
              "citation": {
                "source": "祇園の枝垂桜",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "バスから降りて、まず崖の上から立小便して、それから、ああいいながめだ、と讃嘆の声を放つのである。",
              "citation": {
                "source": "富士に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「きまっていますよ、」　と橋田氏は、僕の茶化すような質問に立腹したような口調で、「貴族の立小便なんかじゃありませんよ。",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに私はこれまで滅茶な男のやうに言はれてゐるし、人と同じ樣に立小便しても、ああ、やつぱりあいつは無禮だ、とたちまち特別に指彈を受けるであらうから、旅に出ても、人一倍、自分の擧動に注意しなければ、いけない。",
              "citation": {
                "source": "九月十月十一月",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルザックの逞しいあらくれの手を忘れ、こそこそと小河で手をみそいでばかりいて皮膚の弱くなる潔癖は、立小便すべからずの立札にも似て、百七十一も変名を持ったスタンダールなどが現れたら、気絶してしまうほどの弱い心臓を持ちながら、冷水摩擦で赤くした貧血の皮膚を健康の色だと思っているのである。",
              "citation": {
                "source": "可能性の文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの横丁へ来て、料理屋の間にはさまった間口の狭い格子づくりのしもた家の前を通るたびに、よしんば酔漢のわめき声や女の嬌声や汚いゲロや立小便に悩まされても、一度はこんな家に住んでみたいと思うのであった。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "左あれば、関八州は貴客に進らすべし」（関八州古戦録）と言って、敵城の方に向い一緒に立小便をした。",
              "citation": {
                "source": "小田原陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "このそうさが妙に気になって、ことによると、まだその後があるかも知れないと思ったせいか、何気なく後姿を見送っていると、大きな黒松の根方のところへ行って、立小便をし始めたから、急に顔を背けて、どてらの方を向いた。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　乙まはかう言ひながら、川縁になつてゐる藪地に向つて立小便を始めた。",
              "citation": {
                "source": "太政官",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょっと、署まで来てもらいたい」「へえ、……いったい何ですウ、現行犯で立小便位なら覚えはあるンですが、原因は何んですウ」「そんなに白っぱくれなくてもいいよ」「君は小松与一だろう？",
              "citation": {
                "source": "清貧の書",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗て彼は、立小便の際の小便の描く曲線を研究し、双曲線であったか抛物線であったか、とにかく、数学的に立派に研究をしとげましたが、そのときも小便の曲線を研究することが、学問上どんな意義があるかということを決して説明はしませんでした。",
              "citation": {
                "source": "新案探偵法",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "おっつけ恰好がついたら、役場さでも出るようにして、家を別に二人っ切りで持つだなあ」　仙太をやりすごしておいて、先生は、空を仰ぎながら立小便をした。",
              "citation": {
                "source": "凍雲",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛神キユピツトに立小便をさせたなどは実に他人を眼中に置かない遣方だと思ふ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "立小便をしている風に見えぬ。",
              "citation": {
                "source": "電車の見えない電車通り",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑誌を草で被い、カラーのところや裾の切れた外套をその上にぶっかけ、立小便をするような姿勢できき耳を立てた。",
              "citation": {
                "source": "小祝の一家",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "通り過ぎる時、極端に淫猥な顏付で自分達の方を見て笑ひながら舌を出した、五六間先の道端の柳の下で、溝の中に悠々と立小便をした後で日盛りの町を遠ざかつた。",
              "citation": {
                "source": "貝殼追放",
                "author": "女人崇拜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
