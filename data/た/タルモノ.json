        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "歐洲諸國ノ大戰ハ天其ノ驕侈亂倫ヲ罰スルニ「ノア」ノ洪水ヲ以テシタルモノ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴族政治ヲ覆滅シタル維新革命ハ徹底的ニ遂行セラレテ貴族ノ領地ヲモ解決シタルコト、當時ノ一佛國ヲ例外トシタル歐洲ノ各國ガ依然中世的領土ヲ處分スル能ハザリシヨリモ百歩ヲ進メタルモノナリキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "要スルニ凡テノ原因ハ朝鮮ガ日本支那露西亞ノ三大國ニ介在シテ自立スル能ハザリシ地理的約束ト、其ノ道義的廢頽ヨリ一切ノ政治産業學術思想ノ腐敗萎微ヲ來シテ内外相應ジテ亡ビタルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米ノ傭兵ト獨逸ノ徴兵トノ優劣ハ實戰ニヨリテ立證セラレタルモノニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "その場内に大岡越前守｜忠相の遺品が陳列してあったが、その中に子爵大岡忠綱氏の出品に係る鑷四丁があって、その説明書に「大岡越前守忠相ガ奉行所ニ於テ断獄ノ際、常ニ瞑目シテ腮髯ヲ抜クニ用ヒタルモノナリ」と記してあった。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二読会において延期派の小沢武雄君の発議により、前記の原案に「但シ修正ヲ終リタルモノハ本文期限内ト雖モ之ヲ施行スルコトヲ得」という但書を追加せられ、結局本案に付き採決の結果は、延期を可とする者百二十三、断行を可とする者六十一で、延期派の大勝利に帰した。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "前後ノ事情ヨリ推察スルニ怪施設ハ大部分完備ニ向イタルモノノ如シ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、二、ソノ色、黒褐色ノ水甕ニシテ、底ヲ逆ニスルト、赤キ「ペンキ」デ４０８４ノ数字ガ記サレタルモノ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "やむを得ず杜は、名刺を一枚だして、それに日附と時間とを書きこみ、それから裏面に「横浜税関倉庫ハ全壊シ、着荷ハ三分ノ二以上損傷シタルモノト被存候」と報告を書きつけた。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "往昔羅馬ノ時代ニ、葬ヲ送ル者皆此壺ヲ懐ロニシ、涙ヲ注シテ墓畔ニ埋メタルモノナリト云フ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "平民自身モマタ奴隷タルベクコノ世ニ生レ出デタルモノニシテ、人格ト権利ヲ没却セラレテモ、之ヲ甘ンジテ屈従スルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ、コノ信念ハ外ニ於テハ国家ニ不忠、内ニ於テハ国教ニ不信ナリトノ理由ヲ以テ、彼等ハ自国ニ住ムコトヲ極度ニ圧迫セラレタルヲ以テ、故国ヲ逃レテ和蘭ノ地ニ来リ、更ニ北米ノ天地ヲ求メタルモノナリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ノ欲スルトコロハ領土ニアラズ、物資ニアラズ、己レノ良心ト信仰トノ活路ヲ見出サンガタメニ新天地ニ出デタルモノ也。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "全て意識せらるゝものは、所謂「シツツアル力」に対して「セラレタルモノ」だけの価を有するに止る。",
              "citation": {
                "source": "意識と時間との関係",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の如くにして、「セラレタルモノ」は「セラレタル瞬間」に於て「シツヽアル力」の後に取り残されるに止る。",
              "citation": {
                "source": "意識と時間との関係",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に「意識しつゝある世界」に於て「シツツアル力」の現在と一切の「セラレタルモノ」の過去の外は何者もない。",
              "citation": {
                "source": "意識と時間との関係",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とならば「ハタラカレタルモノ」即ち「意識の対象」を強ひて「過去」と名ける必要はさらにない。",
              "citation": {
                "source": "意識と時間との関係",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "道學先生ナド、心學ノ錬成ヲナスニ初メ苦心ヲナス状態ヨリ大悟ニ至ルマデノ階段ヲ示シタルモノト言フ人アリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "是ニ於テヤ酒楼ノ情況宛然妓院ニ似タルモノアリ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "抑是ノ酒肆ハ浅草雷門外ナル一酒楼ノ分店ニシテ震災ノ後始テ茲ニ青※ヲ掲ゲタルモノ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "石黒氏ノ近業ハソノ名ノ示スガ如ク往昔郷閭ノ私塾ナリシ有隣舎ノ沿革ヲ調査シソレガ師弟ノ伝ヲ述ベタルモノニシテコレスナハチ拙稿『下谷叢話』ノ記述スル所トホボソノ事ヲ同ジクスルモノ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "悵然タルモノコレヲ久ウス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレ書生タルモノ平時互ニ相誇ルニアルイハ博覧考証ヲ以テシアルイハ詩若シクハ文章ヲ以テシ皆自ラ謂ラク天下｜己ニ若クモノハ莫シト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "金ト銀トハ全然形容ナレドモ、青銅ト鐵トハ半バ形容ニシテ半バ器具原料ヲ示シタルモノナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ニ於テ人類ハ石時代ヨリ、青銅時代ニ移リ、青銅時代ヨリ鐵時代ニ移リタルモノナリトノ説廣ク世ニ行ハルヽニ至レリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "假令同一人民ニシテ青銅器ト鐵器トヲ用ヰタル事有リトスルモ、鐵器ノ用ハ常ニ青銅器ノ用ニ後ルト定マリタルモノニハアラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男子ヲ摸シタラント思ハルヽ土偶ニ鬚髯ヲ示シタルモノ無キ事、貝塚發見ノ人類脛骨極メテ※平ナル事、及ビ貝塚發見ノ人類顎骨齲齒ヲ有スル事ノ他、實物ニ付キテハ何事ヲモ知ル事能ハザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また田村西湖口義の『本草綱目｜記聞』薯蕷の条下に「ナガイモト云ハヤマイモノ人作ヲ経タルモノナリ」と書いてあるが、これは無論事実を誤っている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
