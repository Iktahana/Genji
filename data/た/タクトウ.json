        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「我は托塔天王の二太子、木叉恵岸。",
              "citation": {
                "source": "悟浄出世",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「東渓村の托塔天王だ」「えっ、なんの用で」「そいつア言えねえ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――世間の噂にゃ、托塔旦那は、男｜伊達だ、槍や棒も旦那芸じゃねえ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして托塔天王様に、うんといって、一つ乗り出していただければだ」「なるほど、話はすばらしいや。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "托塔天王とアダ名のある荘院さんですか」「知っているのか」「いや、聞いているだけです。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたが、世間で名高い托塔天王の晁蓋どのか。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "前の統領、托塔天王ノ晁蓋です。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
