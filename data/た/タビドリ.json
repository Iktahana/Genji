        "examples": {
          "standard": [
            {
              "text": "春になると、この干潟にはシベリアへ向かう多くの旅鳥が羽を休めに来る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "旅鳥たちは、途方もない距離を移動するためのエネルギーをここで蓄える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "双眼鏡で旅鳥を観察するのが、この季節の私の日課になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "蔵前の大通りには、家々の前にほこりおさえの打ち水がにおって、瑠璃色に澄み渡った空高く、旅鳥のむれがゆるい輪を画いている。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
