        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "胆太き若者はずかずかと寄りて眼定めて見たり。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "慧鶴はそれで饑を凌ぎながら胆太く自分と富士の運命を見届けにかかった。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その様子に胸先ず安く、遂に調金の事を申し出でしに、図らざりき感嘆の体と見えしは妾の胆太さを呆れたる顔ならんとは。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "到底｜喉を下るまじと思いしに、案外にも味わい旨くて瞬間に喫べ尽しつ、われながら胆太きに呆れたり。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "神ぞ居れ、喚び哭く、冥き神、しや、童、速須佐之男、大天や高天原、日は治らせ、大日※貴、さもこそや夜之食国、夜は治らせ、月よ月読、海原、吾はえ治らさじ、言依させ、吾は聴かじ、神柄ぞ、暴ぶる神、胆太の眦裂くと、言挙ぐと、泣きいさち、抗ふと、おぞえ吼え立つ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、双手にわらんべをかい抱いて、日頃の如く肩へのせると、例の太杖をてうとついて、岸べの青蘆を押し分けながら、嵐に狂ふ夜河の中へ、胆太くもざんぶと身を浸いた。",
              "citation": {
                "source": "きりしとほろ上人伝",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛行船外の国より胆太にそつと降りたる飛行船、夜の間に去れば跡も無し。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オペラ眼鏡を目にあてて、空を踏まへた胆太の若い乗手を見上ぐれば、少し捻つた機体からきらと反射の金が散る。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜時なり、三社の祭りなり、賑い言わん方なしといえば、携え来りし着替を出し、独り夕方より観音へ参詣し、夜に入り蕎麦店へ入りて京味を試み、ゆらりゆらりと立帰りしところ、裏のうち騒がしく「さても胆太き者どもかな」と口々に言う。",
              "citation": {
                "source": "良夜",
                "author": "饗庭篁村",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つ胆太くドッシリと腰を据えてこの事件のどん詰りまで見物してやろう。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「胆太い無心をいうやつ」　呆れ顔が、やがて苦笑になる。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "斬りまくって逃げ延びよう」　と彼は胆太く構えていると、どたどたと飛んで来た手下の一人が、「おお小六さん、大変でがす」　と云ったのが小六には他人事のように聞こえた。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、この胆太い海外貿易家の若い博多町人は、（ほう、これは大浪だ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "天井をつきぬくようなその声には、日ごろ胆太い蜂須賀彦右衛門も堀秀政もとび上がるほどびっくりした。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「胆太い曲者め」　徐晃が、躍り寄って、張遼をうしろへ逃がした。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらは同時代の武士のように、変節や裏切りを朝に夕べにするほどな胆太い厚顔無恥ではなかったが、事、こうなるとじっとしてはいられず。",
              "citation": {
                "source": "私本太平記",
                "author": "黒白帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は崇拜の念止み難き故をもて、膽太くもまたこの群に加りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく膽太く羅馬拿破里の間を往來する女はあらぬならん、奈何などいへり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "神ぞ居れ、喚び哭く、冥き神、しや、童、速須佐之男、大天や高天原、日は治らせ、大日※貴、さもこそや夜之食國、夜は治らせ、月よ月讀、海原、吾はえ治らさじ、言依させ、吾は聽かじ、神柄ぞ、暴ぶる神、膽太の眦裂くと、言擧ぐと、泣きいさち、抗ふと、おぞえ吼え立つ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝も膽太き事を思ひ立ちしものよ。",
              "citation": {
                "source": "花枕",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
