  {
    "uuid": "e051a2cf-3b4a-53da-8ef6-ad7c568601ba",
    "entry": "他室",
    "reading": {
      "primary": "たしつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君が侵入に及んだために他室へ遠慮したというんじゃない。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "静にしておかなければ不可せんから、貴下方は他室へお引取下さい。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日医師等其臥床を他室に移さんとし、誤りて其頭に触る。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "札幌に貸家なけれど、親切な宿の主婦さん、同室の一少年と猫の糞他室へ移しこの室を我らのために貸すべしと申出でたり。",
              "citation": {
                "source": "詩",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "起せど起きぬから他室へ移した、暫くして戻った鼠が下女の体を求めど見えぬ故消え失せた。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "肌脱ぎになる習慣も止めて貰ひたい、運動だと称して（昼間）逆立ちをやつたり、でんぐり返しをしたり、出たら目の体操をやつたりするのも止めて貰ひたい、運動をしたければ、これも法にかなつたこと、例へば鉄亜鈴、棍棒、まだその他室内で出来るいろいろの道具がある。",
              "citation": {
                "source": "蝉",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなた、新さんが、ちょっと雪岡さんに話しがあるといって、他室でさっきから来て待っています」　お前が、さも新吉の凄じい権幕に懼えたように、神経の硬ばった相形に強いて微笑を見せながら、そういって私の部屋に入って来た。",
              "citation": {
                "source": "うつり香",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで他室からは一尺以上も下つてゐたので、そこに座つてゐると穴倉めいて書齋といふよりも仕事場といふかたちであつた。",
              "citation": {
                "source": "緑蔭叢書創刊期",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんなに呼んでも返事がないのはへんだね」　明智はふと不安を感じて、ボーイと一しょに、他室の迷惑もかまわず、はげしくドアをたたいた。",
              "citation": {
                "source": "黒蜥蜴",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "鑑識課員は、股野の死因が、強力なる腕による扼殺であること、ドアの把手その他室内の滑かなものの表面が、布ようのものでふきとってあること、一応指紋は採集したけれども、犯人の指紋は恐らく発見されないだろうということ、表口にも裏口にも、顕著な足跡は発見されなかったことなどを報告した。",
              "citation": {
                "source": "月と手袋",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
