        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "市場では、元気な声の立ち売りが活気をもたらしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "昔は、駅前で食べ物を売る立ち売りがよく見られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、観光地で特産品を売る立ち売りをしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "クラブの事務をたすけている若い人々と櫛田さんは、新しく出る婦人民主新聞のために宣伝のビラをはり、発送を担当し、ある時には新聞の立ち売りをやらなければならなかった。",
              "citation": {
                "source": "その人の四年間",
                "author": "――婦人民主クラブの生い立ちと櫛田ふきさん――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、冬は、九｜里四｜里うまい十三｜里の、焼き芋の立ち売りをしたり……夏は、江戸名物と自ら銘うったところてんの呼び売り。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨が降ると、立売が三割減るからね、なかなか販売部長も頭を悩ますよ。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が明けて十九日となると、景蔵は西の蛤御門、中立売御門の方面にわくような砲声を聞き、やがて室町付近より洛中に延焼した火災の囲みの中にいたとある。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "長州方は中立売、蛤門、境町の三方面に破れ、およそ二百余の死体をのこしすてて敗走した。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻恋稲荷の杉並木に沿うて、二、三丁南へ下ると立売坂。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "用というのは首がほしい　その薄い光で見ると、ほろ酔いきげんの遊佐銀二郎、謡曲か何か低声にうなりながら、妻恋坂から立売坂へさしかかってゆく。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "立売坂の中腹、ちょうど饗庭の影屋敷のすこし手前に当たって、左手に草原を控えたちょっとした平地がある。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいしたことはない」　そのうちに坂を上りきると、立売坂の中腹に、饗庭家と同じ造りの影屋敷の門が見える。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "お粂姐ごが待っているだろうに」　金兵衛は小刻みに走り出したが、下立売から丸太町を抜けて、所司代の番士のお長屋の、塀の側まで間もなく来た。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一信の方は津田に見せてほしいから、皆見てしもたら立売堀の方へ郵送してくれ。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "この辺は立売町で、やあさんは立売町の小町娘だった。",
              "citation": {
                "source": "京のその頃",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが立売りしかありません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "立売りは面白い現象です、アホートヌイ・リャード［自注８］に一杯立売りが並んでいてね、塩づけ胡瓜、卵、キャベジ、肉、殆ど何でも売って居りました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉子などの立売りも出ている。",
              "citation": {
                "source": "折たく柴",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "余十八九歳の頃片山再び浪華に下り、立売堀に住す。",
              "citation": {
                "source": "僻見",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "モスク※で、伸子たちをバリシュニヤーとよぶのは辻馬車の御者か町の立売りぎりだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポン公といふのは、町の広場で、夕刊新聞の立売をして、どうにか暮しながら、ひとりで勉強してるかんしんな少年です。",
              "citation": {
                "source": "シロ・クロ物語",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "四方を眺むれば橋の袂に焼くもろこしの匂い、煎豆の音、氷屋の呼声かえッて熱さを加え、立売の西瓜日を視るの想あり。",
              "citation": {
                "source": "良夜",
                "author": "饗庭篁村",
                "note": "青空文庫"
              }
            },
            {
              "text": "罹災者もそろそろ露店や立売りを始めて生活の方針を考え出した。",
              "citation": {
                "source": "震災日誌",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺町今出川下町壱人、上立売下ル瓢箪之図子に壱人。",
              "citation": {
                "source": "エタ源流考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳川時代にはお庭掃除は小法師と称して、もとは丹波の山国から出ておったが、中頃は三条余部村のエタ六人と、寺町今出川下ル町及び上立売下ル瓢箪図子から各一人、都合八人でこれを奉仕し、享保十二年以後は大和丹波市外六人のエタ村から出役し、さらに後には京都蓮台野からもこれを勤めておった。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時、私は京都に住んでいたが、京都堀川の中立売に代々野獣を商っている老舗があって、私はその店へよく猪の肉を買いにやらされた。",
              "citation": {
                "source": "猪の味",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "川勝氏ノ著書ヲ見ルト、上京区千本上立売上ルニ石像寺ノ阿弥陀三尊石佛ト云ウモノガアッテ、中尊ニ定印弥陀坐像、ソノ向ッテ右ニ観音、左ニ勢至ノ二脇侍立像ガ侍立シテイテ、ソレラ三尊ノ写真ガ各別々ニ載ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "規定としては、漁獲物はすべて組合へ納め、組合で一括してそれぞれの問屋へ卸す仕組になっていたが、ちょっと「日銭」が欲しいような場合には、納入する責任量を超過した分だけ、立売りすることが黙認されていた。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番の人出は向島、枕橋を渡ると花の世界で目鬘売りや花かんざしの立売りが並ぶ間を、三囲から白鬚、遠くは木母寺まで肩摩轂撃、土手際にはよしず張りの茶店、くわいの串ざしや、きぬかつぎを売り物に赤前垂が客を呼ぶ。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏場はここが車力や小僧さんの昼寝の場所、柳の下蔭には飴湯や枇杷葉湯、甘酒屋などが荷を下ろして一ぱい一銭の立売り、汗を拭き拭き飲んでいる人力車夫や行商人など、そのほかの通行人にも唯一の休息地帯。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "門前町から沿道の露店やら大道芸人やら立売りなどまで、見洩らすまじと、人に揉まれ揉まれ、眼をくばり歩いているふうだった。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
