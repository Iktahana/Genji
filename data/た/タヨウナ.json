        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夫ガ病人ニナッテシマッタノダカラ残念デタマラナイノダガ、君ノ手紙ヲ見テ西洋ヘ往タヨウナ気ニナッテ愉快デタマラヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "何カ戦場ヘ長袖ノ人ガ出テキタヨウナマドロツコシイ感ジガスル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際今マデ道子ノ為ニ生キテ来タヨウナ私ハ、道子ヲ失ッタ今生キテ居ル甲斐ガナイト思ッタノデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテ暑イ間ダケオ止メニナッタラ」「イヤ、コノ頃イクラカ利イテ来タヨウナ気ガスルンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ糊ノ硬イゴワ／＼シタ単衣ヲ着セラレルノガ嫌イデアッタガ、寝間着ニハイツモ甘ッタルイ腐リカヽッタヨウナ糊ノ匂イガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルデ猛獣ガ現ワレタヨウナ気ガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ景観ニ接シタヾケデモ、五味溜メヲ引ックリ返シタヨウナ東京トハ比較ニナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………僕ハ今年カラ、今日マデ日記ニ記スコトヲ躊躇シテイタヨウナ事柄ヲモアエテ書キ留メル、自分ト妻トノ関係ニツイテハ、アマリ詳細ナヲ恐レテイタカラデアッタガ、今年カラハソレヲ恐レヌハシソウモナイケレドモ、シカシ必ズシモソウトハ限ラナイ理由モアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "平衡感覚ヲツカサドル神経ハドコヲ通ッテイルノカ知レナイガ、イツモ後頭部ノトコロ、チョウド脊髄ノ真上ノトコロニ空洞ガ生ジタヨウナ感ジガシ、ソコヲ中心ニ体ガ一方ヘ傾クノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘラヘラト、馬鹿ニシタヨウナ笑イカタヲシテ、「途方モナイコト、イイ出スモンジャナ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
