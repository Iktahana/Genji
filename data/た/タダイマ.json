  {
    "uuid": "c36a58b7-d005-5415-a0a5-ee7d43e248ab",
    "entry": "タダイマ",
    "reading": {
      "primary": "ただいま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
