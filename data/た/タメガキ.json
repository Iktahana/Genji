        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "尊敬する恩師から、サインとともに心のこもったため書きをいただいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "サイン会で作家にため書きをお願いすると、一人ひとりに丁寧なメッセージを書いてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "父の本棚には有名選手のため書きが入ったサイン本が大切に保管されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "参考のため書き添えておく。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼のため書きうつしてきてくれたのは、上のような割り算であった。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は始めての会席料理なれば七十五日の長生すべしとて心覚のため書きつけ置く。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "或いは単なる伝説かも知れないが、参考のため書き留めて置く。",
              "citation": {
                "source": "パラティーノ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この一文は昭和九年十月婦人公論に発表したのを、更に中等女子国語読本に収録するため書き改めたものである。",
              "citation": {
                "source": "言葉の魅力",
                "author": "――女学校用国語読本のために――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
