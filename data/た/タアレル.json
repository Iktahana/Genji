        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "よしやあなたが百万タアレル出すと云つても、わたしは売りません。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "けふなんぞは見料が百三十タアレル取れたのです。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "あしたは一万タアレル取れるかも知れない。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "追々毎日十万タアレルも取れるやうになるかも知れない。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし一日に十万タアレルの見料が這入るとすると、四日目には此ペエテルブルクの人民が皆来てしまはなくてはならない。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとは、手の甲に一タアレルの銀貨をのせられるくらいでなければいけないのに。",
              "citation": {
                "source": "神童",
                "author": "DAS WUNDERKIND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
