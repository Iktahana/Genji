        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "空が暗くなったかと思うと、忽ち激しい雨が降り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昨夜まで元気だった彼が、忽ち体調を崩して入院したと聞いて驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "平穏だった街の空気が、事件の発生によって忽ち緊迫したものに変わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
