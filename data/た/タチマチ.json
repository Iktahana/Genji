[
  {
    "uuid": "f17df65e-6a00-5e22-8a73-88eb7ffa4325",
    "entry": "忽ち",
    "reading": {
      "primary": "たちまち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
