        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「いやいや、そんな大したことぢやあないから……」　カタクナなくせに甘い奴だ。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍家も流石に御不興気のお顔をなされ、何もおつしやらず、さつさと御判をたまはり、相州ハ、マダ、死ニタクナイモノト見エル。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "急ニ書キタクナクナッタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてやって来たボーイ頭をつかまえて「このアイスクリーム、チトモツメタクナイ。",
              "citation": {
                "source": "三斜晶系",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "チトモツメタクナイ。",
              "citation": {
                "source": "三斜晶系",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ　イクラ　ガマンシテモ　ネムタクナルバカリデス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ　イクラ　ガマンシテモ　ネムタクナルバカリデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんというカタクナな否定的態度であろうか。",
              "citation": {
                "source": "風流",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かになる）人見　（まっくらな中で）……あんなにカタクナな人間を、私は知らない。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎ニ角予ハ助六ノ芝居ガ好キナノデ、助六ガ出ルト聞クト、勘弥ノデモ見ニ行キタクナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナ所ニ埋メラレタクナインダ」「ソレハ分ッテマスケレド、京都ニナサルニシタッテ、来月ノ大文字マデニハ決メルッテオッシャッテタデショウ」「マダ一カ月アルンダカライヽサ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何ダ、モウ起キテタノカ」「アタシコソ昨夜ハ寝ラレナカッタワ」予ガ窓ノブラインドヲ上ゲルト、寝起キノ顔ヲ見ラレタクナイラシク、慌テヽ浴室ヘ逃ゲテ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ癖他人ガ触ルトツメタクナイ、普通ノ温カイ手ヲシテイルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ情ナイ姿ノトコロヲ彼女ニ見ラレテハ極マリガ悪イ、ト、思ッタ途端ニコノ言葉ガ出タノデアルガ、正直ヲ云ウト来テ貰イタクナイコトモナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヤ、ソコガアノ方ノ偉イトコロデスヨ、麻酔ドクターマデ呼ンデ十分ノ用意ヲシテカヽッタンダカラ、誰デモヤッテシマイタクナルトコロダガ、僅カ一滴ノ血ヲ見タヾケデモ大事ヲ取ッテ中止スルト云ウコトハ、ナカ／＼出来憎イコトデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、何ノ目的デサヨウナヲ分ラセテイルノデアルトシテモ、ソレハ、「私ハセメテ相手ヲアナタト思イタクナイノデス、木村サンダト思イタイノデス、ソウシナケレバ感興ガ湧イテ来ナイノダカラ、結局ハソレガアナタノタメデモアリマス」トイウ意味ナノカ、「コレモヤハリアナタヲ嫉妬サセテ刺戟ヲ与エル手段ナノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "因果ナ※ニ、僕ハソコマデ想像スルトイヨイヨタマラナイ嫉妬ヲ感ジ、ソノ嫉妬ノ快感ノユエニアエテソノ危険ヲ冒シテミタクナルノデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ実彼女モグルデアル※ハ察スルニカタクナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシモ、コンナ事、アナタニ知ラセタクナイノデスガ、ドウシテモ、コノ問題ハ、アナタニ解決シテモラウシカ、手ダテガナイト考エタノデ、急ギ、コノ手紙書クノデス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八六八年八月十三日ボリビア及びチリ大地震の時、チリのタクナその他の土地でしばらくの間空が輝きわたった。",
              "citation": {
                "source": "地震なまず",
                "author": "武者金吉",
                "note": "青空文庫"
              }
            }
          ]
        }
