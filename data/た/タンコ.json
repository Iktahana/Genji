  {
    "uuid": "d2e368b3-5b5b-5edd-af1e-8fb24362e8ba",
    "entry": "タンコ",
    "reading": {
      "primary": "たんこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ボーボラナンキン」といふのは「オタンコナス奴」といふやうな意味だ。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガタンコガタンコ、シュウフッフッ、　　凍えた砂利に　湯げを吐き、　　火花を闇に　まきながら、　　蛇紋岩の　崖に来て、　　やっと東が　燃えだした。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガタンコガタンコ、シュウフッフッ、　　鳥がなきだし　木は光り、　　青々川は　ながれたが、　　丘もはざまも　いちめんに、　　まぶしい霜を　載せていた。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガタンコガタンコ、シュウフッフッ、　　やっぱりかけると　あったかだ、　　僕はほうほう　汗が出る。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小平さんは、ともかく、お餅をいたゞいておかうといつて、奥へはいつていき、カタンコトンと音をさせてゐましたが、やがて、空の重箱をまた風呂敷に包んで出て来ました。",
              "citation": {
                "source": "疣",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "小平さんは、ともかく、お餅をいただいておこうといって、おくへはいっていき、カタンコトンと音をさせていましたが、やがて、からの重箱を、また風呂敷につつんで出てきました。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し大きな波は、川崎船と本船を、ガタンコの両端にのせたように、交互に激しく揺り上げたり、揺り下げたりした。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド人事ヲツクシテ天命ヲ俟タンコトヲ思イ、許シ得ル範囲ノ応急送信機及ビ受信機ヲ建造セルナリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかんね」と真黒い足をバタンコと鳴らしました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "）に捕えられて上空に来かかり、きっと割合腰抜けだったと見えて周章していきなり、ポタンコ　ポタンコとやりました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "事情あって、拙者は一命を大切に……」「オタンコナスめ」　白拍子が打ってかかろうとすると、軽くその肩を押えた五郎。",
              "citation": {
                "source": "曾我の暴れん坊",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オタンコナス」　と大姐さんにアグラをかゝれてタンカをきられる始末。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "このオタンコナスめ。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オタンコナスめ」　と、漬物屋のオカミサンは怒って帰って行ったが、一時間ほどすると、浮かない顔でやってきた。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "願いごとをかなえてくれる魔物がいるなら、私の未来の時間を半分わけてやっても、放二さんを殺してもらいたかったわ」「なぜさ」「目の上のタンコブなの。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜだか分らないけど、タンコブなのよ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレはタンコブじゃアないだろうな？",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロボックウングル、トイチセグル、メナシクル、シュムクル、チュプカグル、コタンコルクルなどのクルこれである。",
              "citation": {
                "source": "「ケット」と「マット」",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……一四一二年、スタンコイッチ一世が登位して以来、この王系は、一九一四―一八の世界大戦によって惹き起されたバルカン半島における政治的乃至領土的紛擾の際にも、王位の干犯を受けることなく、連綿、五世紀に亙ってこの国を統治している。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "政略の動機は、スタンコウィッチ家のエレアーナ王女を廃して、ステファン五世の王甥、イヴァン・チェルトクーツキイを登位させるためです」　心の中の痛恨をおし鎮めようとでもするかのように、やや長い間瞑目したのち、突然、若々しい、熱情的な口調になって、「そこで、われわれは、機先を制した。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの、息づまるような刹那に、竜太郎が聞いた、大砲と鐘とどよめきの声は、反乱軍の突然の背反と、スタンコウィッチとステファン両家の和議成立を告げる祝賀の合図だった。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな奴ぁ、情無しの、我利々々野郎のオタンコナスの、だら野郎つうだ！",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥前「やーれ、月の出しをと、こら約束したが月は山陰、主あどこにやれ、チートコ、パートコ」二、三人さきに、ペタンコになって寝ているマキと言う十六七の戦災孤児の女の子が、ムックリ顔を向けて、マキ　やかましいなあ、肥前の小父さん、歌というとそれしきや知らないの？",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "笠太　あにをつ※　あにが、此のオタンコナスめ、貴様の亭主にならうと云ふ男ば迎へに出るが、あにが慾だ！",
              "citation": {
