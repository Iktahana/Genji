[
  {
    "uuid": "19ff0735-bb0c-51f0-bdd3-1bca0842d746",
    "entry": "探知機",
    "reading": {
      "primary": "たんちき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
