        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "クマノ　トムト　　イヌノ　ジヨンハアマリヨロコンデ、トンダリハネタリシテ、タローサンニ　　シカラレマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々タイツニ皺ガ寄ッタリシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸モペッタリシテオ乳ナンゾナクナッチマウシ、肩ノ筋肉モマルデ男ミタイニコチ／＼ニナルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日一日寝タリ起キタリシテ暮ラス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今時分カラ芝生ノ上ニ坐ッタリシテ、冷エルトイケナイカラオ止シナサイト、婆サンハ頻ニ止メタガ、「オ爺チャン、チョットイラッシャイヨ」ト、颯子ガスヽメタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トキ／″＼足ノ裏ガ見エタリシテ」ソレハヨカッタガ、ソノアトデ次ノ事件ガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ試ミニ息ヲ吸ッタリ吐イタリシテミルト、ヤッパリ間違イナクピイピイト鳴ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ上下ノ歯齦ヲ何度モパク／＼ト離シタリ合ワシタリシテ黄色イ舌ヲ口腔デベロ／＼サセ、思イキリグロナザマヲシテ見セタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那人ハコノ技ニ甚ダ熟達シテイテ、風ノ吹ク中デモ平気デブラシニ水ヲ含マセ、碑面ニ白イ紙ヲ伸バシテ傍カラパタ／＼叩イタリシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真ハ全裸体ノ正面ト背面、各部分ノ詳細図、イロイロナ形状ニ四肢ヲ歪曲サセ彎屈サセ、折ッタリ伸バシタリシテ最モ蠱惑的ナル角度カラ撮ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初ハ木村ガ裸体ノママデ立ッテイルヨウニ思エタガ、胴カラ生エテイル首ガ、木村ニナッタリ僕ニナッタリ、木村ノ首ト僕ノ首トガ一ツ胴カラ生エタリシテ、ソノ全体ガマタ二重ニ見エタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
