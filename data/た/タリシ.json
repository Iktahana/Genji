        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "此時ヨリノ天皇ハ純然タル政治的中心ノ意義ヲ有シ、此ノ國民運動ノ指揮者タリシ以來現代民主國ノ總代表トシテ國家ヲ代表スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "既ニ王朝貴族ニ朝鮮人ノ血液ガ多量ナリト云フコトハ、實ニ其ノ貴族ノ血液ガ皇室ニ入リ得ベキ特權階級タリシ點ニ於テ、日本ノ元首其者ガ朝鮮人ト沒交渉ニ非ズト云フコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "空疎守舊ノ學説ト薄弱ナル意志ト衆愚ノ喝采ヲ足レリトスル虚榮ト、實ニ通俗政治家ノ標本タル「ウヰルソン」輩ノ通辯ニ得々タリシ所謂學者ナル者ノ反省ヲ要ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ニ白人ノ新移住者印度人支那人ノ移住者ガ取得スル所ヲ、已ニ早ク日本國民タリシ彼等ニ拒絶スベキ理由ナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒユース」ガ勞働者出身ナリトモ、「レニン」ガ社會主義者ノ尊敬スベキ同志ナリトモ、國際的對立ヨリ見テ彼等ガ〔大地主〕タルコトハ、昔時魚賣タリシ大倉喜八、貧書生タリシ加藤高明ガ無産階級ヨリ見テ富豪タルト同シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大戰中ニ於ケル印度獨立運動ノ失敗ハ凡テ日本ガ日英同盟ノ忠僕タリシガ爲メニシテ、從テ英國ガ一時的全勝將軍タルガ爲ニ瞬時雌伏スルニ過ギズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國ハ英獨協商ノ相手方ヲ日本ニ代ヘタルガ故ニ、今ヤ該協商ノ目的タリシ中部支那以南ノ領有ヲ現實ナラシメントシテ茲ニ青海四川甘肅ヲ包有セル西藏濁立ノ要求トナリテ現レタルナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ今次ノ大戰ニ際シテ大西郷アリ明治大帝アリシナラバ、獨逸ノ陸軍ト東西呼應シテ一擧露國ヲ屈服セシメ、海軍亦東西ニ相分レテ英國艦隊ヲ本國ト印度濠洲トノ防備ニ兩分セシメ十分ナル優勢ヲ持シテ各々之レヲ撃破シ、朞年ナラズシテ早ク已ニ北露南濠ニ大帝國ヲ築キタリシ筈。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚オ、余ハ無情ナル父親タリシコトニツイテ、彼ノ寛恕ヲ乞ウ。",
              "citation": {
                "source": "無駄骨",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "我邦ニテ古今無双ノ古貨幣家タリシ旧福知山侯ノ蔵品ハ、長持幾棹トカ有リシモ、皆徃年普魯斯人某ガ神戸ニテ買ヒ去リシト。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "タリシュオスの子エケポ，ロス、トロイア軍の先陣の中にすぐれし勇將を、アーンチロコス先づ斃す、馬尾の冠毛振りかざす甲の天邊打碎き、鋭刄凄く骨に入り、其額上を貫けば一命亡び死の暗は忽ち彼の目を蔽ひ、　460亂軍中にどうと伏し塔の倒るる見る如し。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "其證ハ大顱ノ白人モ、始ヨリ大顱タリシニハ非ズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "クマノ　トムト　　イヌノ　ジヨンハアマリヨロコンデ、トンダリハネタリシテ、タローサンニ　　シカラレマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ当初稿ヲ脱セシ時ヨリ既ニ半歳ヲ過ギ一時｜蒐集シタリシ資料ノ今｜蚤クモ座右ニ留メザルモノマタ鮮シトナサズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔君見ズヤ去年堤上此ノ時節／禁奢令厳ニシテ春淒絶タリシヲ〕また「近日漸復旧繁華。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "集中ニハ花ニ月ニ唱和シタリシ作十ノ六、七ニ居ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "○日本石器時代人民ハ幾種族ナリシカ容易ニ知ル事能ハズト雖モ、北海道ト本州ノ大部分トニ分布棲息セシモノハ一種族タリシ事種々ノ點ニ於テ遺物ノ一致スルヲ以テ知ルヲ得。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "またある時、ある草を採って来たらそれがムカゴニンジンであるという事が分かり、またある草がフタリシズカであるという事も分って嬉しかった。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第二部　混混録",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々タイツニ皺ガ寄ッタリシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ノ意見デ、整形外科ノ方ヘ行ッテ見テ貰ッタラト云ウノデ、先日虎ノ門病院デレントゲンヲ撮ッタノデアルガ、頸椎ノ辺ニ曇リガアルシ、手ノ痛ミガソンナニ激シイノナラ、事ニ依ルト癌カモ知レナイト嚇カサレテ、頸椎ノ断層写真迄モ撮ラセタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸モペッタリシテオ乳ナンゾナクナッチマウシ、肩ノ筋肉モマルデ男ミタイニコチ／＼ニナルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日一日寝タリ起キタリシテ暮ラス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハソンナニ子供ガ好キジャゴザイマセンノ」トカ、「死ノ灰ガ降ルッテ云ウノニ沢山生ンダッテ仕様ガナイジャアリマセンカ」トカ云ッタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今時分カラ芝生ノ上ニ坐ッタリシテ、冷エルトイケナイカラオ止シナサイト、婆サンハ頻ニ止メタガ、「オ爺チャン、チョットイラッシャイヨ」ト、颯子ガスヽメタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "数年前カラ予ニハ前立腺（青年時代花柳病ヲ患ッタ頃ニハ摂護腺ト呼ンダモノダガ）肥大症ガアリ、トキ／″＼残尿ガ溜ッタリ、尿ガ出ナクナッテカテーテルデ導尿シタリシタコトガ二三回アル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思イガケナク予ガ廊下ニ現レタリ、マズイコトニハオ静ト打ツカッタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トキ／″＼足ノ裏ガ見エタリシテ」ソレハヨカッタガ、ソノアトデ次ノ事件ガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ試ミニ息ヲ吸ッタリ吐イタリシテミルト、ヤッパリ間違イナクピイピイト鳴ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ上下ノ歯齦ヲ何度モパク／＼ト離シタリ合ワシタリシテ黄色イ舌ヲ口腔デベロ／＼サセ、思イキリグロナザマヲシテ見セタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
