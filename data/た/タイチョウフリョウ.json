    "definitions": [
      {
        "index": 1,
        "gloss": "poor physical health",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "朝から体調不良を訴えていた部下を早退させ、翌日病院へ行くよう伝えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "体調不良が二週間以上続いたため、精密検査を受けることを決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "大事な発表の当日に体調不良に見舞われ、万全とは言えない状態で壇上に立った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "通常、それなりの精度で人を正しい年代に置けまして、もっとも通常というのは、病気や体調不良の場合はその人物が若くとも老年の手振りそっくりになるからで。",
              "citation": {
                "source": "ライギット・パズル",
                "author": "THE REIGATE PUZZLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "つらいことばかりのここ三年、どうにか書き続けてきたこの原稿を本にまとめる作業は、体調不良で遅れ遅れになっていた。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "体調不良を口実に婦人看守室へ連れて行きましたが、本官は嘘だと思います。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "体調不良かと思い、恥知らずも窓を開けた。",
              "citation": {
                "source": "四日白魔",
                "author": "THE FOUR WHITE DAYS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
