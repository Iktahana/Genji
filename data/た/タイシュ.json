    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "港へ船がはいる前、海上から眺める山に対して、左手にも相似形の大珠山が聳えている。",
              "citation": {
                "source": "北京・青島・村落",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そうそうと切々と錯雑して弾ずれば、大珠小珠玉盤に落つ……そのとき琵琶の音はそれほど華麗ではなかった。",
              "citation": {
                "source": "夜明けの辻",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「無住心を仏心という」と大珠慧海の「頓悟入道要門論」にあるが、真宗的にいえば「はからいなき心」である。",
              "citation": {
                "source": "改めて民藝について",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
