        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヨク来タト申シタイアナタノ可愛イ手紙、今朝参リマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（タト）（フア）（ラム）（ラ）（バ）（テ）（サ）（ミアグ）（ラ）（クシ）（テ）（シア）（ラ）（ナー）（ガ）（テ）。",
              "citation": {
                "source": "短歌の詩形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「イイヤ、生レタトキハ良カツタ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「イイヤ、生レタトキハ良カッタ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "マオカから七里ほど北のオタトモといふところに製造所があるのだが、そこは八月から浪が荒くなるので、四里ばかり手前へ假製造所を定め、また別に一ヶ所、マオカの南一里ばかりのテイヤにも設けた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹一疋に附き、マオカで二十錢から二十五錢もしたのに、少し不便なオタトモでは始終八錢の値段を保つてゐたが、それも雜漁者數名を抱へて置けば、ずツと安い割合になること。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "万一出来タトシテモ其時ハ話モ出来ナクナッテルデアロー。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　スタスタト　モリノ　ハウヘ　イツテ　シマヒマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　トシヨリト　ワカレテ　ナホモ　アルイテ　イキマスト、ナルホド　アノ　トシヨリガ　イツタトホリ、ハタケハ　タイハウノ　ワヤ　ウマノ　アシデ　スツカリ　アラサレテ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サカナハ　タイヘン　トクヲ　シタト　オモヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ヤツパリ　イタチハ　ヨブンヂヤ　ナカツタト　オモヒマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノ　カゲカラ　コノ　ヤウスヲ　ウカガツテ　ヰタ　オカアサンダヌキハ　タイヘンナ　コトニ　ナツタト、メヲ　マンマルクシテ　オドロキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリオストが記したヒポグリッフ、ハンガリーのタトス、古ドイツとスカンジナヴィアのファルケいずれも翼ありて空中を行く馬だ。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ父ッチャハ半トシモネテ、ウチノ中ニ何ンニモナクナッタトキニ死ンダノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イアイダ、タベモノヲ見タコトモナカッタトコロヘ、ハジメテソウシキノオソナエモノヲミルト、モウ矢モタテモタマラズ、目ガクラクラットシテ、ソレニ小サイ弟ヤ妹ナノデ、死ンダオ母ッチャニワルイトオモイナガラ、スキヲネラッテ、ミンナデムチュウニナッテタベテシマッタンダッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "これと比べると、有島君の『イエツタトリイチエ』は、かうも筆の触りや、感じや気分が違ふものかと思はれた。",
              "citation": {
                "source": "自他の融合",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはモーリス・ルブランとたとえばチェスタトンとを例にあげてもよい。",
              "citation": {
                "source": "現下文壇と探偵小説",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェスタトンの探偵小説の価値を非常に高く評価する人も中にはあるが、それは探偵小説の独自性を認めない人々であって、私は彼の作品、わけても、小酒井不木が彼の傑作として翻訳紹介した『孔雀の樹』のような作品は探偵小説としては実に退屈な失敗の作だと思っている。",
              "citation": {
                "source": "現下文壇と探偵小説",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェスタトンのブラウンから愛嬌をとって、その代わりに陰気なところを加えたような型で、頭はひどくよいが、そのよさが、満べんなく円満によいというのではなくて、どこか片輪のようなよさである。",
              "citation": {
                "source": "ヂユパンの癖とヴァンスの癖",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つはドイツのマルクス主義者フランツ・メーリングの文学論を川口浩氏が編訳した「世界文学と無産階級」という書物で、いま一つは、イギリスでショーと並び称せられた特色ある批評家チェスタトンの「探偵小説擁護論」（『新青年』所載）である。",
              "citation": {
                "source": "二つの文学論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェスタトンは、探偵小説の本質的な価値を「モダン・ライフにおける詩の観念を表現する大衆文学中、最初にしてしかも唯一の形式だという点に存する」と定義している。",
              "citation": {
                "source": "二つの文学論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェルズや、チェスタトンやハガードなどは別として、純粋の探偵小説家で、いわゆる「文壇」に重きをなしている人はほとんどなかろうと思う。",
              "citation": {
                "source": "『心理試験』を読む",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "タトエバ我々ノ映画事業ニシテモ、何カ会ダノ組織ダノガデキルタビニ、ズラリト重要ナ椅子ヲ占メラレルノハ、必ズ、全部ガ全部映画ニハ何ノ関係モナイ人バカリデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コウイウ国ガラデアツテミレバ、タマタマ私ガ少シクライ畠チガイノコトニ口出シヲシタトコロデメツタニ苦情ヲイワレル筋合イハナイハズデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モシオ前ガ何カ他人ノ物ヲコワシタトキニハ、オ前ハドウシナケレバナランカ？",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の若いほうの女は、写真で見ると、可成りの美人で、映画女優のルス・チャアタトンにとてもよく似ている。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　其ノ日「マージャン」ヲシテ居ル最中、タシカ九時半頃デシタト思イマス、友田ガ便所ニ立ッタノデス、スルト道子ガ続イテ何カ台所ニ用ガアルト見エテ室ヲ出マシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ彼女ガ便所カラ出テ来タトコロヲ廊下ニ擁シテ話シタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
