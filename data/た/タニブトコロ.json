        "examples": {
          "standard": [
            {
              "text": "霧が晴れると、谷懐に小さな農村が静かに広がっているのが見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "修験者たちは谷懐の奥深くに庵を結び、俗世を離れて修行を続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "谷懐に抱かれたその温泉地は真夏でも涼しく、湯治客が絶えなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "その二百十四　わたくしは狩谷懐之が、縦令多少書を読んでゐたとしても、必ずしも大商店を経営する力をば有せなかつたものと推する。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "狩谷懐之を「せうとの君」と書してある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
