          "literary": [
            {
              "text": "なかで気のきいたせんせいたちが、バタパンご持参で、やってきていましたが、それをそばの人にわけようとはしませんでした。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "その探偵はタパン先生の弟子ルコックでありトンマ探偵は、時になんとか警部であり、時に巴里名題の探偵というグアイである。",
              "citation": {
                "source": "探偵小説を截る",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ああ、また始まったね」と、その監視人は言い、バタパンを蜜の壺に浸した。",
              "citation": {
                "source": "審判",
                "author": "DER PROZESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "スタパンは若くて清らかだ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「赤羽君、このバタパンを食って見給え。",
              "citation": {
                "source": "凡人伝",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてクレエテルヤアン氏は、コオヒイを――コオヒイとバタパンを求めた。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも彼はＫの音を、のどのずっと奥のほうで出すし、また誰でも食慾をそそられずにはいられない調子で、「ボタパン」と発音する、一種あざやかな癖を持っていた。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬車を降りると、コオヒイとバタパンを取り寄せたが、大いに呆れた顔をしていた。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前におれのバタパンを半分やろう。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
