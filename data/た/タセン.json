        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "知事の多選による弊害を防ぐために、任期を制限する条例が可決された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "同じ人物が長年リーダーを務める多選は、組織の硬直化を招きかねない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は地元での根強い人気を背景に、衆議院議員として多選を重ねている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
