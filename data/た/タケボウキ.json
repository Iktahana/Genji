        "examples": {
          "standard": [
            {
              "text": "朝、庭師が竹ぼうきで落ち葉を丁寧に掃き集めていた。カサカサという音が心地よい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "縁側を竹ぼうきでサッサッと掃いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "竹ぼうきは和風の家の景観に調和している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "あんな助平で騒々しか鳥はわしゃ好かん」　晩飯をすました三太が、裏庭へ出てみると、爺さんは傍らに竹ぼうきを投げだしたまま、土蔵の石段にしょんぼり腰をかけていた。",
              "citation": {
                "source": "南方郵信",
                "author": "中村地平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
