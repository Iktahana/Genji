          "literary": [
            {
              "text": "ツメタイノ持って来てください。",
              "citation": {
                "source": "三斜晶系",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "デキアガツタ　クワガ　タクサン　ヘイタイノヤウニ　ナランデ　ヰマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレハ、イタチサンガ、オナラヲ　シタイノヲ　アマリ　ガマンシテ　ヰタノデ　コンナ　コトニ　ナツタノデス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジウタイノママジゾクセリ」　私は直ぐに持久戦を覚悟した。",
              "citation": {
                "source": "父杉山茂丸を語る",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノイドノ水ガイチバンツメタイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムネイタイノ、ト君チャンガキクト、イヤト頭ヲフルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナッテ、又ムネイタイノ、トキクト、ダマッテ目ヲツブッテ、ソレカラムネナンテ何ンデモナイ、ト云ッテ、君チャンノカオヲ見、何ンベンモソットナミダヲフイテルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ金モ、今日ダツテ、コレグラヒ持ツテ来マシタ、マタ来月モ持ツテ来ルデセウ、だつでいニ贈リタイノデアリマス。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈ボクハ　コノ地上デ受ケタ魂ノ疵ヲコノ地上デ医ヤシタイノダ　アマストコロアト　七千日……〉　旅先で新しい愛人を得て、東京へはもう戻らないと宣言した友からの手紙だつたが、異常な悲壮が揺れうごいてゐた。",
              "citation": {
                "source": "火の踵",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘイタイノ　ジムハ　テッポウデ　ウツト　オコリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「センセ、オテテガイタイノ」　私は手を揚げるべき時にそう云った。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジ辻堂ノ中デ五六丁離レタ所ニオ誂エ向キノ家屋ガ一軒売リ物ニ出タノデ、何トカシテソレヲ買イタイノダガ、ソレニハ金ガ二三百萬足リナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全日本バンタム一位ノ坂本春夫ガタイノバンタム一位ノシリノイ・ルクプラクリスヲノック・アウトシテ初代チャンピオンガ生レタアノ晩デスヨ、―――」ソノシリノイ・ルクプラクリスト云ウ名ヲ陸子ハ流暢ニペラ／＼ト云ッテ退ケタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハオ爺チャンノ墓地捜シノオ供ヲシテモ詰マラナイカラ、アタシハ御免蒙リタイ、コレカラ四条通リヘ出カケテ「キリハタ」ヤ高島屋デ買物ヲシ、午後ハ高雄方面ヘ紅葉見物ニ行キタイノダガ一人ボッチデハ仕様ガナイ、誰カ案内ヲシテクレナイカシラト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョット食堂ヘ行ッテ来タイノ」イツノ間ニカ颯子ガ眼ヲ覚マシタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ妻ニ注意シタイノハ、云ウマデモナイダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、何ノ目的デサヨウナヲ分ラセテイルノデアルトシテモ、ソレハ、「私ハセメテ相手ヲアナタト思イタクナイノデス、木村サンダト思イタイノデス、ソウシナケレバ感興ガ湧イテ来ナイノダカラ、結局ハソレガアナタノタメデモアリマス」トイウ意味ナノカ、「コレモヤハリアナタヲ嫉妬サセテ刺戟ヲ与エル手段ナノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ノ目的ハ、コレラヲ僕ノ日記帳ニ貼付シテオクハ希有ノニヨッテ彼女ヲ極度ニ辱カシメ、彼女ガドコマデシラヲ切ッテイラレルカヲ試シテヤリタイノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今度ハコレヲ聞キタイノデスカ？",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『コワクテ、イタイノ、アイッテ。",
              "citation": {
                "source": "赤い手帖",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "コワクテ、イタイノ、アイッテ、フフフ、か。",
              "citation": {
                "source": "赤い手帖",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
