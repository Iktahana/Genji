        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕は、このスタデーとレヴォルトの二つの野心を、それぞれ監獄と社会とで果し得たいものだと希望している。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月十一日（木）　松方から『サタデー・イブニング・ポスト』の寄稿家の老婦人会いたいと云って来る。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉三郎はこまんが或時栄一のスタデーに泣いて居るのを見たと高い黄ろな声で云つて、お梅の好奇心を買つて居た。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日の朝栄一は平常の様に、父やお梅に遅れて食事しようと八時十五分程前に二階のスタデーから下の台所へ降りて来た。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ひ立つと慌てゝ蒲団をグル／＼と巻いて玄関の押込へつき込んで、二階のスタデーへ飛び込んで机にもたれた。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾て君がスタデーで与へられた接吻、どうして忘れる事が出来ませう！",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "読んで居て堪らなくなつたから急に立ち上つて二階のスタデーへ這入らうと襖を蹴立てゝ二階へ駆け上つた。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚いた事には、自分のスタデーは蒲団の洗濯物の為めにでんぐり返してある。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "主義に立つて居る者が未来に対する恐怖とか、自分のスタデーの荒されて居る位の事で身震ひする様では駄目だと思つたから、身を起して窓に立つて見渡すと、晴れ渡る朝空に、川に沿うて生えて居る老松の緑が如何にも対照よく見える。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう困難のうちにおいて、彼らを助けに来てくれたただ一人の者は、タデー・モークという四十歳ばかりのユダヤ人だった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしタデー・モークを初めて見ると、彼は顔を渋めた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ルック』や『サタデー・イーヴニング・ポスト』といった家庭雑誌だ。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "（バート・コラル、『サタデー・レヴュー』）　音楽のモードが変化するとき、街の壁が崩れ落ちる。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラウン物をサタデー・イーブニング・ポストに発表しはじめた時の彼は、既に評論、随筆、小説の各方面で活躍して、名声を博していた。",
              "citation": {
                "source": "ブラウン神父総説",
                "author": "村崎敏郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
