[
  {
    "uuid": "5bcbd86c-3abf-5948-bd12-844d338fb641",
    "entry": "他愛",
    "reading": {
      "primary": "たわい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "sanity",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "悲しみのあまり、彼は他愛を失ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "高熱で意識が朦朧とし、他愛もなくなっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の言動には、もはや他愛が見られない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "こんな他愛のないことを考えることもある。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上は自分が今日までに感じた随筆難のありのままの記録で、云わば甚だ他愛のない「筆禍事件」の報告と愚痴のいたずら書に過ぎないが、こんなことまで書くようになるのもやはり随筆難の一つであるかもしれないのである。",
              "citation": {
                "source": "随筆難",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このような他愛もない事を考えながらともかくも三年にわたる厄年を過して来た。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は今の青年男女が野天のプールで泳ぐように、満身に陽を浴びながら水沫を跳ね飛ばして他愛もなく遊んでいます。",
              "citation": {
                "source": "鯉魚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何が可笑しいと聞かれると実は返答に困るような甚だ他愛のない、しかしそれだけに純粋｜無垢の笑いを笑ったようである。",
              "citation": {
                "source": "初冬の日記から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして室生は、この點でドストイエフスキイ系に屬する他愛的エゴイストである。",
              "citation": {
                "source": "室生犀星の印象",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チタ子はホルマリンの臭のする、平気で汚い紙幣と交換される踊子たちの貞操帯の中で、私と他愛もないことを喋りながら一夜を明かしました。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "他愛なく笑ひさざめく男達の前で裸踊する痩せこけた女の顏、血烟立ててコロツと前に轉がつた馬賊の首、死骸のやうに床にのけぞり返つてゐた阿片中毒のロシヤ人の無氣味な瞳の光……。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな他愛もない事を考えてみたりした。",
              "citation": {
                "source": "断片（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "某百貨店の入口の噴水の傍の椰子の葉蔭のベンチに腰かけてうっとりしているうちに、私はこんな他愛もない夢を見ていたのである。",
              "citation": {
                "source": "夏",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "をぢさんは私を相手にしてランプの前で一時間ほども他愛もない話などをしてゐた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と濁った声を出して白痴が件のひょろりとした手を差向けたので、婦人は解いたのを渡してやると、風呂敷を寛げたような、他愛のない、力のない、膝の上へわがねて宝物を守護するようじゃ。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おんぶするならしてくれ、で、些と他愛がないほど、のびのびとした心地。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、こうも、他愛のない事を考えるのも、思出すのも、小北の許へ行くにつけて、人は知らず、自分で気が咎める己が心を、我とさあらぬ方へ紛らそうとしたのであった。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな訳で話も何も他愛なく纏まっちゃって、己れのこね上げた腸詰はグリゴリー・ペトニコフの皿の上に乘っかったのよ。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は蔓のやうにからみ付くその手足を没義道にも他愛なく引き放して、いきなり外套と帽子と履物と掃除道具とでごつちやになつた真暗な中に子供を放り込んだ。",
              "citation": {
                "source": "An Incident",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お末は素早く逃げおほせて、他所に遊びに行つて他愛もなく日を暮して帰つて来ると、店の外に兄が出て待つて居たりした。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お末はお末で洗物をするでもなく、川柳の小蔭に腰を据ゑて、ぎら／＼と光る河原を見やりながら、背の子に守り唄を歌つてやつて居たが、段々自分の歌に引き入れられて、ぎごちなささうに坐つたまゝ、二人とも他愛なく眠入つてしまつた。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お末はそれでもその後少しも腹痛を覚えずにしまつたが、力三はどつと寝ついて猛烈な下痢に攻めさいなまれた挙句、骨と皮ばかりになつて、九月の六日には他愛なく死んでしまつた。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　折角鶴吉の骨折りで、泥の中から頭を持ち上げかけた鶴床は、他愛もなくずる／＼と元にも増した不景気の深みに引きずり込まれた。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうかしたはずみを喰ふと、おんつぁんも勃凸も他愛がなくなつて、店に出入りする若者達と一緒にどこかに出かけて、売溜めを綺麗にはたいて、商売道具を手あたり次第に質草にするのが鳧だつた。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達はさういふ風にして他愛もなく騒いだ。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四六課　他愛　他を愛することばかりが美挙の全部だと思っている人があります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "親船は他愛がなかった。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と金切声を出して、ぐたりと左の肩へ寄凭る、……体の重量が、他愛ない、暖簾の相撲で、ふわりと外れて、ぐたりと膝の崩れる時、ぶるぶると震えて、堅くなったも道理こそ、半纏の上から触っても知れた。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　唯吉は、襟許から、手足、身體中、柳の葉で、さら／＼と擽られたやうに、他愛なく、むず／＼したので、ぶる／＼と肩を搖つて、「此は暑い。",
              "citation": {
                "source": "淺茅生",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　美人に見惚るゝとて、あらう事か、ぐつたり鏡臺に凭掛つたと云ふ他愛なさ。",
              "citation": {
                "source": "魔法罎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先刻の、あの雨の音、さあっと他愛なく軒へかかって通りましたのが、丁ど彼処あたりから降り出して来たように、寝ていて思われたのでございます。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "徒らに砂を握れば、くぼみもせず、高くもならず、他愛なくほろほろと崩れると、また傍からもり添える。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした外観だけを見ている人は、おそらくこうした夫婦の生活を、たわいもない子供の『ままごと』遊びのように思ったであろう。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
