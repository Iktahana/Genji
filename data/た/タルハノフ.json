          "literary": [
            {
              "text": "タルハノフといふ商人の支配人だ。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな風にして歩いて、とう／＼、タルハノフの家のある所に、或る朝夜の明け切らない内に着きました。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "タルハノフの住ひは森の中にあつて、周囲には丈夫な垣が結つてあります。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "タルハノフの家を出て、夜道を歩いた時なんぞが、丁度さういふ場合でした。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            }
          ]
        }
