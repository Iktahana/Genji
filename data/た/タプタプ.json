        "examples": {
          "standard": [
            {
              "text": "運動不足のせいで、お腹の周りがタプタプとした脂肪で覆われてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "コップになみなみと注がれた水が、歩く振動でタプタプと揺れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「わっ、この大きな水槽、叩くとタプタプ音がして面白いね！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "モウタアを仕かけたその小さな伝馬は、すぐその向うのところに来てタプタプと波に浮かんでゐた。",
              "citation": {
                "source": "モウタアの輪",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "電気をひくくさげて、ペン先きにたっぷりとインキをふくませて、紙の上にタプタプとおとしてみる。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
