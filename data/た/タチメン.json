          "literary": [
            {
              "text": "立花先生のことを、このへんの子供は、タチメンとよんでいた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは身体が長い銀色の魚タチウオに似ていて、先生は女だからメスで（この町ではメスのことをメンという）つづけていうとタチウオのメン、つまりタチメンという綽名がついたのである。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけのことであったが、タチメン先生にちがいなかった。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "タチメン先生に、この黄金メダルを預ってもらおう。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
