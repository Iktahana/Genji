        "examples": {
          "standard": [
            {
              "text": "この美術館の展示は宝尽くしだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "江戸時代の着物に描かれた宝尽くしの文様が素晴らしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その書斎は古い本や美術品の宝尽くしだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "千両｜函、大福帳、蕪、隠れ蓑、隠れ笠、おかめの面などの宝尽くしが張子紙で出来て、それをいろいろな絵具で塗り附ける。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "熊手を拵えて売ったはなし",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
