        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この美術館の展示は宝尽くしだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "江戸時代の着物に描かれた宝尽くしの文様が素晴らしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その書斎は古い本や美術品の宝尽くしだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "千両｜函、大福帳、蕪、隠れ蓑、隠れ笠、おかめの面などの宝尽くしが張子紙で出来て、それをいろいろな絵具で塗り附ける。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "熊手を拵えて売ったはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝尽しの模様を織った、薄紫の緞子の衣裳に、水晶の耳環を下げているのも、一層この妓の品の好さを助けているのに違いない。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲「ハテ品川の益田孝君さ、一｜夜に頭が三｜尺延たといふが忽ち福も禄も益田君と人のあたまに成るとは実に見上げた仁です、殊に大茶人で書巻を愛してゐられます、先日歳暮に参つたら松と梅の地紋のある蘆屋の釜を竹自在に吊つて、交趾の亀の香合で仁清の宝尽しの水指といふので一ぷく頂戴しました。",
              "citation": {
                "source": "七福神詣",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
