        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "帯地に宝尽くしの模様が描かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "宝尽くしのデザインは新年の着物に好まれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この襖絵には宝尽くしが描かれており、おめでたい。",
              "citation": {
                "source": "Illusions AI",
