    "definitions": [
      {
        "index": 1,
        "gloss": "to hang over",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "早朝の湖には深い霧が立ち込め、周囲の景色を白く覆い隠している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "焼き鳥屋の前を通ると、食欲をそそる香ばしい煙が辺りに立ち込めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "火事の現場には黒い煙が立ち込め、避難する人々の視界を遮っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "行く手に立ち込める濃い朝霧を通って行った後、あの面影の女の袖を引く手を振りほどいて帰ってしまったのは、そもそも主命に背かぬがためであった。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗い、黄霧の立ち込める朝で、ただでさえインスピレーションが湧きにくい天気だというのに、あの馬鹿女はドアのすぐ前に立ちん坊を決め込んだまま返事を待ち私がじれて他のことを考えられないようにしむけている。",
              "citation": {
                "source": "盗聴者",
                "author": "Ａ. ブラックウッド　A. Blackwood",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人の銃弾が背後の扉に逸て、濛々と白煙が立ち込める。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "靄が立ち込めるロング・エーカーの青白い光は弱く、向かい側のラッセル・ストリートは一層暗い。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那の占星の術は星の位置と他星との交渉と、光威とその付近にたちこめる霞気の類との状態に照らして人事や運勢の吉凶を判断するのであって、星を占うという語と共にしばしば支那の書に於いて遭遇するところである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは、遠くからみれば大乳海を呈し、はいれば、たちこめる花香のなかで生きながら涅槃に入るという、ラマ僧があこがれる理想郷である。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそこを、雲霧たちこめるおそろしい湿熱の様から、“｜Los Islas de Tempeturas”と名づけた。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は、毒瓦斯たちこめる原頭に立って、いささかもひるむところなく、例の大きな機械の組立を急いだ。",
              "citation": {
                "source": "二、〇〇〇年戦争",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "丘を登るドーヴァー行の駅逓馬車、その傍を歩く一乗客、泥濘の道、馬車を曳く馬、谷々をたちこめるイギリス名物の霧、厚く身をくるんだ乗客たち、馭者と車掌、等、等、――この物語の初めの方は長編の発端らしく悠々としてその道を辿り、遅々として進捗しない。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月のある暑い日のこと、ちょうど夕暮ちかくで町の家畜の群が往来をぞろぞろ追われて行き、中庭いちめんにもうもうと埃がたちこめる時刻だったが、とつぜん誰か木戸をこつこつと叩く人があった。",
              "citation": {
                "source": "可愛い女",
                "author": "DUSHECHKA",
                "note": "青空文庫"
              }
            },
            {
              "text": "岸と船で別れの合図をかわし、艀はまた湯気のような熱い靄のたちこめる赤道の海に漂いだした。",
              "citation": {
                "source": "海難記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩穴の中は、もうもうとたちこめる一面の白い煙。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "白くたちこめる湯気の中に、背に彫られた恐しい般若の面が、すっと消え、ちょっとの間、妖しい雰囲気がただよった。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々の精神のようなあんな放浪的な歩みを追いかけたり、そのかくれた隅々にたちこめる雲霧を見とおしたり、その運動の機微な様態を一々捕捉したりするのは、苦しい仕事である。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにいよいよ旺にたちこめるは、日頃の炊煙にしては夥しすぎる。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "信長の乞いに委せて遠く博多から携えて来て鑑賞に供えた家伝来の幅、牧谿の遠浦帰帆之図は、たちこめる煙の中にも、名画の気品をすこしも譟がしてはいなかった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方になって池の面が薄い霧のヴェールに蔽われるころになると何かしらほのかな花の匂いが一面に立ちこめる。",
              "citation": {
                "source": "浅間山麓より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたあとで、テナシティのデッキの上から「あしたは出帆だ」とどなるのをきっかけに、画面の情調が大きな角度でぐいと転回してわき上がるように離別の哀愁の霧が立ちこめる。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "でなくば、あの速さで火薬の煙が家中に立ちこめるわけがない。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほの白い夜あけの空気が、病室のなかに立ちこめる。",
              "citation": {
                "source": "青白き夢",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "噎せる程強いシトロンの香の立ちこめる熱い空気の中で、会衆は静かに頭を垂れた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "迷つてゐる者に道を教へるやうに、日中が近寄つて來ることを告げるやうに、身をゆすぶり、木をゆすぶり、林をゆすぶつて、立ちこめる霧を追ひやるやうに鳴き出した。",
              "citation": {
                "source": "霧の旅",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "賈誼の詩だな――はるかに白雲の蓬勃たるを望めば……か、あははははは」　とこの豁達な笑いに忠相もくわわって、ともに語るにたる親交の醍醐味が、一つにもつれてけむりのように立ちこめる。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "十日　夜一時半　夜露が深く湖面に立ちこめると見えて、うすらつめたく湿った空気があけた窓から入って来る。",
              "citation": {
                "source": "樹蔭雑記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに日暮れ、川の上に立ちこめる水蒸気と、しだいに暗くなる夕空の薄明りとは、この大川の水をして、ほとんど、比喩を絶した、微妙な色調を帯ばしめる。",
              "citation": {
                "source": "大川の水",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "風につれて、さあっ、さあっと山から山へ立ちこめる霧雨が降って来た。",
              "citation": {
                "source": "小村淡彩",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "場内は、立ちこめる煙草のけむりと一緒に益々混乱し、いろんな突拍子もない意見や質問が続出した。",
              "citation": {
                "source": "乳房",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の、贅沢な、物懶い横目では、もうどうにも、負わされない一種の力、何か不気味に因縁的な、陰気な意地悪いものが、心の奥からしんしんと湧き上って、自分の周囲を立ちこめるのを感ぜずにはいられなかったのである。",
              "citation": {
                "source": "渋谷家の始祖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "丘陵の谷間に夕靄が立ちこめると、いつのまにか月が出ていた。",
              "citation": {
                "source": "常識",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "山田の頭に憂欝なものが立ちこめる。",
              "citation": {
                "source": "春盲",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
