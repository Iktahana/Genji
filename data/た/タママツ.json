          "literary": [
            {
              "text": "門を出ると、右左、二畝ばかり慰みに植えた青田があって、向う正面の畦中に、琴弾松というのがある。",
              "citation": {
                "source": "星あかり",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "門を出ると、右左、二畝ばかり慰みに植ゑた青田があつて、向う正面の畦中に、琴彈松といふのがある。",
              "citation": {
                "source": "星あかり",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "松下に一壺おけばそのまゝ卓ともなり、默石彈松の間に、何をひとり考へようと自由である。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
