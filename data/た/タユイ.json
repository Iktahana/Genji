        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お納戸の絹セルに、ざっくり、山繭縮緬の縞の羽織を引掛けて、帯の弛い、無造作な居住居は、直ぐに立膝にもなり兼ねないよう。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "薩摩下駄の小倉の緒、太いしっかりしたおやゆびで、蝮を拵えねばならぬほど、弛いばかりか、歪んだのは、水に対して石の上に、これを台にしていたのであった。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏手の貧乏長屋で、力のない赤子の啼き声が聞えて、乳が乏しくて、脾弛いような嗄れた声である。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "徒歩の目弛いのに気を腐していたお島は、小野田の勧めで、自転車に乗る練習をはじめていた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "階段は弛い勾配をもって高く上へ懸かっている。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不思議とどうにも体が弛い。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三つ目の林を駈け抜けると弛い斜面が現われた。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉末は一呼吸呼吸を入れると弛い斜面を走り出した。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "扇子に例へれば、いゝ骨だし展きも見事なものだが、要の弛いために、がくがくするやうなもの、骨格の弱体を蔽へない仕事振りだつた。",
              "citation": {
                "source": "小杉放庵",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "弛い放射音が海鳴りのようにつたわる高い天井裏は見ることが出来ないが、天井の灰鼠の混凝土の上に心がとどまって遊んでいる気がし出し、それは天井が見られないために却ってそんな心が遊ぶ状態にあることを知った。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの大輪の環円人花はちょっと廊下からは花びらを見るのに似ていて、打合せが済むと花びらは弛いこなしで蕊の方からくずれて行った。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "発熱前の身体はザワザワと、なんともいえぬ弛い気持がします。",
              "citation": {
                "source": "仁王門",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしの抱く不審は」「ちがうと思う」　馬は黙々と老公をのせて弛い坂をのぼり坂を降ってゆく。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "函南の裾野は弛い傾斜を曳いて、その果ての遠い町の屋根に、冬日は舂きかけていた。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "波打際を数町離れた左馬介光春は、やがて弛い半円の波紋を描いて、水面わずかに見える馬の頭を――西の方、坂本のほうへぐるりと向け直していた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴンドラは、ユラユラと危く揺れて、右に左にたゆいながら進んで行く。",
              "citation": {
                "source": "地獄風景",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
