        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三千や四千の金なら、随分そこらに滾つてゐやうと私は思ふ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度筋肉と骨の間に、煮滾つた熱湯を流し込まれるやうな感じで、ひどい時には痛む腕を根本から断り除つてしまつたらどんなによからうと思ふ。",
              "citation": {
                "source": "烙印をおされて",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "火鉢の上には鉄瓶が滾つて居た。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手で、す早く、滾つて居る鉄瓶を下したが、再び莟を撮み上げると、直ぐさまそれを火の中へ投げ込んだ。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            },
            {
              "text": "手に用をせねばならぬお政は、わきたぎつ涙をぬぐうてもいられぬ。",
              "citation": {
                "source": "告げ人",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただその一囘で、彼の全身の血潮は熱くたぎつて流れた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "落ちたぎつ瀧の水の沫と散りて猶｜麗しきを見ずや。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく麓より眺むれば、この落ちたぎつ水の勢は、早晩巖石を穿ち碎き、押し流して、その上なる人家も底なき瀧壺に陷らずやと怖しく思はると宣給ふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "竈の前に心配相な顏をして茶を沸して居たお袋はたぎつた湯を急須にさして上り框へ持つて來た。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "）兎に角、この室から四方をながめると、靜かなもので、火鉢の湯のたぎつてる音がしてゐるあひだに、川の音が始終遠く、そして時々自動車や馬車の發着の響きが松や檜葉や赤い實ばかりになつてる柿の木やの樹かげから、聞えるばかりだ。",
              "citation": {
                "source": "鹽原日記",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見たとき、勝平は煮えたぎつてゐる湯を、飲まされたやうな、凄じい気持になつてゐた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉井勇氏の戯曲「一本腕と一本足」を見出したが、氏の近詠、物部川夕さりくれば水たぎつ音さらさらと聴え初めけり――と声を立てながら無断引用を為し、遥かに朝臣の盃の夢の健かを望みながら、意を尽し得なかつた禿筆を擱く。",
              "citation": {
                "source": "月評",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをひとめ見た者には、この男の奇怪な心底には只ならぬ魂胆がふつふつと煮えたぎつてゐて、それに対する地上の報いはただ絞首台あるのみだといふことが立ちどころに頷かれた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "二荒山七十餘丈落ちたぎつ瀧は常世のものと響けり山を落つる瀧の音ふかし虹たちてしぶきに秋の日は照り映ゆる山を落つる瀧は水より白雲と霧らひただよひ落ちて流るる",
              "citation": {
                "source": "瀧",
                "author": "今井邦子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また忍ぶかな、高山の奥より落つる長水に巨大の河馬の嘯きて、波濤たぎつる河の瀬を、あるは月夜の清光に白みしからだ、うちのばし、水かふ岸の葦蘆を蹈み砕きてや、降りたつを。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "また忍ぶかな、高山の奧より落つる長水に巨大の河馬の嘯きて、波濤たぎつる河の瀬を、あるは月夜の清光に白みしからだ、うちのばし、水かふ岸の葦蘆を蹈み碎きてや、降りたつを。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　だが、汎神論的色彩といつたものは、リツ子の夫の「私」にも多分に感じられ、万物尊崇でないまでも、万物生成といつたやうな、作家的願望が到る処にたぎつてゐるやうです。",
              "citation": {
                "source": "檀一雄「リツ子・その死」",
                "author": "――創芸社刊――",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ嬉しくて嬉し涙がふつふつとたぎつて來る。",
              "citation": {
                "source": "雨",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が更けると、汽車の汽笛が四圍に響くのと、時々手水場の板戸の音がする外は、部屋の火鉢にかけた鐵瓶がちんちんとたぎつてゐるだけ、かうした靜かな部屋で、孝次郎はふつと名古屋にゐる中學時代からの仲のよかつた友人を思ひ出した。",
              "citation": {
                "source": "雨",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い間沈潜されてゐた女の感情が、ふつふつとたぎつて來てゐる。",
              "citation": {
                "source": "風媒",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "言に言でていわばゆゆしみ山川のたぎつ心をせかえたりけり「ふーむ。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧の馬蹴あげ荒るれど益荒男は手綱たぎつつ鞍無しに乗る煙。",
              "citation": {
                "source": "禮嚴法師歌集",
                "author": "與謝野禮嚴",
                "note": "青空文庫"
              }
            },
            {
              "text": "其中央に、大きな釜があつて、湯がたぎつて居る。",
              "citation": {
                "source": "花の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝには卓の上に、てら／＼光る、気持の好い、腹のふくらんだサモワルがたぎつてゐる。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな爐をきつて、自在に大藥罐の湯がたぎつて居る。",
              "citation": {
                "source": "熊の足跡",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "火鉢の炭火はカンカンにおこり、大きな薬缶の湯はたぎつてゐる。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭火が赤あかとおこり、鉄瓶の湯がたぎつてゐる。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして湯が、せめてぎんぎんたぎつてゐた。",
              "citation": {
                "source": "麓",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "○山川もよりて奉ふる神ながらたぎつ河内に船出するかも　〔巻一・三九〕　柿本人麿　持統天皇の吉野行幸の時、従駕した人麿の献ったものである。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「稲日野も」の「も」は、「足引のみ山も清に落ちたぎつ」（巻六・九二〇）、「筑波根の岩もとどろに落つるみづ」（巻十四・三三九二）などの「も」の如く、軽く取っていいだろう。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
