[
  {
    "uuid": "4e2cea10-a9c8-50b5-9a35-4aaf32fd5ad5",
    "entry": "球乗り",
    "reading": {
      "primary": "たまのり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
