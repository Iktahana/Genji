    },
    "definitions": [
      {
        "index": 1,
        "gloss": "balancing on a ball",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "サーカスのピエロが、大きな鞠の上で絶妙なバランスを保ちながら球乗りを披露した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "アシカが鼻先にボールを乗せたまま球乗りをする姿に、観客から拍手が沸いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "球乗りを練習しすぎて、足の裏の皮がすっかり厚くなってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "又、おばあさんとだけやらされるときもあったが、そんなときには私はいつも球乗りや花屋敷などへ彼女を引っぱって行った。",
              "citation": {
                "source": "幼年時代",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "晝としよりのゐねむりゐねむりはぎんのはりをのむたまのりむすめふゆのひのみもだえそのはなさきにぶらさがりたるあをぞら。",
              "citation": {
                "source": "聖三稜玻璃",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "この節を機として、諸国より入り込みたる野師らは、磧も狭しと見世物小屋を掛け聯ねて、猿芝居、娘｜軽業、山雀の芸当、剣の刃渡り、活き人形、名所の覗き機関、電気手品、盲人相撲、評判の大蛇、天狗の骸骨、手なし娘、子供の玉乗りなどいちいち数うるに遑あらず。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "公園裏にて下り小路を入れば人の往来織るがごとく、壮士芝居あれば娘｜手踊あり、軽業カッポレ浪花踊、評判の江川の玉乗りにタッタ三銭を惜しみたまわぬ方々に満たされて囃子の音ただ八ヶまし。",
              "citation": {
                "source": "半日ある記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば、小人たちは、ふたりずつに別れて、木の葉や、高い草の上にたまっている、大きな露のしずくの上で、玉乗りあそびをしていました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕の外に出ている玉乗りの女の異様な扮装や、大きい女の鬘を冠った猿の顔にも、釣り込まれるようなことはなかった。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの中を、むっつり右門は依然むっつりと押し黙って、かき分けるようにやって行きましたが、と、立ち止まった見せ物小屋は、なんともかとも意外の意外、南蛮渡来の女玉乗り――と書かれた絵看板の前だったのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただの玉乗りとはわけが違う。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "七段返しに宙乗り踊り、太夫は美人で年が若うて、いずれも南蛮渡来の珍しい玉乗り。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「座頭太夫はもと船頭で、唐の国へ漂流いたし、その節この玉乗りを習い覚えて帰ったとかいううわさじゃが、まさかにうそではあるまいな」「そこです、そこです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘がびんを取り上げてみると、あいにくそれがからだったので、なにげなく屋台車のけこみを押しひらいて、中からたくわえの別なびんを取り出そうとしたそのとたん、ちらりと鋭く右門の目を射たものは、たしかにいま浅草の小屋で見て帰ったと同じ南蛮玉乗りの大きな黒い玉でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に、ことりとなにか取り出したらしい物音は、たしかにあのけこみの中へ秘めかくしておいた玉乗りの黒い玉です――右門はかくし持っている御用｜龕燈をしっかりと握りしめました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "南蛮渡来の玉乗りも、むろんその切支丹伴天連が世を忍んだ仮の姿で、岡っ引き長助を殺した直接の下手人は、催眠の術にたけていたおでん屋親子とみせかけているその両名でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "侍のみを目がけたのは、いざというときその腕を役だたせよう、というので、玉乗りの玉を使った理由は、さも幽霊のしわざででもあるかのように見せかけて、少しでもその犯行への見込みを誤らしめようという計画からでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかでもなく、それは柳原からの報告をもたらしたとき、すぐに右門が玉乗りへやって行ったあの事実です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それにしても、いきなり玉乗りへ行ったのは、まさかだんなも伴天連の魔法を知ってるわけじゃありますまいね」　すると右門は即座に自分の耳を指さしたものでしたから、伝六が目をぱちくりしたのは当然。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめはむろんでたらめなべらべらだなと思っていたが、きさまがおでん屋で芋焼酎を売り物にしているといったあの話から、てっきり南蛮酒だなとにらんだので、南蛮酒から南蛮渡来の玉乗りのことを思いついて、妓生のべらべらをもう一度聞きためしにいったまでのことさ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの玉乗りの太夫たちが唐人ことばで踊りを踊るということは、まえから聞いていたのでな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういうことを思い浮べながら、玉乗りのあった前を通っていると吾妻橋の近処に住んでいる友人に会った。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "此頃誠太郎はしきりに玉乗りの稽古をしたがつてゐるが、それは、全く此間浅草の奥山へ一所に連れて行つた結果である。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃誠太郎はしきりに玉乗りの稽古をしたがっているが、それは、全くこの間浅草の奥山へ一所に連れて行った結果である。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "球だけ取り脱して、よく江川の玉乗りの真似などして、「そんなことをすると罰が当るぞ」などと祖父から叱られたりしたことを思いだした。",
              "citation": {
                "source": "地球儀",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "球だけ取り脱して、よく江川の玉乗りの真似などして、「そんなことをすると罰が当るぞ。",
              "citation": {
                "source": "地球儀",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪だって善だって、漫才だって、玉乗りの果てに至るまで日本人はそうなんだから、まア、とにかく、僕らにしてもやっと御幣の傍へ帰りついたのだからね、お祭りぐらいはしたくなるよ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬車に乗せて、三越で着物を買つて、白ぼたんで指環を買つて、そして奥山の玉乗りを見せよう。",
              "citation": {
                "source": "茗荷畠",
                "author": "眞山青果",
                "note": "青空文庫"
              }
            },
            {
              "text": "着物が素味だつた割に、帯は赤の玉乗り友禅や麻の鹿の子などはんなりしてゐた。",
              "citation": {
                "source": "写生帖の思ひ出",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に少年は、ひと抱えほどある大きな毬を取り出し、玉乗りの芸を始めました。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎は玉乗りの大きな毬を持ちだしました。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "実に、見事な猫の玉乗りです。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが大抵は赤いズボンに、半身は裸の役者だから、愈曲馬か玉乗りの親類らしい気がしてしまう。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
