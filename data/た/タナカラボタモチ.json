        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「ずっと欲しかった非売品のポスターを友人から無料で譲ってもらえるなんて、まさに棚からぼた餅だ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ライバル会社の不祥事により、棚からぼた餅で棚ぼた的な受注が舞い込んできた。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「努力もせずに棚からぼた餅のような幸運ばかりを期待していると、足元をすくわれるぞ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "棚からぼた餅をとるんとわけがちがうぞ。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "儲ける国は棚からぼた餅でほくほくものだろう。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "棚からぼた餅といわれているが、何んの当世棚を覗いたってぼた餅なんかァありそうもねえが、今日はそいつにありついたってものさ、そうはいっても俺の考え、間違っていりゃァ別だがな」　押し詰った十二月の中旬真昼。",
              "citation": {
                "source": "染吉の朱盆",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "９．「占めた、これこそほんたうに棚からぼた餅といふ奴だ！",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
