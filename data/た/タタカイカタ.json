          "literary": [
            {
              "text": "地の理も、将門の戦い方も、経験によって、彼らは、相当、研究をつんで来たらしい。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "奴が跳ね回って突っ込んでくれば俺なんか吹っ飛ばされるところだが、おそらく奴は前に何度も引っ掛けられて、これが一番の戦い方だと学習したんだ。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "その戦い方には動揺がない。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとうの勝ちはその戦い方にある。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
