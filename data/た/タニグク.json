  {
    "uuid": "2a066e11-3cda-5a36-8f69-ef484e720ab3",
    "entry": "タニグク",
    "reading": {
      "primary": "たにぐく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
