  {
    "uuid": "389e3a98-ca3e-52ea-9338-bd370f815560",
    "entry": "タア",
    "reading": {
      "primary": "たあ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "或は伊太利のヴェニスを詩的と言い、マンチェスタアや紐育をプロゼックだと言う。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の肖像と事蹟とは、米国の親友お札博士の名で日本に知られているところの、スタア氏の著書『フジヤマ』（英文単行本）によって、同情ある筆で世界に伝えられたが、故国で、知音諸氏によって、君を追悼した登山会が催されたとすれば、君にはいい手向けである。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も、桑港で発行される日本字新聞『日米』で、君とスタア博士と富士山との交渉を書いて、心ばかりの供養に代えたが、富士山の納め手拭から、この事を知ったのは、山中でひょっくり君に出逢ったようであった。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが失くなったてなあ、おかしいじゃないか」　と言うと、タア坊は、飯場の入口に立ったまま首を傾けた。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "タアちゃんだっても、東京の方がいいなあ、なんかって言ってるのよ」「そりゃ、俺だって、どこかで、楽な生活ができれば遠慮しやしないよ。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲーテのファウスト、ダンテの神曲、シェークスピヤのハムレット、カアライルのサアター・レサアタス（Sartor Resartus）、ブラウニングのイースタアデー（Easter Day）とラビ・ベン・エズラ（Rabbi Ben Ezra）等はそれである。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬場はドクタア・プラアゲと日本の樂壇との喧嘩を噛んで吐きだすやうにしながらながながと語り、プラアゲは偉い男さ、なぜつて、とまた獨りごとのやうにしてその理由を呟いてゐるうちに、私は私の女と逢ひたくて、居ても立つてもゐられなくなつた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はライタアで、煙草に火をつけてあげて、「そうしてね、進も兄さんも、下谷の家が大きらいなんだろう？",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランタアンといふ短篇小説である。",
              "citation": {
                "source": "音について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みな寝しづまつたころ、三十歳くらゐのヘロインは、ランタアンさげて腐りかけた廊下の板をぱたぱた歩きまはるのであるが、私は、いまに、また、どこか思はざる重い扉が、ばたあん、と一つ、とてつもない大きい音をたてて閉ぢるのではなからうかと、ひやひやしながら、読んでいつた。",
              "citation": {
                "source": "音について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "未来派の絵というと、ギタアが出て来るのは、あれはどういう理由によるのだろうか。",
              "citation": {
                "source": "二科会展覧会雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そオら、今度は敏樹はふつて御覽‥‥」「うん‥‥」　と受け答へて、茶色のスエエタアを着た、まるまる肥つた體をよちよちさせながら、敏樹は別の小さな鞠を投げた。",
              "citation": {
                "source": "畫家とセリセリス",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミスタア・木村、ミスタア・高柳、ミスタア……」と、女は小聲に微笑を含んだ聲で云つた。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドイルやルブランの作品の多くは云ふまでもなく、ポオの『病院横町の殺人犯』チエスタアトンの『青い十字架』など。",
              "citation": {
                "source": "探偵小説の魅力",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さあ、ヴイクタアを買ふね。",
              "citation": {
                "source": "夢",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "武井の持つてるやうな……」「ええ、ヴイクタアはいいわ。",
              "citation": {
                "source": "夢",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつたい誰でも運勢が傾いてくると、自然とじたばたし出すのは人情の然らしむる所だが、五｜段里見※は紙入からお守札を並べ出す、四｜段古川緑波はシガアレツト・ライタアで切り火をする。",
              "citation": {
                "source": "麻雀を語る",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつたい「櫻の園」には第一｜幕の汽車の音、第二｜幕のギタアの音色、第四｜幕の終りの櫻の木を切り倒す斧の響きなどと、塲面々々の感じと相俟つて音響の効果が實に巧に用ゐられてゐるが、私の狹い知識の範圍では、戯曲に球突の球の響きなどを用ゐたのはひとりチエエホフあるのみのやうである。",
              "citation": {
                "source": "文壇球突物語",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "プレモ、オオトシヤツタア、ソルントンシヤツタア、フオルカルプレンシヤツタア、カアルツアイス、百分の一、千分の一、テツサア、アナスチグマツト――さういふ寫眞用語がいかに歴亂として私の腦裡を動き、いかに胸躍るやうな空想を描かせ、いかに儚ない慰樂を與へたことか？",
              "citation": {
                "source": "寫眞と思ひ出",
                "author": "――私の寫眞修行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さうだ貯金をしよう、貯金を……」　或る日、私はそれ等の目｜録を眺めながら、せめて百分の一｜秒ぐらゐまでのシヤツタア裝置のある三四十円の寫眞器を買はうと思ひ立つて、さう心をきめた。",
              "citation": {
                "source": "寫眞と思ひ出",
                "author": "――私の寫眞修行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國｜製で、シイ・テツサア四・五｜鏡玉、千百六十分の一｜秒まで利くシヤツタア付の、手｜札形レフレツクス、素人｜用としては殆どこの上ないものといつて差支へないのだが、それで一時｜盛返した熱も今は又すつかりさめきつて、それは空しく押入の奧でほこりにまみれてゐる。",
              "citation": {
                "source": "寫眞と思ひ出",
                "author": "――私の寫眞修行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろずいぶん遠くの事だつたで‥‥」　警視は鋭い眼で暫くダアルベルグの顏を探るやうに見詰めてゐたが、やがて次のペタアソンの方へ向きなほつた。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "正面に、エレベエタアの鉄筋が……それも、いま思うと、灰色の魔の諸脚の真黒な筋のごとく、二ヶ処に洞穴をふんで、冷く、不気味に突立っていたのである。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――まさか、十時、まだ五分前だ――　立っていても、エレベエタアは水に沈んだようで動くとも見えないから、とにかく、左へ石梯子を昇りはじめた。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の子、どうかすると十六七の妙齡なるも、自分の事をタアと言ふ。",
              "citation": {
                "source": "寸情風土記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
