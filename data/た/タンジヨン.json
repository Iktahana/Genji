          "standard": [],
          "literary": [
            {
              "text": "市街に向つて右のタンジヨン・カトンの岬に伸びた一帯の大椰子林は新来の旅客の目を先づ驚かすものである。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "海上から見えて居たタンジヨン・カトンの大椰子林へ馬車を駆つて行つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰途タンジヨン・カトンの玉川ガーデン、敬二居等に立寄り、今日の吟行地植物園に下車。",
              "citation": {
                "source": "五百五十句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
