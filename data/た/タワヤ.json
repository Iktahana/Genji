        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "と渋面つくりて銀平の顔を視め、「銀平、遅かったわやい。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "行燈のかげには清き女の童物縫ふけはひ、そがなかにたわやの一人髪あげて戸外すかしぬ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "たわやになびく黒髪の君の水脈こそ身に翻れ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "』とばかり、かたへなる自働電話の火のとびらたわやに開けて、つと入りぬ。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "街へ出かけた、いろ／＼の買物、そしてとう／＼またわやになつた、Ｔさんの店で、Ｋさんの店で。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "『三の緒は、瑞樹のかくれ、たわや女が夏の夜の夢。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "供の者が何か御無礼いたした様子、お腹も立ちましょうが、御堪忍あそばして、許してやって下さいませ」　と、丁寧に挨拶する雪之丞の、たわやかな姿を、素浪人は、かっと見開いた、毒々しい目でぐっと睨め下ろした。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、美しく、たわやかで、その中に限りない凛々しさをほの見せている雪之丞の舞台すがたに、食い入るような瞳を投げつづけながら、罵り、もがき、もだえているのだ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "処がそれは、大一番の丸髷に赤い鹿の子のてがらをかけた、たわやかな美人なのである。",
              "citation": {
                "source": "浅間山麓",
                "author": "若杉鳥子",
                "note": "青空文庫"
              }
            },
            {
              "text": "がらす戸の外にはたわやかなる紺青の海。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ迷ふ迷ひぬ、ふかき「にるばな」に、たわやの髮は身を捲きぬ、たゆげの夜を煩惱は狎れてむつみぬ、「にるばな」に。",
              "citation": {
                "source": "有明集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢の私語、たわやげる瑪瑙の甘寢、「にるばな」よ、艶も貴なる敷皮に嫋びしなゆるあえかさや。",
              "citation": {
                "source": "有明集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンネット、ケラマンの人魚をみたときに、わたしはこれと同じい姿勢とたわやかな美しさとを感じた。",
              "citation": {
                "source": "ヒッポドロム",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上、たわや腕の譬喩。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "たわやかな細く長く引く線は、そう祈るが如く私には思える。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
