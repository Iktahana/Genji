        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "』『ゾウワイジケンノタメシユウヨウチユウノ××ハフキソトケツテイシマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "電報は「ゾ　ウサンノタメシヨウガ　ツヤスミヘンジ　ヨウ」カエラヌ」ツルキチ」鶴さんからオトラ婆さんに宛てたものだった。",
              "citation": {
                "source": "電報",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝の誓願、今後は焼酎を飲むまいぞ、総じて火酒は私に向かない、火酒を飲んでロクな事があつたタメシがない、火酒は地獄の使だ！",
              "citation": {
                "source": "道中記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈石ニ矢ノ立ツタメシアリ、石ニ立ツ矢ノタメシアリ……）　ケラア先生もお葉も、そして太郎も夫々の魂をひたすら楽器に打ち込んで夢中となつた。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "逢って徳をしたタメシがない、で改めて云って置く、俺の住居を話すなよ』――でもあなたのおためなら、道人様のお言葉に背き、道人様のお住居を、お話し致したってかまいません」　これを聞くや山影宗三郎、傷の痛みも打ち忘れ、スルスルと前へ膝を進めた。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ぬまぎわに、あんなことをするなんて、カイビャク以来、きいたタメシがありゃしない」　みんな、しばらく重々しく、だまっていた。",
              "citation": {
                "source": "遺恨",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "半年以上も床屋へ行かず、自分でハサミできってるという頭で、クシなど使うタメシのない頭だから、かんべんしてくれ、と云っても、嘘だと思ってとりあわない。",
              "citation": {
                "source": "無毛談",
                "author": "――横山泰三にさゝぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は前後四五人の女中を、こうして駅頭へ迎えたけれども、私がそれと目印を見破ってモシモシと話しかけると、ハイ、そうです、などゝ返事をする娘のいたタメシがない。",
              "citation": {
                "source": "無毛談",
                "author": "――横山泰三にさゝぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "最上清人先生がおのづからアル・カポネになるなんて、日本歴史のカイビャク以来、人相手相星ウラナイ、物の本にこんな予言のあつたタメシはないだらうな。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから僕の見てきたところでも、オメカケが浮気をしてロクなことになったタメシはないね。",
              "citation": {
                "source": "青鬼の褌を洗う女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オメカケが浮気してロクなことがあったタメシがないんだって。",
              "citation": {
                "source": "青鬼の褌を洗う女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうと睨んだ稲荷カンスケの第六感、はずれたタメシは――」「大ありだ」「その通り！",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレが人相を見て外れたタメシはないはずだが。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こうこだわるのは不健全だ」　と考えて想念を払うために努力するのを忘れたタメシはないのだが、日ましに想念に苦しむ時間が長くなった。",
              "citation": {
                "source": "握った手",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "慾深い人が穴を掘って、よかったタメシはありません。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋愛に一途であって、世の悪評をしりぞけることが出来なかったタメシはない。",
              "citation": {
                "source": "安吾巷談",
                "author": "天光光女史の場合",
                "note": "青空文庫"
              }
            },
            {
              "text": "悠々として成功を説いた歴代の学者に成功したタメシがないのだから、ヤケクソの方に名論が多い。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワシを軽々と抱えて降りたバカ力はたいしたものだが、力持ちに利口がいたタメシはないものだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな門構えの邸宅に「アンマもみ療治」の看板が出ているタメシはない。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "「以前にもこんなことがあったタメシはありませんか」「一度もない」「矢の数は算えることがありますか」「一年かかって三十本の神の矢ができるようになっている。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチには三十年間お金もお米もあったタメシがありませんや。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十八　踊る時計",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちもお食事とお茶をいっぺんハナレへ運ぶだけで、トンビの来る姿も帰る姿も毎年見たタメシがないよ」「オレのタケノコを変テコな奴が食ってやがるんだなア。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二十　トンビ男",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコを食ってから、なにか変テコな、変ったことが起りやしねえか」「はばかりながら、このお邸に変テコなことなんぞ起ったタメシはないやね。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二十　トンビ男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくせ夜明けちかく書斎からでてくると必ず肉体を要求することだけは忘れたタメシがないのだそうで、これでは全くケダモノの生活だと小夜子サンは思いつめました。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真屋来るというので、顔を洗い、ヒゲをそり、着物をきかえたタメシがないのである。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その八　安吾愛妻物語",
                "note": "青空文庫"
              }
            },
            {
              "text": "将棋の連中、医者のクラブ、弁護士クラブ、木谷会などというのに連敗して、一度も勝ったタメシがない。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私もタメシにケロリンをのんでみたいと思ったが、薬屋へ行って「ケロリン下さい」と云ってみる勇気がなかったのである。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第二回　富山の薬と越後の毒消し≪富山県・新潟県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "タメシにのんでみたいと思ったが、薬屋へ行って、まさかケロリン下さいとも云えないじゃないか」　すると女房が言下に答えた。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第二回　富山の薬と越後の毒消し≪富山県・新潟県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆえに昔よりそれで物を染めたタメシが無い。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
