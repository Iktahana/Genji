    "definitions": [
      {
        "index": 1,
        "gloss": "treading water",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "レスキュー隊員は水面から顔を出し、立ち泳ぎをしながら周囲の状況を確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "水球の選手は、激しい試合中も常に力強い立ち泳ぎで体を支えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "足の届かない深いプールで、必死に立ち泳ぎをして助けを待つ練習をする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "平泳ぎ、背泳ぎ、両抜手、片抜手、競泳、立ち泳ぎ――等を悉く試みた。",
              "citation": {
                "source": "「或る日の運動」の続き",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ふりかえると、三メートルほどむこうで、高志がニヤニヤしながら、立ち泳ぎをしていた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "大原と肩をならべる水練の達者は、三上治太郎、福井文吾の二人で、去年の夏の水練御上覧の節には、大原は隅田川のまん中で立ち泳ぎをしながら短冊に歌をかいた。",
              "citation": {
                "source": "鐘ヶ淵",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "三上はおなじく立ち泳ぎをしながら西瓜と真桑瓜の皮をむいた。",
              "citation": {
                "source": "鐘ヶ淵",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは立ち泳ぎをしながら、のみこんだ水をはきだすと、頭をめぐらして方角を見さだめた。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "身がまえたといっても、風呂の中で立ち泳ぎをしているときのように、おかしいほど、お尻がふわりと浮きあがる気持だった。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっとのことで追いついたとき女は立ち泳ぎをしながら笑っていた。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ふたりは手をつないだまま、まっくらなつめたい水の中で、立ち泳ぎをはじめました。",
              "citation": {
                "source": "大金塊",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "胴のない生首は、胴をかくして立ち泳ぎをしている人間のように、グルリとまわって、足軽のほうへ顔を向けた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一生懸命に……一生懸命に……、そして立泳ぎのようになって足を砂につけて見ようとしたら、またずぶりと頭まで潜ってしまいました。",
              "citation": {
                "source": "溺れかけた兄妹",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "水が窓から流れ出るまで、小一郎は垢離部屋で立泳ぎをしていた。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、眼下の湖水の中に、老人が一人立泳ぎをしていた。",
              "citation": {
                "source": "鵞湖仙人",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "水府流にしても小堀流にしても、一伝流にしても大和流にしても、立泳ぎといえば大方は、乳から上を出すものである。",
              "citation": {
                "source": "鵞湖仙人",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……で、湖畔で貴殿に会いその人物を験めそうものと、例の立泳ぎお目にかけました。",
              "citation": {
                "source": "鵞湖仙人",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（なるほど、海水だな）　平泳ぎから立泳ぎになったり、また平泳ぎにかえったり、僕は二十分間ぐらい泳いだ。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦しい立泳ぎが、一層苦しくなる。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたし生れ香港、五つの時から泳ぎおぼえた」　石少年は、立泳ぎをしながら、こんなのんきな返事をした。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これには、の組仕事師中の泳ぎの名人の思付きで、六間ばかりの油紙で張った蛇体の中に火を燈し、蛇身の所々に棒が付いてあるのを持って立泳ぎをやる。",
              "citation": {
                "source": "江戸か東京か",
                "author": "淡島寒月",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラ下げた長い長い二本の縄の脚を軟らかに空中に波うたして、紙鳶は心長閑に虚空の海に立泳ぎをして居る。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵の通せんぼうをかい潜りかい潜り、立泳ぎ、蛙泳ぎ、抜き手、片抜手、美しき筋肉運動の限りを尽して、美少年のお尻へと追い縋る。",
              "citation": {
                "source": "地獄風景",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きられる丈け生きるんだ」　そして、遂に私達は水に身体を浮かして、軽く立泳ぎをしながら呼吸を続けねばならなかった。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　旗男少年は、得意の立泳をつづけながら、夕日に向かって挙手の礼をささげた。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
