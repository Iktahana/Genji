        "examples": {
          "standard": [
            {
              "text": "「二直線が交わるとき対頂角は等しい」と先生が黒板に図を描きながら説明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "幾何の問題で対頂角の性質を使うと、未知の角度が一発で求まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "対頂角の定理を初めて自分で証明できたとき、数学の面白さに目覚めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "大きな実験台が、入口と対頂角をなしたところにすえてあり、電気の器具がならび、その向う側には薬品の小戸棚を越えてレトルトや試験管台や硝子製の蛇管などが頭をだしていた。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
