        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「これはタルミミ隊の者です。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これから、このタルミミ隊が皆さんのお世話をします。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、このタルミミ隊は、じゅうぶん皆さんの気にいるようにお世話をすると思います。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "中尉は愛弟をうしろにかばって、新米のタルミミ隊をにらみつけていた。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "タルミミ隊は、山岸中尉の前で活動をはじめた。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、どうぞ召上ってください」　と、タルミミ君らしい一人が、そういって挨拶をした。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "安心して召上ってください」　タルミミ君は、ていねいにいった。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この蜜柑は、どこになったのかね」　山岸中尉がタルミミ君へ声をかけた。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "山岸兄弟が食事をしているのを見て安心したものか、タルミミ隊員は、いつとはなしに二人の前から姿を消してしまった。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
