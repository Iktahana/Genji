[
  {
    "uuid": "5aaf02c5-d908-5c08-bb47-4416293b5335",
    "entry": "他愛ない",
    "reading": {
      "primary": "たわいない",
      "alternatives": [
        "たあいない"
      ],
      "is_heteronym": true
    },
    "grammar": {
      "pos": [
        "形容詞"
      ],
