        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "答　私ガ道子ヲ殺ス気ニナッタノハ、今マデ私ニ親切デアッタノニ心変リヲシテカラ全ク私ニ冷淡ニナリ、友田ヲ愛スルヨウニナッタカラデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "所ガ私ガアレダケホントウノ事ヲ告白シタノニ不拘清三ハ全ク耳ニモ入レマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……中に、ステパンの会話の力で判断してだろう、片仮名で、「オナツカシキペテロフサマ、ソノゴオカワリモアリマセンカ、ユウベ、マテイタノニキテクダサイマセン、ナゼデスカ、シドイシト、ワタシノココロモシラナイデ。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ仕立屋デ、毎日、コヽデ着物ヲヌツテヰマシタノニ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "入梅中デ雨モ降ッテイタノニ、昨夜ハナカ／＼暑カッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「折角ソコマデ習ッタノニナゼ止メタンダネ」「ダッテ、トテモ足ガ変形シチャッテ醜クヽナルノヨ」「ソレデ止メタノカネ」「アタシ、足ガアンナニナルノハイヤダワ」「ドンナニナルノサ」「ドンナニナルッテ、ソリャヒドイノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツマリ彼等ハ、午後二時半カラ四時半マデハ予ガ治療ヲ受ケテイテ寝室カラ出ル筈ガナイト、考エタノニ違イナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレマデノ間ニソット二階カラ下リテ消エテナクナレバイヽ筈デアッタノニ、彼等ノ方ニモ計算違イガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今朝ホド測リマシタ時ハ上ガ一四五、下ガ八三デ、至極順調デゴザイマシタノニ、ドウシテ急ニコンナニ上ッタンデゴザイマショウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪ノ形ガソンナニ委シク見エタノニ顔ハドウモハッキリ見エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "体ガ丈夫デサエアレバコンナ秋日和ノ日ハドンナニ爽快デアロウ、予モ四五年前マデハソノ爽快味ヲ満喫シテイタノニト思ウト、クヤシクモ忌マ／＼シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ髯ヲ剃ッタノニ心ヅイテ、早クモ何カヲ察シタノカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ彼女ヲソウサセタノニハ予ニモ責任ガナイコトハナイガ、浄吉ノ奴ハ亭主ノ癖ニ最初カラ彼女ニ一目置クヨウナ素振ヲ見セテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ハアンナノハ大嫌イダ」「マア、ソンナコトヲ仰ッシャッテ」「子供ハ病室ヘ寄越スナッテ云ットイタノニ、勝手ニ這入ッテキヤガッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思イモ寄ラヌ秘密ヲ不意ニ彼女ニ発カレタヽメカ、自分デモ疾ウカラ内々ハ気ヅイテイテ、強イテ気ヅカヌ振リヲシテイタノニ、コノ古狸ニ突如素ッ破抜カレタヽメカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五子ノ奴ガ電話デ萬事云イ附ケテ置イタノニ違イナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日、七日ノ晩ニ僕ハスデニ木村ニ対シ淡イ嫉妬（淡クモナカッタカモ知レナイ）ヲ感ジツツアッタノニ、―――イヤソウデハナイ、ソレハ去年ノ暮アタリカラダッタ、―――ソノ半面、僕ハソノ嫉妬ヲ密カニ享楽シツツアッタ、ト云エナイダロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノ間ハ運ヨクスグニ掴マッタノニ今日ハナカナカ掴マラナイノヨ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間モウロウロシテ来タノニ違イアルマイ）来タノデアルガ起リ得タカヲ、努メテ考エナイヨウニシタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時刻カラ考エテ、妻ハ帰宅ノ途中デアッタラシイノデアルガ、西向キニ歩イテイルノハ、恐ラク僕ヨリ先ニ僕ヲ見付ケテ自分ノ方カラ避ケタノニ違イナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トイッテ、僕ハ全然ソウイウヲ考エナイヨウニシテイタノニ、イキナリハッキリト聞カサレタノデギクリトシタ、トイウノガ偽ラザル気持カモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭ニ浮カブノハ妻ト寝ルハナカッタノニ、終日何モ読マズニイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "和服ダトアレガエキゾチックニ感ジラレタノニ、洋服ダト取ッテ付ケタヨウデ、シックリシナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ好イ加減キマリガツイタ時分ダト思ッテイタノニ、先達淡路カラ絵端書ヲ貰ッテマダソンナコトカト驚イタ次第デス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲ナオリノ式ハ、無事ニ終ツタノニ、女ノ事デ、オタクノ金五郎サント、友田喜造親分ト、ソシテ、ワタシタチノ間ニ、悪イイキサツガ出来テシマツタノデス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ少シ、病院ニ居レバ良カッタノニ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハルガキタハルガキタドコニキタヤマニキタサトニキタノニモキタ　子供が歌っている。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
