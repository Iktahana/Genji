          "literary": [
            {
              "text": "それほどになるのも考えものであるとも思うが、しかしたとえ楽しみ事にしろやっぱりそこまで行かなければつまらないとも思う。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "講の連中はたいていひと年入れた者か、隠居役の爺さん媼さんの楽しみ事であるのであったが、かやは重吉をむりにすすめて自分は行かなかった。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さむらいの御奉公とは、あしたに死に、ゆうべに死し、まい日が覚悟のお勤めとこそ母もうけたまわれ、わたくしの楽しみ事など思うは、まだまだ早き慾とこそ、もったいのうぞんぜられ候。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "祝い事、楽しみ事の最中にも、常に我々の境遇を想い出させるあの繰返しを歌おうではないか。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
