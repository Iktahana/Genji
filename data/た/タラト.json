          "literary": [
            {
              "text": "タローサンハ　モシモ　トチウデ、コマルコトガデキ、タラト、バスケツトノナカヘ　デンシヨバトヲイレテキマシタノデ、テガミヲツケテ、ハナシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ノ意見デ、整形外科ノ方ヘ行ッテ見テ貰ッタラト云ウノデ、先日虎ノ門病院デレントゲンヲ撮ッタノデアルガ、頸椎ノ辺ニ曇リガアルシ、手ノ痛ミガソンナニ激シイノナラ、事ニ依ルト癌カモ知レナイト嚇カサレテ、頸椎ノ断層写真迄モ撮ラセタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サン曰ク、田園調布ノ鈴木サンニ鍼ヲシテオ貰イニナッタラドウ、鍼デ直ルカモ知レナイカラ頼ンデ見タラト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ハ頻リニコノ天候ヲ気ヅカッテ、モウ一日オ延バシニナッタラト云ッタガ、予モ颯子モ承知シナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ノ意見デ東大梶浦内科ノ梶浦博士ニ来診ヲ乞ウタラト云ウコトニナリ、本日午後博士来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
