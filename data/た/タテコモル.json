        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "テロリストが銀行に「立てこもっ」ているというニュース速報が入った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "デモ隊が議事堂に「立てこもり」、政府に抗議の声を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "避難民は、安全な場所を求めて、一時的に施設に「立てこもっ」た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
