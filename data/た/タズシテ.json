          "literary": [
            {
              "text": "（二）右ノ報告ヲ本日午後十時マデニ報告シ得ザルトキハ、在京同志ハ悉ク明朝ヲ待タズシテ鏖殺セラルルコトヲ銘記セヨ。",
              "citation": {
                "source": "間諜座事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "是レ余輩ノ弁論ヲ俟タズシテ明了ナルベシ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "結句原文、「名者不立之而」は旧訓ナハ・タタズシテであったのを、古義でナハ・タテズシテと訓んだ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
