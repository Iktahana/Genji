        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昨晩はたんと飲みすぎてしまい、二日酔いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供は誕生日プレゼントをたんと貰って大喜びしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "たんと稼いで、いつか世界一周旅行に行きたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
