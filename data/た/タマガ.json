        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「ア、カアチヤン、ハツパノ　サキニ　タマガ　ヒカツテル」「ソレハ　アサツユツテ　モノ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……イヤラッサナア……マアホンニ……タマガッタガ……トッケムナカア……ゾウタンノゴト……イヒヒヒヒヒ……」　……そのあとから追いかけるように、私の腹の中でグーグーと胃袋が、よろこびまわる音……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "『コノ、ニッポンノ紳士ハ、スコシ、アタマガ変デワナイノデショウカ、変ナコトバカリ云イマス』と。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎年旧暦八月八日より十五日までの間に、タマガリを見ると称して幽霊火を見に出かける。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ「ソラ、タマガトンダヨ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中にはシビトバナ、ジゴクバナ、キツネバナ、キツネノタイマツ、キツネノシリヌグイ、ステゴグサ、シタマガリ、シタコジケ、テクサリバナ、ユウレイバナ、ハヌケグサ、ヤクビョウバナなどのいやな名もあるが、またハミズハナミズ、ノダイマツ、カエンソウなどの雅びな名もある。",
              "citation": {
                "source": "植物知識",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
