        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――これがメーテルリンクによつて取り扱はれた、詩劇タンタジールの死の主題であつた。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしあのろうそくの炎の不定なゆらぎはあらゆるものの陰影に生きた脈動を与えるので、このグロテスクな影人形の舞踊にはいっそう幻想的な雰囲気が付きまとっていて、幼いわれわれのファンタジーを一種不思議な世界へ誘うのであった。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵巻物では、一つの場面から次の場面への推移は観覧者の頭脳の中で各自のファンタジーにしたがって進転して行く。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、子供の時に唱歌をやったと同じように、時々ピアノの鍵盤の前に坐って即興的のファンタジーをやるのが人知れぬ楽しみの一つだそうである。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（おまへがこゝへ来ないのは　　　タンタジールの扉のためか、　　　それは私とおまへを嘲笑するだらう。",
              "citation": {
                "source": "『春と修羅』補遺",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "殿堂の建設には設計者のファンタジーが必要である。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "重兵衛さんは自分の心にファンタジーの翼を授け、自分の現実世界の可能性の牢獄を爆破してくれた人であった。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「絵本西遊記」を読んだのもそのころであったが、これはファンタジーの世界と超自然の力への憧憬を挑発するものであった。",
              "citation": {
                "source": "読書の今昔",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "魔物に、その可憐な弟を奪われて、鉄の扉の前で、狂乱するタンタジールの姉のように、命掛の声を振搾った。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "『侵入者』も好いが、それよりも『内部』や『タンタジールの死』の方が私は好きである。",
              "citation": {
                "source": "社会と自己",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "『タンタジールの死』もさうである。",
              "citation": {
                "source": "社会と自己",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな虚構、どんな作為のファンタジーにしても、それが文学として実在し、読者の心に実在感をもってうけいれられるためには、力をつくして、そのファンタジーや、ディフォーメーションにそのものとしての現実性を与えることに努力しているのである。",
              "citation": {
                "source": "新しい文学の誕生",
                "author": "――若い人に贈る――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「多年積念炉頭雪、一日憂懐風裡糸」とつぶやいて、彼はそれらの文字が持つファンタジーにうっとりした。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "やぶれた敗者の魂には、人知れず、昔のファンタジーを呼びとめる何かがあるやうに、そのファンタジーは、時々は、誰にも反省をうながすものであらう。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは円い塔で、変な螺線的な階段がついて、すべて立体的に、色々な構造をあらゆる近代的科学の力を出来るだけ応用して――という条件なのですが、彼のドランクン・ファンタジーなのですから、来る度にいつもその内容が色々と変化するようです。",
              "citation": {
                "source": "書斎",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファンタジーとレアリテートの間に私は主観的ならぬ区別はないかと思います。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう程度の詩集になると、シャガールのファンタジーによる插画なんか不用になって来るところは、一層興味あるところですね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ考証ぬきの素人がかくことだからせめて文章そのものから白と黒との幻想に描きだされる鷺娘のファンタジーを読者につたえようと努力した。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どんなに力こぶを入れて見たって、鷺娘には昔の日本のシムボリズムとファンタジーがあるきりなんですもの……しかもああいう踊りの幻想は、古風なつらあかりの灯の下でだけ生きていたんだわ」「――桑原、桑原」　中館公一郎がふざけて濃い眉をつりあげながら首をちぢめた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――何色だったか……あれは大人のおとぎばなしですよ、菓子の中から革命が擡頭したりするファンタジーは、少し困りますよ。",
              "citation": {
                "source": "子供・子供・子供のモスクワ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際吾々は表象をアナロジーやユーモアやファンタジーやサジェッションに結びつけていつも文学的にもちいることしか他に道を有たない、そうしなければ実際的の文章にも思想にもならないからだ。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る時期のシェリングはその哲学によって、現実を消去して自由なファンタジーの世界を導き入れたが、この自由なファンタジーの代りに過去の歴史を導き入れるものが、シュライエルマッハーの解釈学の動機だと云ってもいいだろう。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "して見ると、文学的表象と雖も無下に空想的なものではなかったので、その根柢にはいつも何かしら核心があって、その核心の周りを文学的ファンタジーが羽搏いていたに過ぎない。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　科学的理論にとって、ファンタジーが如何に大事な役目を持っているかは、少し考えて見れば判ることだ。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "科学的独創や科学的新着眼は、いつも文学的な一種のファンタジーや示唆によって導かれる。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二、連想力＝構想力＝ファンタジー。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも童話の世界では、それらの機械や武器やが、驚くべきフアンタジイの空想力で、荒唐無稽にまで夢幻化されてゐるのである。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての驚くべき科學的大發明は、最も子供らしき夢の熱意と、最も荒唐無稽なフアンタジイから誕生した。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故に獨逸、佛蘭西等の如く、世界で最も科學の發達してゐる國の子供は、最もよくフアンタジイのお伽話を好む子供であり、したがつてまた秀れた童話作家を、多分に所有してゐる國なのである。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし果して今の子供が、さうした眞の童話精神を喪失し、フアンタジイの夢を持たなくなつてしまつたことから、却つてその種の物への冷笑的態度を示すならば、正に大いに憂ふべき教育上の問題である。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
