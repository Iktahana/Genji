        "examples": {
          "standard": [
            {
              "text": "職人が高価な反物にハサミを裁ち掛けた瞬間、工房に独特の緊張感が走った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "型紙を合わせて布を裁ち掛けたところで、寸法の間違いに気づいてヒヤリとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "一思いに裁ち掛ける勇気が持てず、何度も印を付け直して確認を繰り返す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "これから、一っぱしり藁店へ出かけて行って、お民さんに談じこんでやりましょうよ」　たちかけるのである。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "びっくりして、劉備がたちかけると、廟の扉を蹴って、突然、豹のように躍りだしてきた男があって、「こら、待て」　劉備の襟首を抑えた。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
