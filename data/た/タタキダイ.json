        "examples": {
          "standard": [
            {
              "text": "とりあえず私が作成した案をたたき台にして、みんなで意見を出し合おう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "会議を円滑に進めるために、部長が議論のたたき台となる資料を用意した。",
