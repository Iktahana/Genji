    "definitions": [
      {
        "index": 1,
        "gloss": "Labracoglossa argentiventris (species of knifefish)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "東南アジアの河川に鰖が生息している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "鰖は小型の肉食魚として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "熱帯魚の愛好家は鰖を珍しい種として珍重している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "併し語どほりに解すると、かねは、おもろ・おたかべの類に、穀物の堅実を祝福する常套語で、又かねの実ともいふ。",
              "citation": {
                "source": "琉球の宗教",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "おもろ・おたかべ・みせゝりなどいふ種類、或はまたその系統のものが、まだ地方に残つて居る。",
              "citation": {
                "source": "熟語構成法から観察した語根論の断簡",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か、偶然な誤解が、沖縄の祝詞なるおもろ・おたかべの辞句理会の上に加つて、日本の祝詞語と結びついたものではないか。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と庄屋の長左衛門が、駕籠の見えなくなった時、太郎右衛門に言いますと、太郎右衛門は眼に涙を一杯｜溜て、「何が目出たかべい……庄屋様、後生だわで、殿様がいやになったらいつでも遠慮なく家さ戻って来るように言ってやってくれべい！",
              "citation": {
                "source": "三人の百姓",
                "author": "秋田雨雀",
                "note": "青空文庫"
              }
            },
            {
              "text": "もよりのゴンドラの発着所で、のりものにのると、かれは運河のうすぐらい迷路を、獅子の像が側面についている、きれいな大理石の露台をくぐりぬけ、ぬるぬるしたかべのかどをまがり、ゆらぐ水面に大きな看板を斜めにうつしている、悲しげな高楼の正面を通りすぎて、サン・マルコまでつれて行ってもらった。",
              "citation": {
                "source": "ヴェニスに死す",
                "author": "DER TOD IN VENEDIG",
                "note": "青空文庫"
              }
            },
            {
              "text": "四かくな切れ目から、すこしはなれたかべの上の方に、コンクリートが小さくふくらんだところがあります。",
              "citation": {
                "source": "赤いカブトムシ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "島田君は右がわ、木下君は左がわの、こわれたかべぎわに、身をふせ、からだをかくして、れんがのこわれたあいだから、目だけをだして、建物の奥をのぞきました。",
              "citation": {
                "source": "透明怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "八角形になったかべが、ぜんぶ鏡ではりつめられ、天井も鏡の板、ゆかもあついガラスの鏡、その小部屋は、どこにも鏡でないところはないのです。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあいだに、明智探偵は、怪人が背中をつけたかべを、しらべていましたが、「これだ。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "開いたかべの中から、まぶしいような白い光がさしてきました。",
              "citation": {
                "source": "電人Ｍ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
