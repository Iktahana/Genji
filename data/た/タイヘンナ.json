        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アル　ヒ　ソノ　デンデンムシハ　タイヘンナ　コトニ　キガ　ツキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、トウトウ、タイヘンナ　コトガ　オコリマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、タイヘンナ　コトニ、コゾウサンガ　ピント　ヒゲヲ　ハヤシテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノ　カゲカラ　コノ　ヤウスヲ　ウカガツテ　ヰタ　オカアサンダヌキハ　タイヘンナ　コトニ　ナツタト、メヲ　マンマルクシテ　オドロキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ぎに「チクマアニノワタシタモノ……モシツカヘバ」……と、そこでしばらく考へてから、やつと「タイヘンナコトニナル」……。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウウ、ウウ、タイヘンナ　コトニ　ナツチヤツタア。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイタリ、タタイタリ、コスツタリ、ナカハ　タイヘンナサワギデス。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムクン、イマサラタイヘンナコトヲシタトオモッテモ、モウ　マニアヒマセン。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
