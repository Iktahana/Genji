          "literary": [
            {
              "text": "金五百円ハヤガテ君ガモノタルベシトゾ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義的議論ノ多クガ大地主ノ土地兼併ヲ移シテ國家其者ヲ一大地主トナシ以テ國民ハ國家所有ノ土地ヲ借耕スル平等ノ小作人タルベシト云フハ原理トシテハ非難ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ガ妻タリ母タル勞働ノミトナラバ、夫タル勞働者ノ品性ヲ向上セシメ、次代ノ國民タル子女ヲ益々優秀ナラシメ、各家庭ノ集合タル國家ハ百花爛漫春光駘蕩タルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ハ日本ノ一部タルコト北海道ト等シク正ニ「西海道」タルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ日本ハ北ニ大ナル圓ヲ畫キテ支那ヲ保全シ、支那亦日本ノ前營タルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "庇護行為ノ者ハ同罪タルベシ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ人必ズ七日ノ後、マサニ是ノ如キ快楽ト眷族ヲステ、決定必ズ死ニイタルベシ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
