        "examples": {
          "standard": [
            {
              "text": "溶鉱炉の底部には耐火煉瓦を敷き詰める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "耐火煉瓦の品質が炉の寿命と安全性を決める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その耐火煉瓦は日本の有名メーカーから輸入された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "一見それは耐火煉瓦なぞで築きあげ、行き止まりらしく見える。",
              "citation": {
                "source": "火葬国風景",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "長く処を得なかった胸像もよく掃除せられ、黒｜花崗と耐火煉瓦とを四角に積重ねた美しい台の上に据えられて、晴上った日に照らされ、つぎつぎと花を捧げる小さな曾孫たちを笑顔で見下されているようです。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランドリュは二人をあの世へ送りこむことにきめ、納屋をつくるのだといって、ヌイイの家から耐火煉瓦や砂を運んできた。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "台所の石床に厚く砂を敷き、その上に耐火煉瓦を積んで火爐をつくり、煙突を立てて、その煙突を料理用のストーヴの煙突に接続させた。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の進歩した耐火煉瓦に劣らぬほどの煉瓦を、当時、独創的に作り出したものであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "如法闇夜の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
