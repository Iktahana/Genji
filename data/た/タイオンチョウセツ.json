          "standard": [
            {
              "text": "夏の暑い日は、体の体温調節機能が重要になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "赤ちゃんはまだ体温調節が未熟なので、周囲の温度管理が大切だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "運動中は、発汗によって体温調節が行われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そうやって患者の身体に助太刀しているうち患者の身体自身に備わっている体温調節の機能が盛り返して来て、病気を弾ね除けてしまいます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
