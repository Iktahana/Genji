[
  {
    "uuid": "8b0e889c-c254-5b96-8d96-43b4d834510f",
    "entry": "度々",
    "reading": {
      "primary": "たびたび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "often",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「度々お電話して申し訳ありませんが、例の件はどうなりましたか？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この地域では夏になると、度々局地的な大雨に見舞われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "若い頃は度々海外へ一人旅に出かけていたが、最近は家で過ごすことが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "だつて君そこに浮気があります浮気は悲しい音楽をヒヨツと忘れさせること度々です空　空　空やつぱり壁は土で造つたものでした。",
              "citation": {
                "source": "不可入性",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "）住居は度々変ったが、純日本風の家を好んで、少しでも洋風を加味したものを嫌った。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "度々のことで面倒だから、今度から止めにして、先へ勝手に寝ることにしろと何度も言うが、妻は婦道に背くと言い、なかなか承知しないので困っている云々（大意）と。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃のヘルンは、瞬時を惜しんで仕事に熱中していたため、以前のようには、度々妻と一所に旅行したり、散歩したりすることができなかった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで妻の屈託を慰めようとし、夫人に向って度々外出や遊山をすすめた。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、芥川君も度々言つた。",
              "citation": {
                "source": "芥川君との交際について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はまぶしさうに電燈の方に度々眼を向けた。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は維新前いわゆる御鯨方の支配の下に行われた捕鯨の壮観と、大漁後のバッカスの饗宴とを度々目撃し体験していたので、出発前にその話を飽きるほど聞かされていた。",
              "citation": {
                "source": "初旅",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "千駄木町の夏目先生の御宅の文章会で度々｜一処になった。",
              "citation": {
                "source": "高浜さんと私",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "温泉場へ來たからには義理にも度々温泉に浴しなければならないといふ譯もないが、すこしすまなかつたやうな氣がする。",
              "citation": {
                "source": "伊香保",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなに度々繰返される自然現象ならば、当該地方の住民は、とうの昔に何かしら相当な対策を考えてこれに備え、災害を未然に防ぐことが出来ていてもよさそうに思われる。",
              "citation": {
                "source": "津浪と人間",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、公園にはいる前、街路で逢う人が度々振り返った理由をごくぼんやりと認識したが、それらが、彼に何であるのか、彼は、しゃにむに歩けば宜いのだ。",
              "citation": {
                "source": "伯林の落葉",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "度々来ているうち、その事もなげな様子と、それから人の気先を撥ね返す颯爽とした若い気分が、いつの間にか老妓の手頃な言葉｜仇となった。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚後も主人は度々東海道へ出向いた中に私も二度ほど連れて行って貰った。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もそれは間もなく日光にあたってぼろぼろに裂け、度々の出水に次から次と削られて行きましたが、新らしいものもまた出て来ました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛が度々立ち止まるので、達二は少し苛々しました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一、薊があんまり沢山ありましたし、それに草の底にさっき無かった岩かけが、度々ころがっていました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "疲れはしないかと三人から度々聞かれた。",
              "citation": {
                "source": "ゴルフ随行記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへきて民子が明けてもくれてもくよくよして、人の眼にもとまるほどであるから、時々は物忘れをしたり、呼んでも返辞が遅かったりして、母の疳癪にさわったことも度々あった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな意味からも度々いゝ講演の出來る樣になり度いと思ふ。",
              "citation": {
                "source": "講演會　其他（大正十五年二月號）",
                "author": "『青空』記事",
                "note": "青空文庫"
              }
            },
            {
              "text": "）あの人は度々お前の処へ来ますの。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だから、三度々々ちゃんとご飯喰べてお呉れと云うに、さ、ほんとに後生だから」　母親はおろおろの声である。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロダンさんはコート・ダジュールの華美なノアイユ旅館から、度々妾のお芝居を見にいらっしゃったのだそうです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "――氣の毒だな‥‥と、思ふことが私も度々あつた。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京や横濱、神戸、大阪などで、私は度々支那料理を食つてみた。",
              "citation": {
                "source": "阿片の味",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういふ風に書くものやら全然不案内であつたがチヨークで書いた畫を見たことは度々あり、たゞこれまで自分で書かないのは到底未だ自分どもの力に及ばぬものとあきらめて居たからなので、志村があの位ゐ書けるなら自分も幾干か出來るだらうと思つたのである。",
              "citation": {
                "source": "畫の悲み",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういう風に書くものやら全然不案内であったがチョークで書いた画を見たことは度々あり、ただこれまで自分で書かないのは到底まだ自分どもの力に及ばぬものとあきらめていたからなので、志村があの位い書けるなら自分も幾干か出来るだろうと思ったのである。",
              "citation": {
                "source": "画の悲み",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車や汽車が度々すぐうしろを通った。",
              "citation": {
                "source": "断片（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしあまり度々こんな悪戯をやると警官に怪しまれるであろうが一度だけは大丈夫成功するであろうと思われる。",
              "citation": {
                "source": "異質触媒作用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯、念のために申して置きますが、あの坊主は惡い奴で……延命院の二の舞で、これまでにも惡い噂が度々あつたんですよ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
