        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "モシ、君ガ充分ノ親切心ト忍耐力トヲ保有シテイルナラバ、君ノ今日ノ用事ヲコノ紙片ニ書キシタタメテ欲シイ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラタメテ占フニハ及ビマセン。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　五ニンノ　サムライハ　サルヲ　キラナクテ　ヨカツタ　コトヲ、メニ　ナミダヲ　タメテ　ヨロコビマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、どんな孤高の人が、輸送船の中へカタメテつみこまれなかったろうか。",
              "citation": {
                "source": "五〇年代の文学とそこにある問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャングルの中にカタメテすてられた部隊から、一人はなれた人の飢餓と苦悩の運命の終焉が、カタマって餓死した人々の運命とその本質においてどうちがったろう？",
              "citation": {
                "source": "五〇年代の文学とそこにある問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
