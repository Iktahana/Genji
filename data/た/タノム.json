  {
    "uuid": "dc362840-365e-5ad3-85ed-17b40d67af9f",
    "entry": "タノム",
    "reading": {
      "primary": "たのむ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「アスアサゴジヒキコシテツダヒタノム」といふのだ。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、二度も罹災して、行くところが無くなり、ヨロシクタノムと電報を発し、のこのこ生家に乗り込んだ。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "名刺もつくらせ、それからホテルの海野先生へ、ゲンコウタノムの電報、速達、電話、すべて私自身で発して居りました。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、二度も罹災して二人の幼児をかかえ、もうどこにも行くところが無くなったので、まあ、当ってくだけろという気持で、ヨロシクタノムという電報を発し、七月の末に甲府を立った。",
              "citation": {
                "source": "庭",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "○オクツタ」ユイノウタノム」ケツコンシキノシタクセヨ」アスペキンタツ」オオスミチユウタロウ　同時に電報｜為替で百円送られて来たのである。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "船司は、ハナシツイタ、ソウキンタノムと大阪の児子家へ電報打った。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トリ、入院、カネタノム、モリオカ○○○病院、タムラ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と、思う胸騒ぎを、じっと抑えて、読み下すと、アスマデニ三〇〇エンツゴウシテクレ、イノチガケニテタノム、アネ　と、いう電文だった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　八代龍太へ――「ヘンジデンニテタノム」（一九三三、十、十九、相州夜見村にて）",
              "citation": {
                "source": "水車小屋の日誌",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "文面はたしか『一○ジ二一フンイイダマチツクエキマデムカイタノムキミ』となっているんです。",
              "citation": {
                "source": "山吹町の殺人",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "（七月×日）――ビョウキスグカエレタノム　母よりの電報。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月×日　――ビヤウキスグカヘレタノム　母よりの電報。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、そこに書き綴られた文章は――「レイノジケンニツキ、シキユウ、セキガイセンシヤシンサツエイタノム。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "警察手配タノム、午後二時探偵帆村」「なんや、ハエオトコて、どう書くんや」「ハエは夏になると出る蚊や蠅の蠅だ。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "『計画ハ、クイチガッタ、我等ハココニアリ、至急スクイ出シ、タノム』と、信号したくはないのかね。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カタキヲタノム」　この悲壮な遺書を、鉄丸の破片とともに空缶の中に入れ、海中に投げこんだ、そのあわれな遭難漁夫三浦スミ吉が、今ここでクイクイの神となりすまし、ミンミン島とロップ島の原地人の前に、とりすました顔で立っているのだ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ケッコウシマス、テツヅキヨロシクタノム。",
              "citation": {
                "source": "宇宙爆撃",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ケッコンシマス、テツヅキヨロシクタノム――。",
              "citation": {
                "source": "宇宙爆撃",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アス九ジタツムカエタノムサキエ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月四日（水）立春　○江井芳三、病気キトク、紀さんに見マイ 1,000 タノム　○仕事八枚半（一〇二枚）　百舌鳥のような鳥の声もした、きょうは初めてやぶ鶯の声がした、いつもの竹やぶで。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒラタユクタノム」という電報が不意に私の所へ舞い込んできました。",
              "citation": {
                "source": "香奠",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（十三日）　学校へ「トシニゲタ、ホゴタノム」という電報がきたのは十日だと思う。",
              "citation": {
                "source": "出奔",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チクマアニカラウケトツタモノスグヘンソウタノムチクサ」と、まづ書いてみて、それを消した。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "二〇ヒアサタツタ」ヒロシサンノユクサキワカツタラソチラシラベタノム　弘の行先は無論わからなかつたが、これでみると、梨枝子は三日も前に発つてゐるし、弘も房州海岸へ出掛けて行つて、一足先に発つたのだといふことが想像された。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "二四ヒスマヌ　アスアサデ　ンタノム。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧暦｜八朔のタノムの節供のごときも、今は晩稲のまだ穂を出さぬものが多くなって、単に田を誉めまたは田の神さん頼みますなどと、わめいて巡るだけの村もあるようだが、もとは若稲のまだよく固まらぬ穂を摘んで、これを火で炒って扁米というのをこしらえ、神と祖霊に供え、家の者も相伴した。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "三益愛子よりＯ・Ｋの電報来る、「ミマスヲタノムナカノ」と中野英治からも電報、その旨川口に言ふと、「あれは要りません」といふ返事、それじゃこっちの立場がない、大いにフンガイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
