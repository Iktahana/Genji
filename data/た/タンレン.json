[
  {
    "uuid": "e7ae9d87-75ea-5f23-b3f4-08384ca8bc53",
    "entry": "鍛錬",
    "reading": {
      "primary": "たんれん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
