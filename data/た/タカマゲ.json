        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "かつ島田髷としてはほとんど文金高髷に限られた。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "亀姫、振袖、裲襠、文金の高髷、扇子を手にす。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "左に、腰元、木の芽峠の奥山椿、萌黄の紋付、文金の高髷に緋の乙女椿の花を挿す。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "渠はその音の可愛さに、なおしいて響かせつつ、橋の央近く来たれるとき、やにわに左手を抗げてその高髷を攫み、「ええもう重っ苦しい。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "文金の高髷ふっくりした前髪で、白茶地に秋の野を織出した繻珍の丸帯、薄手にしめた帯腰｜柔に、膝を入口に支いて会釈した。",
              "citation": {
                "source": "縁結び",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "高髷を俯向けにして、雪のような頸脚が見えた。",
              "citation": {
                "source": "縁結び",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸は内へ、左右から、あらかじめ待設けた二｜人の腰元の手に開かれた、垣は低く、女どもの高髷は、一対に、地ずれの松の枝より高い。",
              "citation": {
                "source": "伊勢之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　今更｜贔屓分でいうのではありません、――ちょッ、目力（助）編輯め、女の徳だ、などと蔭で皆｜憤懣はしたものの、私たちより、一歩さきに文名を馳せた才媛です、その文金の高髷の時代から……　平打の簪で、筆を取る。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　勝手の戸がかたりとしまると、お夏ははらりと袂を畳へ、高髷を衝と低く座を崩して姿を横に、縋るがごとく摺り寄って、「どうしたの、お前、」　とて、膝につむりを載せないばかり。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その清浄な膚をもって、緋の紋綸子の、長襦袢で、高髷という、その艶麗な姿をもって、行燈にかえに来た雇の女に目まじろがない、その任侠な気をもって、すべてを愛吉に与えてその晩……」「…………」丹平黙然として少時不言。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（四）の二　畔柳元衛の娘｜静緒は館の腰元に通勤せるなれば、今日は特に女客の執持に召れて、高髷、変裏に粧を改め、お傍不去に麁略あらせじと冊くなりけり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十位に見える大丸髷の年増が、其の比流行った縮緬細工の牡丹燈籠を持ち、其の後から文金の高髷に秋草色染の衣服を著、上方風の塗柄の団扇を持った十七八に見える※な女が、緋縮緬の長襦袢の裾をちらちらさせながら来たところであった。",
              "citation": {
                "source": "円朝の牡丹燈籠",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつものようにお米が牡丹燈籠を持っている後に、文金の高髷に秋草色染の振袖を著たお露が、絵の中から抜け出たような美しい姿を見せていた。",
              "citation": {
                "source": "円朝の牡丹燈籠",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中に一軒、勸工場式、むしろ、ハイカラ式といふべき店ありて、唐物の類を賣り、垢ぬけしたる女、流行の二百三高地ならで、ゆひたての舊式の高髷つやゝかに、店頭に新聞を讀む。",
              "citation": {
                "source": "飛鳥山遠足",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "図は文金高髷の現代風のお嬢さんが、長い袖の衣裳で仕舞をしているところを描写したものです。",
              "citation": {
                "source": "謡曲仕舞など",
                "author": "――文展に出品する仕舞図について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると三尺の開口がギイーと開き、内から出て来ました女はお小姓姿、文金の高髷、模様は確と分りませんが、華美な振袖で、大和錦の帯を締め、はこせこと云うものを帯へ挟んで居ります。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "多助は袴羽織でお花は縫模様の振袖と大和錦の帯を締め、髪は文金の高髷にふさ／＼と結いまして、少し白粉も濃く粧けまして、和平夫婦が三々九度の盃を手に取上げる折から、表の方から半合羽を著て、今河岸の船から上って来たという様子で這入ってまいりましたのは、炭の荷主で、飛駒村の吉田八右衞門でございます。",
              "citation": {
                "source": "鹽原多助一代記",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "いったい、どんなようすをしています」「高髷を結って、岡持を下げている」「和蘭陀にも岡持なんかあるんですか」「それもそうだな。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "萩寺の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ち見たところその女客、文金の高髷に銀釵筥迫、どこの姫様かお嬢様かというふうだが、けしからぬのはこのお方、膳の上に代りつきのお銚子を据え、粋な莨入れに細打の金煙管、ポンとはたいて笹色の口紅から煙をスパッとくゆらした。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
