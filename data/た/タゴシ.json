          "literary": [
            {
              "text": "藍色の衣を纏へる僧六人に舁かせたる、華美なる手輿に乘りたるは法皇なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガッシリ手輿が築かれたのである。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「手輿をお組みよ！",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」桔梗様を手輿へ舁きのせた。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やう／＼のこと、國の役人の世話で手輿に乘せられて家に着きました。",
              "citation": {
                "source": "竹取物語",
                "author": "和田萬吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "駕籠（手輿）には、晴れの紅絹やら花紐が掛けてある。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "官兵衛は四名の家臣が支え上げている手輿の上に乗ってやって来た。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "神の御輿とか貴人の手輿とかになると、二本の棒をあわせてその上にのせて舁き、できるだけ土から遠くしようとしており、今でも物によると天井持といって、棒の下に通して舁くことがまれにはある。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
