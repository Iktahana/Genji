[
  {
    "uuid": "051de9ef-c234-5910-a621-f801c40a34d9",
    "entry": "楯突く",
    "reading": {
      "primary": "たてつく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-カ行",
        "動詞-自動詞"
      ],
      "ctype": "五段-カ行",
      "inflections": null,
