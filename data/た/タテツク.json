    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to defy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「平社員の分際で、私の方針に楯突くつもりか！」と部長の怒鳴り声が会議室に響いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は周囲の反対を押し切り、権力に楯突いてでも自分の信念を貫き通す覚悟を決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "たとえ運命に楯突くことになったとしても、私は愛する人を守るために戦い続けるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それに昇は花で言えば今を春辺と咲誇る桜の身、此方は日蔭の枯尾花、到頭楯突く事が出来ぬ位なら打たせられに行くでも無いと、境界に随れて僻みを起し、一昨日昇に誘引た時既にキッパリ辞ッて行かぬと決心したからは、人が騒ごうが騒ぐまいが隣家の疝気で関繋のない噺、ズット澄していられそうなもののさて居られぬ。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "信長に楯突くの非を悟り、関東の方へ居を移し、広大な山間の地域を領し、女ながらも大豪族として、永く栄えたということである。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なぜこの冬次郎に楯突くか？",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊沢蕃山、山鹿素行、山崎闇斎、大塩中斎、など、凡庸を脱して、徳川の官学に盲従しなかつたのであるが、どれも孔子に楯突くことはしなかつた。",
              "citation": {
                "source": "月を見ながら",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "五「いや、そちらこそ、いつまでこうやって楯突くつもりかな」　源三郎は、にこりともせずに、蹴るような足どりで、歩いて行く。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "楯突くとはなんたることだ。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし楯突くなら、冷酷にそうする。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケルト人に楯突く者は皆、背を向けて逃げていった。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏を同じくする一族の結合を、今日ではマキという地方が多いが、そのマキの内でも、気持のちがうことはまったく無いとは言えないが、その総本家の権能はひじょうに古くからのもので、これに楯突くことは世間からも許さないが、多くの氏々の連合にはそういう中心の力がよわい。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はたてつくようになり、自分の権利を主張し、そしてついにある舞踏会へぜひとも行きたいと言い出す。",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう場合のそういう事件を仮借することなしに裁断する公儀のことばは、上へたてつく不届き者という一語に尽きていましたものでしたから、大久保甚十郎一家は、ならわしどおり秩禄召し上げ、お家はお取りつぶしということになりました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "青眉の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いやしくも」地主樣にたてつくやうなことはしないことだ。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいたい東洋人が、われわれ白人にたてつくなんて、怪しからん。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "法にたてつく人たちのために、心の正しい人々が鞭と縄とで威嚇されております＊。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたがたのような“憂国者”たちは、反戦運動はあなたがたにたてつく運動だと言っている。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "反戦運動はあなたがたにたてつく運動だ、と上官たちは言うにちがいない。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォーク・シンガーも、プロテストによって社会にたてつく一種の悪役である。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争はしても、なるたけわたしたちの住居から遠ざかったところで参戦したのである）、わたしの家が相当近所の人々から愛情をもって見られたのは当然で、いわば「糞堆＊の上なる」わたしにたてつくことは、はなはだ困難だったのであろう。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "……と、ばかりでは、叡慮にたてつくまろの依怙地のように取られもせんが、世を思うためだ。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
