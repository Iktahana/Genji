        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "去年ノ今頃モ修繕シタコトガアッタッケガ、ソノトキハ赤沢常造ノ奴ガイタカラ、半日デ片付イタモノダ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "地方によって多少作り方も違い、タチツケ、あるいは略してタッケ、猿袴、踏ん込みなどともいい、庄内辺ではマタシャリとも言うそうな。",
              "citation": {
                "source": "春雪の出羽路の三日",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……舟木　アッタッケが来れば、今すぐにでも、転機を取る。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョゼフィーヌはダイム伯に嫁し後にシュタッケンベルク男爵と二度目の結婚をした。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ家ガ本所割下水ニアッタ時代デ、両国廣小路ノ、アレハ何ト云ッタッケナ、何トカ云ウ有名ナ絵草紙屋ノ店頭ニ助六ト意休ト揚巻ノ三枚続キノ錦絵ガ掲ゲテアッタノヲ今モ忘レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今浴ビテルトコロナノ、チョウドオ晝寝ノ時分ダト思ッテ覗イテ見タノ」「今日ハ日曜ダッタッケナ、浄吉ハイナイノカ」ソレニハ答エナイデ別ナコトヲ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今マデ颯チャンガソンナ石ヲ持ッテタノヲ、オ婆チャンモ見タコトハナイト仰ッシャイマスシ、アタシモ知リマセンケレドモ、イツアンナモノヲ買ッタンデゴザイマショウネ」「………」「ソウ云エバ岸サンガ総理大臣ダッタ時、佛印カ何処カデキャッツ・アイヲ買ッテ問題ニナッタコトガアリマシタッケネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ア、コヽニアノ爺サンノ墓ガアッタッケナ」ト、通リスガリニ立チ寄ッテ線香ノ一本モ手向ケテクレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
