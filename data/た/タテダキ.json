        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ミルクを飲ませた後、ゲップを出させるために赤ちゃんを縦抱きにして優しく背中を叩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "首がすわっていない新生児を縦抱きにする時は、頭をしっかりと支えるように気をつけている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は慣れない手つきで幼い娘を縦抱きにし、あやすようにゆっくりと部屋の中を歩き回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "二人は、入口の大きな男を引き起こし、縦抱きの要領で静かに抱き上げ、そのまま階段を下ってコークス置き場へ運んだ。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
