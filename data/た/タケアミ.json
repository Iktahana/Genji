        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私は竹編みの魚籠を持つ役だ。",
              "citation": {
                "source": "田園の幻",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてたいてい、竹編みの大きな籠を、長い紐で肩からぶらさげていた。",
              "citation": {
                "source": "絶縁体",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "油ボロを芯に枯れ葉などを仕込んだ竹編みの火焔玉やら、投げ松明の類だった。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹編戸があるばかりだ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹編でこれに渋紙を貼り定紋を大きくつけます。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "道場と住居とは離れていて、住居の庭へ行くには垣と竹編戸の中門がある。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ひしめいた門人達の力は、門の竹編戸を押し破ってしまった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
