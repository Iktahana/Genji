        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「俺等がやめなきゃ、いつまでたったってやまるもんか。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（舌鼓うつ）たったったっ、甘露甘露。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうでもえいと思ってやれば、いつまでたったって仕事は強くならない」　母は気づかって省作を励ますのである。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワラにあたったって、しようがねえだろ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしも兄さんも、このままでいたのでは、一生たったって幸福にはなりません。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄さんは一生たったって下男でいなければなりませんし、わたしは女中奉公をしていなければならないのですもの。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君、支那人のように嘘つくことが正義になれば、もう此奴はいつまでたったって、滅びやしないよ。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺されないなら、死んだって国の為にはならないし、同じ死ぬなら殺されよう、と思っているうちに、いつまでたったってこの醜態だから、死ぬことが出来やしない。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この調子だと、俺もいつまでたったって食えないかもしれないぞ。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "良い加減に一度ヨーロッパの奴を捻じ上げとかないと、いつまでたったって馬鹿にしやがる。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは私はいつまでたったって罰のあたり通しだ、あなたの所へ来たってもう私には幸わせがないといって泣き始めた。",
              "citation": {
                "source": "鳥",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は若し自分が片思いにしても思って居る男が外の女と好きそうな様子をして、たった一度位にらみ合いをしたったって、必してそんな事に安心させられるほどのんきな気持をもって居るものじゃあありゃしない。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たったったっ田の中で……　九州へ行っている父さんさえこれでよくなったら、当分はお母さんの唄でないが、たったかたのただ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "らっ、たったったっ、　らっ、たったったっ、　とにかく、それは怪塔王が起しているものにちがいありません。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "青江、がまんをしていろよ」　つよい小浜兵曹長は、はげしい空気の流にもひるまず、たったったっと綱にぶらさがって、青江三空曹のそばに近づきました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "貝谷も銃を背に斜めに負うたまま、ひらりと局長のとなりの梯子にとびつき、そのままたったっと舷側へのぼっていった。",
              "citation": {
                "source": "幽霊船の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふふん、うたなんか、うたったって、クリスマスの役には立たないや。",
              "citation": {
                "source": "金のくびかざり",
                "author": "小野浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬は足をゆるめて、たったったっ……と、ゆっくり、太郎のそばを通りかかりました。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それはいつまでたったって無駄だろうな。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "君がいつまでも、世間並みの補祭でいて、休日だけ勤めてそのあとはぶらぶらしているようだと、十年たったって元の杢阿弥だぜ。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そうそう、補祭君、天に熊手でそう書いたったっけな。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そんなウンテレガンの証言を捜索の基礎にしてるんだから、こりゃ、いつまでたったって解決する筈がない。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その波濤の面の金と紅とが乳黄となり、やや寒い瓏銀となり、ブリュブラックとなり、重く暗くなり、そうして今は舷下の飛沫と潮※とがただ白く青く駛って、擾れて、機関部の汚水がタッタッと吐き出されてゆく。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏庭から横露地を玄関前へタッタッタッと乗出して、往来へ出るや否や左へ一曲り、「ハヨ――ッ」　と言う子供声、高やかに、早や蹄の音も聞こえなくなってしまった。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……斯んなことを考へてゐるうちに、階段を昇つて来るやうな眠気が、タッタッと迫つて来て、最少しで彼は、縁側から転がり落ちるところだつた。",
              "citation": {
                "source": "眠い一日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな風に、叩くといつも、トゥルルッル……ルッ……トゥラタッタ……タッタッタッって鳴るやつをね。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからタッタッと追い上った。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッタッと後へ引き下がり、武士は構えざるを得なかった。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　思わず膝をついた一刹那、タッタッタッと階段を登る逞しい足音が聞こえて来たが、闇にもそれと見分けのつく鎧冑に身をよそった一個長身の武士が颯と蝙蝠でも舞い込んだように老人の眼前へ現われた。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッタッタッタッと帰館になる。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
