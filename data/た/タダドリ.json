    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ただ取り次いでいただけばいいのです」ストキはやっぱりまじめに、急がず、何か相談でもしてるような調子で話した。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "主観的な意味を求めてみたが、得たものはただ取り止めの付かぬ妄想に過ぎなかった。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でも飛騨一円当時変ったことも珍らしいこともなかったが、ただ取り出でていう不思議はこの医者の娘で、生まれると玉のよう。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ取りきめを默つて聞くばかりぢやが、そしてこりや毎年のこつて何も今年に始まつたことではないんぢやが、わしらも、ちつとばし腹のなかに思つとることはある。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十圓分の册數をただ取り揃へるだけなら容易であつたが、どれにしようかといふ撰擇には迷はないわけにはいかなかつた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はもう思いが乱れますばかりで、ただ取り止めもない事ばかり認めているようで御座います。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホウ、ただ飲み、ただ取りだ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし彼女たちは踊らず、歌わずただ取り巻いてチップだけは受取ろうという訳だから、十分間で十分の退屈を味わうことが出来るかも知れない。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ取り留めもない雑談だけで充分だった。",
              "citation": {
                "source": "溺るるもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の階のことは知らないが、その最上階では、客は芸妓を相手に、茶をすすり水瓜の種をかじりながら、ただ取り留めもない話で時間をつぶすのだった。",
              "citation": {
                "source": "ピンカンウーリの阿媽",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも堂々と正面からやって來ないで、謀略でケチをつけ、ただ取りしようとしている。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "「露八先生、どうだね」「五両くれますか」「やるとも」　無造作に、射あてたので、斧四郎はただ取りを喰ったような顔をした。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご免こうむりましょう、といったら、たちまち俺は二心ありと首にされ、公安の城はただ取りにされてしまうだろう。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
