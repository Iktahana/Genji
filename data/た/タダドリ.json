    "definitions": [
      {
        "index": 1,
        "gloss": "getting something for nothing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "他人が苦労して集めたデータをタダ取りしようとするなんて虫が良すぎる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "著作権を無視してコンテンツをタダ取りする行為は許されない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "近所の畑から野菜をタダ取りしていた男が、ついに警察に捕まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "生糸貿易にかけては素人のフリをして、期限ぎれや、わざと粗悪品をつかまされるように仕向けて、契約違反で訴えて、品物はタダ取りの罰金はモウカルというモトデいらずの商法の大家が多かったのである。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "今思えば、両者とも四万円ずつ出し、当分ここに居住できそうな調子だから、別に愚痴をこぼすことはない筈ですが、当時の僕らの気分としては、四万円をタダ取りされた感じで、腹が立って腹が立ってたまらなかった。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "百円は、ただどりをされたようなものだ。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
