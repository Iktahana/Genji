        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこに居て壁を押せば、縦三尺幅四尺向うへ開く仕懸にて、すべての機械は人形に、隠るる仕方巧みにして、戸になる壁の継目など、肉眼にては見分け難し。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "上へ上へと少しづつ落葉を掻いて來てはそれを續けてゐると、やがて幅四尺に縦三尺位、厚さ五寸位の落葉の板のやうなものが出來上る。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その幅員、縦三十五マイル、横十九マイルの間にわたる。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の小さな白いブッシュ豆を六月一日ごろ、新しく丸くてまざりのない粒をていねいにえらんで、横縦三フィートと十八インチの間隔の列に蒔く。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "横六尺、縦三尺、それにいろいろの工みを施した花崗岩だ。",
              "citation": {
                "source": "周防石城山神籠石探検記",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "縦三尺に横十二尺の大きさで、枯れたくぬぎ林と野川の景色が水墨で描いてある。",
              "citation": {
                "source": "扇野",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方の壁には、坐っていて眼の高さに小さな窓のような枠があり、縦三寸横一尺ほどの滑り戸が付いていた。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "市街の中央部には、遠くからでも明らかに皇居の大内裏十二門の一劃とわかる官衙殿堂が、孔雀色の甍や丹塗の門廊とおぼしき耀きを放ッて、一大｜聚落をなしており、朱雀、大宮などを始め、一条から九条までの大路や、横縦三十二筋の道路は、碁盤目のように、市坊を区ぎって整然と見えた。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "横二里、縦三里に余る高原に出会う。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ一つ正面の壁に縦三尺ほどの大きな額が懸っている。",
              "citation": {
                "source": "偉大なる夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
