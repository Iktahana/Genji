        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかるに、わざとジュリアン風にふるまったのは、どうせ線を引かねばならぬのなら、「冴子ハ『赤ト黒』ヲ借リニ来タノダ！",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫ガ病人ニナッテシマッタノダカラ残念デタマラナイノダガ、君ノ手紙ヲ見テ西洋ヘ往タヨウナ気ニナッテ愉快デタマラヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハテ、コンナ　ウツクシイ　花バタヲ　ダレガ　アラシタノダラウ」ト　ヲトコガ　タホサレタ　イツポンノ　ケシノ　花ヲ　オコシテ　ヤラウト　スルト、ソノ　ネモトニ　シンチユウノ　ラツパガ　ヒトツ　オチテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ、　「実ハ此処ニ居ル道子サンヲ殺シテ自分モ死ヌ気デ来タノダ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ハドウ思ッテ居ルカ知ラナイガ、実ハ道子サント僕トハズット前カラ姦通シテ居タノダ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ道子ガ裏切ッタノダ、ダカラ今ココデ罰シテヤルンダ」　ト云ッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤントワンコチヤンノナキゴヱヲキイテ、オ母サンハ、キツト、ワンコチヤンガモンコチヤンニホエツイタノダラウトオモヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オマンヂウハ　ナミガ　ミンナ　タベテシマツタノダヨ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルコオバサンハ　セツカク　カメコオバサンガ　キタノダカラ、オキヤクサマノ　マヘデ　ネムツタラ　タイヘン　シツレイダ　トオモヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ニ行クホド暑クナリマス」正直ノトコロ、予ハ手ノ痛サニ閉口シテ晝ノ部ヲ見ルノハ止メヨウカト思ッテイタノダガ、婆サンニ窘メラレタノデ却ッテ依怙地ニナリ、痛イノヲ怺エテ明日ノ晝ニ又来ヨウカト思ッテイタノダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚シタテハソレホドデモナカッタノダガ、コノ三四年目立ッテソンナ風ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ幸イニ一時快方ニ向ッテイタノダガ、昨夜ノ失敗デ又ブリ返シタヨウデアルカラ、当分用心シタ方ガイヽ、シノミンハ餘リ連用スルト副作用ガアルカラ一回四錠ズツ日ニ三回、三日以上ハ続ケナイデ下サイ、毎朝怠ラズ尿ノ検査ヲシ、雑菌ガアッタラ、ウバウルシヲオ飲ミナサイト云ワレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウダ、確ニコレダ、コレダッタノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分昨日ノ明ケ方ノ蟋蟀ノ夢ヤ乳母ノ夢ガ跡ヲ引イタノダト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トコロデプールヲ作ル費用ハドノクライカヽルンデス」当然コノ質問ガ来ルコトヲ覚悟シテイタノダッタガ、大婆サンモ小婆サンモツイ取リ紛レテコノ大切ナ質問ヲスルコトヲ忘レテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日デナクテモヨカッタノダガ、犬ノ事件ヲ早速佐々木ガ知ラセタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂ヘ出レバ颯子ノ顔ガ見ラレルカモ知レナイト思ッタノダガ、「出テハイケマセン」ト止メラレテ、オトナシク云ウコトヲ聴ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテソレトナク予ヲ力ヅケルタメニコノ時期ヲ待ッテ出テ来タノダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "要スルニ餘リ大事ヲ取リ過ギタノガ失敗ノ原因ダッタ、萬々一ノ場合ニ備エテ仰山ナ準備ナドヲセズ、イツモノヨウニ手軽ニ考エテスレバヨカッタ、博士自身ガ神経過敏ニナッテイタノガイケナカッタノダ、ト云ウ点デハ二人ノ意見ガ一致スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ春以来気ニナッテイタノダガ、イッソコノ際京都行キヲ決行シヨウカト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖父母ノ墓ハ深川ノ小名木川近クノ或ル法華寺ニアッタノダガ、ソノ後間モナクアノ辺一帯ガ工場地帯ニナッタヽメニ寺ハ浅草ノ龍泉寺町ニ移リ、ソコモ大地震デ焼カレタノデ、今デハ多磨墓地ニ移ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一旦京都ホテルヘ戻ッテ出直シテ来タノダト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルヘ戻ッテ何シテタンダ」「寒クナリソウダカラ着換エテ来タノヨ、オ爺チャンモ気ヲオ付ケニナラナイト風邪ヲ引クワヨ」四条通リデ買ッテ来タノヲ早速着テ見タカッタノダロウ、白ノブラウスニ、ブリューニ銀ノラメガ繍イ込ンデアルセーターヲ着テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ彼女ト直接閨房ノ※ヲ語リ合ウ機会ヲ与エラレナイ不満ニ堪エカネテコレヲ書ク気ニナッタノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ハ最初敏子ニ差シタノダガ、「私ハダメデス、ドウカママニオ酌ナスッテ」ト敏子ガ云ッタカラデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンナツモリデ今夜モ木村ヲ引キ留メタノダロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏ヲ送ッテ出ルヲ云エバ、実ハソウシテ貰ウ方ガ僕ノ望ムトコロダッタノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
