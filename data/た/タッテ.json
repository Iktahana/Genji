[
  {
    "uuid": "687aca31-c5b7-5d25-9b7c-0a3f3a4aecec",
    "entry": "達て",
    "reading": {
      "primary": "たって",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "strongly hoping or requesting (of something that is difficult to be brought to fruition)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "これは達ての願いですので、どうかお聞き入れいただけないでしょうか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "恩師からの達ての依頼とあっては、断るわけにはいかなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は達てのご希望により、このプロジェクトのアドバイザーに就任した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "つい先達て「歯」のことを書いた中に「硬口蓋」のことを思い違えて「軟口蓋」としてあったのを手紙で注意してくれた人があったが、こういうのは最も有難い読者である。",
              "citation": {
                "source": "随筆難",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし破壊的地震としては極めて局部的なものであって、先達ての台湾地震などとは比較にならないほど小規模なものであった。",
              "citation": {
                "source": "静岡地震被害見学記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "先達てドイツのある科学雑誌に猫の宙返りの真似をする雛形が載せてあった。",
              "citation": {
                "source": "猫六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "津田君は先達て催した作画展覧会の目録の序で自白しているように「技巧一点張主義を廃し新なる眼を開いて自然を見直し無技巧無細工の自然描写に還り」たいという考えをもっている人である。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "先達て宮中の園遊会で音楽者、戯曲家、文学者を招待されたが科学者は呼ばれなかった」とこぼしている。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お梅さんが先達て琴平で買って来たのよ、奉公に出る時｜持てゆきたいって……。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "先達て開かれた「煙草に関する展覧会」でこの天狗煙草の標本に再会して本当に涙の出る程なつかしかったが、これはおそらく自分だけには限らないであろう。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は反古にして無くして仕舞いましたが、先達て此事を話し出した節聞いたらば、麗水君は今も当時写したのを持って居るという事でした。",
              "citation": {
                "source": "学生時代",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も主婦がこの娘に対すると先達て生れた妹の利ちゃんに対するとその間に何のちがいも自分には認められなかったとは云え。",
              "citation": {
                "source": "雪ちゃん",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょっと分りますまい、じゃろうがね、………先達て、三月四日の午後十二時の頃に逢うたのですが。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一個人として、私一｜人として、じゃね、……非常に先達ては失敬した、詫をします、と貴方からよう言うて貰いたいのじゃ。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」深川綾子の先達て、女乞食を救いたるは、廃物を買いて虚名を売り、給金無しの下婢を得て奇利を占めんず政略なりし、今また経費を節減せんとて、行く処なく帰る家なき女乞食を追出だせり。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "先達て友人が来てこんな話をした。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "先達てかねて紹介して置いた福岡大学の久保博士からの来書に、長塚君が診察を依頼に見えたとあるから、今頃は九州に居るだろう。",
              "citation": {
                "source": "『土』に就て",
                "author": "――長塚節著『土』序――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」私「重だった客は先達てのＸ図案家や、詩人のＸ氏や、哲学科のＸ氏あたりでしょう。",
              "citation": {
                "source": "鶴は病みき",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "御勝れ遊ばさん事は、先達ての折も伺いましてごわりましてな。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜、近くの大西質店の主人が大きな風呂敷を持ってやってき、おくやみを述べたあと、「じつは先達てお君はんの嫁入りの時、支度の費用やいうて、金助はんにお金を御融通しましてん。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもこういう事をはじめて聞きましたのが、先達てお嬢さんが口惜がっておいでなすった、根岸の鴨川一件だ。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……村の口の端、里の蔭言、目も心も真暗になりますと、先達て頃から、神棚、仏壇の前に坐って、目を閉じて拝む時、そのたびに、こう俯向く……と、衣ものの縞が、我が膝が、影のように薄りと浮いて見えます。",
              "citation": {
                "source": "甲乙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "先達てかねて紹介して置いた福岡大學の久保博士からの來書に、長塚君が診察を依頼に見えたとあるから、今頃は九州に居るだらう。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "梵授王が智馬を有する間は隣国皆服従し、智馬死すると聞いてたちまち叛き去ったとは信られがたいようだが、前達て『太陽』へ出した「戦争に使われた動物」てふ拙文中にも説いた通り、昔は何地の人も迷信重畳しおり、したがって戦術軍略の多分は敵味方の迷信の利用法で占められ、祥瑞の卜占のという事兵書筆を絶えず。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "また畜類の糞は古来種々に用達てられた。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "先達ても十日ばかり田舎へ行つてゐたら、近所ではお産に行つたなんて噂をしてゐるんだつて――尤もそれは噂に過ぎなかつたんだが。",
              "citation": {
                "source": "妄想患者",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺が先達て先祖の計算をして、四十｜代前の俺の先祖の數が、一｜萬九百九十五｜億二千一百六十二｜萬五千七百七十六｜人だといふ莫大な數字を發表した時には、三十三｜萬三千三百三十三｜人の『中外』の讀者が一｜齊に僕の頭腦の明晰を感嘆したんだからね。",
              "citation": {
                "source": "ハガキ運動",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "宛名はツイその近傍の著名な書肆で、「先達ての○は何々へ届けてくれ、本人が義務を怠たったら自分が返債する」という罪な文面だ。",
              "citation": {
                "source": "硯友社の勃興と道程",
                "author": "――尾崎紅葉――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ないもんですか、先達て大変な騒ぎが起こったのよ」「へぇ、どんなことが？",
              "citation": {
                "source": "或る探訪記者の話",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "千之介がけわしく叱ったのも無理からぬこと、実は波野と二人してこの怪談を先達てある者から聞いたので厶ります。",
              "citation": {
                "source": "十万石の怪談",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "病人は先達てから左腹部に出來た凝がまだとれなくて、熱もあまり高くはなくなつたが、同じやうな度で續いた。",
              "citation": {
                "source": "四十餘日",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先達て小紋の着物がほしいと言つて來たので、安物の絹に形を置かせたのが今日出來上つて來たのである。",
              "citation": {
                "source": "四十餘日",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の作品は、どう考えたって、映画化も劇化もされる余地が無い。",
              "citation": {
                "source": "自作を語る",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
