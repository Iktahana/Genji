  {
    "uuid": "e7d71fec-dce2-52fd-8112-582d094dc444",
    "entry": "チョチョ",
    "reading": {
      "primary": "ちょちょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
