        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "既に、危い二人を救けて、　家臣共を尽く川へ投げ込み、又は打ちのめし、最後にお殿様をチャチャクチャに叩き付けてフラフラになったお殿様の首筋掴んで、Ｔ「仇討の熱病　患者奴！",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "土足のままといっても、しかし、何でもかでも横紙を破り、破目を外し、メチャクチャになれというわけではない。",
              "citation": {
                "source": "土足のままの文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "すくなくとも私は小説を書くために、自分をメチャクチャにしてしまった。",
              "citation": {
                "source": "私の文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪趣味というより、まるでメチャクチャだった。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "店仕舞いメチャクチャ大投売りの二日間の売上げ百円余りと、権利を売った金百二十円と、合わせて二百二十円余りの金で問屋の払いやあちこちの支払いを済ませると、しかし十円も残らなかった。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「顔クチャクチャにして、ゴーンと床に頭付けて笑わすんやから、王道やない」という。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "実に気立てのいい編集者が、メッチャクチャに人の原稿を変えるのだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯が済んでから、お作が台所へ出ていると、新吉とお国が火鉢に差し向いでベチャクチャと何か話していた。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "うるさい、とにかく、こいよ」「メチャクチャじゃない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "中間試験とちがって、先生は採点でムチャクチャにいそがしいから、高志のいうように「生徒の相手なんかしてられない」ことになる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わかんないよ、日本の会社はメチャクチャだから」「ヤードバーズの〈オーヴァー・アンダー・サイドウェイズ・ダウン〉だの、スタンデルズの〈ダーティー・ウォーター〉だの、騒々しい曲ばっかじゃねえか」　三日後に、ワラがアメリカへ帰る。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "躰は慶一よりひとまわり大きいくらいだが、相撲がムチャクチャに強い。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は少しも驚かず懐中から紙袋を出してパンにムチャクチャに噛りついた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふ批評家は闘牛師が赤いマントをふりさへすれば、飛びついてゆく牛のやうな、ムチャクチャな単純な頭をもつた批評家といふべきだらう。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "リエの生命を自分のものとしたい不逞なメチャクチャな願いから、アドルムと酒に酔い、一日、兇器をとりリエの下腹さえ刺した。",
              "citation": {
                "source": "さようなら",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思うと、雄吉は自分の感情で、河野の弱さを、メチャクチャに冷笑して居た自分が、不安にならずには居られなかった。",
              "citation": {
                "source": "神の如く弱し",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも日本人なんかがイクラ想像したって追付かない位、メチャクチャな発達を遂げているのですが、その中でも亦、特別｜誂えの天下無敵の話っていうのが、この崑崙茶の一件なのです。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "三等待合室へ張込んで、クチャクチャになった朝日の袋の中からモウ一本引出して美味い美味い煙を吸った。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サアサア、お父さんだよお父さんだよ」　と揺すり上げながら、思い切り頬ずりをしようとしましたが、その私のチョッキの上を、思いもかけぬ力強さでメチャクチャに蹴立てた赤ん坊は、又も焦げ付くように泣き藻掻き初めました。",
              "citation": {
                "source": "霊感！",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは二個の丸い櫛が、私の頭の上に並んで、息も吐かれぬ程メチャクチャに駈けまわり初めたからであった……が……その気持ちのよかったこと……自分がキチガイだか、誰がキチガイだか、一寸の間にわからなくなってしまった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿呆メチャクチャ出鱈目放題。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビックリして、魘えて、メチャクチャに泣き出す。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……とはいえ……その時に、あまりに深い幻覚に囚われていたために、それを信ずる事が出来なかった私は、それから正木博士と対座して、あの通りの議論をした揚句に、正木博士をメチャクチャに遣っ付けてしまった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それともこの犬が偶然に手に入ったのを幸いに、知らん顔をして実験にかけて弄り殺しに殺して、唖川小伯爵と山木テル子嬢の中を永久に割こうという卑劣手段を講じているのか」「……そ……そんな乱暴な……メチャクチャです。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……その時にウチはメチャクチャに泣き出して、父さんの頸にカジリ付いて、イクラ叱られても離れなかった。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず、その音を聞くと同時にイヨイヨ自分の無罪を確信しつつ、メチャクチャに相手をタタキ付けてしまおうと焦燥った。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボ……僕の巡査志願の第一原因は、やっぱりメチャクチャに探偵小説を読んだからなんです」「馬鹿な。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
