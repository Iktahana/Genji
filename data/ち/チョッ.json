        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "俺だってバスケットを坐らせといて立っていたくねえや」「チョッ、喧嘩にもならねえや」「当り前さ」　少年は眼を開いた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドーン、バーン、ドドーンー　発破は機関銃のように続いて、又は速射砲のようにチョット間を置いて、鳴り続けた。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰かに苛められたの」私は入口の方をチョッと見やりながら訊いた。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョッと出かけて来るから、おやじが帰ったらそういっといとおくれよ」三上が靴をはいてると、「そして荷物は？",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「困ったなあ、ほんとに、チョッ！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人ずつ、チョッと上陸すると、いった格好をして、出ればいいからなあ」「じゃあ、そうしよう」そこで、二人のセーラーは下へ降りた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はチーフメーツが上がって来たのでチョッとニッコリした。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チョッと」と彼はあとしざりした。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョット『革命史』を見まするならば、このくらいの本は誰にでも書けるだろうと思うほどの本であります。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人の生涯はすでにご承知の方もありましょうが、チョット申してみましょう。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人が帰ると、こんどは、チョッピリ女史の御入来だ。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄さんは、チョッピリ女史を芹川一族の恥だと言っている。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わるい人ではないが、どうも、少しチョッピリなのである。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョッピリという名は、兄さんが去年発明したのである。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ではまあ、ほんのチョッピリ！",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョッピリ女史は、すでに退散。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまは、川越一太郎というとしとったお巡りさんが、老妻のキンさんと共に別荘に住んで留守番をしているのだが、僕の家のひとも、あまりやって来ないし、チョッピリ女史がお弟子やら友達やらを連れて時たまやって来ては利用しているだけで、ほとんど廃屋に近くなっているのだ。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉さんはいま、目黒のチョッピリ女史のところにいる。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたら、すぐに荷物を持って、チョッピリ女史のところへ行き、落ちついてしまったのである。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも、こんどの事件には、チョッピリ叔母さんが陰で糸をひいているように、僕には、思われてならない。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の考えでは、どうも、チョッピリ女史が、くさい。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうち一度、チョッピリ女史のところへ、何くわぬ顔をして偵察に行ってみよう。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の事件は、まだ、他の親戚の者には知られていないようだが、いまのところでは、姉さんの味方は、お母さんに、チョッピリ女史。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョッピリ女史が傍に控えているんじゃ、だめだ。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのう学校からの帰り道、ふと目黒のチョッピリ叔母さんのところへ寄って行こうかと思って、そう思ったら、どうしてもきょう行かなければいけないような気がして来て、午後からはお天気も悪くなって雨が降り出しそうだったのだが、ほとんど夢中で目黒まで行ってしまった。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョッピリ女史は在宅だった。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」チョッピリ女史は、ひとを馬鹿にし切ったような返事をして、お茶をいれながら、「どうにか大学へはいって、やれ一安心と思うと、すぐにこんな、不良の真似を覚えるし。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだい、チョッピリ女史のくせに。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
