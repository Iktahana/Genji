  {
    "uuid": "4c5ec3c1-07e8-5702-a889-e42435b786f1",
    "entry": "ちら見",
    "reading": {
      "primary": "ちらみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "高いあかり窓から雪の降つてゐるのがちらちら見えた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」一陣の風がスケツチブツクをぱらぱらめくつて、裸婦や花のデツサンをちらちら見せた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの芽がのびて風に吹かれ、白い葉裏をちらちら見せながらそよぐ頃には、この辺いっぱいに様々の草花も乱れ咲きます。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　葉藏は梨の木の枯枝のあひだからちらちら見える大きなひらたい岩を指さした。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "またあの人だって、無理に自分を殺させるように仕向けているみたいな様子が、ちらちら見える。",
              "citation": {
                "source": "駈込み訴え",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「嘘ですよ」一陣の風がスケッチブックをぱらぱらめくって、裸婦や花のデッサンをちらちら見せた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "古いが、もとは相当にものが良かったらしい外套の下から、白く洗い晒された彼女のスカートがちらちら見えていた。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "校長室の中では、白服の人の動いているのがちらちら見えます。",
              "citation": {
                "source": "茨海小学校",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚の方でも時々は、あの小さなそら豆形の怒ったような眼をあげて、そちらをちらちら見ていたのだ。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝろに白けた以上に白け切って眼の裏のまぼろしに、不思議と魚の浮嚢、餅の青黴、葉裏に一ぱい生みつけた小虫の卵、というようなものが代る／＼ちらちら見え出して、身慄いが細い螺旋形の針金にでもつき刺されるように肩から首筋を刺した。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "木立の隙間から倉の白壁がちらちら見える、それが省作の家である。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くの方にテューダー朝様式の煙突の数々そびえ立つくすんだ古屋敷がちらちら見えたが、車道はうっそうとした木々のあいだを通っていて、男の姿はもはや見えない。",
              "citation": {
                "source": "自転車乗りの影",
                "author": "THE ADVENTURE OF THE SOLITARY CYCLIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "公園を出たころには、そこらに灯の影がちらちら見えて、見せ物小屋の旗や幕のようなものが、劇しい風にハタハタと吹かれていた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔父と糺とは、提灯をさげた植木屋と一緒に、黙って吊り台の傍へ附き添ったが、その灯影にちらちら見える人々の姿の見えなくなるまで、母親とお庄は門に立って見送っていた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "日暮里へ来ると、灯影が人家にちらちら見えだした。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十五年四月　　梨の畑あまり花の白さにちよつと接吻をして見たらば、梨の木の下に人がゐて、こちら見ては笑うた。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "燈もちらちら見えてます。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "すかして見ると明け放ちたる座敷の灯さえちらちら見える。",
              "citation": {
                "source": "一夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その喪車の周囲に垂れた黒い幕が揺れるたびに、白綸子の覆をした小さな棺の上に飾った花環がちらちら見えた。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、白い着物を着た葬列のものたちがやって来るのがちらちら見えはじめました。",
              "citation": {
                "source": "ごん狐",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "埠頭を埋めた黒山の群衆のなかから、日の丸の旗がちらちら見えるのに、負けてきた、という感慨が、今更のように口惜しく、済まないなアと込みあげて来ました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "箱根遊船会社が拓いたという専用道路をのぼって行くと、一路平坦、殊に先刻から懸念していた山霧は次第に晴れて、陰暦五日の月があらわれたので、まず安心とよろこんでいると、湖尻に着いた頃から燈籠の光がちらちら見えはじめた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "十　暮れから催していた雪ぞらも、春になってすっかり持ち直したが、それも七草を過ぎる頃からまた陰った日がつづいて、藪入り前の十四日にはとうとう細かい雪の花をちらちら見せた。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は比較的人通りの少ない宵闇の町を歩きながら、やはり明るい室内の光景をちらちら見た。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "松の間から暖簾のようなものがちらちら見える。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "初夏の武蔵野は檪林、楢の林、その若葉が日に光って、下草の中にはボケやシドメが赤い花をちらちら見せて居る。",
              "citation": {
                "source": "新茶のかおり",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "この辺から、左右に、小山が連なって、戸塚の焼餅坂を登りきると、右手に富士山が、ちらちら見えるまでに、晴れ上ってしまった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "帽子も冠らず、旅行者らしいゴルフズボンで、群衆の中をあちらこちら見廻しつつ、ぶらぶら広場を横切って通りの方へ行くのだが、日光が強いので、禿頭の頂がよく輝き、多い群衆の中にも拘らず、どこまでも明瞭にひと眼でそれと見別けがつく。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
