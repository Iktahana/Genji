          "literary": [
            {
              "text": "それから後、象の大群が見られるというので「チャング」を見、アフリカの大自然があるというので「ザンバ」を見た。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがお前はドーバー駅とチャングクロス駅の間で奴がどうなったか、何が起こったか知っている。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、チャング飯田信夫、藤山一郎とおきなで、すきやきし、十二時半帰って又麻雀する、四時迄。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
