        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "錫製の銚釐で熱燗をつけると、お酒の味がまろやかになると言われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "囲炉裏にかけた銚釐から湯気が立ち上り、香ばしい日本酒の香りが漂う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "年季の入った銚釐を丁寧に磨き上げ、正月の祝い酒を準備する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "私は、銀色の銚釐を静かに小杯に傾けながら、夫人が語るすっぽんの割烹譚を興深く聞いた。",
              "citation": {
                "source": "すっぽん",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "空は爽に晴渡ツて、星が、何かの眼のやうに、ちろり、ちろり瞬をしてをる。",
              "citation": {
                "source": "水郷",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら笑っても愁いの除かぬ切れ目の小さい眼でちろり／＼わたくしを眺めながら物を言う間にも額口や袖口のカフスの中の手首をハンカチで拭く所作があります。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると葛岡は、世にも恨めしそうな眼で、ちろりとわたくしを見返しましたが、「おかしいとは何だ。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "がっちりした顎を青々と剃って黒い瞳をちろり／＼と動かしながらペタルを踏んで行く二十二の弟を見て、啓司はこいつ馬鹿なのか利口なのかと見定めるよう更めて見詰めました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人がこのポーズを取ったあと、口振りとはおよそちぐはぐの恨めしそうな白眼でちろりとわたしの方を見て、それからもぞ／＼と身体をわたしと反対の方へいざり向け、何やら覚束なく手慰みの細工仕事に向うそのうしろ肩の寂しさ。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "水門の上を蒼白い月がのぼり、栴檀の葉につやつやと露がたまれば膽のわななきもはたと靜止して足もとにはちんちろりんが鳴きはじめる。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かの蟲がちろりんと鳴いたと思つたら死んでゐた。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかあかと阿波の鳴門の巡禮が泣けば…………ころべば…………韮の葉が…………芝居小屋の土間のむしろに、ちんちろりんと鳴いづる。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれ、ルウヴルの屋根の上、望の色の天のおく、ちろりちろりとひとつ星。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "見よ、大空の奧深く、千萬年も倦んぜずに、また、こよひ、ちろり、ちろりと見える、聞える、色の數々顫はせた、星の光の節まはし。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐘村で名代の鐘撞男月がよいのでうかうかと鐘をつくのもつひわすれ灯のつく街がこひしさに山から港へではでたが日がくれるのに山寺の鐘はつんともならなんだ村長さまはあたふたと鐘撞堂へきてみれば伊部徳利に月がさしちんちろりんがないてゐた。",
              "citation": {
                "source": "どんたく",
                "author": "絵入り小唄集",
                "note": "青空文庫"
              }
            },
            {
              "text": "新納武蔵守は薩摩武士の生粋で例の戯談好きな太閤様の歌にある、ちんちろりんのやうな長い鬚を生やした男だつたが、矢張り薩摩者に有りうちの、ちんちろりんのやうに雌を可愛がるので聞えた男だつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちんちろりんは随分な嫉妬焼きで雌が他の雄と談話でもしてゐようものなら、いきなり相手を後脚で蹴飛ばすさうだが、薩摩者もこの点ではちんちろりんに劣らぬ道徳家である。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　はつと思つて、女が袖の下へそれを隠すと、武蔵はちんちろりんのやうな顔で袖の下を覗き込む。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "武蔵も少しは歌を咏んだ男だけに、ちんちろりんのやうな顔に涙を流して不憫がつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度秋も末で、窓の外にはちんちろりんが意気な小唄を謡つてゐる頃であつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほどよく帰つて寝た、ちんちろりん／＼、いつしか睡つてしまつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "めづらしく宵寝、いろ／＼の夢を見た、とき／″＼眼が覚めて、孤独のおもひが澄みわたつた、身に迫つてちんちろりん、虫もさびしいのだろう！",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "意味を読もうとするような笹村の目が、ちろりと女の顔に落ちた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "莫迦みたいな顔して寝ていちゃ困りますよ」　小野田が薄目をあいて、ちろりと彼女の顔を見たとき、お島はいらいらした声で言った。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず雨戸をしめて後に寝床へはいるとチンチロリンの声が聞こえなかった。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴虫が数日前から前栽でチンチロリン、チンチロリン、まだまづいな。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "チンチロリン、チンチロリンと松虫が鳴いています。",
              "citation": {
                "source": "ごん狐",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘は、青菜を洗ひながらも、チロリ、チロリ、と横眼で近づいてくる鶏たちの方を見るのでした。",
              "citation": {
                "source": "小熊秀雄全集-14",
                "author": "童話集",
                "note": "青空文庫"
              }
            },
            {
              "text": "お由の家の大炉には、チロリチロリと焚火が燃えて、居並ぶ種々の顔を赤く黒く隈取つた。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "お由の家の大爐には、チロリ／＼と焚火が燃えて、居並ぶ種々の顏を赤く黒く隈取つた。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにつづいて蟋蟀が草の根本から涼しい声で、「チンチロリン、チンチロリン」　とうたい出します。",
              "citation": {
                "source": "がちゃがちゃ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴虫の鈴鈴虫　鈴虫チンチロリン鈴　どこから持つて来た母さんお嫁に来るときに番頭に負はせて持つて来た鈴虫　鈴虫チンチロリン鈴　ちよつくら貸してみろ貸したら返さぬあーかんべ番頭に負はせてやつちやつた。",
              "citation": {
                "source": "十五夜お月さん",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "お藪の蔭は　　　茨とすすき　茨にやさされ　　　足が　痛い　すすきにや切られ　　　足が　痛いチロリン　チロリン　チンチロリンチロリン　チロリン　チンチロリンと松虫は　　お藪にとまつて鳴きました。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
