  {
    "uuid": "f2f68f19-8df9-5a0c-afc1-cf3b3e2bad4e",
    "entry": "陳状",
    "reading": {
      "primary": "ちんじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
