        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "渇の止まると共に次には飢の苦、あゝ此樣な事と知つたら、昨夜海中に飛込む時に、「ビスケツト」の一鑵位いは衣袋にして來るのだつたにと、今更悔んでも仕方がない、斯うなると昨夜の暖な「スープ」や、狐色の「フライ」や、蒸氣のホカ／＼と立つて居る「チツキンロース」などが、食道の邊にむかついて來る。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの、（リノキ、チツキテビー）よ。",
              "citation": {
                "source": "間引菜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……切符はチツキを入れませんから、代價の割戻しが出來ます。",
              "citation": {
                "source": "雨ふり",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはアキラメでもなければナゲヤリでもない、むろんサトリでもない、いわば、老のオチツキでもあろうか。",
              "citation": {
                "source": "三八九雑記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせチツキに出すのだから風呂敷包みでも好いだらうになどと彼は思つてゐるうちにトランクの隅に埋つてゐる登山袋を眼にした。",
              "citation": {
                "source": "鶴がゐた家",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "チツキの番号は３３４５。",
              "citation": {
                "source": "上海の絵本",
                "author": "三岸好太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
