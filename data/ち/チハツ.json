        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "エンジンの遅発が、事故の原因となった可能性がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "爆弾の遅発装置が作動し、建物は大きく揺れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「おい、遅発するぞ！伏せろ！」と彼は叫んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
