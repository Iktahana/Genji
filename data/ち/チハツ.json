[
  {
    "uuid": "295b42d8-646b-5da9-ad45-e1f49faffd7d",
    "entry": "遅発",
    "reading": {
      "primary": "ちはつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "delayed departure",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "悪天候のため、列車の遅発が相次いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ロケットの打ち上げは、技術的な問題により遅発した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「すみません、飛行機が遅発しまして」と彼は息を切らして謝った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "このお六というのは、渡り者の大年増で、中低で盤台面の、非凡の愛嬌者で、高輪の往来――遅発の旅人の、好奇の眼を見張る中から、八五郎をしょっ引いて、巴屋の店に飛び込むほどの勇気と腕力を持っていたのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お六の役目",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏近くなって庭の古木は青葉を一せいにつけ、池を埋めた渚の残り石から、いちはつやつつじの花が虻を呼んでいる。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "竜の髭のなかのいちはつの花の紫が、夕風に揺れ、二人のいる近くに一本立っている太い棕梠の木の影が、草叢の上にだんだん斜にかかって来た。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉藏は、いちいちはつきり答へた。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭にはかんかん陽があたって蝉の声の降るなかにいちはつがちらほら咲いていた。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽はまぶしいほど山地に反射して、道端に咲くいちはつの花が鋭い白星のように見える。",
              "citation": {
                "source": "呼ばれし乙女",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シグナレスさん、ほんとうに僕たちはつらいねえ」　たまらずシグナルがそっとシグナレスに話しかけました。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘たちはつまらない顔をして帰って行った」　かの女は娘たちの案に相違した顔を思い出すように、またくっくと笑った。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "落栗いが栗のあをきがうちはつくづくと鳴く蝉ありき。",
              "citation": {
                "source": "第二海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀の力彌の肩衣はいちはつぐさか、――雨がへるぴよいと飛び出た宙がへり、青い捕手の幕切はええなんとせう、夜の雨に。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たちはつい昨日まで戦争といふ「狂気」の壁に取まかれてゐたが、その壁ははたしてほんとに取除かれたのだらうか。",
              "citation": {
                "source": "「狂気について」など",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "おみなへし、へらしだ、われもかう、烏萩、こうや万年草、いちはつ、狐の行灯、烏瓜、ぶらぶら提灯花、孔雀歯朶、盗棒萩、犬虱、しほん、獅子舞ひ蓮華、猫柳……等々と、一見見渡したゞけで忽ち百種類も数へあげることが出来るのである。",
              "citation": {
                "source": "バラルダ物語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い人たちはつれだって町に出かけた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋の人たちはつぎのように答える。",
              "citation": {
                "source": "石仏",
                "author": "THE STONE BUDDHA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日も朝のうちはつぶされるな。",
              "citation": {
                "source": "戯作三昧",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛆はかう云ふ僕の記憶に忽ちはつきり浮かび出した。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "四隅に花壇があって、ゆすらうめ、鉄線蓮、おんじ、薊、ルピナス、躑躅、いちはつ、などのようなものが植えてあった。",
              "citation": {
                "source": "風琴と魚の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私たち、折角働いてこしらえたって、この頃のものなんか何こさえているんだか分んないみたいで詰んないわ、ねえ」　月賦がきくのと時間がないのとで、娘たちはつい購買で拵えることになるのであった。",
              "citation": {
                "source": "三月の第四日曜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちはついでにシェイクスピアの母方の親戚なる郷士アーデンの屋敷がウィルムコートに在るというので、それをも見て行こうとして、田舎道を乗りまわしたけれども、捜し出せなかったので、そのままウォリクの古城をさして北東へ進んだ。",
              "citation": {
                "source": "シェイクスピアの郷里",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たちをだまかしたんだな」　そう言って子供たちはつめよっていきました。",
              "citation": {
                "source": "影法師",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "僧三　若いお弟子たちはつまずいても。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "起きても仕方がないから、また床にもぐり込んだが、それも、朝飯の頃には、しとしと小雨が降りそそいで、いやにうすら寒いから、手紙を書いたり煙草をふかしたりして、朝のうちはつぶれてしまった。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "闇墜ちぬ、にほひもはた色もひとつの音に添ひぬ、燈火遠ながき笛の音……草びら向日葵の蘂の粉の黄金にまみれ、　あな、夕まぐれ、朽ちはつる草びらや、草びらは唯わびしらに。",
              "citation": {
                "source": "有明集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "老女　　わたしを助けてくれる人たちはつらい仕事をしなくっちゃならないよ。",
              "citation": {
                "source": "カスリイン・ニ・フウリハン（一幕）",
                "author": "CATHLEEN NI HOOLIHAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしたちはついに町の門を過ぎて、前方にある丘をのぼり始めました。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "クラリモンド",
                "note": "青空文庫"
              }
            },
            {
              "text": "お家にのこるおかあさんや、姉妹たちはつらいでしょうが。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "一座の人たちはついにその夜は散会することになり、昔流の、心のこもった握手を交わした。",
              "citation": {
                "source": "クリスマス・イーヴ",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、金持ちはつくづくと我が身の上を悲しんだのでありました。",
              "citation": {
                "source": "金の魚",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやく、みつばちが、やってきてくれないものかと、花は、待っていましたが、その日は、みつばちはついにきませんでした。",
              "citation": {
                "source": "公園の花と毒蛾",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "このお六といふのは、渡り者の大年増で、中低で盤臺面の、非凡の愛嬌者で、高輪の往來――遲發の旅人の、好奇の眼を見張る中から、八五郎をしよつ引いて、巴屋の店に飛び込むほどの勇氣と腕力を持つてゐたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お六の役目",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
