    "definitions": [
      {
        "index": 1,
        "gloss": "tea harvesting (picking)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "静岡では、春になると茶摘みのシーズンが到来し、茶畑が賑わう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供の頃、祖母と一緒に茶摘み体験をしたのが良い思い出だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "茶摘みは重労働だが、美味しいお茶のためには欠かせない作業だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "春なれば茶摘みの様汽車の窓より眺めて白手拭の群にあばよなどするも興あるべしなど思いける。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方に馬から離れた茶摘男たちは、一休みする間もなく各自に、長い長い綱を附けた猿を肩の上に乗せて、お茶摘みに出かけるのです。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところどころに茶摘みをする女の赤い襷と白い手拭いとが見え、裸で茶を製している茶師の唄が通りに聞こえた、志多見原にはいちやくそう、たかとうだいなどの花があった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "籔の雑草かりを手伝つたり、茶摘みの手助けになつたりした。",
              "citation": {
                "source": "籔のほとり",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝から、神保さんがやつてきて茶摘みに精出してゐる。",
              "citation": {
                "source": "行乞記",
                "author": "室積行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄舟寺老師の麻の腰に来て驚くやうに消え入る蛍　この鉄舟寺老師こそ先にも云つた通りの、一生参学の事了つた老翁の茶摘み水汲み徳を積む奇篤な姿である。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たち明治期の、都會生れのものが、風俗畫からやしなはれて來た常識――茶舖でもらふ、茶摘み風景をゑがいた團扇や、海苔やの、海苔そだに小舟をあしらつたり、干し場の景色には、富士山が遠く紫ばんで見えたりするのや、うつくしげな養蠶風俗などとは、似てもにつかない生計の業であつた。",
              "citation": {
                "source": "桑摘み",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "日光と京都と奈良と、鵜飼ひと茶摘み（？",
              "citation": {
                "source": "左団次一行",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「黄檗を出れば日本の茶摘みかな」茶摘みの盛季はとく過ぎたれど、風は時々｜焙炉の香を送りて、ここそこに二番茶を摘む女の影も見ゆなり。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そろそろ茶摘みの始まる季節に二日ばかりも続いて来た夏らしい雨は、一層人を疲れさせた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶摘みだ烙炉だ筵だと騒いでいる木曾の季節の中で、男女の移住者の通行が続きに続いた。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "――私は母とあの広い庭へ出て茶摘みをしたり、庭で父と三人でお菓子をたべたりしたことが思い出された。",
              "citation": {
                "source": "幼年時代",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "その絶壁は又、四川の旅行者がよく紀行にも語つてゐるやうに、どんな登山家も取りつけないやうな嶮しさなので、支那人がその茶の木から新芽の葉を摘み採る時には、猿の腰に籠を結びつけ、それに長い綱をつけて、猿に茶摘みをさせるのだといふことである。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　かっぱとかっぱが顱合せをしたから、若い女は、うすよごれたが姉さんかぶり、茶摘、桑摘む絵の風情の、手拭の口に笑をこぼして、「あの、川に居ります可恐いのではありませんの、雨の降る時にな、これから着ますな、あの色に似ておりますから。",
              "citation": {
                "source": "小春の狐",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　暑さが漸く催して此から百姓の書入時といふ茶摘の頃までは何の噂もなかつた。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "おすがゞ五六人連で茶摘をして居る所へ引つ掛つてしまつたからである。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "お安はおすがと茶摘をして兼次を騷がしたことのある女である。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年は芍薬の出が早いとか、茶摘歌を聞いてゐると眠くなる時候だとか、何所とかに、大きな藤があつて、其花の長さが四尺｜足らずあるとか、話は好加減な方角へ大分長く延びて行つた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年は芍薬の出が早いとか、茶摘歌を聞いていると眠くなる時候だとか、何所とかに、大きな藤があって、その花の長さが四尺足らずあるとか、話は好加減な方角へ大分長く延びて行った。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間間に緑色の半纏を着た茶摘男とか、黄袍を纏うた茶博士とかいったような者が、二三十人｜入り交って行くのですが、この猿が何の役に立つかは後で解ります。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでソンナような冒険的な苦心をした十人か十四五人の茶摘男が、めいめいに一握りか二握りのお茶の新芽を手に入れると、大急ぎで天幕張りの露営地に帰って来ます。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "駿府にはわざと泊らず、海近い焼津から一気に大井川を越えて、茶摘歌と揚雲雀の山道を見付の宿まで来ると高い杉森の上に三日月が出たので、通筋の鳥居前、三五屋というのに草鞋を解いた。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶摘といへば日頃出入の家の婆さんまで頼まれて來て、若葉をホイロに掛けて揉む時には男も一緒に手傳ひました。",
              "citation": {
                "source": "幼き日",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親は其頃茶摘に行っては、よく帰りに淡竹の筍を沢山採って来た。",
              "citation": {
                "source": "新茶のかおり",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "彩色した茶摘女や、能人形も少しあり、金属や陶磁器のも一つ二つありました。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "春の茶摘歌、五月雨頃の田植歌、夏の日盛りの田草取の歌から、秋の哀れも身に泌む砧の音、さては機織歌の如き、苟も農事に関する俗歌俗謡の如きものは、その文句の女性に依って唄わるべく作られてあることを思わば、田舎の女子の農事に対する功労は我々が大いに感謝すべきであると思う。",
              "citation": {
                "source": "夫婦共稼ぎと女子の学問",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの時代の彼女達の生活が文化の上に残した各地方の労働歌――紡ぎ唄、田植唄、粉挽の時に歌う唄、茶つみ唄、年に一度の盆踊りに歌う唄などは、素朴な言葉の間に脈々とした訴えと憧れとをふくめている。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "且、未定、七月九日　金　二番茶つみ。",
              "citation": {
                "source": "日記",
                "author": "一九二〇年（大正九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「春明草」に、茶つみの謌、金屋氏の乞によりて、茵華　匂ふ少女が玉手もて　摘みつる春の木の芽　めしませと言ふのも、おなじ人に関したものであらう。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
