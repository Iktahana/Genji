        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "チカチカチカチカ、コチコチコチコチ、パッとまた幕面が白く明って見出しの円が出る。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ち見たところ二十八九、容姿端麗の美婦であったが、身には純白の行衣を着、仄かに灯された獣油の灯火で、四季洞内に籠り詰め、カチカチカチカチと鑿を揮い、仮面を作るに余念なかった。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "星を刻むような鋒止先、チカチカチカチカと青光る。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつを迎えた一本の剣、鶺鴒の尾のように上下へ揺れ、チカチカチカチカと青光る。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――正面の硝子にうつっていた博士の顔が、雨のように流れだしたかと思うと、チカチカチカと煌くなり、まるで映写中のフィルムが切れたときのように、博士の顔がパッと消えて、あとには透明な硝子板の外になんにも見えなくなった。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチカチカチカチと錠を開けるような音！",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチカチカチカチン。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチカチカチカチン……。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……越後国｜頸城郡林泉寺村真日山林泉寺に馬頭観音と祭られたる法性月毛の十寸六寸にあまる名馬に打ち跨り……」　カチカチカチカチン。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチカチカチカチカカチカチ。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチカチカチカチ、懐中時計の秒を刻む音が、やかましく耳につく程の、静けさだ。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、おまえが半年のあいだ、正成公の碑にむかって、カチカチカチカチ鑿をもって仕事しているうちには、いつか、正成公のこころが、一滴の血ぐらいでも、おまえの意志のなかにはいって来たにちがいない。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
