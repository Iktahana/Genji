        "examples": {
          "standard": [
            {
              "text": "この国際条約には、世界中の多くの国が調印国として名を連ねている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "調印国会議が開催され、今後の協力体制が話し合われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新たな協定の調印国となることに、その国は前向きな姿勢を示した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しかるに、対日平和条約に対しては、まだ多くの未調印国家、未批准国家があり、特に一衣帯水のソ連並びに中共との間には戦争の状態が残っておるのであります。",
              "citation": {
                "source": "浅沼稲次郎の三つの代表的演説",
                "author": "浅沼稲次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
