    "definitions": [
      {
        "index": 1,
        "gloss": "with a clink (of metal)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ポケットから小銭を取り出すと、ちゃりん、と音がした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "鍵束をテーブルに置いた時の、ちゃりんという乾いた音。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供がおもちゃのオルゴールを鳴らすと、ちゃりん、と可愛らしい音が響いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ふたりは、やあ公が十｜銭玉をいつもの手さげ金庫にちゃりんとほうりこんだのをしおに、にげ出すような気持ちで店を出た。",
              "citation": {
                "source": "空気ポンプ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "岸の青砥は喜ぶ事かぎりなく、浅田から受け取った十一文を三度も勘定し直して、うむ、たしかに十一文、と深く首肯き、火打袋にちゃりんとおさめて、にやりと笑い、「さて、浅田とやら、このたびの働きは、見事であったのう。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹替小判をちゃりんと投げ与えておくと、すたすたと大股に追っかけました。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "入り口で坐っていた物乞いの帽子に、二十五セント玉をちゃりんと入れて、汽車に乗り込んだ。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "その瞬間、背の低い一人の若者が、水に閃く影の如く、人々の袖の間を摺り抜けて出て「ええいっ」　懸声と同時に、ちゃりんと、刃の合った音がした。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちゃりんちゃりんナイフを磨ぐ音がした。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「第二は、この猿の鍵です」　一彦は、ちゃりんと音をさせて、テーブルの上に大きな鍵を出しました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時に、彼のゆったりとした気分は、突然、一枚の金貨が馬車の中に飛び込んで来て、その床の上でちゃりんと鳴ったのに、掻き乱された。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "若松屋惣七は、ちゃりんという小判の音で眼をさます。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちゃりんと音のするのを見ると、思いがけなく、眼を射るような吹きたての小判だった。",
              "citation": {
                "source": "早耳三次捕物聞書",
                "author": "浮世芝居女看板",
                "note": "青空文庫"
              }
            },
            {
              "text": "七郎の腰につけている刀が壁際にかけてあったが、それが不意にひとりでに抜けて、鞘から二、三寸ばかり出て、ちゃりんという響と共に、その光がぎらぎらと電のように光った。",
              "citation": {
                "source": "田七郎",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "たくさんの鈴の音が、ちゃりんちゃりんとそれに調子を合わせて、何やら幻妙な響きを遠くから伝えて来る。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのはずみに、銅貨がすべり落ちて、入口の石段でちゃりんと鳴った。",
              "citation": {
                "source": "キリストのヨルカに召された少年",
                "author": "フョードル・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、ちゃりんちゃりんと切りむすぶ音がきこえてまいります。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼女が身體を動かすと、小さな貨幣がちゃりんと鳴って、土間に落ちた。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼女が改札口から現れると、鎖の音をちゃりん！",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥様は今朝方、旦那様とともに五時十五分、チャリング・クロス発大陸行の汽車でお発ちになりました。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャリング・クロスの待合室で、俺の左の犬歯をたたき折った奴。",
              "citation": {
                "source": "空家の冒険",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここからチャリング・クロスまで蹴飛ばされても相応の報いだよ。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで私も銀銭を目つぶし、チャリンと撥で受けると、片眼のそのお婆が、「へい、ありがとう。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　チャリンと言う刃音が同時に伝わった。",
              "citation": {
                "source": "老中の眼鏡",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チャリング・クロスの周囲三｜哩以内の地にのみ、文学は在り得る。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "○いざり三、子供達にはマラソン競争を申込まれるし○いざり二、物乞ひもしねえのに、帽子を脱いだら、チャリンと金を放りこみやがるし、○いざり四、大の野郎まで、（泣きながら）馬鹿にしくさつて、背くらべにやつてくる○いざり一、そこでたまらなくなつて、村に引こんで百姓だ。",
              "citation": {
                "source": "きのふは嵐けふは晴天",
                "author": "小熊秀雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "床に、乞食に投げるように、チャリンと音をさせて下さい」　そうして、呆気にとられた早苗の手から、二、三枚の銀貨を握ったとき、左枝は突然、脳に灼熱するようなものを感じた。",
              "citation": {
                "source": "地虫",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはどこかから、チャリンチャリンと楽玻璃のように、一定の節奏をもって、快い玻璃の音が響いてくるのであった。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右胴へ来た奴をチャリンと鉄砲の砲口で弾いたが、その切尖の欠けた刀を持ち直さぬうちに、十手を鍔元に引っかけて巻き落いた。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それほど人は切っていたが、チャリンと刀を合わせたのは、二、三合しかないからであった。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャリンと葉之助は両刀で受けた。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「酒も黄金の色ではあるが、ちと、その、どうも水っぽくてな」「チャリンチャリンと音のするやつを」「なんだなんだ、金がほしいのか」　今気がついたというように、花垣志津馬は苦笑したが、「持ってけ持ってけ。",
              "citation": {
                "source": "怪しの館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このお侍さんの分もナ」　チャリンと二つ三つ、小粒を盆へ投げだす。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
