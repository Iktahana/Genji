    "uuid": "dc4d291f-2473-5a04-8d51-3fdef016f474",
    "entry": "鎮南",
    "reading": {
      "primary": "ちんなん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
