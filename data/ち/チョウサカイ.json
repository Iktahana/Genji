          "standard": [],
          "literary": [
            {
              "text": "一九〇一年には Chief Gas Examiner（ガス受給に関する監督局の長官）に任命され、ガス法規修正案の調査会の議長となり、また訴訟問題の判定に参与したりした。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし日本では濃尾震災の刺戟によって設立された震災予防調査会における諸学者の熱心な研究によって、日本に相当した耐震建築法が設定され、それが関東震災の体験によって更に一層の進歩を遂げた。",
              "citation": {
                "source": "颱風雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "国語調査会とかいうものでこういういい言葉を調べ上げたらよさそうに思われた。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "後を追ひ縋つて来た小山内氏は、犬養木堂が外交調査会の会議室に入つて往くやうにつんと済ました顔をして車掌台に足をかけた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "葵の上９・４（夕）　文学士｜富尾木知佳氏は東京音楽学校の教授で、兼てまた邦楽調査会の委員である。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その邦楽調査会の用事で、富尾木氏が京都にやつて来た事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は外交調査会がある日だから、一つＴさんを撮ってきて下さい。",
              "citation": {
                "source": "Ｍ侯爵と写真師",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "この期間にフロレンスは医学調査会の報告や、衛生局のパンフレットや、病院、孤児院などの沿革をむさぼり読んだ。",
              "citation": {
                "source": "フロレンス・ナイチンゲールの生涯",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の傑出した論説の中には一九〇九年の窮民救助法調査会に先鞭をつけているものもあった。",
              "citation": {
                "source": "フロレンス・ナイチンゲールの生涯",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "民法編纂の当時、起草委員より編纂の方針に関する案を法典調査会に提出して議決を経たる綱領中に、「文章用語は意義の正確を欠かざる以上なるべく平易にして通俗なるべきこと」とあるは、特にこの点に注意したるためであった。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "我邦では、この語は、明治十三年以来用いられているが、明治三十年の頃、我輩は法典調査会において、法学博士山田｜三良君の補助を得て、現行の法例を起草した際、この法例という題号の由来を調べてみたところ、凡そ次のようなものであった。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "五五　準拠法　準拠法は、我輩が明治二十九年法典調査会において法例を起草した際、マイリ(Meili)などのドイツ国際私法論者が用いた Massgebendes Recht という語に当嵌めた訳語であって、初めてこれを法例理由書の中に用い、その後広く行われるようになったのである。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "同君の弁論の達者なことは、法典調査会の始めの主査委員会二十回および総会百回に、同君の発言総数が、三千八百五十二回に上っている一事でも分る。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "これにおいて、翌年三月、内閣に法典調査会を置かれることとなったが、伊藤総理大臣は総裁となられる予定であったから、先ずその始めに副総裁たるべき西園寺公望侯、および委員に擬せられたる箕作麟祥博士を始め、数名の法律家を永田町の官邸に招いて大体の方針を諮問せられた。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "これより先き、法典調査会においては、商法の編纂に着手し、同法起草委員たらしめるため、当時欧洲に滞在中なりし岡野敬次郎博士を召還し、梅博士、田部芳博士と共に起草の任に当らしめ、その原案は百三十二回の会議を経て議了せられたから、民法親族編、相続編と同時に議会に提出された。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "五五　準拠法　準拠法は、我輩が明治二十九年法典調査会において法例を起草した際、マイリ（Meili）などのドイツ国際私法論者が用いた Massgebendes Recht という語に当嵌めた訳語であって、初めてこれを法例理由書の中に用い、その後広く行われるようになったのである。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮名遣改定案を制定したる国語調査会の委員諸公は悉聡明練達の士なり。",
              "citation": {
                "source": "文部省の仮名遣改定案について",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "国語調査会の委員諸公は悉聡明練達の士なり。",
              "citation": {
                "source": "文部省の仮名遣改定案について",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "我国語調査会の委員諸公は悉聡明練達の士なり。",
              "citation": {
                "source": "文部省の仮名遣改定案について",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "田村幸策君（法博）の話――毎日新聞の大東亞調査会で、学者たちが戰爭責任に関する研究を進めていた。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月二日（土）　鮎沢巖君、世界経済調査会を辞めた。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "シベリア出兵に関する外交調査会の審議に関するものだ。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "外交調査会のようなものがあるほうが、外交について大きな失敗をしないためによい。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "（心霊学協会雑誌第八千二百七十四号所載）　わが心霊学協会は先般自殺したる詩人トツク君の旧居にして現在は××写真師のステユデイオなる□□街第二百五十一号に臨時調査会を開催せり。",
              "citation": {
                "source": "河童",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
