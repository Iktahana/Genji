        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（指さして）ほら、あっちの方でちゅくちゅく鳴いている鳥はあれはなあに？",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チュクチュクチュク」と始めて「オーシ、チュクチュク」を繰り返す、そのうちにそれが「チュクチュク、オーシ」になったり「オーシ、チュクチュク」にもどったりして、しまいに「スットコチーヨ」「スットコチーヨ」になって「ジー」と鳴きやんでしまう。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中途に横から「チュクチュク」とはじめるのが出て来る。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに餌あり、チュクチュクチュク。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝早くから起きて、ピイチク、チュクチュク、ピイチク、チュクチュク、騒がしいったらない。",
              "citation": {
                "source": "小さき花にも",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "何をしているのか、ピイチク、チュクチュク、ピイチク、チュクチュク、騒ぎまわって、薄暗くなるとひっそりしてしまう。",
              "citation": {
                "source": "小さき花にも",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんないっしょになって、ピイチク、チュクチュク、ピイチク、チュクチュク。",
              "citation": {
                "source": "小さき花にも",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "声は声を呼んで、チイチク、チュクチュク、チイチク、チュクチュク、潮のように高まってくる。",
              "citation": {
                "source": "小さき花にも",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "チイチク、チュクチュク、チイチク、チュクチュク、騒ぎまわってくれ。",
              "citation": {
                "source": "小さき花にも",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
