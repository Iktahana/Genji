        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供がお風呂で自分のちんこを指差して「これなあに？」と尋ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "生物の授業で、ちんこの機能について説明があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "幼児向け絵本では、ちんこの名称として「おちんちん」が使われることが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "円山さんというのがいったい西洋窓のついた日本座敷みたいに、こちんこちんした無愛想な男だ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」“Chon-aiko! chon-aiko! ……”「華魁、何をそんなに見てお出でなの、くよくよとさ、黄色いふたつの高張に赤い日が、あのやうに射しかけて、ぴちやぴちやと濁水が凄いわねえ、あら、ちよいと、そんな処でおちんこなんか捲くるもんぢやありませんつたら、小児は罪が無ことねえ、ほほほ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "花の盛り花の盛りはちんころぐさの花でさへ、ただもう、ふんはりとしましての、よいにほひの、好いたらしいよいおいろの、にくげといふものつゆもない。",
              "citation": {
                "source": "第二海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちんころ兵隊ちんころ、ちんころ、ちりちりちん、ちりちり、ちんころ、ちりちりちん。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちんころ兵隊、喇叭卒、てとてと、鉄砲も肩にかけ。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちんころ、ちんころ、ちりちりちん、ちりちり、ちんころ、ちりちりちん。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちんころ兵隊、赤胴衣、飴屋のお鉦で泣き出した。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し腑に落ちんことがあるなら、どういうわけでそう為にゃならんのか、分りませんちゅうて、教えて貰いんされえ。",
              "citation": {
                "source": "ヰタ・セクスアリス",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちんころが縫いあげしたような顔ってえことばがあるが、こんなのは珍しいや。",
              "citation": {
                "source": "右門捕物帖",
                "author": "左刺しの匕首",
                "note": "青空文庫"
              }
            },
            {
              "text": "せんにお父さまは、よそのいたづらつ子が、ぱちんこで小鳥をうちおとしたときに、その子の耳をおひつぱりになつたことがある。",
              "citation": {
                "source": "かたつむり",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、その傍で何かのつぎはぎものでもしてゐた母親が見咎めて、『おや、この餓鬼、お尿しやがつたな、うぬ、今度｜為て見い、おめえのおちんこを、これよ、此の鋏でチヨン切つちまふぞい。",
              "citation": {
                "source": "神童の死",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり弟に乗しかかつて、傍にあつた鋏を取ると、その小さな、また可燐な、恰度朝顔の蕾のやうに尖つた、ヒクヒク動いてゐるそのおちんこをいきなり、チヨンと切り落として了つた。",
              "citation": {
                "source": "神童の死",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄の子は、弟のおちんこをチヨンと一つ切り落す事が、それほどの一大事とは思ひがけなかつたにちがひない。",
              "citation": {
                "source": "神童の死",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはおちんこをチヨンと一つ切り落す事は朝顔の蕾を一つチヨンと切り落すのと大した相違はなかつた筈だからだ。",
              "citation": {
                "source": "神童の死",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、兄の子はわあわあ泣き泣き、飛んでつた弟のおちんこを捨つて、そつと母親の方に差出した。",
              "citation": {
                "source": "神童の死",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親は『ほほヽヽヽヽヽ』とたまらず声を上げて笑ふと、落ちてゐた小さなおちんこを拾ひ上げて、弟の子の血みどろの跨の間に押しつけて見た。",
              "citation": {
                "source": "神童の死",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな男が、ふんべつ顔して、いろは歌留多などを作っている図は、まるで弁慶が手まりついて遊んでいる図か、仁王様が千代紙折っている図か、モオゼがパチンコで雀をねらっている図ぐらいに、すこぶる珍なものに見えるだろうと、思う。",
              "citation": {
                "source": "懶惰の歌留多",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵士の死ぬ事を、チンコロが一匹死んだ程にも考えやしない。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「書簡は各小隊でまとめて船長の所へ持って来い、わかったか、わかったら返事せんか」　ワーイ「おい酔うて甲板へ出ると危いぞ」「うん」「海へ落ちるな、カマスゴに喰われるぞ」○ゴムのパチンコで蝿を殺してる兵。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎角コチンコチンコセコセとした奴らは市区改正の話しを聞くと直に日本が四角の国でないから残念だなどと馬鹿馬鹿しい事を考えるのサ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "市電の革屋町駅で降り、本通りと名付けられたこの通りを東に向かって歩くと、パチンコ店や高級食料品店が目に入り、その並びにブティックや書店があり、パン屋のアンデルセン本店のはす向かいには、何と小さな古書店がある。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "辞表を出してから引き続いてＣＡＣの仕事を手伝うこともあったが、大半の時間はパチンコ屋で過ごした。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが乗り込んできた本流のコンピューター屋が作ったＰＣ―９８０１と同門のガチンコ勝負となって、破れ去った。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒さでカチンコチンに凍ってしまって、あたかも死んだようになってしまって、地面に落ちていきます。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            },
            {
              "text": "パチンコで雀を落して、自分で毛を※って、学校の隣の支那料理屋で焼いて貰って、喰べながら、教室へはいってきた男もいた。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "）パチンコなんぞを振りまわして、むやみに女を撃ち殺すなんて、そんな乱暴な奴は早く取ッつかまえて遣る方がいいわ。",
              "citation": {
                "source": "影",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこに隠していたか知らないが、あの人がパチンコなんぞを持っていようとは思わなかったが……。",
              "citation": {
                "source": "影",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはツイ一時間ばかり前に、二重の麻袋に入れて、松脂やタールでコチンコチンに塗り固めて、大きな銑鉄の錘を付けて、確かに海の底へ沈めた筈の二人の水夫に違いなかった。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "事によるとあの二｜挺のパチンコで穴を明けられちゃ叶わねえと思って、そのまんまにしといたんです。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その自分の右足が、巨大な硝子筒の中にピッタリと封じ籠められて、強烈な薬液の中に涵されて、漂白されて、コチンコチンに凝固させられたまま、確かに、標本室の一隅に蔵い込まれているに相違無い事を、潜在意識のドン底まで印象させておいたならば、それ以上に有効な足の幽霊封じは無いであろう。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
