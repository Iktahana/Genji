          "literary": [
            {
              "text": "チーチーパッパでやって行くが、上級の子は、女の子は大抵の女の子とつれ立ち、男の子は男の子とつれ立っている。",
              "citation": {
                "source": "砂遊場からの同志",
                "author": "――ソヴェト同盟の共学について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学校だからチーチーパッパで、ときどきはやかましいが、清澄なやかましさで、神経には一向にさわりません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チーチーパッパ」のレコードお土産で、すぐかける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
