  {
    "uuid": "b0a0334c-a94c-551d-825a-2379cf421dec",
    "entry": "知心",
    "reading": {
      "primary": "ちしん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこでこういう場合は、いろいろ六ヶしいことがあるが、簡単に説明すればこうだ、皆さんこの外どういうことがあるか考えて御覧なさいといった風にして、彼等の求知心を強からしめ、研究的態度に出でしむるようにありたい。",
              "citation": {
                "source": "研究的態度の養成",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはわしが悪かった、どうかこらえてくれ」　毅と銭塘君はそのときから知心の友となった。",
              "citation": {
                "source": "柳毅伝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれがすなわち探水知心、人心を探る一伝法じゃ。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼎足論云、焼則灰、埋則土、何物残而有之者、不知心性猶水去此往彼湛然常住也、凡人死而成畜、畜死而成人、且生天上堕地下者、在乎三国経史矣、言滅而無者何也、断見矣。",
              "citation": {
                "source": "通俗講義　霊魂不滅論",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
