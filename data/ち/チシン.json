  {
    "uuid": "2c861c1d-75dc-5ce7-a2f9-b5350114728e",
    "entry": "治心",
    "reading": {
      "primary": "ちしん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "つぎに、淘宮術は天源術より出でたるものにて、もっぱら十二支にもとづき、人の生年月によりてその資性、命運を判定し、もって治心の要法としたるものである。",
              "citation": {
                "source": "迷信解",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "海舟の政治心得第一条は「高い運上（税金）は国を亡ぼす」ということだった。",
              "citation": {
                "source": "安吾史譚",
                "author": "勝夢酔",
                "note": "青空文庫"
              }
            },
            {
              "text": "把心以治心、謂之聖學。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
