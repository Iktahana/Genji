[
  {
    "uuid": "49028660-ae55-5313-88a3-b02db39b976a",
    "entry": "地方",
    "reading": {
      "primary": "ちほう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "district",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この地方は、美しい自然に恵まれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は地方出身だが、都会で成功を収めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "地方自治体が、地域の活性化のために様々な取り組みを行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "僕は彼の詩集、「春と修羅」を十年来愛読してゐますが、自分が無名のために、此の地方で印刷された驚くべき詩集を、皆さんにお知らせする術を持ちませんでした。",
              "citation": {
                "source": "宮沢賢治全集刊行に際して",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "感想中原中也　地方の詩のグループも多いことだが、どういふものか、ずつと以前から大連と神戸にだけ面白いものが見られるのだつた。",
              "citation": {
                "source": "感想",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊本へ出張して一と晩久しぶりで旅人の気分で歩いたが、熊本といふ所はいい所です　火山地方特有の落付がありますとも書いてゐた。",
              "citation": {
                "source": "詩集　浚渫船",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "強烈な地方色がない。",
              "citation": {
                "source": "九月十月十一月",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "尋常五年生は毎年関東地方の地図を出品するといふことになる。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうして五六年目頃までは、年々、一等は一等でもその一等が目に見えて立派さを加へて行くのだが、その五六年を過ぎてしまふと、一等賞の関東地方の地図は年々おんなじ位の出来｜栄となり、もうその村が格段開けるとかなんとかしない限り、その出来栄は大体変らないといふのである。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃地方の新聞に短歌欄あり、短歌を投書す。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "（饑饉といふやうな不幸もありはするが、それは一地方といふか一国といふか、とまれ人一人の不幸ではないから断つておく。",
              "citation": {
                "source": "よもやまの話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反して芭蕉は、好んで奥州や北国の暗い地方を旅行していた。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高原地方のアトモスフィアを、これほど鮮明に、印象強く、しかもパノラマ的展望で書いた俳句は外にない。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高原地方や山麓の焼土に多く生棲していて、特に夏の日中に飛翔する小虫を捉えた着眼点にある。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち読者は、羽蟻という言葉によって、そうした高原地方の、夏の日中の印象を与えられてしまうのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "因に、こうした景趣の村は関西地方に多く、奈良、京都の近畿でよく見かける。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはたいてい垢じみた着物をきて、頭を乱髪にした地方の文学青年だった。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも用件で来るのは好いのだけれども、地方の文学青年なんかで、ぼんやり訪ねて来られるのは最も困る。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "関東地方の温泉では、先づ「好い温泉」といふ部類に属するものであらう。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "地方の中学にかなりに好い口があって世話しようとした先輩があったが、田舎は厭だからと素気なく断ってしまった。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ一人親しく往来していた同窓の男が地方へ就職して行ってからは、別に新しい友も出来ぬ。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って現在高知にそういう狩猟法が残存しているかどうか、また高知以外の日本のどの地方に過去現在のいずれかに同様なものが行われて来たかどうか、ということについても全然なんらの知識も持合わせていない。",
              "citation": {
                "source": "鴫突き",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇が崩御になった九州のある地方の名がすなわちこの村の名になっている。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "話は飛ぶが私の兄は、この地方に於いて最も注目されてよい人物の一人かもしれぬ。",
              "citation": {
                "source": "人物に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいまいの産地は、本邦では、小笠原、琉球、臺灣などの南の諸地方だといふ話を聞いてゐる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙臺地方には昔から、雀が多かつたのか、仙臺笹とかいふ紋所には、雀が二羽圖案化されてゐるし、また、芝居の先代萩には雀が千兩役者以上の重要な役として登場するのは誰しもご存じの事と思ふ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、昨年、私が仙臺地方を旅行した時にも、その土地の一友人から仙臺地方の古い童謠として次のやうな歌を紹介せられた。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま私は、戰災のため田舍暮しを餘儀なくされてゐるが、ちやうどいまの日本の津輕地方の生活が、そつくりチエホフ劇だと言つてよいやうな氣さへした。",
              "citation": {
                "source": "津輕地方とチエホフ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "津輕地方にも、いまはおびただしく所謂「文化人」がゐる。",
              "citation": {
                "source": "津輕地方とチエホフ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "津輕地方のインテリゲンチヤたちも、實にこの「意味」の追及に熱心である。",
              "citation": {
                "source": "津輕地方とチエホフ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "低きには森あり、林あり、野の花あり、しかして高きには雪あり、氷あり、我らの不二山は、小さい山だが、熱帯地方の二倍も高い山より偉大なるは、雪と氷に包まれているためである。",
              "citation": {
                "source": "梓川の上流",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "このような、恐怖すべき時代は、今日では都会を襲って、地方に及ぼそうとしている、土地もあろうに、この峡谷を以て、その時代を象徴させようとするには、あまりに惜しい上高地ではあるまいか。",
              "citation": {
                "source": "上高地風景保護論",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "朽ちほうけた七五三飾の繩ばかりなのが、其對立してる二本の榛に引きはへてある。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
