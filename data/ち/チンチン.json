        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ストーブの上のヤカンがちんちんと鳴り始めたので、お茶を淹れることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "台所からちんちんと聞こえてくる蒸気の音が、冬の朝の訪れを告げている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「お湯がちんちん言ってるわよ、早く火を止めて」",
              "citation": {
