        "examples": {
          "standard": [
            {
              "text": "「お風呂がちんちんだから、水で埋めないと入れないよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "焚き火の中に放り込んでおいた石が、ちんちんに熱くなっている。",
