        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あの二人はいつも人目もはばからずちんちんしていて、見ているこっちが恥ずかしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
