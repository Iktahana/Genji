[
  {
    "uuid": "1632bec7-1f88-5b0b-8b6c-54a64803364f",
    "entry": "宙ぶらりん",
    "reading": {
      "primary": "ちゅうぶらりん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
