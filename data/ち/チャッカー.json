        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ポロの試合は通常、4つから6つのチャッカーで構成されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "最終チャッカーで逆転ゴールを決め、会場は大いに沸いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今日の練習試合は、短いチャッカーを繰り返して集中力を高めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それはいいが、ふつうの寮生がスニーカーやテニスシューズを愛用するのとは異なり、片桐は、三センチぐらいのヒールのついた黒いチャッカーブーツで、点呼だろうが、食堂だろうが、学校だろうが、どこへでもノシていくので、そのたびに問題になる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり、真っ黒なチャッカーブーツが、藤井の鼻をとらえた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "人から、うしろ指一本さされない態の、意志に拠るチャッカリ性。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、俗にいうチャッカリ性でした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮮銀はさらに、カムチャッカ漁場の利権を買ってる漁業会社へ、一ルーブル十八銭――二十銭で売りつけた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこはカムチャッカの横の方の地図で見ると山脈の褐色のケバが明るくつらなってゐるあたりらしかったが実際はそんな山も見えず却ってでこぼこの野原のやうに思はれた。",
              "citation": {
                "source": "花椰菜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はみなチャッカリしてるが、しかし君みたいに、徹底したのはおらんな。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなチャッカリした女にも、一つだけ抜けたところがある。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムチャッカ蘭です。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "見える、見える、あのカムチャッカ蘭の窓が。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャッカリ屋、吉屋信子女だてらに原稿料の荒稼ぎ河童の頭の皿に精々注いで貰ひな黄金の水を――。",
              "citation": {
                "source": "小熊秀雄全集-12",
                "author": "詩集（11）文壇諷刺詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャッカリ小僧「……ウヌ……逃げたナ……」　と云ううちに交通巡査も、物蔭に隠しておいた自働自転車を引ずり出して飛乗った。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ナカナカ重役の仕込みがいいな貴様は……チャッカリしている。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば、カムチャッカのようなところへやったとしても、まあ防寒手袋の一つも宛がえば、平気で斧をかついで、新らしい小屋を建てる木を伐りに出かけますからね。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても、おそらく本場のカムチャッカにおいても、こんな大群を見ることはめずらしかろう。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の北のほうにある漁場カムチャッカだ」　大いばりでフォークをにぎろうとしたとき、「三千夫ボーイ、事務長のおよびだ」　と、ボーイ長がどなった。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あ、そうそう、カムチャッカでやっとります燻製の鰊に燻製の鮭は、いかがさまで……」「それだ。",
              "citation": {
                "source": "地軸作戦",
                "author": "――金博士シリーズ・９――",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムチャッカ半島の東の鼻先のところにある岬の名だ。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに違いない」　彼はそれからタイムスの世界大地図をまた担ぎだして、カムチャッカ半島の部の頁を繰った。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムチャッカのデジネフ岬がどうしたというのだ。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……この平助の希望とするところは、ロシアの南下を防ぐにありまして、今日のままにて打ち捨て置きましたならば、カムチャッカの者は蝦夷と合し、蝦夷もやがてはロシアの勢力に……」「あやまる、平助、今夜は止めてくれ。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、「その点がはっきりしねえうちは、俺あもう組合費は出さんつもりだ」「チャッカリしすぎてるぞ！",
              "citation": {
                "source": "乳房",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、耳の鼓膜がやぶれるような、すごい爆破の音がつづけさまに起り、一番後にいた殿艦『カムチャッカ』と六番艦の『ミゾリー』がわずか二分間で、かきけすように沈んでしまったのだ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "この社会的認識の欠乏は壮年や老人ならば却って、反対にチャッカリした悪く常識的な思想と生活とを産むものなのだが（今日では一定の認識不足なしには社会生活は甘く行かぬ）、それが青年の場合だと、無条件的な野心や冒険欲となって現われるというだけだ。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "不幸なペルウズの書類を持ってカムチャッカからペテルスブルグまで旅をしたドゥ・レセップ氏は、世界のこの地方が時に食物の不足から蒙る窮乏の陰惨な光景を書いている。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムチャッカのボルチェレックという村に滞在中に、彼は曰く、『ひどい大雨は洪水を起し、川から魚を逐いはらってしまうから、この地方では有害である。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧しいカムチャッカ人に最もつらい飢饉はその結果であり、これは昨年は半島の西海岸にあるあらゆる村に生じた。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "この恐るべき災害はこの地方に極めて頻々と起るので、住民はその住居を棄て、魚のもっと豊富なカムチャッカ河の流域にその家族と共に移住するを余儀なくされる。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥ・レセップ氏によれば、カムチャッカでは、それは原住民の四分の三１）の生命を奪った。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "シベリヤ、カムチャッカ、樺太を渡り歩いたといふだけで、なにをしてゐたか誰も知らない。",
              "citation": {
                "source": "それができたら",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
