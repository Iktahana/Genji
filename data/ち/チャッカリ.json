    "definitions": [
      {
        "index": 1,
        "gloss": "shrewdly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はちゃっかりと美味しいところを独り占めして、みんなを呆れさせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "みんなが忙しくしている間に、彼女はちゃっかり休憩を取っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「あら、ちゃっかりしてるわね！」と、友人からの軽い非難の声が上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」　ちゃっかりしていやがる。",
              "citation": {
                "source": "渡り鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちゃっかりした娘なら、ただでは済まさないわね。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうＤさんだって、僕があの人の日常生活を親しくちょいちょい覗いてみたところに依ると、なあに御自分の好き嫌いを基準にしてちゃっかり生活しているんだ。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "村々は、素知らぬ振りして、ちゃっかり生活を営んでいる。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の若い人たちは、なんにも知らぬ振りをして子供っぽい口をきいて私たちを笑わせながら、実は、どうして、ちゃっかり俗な打算をしているのだから、いやになります。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どちらも、自分がこれから下谷へ行っても、充分に楽しめるように計画して買うのだから、ちゃっかりしている。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと近いところだったら、貸してくれそうな様子だったのだが、とにかく、ちゃっかりしたおじいさんである。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちゃっかりしていやがら。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "背に腹は代えられぬ情なさだが、しかし「セントルイス」は女の経営にしては、万事大まかに穴があいて、ちゃっかりした抜け目のなさが感じられぬのは、さすがに本妻の気品で、他の京都人経営の喫茶店を嗤っているところもあり、「おれ京都がいやになったよ」　と、京吉が言いに行くには、ふさわしい店でもあった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "なアんだ、それで呼びとめたのかと、京吉は軽蔑したような口つきになって、「ちゃっかりしてるね。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "金銭にかけると抜目がなくちゃっかりしていると、軽蔑しているのである。",
              "citation": {
                "source": "鬼",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の子って、実に抜け目が無く、自分の事ばかり考えて、ちゃっかりしているものだと思った。",
              "citation": {
                "source": "作家の手帖",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "事実、仕事とは無関係に４００４のキットを買ってきた後藤富雄も、ちゃっかりと会社にあったテレタイプを利用している。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ちゃっかりしてるけれども、人をだましたりなんかしないから。",
              "citation": {
                "source": "※東綺譚",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すいぶん、ちゃっかりしているなあ。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "それともう一つ、いま築地の異人館へボーイに住込ませて置く忠作という小僧が、あれがまたなかなかのちゃっかり者で、ボーイに身をやつして、毛唐の趣味趣向から、その長所弱点をことごとく研究中である。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校でだって案外たかく売れる」「ちゃっかりしてやがらあ」兄はほがらかにいった。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "芭蕉なんて、あれで相当ちゃっかりした爺さんだから、何処か山蔭の食糧豊富なところに色女でも隠匿していたのじゃないかね。",
              "citation": {
                "source": "メフィスト",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり玄人なんてえのはちゃっかりしているんだね。",
              "citation": {
                "source": "メフィスト",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "人から、うしろ指一本さされない態の、意志に拠るチャッカリ性。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、俗にいうチャッカリ性でした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はみなチャッカリしてるが、しかし君みたいに、徹底したのはおらんな。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなチャッカリした女にも、一つだけ抜けたところがある。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャッカリ屋、吉屋信子女だてらに原稿料の荒稼ぎ河童の頭の皿に精々注いで貰ひな黄金の水を――。",
              "citation": {
                "source": "小熊秀雄全集-12",
                "author": "詩集（11）文壇諷刺詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャッカリ小僧「……ウヌ……逃げたナ……」　と云ううちに交通巡査も、物蔭に隠しておいた自働自転車を引ずり出して飛乗った。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ナカナカ重役の仕込みがいいな貴様は……チャッカリしている。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、「その点がはっきりしねえうちは、俺あもう組合費は出さんつもりだ」「チャッカリしすぎてるぞ！",
              "citation": {
                "source": "乳房",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この社会的認識の欠乏は壮年や老人ならば却って、反対にチャッカリした悪く常識的な思想と生活とを産むものなのだが（今日では一定の認識不足なしには社会生活は甘く行かぬ）、それが青年の場合だと、無条件的な野心や冒険欲となって現われるというだけだ。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ、といふので駈けつけて売値をたしかめ、それから諸方の本屋につてを求めて買手をさがして、東奔西走、忙しくて仕方がなくても、売手買手、両雄チャッカリしたもので、口銭はいくらにもならない。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は観察して、オコウちやんの人気は抜群であり、愛嬌もお客のあしらひも、金勘定のチャッカリぶりも、顔も姿も第一等で、浮気心もまだ知らない。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
