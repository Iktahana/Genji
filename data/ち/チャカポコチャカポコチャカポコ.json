        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "キチガ――ア――イ――地イ獄ウ――……スカラカ、チャカポコチャカポコチャカポコチャカポコ……　　　　　　　一　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……スカラカ、チャカポコチャカポコチャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きたながらのこの世の地獄じゃ……チャカポコチャカポコチャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナント恐ろしキチガイ地獄……チャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんじょ、そこらの地獄の話じゃ……チャカポコチャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがホンマの阿呆陀羅経だよ……スカラカ、チャカポコチャカポコチャカポコチャカポコチャカポコチャカポコ……　　　　　　　二スカラカ、チャカポコチャカポコチャカポコチャカポコ……　▼あ――ア――ああア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "キチガイ地獄のイロハのイの字じゃ……スカラカ、チャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "スチャラカ、チャカポコチャカポコチャカポコ……　　　　　　　三……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャチャラカ、チャカポコチャカポコチャカポコチャカポコ……　▼あアア――ああ……アアア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "確かな事実は一つもわからん……チャカポコチャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで診察出来るが奇妙じゃ……チャカラカ、チャカポコチャカポコチャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテモ恐ろしキチガイ地獄じゃ……スカラカ、チャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャカポコチャカポコチャカポコチャカポコチャカポコチャカポコ……　　　　　　　四　▼スカラカ、チャカポコチャカポコチャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
