  {
    "uuid": "01d36598-5889-545b-94ae-ecfc02c0a91c",
    "entry": "中三",
    "reading": {
      "primary": "ちゅうさん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
