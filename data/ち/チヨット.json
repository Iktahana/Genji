          "literary": [
            {
              "text": "虎には、チヨット、わかるまいよ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その一　舞踏会殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生も――圭子　（それと同時に、その前からハラハラして一同を見まわしていたのが、そのチヨット前から欣二がニヤリニヤリとしながら誠の方へ近寄って行きつつあるのに視線を吸いとられていたが、欣二の薄笑いを浮べた表情に、なにか唯ならぬものを感じ取って、不意に真青になってスッと立つ）欣二さん！",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "金吾それをチヨット見送っていてから、ゆっくり砂利を踏んで歩き出す。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな急いだって――花岡　いや、チヨット、表のようすを見て来る。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、チヨットだまっていてから、ウーッという）花岡　……（ビクンとして、首をあげて佐山を見て、それから、ユックリと上半身をもちあげる。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ロウソクも、もう、あと、一本とチヨット。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう、ホンのチヨット。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
