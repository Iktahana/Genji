        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夕暮れの街に、豆腐屋さんの自転車がちりんちりんと鐘を鳴らして通る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "風鈴がちりんちりんと涼やかな音を立て、夏の午後を彩っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "背後でちりんちりんとベルを鳴らされ、慌てて歩道の端に避けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "幌馬車でちりんちりんだ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "女房は銚子を忙しげに受け取って、女中に「用があればベルを鳴らすよ、ちりんちりんを鳴らすよ、あっちへ行ってお出」と云って、障子を締めた。",
              "citation": {
                "source": "鼠坂",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "野々宮君は、向こうの小間物屋をさして、「あすこでちょいと買物をしますからね」と言って、ちりんちりんと鳴るあいだを駆け抜けた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、型の如く煤けた天井と、同じく煤けたシャンデリアで、それにはカットグラスが沢山ぶらさがっていて、給仕が型の如く、海辺に集う鳥の数ほど夥しい茶碗を載せた盆を、大胆に振り廻しながら擦りきれた油布の上を駈けまわるたんびに、跳ねあがったり、ちりんちりん音を立てたりする。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとあちらの方で電話がちりんちりんと鳴った。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちりんちりんと鳴る鈴は羊のくびにないけれど、かはりにぼくが口笛をじやうずに吹いてひびかせる。",
              "citation": {
                "source": "歌時計",
                "author": "童謠集",
                "note": "青空文庫"
              }
            },
            {
              "text": "その足音が長吉の耳には急いで馳けて行くように聞えた、かと思う間もなく、ちりんちりんと格子戸の鈴の音がした。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "最上等のお仕込を受けた申分のない紳士たちは、彼等がものうげに動くたびにちりんちりんと鳴る小さな垂れ下っている飾物を身に著けていた。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "見世物が終って、そこの空気中の例の激動はほんの小さな嵐になり、例の貴金属の小さな鈴はちりんちりん鳴り響きながら階下へ降りて行った。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "出がけにまた念のためだから電話をちりんちりん鳴らして見たがさらに通じる気色がないのでやめた。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の方では電話が仕切なしにちりんちりんと鳴っている。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間にはちりんちりんと云う電話の仮色も交った。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "だって　ちりんちりん　やることになったら、　きっと　ほんものの　メリアンが　ドアを　あけにくるからね。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の木靴と犬の四本の足は、一緒に荷車の鈴をちりんちりんと鳴らしながら勇ましく早足で進んでいきます。",
              "citation": {
                "source": "フランダースの犬",
                "author": "A Dog of Flanders",
                "note": "青空文庫"
              }
            },
            {
              "text": "じりじりと釣糸を底までおろして、やっと少し引いてみると、井戸の壁になにかがぶつかる微かなちりんちりんという金属性の音が聞えた。",
              "citation": {
                "source": "井戸",
                "author": "Ｗ・Ｗ・ジェイコブズ",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゅっしゅっあえぐ汽車にのったり、ちりんちりん鈴の鳴る二輪馬車で、何度も街角を曲ったりして、私たちが鞄や緑色の実験箱をたずさえて、ふたたび水路組合の棧橋に立ったのは、ちょうど時計が十一時を打った頃のことだった。",
              "citation": {
                "source": "歌う白骨",
                "author": "THE ECHO OF A MUTINY",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも小門がちりんちりんと鳴って、女中が表へ走り出て行ったような気がした。",
              "citation": {
                "source": "逗子物語",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき向ふから一列の馬が鈴をチリンチリンと鳴らしてやって参りました。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ、まあ、その中から馬そりの鈴のチリンチリン鳴る音が、やつと聞えるのでやつぱり誰か通つてゐるなといふことがわかるのでした。",
              "citation": {
                "source": "氷河鼠の毛皮",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三、署長室の策戦　次の日税務署長は役所へ出て自分の室に入り出勤簿を検査しますとチリンチリンと卓上ベルを鳴らして給仕を呼び「デンドウイを呼べ。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん気をつけてみるとそういう不思議な鳴き方をするのは、ほとんどきまって豆腐屋のラッパが遠くから聞こえてだんだん近よって来るときか、またはたぶん豆腐屋であろうかチリンチリンと鈴を鳴らしながら前を通るときであるらしい。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "振売の時、チリンチリンと鳴らすが、似ているからって、風鐸蕎麦と云うんだそうです。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "チリンチリン、鈴をつけているのです。",
              "citation": {
                "source": "影",
                "author": "SKYGGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "青いフウリンソウと、小さな白いマツユキソウとが、まるで、鈴でも持っているように、チリンチリンと音をたてながらはいってきました。",
              "citation": {
                "source": "イーダちゃんのお花",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "電話は間断なしにチリンチリンいうと、女は眼を嶮しくして耳を傾ける。",
              "citation": {
                "source": "一日一筆",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "高山の頂を極めようとする人達が、威勢よく腰の鈴をチリンチリンチリンチリン言わせて、宿屋に着くことを楽みにして来る様子は、活気が外部からこの谷間へ流れ込むように聞える。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チリンチリン、チリンチリン。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "」チリンチリン　電話をかけ終った巡査は、また留吉の方へ出て、さて言うには、「今田氏はお前のような友達は持ったことはないと仰言るよ」「今田｜時雄は、その、算術の試験の時……」「もう好い。",
              "citation": {
                "source": "都の眼",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "あけてみると、チリンチリンといい響のする、小さな鈴でした。",
              "citation": {
                "source": "誕生日",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "リンをチリンチリンとならして走って来た。",
              "citation": {
                "source": "心配",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
