        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "丁度君の崇拜してゐた、あの兇賊チグリスのやうに。",
              "citation": {
                "source": "室生犀星に與ふ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バグダッドの兵器庫といふのはチグリス河の上流のその町の近くにある、トルコ軍の兵器庫なのです。",
              "citation": {
                "source": "勇士ウ※ルター（実話）",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、家内の父親の持つてゐるモーターボウトを借り、チグリス河をさかのぼつてバスラといふ町へつきました。",
              "citation": {
                "source": "勇士ウ※ルター（実話）",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「かのウ※ルターが、コロンボで下船して遁走しましたことは、すでにお話ししましたが、その後、私は、最近、はからずも、アデンの、チグリス河の河岸で彼に出会ひました。",
              "citation": {
                "source": "勇士ウ※ルター（実話）",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九〇八年板英国科学士会員ペッチグリウの『造化の意匠』巻二に、猴の心性について汎論した一章あって煩と簡との中を得居るからその大略を述べよう。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペッチグリウ博士続けていわく、予かつて高等哺乳動物の心室と心耳の動作を精測したき事あって一疋の猴の躯を嚢に入れてひっ掻かるるを防ぎ、これにクロロホルムを施すに猴あたかも予の目的を洞察せるごとく、悲しみ気遣いながら抵抗せず、予の為す任に順いしは転た予をして惻隠の情に堪えざらしめた。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペッチグリューまた曰く、猴は人真似に止まらず、また究察力を有す。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上ペッチグリウが挙げた諸例は科学者が審判して事実と認めたもので、その多くはロメーンズの『動物の智慧』から採り居る。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのチグリスなる名は古ペルシア語のチグリ（箭）より出で、虎の駛く走るを箭の飛ぶに比べたるに因るならんという。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "“イネ建国軍キンギン派遣隊司令官カチグリ大佐！",
              "citation": {
                "source": "二、〇〇〇年戦争",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチグリこと佐藤氏来。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、右の話、実は、イタリーのピチグリリがその作品のなかに、もっと面白く書いている。",
              "citation": {
                "source": "愉快な話",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "粗き目は不充分なるさとりの力一〇三―一〇五【いよ／＼】正午の太陽は光殊に強く※轉殊におそしとみゆ【見る處の】正午即ち太陽の過ぐる子午線の位置は經度の異なるに從つて異なる意か【亭午の圈】子午線一〇九―一一一【仄闇き蔭】林の一一二―一一四【エウフラーテスとティーグリ】エウフラテス、チグリス。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "老成すると煙の出るツチグリの若いのもたべたし、アワタケもたべた。",
              "citation": {
                "source": "山の秋",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三度グリ、シバグリ、カチグリ、ハコグリ　諸国に往々三度グリと呼んでいるクリがあって、その土地の名高い名物となっていることがある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチグリのカチは搗くことであるが、そのカチの音が勝に通うのでこれを勝栗と利かせ、戦争や勝負ごとなどに勝つとして縁起を祝うたものである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハバマヤボクチ、葉裏の毛を火口につかったものです」　其の他、小楢、クサボケ（シドミ）、ツリガネ草、スズメノヤリ、フデリンドウ、ニオイツボスミレ、ツボミスミレ、カガリビ草（クチナシ草）、タチフウロ、ミツバチグリ、キジムシロ、ウド、オミナエシ、カンゾウ等。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第二部　混混録",
                "note": "青空文庫"
              }
            },
            {
              "text": "必ずその目的を有し、すでにしてその幾千年前チグリス、ユーフラテスの河畔にその簡易なる社会を構造するのときよりして、すでに今日の境遇に入り、今日の社会に出でざるべからざる一の命運をばあらかじめ造物主より指示せられたるものなり。",
              "citation": {
                "source": "将来の日本",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "別所先生はこの著述中「背景としての山」なるチャプタアに於て、次のように言われている――　スメリアの文明は、ユーフラテス、チグリス両河の流域に起れるもの乍ら、神々の怒りに洪水来りて、全地の人溺れ死せるをり、「人種の保存せる者」といふ英雄の、一家と共に難を船に避けて、遂に山に住んだといふ伝へがある。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "東洋の医学メソポタミアにおける医学　メソポタミアは実際に揺りかごでなかったとしても、全ての文明の託児所であった（メソポタミアはチグリス川とユーフラテス川のあいだの部分。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
