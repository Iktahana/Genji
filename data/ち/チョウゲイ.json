        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "就中喫茶店は、貴婦人社会にさるものありと衆も識りたる深川綾子、花の盛の春は過ぎても、恋草茂る女盛り、若葉の雫滴たるごとき愛嬌を四方に振撒き、多恨多情の八方睨に大方の君子を殺して黄金の汁を吸取ること長鯨が百川を吸うがごとし。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十五日親王長鯨丸に乗りて江戸を発せさせ給ふ。",
              "citation": {
                "source": "能久親王年譜",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者を除いた九名の選手と仮装マネージャーが、文字通りに長鯨の百川を吸うが如くである。",
              "citation": {
                "source": "ビール会社征伐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "また長鯨の百川を吸うがごとき彼の飲みつぷりにも接したことがない。",
              "citation": {
                "source": "人間山中貞雄",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊豆の大島は、海上に長鯨の如く横はる。",
              "citation": {
                "source": "鹿野山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたかも二｜竜の長鯨を巻くがごとく黄海の水たぎって一面の泡となりぬ。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　今夕、長鯨の潮を吹きて走るを見ること一回、小汽船に会すること二回なり。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
