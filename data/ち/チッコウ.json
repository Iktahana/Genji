        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その築港は、巨大な貨物船が停泊できるよう深く設計されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古い漁村の沖に、新たな築港が完成した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "築港のおかげで、貿易が飛躍的に発展した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
