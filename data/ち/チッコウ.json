        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "半蔵門外西洋家具店竹工堂を訪ひ、麻布普請塲に至る。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹工堂を訪ひ椅子を購ふ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから竹工品も茶に使います。",
              "citation": {
                "source": "書道と茶道",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "この朝の主なる収獲は、木工品、竹工品、陶器、その他。",
              "citation": {
                "source": "全羅紀行",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "○竹工藝について　竹細工は是非生かすといいな。",
              "citation": {
                "source": "台湾の民藝について",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
