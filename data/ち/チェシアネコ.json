        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ネコ　――　チェシアネコが　――　にやにや、　チェシアネコは　いっつも　そうなんだ。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "９　チェシアネコ　ひとりぼっち、　ひとりぼっち！",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなとき　チェシアネコが　あたまのうえの　きに　やどってたもんだから、　とっても　うれしかったこと　わかるよね。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェシアネコと　わかれたあと、　アリスは　チェシアネコの　おしえてくれたとおり、　やよいウサギと　ぼうしやに　あいにいったわけ。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そうして今度は自分の知り合いのなかでもブタとしてならやっていけそうな子を思いうかべながら、ひとりごとを言おうとしてね、「ちゃんと化けるやり方を知ってたなら……」とちょうどそのとき、ちょっとびくっとしてね、目の前で、チェシアネコが数メートル先の木の大枝にちょこんといたんだ。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
