    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これで名物のなんのとチャンチャラおかしいや。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "警視庁からの親分の電話でこの喧嘩の趣旨を知り、敵方が機関銃なんていうチャンチャラ可笑しいものを持っていると聞くと、みないい合わしたように一斉に武器を捨ててしまった。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに、世のため人のためと云いたがる料簡がチャンチャラおかしいのさ。",
              "citation": {
                "source": "影のない犯人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "盗んでくれと云わんばかりな顔をしているのに、自分の不注意を棚に上げて、人に盗癖があるなんてチャンチャラおかしい。",
              "citation": {
                "source": "梟の眼",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "厄年がチャンチャラ可笑しい」　と附け加えた。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お腹の虫がチャンチャラおどりをしたいとサ」「きッとか！",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
