          "literary": [
            {
              "text": "チャカポコチャカポコ…………サアサ寄った寄った。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャカポコチャカポコ…………サッサ来た来た。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャカポコチャカポコ……　▼ア――あ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "キチガ――ア――イ――地イ獄ウ――……スカラカ、チャカポコチャカポコチャカポコチャカポコ……　　　　　　　一　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……スカラカ、チャカポコチャカポコチャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きたながらのこの世の地獄じゃ……チャカポコチャカポコチャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナント恐ろしキチガイ地獄……チャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんじょ、そこらの地獄の話じゃ……チャカポコチャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の病気を治癒すが役目じゃ……チャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トテも驚く進歩の違いじゃ……チャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の心は診察出来ない……チャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがホンマの阿呆陀羅経だよ……スカラカ、チャカポコチャカポコチャカポコチャカポコチャカポコチャカポコ……　　　　　　　二スカラカ、チャカポコチャカポコチャカポコチャカポコ……　▼あ――ア――ああア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
