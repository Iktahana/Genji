        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お寺の障子をしめきって、細目にあけて、ナンマンダブ、ナンマンダブ、ふるえながらのぞいていると、ホラブンは何の構えもなくノコノコと門の下へ行って、棒をつきだして、「チョーセイ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョーセイ」　浜の漁師がイワシ網をあげているような至ってノンキなカケ声をかけながら、チョイ、チョイ、チョイ、と棒の先をふって、たちまち蜂の巣を落してしまった。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "目の前に熊蜂がワンワンむらがるのに彼はちッとも気にとめず、「チョーセイ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョーセイ」　チョイ、チョイ、チョイと、棒の先で蜂の巣をころがすこと五十｜米あまり、肥ダメの中へ突き落して、「ホレ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョーセイ」　蜂どもを棒の先でなだめて、ニコニコ笑いながら戻ってきた。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほれ、見てろ」　子供のモチ竿をかりて庭へでて、杏の木の蝉にむかって、「チョーセイ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョーセイ」　チョイ、チョイ、チョイと、竿の先をふるわせて近づけると、何匹でも蝉がくッついてしまう。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "このガキめ、見てろ」　モチ竿をつきだして、庭の木の雀にニコニコと竿を近かづかせて、「チョーセイ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョーセイ」　チョイ、チョイ、チョイ、と近かまへ持って行くが、雀はキョトンとしてジッとしている。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は花サカ爺イのような赤い扮装、タイコをたたいて、「チョーセイ、チョーセイ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "元祖チョーセイアメ、ホラセンベイといえば近郷近在になりとどろき、遠い所から珍芸を見物がてら買いにくる人もある。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "駄賃にアメとセンベイがもらえて、面白くもない字を習う必要もなく、皿まわしを習うことができるから、大そうな喜びようで、寺小屋の繁昌すること、みんな心をそろえて、「チョーセイ、チョーセイ、チョーセイ、チョーセイ」　と、咒文を唱えながら、一心不乱にセンベイをひっくりかえして焼いている。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チョーセイ、チョーセイ、フノ字ノ番ダヨ、チョーセイ、チョーセイ」　こう唱えてやらせる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョーセイ元祖の梵字センベイ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョーセイ元祖の梵字センベイ」　売れるわ、売れるわ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供が三人あつまれば、野良仕事はそッちのけで、モチ竿を突きだして、「チョーセイ、チョーセイ、チョーセイ、チョーセイ」　妖しい手ツキで虫や雀を追いまわしている。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の子供は、チョーセイ、チョーセイと咒文を唱えると、どんな怪物も疫病も退散すると心得ているらしくて、親父どもが叱りつけたり追っかけたりしても、おどろかず、たちまち妖しい手ツキをして、「チョーセイ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョーセイ」　親の鼻の先で、両手の指を妖しくふるわせて親を咒文にかけようとする。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
