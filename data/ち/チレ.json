        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "襖がすらりとあいたようだから、振返えると、あらず、仁右衛門の居室は閉ったままで、ただほのかに見える散れ松葉のその模様が、懐しい百人一首の表紙に見えた。",
              "citation": {
                "source": "縁結び",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "散りたくても散れぬなんて、気のきかない樹だよ。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」説教者にも聴聞者にも気の散れることのないやうに、小声でかう云つて、手で指図をしようとした。",
              "citation": {
                "source": "夜烏",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "入江の端より端へと、おのがじし、見るが間に分れ散れり。",
              "citation": {
                "source": "たき火",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処へ、ちらちらと真紅な緋葉も散れば、色をかさねて、松杉の影が映します。",
              "citation": {
                "source": "菊あわせ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとりで散れば散るんですけれど。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "花弁のちり／″＼にならで散ればにや、手に取りて弄びたき心地もするなり。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲の峯の天にいかめしくて、磧礫も火炎を噴くかと見ゆる夏の日、よろづの草なども弱り萎るゝ折柄、此花の紫雲行きまどひ蜀錦碎け散れるが如くに咲き誇りたる、梅桜とはまた異るおもむきあり。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "氣が凝れば腦に充血し、氣が散れば腦は貧血する傾がある。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "算盤に對して加減乘除を事とするとしても、氣が散れば必らずや過失を生じ勝である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "気が凝れば脳は充血し、気が散れば脳は貧血する傾向がある。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "算盤で運算しようとしても、気が散れば必ず過失を生じがちである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「散ればこそいとど桜はめでたけれ」（何か浮き世に久しかるべき）などとも口ずさみながら同車の人々とともに二条の院へ参った。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（下）",
                "note": "青空文庫"
              }
            },
            {
              "text": "大空の風に散れども桜花おのがものぞと掻き集めて見る　左の童女の馴君がそれに答えて、「桜花｜匂ひあまたに散らさじとおほふばかりの袖はありやは　気が狭いというものですね」　などと悪く言う。",
              "citation": {
                "source": "源氏物語",
                "author": "竹河",
                "note": "青空文庫"
              }
            },
            {
              "text": "珠数工の夜猫の乳古風の門よ、ほどほどに霧雨かかれ、あたらしく、檀よ、青い「猫の乳」よ、微塵の花のさみどりよ、此処は墓地うら、夏は朝、散れよ、細かに、このしめり。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "散れ散れ花散れ駕籠飛ばせとくりゃがらあ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱっと散れば白雨が一度にくる。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "十｜丁にして尽きた柳の木立を風の如くに駈け抜けたものを見ると、鍛え上げた鋼の鎧に満身の日光を浴びて、同じ兜の鉢金よりは尺に余る白き毛を、飛び散れとのみ※々と靡かしている。",
              "citation": {
                "source": "薤露行",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "罌粟散るを憂しとのみ眺むべからず、散ればこそまた咲く夏もあり。",
              "citation": {
                "source": "薤露行",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "春は青年の体内から永遠に歌ひ継げ我等の歌をもつて夜から暁へのリレー死ぬものから――生きるものへバトンを手渡せだまるな、饒舌をもつて敵を圧倒せよ、牡丹のやうに美しく咲いて美しく散れいゝ加減、政治上の敗北にのたうち廻ることをインテリゲンチャに贈呈しろ過去は過去のみ何ものにも非ざるぞ――。",
              "citation": {
                "source": "小熊秀雄全集-5",
                "author": "詩集（４）小熊秀雄詩集２",
                "note": "青空文庫"
              }
            },
            {
              "text": "舌頭へぽたりと載せて、清いものが四方へ散れば咽喉へ下るべき液はほとんどない。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "くだけ散れる片われに、窓より落つる光の靜かに這ふを眺めて、獨り思ひに耽りぬ。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お峯は土間に護謨靴と油紙との遺散れるを見付けて、由無き質を取りけるよと思ひ煩へる折しも、「頼みます、はい、頼みますよ」　と例の声は聞えぬ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "風は猶も邪に吹募りて、高き梢は箒の掃くが如く撓められ、疎に散れる星の数は終に吹下されぬべく、層々｜凝れる寒は殆ど有らん限の生気を吸尽して、さらぬだに陰森たる夜色は益す冥く、益す凄からんとす。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを散ればこそいとど桜はめでたけれ、浮世に何か久しかるべき、と諦め得ぬ羅摩の心を愚痴の極とし、無常の近づき至るほどいよいよ深く執著する者に比したのだ。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを見れば春の海に秋の木の葉しも散れるやうにぞありける。",
              "citation": {
                "source": "土佐日記",
                "author": "紀貫之",
                "note": "青空文庫"
              }
            },
            {
              "text": "よろこびは春の華の如く時に順つて散れども、かなしみは永久の皷吹をなして人の胸をとゞろかす、会ふ時のよろこびは別るゝ時のかなしみを償ふべからず。",
              "citation": {
                "source": "哀詞序",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠目に濁る蒼海の色こそあかれ、黒潮の水脈のはたての水けぶり、はた、とどろ撃つ毒の砲弾、清しき喇叭、薄暮の朱のおびえの戦に疲れくるめく衰ぞああ音を搾る。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、さはあかれ、嗟嘆の樅のふたもと。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "載せきたる板硝子過ぐるとき車｜燬きつつ落つる日の照りかへし、そが面噎びあかれば室内の汚穢、はた、古壁に朽ちし鉞一斉に屠らるる牛の夢くわとばかり呻き悶ゆる。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
