          "literary": [
            {
              "text": "わが妻来れ、チウチウチウ。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "雀がチウチウ烏がカアカア。",
              "citation": {
                "source": "善悪両面鼠小僧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小猫は、三郎さんの持ちそへてゐるお椀の乳を、大そうお旨さうにチウチウ音をたてゝ飲みました。",
              "citation": {
                "source": "身代り",
                "author": "土田耕平",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとどうやらこれがお客に聴いてもらえ、喜んで下りてくると、そのころチウチウ燕路といわれていた大看板の燕路さんがいつの間にか来ていて、たいそう私のことをほめ、お前は初めて落語家になったのじゃあるまいとこう言います。",
              "citation": {
                "source": "初看板",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
