          "literary": [
            {
              "text": "チヨキン／＼と鋏が鳴る。",
              "citation": {
                "source": "蜜柑山散策",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "騒いで、また静かになつて、チヨキン／＼である。",
              "citation": {
                "source": "蜜柑山散策",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、ふふふと娘の声で笑つて、逃げるやうにチヨキン／＼である。",
              "citation": {
                "source": "蜜柑山散策",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処に頬かぶりの手甲脚絆で、チヨキン／＼とやつてゐる七十ばかりの白髪のお婆さんがゐたといふわけである。",
              "citation": {
                "source": "蜜柑山散策",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸び上つてはチヨキン、かがんではチヨキン、腰を叩いてはチヨキン。",
              "citation": {
                "source": "蜜柑山散策",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "山羊サン　ハオヒゲ　ヲチヨキン　ト切ツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
