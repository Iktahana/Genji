        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "畏れ多い話だが、神功皇后の鎮懐石でも、筑前に在つたものは、巨大な二箇の石で、万葉集にまで大きさが記されてゐる。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "壱岐の鎮懐石（石を栓として置く）。",
              "citation": {
                "source": "漂著石神論計画",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "42　鎮懐石の意義と、成女戒と。",
              "citation": {
                "source": "漂著石神論計画",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "43　鎮懐は、鎮魂の一方面であること。",
              "citation": {
                "source": "漂著石神論計画",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "44　鎮懐石の他処より来る事。",
              "citation": {
                "source": "漂著石神論計画",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔鎭懷石と釣魚〕　かれその政いまだ竟へざる間に、妊ませるが、産れまさむとしつ。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "鎭懷石と釣魚　かような事がまだ終りませんうちに、お腹の中の御子がお生まれになろうとしました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
