        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "薬鑵は顛倒して濛々たる湯気が部屋に立ちこもり、先生は、「あちちちちち。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あちちちち、ひでえ、あちちちち、助けてくれ、柴が燃えてる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜜柑の匂いなどのする四下には、草のなかに虫がそこにもここにも、ちちちちと啼いていた。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "崖くづれのした下の茂みでははぐれ小鳥がちちちちとやつてゐる。",
              "citation": {
                "source": "蜜柑山散策",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その母も、ちちちちと、その音聴きき。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "白いお馬は、主かいな今宵帰して、いつの日か濡れにくるかや、しっぽりと抱いて、あかした移り香のさめて、果敢なや、肌寒の朝の廓の霜景色霜にまごうか白い馬「とくらあ――あちちちち」　一人の若い衆が、湯の中から、飛上った。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして海と風とのどよめきが四辺を罩めている中に、ちちちちと木の葉の様な眼白鳥が幾つとなく啼いて遊んでいる。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あちちちちッ」義眼はあつくなっていて、彼の手を焼いた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "机博士は、最後の言葉もおわらぬうちに、「あっちちちち」と、叫んで右の眼をおさえた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あっちちちち」　机博士はふたたび叫んで、今度は左の眼をおさえた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あっちちちち、あっちちち、わっ、た、助けて……」　小男のかまえた毒棒からは、まるで一本の糸のようにつぎからつぎへと毒針がとびだしてくる。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度は、ほら、あっちの上の方で、ちちちち　ちろろって鳴いてるのは？",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "チチチチ、チュ、チュッ、すぐに掌の中に入った。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もみぢが、ちら／＼とこぼれて、チチチチと小鳥が鳴く。",
              "citation": {
                "source": "妖魔の辻占",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――チチチチと鳴くのはこおろぎか松虫か、恋呼ぶわびしい虫の声である。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "……チチチチチチチ……クリクリクリクリクリクリ……チチ……　という小鳥の群が、松の間を渡る声が聞えるばかり……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "風が出て来て、カナリアのチイチイチイ、チチチチチというメロディアスな声を吹きちぎります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっきりした茶色の幹を輝かして立って居る一群の木々の間からは真紅の小さい葉どもがチラチラして、その奥の奥からはチチチチチ、チチチチチと云う小鳥の声があっちにゆったり落着いて居る山の方まで響いて行く。",
              "citation": {
                "source": "追憶",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度今朝抱いて居た雛がかえって、母親の茶色のムクムクな羽交の中で、時に、チチチチとつつしみ深い声を出して居る。",
              "citation": {
                "source": "南風",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつか夜が明けかけ、チチチチと鳥の音はしていたが心にも耳にも入らない。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この村が春の末から到る処、燕の児のチチチチと啼く村になったら、どの位またのんびりとした気分になるか知れない。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "チチチチチ野に啼く声も稚く聞えて耳に寒い。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "空は、チチチチと囀りに明けかけている。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "――いつか外に、チチチチと、小鳥が明けを告げていたのも耳になく。",
              "citation": {
                "source": "私本太平記",
                "author": "婆娑羅帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "行々子のヒナやら雲雀やら、ほの暗い芦のうちでは、もうチチチチが聞かれ出す……　彼は知らない。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
