        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それからすぐまたなんだか役者の話なぞベチヤクチヤ喋舌り散らしてゐる。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『さうですかね』『でなくても左樣見えますね』『婆樣は上方者ですよ、ツルリンとした顏の何處に「間拔の狡猾」とでも言つたやうな所があつて、ペチヤクリ／＼老爺の氣嫌を取て居ましたね。",
              "citation": {
                "source": "湯ヶ原ゆき",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴトウチヤクマデシゴトニカカラヌ。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼アイヌ、家屋の空見ず、さやら葉の青の長葉の、アイサク・ピヤパ（髯なき稷）フレ・ピヤパ（赤き稷）チヤク・ピヤパ（はぜ稷）ヤムライタ・ヨコアマム（藪虱に似し稷）、また、脚高の熊檻、仔の熊の赤き舌見ず、汗垂らし、拭ひもあへず。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "けふは雨で散々だつた、合羽を着けれど、草鞋のハネが脚絆と法衣をメチヤクチヤにした、宿の盥を借りて早速洗濯する、泣いても笑つても、降つても照つても独り者はやつぱり独り者だ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "筍を食べたが、料理がムチヤクチヤなので、あんまりおいしくなかつた、うまい筍で一杯やりたいものだ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月十一日　十二日　十三日　十四日　十五日酒、酒、酒、酒、酒、……遊びすぎた、安易になりすぎた、友情に甘えすぎた、伊東君の生活を紊したのが、殊に奥さんを悲しませたのは悪かつた、無論、私自身の生活気分はメチヤクチヤとなつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "といふ気分で飲んだ、飲めるだけ飲んだ、ムチヤクチヤだ、しかもムチヤクチヤにはなりきれないのだ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月五日昨日のワヤのつゞき、ムチヤクチヤだ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからがいけなかつた、いつしよに街へ出たのがいけなかつた、私だけは早く帰つたが、残つた二人はムチヤクチヤだつたといふ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月廿七日――三十日ムチヤクチヤだつた、私の自棄的身心をさらけだした。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "街で樹明君に邂逅、同伴して帰庵、飲むうちに、そして歩くうちにムチヤクチヤになつてしまつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるでムチヤクチヤだつた、それはムチヤクチヤだつたけれど、私としては一切を投げだして死生の境を彷徨したものだつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は不死身に近い肉体の持主だが、病的健康とでもいふのだらうか、あんなにムチヤクチヤで、こんなにガンキヨウである。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の生活はメチヤクチヤだ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "福岡市街をムチヤクチヤに歩きまはる、やたらに酒を呷る。",
              "citation": {
                "source": "道中記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコガ　メヲ　サマシテ　ミルト、コレハ　マタ　ドウシタ　コトデセウ、メノ　マエノ　オ花バタケガ　ムチヤクチヤニ　フミニヂラレテ　アリマス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンヤハンドレペイジチヨウジユウバクゲキキ五ダイトウチヤクシタ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒキヨモギ　メドハギ　イヌハギ　ネコハギ　マキエハギ　アリノトウグサ　タチフウロソウ　グンナイフウロソウ　コウリンカ　ハナナヅナ　コバノイチヤクソウ　ツリガネニンジン　フシグロセンノウ　トリアシショウマ　ムシャリンドウ　角間新田の上で星糞峠の道に合した。",
              "citation": {
                "source": "女子霧ヶ峰登山記",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカ五カツ二三ヒコウベハツ、七カツ一ヒマルセーユチヤク」まだ退院せぬか。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それハ／＼実当時のヘボクレ役人や、あるいハムチヤクチヤをやぢの我国ヒイキ我家ヒイキにて、男子とし（て）の咄にあらず。",
              "citation": {
                "source": "手紙",
                "author": "文久三年六月十六日　池内蔵太の母あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "猶よろしくおしかり被下度、実ニヘチヤクチヤ別りかね候人なれバ、実に御気のどくニ存候。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十一月二十日　寺田屋お登勢あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "言わばマンチヤクだ。",
              "citation": {
                "source": "この握りめし",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　あひるさんはそれをきくと、メチヤクチヤに泣き出しました。",
              "citation": {
                "source": "お猫さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イチヤク草、昔から薬として此の一つの草があれば何にでも効くと考えたものです、故に一薬草です。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第二部　混混録",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつは、よその国はみんな泥坊だと決めてかかつたムチヤクチヤ議論だぞ。",
              "citation": {
                "source": "ぼたもち",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼と同時代の改革者ルーターは、馬鹿者は完全な天文学をメチヤクチャにすると当時の見解を表現した。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
