        "examples": {
          "standard": [
            {
              "text": "彼は国への忠愛を誓い、命を捧げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "犬は飼い主に対して深い忠愛を示す動物だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "忠愛の精神が、その組織を長年支えてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "国家に対する忠愛の熱情と国政に対する識見とに於て、生死を賭して所信を敢行する勇気とに於て、彼等のみが決して独占的の所有者ではない。",
              "citation": {
                "source": "二・二六事件に就て",
                "author": "河合栄治郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "万延以来、鹿児島の町人で郷士｜是枝柳右衛門を通じて薩州その他九州の尊攘派と連絡がついているので、中山｜忠愛卿の教旨を持たせて清河らを肥後に送った。",
              "citation": {
                "source": "新撰組",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "又熊沢蕃山の弟泉忠愛の妻は三成の孫に当っていたが、彼女は阿波国の人箕浦平左衛門の娘であって、平左衛門の妻は三成が娘であったと云う。",
              "citation": {
                "source": "聞書抄",
                "author": "第二盲目物語",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやもっと切実な忠愛と敬礼を捧げきって骨も細りゆく姿だった。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
