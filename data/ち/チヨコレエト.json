        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "桃太郎はその頃まだ男よりもチヨコレエトの方が好きな年頃だつたので、お座敷で客に惚れる程の冒険はしなかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしんば什※冒険好きな女でも、チヨコレエトの代りに男に惚れるやうな心得違はしない筈だ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "女といふものは、十人が十人、先づチヨコレエトを喰べて、それから徐々男に惚れるものなのだ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "空がごろごろ鳴り出すと、京都の女はチヨコレエトを食べさして、蚕のやうにぶるぶるつと身体を顫はせる。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘はチヨコレエトよりも、接吻よりも、一番「結婚」が好きらしい口もとをしてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸ひまだポケツトにはチヨコレエトの棒も残つてゐる。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は長椅子に寝ころんだままチヨコレエトの棒でも囓ることにしよう。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "』私はホテル・ド・ルウロオプで、子供達が、ミルクや、ココアや米や、フアリナや、白いパンや、チヨコレエトや、それから肉類をすらも食べてゐたのを見たのだ。",
              "citation": {
                "source": "子供の保護",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇　　　　　　　◇　日暦はチヨコレエトを増す。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナはチヨコレエトで化粧するのである。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々はそれを食べて豚の様に肥満するチヨコレエトの香りを放散するのである。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿の様に笑ふヲンナの顔には一夜の中にげにも美しくつやつやした岱赭色のチヨコレエトが無数に実つてしまつたからヲンナは遮二無二チヨコレエトを放射した。",
              "citation": {
                "source": "狂女の告白",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨコレエトは黒檀のサアベルを引摺りながら照明の合間合間に撃剣を試みても笑ふ。",
              "citation": {
                "source": "狂女の告白",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑ひが遂に飴の様にとろとろと粘つてチヨコレエトを食べてしまつて弾力剛気に富んだあらゆる標的は皆無用となり笑ひは粉々に砕かれても笑ふ。",
              "citation": {
                "source": "狂女の告白",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "羅漢は肥大してヲンナの子宮は雲母の様に膨れヲンナは石の様に固いチヨコレエトが食べたかつたのである。",
              "citation": {
                "source": "狂女の告白",
                "author": "李箱",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
