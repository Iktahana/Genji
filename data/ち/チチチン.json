          "literary": [
            {
              "text": "「チチーン、シャン、チチチ、チチチン。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲角の向うから、気狂いじみたチンドン屋の馬鹿騒ぎが、チチチンチチチンと聞えて来た。",
              "citation": {
                "source": "石塀幽霊",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "お藤はじっと眼を据えて、這いまわる尺取り虫を見つめながら、ツンツルルン、チチチン、チン……。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、たんと思召しを投げて頂戴ね」　みんなおもしろがって、「さあ、やんな、やんな」「お鳥目は、おいらがあとで集めてやらあ」「毎度おやかましゅう」三味線の手を休めたお藤、「ではお言葉にあまえまして、江戸名物は尺取り虫踊り……」　チチチン！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやさ話がよ、チチチンと、あれ寝たと言う寝ぬと言う、とまあ言ったわけで、あーっ、俺は恋しいや、深川はやぐら下。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやさ話がよ、チチチンと、あれ寝たという寝ぬという、とまあいった訳で、あーっ、俺は恋しいや、深川はやぐら下。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
