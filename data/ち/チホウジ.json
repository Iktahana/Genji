        "examples": {
          "standard": [
            {
              "text": "サマータイムを導入すると、地方時と標準時のずれが生じます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "かつて、日本でも各地域で異なる地方時が使われていた時代があったんですよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この古い時計は、正確な地方時を示していたと言われているよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "地方時務の多くは民の訴え事であるが、訴訟などはてんでほうりだしておくため、書類は山積して塵に埋まっている。",
              "citation": {
                "source": "三国志",
