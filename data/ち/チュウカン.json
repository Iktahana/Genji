        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "国際会議には、日本、中韓、そして欧米諸国からの代表者が集まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "最近、中韓関係は経済協力の面で進展を見せている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "歴史問題が、時に中韓間の外交に影を落とすことがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "中韓からこの道を進んだ奥詰まりに難波の宮を設けてみたこともある。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            }
          ]
        }
