        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まかり出でたるキチガイ坊主……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャカポコチャカポコ…………サアサ寄った寄った。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャカポコチャカポコ…………サッサ来た来た。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "来て見てビックリ……スチャラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャチャラカ、チャカポコ……　▼ア――あ――。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "スカラカ、チャカポコ外聞晒す。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "たたく木魚に尋ねてみたら……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャカポコチャカポコ……　▼ア――あ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏も素性もスカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "キチガ――ア――イ――地イ獄ウ――……スカラカ、チャカポコチャカポコチャカポコチャカポコ……　　　　　　　一　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……スカラカ、チャカポコチャカポコチャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きたながらのこの世の地獄じゃ……チャカポコチャカポコチャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナント恐ろしキチガイ地獄……チャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんじょ、そこらの地獄の話じゃ……チャカポコチャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
