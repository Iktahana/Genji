        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今の人でもおそらく年中悪い事ばかりはしていまい。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の中悪戯をして叱られると、内を駈出して、近所の馬鹿｜囃子の中へ紛込んで、チャチャチャッチキチッチッと躍っていると、追駈けて来た者が分らないで黙って見遁しては帰ったが、私の顔は今でもおかめの面に肖ているかといって、尋ねられたこともある。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "六に多言にて慎なく物いい過すは親類とも中悪く成り家乱るる物なれば去るべし。",
              "citation": {
                "source": "三つの「女大学」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母寵愛して恣に育ぬれば、夫の家に行て心ず気随にて夫に疏れ、又は舅の誨へ正ければ堪がたく思ひ舅を恨誹り、中悪敷成て終には追出され恥をさらす。",
              "citation": {
                "source": "女大学評論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "六に多言にて慎なく物いひ過すは、親類とも中悪く成り家乱るゝ物なれば去べし。",
              "citation": {
                "source": "女大学評論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "大伯父はしっかり者で頭の明かな人だったから好い様だったけれ共その夫になくなられて後このクタクタな年中悪酒に酔わされて居る様な頭の大伯母が一人で自分の老後の掛り児をなみなみに仕上げ様とする努力は実に普通の母親が三人子供を仕立てる位のものだった。",
              "citation": {
                "source": "千世子（二）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬来人やヒンヅ人が黒光のする体に黄巾赤帽を戴き、赤味の勝つた腰巻を纒つて居る風采は、極帯植物とに調和して中中悪くない。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モーセ在世中悪魔とは交際してゐなかつたから、死体についてかれこれ言はれることはない筈である。",
              "citation": {
                "source": "ミケル祭の聖者",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリスチャンには、大概、一種の被害妄想――ではない、自分も他人も年中悪を犯しているような、罪を犯してるような気がしている。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も途中悪口を言い／＼来たので敷居が高かったのかも知れない。",
              "citation": {
                "source": "好人物",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おなつは意識なしに云ったらしいが、自分は猿山の湯治場の者で、町から帰る途中悪者に遭って着ていた物を剥がれた。",
              "citation": {
                "source": "契りきぬ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道中悪にかどわかされて、そこへ、捨て売りにされただけに、素人くさいのと、武家出の女という事が、酉兵衛の心をうごかした。",
              "citation": {
                "source": "無宿人国記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は夜中悪夢にうなされ続けていたのだった。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は一晩中悪夢にうなされ、その夢と昨夜の出来事とが混り合って、どこまでが現実でどこまでが夢だか、よく分らない気持だった。",
              "citation": {
                "source": "一寸法師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
