        "examples": {
          "standard": [
            {
              "text": "濃厚なチェダーの風味がたまらない、贅沢なマカロニチーズを夕食に作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ハンバーガーのパティの上で、溶け出したオレンジ色のチェダーが食欲をそそる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ポップコーンにチェダーのパウダーをまぶして、映画鑑賞のお供にするのが定番だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "チーズは、チェダー・チーズでもいい。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとかたまりのチェダー・チーズにやはりウースター・ソースをかけて食べ、仕上げはコーヒーだ。",
              "citation": {
                "source": "頬よせてホノルル",
