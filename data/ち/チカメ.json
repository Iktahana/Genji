  {
    "uuid": "9ba9d83c-37cb-55c5-9061-8c845b773016",
    "entry": "近目",
    "reading": {
      "primary": "ちかめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
