        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "其でも、山の鬼神、野の魍魎を避ける爲の燈の渦が、ぼうと梁に張り渡した頂板に搖めいて居るのが、たのもしい氣を深めた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯、姫の仰ぎ寢る頂板に、あゝ、水にさし入つた月。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "現にあれほど、郎女の心を有頂天に引き上げた頂板の面の光り輪にすら、明盲ひのやうに、注意は惹かれなくなつてゐる。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "現にあれほど、郎女の心を有頂天に引き上げた頂板の面の光り輪にすら、明盲ひのやうに、注意は惹かれなくなつた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其でも、山の鬼神、野の魍魎を避ける為の燈の渦が、ぼうと梁に張り渡した頂板に揺らめいて居るのが頼もしい気を深めた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯、姫の仰ぎ寝る頂板に、あゝ水にさし入つた月。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "現にあれほど、郎女の心を有頂天に引き上げた頂板の面の光輪にすら、明盲ひのやうに、注意は惹かれなくなつた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "其でも、山の鬼神、野の魍魎を避ける為の灯の渦が、ぼうと梁に張り渡した頂板に揺めいて居るのが、たのもしい気を深めた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯、姫の仰ぎ寝る頂板に、あゝ、水にさし入つた月。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯、姫の仰ぎ寝る頂板に、ああ、水にさし入った月。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
