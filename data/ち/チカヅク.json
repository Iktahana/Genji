[
  {
    "uuid": "16ceaa4d-9bd8-55f5-a7aa-c483efecbffb",
    "entry": "近づく",
    "reading": {
      "primary": "ちかづく",
      "alternatives": [
        "ちかずく"
      ],
      "is_heteronym": true
    },
    "grammar": {
