          "literary": [
            {
              "text": "寺男までが南京織の夏ズボンと、縞目のある手編のチョツキを新調しをる。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はフロックを著てゐたが、ネクタイもチョツキもズボン釣りもつけてゐなかつた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルザックはチョツキ一面に宝石をちりばめてゐたといふ。",
              "citation": {
                "source": "ネクタイとステッキ",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
