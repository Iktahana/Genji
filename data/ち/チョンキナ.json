          "literary": [
            {
              "text": "「ちょんきな、ちょんきな、ちょんちょん、きなきな。",
              "citation": {
                "source": "長い名",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "満腹して、ビクターへ寄り、中山晋平氏に「東京ちょんきな」を習ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "中山氏が「東京ちょんきな」を弾いて呉れて声を出してみたが、まだはっきり治ってゐないので、吹込は二十七日の予定だが延さうと話す。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "樋口が来て重役連が「さらば」に不賛成だから変へろと言ふ由、しゃくだが仕方ない、ビクターへかけつけて、「東京ちょんきな」のレヴィウ化を決定した。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時起き、伊藤松雄訪問、「東京ちょんきな」のヴァラエティ台本を引受けて貰ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「東京ちょんきな」のテスト盤きいた、失望した。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ「東京ちょんきな」の台本が出来て来たので、それを読むと、伊藤松雄のとこへ行き、色々話す。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "明るくなって、ベッドと来ては大苦手だ、まるでねられず入浴して、「東京ちょんきな」の手入れをしてゐると、川島が「大久保彦左衛門」の本が出来たからと、来り、本読みをして呉れた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京から「東京ちょんきな」打合せのため、わざ／″＼遠山静雄氏来名、打合せ終って、ウイスキーのみ乍らのすきやき食ひ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「東京ちょんきな」のレコードは明日発売、これの振りが出来たのを、芸妓が踊ってみせた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "又小劇場へ帰り、「東京ちょんきな」を立つ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月二十八日（火曜）　ゆっくりねるつもりが十時に起きたので「東京ちょんきな」のレコードをきく。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二時から五階で「東京ちょんきな」を立ち、有楽座四階楽屋で「青春音頭」を立つ、電通地下食堂へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月三十日（木曜）　十一時半から舞台けい古だが、とても時間通りに行く筈はない、電話で連絡とっといて、伊藤松雄のところへ「東京ちょんきな」作料として二百円持って行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この分では夜明しは明々の事、腰を据えて、「東京ちょんきな」にかゝる、午前六時。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "道具の出来るのを待って「東京ちょんきな」にかゝった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょんきな」も思ひの外受けて文句なし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょんきな」はお粗末乍ら受ける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょんきな」気持よく歌ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時楽屋入り、マダムを終へ、「ちょんきな」済み、「大久保」でくさる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "樋口と相談して、六月一日から日劇で「東京ちょんきな」をやり、これは僕抜きにして貰って、色々準備することにしたいので、社長宛に手紙書くことにした。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木静一来訪、「ちょんきな」の売行きは宣伝程になるまいと言ってる、さうかも知れん。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょんきな」済んで、ホッとして入浴。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "日劇アトラクション「東京ちょんきな」の舞台けい古である。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょんきな」を又見て、ダメをうんと出す。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「東京ちょんきな」いゝ塩梅、ダレもせずにやってゐる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日放送局より六日のひるに、海外放送として「東京ちょんきな」をやるからとのこと、その本をラヂオ用に直す。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めての海外放送、「東京ちょんきな」をやる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三時、「東京ちょんきな」の放送テスト、此の間海外放送でやったし、感激少しもなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
