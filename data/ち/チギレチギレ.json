    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夕映えの色も常に異なった暗黄色を帯びて物凄いと思う間に、それも消えて、暮れかかる濃鼠の空を、ちぎれちぎれの綿雲は悪夢のように果てもなく沖から襲うて来る。",
              "citation": {
                "source": "嵐",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "真黒な影法師のちぎれちぎれな襤褸を被て、茶色の毛のすくすくと蔽われかかる額のあたりに、皺手を合わせて、真俯向けに此方を拝んだ這身の婆は、坂下の藪の姉様であった。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "藁を分けた艶なる片袖、浅葱の褄が船からこぼれて、その浴衣の染、その扱帯、その黒髪も、その手足も、ちぎれちぎれになったかと、砂に倒れた婦人の姿。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "程もあらせず、むっくりと湧いて来て、ふいと行くと、いつの間にか、草の上へちぎれちぎれに幾つも出る。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "泉を繞る木々の梢には、今まで立ち籠めていた靄が、まだちぎれちぎれになって残っている。",
              "citation": {
                "source": "杯",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "神湊海岸砂にあしあとのどこまでつづく晴れるほどに曇るほどに波のたはむれゆく春の夜のどこかで時計鳴る遠く来てひでり雲ちぎれちぎれ六月一日　曇。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "文六ちゃんは話が下手ですから、ちぎれちぎれに話をします。",
              "citation": {
                "source": "狐",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　　　　　＊　　　　　＊　形而上学と云ふ、和蘭寺院楽の諧律のやうな組立てに倦んだ自分の耳に、或時ちぎれちぎれの Aphorismen の旋律が聞えて来た。",
              "citation": {
                "source": "妄想",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "声が次第に遠ざかつて往つて、最後の一句がちぎれちぎれに、やがて聞えなくなつたと思ふころには、鶴の影は漸く小さく、またかすけく、つひに見られなくなつてしまつた。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "見上げれば、ちぎれちぎれの綿のような雲も浮んで、いつの間にか青空に成りました。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "その理由としては、山が高くて、気圧の衝突から雲はちぎれちぎれに成るという説明をも加えてくれた。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "白いちぎれちぎれの雲が風に送られて通る。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "急に日があたってきたかと思うと、ちぎれちぎれの綿のような雲も浮かんで、いつのまにか青空が見られます。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "元三の小屋から呶鳴るような歌声がちぎれちぎれに響いて来る。",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "見上げれば、ちぎれちぎれの綿のような雲も浮んで、いつの間にか青空になりました。",
              "citation": {
                "source": "藁草履",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "藍色を漂わす大空にはまだ消えやらぬ薄靄のちぎれちぎれにたなびきて、晴れやかなる朝の光はあらゆるものに流るるなり。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "このゆえにちぎれちぎれの刹那に立って、個々の断片的なる官能的経験を漁りつつ生活の倦怠より遁れんとする刹那主義者はしばらく措き、いやしくも全部生命（whole being）の本然的要求の声に傾聴して統一せる人格的生活を開拓せんとする真摯なる個人は必ず芸術とともに哲学をも要求せずにはいられない。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の記憶はおぼろでそしてちぎれちぎれだ。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "身を切るような北風が、ちぎれちぎれの灰色の雨雲をひくくはわせておりました。",
              "citation": {
                "source": "アッタレーア・プリンケプス",
                "author": "ATTALEA PRINCEPS",
                "note": "青空文庫"
              }
            },
            {
              "text": "次郎は、この廃都をわが物顔に、十二十と頭をそろえて、血のにおいに飢えて歩く、獰猛な野犬の群れが、ここに捨ててあった疫病の女を、宵のうちから餌食にして、互いに牙をかみながら、そのちぎれちぎれな肉や骨を、奪い合っているところへ、来たのである。",
              "citation": {
                "source": "偸盗",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "火の玉が上って来るに連れて、体中が、ちぎれちぎれに裂けてしまいそうだ。",
              "citation": {
                "source": "日は輝けり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはまるで腹の底からこみ上げて来る哄笑が、喉と唇とに堰かれながら、しかも猶可笑しさに堪へ兼ねて、ちぎれちぎれに鼻の孔から、迸つて来るやうな声であつた。",
              "citation": {
                "source": "枯野抄",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "通り雨ちぎれちぎれの雲見れば、風ある空もむしやくしやとむか腹立てて泣きたいか。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋の展覧会や、多くの紳士淑女や、かと思うと暗いしるこ屋の一隅や、鉄道の踏切やまた母の顔や見も知らぬ恋びとの姿や、ちぎれちぎれのそれ等の情景は、皆悲しい色彩をもって明滅した。",
              "citation": {
                "source": "自殺を買う話",
                "author": "橋本五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何時の間にかついた電燈の淡い光りが、彼等の思いをちぎれちぎれに遠い空間へ運んでいった。",
              "citation": {
                "source": "恩人",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝曇り後晴れて、海のように深碧に凪いだ空に、昼過ぎて、白い雲が頻りにちぎれちぎれに飛んだ。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、アリョーシャのそばへ飛んで来た男は、いきなり、ぐるりと踵で、娘のほうへ身をかわして、興奮して、妙にちぎれちぎれな調子で答えた。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして長いこと幾時間も幾時間も、絶えず一つの想念がちぎれちぎれに彼の夢を訪れた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
