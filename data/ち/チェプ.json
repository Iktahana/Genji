        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ねえ、〔ma che`re〕（いとしいかた）、あたしチェプロフ樣の何處がそんなに好いのか、さつぱり譯がわからないわ。",
              "citation": {
                "source": "狂人日記",
                "author": "ZAPISKI SUMASHEDSHAWO",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんの、チェプロフなんぞにさう易々あの方を首つたけにさせることが出來て堪るもんか。",
              "citation": {
                "source": "狂人日記",
                "author": "ZAPISKI SUMASHEDSHAWO",
                "note": "青空文庫"
              }
            },
            {
              "text": "シチェプキナさんに会うことが出来、ブブノワさんからの土産を渡し、やっと安心した。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "シチェプキナさんのところへゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　動物の名づけ方に見られる二つの立場　以上の如く、鮭のことお、「志ぺ」とも、「カむィ・チェプ」とも、言うのであるが、この二つわ、実わ、異なる立場から名づけられた名称である。",
              "citation": {
                "source": "和人わ舟お食う",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを“ペウレチェプ・エカノク・イノミ”（pewrechep-ekanok-inomi 走りの鮭を・迎える・祭）と申しました。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
