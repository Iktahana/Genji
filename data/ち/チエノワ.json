        "examples": {
          "standard": [
            {
              "text": "なかなか解けない知恵の輪に、彼は夢中になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "友人からもらった知恵の輪を、一日中格闘してようやく解いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「この知恵の輪、どうやったら外れるんだろう？」と首を傾げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それは、おそらく知恵の輪の仕掛けになっていたのだろう。",
              "citation": {
                "source": "蘭学事始",
                "author": "菊池寛",
