        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "するとそれは、チヨコレートででもできてゐるやうに、すつときれいにはなれました。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨコレートよりも、もつとおいしいけれども、こんな雁が飛んでゐるもんか。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "開いた紙障子の方から現はれた顏はチヨコレート色の目鼻立の正しい印度人の男の顏であつた。",
              "citation": {
                "source": "秋雨の追憶",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は一日に一度は、背廣を着込んで銀座に現れたが、通學の時の服裝は上衣が學生服に代るだけで折目のキチンとした色變りのズボンに、靴は赤か、白にチヨコレートいろの模樣のあるものなどで、上衣の袖口からは水いろのワイシヤツの袖が長くはみ出てゐた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから子供のやうにチヨコレートを舐つて、淫売婦のやうに強い煙草を吸つた。",
              "citation": {
                "source": "浪の音",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨコレートの包みや、菓子の壜が大小幾箇も出た。",
              "citation": {
                "source": "青い風",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなはチヨコレートを食べた。",
              "citation": {
                "source": "青い風",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　チヨコレートを摘みながら、彼等は土地と人との話に夜をふかした。",
              "citation": {
                "source": "青い風",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "園丁来りて踏板の上に並べほしたる靴ぬぎの汚れたる毛をはたく、チヨコレートの如き埃立つ。",
              "citation": {
                "source": "春の暗示",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "園丁来りて踏板の上に並べほしたる靴ぬぎの汚ごれたる毛をはたく、チヨコレートの如き埃立つ。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助は手を敲いて婆さんを呼んで、「誠太郎、チヨコレートを飲むかい」と聞いた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「飲む」　代助はチヨコレートを二杯命じて置いて誠太郎に調戯だした。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから今チヨコレートを飲まして遣るから可いぢやないか」「チヨコレートなんぞ」「飲まないかい」「飲む事は飲むけれども」　誠太郎の注文を能く聞いて見ると、相撲が始まつたら、回向院へ連れて行つて、正面の最上等の所で見物させろといふのであつた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、伊三郎氏は丁度口に頬張つてゐたチヨコレートをぐつと鵜飲みにして、「そんなに他の懐中勘定を訊くのは、初めて結婚した男に、『おい、何うだつたい、花嫁さんの……』と訊くやうなものぢやないか。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨコレート兵隊以來フアストの惡魔以來、伊庭君の舞臺を知らない私も、徳子との噂も、演伎座のいきさつも風のたよりには聞いてゐたけれど、かうした旅先きでこんな芝居を見るのも不思議な氣がします。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "こつち同樣のチヨコレートのやうな百姓家の頭が、地平線から浮かんでぼつ／＼見えた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨコレートの中へ飛び込む女。",
              "citation": {
                "source": "七階の運動",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに彼女の動作は極めて不しだらであつて、本を読みながらものべつにチヨコレートを貪り、煙草を喫し、脱棄てたものはその辺にほうり放しにして置くし、大きなヴアニテイ・ケースなどを持込んで来ても使ひ放しで出て行つてしまふといふ風で、私は非常に閉口したのです。",
              "citation": {
                "source": "早春のひところ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、慌しく幾人もの人達が次々に降りて来てローラの額やら頬やら唇に激しい接吻の雨を浴せてチヨコレートの包や花束などでローラの胸を埋めた。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴女が楽しみにして食べるのよつて下すつた、犬のチヨコレートを、ちよいちよい嘗めてゐるうちに前の兵隊さんが、私の足の甲をそつと踏みます。",
              "citation": {
                "source": "谷間からの手紙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これ‥‥」　さう言つて、富士山の模様の風呂敷から、萄葡と固パンを出して私の膝に載つけましたので、私はチヨコレートの犬の尻つぽをお返しにしました。",
              "citation": {
                "source": "谷間からの手紙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇兄さんのお描きなつた海の風景と、チヨコレートにボンボン、コテイのオークルジヨン、雑誌が二冊、とても私の嬉しさ楽しさ、空想してみて下さい。",
              "citation": {
                "source": "谷間からの手紙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨコレートは楽しみに長く食べませう。",
              "citation": {
                "source": "谷間からの手紙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボストンバツクに、外国煙草や化粧品や、チヨコレートや、サツカリン、電気剃刀、砂糖、そんなものを詰め込んで、知りあひをたぐつては、売り込みに行く。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々、父や隆吉の留守を見計つては、直吉は、継母にだけ売り物のチヨコレートを与える。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あめやさん村山籌子きみ　には　ボンボン、きみ　には　チヨコレート、きみ　には　キヤンデイ、きみ　には　キヤラメルをあげよう、さあいくらでももつてゆきたまへ。",
              "citation": {
                "source": "あめやさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お三時のチヨコレートを戸棚の中に入れておきますよ。",
              "citation": {
                "source": "お猫さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（腰を卸ろす）留雄　　（立つたまま）チヨコレートはまだあつたか知ら。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども洋人を見れば、ぞろ／＼其の後についてチヨコレートを貰はうとする子供を憎むまい。",
              "citation": {
                "source": "冬日の窓",
                "author": "永井壮吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
