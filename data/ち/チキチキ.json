          "literary": [
            {
              "text": "ちゃんちきちき面白そうに囃すかと思うと、急に修羅太鼓を摺鉦交り、どどんじゃじゃんと鳴らす。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々、きちきちきちきちという。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭のうしろがちきちき痛んだ。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ足もとのくさむらから小鳥が飛んで出て、チキチキと、かん高い聲をたてて、少年の後の山のあちらの空へ入つてゆきました。",
              "citation": {
                "source": "動物列車",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "キチキチキチ……と青い螽が信長の姿に飛び交う。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い翅の虫が、キチキチキチキチと、鹿之介の身をめぐっていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
