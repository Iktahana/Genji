[
  {
    "uuid": "10de7648-e794-5077-ba6f-5abae2f168bb",
    "entry": "地中",
    "reading": {
      "primary": "ちちゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
