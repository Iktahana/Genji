        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "高価なネクタイだのチェッコスロバキヤの硝子細工だのを売る店の様子は戦争に行く前とちっとも変っていませんでした。",
              "citation": {
                "source": "兵士と女優",
                "author": "オン・ワタナベ（渡辺温）",
                "note": "青空文庫"
              }
            },
            {
              "text": "人造人間をロボットというのは、チェッコスロバキヤの劇作家が一つの小説を書いたが、その中にロボットと名付ける一人の人物が登場するが、それがあとの方になって、本当の人間ではなく、実は機械人間だということが知れる。",
              "citation": {
                "source": "人造物語",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕　茶　キューリ、ハム、マースロ、パン 7.10　午後七時二十分　ワルシャワ五月二日　小雨　チェッコスロ※キアへ入る。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちじにプラーグへつめかけたこれらの旅客は、みんな翌日から開会されるチェッコスロヴァキア第一回工業博覧会へ来た人々だった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この有様じゃ、何とも仕様がないわね」　チェッコスロヴァキアの工業博覧会は、向う二ヵ月の予定で開催されているのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェッコスロヴァキア戦線へ派遣された。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『わたくしは今朝チェッコスロバキヤから着きましたもので。",
              "citation": {
                "source": "踊る地平線",
                "author": "黄と白の群像",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしたらチェッコスロヴァキア公使館の別莊の中から快活なピアノの音が聞えてきた。",
              "citation": {
                "source": "手紙",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまから五年前（一九三五年）に、チェッコスロヴァキアの建築家アントニン・レイモンド氏が設計して建立したもの。",
              "citation": {
                "source": "木の十字架",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "著者は昭和二年九月チェッコスロバキア國の首府プラーグに於ける地震學科の國際會議に於て、此問題に關するわが國最近の研究結果につき報告するところがあつたが、列席の各員は著者が簡單に演述した大地震前徴につき更に詳細な説明を求められ、頗る滿足の態に見受けた。",
              "citation": {
                "source": "地震の話",
                "author": "今村明恒",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇　ドイツとチェッコスロヴァキアの国境をなすリーゼンゲビルゲに行ったのも、思えば昔のことである。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
