        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "次ぎのランナーは、みんな年が若かつたので、元気にまかせて、担いでゐるのが肥えの筈であることを忘れて、ポチャポチャやりながら駆け出し疾走し始めた。",
              "citation": {
                "source": "運動会の風景",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その音がカンカンと響きまして、チャポンチャポンと何だか水に飛びこむ物があります。",
              "citation": {
                "source": "思い出の記",
                "author": "小泉節子",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車の絵をかかせるのですが、何故だか、チッチャポッポが大好きです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワカルパアチャポの事をうかゞって思はず涙にくれる。",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワカルパアチャポ、ワカルパアチャポ……あいぬは滅びるか。",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポチャポチャッと可愛いとこがあらア。",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし正面の水田の中三、四ヶ所で稲が動いてポチャポチャ水の音がするのは、三、四人の人間が泥掻きと草取りをやっているらしい。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし正面の水田の中三、四ヵ所で稲が動いてポチャポチャ水の音がするのは、三、四人の人間が泥掻きと草取りをやっているらしい。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「とりすましたヒネクレ女め、体温まで冷いのじゃないか」「イヤア、案外モチハダか何かで、ポチャポチャあったかいかも知れませんや」　と巨勢博士が処女趣味に似合わしからぬ言辞を弄して、御婦人連をビックリさせた。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの娘が井戸端へ出ると、長屋中まるで御来迎を拝むような騒ぎで」「――」「色白で、ポチャポチャして愛嬌があって、無口なのが玉に疵だが――」「それがどうしたんだ、九尾の狐の化けたのか何んか――」「冗談言っちゃいけませんそんな檜扇で品をつくる代物じゃありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "猿回し",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャポ、チャポと、洗った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "金五郎は、相かわらず、二本の日本刀を、大盤の水で、チャポン、チャポン、鳴らしながら、ときどき、表を見る。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "色白の眼の細い、恐ろしくポチャポチャした娘ですが、美人というには少し縁が遠過ぎます。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "暴君の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポチャポチャして可愛らしくて、若い男の心をひしと掴まずにはおかない――という噂のお浜が、この物に怯えて雁皮紙のように顫えている娘とは思いもよりません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "九百九十両",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝日湯の番台の親爺に訊くと、亥刻（十時）少し前にやって来て、自慢の喉で新内を唸りながら半刻（一時間）ばかりポチャポチャやっていたって言いますぜ」「人でも殺そうというほどの野郎なら、わざと半刻ぐらいは下手な新内でも唸っているだろう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "雪の精",
                "note": "青空文庫"
              }
            },
            {
              "text": "五色の雪の吹雪の中で、白いのや黒いのや、筋ばったのやポチャポチャしたのや、男女様々の肉塊共が、タラタラと血を流しながら、断末魔の手拍子、足拍子面白く、美しくも物凄き気違い踊りを踊り抜いたのである。",
              "citation": {
                "source": "地獄風景",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
