          "literary": [
            {
              "text": "……チチチチチチチ……クリクリクリクリクリクリ……チチ……　という小鳥の群が、松の間を渡る声が聞えるばかり……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "風が出て来て、カナリアのチイチイチイ、チチチチチというメロディアスな声を吹きちぎります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっきりした茶色の幹を輝かして立って居る一群の木々の間からは真紅の小さい葉どもがチラチラして、その奥の奥からはチチチチチ、チチチチチと云う小鳥の声があっちにゆったり落着いて居る山の方まで響いて行く。",
              "citation": {
                "source": "追憶",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チチチチチ野に啼く声も稚く聞えて耳に寒い。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
