    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "茶筌でお茶を掻き廻しているような音でもあるが、どうも、それにしてはひどく乱暴な騒々しい音である。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら茶筌でかきまわしても、うまい具合いに泡が立たないのだ。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　先生は、力のかぎりめちゃくちゃに茶筌で掻きまわしたものらしく、三畳間は薄茶の飛沫だらけで、そうして、しくじってはそれを洗面器にぶちまけていたものらしく、三畳間のまん中に洗面器が置かれてあって、それには緑の薄茶が一ぱいたまっていた。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "所詮は鬼武の「自来也物語」を焼き直したものであるが、主人公の盗賊児雷也を前茶筌の優姿にして、田舎源氏の光氏式に描かせた趣向がひどく人気に投じたらしい。",
              "citation": {
                "source": "自来也の話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "長柄の太刀脇差を三五縄でぐるぐる巻にし、茶筌にゆった髪は、乱れたままである上に袴もはかないと云う有様である。",
              "citation": {
                "source": "桶狭間合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "織田信長が聟入をするとき頭の髪を茶筌に結ったと云うがその節用いたのは、たしかそんな紐だよ」と迷亭の文句はあいかわらず長い。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪を茶筌に結った色白の美男である。",
              "citation": {
                "source": "藤十郎の恋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は茶筌の音を聞いて、ふと真夜中に眼を醒ました。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪は、戦国風の太茶筌。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いらっしゃいませ」　茶筌頭の五十｜爺、真鍮縁の丸眼鏡を額部へ掛けているのを忘れてあわててそこらをなでまわす。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "由緒ある者の果てであろうことは、刀剣類に眼が肥えているのでも知れるし、茶筌髪のせいか、槍はさびても名はさびぬ、そういったような風格が閑山のどこかに漂っている。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪を茶筌に取り上げて、練絹の小袖を纏っている。",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結綿、割唐子、めおと髷、唐人髷、蝶々、文金高島田、島田崩し、投島田、奴島田、天神ふくら雀、おたらい、銀杏返し、長船、おばこ、兵庫、勝山丸髷、三つ輪、芸妓結、茶筌、達磨返し、しゃこ、切髪、芸子髷、かつら下、久米三髷、新橋形丸髷。",
              "citation": {
                "source": "髷",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな日の午前、紫の竜紋の袷の被衣を脱いで、茶筌のさきを二ツに割っただけの、鬘下地に結った、面長な、下ぶくれの、品の好い彼女は、好い恰好をした、高い鼻をうつむけて、そのころ趣味をもった、サビタや、メションや琥珀のパイプを、並べて磨いている。",
              "citation": {
                "source": "市川九女八",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "白髪を後茶筌に束ねた白髯の老翁。",
              "citation": {
                "source": "怪異黒姫おろし",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "生前は薄い頭髪を茶筌に結っていましたが、幽界で私の許に訪れた時は、意外にもすっかり頭顱を丸めて居りました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭髪は茶筌に結っていました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十何歳かからは茶道に親しみ、茶筌を手にするすべを覚えて、爾来、それを続けて現在屈指の大茶人として認識されるに至っている、今日、七十七歳で矍鑠と好者生活を続ける根津さんは通常一片の美的趣味家ではない。",
              "citation": {
                "source": "現代能書批評",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "屏風の面には片耳のない茶筌髪の首が大きな影を落し、それをうしろに背負っている主の顔は、光線の加減で兎唇のところが洞穴のように凹んで見え、あたりに鬼気を発散して、桔梗の方の妖精じみた美しさ迄が何か此の世のものでないように凄じい。",
              "citation": {
                "source": "武州公秘話",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹針の蚕婆一　うえの羽織は、紺地錦へはなやかな桐散し、太刀は黄金づくり、草色の革たびをはき、茶筌髷はむらさきの糸でむすぶ。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪は油の光もない茶筌に結び、色浅黒く爛々たる眼は七万石の主公随臣を睥睨して垢じみた黒紋服に太骨の鉄扇を右手に握り、左の手は胸までそよぐ顎髯を扱いて悠々然と座に着いた。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギラリと輝く明眸、茶筌に結い上げた逞しい赭顔が現われる。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "信長は、和を容れて、具教の助命を認めたが、後年また、北畠父子が叛いたので、その機会をとらえて、信長の次男の茶筌丸――後の信雄を、北畠家へ養子に入れ、三男の信孝を、神戸具盛の後継ぎにすえ、伊勢八郡は名実ともに、彼の版図に収められてしまった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "否とよわれの持つものは鑓の穂先に織田が首織田信長が茶筌首。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶柄杓のぶっ違いの中央に、一丈ばかりの銀色の大茶筌、紅白の吹流しで風流なところが妙。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の茶の湯に用いるのではなくササラのような茶筌で茶の花をたて、御飯やら煮豆やら漬物等を少し入れて飲むのである。",
              "citation": {
                "source": "雲石紀行",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶せんに結った色白の面は、四十を越した男とは、思われぬ程の美しさに輝いて見えた。",
              "citation": {
                "source": "藤十郎の恋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "信長どのは橋の下の泥亀ひょいと出て、ひっ込みひょいと出て、ひっ込み首わざの巧さよこんど出たら取ろ茶せん首　どっと笑う。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ただ飲むは好きというだけのことで」「結構じゃ」　三河守は、茶わんを置き茶せんをそそぎ、女性のような細心な点前を静かにつづけている。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "福島・宮城ではこれを笠鳥とも茶せん子とも呼んでいる。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
