        "examples": {
          "standard": [
            {
              "text": "チョウ目には、美しい蝶や蛾の仲間が多数含まれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昆虫図鑑で、様々なチョウ目の昆虫を観察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "チョウ目の幼虫は、植物の葉を食べるものが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ちょうもくれば、みつばちもやってきたのです。",
              "citation": {
                "source": "花と人の話",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
