        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ガチャンガチャンと妹が縁先の小さい池に食器類を投入する音が聞えた。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし昼間は、あの遠い所でする妙な音はいろいろな周囲の雑音に消されてしまうのか、ただすぐ自分の室のすみでガチャンガチャンと鳴るきわめて平凡で騒々しい、いくらか滑稽味さえ帯びた音だけが聞こえる。",
              "citation": {
                "source": "病院の夜明けの物音",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同時に、　……ガラガラガラガラ……ガチャンガチャン……パーン……パチーン……　という激しい物音が、引き続いて私の足の下に起った。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムネイタイノ、ト君チャンガキクト、イヤト頭ヲフルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルバン、君チャンガ何カニビックリサレタヨウニ、フト目ヲサマシタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ、カイダンヲオチテ、ウチドコロガワルクテ、君チャンガネコンデシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣キナガラ、君チャンガ云ッタワ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "――靴音はだんだん遠のいて、次の室を明けるらしいガチャンガチャンという音が聞えてきた。",
              "citation": {
                "source": "鍵から抜け出した女",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいてガチャンガチャンと大きなレンズが壊れて、頑丈なケースが、薪でも割るようにメリメリと引裂かれる。",
              "citation": {
                "source": "赤外線男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "俄かに二階で、瀬戸物をひっくりかえしたようなガチャンガチャンという物音が聞えてきました。",
              "citation": {
                "source": "崩れる鬼影",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "人造人間が動きだしたぞ」「こっちへどいた」　ガチャンガチャンと金属音を発して、人造人間は函の中から一歩外に出た。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはなぜです」「あの肉体も精神も弱いルナミは、音楽浴にすっかりのぼせ上ってしまって、観測などをするどころか、咽が裂けるような声で愛国歌を唄っては天文部の貴重な器機を片ッ端からスパナーでガチャンガチャン壊しては暴れ廻っています。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝まだ眠いのに家でガッチャンガッチャン、裏の長屋でガッチャンガッチャン。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂上の屋敷へも鉄棒でガチャンガチャンと地面を打って脅かす奴を真先にいずれも酒気を吐いてワッショイワッショイと神輿を担ぎ込む。",
              "citation": {
                "source": "山の手の子",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンガアヽ仰ッシャルノモ無理ナイワ」ト颯子ガ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――近頃ハ伯父サン、オ見受ケシタトコロ大層オ元気デ」「ナーニダン／＼老イ惚レガ激シクナッテネ、毎日颯子ニ叱ラレテバカリイルヨ」「イヤ、イツマデモオ若イッテ、颯チャンガ感心シテマスガ」「飛ンデモナイ、今日モコウヤッテ鍼ナンカシテ貰ッテ、辛ウジテ露命ヲツナイデルノサ」「ソンナコトガアルモンデスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今マデ颯チャンガソンナ石ヲ持ッテタノヲ、オ婆チャンモ見タコトハナイト仰ッシャイマスシ、アタシモ知リマセンケレドモ、イツアンナモノヲ買ッタンデゴザイマショウネ」「………」「ソウ云エバ岸サンガ総理大臣ダッタ時、佛印カ何処カデキャッツ・アイヲ買ッテ問題ニナッタコトガアリマシタッケネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハアタシノ想像ダケレドモ、颯チャンガ立ッテ行ッタノハ外ニ何カ、早ク東京ニ帰リタイ理由ガアッタノデハナカロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、吉雄さんは、もし自分が番をしなかったら、だれか、考えなしに、この家の前で、大きな声を出して、正ちゃんの目をさまさないものでもないと考えたから、大急ぎで、自分の家へ帰って、半紙に、「コノ家ノ、小サイ正チャンガ、ビョウキデスカラ、シズカニ前ヲトオッテクダサイ。",
              "citation": {
                "source": "幼き日",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、ガチャンガチャンというやかましい音がしたかとおもうと、人魚どもの腹のところが、二つにわれて、その中から、はだかの人間がとび出してきました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "道も悪いが、ジープとは、こんなに古くなって、こんなに乱暴に運転しても、こんなに頑丈な物なり、という立証みたいにガチャンガチャンと揺れ轟く。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
