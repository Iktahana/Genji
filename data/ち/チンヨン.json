          "literary": [
            {
              "text": "矢崎鎮四郎を春廼舎に紹介したのもやはり二葉亭であった。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の三人のうちの一人は、田山の細君の兄さんの太田玉茗という坊さん、もう一人は嵯峨廼舎御室といって、後に二葉亭四迷などとロシア文学の研究をし、割におそくまで文筆活動をしていた矢崎鎮四郎である。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "坪内雄藏君が春の屋おぼろで、矢崎鎭四郎君が嵯峨の屋おむろで、長谷川辰之助君も二葉亭四迷である。",
              "citation": {
                "source": "長谷川辰之助",
                "author": "森林太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
