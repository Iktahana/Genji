          "literary": [
            {
              "text": "長期契約はいずれのためにもよくない。",
              "citation": {
                "source": "映画界手近の問題",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大戦後はオーストリアも共和国になって、伝統的な貴族、上流人の社交界がすたれてしまったために、シーズンが終るといっしょにウィーンの有名な音楽家たちは、アメリカへ長期契約で演奏旅行をするようになった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "売れゆきがよければ、その店とだけ長期契約をするといい、鮒と鯉と、二つの容器と背負い籠とを、かなり安価に手に入れたのだ。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
