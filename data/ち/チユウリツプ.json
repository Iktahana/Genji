        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "六時のサイレンが鳴つてから、学校の宿直室に樹明君を訪ねる、いつもにかはらぬ顔を見て安心した（チユウリツプの球根が身代りになつたらしい！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちつとも来ないから、姉さんは心配してたよ、」　庭の先には花壇があつて、チユウリツプや桜草などが綺麗に咲いて、午後の赤味の強い陽が其処にあつた。",
              "citation": {
                "source": "海異志",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チユウリツプの鉢をもつて、「塚越」が「私」を訪れる処も現れた。",
              "citation": {
                "source": "塚越の話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『さう、ぢやああたしチユウリツプがほしいの。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "『あたしもチユウリツプよ。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　と、他の二人もチユウリツプの註文をした。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "何を隠さう、彼はチユウリツプの花を知らなかつた。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "『チユウリツプ、チユウリツプ、きいたやうな名だが……。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　と決心がつくと、やをらしん粉に手をかけて、またゝく暇に植木鉢に三杯、チユウリツプ　？",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それは、むろん狐光老とつさに創作したところのチユウリツプで、桃の花とも桜の花ともつかない、実にへんてこな花であつた。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうみてもほんものゝのチユウリツプそつくりだらう。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "『チユウリツプ……一体どんな花だらう？",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、『チユウリツプはあるかい？",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、すぐ店の者がチユウリツプを持つて来た。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその晩、彼はチユウリツプの花の造り方に就いておそくまで研究した。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして十杯あまり、大鉢のチユウリツプを造つて、屋台の上段へ、ずらり、人目をひくやうに並べておいた。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、彼女達は、早くも棚のチユウリツプに目をつけて、『あら、チユウリツプがあるわ。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "『小父さん、これチユウリツプつていふのよ。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "』といふ顔つきで、『あゝチユウリツプといふんだよ。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "女生徒達はけげんさうに、『でも小父さん、昨日あたし達に拵へてくれたチユウリツプ、とても変な花だつたわ。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "このチユウリツプでよけりやあ、みんなで沢山持つておいで。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、嬢ちやん方は、昨日みたいなチユウリツプをまだ学校でならはなかつたかね。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなチユウリツプつて……。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、狐光老は、『ありやあお前、あつちのチユウリツプなんだよ。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、この『美術曲芸しん粉細工』を演出する場合には、いつもいつもチユウリツプといふ、あのあちら的な花が一輪、二輪、三輪、あまた花々の中にまじつて咲いてゐた。",
              "citation": {
                "source": "美術曲芸しん粉細工",
                "author": "阿部徳蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの公園へ行つても木蔭にチユウリツプが咲いて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬱金香黄と、紅と、みどり、生な色どり……※粉細工のやうなチユウリツプの花よ、葉よ。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "※粉細工のやうなチユウリツプの花よ、葉よ。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
