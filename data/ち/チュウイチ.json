  {
    "uuid": "4059e933-4f31-5898-a572-fb215491ca6a",
    "entry": "中一",
    "reading": {
      "primary": "ちゅういち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
