  {
    "uuid": "6cc64553-b89d-5a93-bc9b-a574990893ce",
    "entry": "チヨウ",
    "reading": {
      "primary": "ちよう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "然し、球台、球、キユウ、チヨウク、お客の人｜柄、建物の感じ、周圍の状態、經營者の經營振――さうした條件がいい氣持に揃ふのは實に困難な事なので、さてしつくりと勝負を樂みたくなるやうなのはめつたにない。",
              "citation": {
                "source": "文壇球突物語",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "暑かつた、労れた、行程八里、厚狭町小松屋といふ安宿に泊る（三〇・中）、掃除が行き届いて、老婦も深切だが、キチヨウメンすぎて少々うるさい。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "△これだけキチヨウメンであつて、そしてこれだけダラシないとは。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "予期した通りにＫから送金、何とキチヨウメンな息子だらう、ありがたし／＼。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケキヨ、ヨ　ケキヨ、ヨ」　チヨウド、ソレハ　ナキジヤクリシテ　ヰルヤウニ　カナシイ　オトデシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　アカチヤンハ　モウ　オメメヲ　アイタカ　ミテ　キテ　チヨウダイ」　テフテフハ　スグ　ウマヤノ　マドカラ　ナカニ　ハイツテ　イキマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　チヨウド　ソノ　コロ、ニシノ　ハウデ　センサウガ　オコツテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ヲトコハ　ウチヨウテンニ　ナツテ　ヰマシタノデ　ソンナ　コトハ　キニモ　カケナイデ、イサマシク　ラツパヲ　フキナラシナガラ　マタ　アルイテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ、チヨウド　オナカガ　スイテ　キタ　コロ　マタ　ヒトツノ　ムラニ　ハイリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヘノ　ナカニハ　フタリノ　トシヨリガ　ヰテ　チヨウド　ヒトツノ　パンヲ　フタツニ　キラウト　シテ　ヰル　トコロデシタガ、ハラノ　スイタ　ヲトコヲ　キノドクニ　オモツテ　パンヲ　ミツツニ　キリ、ソノ　ヒトキレヲ　ヲトコニ　メグンデ　ヤリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル　ヒ、ムラヤクバカラ　デテ　キタ　ソンチヨウサンガ　バシヤヲ　ゴランニ　ナリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、オマエタチノ　オトウサンヤ　オカアサンタチハ　ヨク　コノ　バシヤノ　ゴオンヲ　ウケタノサ」　ソシテ　ソンチヨウサンハ　イヒツヅケマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンチヨウサンモ　セントウニ　タツテ、エンヤ　エンヤト　ヒツパリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヤウサンハ　チヨウド、ロバガ　イツピキ　ホシイト　オモツテ　ヰタ　トコロデシタノデ、アキナヒノ　モツテ　ヰル　カゴヲ　ノゾイテ　ミマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガチヨウノ　タンジヨウビ新美南吉　アル　オヒヤクシヨウヤノ　ウラニハニ　アヒルヤ、ガチヨウヤ、モルモツトヤ、ウサギヤ、イタチナドガ　スンデ　ヲリマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、アル　ヒノ　コト　ガチヨウノ　タンジヨウビト　イフノデ、ミンナハ　ガチヨウノ　トコロヘ　ゴチソウニ　マネカレテ　イキマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「上野・サクラギチヨウ・十七バンチ――ヒデヲ云つて御覧！",
              "citation": {
                "source": "秋・二日の話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボルゲーゼの森には、ダンテ、ペトラルカを始めとして、ゲーテもゐた、シルレルもゐた、チヨウサアやスペンサーもゐた。",
              "citation": {
                "source": "山彦の街",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "北海道の地圖は少しばかりコチヨウして小さくしてありはせぬかと思ふほど宏大で、空よりも平野が廣い。",
              "citation": {
                "source": "摩周湖紀行",
                "author": "――北海道の旅より――",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェツだ」「ホヽウ、それは耳よりな話だねえ、オイ少し位チヨウクワしてもえゝぞ、えゝぞ」　女達はキャツキャツと笑つた。",
              "citation": {
                "source": "「リラ」の女達",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンヤハンドレペイジチヨウジユウバクゲキキ五ダイトウチヤクシタ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "シキウキチヨウアリタシ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり、シキウキチヨウアリタシとしか書かれていない。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子は、シキウキチヨウアリタシに気をわるくしながら、やっぱり返事が気にかかり、落付けず、快活さを失った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、地震の予知という問題がしばしば興味的に取扱われたり、地震という声におびえるものをひそかにチヨウ笑したりするのはその証拠です。",
              "citation": {
                "source": "Ｓ夫人への手紙",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔から、そういう例はたくさんあり、どんな種類のものでも、それが社会的存在としてある影響を示しだすと、きつと、諷刺やチヨウ笑の的になります。",
              "citation": {
                "source": "Ｓ夫人への手紙",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
