    "definitions": [
      {
        "index": 1,
        "gloss": "foresight",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は知慮に富んだ人物で、常に先を見通していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "知慮ある判断が、会社の危機を救った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "リーダーには、将来を見据える知慮が求められる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "水が湯となり氷となるが、人生の事情の多端錯雑、変幻極まりなきに比べてはるかに簡単であり、したがつて物に接するは、事に処するよりも単純であるが、それでも本当に物に接するといふことに徹底するには、大分の知慮分別と、鍛練修業を必要とする。",
              "citation": {
                "source": "些細なやうで重大な事",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "恥と知慮とを棄てたるや？",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "知慮を※らすクロニオーン、　600燃え出す舟の猛焔を眺めんとして斯く待てり。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "復密奏して曰く、燕王は智慮人に過ぐ、而して其の拠る所の北平は、形勝の地にして、士馬精強に、金元の由って興るところなり、今｜宜しく封を南昌に徒したもうべし。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し其説が真実であるとすれば、忠興が固辞したということは、忠興の智慮が中々深くて、能く己を知り彼を知って居たということを大に揚げるべきで、忠興の人物を一段と立派にはするが、秀吉に取っては第一には其の眼力が心細く思われるのであり、第二に辞退されて、ああ然様か、と済ませたことが下らなく思われるのである。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "将門が国庁の記録に事実をとゞめ、四方に実際を知らしめたのは、為し得て男らしく立派に智慮もあり威勢もあることであつた。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは世上の成功者は、皆自己の意志や、智慮や、勤勉や、仁徳の力によつて自己の好結果を收め得たことを信じて居り、そして失敗者は皆自己の罪では無いが、運命の然らしめたが爲に失敗の苦境に陷つたことを歎じて居るといふ事實である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "張る氣は人の學才能智慮を擴大すること、猶膂力意氣を擴大するがごとくで有るから、智光愈張り、氣愈擴大されて、其の人は自ら意識せずに、自己の最高能力を發揮する。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢は言ふまでも無く精神上の過程である、受、想、感情、記憶、智慮、意識等が不完全では有るが働いて居る事を否定する譯にはゆかぬ。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "張る気は人の学才智慮を拡大し、膂力や意気を拡大するので、智光いよいよ輝けば気はいよいよ張り、気いよいよ張れば学才智慮はいよいよ拡大されて、その人は意識することなく自己の最高能力を発揮する。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢はいうまでもなく精神上の過程である、受・想・感情・記憶・智慮・意識等が不完全ではあるが働いている事を否定する訳にはいかない。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めは書物を読んでも、文意も解らずただ声を出して読む素読であり、字を書いても手本を書き写すだけのものであるが、それが身体が大きくなり心が発達して成人となると、意欲が出て、智慮も盛んになって来る。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "孔先生こそ生まれながらの聖人というものではないか、しかも自ら「学ぶ外なし」と言われて、生まれながらの聖では不足とされ、「思えども益無かりき」と語られたではないか、煩悶あればいよいよ学ぶべし、懊悩あれば尚更学ぶべし、およそ心思・智慮・行為・動作に滞るところがあれば、それは即ち困である。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあるからに親類以下散々に智慮外の体｜見及候得共我一代は兎角の義に及ばず候と思、上下の分も無き程に候へ共覚悟前ならば苦しからず候、氏真まで此の如にては無国主と可成候、能々此分別｜之あるべし……」　義元が自らの欠点をさらけ出して氏真を戒めて居る心持は察するに余りある。",
              "citation": {
                "source": "桶狭間合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその何のためたるやは智慮深き吾輩には頓と了解し難い。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "神託宣していわく、もしこの国に年若く姿貌端正にして智慮に富み、足で歩まず、馬に騎らず、車に乗らず、日中でなく、夜中でなく、月の前半でも後半でもなく、衣を著ず、また裸にもあらず、かくてシグツナの王宮に詣り得る美なる素女あらば、その女こそ目前差し迫った大禍難を無事に避くべき妙計を出し得べけれと。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "『水滸伝』中には、鶏を盗むを得意とする時遷のような雑輩を除いても黒旋風のような怒って乱暴するほかには取柄のない愚人もあるが、八犬士は皆文武の才があって智慮分別があり過ぎる。",
              "citation": {
                "source": "八犬伝談余",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼女は、彼が自分などよりはずっとずっと経験もあり智慮もある方だと自分が思っているということを、彼に伝えたいという可憐な願いをこめて、彼に対して膝を屈めて礼をした（当時は若い淑女は膝を屈める礼をしたものである）。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし自分で制する智慮はまだなかった。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "花のような美童で、智慮かしこく、師の僧に愛され、たちまち仏教の奥儀をきわめて、弁舌のさわやかなこと、若年にして名僧と称されるに至った。",
              "citation": {
                "source": "織田信長",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊狗に等しき面持つも、アートレ，デース今更に我をまともに眺め得じ、評議或は行動にわれ亦かれと伴ならず、われを欺き怒らせし彼また更に甘言に、　375欺くことを得べからず、事すでに足る、今やいざ破滅に向へ、神明は彼より智慮を取去りぬ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある一人に神明は戰ふ業を、又他には舞踊の業を、又他には琴と歌とを授けたり、　730又他の胸に轟雷のクロニオーンは智慮深き心をおけり、これにより多數の人は利を受けむ、衆を救はむ斯る人、最も智慮の徳を知る。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は劣れる質乍ら子は優良の材にして、文武に秀いで、健脚に、又戰爭の術に長け、智慮に於てもミケーネー族人中に秀でたる――彼れ戰勝の光榮を今ヘクト，ルの手に讓る。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "740ああヘクト，ルよ、双親に無量の悲嘆負はしめぬ、更に我には就中はてなき恨殘されむ、ああ君死して臨終の床より我に手を延さず、智慮の一言又のべず、のべなば我は日も夜も、之を思ふて流涕の悲つくること無けむ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう点から見てもなかなか智慮に富んで居る法王であることはよく分る。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同時にこの時代に有りがちな他部落との闘争には、是非とも男子の体力と智慮とに俟たねばならぬので、耕作機織の如き仕事は、当然女子の手で処理されたのである。",
              "citation": {
                "source": "穀神としての牛に関する民俗",
                "author": "中山太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その傷ましくも美しい人の有様を前にしつゝ、次第に彼は智慮と弁舌とを十分に働かせる落ち着きを取り返していた。",
              "citation": {
                "source": "武州公秘話",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "智慮分別は多大の打撃を受けて、精神に異状があるのではなかろうかと考えるようになった。",
              "citation": {
                "source": "朝起の人達",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけてその外交的な遠謀と智慮にかけては、若い謙信のごとき、到底、あの百錬の功を経た緋衣の僧将の頭脳には敵すべきもなかった。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、こうした彼の智慮と周到な用意も、それから後は、いかんとも施すに術もなかった。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
