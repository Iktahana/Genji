    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to freeze (in fear, surprise, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "突然の大きな音に、猫が驚いて縮み上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "先生に厳しく𠮟られて、彼はすっかり縮み上がってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "予想外の出来事に、私はただ縮み上がって立ち尽くすしかなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "百メートル、二百メートルなどのワイアの長さを読み上げられた時、われわれは、海の深さより、それを巻き上げることの困難さに縮み上がる。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "喉が乾いて居りますから一掬い飲んで見ると手は縮み上がる程冷たいので、二度と掬って飲む勇気がなかった。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんとか組のなんとか氏は、そうワカラズ屋の暴力団ではないらしかったが、Ｈ氏という女性的に神経質のニセ豪傑がひがんだ主観で事実を自分流にまげて伝えているから、変にこじれて受けとり、どやしつければ文学青年はちぢみあがるもんだと考えて乗りこんだらしい。",
              "citation": {
                "source": "安吾巷談",
                "author": "熱海復興",
                "note": "青空文庫"
              }
            },
            {
              "text": "女主人はいうまでもなくおせいちゃんの母親であるが、年はそれほどでもない筈なのに、あたまはすっかり白髪だったし、痩せていて皺だらけで、これに総入れ歯を外して睨まれると、どんなにあらくれた蒸気乗りでもちぢみあがる、といわれていた。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこのまちがいも、もとはといえば、やはりその癇癖のつよい、気のみじかいところから起ったことなのでしょうが、御城代のごきげんが悪いときくと、城中のさむらいたちでも、この邸につかえている召使たちでも、声をひそめてちぢみあがるといわれるくらい、名代のかんしゃくもちでとどろきわたっているかたでした。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいことってのはな、躯じゅう八万八千の毛穴が一つ一つちぢみあがるような気持だとよ。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの顔一目で縮み上る……　が、大人に道徳というはそぐわぬ。",
              "citation": {
                "source": "茸の舞姫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "揉ほどの手つきをされても、一ちゞみに縮み上る……といつただけでもくすぐつたい。",
              "citation": {
                "source": "木菟俗見",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誤りたるにやと嘲笑ひて、威丈高にわれを見下したる眼光、鬼神も縮み上る可き勢なり。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "駈け出しの不良なぞはそれと知ったら縮み上る。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分では、指も、手首も、未だくっついているように思えたが、激痛に縮み上るような右手へ、左手を当てると、腎から切り落されてしまっていて、生温かい血が、すぐ指の股から、流れ落ちた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "稽古の時に和田垣博士が切腹の場で笛を用ひる様に注意せられたのであつたが、舞台監督のアントワンが笛の音を聞くと縮み上る程嫌ひだと云ふので見合せに成つたのだ相だ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前の絃の音はあれほど優しゅう聞えたのに、お前の姿を見ると、体中が縮み上るような心持がするのはどうしたものだ。",
              "citation": {
                "source": "痴人と死と",
                "author": "ホフマンスタアル　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしが睨んでさへ縮み上るんで御座います。",
              "citation": {
                "source": "動員挿話［第一稿］",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨降れば泥濘の帝都｜益其の特徴を発揮し自動車の泥よけ乾く間もなく待てども来らず来れども乗れぬ電車を見送って四辻の風に睾丸も縮み上る冬は正に来れり。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と思わず心臓が縮みあがる。",
              "citation": {
                "source": "琴のそら音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この命令だという一言に縮みあがるのは、数千年の奴隷生活に馴れた遺伝のせいもあろうが、僕にはやはり大部分は幼年校時代の精神的遺物であろうと思われる。",
              "citation": {
                "source": "獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでどんな荒えびすでも、虎狼のような猛獣でも、田村麻呂に一目にらまれると、たちまち一縮みに縮みあがるというほどでした。",
              "citation": {
                "source": "田村将軍",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "爆撃中は縮みあがるが、喉元すぎれば忽ち忘れる。",
              "citation": {
                "source": "予告殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、縮みあがるような凄味のある声でどなりつけた。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "合乗り乳母車　――仏蘭西縦断の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "白いのも、赤いのも、みんな元気よく、あたたかい日の光を受けると頭をもたげ、雪なんぞ降るといかにもしょげたように、縮みあがる。",
              "citation": {
                "source": "雪割草の花",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして縮みあがる伝七郎の前へ、一通の手紙を投げだしながら、「それを読んでみろ」と云った。",
              "citation": {
                "source": "恋の伝七郎",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後で、その口を曲げて、縮みあがるなよ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん初期のことで服装もそのまま両袖を結んだり、襷をかけたり、中には両肌脱ぎのシャツ一枚、不体裁お構いなし、柔軟体操からダンベル（亜鈴）、球竿、クラブ（徳利形の木製具）など相当重い奴を大汗になって振り回す、嫌々ながら物事すべて新規だから苦情もいえず、いったところで幹事や先生の一喝に縮みあがる。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜜を彼女は、焼けば焼くほどチリチリに縮みあがる肉の上に注ぎながら、「いい年をして、十六七の娘と一緒に踊ってもいられませんわ」　そう言うと、まるで容器にあたるみたいに、ガチャリと乱暴にそれを置いた。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユリの不揃いな成長、アンポンぶりは、時にあなたを苦笑させ、時におこらせ、奈良の薬師寺の国宝の四天王の眼のように四角い四角い眼で見られるとき、ブランカは、どんなにちぢみ上るでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
