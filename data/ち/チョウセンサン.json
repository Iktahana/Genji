          "literary": [
            {
              "text": "「この毛並の軟らかさ、朝鮮産の虎の皮、決して安くはなさそうだ。",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "硅石は一種で無く、朝鮮産の物が調合される。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "其節御恵贈の朝鮮産西洋種｜梨子、誠にやすらかにして美味、有難存候。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮産なんどの養殖は、三十分煮てもやわらかくならぬものが多い。",
              "citation": {
                "source": "料理メモ",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
