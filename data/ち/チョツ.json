        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「チョツ、削けといやあがるのか。",
              "citation": {
                "source": "貧乏",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ徒らに無明の酒に酔ふにあらず……と、云へたら面白からうが、チョツ！",
              "citation": {
                "source": "貧しき日録",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「弱味を付け込みやアがつたな、チョツ、まあ仕方がない。",
              "citation": {
                "source": "熱海へ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺男までが南京織の夏ズボンと、縞目のある手編のチョツキを新調しをる。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はフロックを著てゐたが、ネクタイもチョツキもズボン釣りもつけてゐなかつた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「チョツ、下らねえ。",
              "citation": {
                "source": "父を売る子",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツチョツチョツ、チュル……行々子が囀る。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "西峰と毛勝との間には二十米に足らぬ小隆起がある、片麻岩の大塊が縦横に錯列して、其上に矮い偃松のカサカサした枝が針坊主に針を刺したように先の方へチョツピリと葉を着けてのた打廻っている。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルザックはチョツキ一面に宝石をちりばめてゐたといふ。",
              "citation": {
                "source": "ネクタイとステッキ",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
