        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さて、チクマの本のこと。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "チクマもまさか、合の手にこんな引越しがはさまっていようとは思って居りますまい。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日のうちのことと思えず十月四日　水曜　チクマに手紙十月五日　木曜　池島のところへ手紙をかいた。",
              "citation": {
                "source": "日記",
                "author": "一九五〇年（昭和二十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "又信州に千曲川といふ大河があつて、今「チクマ」川と呼ぶが、古へはかの地の郡名を筑摩郡といふから、チの音でなくツの音である、筑紫をツクシと讀むなども思ひ合はすべきである。",
              "citation": {
                "source": "平安朝時代の漢文學",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チクマアニカラウケトツタモノスグヘンソウタノムチクサ」と、まづ書いてみて、それを消した。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ぎに「チクマアニノワタシタモノ……モシツカヘバ」……と、そこでしばらく考へてから、やつと「タイヘンナコトニナル」……。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他伊賀のアベ（阿拜）は「アハイ」となり信濃のツカマ（筑摩）は「チクマ」となつたやうな例はなほ若干ある。",
              "citation": {
                "source": "國語尊重",
                "author": "伊東忠太",
                "note": "青空文庫"
              }
            },
            {
              "text": "その音をなつかしんで波子は、耳もとでお手玉をついていたが、やがて、高くつきあげて、サイジョウザンハ　キリフカシチクマノカワハ　ナミアラシハルカニキコユル　モノオトハサカマクミズカ　ツワモノカ　それはいたいけな少女の声だった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
