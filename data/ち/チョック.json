        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "チョックラ油断させておいて、不意打ちにタタキ落そうという寸法なんだ。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの小僧は有名な難船小僧っていう曰く附きの代物だって、皆、云ってますぜ」　俺はそう云いさしてチョックラ船長の顔色を窺ってみたが、何の反応も無い。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョックラ指をさしたぐらいじゃ分らないねえ」「そうでしょうなア」　二十年前のこととは云え、あの碁に負けた手筋だけは、どうして忘れられようか。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "お騒がせしてすみませんが、チョックラ挨拶にあがりました。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "神伝魚心流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "この正月にチョックラかぶるべい。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その二　大岡越前守",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョックラここを開けてもらいとうござんす。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "段六　（長五郎のことをヒョイと思い出し、戸棚の方をキョロキョロ見ていたが、やにわに）嬢様、おら、んじゃチョックラ行って来すぞ。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――だども、そいつは、一つはおかみさんがそうやって綺麗でよ、それにまだそんな年じゃなしなあ、へへ、男が見りゃ、チョックラそんな事も云いたくなるずら。",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺にもチョックラ吸わしてくださいよ。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（殆んど福々しいと言える位に柔和な笑顔）青年　どうも――百姓　……（前歯の抜けてしまった大口をパクパク開けて笑いながら、麦こきを続ける）……こんで、暗くなってから家さ戻ったりすると、孫共あ、火じろのわきから俺の方ジロリジロリ見て「おばあ、チョックラ向う向いて見な」などと言いやす。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（立って）よしよし、へえチョックラ汲んで来やす。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女　……おばさんにチョックラ逢いたくなって――百姓　なんの話だ？",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "腸が悪いんだら、悪いように、そんな拝み屋などに頼んじゃおさいせんを巻き上げられてる暇に、その金で、チョックラ小諸か甲府にでも出かけて、立派なお医者の先生さまに見て貰うて、薬を貰うて来るなり、養生のしかたを教わって来るなりしろ。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "子持ちの船乗りの所へなぞ、そうチョックラ行けはしまい。",
              "citation": {
                "source": "好日",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃな、俺あチョックラ出かけて来るからな、どうで夜になるだろうが、首尾が良ければ明日の朝までにゃ落窪へ行くからな。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョックラここを開けて貰いとうござんす。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "段六　（長五郎のことをヒョイと思い出し、戸棚の方をキョロキョロ見ていたが、やにわに）嬢さま、おら、んじゃチョックラ行って来ますぞ。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだ、僕が、生れてはじめて、アテチョック（アルティショー―食用｜薊）ってものを食ったのは、神戸の弘養館だった。",
              "citation": {
                "source": "神戸",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "アテチョックを出されて、食い方が分らなくて、弱ったんだっけ。",
              "citation": {
                "source": "神戸",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
