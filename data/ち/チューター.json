        "examples": {
          "standard": [
            {
              "text": "新入生のために「チューター」制度が導入された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試験勉強で困っていた時、「チューター」が親身になって教えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は大学で後輩の「チューター」をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "彼らは「テューター」と呼ばれている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おまえ、こんなとこで、なにやってんだ」　と、テューターの芝が低い声でいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえは、いきたくても、無理」「だから、そうじゃなくてさ、女子寮には、女のテューターがくるの？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "男のテューターも四人増えるぞ」　そりゃ、そうだろう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "女のテューター、かわいい？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「眠いんなら、もどって、寝ろよ」「だって、テュータールームに連行だろ」「いいんだって。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちはズブぬれなんだから」　と、テューターの芝が、精いっぱいあわれな声でいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "上の道から観察したかぎりでは、玄関わきのテュータールームから灯がもれているだけで、女子寮にとくに変わった点はない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "寮長はよく、かわるがわるテューターを呼んでは、酒をふるまって、学校の未来について、滔々とまくしたてるという話だ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「なんとかなるよ」「いまごろ、テューターがうちの部屋いって、さがしてるよ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関からまっすぐ伸びる廊下の突きあたりに、会議室があり、高志が忍びこもうとしていたとき、ふたりのテューターがそこにいた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いまのところ、昨夜の一件を知っているのは、浅井が逃げまわったりしなかったおかげで、女子寮のテューターふたり、芝くん、それにきみとわたしだけですんでいる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "テュータールームはたしかめたのに、会議室を見なかった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "女テューターどもが、なにもって出てきたと思う？",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえ、寮長はだれにもいう気なんかないし、テューターたちだって、寮長のいいつけなら、だれにもいわない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかしからおなじなんだから、深く考えんなよ」　そうだ、そうだ、起床がなんだ、テューターなんか怖くねえ、と声がかかる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
