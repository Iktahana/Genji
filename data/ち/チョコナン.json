[
  {
    "uuid": "0cf5a3ee-2956-54e8-ba09-5e2dbeaaf6c3",
    "entry": "ちょこなん",
    "reading": {
      "primary": "ちょこなん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
