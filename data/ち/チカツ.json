        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いや、コンネクチカツト州だ。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその餘韻に就ては末尾のピチカツトが效果的な作用をしてゐる。",
              "citation": {
                "source": "『新潮』十月新人號小説評",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍ウヰルソンが或時コネクチカツトの議員を仕てゐる自分の義弟｜某と、リンコルン大統領を訪ねた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "女学校といふのは米国コネチカツト州のスタムフオウドにある女子大学の事で、クレマンソウは一八六五年から一八六九年までまる四年間といふもの、こゝで文学史の教授をしてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまり愉快でないので今も幾分チカツきながらつけていません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（「書割盗人」東京の「夏泥」）　拍子木を鳴らす音は、カラカツチカツチ。",
              "citation": {
                "source": "初代桂春団治研究",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
