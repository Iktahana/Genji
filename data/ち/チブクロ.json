        "examples": {
          "standard": [
            {
              "text": "赤ん坊は母親の乳袋に吸い付いて、安心したように眠りについた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この民族衣装は、乳袋を強調するようなデザインになっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の文献には、乳袋に関する記述が多く見られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "私は黄色くなりかけている古ぼけた調緒をゆるめて胴を外して、乳袋の内側を一眼見るとハッと息を詰めた。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
