          "literary": [
            {
              "text": "四十五年五月　　そなた待つ間チヨンキナ、チヨンキナ、チヨンキナ踊を、けふの踊をひとをどり。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨンキナ、チヨンキナ、チヨンキナ踊を、岡の草木がひとをどり。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨンキナ、チヨンキナ、チヨンキナ踊を、池の面がひとをどり。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨンキナ、チヨンキナ、チヨンキナ踊を、楡の羽蟻がひとをどり。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨンキナ、チヨンキナ、チヨンキナ踊を、白い日傘がひとをどり。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　チヨンキナの繰返しはやはりチヨンキナの囃子にて歌ふ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
