        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "公園を横切るのが一番の近回りだと教えてもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "急いでいたので、細い路地を通って会場まで近回りをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "地図で見ると遠そうだが、地下通路を使えばかなりの近回りになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そのころから重吉は小さい舟でいろいろなものを近回りへ運ぶ海の上の便利屋のような仕事をしていた。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "小川は大して曲がりくねりもせずドラムガニョールの古い百姓家の近くを通っていたため、そのような時には家に帰る住民が近回りをするための道のようになっていたのです。",
              "citation": {
                "source": "ドラムガニョールの白い猫",
                "author": "Ｊ. Ｓ. レ・ファニュ　J.S.Le Fanu",
                "note": "青空文庫"
              }
            },
            {
              "text": "『又入れ替つて出てくれたのかね、あゝ言つて呼んでるのは、』『へい、否、山深く参つたのが、近廻りへ引上げて来たでござります。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は、粗末な貸家なぞがぽつ／＼立ちかけてゐたりするやうな、草原なぞの多い、寂れたところを近廻りして、小ぎれいな家の並んだ上品な通りへ出た。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに連れて「やっぱり親身の者でないとなあ」とか「仏も仕合わせたい」とか近廻りの者が噂し初めた。",
              "citation": {
                "source": "骸骨の黒穂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お辻　なあに、この近廻り、空店が、十何軒も出来てるでせう。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度、仕合谷の南を限る山の鼻を踰える際、崖を下って汀を辿れば三時間も近廻りとなるというので、私は下ろうではないかと長次郎に勧めて見た。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この前は大変御厄介になりまして、有難うございます」　と団さんに挨拶した番頭さんの案内で僕達は近廻りを見物に出かけた。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてお蝶が峠の二合目あたりを辿って行くうち、信玄沢という低地を、近廻りして、何者でしょうか、ざわざわとかき分けて来る者がある。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
