        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あの、仔雀が、チイチイと、ありッたけ嘴を赤く開けて、クリスマスに貰ったマントのように小羽を動かし、胸毛をふよふよと揺がせて、こう仰向いて強請ると、あいよ、と言った顔色で、チチッ、チチッと幾度もお飯粒を嘴から含めて遣る。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "生意気にもかかわらず、親雀がスーッと来て叱るような顔をすると、喧嘩の嘴も、生意気な羽も、忽ちぐにゃぐにゃになって、チイチイ、赤坊声で甘ったれて、餌を頂戴と、口を張開いて胸毛をふわふわとして待構える。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、チイチイチイ……おなかが空いたの。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッパ、チイチイ諸きおいに歓喜の声を上げて、踊りながら、飛びながら、啄むと、今度は目白鳥が中へ交った。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　学生の姿が見えなくなると、小店の向うの竹垣の上で、目白がチイチイと鳴いた。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず舞台一面を本物の竹藪にして、虎狩の唐人どもがチャルメラや、銅鑼や鉦を持って出て、何かチイチイパアパア騒ぎ立てて藪の蔭へはいると、そこへ虎の子を曳いて出る。",
              "citation": {
                "source": "虎",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "チイチイパアパアが幼稚園の先生ぐれえの事しか知らねえ江戸ッ子一流の世間見ずでゲス。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その女たちの中でも一等｜捌けるピン嬢とチョキ嬢という二人がノスタレだかオシッコだかわかりませんが病気になっちゃったんで、とりあえずの埋め合わせに聖路易の支那料理屋に居たというチイチイっていうのとフイフイっていうのと二人の別嬪が手助けに来たんでげす。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつを一方のチイチイって娘が感付いて横槍を入れたものらしいんです。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "……というのはこのチイチイって奴が大変なものなんでげす。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうかすると十二時頃まで、奇妙な支那の歌声や、器楽の音なぞが、チイチイガアガア鳴り響くのであったが、それに気が付くたんびに村の人々は顔を見合わせた。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……チイチイどこかで啼いていやあがる。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「………とその人のお家の庭には春になると、山吹や藤の花が咲いて雀がチイチクチイチク飛びまはります。",
              "citation": {
                "source": "雲雀病院",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "お天気の好い日には、其の沢山の葉が、みな日光にキラキラと輝き、下萌えの草は風に戦ぎ、何処か見えない枝の蔭で囀る小鳥の声が、チイチクチクチクと、楽しそうに合唱します。",
              "citation": {
                "source": "いとこ同志",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "風が出て来て、カナリアのチイチイチイ、チチチチチというメロディアスな声を吹きちぎります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事を済した子供達が隣りの室で、「チイチイパッパ、チイパッパ、雀の学校の……。",
              "citation": {
                "source": "或る男の手記",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "声は声を呼んで、チイチク、チュクチュク、チイチク、チュクチュク、潮のように高まってくる。",
              "citation": {
                "source": "小さき花にも",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "チイチク、チュクチュク、チイチク、チュクチュク、騒ぎまわってくれ。",
              "citation": {
                "source": "小さき花にも",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで大の男がまたチイチイ、パアパアいう。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも言葉がわかれば、多少の諒解も、同情も、出たかも知れないが、何をいうにもチイチイパアで、ただ締りなく泣き叫ぶのを、田山白雲が、この毛唐！",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その賀川さんの西隣の阿爺さんの娘が死んだ時などは、賀川市長の一声で、軒の雀がみなチイチイ鳴いて、やかましかったそうです」　菊子は、静かにそれを聞いていた。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "白木が持ってくる笊の蜆は、台所の流しの上で、一日中チイチイと鳴いていた。",
              "citation": {
                "source": "黄色い日日",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "微細な網目に両脚をつっこんで、逆さにぶら下って、チイチイと啼き叫んでいる。",
              "citation": {
                "source": "庭の眺め",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
