        "examples": {
          "standard": [
            {
              "text": "風に揺れた風鈴がちんちん鳴って、縁側に涼しげな音を届けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "首輪の鈴がちんちん鳴りながら、猫が庭を歩き回っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "電車の発車ベルがちんちん鳴ると、乗客は急いでドアに駆け込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "第一電車のちんちん鳴るので驚いた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからそのちんちん鳴るあいだに、非常に多くの人間が乗ったり降りたりするので驚いた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
