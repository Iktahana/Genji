[
  {
    "uuid": "4ccdcd61-a37f-5cc4-b965-ea5d3b65027b",
    "entry": "千木",
    "reading": {
      "primary": "ちぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
