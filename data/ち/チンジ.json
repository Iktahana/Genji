[
  {
    "uuid": "8b9395be-1334-58b3-8c2f-c72938e3c14f",
    "entry": "珍事",
    "reading": {
      "primary": "ちんじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
