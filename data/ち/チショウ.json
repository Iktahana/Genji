  {
    "uuid": "d74e46b4-1ea5-51ae-a9b0-874645352133",
    "entry": "致傷",
    "reading": {
      "primary": "ちしょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "inflicting injury (criminally)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「彼は酔って通行人に殴りかかり、全治二週間の怪我を負わせる傷害致傷の疑いで逮捕された。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「業務上の不注意によって多くの負傷者を出した事故は、業務上過失致傷にあたる。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「被害者に重大な致傷を負わせた罪は重く、厳しい刑罰が科されるべきだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "決定支倉　喜平　右に対する窃盗放火詐欺強姦致傷殺人被告事件に付き大正十三年四月二日公判準備手続に於て被告人及其弁護人より申請したる証拠調べに対し、検事の意見を聞き左の如く決定す。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "清朝では早く順治九年（西暦一六五二）に、明初の規定を復活して、割股或致傷生。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜助　うわあ、ちしょうめ！",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちしょうめ、ムシャクシャしてならねえんだ！",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わしは、いつか、きみたちしょうねんたんていだんと、ちえくらべをしたまほうはかせだよ。",
              "citation": {
                "source": "赤いカブトムシ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "『おうごんのとら』のじけんで、ぼくたちしょうねんたんていだんに負けた、あのまほうはかせだ。",
              "citation": {
                "source": "まほうやしき",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
