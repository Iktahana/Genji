          "literary": [
            {
              "text": "鏝で勢いよくきゅうとなでて、ちりちりぱっとくくりをつけて、パイプをくわえて考え込んで、モンパリー、チッペラリー、ラタヽパン。",
              "citation": {
                "source": "二科狂想行進曲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "助手はのんきにうしろから、チッペラリーの口笛を吹いてゆっくりやって来る。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "全体何がチッペラリーだ。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と笑ってからチッペラリーの口笛を又吹きながら出て行った。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
