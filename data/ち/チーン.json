        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "庵主さんは、よそゆきの茶色のけさを着て、鐘のまえに立つと、手にもっている小さい鉦をちーんとたたいて、お経を読みはじめた。",
              "citation": {
                "source": "ごんごろ鐘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを彼は指先でちーんとはじきあげた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、窓の障子に女の影が射して、それが消えたかと思うと、「ちーん！",
              "citation": {
                "source": "四十八人目",
                "author": "森田草平",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは俺は以後万事チーンとしよう。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ａ橋の十間ばかり下流、殆ど天竜川本流への流入口近くで、冴えたセットの音が、チーン、チーンと聞えて来た。",
              "citation": {
                "source": "万福追想",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チチーン、シャン、チチチ、チチチン。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一郎は、「テンチン」「テエアンチーン」など、支那語の片言をもとりかねる舌で、俊に菓子を求めた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "市場でマンゴスチーンを買っていたら、子供がおおぜいよって来て銭をねだり、馬車を追っかけて来たがとうとう何もやらなかった。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカチーン街の語学の先生の誕生日に、何か花でも贈り物にしたいと思って、アポステル・パウルス・キルヘの前のけちな花屋へ寄って、あれかこれかと物色した末に買ったのがこの花であった。",
              "citation": {
                "source": "病室の花",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウンター・デン・リンデンを歩いている女と、タウエンチーン街を歩いている男と、ホワイトハウスの玄関をはぎ合わせたりするような事はそもそも宵の口のことであって、もっともっと美しい深い内容的のモンタージュはいかなる連句のいかなる所にも見いだされるであろう。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう何事も訊いて呉れるな、……フフン、それではこれ位に切り上げやう、何れにしても汝は莫迦だ、飛んでもない阿呆だ、罪人だ、気狂だ……さうだそれに違ひないと両の眼がじつとうなづく…　カラカラチーン、チーン、チーン、チーン……気まぐれな隣の自鳴鐘がもう夜の十時を点つ、夕日がくわつと壁から鏡に照り反す。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "チーンと九時半の柱時計が鳴つた。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞夜中頃に、枕頭の違棚に据ゑてある、四角の紫檀製の枠に嵌め込まれた十八世紀の置時計が、チーンと銀椀を象牙の箸で打つ樣な音を立てゝ鳴つた。",
              "citation": {
                "source": "京に着ける夕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "チーンと九時半の柱時計が鳴った。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夜中頃に、枕頭の違棚に据えてある、四角の紫檀製の枠に嵌め込まれた十八世紀の置時計が、チーンと銀椀を象牙の箸で打つような音を立てて鳴った。",
              "citation": {
                "source": "京に着ける夕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "チーン南無猫誉信女、南無阿弥陀仏南無阿弥陀仏と御師匠さんの声がする。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御前も回向をしておやりなさい」　チーン南無猫誉信女南無阿弥陀仏南無阿弥陀仏と今度は下女の声がする。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところへ忽然隣座敷の時計がチーンと鳴り始めた。",
              "citation": {
                "source": "夢十夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "時計が二つ目をチーンと打った。",
              "citation": {
                "source": "夢十夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "予は不案内だが、親友小鳥好きの人の話に、駒鳥は夜の九時になると必ずチーンと一声鳴き、爾後静まり返って朝まで音もせぬ由。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビックリしたが上にもビックリしたらしく、青い顔を一層青くしてドクトルの顔を睨み返しながら、物云いたげに舌の先を震わしたが、かの時遅くこの時早く、老ドクトルが「ハッ」と気合いをかけながら、両手で掴んだ下顎を力一パイ突き上げたので……ガチーン……と音を立てて患者の奥歯がブツカリ合った。",
              "citation": {
                "source": "霊感！",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同時に、　……ガラガラガラガラ……ガチャンガチャン……パーン……パチーン……　という激しい物音が、引き続いて私の足の下に起った。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……何でもその時に女中部屋の時計がコチーンコチーンと二時を打つのを夜着の中で聞いたというがね」「ははあ……重大な暗示ですなあ。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
