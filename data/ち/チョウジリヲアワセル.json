        "examples": {
          "standard": [
            {
              "text": "決算前に会計部は帳尻を合わせるために夜中まで残業している",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "数字が合わないので、帳尻を合わせるために再調査が必要だ",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "不足額を他の項目で帳尻を合わせることになった",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "政府で歳入の帳尻を合わせるために無茶苦茶にこの材木の使用を宣伝し奨励して棺桶などにまでこの良材を使わせたせいだといううわさもある。",
              "citation": {
                "source": "災難雑考",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると女房が内証で里から金を持って来て帳尻を合わせる。",
              "citation": {
                "source": "高瀬舟",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "――帳尻を合わせる能だけの律義之助だ。",
              "citation": {
                "source": "竹柏記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
