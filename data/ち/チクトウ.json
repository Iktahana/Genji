      {
        "index": 1,
        "gloss": "Chinese sugarcane (Saccharum sinense) (used for making wasanbon)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
