[
  {
    "uuid": "60215f7f-a51f-5bf8-8cc9-74382a832f6b",
    "entry": "ちゃんぽん",
    "reading": {
      "primary": "ちゃんぽん",
      "alternatives": [
        "チャンポン"
      ],
      "is_heteronym": false
    },
    "grammar": {
