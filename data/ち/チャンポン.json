        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長崎旅行で、本場のちゃんぽんを食べるのが楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "寒い日には、熱々のちゃんぽんが体に染み渡る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この店のちゃんぽんは、具だくさんでボリューム満点だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
