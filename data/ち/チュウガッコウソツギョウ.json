          "literary": [
            {
              "text": "中学校卒業程度以下の学歴の者は文句なしにはねられるらしいと、いいふらす者もあった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなのは何かの必要からただ中学校卒業の免状だけを貰いに来たのだ。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば受験術・受験法・に精通しているような中学校卒業生は、決して信頼し得る秀才ではあるまい。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "中学校卒業の時に、時計をいただいたことを、申し上げますと、殿様は腹をかかへて、笑ひました。",
              "citation": {
                "source": "硯箱と時計",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
