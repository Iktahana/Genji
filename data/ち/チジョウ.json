  {
    "uuid": "2a4c9336-13cf-5b54-b3a5-7e97c5e78807",
    "entry": "知情",
    "reading": {
      "primary": "ちじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
