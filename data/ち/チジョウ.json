[
  {
    "uuid": "b3879d48-7bd3-583a-886b-133779af100b",
    "entry": "地上",
    "reading": {
      "primary": "ちじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
