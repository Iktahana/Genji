        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "壁にはいつの間に描いたのか、丸まげに結った女と、シルクハット姿の男の顔が茶色の色鉛筆で描いてあり、それぞれ、「君チャンノオカアチャン」「君チャンノオトウチャン」　と、右肩下りの字で説明がついていた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ父ッチャハ、工場デヤスリヲトイデイルウチニ、グルグルマワッテ居ルト石ガカケテトンデキテ、ソレガムネニアタッテ、タオレテ家ヘハコバレテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ母ッチャハ、ナンデ今フユデナイカト云ッテ、泣イテバカリ居タノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナッテ、又ムネイタイノ、トキクト、ダマッテ目ヲツブッテ、ソレカラムネナンテ何ンデモナイ、ト云ッテ、君チャンノカオヲ見、何ンベンモソットナミダヲフイテルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモハジメノウチデ、工場ノ人モダンダンコナクナッテ、死ンダトキニハ、ミンナハモウ君チャンノオ父ッチャノコトヲワスレテシマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ母ッチャハネタキリデ、目アナガウントヒッコンデ、ダマッテミテイルト、イキヲスルタビニウゴイテイタフトンガ、ダンダン分ラナイグライニナッテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、君チャンノオ母ッチャハ、ナカナカスグニヘンジヲシナクナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ母ッチャハ死ンデイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハオ魚ヲ食ベルノガ下手デスカラ、オ婆チャンノヨウニ綺麗デハゴザイマセンケレド」颯子ノ鮎ノ残骸ハ成ル程マコトニキタナラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャンノオ世話ハ、オ婆チャント佐々木サンニオ願イスレバイヽジャナイノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトハオ婆チャンノオ役目デ、ワタクシノ係リデハゴザイマセント、云ワンバカリデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャンノ癖ニ生意気ダワ」「コノクライハ許シテクレルンダト思ッタンダ」「ソンナコト絶対ニ許サナイワヨ、浄吉ニ云附ケテヤルカラ」「御免々々」「出テッテ頂戴！",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年ノ夏ハオ爺チャンノオ守リデ海ヘ行クコトガ出来ナカッタ、ヤッパリ日ニ焦ケテ来ナケレバ駄目ダト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ油谷サンノ奥サンガ何ヨリ先ニ眼ニ附イタノハ、颯チャンノ指ニ光ッテイタキャッツ・アイダト云ウンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト颯チャンノ石ダッテ餘程ノモノデショウネ」「ソンナモノヲ誰ガイツノ間ニ買ッテオヤリニナッタンデショウ」ト、コヽデ又婆サンガ一言シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ小サクッテイラッシャルノニ、ヤッパリオ爺チャンノコトヲ心配ナスッテイラッシャルンデゴザイマスネ」「子供ノ癖ニ変ニマセテイヤガッテ小生意気デイヤナ奴ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オ婆チャンハ胃痛カモ知レナイカラ、ツイデニ行ッテ見テ貰オウッテ云ッテルノサ、オ婆チャンノハ神経ダヨ」「ドウセソウニ決マッテマスワ」「君」ト云イカケテ予ハ云イ直ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハオ爺チャンノ墓地捜シノオ供ヲシテモ詰マラナイカラ、アタシハ御免蒙リタイ、コレカラ四条通リヘ出カケテ「キリハタ」ヤ高島屋デ買物ヲシ、午後ハ高雄方面ヘ紅葉見物ニ行キタイノダガ一人ボッチデハ仕様ガナイ、誰カ案内ヲシテクレナイカシラト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテコノ白唐紙ノ色紙ノ上ニ朱デ足ノ裏ノ拓本ヲ作ル」「ソンナモノガ何ニナルノ」「ソノ拓本ニモトヅイテ、颯チャンノ足ノ佛足石ヲ作ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャン、御免ナサイネ、黙ッテ帰ッテ来チマッテ」「誰カト約束デモアッタノカネ」「ソウジャナイノヨ、正直ヲ云ウト、昨日一日オ爺チャンノ相手ヲサセラレタンデ、スッカリ参ッチマッタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
