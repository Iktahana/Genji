  {
    "uuid": "3980ae96-1745-58bd-a0e6-820e04cd0ab2",
    "entry": "ちゅっ",
    "reading": {
      "primary": "ちゅっ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
