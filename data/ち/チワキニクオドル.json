        "examples": {
          "standard": [
            {
              "text": "応援しているチームの逆転満塁ホームランに、血湧き肉躍るような興奮を覚えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "太鼓の重低音が体に響き、血湧き肉躍る祭りの熱狂に飲み込まれていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歴史を揺るがす大事件の当事者になるなんて、血湧き肉躍る心地だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "何をいうにも新興医学部の最高の使命と名誉とを中心とする、必死の論争なのですから、真に血湧き肉躍るものがありましたでしょう。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした母国の意気組を、はるかに巴里の片隅から眺めていると、片足を棺桶に突込んでいる私でさえ、真に血湧き肉躍るばかりである。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "むらむらと血湧き肉躍る。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
