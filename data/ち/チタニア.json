          "literary": [
            {
              "text": "遥拝すると、白髪の鬘をつけたオベロン王が、白孔雀の扇を胸先に構へてゐるチタニア妃と厳かに同乗してゐる。",
              "citation": {
                "source": "変装綺譚",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワルプルギスの夜の夢一名オベロンとチタニアとの金婚式（間の曲）　　　　座長道具｜方のミイジングさんの手の人達。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "チタニア夫がすねたり、女房がおこったりすると見たら、手ばしこく攫まえて、男は南、女は北の空の果へ連れて行くが好い。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            }
          ]
        }
