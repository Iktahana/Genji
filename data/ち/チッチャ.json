        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それをどんなにして縫っていましたか……どれ位のお金で売れていたか、その時はまだチッチャかったものですから、一つもわかりませんでしたけれども……たった一つ、今でもハッキリ記憶えておりますのは、東京から直方へ来る時に、母が近江屋のお神さんに遣りました小さな袱紗の模様です。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車の絵をかかせるのですが、何故だか、チッチャポッポが大好きです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後は定期船がないから、漁師のチッチャな焼玉エンジンで大島へのりこむツモリであった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争中のクリスマス――たしか三度、先生と治子さんと僕の三人きりでお祝いをして――一度はそこの林からヒイラギの、こんなチッチャイのを切って来て、そこに立てて、飾りがないもんだから、ローソクを三本立てて、三人で、ソトにきこえないように小さな声でサンビ歌を歌った。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
