          "literary": [
            {
              "text": "チイサイ　トキカラ、ヤマ　ノ　ケモノ　ヤ、トリタチ　ト、ナカヨク　アソンデ　ソダチマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　一ツキホド　タチマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "”という代りに……　――ハイ、吉原デ生レテ、吉原デ育チマシタ。",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハイ、十五分経チマシタ」看護婦ガ腕時計ヲ見ナガラ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
