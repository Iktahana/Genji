          "literary": [
            {
              "text": "もう一つはロレンソ・ダルメイダのチャウル（ボムベイ南方）に於ける戦死である。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロレンソは香料取引にチャウルまで行ったのであるが、丁度その頃に、前述のエヂプトの艦隊が押し寄せて来たのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "であとは港の封鎖に留めて南方チャウルに退いた。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
