        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こういう技巧はロシア映画ではあえて珍しくない、むしろすでに伝統的のものであるということは、たとえばわずかに書物のさし絵として見る「ポチョムキン」や「母」の中のいろいろのシーンからもうかがわれる。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名な「ポチョムキン」の市街砲撃の場面で、石のライオンが立ち上がって哮吼するのでも、実は三か所で撮った三つの石のライオンの組み合わせに過ぎないということである。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ポチョムキン」号の水兵は、政治的要求を掲げて立ち上った。",
              "citation": {
                "source": "労働者農民の国家とブルジョア地主の国家",
                "author": "――ソヴェト同盟の国家体制と日本の国家体制――",
                "note": "青空文庫"
              }
            },
            {
              "text": "胡瓜なんかの価をきくときはパ・チョム？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "の方を使って、スコーリコとはきかないのね、スコーリコはもっとまとまったもので、百グラム何銭にいくらというような食品なんかみんなパ・チョムでした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その男、ソブキノの工場と、Мать〔「母」〕、ポチョムキン、新しき Мой　Сынというのを見せて貰れることになった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポチョムキンも素敵なものだ。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "素子は、「うまそうなリンゴだね」と立ちどまって見ていたが、「パチョム（いくら）？",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――だが、こんなこともあるよ、エイゼンシュテインが「戦艦ポチョムキン」を撮影した時、老いぼけた坊主が十字架もって出て来るんだ。",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、一九一七年の「十月」に赤色海軍が演じた英雄的役割は、ソヴェト映画の傑作「戦艦ポチョムキン」に、永久的足跡をのこしている。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあとに侍医のポチョムキン博士、侍従ケムドルフ、給仕のシドニーという順序だった。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ポチョムキンはそれを口実にして、臨終の際に作成された勅令をふりかざし、軍令部が独裁権をとって、即時に戒厳令を実施してしまいました」　そう言って、おだやかな諦観の微笑を浮べながら、「そして、これが、われわれの、哀れな姿です」　と呟いた。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポチョムキンは、突然、乱入して来た十名ばかりの反乱軍の士官によって、寝台の上で射殺されてしまった。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "反乱軍のこの唐突な背反の動機は、ポチョムキンが、王党の、参謀本部附武官を威迫して、王女の自動車を狙撃させた陰険なからくりが士官の遺書から暴露したためだった。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
