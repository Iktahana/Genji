[
  {
    "uuid": "1d92c30c-5a7a-5149-b27c-b6f238cb3619",
    "entry": "中秋",
    "reading": {
      "primary": "ちゅうしゅう",
      "alternatives": [
        "ちゅうじゅう",
        "なかあき"
      ],
      "is_heteronym": true
    },
