        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "旧暦の8月は、月が最も美しいとされる中秋の時期にあたる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼らは、中秋の風物詩である月見団子を囲んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「中秋の月は、なぜあんなにも幻想的なんだろうね」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
