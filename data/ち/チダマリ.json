      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "puddle of blood",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "事故現場には、小さな血だまりができていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "映画の衝撃的な場面で、床に血だまりが広がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の周りに血だまりが広がり、事態の深刻さを物語っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "悲鳴はやんでいたが、夫人は気を失って長椅子の上にのびており、もうひとりの方は片足を肘掛椅子の手すりへだらんと懸け、頭を炉格子の端近くの地面に転がしたまま、血だまりのなか、あいにく事切れていた。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "扉の下から、一筋の赤い血が流れ出ていまして、くねくね曲がりながら通路の反対側まで続いていて、壁の下に血だまりを作っていたんです。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "負けずにうなるスペイン猫、背を持ち上げてグルグルグル、血だまりの周囲をまわり出した。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "城之介めが袴様を殺したヨーッ」　血だまりを睨んだものである。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "残されているのは血だまりだ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼんやりと血だまりを見詰めている。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、この時どうしたものか、血だまりを廻っていたスペイン猫、ネロがお町へ飛びかかって来た。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさしく血だまり、そこにあった。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆さんは意外にも自分の胸へ、自分のナイフを突き立てたまま、血だまりの中に死んでいました。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆さんは意外にも自分の胸へ、自分のナイフを突き立てた儘、血だまりの中に死んでゐました。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "死にかけてから縄が切れて落ちたもので、床板の上には吐出した血だまりがあつた。",
              "citation": {
                "source": "篠笹の陰の顔",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "機銃弾は発見されたが、血だまりは雨に洗われたためか、はっきりしなかった。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "五助ちゃんが穴の奥でさぐっているとき、その血だまりに手をふれたんだ」「あっ、そうか」五助は青くなった。",
              "citation": {
                "source": "雪魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "大利根博士邸の秘密室にこぼれていた古い血だまりは、一体なにを語るのでしょうか。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この血だまりのあることを知っているのでしょうか。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "死にかけてから縄が切れて落ちたもので、床板の上には吐出した血だまりがあった。",
              "citation": {
                "source": "篠笹の陰の顔",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うしろを見て、ふりかえってよ、　くつの中は血だまりだ。",
              "citation": {
                "source": "アッシェンプッテル",
                "author": "ASCHENPUTTEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟は血だまりん中へ突っぷしてしまう、亭主が驚いて戸外へ飛び出して巡査を呼んでる暇に、｜その畜生が辻馬車に乗ってどっかへ行ってしまったというんだ。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "合乗り乳母車　――仏蘭西縦断の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに屍体があって血だまりはそこにしかない、ただ一ヶ所しかない小さな広さのマンナカに殺されているということは、つまり、彼は逃げなかったということを意味しているのではなかろうか。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十二　愚妖",
                "note": "青空文庫"
              }
            },
            {
              "text": "敷布のくぼみの血だまり、籐椅子の上の金盥には、赤い水が縁まで、なみなみとたたえられている。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "気抜けしたような男のうしろには、五人の客が、明るい電灯の光の下で、ねっとりとかがやく血だまりを見ていた。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと見ると、血だまりのなかに女の服の釦が落ちている。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "別に拭いた樣子も、掃除した跡もないのに、縁側に少し血だまりがある外に、單衣に少し附いて居るだけぢやないか。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "月待ち",
                "note": "青空文庫"
              }
            },
            {
              "text": "若者たちは一日中屠殺場にいて、暴力的な死を振りまき、家畜の上に落ちる悲劇を目撃し、引っ切りなしに起こる哀れを誘う叫びを耳にして、血糊や湯気を上げる血だまりの上をぐちゃぐちゃと歩き回り、それらの臭いを吸って過ごすのです。",
              "citation": {
                "source": "夕映えのむこうの国",
                "author": "時代を超えた童話",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ごくろうでした」「そこもとにも」　と、伴天連と半助は、こう会釈をして、すぐに刑吏へさしずして、死座をつくらせ、血だまりの穴をほらせ、水柄杓をはこばせる。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニワトリたちはネコの姿を見ますと、たちまちだまりこんで、地面をつつきまわしては、一生けんめい虫をさがしているようなふりをしはじめました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
