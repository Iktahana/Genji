          "literary": [
            {
              "text": "だが自ら秩然と取旁付ている。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾レ又案ヲ拍チ筆ヲ按シテ姦人狡児ヲ懲罰セント一大呼スレバ、汝秩然トシテ其ノ行伍ヲ整列ス。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "市街の秩然たる、物価の不廉なる点は米国に類す。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "仰いで天文を望めば、日月星辰、秩然として羅列するもの、一つとして妖怪ならざるはなし。",
              "citation": {
                "source": "妖怪学講義",
                "author": "緒言",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
