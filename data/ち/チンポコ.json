        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「ぼくのちんぽこ、見て見て！」と子供が元気よくお風呂から飛び出してきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "おしっこを我慢しすぎて、ちんぽこの先がムズムズすると彼は半べそをかいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "赤ちゃんのオムツを替える時、小さくて可愛らしいちんぽこに思わず微笑んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "可愛いいちんぽこから小便が出る。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "六人の女の中に独り息子と生まれたので、母は時々もしかと思って私のちんぽこを探って見ては安心したと言うのだ。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "・後悔の朝の水を泳ぎまはる　ちんぽこにも陽があたる夏草（或はまらか）　　　　□・いやなおもひでのこぼれやすいはなだ（改作）・朝月にこほろぎの声もととなうたとにかく、更生しなければ、私はとても生きてはゐられない、過去一切の董習を清算せずにはゐられなくなつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちんぽこは白く子供の顔はあんらくそうであった。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者はその時、「小袖曾我」のシテを承っていたが、筆者の装束を着けていた高弟の某氏（秘名）が筆者の小さなチンポコを指の先でチョイと弾じいた。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "小指の先程のチンポコを出したまゝだつた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つが由の「朝顏の莟みたいな」チンポコへとんだ。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、戸を少し細目にあけると、そこからチンポコだけ出して、勢ひよく表へやつた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "拳固を握りしめて、一太は、「おっかちゃんにチンポコなんぞなーいよ、イーだ！",
              "citation": {
                "source": "一太と母",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかんぼ昨日うまれたあかんぼを、その眼を、指を、ちんぼこを、眞夏眞晝の醜さに憎さも憎く睨む時。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬　日露戦争に戦場で負傷して、衛生隊に収容されないで一晩倒れてゐたものは満洲犬にちんぼこから食はれたさうだ。",
              "citation": {
                "source": "拊掌談",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
