        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "…………………………ちゅんちゅん雀が鳴いている。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "軒端には、雀がちゅんちゅんと、間をおいて鳴きかわしている。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "（指さして）じゃ、向うの方でちゅんちゅん鳴いてるのは？",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちゅんちゅんないて、はねをぱたぱたさせながら、やってきました。",
              "citation": {
                "source": "アッシェンプッテル",
                "author": "ASCHENPUTTEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と　ババールが　あやしんでいると、　ことりたちが　そろって　ちゅんちゅん。",
              "citation": {
                "source": "ババールとサンタのおじさん",
                "author": "BABAR ET LE PERE NOEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "のき下では、　ムクドリや　スズメが　クリスマスの　パイを　うたい、　小ガラスは　教会の　てっぺんで　めざめて、　そして　ま夜中だと　いうのに　ツグミと　コマドリが　さえずり、　あたりには　小鳥たちの　歌が　ちゅんちゅん　みちみちます。",
              "citation": {
                "source": "グロスターのふくやさん",
                "author": "THE TAILOR OF GLOUCESTER",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
