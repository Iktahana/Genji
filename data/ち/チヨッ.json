        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夕焼とんぼ大きな、赤い蟹が出て、藺草をチヨッキリちよぎります。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨッキン、チヨッキン、チヨッキンナ。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "雀のお宿はあれかいな、あれかいな、チヨッポリ小藪が山の蔭。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "少くとも五圓は出すだらうと思つたのに、と聞えぬ樣にブツ／＼云つて、チヨッと舌打したが、氣が附いた樣に急がしく周圍を見※した。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬鈴薯は『チヨッ』と舌打して自分を一睨したが、矢張一言もなく、すぐ又石本を睨め据ゑる。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "さつぱり舌が回らなかつたよ……それにしても一つ位ゐあの唱へ文句を覚えてゐさうなものだが、チヨッ！",
              "citation": {
                "source": "貧しき日録",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "）「チヨッ」と、彼は舌を鳴した。",
              "citation": {
                "source": "貧しき日録",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたは馬鹿ね……チヨッ！",
              "citation": {
                "source": "海棠の家",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎には、チヨット、わかるまいよ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その一　舞踏会殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼がその函をチヨッキのポケットにしまつた時に、けたゝましい呼鈴が、召使ひ等に食事を告げた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
