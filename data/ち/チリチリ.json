  {
    "uuid": "23177bb0-11fb-51ed-a0a9-810cec3deb23",
    "entry": "ちりちり",
    "reading": {
      "primary": "ちりちり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鏝で勢いよくきゅうとなでて、ちりちりぱっとくくりをつけて、パイプをくわえて考え込んで、モンパリー、チッペラリー、ラタヽパン。",
              "citation": {
                "source": "二科狂想行進曲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校は、便宜に隊を組んで避難したが、皆ちりちりになったのである。",
              "citation": {
                "source": "朱日記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "人は声なくして、ただ、ちりちりと、蝋燭の涙白く散る。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "心細げの小さい葉だけが、ちりちり冷風に震えている。",
              "citation": {
                "source": "善蔵を思う",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "※たけた祖母の白い顔の、額の両端から小さい波がちりちりと起り、顔一めんにその皮膚の波がひろがり、みるみる祖母の顔を皺だらけにしてしまった。",
              "citation": {
                "source": "玩具",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのなかに三本の際だつて長い皺が、ちりちりと横に並んではしつてゐた。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝉の声もいつかきこえず、部屋のなかに迷い込んで来た虫を、夏の虫かと思って、団扇ではたくと、ちりちりとあわれな鳴声のまま、息絶える。",
              "citation": {
                "source": "秋の暈",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鎧を着てよちよち歩いているだろう他吉のほこりまみれの足が想いだされて君枝はそんな甘い想いに瞬間浸ったことが許せないように思い、ちりちり胸が痛んで眉をひそめていると、次郎はいそいそと出て来て、「こっち歩きましょう」　片影の方へ寄った。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬で、手足がちりちり痛み、水洟をすすりあげてゐると、いやな熱が赤く来て、私はもうぐつたりとして、駒を投げ出す、――そんなある日、私はその観戦記を読んだのである。",
              "citation": {
                "source": "聴雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでね、一度その埋地で家中が寄ったが最後で、あとはもうちりちりばらばら。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "途端にちりりんと鈴の音、袖に擦合うばかりの処へ、自転車一輛、またたきする間もあらせず、「危い、」と声かけてまた一輛、あッと退ると、耳許へ再び、ちりちり！",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が立合うて、思うには、祖父祖母、親子姉妹、海山百里二百里と、ちりちりばらばらになったのが、一つ土に溶け合うのに、瀬戸ものの欠が交っては、さぞ疼かろう。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の品々が、山から突抜けに海岸まで、大通りへ、ちりちりばらばら。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ちりちりばらばら。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "笛も琴も音のやんだのは自分の音楽をもっぱらに賞美したい心なのであろうと当人は解釈して、ちりふり、ちりちり、たりたりなどとかき返してははしゃいだ言葉もつけて言うのも古めかしいことのかぎりであった。",
              "citation": {
                "source": "源氏物語",
                "author": "手習",
                "note": "青空文庫"
              }
            },
            {
              "text": "今が伸びざかりの、胡瓜や隱元など蔓性のものは、支柱からはるかに餘つた蔓の先を、生きもののやうに風に靡かせながら、下葉はちりちりに燒け枯れてゐた。",
