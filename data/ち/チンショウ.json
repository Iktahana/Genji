      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "廬州の軍吏｜蔡彦卿という人が拓皐というところの鎮将となっていました。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "稽神録",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫れから段々切迫して官軍（上方勢）が這入り込んで、ソロ／＼鎮将府と云うようなものが江戸に出来て、慶喜さんは水戸の方に行くと斯うなったので、是れは慶応四年｜即ち明治元年春からの騒ぎで、その時に私は芝の新銭座に屋敷が買ってあったから引越さなければならぬ。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "永山という村名は兵団長の名をとったのであろうが、彼が新設第七師団長に昇格して、旭川に鎮将となったのは明治二十七年のことである。",
              "citation": {
                "source": "望郷",
                "author": "――北海道初行脚――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
