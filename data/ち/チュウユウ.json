[
  {
    "uuid": "a7d1a2ae-c6a9-5f67-8449-9d8912d6f37e",
    "entry": "忠勇",
    "reading": {
      "primary": "ちゅうゆう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
