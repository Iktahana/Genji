          "literary": [
            {
              "text": "スクラムルエッグ・ウィズ・ハムとチキンソティー・ライスにシユガーコーン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、ポタアジュ、チキンソティ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、ミネストロン、チキンソティー、アイスクリーム。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋井が来り、守衛を連れて、又風月堂の二階、ポタアジュ（ぬるいのでいつもクサる、何ういふわけか）チキンソティ、マカロニとスウィートポテト、コーヒー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
