        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「チョチョチョチョ、紋よ、われゃ、よそで飯を盗んで食うたりするんじゃないぞ。",
              "citation": {
                "source": "「紋」",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうかいんの、……あれはどこイ行たんかしらん……チョチョチョ。",
              "citation": {
                "source": "「紋」",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョチョチョチョチョチョット……」「ウルサイわねえ。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも俺にとっては実に致命的な意味を含んだ脅迫状が……」「エッ……チョチョチョット待って下さい」　江馬兆策は感動のあまり真白になった唇を震わした。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "流石は青柳……」「チョチョチョッと待て……周章るな。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョチョチョチョットお待ち下さい。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっと一杯と言う処じゃが、今の懐合いではどうにもならぬけに、いずれ又……なあ……」「チョチョチョチョチョッと待ちない。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十日ほど前に誕生した雛共が、一かたまりの茶黄色のフワフワになって、母親の足元にこびりつきながら、透き通るような声で、　チョチョチョチョチョ……　と絶間なく囀るのを、親鳥の　クヮ……クウクウ……クヮ……という愛情に満ちた鼻声が一緒になって、晴れた空に響いて行く。",
              "citation": {
                "source": "禰宜様宮田",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コムソモールカが昔のバレーの白鳥のようにやっぱりああいう風に爪立って、チョチョチョチョと歩いて、キュッと片脚をのばしている。",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョチョチョン、チョチョチョン、チョチョチョン、チョン……太郎の手が鳴ります。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
