    "definitions": [
      {
        "index": 1,
        "gloss": "to lie scattered",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "雪が深々と降り、庭に白く散り敷く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "紅葉した葉が、地面に美しく散り敷いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "風が花びらを運び、石畳に散り敷かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "眞紅な花の散り敷く梅雨の頃が最もいゝ。",
              "citation": {
                "source": "樹木とその葉",
                "author": "夏を愛する言葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "待っているからね、ゆっくり急いでおいでなせえよ」　花のふぶきをひらひら浴びて、小降りの雨にしっぽりぬれて、花びら散り敷く道を山下めがけていっさん走りでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと見るとその辺にも、夕陽の散り敷く町角の彼方此方に七八人の影がちらと動きました。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "お邸にお帰り遊ばし、落葉散り敷く秋のお庭にお下り立ち遊ばした時の、御奉行様のお顔色は全く死人の色のようでございました。",
              "citation": {
                "source": "殺された天一坊",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二本の剣の間を潜り、重り合って地へ散り敷く。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯くて神無月の五日の暮方に庭に散り敷く楢の葉を物踏みならして聞こえければ、女院世を厭ふ処に何者の問ひ来るぞ、あれ見よや、忍ぶべきものならば急ぎ忍ばんとて見せらるるに、小鹿の通るにてぞありける。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "倶忘軒百歩離れて我れ未だ世事を思はず桜散り敷く　熱海の藤原さんの別墅を尋ねた時の光景。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな往来にあるのなんかより、もっと美しい瑞々しい若葉を出してるし、秋には真黄色になって、庭一杯落葉が散り敷く。",
              "citation": {
                "source": "公孫樹",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "其後は今の入江家との地境になりし檜の植込深き間にひそみ庭に下り来りて散り敷く落葉を踏み歩むなり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "散り敷く落葉を踏み砕き、踏み響かせて馳せ廻るのが、却て愉快であった。",
              "citation": {
                "source": "狐",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "誤って花瓶や盞を地に落した時も散り敷く落葉は布団のように軟なために瑕一ツつきもしなかった。",
              "citation": {
                "source": "写況雑記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ物凄い風の音と、木の葉がぱらぱらと窓や、壁板に当って散り敷く音を聞くばかりで、誰とて自分の家を訪ねて呉れるものがありません。",
              "citation": {
                "source": "嵐の夜",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれはしばしば櫟林の中に這入って、一面に散り敷く落葉の上をかさかさ音を立てながら行った。",
              "citation": {
                "source": "吉野葛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "・おもふことなく枯木をひろひあるきつつ　茶の花のちりしくところ寒菊の花・こちらがあゆめばあちらもうごく小春雲・すゝきをばながほほけたままに住みなれた・ゆふ月が、百舌鳥はまだ暮れない・冬夜いつのまに豚をぬすまれた　十二月九日　日本晴、よい日曜日を祝福する。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "実にも二人がその中は、砕けちりしく花｜硝子――夕日の国の寂寥に、絡みて沈む香の色。",
              "citation": {
                "source": "ふるさと",
                "author": "漢那浪笛",
                "note": "青空文庫"
              }
            },
            {
              "text": "供の侍従介は、さっきから、廊の端に、坐ったまま、苑面にちりしく白い桜花をじっと見入っていた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に二人の目の向うの、月光散りしく城内｜遥かの広場の中を騎馬の一隊に先陣させた藩兵達の大部隊が軍鼓を鳴らし、法螺の音を空高く吹き鳴らし乍ら、二｜旒の白旗を高々と押し立ててザクザクと長蛇のごとく勇ましげに進んでいった。",
              "citation": {
                "source": "十万石の怪談",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっと夜が明けはじめた、いちめんの霧である、寒い寒い、手足が冷える（さすがに土佐は温かく伊予は寒いと思う）、瀬の音が高い、霧がうすらぐにつれて前面の山のよさがあらわれる、すぐそばの桜紅葉がほろほろ散りしく、焼香読経、冥想黙祷。",
              "citation": {
                "source": "四国遍路日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "この庭径を踏んだことのある人は、常緑樹の薄明に、下には松葉の散りしくところを、調和ある不ぞろいな庭石の上を渡って、苔むした石燈籠のかたわらを過ぎる時、わが心のいかに高められたかを必ず思い出すであろう。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは金砂をまいた地の上に散りしく花を見入りつつこれこそあの「曼陀羅華」というのであろうと思った。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その姿の妙にも美しい事は、散りしく桜の花の色さへ消えようずると思はれたが、隠者の翁は遍身に汗を流いて、降魔の呪文を読みかけ読みかけ、かつふつその悪魔の申す事に耳を借さうず気色すらおりない。",
              "citation": {
                "source": "きりしとほろ上人伝",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "降る雨に、散りしく梨の花見れば、春の日ながら、寂しかりけり。",
              "citation": {
                "source": "鉄窓の歌",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の凍蝶と病蝶とを対比するに凍て蝶が散りしく葉桜の霜に横わっている光景よりも桜の霜を身の終りとして凍ったという作者の蝶をいたむ主観が勝っている。",
              "citation": {
                "source": "大正女流俳句の近代的特色",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "散りしく花の花びらででもあったら、繚乱もいいかもしれないが、実に困った言葉だ。",
              "citation": {
                "source": "中里介山の『大菩薩峠』",
                "author": "三田村鳶魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "木の葉ちりては散りしく上にそゝぎてやまぬ雨のこゑ。",
              "citation": {
                "source": "偏奇館吟草",
                "author": "永井壮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "七日の月はあかるい月はさくらの花の散りしくうへにしらじら照つた。",
              "citation": {
                "source": "歌時計",
                "author": "童謠集",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、花が散りしくように、次第に増えて行き、或る街角には、真紅の花束を投げすてたように、かたまっていた。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "隅田川のさざ波に、桜の花の散敷く俤。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
