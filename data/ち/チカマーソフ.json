        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "というのは、その家の主人であるチカマーソフ大佐から、その夫人や令嬢に宜しく伝えてくれと頼まれたのである。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、ハハアこれが当のチカマーソフ夫人だなと見当がつく。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、チカマーソフ夫人が言った。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "チカマーソフ夫人は、わたしの相手をつとめながら、ちょいちょい当惑そうな横眼で、まだ型紙の片づけの済まない隣の部屋のドアをぬすみ見た。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、チカマーソフ夫人は、そのドアへ声をかけた。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "』満足に顔を赤らませたチカマーソフ夫人の眼のなかに、わたしはそう読みとった。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、チカマーソフ夫人が歌うように言った。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれは宅の弟の、エゴール・セミョーヌィチですの……」と、わたしの驚きを見てとって、チカマーソフ夫人が説明した。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それでもう、やけになって……」　夜食がすんでからチカマーソフ夫人は、坊さんの肩帯を見せてくれた。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "客間へ通りながら、ふと見ると、すっかり老いこんだチカマーソフ夫人の姿があった。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
