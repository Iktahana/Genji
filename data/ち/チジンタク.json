          "literary": [
            {
              "text": "このことは、ずっと以前、知人宅で手にしたことのある天保十二年版の観古雑帖にもみえていたような記憶がある。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月三十日（土）　片岡鉄兵君、和歌山の知人宅で死亡。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "好きな道とて学校勤めの忙しい中に一週二回、わざわざ知人宅まで出張。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
