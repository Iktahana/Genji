    },
    "definitions": [
      {
        "index": 1,
        "gloss": "acquaintance",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼とは以前からの古いお近づきで、困ったときにはいつも相談に乗ってもらっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "パーティーで名刺交換をしたのがきっかけで、有名な作家とお近づきになれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "せっかくのお近づきの印ですから、こちらの品を受け取ってください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "あなたの不幸が大きくなればなるほど、そうして僕の愛情が深くなればなるほど、僕はあなたに近づきにくくなるのです。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらく彼は、心境の静寂さにおいて芭蕉に近づき、全体としての芸術を、近代の象徴詩に近く発展させたか知れないのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人はジューリングと一緒に気球で成層圏の根元に近づき一時失神しながらも無事に着陸したという経験をもっていて、搭乗気球としての最高のレコードの保持者であった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊橋も後になり、鷲津より舞坂にかゝる頃よりは道ようやく海岸に近づきて浜名の湖窓外に青く、右には遠州洋杳として天に連なる。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "重兵衛さんの家は維新前にはちゃんとした店をもった商人であったらしいが、自分の近づきになった頃はいわゆる「仲持」すなわち、今の土地家屋売買周旋業と云ったような商売で、口と足とさえ働かしておれば自然に懐中に金の這入って来る種類の職業であったらしい。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私の失意や希望や意志とは全く無関係に歳末と正月が近づきやがて過ぎ去った。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "否な当事者はまして読者諸氏にいかほどか優つた二人の激越が徐々にそのクライマックスに近づきつつあるのを感得しつつ、久々の対面の機を待ちかまへて居たか知れませんでした。",
              "citation": {
                "source": "恋愛といふもの",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ごらんなさい、公爵夫人』とライネル・マリア・リルケは、開いた窓のはうへ私と一しよに近づきながら、言ひつづけました。",
              "citation": {
                "source": "旗手クリストフ・リルケ抄",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして自然と人との間に近づき難いやうな壁のあることを意識する。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「修道士の臨終が近づきますと、あの鐘が鳴るのです。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ村で時々顔を見合わしていても近づき難い女だった――両人は思い出すともなく、直ちに、その娘を聯想した。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "橇が、兵士の群がっている方へ近づき、もうあと一町ばかりになった時、急に兵卒が立って、ばらばらに前進しだした。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが一層将校に近づき難い感じを与えた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉太く、眼の細きが、向ざまに顱巻したる、額のあたり汗になりて、のしのしと近づきつつ、細き道をかたよけてわれを通せしが、ふりかえり、「危ないぞ危ないぞ。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほどなく引返してわがひそみたる社の前に近づきし時は、一人ならず二人｜三人連立ちて来りし感あり。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "道は大畝りに、乗上り乗下つて、やがて、野は迫り、山来り、巌近づき、川灌いで、やつと砂煙の中を抜けたあたりから、心細さが又増した。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔える足は捗取らで、靴音は早や近づきつ。",
              "citation": {
                "source": "夜行巡査",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "心が其舎を守らないで浮動泛濫する相になりますから、其相は過失に近づき易い相になるのであります。",
              "citation": {
                "source": "運命は切り開くもの",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "用がないから習わない、習わないからたいそうむつかしく恐ろしく近づき難いもののように思われ、従ってそれに熟達した人がたいそうえらいものに見え、それでつづられた文章がたいそうありがたいもののように見えてくる。",
              "citation": {
                "source": "数学と語学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つは雨夜の仮の宿で、毛布一枚の障壁を隔てて男女の主人公が舌戦を交える場面、もう一つは結婚式の祭壇に近づきながら肝心の花嫁の父親が花嫁に眼前の結婚解消をすすめる場面である。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そろそろもうアイスクリームの冷たくないのに屈辱の余味を帯びた憤懣を感じ、タオルの偶然な差別待遇にさえ世に捨てられでもしたような悲しみと憤りを覚えることの可能な年齢に近づきつつあるのかもしれない。",
              "citation": {
                "source": "三斜晶系",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔父さんは、きっと何か小細工をして岩見先生に近づき、こんなお手紙を私の父にお書き下さるようにさまざま計略したのです。",
              "citation": {
                "source": "千代女",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなはだんだん近づきました。",
              "citation": {
                "source": "革トランク",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もうあなたの方のお祭も近づきましたね。",
              "citation": {
                "source": "土神と狐",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの物音、たちまち起こり、たちまち止み、しだいに近づき、しだいに遠ざかり、頭上の木の葉風なきに落ちてかすかな音をし、それも止んだ時、自然の静蕭を感じ、永遠の呼吸身に迫るを覚ゆるであろう。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "莞爾しながら近づき、「どうも相済まん、僕は全然遊んでいて。",
              "citation": {
                "source": "酒中日記",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "たちまち見る、水ぎわをたどりて、火の方へと近づきくる黒き影あり。",
              "citation": {
                "source": "たき火",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなとこで、案外ぼくらは、貴族とちかづきになるかも知れないよ。",
              "citation": {
                "source": "注文の多い料理店",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "魚の里酒匂川ちかづきぬらし、色、匂、またさま変へぬ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "閑かなるここらの里も、雛祭ちかづきぬらし。",
              "citation": {
                "source": "海阪",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
