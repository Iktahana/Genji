[
  {
    "uuid": "4a39b7d1-e60d-594b-a2c1-c2554fb7a3ec",
    "entry": "ちゃぶ台",
    "reading": {
      "primary": "ちゃぶだい",
      "alternatives": [
        "チャブだい"
      ],
      "is_heteronym": true
    },
    "grammar": {
