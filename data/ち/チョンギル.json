        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「業績が悪化しているから、非正規雇用からちょん切るつもりだ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は一方的に電話をちょん切って、二度と出ようとしなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "会社との縁をちょん切って、新しい人生を歩み始める決意をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
