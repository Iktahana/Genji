    "definitions": [
      {
        "index": 1,
        "gloss": "to chop off",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "邪魔な紐をハサミで勢いよくちょん切った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は怒りに任せて、元恋人との写真をちょん切って捨てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "包装紙の余った部分を、カッターできれいにちょん切る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "出さぬと、はさみでちょん切るぞ。",
              "citation": {
                "source": "猿かに合戦",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ならぬと、はさみでちょん切るぞ。",
              "citation": {
                "source": "猿かに合戦",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "姪のお辰も当然疑いの圏内に入るべきですが、二十一になる華奢なお辰では、虫一匹｜潰すのさえむずかしく、大の男の首をちょん切ることなどは、どう考えても出来ないことです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "遺言状",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうちぎることも、便利なようにちょん切ることも出来っこありません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの鎌とはさみで、地上にはえた二つの首を、草でも刈るように、ちょん切るつもりかもしれない。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしがわたしのものを持ち去るとき、自分で自分の巾着をちょん切るとき、わたしは窃盗取締令をみだすことにはなるまい。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まさかわしたちの首をちょんぎるようなこともあるまい。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴婦人が引っぱっている革の紐のたるんだところを目がけて、例の鋏でチョン切る。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "バカ大竜の首をチョン切ってこいと云われればそのトンマ首をチョン切ることは絶対だ。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代り、あと二十回でまとめると変テコな出来になるから、今チョン切る不親切をかんべんしてくれ、という意味の事情を明記しておいてくれ。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは徳川時代にも辻斬りなどというものがあり、相手に対し怨みも何も無いものを犠牲にして、首をチョン切るというようなことをした。",
              "citation": {
                "source": "最近の犯罪の傾向に就て",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to fire (a person)",
        "register": "standard",
