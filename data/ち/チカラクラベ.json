    "definitions": [
      {
        "index": 1,
        "gloss": "contest of strength",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供たちが公園でどちらが早く木に登れるか力比べをしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの二人のレスラーの力比べは、会場を大いに沸かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このプロジェクトは、まさにチームの総合的な力比べとなるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "吾々の足が勝つか、水の勢いが勝つか、一つ力比べをやろう。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "その神と力比べしようとか天地創造の神秘をあばこうとか、そういうことをしていいものだろうか。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "もつと古く溯ると、隼人の俳優・相撲などの起原を説く海幸彦・山幸彦の争ひなどもさうで、水神と地霊との力比べを説く呪詞の、叙事詩化した物から出てゐるのである。",
              "citation": {
                "source": "ほうとする話",
                "author": "祭りの発生　その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "水神に相撲の絡んでゐるのは、諏訪と鹿島両明神の力比べもさうであつて、海を越えて来た――天鳥船神が伴うてゐる――神を鹿島とし、地霊を諏訪として、神話化したのである。",
              "citation": {
                "source": "ほうとする話",
                "author": "祭りの発生　その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たち相戦う若い者、アメリカの学生と日本の学生との力比べによって、勝利がどちらへ転ぶかが、決まるんだ」「でもなあ、あんまりやないか、近ごろのざまは。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "その狐めの通力と裸体武兵衛の『肉の力』とどっちが勝つか力比べ、立派にやって見せましょう」　こう云うと武兵衛は立ち上がって、春夏秋冬の風雨に晒し鍛えに鍛えた筋肉の隆々と盛り上がった胸の辺りをハタと片手で打ったのである。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コオクかベエコンか、力比べをやろうじゃないか。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな魚も、喧嘩も、力比べも、死んだ妻も出てこない。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「汝音にも聞きつらん、予は白山の狩倉に、大熊を撲殺した黒坂備中、此の方も未だ自分に力を試さん、いざふれ汝と力競べをして見やうか。",
              "citation": {
                "source": "怪力",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "力競べをしようとて、娘を川向こうに投げ越した。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　そう云う長閑な春の日の午後、天の安河の河原には大勢の若者が集まって、余念もなく力競べに耽っていた。",
              "citation": {
                "source": "素戔嗚尊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、彼等はもうその時には、流れを飛び越えるのにも飽きたと見えて、また何か新しい力競べを試むべく、面白そうに笑い興じながら、河上の方へ急ぐ所であった。",
              "citation": {
                "source": "素戔嗚尊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでこの力競べは、自然と彼等五六人の独占する遊戯に変ってしまった。",
              "citation": {
                "source": "素戔嗚尊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで今まで臆面も無く力競べをしていた若者たちはいずれも興のさめた顔を見合せながら、周囲に佇んでいる見物仲間へ嫌でも加わらずにはいられなかった。",
              "citation": {
                "source": "素戔嗚尊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　二人はこう云う力競べを何回となく闘わせた。",
              "citation": {
                "source": "素戔嗚尊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いつぞや力競べがあった時、あなたと岩を擡げ合って、死んだ男がいたじゃありませんか。",
              "citation": {
                "source": "素戔嗚尊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "力競べを面白がっていた、ほかの若者たちが殺したのです。",
              "citation": {
                "source": "素戔嗚尊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、相撲は、もとは大きいものと小さいものとで取り組んだのであるが、後に、力競べの方に興味が傾く様になつて、大人の相撲と子供の相撲とが、別々に行はれる様になつたのである。",
              "citation": {
                "source": "草相撲の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとは、もつと演劇的要素の多いものだつたと思ふが、それが、力競べにのみ興味が傾いて来たのは、此、時期の関係からであつた。",
              "citation": {
                "source": "草相撲の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、相撲は、もとは力競べだけでなく、もつと演劇的要素の豊かなものであつたと思ふ。",
              "citation": {
                "source": "草相撲の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "少時綱引きの力競べになった。",
              "citation": {
                "source": "死剣と生縄",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "今僕は何者とでも力競べをやれないことはないのだ。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　谷風の敗因　谷風が小野川に負けた浅草八幡社地の角力の日に、蔵前に差しかゝりし時、或る米屋の店先きで奉公人どもが、米俵を捧げて力競べを為し居るのを見て、谷風其の米俵を両手に一俵づゝ持ち、之れを三十五六度｜柝木に打ち、一笑して角力場に向つた。",
              "citation": {
                "source": "初代谷風梶之助",
                "author": "三木貞一",
                "note": "青空文庫"
              }
            },
            {
              "text": "奴もきっと今ごろは、もうすっかり往生して、食堂の粥でも食べているでしょうよ」法力競べの説。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の今住む住宅地の中央の廣場でも、夕方から先づ少年、それから段々と若い衆親爺たちの、力競べになつて行く素人相撲が、毎年夏になると必ずくり返されて居る。",
              "citation": {
                "source": "兒童語彙解説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも現在の墓は、明治四十三年頃に新しく建て換えたものであるが、それ以前から前に云った太刀洗いの池附近に、卵塔型の苔むした自然石が草むらに埋れていて、それが巌流の墓石と云い伝えられ、島に上がった船頭などはよく戯れに、その石を、力競べには手頃なので、差しあげたり、抛ったりしたものだそうである。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ来い、力くらべをしよう。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は忙しく、一生けんめい自分の服のあっちを引張り、こっちを引張りして、目に見えない相手と力くらべをした。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "力くらべなら、幽霊なんかに負けるものか。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "力くらべならば、彼はすこぶる自信があった。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
