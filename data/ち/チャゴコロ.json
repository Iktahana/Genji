        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "茶心がある人（即ち奥深い美しさを求める人であったら）だったら、誰でも心を惹かれ早速用いたい希いを起すのではないでしょうか。",
              "citation": {
                "source": "多々良の雑器",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくなども、その抹茶を愛飮すること、二十年餘にもなるが、無作法、無茶心、何ひとつ卒業してゐない。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは淡々齋の茶心を知つた。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
