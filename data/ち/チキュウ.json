    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二番目の「地久」というのは、やはり四人で舞うのだが、この舞の舞人の着けている仮面の顔がよほど妙なものである。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日、はじめて店をあけた通りの地久庵の蒸籠をつる／＼と平げて、「やつと蕎麥にありついた。",
              "citation": {
                "source": "十六夜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "亡母第四十九回忌、御幸山大権現祭日、地久節、母の日週間。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "御地久しく雨ふらず候よし、郷に宜。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正元年　冬藤村　　　その一　　　　　学生の家　地久節には、私は二三の同僚と一緒に、御牧ヶ原の方へ山遊びに出掛けた。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "左れば生者が死者に対して情を尽すは言うまでもなく、懐旧の恨は天長地久も啻ならず、此恨綿々絶ゆる期なしと雖も、冥土｜人間既に処を殊にすれば、旧を懐うの人情を以て今に処するの人事を妨ぐ可らず。",
              "citation": {
                "source": "新女大学",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "地久節チキユウセツハメデタイナクワウゴウサマノオウマレ日ガツカウモ　ヤクバモイハヒマス。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "錦町の福本とうに無く、神保町の地久庵も最近に廃業して、あの時代の蕎麦屋では、依然連雀町の藪一軒をのこすのみとなったが、これも昔の、ちょっとした植込みなどがあって奥深かった小座敷のおもかげは無い。",
              "citation": {
                "source": "神田界隈",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは土に注がれた愛のしたゝりで、土は所謂地久、而して「愛は何時までも堕つる事がない」からでありましょう。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天長地久、大阪市に幸あれかし。",
              "citation": {
                "source": "大阪といふところ",
                "author": "長岡半太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天長く地久しくとか、天地無窮とか、終り無き世とか云ふのは梨子を「有りの実」と唱び硯箱を「当り箱」と名づけるのと同じく縁喜を祝ふ仮の言葉で、数日の後には必ず枯れるに定まつた松の切り枝を立てて常磐の栄を願ふ徴しとするのと同じ心持で常に唱へて居るに過ぎぬ。",
              "citation": {
                "source": "人類の将来",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このことは天平の伎楽面を鎌倉時代の地久面、納曾利面の類と比較して見れば明らかである。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然らばこの誓約こそは天長地久変ることなかるべきである。",
              "citation": {
                "source": "永久平和の先決問題",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
