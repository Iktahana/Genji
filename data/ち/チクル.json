        "examples": {
          "standard": [
            {
              "text": "チューインガムの原料であるチクルは、天然ゴムの一種です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "チューインガムの主成分はチクルである。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "チクルはメキシコ産のものが質が良いとされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "或地方にてはトイチセクルと云ふ名行はれ、或地方にてはトイチクルと云ふ名傳はれり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
