[
  {
    "uuid": "ac4d98a8-19a2-5b74-a922-a17a44d48923",
    "entry": "知能",
    "reading": {
      "primary": "ちのう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
