        "examples": {
          "standard": [
            {
              "text": "古代ローマのチャリオット競走は、コロッセオと並ぶ人気の見世物だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "博物館に展示されたエジプトのチャリオットは、精巧な木工技術で作られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "映画の中でチャリオットを駆る場面は、長期間の訓練と準備を要したという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "自分このようなものを見るの始めてだったから、騎兵や、軽砲車がチャリオットのようにとんでゆく様子を面白く思った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここの生活は丁度おそろしい不揃の馬におそろしくぶぞろいな手綱をつけたチャリオットがころがって行くような生活よ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
