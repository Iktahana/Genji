          "literary": [
            {
              "text": "父｜克勤は済寧の知府たり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "火箭　乾隆六年、嘉興の知府を勤める楊景震が罪をえて軍台に謫戍の身となった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "子不語",
                "note": "青空文庫"
              }
            },
            {
              "text": "知府が現場に出馬して、古碑を檢閲した後ち、之を見事な土臺の上に安置し、風雨の迫害を保護し、同時に諸人の觀覽を自由にすべく、碑の上に碑亭を構へた。",
              "citation": {
                "source": "大秦景教流行中國碑に就いて",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
