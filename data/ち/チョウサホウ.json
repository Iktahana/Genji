          "standard": [
            {
              "text": "社会学の授業で、インタビューと質問紙を組み合わせた調査法について学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "研究者は既存の調査法では捉えられない側面があると感じ、独自の手法を開発した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "教授は「この調査法では回答者の本音を引き出しにくい」と指摘した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "れっきとした大家の古文章古記録に載らず石塊か古墳かがなくてはならず、社寺、堂宇等の縁起書に拠らねばならぬ調査法のみが学問ではなくなった。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "半官的なギャラップ博士の米国世論調査所の示したこのたびの失敗は、世界の世論調査法に大きい教訓となった。",
              "citation": {
                "source": "新しい潮",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
