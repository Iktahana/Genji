          "literary": [
            {
              "text": "枕草子に、チユウゲンなる折に大進物聞こえんとありと、人の告ぐるを聞こしめして、……めのありしをたゞ取りに取りて喰ひまぎらはしゝかば、チユウゲンにあやし（賤）の食ひ物やと人も見けんかし。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "更科日記に、夕潮たゞ満ちに満ちて、今宵宿らんもチユウゲンに、潮満ち来ればこゝをも過ぎじと、ある限り走りまどひ過ぎぬ。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
