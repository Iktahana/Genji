        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "田中ちゃまが来られたそうですね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ちゃまのご意見をお伺いしたいのですが。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "山田ちゃまはいつ参加されるのですか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "私を見つけると、すぐにばたばたと玄関に駈け込んで、園子ちゃんが来たわよう、お母ちゃま、と呼んで下さった。",
              "citation": {
                "source": "十二月八日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はどういうものかしきりと子供の時のことを想いだして、さきほども別荘の坊ちゃまたちがお庭の中で声を揃えて唱歌を歌っておいでになるのを聞いた時なんだか泣きたくなりました。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おや、これがお嬢ちゃまで、おかやちゃんで、さようでまあ」と、お媼さんからかやの方へ向けた笑顔は、しゅっと引き釣った両唇とは反対に、切れ長の眼瞼が、二筋三筋の皺を走らせて流れる様に眼尻の方へ上品な愛嬌を溢して居た。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「町人百姓の子に、お嬢様たあ勿体すぎる」　斯う苦り切って云うお爺さんの前では止めたけれども、蔭へ行くと婆やはかやを、かやちゃまだの、お嬢様だのとよく呼んで居た。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おや、おかやちゃん、あんた、甚三さんに、見惚れて居なはるな、甚三さん、おかやちゃんがな、このお嬢ちゃまがな、お前さんの笛の音が、大好きでな、毎晩々々、それはそれは、熱心に聞きとて居なはることよ、な」　婆やの、このおしゃべりが終った時、甚三はまた、誰にということも無く例の笑いを、にっと現わした。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「かやちゃま、おかやちゃん、どうした、どうしなはったよ」　斯う云い乍ら、気忙しく婆やがかやを抱き起すと、かやのそむけたままの横顔は真赤に染まって、縁板には三四滴の涙の痕がついて居るのであった。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「坊っちゃまは……」　と、女中はなぜか赧くなって、「お出掛けどす」「ふーん。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「坊ちゃま」　お雪は幹男の上衣の端を掴んだ。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「…………」「一体どないしたんや」「…………」「言うてみイ」　お雪はきっと涙にぬれた顔をあげて、「坊ちゃま。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの、かわいらしい、伯爵のぼっちゃまは、それはそれは愛らしくて、神さまの天使のようでした。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼっちゃまは、アンネ・リスベットに、とてもなついていました。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンネ・リスベットも、ぼっちゃまが大好きでした。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼっちゃまは、アンネ・リスベットにとっては、大きなよろこびでした。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのぼっちゃまも、今は大きくなって、十四｜歳になっています。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンネ・リスベットは、赤ちゃんのときに、だいてあげてから、ぼっちゃまには、一度も、会ったことがありませんでした。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すてきな、わたしのかわいい、ぼっちゃまのところへ、すぐ行ってこよう。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっと、ぼっちゃまも、わたしのことをこいしがって、心にかけていてくださるにちがいないわ。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼっちゃまだって、きっと。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、早く、ぼっちゃまにお目にかかりたい」と、アンネ・リスベットは思いました。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "かわいいぼっちゃまには、食事のあとで、お目にかかることになりました。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、ぼっちゃまは、すっかり大きくなって、ひょろ長くなっています。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼっちゃまは、アンネ・リスベットを見ました。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼっちゃまは、すぐに、くるりとふりむいて、むこうへ行こうとしました。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、もう、いいよ」と、ぼっちゃまは言って、部屋から出ていってしまいました。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "このぼっちゃまこそ、アンネ・リスベットが、どんなものよりも、強く愛してきた人です。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、そのぼっちゃまは、さっさと行ってしまったのです。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぼっちゃまは、あんなによそよそしくなってしまった。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、わたしは、あのぼっちゃまを、小さいころ、昼も夜も、だいてあげたのに。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンネ・リスベットは、伯爵のぼっちゃまを、心から愛していました。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのぼっちゃまに、会いたいばかりに、遠い道を歩いていったのです。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
