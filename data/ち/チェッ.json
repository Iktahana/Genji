    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ちぇっ、つまらねえ事になりやがった」「私、もう一度、なおしたいの。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「無理でしょう」　とおかみさんは、口をはさみ、「お可哀そうよ」　ちぇっ、と上原さんは舌打ちして、「そんなら、こんなところへ来なけれあいいんだ」　私は黙っていた。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ちぇっ、若いのをおもらいになったんでしょう？",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちぇっ、そんな叫び声あげたくらいで、自分の弱虫を、ごまかそうたって、だめだぞ。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀木が、それを読み、上機嫌のその顔がみるみる険悪になり、「ちぇっ！",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "君たちは、たったいま、一の鳥居をくぐっただけだ」「ちぇっ！",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゃくにさはったまぎれに、あの林の下の堰を、たゞ二足にちぇっちぇっと泳いだのでした。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゃくにさわったまぎれに、あの林の下の堰を、ただ二足にちぇっちぇっと泳いだのでした。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちぇっ、莫迦にしていやがる。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「また、やったな、ちぇっ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういうホシをつけなすったかしらねえが、割らなきゃ口を割るように、早いところ締めあげておしまいなせえよ」「だめだよ」「ちぇっ、べっぴんだから、おじけが出たんですかい」「うるせえな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "曲芸三人娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たちはいまからすぐ出発して、ともかく日の出ごろには戻って来られるだろう」「では君は、この君の酔狂がすんでしまって、甲虫一件がだ（ちぇっ！",
              "citation": {
                "source": "黄金虫",
                "author": "THE GOLD-BUG",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが次ぎの瞬間には、何も言うことがなくなり、それから今度は、『ちぇっ、まるで得体の分らぬ男だ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼は馬車を停めると、女の子を助けておろしてやりながら、『ちぇっ、なんて穢ねえ足をしてやがるんだい！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちぇっ、なんちゅう駄馬だろう！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ちぇっ、この＊２ソフロンめ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ちぇっ、こいつ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "【ちぇっ、くそ喰えだ！",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちぇっ、君の煙草なんか、くそ喰えだ！",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちぇっ、まったく、こんな馬鹿な恰好ってあるもんじゃない！",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちぇっ、てんでまたわからなくなってしまったぞ！",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "【ちぇっ、どんなもんだい！",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちぇっ、畜生め、こりゃ女じゃないか！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし不思議なことに、彼の言葉には、何やら頼りないところがあって、今にも自分自身に向って、『ちぇっ、嘘をふいてらあ、それも大嘘をさ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　セリファンはそれに対して一言の口答えもしなかったが、首を垂れたまま、どうやら肚の底では、『ちぇっ、飛んでもねえことになっちまったぞ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
