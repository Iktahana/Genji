        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「夜明け前の静かな森に、小鳥の『チェッ、チェッ』という控えめな鳴き声がした」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「茂みの中から『チェッ』と音が聞こえたが、正体は小さなスズメだった」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「飼っている文鳥が、構ってほしい時に『チェッ』と甘えるような声を出すんだ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
