        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "文楽劇場では、太夫と三味線弾きがちょぼを務める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "義太夫節では、語りと三味線を担当する人をちょぼと呼ぶ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "舞台の脇で、ちょぼが物語の世界を語り上げる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
