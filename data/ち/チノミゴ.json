[
  {
    "uuid": "f79b97a2-ddcd-5c66-bfa6-86e0ee7589fe",
    "entry": "乳飲み子",
    "reading": {
      "primary": "ちのみご",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
