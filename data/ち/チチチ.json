        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "薬鑵は顛倒して濛々たる湯気が部屋に立ちこもり、先生は、「あちちちちち。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あちちちち、ひでえ、あちちちち、助けてくれ、柴が燃えてる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「細工はりゅうりゅう、手並をごろうじろ」　と彼は抑揚をつけていったが、蓋の熱さに堪えなかったものと見え、ち、ちちちといって、蓋を急ぎ下に置いた様子も、逸子には壁越しに察せられた。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あちちち」と顔を皺めて、「痛い事をなさるねえ！",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜜柑の匂いなどのする四下には、草のなかに虫がそこにもここにも、ちちちちと啼いていた。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "崖くづれのした下の茂みでははぐれ小鳥がちちちちとやつてゐる。",
              "citation": {
                "source": "蜜柑山散策",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その母も、ちちちちと、その音聴きき。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "白いお馬は、主かいな今宵帰して、いつの日か濡れにくるかや、しっぽりと抱いて、あかした移り香のさめて、果敢なや、肌寒の朝の廓の霜景色霜にまごうか白い馬「とくらあ――あちちちち」　一人の若い衆が、湯の中から、飛上った。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして海と風とのどよめきが四辺を罩めている中に、ちちちちと木の葉の様な眼白鳥が幾つとなく啼いて遊んでいる。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "よくみていると、初秋に飛んで来るみそさざいが、ちょん、ちちちっと気ぜわしく飛びはねているが、死んだ田舎の祖母が、「みそさざいが来ると、雪が降るだよ」と言った事を思い出して、秋はいいなア、と啓吉は思わず空を見上げた。",
              "citation": {
                "source": "泣虫小僧",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あちちちちッ」義眼はあつくなっていて、彼の手を焼いた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "机博士は、最後の言葉もおわらぬうちに、「あっちちちち」と、叫んで右の眼をおさえた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あっちちちち」　机博士はふたたび叫んで、今度は左の眼をおさえた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、チチチと何處からとなく聞えてくる朝の雀の囀りに耳を傾けながら、今日誰が見舞ひに來てくれるだらう――などと云ふ事を、樂しみながら考へたりした。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チチチチ、チュ、チュッ、すぐに掌の中に入った。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チチーン、シャン、チチチ、チチチン。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もみぢが、ちら／＼とこぼれて、チチチチと小鳥が鳴く。",
              "citation": {
                "source": "妖魔の辻占",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "往来をあるいているこどもたちまでが、「チチチ、クルック、クルック、クルック」と、うたうと、皇帝もそれについておうたいになりました。",
              "citation": {
                "source": "小夜啼鳥",
                "author": "NATTERGALEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "――チチチチと鳴くのはこおろぎか松虫か、恋呼ぶわびしい虫の声である。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "……チチチチチチチ……クリクリクリクリクリクリ……チチ……　という小鳥の群が、松の間を渡る声が聞えるばかり……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは耳朶じゃねえったら……アチチチ……コン畜生……」「ハハハハ。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲角の向うから、気狂いじみたチンドン屋の馬鹿騒ぎが、チチチンチチチンと聞えて来た。",
              "citation": {
                "source": "石塀幽霊",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり、その頃、庭には楓の樹が紅らんでいて、屋根の上では雀がチチチと啼いていたのかしら、そうすると、雀はその時、雄二が産れたことをちゃんと知っていてくれたような気がします。",
              "citation": {
                "source": "誕生日",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ものすごい雲の流れを背に、立ち木が二、三本ヒョロヒョロと立って、くずれた石垣のあいだに、チチチと、耳鳴りのような音をたてて鳴いているのは、あれは、なんの地虫？",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "チチチ……とまるで生きもののように、二つの刀の先が五、六寸の間隔をおいて、かすかにふるえているのだが、どちらかの刀が少しく出て、チャリーと小さな、けれども鋭いはがねの音を発するが早いか、双方ともに何ものかに驚いたかのごとく、パッと左右に飛びはなれて静止する。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お藤はじっと眼を据えて、這いまわる尺取り虫を見つめながら、ツンツルルン、チチチン、チン……。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、たんと思召しを投げて頂戴ね」　みんなおもしろがって、「さあ、やんな、やんな」「お鳥目は、おいらがあとで集めてやらあ」「毎度おやかましゅう」三味線の手を休めたお藤、「ではお言葉にあまえまして、江戸名物は尺取り虫踊り……」　チチチン！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "大之進の一刀と、濡れ燕と、ふたつ斬っ尖のあいだがみるみるせばまって、チチチと二本の刃物のふれあうひびき……と！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャンの返事はなく、ただ籠の中で、小鳥がチチチと鳴いていた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "水は硝子のせいでもあろうか、淡い青色に染まっていて、ときどきチチチと歪んでみえた。",
              "citation": {
                "source": "火葬国風景",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
