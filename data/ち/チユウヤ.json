        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――「チユウヤといふ偉い武士が、彼れの友達のジオシツといふものと共に、皇帝に対する陰謀を企てたことがある、このチユウヤの妻は、才色兼備の女だつた。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "チユウヤの陰謀は五十年間秘密に計画された後、とうとう、チユウヤの失策のために、露顕することになつた。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして政府は、チユウヤ並びにジオシツを逮捕せよといふ命令を出した。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、捕手はチユウヤの門の前で『火事だ、火事だ』といふ声をあげた。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "チユウヤは火事を見届けるために、門の外へ走り出した。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしチユウヤは、勇敢に戦つて、捕手を二人斬り殺した。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "チユウヤの妻は、その間に、格闘の音を聞いて、早くも捕手の向つたことをさとり、夫の重要書類を火の中に投げ込んだ。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "チユウヤの妻のおちついてゐたことは、今日でも、日本中の驚嘆の的になつてゐる。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのために女の判断力並びに決断力をほめる場合には、チユウヤの妻のやうだといふくらゐである。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　このチユウヤは、勿論、丸橋忠弥であり、ジオシツは由井正雪である。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
