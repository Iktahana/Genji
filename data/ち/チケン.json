        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "木は伐られ、道は拓かれ、彼処にも一塁、ここにも一塁、やがて一大｜要塞地圏の現出が思われた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            }
          ]
