        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "堪らず袖を巻いて唇を蔽ひながら、勢ひ釵とともに、やゝ白やかな手の伸びるのが、雪白なる鵞鳥の七宝の瓔珞を掛けた風情なのを、無性髯で、チユツパと啜込むやうに、坊主は犬蹲に成つて、頤でうけて、どろりと嘗め込む。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "前の電線に雀がチユチユツと飛んで来て交んだかと思ふとパツと別れた。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、「チユツチユツ、ホラホラ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして奥歯を甘さうにチユツ／＼と鳴した。",
              "citation": {
                "source": "白明",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "旨い汁があればチユツと吸ふし、氣に喰はぬ奴が居ればチクリと刺す。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、與へる物質の代りに、彼の異臭を放つ汚い顏をかろく抱いて、その頬へ、チユツと接吻してやつた。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
