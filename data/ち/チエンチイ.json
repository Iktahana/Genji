        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "番付には流石にわが實の苗字をしるさんことの恥かしくて、假にチエンチイと名告りたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく云ひつゝ我を視て、扨は新顏の即興詩人を伴ひ歸りしか、チエンチイといふなるべし、違へりやと云ふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "公子はチエンチイとはと我面を顧みたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "さるにても、フアビアニ、おん身は何故我に一たびもチエンチイの事を語らざりしぞ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
