  {
    "uuid": "459f5b7b-fc4b-5469-8872-b860fb264b94",
    "entry": "ちんぴら",
    "reading": {
      "primary": "ちんぴら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ここでちんぴらライターたるこのオレが「それはないんじゃないの」と調子に乗って攻め立てたりしたものだから、一瞬横綱の目玉パワーに陰りが生じたような気がしたのだが、これには後日談があってやはり大人は誠実の人であった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「へえ……偉いね、ちんぴら。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二三のちんぴらな小僧が物蔭から飛び出してこの音楽家の前に立つた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "外でもない、ちんぴらな新聞売子で、医者とエマアソンとの知らない色々の事が載つてゐる新聞を押売しに来るのだ。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "胡桃５・６東京日日（夕）　シカゴのある墓地で、二人のちんぴら小僧が胡桃の実を盗んでゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとね、ああちんぴら絵描きは骨が折れるって云ったから、何をお高く止ってるンだ馬鹿｜野郎、ピンハネをしてやがってと呶鳴ってやったら、いきなりコップを額にぶっつけたンだ」「マア、まるで土工みたいね、痛い？",
              "citation": {
                "source": "清貧の書",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「このあいだのちんぴら少年どもが、警察に知らしたのにちがいない。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あっはっはっ、そのちんぴら小僧は魔術といったな。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのちんぴら娘はおれ達を相手にしやしないよ。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "大馬鹿な餓鬼かちんぴらじゃねぇのか？",
              "citation": {
                "source": "死生に関するいくつかの断想",
                "author": "BITS OF LIFE AND DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてことごとくの眼が私を睨んで、うるさいちんぴら、早く寝てしまえといったふうのことを語る。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "あほうなことを、ちんぴらが言ふよ。",
              "citation": {
                "source": "身毒丸",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸のきりきりする痛みは募る一方であったが、ヴェリチャーニノフはこの厚かましいちんぴら先生が面白くてならなかった。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が陶器の判る人が怖いということにも、文学が彼よりもっと判る人が怖いとおなじことなのだ、ちんぴら作家がとても適わないようなものを書いたとすれば、よくやったという嬉しい溜息をつくまでに彼は成長しているのだが、それだから文学の世界が広くて怖くも思えるのである。",
              "citation": {
                "source": "陶古の女人",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「それ見たまえ、ちんぴらのきみだって、自分のつくったところに、とろけようとしているんじゃないか。",
              "citation": {
                "source": "蜜のあわれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「吃驚するじゃないか、ちんぴら、どうして来たんだ。",
              "citation": {
                "source": "蜜のあわれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「小さいからね、では、勢よく、どぶんとお池に飛びこめ、」「どぶんと飛びこむわ、一、二、三、と、あ、わすれた、明日は理髪店に行く日なのよ、お忘れにならないで、……」「有難う、ちんぴら。",
              "citation": {
                "source": "蜜のあわれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おじさま、あれ、目高が池から飛び出しちゃった、危い、危い、ちんぴらのくせに勢い余って飛び出すやつがあるものか、ほらね、酷かったでしょう、眼を白黒させているわ。",
              "citation": {
                "source": "蜜のあわれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなちんぴらでも、小説くらいは書けるからである。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は三十歳で小説というものを初めて書いたが、藤村の小説の著作は遅れていたけれど、その重量感と、雑誌新聞にむかえられたまろうど振りは、到底、私ごときちんぴらの比ではなかった。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "見てやれ、このちんぴらのそれが何であらうと見てやれといふ圖太い氣が募り出して來た。",
              "citation": {
                "source": "末野女",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、このおれと、ちんぴらのきみとじゃ、勝負にならない。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウヘヘヘ……、小林のちんぴら、よくも、おれをひどいめにあわせたな。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "え、ちんぴら探偵、おれはきみなんかの手にあう相手じゃないよ。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウフフフ……、ちんぴらのくせに、いやにおちついていやがるな。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちんぴら先生、いまに、こいつにきみを食わせてしまうから、かくごするがいい。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても、小林というちんぴらは、じつにすばしっこいやつだ。",
              "citation": {
                "source": "サーカスの怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人組の少年たちは、一般にちんぴらと呼ばれる連中で、なんの必要も理由もないのに、弱そうな者をみつけると威したり、殴ったり、持ち物を奪ったりすることに英雄的快感を覚え、それだけが生きるたのしみだと信じているらしい。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちんぴらどもは彼の酒量に驚き呆れ、三度も酒屋へ馳けつけた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
