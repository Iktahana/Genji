        "examples": {
          "standard": [
            {
              "text": "「ネットショップで注文した商品が、自社便による直配でその日のうちに手元に届いた。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「中間マージンをカットするため、工場から各店舗へ直接届ける直配ルートを確立した。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「お歳暮の時期は配送業者がパンクするので、近所の取引先には社員が直配に伺うことにしている。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "……お庭番といえば将軍さま御直配の隠密。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "捨公方",
                "note": "青空文庫"
              }
            },
            {
              "text": "一階の窓際にとりつけた立看板で、Ｙ新聞竜泉寺直配所としてある。",
              "citation": {
                "source": "安い頭",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
