[
  {
    "uuid": "99220ba9-4cdf-5b92-afd4-6c2421143cd7",
    "entry": "茶請け",
    "reading": {
      "primary": "ちゃうけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
