[
  {
    "uuid": "4e404687-8937-5aca-8399-8246ce3f928b",
    "entry": "茶入",
    "reading": {
      "primary": "ちゃいれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
