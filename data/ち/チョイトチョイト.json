          "literary": [
            {
              "text": "窓の女は人の跫音がすると、姿の見えない中から、チョイトチョイト旦那。",
              "citation": {
                "source": "寺じまの記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョイトチョイト眼鏡のおじさんとかいって呼ぶのが、チイト、チイートと妙な節がついているように聞える。",
              "citation": {
                "source": "寺じまの記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "外へ出ると、人の往来は漸く稠くなり、チョイトチョイトの呼声も反響するように、路地の四方から聞えて来る。",
              "citation": {
                "source": "寺じまの記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
