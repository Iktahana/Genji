[
  {
    "uuid": "ad760ee3-b86f-504e-b53b-8fa530adaede",
    "entry": "貯金",
    "reading": {
      "primary": "ちょきん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
