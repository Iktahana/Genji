[
  {
    "uuid": "a5b6e9dc-321f-5909-9f97-62ea188b922f",
    "entry": "朝廷",
    "reading": {
      "primary": "ちょうてい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
