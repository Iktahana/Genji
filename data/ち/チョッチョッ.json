    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "母の袖の下から首を出して、チョッチョッと呼んで見た。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに非常に人懐こくて、門前を通掛りの、私のような犬好が、気紛れにチョッチョッと呼んでも、直ともう尾を掉って飛んで行く。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "オシャベリ姫は淋しくてたまらないところでしたから、この猫を見るとよろこんで、「チョッチョッチョッ」　と呼びました。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても朝日が昇るにはまだ間があるから、夜食をする名目がたたぬことはない」　と長閑な事をいうと、左手で古市の手を曳きながら大股に食堂に入って行ったが、たちまちチョッチョッと舌打ちをし、「おお、これはいかん。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下へ出る扉の傍に壁を繕った個所があるでしょう、あの中です……」　声の主はいかにも口惜しそうにチョッチョッと舌打ちして、「ああ、そんな気がしていた。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "つゞいて、チョッチョッと舌つゞみを打ちながら、部屋のあちこちを見廻す。",
              "citation": {
                "source": "散る日本",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チョッチョットお待ち下さい、そのサセボ菌というのは」　これは失礼しました。",
              "citation": {
                "source": "エキゾチックな港街",
                "author": "小野佐世男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで如何にもチョッチョッと片付けてしまうように見えるんです。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "手洗鉢の水を、南天の葉へチョッチョッとかけて、手拭掛けに手を伸ばしながら、さて、おもむろに庭の秋色を眺め廻した後、机の抽斗から薬草の胚子らしいものを取り出して庭へ下りた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
