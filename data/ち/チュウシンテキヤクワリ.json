          "standard": [
            {
              "text": "彼はプロジェクト全体で中心的役割を担い、各チームの調整を一手に引き受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "その組織で中心的役割を果たしてきた創業者が引退することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "外交交渉でアメリカが中心的役割を演じ、両国間の合意を取り付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "一万からできる公民館はやがて図書館の機能として動き、文化機構の中心的役割をもって来ることとなるであろう。",
              "citation": {
                "source": "図書館法楽屋話",
                "author": "中井正一",
                "note": "青空文庫"
              }
            }
          ]
