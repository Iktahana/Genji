          "literary": [
            {
              "text": "これは自然私にフルマーノフの「チャパーエフ」（覚えていらっしゃるでしょう？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここでは又農民というものも歴史の水平線の上にあらわれて来て「チャパーエフ」、「壊滅」そのほか。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九一八年の党員で、フルンゼと一緒に赤色戦線で働き、クバン駐在赤軍政治部長をやった若いドミトリ・アンドレーウィッチ・フールマノフは、ボルシェビキ作家の誇、「チャパーエフ」（日本訳、赤色親衛隊）、「反乱」などをわれわれに与えた。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "党の政治部は、例えば、「チャパーエフ」（日本訳、赤色親衛隊）を読んでもよくわかるように、闘争の重大な理論的指導の任務を帯びる。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
