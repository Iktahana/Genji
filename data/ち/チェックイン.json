        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "空港でのチェックインは、オンラインで済ませておいた方が楽だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ホテルのチェックイン時刻は午後3時ですが、早めに到着してしまいました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "飛行機に乗る前に、搭乗手続きカウンターでチェックインをしてください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そしてホテルにチェックインした。",
              "citation": {
                "source": "三重塔にて",
                "author": "福永信",
                "note": "青空文庫"
              }
            },
            {
              "text": "時差と醒めきらぬアルコールがすっかり気分をハイにしてしまい、チェック・インもそこそこにホワイトハウスあたりを見物。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "空港でチェック・インをすませてロビーにいると、妹のヘレンがやって来た。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はロビーのソファで待ち、彼がチェック・インして部屋の鍵を受け取った。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パン・アメリカン航空のカウンターで節子がチェック・インしているところへ、美容院店主の杉山美代子が主任の女性とともにあらわれた。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
