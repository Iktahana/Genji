          "literary": [
            {
              "text": "彼等夫妻がある都会のホテルに滞在していたとき毎日細君に花束を届けてよこした一人の人間を、そのことからいい人間、チストカが意外ないい人間という風に判断するとすれば、それは最も凡俗な女流作家或は文学少女の人物評価の基準でなければなりません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○この頃 Партия〔党〕のチストカ〔粛清〕が行われて居る。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "小心なるボルシェビキはチストカ〔粛清〕でつかれて眠る。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
