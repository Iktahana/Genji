          "literary": [
            {
              "text": "ほんとに、いい笑はれもんだよ、定期市へ出かけて来て、苧麻ひと握りよう売らないなんて……。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "衣服なども苧麻を染めて手織りで作っているが、非常にいいものが出来る。",
              "citation": {
                "source": "台湾の民藝について",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
