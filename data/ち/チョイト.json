        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ここらでチョイトひと休み。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは旧と同僚で有ッた山口｜某という男で、第一回にチョイト噂をして置いたアノ山口と同人で、やはり踏外し連の一人。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し、ここいらでチョイト普通人の真似をして、常識的の順序を立てて書く事にすると……まず第一に明かにしなければならぬのは吾輩の自殺の動機であろう。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでチョイト外を覗くと直ぐに大｜卓子の前の方へ引返して来たが、その態度は、今までよりも又ズット砕けた調子になっていた。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "小便に行かっしゃったとじゃろか」　と呟やきながらお作はチョイト表の方の暗がりを振り返った。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬の首ッ玉の耳の背後よりも少し下った処……八釜しく云うと七個在る頸骨の上から三つ目ぐらいの処をチョイト抓むと、ドンナ猛犬でも頭がジインとなって、この人にはトテモ敵わない。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこれほどの怪事件はチョイトほかに類例が無いし、問題が又ドエラク大きいもんだから、あの報告書が出来上っても、どこへ出したら宜えかチョット見当が附かんで困っておったところだが……まさかソコを探知して受取りに来たんじゃあるまいな……君は……。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョイト絡んで来たところが気に入ったよ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな呼吸をしても……チョイト動いても、すぐに運命の神様の御心に反いて、大変な事が起りそうな気がして来た。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのオ……チョイト……ボーイさん。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これには流石の頭山満もチョイト本気になったらしい。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ネエ……チョイト……」　という艶めかしい声を、耳のすぐ傍で聞いたように思ったので、彼はハッとして眼を見開いた。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……「ネエ……チョイト」という秘やかな声をハッキリと耳にして、思わず立ち止った事も一度や二度ではなかった。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ……チョイト雲雀さん。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "時と場合では宴会の席上にも来るが、芸妓のように「アラチョイト」式の活躍はしない。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アラチョイト、あなた学生さん？",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チョイト、チョイト、旦那おあがんなさい。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒形の高麗屋敷の、とある横町を屑イ、屑イと流していますと、乙な年増が、チョイト屑屋さん……」「コレコレ、仮声は抜きでよろしい」「恐れ入ります。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「姐御、もうでえぶほとぼりの冷めたころだから、あっしアこれから、品川であの柳生源三郎の一行から盗みだしたこの壺を、妻恋坂の峰丹波様へ納めてくるぜ」「チョイト、張り板が裃を着たような、ヤに突ッぱった田舎のお侍さんたちが、眼の色かえて江戸じゅう、そいつを探しているっていうじゃないか。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、この門之丞の心が、それこそチョイト門からころがりでて、とほうもない方向へ走りだし、いまこの丹波の一党に加担するようになったのは、あの十方斎先生のお葬式の日からでした。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "屑イ、屑イ――」「チョイト、屑屋さん！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ではチョイト待ちたまえ。",
              "citation": {
                "source": "蠅",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなに細かに手紙やっておいたのに、ペンが使いに行ったらそのときになって二階をチョイトゴソゴソやって云うには、何しろ古いものだから分りかねる、受とりを見せてくれれば見つけるが、という次第です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩のお酒を買うために特別に落したお金だから、オツリを出しな」「チョイト、お前さん。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はお前さんのほかの男なんかデクノボーにしか見えやしないんだから」「オメエは浮気じゃないけれども、チョイト遊ばせないかなんて男に袖をひかれたときには悪い気持はしないだろう」「とても悪い気持がするんだよ。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台の上からチョイトなんてパン助いるかい」「あんなこといってらア。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
