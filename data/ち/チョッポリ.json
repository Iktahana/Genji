        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "舞台下手にちょっぽり枯田の畦が現れ、小さい石地蔵、施餓鬼の塔婆など立っている。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――大きな頭に、ぎろぎろと動く大きな目玉、それから、胴中がほんのちょっぽりしかついていなくて、すぐ手足みたいなものが生えている。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、書記の火はもっともっとちょっぽりで、一片の石炭かと見える位であった。",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方はいわゆる山また山さ、その上から富士がちょっぽりのぞいてるなんぞはすこぶる妙だ。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
