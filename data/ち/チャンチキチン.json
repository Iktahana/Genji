        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ずらりと並んだ舞子たちが、キラキラと光った鉦を揃えてたたくのだ、チャンチキチン、コンコン、というのだ。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの、チャンチキチンのために、ますます算術が馬鹿々々しくなって来るのであった。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "大工あり、日に何時間と読むうちに、何んだつまらないと思うと同時に、チャンチキチンの囃子が猛烈に始まるのだった。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうなると問題も試験もくそもなく、ただ私はチャンチキチン、なのだ。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "その瞬間、芦辺踊りもちょっと鳴りやむのであるが、出来ませんといってこの災難を追払うと同時に、またもやチャンチキチンだ。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "親父の臨終において、チャンチキチンなど考えているべきはずではないではないかと私は私の囃子｜方へ、ちょっと注意をしてやった。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう私の一生涯はチャンチキチンでも、ドンドンでも何んでも来いだと思った。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
