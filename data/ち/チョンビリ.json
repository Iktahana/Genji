          "literary": [
            {
              "text": "頭は悉皆禿げていたがそれでも秋の芒のようにチョンビリと白髪が残っている。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶色の根の囲りに土の中から、浅いみどりの芽がチョンビリのぞいて居るのが、いかにもたのもしく又いじらしく見える。",
              "citation": {
                "source": "霜柱",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "四匹は白黒、チョンビリ茶。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じゃ大方イギリスの資本家は、さんざっぱら合理化してチョンビリ残した労働者を一人一人馬車へでものっけて運んでるんだろ！",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
