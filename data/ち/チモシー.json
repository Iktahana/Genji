        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "うさぎの餌として、新鮮なチモシーが与えられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "広大な牧草地には、チモシーが風になびいていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "チモシーは家畜の飼料としてだけでなく、園芸用にも利用される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "彼は野生になったティモシーの茎を抜き取って、その根もとのやわらかい甘味を噛みしめなどしながら父のあとに続いた。",
              "citation": {
                "source": "親子",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "リービは　ぱんやきティモシーのところに　よって　マフィンを　買いました。",
              "citation": {
                "source": "パイとやきがたのはなし",
                "author": "THE TALE OF THE PIE AND THE PATTY-PAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん　ものうりの　にぐるまは　まわってきます　――　おにくやさんに、　うおやさん、　それから　ぱんやきティモシー。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも　〈キャラウェイシード〉のパウンドケーキや　スポンジケーキ、　バターロールパンだけでは　なかなか　いきてはゆけません　――　ティモシーが　つくるほど　おいしい　スポンジで　あってもです！",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ティモシー・リアリイは、ＬＳＤを「脳のためのビタミン剤」と呼んだ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この態度のひとつのあらわれを、ティモシー・リアリイは、ステージのマイクのつかわれ方のなかにみている。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはティモシー・バーリー判事の家で、一七二三年に建てられた後ずっと住居として使われてきた。",
              "citation": {
                "source": "長い部屋",
                "author": "O. H. ダンバー　O. H. Dunbar",
                "note": "青空文庫"
              }
            },
            {
              "text": "ティモシー判事の綺麗な若妻が使っていたのはここに決まってる！",
              "citation": {
                "source": "長い部屋",
                "author": "O. H. ダンバー　O. H. Dunbar",
                "note": "青空文庫"
              }
            },
            {
              "text": "ティモシー判事までたどり着けたかい？",
              "citation": {
                "source": "長い部屋",
                "author": "O. H. ダンバー　O. H. Dunbar",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ティモシー・バーリー判事がアン・スティールと結婚したのは彼女が十七の時でした。",
              "citation": {
                "source": "長い部屋",
                "author": "O. H. ダンバー　O. H. Dunbar",
                "note": "青空文庫"
              }
            },
            {
              "text": "簡単に要約することにしましょう……「ティモシー判事はチャーミングな若妻に対してあまり恋人みたいには振る舞わなかったようです。",
              "citation": {
                "source": "長い部屋",
                "author": "O. H. ダンバー　O. H. Dunbar",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
