  {
    "uuid": "af4db36a-bd85-59c8-be31-39b2f0f8b90f",
    "entry": "チンカン",
    "reading": {
      "primary": "ちんかん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "東北人のユウモアは、とかく、トンチンカンである。",
              "citation": {
                "source": "散華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　音痴同志のトンチンカンな会話。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "変に、家の中の機構が、トンチンカンになった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何となくトンチンカンな感じがしましたから……その時にこう云ってやったのです……。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから、トンチンカンなお天気の話なぞをしかけて、患者が変に思いながら窓の外を見たりしているうちに押し込むと、他愛もなくツルリと這入るのです。",
              "citation": {
                "source": "霊感！",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……アハ……アハ……こんな馬鹿馬鹿しい……間の抜けた……トンチンカンな争いが又とこの世にあり得ようか。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもの自分にも似合わないトンチンカンな頭の使い方ばかりしている。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡クラな、トンチンカンなヘボ探偵に過ぎないのです。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一生懸命で緊張しているところへ、こんなトンチンカンな芝居を見せられるからであろう。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……イイエ……ちっともトンチンカンな話じゃないの。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあお聞きなさいったら……トンチンカンでもいいからサア……。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてドンナ間違いから海の中に放り込まれるような事になったのか……ナンテいろんなトンチンカンな事を真剣になって訊くの……。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまりトンチンカンな記事なので、一人でゲラゲラ笑い出したらカフェーじゅうの西洋人や日本人が一時にこっちをふり向いた。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙な、トンチンカンな光景……。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "探偵談なんていうのも恥かしいくらいトンチンカンな、単簡明瞭な事件なんだが……。",
              "citation": {
                "source": "近眼芸妓と迷宮事件",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の話がトンチンカンですって……。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこがトンチンカンですか。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに自分の事と、他人の事とをチャンポンにして考えたりするので、話がだんだんトンチンカンになって来る。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何というトンチンカンな家庭であろう。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は前からあの女……ユリ子を御存じなのですか」　私は思わず発したこの質問が、如何に前後撞着した、トンチンカンなものであったかを気付くと同時に、自分の膝頭がガクガクと鳴るのをハッキリと感じた。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべて政界の出来事の表面がトンチンカンに見える時、その裡面に卑怯な真相が横たわっていることは、誰でも感付くことである。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チグハグな道路工事　往来で買った新聞を通じて東京市政を見ると、こんな風にトンチンカンに見える。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者は今度は市でやっているいろんな工事を見まわってみたが、この「トンチンカン」さが一層ヒドいのであった。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい子供泣きます』ヘルンは『御免御免』など云って、私に案内されて、食堂に参りますが、こんな時はいつも、トンチンカンでおかしいのです。",
              "citation": {
                "source": "思い出の記",
                "author": "小泉節子",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵の批評とすればトンチンカンなのかしれないけれども、私はそう感じました。",
              "citation": {
                "source": "第一回日本アンデパンダン展批評",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど真淵一派は『万葉』を解きて『万葉』を解かず、口には『万葉』をたたえながらおのが歌は『古今』以下の俗調を学ぶがごときトンチンカンを演出して笑を後世に貽したるのみ。",
              "citation": {
                "source": "曙覧の歌",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
