  {
    "uuid": "3ea8c7d5-1190-5dfb-99eb-25ff71532ec9",
    "entry": "チオン",
    "reading": {
      "primary": "ちおん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
