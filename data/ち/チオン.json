  {
    "uuid": "88421e68-ee43-5a5b-adbc-1aed3a261261",
    "entry": "血温",
    "reading": {
      "primary": "ちおん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
