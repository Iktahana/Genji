  {
    "uuid": "ea1540c0-1af5-50a8-915c-fa402523f7ea",
    "entry": "知恩",
    "reading": {
      "primary": "ちおん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "知恩院の前の暗い夜道をひとり帰りながら色々なことを考えた。",
              "citation": {
                "source": "祇園の枝垂桜",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "豹一は円山公園から知恩院の前へ抜けて、平安神社の方へ暗い坂道を降りて行った。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "知恩院の勅額を見上げて高いものだと悟った。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "知恩院の境内で亡くならないで東京の町のなかで目を瞑つたのは博士がせめてもの本望だつたかも知れない。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "クンカン８・11（夕）　亡くなつた上田敏博士は晩年、京都知恩院境内の源光院にある広岡氏の別荘に間借をして住んでゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "上田敏博士の追悼会が先日知恩院の本堂で営まれた時、九十余りの骸骨のやうな山下管長が緋の袈裟を被つて、叮嚀にお念仏を唱へた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "京都の知恩寺といへば、断わる迄もなく浄土宗の大本山である。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "知恩寺の床下からは、つい先日食べ荒したばかりの魚の骨がどつさり出た。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "千鳥の声の聞える一夜、私達はそこから出て、岡崎を南に、知恩院の境内を通りぬけ、絃歌の雨のやうに降り注ぐ祇園を西に、四条大橋の袂まで来た。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "近くの大仏、三十三間堂あたりから順々に、清水、高台寺、祇園、円山、知恩院、太極殿、それからずつと疏水の方まで歩いて行つた。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは知恩院あたりの景色でもいふのであらうか。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝よげに見える東山の、円らの姿は薄墨よりも淡く、霞の奥所にまどろんでおれば、知恩院、聖護院、勧修寺あたりの、寺々の僧侶たちも稚子たちも、安らかにまどろんでいることであろう。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "親鸞　祇園、清水、知恩院、嵐山の紅葉ももう色づきはじめましょう。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕暮れ、私ら二人は知恩院を訪うた。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああこれぞ知恩院である。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "また帰途には郷里の親友の由井清と、伊藤奚疑の二氏が送りかたがた京都見物をするといって、附いて来たので、京都へ廻って月並ながら例の祇園、清水、知恩院、大仏などへ行って、南禅寺の門前の瓢亭で共に酒を飲んだ、この時に京都で始めて電車に乗った。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに英国の碩学、ことに日本の古代宗教および文学に精通せるアストン先生の書中に、神道は知恩と愛情の宗教なりという一句があった。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "アストンにしても、黒住にしても、その説くところ間違いなきを保し難いが、我が固有の教えは知恩の念に満てるものなりとの一条は過ちなしと信ずる。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "知恩院の鐘がどんよりと曇る月夜に鳴る晩は前の河にも花が散る。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "八坂の塔だの、東寺の塔だの、知恩院だの、金閣寺だの銀閣寺だのがきらきらと映ります。",
              "citation": {
                "source": "私の生ひ立ち",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "慧心の代表作なる、高野山の廿五菩薩來迎圖にしても、興福院の來迎圖にしても、知恩院の阿彌陀十體像にしても、皆山から來向ふ迅雲に乘つた姿ではない。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "其が山越し像を通過すると、知恩院の阿彌陀二十五菩薩來迎像の樣な、寫實風な山から家へ降る迅雲の上に描かれる樣になるのである。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "慧心の代表作なる、高野山の廿五菩薩来迎図にしても、興福院の来迎図にしても、知恩院の阿弥陀十体像にしても、皆山から来向ふ迅雲に乗つた姿ではない。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其が山越し像を通過すると、知恩院の阿弥陀二十五菩薩来迎像の様な、写実風な山から家へ降る迅雲の上に描かれる様になるのである。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "慧心の代表作なる、高野山の廿五菩薩来迎図にしても、興福院の来迎図にしても、知恩院の阿弥陀十体像にしても、皆山から来向う迅雲に乗った姿ではない。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "祇園清水知恩院、金閣寺拝見がいやなら西陣へ行って、帯か三｜枚襲でも見立てるさ。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
