        "examples": {
          "standard": [
            {
              "text": "ここは山の境界線だから、片側だけで雨が降る馬の背を分けるような天気がよくある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「山で急に雨が止んだと思ったら、まさに馬の背を分ける現象が起きたんだね」と登山のガイドが言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "まるで馬の背を分けるように、道を境にして一方だけがびしょ濡れになっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "夏の雨は馬の背を分けるというが、全くその通りだ。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
