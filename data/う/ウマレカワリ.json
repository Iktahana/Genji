    "definitions": [
      {
        "index": 1,
        "gloss": "rebirth",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖母は死んだ猫が孫娘として生まれ変わりに来たと信じて疑わなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "その寺では生まれ変わりにまつわる言い伝えが代々受け継がれてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女は前世の生まれ変わりだとスピリチュアルカウンセラーに告げられ、戸惑った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ロシアの読本をのぞくと、たちまちにして自分がロシアの子供に生まれ変わり、ラテンの初歩をかじると、二千年前のローマ市民の子供になり、蝋石盤をかかえて学校へ通うようになる。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――生まれ変わりてえな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "知恵の袋をうんとこしこたま仕込んで、今ここでぴょこんといっぺんに生まれ変わりてえな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "碁打ちのなかにだって、石川｜五右衛門の生まれ変わりがいねえともかぎらねえんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "明月一夜騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした故人の生まれ変わりの人と見ることはできなくても、現在のような慰めのない生活をしているよりはと思う心から、その方に興味が持たれます。",
              "citation": {
                "source": "源氏物語",
                "author": "宿り木",
                "note": "青空文庫"
              }
            },
            {
              "text": "パーソナルコンピューターは、仕事の道具に生まれ変わりつつあった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "６８０００を使い、インターフェイスには全面的にアルトの流儀を採用し、マウスを付けるというジョブズの新しい方針にラスキンは激しく抵抗したが、一九八一年のはじめにはマッキントッシュは安くて小さなリサを目指すプロジェクトに生まれ変わり、ラスキンはその後アップルを去った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "このうらやむべき境涯にいたって、はじめて婆羅門アウルヤ学派の知識と名乗り、次ぎの世に生まれ変わりたいと思うものをも、自由自在に望むことが許されるのである。",
              "citation": {
                "source": "ヤトラカン・サミ博士の椅子",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつとはなく、「王子は神様の生まれ変わりだ」という評判が国中に広まりました。",
              "citation": {
                "source": "お月様の唄",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして遂には王様まで、自分の子は神の生まれ変わりではないかと思われるようになりました。",
              "citation": {
                "source": "お月様の唄",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "中世期の宗教的封建国家は、プラトンで構成されたところの、上に動かざるエイドス、理想的な象徴があり、その下に無限のフェノメナ、現象が、その影のごとく、その映像をわけもちながら、不完全な形で、生まれ変わり、死に変わりするという世界像を、まことに重宝としたのである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この劇は一度再演されたのち、キャロルおよびクラークの死後はオペレッタとして生まれ変わり、一九三〇年までに十八回も上演されました。",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはただ体に付着した汚れを洗い落とすということでなくて、道徳的な生まれ変わりという意味をもちました。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "同種の奇人や偏執狂たちは互いに群れる傾向があることを知っていたからで、単にチャールズないしアレンが、海外にお相手を――恐らく、オーンの筆跡を見たことがあり、故人の生まれ変わりの振りをしようとする誰かを――見出したのだと信じていた。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "同様に、彼が自分自身をジョセフ・カーウィンの生まれ変わりだと見なしていることも、また、チャールズ・ウォードのこととしか考えられぬ「少年」に対する殺意を抱いている――あるいは抱くように勧められている――ことも否定することができないのだ。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレンの――生まれ変わりという無言の主張を容れるならばカーウィンの――撲滅ないし収監はいかなる犠牲を払おうと実現せねばならぬと感じており、探偵たちがやってきたときには、既に席についてかような信念をウォード氏に伝えていた。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンドンの貧民窟で１年も暮らせば、新しい男に生まれ変わり、ものを学び、人を尊敬する男になり、全ての女性が誇らしげに領主とも、ええ、支配者とも呼ぶでしょう。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういうダブル・バインドのさなかで、美代子の生まれ変わりのような高村恵子に対して、玲子としてはきわめて当然のこととして、恋愛の感情を抱く。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォーケの名のもとで死ぬよりもゴリオとして生まれ変わりたいという炎のような希望が彼女を虜にしたのだった。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりゃもう、先生の御意見で夢が覚ましたから、生れ代りましたように、魂を入替えて、これから修行と思いましたに、人は怨みません。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お民が直ぐに（お民は中将姫の生れ代りらしいの、おとなしくって親切だけど、いやに加奈子に言い付け口するの。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "中将姫の生れ代りのお民ばかりよ。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは鶏の生れ代りで御座います。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは云う迄もなく、殊勝な念仏行者の満海という者の生れ代りだと言われている伊達の藤次郎政宗である。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "生れ代りの説は和漢共に随分俗間に行われたもので、恐れ多いことだが何某天皇は或修行者の生れ代りにわたらせられて、其前世の髑髏に生いたる柳が風に揺られる度毎に頭痛を悩ませたもうたなどとさえ出鱈目を申して居たこともある。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "武田信玄が曾我五郎の生れ代りなどとは余り作意が奇抜で寧ろ滑稽だが、宋の蘇東坡は戒禅師の生れ代り、明の王陽明は入定僧の生れ代り、陽明先生の如きは御丁寧にも其入定僧の屍骸に直に対面をされたとさえ伝えられている。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから政宗は満海の生れ代りであろうと想われ、そして梵天丸という幼名はこれに因りて与えられた。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "満海の生れ代りということを保証するのは御免｜蒙りたいが、梵天丸という幼名だったことは虚誕では無く、又其名が梵天｜帝釈に擬した祝福の意であったろう事も想察される。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢張り老耄の生れ代りなんだ。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「へへん、雲雀の生れ代りだっせ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
