        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "息子さん連もまじっていたようだが、子供心にも、そんな青い、ウジョウジョしていた男の子は軽蔑したからよく覚えていない。",
              "citation": {
                "source": "源泉小学校",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "五日ほどののち、団六のところで将棋をさしながら、青木が、フト畳の上を見ると、乾酪の中で見かけるあの小さな虫が、花粉でもこぼしたように、そこらいちめんウジョウジョと這い廻っていた。",
              "citation": {
                "source": "昆虫図",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
