        "examples": {
          "standard": [
            {
              "text": "資金がないので、打つ手がない状況に陥った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "打つ手がないままに月日が過ぎていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "対策を講じても効果がなく、打つ手がない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それで法的に打つ手がないということは、凡そ締め括りのつかぬ世の中になったものです。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その四　人形の家",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで駅逓馬車みたいに、のべつ書きどおしで、ほかに打つ手がない。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "呉の堅陣に対して打つ手がない。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
