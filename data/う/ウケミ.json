        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "何事にも受身な姿勢では、新しいチャンスは掴めない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は指示待ちで受身なところがあり、積極性に欠ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "受身でいるのではなく、自分から意見を発信してほしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
