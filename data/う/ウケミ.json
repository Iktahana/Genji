    "definitions": [
      {
        "index": 1,
        "gloss": "the defensive",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "相手の猛攻にさらされ、試合開始からずっと受身に回っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は論争で受身の立場に立たされ、防戦一方だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "攻勢に転じる隙をうかがいながら、受身を貫く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "西山には何んとなく気を兼ねていたが、西山がどうかすると受身になりたがるガンベの渡瀬に対してつけつけと無遠慮をいった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と言われて八蔵受身になり、むむ、と詰りて頬｜脹らし、「何さ、そりゃ此方の商売じゃ、泊めたが悪いというではない。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「勝つも負けるも、女は受身だ。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョーンは受身｜許りでは居られなかった。",
              "citation": {
                "source": "決闘場",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのために、私の方からはなるべく語りかけないようにして、彼の話に対しては私は全然受身の態度に出た。",
              "citation": {
                "source": "三稜鏡",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして社會に立つて受身の位置にある女性として男子に思はれるといふことの不快なるべき筈がない。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐治君に對しても受身になつてしまつた。",
              "citation": {
                "source": "教師",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "その少年という詞が、男色の受身という意味に用いられているのも、僕の為めには新智識であった。",
              "citation": {
                "source": "ヰタ・セクスアリス",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "受身になることが大嫌いの播磨は、もう果しまなこで柄頭に手をかけると、主を見習う家来の奴共も生れつきの猪首をのけぞらして呶鳴った。",
              "citation": {
                "source": "番町皿屋敷",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "『一代女』は全体のトオンが消極的で受身になつてゐるのに反して、『一代男』は積極的で、男の『種を蒔く』といふ形を作者は十分に飲み込んでゐる。",
              "citation": {
                "source": "西鶴小論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして柔道の受身を用ひて、素晴しい音響をたてた。",
              "citation": {
                "source": "眠い一日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "……青年の方が受身らしい。",
              "citation": {
                "source": "温室の恋",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういう男女の間から生れてもそれは人間の一人の子供であって、“生れた”という言葉は絶対にこの世に現われた子供が自分で自分を生んだのではなくて受身にこの世に送り出された関係を語っています。",
              "citation": {
                "source": "“生れた権利”をうばうな",
                "author": "――寿産院事件について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "淋しい、受身の、それでゐてどこか投げやりな、不思議な炎がちろめくやうな足取りだ。",
              "citation": {
                "source": "檀一雄「リツ子・その死」",
                "author": "――創芸社刊――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の心はどうしたものか、艸木に対すると直に受身になり、何の選好みもなく、無条件にそれをこちらに受容れようとする。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "訝しい事には、此時お定の方が多く語つた事で、阿婆摺と謂はれた程のお八重は、始終受身に許りなつて口寡にのみ應答してゐた。",
              "citation": {
                "source": "天鵞絨",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "訝しい事には、此時お定の方が多く語つた事で、阿婆摺と謂はれた程のお八重は、始終受身に許りなつて口寡にのみ応答してゐた。",
              "citation": {
                "source": "天鵞絨",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分にしろ今こそ妻のことを余融あり気に冷たく母などに向ひ、また自分に向つて吹聴するものゝ、はぢめのことなどを考へて見れば、自分のみが決して空々しく受身なものではなかつた。",
              "citation": {
                "source": "蔭ひなた",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "葦のごとく細く弱いしかし容易には折れない受身の力を――弱さの持つ強さといつたものを自分のうちに感じたのである。",
              "citation": {
                "source": "盲目",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその強さは激しい攻撃的なものではなくて、攻めはしないがしかし決して何ものにも打ち負かされはしないといふ、受身の強さを現してゐた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "注意をひかれるのは、この作者が、「外国人は全部四川省からも揚子江からも、いまに追い出されてしまうようなことになりましょう」「われわれはこの民族の偉大な興隆のほんの始まりに居合わせただけなのです」という観念と「かれらは受身でおとなしく、機械のなかにあるなにか攻撃的なものを排撃します。",
              "citation": {
                "source": "「揚子江」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "弓子さんの死が、死に到るまでそのような実行力のない実際生活で導かれたとすれば、死は、受身に受身に内屈せられた感情の破局として全くマイナスの社会的意味しか持たないと信じます。",
              "citation": {
                "source": "私も一人の女として",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名な「ステラダラス」「マズルカ」などでも、この社会で受身な負担のにない手である女の苦しい感情が母性愛といういろどりで描かれている。",
              "citation": {
                "source": "映画の恋愛",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の人がひとりになると自堕落になるとか、いろいろの誘惑が危険であるというのは、外部との結びつき方を、受身に見て云うことで、その人々の心持ちを主にして、その側から見れば、その気持の中に、自堕落にさせたり、ちょっとした好奇心や誘いかけにもろくなっている様な独立的でない感情があるからではないでしょうか。",
              "citation": {
                "source": "女性の生活態度",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本では良妻賢母という言葉によっては既に新しい刺戟を与えられないが、服飾や愛の技巧の研究に女が公然と物を云うようになると同時に、そういう趣味的な面を通じて、案外な程度に、復古へ誘いこまれ、性的な交渉では女が受身という点が粉飾的に強調されている。",
              "citation": {
                "source": "日本の秋色",
                "author": "――世相寸評――",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学において、リアリストと混同され勝ちな経験主義者や瑣末な現実の断片を受身に反映する写実主義者は、ある一つの段階に達すると必ず共通な倦怠を生活に対して感じるようになるらしい。",
              "citation": {
                "source": "問に答えて",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "協力は愛のひとつの作業だから、結局のところ相手が自分に協力してくれるその心にだけ立って自分の協力も発揮させられてゆくという受身な関係では、決して千変万化の人間らしい協力の花を咲かせることはできない。",
              "citation": {
                "source": "明日をつくる力",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋愛とか結婚とかいう問題について受身であったばかりでなく、性生活そのものについての理解がほとんど暗黒のまま封鎖されていた。",
              "citation": {
                "source": "人間の結婚",
                "author": "――結婚のモラル――",
                "note": "青空文庫"
              }
            },
            {
              "text": "受身に私共の観賞を支配される形ではあるが、一都市が所有する美の蔵の公平な認識者、批評家として、趣味の浮浪人は暗黙の裡に重んぜられる当然の運命をもっている。",
              "citation": {
                "source": "小景",
                "author": "――ふるき市街の回想――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして婦人のうけみな社会的立場をおのずから反映してうけみな対象として文学に導きいれられた婦人は、ルネッサンスの時代、文芸復興期になって、どういう変化をうけたろう。",
              "citation": {
                "source": "女性の歴史",
                "author": "――文学にそって――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
