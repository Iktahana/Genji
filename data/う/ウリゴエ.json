[
  {
    "uuid": "233566bb-8cce-5fcb-bbf0-2616e882df91",
    "entry": "売り声",
    "reading": {
      "primary": "うりごえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "hawker's or vendor's cry",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「いらっしゃいませ、焼きたてのたい焼きはいかがですか」という売り声が商店街に響いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "豆腐屋のラッパの音と売り声が、昭和の下町の朝を彩っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "縁日の夜店で金魚売りの売り声が夏の夜の雰囲気を盛り上げていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "同じく昔の郷里の夏の情趣と結びついている思い出の売り声の中でも枇杷葉湯売りのそれなどは、今ではもう忘れている人よりも知らぬ人が多いであろう。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "売り声の滅びて行くのは何ゆえであるか、その理由は自分にはまだよくわからないが、しかし、滅びて行くのは確かな事実らしい。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしてももう老いさらぼえた雪道を器用に拾いながら、金魚売りが天秤棒をになって、無理にも春をよび覚ますような売り声を立てる季節にはなったろう。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄塵万丈の風に乗って、泣くようなその売り声が町の角々から漂ってくるとき、人は「哈爾賓らしさ」の核心に触れる。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "」で焼き栗屋の売り声だが、そこで、朝のりすぼん港の日課的大合唱は――お！",
              "citation": {
                "source": "踊る地平線",
                "author": "しっぷ・あほうい！",
                "note": "青空文庫"
              }
            },
            {
              "text": "また売り声を上げながら、廻って行った。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "燕の飛ぶ小雨の日に、「新藁、しんわら」と、はだしの男が臑に細かい泥を跳ねあげて、菅笠か、手ぬぐいかぶりで、駈足で、青い早苗を一束にぎって、売り声を残していった。",
              "citation": {
                "source": "大門通り界隈一束",
                "author": "続旧聞日本橋・その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことさら暑い日中を択んで菅笠を被った金魚屋が「目高、金魚」と焼けつくような人の耳に、涼しい水音を偲ばせる売り声を競う後からだらりと白く乾いた舌を垂らして犬がさも肉体を持て余したようについて行く。",
              "citation": {
                "source": "山の手の子",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とそれに追い立てられるように、今までやかましかった夜店の売り声がひとつひとつなくなっていって、賑やかさの裏のひとしおのつめたさが、氏の足先を包んできた。",
              "citation": {
                "source": "地図にない街",
                "author": "橋本五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝、何気なく窓から外を見てゐると、昔ながらの節の付いた呼び声で、コーモリや、コーモリ直し、と、町を呼んで歩く「売り声」を聞いて、何かしらんホツとしたやうな心持がした。",
              "citation": {
                "source": "東京の風俗",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "が聞こえるものは、遠くの街をゆく夜泣きうどん屋の売り声と、岸高く鳴る松風の音ばかり――もう夜もだいぶ更けたらしく、大川の水が杙にからんで黒ぐろと押し流れて、対岸の家の灯もいつとはなしに一つ二つと消えていた。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "立ち並ぶ仮屋に売り声やかましくどよんで、臼、木鉢、手桶などの市物が、真新しい白さを見せている。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "果物を売る小舟が往来し、売り声などが海上にしきりである。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし私がいちばん困ったのは『エーつけ物やつけ物……』の売り声がまるきり出ないことだった。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これではならじ」と、ある日家のまばらな日清紡績裏の空地に立って、声をふりしぼって売り声の練習をした。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧暦の十二月朔日といえば、大体に正月も終わったころで、寒風の吹くようになった夜、広島の町を流してゆく「かわどうり、かわどうり」という売り声を聞くと、さすがの広島の冬も深くなったものだと思わされた。",
              "citation": {
                "source": "広島という名の由来",
                "author": "薄田太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "売り声は、大体にこどもの声であるが、時にはサビのある大人の声も聞かれた。",
              "citation": {
                "source": "広島という名の由来",
                "author": "薄田太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とくに花街を流していく売り声には、広島ならではの季節感があった。",
              "citation": {
                "source": "広島という名の由来",
                "author": "薄田太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかみの毛利城下町に残された「川通りもち」の風習が、長い歳月の冬を生き抜き、戦後も売り声こそ聞かれなくなったが、菓子として昔風そのままに形を残しているのは嬉しいことである。",
              "citation": {
                "source": "広島という名の由来",
                "author": "薄田太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と云う売り声も、いかにもいい声で、当人も気持よさそうであった。",
              "citation": {
                "source": "生い立ちの記",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "売り声にも年季が入っていて、新米には真似られない渋さがあった。",
              "citation": {
                "source": "生い立ちの記",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいえ、アイスクリームじゃない、売り声の通り、アイスクリンなのである。",
              "citation": {
                "source": "甘話休題",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "――すると誰やら後ろのほうから、妙な売り声で、呼ばわるともなく、呟くともなく、ぼそぼそ言いながら、くッついてくる男があった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　豆府屋の親仁が、売声をやめて、このきらびやかな一行に見惚れた体で、背後に廻ったり、横に出たり、ついて離れて歩行くのが、この時一度｜後へ退った。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……しばらくあって、一つ「とうふイ、生揚、雁もどき」……売声をあげて、すぐに引込む筈である。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　外所は豆腐屋の売声高く夕暮近い往来の気勢。",
              "citation": {
                "source": "酒中日記",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お銀がつくった大ももは」という売声には色々な郷土伝説的の追憶も結び付いている。",
              "citation": {
                "source": "郷土的味覚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と可い気な売声。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その小旗が風に靡いて拡がれば拡がったまま、風がなくなって垂れれば垂れたままで、少しの頓着もなく売声はもとより立てずに悠々と歩いていくのだった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅の売声がようきこえる。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
