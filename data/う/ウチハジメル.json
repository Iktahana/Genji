        "examples": {
          "standard": [
            {
              "text": "コーチの号令とともに選手たちは一斉にボールを打ち始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "時計が十二時を告げると、祭りの太鼓が打ち始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "雨が本降りになった頃、鍛冶師は炉の前で鉄を打ち始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "（おいよは砧の盤にむかいて打ち始める。",
              "citation": {
                "source": "人狼",
                "author": "――Were-Wolf――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが通路の中で碁を打つと客観性が無くなつて喧嘩碁ばかり打ち始める。",
              "citation": {
                "source": "無常の風",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "』痩せ馬が身をもがくと、やるせない動物の泣いているような『すなおな眼』の上を、百姓はぴしぴしと打ち始める。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "（四時をうたないわけは、一つの柱時計が三時をうって終り、次にもう一つの時計が、五時からうちはじめるからだ）　なるほど、二つの柱時計を、そういう風に鳴らせば、四時のところでは、鳴らないわけだ。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
