        "examples": {
          "standard": [
            {
              "text": "海天狗は深海に住む珍しい魚で、滅多に見ることはない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "海天狗の奇妙な形は、深海での生活に適応した結果だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "博物館の深海生物展で海天狗の標本を見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "『本草綱目』蚕の条などに竜馬同気と云々種々理由あるべきも、まずは海馬楊枝魚海天狗など竜馬折衷の魚が竜棲むてふなる海中に少なからぬが一の主因だろう。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
