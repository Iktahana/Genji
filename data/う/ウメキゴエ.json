        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "うめき声を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちはうめき声について学習した。",
              "source": "幻辞"
            },
            {
              "text": "うめき声の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生はうめき声の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化ではうめき声が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "うめき声という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中にうめき声という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社ではうめき声についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "うめき声を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によるとうめき声は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "うめき声について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野ではうめき声が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的にうめき声は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展によりうめき声の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "うめき声は様々な場面で使われる。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "町辻でうめき酒場でうめきしているそのうめき声にひとりで節が乗ってとうとう人間のうめきの全幅の諧調を会得するようになったのだ。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供達は、喜び、うめき声を出したりしながら、互いに手をかきむしり合って、携えて来た琺瑯引きの洗面器へ残飯をかきこんだ。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "出ていかねばたたき殺すぞ」　やがて牛のうめき声のような口惜し泣きが、立ったままの純次の口からおめきだされた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて阿難の死んだような体から、かすかなうめき声が洩れ始め、その声は段々高くなって行く。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モミの木は、うめき声をあげて、地べたにたおれました。",
              "citation": {
                "source": "モミの木",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "町辻でうめき、酒場でうめきしてゐるそのうめき声にひとりで節が乗つてとう／＼人間のうめきの全幅の諧調を会得するやうになつたのだ。",
              "citation": {
                "source": "ダミア",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "）ただいま期せずして座の一隅より、切望懇願のうめき声が発せられたようでもあり、まあ致しかた無い、御伝授しましょう。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたしが、あの畑の道を通りかかると、人のうめき声がきこえました。",
              "citation": {
                "source": "張紅倫",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンドは間抜けた調子で、誰も踊っていないホールへ相変らずクンパルシータの曲を送っていたので、茉莉のうめき声は、ともすればその音に消されたが、苦しそうにうめいていることだけは、さすがに風のように陽子の耳には判った。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　茉莉のうめき声は、いのちの最後の苦しみを絞り出しているのかもしれない――といういやな予感に、陽子はどきんとして、「――お医者を……」　呼びに早くボーイを……と、あわてて振り向いた途端、木崎の姿が眼にはいった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、癌の苦痛という感覚の前にはもうそんな神経もいつか図太くなって来たのか、背に腹は代えられぬ注射の手伝いをしているうちに、次第に馴れて来て、しまいには夜中看護婦が眠っている間一代のうめき声を聴くと、寺田は見よう見真似の針を一代の腕に打ってやるのだった。",
              "citation": {
                "source": "競馬",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "うめき声で眼を覚した寿枝が二階へ上つて見ると、楢雄は土色の顔へ泡を噴きだしてのた打ちまはつてゐた。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、棺の中からうめき声が聞えてきた。",
              "citation": {
                "source": "阿宝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」それはうめき声だった。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　男は深いうめき声を上げながら、長椅子にへたり込み、手錠のかかった両手で顔を覆った。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」うめき声が後ろから聞こえた。",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "その叫びは低いうめき声へと変わったが、その元は我々が初めに入った部屋からだとわかった。",
              "citation": {
                "source": "ライギット・パズル",
                "author": "THE REIGATE PUZZLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "牡牛のうめき声、子牛の鳴き声等あい混じてにぎやかである。",
              "citation": {
                "source": "去年",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "横浜へＲと活動を観に行つて、夜更けに宿へ曲る薄暗い露路にさしかゝると、水兵がひとり垣根の傍らに倒れて、うめき声をあげてゐるのが、月あかりに透かされた。",
              "citation": {
                "source": "岬の春霞",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、今にも息が絶え入りさうなうめき声を発しながら、ぐらぐらする流しの両端に噛りついて、千仞の谷底をのぞく臆病者のやうに上体を前方にのめり出した。",
              "citation": {
                "source": "秋晴れの日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その牛のうめき声のような泣き声が気疎く船の上まで聞こえて来た。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "倉地が眠りの中でそれを感じたらしく、うるさそうにうめき声を小さく立てて寝返りを打った。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はウーンと仰山なうめき声を発して死んだ真似をした。",
              "citation": {
                "source": "晩秋",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、そのうめき声は、やっぱり言葉になって出た。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　村川は、もううめき声が口に出なかった。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、村川がときどき、低いうめき声を出すだけで、眠りつづけているのが、物足りなかった。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ、人の心を掻きむしるような低いうめき声が続いている丈であった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、彼は低い、ともすれば、絶えはてそうなうめき声を続けている丈であった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、おのが、木のしんまできりこんだので、もみの木は、うめきごえを立てて、地の上にたおれました。",
              "citation": {
                "source": "もみの木",
                "author": "GRANTRAEET",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから絶え入るように、「おかえりになりました」とうめきごえを立てた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
