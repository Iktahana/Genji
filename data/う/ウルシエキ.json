        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それには私はメディアムとして速乾漆液をそのまま柔らかな日本風の彩色筆に含ませて油絵具をきわめて薄くほとんどお汁の状態にまで溶解してガラス面へ塗って行く方法をとっている。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら多少の大作でもやるとすれば速乾漆液では乾きが早過ぎて不便だ。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "油Ａ　ヴェルニアタブロー　Vernis a tableauxＢ　速乾漆液　工業用薬品店にあります。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在私は速乾漆液のみを用いて描きます。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "）此他｜漆液の類、繪の具の類を造りし證跡有り。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
