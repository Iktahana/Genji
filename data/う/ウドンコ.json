[
  {
    "uuid": "56d510c5-3db6-520e-98b9-8fc4288dda47",
    "entry": "うどん粉",
    "reading": {
      "primary": "うどんこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
