    },
    "definitions": [
      {
        "index": 1,
        "gloss": "udon flour (wheat flour)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "うどん粉に塩水を加えてこねていくと、だんだんなめらかな生地になってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "祖母はうどん粉を量って台の上に広げ、慣れた手つきで生地をのばしていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "スーパーでうどん粉と中力粉の違いを店員に聞いて、初めて種類があることを知った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "たとへば、豚の肉を細くたゝいて、擂鉢であたつて、しやくしで掬つて、掌へのせて、だんごにまるめて、うどん粉をなすつてそれから捏ねて……あゝ、待つて下さい、もし／＼……その手は洗つてありますか、爪はのびて居ませんか、爪のあかはありませんか、とひもじい腹でも言ひたく成る、のが澤山ある。",
              "citation": {
                "source": "湯どうふ",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二ぜん分を籠みにした生がえりのうどん粉の中毒らない法はない。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……渋豌豆の堅いやつを、自分で持って行って、無理に頼んで、うどん粉をこってりと、揚物にさしたという、それに中てられたんです。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "亭主物うき事に思い歎くと、大黒天その夢に現じて、宵の鼠のうどん粉に塗れ出でたるも、汝に富貴の道を教ゆべき方便であった。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝から大釜には湯がたぎって、主らしい男が、大きなのべ板にうどん粉をなすって、せっせと玉を伸ばしていた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の乳房が千貫の重さで、うどん粉の山のようにのしかかっている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "模様には、ライラックの花がついて、きつく振ると、瓶の底から、うどん粉のような雲があがった。",
              "citation": {
                "source": "風琴と魚の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハッハッ……うどん粉つけて、雪の肌いなりゃア、安かものじゃ」　悲しさがこみあげて来た。",
              "citation": {
                "source": "風琴と魚の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "バスケツトや行李のやうな高価なものは買つて貰へなかつたので、由の持ちものと云へば、襯衣の空箱に一二枚の着替へのものと、白いハガキが四五枚、それに馬琴の弓張月と云ふ、青く古ぼけた本とそれきりで、うどん粉の匂ひのする化粧水のやうなものも一本持つてゐたやうです。",
              "citation": {
                "source": "小さい花",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼いうちにはしかを病んで顔にそばかすがありましたので、由の母親は「海辺に行くとお前のそばかすは濃くなる故これでも塗つたらええぞな」と云つて、何時買つたとも判らぬ、うどん粉の匂ひのするその化粧水をくれたのですが、此化粧水は島にをるあひだぢう塗つた事はありませんでした。",
              "citation": {
                "source": "小さい花",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "忙がしいはずの私がうどん粉をこねたりしているのを家人たちはびっくりして見ていた。",
              "citation": {
                "source": "貸家探し",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スープ（大根のやうなのに人参少し）それに、うどん粉の酸つぱいのや（すゐとんに酢をかけたやうなもの）蕎麦の実に鶏の骨少し、そんなものでした。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「又始まった、だだっ子だなこの人は――」　男は何でもない様に云って、ねりそこねたうどん粉の様な笑い方をした。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その作り方は小鯵の皮および骨を抜き身だけを摺鉢へ入れて能く摺砕きその中へうどん粉を入れて能く摺り混ぜなおまた味淋と塩とを適宜に入れて味を付け別に昆布または鰹節にて煮汁を作り塩醤油にて淡く味を付け前の摺身を好きほどに丸めてその中へ入れ煮上りたる時を度合として椀へ盛り青味を添えて食すべし。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかの子供は、どこからか、はちの子をさがして持っていくことがあったが、勇ちゃんだけは、いつもうどん粉の餌を造って、釣りに出かけたのでした。",
              "citation": {
                "source": "ある夏の日のこと",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "神前には紅白の落雁が四つ供えてある、三十銭を奉納してこの供物をいただき、弁当の残りだというみずやき（うどん粉を溶いた中に菜漬を入れて焼いたもの）を一つ老人から貰い受け、少し気力を恢復して、一里の暑い野原路を台ヶ原までまっしぐらに急いだ。",
              "citation": {
                "source": "木曾駒と甲斐駒",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この種のものは外観上はうどん粉位の粉に見えるのであるが、その顕微鏡写真をとって見ると、非常に小さい角柱状の結晶の集合から成っている場合が多い。",
              "citation": {
                "source": "雪",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ｃ）　立体角板集合　小角板が立体的に組合わされたもので、細いうどん粉のような雪が降る時に、この種の結晶が見られることがあるが、我国では比較的稀な結晶である。",
              "citation": {
                "source": "雪",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "粉雪という言葉は前にも述べたように、積雪の性質を示す時以外にも、雪片形成状態を指して使われることもあるが、此処でいう「粉雪」とは、粒が非常に細く、降り立てのものが積った様子は全くうどん粉のような外観を呈しているものである。",
              "citation": {
                "source": "雪",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この粉雪は外観上はうどん粉くらいの粒に見えるのであるが、その顕微鏡写真をとって見ると、非常に小さい角柱状の結晶の集合から成っている場合が多い。",
              "citation": {
                "source": "粉雪",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――辰野は出鱈目に書いたのだが、事実安物の石鹸にはうどん粉を交ぜることが後で分つたのは大笑ひだつた。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「漆喰か何んかぢやありませんか」　それは漆喰か胡粉のやうな白い粉末ですが、指先でつまみ上げると、觸覺がねつとりして、漆喰やうどん粉のそれとは全く違ひます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "妹の扱帶",
                "note": "青空文庫"
              }
            },
            {
              "text": "用途は「うどん粉」の捏鉢である。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、それらは多く黒っぽい土、即ち色のついた土の上にうどん粉のように見える白い泥をベタに塗って、それに模様を彫ったものであって、いきおい絵は白以外の色を以て表われる。",
              "citation": {
                "source": "古器観道楽",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "揚物の油が鍋の中にて發火した場合は、手近にあるうどん粉、菜葉などを鍋に投げ込むこと。",
              "citation": {
                "source": "地震の話",
                "author": "今村明恒",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在、タナゴの定餌は玉虫と決まっているが、当時は卵の黄身をうどん粉にまぜてねり餌にしたり、干しうどんを口に含んで、それを細かに噛み切ってつけるか、飯粒を半分くらいにして、針先につけていた。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを裏ごしにかけて、耳タボくらいのかたさがよいというが、ゆで過ぎてやわらかなのは、うどん粉を入れて、針から落ちないようにする。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "うどん粉がありませんから、料理でうすいうどんこからこしらえた皮を出すところをパンにしてあったりして。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "乾パン、うどん粉、うどんが半月分当ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "うどん粉はパンをつくるのだけれど、うちの技師は、いつも、原始人の粉饅頭に似たものをつくり、おかあさん出動しないとフワリとしたものにならないのだから妙です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
