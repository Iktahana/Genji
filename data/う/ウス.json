        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "功績のあった家臣が若くして失すとは、誠に惜しきことかな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "大納言は病を得て、昨夜静かに失せ給う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "乱世にあって、多くの名もなき民が戦火に失せり。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
