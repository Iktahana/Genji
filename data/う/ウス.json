  {
    "uuid": "46a49a61-494d-5836-8ce7-341aa9ede82a",
    "entry": "ウス",
    "reading": {
      "primary": "うす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アキレウスは「そのスラリと長い脚で」無限に亀に近迫するがよい。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "「継続された有限性」を継続する放浪者、「悪い無限性」を喜ぶ悪性者、「無窮に」追跡して仆れないアキレウス、この種の人間だけが本当の媚態を知っているのである。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "またショパンは「ヘ」短調司伴楽の第二楽章の美しいラルジェットがコンスタンチア・グラコウスカに対する自分の感情を旋律化したのであることを自ら語っている｛７｝。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、サンサンス、マスネエ、ドゥビュッシイ、リヒアルド・スュトラウスなどの作品中の或る旋律を捉えて厳密なる意味において「いき」と名附け得るであろうか。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲーテのフアウストやミルトンの失樂園やは、今日に於て既に詩の範圍に屬さない。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かりにメフィストフェレスが出現して、今一度青春を与えようと約束しても、僕はファウストのように小躍りして、即座に跳びつくか否かは疑問である。",
              "citation": {
                "source": "老年と人生",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "八十歳になったゲーテが、十八歳の娘に求婚して断られた時、彼はファウストの老博士を想念し、天を仰いで悪魔の来降を泣き呼ばった。",
              "citation": {
                "source": "老年と人生",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「独逸人は私のところへ来て、ファウストの中にどういう観念を具体化しようとしたかと尋ねる。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかにゲーテのファウストやダンテの神曲やが、人間的弱小の非力感から、或る超人的なものへ飛ぼうとする悲痛な歎息を感じさせるか。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲエテのファウストでも、ミルトンの失楽園でも、そこには人間的非力を以て、神や運命に挑戦している思想の深い哲学が語られており、それによって、人間性の地獄から呼びあげてくる真の力強いヒロイックの権力感を高翔さすのだ。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道に沿つたお寺の、白い塀壁の表面のウス黒い埃りや、そこに書いてあつた〈へのへのもへじ〉なぞも、目に留つてゐて離れない。",
              "citation": {
                "source": "亡弟",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "何のことはない妄想家流であつて、ジャズだつてオネガだつてアッターベルヒだつてラヴェルだつてシトラウスだつてマーラーだつて、妄想家流――といつて妥当でなければ幻想家流である。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中に倉橋君が来る、晃平を殿として、一行が揃う、こう霧がひどくては、方角も何も解らない、晃平は荷を卸して、路を捜索に出たが、無益に戻って来た、岩の間を点接して、トウヤクリンドウ、ミヤマキンバイ、ミヤマウスユキソウ、チングルマなどがあったが、風と霧と雨の中で、一々眼に止めていられない。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲーテのファウスト、ダンテの神曲、シェークスピヤのハムレット、カアライルのサアター・レサアタス（Sartor Resartus）、ブラウニングのイースタアデー（Easter Day）とラビ・ベン・エズラ（Rabbi Ben Ezra）等はそれである。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "◯ブレンチウス（Brentius）いう、人が患難に会したる時はその患難を以てその人を審判くべからずその人格を以てその患難を審判くべしと。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンテの地獄篇の初めに出てくる（名前はいま、たしかな事は忘れた）あのエルギリウスとか何とかいう老詩人の如く、余りに久しくもの言わざりしにより声しわがれ、急に、諸君の眠りを覚ます程の水際立った響きのことは書けないかも知れないが、次第に諸君の共感を得る筈だと確信して、こうして書いているのだ。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "身を以てボオドレエルの憂鬱を、プルウストのアニュイを浴びて、あらわれるのは少くとも君たちの周囲からではあるまい。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史、哲学、教育、宗教、法律、政治、経済、社会、そんな学問なんかより、ひとりの処女の微笑が尊いというファウスト博士の勇敢なる実証。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり廊下の拡声機から、当直の事務員のおそろしく緊張した口調のニュウスが、いろいろと報告せられるのだ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎夜、八時半の報告の時間には、さまざまのニュウスを聞かされる。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
