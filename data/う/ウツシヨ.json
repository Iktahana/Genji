[
  {
    "uuid": "86f152ca-ac9f-5325-894b-ec9b09cf6c5e",
    "entry": "うつし世",
    "reading": {
      "primary": "うつしよ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
