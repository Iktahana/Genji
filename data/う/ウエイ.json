        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "チュアン　イエン　ペイフォン　ツイイエンジュン　ハン　コアンフイパイ　ファニャン　ワンアルツイホン　ゾアン　イ　コン　ウエイ「畜生！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「グルルル、グルウ、ユー、リトル、ラズカルズ、ユー、プレイ、トラウント、ビ、オッフ、ナウ、スカッド、アウエイ、テゥ、スクール。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのレコード止してくれない」聴き手の方の青年はウエイトレスがまたかけはじめた「キャラバン」の方を向いてそう言った。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "厭だと思い出すととても堪らない」　黙ってウエイトレスは蓄音器をとめた。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生をもう二つ」　話し手の方の青年は馴染のウエイトレスをぶっきら棒な客から救ってやるというような表情で、彼女の方を振り返った。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らはは入って来ると同時にウエイトレスの方へ色っぽい眼つきを送りながら青年達の横のテーブルへ坐った。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ポーリンさんにシマノフさん、いらっしゃい」　ウエイトレスの顔は彼らを迎える大仰な表情でにわかに生き生きし出した。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "安い代わり動作速度の遅いメモリーを使おうとする際には、ＣＰＵにウエイトと呼ばれる待ちの状態を意図的にはさんでタイミングを合わせる手法が使われることがある。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時としては高速の８０８６―２を使おうとすれば、使用できるメモリーとのバランスをとるためにウエイトをかける手が常識的には考えられたが、クロック周波数を七Ｍヘルツに抑える代わり、ウエイトのかからない構造が工夫された。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "自らもハードウエアに手を染めてきた三人のハッカーは、ＣＰＵにウエイトをかけないために巧妙にタイミングをとった設計やカラーのグラフィックスを高速処理するプレーン構造を目の当たりにして、ＰＣ―１００に向けてアプリケーションを書く意欲をいっそうかき立てられた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪に綺麗なウエイブがかかっていて、顔も寝る前に化粧したらしく、少し濃いめの白粉に冷たく塗られて、どんな夢を見ようとするのか、少しの翳しも止めない晴々しい麗しさであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時彼は葉子について、そのころ銀座にあったメイ・ハルミヘ行ったが、ちょうどその階下が理髪屋であったところから、葉子がウエイブをかけている間、彼も階下で髪を刈ることにした。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と母は氣にして時々目をさまさせて、ウエイフアーや何かをくれたり、話をしかけたりして氣を紛らせた。",
              "citation": {
                "source": "赤い鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "短い指の女給が、綺麗な指をしているという他のウエイトレスを伴って戻って来た。",
              "citation": {
                "source": "指と指環",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "未だに、悪魔教バルダスの遺風が残っていて、ミュイヤダッハ十字架風の異教趣味に陶酔する者があると云われる――あのウエイルズ生れなんだ」「いったい君は、何を云いたいんだ」と検事は、薄気味悪くなったように叫んだ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日は女優、今日はウエイトレス、明日は女学生、明後日は交換嬢と、到る処に手を握り締め涙を流して、「あなたは僕の未来の妻です」　と身をふるわせ得る鳥打帽……。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ユキちやん、オーバ・ゼ・ウエイヴを掛けて御覧よ。",
              "citation": {
                "source": "ランプの便り",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云ふので、滝本は、オーバ・ゼ・ウエイヴ・ワルツなどを、調子高く吹奏した。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し何といっても呑気なもので、ルウスはこの日、許可を得て、監房内へ美容師を呼び入れ、パアマネント・ウエイヴをかけたりしている。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "小高い丘陵が続く具合、別荘の多い処、自然が人間の手によってかなり整頓されている処、素晴らしいドライヴウエイがあり、西洋人夫婦が仲よく走る有様なども似ている。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しいドライヴ・ウエイを二十分ばかりのぼると杉、松、栗、柏などの見事な喬木の森がつきて白樺、つつじ、笹などの高原植物になります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分この左手の方に一米十円をかけたという一万メートルの志賀高原へのドライヴ・ウエイが通って居ると思います。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤルタから、セバストーポリまでは、黒海の海岸ぞいのドライヴ・ウエイで、その眺望は極めて印象に強く残ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（中略）「湾そのものの、第一印象は、頗る、ノオルウエイの峡湾に似てゐる。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に、ノオルウエイの首府クリスチヤニアにはいるところに似てゐる。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "長崎の湾も小山は水際からすぐに聳え立つて、そのまた小山には、鬱々と松が茂つてゐる、しかし上陸して見ると、植物はノオルウエイよりも遙かに熱帯的である。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は先年支那へ遊んだ時、揚子江を溯る船の中で、或るノオルウエイ人と一緒になつた。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにも拘らず、このノオルウエイ人は、妻としての支那人｜乃至日本人を雲の上までほめ上げてゐた。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "元はゆるやかな砂丘つづきで、小松や萱の生え茂っていたその海岸を縫って、近年観光のドライヴ・ウエイができた。",
              "citation": {
                "source": "夜の若葉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
