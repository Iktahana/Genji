        "examples": {
          "standard": [
            {
              "text": "川を遡上する海鱒の姿をカメラに収めるため、早朝から準備をして待機した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "釣り上げた海鱒の銀色に輝く魚体は、まさに魚の王様と呼ぶにふさわしい風格があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この川では、毎年秋になると海鱒が産卵のために戻ってくるので、釣り人が集まる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ありがたい事に達者で――針も持ちます、苧もうみます、御団子の粉も磨きます」　この御婆さんに石臼を挽かして見たくなった。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月九日ごろ咲枝が赤子チャンなるものをうみますから、そのときは、太郎のために林町に行ってやる約束いたしました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
