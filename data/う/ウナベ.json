        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "冬の夜、家族で囲む鰻鍋は格別な味わいだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "温かい鰻鍋の汁を吸ったネギが美味しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "老人ホームの冬の献立では鰻鍋が利用者に人気だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "」　口を小さくあけて、嬰児のようなべそを掻いて、私をちらと振りむいた。",
              "citation": {
                "source": "断崖の錯覚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな奴が、「芥川賞｜楽屋噺」など、面白くない原稿かいて、実話雑誌や、菊池寛のところへ、持ち込み、殴られて、つまみ出されて、それでも、全部見抜いてしまってあるようなべっとり油くさいニヤニヤ笑いやめない汚いものになるのであろうと思いました。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたのようなべっぴんになにかと長居されりゃ、いろいろと世間のバカがつまらぬうわさをたてやがるから、早いとこ引き取ってもらいますかね」「まあ！",
              "citation": {
                "source": "右門捕物帖",
                "author": "なぞの八卦見",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十九歳を若頭にね、六十一、六十三、六十八、七十、七十三と、しわから顔がのぞいているようなべっぴんばかりですよ」「ウフフ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、あの仏たちゃまだなまなましい若そうなべっぴんどうしですぜ」「だから、なおのことそうじゃねえか。",
              "citation": {
                "source": "右門捕物帖",
                "author": "村正騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "「んで、財布これさ」　干柿のようなべったりした薄い蟇口を眼の高さに振ってみせた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京では、どじょうなべというより「柳川」というほうが通りがいい。",
              "citation": {
                "source": "一癖あるどじょう",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "古老の話によると、幕末のころ、日本橋通一丁目｜辺に「柳川屋」という店があり、ここでかつて見たこともない「どじょうなべ」なるものを食わした。",
              "citation": {
                "source": "一癖あるどじょう",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸いそれが当たって、江戸中の評判となり、いつとはなしに、どじょうなべのことを柳川というようになった。",
              "citation": {
                "source": "一癖あるどじょう",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "どじょうなべの要点はだしで、表側の卵を汚さぬ工夫、だしを笹がきごぼうの下にだぶだぶ残さない工夫、卵を笹がきの中まで沈めない工夫、この三つができたら本格である。",
              "citation": {
                "source": "一癖あるどじょう",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも冬場でも、まぐろの腹部の肉、俗に砂摺りというところが脂身であるゆえに、木目のような皮の部分が噛み切れない筋となるから、この部分は細切りして、「ねぎま」というなべものにして、寒い時分、東京人のよろこぶものである。",
              "citation": {
                "source": "鮪を食う話",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチンと、みんなが、手から繰り出した、鉄砲だまのようなべいは、たがいにはじき合って、火花を散らしました。",
              "citation": {
                "source": "こま",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はよせなべとか、ぎゅうなべとか、お寿司やごもくは大嫌いだった。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の流れと、川岸や川床の浸蝕というようなべつべつの現象のあいだにも、関連性がある。",
              "citation": {
                "source": "犬がなくとガラスがこわれるか",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "では又、きょうのようなべとつく日、さぞあつい湯で体をおふきになりたいことでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "依然として降りしきる生暖かいようなべた雪を浴びて、全身真っ白になっていた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、震えているような倒影の揺れから小波が立っているらしいと知らされたのだが、橋から見える限りの辺りの水面は、油のようなべっとりした感じの黒光りを放った、いっこうに皺のない滑らかさであった。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼は場所もあろうに、雑沓をきわめた往来のまんなかで、恐ろしさにブルブル震えながら、気をうしなうばかりになって、拡声器のようなべら棒な声で、彼自身の罪状を白状してしまい、お巡りさんにとらえられるというお話である。",
              "citation": {
                "source": "探偵小説の「謎」",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
