          "standard": [
            {
              "text": "北海道に自生する鵜松明樺は樹高が大きく、木材として価値がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "森林調査で鵜松明樺の樹齢を測定する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この地域の鵜松明樺の林は天然記念物に指定されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "暗灰褐色の樹皮が鱗状に剥き出しかけている春楡の幹、水楢、桂の灰色の肌、鵜松明樺、一面に刺のある※木、栓木、白樺の雪白の肌、馬車は原生闊葉樹の間を午後の陽に輝きながら、ばらばらと散る紅や黄の落ち葉を浴びて、落ち葉の道の上をぼこぼこと転がっていった。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            }
          ]
        }
