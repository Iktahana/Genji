        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その結果は、「要するに御当人ウヤムヤなんだ」といふことになる。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中に倉橋君が来る、晃平を殿として、一行が揃う、こう霧がひどくては、方角も何も解らない、晃平は荷を卸して、路を捜索に出たが、無益に戻って来た、岩の間を点接して、トウヤクリンドウ、ミヤマキンバイ、ミヤマウスユキソウ、チングルマなどがあったが、風と霧と雨の中で、一々眼に止めていられない。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "巡査も、ウヤムヤで来なくなってしまった。",
              "citation": {
                "source": "名勝地帯",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマデハ　ヤマキチ　ノ　ナカヨシ　ノ　イロイロ　ノ、トリ　ヤ　ケモノ　ガ、ヤマキチ　ノ　カエリ　ヲ、タイソウ　ヨロコビマシテ、ウタ　ヲ　ウタウヤラ、オドリ　ヲ　オドルヤラシテ　カンゲイ　シマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが、「三毛」の子で性質温良なる雄の「ボウヤ」を、女敵のようにつけねらって迫害し、すでに二度も大けがをさせた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボウヤ」は、この「オジサン」が来ると、喜んでいっしょについてあるくのである。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫の「ボウヤ」が十月に死んでから、妙にさびしくなった家が、これでまた急ににぎやかになったような気がして、それからは、毎朝新しい菜っ葉をやっては、玉をころがすような朗らかなワーブリングを聞くのが楽しみであった。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "死んだ「ボウヤ」にそっくりの白い猫である。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もみじを隔てて、遥にこう、雲の中で吹き澄ますといった音色で、オヒャラー、オヒャ、ヒューイ、ヒヒャ、ユウリ、オヒャラアイ、ヒュウヤ、ヒュールイ、ヒョウルイヒ、と蒼空へ響いて、幽に耳に留りました。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝の水くみあげくみあげあたゝかい・いちご、いちご、つんではたべるパパとボウヤ　旅の人とし休んでゐる栴檀の花や葉や　まいにちいちにち掘る音を聞かされる（温泉掘鑿）　六月八日　同前、吉見行乞。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ　ウグヒスハ　オカアサンウグヒスデ、センダツテノ　コト、ボウヤノ　ウグヒスヲ　ナクシタノデ、タイヘン　カナシンデ　ヰタノデシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、コノ　ウグヒスハ、オカアサンヲ　ナクシタ　コドモノ　フク、カナシイ　ウグヒスブエノ　オトヲ　キクト、ナクシタ　ボウヤノ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホントウニ　ソウデスヨ、ワタシモ　ハヤク　ボウヤニ　コノ　ヨイ　セカイヲ　ミセテ　ヤリタクテ　タマリマセン」ト　ウマハ　コタヘマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボウヤノ　アタマノ　トコロニ　大キナ　モノガ　アルデセウ？",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガチヨウノ　タンジヨウビ新美南吉　アル　オヒヤクシヨウヤノ　ウラニハニ　アヒルヤ、ガチヨウヤ、モルモツトヤ、ウサギヤ、イタチナドガ　スンデ　ヲリマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽やかな夏の新装を身に着けた貴婦人たちの群が、ウヤズドフスキェの大通りを、いくつも流れていった。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "困るな」「それから早川の下宿のお神も新聞の写真を見て、早川さんの方は間違いないが、女の方は誰だかわからんようです……とウヤムヤな事を云いおるんだ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち居ながらにして天下を巡狩しようという、有難い思召だ……ドウヤラ貴妃様の御注文らしいがね」「絵の天才だったのですねその青年は……」「無論さ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の中でもフイフイっていうのは、まだ十七か八の初々しい聡明そうな瞳をした、スンナリとした小娘でしたが、あっしに色目を使いはじめたのはドウヤラ此娘の方が先だったらしいんです。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつがドウヤラ新聞に出た台湾館の行方不明の客呼び男らしいていう噂がホテルのお客さんたちの間に立ち初めました。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "よくわかります」「僕が継母に説伏せられて三度の御飯よりも好きな音楽をやめて、軍隊に入る約束をさせられたのもドウヤラその弁護士の策謀らしいのです。",
              "citation": {
                "source": "戦場",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウヤラ笑っている眼付である。",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "張扇をバタバタと叩いて「ソラソラ」と云う時は軽い時で、笛の笙歌を「オヒャラリヒウヤ」とタタキ附けるように云う時は筆者の気が抜けているのを呼び醒ますためであった。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも最初は、それほどこの「ヒウヤ」が怖くなかったが、そのうちに翁が笙歌を云いながら立上って来て、「ヒウヤ」と耳の傍で憎々しく云うと筆者を突飛ばしたので、それ以来この「ヒウヤ」を聞くたんびにドキンとして緊張した。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところであの母親の方はドウヤラ継母と私は睨みましたが……」　和尚は良助の明察にギョッとしたらしくよろめいた。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日田金がドウヤラ今度の振袖娘胴切の事件の発端らしいケニ、世の中はどう持ってまわったものかわからん」「ハアテなあ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故という事なしに、「犯人はドウヤラこの一知らしい」　という直感が、草川巡査の脳髄のドン底にピインと来たのであった。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
