        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「ウヘッ」と彼は苦い薬を飲み込んで、顔をしかめていました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "冷たい水を一気に飲んだ時、「ウヘッ」と喉がびっくりしたような声が出てしまいました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "辛いものを食べてしまった時、「ウヘッ」と息を呑んで顔が赤くなりました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
