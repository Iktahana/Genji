        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ナマケモノといふ動物を思ひ出さずにはゐられないほど、此頃はなまけてゐる、どうもグウタラから抜けきれない。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のワガママとグウタラとのせいであります。",
              "citation": {
                "source": "三八九雑記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "友に与へた手紙のうちに、――老来なか／＼に思ひ惑ふことが多くて、ます／＼グウタラとなり、モノクサとなりつゝあります、どうでも少し歩いて来なければなりません。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は私のワガママとグウタラとを責めずにはゐられない、何といふ我儘な怠け者だらう！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ニ逢ウタラ鰹節一本贈ルナドトイウテ居タガ、モーソンナ者ハ食ウテシマッテアルマイ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんならこのコップで行こうで」「まア……イヤラッサナア……冷たい盃や受けんチウタラ」「ヨウヨウ。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「啖付いても大事ないかえ」「歯が立ったなら鰻を今一パイ喰わせる……アイタタタ……待て……待てチウタラ……」　廊下を通りかかった女中が吃驚したらしく襖を開けたが、木乃伊親爺の二の腕に付いてる濡れた歯型を見ると、呆気に取られたまま突立っていた。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "わかっとるチウタラ……」　　　　　　　五　星浦製鉄所はさながらの不夜城であった。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "両方儲かる話が、わからんチウタラ打出の小槌でたたいても銭の出んアタマや……ハハン。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「耶蘇教の婚礼なんてナンチいう、フウタラ、ヌルイ（風多羅緩い？",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……何だい赤たんて……」「赤チュウタラ赤たん。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ちはやし、打ちはやす、トウトウタラリ、ポポンポン。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おゝアイヌウタラ、アウタリウタラ！",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ記念にと言ってアイヌウタラに貰ったイクパシュイが十何本と、イナウルが一つとを持っていらっしゃるさうです。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫は幼年学校、陸士育ちの生粋の軍人であるから、敗戦にヤブレカブレ、グウタラ、不キゲン、毎日腹を立てゝいる。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "金龍の手練は美事であったし、謎のゆたかな肉体というものならば、私程度の遊び人は、誰しも一生に五人や六人その心当りはあり、然し、そのようなものによっては、我々のグウタラな魂すらも充たされぬものであることを知っている筈のものだ。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは然し私の心の中の話で、私は類例の少いグウタラな人間だから、酒の飲めるうちはノンダクレ、酒が飲めなくなると、ひねもす碁会所に日参して警報のたびに怒られたり、追ひだされたり、碁も打てなくなると本を読んでゐた。",
              "citation": {
                "source": "ぐうたら戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "人殺しや強盗などには勤勉でよく働くのが多いものだが、コソ泥などというチャチなのに限ってグウタラで、人目を盗んで精一パイ怠けたがるのが多い。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の健康さの全部のものを作品に捧げつくして、その残りカスが私というグウタラな現身なのだよ、と誇示し得ないこともないのである。",
              "citation": {
                "source": "わが精神の周囲",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はグウタラで、ヒネクレ根性で、交際ギライの偏執狂であるが、しかし、私は、自分のつくすべき役割への責任を知り、人のために、自分でつくせる奉仕はつくしたいという心の正しい位置をつきとめている。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、自分も働いてお金をもうけることをせず、木々彦がグウタラな道楽息子に育ち上るのを意に介せず、名家の子はノンビリとしたい放題、そんなものだと心得ている。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "神楽歌には土地の人々も意味を知らない国籍不明の文句が多々あって、たとえばトウトウタラリトウタラリというようなのを河口慧海という人がチベット語だと云った。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第一回　高千穂に冬雨ふれり≪宮崎県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、絵かきなんて言う人たちは、皆が皆どうしてこう、揃いも揃って、いけずうずうしいと言うか自分勝手と言うか、気ちがいじみて、グウタラなんだろう。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンバソウがチベット語で「トウトウタラリ」の全文がそっくりチベット語にほかならず、現にチベットに於ては、これとほぼ同じような踊りが行われていると言うのであった。",
              "citation": {
                "source": "勉強記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ノ意見デ東大梶浦内科ノ梶浦博士ニ来診ヲ乞ウタラト云ウコトニナリ、本日午後博士来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたのようなグウタラ親方のところに居ったんじゃあ、先の見込みがないけ、こっちから、ケツ割ってやったんじゃ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
