        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ウウウウと云う音が丸い段落をいくつも連ねて家の周囲を二三度｜繞ると、いつしかその音がワワワワに変化する拍子、疾き風に吹き除けられて遥か向うに尻尾はンンンと化して闇の世界に入る。",
              "citation": {
                "source": "琴のそら音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウウウウ、ウウウ、ウウウウウ、ウウウウ、ウウウ、ウウウウウ、と、正坊は「ゆうかんなる水兵」の曲をうなりだしました。",
              "citation": {
                "source": "正坊とクロ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ウウウウ……そんなに死にてえのかナア……」　って喘ぎ喘ぎ云いながら、妾の両足を掴んで、床の上をズルズルと、片隅に引っぱって行くと思ったら、そこに置いてあったらしい細い針金で、足首の処から先にグルグルグルグルと巻き立てて、胸の処まで袋ごしに締め付けてしまったの……。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆の者、よく見ておけ」　と云いながら鸚鵡に向って――「ウウウウ。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "受け取った一学が、改めて、「新参者の分際で――」　と、やり出したとき、どウウウウん、どうん！",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウウウウ　ハアハア　胸はひどく波打って居た。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬいを認めると、彼は藁を打ちながら、頭を動して笑い、「ウウウウウ」と挨拶した。",
              "citation": {
                "source": "杏の若葉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雄鳩は不安なき眠りの悦びを感じながら優しく、「クウウウウウ」と喉を鳴らした。",
              "citation": {
                "source": "白い翼",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "再びカサカサ身じろぎをし、雌は、「クククウウウウウウ」とゆるやかに啼いた。",
              "citation": {
                "source": "白い翼",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「見給え、こういうものさ」　酒のまわり始めたポリニャークは、テーブルに向ってかけている椅子の上で胸をはって上体を立て、顎をカラーの上にひきつけて、正面をにらみ、腕をそろそろと大きい曲線でもち上げながら、「ウーウ、ウウウウヽヽヽヽ」と、どこやら謡曲らしくなくもない太い呻声を発した。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもウウウウウと、のどの奥で奇怪なうなりをたてています。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウウウウおのれは左近将監！",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ウウウウウウ」　と正三君は泣きだした。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉山はやりすごしてから、「ワーウウウウ」　と唸りながら先生の肩へ虎の前足をかけた。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "バウー……バウウウウ……ッ。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、鉄人の肩が、がくんとゆれて、「ウウウウ……。",
              "citation": {
                "source": "鉄人Ｑ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、「ウウウウ……。",
              "citation": {
                "source": "鉄人Ｑ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウウウウ……」何とも云えぬ気味の悪い唸声がしたかと思うと、Ｔ氏がヌッと椅子から立上って、バッタリと床の上へ倒れた。",
              "citation": {
                "source": "赤い部屋",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
