        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サウシーの『随得手録』三輯記する所はやや異なるなり。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウシーの『コンポステラ巡礼物語』はこれを敷衍したものだ。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウシーの『コンモン・プレイス・ブック』四輯に、コングリーヴの一犬ペンクリッジ寺の修繕一年に竟り誰も詣でざるに、日曜ごとに独り欠かさず詣でたと載す。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "七百年の永い間の物語りは、私達の知るところではない、ウシーの宿で書いたと云う、彼のバイロンの一節と、湖の空にグラモンの雪を仰げば、歴史は私にとっては、何の感興をも与えない。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひる終って、大勝館へ、白十字で食事して行くと、おめあての「ワンダバー」“Wonder Bar”のつまらぬこと、豪華キャストと、映画ならではのレヴィウシーンがいゝだけ、つまらんので出ちまった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
