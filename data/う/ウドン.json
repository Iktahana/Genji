  {
    "uuid": "2068639f-4b64-55c3-a83f-082c2fb8ae4b",
    "entry": "優曇",
    "reading": {
      "primary": "うどん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
