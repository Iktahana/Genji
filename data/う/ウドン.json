[
  {
    "uuid": "38cb94ca-b839-5783-b4fd-601b1ec3f0b9",
    "entry": "饂飩",
    "reading": {
      "primary": "うどん",
      "alternatives": [
        "うんどん"
      ],
      "is_heteronym": false
    },
    "grammar": {
