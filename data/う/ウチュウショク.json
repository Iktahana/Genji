        "examples": {
          "standard": [
            {
              "text": "チューブ入りのペーストが主流だった初期に比べ、現在の宇宙食は非常にバラエティ豊かだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "地上と同じ味を再現するため、宇宙食の開発には一流シェフの知恵も取り入れられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "無重力空間でも飛び散らないよう、宇宙食のスープには適度な粘り気がつけられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、食事という習慣を捨てて、それを宇宙食みたいな薬品（だろう、あれは）の摂取に変えるとなれば、話はちがってくる。",
              "citation": {
                "source": "本はどのように消えてゆくのか",
                "author": "津野海太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
