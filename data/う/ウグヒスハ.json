                "note": "青空文庫"
              }
            },
            {
              "text": "コノ　ウグヒスハ　オカアサンウグヒスデ、センダツテノ　コト、ボウヤノ　ウグヒスヲ　ナクシタノデ、タイヘン　カナシンデ　ヰタノデシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、コノ　ウグヒスハ、オカアサンヲ　ナクシタ　コドモノ　フク、カナシイ　ウグヒスブエノ　オトヲ　キクト、ナクシタ　ボウヤノ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウグヒスハ　ヘイノ　ウヘヤ、ツバキノ　エダニ　トマツテ、「ケキヨ、ヨ　ケキヨ、ヨ」ト　ナキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
