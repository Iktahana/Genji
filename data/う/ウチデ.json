          "literary": [
            {
              "text": "オマエハ、ウチデ、オトナシク、ルスバンヲシテイレバ、ソレデ、イイノダヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチデハ　トウサン　トツテモ　ヤサシイノニ　ガクカウデハ、ドウシテ　コンナニ　キツイノダラウ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモハジメノウチデ、工場ノ人モダンダンコナクナッテ、死ンダトキニハ、ミンナハモウ君チャンノオ父ッチャノコトヲワスレテシマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルヒ　タラウサンノ　ウチデハ、ナニカ　オホソウドウガ、モチアガリマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
