        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "長崎の銀座、いちばん賑やかな場所はどこですか、どうゆきますか、と行人に訊ねたら、浜ノ町でしようね、こゝから下つて上つてそして行きなさいと教へられた、石をしきつめた街を上つて下つて、そして下つて上つて、そしてまた上つて下つて、――そこに長崎情調がある、山につきあたつても、或は海べりへ出ても。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは千葉県の九十九里浜というたいへん長い海べりでありました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わる者たちの方は、海べりにテントをはり、さかんに火をもやして、なにかうまそうなたべ物をにているようです。",
              "citation": {
                "source": "電気鳩",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――着けばもうその日のうちに、海べりの閑静なわが家が見つかる。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "すさまじい暴風の中で岩だらけの海べりに集つて来て、昨日から帰つて来ない幾つかの舟を心配してゐる大勢の女や老人子供たち。",
              "citation": {
                "source": "アラン島",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "沖の弁天から南の海べりまで続くひとすじの道があって、ひどく歪んだ松の並木が不揃いにずっと断続している。",
              "citation": {
                "source": "お繁",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和三年四月四日、農山漁村の名が全部あてはまるような、瀬戸内海べりの一寒村へ、若い女の先生が赴任してきた。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "海べりの家ではどこもみな、屋根がわらをはがされたらしく、屋根の上に人があがっていた。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "アビルの弟の家は、いわば陸と海のさかいの海べりにあった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
