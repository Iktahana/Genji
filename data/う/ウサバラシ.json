      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "diversion (from one's worries, troubles, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "映画館へ行くことが私の憂さ晴らしだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ストレスの憂さ晴らしに友人とカラオケへ行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "買い物をすることが彼の憂さ晴らしらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "旦那さまだとて金滿家の息子株が藝人たちに煽動られて、無我夢中に浮かれ立つとは事が違ふて心底おもしろく遊んだのではありますまい、いはゞ疳癪抑へ、憂さ晴らしといふやうな譯で、御酒をめし上つたからとて快くお醉ひになるのではなく、いつも蒼ざめた顏を遊ばして、何時も額際に青い筋が顯はれて居りました。",
              "citation": {
                "source": "この子",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、近頃はまだ噂の行き亘らぬ吉原方面に場所を変え、そこを取引先との交際場にも、自分の憂さ晴らしにも使うようになった。",
              "citation": {
                "source": "とと屋禅譚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもねえさんにはあなた方の考えてもみられないような心配な事や困る事があるものだから、つい憂さ晴らしにこんな事も覚えてしまったの。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "読者は「外套」の幽霊と肩を抱きあつて慰めあひ、憂さ晴らしに腕を組んで居酒屋へ行きたくなる。",
              "citation": {
                "source": "幽霊と文学",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人旅の憂さ晴らしに、ていのいい幇間代りの道具にされるだけなのだ。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「議論に負けた憂さ晴らしよ！",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……水戸様石置き場の空屋敷などへ、たとい私たちが出入りをしたにしても、それはほんの憂さ晴らしでもあり、いい換えれば息抜きでもあるのだよ。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "罪の深い男で、ただ憂さ晴らしのために飲んだんでございますよ。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "だって、人は憂さ晴らしに酒を飲むだろう。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ね、だからぼくも憂さ晴らしに、こうしてここに来ているのだ、ねえ、ひとつ聞かしてもらおう。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も奥畑のお茶屋遊びは前からのことではあったが、当人は、これも君との結婚を許して貰えない憂さ晴らしだから、大目に見てくれ、但し僕のは女達を集めて無邪気に酒を飲むだけだ、決して節操を汚すようなことはしないから、それは信じてくれと云っていたので、その程度のことは諒解してやっていたのであった。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも同じくむしゃくしゃしている子分連中と、山笠をおさめてから、自宅で、憂さ晴らしの饗宴を張った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "久しぶりに独りで映画でも観て、うさばらしでもしたかつた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤羽夫人は、パートナーを連れて早々に競技場をひきあげると、うさばらしに飲みにゆき、キャバレーへ踊りに行った。",
              "citation": {
                "source": "華々しき瞬間",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、メルゲルの心を苦しめたのは、後悔であったか、それとも羞恥心であったかはともかくとして、彼はますます＊４うさばらしを必要とするように思われた。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊４　うさばらし――うさばらしをするためのブランデーをさす。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私窩子のやるせない憂さ晴しである。",
              "citation": {
                "source": "ダミア",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は憂さ晴しの酒を飲めるやうな健康ではなかつたので、生死の間をさ迷ふやうな心持で、凝つと腕組みをしたまま思案ともつかぬものに耽つてゐると、母親は急にこそこそと片づけごとをはじめたり、あちこちの箪笥に錠をおろして別の家に赴いたまま幾日でも帰らなかつた。",
              "citation": {
                "source": "裸虫抄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も、自分にとって、創作は冗談や余技の憂さ晴しではない、たといどんなに小さくても、自分から産み出された芸術の裡に、又は、創造しようとする努力の裡に、自分の生命の意味を認めずにはいられない力を、内から感じているのである。",
              "citation": {
                "source": "概念と心其もの",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧亡して居ると酒で憂さ晴しだよ。",
              "citation": {
                "source": "お久美さんと其の周囲",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "和子さんなんか　本当にお好きで、天分もおありんなって、本ものになろうとしていらっしゃるんだからいいけれど、私なんぞ、外にすることがないし、したくったって出来ないから、まあ憂さ晴しみたいなもんなんですものね」　佳一にそんな打あけ話をするくらいであった。",
              "citation": {
                "source": "ヴァリエテ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃の人の道徳に従って、遊女に戯れて憂さ晴しをやるような、そんな生優しい悩みでは無いと二人共信じ切って居たのです。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "枕の妖異",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥かげに鼠なきしてなぶられるこれも苦海のうさはらし、愚痴がのませる冷酒はしんきしんくのアヽくの世界。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "試験者も受験者も共に満足せずして、いわば婢ばらがうさはらしの種となるに終われるなり。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はあらゆる職業に失敗して、失望のどん底にある時、うさはらしに一篇の小説を書いた。",
              "citation": {
                "source": "陰獣",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "世に認められぬ人間は、自分の地位の卑しいことの憂さはらしに自分の見解の高さをほこるものである。",
              "citation": {
                "source": "バルザック",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この憂さはらしには、遊蕩紳士殿村啓介に変身して、いまわしい記憶を洗い落とすほかはないと思った。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
