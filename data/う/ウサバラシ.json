    "entry": "憂さ晴らし",
    "reading": {
      "primary": "うさばらし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
