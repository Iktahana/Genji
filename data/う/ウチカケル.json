        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "藤村の「お小夜」「つげの小櫛」の境地は、『みだれ髪』にうたわれた女の、身をうちかける積極性と、何とちがった抒情の世界であるだろう。",
              "citation": {
                "source": "婦人作家",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸木艇が、怪力線をうちかけると、蟻田艇は、遮蔽網でふせぐ。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なぜ、今頃になって、天井の青い電灯がついたのだろうか」　これはなにか、小浜兵曹長に対し、上からピストルでもうちかけるのではないかと思われました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
