          "literary": [
            {
              "text": "可哀さうに、後ろ傷で往生しちや綱の野郎も浮ばれめえ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美女を洗ひ出す",
                "note": "青空文庫"
              }
            },
            {
              "text": "可哀想に、後ろ傷で往生しちゃ綱の野郎も浮ばれめえ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "美女を洗い出す",
                "note": "青空文庫"
              }
            },
            {
              "text": "死骸の背には二太刀ほど、大きな後ろ傷が負わせてある。",
              "citation": {
                "source": "御鷹",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　まだ癒えきらない後ろ傷の身に鎧甲を着けて、周瑜は剛気にも馬にとびのり、自身、数百騎をひきいて陣外へ出て行った。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑止や武士には第一の恥辱たる後傷をだッとその背に浴びて、声もなくどったりとそこにうっ伏しました。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後傷はたいへん良くなった。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
