        "examples": {
          "standard": [
            {
              "text": "仕事が忙しかった分、週末は家族と過ごして埋め合わした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "失った時間を埋め合わすために夜遅くまで勉強した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "このボーナスで給料の不足分を埋め合わすつもりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "差し当った生活の欠陥を埋め合わすために何か自分のものを書くつもりで、その材料を考えようとしたが、そんな気分になれそうもなかった。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく現代に於ては沖縄人にして第一この大欠点をうめあわす事が出来ないとしたら、沖縄人は市民としても人類としても極々つまらない者である。",
              "citation": {
                "source": "沖縄人の最大欠点",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが走りがすむかすまないうちに時化で、枠網一枚台なしにしてしまうし、そんならヤン衆共を喰って埋めあわすばかりだと九一金全廃の腹をきめれば、帳場の奴がとんだどじを踏んでこんどの騒ぎになるし、何一つとしてろくなことはない……。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私の注目を惹いた唯一のこれに代る新税は狩猟税であるが、狩猟は現在フランスではほとんど消滅しているから、一切の残余を埋合すに足る収入を生ずるものとは期待し得ない。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
