        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎日の単調な仕事に倦み疲れて、転職を考えるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "長年同じことを繰り返していると、人は倦み疲れてしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女は人間関係の複雑さに倦み疲れた様子で、休暇を取ることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "太陽が中天に一休みして暑さと砂ほこりにみんなが倦み疲れる頃を見はからい彼は唄をうたった。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日同じ事の繰り返しにすぎませんが、決して倦み疲れることを知りません！",
              "citation": {
                "source": "九州の学生とともに",
                "author": "WITH KYUSHU STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "想像に倦み疲れると、凡てを頭の外へ抛り出そうとした。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の役割に倦み疲れるせいか、子供心にとらわれて他のことを考えるせいかだったろう。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲痛な実は甘いいろんな想像にうみ疲れると、彼の頭の中には、隆吉の姿がしつこく浮び出て来た。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
