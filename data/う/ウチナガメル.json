        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は失恋してから、空を打ち眺める日々が続いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "少女は物思いにふけりながら景色を打ち眺めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "年配の男性は思い出に浸りながら街を打ち眺めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
