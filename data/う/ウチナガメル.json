    "definitions": [
      {
        "index": 1,
        "gloss": "to look afar",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は窓から遠い山々を打ち眺めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "船の甲板から海を打ち眺める乗客たちがいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "祖母は縁側で庭を打ち眺めながら考え込んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そして自分は、自分もあまり好きでもなかつた眼の前の女の顔を、それとなく打ち眺めることがあつた。",
              "citation": {
                "source": "蔭ひなた",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "令嬢の木のぼりを叱るは親なり、隣の息子は指をくはへて打ち眺める。",
              "citation": {
                "source": "素面の管",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も、その後で、陶然と半眼を開いて、上気したララ夫人の顔を打ち眺めるに及んで、これはまた、声だけで満足する法はないと思つたのも事実である。",
              "citation": {
                "source": "「語られる言葉」の美",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらは実に翁の目的をいかにしても成就せしめないゆえんであって、私らから打ち眺めるとき、ただただはがゆさを感ぜざるを得ないのである。",
              "citation": {
                "source": "素人製陶本窯を築くべからず",
                "author": "――製陶上についてかつて前山久吉さんを激怒せしめた私のあやまち――",
                "note": "青空文庫"
              }
            },
            {
              "text": "思わぬ舞台の急変に、一同ただ唖然と花の狂態を打ち眺めるばかりであったが、前の三人のあやふやな証言とはこと違う、何かそこに惻々と迫る実感がある。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、娯楽を慰安と同じに考えることも亦、所有者的な観点から民衆を打ち眺める結果の一つだ。",
              "citation": {
                "source": "娯楽論",
                "author": "――民衆と娯楽・その積極性と社会性・――",
                "note": "青空文庫"
              }
            },
            {
              "text": "造麻呂　（はっとしたように、その忍びのいでたちをした御行の姿を打ち眺める）御行　（なにやら勝ち誇ったように）……私なのです。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "文麻呂は、魔に憑かれたように、天空の彼方を打ち眺める。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度それは雲の間から覗いた深い／＼底無し井戸を見るやうな感じであつて、私はその深碧の色を神祕な、言葉では形容の出來ん世にも美しい色と打ち眺めるのであつた。",
              "citation": {
                "source": "二百二十日",
                "author": "高濱虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼も世間の老人なみに早くから眼が覚める方なので、夜明け方の鶏の鳴く音を聞きながら、まだすや／＼と眠っている妻の顔を、ちょうど今朝ぐらいのうすら明りの中で打ち眺めるのが常なのであるが、今朝はその顔のあるべきところに、主のない枕が空しく置いてあるばかり。",
              "citation": {
                "source": "少将滋幹の母",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明智と書生は、部屋に一歩踏み込んだまま、薄闇の中の血の色の生々しさに、犠牲者に駈けよることも忘れて、しばらくは、茫然とその無残な光景を打ち眺めるばかりであった。",
              "citation": {
                "source": "暗黒星",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "傑作をうちながめる人たれか心に浮かぶ綿々たる無限の思いに、畏敬の念をおこさない者があろう。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリストフは眼を開いて、息を凝らし、しみじみとした心で、自分のそばにうちながめる、眠ってる女の疲れたなつかしい顔を、恋のためのその蒼白い色を……。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼は今まで存在していたすべてのものの記憶を失って、うちながめることの喜びをむさぼるように味わった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と太い声で独語ちて、私の貌を打眺めると、ちよつと間、もぢもぢと体を動かせてゐたが不意にべこんと頭を下げると一目散に棚の中へ駈け込んだ。",
              "citation": {
                "source": "青春の天刑病者達",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "明い日の光の中に燃えては消えて行くさま／″＼な色彩の変転は、黙つて淋しく打眺める自分の胸に悲しい恋物語の極めて美しい一章々々を読み行くやうな軟かい悲哀を伝へる。",
              "citation": {
                "source": "花より雨に",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は途方に暮れて、唯だぼんやり其の樣子を打眺めるばかり、女が此後の身の振り方を問ひ迫つても、私は何とも即座に囘答を與へることが出來ない。",
              "citation": {
                "source": "歡樂",
                "author": "永井壯吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に私はこの石碑を打眺めるたびに太だ好感情を禁じ得ないことは典山文慶のやうな世話物の妙手にこの企のあるは当時としても、貞山、馬琴、如燕、若燕、南龍のごとき「天保六花撰」をば未だ嘗て一とくさりだに高座で読んでゐない人々が共にこの建碑に出費してその名を列ねてゐると云ふ美事である。",
              "citation": {
                "source": "下谷練塀小路",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "処で、この風景を打ちながめるに就いてすぐ様注意を奪われるのは、まず第一に所謂右翼団体の存在と活動と、それから軍部の大きな実際勢力とだろう。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
