        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "シカシ労働ニ害サレタ手ハ思ウヨウニ自分ノ感力ヲ現ワス事ガデキナイデ困リマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大キナ犬ヲ飼ウヨウニナッタノハ浄吉ガ嫁ヲ迎エテカラデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ニ墨グライハ磨ッテ貰ウヨウニナルカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ上ニ大型ノ写真ノ暗箱ノヨウナ機械ガ天井カラ降リテ来テ予ノ姿勢ノ上ニ巧ク出会ウヨウニ加減スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ昨日急ニ気ガ変リ、彼女ニ打チ明ケタ方ガイヽト思ウヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ左手ノ運動ガ不自由ノタメ、手ヲ思ウヨウニ使ウコトガ出来ナイノデ一層困難ヲ極メタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジ支那デモ上海ト広東トハマルデ国ガ違ウヨウニ離レテイマス、目下当地デハ「グレイハウンド」ガ流行デス、ソレデヨケレバ持ッテ行キマス、ドウイウ犬カ君ハ多分知ッテイルデショウガ、参考ノタメ「グレイハウンド」ノ写真ヲ此処ニ入レテ置キマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
