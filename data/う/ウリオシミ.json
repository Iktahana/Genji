        "examples": {
          "standard": [
            {
              "text": "農家が米の売り惜しみをしたため、市場への出荷量が減少し米価が上昇した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "コレクターたちの売り惜しみが続いたことで、希少切手の価格はさらに高騰した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "売り惜しみが横行すれば消費者が困るとして、公正取引委員会が調査に乗り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "買い占めや売り惜しみなどは、そもそもこの根本原因の末梢的結果だろう。",
              "citation": {
                "source": "挙国一致体制と国民生活",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "見栄坊の売り惜しみ屋だから、まだ相当のものがあるのよ。",
              "citation": {
                "source": "遺恨",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この前の戦争で狡い奴らに先を越されて損をしたが、今度はチャンと要領を覚えたから、今度戦争になってみろ、買い溜め、売り惜しみ、闇屋、持ち逃げタダ拾い（戦争中は泥棒なんて言葉はないや。",
              "citation": {
                "source": "武者ぶるい論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいものは、どうも売り惜しみがしてね。",
              "citation": {
                "source": "らんの花",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
