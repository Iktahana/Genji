        "examples": {
          "standard": [
            {
              "text": "絶好の甘い球が来たのに、緊張のあまり打ちそこなって空振り三振した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "壁に釘を打とうとしたが、金槌を打ちそこなって自分の親指を叩いてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "蚊を叩こうと両手を合わせたが、わずかにタイミングを打ちそこない、逃げられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "蠅を打つにも、全心全力で打てば、めつたに打ちそこなうことはない。",
              "citation": {
