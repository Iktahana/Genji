        "examples": {
          "standard": [
            {
              "text": "医師はうつ病の症状について詳しく説明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "カウンセラーと一緒にうつ病の治療に当たっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "うつ病は誰もがかかる可能性のある病気だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "収容所でも年を取つた兵隊が激しいノルマに耐へられなくてうつ病になつて行き、ひどい取越苦労にとりつかれて、自殺したものも幾人かあつた。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
