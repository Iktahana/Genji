[
  {
    "uuid": "30fba535-4e56-5cb2-9af9-efa4e4a57ed5",
    "entry": "うたた寝",
    "reading": {
      "primary": "うたたね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
