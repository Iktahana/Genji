          "standard": [
            {
              "text": "「生みの親より育ての親」という言葉が示す通り、彼は育ての親を尊敬していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "生みの親より育ての親という考え方は、古くから日本に根付いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "養子を引き取った親は「生みの親より育ての親」の重要性をよく理解している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "生みの親より育ての親、と言うでしょう？",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "親は無くても子は育つんだからなあ、それ、世間でも生みの親より育ての親と言うだろうじゃねえか、拾って下すって、今日まで面倒を見て下すったその御恩人に対して、御恩報じをする心持でいせえすりゃ、それでいいのさ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
