        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして両手をウーンと張り上げた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウーンと唸る声がした。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「親分一寸Ｔ「いい女ですな」　と、云われて「ウーン」見惚れて居る五郎蔵。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　大吉「ウーン、いいとも」と頷いて、さて改まって、Ｔ「じゃが……」　ジロッと凄く仲蔵睨んで、Ｔ「素ッ首　洗っとけよ！",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し江藤さんとは全体誰の事じゃ」「江藤侯のことで……直文さんのことで」「ウーン三輔のことか、そうか、三輔なら三輔と早く言えば可えに。",
              "citation": {
                "source": "富岡先生",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンポン桶をたたきながら黙って聞いていた桶屋はこの時ちょっと自分のほうを見て変な目つきをしたが、「そしてその麝香というのはその木の事かい、それともまた毛虫かい」と聞く、「ウーン、そりゃあその、麝香にもまたいろいろ種類があるそうでのう」と、どちらともわからぬ事をいう。",
              "citation": {
                "source": "花物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕頭で、ウーンと呻吟くのが響き出した、その声が、何とも言われぬ……」　　　　　　　二十八「寝てから多時経つ。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……キャッと叫ぶ、ヒイと泣く、それ、貫かれた、抉られた……ウ、ウ、ウーンと、引入れられそうに呻吟く。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　ゴウーンと雨に籠つて、修禪寺の暮六つの鐘が、かしらを打つと、それ、ふツと皆消えた。",
              "citation": {
                "source": "雨ふり",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宜いか按摩、と呼ばゝつて、備中守、指のしなへでウーンと打つたが、一向に感じた様子がない。",
              "citation": {
                "source": "怪力",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次郎公がキヤツと叫んで後へドタリと倒れると、女房もまたウーンと云つたまゝ気絶して了つた。",
              "citation": {
                "source": "神童の死",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "よかったら、あなたのバンドのドラムの子も」「ウーン、わかんないよ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「邪魔者つきのデイトってところか」「ウーン、微妙なところ」　といってから、慶一は、芝の目に映った邪魔者は、高志とじぶんのどちらなのかと考えた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ウーン、高志がいなくなったことが、ショックだったんだよ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おまえやおれが殺したんだ」「そうかな……ウーン、まあ、ある意味ではそうかもしれない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう一面から、また一方、極めて高く汚れないその理想主義に至るまでの幅の広さを考えると、子路はウーンと心の底から呻らずにはいられない。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウーンと、睡り足りた後の快い伸びをすると、手足の下、背中の下で、砂が――眞白な花珊瑚の屑がサラ／＼と輕く崩れる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウーンと、睡り足りた後の快い伸びをすると、手足の下、背中の下で、砂が――真白な花｜珊瑚の屑がサラサラと軽く崩れる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ウーン、ダメダ、オナカヾ　イタイカラ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "検事はウーンと呻き声を発して、思わず銜えていた莨を取り落してしまった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同時に、押絵を見ていた検事がウーンと唸った。",
              "citation": {
                "source": "後光殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔色一つかえずに、僕の前でそう云うたぞ」「ウーン。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうもおかしいんだ」「……ウーン……おかしいね……」「……とにかくあの別嬪は、君が抹殺したようなものだぜ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして何だか解からないものを床の上で踏み潰しては、ウーンと云って引っくり返る……というのが、この青年名探偵アンポンタン氏の日課になっているのだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トタンに吾輩の全身がズウーンとして、お尻の割れ目がゾクゾクと鳥肌だって来た。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "中心になっているお河童さんの恋愛だって、本物だかどうだか知れたもんじゃないわ」「ウーン。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウーンと云って引っくり返ってしまった。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とか云ったっけ……ウーン。",
              "citation": {
                "source": "殺人迷路",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚吉の足が二本、井戸の中からニューと出ておりますから、驚いてすぐに走り寄って、その足を両方一時に掴まえて、「ウーン」　と引っぱりますと、スッポンと抜けてしまいました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
