        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　と真に打解けたものいいで、「精々勉強したら、名高い、ギョウテの（ファウスト）だとか、シルレルの（ウィルヘルム、テル）………でしたっけかね、それなんぞ、何年ぐらいで読めるようになるんでしょう。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "葛西善蔵先生ハ、旦那芸ト言ウテ深ク苦慮シテ居マシタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "外ヶ浜通りの村の名にもタツピ、ホロヅキ、内マツペ、外マツペ、イマベツ、ウテツなどいふ所有り。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今にても、ウテツなどの辺は風俗もやや蝦夷に類して津軽の人も彼等はエゾ種といひて、いやしむるなり。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "余思ふにウテツ辺に限らず、南部、津軽辺の村民も大かたはエゾ種なるべし。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「美術叢書」（Die Kunst）を監修してゐたリカルド・ムウテル教授に囑せられてロダン論を書くためであつた。",
              "citation": {
                "source": "巴里の手紙",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　――原作はヘルマン、ズウテルマンだよ。",
              "citation": {
                "source": "牛込館",
                "author": "映画館めぐり（十）",
                "note": "青空文庫"
              }
            },
            {
              "text": "豆腐イ……豆腐イ……　テウテ胡桃の淡紫の幹――坂をのぼりきりたるところより貯蔵庫（柑子類の植物を入れたる）の煉瓦壁見ゆ。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "其中漫筆　　酔中戯作一首あなた　ドウテイわたくし　シヨヂヨよ月があかるい虫のこゑ　　　其中漫筆□私俳句とは――□リアリズム精神　　自由、流動、気魂。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ニ逢ウタラ鰹節一本贈ルナドトイウテ居タガ、モーソンナ者ハ食ウテシマッテアルマイ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ヲトコハ　ウチヨウテンニ　ナツテ　ヰマシタノデ　ソンナ　コトハ　キニモ　カケナイデ、イサマシク　ラツパヲ　フキナラシナガラ　マタ　アルイテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、朝、昼、夕方おかまいなしなのも嬉しく、ぼく達も「グウテンモルゲン」で一日中、間に合せます。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か持って参ろうと思ったんですが、まだお目にかかったことがないので、どんな物が、お気に召すか分りませんので、お花ならと思いまして……」と、パラフィン紙の中から、強烈な匂いをこぼしている、アメリカン・ビュウティと呼ばれる赤みを含んだ黄バラの花束を、準之助の前に差し出した。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "結果は直線コースになってから二番人気のトウテンコーに追込まれて、トウテンコーが二番人気ながら七十一円もの好配当になった。",
              "citation": {
                "source": "競馬の一日に就いて",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳町、大浜ト飲ミマワッテ、化粧ノ女ト遊ビ狂ウテオリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お蔭で、永い間の不名誉を回復しましたチウテナ。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒が這入ると気が荒うなるけん、一口も飲む事はならんチウテ遺言されて御座るげなけになあ。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの博多一番の分限者の一人娘で、蔵元屋のお熊さんチュウテなあ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノムネデンウテ」　私は青くなって、時計を貴重品扱いで返送した。",
              "citation": {
                "source": "ざんげの塔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ふ存分、行き度いところまで走つて日頃の鬱憤を晴し、そして叔父さんが戻らぬ間に引返して、何喰はぬ顔でタイキを厩に繋いで置いたら、どんなに愉快だらうとウチヤウテンになつたの。",
              "citation": {
                "source": "〔婦人手紙範例文〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが「フウテンのゴロ」というのが脅迫罪でＮ署に引っ張られたとき、檻房で偶然太田と一緒になった。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでフウテンのゴロが出て来るときに、彼は私たちの知っているＴのところへレポを頼んだのである。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "この蘭医は二か年ほど日本に滞在し、オランダ使節フウテンハイムの一行に随って長崎から江戸へ往復したこともある人で、小倉、兵庫、大坂、京都、それから江戸なぞのそれまでヨーロッパにもよく知られていなかった内地の事情をあとから来るもののために書き残した。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "この兵庫は下の関から大坂に至る間の最後の良港であって、使節フウテンハイムの一行が到着した時は三百｜艘以上の船が碇泊しているのを見た、兵庫市には城はない、その大きさは長崎ぐらいはあろう、海浜の人家は茅屋のみであるが、奥の方に当たってやや大きなのがあるとも言ってある。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
