          "literary": [
            {
              "text": "これは有名な、古今を貫いての傑作といわれているのであるが、あのかすかに開いている口が、うめき声をあげているか、いないかについて、ドイツのレッシングと、ウィンケルマンは、いろいろと論争しているのである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェリントンは、シャッセの一個旅団を右翼から抜きウィンケの一個旅団を左翼から抜き、それを中央に加え、次にクリントンの師団をも加えた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "手をあごに当て、リップ・ヴァン・ウィンケルのようにあご鬚を触った。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            }
          ]
