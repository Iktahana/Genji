[
  {
    "uuid": "af65dbdc-f668-5d55-8276-1cedc5ddfeba",
    "entry": "奪い合う",
    "reading": {
      "primary": "うばいあう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
