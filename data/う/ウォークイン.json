        "examples": {
          "standard": [
            {
              "text": "その高級レストランは完全予約制で、ウォークインの客は原則として断っているそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "出張中に急遽泊まる場所が必要になり、駅前のホテルにウォークインで空室があるか尋ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "予約なしのウォークインでも快く受け入れてくれるヘアサロンを見つけて、ラッキーだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
