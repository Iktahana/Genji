        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "丑三つ時に電話が鳴り、受話器を取ると無言のまま数秒後に切れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "丑三つ時に書いた手紙は翌朝読み返すと後悔することが多いと母から言い聞かされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "丑三つ時の病棟は静まり返り、モニターの電子音だけが廊下に低く響いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "〔無題〕都の中の神田にも、丑三つ時のあることを、病みて知れるにあらねども、声の無きこそ哀れなれ。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、一時、二時、むかしのことばでいえば、丑三つ時です。",
              "citation": {
                "source": "少年探偵団",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "third quarter of the hour of the ox (2-2:30am, or 3-3:30am)",
        "register": "standard",
        "nuance": null,
