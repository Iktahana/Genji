[
  {
    "uuid": "610a59a8-fc9a-5597-abe7-190628e1bafb",
    "entry": "丑三つ時",
    "reading": {
      "primary": "うしみつどき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
