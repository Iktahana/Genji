        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "秋には兎狩りの季節がやってくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "兎狩りに出かけた猟師たちは朝早く出発した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "昔の兎狩りは重要な食料調達の手段だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "四「おい、兎狩りに行こうか。",
              "citation": {
                "source": "雪のシベリア",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺が前以て注意をしたんだ、――兎狩りにさえ出なけりゃ、こんなことになりゃしなかったんだ！",
              "citation": {
                "source": "雪のシベリア",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "国にいるとき兎狩りを二、三度したことがある。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔はこのへんでも熊狩りなどもやつたさうですが、この頃は主に兎狩りをするのだと云ひます。",
              "citation": {
                "source": "匈奴の森など",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「兎狩りでも思いつかれたかな」　そして、手をあげて、すこし離れた箇所を指さした。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "物見遊山と申してもそれは至って単純なもので、普通はお花見、汐干狩、神社仏閣詣で……そんな事は只今と大した相違もないでしょうが、ただ当時の男子にとりて何よりの娯楽は猪狩り兎狩り等の遊びでございました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "国に居るとき兎狩を二三度した事がある。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "池上市長と兎２・19（夕）　十六日の朝、大阪市役所の連中は恒例といふ事で、箕面附近の山で兎狩を行つた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、明日は愈々兎狩かな。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "文政元年より毎年二月と九月に長崎奉行兎狩に託して人数押えを行うた由（『甲子夜話』六四）、いずれそれが済んだ後で一盃飲んだのでしょう。",
              "citation": {
                "source": "十二支考",
                "author": "兎に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭焼、兎狩の話なぞが夫婦の口からかわるがわる話された。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の昨日の田圃だと思った木の無い谷では、すでに山猟師がやってきて兎狩をしているのだった。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時宿主らの連れて居る猟犬は兎狩に行って兎を喰殺して帰って来るという始末で大変に殺伐な光景が現われて来た。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "猟の好きな人は一日を休んで兎狩などに出褂ける。",
              "citation": {
                "source": "山と村",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同年芳江比巴国山兎狩御出。",
              "citation": {
                "source": "ひとごろし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――兎狩のとき争論あり、御抱え武芸者｜仁藤昂軒（名は五郎太夫、生国｜常陸）儀、御側小姓加納平兵衛を斬って退散。",
              "citation": {
                "source": "ひとごろし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
