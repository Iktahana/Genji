    "definitions": [
      {
        "index": 1,
        "gloss": "storming (e.g. an enemy's castle)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "義士たちが吉良邸への討ち入りを決行した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "討ち入りの当日、江戸の町は静まり返っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "芝居のクライマックスで、ついに討ち入りが始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "六段目までの稽古が済んで、もう討ち入りまでは用がないと、あとへ引きさがって煙草をすっていると、うしろから自分の腰を強く蹴って通るものがあった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "人形使い",
                "note": "青空文庫"
              }
            },
            {
              "text": "『呉越春秋』か『越絶書』に、伍子胥越軍を率いて、その生国なる楚に討ち入り、楚王の宮殿を掠めた時、旧君たりし楚王の妃妾を強辱して、多年の鬱憤を晴らしたとあった。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "そばを喰ってしまって、茶を飲んで、それから例のむかし話に移ったが、かの大高源吾の笹売りから縁を引いて、頃は元禄十五年極月の十四日、即ち江戸の煤掃きの翌晩に、大石の一党が本所松坂町の吉良の屋敷へ討ち入りの話になった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "吉良の脇指",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大磯の虎が涙雨」と言つて、曾我討ち入りの夜に降る雨を言ふと伝へた雨も、唯虎御前に責任を負はせたゞけの昔語りで、さういふことを言ひ出した原因は、農村における皐月の意味の深さ、説いても説きゝれぬ五月の心理を、あゝ言ふ形に説いて見たばかりである。",
              "citation": {
                "source": "芸能民習",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして伊右衛門の討たれも雪、大詰が雪の高屋敷討ち入りと言ふことになるのであつた。",
              "citation": {
                "source": "夏芝居",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しからば明夜お討ちなされ」　それから熊太郎は冬次郎によって、計画されている明夜の討ち入り――否、潜入について物語った。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そればかりでなく本陣備前屋に、火災が起こり討ち入りがあったら、十町とは距離のへだたっていない、ここらあたりも騒動しよう。",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分を討ち漏らした代官松の徒が、あくまで自分を討って取ろうとして、自分の屋敷へ討ち入りはしまいか？",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その高氏が京都へ入り、両六波羅を討伐し、この年の五月七日をもって、全く両六波羅を亡ぼしおえ、新田義貞が鎌倉に討ち入り、同じ月の二十一日に、北条一族を亡ぼして、頼朝以来の武家政治を、百五十余年にして消滅させ、政権を朝廷に帰すことを得た。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は芳年の書いた討ち入り当夜の義士が動いてるようだ。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十七士の討ち入り、桜田門外の変、……しかし、今度の事件ほど暗い運命的な感じのする事件はないね。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "また遠くは、上州三国の嶮をこえて、越後春日山へ討ち入り、上杉勢の本拠をつくべく、すでに呼応の聯絡をとっていた滝川｜一益麾下の軍隊へも。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　おなじ人が、金三円ばかりなり、我楽多文庫売上の暮近い集金の天保銭……世に当百ときこえた、小判形が集まったのを、引攫って、目ざす吉原、全盛の北の廓へ討入るのに、錣の数ではないけれども、十枚で八銭だから、員数およそ四百枚、袂、懐中、こいつは持てない。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この着物は、私にとって、謂わば討入の晴着のようなものである。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "われら破れかぶれの討入の義士たちは、顔を見合せて、苦笑した。",
              "citation": {
                "source": "未帰還の友に",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　その前夜、東京に夜間の焼夷弾の大空襲があって、丸山君は、忠臣蔵の討入のような、ものものしい刺子の火事場装束で、私を誘いにやって来た。",
              "citation": {
                "source": "酒の追憶",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜更けの盛り場を選んで彼の売る絵は、こっそりひらいてみると下手な西洋の美人写真だったり、義士の討入りだったりする。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも、また今夜にも吉良邸へお討入りに相成りますかな。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その崩が豊国へ入って、大廻りに舞台が交ると上野の見晴で勢揃というのだ、それから二｜人三人ずつ別れ別れに大門へ討入で、格子さきで胄首と見ると名乗を上げた。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "提灯がないので、暗くて蝮の危害を懼れて、樹明君即製の灯火をふりかざして帰つてゆく、昭和の討入よろしくといつた風態！",
              "citation": {
                "source": "行乞記",
                "author": "仙崎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまた赤穂義士討入の日（昨夜から今朝にかけて）。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "不折まがいの奇抜な字で、余興と題した次に、赤穂義士討入と書いて、その下に辟邪軒秋水と注してある。",
              "citation": {
                "source": "余興",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "あすは討入りという四月二十日の夜、数馬は行水を使って、月題を剃って、髪には忠利に拝領した名香｜初音を焚き込めた。",
              "citation": {
                "source": "阿部一族",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "権右衛門は討入りの支度のとき黒羽二重の紋附きを着て、かねて秘蔵していた備前｜長船の刀を取り出して帯びた。",
              "citation": {
                "source": "阿部一族",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "権右衛門は討入りのときのめいめいの働きをくわしく言上して、第一の功を単身で弥五兵衛に深手を負わせた隣家の柄本又七郎に譲った。",
              "citation": {
                "source": "阿部一族",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "）それを思ふと、赤※義士の討入りなどは仕事が小さい。",
              "citation": {
                "source": "正雪の二代目",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に浄瑠璃坂の仇討のごときは、それが江戸の出来事でもあり、多人数が党を組んでの討入りでもあり、現に大石内蔵助の吉良家討入りは浄瑠璃坂の討入りを参考にしたのであると伝えられている位であるが、どうもそれがぱっとしない。",
              "citation": {
                "source": "かたき討雑感",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "小山田庄左衛門は人も知つてゐる通り、赤穂浪人の一人で、討入の前夜｜湯女の許に泊つて、覚えずぐつすり寝込んで、勢揃ひに洩れたといふ男である。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「私小山田が討入前といふ大事な晩やのに、ついふらふらと湯女の許へ往た、あの余裕のある気持が気に入つてまんね。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は、下郎にちがい無いんだから――然し、今夜は、討入だ。",
              "citation": {
                "source": "寺坂吉右衛門の逃亡",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
