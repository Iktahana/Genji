          "literary": [
            {
              "text": "ウワアーアハハハ○さてこんどは猫のお嬢さんいかがですずゐぶんひどいわ　こんなところに入れてほほう　大｜立腹ですな　すぐ治りますよ○あら　まあ嬉しい！",
              "citation": {
                "source": "小熊秀雄全集−22",
                "author": "火星探検―漫画台本",
                "note": "青空文庫"
              }
            },
            {
              "text": "あげくの果は驪山宮という宏大もない宮殿の中に、金銀珠玉を鏤めた浴場を作って、玉のような温泉を引いて、貴妃ヤンと一緒に飛び込んで……お前とオーナラバ、ドコマデモオ……と来たね」「ウワア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこいら界隈の村里へ出て、美しい女を探し出すと、馴れ馴れしく側へ寄って、あなたの絵姿を描いて差上げるからと佯って、山の中へ連れ込んで、打ち殺してモデルにしようと企てたが……」「ウワア……トテモ物騒な忠君愛国ですね」「ウン。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大方｜伜と娘のためだっしょ」「ウワア。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「白い湯もじを島田に結わせエ赤いゆもじを買わせた奴はアどこのドンジョの何奴かアドンヤツドンヤツどんやつかアウワア――アアア――」「ようし……」　とお作は唄が終るか終らぬかに、コップの冷酒をグイと飲み干して立ち上った。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウワア、これあマア先生、カンジキも穿かねえで、どうしてここまで御座った」「あぶねえことだった。",
              "citation": {
                "source": "眼を開く",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウワア……変な写真が在ライ」　と云いも終らぬうちに塵埃だらけになって転がっていた狸婦人が鞠のように飛上った。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界中に一匹しか居ない」「ウワア。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "老酒、アブサン、サンパンぐらいに致しましょうか」「ウワア。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生のお話が真実百パーセントとして聞いても、あたし達の常識が受け入れられないところがあるから……」「ウワア、こいつは驚いた。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ヨシッ……行けッ……」「ウワア――アッ……」　と伊那少年は悲鳴を揚げながら船長室を飛出したが……その形容の出来ない恐怖の叫び、悲痛の響、絶体絶命の声が俺は、今でも思い出すたんびにゾッとする。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これあどうも……」「済まねえが一寸、顔を貸してくれい」「ウワアア。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな話を聞いてる中に眼尻が釣上って来て自然と別嬪になる……新手の美容術……ウワア。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ウワアッ……西村さんだっ……」「ナニ。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウワアッ」　と三好は夢中になって藻掻いたが、白坊主の力は意外に強く、肩先を羽がい締めにして来るので呼吸が詰まりそうになって来た。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……俺が誰か……わかるか……」「ウア――ッ……ウワア――ッ……」　と三好は悲鳴を揚げて藻掻き狂った。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……幽霊だあッ……ウワア――ッ……」「幽霊じゃない……」　白坊主が底力のある声で云った。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは僕の尻から出たサナダ虫をば並べたとたい」　菊地市長は「ウワアッ」と叫んで襖の蔭に転がり込んで行ったが、それっ切り出て来なかった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウワア――』　と一層、高音を揚げて精一パいに泣出しますと、母親は私の坊主頭を撫でながら、『ヨカヨカ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "資金に詰まって友達の生胆を売って大間違いを仕出かしたのを幕切にして、立派にやめてしまいましたが、考えてみると私輩の一生は南京花火のようなもので……シュシュシュシュポンポンポン……ウワアーイというただけの話で……。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "全快ったらしい』『ウワア……それは大変事の出来とる。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ウワア……しくじったア。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへも一パイ頭からバケツの水をブッかけましたので、無茶先生は、「ウワア。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "このたびは二の替りといたしまして朝顔日記大井川の段……テテテテテ天道シャマア……きこえまシェぬきこえまシェぬきこえまシェぬ……チン……きこえまシェぬわいニョ――チッチッチッチッ」「妻ア――ウワア。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども次の瞬間、激しく揺れ続ける吊ランプの向うで、壁にぴったり寄添いながら、眼を瞋らし、歯を喰いしばって、右手に大きな手銛を持ってハッシとばかりこちらへ狙いをつけたその船長を見た時に、丸辰がウワアアと異様な声で東屋氏にだきついた。",
              "citation": {
                "source": "動かぬ鯨群",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "受け取った屑屋、頓狂なおじぎとともに、「ヘッ、おありがとう――と申しあげてえが、ウワア、なんて小汚え壺だ！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "腰をおとしざま、逃げるように退った喬之助、低めた剣を立て直して、つるぎの逆茂木、下正眼につけたうえ、はずみというものは恐ろしいもので、見事、頼母は自分のほうから追いかぶさるようにブッ刺さって、「ウワアッ！",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "して、子爵自身に就いて云へば、この詩の方面に於ては、キーツ、テニソン、ブラウニングに精通し、特にウワアヅウワアスに至つては、早くからこれを愛誦し、その一言一句をも諳んじて、折に触れ事に接してこれを想ひ起し、回想記にも雑講にも随処にこれを引用してゐる。",
              "citation": {
                "source": "趣味としての読書",
                "author": "平田禿木",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつかウワアズワアスの話が出たら、「詩と云うものは全然わからぬ。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
