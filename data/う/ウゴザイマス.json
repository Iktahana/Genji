        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "門をはひるや否や、色の淺黒い（といつても、カロリン諸島は東へ行くにつれて色の黒さが薄らいでくるやうに思はれる）子供等が爭つて前に出て來ては、オハヨウゴザイマスと叮嚀に頭を下げる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、一齊に、オハヨウゴザイマスと言ひながら頭を下げた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "門をはいるや否や、色の浅黒い（といっても、カロリン諸島は東へ行くにつれて色の黒さが薄らいでくるように思われる）子供らが争って前に出て来ては、オハヨウゴザイマスと叮嚀に頭を下げる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、一斉に、オハヨウゴザイマスと言いながら頭を下げた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ犬デスガ、年ヲトリマシタノデ、一人デクラスノハ、サミシウゴザイマス。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサハ　ダレニデモ　バウシヲトッテ、「オハヤウゴザイマス。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、ボンコチヤンハイツモ、アタラシイ時ノヤウニ美シウゴザイマス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリガタウゴザイマス、アリガタウゴザイマス。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "御療治ノ最中ニ失礼ダト存ジマシタケレド、先日颯チャンカラオ願イシマシタラ御承知下サイマシタソウデ誠ニ有難ウゴザイマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………五時、佐々木ガ牽引ノ時間ヲ知ラセニ来、「オヤ、オ眼ガ赤ウゴザイマスネ」ト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ牽引ヲオ止メニナッテ、安静ニナスッテイラシッタ方ガヨウゴザイマスネ」ソウ云ッテ佐々木ハ予ヲ無理ヤリニ寝室ヘ運ビ、横臥サセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽエ別ニ………」「ソウカイ、子供達モ大層元気ラシカッタネ」「有難ウゴザイマス、オ蔭様デ今年モ大喜ビデ」「不断メッタニ見ナイセイカ、三人トモ見違エルホド大キクナッタネ」コヽデ婆サンガ口ヲ挟ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「起キテコチラヘ来テ立ッテ戴キマショウ、ソノ方ガ注射シ易ウゴザイマス」「承知シマシタ」予ハ寝台ヲ下リ、特ニ勇マシク、シッカリシタ足ドリデ博士ノ立ッテイル明ルイ窓際ノ方ヘ歩ヲ運ビ、博士ト向イアッテ立ツ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デハコレカライタシマス、別ニ痛クモ何トモゴザイマセンカラ御心配ナク」「心配ハシテオリマセン、ドウゾ御遠慮ナク」「ヨロシュウゴザイマスナ」針ガ頸部ニ射シ込マレルノガ感ジラレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜ハオ寒ウゴザイマスカラ明日ニナサイマシタラ」佐々木ガ驚イテ制シヨウトスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ早ウゴザイマス、オ爺チャンハ朝ハイツモオ早イノネ」ソウ云ッテ、竹ノ皮ニ包ンダモノヲ二本、風呂敷ヲ解イテナイトテーブルノ上ニ置ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロデ木村ノ友人ニソノ機械トフィルムヲ持ッテイル人ガアルノダガ、「オ入リ用ナラ借リテ来テモヨロシュウゴザイマス」ト云ウノダッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ハ手伝イニ来タツイデニ、「ヨロシュウゴザイマスカ」ト階段ノ途中カラ声ヲカケテ上ッテ来テ書斎ニハイリ、「オ約束ノ品ヲ持ッテ来マシタ」トポーラロイドヲ置イテ行ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ帰ッテモヨロシュウゴザイマスカ」ト云ウカラ「アア」トダケ答エタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス10点”　あたりは再び静寂に包まれる。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス10点”　またしても頭の中に甲高い金属音が鳴り響く。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス20点”“オメデトウゴザイマス　プラス20点”“オメデトウゴザイマス　プラス20点”　しかし敵の宇宙船は巧みに編隊を組み、今度はなかなかレーザー光線が命中しなくなる。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス20点”　書斎の安楽椅子に深々と体をうずめながら擬似体験ゲームの世界に没入しているあなたは、塾から帰った小学生の秀夫がこっそり部屋に入って来たのに気づかない。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス５点”　頭の中に金属音が響き渡る。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス10点”　頭の中でまたしても金属音が鳴り響く。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス３点”　ちくしょう、俺はゲーム得点が欲しくて戦っているわけじゃないんだ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス３点”「今度はお前の番だ」あなたは大魔王ミノスを威嚇するようににらみつける。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
