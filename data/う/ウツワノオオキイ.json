        "examples": {
          "standard": [
            {
              "text": "器の大きい人になれるよう、まずは人の意見を素直に聞くことから始めよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "チームの絆を深めるには、やはり器の大きいリーダーの存在が不可欠だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "どんな困難にも笑顔で立ち向かう彼女は、まさに器の大きい女性だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "さて人の器の大きい小さいと云ふことを見るのはどう云ふ所で見るだらう。",
              "citation": {
                "source": "混沌",
                "author": "森林太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "薔薇の這つた門や陶器の大きい植木鉢に植ゑられた一丈｜位の柘榴や桜の木の並べられてあるのも見える。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "薔薇の這つた門や陶器の大きい植木鉢に植ゑられた一丈位の柘榴や櫻の木の竝べられてあるのも見える。",
              "citation": {
                "source": "巴里にて",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
