          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "特殊な薬品を吹きかけると、紙の表面に隠されていた秘密のメッセージが浮かび出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "感情が高ぶると、彼の額には太い青筋がはっきりと浮かび出る癖がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "湖の底から泡がふつふつと湧き上がり、何かが水面に浮かび出ようとしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "観客はその夢幻郷の蝴蝶になって観客席の空間を飛翔してどことも知らぬ街路の上に浮かび出るのである。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな事を思うにつけて、君の心の目にはまざまざと難破船の痛ましい光景が浮かび出る。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今度こんなひょんな事でわたしアメリカに上陸もせず帰って来る事になったんですが、ほんとうをおっしゃってくださいよ、あなたはいったいわたしをどうお思いになって」　葉子は火鉢の縁に両｜肘をついて、両手の指先を鼻の先に集めて組んだりほどいたりしながら、古藤の顔に浮かび出るすべての意味を読もうとした。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、画面全体が見るみるぼやけて、そこに過去の話中話が煙りのように浮かび出る――こんなふうに。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "民家の群れは月光を浴びて、いやがうへにも白々と輝やき、低い壁が闇のなかに一際くつきりと浮かび出る。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドニェープルの波の間からは、身投げをして死んだ娘たちが、列をなして浮かび出る。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が黙したときに浮かび出る哀愁、それは彼女すら自覚しないもので、幼時からの逆境による潜在性の性質だったのだ。",
              "citation": {
                "source": "五階の窓",
                "author": "合作の四",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の生活を他人任せ成行任せに押し流して、玉楼の陰であれよし星空の下であれ許された限りの睡りを貪り、分ち与へられた食物に満足して――斯うして万端切羽詰まつた挙句の果に、幸ひにして死ぬことも無く思ひ掛けぬ生活力が浮かび出るなら、何といふ思ひまうけぬ悦びであらうか！",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりげなく皮肉を吐いて時々チラリと伏目にするとき、額にクッキリと浮かび出る神経の波を、見逃すことはできなかつた。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "うす絹のような雲をわけて、まんまるの月が、まんまんたる緑色の大空へ浮かび出るのを、少年は、家の前に立ってながめていました。",
              "citation": {
                "source": "夢のような昼と晩",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとふたたび故しらぬよろこびで胸が波立ちはじめ、どこかの大広間のありさまがおぼろに浮かび出る。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分一個の道――こう押し詰めて来ると、そこに忽然と浮かび出るあの女の幻。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲はすべて琶音から成っていて、時々一連の旋律が、弱々しいつばさで、その上に浮かび出るのである。",
              "citation": {
                "source": "神童",
                "author": "DAS WUNDERKIND",
                "note": "青空文庫"
              }
            },
            {
              "text": "眠りの淵から、からみ合った二つの身体が同時に浮かび出る。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒をつんで、妓をのせて、川尻の澪標木のあたりまで浮かび出るのである。",
              "citation": {
                "source": "治郎吉格子",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵をながめながらふとその作者のことを思うと、その瞬間に浮かび出るのは顔である。",
              "citation": {
                "source": "面とペルソナ",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "古えの工藝家がそれらの器に漆を塗り、蒔絵を画く時は、必ずそう云う暗い部屋を頭に置き、乏しい光りの中における効果を狙ったのに違いなく、金色を贅沢に使ったりしたのも、それが闇に浮かび出る工合や、燈火を反射する加減を考慮したものと察せられる。",
              "citation": {
                "source": "陰翳礼讃",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "織部正は、正直のところ歌のよしあしはどうでもよいのだが、夫人が短檠の灯影のもとにうつむいて、心に浮かび出る文句を口のうちであれかこれかと選り分けているときの、深く考え込んだ表情を見るのが楽しみなのであった。",
              "citation": {
                "source": "武州公秘話",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾々が世に浮かび出る千｜載の一｜遇が来たのに、その機会を逃がすなどという法があるものか。",
              "citation": {
                "source": "死んだ千鳥",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "浪人仲間の一部で、（世に浮かび出る時が来た）　と云っているのは、寛永、正徳以来、ここ五、六十年間の通し矢は、御三家や各藩士の間でばかり競技が行われて来ていたが、今度は、遍く天下の隠れたる弓仕に、あの曠れの場所が与えられ、藩士以外の上手が見出される事になったのを歓んでいるのだった。",
              "citation": {
                "source": "死んだ千鳥",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、ただ目下のわたくしが、心にうかびでるままに、その二、三をあげたのである。",
              "citation": {
                "source": "死刑の前",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "一種の異臭の幽かに浮び出るを敏くも感覚した長次は、身体の痛みも口惜しさも忘れ、跣足のまゝに我家へ一散走り、「母さん、判りました、判りました。",
              "citation": {
                "source": "名工出世譚",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "よき文章家には、必ず隠そうとして隠し切れないであろう特色が、自らその文章に浮び出るものである。",
              "citation": {
                "source": "大衆文芸作法",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "私にして現象である以上の意味をもつことができないならば永劫の時の流の一つの点に浮び出る泡沫にも比すべき私の生において如何に多くのものがそのうちに宿されようとも、いずれは須臾にして消えゆく私の運命ではないか。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "私にして現象である以上の意味をもつことができないならば永劫の時の流の一つの點に浮び出る泡沫にも比すべき私の生において如何に多くのものがそのうちに宿されようとも、いづれは須臾にして消えゆく私の運命ではないか。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "『七郎丸』が海上に浮び出ると同時に、諸君は、これまでの共和生活を挙げてわれらの船の上に移して下さい。",
              "citation": {
                "source": "吊籠と月光と",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄暗いランプの蔭で、おまけに飾りの氷柱がちか／＼と光りを反射するので、表情の凹凸だけが暗闇の中に、明暗の線がくつきりと強い大写しになつてぼんやりと浮び出るばかりであつたが、孰れもあの村の部屋にゐたままの自分の姿だけである。",
              "citation": {
                "source": "痴酔記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "フアコートの襟元から白い息が煙つて、青白い灯光の中に浮び出る冬子の横顔が、村瀬の眼に夢のやうに冷たく美しく映つた。",
              "citation": {
                "source": "女に臆病な男",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼をつむつて見ると、何よりも先きにあの崖下の鉱泉浴の煙突だけが厭にくつきりと浮び出るのが私は、憐れで、滑稽であつた。",
              "citation": {
                "source": "ゾイラス",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生が独りで、又はその仲よしの妹さんの腕に倚つて此の苺園の小径を逍遥する時に、黄昏のメランコリーと共に、その憐れな子供の時の記憶が一々頭に浮び出るであらうことを、僕は想像せぬ訳にはゆかぬ。",
              "citation": {
                "source": "フランソア・コッペ訪問記",
                "author": "堀口九萬一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
