[
  {
    "uuid": "b93d1f90-02f6-593a-a05b-ffd12925f24c",
    "entry": "植え替え",
    "reading": {
      "primary": "うえかえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
