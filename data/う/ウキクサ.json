    },
    "definitions": [
      {
        "index": 1,
        "gloss": "floating weed",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夏の池には浮き草が広がり、水面を緑色に染めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "金魚鉢に浮き草を入れると魚の隠れ場所になり、落ち着くという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "台風の後、川から流れてきた浮き草が用水路に詰まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ポーラはやはり浮き草のようなポーラであるところにこの劇の女主人公としての意義があり、そこに悲劇があり、ほんとうの哀れがあるのではないか。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとは河骨のようなものと、もう一種の浮き草のようなものがあったのだと記憶している。",
              "citation": {
                "source": "池",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、水上に浮かぶ二つの浮き草の花が水中に隠れた根によって連絡されているようなものである。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の幽霊草というのは曼珠沙華のことで、墓場などの暗い湿っぽいところに多く咲いているので、幽霊草とか幽霊花とかいう名を付けられたのだが、ここらでいう幽霊藻はまったくそれとは別種のもので、水のまにまに漂っている一種の藻のような浮き草だ。",
              "citation": {
                "source": "水鬼",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "水かさのました稲田から流れ込んだ浮き草が、ゆるやかに回りながら、水の面へ雨のしずくがかいては消し、かいては消す小さい紋といっしょに流れて行く。",
              "citation": {
                "source": "竜舌蘭",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "地方人の生きかたは都会に浮き草の様な生活を営む月給とりや、日なしの職人のやうな根のない生活はして居ない筈だ。",
              "citation": {
                "source": "民俗芸能の春",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとい充実せぬはかない気分で冷たい境地をうろついていても、たとえば浮き草の葉ばかり揺らいで根の無いごとく、吹けば消え散る心の靄、こんな生活をして、果ては恐ろしい倦怠のみが訪れても私は死にたくない。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "身のまはりの不自由は何ともないが、年中他国を歩いてゐるので、若いうちはそれも面白かつたが、最近は浮き草のやうなたよりない気がして来た。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その簡単な有り様は、太古の移住民族のごとく、また風に漂う浮き草にも似て、今日は、東へ、明日は、南へと、いうふうでありました。",
              "citation": {
                "source": "銀河の下の町",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "流れ浮き草……風吹くままに……　人も無げなるこの振舞いに地団駄踏んだ警官連、ふと見ると隣りの庭に一艘の舟が繋がれてあった。",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の幅は一町ばかり、いちめんの蓮のほかに水葵と蒲かなにかごちゃごちゃに茂って浮き草が敷きつめたようになっている。",
              "citation": {
                "source": "妹の死",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そこに夜店の……といつたゞけでいけなければ、夜あかしの、さうした喰物やのうきくさの果敢ないいのちは潜んでゐる。",
              "citation": {
                "source": "夜店ばなし",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "うきくさのその果敢ないいのちにはツきり触れるからである。",
              "citation": {
                "source": "夜店ばなし",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治以後もそうであり、始めて輸入された浪漫主義は、単に少年少女の幼稚な感傷文学として弄ばれ、未だその真の根がつかない中に、早くも浮草のように枯れてしまった。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにランプの焔はどこかしっかりした底力をもっているのに反して、蝋燭の焔は云わば根のない浮草のように果敢ない弱い感じがある。",
              "citation": {
                "source": "石油ランプ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "緩い流は浮草の帶を解いた。",
              "citation": {
                "source": "城崎を憶ふ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘆の枯葉をぬら／＼と蒼ぬめりの水が越して、浮草の樺色まじりに、船脚が輪に成る頃の、五位鷺の搏ちやう。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　で、老爺は今度は自分の刻んだ魚を、これは又、不状に引握つたまゝ斉しく投げる、と※が立つたが、浮草を颯と分けて、鰭を縦に薄黒く、水際に沈んでスツと留る。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕一人が世間に住みつく根を失って浮草のように流れている。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつまでも一本立ち出来ず、孤独な境遇のまま浮草のようにあちこちの理髪店を流れ歩いて来た哀れなみじめさが、ふと幼友達の身辺に漂うているのを見ると、私はその無心を断り切れなかった。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして立上ったけれども、看護婦のおさへた手が少しでもゆるむと、浮草のやうにくら／＼と動いて、眼は夢のなかのやうに物事をはっきり見ることが出来なかった。",
              "citation": {
                "source": "青白き夢",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の日、お葉はまた浮草のやうにたよりない身体を杖と人とにさゝへられて、扉のそばに立たせられた、そして又、はてしないやうな廊下の末を見やって、物悲しい心になった。",
              "citation": {
                "source": "青白き夢",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "刺戟や苦惱やになれて來た今にして思へば、その當時の事は、たゞ一寸深き注意を要したに過ぎぬ位の事であつたかも知れないけれど、これといつて一生の根を張るものにめぐり合はず、離れつ即きつしつゝ漂つてゐる浮草のやうな生活の上にあつた私達には、ほんとに恐しいその二年間でした。",
              "citation": {
                "source": "道",
                "author": "――ある妻の手紙――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――その揚句にはまた、私は複雑した関係から市役所を馘首になり、妻と二人で浮草のように漂泊しなければならない身となった。",
              "citation": {
                "source": "骨を削りつつ歩む",
                "author": "――文壇苦行記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――所詮、乞食坊主以外の何物でもない私だつた、愚かな旅人として一生流転せずにはゐられない私だつた、浮草のやうに、あの岸からこの岸へ、みじめなやすらかさを享楽してゐる私をあはれみ且つよろこぶ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "一分のめだかから一尺の鯉にいたる魚のすべて、さぎ、白鳥、おしどり、鴨、鶴など水に親しむ鳥どものすべて、また水にさく浮草の花の一つ一つが、それを聞くのじゃ。",
              "citation": {
                "source": "おしどり",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "己もデカダンスの沼に生えた、根のない浮草で、花は咲いても、夢のような蒼白い花に過ぎないのであろうか。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "此頃折々切実に感ずる故郷の恋しさなんぞも、浮草が波に揺られて遠い処へ行つて浮いてゐるのに、どうかするとその揺れるのが根に響くやうな感じであるが、これは舞台でしてゐる役の感じではない。",
              "citation": {
                "source": "妄想",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ、瑠璃子夫人に対する――夫人の移り易きこと浮草の如き不信に対する憎みと、恨みとで胸の中が燃え狂つてゐたのだつた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ、瑠璃子夫人に対する――夫人の移り易きこと浮草の如き不信に対する憎みと、恨みとで胸の中が燃え狂っていたのだった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
