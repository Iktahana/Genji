        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「このケーキ、うまうまだね」と子どもたちが言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "祖母の作った料理を食べながら「うまうまだ」とつぶやいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "「このラーメン、うまうまじゃん」と友人が箸を進める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
