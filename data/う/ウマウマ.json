[
  {
    "uuid": "8f08b1f9-d131-588f-9fc5-4cc7fd848d73",
    "entry": "旨々",
    "reading": {
      "primary": "うまうま",
      "alternatives": [
        "ウマウマ"
      ],
      "is_heteronym": false
    },
    "grammar": {
