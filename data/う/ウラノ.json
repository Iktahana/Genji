        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自省直ケレバ千万人ト言エドモ、――イヤ、握手ハマダマダ、ソノ楯ノウラノ言葉ヲコソ、「自省直カラザレバ、乞食ト会ッテモ、赤面狼狽、被告、罪人、酒屋ニ飛ビ込ム。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "同様にその息子の天の神ウラノス（Uranos）が通例万物の父と名づけられたものである。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女とウラノスは六人の男子と六人の女子を生じた。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二ヒキハ　ウラノ　イタベイノ　カゲニ　ニゲテキテ、ハア　ハア　ト　クルシイイキヲ　ツキマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二ヒキハ　ウラノアキチヘ　ニゲマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この母神その子クロノスに勤めて、父神ウラノスを殺さしむ。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺されしウラノスの流せし血汐は、化して恐しき殺害の復讐神となる。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "其はじめの、天然的分子を含むこと甚しき、天地開闢に関する部分を除きて、人文神話的性質の、稍明かなる部分に就て、之を述べんに、第一回の主宰神は、天神ウラノスにして、第二回の主宰神は、天神クロノスなり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロノスはウラノスの末子、ツォイスも亦た、クロノスの末子なり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウラノスの宇宙主宰倒れて、主権クロノスの手に移り、クロノスの世界政治覆えりて、主権遂にツォイスの手に帰するに至りしは、决して尋常一様の継承相続の結果には非ずして、純然たる一種の革命の結果に外ならず。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "簡単に述べんにウラノスはその末子クロノスに殺され、クロノスの末子ツォイスは、其独特の武器電光霹靂を恣にして、其父の軍を滅したるなり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウラノスの殺されしも、クロノスの滅されしも、進歩に対する犠牲にして、而して、何れの場合に、於ても、末子の手に主権の帰せしを説くは、物は後に至りて愈完全に、社会は時代を経て、益々円満に近くものなりとの思想を、示すものなり、否其思想の自ら、神話の中に現われたるなり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（アキリュウスの母神テチスと混ずべからず）ヘーシオドスによればオーケアノスはウラノスとゲーアの子にして其妻たり妹たるテーチュスと共に三千の河流を生む。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
