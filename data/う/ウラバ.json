          "literary": [
            {
              "text": "オヘダは土人の抵抗によって危うく命を落そうとしてニクエサに救われたりなどしたが、一五一〇年ウラバ湾に植民地サン・セバスチアンを建設した。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち一五〇〇年にロドリゴ・デ・バスティダスの遠征に従い、ベネズエラ湾からダリエン湾（ウラバ）を経てパナマ地峡に到った。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "紀州の田辺附近では、こうほね（骨蓬）のことをゴウライの花という者もあり、またこの彼岸花をゴウラバナというものもある（『和歌山県誌』）。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
