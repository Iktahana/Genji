        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（十二月×日）　駒形のどじょう屋の近く、ホウリネス教会の隣りの隣り、ちもとと云う店。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒形橋のそばのホウリネス教会。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "南河内の山村でカラウ又はウリネといふものと同じであらう。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一名ウリネともいへば、前に掲げたウルネカヅラと同じものであらう。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "南河内の山村でカラウまたはウリネというものと同じであろう。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一名ウリネともいえば、前に掲げたウルネカズラと同じものであろう。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
