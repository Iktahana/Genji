        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『望郷の歌』は、誰も知つてゐる通り、ゲエテのウヰルヘルム・マイステルにあるミニヨンの歌を想ひ浮べながら、京都の四季のうつり變りを歌つてみました。",
              "citation": {
                "source": "詩集の後に",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワグネルが『タンホイゼル』の第三｜齣、『フアウスト』歌劇中のローマンマーチ、さてはかの名高き『ウヰルヘルム・テル』の管絃楽『ローヘングリン』の花嫁の進行曲もありき。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "唐天子の前に、このウヰルヘルムテル丸出しの射藝を演ず。",
              "citation": {
                "source": "蝦夷とコロボツクルとの異同を論ず之に潜みて",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
