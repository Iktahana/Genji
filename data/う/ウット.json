        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その内に一時間位はウットリしたのであろう。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと、ウットリとのびのびするようなの、ないの。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ一人、円タクの片隅に小さくなって……しかし、思案深げな双眸の下の頬には、ウットリとした明るみが、久々に忍び上っていた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い心はウットリとして、何か恁う、自分の知らなんだ境を見て歸る樣な氣持である。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻梁やや人に近く、諸猴に優れて相好美し（ウットの『博物画譜』一）。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウットの『博物図譜』。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウットの『博物画譜』に虎道傍にあって餌獣の至るを俟つに必ず自分の巣に対せる側においてす。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただし野干咆ゆるより虎の居処知れ討ち取らるる例多しとウットが書いた。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "その音が鳴りおわるまで彼女は、机の上にあらわな両腕を投げ出して、ウットリと眼を据えていた。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時のお茶の味が又、特別においしいのだそうで、身体中がお茶の芳香に包まれてしまったようなウットリとした気持になるのだそうですが、やはり神経が弱り切っているせいでしょうね。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなものが一つ一つに溶け合って、次第次第に遥かな世界へ遠ざかって、ウットリした夢心地になって行く……その気持ちよさ……ありがたさ……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、私がそうした瞬間に、又も云い知れぬ失望の色が、スウット若林博士の表情を横切った。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……諸君が何か知ら考え詰めてアタマの疲れた時分にウットリと凝視している、アノ取止めのない空想とか、妄想とかいうものがソレで、そのうちに脳髄がイヨイヨ疲れて眠り込んで来ると、そんな意識同志の連絡もイヨイヨ絶え絶えになって来る。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……何の罪も科も無いのに、殺される以上の残虐を受けているじゃないですか」「……フン……それで……」　と色も味もなく云い棄てたまま正木博士は、自分の吹いた煙の行衛をウットリと見送った。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に、その今までになく明るく見える安全燈の光明越しに、自分の左右の肩の上から、睫を伝って這い降りてくる、深紅の血の紐をウットリと透かして見たのであったが、それが福太郎の眼には何ともいえない美しい、ありがたい気持のものに見えた。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "見る見るうちに街路の向うの……ズウット向うの方へ曲り曲って見えなくなってしまった。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "松の間のゴロ石の上を比較的広い隙間がズウット向うまで行抜けております。",
              "citation": {
                "source": "Ｓ岬西洋婦人絞殺事件",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "綺麗に剃り上げた頬の皺は、濡れた紙のように弾力を失って、甲板の上からトロンと見据えた大きな真珠色の瞳は、夢遊病者のソレのようにウットリと下関駅の灯を映している。",
              "citation": {
                "source": "人間レコード",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "わざと指環をはめないで、化粧だけした両手の指を、これ見よがしに卓子の上に並べながら、ウットリと遠い所に眼を遣った。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　私は眼の前にモヤモヤと渦巻きのぼる温泉の白い湯気を見守りながら、夢を見るようないい気持ちになって、ウットリと彼女の囁やきに聞き惚れていた。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたのお母様は絵のようだと申し上げたいが、絵よりもズウットズウットお美しい」　とある人は申しました。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれ見せろ」　と仰有って信乃と現八の顔をウットリと見ておいでになりました。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども歌舞伎座へ這入って平土間に坐りますと間もなく、人イキレであたたかくなりましたせいか、又もウットリとなりまして、お芝居通の先生や奥様が色々と説明して下さるのを、夢うつつに聞いているばかりで御座いました。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "中はズウット長い石畳の廊下で、冷やりとした薄気味の悪い風がソヨリと吹く。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると彼も往生して、私の寝入るまで、ジットそこで我慢し、あとでソウット母の方に行くのであった。",
              "citation": {
                "source": "私の母",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど、そなたと袖振り合う女子という女子は、たとえば町家の小娘も、そぞろ歩きの遊びめも、大名高家の姫ぎみも、心からウットリとせずにはいられぬのだ――」　と、言いかけた時、今まで熱心に絵筆をふるっていた露月は急にあとをふり向きました。",
              "citation": {
                "source": "艶容万年若衆",
                "author": "三上於兎吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はどうしてまあ、今日はこんなにウットリする様な事ばっかりあるんだろうと思いながら、長い袖でお敬ちゃんの首をかかえた。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "哀れなみなし子がその救主を見上げる様なオロオロしたはずかしそうな目つきをして、若々しいまるい顔にこぼれる様なほほ笑みをうかべてウットリと見入って居る舞子の姿を見上げた。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
