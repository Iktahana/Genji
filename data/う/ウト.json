  {
    "uuid": "33cab82d-e71b-5491-bc7a-3a25271dcf50",
    "entry": "ウト",
    "reading": {
      "primary": "うと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「今夜はもう出ないのかしら」と、安岡は失望に似た安堵を感じて、ウトウトした。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "モーツァルトのフリュウト・コンチェルトに眼を細める。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "柔らかい毛布にくるまって上には志んの持って来た着物をかけられ、脚部には湯婆が温かくていい気持になってほとんど何も考えないでウトウトしていたが眠られはしなかった。",
              "citation": {
                "source": "病中記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ターリングでやろうと計画していた研究の一つは、主要なガス元素の比重を精密に測定してブラウト方則を験しようというのであった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "前髪に蝶結びのリボンを巻いた踊子の意気姿、かの女はもとよりショウト・スカウト、ハイヒール、流行色の粧いが艶やかだ。",
              "citation": {
                "source": "東京ロマンティック恋愛記",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "よってファーニッシング部は廃業して、南京路入口、アウトフィッチング・デパートメントの一部とともにスコッチ・ベーカリーに賃貸するに至れり。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "――更に云ひ直せば、人間がどんなにあがいてみたつて、結局人生には永久にユウトピヤは來ないと云ふ事になるんだ。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――人間にそのユウトピヤへの夢がなかつたら、云ひ換へれば、自分達の生活をより善く、より幸福にしようとする感激がなくなつたら……」「そりや寂しい。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ええ、」　とちょいと天窓を掻いて、「林檎を食べた処から、先祖のニュウトン先生を思い出して、そこで理学者と遣ったんです。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロステチウト、そう言おうと思っていたのでございます。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　実に、気の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　實に、氣の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、日本国内ニ於テハ、農村ヤ工場ニ於テ、資本家ヤ地主カラ搾取セラレ、支那ニキテハ帝国主義ブルジョアジーノタメニ命ガケノ血ナマグサイ戦争ヲサセラレヨウトシテイル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那ノ労働者農民ノ国民革命運動ヲ、血ヲ以テ窒息セシメタ各国ノ帝国主義ハ、干渉カラ土地掠奪ニ移ロウトシテイル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ山東ヲ満洲ノ如ク、奴隷的植民地トシヨウトシテイルノダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "青キ朝日ハコノトキニ、　　　　ケブリヲノボリユラメケバ、樹ハサウサウト燃エイデテ、　　カナシキマデニヒカリタツ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）※（Ｆ・Ｉ）は「フェード・イン」、（Ｆ・Ｏ）は「フェード・アウト」",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ、ソノ　ハナシヲ　キイテ、スグニ、ウミ　ト　イウトコロ　ヘ　ユキタクテ　タマラナク　ナリマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タカ　モ　トウトウ　コトワリカネテ、ソノママ　ツバサ　ニ　ヤマキチ　ヲ　ノセ、ウミ　ヲ　サシテ　トンデ　ユキマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "生々しい膝節を出してスカートのような赤縞のケウトを腰につけたスコットランド服の美貌の門番が銀盆の上に沢山の「平凡」を運んで来た。",
              "citation": {
                "source": "バットクラス",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの狭い石段から眺めるシャトウ・モウトン・ロスチルドと名づけられた一八六九年のボルドウ酒やロマネー・コンチという一八七〇年のブルガンディ酒やはその名前の罎を見るだけでフランス人の飲食物に対する執拗な愛慾を観察するに役立つ。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "野球は其樣な災難が無いから、毎日／＼盛んなものだ、丁度海岸の家から一｜町程離れて、不思議な程平坦な芝原の「ゲラウンド」があるので、其處で「アウト」「ストライキ」の聲は夕暮の空に響いて、審判者の上衣の一人黒いのも目立つて見える。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいていの人間は一種のアウトマーテンである。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "俳諧の道は、われわれをアウトマーテンの境界から救い出す一つの、少なくも一つの道でなければならない。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンドラデによると、ニウトンの原子に関する説明（２）を読めば、彼がルクレチウスを知らなかったと想像する事はできないということである。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "またおそらくニウトンが直接あるいは間接に受けついだと思われる光微粒子説でも一時全く忘れられていたのが、最近にまた新しい形で復活して来たのは著しい事である。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし無限の空虚の中にいかにしてある「中心」が存在し、かつ支持されうるかという論難は、ニウトン以前の当時の学者には答えられなかったであろうのみならず、現在においても実は決して徹底的には明瞭に答え難いものである。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
