          "standard": [
            {
              "text": "烏兎のようにあっという間に一年が経ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "人生で烏兎とは取り戻せぬものだと感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大学の烏兎の中で多くの友人ができた。",
              "citation": {
