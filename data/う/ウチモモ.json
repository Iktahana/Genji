        "examples": {
          "standard": [
            {
              "text": "長時間の乗馬で内ももが筋肉痛になり、歩くのが辛い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "美容のために、内ももの筋肉を引き締めるエクササイズを始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "転んだ時に内ももを強く打ち、大きなあざができてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "我は母様読みたまふ内ももどかしく、いかなる事をかとそぞろに心悩ませしに。",
              "citation": {
                "source": "葛のうら葉",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            }
          ]
        }
