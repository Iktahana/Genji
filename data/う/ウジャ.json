    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お前等二人が余り仲が好過ぎるとて人がかれこれ云うそうじゃ。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "知ってなきゃそんな無茶苦茶な事が云える筈がなかろうじゃないか。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "八釜しくて仕様がないや」「八釜しい奴あ、耳を塞いどけよ」「そうじゃねえんだ。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、早仕舞にしようじゃないか」　秋山と云う、ライナーのハンドルを握ってるのが、小林に云った。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう五尺は入っただろう」「そうさなあ、入ったかも知れねえな」「早仕舞にしようじゃないか」「いいなあ、ハムマーの連中にそう云おうかなあ」「だが、ダイの仕度は出来てるかい？",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻の先にブラ下った餌を食わないようじゃな。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちへ開いたら、俺は下の敷石へ突き落されちまうじゃないか。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらかじめ無事に収まる地震の分ってる奴等が、慌てて逃げ出す必要があって、生命が危険だと案じる俺達が、密閉されてる必要の、そのわけを聞こうじゃないか。",
              "citation": {
                "source": "牢獄の半日",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりゃあ、ハッパをかけて石が飛ばないようじゃ、かける必要はありませんがね。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "君だってそうじゃないか、機械の付属品たる君と、妻君のための君と、奴隷としての君と、君の主人としての君と、だれだって、労働者はこの二つの人格を持っていないものはないだろう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝馬はどんどん流れっちまうじゃないか、どうしたんだい」「船長！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が明けちまうじゃないか、しっかり押せ！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「買い手はあるつもりかい」「売り物だったら買い手もあろうじゃないか」　おやじは、もう三上と「まじめ」な話をすることは「やめた」と決めた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "よそうじゃないか、おれたちあ、船を桟橋まで着けないで下船しちゃおう、ばかばかしいや！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "君も二度まで沈没船に乗っていたというじゃないか、その時に、もし万一君が死んでいたら、どのくらい君の家族は嘆いただろう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれたちじゃとても太刀打ちができねえから、やっぱりストキに頼むんだね」「じゃあ、今夜要求条件をこしらえて、それに全部で連印して、それを船長に提出しようじゃないか」波田がいった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは、もし、コーターマスター全部が承知したら、コーターマスターの室でやろうじゃないか」と小倉が言った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でもあたり前のことです』とやるか」「そうじゃないよ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いるよ、海図室で、相談しようじゃないか」波田は、ストキに耳打ちをした。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だから、たとい四人でも五人でも、時機さえしっかりつかまえれば勝てると思うよ」「だから、その要求条件を、ここで作ろうじゃないか」西沢が言った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは、藤原君に草案が一任してあるから、それでもって作って行こうじゃないか」波田が言った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この世の中を、私が死ぬときは、私の生まれたときよりは少しなりともよくして逝こうじゃないか」と。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一生涯かかってもこの穴を掘ろうじゃないか」といって掘り始めた。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "惻隠の心は、どんな人にもあるというじゃありませんか。",
              "citation": {
                "source": "竹青",
                "author": "――新曲聊斎志異――",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬鹿なエッセイばかり書きやがって、この頃、君も、またあのイヒヒヒヒの先生も、あまり語学の勉強をしていないようじゃないか。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ええ、まあ、こんなものですが、でも、まあ、こんなものでしょうねえ、そうじゃないでしょうか、などと自分ながら何が何やらわけのわからぬ挨拶をしてしまうような始末である。",
              "citation": {
                "source": "作家の手帖",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三田君は、戸石君と二人きりになると、訥々たる口調で、戸石君の精神の弛緩を指摘し、も少し真剣にやろうじゃないか、と攻めるのだそうで、剣道三段の戸石君も大いに閉口して、私にその事を訴えた。",
              "citation": {
                "source": "散華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽の光が、まるで東京と違うじゃないの。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
