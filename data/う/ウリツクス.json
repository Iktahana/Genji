        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "そのセール品は一日で売り尽くされてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "特別販売品を売り尽くしたので本日営業を終了した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新作アルバムは発売初日に売り尽くした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「八犬伝」の最初の編が一度市場へ現われるや、萬本｜即座に売り尽くすという空前の売れ行きを現わした。",
              "citation": {
                "source": "戯作者",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "活版世に行なわれ、いくばくもなく売り尽くす。",
              "citation": {
                "source": "将来の日本",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビロードのルパシカ、巴里仕立てのタキシード、お召の襤袍、そんなところは無事でしたが、お仕舞には、フェルトの帽子、薄汚れたボヘミアンネクタイ、スリッパなどが出るという浅ましい有様、やがて、そんなものを売り尽すと、今度は一と抱えの女物を持ち出して、片っ端から叩き始めました。",
              "citation": {
                "source": "新奇談クラブ",
                "author": "第二夜　匂う踊り子",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通は一本を二つに折って、それを一銭に売るのだから、売りつくすと二円になる。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその日は全部売りつくすまで廻りましたが、自分で食べた分もあるので、売上げは九十七銭でした。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＴＫ―80は、担当者もまったく予想しなかった七万台を売りつくすことになります。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
