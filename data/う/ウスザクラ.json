        "examples": {
          "standard": [
            {
              "text": "着物の地色は薄桜で、春の柔らかな陽光の中でいっそう映えて見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女が選んだノートの表紙は薄桜で、机の上に置くだけで部屋が華やいだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "和室の壁が薄桜に塗られており、朝の光を受けると温かみを帯びた色合いになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
