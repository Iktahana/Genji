        "examples": {
          "standard": [
            {
              "text": "炊飯器の内釜を洗うときは、コーティングを傷つけないように柔らかいスポンジを使う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "最新の内釜は熱伝導率が高く、お米の芯までふっくらと炊き上げることができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "内釜にメモリが付いているので、誰でも簡単においしい水加減を計れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "歩いているうちがまだしも心が休まるような気がする。",
              "citation": {
                "source": "日没の幻影",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふり返るとバルブレンのおっかあのうちがまだ見えたが、それはだんだんに小さく小さくなっていった。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "うちがまずそうきめて、早くに伝えてあげたら、高木さんもご安心でしょう」「そのとおりだ」　そう言った父親はヨシオに顔を向けた。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
