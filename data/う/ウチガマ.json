        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古い日本家屋には、薪で沸かすタイプの内釜がまだ残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "内釜の調子が悪く、お風呂を沸かすのにいつもより時間がかかってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬の寒い夜、内釜で沸かした熱いお湯に浸かるのが何よりの楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
