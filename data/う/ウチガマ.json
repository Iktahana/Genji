        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "炊飯器の内釜を洗うときは、コーティングを傷つけないように柔らかいスポンジを使う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "最新の内釜は熱伝導率が高く、お米の芯までふっくらと炊き上げることができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "内釜にメモリが付いているので、誰でも簡単においしい水加減を計れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "歩いているうちがまだしも心が休まるような気がする。",
              "citation": {
                "source": "日没の幻影",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふり返るとバルブレンのおっかあのうちがまだ見えたが、それはだんだんに小さく小さくなっていった。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "うちがまずそうきめて、早くに伝えてあげたら、高木さんもご安心でしょう」「そのとおりだ」　そう言った父親はヨシオに顔を向けた。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "七十　翌朝お庄が目を覚ました時分は、屋内がまだひっそりしていたが、立て廻した屏風の外の日影は闌けていた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "足腰のしゃんと立ったのは言うまでもないこと、声までがしいんと骨身にしみ透るように冴え渡って、手の内がまた免許皆伝以上、しかも流儀は短槍にその秘手ありと人に知られた青江信濃守のその青江流なのです。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "不良少女が行くのをうしろから見ると、所謂「内がま」とも「外がま」とも付かぬ。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "家内がまた、えらく憤れるからなあ、まったく。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "家内がまだ生きているんです」「家内って――あなたのお内儀さんが？",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "たった一人の東洋人を捕らえかねて、島内がまるで蜂の巣をつついたように騒ぎまわっているとは、一たい何たるざまだ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "家内がまた、感心な……善良な女で、私にいくらでも飲ませる。",
              "citation": {
                "source": "自由人",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころ、補祭の家内がまいりましてね。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日で約束した三日の期限が切れるのに、幸内がまだ帰って来てくれないことをお銀様は心配していました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "伯耆の安綱の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "生活の不安は、国民一人一人の心がしつかりと結びつけられてゐないところから来るのでありまして、日本のやうな国では、戦さがいくら続いても、例へば欧洲諸国のやうに、国内がまつたく饑饉状態に陥るなどゝいふことはあり得ないのであります。",
              "citation": {
                "source": "生活の黎明",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が明けるとヤジ馬が店の前に雲集したが、被害者が百人だから店内がまた立入りの余地もない。",
              "citation": {
                "source": "桐生通信",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "根ぼり葉ぼり訊いてましたが、相手がメクラのことですから、仁助の知りたいところに限って弁内がまったく不案内というワケなんです」「たとえば、どんなところが……」「たとえば、オカネは燈りをつけてねていたか。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "本郷の弥生ヶ丘や芝山内がまだ海岸だった頃のことだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
