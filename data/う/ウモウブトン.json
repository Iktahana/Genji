        "examples": {
          "standard": [
            {
              "text": "冬は高級な羽毛布団を使うと、とても暖かく眠れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "羽毛布団は値段が高いが、十年以上持つことがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "羽毛布団のクリーニングに出すと、想像以上に費用がかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ルシンダの　まくらから　うもうを　はんぶん　ぬきだしたところで、　ああ　これは　ほしかった　うもうぶとんに　できると　おもいなおします。",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            },
            {
              "text": "人は生活を赤裸々にして羽毛蒲団の暖さと敷布の真白きが中に疲れたる肉を活気付けまた安息させねばならぬ。",
              "citation": {
                "source": "夏の町",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　台所から茶の間に入り座敷の襖の引きちがひになつた其隙間から内を覗くと、未亡人常子は仰向きになつて、顔の上に開いた小説本を載せ、羽毛蒲団を下の方に、浴衣を重ねた襟付お召の寝間着の胸に片手を置き、青竹色の伊達締の端の解けたのも其まゝ、片手を敷布の上に投出して、すや／＼眠つてゐる。",
              "citation": {
                "source": "来訪者",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と白井は促すやうに膝を進めて羽毛蒲団の端をつかむ。",
              "citation": {
                "source": "来訪者",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
