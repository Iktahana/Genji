          "literary": [
            {
              "text": "全体が七五調の歌謡体になっているので暗記しやすかった。",
              "citation": {
                "source": "読書の今昔",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの小唄は私の爾後の歌謡体の機縁を開いた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「花火」「水盤」「心中」「放埒」「紫陽花」等第七、新俗謡体の小唄。",
              "citation": {
                "source": "雪と花火余言",
                "author": "東京景物詩改題に就て",
                "note": "青空文庫"
              }
            },
            {
              "text": "「片恋」「かるい背広」「春の鳥」等第八、新俗謡体より出でたる印象風の景物詩。",
              "citation": {
                "source": "雪と花火余言",
                "author": "東京景物詩改題に就て",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二は『桐の花とカステラ』式の詩と同型の桐の花の歌、第三は本集の新俗謡体の詩と『思ひ出』の殆ど全部等である。",
              "citation": {
                "source": "雪と花火余言",
                "author": "東京景物詩改題に就て",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時代（自四十四年二月到四十四年十月）に愈私の俗謡体は発達して行つた、『薄あかり』『夜ふる雪』『柳の左和利』等がそれである。",
              "citation": {
                "source": "雪と花火余言",
                "author": "東京景物詩改題に就て",
                "note": "青空文庫"
              }
            },
            {
              "text": "何れも民謠體のものです。",
              "citation": {
                "source": "詩集の後に",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
