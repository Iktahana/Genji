    "definitions": [
      {
        "index": 1,
        "gloss": "cormorant fisherman",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長良川では毎年夏、鵜匠が手縄で十二羽の鵜を操りながら暗い川面を進む鵜飼いが披露される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "鵜匠は幼いころから鵜と共に生活し、その信頼関係を築くまでに何年もの時間をかけるという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "観覧船の上から眺めていると、鵜匠の手際よい縄さばきに合わせて鵜が次々と魚をくわえ上げてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "鵜匠鵜匠の宗家長良川の山下幹司君に篝火の朱にはゆる君こそは鵜匠なれ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "角顔の体のがっしりした男が舳の鵜匠になり、痩せぎすな男が中の鵜匠になり、背の高い眼の鋭い男が※工となり、背のずんぐりした白髪の眼立っていた男が舟乗りとなって艪を漕いでいた。",
              "citation": {
                "source": "赤い土の壺",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の鵜匠にあやつられている鵜は、水の中に潜っては浮きあがり、浮きあがっては潜って魚を獲った。",
              "citation": {
                "source": "赤い土の壺",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、鵜が四五｜尾の魚を喉に入れたと思う比を見はからって、鵜匠は手縄を曳いて舟に曳き寄せ、ぐいとその喉を絞って魚を執るのであった。",
              "citation": {
                "source": "赤い土の壺",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうじゃ、そうじゃ、無益な殺生はやめよう、やめて早う一杯やろう」　舳の鵜匠はちょとふり返って中の鵜匠の顔を見て、「そうじゃなあ、これ位ありゃ、肴は十分ある」　と云った。",
              "citation": {
                "source": "赤い土の壺",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中の鵜匠はすぐ応じた。",
              "citation": {
                "source": "赤い土の壺",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やめてもよかろう、やめて別院の下の涼しいところへ往って、一杯やるとしょうか」　舳の鵜匠はまた云った。",
              "citation": {
                "source": "赤い土の壺",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よかろう、別院の下なら涼しかろう」　二人の鵜匠は手縄を曳いて鵜を舟にあげた。",
              "citation": {
                "source": "赤い土の壺",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ本に鵜飼の画がある、それは舟に乗つた一人の鵜匠が左の手に二本の鵜縄を持つて右の手に松火を振り上げて居る。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は翌日鵜匠から鵜をあやつった綱を貰ったが、火にもやけぬこの綱は、逆に捻じればぽろりと切れた。",
              "citation": {
                "source": "鵜飼",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "将来は生きのいいところを、鵜匠がその場で見物客に食わす考えを持つべきである。",
              "citation": {
                "source": "鮎の名所",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "手にすゑて浅瀬をのぼる鵜匠かな　　　　一之　読んで字の如くである。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "一羽の鵜を手に据えて、浅瀬をざぶざぶ上って行く鵜匠の姿を描いたので、現在鵜を使っているわけではない、準備的状況のように思われる。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "鵜匠の振立てる松明の火の粉が岸の柳に散りかかる、という意味らしく思われる。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "鵜飼を詠んだ句の多くは、鵜もしくは鵜匠に集注する。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "この句は鵜匠の働きを描いて、多少変った方角から見たところに特色がある。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　細谷川の道を、里へ出て行く鵜匠があった。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鵜匠の男は、さっきから頼朝の後を怪しみながら尾けていたが、とうとう言葉をかけた。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「青墓に知辺でもあるのかね」「うむ」「何というお方か」「行けば分るけど」「そうか」　鵜匠は口をつぐんだ。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたは誰か、源氏のお子だろう」　鵜匠は、突然云い出して、頼朝の帯びている刀を、自分の携えている山芋の苞へ入れ代えてくれた。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はただ漠として、身の運命を、鵜匠の男に託していた。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿の長者｜大炊の家へ行くのだと初めて明かすと、鵜匠は非常に驚いて、「さてこそ、あなた様は」　と頼朝の面をしげしげ見直し、苞入りの刀を彼の手へもどすと、名も告げずに立去ってしまった。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまで、鵜匠の肚を、疑いぶかく警戒していた頼朝は、非常にすまない顔して、「……あ。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鵜匠の鵜舟は繋ぎ捨てられたまま今は顧みられもせぬ。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お放しなすって、え、どうしょうねえ」　とおぼえず、声を放ちたり。",
              "citation": {
                "source": "夜行巡査",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、蟹は、「とこやというしょうばいは、たいへんひまなものだな。",
              "citation": {
                "source": "蟹のしょうばい",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一とうしょう、白金メタル。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「第二とうしょう、きんいろメタル。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「第三とうしょう、水銀メタル。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「第｜四とうしょう、ニッケルメタル。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
