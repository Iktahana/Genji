        "examples": {
          "standard": [
            {
              "text": "宿題を半分くらい打っ遣らかして、彼は勝手に遊びに出かけてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "部屋の掃除を打っ遣らかしたまま、慌てて駅まで走り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "大事なプレゼンの準備を打っ遣らかすなんて、君の責任感を疑うよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "まあ、こういうわけで、結局、諦めてうっちゃらかすより仕方がない。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
