          "literary": [
            {
              "text": "これはもとウリオンと書いたのをいまではオリオンとなっていることを言ったものだと話したことがある。",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブロウニュの森からサンゼリゼまでは、自動車に乗る間もないほど近かったカフェー・トウリオンフは凱旋門から下って来た左手にある、大きなカフェーの一つである。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "カフェー・トウリオンフのテラスには、数百の真紅な籐椅子がいつも道路に向って並んでいた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢代たちもトウリオンフを出てサンゼリゼを下へ下った。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
