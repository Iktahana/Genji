        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "やっとサンゴを取り除き、財宝の輝きを見た時、うぉっと座り込むしかなかった。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "これをお返しいたします」　億万長者がベナを見て、うぉっと叫んだ。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも心細いので、兄さんから借りているストップ・ウォッチと、僕の腕時計と二つ忘れずに持って出た。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウォッカの酔いがまわると、マリがアレキサンドラの娘をとらえて饒舌りだした。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥の大きさが仮定できれば単に仰角と鳥の身長の視角を測るだけで高さがわかるし、ストップ・ウォッチ一つあればだいたいのテンポはわかる。",
              "citation": {
                "source": "疑問と空想",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "★ＩＢＭに関する著作は大変に豊富であり、いわゆるウォッチャーなどという興味深い人種も（かつては？",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九九〇年一月号から一九九二年三月号にかけて、同社の『パソコン・マガジン』に「インサイドウォッチャー」と題して連載していたコラムを、まとめたものだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "編集部が用意した「インサイドウォッチャー」という連載タイトルには、人にまつわる企業の内幕話を書いて欲しいというライターへの期待が現れている。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後の私の道筋に、大きな影響を与えた病気と向き合わされたのは、「インサイドウォッチャー」の連載中だった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "本書はソフトバンク刊の『パソコン・マガジン』に「インサイドウォッチャー」と題して連載した時評コラムを、まとめ直したものだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まだ、日の出にはすこし時間がある」　ダイヴァーズ・ウォッチを見ながら、高志がいった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "山崎が、目のまえにもちあげたストップウォッチを押しながら、ひでえタイトル、とつぶやいた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひょっとしたら、顔を剃った後で鬚につけて拭くウォッカを、どうかして水と間違えて飲んだのかもしれないぞ。",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに何ですよ、この鼻は壜へ入れてアルコール漬にしておくか、もっと手をかければ、それに強いウォッカと沸かした酢を大匙に二杯注ぎこんでおくのです――そうすれば、相当うまい金儲けができますよ。",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで私は、大丸と、雑誌屋と、荒木と、丹平と、それだけ以外で決して買物をした事はないが、又実際、心斎橋で白狐の襟巻も、気の利いたウォッチリングも、マイ・ミキスチュアも、無いのだから仕方がない。",
              "citation": {
                "source": "大阪を歩く",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の多くはロンドン・ニュースやグラフフ※ック、パックやウォッヘの切抜で下らぬものばかりである。",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の多くはロンドン・ニュースやグラフフヰ※ック、パックやウォッヘの切抜で下らぬものばかりである。",
              "citation": {
                "source": "灰燼十万巻",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあやあそこに渡らせられるは……」　と、わたくしがものをいいかけるうちにも、かの特使閣下はわたくしの姿を認め、手に持っていたステッキもウォッカの壜も、鋪道の上に華々しく放り出して、ものも得いわず、いきなりわたくしの小さい身体に抱きついたものである。",
              "citation": {
                "source": "地軸作戦",
                "author": "――金博士シリーズ・９――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウォッと、怒濤のような地響きが起った。",
              "citation": {
                "source": "反逆",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんとなく、あの毛布の下に、ウォッカの罎でも隠してありそうな気がした。",
              "citation": {
                "source": "水の三日",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピストルとストップ・ウォッチ。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三分と十秒ほどだ」と久野はストップ・ウォッチを見ながら言った。",
              "citation": {
                "source": "競漕",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "久野は片手にストップ・ウォッチを持ち、片手に望遠鏡を押えて息を殺した。",
              "citation": {
                "source": "競漕",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は急いでストップ・ウォッチの釦を押した。",
              "citation": {
                "source": "競漕",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "書物の側にはいつもウォッカの壜を置いて、塩漬の胡瓜や、林檎が、デスクの羅紗の布の上に置いてある。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "半時間毎位に彼は書物から眼を離さずに、ウォッカを一｜杯注いでは呑乾し、そうして矢張見ずに胡瓜を手探で食い欠ぐ。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "狼がついに部屋に到着したらしく、ウォッという荒い叫びが部屋いっぱいにとどろいた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "雷象がアッと気を失いかけると、「ウォ、ウォッ」ととびかかる狼の声。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "世話役がストップウォッチを見ながら、ヘッと突んぬけるような奇声をあげると、六さんと由さんは同時にリンクにおりて、向きあう位置に鶏を据えた。",
              "citation": {
                "source": "春の山",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "四人のうちには智謀のヘンリイ・ウォットンや、皮肉屋のヘンリイ・カッフがいた。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
