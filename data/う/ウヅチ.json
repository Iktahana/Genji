        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "若君様へこちらから卯槌を差し上げられます。",
              "citation": {
                "source": "源氏物語",
                "author": "浮舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "卯槌が美しい細工で作られてあるのは、閑暇の多い人の仕事と見えた。",
              "citation": {
                "source": "源氏物語",
                "author": "浮舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月に使用するうづゑ（卯杖）・うづち（卯槌）などゝ言ふものがある。",
              "citation": {
                "source": "花の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、私は、卯杖・卯槌は、地べたのものを追ひ払ふ為に、たゝくものだと考へて居る。",
              "citation": {
                "source": "花の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "卯杖・卯槌を空木で作り、そして、空木は鬼やらひに用ゐる木なのである。",
              "citation": {
                "source": "花の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　地を打つ行事――卯杖・卯槌正月に関係のあるもので、卯杖・卯槌など言ふものがありますが、此は、元は地面を叩く道具だつたと思ひます。",
              "citation": {
                "source": "山の霜月舞",
                "author": "――花祭り解説――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
