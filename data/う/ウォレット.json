        "examples": {
          "standard": [
            {
              "text": "誕生日プレゼントに、使い込むほど味が出る本革のウォレットをもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "カバンの中をいくら探してもウォレットが見当たらず、顔が真っ青になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "最近はカードの収納枚数が多い、長財布タイプのウォレットが人気らしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
