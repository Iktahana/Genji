        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "スマホのウォレットにクレジットカードを登録しておけば、財布を持ち歩く必要がない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "改札を通るとき、スマートウォッチのウォレットをかざすだけで決済が完了した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ポイントカードもすべてウォレットアプリに集約して、持ち物を最小限にしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
