          "literary": [
            {
              "text": "◎ウインナの tip の割は三人で頭七、給仕五、ビールはこび二の割。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "◎ウインナは社会政策が世界一だという。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことによると、また戦争が始まつて、ウインナまで伊太利に取られてしまふぞ。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイス・ウインナだ。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタージュ、ウインナ・シュニツェル、ロール。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "渋谷ウインナベーカリー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「凸凹」のウインナの景、「カティンカ」のギャグが、昨日見た「花詩集」にもあったので一寸驚いた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月三十日（金曜）　二時近くから「芝居の世の中」の稽古、ヘンな背景が出来て来ちまって、キャバレエ・ウインナの感じまるで出ず、（「会議は踊る」のビアガーデンの図を描いてやったのに）衣裳もてんで成ってないので少からずくさった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
