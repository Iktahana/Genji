[
  {
    "uuid": "36e728b3-d332-59eb-9292-7cf1251dcbf6",
    "entry": "上値",
    "reading": {
      "primary": "うわね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
