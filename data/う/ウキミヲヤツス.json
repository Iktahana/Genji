        "examples": {
          "standard": [
            {
              "text": "彼は寝食を惜しんで、締め切り間際の新作の執筆に憂き身をやつしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "骨董品の収集に憂き身をやつすあまり、ついには先祖代々の家財を使い果たしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は長年アイドルの追っかけに憂き身をやつし、全国各地のライブ会場を回っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "だから、容色を整へる為に憂き身をやつすのはどうも面白くない。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを言葉どほり受け取つたわけではないが、彼女は、それ以来、自分自身の化粧に憂き身をやつすやうになつた。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
