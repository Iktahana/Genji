    "definitions": [
      {
        "index": 1,
        "gloss": "to glance at",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は時計を打ち見て、会議の開始まであと五分しかないと気づいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "通りすがりにショーウィンドウを打ち見ると、懐かしい玩具があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は自分の服装を鏡で打ち見て、満足げに微笑んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "打ち見る所は保と同年位であった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ち見るところ、その方も、眼の配り方胆の据え方、心得ある者と思ったればこそ、今までは言葉を厚うして味方に引き入れんとは企てたれ、今の雑言を聞くからは、もはや一寸も動かぬぞよ！",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ち見るところ、少なからず彼が気に入ったらしい。",
              "citation": {
                "source": "大ヴォローヂャと小ヴォローヂャ",
                "author": "ВОЛОДЯ　БОЛЬШОЙ　И　ВОЛОДЯ　МАЛЕНЬКИЙ",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ち見るところ、何もかも私の目論見どおり希望どおりに運んでいるらしい。",
              "citation": {
                "source": "妻",
                "author": "ЖЕНА",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ち見るところお年齢はやっと二十四五、小柄で細面の、大そう美しい御縹緻でございますが、どちらかといえば少し沈んだ方で、きりりとやや釣り気味の眼元には、すぐれた御気性がよく伺われました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、打ち見るところ、御辺もあまり偉丈夫とは見えんな。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "打見るさえいと懐しく、退りて二階なる窓の戸に向いて、「姉さん、唯今帰りました。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "御仏に仕ふる此寺のものゝ、灯燭を続ぎまゐらせんとて来つるにやと打見るに、御堂の外は月の光り白と上り来りぬ。",
              "citation": {
                "source": "二日物語",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「われも片隅なる一榻に腰掛けて、賑はしきさま打見るほどに、門の戸あけて入りしは、きたなげなる十五ばかりの伊太利栗うりにて、焼栗盛りたる紙筒を、堆く積みし箱かいこみ、『マロオニイ、セニョレ。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "打見るところは、僅に四十歳を踰えたかとおもはれる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この「バルコン」めきたるところの窓、打見るほどに開きて、少女のかしら三つ四つ、をり畳なりてこなたを覗きしが、白き馬に騎りたりし人はあらざりき。",
              "citation": {
                "source": "文づかひ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "打見るところ、何か、出張の目的あって、自分よりも以前にこの家に逗留しつつ、その所用を果しつつあるのだな。",
              "citation": {
                "source": "大菩薩峠",
                "author": "勿来の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "打見るところ――ではない、打聞くところです、その聞くところの音声によって判断、ではない、想像であります、その想像によると、竹林に近く一つの堂があって、その堂守として尼さんがいる、堂のわきには塚があって、石の塔が立っている、その前へ竜之助が近づいたことから、堂守がかく呼びかけたものであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "打見る所、年齢は二十歳余り、顔は丸顔の方で、緻致はさしてよいとも言われませぬが、何所となく品位が備わり、雪なす富士額にくっきりと黛が描かれて居ります。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "病中ゆえ、かえって失礼と存じたまでのこと」「それがしは、遠い辺土の国境にあって、西蕃の守りに任じ、天子に朝拝する折もめったになく、国舅とも稀にしかお目にかかれんで、押してご面会をねがったわけだが――こう打見るところ、さしてご病中のようにも見られぬ。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
