    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to confide",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は親友に、長い間誰にも言えなかった秘密をとうとう打ち明けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「ずっと悩んでいたことがあるんだ」と彼女は静かに打ち明けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "医師に症状を打ち明けると、思ったより深刻な状態だと告げられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それをお前にかうして打ち明ける、お前の心を亂だす、お前の胸を苦しめる。",
              "citation": {
                "source": "疑惑",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然はやはりその恋人にのみ真心を打ち明けるものである。",
              "citation": {
                "source": "科学者とあたま",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸の小咄にある、あの、「誰でもよい」と乳母に打ち明ける恋いわずらいの令嬢も、この数個のほうの部類にいれて差し支えなかろう。",
              "citation": {
                "source": "チャンス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、やはり腹黒く、自分の罪をその友人にも女中さんにも、打ち明けることはしなかった。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そういうことなら、なぜ娘さんにその気持ちの径路を早く行って聞かさないで、こんな処で私一人に今更打ち明けるのですか」「ははあ。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はそれを打ち明ける辛さを敢てするまで、老師への哀訴の情が、切迫してしまつたのである。",
              "citation": {
                "source": "老主の一時期",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はたかい自矜の心を持つてゐたから、私の思ひを相手に打ち明けるなど考へもつかぬことであつた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、あの人たちに、僕のくるしい秘密を打ち明ける事が、どうしても出来ず、夜も眠られぬ程ひとりで悶えていました。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことにも、ゆうべ、あんな噂を耳にしたので、なおさら打ち明けるのが苦痛になった。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女に恋を打ち明けるなど、男子の恥だ。",
              "citation": {
                "source": "困惑の弁",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ自分が帰って行って、「たからくじ」の秘密をはじめて打ち明ける。",
              "citation": {
                "source": "家庭の幸福",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おきみ婆さんに打ち明けると、泣いて賛成してくれました。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな時、道端の百姓家へ泣きこんで事情を打ち明けると、食事を恵んでくれる親切なお内儀さんもありました。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "……というのは、この眼の前の青年……本名は何というのか、まだわかりませんが……リヤトニコフと名乗る青年が、この際ナゼこんなものを私に見せて、これ程の重大な秘密を打ち明ける気になったかという理由がサッパリわからない事です。",
              "citation": {
                "source": "死後の恋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで『すべて吾輩に打ち明けるのが一番よいかと。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "ようやく今日になってプレンダギャスト少佐に悩みを打ち明けると、先生の元にと勧められて。",
              "citation": {
                "source": "橙の種五粒",
                "author": "THE FIVE ORANGE PIPS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、ボイジャージャパンの設立を決めてその他班の仲間に打ち明けると、彼らも土俵から飛び出す機会を待っていたと言います。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりとて嫁入り早々に、姑や夫にそれを打ち明けることも出来ない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大阪屋花鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人にむかって真逆にそんなことを打ち明けるわけにも行かないので、彼女は朋輩のお米にそっと話すと、お米は又それを店の者どもに洩らした。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "小栗の屋敷の用人から頼まれて来たことを打ち明けると、寺でも疎略には扱わなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "薄雲の碁盤",
                "note": "青空文庫"
              }
            },
            {
              "text": "くどくも云うようだが、訳さえわかれば決して御迷惑はかけませんから」　武士はそれでもまだ渋っていたが、半七からいろいろに説きすかされて、彼もようよう納得したらしく、内に引っ返して一方の武士と何かしばらくささやき合っていたが、結局思い切ってその事情を打ち明けることになった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "あま酒売",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、これから彼等がどんな秘密を打ち明けるかと、両方の耳を引き立てていると、あたかもそこへ足早に駈け込んで来た者があった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "あま酒売",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそのままにはしておかれないので、あくる日すぐに下屋敷へ行って、紋作の叔母さんに内証でそのことを打ち明けると、叔母さんも驚いたがどうもしようがない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "人形使い",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれを喜兵衛に打ち明けるわけにも行かないので、忌々ながら万吉のおもちゃになっているうちに、わたくし共がだんだんに手を入れ始めて、女中のお千代が魚虎へ引っ張られて行ったので、おとわもこれはあぶないと感付いたんでしょう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉間尺は正直に自分の身の上を打ち明けると、男は言った。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "路を東にとって石門にむかうと、婦女数十人、いずれも鮮麗の衣服を着て歌いたわむれていたが、は事情をつまびらかに打ち明けると、女たちは顔をみあわせて嘆息した。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "白猿伝・其他",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀麿と父との対話が、ヨオロッパから帰って、もう一年にもなるのに、とかく対陣している両軍が、双方から斥候を出して、その斥候が敵の影を認める度に、遠方から射撃して還るように、はかばかしい衝突もせぬ代りに、平和に打ち明けることもなくているのは、こう云うわけである。",
              "citation": {
                "source": "かのように",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、五、六年もそれを続けて、それからはじめて女に打ち明ける。",
              "citation": {
                "source": "作家の手帖",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "接吻とか、抱擁とか、恋愛を打ち明ける場面とかゞ、空々しく書かれてゐても厭に刺戟的だつた。",
              "citation": {
                "source": "好色夢",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、親しい友人に、それを、うちあける。",
              "citation": {
                "source": "白紙",
                "author": "立原道造",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
