          "literary": [
            {
              "text": "「あたしのウィリイは……」「何だと？",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……」「あいつは好くはならんぞ」「神様、あの子、ウィリイを守り給え」　囁く彼女の膝の上では、靴下の穴が大きくひろがっていた。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウィリイは微笑んだ。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてあのコンポジションのうちに、ひょっこりと思いついたあの気の毒なウィリイこそ彼自身に外ならないではなかろうか。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしウィリイは泣き笑いの生活で満足しているらしい。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
