  {
    "uuid": "01eccaca-8e41-56e8-9b92-93b150c7e8c2",
    "entry": "槽",
    "reading": {
      "primary": "うけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
