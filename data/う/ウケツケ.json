        "examples": {
          "standard": [
            {
              "text": "申請書類の受付は窓口で行われ、不備があれば即日差し戻された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "オンライン申込みの受付が完了すると、登録メールアドレスに確認メールが届く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "書類の受付を終えた係員は、整理番号の書かれた紙を手渡してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
