      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "dead of the night",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "丑三つに鳴き声が聞こえたと隣の老婆が言い張るが、誰も信じなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "火事の通報が入ったのは丑三つで、消防士たちは眠い目をこすりながら出動した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "丑三つに廊下を歩く音がして目が覚め、恐る恐るドアを開けると飼い猫が座っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "平気で読経し居ると、丑三つ頃、表の戸を敲きデンデンコロリ様はお内にかという者あり。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、此頃毎夜丑三つの刻限に、東の山の上へ怪しい星が現はれて、其の星の下に弘法大師のお姿があり／＼拜まれるといふことを言ひ觸らすものがあつた。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の夜の丑三つに、大膽な文吾は、東の山へ現はるゝといふ大きな星と弘法大師のお姿とを拜むのぢやと、母に告げて、壞れかけてガタ／＼してゐる雨戸の外へ出たが、其のまゝ跣足に夜露を踏んで、飛ぶが如く光明寺へ駈け付けると、うま／＼和尚さんの居間に忍び入つた。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさか丑三つの深夜に、大膽な文吾が寺へ忍び込んだとは、流石の和尚さんも思つてゐないやうである。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る夜おそく、もう二時……丑三つに近い頃、ふらりと酔歩をはこんでくると、祈祷所の中から、何やら呟く声が聞える。",
              "citation": {
                "source": "オランウータン",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに、真夜中、丑三つの頃というのであろうか、顔色を変え息をつめて、がばとはね起きた。",
              "citation": {
                "source": "怪異に嫌わる",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔無題〕都の中の神田にも、丑三つ時のあることを、病みて知れるにあらねども、声の無きこそ哀れなれ。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは毎夜更けて丑三つごろになると、ボストンの市街の暗い空に、ほの白いこわげな姿をして、奇妙なものが無数に飛び回り、うようよと動き、日中でも雨のじめつくうっとうしい日などは、必ず怪しげな無数の変化がありありと虚空に動くのが見える。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、一時、二時、むかしのことばでいえば、丑三つ時です。",
              "citation": {
                "source": "少年探偵団",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうも朝からじとじとと、こやみもなく時雨がしょぼふって、病床にふしていた老母がふとトロトロと、まどろみにおちたのは、もはや夜も子の刻どき、あるいは草木も眠るうしみつごろであったかもしれません。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな事を言つたのは恰も箱根の山中で、丁ど丑三と言ふ時刻であつた。",
              "citation": {
                "source": "雨ふり",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天地万象、シーンとした丑三ツの時、此所に出て来た物は何だと思ふ。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ステツキの酒に一同元氣づきしが、草木も眠る丑三の空、眠くはなる、脚は疲れる、休息すること數多くなりぬ。",
              "citation": {
                "source": "粕壁夜行記",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "郁太郎の苦しむことさえなくば、室の中も戸の外も、静まり切った丑三時で、しんしんと更けてゆきます。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴鹿山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵馬は橋の上へ来てから、大事なものを踏むように、わざとゆっくりゆっくり歩いています……朧月夜もふけて丑三過ぎで、無論、人の通ることは宵から数えるほどしかなかったのですから、この深夜には誰憚るものもない、千金にも替え難き都の春の夜を一人占めにして歩いているようなものです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "壬生と島原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は草木も眠る丑三時、竜神八所に立籠めた水蒸気はうすものの精が迷うているようであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "竜神の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　それから、丑三の頃、大胆至極にも、江戸城の一の御門の塀を乗越して潜入した、一つの黒い影があります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、もう二時だ、丑三時だ、寝なければならぬと気がついた時、ふと思い出したのは、酔いどれのマドロス氏のこと。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お雪ちゃんが、もう正体もなく眠りに落ちたと見た時分――それはどちらからいっても丑三頃でしょう、竜之助が静かに起き上りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "勿来の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は、たしかに丑三時、麓の若い人から頼まれた発句の点をして、今まで夜更かしをしていたが、ようやくそれを終ったから瓶子を洗って、また一陶の酒を汲もうとしている時に、この人影でしたから、老人が沈吟をはじめたのも無理はありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "光緒己丑三月英倫役満東帰由法国之馬賽口登舟遇日本井上甫水兄亦自欧洲東帰者倚篷筆談不倦頗慰客懐甫水兄於書無敢不読既通泰西文字又通朱陸之学洵東方之博雅也将別矣率成一律以贈其帰時五月十八日舟過安南海書此。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "（光緒己丑三月、英倫の務めを終えて東へ帰る、法国の馬賽口より船に乗る、日本井上甫水兄に遇う。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二十二　嘉永六年｜癸丑三月三日に横山湖山、鷲津毅堂の二人が羽倉簡堂に招かれて、その邸に催された蘭亭｜修禊の詩筵に赴いた。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "では君は二重歩行者［〔Doppelga:nger〕 とは草木も眠る丑三の頃になるとねてゐる體から別な體が拔け出して勝手な眞似をして廻るといふ迷信、同時によく似た人がゐると一方を他の 〔Doppelga:nger〕 だ；或は alter ego（anders Ich）だ等といふ］に違ひない。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをば、無慙にも鉄板の上に乗せて焼いているのは、何か丑三詣りに似た呪いの所業でも行なっているような気がし出したのだ。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "third quarter of the ox's hour (around 2-2:30am or 3-3:30am)",
