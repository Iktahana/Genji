        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "時代小説の中で盗人は丑三つを狙って忍び込み、眠り薬で番犬をおとなしくさせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "江戸の夜、丑三つを告げる辻番の声が静まり返った町に響いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "丑三つは深夜二時から二時半ごろに当たり、夜警の交代が最も眠い時間帯でもあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
