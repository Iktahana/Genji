[
  {
    "uuid": "841bcc5f-fea1-5aac-9669-38e69b91ad31",
    "entry": "丑三つ",
    "reading": {
      "primary": "うしみつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
