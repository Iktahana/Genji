        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "陣痛が始まってから数時間後、ようやく元気な産声を上げました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "無事に産声を上げた我が子を腕に抱き、母になった実感が湧いてきました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "予定日を過ぎていたけれど、昨日ようやく力強い産声を上げたそうです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "竹松たちがソフトウエアによって命を吹き込めば、パーソナル・ダイナミック・メディアは、今、ここで産声を上げるのだ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
