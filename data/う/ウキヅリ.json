        "examples": {
          "standard": [
            {
              "text": "川べりでウキ釣りをする老人を見かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ウキ釣りで鯉を狙う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子どもの頃、祖父と一緒にウキ釣りに行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "川では流しのウキ釣り、潮入りの池ならネリといつて米糠の団子で釣る。",
              "citation": {
                "source": "夏と魚",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "流れのある川の杭がらみ、石垣のくずれ、細の枯れ葦の間、沼、池、用水、深いところ、中層釣り、流速釣り、見釣り、誘い釣り、ウキ釣り、脈釣りと千変万化。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは脈釣りで、寒さにタナゴがひとつところに集まったときとか、競争釣りなどに使う手だが、一人で場所を広く釣り、タナゴと遊ぶにはウキ釣りも、また楽しいものだ。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "二間半、三間という長竿のウキ釣り。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな吸い込みウキを入れて、そのわきにイトメを二、三本つけた食わせウキ釣り。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊豆伊東の松川では、アジの身を噛んで吹いて、それを餌にウキ釣りをする。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
