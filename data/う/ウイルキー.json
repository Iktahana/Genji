        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イギリスの作家ではわからずなりにヂツケンス、サツカレー、下つてウイルキー、コリンスなどいふ人のものを読み、それから段々近代の作品に移つて行つた。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "サツカレーの『虚栄市』『ニウカムス』ヂツケンスの『ヒツクウイク』『二市物語』などを読んだり、ウイルキー・コリンスの『白衣婦人』『イビル、ジニアス』を読んだりした。",
              "citation": {
                "source": "紅葉山人訪問記",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウイルキー「陽はすべての人のために沈む」。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "最終的にウイルキー・コリンズの小説を元にしたのを選んだ。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
