        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "馬の背中に「上敷き」を置いてから鞍を乗せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "乗馬クラブでは、馬に合ったサイズの「上敷き」を選ぶ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この「上敷き」はクッション性が高く、馬への負担を軽減する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
