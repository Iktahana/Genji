        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ウヒャーッ」　と、身もだえするような笑いを、お睦は上げて、飯場の蒲茣蓙の上を、転げ廻った。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁が厚い洋館の二階から発射される弾丸が、ヒウヒウと、街路の上をとび交うた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕あなたのためなら、次の十時の汽車が来る時｜腕を下げないで、じっとがんばり通してでも見せますよ」わずかばかりヒュウヒュウ言っていた風が、この時ぴたりとやみました。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "★パーソナルコンピューターのソフトウエア産業が勃興してくる過程は、『パソコン革命の英雄たち』（ポール・フライバーガー／マイケル・スワイン著、大田一雄訳、マグロウヒルブック、一九八五年）に詳しい。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ショウヒン………ふふっ、あの横。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛んだかと見るまにヒュウヒュウと藩士の身辺におそいかかりました。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒュウヒュウ、ピイピイピイ。",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドコドコドンドン、ヒュウヒョロヒョロと、朝ごとに角兵衛獅子の囃子がその柳原お馬場の近くの旅籠町からわびしく流れだして、西に東に江戸一円へ散らばっていくのでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、スリッパかなんか、ないかしら」　と、茶のロウヒールを困ったように見おろした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓には戸がないから、冬の日などは寒い風がヒュウヒュウと吹き曝し、教場へは下駄を履いたまま上がるという風で、教師などは大抵大学生が学資を得るために、内職として勤めているのが多かった。",
              "citation": {
                "source": "私の経過した学生時代",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのせきは、冬の夜、枯木のうれをならす風の音のように、ヒュウヒュウいった。",
              "citation": {
                "source": "うた時計",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "程経て妻の心覚につけた日記を読んで見て、その中に、ノウヒンケツ（狼狽した妻は脳貧血をかくのごとく書いている）を起し人事不省に陥るとあるのに気がついた時、余は妻は枕辺に呼んで、当時の模様を委しく聞く事ができた。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　活動が済むころから、風がヒュウヒュウ吹き出したので、かなり寒い、星だらけの夜になった。",
              "citation": {
                "source": "人の顔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡良瀬川の渡し場から中田に来る間の夕暮れの風はヒュウヒュウと肌を刺すように寒く吹いた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして妾は、ゾウヒビョウと言う恐ろしい病気に続けてかかってしまい、妾の両脚はとてもとても人様に見せられない様な、それはそれはみにくいものになってしまいました。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、数匹の狼が、ヒュウヒュウと床下へ飛び込んだ。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「呼吸につれて時々リツ子の喉が笛のやうに細くヒウヒウ鳴る」こんな病床をめぐつての細々した記述も、私には思ひあたる節が多かつたのですが、四月四日、臨終の前、病人の口全体が乾燥してゐる姿に驚いて蜂蜜を塗つてやるところを読むと、（あ、あのとき蜂蜜を塗つてやればよかつたのか）と感に堪へないものがありました。",
              "citation": {
                "source": "檀一雄「リツ子・その死」",
                "author": "――創芸社刊――",
                "note": "青空文庫"
              }
            },
            {
              "text": "白いマントを着たイヴァン・モジュウヒン。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥絵具で、少々、イヴァン・モジュウヒンはにやけている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョウヒョウヒョウヒョウ。",
              "citation": {
                "source": "鍵から抜け出した女",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪物見ゆ　非常汽笛がヒョウヒョウと鳴り終ると、それに入れかわって高声器が働きだしたらしく、ゴソゴソと雑音がひびいてきた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "時折ヒュウヒュウという梢を吹く木枯しの音が、反ってあたりの静かさを増しています。",
              "citation": {
                "source": "計略二重戦",
                "author": "少年密偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "武蔵野を吹き暴るるからッ風の音、ヒュウヒュウと顔に鳴るとき鯨髭の弓弦もそれに劣らず唸り出しては、江戸ッ児の心自らジッとしておられず、二枚半の糸目を改めて雁木鎌幾つかを結びつけ、履物もそそくさと足に突ッかけて飛出すが例である。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "出しものはプロコウヒフの作曲「｜三つの蜜柑への恋」。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "這入るてえとこう、ずらりと機械みたいな物が並んでて、穴へ金を入れると自働でもってパンが出る、ね、肉が出る、はははは、コップにコウヒイが出て一ぱいになると止まりまさあ――って調子で、万事が簡便主義です。",
              "citation": {
                "source": "踊る地平線",
                "author": "黄と白の群像",
                "note": "青空文庫"
              }
            },
            {
              "text": "狩衣、差貫ようのもの、白丁にくくり袴、或いは半素袍角頭巾、折烏帽子に中啓、さながら能と神楽の衣裳屋が引越しをはじめたようにゆるぎ出すと、笛と大拍子大太鼓がカンラカンラ、ヒュウヒュウヒャラヒャラ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
