        "examples": {
          "standard": [
            {
              "text": "週末は家族でスキー場へ行き、ウインタースポーツを存分に楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "北海道は雪質が良く、世界中からウインタースポーツの愛好家が集まる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ウインタースポーツのシーズンが到来し、スポーツ用品店は賑わいを見せている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そして彼はウインタースポーツ場に出かけた。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウインタースポーツとしてスキー、スケートが婦人にできて、氷上のワカサギ釣りが女の子にできないわけがないと思う。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "タナゴ釣りは、ウインタースポーツとして、みなさまにもぜひおすすめしたい。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
