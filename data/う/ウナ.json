[
  {
    "uuid": "25fd7283-4d06-5c87-b6e7-691b8c396bd1",
    "entry": "鰻",
    "reading": {
      "primary": "うな",
      "alternatives": [
        "う"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-接頭辞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "eel (esp. the Japanese eel, Anguilla japonica)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "土用の丑の日が近づくと、スーパーの鰻コーナーに人が集まってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "うな丼を注文すると、タレの香りが食欲をそそる一品が目の前に運ばれてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "冷めたうな重に土瓶のお茶をかけてうな茶漬けにして食べると、また格別な味がした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "13　その夜さらに、室生犀星君と連れだち、三人で田端の料理屋で鰻を食べた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体に食う方にかけては贅沢で、金のある時には洋食だ鰻だとむやみに多量に取寄せて独りで食ってしまうが、身なりはいつでも見窶らしい風をして、床屋へ行くのは極めて稀である。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰻釣りや小海老釣りでも同様であった。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "裂かれた鰻のように、彼の心臓は未だピクピクしていた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿の裏の瀦水池で飼つてある鰻の蒲焼も出た。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿の裏の瀦水池で飼ってある鰻の蒲焼も出た。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰻の腹のような靱い滑かさと、羊皮紙のような神秘な白い色とが、柚木の感覚にいつまでも残った。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱海滞在中漁船に乗って魚見崎の辺で魚を釣っていたら大きな海鰻がかかったこと、これを船上で煮て食わされたが気味が悪くて食われなかったようなことなどを夢のように覚えている。",
              "citation": {
                "source": "箱根熱海バス紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "百分の一近辺のものは猩々、鹿、猫など、それから下って百分の一より千分の一の間にあるのが麒麟、象、羚羊、獅子、袋鼠、鷲、白鳥、雉、鼠、蛙、鯉など、なお一層下って千分の一より一万分の一の間には海馬、鯨、鰐、海鰻、章魚などがひかえている。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "講義も演習もいわば全く米の飯のようなもので、これなしに生きて行かれないことはよく知りながら、ついつい米の飯のおかげを忘れてしまって、ただ旨かった牛肉や鰻だけを食って生きて来たような気がするのであろう。",
              "citation": {
                "source": "科学に志す人へ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘆の根方に住んでいる小｜鰻がそれに取りつく、環をそっと引き上げて、未練に喰い下って来る小鰻を水面近くまでおびき寄せ、わきから手網で、さっと掬い上げる。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "環虫類も何だか虫の中では醜い衰亡者のように思えるし、鰻だとて、やはり時代文化に取り残されたような魚ではないか。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかし父親にとってこの方法の鰻取りは単なる娯しみに過ぎなかったが、今は必死の副業である。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "始末に困るんだよ」　こんな鷹揚なものの云い方をしながら父親は獲物を鰻｜仲買に渡した。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯛や比良目や海鰻や章魚が、そこらに投げ出してある。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊にもう夕飯の時分になったので、半七はお亀にたのんで近所から鰻を取って貰った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦場だからな」「鰻でも取りますか」「それがよかろう」　鰻の蒲焼を註文して、二人は早い夕飯を済ませると、七月の日もかたむいて来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鬼娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "物価は、鰻のぼりにのぼった。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "後に小田原の町を放れ、函嶺の湯本近に一軒、茶店の娘、窶れ姿のいと美しきが、路傍の筧、前なる山凡そ三四百間遠き處に千歳久しき靈水を引いたりといふ、清らかなる樋の口に冷たき其の土を洗ふを見て、山の芋は鰻になる、此の牛蒡恁くて石清水に身を灌がば、あはれ白魚に化しやせんと、そゞろ胸に手を置きしが。",
              "citation": {
                "source": "城の石垣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "根方の処の土が壊れて大鰻を捏ねたような根が幾筋ともなく露れた、その根から一筋の水がさっと落ちて、地の上へ流れるのが、取って進もうとする道の真中に流出してあたりは一面。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鰻の丼は売切です。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗て衣絵さんが、婿君とこゝを通つて、鰻を試みたと言ふのを聞いて居たので、園は、自分好きではないが、御飯だけもと思つたのに、最う其は売切れた……「そら行け。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "た※｜渺々として果もない暗夜の裡に、雨水の薄白いのが、鰻の腹のやうに畝つて、淀んだ静な波が、どろ／＼と来て線路を浸して居さうにさへ思はれる。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又其の上に海の方――羽田あたりからも隅田川へ入り込んで来て、鰻を捕って居るやつもある。",
              "citation": {
                "source": "夜の隅田川",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "季節にもよるが、鰻を釣るので「珠数子釣り」というをやらかして居る。",
              "citation": {
                "source": "夜の隅田川",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "珠数子釣りは鉤は無くて、餌を綰ねて輪を作る、それを鰻が呑み込んだのを※網で掬って捕るという仕方なのだ。",
              "citation": {
                "source": "夜の隅田川",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉤を用いて鰻の夜釣をして居る人もある。",
              "citation": {
                "source": "夜の隅田川",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰻と少しも変りませんから。",
              "citation": {
                "source": "やんぬる哉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "御覧なさい天才は彼の自叙伝を急ぎさうなものに恋愛伝の方を先に書きました",
              "citation": {
                "source": "（天才が一度恋をすると）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが身を見たり、夏としなれば、そのやうなわが身を見たり。",
              "citation": {
                "source": "夏と私",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
