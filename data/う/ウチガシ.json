        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "急な出費が重なったため、店主に給料の内貸しを頼み込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "会社は長年勤めている彼に対して、特別に内貸しを認めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "内貸しをした分は、来月の給料から差し引かれることになっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "身うちがしみるやうだ。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "こないだも、うちがしきりに呼ぶものですから、何の気なしにわたしは格子の前へ行って立ったことがありました。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でも、トランクはまだ失くなったわけじゃないと思いますよ」「そう思ううちがしあわせでさあ」と、男はいって、短くて濃い黒い髪の毛をごりごりかいた。",
              "citation": {
                "source": "火夫",
                "author": "DER HEIZER",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どれどれ、うちがしたげよう」ブリキの缶がつるつる滑って、悦子では巧く括れないので、妙子が自分の膝へ取ったが、ガーゼの中の蛍は、昼間でも暗い蔭に置かれると青く光っているのが見えた。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "教室のうちがしんとしました。",
              "citation": {
                "source": "白い雲",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
