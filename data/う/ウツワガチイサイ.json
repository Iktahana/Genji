        "examples": {
          "standard": [
            {
              "text": "あんな些細なことで文句を言うなんて、器が小さいと思われても仕方ない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "器が小さい男とは、二度と仕事をしたくない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "部下のちょっとしたミスをいつまでもネチネチ言うなんて、器が小さい証拠だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "其の時其の人の器が小さいとか氣質の偏が有るとかすると、おのづからにして亢る氣を生ずる。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時その人の器が小さいとか気質に偏りが有るとかすると自然と昂る気を生じる。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
