        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ある条件を与えたら人はどう振る舞うだろうかを詰めていく、心理シミュレーション小説の傑作、アイザック・アシモフのファウンデーション・シリーズに登場する、『銀河百科大事典』です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "尻切れトンボの二つ目の理由が気になって、ファウンデーション・シリーズの第一作、『銀河帝国の興亡１』を読み直してみました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウンデル・リンデンの並木｜路を美しいと聞いて居たが、其れは巴里のシヤンゼリゼエを知らない人の言ふことであつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああこれだけのファウンデーションと思うの、その上にもしわれらの楼閣をきずくことが出来ないとしたら、それは、果して複数で云える責任でしょうか。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "革命のファウンデーションワーカーの苦痛多き生活、消耗を、公平に認めて居るところ感心した。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、やす普請でファウンデーションがわるいと見え、電車の響がつたわるし、トラックなどが来ると、ブルブルする。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーヘンタールを溯れば、ドライヘルン・シュピッツ Dreiherrn Spitz, 3505m. で、ビルンリュッケ 〔Birnlu:cke〕 からアールンバッハ Ahrn-Bach の谷になる、聞いて見ると、駅長殿身振りをまぜて、ウンデルシェーン！",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の精　ウンデネ　うねれ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウンデネは1285さざめきて流れ寄れ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "大統領直属のサイエンティフィック・アドヴァイザーの報告にもとづいて、一九五〇年にナショナル・サイエンス・ファウンデーションの制度が生まれた。",
              "citation": {
                "source": "調査機関",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホウソウンデンでの晩餐の後に、ベン・ジョンソンは、ブラウントにこんな話をしている。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "「時間からの影」同様に、本作はアスタウンディング・ストーリーズ誌の表紙を飾りました。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "今考エルトアノ奥サン大層オシャベリナ方ダッタカラ、ワザ／＼コレガ云イタクッテ寄ッタンジャナイカッテ、陸子ハ云ウンデスガネ」「コレトハ何サ」「マア、コレカラ先ハ陸子ニオ聞キニナッテ下サイ」安楽椅子ニ腰カケテイル予ノ面前ニ並ンデ立ッテイタ二人ハ、コヽデ「ドッコイショ」トソファニ腰ヲ据エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ油谷サンノ奥サンガ何ヨリ先ニ眼ニ附イタノハ、颯チャンノ指ニ光ッテイタキャッツ・アイダト云ウンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥サンノ見タトコロデハキャッツ・アイト云ッタッテアンナ大キナ立派ナ石ハ、ソンナニザラニアルモンジャナイ、恐ラク十五カラット以上アルコトハ確カダト云ウンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌劇「ウンディーン」の総譜は官吏の不注意で郵送中に失われ、数年後にチャイコフスキーの手許に届いたりした。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを進呈しよう」　と云ひ乍ら彼はエドモンド・ゴスが訳したフーケの「ウンデイーネ」を懐から取り出すと自分の机の上に置いた。",
              "citation": {
                "source": "芥川龍之介を憶ふ",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと異なった例としては、壱岐では梟をムギウマセドリといい、この鳥が啼き始めると麦がウンデ（熟して）来ると伝えている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
