[
  {
    "uuid": "4e92f213-4b4b-5168-b801-0aa216399244",
    "entry": "生まれ変わる",
    "reading": {
      "primary": "うまれかわる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-自動詞"
