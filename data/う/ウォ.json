          "standard": [],
          "literary": [
            {
              "text": "そうして本居宣長翁は、その実際の音を推定して「を」は「ウォ」（ローマ字で書けばwo）であり、「お」は純粋の母音の「オ」（すなわちｏ）であると言っておられます。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワ行の「ゐ」「ゑ」「を」は、「ウィ」「ウェ」「ウォ」（wi、we、wo）であったと考えられるのであり、それに対して、ア行の「い」「え」「お」は、イ、エ、オ（単純な母音）であったのです。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その結果として、第一に、古代には現代にない「ウィ」「ウェ」「ウォ」および「イェ」というような音があったことが明らかになったのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "-------------------------------------------------------　ウォーソン夫人は頭脳もよく、相当に教育もある婦人であった。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日毎日、その忌わしい奇怪の事実が、執拗にウォーソン夫人を苦しめた。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしウォーソン夫人だけは、真面目になって質問した。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウォーソン夫人は耐えがたくいらいらして来た。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうその時には、ウォーソン夫人の顔が真青に変っていた。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウォーソン夫人は椅子を蹴った。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウォーソン夫人の充血した眼は、じっと床の上の猫を見つめていた。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏蘭西啓蒙期の詩人ウォルテルの如きも、非常に実利的で利殖に抜け目のない人物でありながら、しかも当時一流の人間的情熱家だった。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の眼も昇降機の如く、鋭角を追うて一気に上下すれば、建物と建物との間にはさまって、帯のように狭くなった天空は、ニューヨークの株屋が活動するウォール・ストリートあたりを見るような天空深淵を、下から上へとのぞかせている。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ、コーターマスターが駆け込んで「ウォーニン」をとれと伝えた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウッカリするとウォーニンのあおりを食って、海へ飛んで行かねばならなかった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、ウォーニンを取りはずすことは、また急いでいるんだろう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "また別に仕事もなかったので、水夫らは、船首甲板にウォーニンを張って、その下で寝ころびながら、ボースンの伝馬を見送っていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "おもてのウォーニンの下でも、砂丘の上の粒のような人間たちが、動揺し始めたことを見た。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは、ウォーニンの柱やレールに上ったり、つかまったりして、それをながめようとした。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それゆえに文学者が机の前に立ちますときにはすなわちルーテルがウォルムスの会議に立ったとき、パウロがアグリッパ王の前に立ったとき、クロムウェルが剣を抜いてダンバーの戦場に臨んだときと同じことであります。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名なるウォルフ将軍がケベックの市を取るときにグレイの Elegy を歌いながらいった言葉があります、すなわち「このケベックを取るよりもわれはむしろこの Elegy を書かん」と。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながらこれがイギリス人の心、ウォルフ将軍のような心をどれだけ慰めたか、実に今日までのイギリス人の勇気をどれだけ励ましたか知れない。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
