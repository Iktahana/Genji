    "definitions": [
      {
        "index": 1,
        "gloss": "tactic of avoiding hitting the ball (e.g. to tire out the pitcher)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は相手投手のスタミナを削るため、あえてウェイティングの戦術をとった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "監督はバッターに対し、無理に打ちにいかずウェイティングするよう指示を出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長い回を投げ続ける投手にとって、打者のウェイティングは精神的にこたえるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "乗込もうとする人は、もう皆、下へ行ってしまったものと見え、広大なウェイティング・ルームには、人影もない。",
              "citation": {
                "source": "南路",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
