        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "両親は私に小さい頃から勤勉さを植え付けようとしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "教育の目的は学生に知識と倫理観を植え付けることだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "良い生活習慣を子どもに植え付けることが大切である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
