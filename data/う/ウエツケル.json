    "definitions": [
      {
        "index": 1,
        "gloss": "to plant",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "農夫たちは毎年春に苗を畑に植え付ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "去年植え付けたジャガイモが今年も育っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子どもと一緒にプランターに花を植え付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "日本人が科学的頭脳において西洋人に必ずしも劣らないという自信を生徒の頭に植え付ける事もかなり大事な事ではないかと思う。",
              "citation": {
                "source": "雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "紀久子は万年筆を取って、鶏が餌を拾うように首を動かしながら、啜り泣きながら、涙に曇ってくる目を幾度も幾度も押し拭いながら、一字一字を植え付けるようにして手紙を書いた。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それゆえ、農夫は人々の新しい生活を植え付けるために何世紀にも渡ってただひたすら耕し続けるのである。",
              "citation": {
                "source": "石仏",
                "author": "THE STONE BUDDHA",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしそれが新しい床であったならば、古い床から菌の種子を持って来て、それを新しい床に植え付けるのだということである。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　多数読者の嗜好を探り、その嗜好に投じ乍ら、自己の思想を植え付けることは、作家として最も大切では無いか。",
              "citation": {
                "source": "愚言二十七箇条",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何年も前に言いましたが、英国が生き延びる唯一のチャンスは欧州にスポーツ害毒を植え付けることです。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけても日本の如き音楽の処女地に、急速に良き音楽――芸術的な音楽をうえつけるために、ベートーヴェンは、どれだけ役に立ったことか。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to instil (idea, feeling, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "両親は私に小さい頃から勤勉さを植え付けようとしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "教育の目的は学生に知識と倫理観を植え付けることだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "良い生活習慣を子どもに植え付けることが大切である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
