        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこにはあのゆるやかな抑揚ある四拍子の「子守り歌」の代わりに、機械的に調律された恒同な雑音と唸り音の交響楽が奏せられていた。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "死人の胸のようなドームの壁体がユラユラと振動してウワンウワンウワンと奇怪な唸り音がそれに応じたようであった。",
              "citation": {
                "source": "空中墳墓",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにかしら、ひゅーんという高い唸り音をあげて、廻転機がまわっていた。",
              "citation": {
                "source": "宇宙女囚第一号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして山岸少年の耳にかけた受話器に、七色の笛のようなうなり音がはいってきた。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "小僧さんは、こんなにして倒れていたけれど、ときどき思い出したように電車のうなり音が訪れてくるほかは、だれもそばへよってきて、ようすをたずねるものもありませんでした。",
              "citation": {
                "source": "波荒くとも",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "空にはたこのうなり音がしていました。",
              "citation": {
                "source": "山へ帰ったやまがら",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいて、ブーン、ブーンと、飛行機のようなうなり音がします。",
              "citation": {
                "source": "夜の進軍らっぱ",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "車が、でこぼこの道をゆきますと轍がおどって、そのたびにバイオリンは車の上から悲しいうなり音をたてたのであります。",
              "citation": {
                "source": "海のかなた",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこからは、自分の鳴る音に負けないほどの、ゴウゴウなりとどろく、汽罐のうなり音や、車輪のまわる音や、いろいろの蒸気機関の活動するひびきをききました。",
              "citation": {
                "source": "ぴかぴかする夜",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて沈黙が破られたのは、遠方の自動車のガタガタ音と、うなり音だった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "奇妙な静寂に包まれていたが、けたたましい海鳥の鳴き声で破られ、日々の絶え間ない葬送曲は、荒涼とした海岸のうなり音だ。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
