        "examples": {
          "standard": [
            {
              "text": "植物園で、虫を捕食する靫蔓の奇妙な形をじっくりと観察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "靫蔓の袋の中に水が溜まっているのを見て、面白い仕組みだと感心した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "日当たりの良い窓辺に靫蔓を吊るして、育てることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ニューギニアの奥地には食肉植物の、『うつぼかずら』のひじょうに巨きなものがあるという話だったが……。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしかに、「うつぼかずら」の大瓶花が小鳥をくわええたにちがいない。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とそれをキューネが力まかせに引くと、一茎の攀縁一アール（百平方米）にもおよぶと云う、「｜大うつぼかずら」がズルズルと引きだされてくる。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
