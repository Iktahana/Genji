    "definitions": [
      {
        "index": 1,
        "gloss": "(bargain) sale",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "春の売り出しで冬物が半額になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その家電量販店の売り出し期間は毎年恒例だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新しい売り出しが始まるので見に行こう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "軽い双眼鏡　今度ロンドンのネグレッチ・アンド・ザンブラで売り出した新形の双眼鏡「ミニム」というのは従来の双眼鏡中で最も軽いものである、その倍率は八倍で重量七十五匁くらい、柔らかい皮袋に入れて隠袋に収めるように出来ている。",
              "citation": {
                "source": "「万年筆」欄より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃ次郎長だ」　「そうだ、次郎長だ」　「静坊、次郎長と言ったろう」　「そうだったかしら」　「きっとそうだ、次郎長に違えねえ」　石松が感心して、　「そうか、あれが今売り出しの清水の次郎長か。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "武井の安五郎が、　「吉兵衛、清水港の長五郎と云ゃあ此頃売り出して来た次郎長のことだろう」　「そうでしょう」　「何しに来たんだろう？",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちゞれ雲西に傷みて、　　　　いささかの粉雪ふりしき、警察のスレートも暮れ、　　　売り出しの旗もわびしき。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今からでも大書店で十六ミリフィルムを売り出してもよくはないか。",
              "citation": {
                "source": "読書の今昔",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その当時売り出した、バリモアというオペラ女優の身ぶりなどを巧みにまねながら貴女は手に持っていた薔薇を無意識に胸にさしてしまった。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "堅気になってもう十年、めっきり老い込んでしまった甚右衛門が、売り出しのお前さん達に何の指図が出来るもんか。",
              "citation": {
                "source": "半七捕物帳",
                "author": "十五夜御用心",
                "note": "青空文庫"
              }
            },
            {
              "text": "市場に売り出した第一回作品は「非金儲主義」と云う喜劇で、曾てはナポレオンの如く遍く世界中を風靡したことのあるチャーリー・チャップリン――そう云う喜劇役者を憶えておいででしょうな――に主演させました。",
              "citation": {
                "source": "十年後の映画界",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして大通りのガレイジの処で、車をおりて仲通りへ入って来ると、以前の朋輩であり、今は松の家の分け看板として、めきめき売り出して来た松栄とひょっこり出喰わし、松島の死を知った。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　文化の低いこの町では、銀子の好きなイタリイやドイツの写真もなく、国活がまだ日活になったかならない時分のことで、ちゃんばらで売り出した目玉の松ちゃんも登場せず、女形の衣笠や四郎五郎なぞという俳優の現代物が、雨漏りのした壁画のような画面を展開していたにすぎなかった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがその芝居は、重吉の経験した戦争ではなく、その頃｜錦絵に描いて売り出していた「原田重吉玄武門破りの図」をそっくり演じた。",
              "citation": {
                "source": "日清戦争異聞（原田重吉の夢）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓の下、歳の市の売り出しにて、笑いさざめきが、ここまで聞えてまいります。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳吉と蝶子が高津神社坂下に間口一間、奥行三間半のちっぽけな店を借りうけてはじめた剃刀店の売り出しの東西屋らしいと、きいて君枝にもおぼろげに判った。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンフランシスコ市では、少年少女たちが日本への義えん金を得るために花を売り出したところ、多くの人が一たばを五十円、百円で買ったと言われています。",
              "citation": {
                "source": "大震火災記",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さるにても、山川の美しさは、春や秋のは言わばデパートメントの売り出しの陳列棚にもたとえつべく、今や晩冬の雪ようやく解けて、黄紫赤褐にいぶしをかけし天然の肌の美しさは、かえって王宮のゴブランにまさる。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今、やっと売り出しかかっている女優なんだ。",
              "citation": {
                "source": "殺人迷路",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この年、アップルは初めてマック用のＣＤ―ＲＯＭドライブを売り出しました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九九六（平成八）年二月のマックワールドエキスポで、このブックを横丁作品として売り出し、最終日にあたる二月二十四日をもって、彼らはインターネットでブックを売るという新しい冒険に乗り出していきました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "単漢字変換のイージーワード　１・０版は「これじゃ売り出しても勝負にならんわ」というわけでデビューには至らず、一九八五年九月、五百字までの一括変換をサポートするバージョン２・１で初めて発売となった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂丹羽物といはれた頽廃もので売り出した丹羽文雄氏が、あだかも自分が女性主義者でないことを証明するかのやうに、甚だ男性的な『勇ましい小説』を書いてゐることである。",
              "citation": {
                "source": "小熊秀雄全集-20",
                "author": "大波小波",
                "note": "青空文庫"
              }
            },
            {
              "text": "下谷の西黒門町にある最中で近頃売り出したうさぎやといふ家も焼けた。",
              "citation": {
                "source": "地震の時",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、大学を出ると、見る間に、メキ／＼と売り出して、今では新進作家の第一人者として文壇を圧倒するような盛名を馳せている。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "果然、疑問のあだ者は、右門の目ききしたとおり、いま江戸で売り出しのくし巻きお由であったとみえて、そのわざの早いこと、早いこと！",
              "citation": {
                "source": "右門捕物帖",
                "author": "なぞの八卦見",
                "note": "青空文庫"
              }
            },
            {
              "text": "銘仙ですらがそんな景気ですから、その他のもののはけぐあいがいいことはもちろんのことで、二日三日と大売り出しが重なっていくにつれて、客は客を呼び、評判は評判を生んで、まことに文字どおり店先は市をなすの盛況でありました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "身代わり花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "４　時刻はすでに四ツを回って、普通ならばとっくに寝ついているべきはずでしたが、昼の大売り出しの勘定がつかないとみえて、まだ生島屋ではいずれもが起きていましたので、右門はかって知った内玄関のほうへ駕籠を乗りつけると、案内も請わずにずかずかと門内へはいっていきました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "身代わり花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "南町はどなたのご配下の岡っ引きだとききやがるから、へん、はばかりさま、いま売り出しのむっつり右門様っていうなおれの親分なんだって、つい啖呵をきっちまいましたら、おやじめがこんなにぬかしやがるんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "青眉の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論、その価格でドシドシ売り出している。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "と地震のやうな激しい力が自分を地の底から持ち上げて、自分をはうりだしたやうに感じた。",
              "citation": {
                "source": "夜烏",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "」雑誌をほうりだして、「理くつばかり言ってるのね。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「施十娘、施十娘、私は世高だよ、私は生きているのだよ、恐れることはないよ、私は理由があって、生きているのだよ」　そのとたんに老婆は転んで酒壷を前へほうりだした。",
              "citation": {
                "source": "断橋奇聞",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
