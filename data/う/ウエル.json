  {
    "uuid": "79428c5d-6c7f-54d9-ad2c-b7a1abedaf78",
    "entry": "餓える",
    "reading": {
      "primary": "うえる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "下一段-ア行",
