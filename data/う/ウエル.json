[
  {
    "uuid": "5b51419d-d4f4-5716-910d-0da6bf1c45cc",
    "entry": "飢える",
    "reading": {
      "primary": "うえる",
      "alternatives": [
        "かつえる"
      ],
      "is_heteronym": true
    },
    "grammar": {
      "pos": [
