        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ウサギノ　ハイツタ　カゴヲ　モツテ　ヲリマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　ウサギノ　ハウハ　イクラ　ダイジニ　シテ　ヤツテモ、チツトモ　オホキク　ナリマセン。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "今はいかんねん」悦子はその綴方は「ウサギノミミ」と云う題で、姉ちゃんのことがちょっと出て来るのだと云った。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――ウサギノミミ私ハウサギヲカツテヰマス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝学校ヘ行ク時ニゲンカンヘ出テミマシタラ、ウサギノミミガ、一ツダケピント立ツテヰテ、一ツハヨコニタオレテヰマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハネエチヤンニ、「ネエチヤン、アノウサギノミミヲ立テテ下サイ」トイヒマシタノデ、ネエチヤンハ足デウサギノミミヲツマンデ、立テテオヤリニナリマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪子は慌てて、「ネエチヤンハ足デウサギノミミヲ………」とある「足デ」の二字を鉛筆で消した。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――………ネエチヤンモウサギノミミヲツマンデ、立テテオヤリニナリマシタガ、ネエチヤンガソノミミヲオハナシニナルト、マタパタリトタフレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
