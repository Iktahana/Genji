[
  {
    "uuid": "49ab90df-4386-534a-ac8f-88693f7d20d0",
    "entry": "うっ血",
    "reading": {
      "primary": "うっけつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "congestion (of blood)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長時間座っていると足にうっ血が起きる。",
              "source": "幻辞"
            },
            {
              "text": "うっ血により血色が悪くなった。",
              "source": "幻辞"
            },
            {
              "text": "医者はうっ血の原因を調べるために検査をした。",
              "source": "幻辞"
            },
            {
              "text": "うっ血を解消するには運動が必要だ。",
              "source": "幻辞"
            },
            {
              "text": "静脈瘤はうっ血が原因で起こる。",
              "source": "幻辞"
            },
            {
              "text": "皮膚のうっ血が目に見えている。",
              "source": "幻辞"
            },
            {
              "text": "心臓病はうっ血性心不全を引き起こす。",
              "source": "幻辞"
            },
            {
              "text": "うっ血があると、足の腫れが起こる。",
              "source": "幻辞"
            },
            {
              "text": "脳のうっ血は危険な状態だ。",
              "source": "幻辞"
            },
            {
              "text": "マッサージはうっ血を軽減するのに役立つ。",
              "source": "幻辞"
            },
            {
              "text": "うっ血症状が続く場合は医師の診察を受けるべき。",
              "source": "幻辞"
            },
            {
              "text": "運動不足はうっ血のリスクを高める。",
              "source": "幻辞"
            },
            {
              "text": "うっ血により局所的な酸素不足が生じる。",
              "source": "幻辞"
            },
            {
              "text": "肝臓のうっ血はアルコール摂取で悪化する。",
              "source": "幻辞"
            },
            {
              "text": "うっ血した部位は冷却すると良い。",
              "source": "幻辞"
            },
            {
              "text": "妊娠中のうっ血は一般的な症状だ。",
              "source": "幻辞"
            },
            {
              "text": "うっ血の改善には圧迫療法が有効だ。",
              "source": "幻辞"
            },
            {
              "text": "静脈の障害がうっ血を引き起こす。",
              "source": "幻辞"
            },
            {
              "text": "うっ血は血管内の圧力上昇を示す。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "今は皆自信を持って安産を考えていますが、夏頃はひどくうっ血した顔をしているし、苦しがっているし全く心配でした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "始め羊水が多すぎると言って食物制限をして、バターを食べさせなかったところ、小鷹さんに診せたら心臓が丈夫でない為、うっ血してガスが発生し、その為お腹が人並より大きいし、全体むくんでもいるというわけで、勿論バターなどは是非たくさん食べた方がいいしという話で吃驚した次第です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "初老の痛風｜患いで、頸動脈辺りがうっ血気味の紳士にしては、しわの無いがっちりしたきれいな手だ。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "肝臓のうっ血に中国の治療はシソの他にタケの芽およびゾウの革、特にブタ肝臓の抽出液、ウシの胆汁またはクマの胆汁をアラク酒で処理したものを推薦する。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
