        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "舞台袖に下がる直前、アイドルが客席に向かって茶目っ気たっぷりにウインクをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は秘密を共有した証として、私にだけ見えるように片目で軽くウインクを送ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "写真を撮る時にウインクをしようとしたが、どうしても両目が閉じてしまい、うまくできなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "望月は、はっとしたらしかったが、べつに大した狼狽もせず、気障なウインクを送った。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、前後を見廻して、其のウインクが私に向って発せられたものであることを確かめると、私は私の記憶の隈々を大急ぎで探しはじめた。",
              "citation": {
                "source": "虎狩",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ひどくしょんぼりした顔の小柄な浪人者が、横眼で土門の方を見て、ウインクした。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "で僕は、弓なりにした剣の間から、敬うとも嗤うともつかぬウインクスを投げただけだった。",
              "citation": {
                "source": "吊籠と月光と",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下で出逢ったりする時彼は明らかに私にウインクした。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥さんなら、いまちょいとお仕事が、おあんなさるのですって」　雪子夫人は、お饒舌をしたあとで、娼婦のように、いやらしいウインクを見せたのだった。",
              "citation": {
                "source": "振動魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "別にウインクしたのでもないが、服装が態度が遊覧客らしかつたのだらう、若い売笑婦に呼びかけられた！",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "次にこれが三度目をパチクリさせたあと、右目でウインク。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "出納の記帳台に納っていた白板面が、係長の眼を盗んで槇子へ下手くそなウインクを送ってよこした。",
              "citation": {
                "source": "罠を跳び越える女",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニカイ　アガリマショウの男は、盛んに私にウインクしていた。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さすが、ミツシヱルの好みだけあつて、美しいわね、一寸やけるわ」　ちよいちよいロロは寒子の肩越しに、ミツシヱルにウインクして見せながら、茶目ツ子らしく舌を出してゐた。",
              "citation": {
                "source": "瑪瑙盤",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その場でインキを二つ三つぶっ付け合うと……ヘエ……ウインクですか……どうも相すみません。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "此奴ったら」と、ぼくのほうを顎でしゃくって、「ウインクの真似をしてやがるんだ。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハア、それがウインクてんだな。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとうに、片眼をおもいッきり、つぶってウインクをしてみる。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、そのだぼはぜ嬢が、愈々、瞳に媚をたたえて、「けっして、助平とは思わないでね」とウインクをするのです。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に、ステップ、ウインク、投げキッスと、三拍子、続けてやられたとき、その濡れたような漆黒の瞳が、瞬間、妖しくうるんで光るばかりに眩ゆく、ぼくは前後不覚の酔い心地でした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "かねて知合いのウインクレル氏だとすぐ思って、会えるかも知れないと道を急いだ。",
              "citation": {
                "source": "春の上河内へ",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーストリアのウインクレル氏は二十九の元気な青年だ。",
              "citation": {
                "source": "五色温泉スキー日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウインクレル氏が先頭で孝ちゃんが殿りに。",
              "citation": {
                "source": "五色温泉スキー日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "たった、ひとりで踊場にあらわれるレデーの香入りの天蓋の下で、僕は曲線のあるウィンクを感じながら、女性の罠と、慇懃な精神のむなさわぎを衝ける。",
              "citation": {
                "source": "東京ロマンティック恋愛記",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の片隅にはアオイ・ホテルから小湊へ事件後返り咲いたお六が、南京刈の男のウィンクに応じて立上るとショートオオダァのために別室に消えた。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "イズモ町を過ぎて商店の飾窓の彩玻璃に衣裳の影をうつしてプロフェショナルな女がかるく通行の男にウィンクした。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "リップ・ヴァン・ウィンクルの話を思い出しながら外へ出る。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "余談ではあるが、二十年ほど前にアメリカの役者が来て、たしか歌舞伎座であったかと思うが、「リップ・ヴァン・ウィンクル」の芝居をした事がある。",
              "citation": {
                "source": "化け物の進化",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の中でリップ・ヴァン・ウィンクルが元気よく自分の名を叫ぶと、反響がおおぜいの声として「リーッウ・ウァーン・ウィーンウール」と調子の低い空虚な気味の悪い声であざけるように答えるのが、いかにも真に迫っておもしろかったのを記憶する。",
              "citation": {
                "source": "化け物の進化",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "）というような意味のこもったウィンクを送った。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの頃は先生も男のさかりで、アアヴィングの「リップ・ヴァン・ウィンクル」などを教えてくれたものだった。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうかすると先生の口から先生自身がリップ・ヴァン・ウィンクルであるかのような戯談を聞くこともある。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほか私が本を読んでもらった人に、そのとき『現象学と宗教』という論文で講師の地位を得たウィンクレル氏がある。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
