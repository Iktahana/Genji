        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ロンドン滞在中に、ウエストエンドの劇場で有名なミュージカルを鑑賞した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ウエストエンドの華やかな通りには、一流ブランドのフラッグシップショップが軒を連ねている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "役者を目指す若者にとって、ウエストエンドの舞台に主役として立つことは最大の夢だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "二人はまさにウエストエンドの雰囲気を漂わせ、このエドワード・ストリートには全く不釣り合いだ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁には武器の戦利品がかかり、どう見ても南アフリカ産だし、床には虎皮が一枚丸ごと敷いてあり、少なくともウエストエンドで売られている品じゃない。",
              "citation": {
                "source": "ギルレイ",
                "author": "The Man Called Gilray",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　ウエストエンドではただの話題になるぐらいだった。",
              "citation": {
                "source": "バブル崩壊",
                "author": "A BUBBLE BURST",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにウエストエンドも良くない。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホワイトチャペルで議論され、ウエストエンドのクラブで熱心に討論された。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
