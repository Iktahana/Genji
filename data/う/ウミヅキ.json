        "examples": {
          "standard": [
            {
              "text": "妻の産み月は来月の予定だから、出産準備を進めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "産み月が近づくにつれて、母親の身体は大きく変わる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "医者に産み月の検査を受けるよう勧められた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "もう産み月で痛み出して居るかも知れませんがなあ。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い羽根蒲団の上に、産み月の黄金の闇は悩みをふくんでゐる。",
              "citation": {
                "source": "藍色の蟇",
                "author": "大手拓次",
                "note": "青空文庫"
              }
            },
            {
              "text": "産み月近くには、二人ばかり貰い手の口もあったのだけれど、いざ生れて、猿っこのような赤ん坊を見せられると、二人の貰い手は、もっと器量のいい子供をと云うことになったのであろう。",
              "citation": {
                "source": "河沙魚",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "産み月のポテレンで、裳を高々とまくりあげ、アユのころがしをやっている図などは、想像しただけで愉快である。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "産み月の近くなったころ、特別製の大きなオーバーをきて、そっくりかえるような堂々さで歩いていた姿は実に立派だった。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん現在も吉野屋にいるし、懐妊ちゅうで、来月が産み月だ、ということであった。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の歴史の本には、「たまたま産み月にあたる。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時妹のくれがし氏は、その狂へる人の胤を宿し、既に生み月に近き身に候ひしが、同じ歎きを悲しびて、やがて又、命を終らむばかりなりしを、やう／＼に取り止め候ひしとか承り及びて候。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――今月も生み月になっている妃が六人いるのですからね。",
              "citation": {
                "source": "青年と死",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "神功が女釣師の初めなり　落語の中に出てくる神功皇后は、十四代仲哀天皇のおたねをお宿しになり、三韓へ渡るときに十月十日の生み月で男装をしたというから、モダンガールの始祖でもある。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
