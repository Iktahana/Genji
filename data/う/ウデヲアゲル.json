        "examples": {
          "standard": [
            {
              "text": "毎日の練習で野球の腕を上げることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "留学先の大学で語学の腕を上げたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "コーチの厳しい指導で相撲の腕を上げていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "私は彼にファシスト風の真直ぐに腕を上げる挨拶をして、まず私たちがいかに方々を旅行して来た場慣れ者であるかを示した。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほら、こそぼってもよいわ」　たつは両腕を上げる。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今度こっさり、こそぼがらんほん」　たつは自分から腕を上げる。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度こっさりや」　たつはまた腕を上げる。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにつけても、一つでも餘計に仕事をして、腕を上げるのが心掛といふものぢやないか。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "傀儡名臣",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにつけても、一つでも余計に仕事をして、腕を上げるのが心掛けというものじゃないか。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "傀儡名臣",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
