        "examples": {
          "standard": [
            {
              "text": "この老舗の和菓子屋は、百年以上、同じレシピでうぐいす餅を作り続けている。",
              "source": "幻辞"
            },
            {
              "text": "京都の菓子屋でうぐいす餅を買った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "うぐいす餅の餅の食感が好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "菓子は好物のうぐいす餅、菜は独活にみつばにくわい、漬け物は京菜の新漬け。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
