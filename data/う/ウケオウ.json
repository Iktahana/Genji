        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "育児で忙しい妹に代わって、週末の買い出しを全て私が請け負うことにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はチームのムードメーカーとしての役割を、自ら進んで請け負っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "誰もやりたがらなかった雑用を、新人の彼が笑顔で請け負ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
