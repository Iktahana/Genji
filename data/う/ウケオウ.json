    "definitions": [
      {
        "index": 1,
        "gloss": "to contract",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "地元の工務店が、古い古民家のリノベーションを格安で請け負ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はプログラミングのスキルを活かし、ウェブサイトの制作を個人で請け負っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "国交省から直接、大規模な道路建設プロジェクトを請け負うことに成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "基礎的な情報収集の面でも、請け負う仕事に関連しても、インターネットにはまっている時間はとても長くなる。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九七四年春に連邦政府がデータ解析を無料で請け負うようになるまでに、トラフォデータはおよそ二万ドルを売り上げた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラスキンは人を雇い入れて会社を作り、マニュアル制作を本格的に請け負うようになった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」といふのが、創立當時の綱領であつたさうだが、さうでなければ、米國人が金を出す氣づかひもなく、新島氏もそれを請け負うて來たのであらう。",
              "citation": {
                "source": "學校の今昔",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "料金をいただいて、人殺しを請け負うというわけですよ」　ますます恐ろしいことをいう。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "きくところによれば（まったく彼らは覆面をしてゆくのである）、中にはお金を貰って、それで他人の信心を請け負う者もいるということだけれど、苦痛の蔑視もここまで来ると、信心の欲求の方が金銭の欲求よりもずっと強いものだと知っているだけに、ほとほと感心させられる＊＊＊。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "印刷を請負うのにも、近頃は前金をとり、不意の活字は同業者のところへ借りに走っていた。",
              "citation": {
                "source": "雪の夜",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまで仕売物ばかり拵えている或工場に働いていた小野田は、そんな仕事が仲間の手に溢れるようになってから、それを請負うことになった工場の註文を自分にも仕上げ、方々人にも頼んであるいた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一は、目下の食糧購入費を得るために、『税庫建築』を請負うこと。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "五年前、桜が咲きかける時分石川は予期しない建築を一つ請負うことになった。",
              "citation": {
                "source": "牡丹",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほいと非人の階級は、頼まれれば生きた人間の磔刑をさえ請負うのであるから、犬なんぞは朝飯前のものであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "道庵と鰡八の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドテラ婆に、うちのオヤジを殺すことを請負うちょったそうなが、……」「そらそうと、時やんは、姐さんを迎えに行くちゅうて、広島に帰んだが、うまいこと、つれて戻りきるじゃろか？",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしが、請負うちょく」「そんなら、よろしいですけど、……」　マンは、まだ、気がかりの面持だった。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸へ移住して来た初めは、弥次兵衛はただの牢人者だったが、才気と侠気が備わっているので、人を御すのが上手、町人になって、屋根｜請負いを始め、やがて、諸侯の普請人足を請負うようになり、また、土地の売買をやったりして、今では懐手をして「親分」という特殊な敬称をうけている。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "普請を請負うたびに損をするか、たまに儲けたと思うとうまく騙されて金を貸し、相手に逃げられてしまう。",
              "citation": {
                "source": "おさん",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to take over",
