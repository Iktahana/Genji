        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "烏兎匆々として子どもたちはもう高校生になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "仕事に没頭していると烏兎匆々で月日が流れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "烏兎匆々と人生は過ぎていくのを実感した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それから更に烏兎匆々と過ぎて大正三年になって、市川眼玉という老優が東京へ来た。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏兎匆々歳月人を待たずで私は今年七十二歳ですが、斯く植物が好きなもんですから毎年よく諸方へ旅行しまして、実地の研究を積んで敢て別に飽きる事を知りません。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第二部　混混録",
                "note": "青空文庫"
              }
            },
            {
              "text": "句意は春の日の長閑な趣をいったので、烏兎匆々といったり、光陰如矢といったりするその早い月日をこのごろは気候の長閑なので考えもせずにいたというのであります。",
              "citation": {
                "source": "俳句とはどんなものか",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
