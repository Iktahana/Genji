[
  {
    "uuid": "7e0baecc-ae58-5b3a-bb33-f31eb769aa02",
    "entry": "旨煮",
    "reading": {
      "primary": "うまに",
      "alternatives": [
        "あまに"
      ],
      "is_heteronym": true
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "fish, meat, and vegetables stewed in a thick, sweet sauce of soy sauce, sugar and mirin",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "母さんが作ってくれた野菜の旨煮は、優しい味がして心が温まる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "料理店のメニューに旨煮を見つけると、つい注文したくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "根菜をじっくりと時間をかけて旨煮にしたから、中まで味が染み込んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "はてさて迷惑な、こりゃ目の前で黄色蛇の旨煮か、腹籠の猿の蒸焼か、災難が軽うても、赤蛙の干物を大口にしゃぶるであろうと、そっと見ていると、片手に椀を持ちながら掴出したのは老沢庵。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "はてさて迷惑な、こりや目の前で黄色蛇の旨煮か、腹籠の猿の蒸焼か、災難が軽うても、赤蛙の干物を大口にしやぶるであらうと、潜と見て居ると、片手に椀を持ちながら掴出したのは老沢庵。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、後船鎗と戸棚の中とに、鮭の鑵詰、スープ、羊肉の旨煮、その他のご馳走がある。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしの来るのを前から知っていたので、台所には相当の準備があったらしく、オムレツや、フライや、鳥のお吸物や、この山で取れるという竹の子のお旨煮や、たくさんの御馳走が列べられたのには、わたくしも少しく驚かされました。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "例之ば午、吸物摘入、小蕪菁、椎茸、平昆布、大口魚、鱠、千六本貝の柱、猪口はり／＼、焼物生鮭粕漬、夕、吸物牡蠣海苔、口取蒲鉾卵｜橘飩青海苔を塗したる牛蒡鯛の小串、刺身｜比目魚黒鰻、大平鯛麪、旨煮烏賊牛蒡｜土当帰、概此類であつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "月の輪熊の方は、その翌日とろ火にかけて、小半日ばかり湯煮して、やわらかに煮あげ、それを里芋、牛蒡、焼豆腐と共に旨煮にこしらえて賞味したところ、山谷の匂い口中に漂って、風雅の趣を噛みしめた。",
              "citation": {
                "source": "老狸伝",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛肉の山椒煮だの、慈姑の旨煮などがつめられた。",
              "citation": {
                "source": "河原の対面",
                "author": "小寺菊子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ毎日、生命の漂うまにまに任運騰々として充ち満ちた生活を送るだけであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と思うまに見えずなりぬ。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろ考えて、照枝も今まで水商売だったから、やはりこんども水商売の方がうまにあうと坂田はあやしげな易判断をした。",
              "citation": {
                "source": "雪の夜",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思うまもなく、あっというまに、めらめらと燃えあがって、消えてしまいました。",
              "citation": {
                "source": "すずの兵隊さん",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "お日さまの光は、お日さまからあたしたちのところまで、はかることもできないほどの、遠い遠い距離を、あっというまに、とんでくるんですもの。",
              "citation": {
                "source": "かけっこ",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ、神さまの国をせめようとして、たった一ぴきの、小さなハチのために、あっというまに、やっつけられてしまったんですからね。",
              "citation": {
                "source": "わるい王さま（伝説）",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしたちの生活の中に、まかれている罪のたねも、それと同じように、あっというまにふくらんで、考えや言葉や、行いのうちに、芽を出すことがあります。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "するととつぜん、パクッと人形が口をあきペロッと舌を出し、あっというまに、もとのように口をとじてしまいました。",
              "citation": {
                "source": "狐",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "チエホフの芝居にも、ひとりの気のきかない好人物が、「あわや、というまに熊は女を組み伏せたりき。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あわや、というまに熊は女を組み伏せたりき。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あわや、というまに熊は女を組み伏せたりき、か。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大国主神は、おやと思うまに、たちまち四方から火の手におかこまれになって、すっかり遁げ場を失っておしまいになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとふいに大きな大ぐまが現われて、あっというまにまたすぐ消えさってしまいました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを阿知直という者が、すばやくお抱え申しあげ、むりやりにうまにお乗せ申して、大和へ向かって逃げ出して行きました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "王は曾婆加里の目顔がそのさかずきで隠れるといっしょに、かねてむしろの下にかくしておおきになった剣を抜き放して、あッというまに曾婆加里の首を切り落としておしまいになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでまったくなんのお気もなく、すぐにおうまにめして、大長谷皇子のお仮屋へ出かけておいでになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、あっというまに、仲間の一人をのんでしまいました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、あっというまに、もう自分の家の戸口まで帰っていました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "一、アラジンとふしぎなランプ",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっというまにかかる。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "もういい加減にしてくれとのどまででかかってもやはり、「マックス・ヘッドルーム」は見にゃならんわで、本当に一九九〇年の十月はあっというまに舞台にあふれかえった登場人物をみんな引き連れて飛ぶように去っていったのであった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんぐりの背比べの中から物の弾みでひょいと頭一つ飛び出せば、後はこの空間を支配する標準化の力学が、あれよあれよというまに絶対的な強者に押し上げてくれた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうまにあわない、なにもかもまにあわない。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ来い、野郎だッ」　うなりをたてながら飛び出していったかと思うまに、伝六得意の一つ芸、たちまちそろえたのは替え肩六人つきの早駕籠二丁です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
