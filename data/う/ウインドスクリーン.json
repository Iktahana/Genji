        "examples": {
          "standard": [
            {
              "text": "フロントのウインドスクリーンが曇ってきたので、デフロスターをオンにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "レース車両の低いウインドスクリーンが、空気抵抗を極限まで抑えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "泥はねで汚れたウインドスクリーンを、ウォッシャー液できれいに拭き取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
