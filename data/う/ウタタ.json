  {
    "uuid": "49c45cc6-4330-5ac6-9282-dbb5c364ef6e",
    "entry": "転た",
    "reading": {
      "primary": "うたた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
