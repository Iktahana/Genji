      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "漫に昨夜を憶起して、転た恐怖の念に堪へず、斯くと知らば日の中に辞して斯塾を去るべかりし、よしなき好奇心に駆られし身は臆病神の犠牲となれり。",
              "citation": {
                "source": "妖怪年代記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "読書、弾琴、月雪花、それらのものは一つとして憂愁を癒すに足らず、転た懐旧の媒となりぬ。",
              "citation": {
                "source": "妖僧記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "野田山に墓は多けれど詣来る者いと少なく墓｜守る法師もあらざれば、雑草｜生茂りて卒塔婆倒れ断塚壊墳算を乱して、満目｜転た荒涼たり。",
              "citation": {
                "source": "妖僧記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "儂思うてここに至れば、血涙淋漓、鉄腸寸断、石心分裂の思い、愛国の情、転た切なるを覚ゆ。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああこれを思い、彼を想うて、転た潸然たるのみ。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "予も又胸に一種の淋しみを包みつつある此際、転た旅情の心細さを彼が為に増すを覚えた。",
              "citation": {
                "source": "浜菊",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに宛転たる嬌音をもって、乾燥なる講筵に一点の艶味を添えられたのは実に望外の幸福であります。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "書して茲に至り吾人は実に悵然として転た大息を禁ずる能はざる者に候。",
              "citation": {
                "source": "渋民村より",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうか洋行の一つも為せて、指折の人物に為たいと考へてゐるくらゐ、未だ未だこれから両肌を脱いで世話をしなければならんお前の体だ、なう」　これを聞ける貫一は鉄繩をもて縛められたるやうに、身の重きに堪へず、心の転た苦きを感じたり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は自若として、却つてその子の善く論ずるを心に愛づらんやうの面色にて、転た微笑を弄するのみ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この心なる宮はこの一月十七日に会ひて、この一月十七日の雪に会ひて、いとどしく貫一が事の忍ばるるに就けて転た悪人の夫を厭ふこと甚かり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は転た人生の凄涼を感じて禁ずる能はざりき。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "見遍せば両行の門飾は一様に枝葉の末広く寿山の翠を交し、十町の軒端に続く注連繩は、福海の霞揺曳して、繁華を添ふる春待つ景色は、転た旧り行く歳の魂を驚かす。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いと淡き今宵の月の色こそ、その哀にも似たるやうに打眺めて、他の憎しとよりは転た自を悲しと思続けぬ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "狭山さん、それぢや私も……覚……悟したわ」「酒を持つて来な」「あい」　お静も今は心を励して、宵の程｜誂へ置きし酒肴の床間に上げたるを持来て、両箇が中に膳を据れば、男は手早く燗して、その間に各服を更むる忙しさは、忽ち衣の擦り、帯の鳴る音高くと乱れ合ひて、転た雨｜濃なる深夜を驚かせり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その鑑識に驚いて予が小沢という人に話し、小沢また岡崎氏に向って受け売りすると、恋愛の実境はそんな言では悉し得ない、すべて少年は縹緻を重んじ中年は意気を尚ぶ、その半老以後に及んではその事疎にして情｜転た熾んに、日暮れ道遠しの事多し、ただ身分の健否を問うのみと言われた由。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "予在外中しばしば屠場近く住み、多くの牛が一列に歩んで殺されに往くとて交互哀鳴するを窓下に見聞して、転た惨傷に勝えなんだ。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペッチグリウ博士続けていわく、予かつて高等哺乳動物の心室と心耳の動作を精測したき事あって一疋の猴の躯を嚢に入れてひっ掻かるるを防ぎ、これにクロロホルムを施すに猴あたかも予の目的を洞察せるごとく、悲しみ気遣いながら抵抗せず、予の為す任に順いしは転た予をして惻隠の情に堪えざらしめた。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまだわず、ただ睛を注ぎ唇を舐り奴を視る、然、またこれを覚る、奴食を催す転た急なり、然、計を決し髀を拍ち大いに喚んで烏竜と白う、狗声に応じ奴を傷つく、奴刀を失し伏して地に倒る、狗ついに奴の頭を咋う、然、因って刀を取って奴を斬り、婦を以て官に付しこれを殺すと。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "空想勝なる自分の胸は今しもこの山中にも猶絶えない人生の巴渦の烈しきを想像して転た一種の感に撲れたのであつた。",
              "citation": {
                "source": "重右衛門の最後",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊にアレキサンドリアの文庫の滅亡は惨絶凄絶を極めて、永く後世をして転た浩嘆せしめる。",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "平凡なる私の如きものも六十年の生涯を回顧して、転た水の流と人の行末という如き感慨に堪えない。",
              "citation": {
                "source": "或教授の退職の辞",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して私共はこの大海のただ中の甲板上に立って、私共を出口まで引張って来た所の三人の恩人を顧みて、転た感謝の念を熾にせざるを得ないのであります。",
              "citation": {
                "source": "琉球史の趨勢",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間も朝鮮人の密航船が玄海灘で難破して、一行二三十名が藻屑となったという報道を読んで、転た感深いものがあった。",
              "citation": {
                "source": "玄海灘密航",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "モムゼン(Mommsen)は外蕃の人であるといい、フシュケ(Huschke)はローマ人であると主張し、吾人をして転たその適従に苦しましめる。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "モムゼン（Mommsen）は外蕃の人であるといい、フシュケ（Huschke）はローマ人であると主張し、吾人をして転たその適従に苦しましめる。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "読み到りて当時を追想すれば転た悚然たらずんばあらず、然も今之を誌上に掲載して、昔日の夢を笑ふが如き、蓋し天の幸のみ。",
              "citation": {
                "source": "牡丹句録",
                "author": "子規病中記",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜀道磽※として轉た世は嶮なるかな。",
              "citation": {
                "source": "魔法罎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "地は海上三千餘百尺、誠に高燥にして神心轉た爽快ならずむばあらず。",
              "citation": {
                "source": "草津行",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "家は雨の叩くに任せ、浴槽は落葉の埋むるに任せ、鳥聲獸跡、轉た山中隱者の感に堪へざらしむ。",
              "citation": {
                "source": "日光山の奧",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            }
          ]
