[
  {
    "uuid": "fabd37c4-ded2-5440-9403-cd7f6a116fdb",
    "entry": "転",
    "reading": {
      "primary": "うたた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
