    },
    "definitions": [
      {
        "index": 1,
        "gloss": "more and more",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "季節が移ろい、うたた秋の気配が深まってきたように感じる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "長年連れ添った夫婦の顔が、うたた似通ってくるのは不思議なものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "降り続く雨の音を聞いていると、うたた物寂しい気持ちになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "高きより、風のただ中に、思ひ出の破片の翻転するをみたり。",
              "citation": {
                "source": "夏と私",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫くゆくと自転車を坂の下に落として、自分一人は草を掴めば上れるが、自転車を置いとくわけにもいかずといふ災難者にあつた。",
              "citation": {
                "source": "（七銭でバットを買つて）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "自転車に紐か何か付いてるでせう、と僕は云つた。",
              "citation": {
                "source": "（七銭でバットを買つて）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "へい、――それには全く気が付きませんでした、自転車は月の光を浴びながら、ガタ／＼といつて引揚げられた。",
              "citation": {
                "source": "（七銭でバットを買つて）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "自転車の前の、ランプが灯つた。",
              "citation": {
                "source": "（七銭でバットを買つて）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨今の如く、交際ばかりがうまくて、仕事はその交際のお景品のやうにしてゐるインテリが、インテリの中で比較的景気のよい方に属するといふが如き、そんな有様では、もともと冠履転倒である。",
              "citation": {
                "source": "作家と孤独",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　　　　　　　　×　話頭一｜転、信義なき対人圏にあつて、芸術家が何を得るとしても何れは僅かなものである。",
              "citation": {
                "source": "詩と現代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は此の新生児を抱いて、七転八倒してみるだけのことである。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまり七転八倒の文章であるから以下簡単に此の一文を要約してみる。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の毒がられては、Ｂとしては冠履転倒も甚だしいものだ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――然し、事象は歴史を織りなして行くであらうが、歴史が事象を織りなしてゆくとは冠履転倒のことであるから、時代なぞといふ方から文学を考へるよりも、文学者自体の実状を反省してみることは却て賢明なことであらう。",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "話といふやうなものはてんでないで、話をしてゐても、その話が相手の気に触りはしないかといふことが念頭に浮ぶや、実に手の腹を返すが如く話頭を転ずるのだが、それでまた相手が妙にも思はぬといふ摩訶不思議な有様である。",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "……僕は此の十幾年といふもの夜昼転倒の生活をしてゐるのだ。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷物を、運転手と僕とで運び入れて、運転手と助手とが帰つて行くと、僕一人になつた。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞けばその後また横浜の小学校に転任したさうであるが、ナニ、ブラ公なぞが訪ねた所で誰が喜ぶものでもあるまい。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時は下宿をしたり、ある時は間借りをしたり、ある時は借家をしたりして、常に住居を転々としていた。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "自転車に乗って三鷹の駅前の酒屋へ用達しに来て、酒屋のおかみさんに叱られてまごついている事もある。",
              "citation": {
                "source": "男女川と羽左衛門",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはり、自転車に乗って三鷹郵便局にやって来て、窓口を間違ったり等して顔から汗をだらだら流し、にこりともせず、ただ狼狽しているのである。",
              "citation": {
                "source": "男女川と羽左衛門",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大隅君は転々と職を変えた。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは、その原因をあれこれと指摘し、罪を社会に転嫁するような事も致しません。",
              "citation": {
                "source": "自信の無さ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮りにその要求の満足される場所が生活の方に転移するとしても、転移したら転移したとしての詩心の表現物、即ち詩は要求されるのである。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち実在は人間の思考作用に入り来るや空間化され、而してその空間化されし実在に於ては、主語と客語は常に転換され得る。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "首尾よく一匹はそこに仰向きに転んだ。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も該ノートの論旨を心得てゐれば心得てゐないよりは幾分宿命をいい方に転向させることが出来るといふものであらう。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が此の中学に転任と定つた際、最初此の学校のことゝして聞いたのはそのことであつた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場が運転するためには、先づ発明家が製作品の設計を渡さなければならぬ。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "スチクレスタードの野の戦の始まる前に、王は部下の将卒の団欒の中で、フィン・アルネソンのひざを枕にしてうたた寝をする。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁は興奮に駆られて自ら歓びをたしなめる下からまた盛り上る歓びにうたた反側しながら呟いた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、十一時から十二時頃までは安楽椅子でうたた寝をしてから寝室へ行くという不思議な癖があった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "先年ドイチュランド号が二十三浬一五の速力を得たに比較して少々劣るようであるが、これは途中で霧に逢うたためだとの事である。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
