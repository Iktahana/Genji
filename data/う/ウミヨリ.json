        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さうして、その青森県の日本海寄りの半島たつた一つが津軽なのである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その海寄りの岸のところに突っ立って水をながめている小僧、そのうしろ姿がどうもそれらしく思われるので、半兵衛があわてて追っかけました。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつは風が甚だしく寒いので、更に品川の町に入り、海寄りの小料理屋へ上って、午餐を喫いながら硝子戸越しに海を見た。",
              "citation": {
                "source": "一日一筆",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "終日濤声に包れていたのであるから普通なら別に驚かないのだが通りかかった其処は左がやや傾斜を帯びた青い麦畑で右手海寄りの方は一寸した窪地を置いて直ぐその向うに小高い雑木林の丘がある許り、その附近暫く浪や海の姿に遠のいている場所であった。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "小山ながら海寄りの平野に孤立して起つた樣な山なので、この頂上からは四方の遠望が利く。",
              "citation": {
                "source": "樹木とその葉",
                "author": "或る日の晝餐",
                "note": "青空文庫"
              }
            },
            {
              "text": "海寄りの斜面へでると、とつぜん吹き倒されてしまひさうな風の中に立つてゐる。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩室の娘たち　毒消し部落は角田山の海寄りであるが、角田と弥彦をとりまく平野側には蟻のはいでる隙もなく新潟芸者の産地がギッシリたてこんでいるのである。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第二回　富山の薬と越後の毒消し≪富山県・新潟県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "山地ではさすがにそのころから二三メートルの積雪を見るが、海寄りの平地では十年前まで二三メートル積った雪がせいぜい一尺だという。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第二回　富山の薬と越後の毒消し≪富山県・新潟県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あん子はコンクリの石段に腰をおろし、蟲の聲と鹽ぱい海寄りの風を頬に受けて坐つた。",
              "citation": {
                "source": "神のない子",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "富山湾に面した海寄りの地方に、藁を材にし紺の麻糸で編んだ大きな夜具包があります。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海寄りの小さな町でありますが、染物に用いる型紙の産地となって、名を全国に広めました。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
