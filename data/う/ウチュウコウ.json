        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "多くの旅行客で賑わう宇宙港のロビーでは、月から到着したばかりのシャトルがモニターに表示されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "宇宙港の近くに住む子供たちは、毎日空を飛んでいくロケットを眺めながら育った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "老朽化した宇宙港を改修し、垂直離着陸型の新型機に対応させる工事が始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "宇宙港で負傷したのでしょうか？",
              "citation": {
                "source": "親友たち",
                "author": "C. スミス　C. Smith",
                "note": "青空文庫"
              }
            },
            {
              "text": "「宇宙港で傷つけられたりはしませんでした。",
              "citation": {
                "source": "親友たち",
                "author": "C. スミス　C. Smith",
                "note": "青空文庫"
              }
            },
            {
              "text": "宇宙港に着陸した際の事と、その前数日間の飛行についてならいかがでしょう。",
              "citation": {
                "source": "親友たち",
                "author": "C. スミス　C. Smith",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
