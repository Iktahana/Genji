    },
    "definitions": [
      {
        "index": 1,
        "gloss": "seller",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "売り主はその土地を20年間所有していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "売り主と買い主が合意に達した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "売り主の印鑑証明が契約に必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "阿片粉末の売り主はどこの薬局か。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「親分は頻りに鶏の売り主を詮議していなすったが、なにか眼を着けた事でもあるんですかえ」と、庄太はあるきながら訊いた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大森の鶏",
                "note": "青空文庫"
              }
            },
            {
              "text": "売り主も大事にしているんですから、その買い手がきまり次第、持って来てお目にかけます。",
              "citation": {
                "source": "半七捕物帳",
                "author": "冬の金魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "芭蕉と其角の短冊は問題にされなかったが、金魚の方は心あたりがあるというので、四、五日経ってから惣八は再びその模様を探りに行くと、其月はその売れ口があると云ったので、惣八はよろこんで帰って、早速その売り主の元吉というのを連れて行くことになった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "冬の金魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯のなかで生きていられるといっても熱湯ではとても堪まらないのであるから、売り主はいいくらいに湯加減をして置いて、さてその金魚を放してみると、二匹ながら紅い尾を振って威勢よく泳ぎまわったので、其月も得心した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "冬の金魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "といって、あの宗匠の家の出入りを止められると、これからの商売にもちっと差しさわることもありますので、よんどころなしに御無理ごもっともと一旦は引きさがって来て、とりあえず売り主の元吉にその話をしますと、元吉も素直には承知しません。",
              "citation": {
                "source": "半七捕物帳",
                "author": "冬の金魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "かさねがさね驚いているのでございます」「一体その売り主の元吉というのは何者だえ」「本所の金魚屋の甥でございまして、自分は千住に住んで居ります」と、惣八は説明した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "冬の金魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "売り主の話によると、これらの小さい潜水艇も、前にはずいぶんこの方面で活躍したそうである。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、なんども競売をくりかえし、なんでも、十何回目かに、今の売り主が一たばにして買ったんだそうであるが、それはとほうもなくやすい値段だったそうである。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "売り主が、そういうんだから、うそではあるまい。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがその目算がはずれて売り主の方から破談を云い出された。",
              "citation": {
                "source": "半七捕物帳",
                "author": "仮面",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の村人が、あまり値段が高いじゃないかと注意したら、売り主の曰く、そりゃ些ア高いかも知んねえが、何某さんは金持だもの、此様な時にでも些ア儲うけさして貰わにゃ、と。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　それだけのことでは、その売主についてもなんの手がかりを見いだすことも出来なかった。",
              "citation": {
                "source": "兜",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「薄利多売主義」とか「負けぬ代りに安い」という看板は、こんなのに比べるととても廻りクドくて問題にならぬ。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、たばこ吸事｜被二禁断一訖、然上は、商賣之者迄も、於レ有二見付輩一｜者、双方之家財を可レ被レ下、若又於二路次一就二見付一者、たばこ並売主を其在所に押置可二言上一、則付たる馬荷物以下、改出すものに可レ被レ下事。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、たばこ吸事｜被禁断訖、然上は、商賣之者迄も、於有見付輩者、双方之家財を可被下、若又於路次就見付者、たばこ並売主を其在所に押置可言上、則付たる馬荷物以下、改出すものに可被下事。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の売主を尋ねてみると、果して松本順造だった。",
              "citation": {
                "source": "自由人",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "此辺の田舎でも、些とまとまった買物を頼めば、売主は頼まれた人に、受取は幾何金と書きましょうか、ときく。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して薪の売主は、衆議院議員選挙権を有って居る、新聞位は読んで居る男である。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄利多売主義のためにまわす。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま中村屋には職長級の人が十四五人いるが、いま年少な君達も、やがて職長となり、技師長となり、販売主任となるべきであって、職長学の修業は、常に心がけて、だんだん自分をその器につくり上げて行かなくてはならない。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "為後日一札仍て如件　天保七申十二月　　　日成行村売主　　儀十郎印請人　　弥右衛門印同　　政五郎印大久保村買主　　儀左衛門殿　右の「上十五日」とは、月の上半に右両村内に生じた死牛馬の権利を云ったものなのである。",
              "citation": {
                "source": "牛捨場馬捨場",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、買主が大佐、売主が私。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "売物は売主と同一のもの、但し、新品同様、履行は、昭和二十九年。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "滔々たる世俗の流輩が重金説・保護主義・専売主義等に心酔したるももとよりうべなりというべし。",
              "citation": {
                "source": "将来の日本",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "これと比べて違ったところはわずかに一点、駒では売主が愚直の農民で、買手が横着欲深の馬喰なるに反し、田では買手がさらに無思慮な小作人であることである。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "悉皆買おうと申込んだが、売主がおらず探しても現れず、ついに惜しい別れをしてしまった。",
              "citation": {
                "source": "全羅紀行",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "明朗ロッパを写す会といふ、読売主体の催し。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "読売主催選挙と府民の夕。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その士格の売主は、小普請目見得格で小牧甚三郎という御家人、一人娘があるから、聟の形式をもって継いでくれれば、万端都合がいいという。",
              "citation": {
                "source": "脚",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
