[
  {
    "uuid": "ddcc598a-8164-51f9-a8be-29eee52e166e",
    "entry": "烏啼",
    "reading": {
      "primary": "うてい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
