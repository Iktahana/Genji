  {
    "uuid": "eb5eaba1-986c-57ee-bffc-fdf8b6a0ca0b",
    "entry": "ウテイ",
    "reading": {
      "primary": "うてい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "其中漫筆　　酔中戯作一首あなた　ドウテイわたくし　シヨヂヨよ月があかるい虫のこゑ　　　其中漫筆□私俳句とは――□リアリズム精神　　自由、流動、気魂。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの日、私の妻は、アメリカン・ビユウテイのスキー・ジヤケツに身を固め、頭には雪のやうに真白なターバン帽子をいたゞき、ほのぼのとして「春風」に打ち乗つた。",
              "citation": {
                "source": "バラルダ物語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが真実に子供たちの運命を予言しうるものとすれば（実験の結果によれば――と当代の心理学者が権威をもって発表する）コノ指数ニ満タザルモノハトウテイ社会有用ノ人間タルコトヲ得ズ。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは私でなくては図星を指す者は居ないのでございますが、この犯人は、かの憎むべき奇賊烏啼天駆の仕業でございます」「なに、ウテイ・テンクとは何者です。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺だって自分の事を振返ってみて、オヤと思う事があるものだから、連中の事だけじゃないんだ、自分もだよ……つまり自分も人も、見ていると、なんだかキマリが悪くなってしまって、どいつもこいつも、トウテイ救われねえという気がするんだ。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
