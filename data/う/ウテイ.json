    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ひとが笑へばにやにやと、猫のなきまね、烏啼き、たまにやべそかき赤い舌、嘘か、色眼か、涙顔。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "さても笑止や、垣根のそとで障子張るひと、椿の花が上に真赤に輝けば張られた障子もくわつと照る、烏勘左衛門、烏啼かせてくわつと吹くよかよか飴屋のちやるめらもみんなよしよし、粉嚢やつこらさと担いで、禿げた粉屋も飛んでゆく。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、その末にこの頃は談林発句とやらが流行するから自分も一つ作って見たといって、「月落烏啼霜満天寒さ哉――息を切らずに御読下し被下度候」と書いてあった。",
              "citation": {
                "source": "斎藤緑雨",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時代を離れては緑雨のこの句の興味はないが、月落ち烏啼いての調子は巧みに当時の新らしい俳風を罵倒したもので、殊に「息を切らずに御読下し被下度候」は談林の病処を衝いた痛快極まる冷罵であった。",
              "citation": {
                "source": "斎藤緑雨",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏啼霜月夜寥寥囘首離城尚未遙正是思家起頭夜遠鐘孤棹宿楓橋　彼もまた鳴らぬ夜半の鐘を聴いたものと思はれる。",
              "citation": {
                "source": "放翁鑑賞",
                "author": "その六　――放翁絶句十三首和訳（つけたり、雑詩七首）――",
                "note": "青空文庫"
              }
            },
            {
              "text": "○平野秀吉氏の唐詩選全釈には、「後、張継、再び此に来り、重泊楓橋と題して、白髪重来一夢中、青山不改旧時容、烏啼月落江村寺、欹枕猶聴夜半鐘と詠じたが、詩品も劣り、且つ全唐詩にも載せざるを見れば、或は後人の偽作か」としてある（簡野道明氏著『唐詩選詳説』にも之と同じことが書いてある）。",
              "citation": {
                "source": "放翁鑑賞",
                "author": "その七　――放翁詩話三十章――",
                "note": "青空文庫"
              }
            },
            {
              "text": "近ごろ孫仲益の楓橋寺を過ぎる詩を読むに、云ふ、白首重来一夢中、青山不改旧時容、烏啼月落橋辺寺、欹枕猶聞夜半鐘と。",
              "citation": {
                "source": "放翁鑑賞",
                "author": "その七　――放翁詩話三十章――",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏啼ものの「いもり館」である。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏啼天駆という怪賊があるが知っているかね」「ああ、怪賊烏啼か。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏啼のことなら聞いたことがあるが、若いくせに神出鬼没の悪漢だってね。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体どんな顔をしているのかな、その烏啼というやつは……」「それがよく分らない。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏啼と名乗る彼に会った者は誰もない。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし脅迫状などで、烏啼天駆の名は誰にも知れ亙っている」「捜査課長ともあろう者が、そんなぼやぼやしたことで、御用が勤まると思うのか」「何をいう。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪賊烏啼　そのあとで課長は溜息ばかりついていた。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この二つの事件に、怪賊｜烏啼天駆が関係しているとは、目賀野の話で始めて分った。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありとあらゆる検察力を発揮しないと、烏啼を引捕えることは出来ない。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は早速、この事件に烏啼天駆が関係していることを帆村に語って、帆村の助力をもとめた。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきあなたから伺った話から誘導すると、その美貌の男こそ、烏啼天駆でなければならないと思うんですが、課長さんの意見は如何ですか」　帆村は、大胆なことをいった。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれが烏啼なら、あのとき逃がすんじゃなかった。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの広告主の一人は烏啼天駆であり、もう一人はやっぱりあの女だったんですよ」「ふうん、なるほど、そういえばそうかもしれない」「あの二人は、時に一緒になって働きました。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれはお化け鞄が紛失したのに困った烏啼が、小山すみれを唆のかして、猫又を利用した新規の起重装置をこしらえるように頼んだ。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろその後、烏啼の消息がさっぱり分らないので、油断はならないとのことであった。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし田鍋課長が、彼に自慢らしく語ったところでは、烏啼はあのＲ大学の研究所のラジウム保管室の向いの研究室の助手に化けこんでいて、あのラジウムを巧みに盗み出した。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋草はそれを持って出て、某飛行場へ急行し、烏啼の一味である矢走という男をして、その品物を飛行機でもって三原山の噴火口に投げおとさせたと認める。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の美男美女というのは、この烏啼と秋草らしいといわれる。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この奇竜丸の救援に赴いた官憲は、はからずも、この船の構造や、乗組員の様子に疑惑を持ち、厳重に取調べた結果、この船こそ怪賊｜烏啼天駆の持ち船だと分り、そして天罰とはいえ重傷を負っている烏啼を、遂に他愛なく引捕えた。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "このことは早速東京へ無電で連絡され、田鍋課長は再びこの大島へ急行して、烏啼を受取った。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏啼はもう観念したものと見え、すべてをべらべらと喋った。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
