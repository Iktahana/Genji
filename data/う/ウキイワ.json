        "examples": {
          "standard": [
            {
              "text": "川の中ほどに浮岩があり、子供たちはそこを飛び石にして対岸へ渡った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "干潮の時だけ姿を現す浮岩に、フジツボが密集していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "漁師は浮岩の周辺に魚が集まることを知っており、そこへ網を仕掛けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
