    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "宮様のお泊まりにあてられるという三留野の普請所では、小屋がつぶれて、けがをした尾張の大工たちが帰国するところであるという。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "本腰にかゝるや、業を昼夜兼行に急いで、本多佐渡守の如き明け七ツに「御普請所御出候ツルママ諸大名衆不残提灯御タテサセ丁場々々ヘ御出被成候」といふ、盛観のことだつた。",
              "citation": {
                "source": "東京の風俗",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "古くから請負場または請所ともいっている。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
