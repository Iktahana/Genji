[
  {
    "uuid": "2f8f7b2d-8c4c-51ec-884d-dbd19423fe84",
    "entry": "占い師",
    "reading": {
      "primary": "うらないし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
