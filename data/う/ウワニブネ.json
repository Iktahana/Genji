        "examples": {
          "standard": [
            {
              "text": "江戸時代、上荷船が大型船から荷物を移して岸へ運んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "上荷船の船頭は潮の満ち引きを見極めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "複数の上荷船が一度に出動して荷物の移送を急いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "菱垣番船、伏見の過所船、七村の上荷船、茶船、柏原船、千石、剣先、麩粕船。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "長崎ものがたり",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に紛れて上荷船で密貿易の品を運び上げ、よくないことでもしていたのに違いない。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "長崎ものがたり",
                "note": "青空文庫"
              }
            }
          ]
