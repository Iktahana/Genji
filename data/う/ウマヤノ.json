        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ウマヤノ　マエノ　ヒザシガ　ヒニ　ヒニ　アタタカク　ナツテ　クロイ　土カラ　白イ　ユゲガ　ノボリハヂメテ　ヰマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ピイチク　ピイチク　ピイチク　ピイチク」　ヒバリノ　コヱハ　タカイ　ソラカラ　キンノ　アメノヤウニ　フツテ　キテ、ウマヤノ　ソバノ　ナタネノ　マワリニ　フリソソギマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "花タチハ　キイタ　コトノ　アル　コヱダト　オモツテ　ミルト、ウマヤノ　マドニ　大キナ　ヤサシイ　ウマノ　カホガ　ノゾイテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ　コノ　テフテフモ　オハネガ　ジヨウブニ　ナルト　カゼニ　ノツテ　ウマヤノ　ヤネヲ　コエタリ、ヲガハノ　ウエニ　イツテ　ミタリ　シマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　アカチヤンハ　モウ　オメメヲ　アイタカ　ミテ　キテ　チヨウダイ」　テフテフハ　スグ　ウマヤノ　マドカラ　ナカニ　ハイツテ　イキマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
