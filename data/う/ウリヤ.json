[
  {
    "uuid": "b2ceae01-a0d0-5040-b04a-8fb46f4e2409",
    "entry": "売り家",
    "reading": {
      "primary": "うりや",
      "alternatives": [
        "うりいえ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "house for sale",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その売り家は築30年で老朽化している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "売り家を見に行くことになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "近所に売り家が増えて不動産が活発化している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "すると、その家は堅く閉まって、店頭に売り家の札がはってありました。",
              "citation": {
                "source": "青い時計台",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンドン売り家が出ている。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間が一般にひどい不景気で、日本橋の大きな問屋筋でも、倒産した店が少なくないという話だし、町をあるけば「店じめいにつき投売り」とか、閉めた店の大戸に貼った「売り家」の字などが眼につかないことはなかった。",
              "citation": {
                "source": "さぶ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのよく日、町の子の克巳は、なすや、きゅうりや、すいかを、どっさりおみやげにもらって、町の家に帰っていったのでした。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう地上では稲を植えるわけにはいかないし、お芋やきゅうりやなすをつくることもできないです。",
              "citation": {
                "source": "三十年後の東京",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "りんごでもかきでも、一週間でりっぱな実となります」「おどろきましたね」「そんなわけですから、昔とちがい、一年中いつでもきゅうりやかぼちゃがなります。",
              "citation": {
                "source": "三十年後の東京",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月頃はたけにはへた、おくればへのまうりや、きうりの如し。",
              "citation": {
                "source": "手紙",
                "author": "慶応三年六月二十四日　乙女、おやべあて",
                "note": "青空文庫"
              }
            },
            {
              "text": "「銭はこのつぎだよ」「はい」「用がないからゆけよ、おれはここで八百屋の豊公を待っているんだ、あいつおれの犬に石をほうりやがったからここでいもをぶんどってやるんだ」　チビ公はやっと虎口をのがれて町へはいった、そうして悲しくらっぱをふいた。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "地上を攻撃されるおそれがあるんなら、地上でおちおち畑をつくってもいられないでしょう」「そうですとも、もう地上では稲を植えるわけにはいかないし、お芋やきゅうりやなすをつくることもできないです。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして女装してりゃ、誰も喧嘩をうりやしませんし、仲間の仁義で血の雨をくゞる必要もありませんや。",
              "citation": {
                "source": "日月様",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "露むすぶ庭の荻原霜枯れて、籬の菊の枯れ枯れに、うつろふ色を御覧じても、御身の上とや思しけむ、仏のおん前へ参らせ給ひて、『天子しやうりやう、じやうとうしやうがく、一門亡魂、とんしよう菩提』と祈り申させ給ひけり。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "とんぼが、きゅうりや、すいかの大きな葉の上に止まったり、棒の先に止まったりしているほか、だれも人影がなかったのです。",
              "citation": {
                "source": "薬売り",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういえば、昔の絵にかかれた、さびしそうな景色や、笠や手ぬぐいをかぶって働く百｜姓の姿や、みじかいつつそでの着物をきて、ぞうりや、げたをはいた子供などは、どこにも見られなかったのでした。",
              "citation": {
                "source": "雲のわくころ",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、大きななすや、みごとなきゅうりや、野菜物はなんでもありますから。",
              "citation": {
                "source": "公園の花と毒蛾",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は二、三日後、町の市場の、にんじんやトマトやきゅうりやキャベツなどが山のように積まれた中で、また彼女を見かけた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "テーブルの上にはろうそくが危うく燃え残って、大方からになったウォートカのびんや、さかずきや、パンや、コップや、きゅうりや、もうとっくに飲みほされた茶器などがのっていた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらから見ると、なすや、きゅうりや、大根などが、店先にならべられて、午後の赤色をした日の光を受けていました。",
              "citation": {
                "source": "眼鏡",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし東京へ移ってから、子供が大ぜい生れたりして、家内が狭くなった上に、貯財も少し出来て来たので、夫人のすすめで売家を一軒買うことにした。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……薬臭い寂しい邸は、冬の日売家の札が貼られた。",
              "citation": {
                "source": "茸の舞姫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "家主は下の中の間の六畳と、奥の五畳との二間に住居いて、店は八畳ばかり板の間になりおれども、商売家にあらざれば、昼も一枚｜蔀をおろして、ここは使わずに打捨てあり。",
              "citation": {
                "source": "化銀杏",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この市隠荘はお絹等姉妹の父で漢学者の荒木蛍雪が、中橋の表通りに画帖や拓本を売る蛍雪館の店を開いていた時分に、店の家が狭いところから、斜向うのこの露路内に売家が出たのを幸、買取って手入れをし寝泊りしたものである。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　章三は今朝田村で見た新聞の売家広告を想い出した。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "なれども御三代の当主と来ては、いやはや何と言うか、売家と唐様で書く三代目どころの騒ぎではござりませぬわい。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊万里は勿論、途上、空家貸家売家がよく目につく、不景気は深刻である。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "バラツク売家を見にゆく、其中庵にはよすぎるやうだが、安ければ一石二鳥だ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "売家があるといふので問合にいつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月廿二日今日も家の事で胸いつぱいだ、売家が二つ三つある、その一つが都合よければ、其中庵も案外早く、そして安く出来るだらう、うれしいことである。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀座裏に、芸妓家の売家があること、……しかし、貴女からのご返事があるまでは、空なものでありましたが、お手紙ですっかり勇み立ち、僕もちょっと見て参りました。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄色い霧に鎖された家の窓には売家と書いた赤い札が貼ってあった。",
              "citation": {
                "source": "日蔭の街",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "自薦他薦の養子の候補者は、選りどり見どりだが、苦労を知らない大家の次男三男を養子に貰ったところで、よくいう、初代が『初松魚伊勢屋の前をすぐ通り』二代目へ来て『二代目の伊勢屋の前に初松魚』、三代目となると『売家と唐様で書く三代目』という川柳の通りに、悪くすると家の落目を招くにきまっている。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
