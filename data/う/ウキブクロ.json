          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "海へ行く前に、子供たちの浮き袋に空気が漏れていないか念入りに確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "波打ち際で色鮮やかな浮き袋にしがみつきながら、冷たい水に足を浸してはしゃぐ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "派手な縞模様の浮き袋を肩にかけて、意気揚々と砂浜を歩いていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「なんにも見えない」「救わなきゃならない、浮き袋と縄を投げこめよ」と富士男はいった、そうしてまたさけんだ。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「気をつけろよ、岩が多いから乗りあげるかもしらん、そのときにあわてないように、浮き袋をしっかりとからだにつけていたまえ」　富士男は人々に注意した。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし綱がとどかなかったら、漁師は浮き袋でも木箱でもなんでも浮く物を投げてよこすだろう。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "船に備えつけの浮き袋を投げてやると、それにつかまった。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は彼等はエスキモーが爲す如く、銛に長き紐を付け其｜端に獸類の膀胱抔にて作りたる浮き袋を括り付け置きしならんと考ふるなり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エスキモーは斯かる浮き袋に息を吹き込み、且つ其氣の漏るるを防ぐ爲に栓を爲るの便を謀りて、角製の管を是に付け置く事なるが是と等しき物武藏西ヶ原貝塚及び下總柏井貝塚より出でたり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "余はコロボックルの遺物たる是等の角噐は實に浮き袋の口として用ゐられしならんと信ずるなり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "網形の押紋有る土噐片、骨器の刺さりたる大鯛の頭骨、浮き袋の口と思はるる角製の管、皆人類學教室の藏品なり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして溺れかかっている者が、つい眼の前に浮き袋のあるのをみつけたときのような表情で、それほんと、ときき返した。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カツオノエボシは、綺麗な形をしたゼラチン質の浮き袋を紫色の虹のように輝かせながら、ひっくり返ったり元に戻ったりしていた。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして奴の背骨近くの浮き袋が空気で膨れてしまえば、もう深く潜って死ぬことはできなくなる。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、うきぶくろにつかまって、泳ぎなさいといったのだよ。",
              "citation": {
                "source": "赤土へくる子供たち",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "白昼の往来の明るさからいきなり変つたその暗さに私はまごついて、覚束ない視線を泳がせたが、壁に掛つたベートーベンのデスマスクと船の浮袋だけはどちらも白いだけにすぐそれと判つた。",
              "citation": {
                "source": "木の都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い名曲レコードの売買や交換を専門にやつてゐるらしい店の壁に船の浮袋はをかしいと思つたが、それよりも私はやがて出て来た主人の顔に注意した。",
              "citation": {
                "source": "木の都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなものを飾つて置いてもかへつて後悔の種ですよと、壁に掛つた船の浮袋を指して、しかしわたしもまだ五十三です、……まだまだと言つてゐるところへ、只今とランドセルを背負つた少年がはいつて来て、新坊、挨拶せんかと主人が言つた時には、もうこそこそと奥へ姿を消してしまつてゐた。",
              "citation": {
                "source": "木の都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから船橋の前にブラ下げて在った浮袋を一個引っ抱えて上甲板へ馳け降りた。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく吾輩の処へ議論を吹っかけに来る江戸ッ子の若造で、友吉とも心安い、来島という柔道家だったが、これも猿股一つになって、真黒な腕に浮袋を抱え込んでいた。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "水夫も火夫もみんなポンプに掛り切っていて手が足りないんですから……浮袋を離してはいけませんよ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "水着や浮袋やサンド・パラソルを本日お送りいたしておきました。",
              "citation": {
                "source": "〔婦人手紙範例文〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "浮袋は勿論私だけの必要品ですわ、今年こそは貴女にクロールを教へて戴かなければなりません――屹度、屹度それまでには爽々しい水着姿の貴女の御様子を拝見出来るものと祈つて、そんなものをとりそろへたのです。",
              "citation": {
                "source": "〔婦人手紙範例文〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "浮袋がなければ水のなかへ入れないなんて人、ずゐぶん滑稽でせう。",
              "citation": {
                "source": "〔婦人手紙範例文〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいえ、船尾の浮袋へ、差通されたように引っかかって、ロープで船に引かれるように水びたしになっておりました」「ヨットは最初誰が見つけましたか？",
              "citation": {
                "source": "死の快走船",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "間違いないようですよ」　やがて捕鯨船は、両の舷側に大きな獲物を浮袋のようにいくつも縛りつけて、悠々と引きあげて行った。",
              "citation": {
                "source": "動かぬ鯨群",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人はオリーブ色、一人は紅色の海水着を着た、どちらも背丈のすんなり高い若い女が、手に褐色の浮袋をかゝへ、並んで松林の中の別莊に歸つて行くのが繪よりも美しかつた。",
              "citation": {
                "source": "滑川畔にて",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく見ると、大柄な男が、眼をつぶつて、浮袋の上に身動きもしない。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の様子が妙だつたので、突差には、その場のありさまが判然と呑みこめなかつたが、浮袋のわきに、酒場の名前をペンキで書いた、白い板が浮いてゐるのを眼にして、直吉は、なるほど、生きてゐる人間の商売なのかと、吻つとすると同時に、その男の悠々とした、たゞよひかたが、ひどく気に入つた。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "細長い浮袋には、長い縄がついてゐて、石崖の杭に結びつけてある。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　やがて、博士の涙とともに、浮袋が投げられた。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちやんと用意して待つてゐた各新聞社の寫眞係りが、籐椅子を据ゑ、いかにも美術的の趣向だといふやうに浮袋を側に立てかけて、扨て自分を腰かけさせた。",
              "citation": {
                "source": "貝殼追放",
                "author": "新聞記者を憎むの記",
                "note": "青空文庫"
              }
            },
            {
              "text": "余が又土偶の足、半磨石斧、三｜月二十二｜日に獸牙製曲玉の一｜種、略してキバマガ（第二圖ハ參照）を出し、同月二十六｜日に、鹿角製浮袋の口（第二圖イ參照）を出し、四｜月三｜日に土偶胴部（第壹圖ハ參照）を出した等が主なる物。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "權現臺の懷古",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
