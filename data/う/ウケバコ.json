    "definitions": [
      {
        "index": 1,
        "gloss": "box set at a gate of a home or near the front door, used for receiving deliveries of newspapers, mail, milk, etc.",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "玄関先の受け箱に新聞が届けられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "牛乳瓶を受け箱から取り出して冷蔵庫に入れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "郵便受けがいっぱいだったので、予備の受け箱を設置した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "格子から予がのぞくとたんに、板塀に取り付けてある郵便受け箱にカサリという音がした。",
              "citation": {
                "source": "水籠",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵便受箱に、生きている蛇を投げ入れていった人がある。",
              "citation": {
                "source": "悶悶日記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日に二十度、わが家の郵便受箱を覗き込む売れない作家を、嘲っている人の為せる仕業にちがいない。",
              "citation": {
                "source": "悶悶日記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "驛で新聞買つたら、それを、實家の郵便受箱に知らぬふりして、投げ込んで置かうか、とさへ思つた。",
              "citation": {
                "source": "當選の日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "門の所で、執事をさきに中に行かせ、郵便受箱に、自分宛、僕宛、秋川駿三宛のさつきの脅迫状を投げこんだのだ。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "随分永らくかきませんでしたね、十九日に書いたぎり何てひどかったのでしょう、でも私は今日は今日はと思っていたのよ、カタンカタンとガラスをあげたりおろしたりして、度々受箱を見ていたのよ、でも来やしない。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵便受箱へ入れておいて下さいというつもりで高窓をあけたら、タオル寝間着の若い男のひとが立っていて、妙にひそめた声と左右に目を配った挙動とで、「一寸ここまで来て下さい」と云う。",
              "citation": {
                "source": "このごろの人気",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "最前列の女が席を立ってそれを舞台の上、演壇の下に出されてる投書受箱へ入れてきた。",
              "citation": {
                "source": "三月八日は女の日だ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな受箱が少しの水を待っている。",
              "citation": {
                "source": "日田の皿山",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
