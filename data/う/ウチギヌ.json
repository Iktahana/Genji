          "literary": [
            {
              "text": "それからずつと探りまはすと、絹らしい打衣の袖にさはる。",
              "citation": {
                "source": "好色",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "侍従は平中の鼻の先に、打衣一つかけた儘、しどけない姿を横たへてゐる。",
              "citation": {
                "source": "好色",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年賀茂祭検非違使所相具之庁下部等、或付鏡鈴等、或著錦紅打衣。",
              "citation": {
                "source": "放免考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……晩頭明兼来、祭間庁下部装束可制事、錦紅打衣、金銀類、如鈴鏡風流事、可制止由仰下了。",
              "citation": {
                "source": "放免考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "奏、祭間庁下部装束過差事、可制止色々、金銀錦紅打衣、如鏡鈴風流之類也。",
              "citation": {
                "source": "放免考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、薄紅梅に、青摺の打衣を襲ねた裳からこぼれた得ならぬ薫りが、いつまでも、自分のあとを追ってくるような気もちにとらわれた。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
