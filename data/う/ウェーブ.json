        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "逆転ホームランが飛び出した瞬間、スタジアムの観客席で巨大なウェーブが自然発生的に巻き起こった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "外野席の端から始まった熱狂のウェーブが、バックネット裏を通ってスタンドを一周した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "選手たちの健闘を称えるために、観客たちは総立ちになって何度もウェーブを繰り返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
