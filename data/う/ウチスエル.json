        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "重い漬物石を樽の上にしっかりと打ち据え、味が染み込むのを待つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "庭の土台となる大きな石を、職人がびくともしないように打ち据えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "柱の根元を楔で打ち据え、地震でも倒れないように固定した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
