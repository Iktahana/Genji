        "examples": {
          "standard": [
            {
              "text": "寒い冬の夜、白菜とタラを入れた魚すきを家族みんなで囲んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "京都の料亭で食べた魚すきは、だしが上品に効いていて魚の甘みが引き立っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「今夜は魚すきにしようか」と母が言い出し、冷蔵庫の魚介類を全部鍋に入れることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "織田信恒子爵来り、明日満州へ出発とのこと、サンボアへ案内し、南の万花てふ魚すきへ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
