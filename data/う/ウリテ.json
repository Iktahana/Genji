  {
    "uuid": "b05aaecb-16ed-5450-88de-24f17f22ed30",
    "entry": "売手",
    "reading": {
      "primary": "うりて",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
