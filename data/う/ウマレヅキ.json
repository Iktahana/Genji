        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "生まれ月が早い子どもほど体格がよく、スポーツで有利になりやすいという研究がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女の生まれ月は桜の咲く四月で、名前もその季節にちなんでつけられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "保険の申込書には生まれ月まで細かく記入する欄が設けられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "お静は田町へ行って綾衣の生まれ月日を言うと、占い者は又もひたいに皺を寄せて、この女には剣難の相があると言った。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "美奈子は高杉と生まれ月までおなじ同年齢だ。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに高村さんは美代子さんとおなじ年齢です」　日比谷の説明を受けて、「お生まれ月は？",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "高村恵子の生まれ月は、後藤美代子のそれと同じだった。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "うかがってみるとおなじ年齢で生まれ月がおなじで、背丈もおそらく五ミリと違わないでしょう。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "栄さん結婚十五年というので、何婚式になるんだろうと当用日記のうしろを見たら、これまで生れ月の宝石だの結婚記念などのあった欄が、すっかり「ス・フの知識」に変っていた。",
              "citation": {
                "source": "寒の梅",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○栄さん十五年（結婚）と云い自分たち足かけ八年目故この日記の家庭のところ見たら、もと生れ月の宝石や結婚記念日を書いてあったところに、スフの知識というのがわりこんで来ていて、さがしているのは消えている。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「生れ月は――」「措かっしゃい。",
              "citation": {
                "source": "妖婆",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月の生れ月の宝石は紫水晶だからと、素子はその耳飾りを見つけて来てくれた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダムのお嬢さんにたのまれたのですけど、生れ月日の下へサインして、感想欄のところへ何か感想を書いて下さいッて」　なるほど署名欄は三百六十五日の日附になっていて、ところどころ生れた月日の下に誰かの署名がある。",
              "citation": {
                "source": "九段",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "閏があつてもなくても、生れ月が來れば、生れるに決つてゐるぢやありませんか。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "血塗られた祝言",
                "note": "青空文庫"
              }
            },
            {
              "text": "年は同じで、生れ月は彼のほうが半年ほど早かったが、彼は私を兄のように扱ってくれました。",
              "citation": {
                "source": "失蝶記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "乳が同じであるし、生れ月も近いしおまけに看病のしやすい年恰好だから、本当ならうつして貰ってもさせるところなのだが、和助のは性が悪いらしいということで、向うから近づかないようにと注意されていたのである。",
              "citation": {
                "source": "柳橋物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一緒に出てきた紅錦の守り札袋――それには、紺紙金泥の観音の像に添えて、世阿弥とお才とが仲の一女、お綱の干支生れ月までが、明らかに誌してあった。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分自身にさえ、間違いのない生れ月や日を確かめる必要などは一生の間でもめったにありはしない。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は一ヶ月の給料をはたいて、初代の生れ月に相当する、電気石をはめた指環を買求めて、彼女に贈った。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
