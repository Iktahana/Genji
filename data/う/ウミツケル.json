        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "産卵期の鮭は海から川を遡上して卵を生み付ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "亀は砂浜に卵を生み付けるために上陸する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ニワトリが産卵期に卵を生み付ける場所として、巣箱を用意している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "めすの鮭は卵をうみつけるときに、自分の頭で川底の砂利を二尺四方くらゐ穴を掘るさうである。",
              "citation": {
                "source": "故郷を辞す",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うん、今あの穴の中へ子供を生みつけるんだよ。",
              "citation": {
                "source": "畫家とセリセリス",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ第一に、母胎そのものから、胎児を畸形に生みつける原因を除去するといふことである。",
              "citation": {
                "source": "日本人とは？",
                "author": "――宛名のない手紙――",
                "note": "青空文庫"
              }
            },
            {
              "text": "これから誰かに生ませる女の子を、さういふ風に生みつけるといゝわ。",
              "citation": {
                "source": "女人渇仰",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "更にシェストフはこの「敵意ある屈従」を独鈷にとって、さもチェーホフが唯物論の苛酷な脅迫のうちに新型の「歯痛の快感」を見出していたかの如き印象を、われわれに生みつけることをも忘れない。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "田圃に田植えの準備がはじまって、苗代水が流れだすと鯰は大きな流れや深い淵から、細流や田のなかへ遡り込み、水藻の葉などに卵を生みつける。",
              "citation": {
                "source": "鯰",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ろ、お前達は、みんなして、こんな所に、こんな隅つこに、親父のわからない子供を生みつけるんだ。",
              "citation": {
                "source": "疵だらけのお秋（四幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "きりぎりすは秋に、土のなかに卵を生みつけるが、生長期の例のくさむらの宮殿にいるころは、却々はしこい上に神経過敏で、僕らの足音や、くさむらが不意に不自然にうごいたりすると、鳴き歇んでしまい、鳴き止むとすぐに枝を移って前の位置を変えてしまう。",
              "citation": {
                "source": "螽※の記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、ことばというものを生みつける白秋のことでは、どういう頭もかなわなかったごとく、二十一歳の私が活字の威厳と色彩の発見について、白秋をえらい人だと心に置いたことも今日とかわらなかった。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰でも彼を許し、これを愛さずにいられない風であり、そして柔しくしたいという好奇を対手方に、そっと生みつけるような男である。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "羽根が黒くて腰の黄色い小さな蜂が、柔らかい若芽の茎の中に卵を産みつけると、やがて茎の横腹が竪にはじけ破れて幼虫が生れ出る。",
              "citation": {
                "source": "蜂が団子をこしらえる話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の所有する珠貨は、玳瑁が浜辺で一度に産みつける卵の数ほど多い。",
              "citation": {
                "source": "南島譚",
                "author": "幸福",
                "note": "青空文庫"
              }
            },
            {
              "text": "近海には、鮪、サワラ、鯨が居り、青海亀や※瑁が砂原へ上がってきて卵を産みつける。",
              "citation": {
                "source": "ボニン島物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "抱卵した鰍は、流れの強い底石の、それが矢倉に組んである石の天井を捜して、卵を産みつけるのである。",
              "citation": {
                "source": "鰍の卵について",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、後からその矢倉石を発見した体力のある鰍の夫婦は、先口の鰍夫婦を追い払って、前に産卵した矢倉石の天井へ産みつける。",
              "citation": {
                "source": "鰍の卵について",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月末から十月になれば、親の山女魚は、浅い流れの小石の間に堀をほって卵を産みつけるのである。",
              "citation": {
                "source": "木の葉山女魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰍は、二月から四、五月にかけて、水底の大きな石の裏側に卵を産みつける。",
              "citation": {
                "source": "姫柚子の讃",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "天は地上に、この味覚の人を産みつけるべく、常に甚だケチであるとも言えようか。",
              "citation": {
                "source": "料理も創作である",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンターは子供のときから博物学に興味を持っていて、ジェンナーもその影響で郷里で開業をしても博物学の研究を続け、カッコウが他の鳥の巣に卵を産みつける生態の研究などが認められて、ロイヤル・ソサイエティのフェロウにもなった。",
              "citation": {
                "source": "イングランドの西部の諸州とくにグルスターシャーで見つかった病気で、牛痘の名で知られているウシ天然痘の原因および効果についての研究",
                "author": "AN INQUIRY INTO THE CAUSES AND EFFECTS OF THE VARIOLAE VACCINAE, A DISEASE DISCOVERED IN SOME OF THE WESTERN COUNTIES OF ENGLAND, PARTICULARLY GLOUCESTERSHIRE, AND KNOWN BY THE NAME OF THE COW POX.",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時期にトスカナの医師フランチェスコ・レーディは昆虫の発生についての実験を発表して腐った物質は卵を産みつける巣以上のものでないことを示した。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "その底に現われ出た、新らしい岩片の上へ、卵を産みつけるのだという。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばある種類の蠅は卵を腐肉の上に産み付けるが、これは孵化した幼虫が直ちに十分の食物を得るためで、種属維持にとってははなはだ必要な本能である。",
              "citation": {
                "source": "いわゆる自然の美と自然の愛",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに天南星科の植物には腐肉の如き臭気を発する花の咲くものがあるが、蠅がそこへ来て往々卵を産み付ける。",
              "citation": {
                "source": "いわゆる自然の美と自然の愛",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
