  {
    "uuid": "b89776e6-cd7c-50ea-98eb-af9811ffc6e3",
    "entry": "打ち紐",
    "reading": {
      "primary": "うちひも",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
