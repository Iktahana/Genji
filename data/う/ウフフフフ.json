          "literary": [
            {
              "text": "のっそり降りると、「ウフフフフフ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "くやしくてならねえんですよ」「ウフフフフフ、そんなことで泣くのがあるかよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しばかり男ぶりがいいったって、目のくらむあっしじゃござんせんよ」「ウフフフフ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫く、靴音が遠くなってから、とても若々しいハミングが、フウフウフフン、ウフフフフンとか聴えて来ました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "文をもらってさ」「それじゃやっぱり女だろう」「なあに男がさ」「男なら、その坊主だろう」「ええ、その坊主がさ」「坊主がどうして驚ろいたのかい」「どうしてって、本堂で和尚さんと御経を上げてると、突然あの女が飛び込んで来て――ウフフフフ。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥方はちゃんといるぜ、君」「ウフフフフ」と主人は笑いながら「構うものか」と云った。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アッハッハッハッハッ……ゴホンゴホン……妙な顔をしているじゃないか……ウフフフフフフ是非とも吾輩が死んでいないと具合がわるいと……ゲッヘンゲッヘン……云うのかね。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウフフフフフフ……ゾッとする筈だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたら足を抱えていた男が、「サア……天国へ来た……」「ウフフフフ。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そうでしょう……どうです……」「……………」「……ウフフフフフ、私がこの眼で見たのですから、間違いは無い筈です。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アハハハハハハ」「オホホホホホホ」「ウフフフフフフ」　泥棒は夢中になって逃げ出すと、すぐに通りがかりの巡査さんに捕まりました。",
              "citation": {
                "source": "雪子さんの泥棒よけ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｗは女の意味だの、女のアレ……」「ウフフフフフフ」「……だの奥様だのいう……」「Ａと同じだね」「ウン。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アッハハハウフフフフアッハハハハ。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の精霊　だが及ばぬ事じゃ、いかな物ずきでもしわくちゃなはげおやじに……ウフフフフフおかしい様な気もするワ、いい年をして子の様な精女の姿にうなされるとは――はかりきれない美くしさをもって居ると見える。",
              "citation": {
                "source": "葦笛（一幕）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとたんに、「ウフフフフフ、だいぶ胆をひやしたようじゃが、その調子では、墓埋めなどというすごい仕事はつとまるまいテ、わっはっはっは」　また大声が、眼の前に爆発して、暗黒が凝ったかと見える一｜塊の人影が、ノッソリ立ち現われた。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず伯仲であろうとは思うが、いずれその決着も、つく折りがあろう、ウフフフフ」「くだらぬ者を斬ったな。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、惜しむらくはどれもこれも不細工、ウフフフフ都では通用せん代物じゃて……」　と言いおわるを待たず、それッ！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウフフフフフ……と、ふすまのかげから、源三郎の低い笑い。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "姓は丹下、名は左膳……ウフフフフ、コウさむれえ、えらいところをじゃましてすまなかったが、おらア因果と、この壺てエものを見るてえと、やたらに欲しくなる性分でナ。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウフフフフフフフ、入り口がわからないって言うのか。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウフフフフ、そら見なさい。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ウフフフフフ、なかなか手きびしいね。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ウフフフフフ、おさっしのとおり、魔法博士が、ご自身で、明智先生をおむかえに来たのさ。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウフフフフフフ、名探偵も、もろいもんだな。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　魔法博士はスックと立ちあがって、明智と小林少年を見おろしながら、ウフフフフと、うすきみ悪く笑うのでした。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウフフフフ……、とうとう、わなにかかったね。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウフフフフ……、ふしぎそうな顔をしているね。",
              "citation": {
                "source": "魔法博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウフフフフ……、そうはいくまいて。",
              "citation": {
                "source": "魔法博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
