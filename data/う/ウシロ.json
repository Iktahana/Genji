[
  {
    "uuid": "134ba748-975d-5c73-9e65-fda94fed4635",
    "entry": "後ろ",
    "reading": {
      "primary": "うしろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
