  {
    "uuid": "52f1d0f7-17c5-5556-8efa-a11d3ce33834",
    "entry": "ウシロ",
    "reading": {
      "primary": "うしろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カゴカキ新美南吉　ツキヨノ　マツナミキノ　ミチデ　一リノ　サムライガ、ウシロカラ　ハシツテ　キタ　カラノ　カゴニ　ノセテ　モラヒマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シバラク　スルト、ウシロノ　カゴカキガ、「シーツ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ウシロデ　イヒマス。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ウシロノ　ハウガ　イヒマスト、マヘノ　ハウガ、「モウ　スコシ　サキノ　ガケノ　上カラ　タニ川ヘ　ホリコンデ　ヤラウ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　トウサンノ　ウシロカラ、「オトウサン。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サムラヒハ　ビツクリシテ　アシモトヲ　ミルト、ゲタノ　ウシロニ　フデノ　ホノヤウナ　シツポガ　チヨロリト　デテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ポストノ　ウシロニ　タツテ　ヰタ　ガイトウガ　カラ　カラト　ワラツテ、「ポストノ　カゲナラ、ポストノ　ウシロニ　コロガツテ　ヰル　ソノ　ブカツカウナノガ　サウヨ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポストハ　ウシロヲ　ミルト、ソコニ、ホントウニ　ブカツカウナ　ジブンノ　カゲガ　アリマシタノデ　アカク　ナリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガイトウノ　カゲナラ、ガイトウノ　ウシロニ　アル　ソノ　ヒヨロヒヨロシタノガ　サウダヨ」ト　ケイキキユウハ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ミヤニニタウシロスガタ――といふのは何んな意味なの。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "右翼青年の集りが拙者に講演をたのむとは憎い奴め、ウシロを見せるわけにはいかないから、当日でかけて行くと、二十人ぐらいの坊主頭の若者どもが小癪な目をして私をかこんで坐る。",
              "citation": {
                "source": "安吾巷談",
                "author": "熱海復興",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしウシロは見せられない。",
              "citation": {
                "source": "安吾巷談",
                "author": "田園ハレム",
                "note": "青空文庫"
              }
            },
            {
              "text": "船が動く、海がひろびろとウシロに展ける、黒く蠢めく人波が、長い岩壁に、丁度立ち去つた汽船の長さだけ残る。",
              "citation": {
                "source": "海の霧",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンシンバシラヤ、ハタケヤ、モリヤ、イナカヤヤ、ケシキガ　ドンドンウシロヘ　ハシッテユキマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "よ、名探偵」「さようそこがトウシローと名探偵のちがいさ。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の後立はウシロタテと読むのか又はゴリフと読むのか判然しないが、順序からいうと爺岳か鹿島槍に相当するらしいので、爺岳としても差支ないようであるが、「其中に後立山最高し」と明瞭に断ってある所から推せば、これはどうしても鹿島槍ヶ岳を指したものである。",
              "citation": {
                "source": "後立山は鹿島槍ヶ岳に非ざる乎",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯カラ上ルト、ウシロカラタオルデ拭キ、ベビーパウダーヲ振リカケ、扇風機ヲカケテクレルガ、決シテ前ヘハ廻ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿閉ハ老人ニハシバ／＼起ル現象ダソウダガ、平生デモ一回ノ排尿ニ時間ガカヽリ、劇場ノ便所ナドデ人ガ大勢ウシロニ列ンデ待ッテイラレルト甚ダ困ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ足元ニ用心シナガラ闖入シテ、戸ヲウシロデデ締メタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鞄カラ鍼ノ匣ヲ取リ出シタリ、アルコールデ消毒シタリスル細カイ作業ハ鈴木氏自身デスルケレドモ、常ニ弟子ノ一人ガ附キ添ッテウシロニ控エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハイ、ハイ、オ爺チャン、アタシニドウシロッテ仰ッシャルノヨ、何デモスルカラ仰ッシャッテヨ」ト、ソウ来テクレヽバ締メタモンダガ、迂闊ニソウハ云イソウモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚二三の異例を擧げて見ると、仙臺ではコナサセの他に、ウシロガカといふ名もある。",
              "citation": {
                "source": "産婆を意味する方言",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
