[
  {
    "uuid": "d4b4aa98-37f6-5e0a-b637-33055a7e6f32",
    "entry": "ウフ",
    "reading": {
      "primary": "うふ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
