        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こうしてウィルビイ・ハーコートは十五歳で世の中に放り出され、自立した。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "令夫人は同じテーブルで過ごしたかったし、偶然ウィルビイ・ハーコート氏もそうだった。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「つまりウィルビイ・ハーコートさんの筆名ですか」　ハーコート氏は曖昧に笑った。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらく参列者が思ったのは、ウィルビイ・ハーコート氏の栄誉にもう一つ、月桂冠が加わった。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウィルビイ・ハーコートが喋ったの。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "台本をウィルビイ・ハーコートへ送ったら、気に入った。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウィルビイ・ハーコートにはもう後がない。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「当誌の信頼できるマーク・ジャーマン手配師によれば、ウィルビイ・ハーコートの最新ヒット劇『世の終わり』に新たな秘話が加わった。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、知り合いのウィルビイ・ハーコートにやらせましょう」了",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
