        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ジュパーン　波蘭から伝はつた長上衣の一種で、ウクライナ人、殊にカザックの晴著として用ゐられたもの。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたものが皆んな、病的な頭脳にとっては異常に陰惨で幻想的な性質を帯びているところへ、湯番をしている肥った｜ウクライナ人がまた、ついぞ口を利いた例しのないむっつり屋と来ているので、その陰気な顔つきが弥がうえにも部屋の印象を暗くするのであった。",
              "citation": {
                "source": "紅い花",
                "author": "КРАСНЫЙ ЦВЕТОК",
                "note": "青空文庫"
              }
            },
            {
              "text": "「毟ってはならん」と｜ウクライナ人の老人が言った、「花壇へはいってもならん。",
              "citation": {
                "source": "紅い花",
                "author": "КРАСНЫЙ ЦВЕТОК",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっきりあけすけにそう云わず、置手紙などするところ、プチなウクライナ人らしい。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウクライナ人とはきれいずきと思ったが。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウクライナ人と云うのは郷土心がつよい。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホホール（ウクライナ人の蔑称）の家が火事だ！",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            },
            {
              "text": "町の劇場をその冬いっぱい借り切って、短い期限をきってウクライナ人の劇団や、奇術師や、土地の素人芝居に又貸しした。",
              "citation": {
                "source": "可愛い女",
                "author": "DUSHECHKA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーゴリはウクライナ人であったが、チェーホフの出身もやはり南方だ。",
              "citation": {
                "source": "チェーホフ試論",
                "author": "――チェーホフ序説の一部として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーゴリは周知のようにウクライナ人であったが、チェーホフの出身もやはり南方である。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェーフというのはチェック人という意味の珍しい姓であり、ヴォローネシ県の人口の過半は当時ウクライナ人によって占められていた。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
