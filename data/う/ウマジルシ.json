[
  {
    "uuid": "e9fd3731-d9c2-54b5-ba97-28e53ed0edd4",
    "entry": "馬印",
    "reading": {
      "primary": "うまじるし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "battle standard raised next to the horse of a commander",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "合戦の最中、敵の攻撃が激しくなっても、将軍の馬印は高く掲げられたままだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "歴史資料館で、あの有名な武将が実際に使っていた馬印のレプリカを見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "馬印が右に動いたのを見て、味方の軍勢は一斉に攻勢を強めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "一益の金の三団子をつけた馬印を、危く奪われると云う騒ぎである。",
              "citation": {
                "source": "長篠合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀吉笑って許さず、馬印を盛政勢の背後の山に立置く様に命じて置いて、菓子を喰い茶を飲んで悠々たるものである。",
              "citation": {
                "source": "賤ヶ岳合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "よろしく北の庄に入って、心静かに腹を召し給え」と勧め、自らは勝家の馬印をもって止り防がんことを乞うた。",
              "citation": {
                "source": "賤ヶ岳合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝家、庄助の忠諫を容れ、金の御幣の馬印を授けて、馬を北の庄へと向けた。",
              "citation": {
                "source": "賤ヶ岳合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その処を赤い瓢箪の上に小熊を附けた馬印を押し立て、兵五百に先頭して、馳け抜ける若武者がある。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "細川越中守忠利は、地白、上に紺の九曜の紋ある旗を掲げ、狸々緋の二本しないの馬印を立て、黒白段々の馬印従えた肥後守光利と共に、三の丸前門を攻撃した。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう此頃には、三の丸池尻門辺に、上白下黒白黒の釘貫の旗や、白い鳥毛二つ、団子の馬印が立てられて、有馬｜豊氏、同忠郷の占拠を示し、三の丸田尻門辺には立花忠茂の上白下黒、黒の処に紋ある旗や、松倉重次の黒に中朱筋一つの旗が眺められた。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "二の丸辺に、熊毛二段の団子、下に金の団子の馬印が動くのは、寺沢忠高が乗り込んで居るからであり、その後に、赤い旗が進むのは、小笠原忠政、同長次が進みつつあるからである。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "信綱の子輝綱は、従士十数名と共に、馬印も掲げず秘かに城へ向うを、地白紋登りはしごの総帥旗の下に、地白紋赤き丸三つの旗掲げた戸田氏鉄と共に、本営に指揮して居る信綱に見付かった。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「茜の吹貫二十本、金の切先の旗十本、千本｜鑓、瓢箪の御馬印、太閤様御旗本の行列の如く……」と、『大阪御陣覚書』に出ている。",
              "citation": {
                "source": "大阪夏之陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「路には御馬印｜捨候を伊藤武蔵と云ふ広島浪人跡より来り捨たる御馬印を取揚て、唐迄聞えたる御馬印を捨置、落行段大阪数万の軍勢に勇士一人も無し、伊藤武蔵、御馬印を揚帰るとて御馬印を指上げ城に入る」と『大阪御陣覚書』にあるが、落城の悲惨さが分る。",
              "citation": {
                "source": "大阪夏之陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄手の軍が、こんな朱敗を重ねてぐずぐずしている間に、幸村は軍を勝曼院の前から石之華表の西迄三隊に備え、旗馬印を竜粧に押立てていた。",
              "citation": {
                "source": "真田幸村",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀頼公が御旗御馬印を、玉造口まで押出させ、寄手の勢力を割いて明石が軍を目的地に進ましめることを計った。",
              "citation": {
                "source": "真田幸村",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "箱根山を千成｜瓢箪の馬印が越せば、総て解決されるのである。",
              "citation": {
                "source": "小田原陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "井楼、矢倉、隙間もなく立置き、持口々々に大将家々の旗をなびかし、馬印、色々様々にあつて、風に翻り粧ひ、芳野立田の花紅葉にやたとへん。",
              "citation": {
                "source": "小田原陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると跡に、時代の古いものでは、「御馬印揃」、「御紋尽」、「御屋敷附」の類が残って、それがやや形を整えた「江戸鑑」となり、「江戸鑑」は直ちに後のいわゆる「武鑑」に接続するのである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし今知っている限を言えば、馬印揃や紋尽は寛永中からあったが、当時のものは今｜存じていない。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "雁木坂加番小笠原は、自分の詰所の前の雁木坂に馬印を立ててゐる。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へば島原陣諸家指物図に、鍋島光茂の馬印を「大鳥毛・だし・金の瓢」と書いたのや、奥羽永慶軍記小田原攻めの条に出る岡見弾正の酒林のさし物などを見ても知れる。",
              "citation": {
                "source": "髯籠の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「武器短歌図考」を見ると、だし（竿頭の飾り）に切裂き・小馬簾をつけ、竿止めに菊綴ぢ風に見える梵天様の物をつけたのが円居で、蝉口に吹き流しをつけたのを馬印としてゐるが、事実は、そんなに簡単に片づく物ではなかつた様である。",
              "citation": {
                "source": "まといの話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "此は、馬印がまといの勢力を奪うたので、段々まといが忘れられて来た為である。",
              "citation": {
                "source": "まといの話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "右に馬印とした物を纏と記した上に、吹き流しを吹き貫きにしたゞけの物を馬印として並べてゐる「弘前軍符」の類もある。",
              "citation": {
                "source": "まといの話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "此は、まといが忘れられる前に、まづ馬印と混同して、馬印は栄えて行き、まといは家によつては、形式の少し変つたさし物の名に、固定して残つたものと見るべきであらう。",
              "citation": {
                "source": "まといの話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "（これは越前名代の強力、一日狩倉に出て大熊に出逢ひ、持てる鎗は熊のために喰折られ已む事を得ず鉄拳を上げて熊をば一｜拳の下に打殺しこの勇力はかくの如くであると其の熊の皮を馬標とした。",
              "citation": {
                "source": "怪力",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪城の天守が雷火に焚かれたときに、そこにしまってある権現様の金の扇の馬標を無事にかつぎ出して、天守の頂上から堀のなかへ飛び込んで死んだという、有名な中川｜帯刀もやはりこの番士の一人でした。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてこの際、采配を振るとは言うけれど、自分が金扇馬標を押立てて本陣に馬を進めようというのではなく、表面はどこまでも道庵に芝居をさせて、自分は軍師としての采配を振る――という行き方は、お角さんらしいものでありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」という大標題を掲げ、金扇馬標を描いて馬上の道庵大御所の姿を現わし、それから本文には、近ごろ江戸で名代の金持のお医者さんが、道楽で関ヶ原に模擬戦を試みて大成功を遂げ、その勢いで不日、京阪の地に乗込んで来る！",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "周知の如く武鑑とは現代の紳士録の先駆的出版物であって、徳川一門から譜代外様の大名諸侯残らずその家の紋どころ、槍飾り馬標、領地江戸邸、各家の家族関係から重臣まで記載してある。",
              "citation": {
                "source": "長屋天一坊",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そればかりか、中軍に持っていた金幣の馬標まで、敵手に奪われてしまい、主従、ちりぢりになって逃げ走った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "死を決して奮進した采女は、奪われた味方の馬標を敵の手から奪りかえし、しかも後日、身をもって危地から遁れてかえった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
