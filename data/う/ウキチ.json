        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「トウキチキトク、テイ」　その電報は新吉宛だつた。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは返電で、二日前にシキウキチョウアリタシと打たれて来た。",
              "citation": {
                "source": "おもかげ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シキウキチヨウアリタシ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり、シキウキチヨウアリタシとしか書かれていない。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子は、シキウキチヨウアリタシに気をわるくしながら、やっぱり返事が気にかかり、落付けず、快活さを失った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『史学雑誌』とかタグチ　ウキチの編纂していた『史海』とかを見てはいたようであるが、特殊の問題を取扱った論文などは、読んでもよくわからなかったろうし、『国史眼』というものも買ったことは思い出せるが、それを通読したかどうかは忘れている。",
              "citation": {
                "source": "学究生活五十年",
                "author": "津田左右吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
