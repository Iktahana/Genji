          "literary": [
            {
              "text": "○ドーム・ウチョーヌイフ〔学者の家〕、No. 11 に入る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○ドーム・ウチョーヌイフ、朝から、十二時迄、夕方から夜十二時迄、台所にキピァトーク〔熱湯〕がある。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "レーニングラード‐ヴ・オ・ク・ス（対外文化連絡協会）は、伸子たちの泊っている元ウラジーミル大公の邸、ドーム・ウチョーヌイフ（学者の家）の通りを三位一体橋の方へゆく左側にあった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
