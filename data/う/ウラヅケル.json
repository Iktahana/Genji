[
  {
    "uuid": "d3467450-fdc6-542c-8fa4-58981763a929",
    "entry": "裏付ける",
    "reading": {
      "primary": "うらづける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
        "動詞-他動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to support (a theory, claim, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その理論を裏付ける証拠を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "複数の研究が彼の仮説を裏付けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "目撃証言がアリバイを裏付けることはできなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それからというもの、起こることすべてが、最初の仮説を裏付けるばかりだった。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故、君たちを悩ませ、真相を曇らせたものは、私にしてみれば明るくするものであり、考えを裏付けるものだった。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど氏の能力に関する僕の高評価を裏付けるものだった。",
              "citation": {
                "source": "最後の事件",
                "author": "THE FINAL PROBLEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は内的時間意識を永遠なる神をもつて形而上學的に裏付けるであらう。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "……純情は尊いけれど、それを裏付ける強い意志が伴はないならばたゞそれだけにとゞまる、……よい酒とは昨日を忘れ、明日を思はず、今日一日をホントウに生かしきることが出来るやうに役立つ酒でなければなりません、……とにかく、酒に求めないで、酒を味ふやうにならなければウソですね。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに君枝は、かなり美貌の方ではあるが、吉村の所謂女らしい雰囲気にひどく乏しかったし、その文章も吉村の持論を裏付けるようなものだった。",
              "citation": {
                "source": "鳶と柿と鶏",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日の私のポーズの裏付けるものを知ることが出来ないでいる。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハカリに記された背比べのシルシが正しい安彦氏の身長だということを裏付ける方法がありません。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "看護婦や信子や木下の一挙一動、その動作を裏付ける感情、一として彼の眼を逃れることは出来なかった。",
              "citation": {
                "source": "二つの途",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある水道会社のパイプを通ってコレラ毒が送られているときには、上の規則は成立しないで、たぶん女性は男性よりもビールを飲む習慣が少ないので従って水を飲むことが多いので、反対の規則が成立する、ということはこの考えを裏付けるものである。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は俺の周圍に、俺よりも遙に劣等な生活内容を持ちながら、その劣等な生活内容を裏付けるに稀世の天才にのみ許される自信を以つてするチグハグな「自己肯定者」を見た。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その言葉はそれを裏付けるやうな事情が直ぐに起らなかつたなら、私の記憶から消え去つてゐたかも知れない。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩六時、重要な情報が、一見して俺の話を裏付けるものだが、インド商会に届く。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの検屍官の推定を裏付けるかのごとく、夫人の屍体は以上のような無数の疵をその豊艶なる肢体に印しつつ、三発の弾痕から鮮血を雪白の敷布に迸らせて、まったく一糸｜纒わぬ裸体のままで仰臥していたのには、思わず面を背けずにはいられなかったと立会いの警官たちも述べていた。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この説を裏付ける証拠は何一つない。",
              "citation": {
                "source": "ナショナリズムについての覚書",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーキュリー紙の編集長はこれを裏付ける現場に居たと思われるが、犯人像は推測に過ぎん。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザリも同時期に妙に消えたから、私の話を裏付ける人物はいません。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがこれは数日思っていたことを裏付けるものだ。",
              "citation": {
                "source": "ギルレイ",
                "author": "The Man Called Gilray",
                "note": "青空文庫"
              }
            },
            {
              "text": "よい事ばかりはない、よい事をよくない事がうらづける、それが浮世といふものだ。",
              "citation": {
                "source": "行乞記",
                "author": "大田",
                "note": "青空文庫"
              }
            },
            {
              "text": "但しここでは近世哲学の発端は、観念性の尊重という処におかれているから、吾々の見解をうらづけるに充分でない。",
              "citation": {
                "source": "科学論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は川端氏のこの神祕的な作品を、或程度私の感覺的な經驗で裏づけることの出來るのを感じたのだ。",
              "citation": {
                "source": "川端康成第四短篇集「心中」を主題とせるヴァリエイシヨン",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（メーリンクのレッシング論はこの點で私の主張を裏づけるであろう。",
              "citation": {
                "source": "政治的價値と藝術的價値　マルクス主義文學理論の再吟味",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "何よりも私は、私の考へを裏づけるやうな材料を蒐集し、これを適当に整理する余裕をもたな過ぎた。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "（メーリンクのレツシング論はこの点で私の主張を裏づけるであらう。",
              "citation": {
                "source": "政治的価値と芸術的価値",
                "author": "マルクス主義文学理論の再吟味",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夢は、いま私どもの持っている確信をいっそう裏づけるばかりです。",
              "citation": {
                "source": "チャアリイは何処にいる",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "何も瀧田の人物鑑定眼を裏づけるに私だけをとり立てて云うには当らないのですからね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ろくでもない養生ぶりについて患者は、自分の感受性を裏づけるだけの闘病の経験も知識もかけていて、したがって意力も十分ではなかったのだと思います。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が土を掘ってこそいるが、或る精神力のようなものをも持っていて、世界のいろいろな出来事に興味を感じ、その興味を裏づけるに必要な知識を、若い大学生から得たい心持でいるのがよく察せられた。",
              "citation": {
                "source": "北へ行く",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのために、アメリカの目の下で、社交性を裏づける「何か一つ」をやらなければならないという焦燥があるということがわかりました。",
              "citation": {
                "source": "往復帖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが朝子は、こういう歓びの同感のさなかでさえ、その感情を感傷で裏づけるほど身近に感じられている悦びへの渇望、それによって生き、殪れる今日の日本のわれら、その生活を自分は描きたいと思うのであった。",
              "citation": {
                "source": "広場",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
