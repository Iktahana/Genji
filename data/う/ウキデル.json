    "definitions": [
      {
        "index": 1,
        "gloss": "to rise to the surface",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "沈められた物が浮き出る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "下からゆっくり気泡が浮き出る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "古い記憶が心の奥底から浮き出る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "この闇の中を夢のように歩いていると、暗い中に今夜見た光景が幻影となって浮き出る。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "月石の光芒がスープの中にぽくりと浮き出る。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手の方、一間半ばかり離れて、雑草の中に、何か、時々ぼーっと浮き出る白いものが眼についた。",
              "citation": {
                "source": "鱗粉",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それきりだが、それ故にまた、深夜の中にくっきりと浮き出るのだ。",
              "citation": {
                "source": "聖女人像",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、ありありと姉さんの面影が、その、日に輝いたとこなつの花弁の中に浮き出るのでありました。",
              "citation": {
                "source": "夕焼け物語",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「待つて下さい、庚申塚の親分、――私は人に聽いたことだが、締め殺して暫らく放つて置くと締めた紐の跡が浮き出るといふことだ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "妹の扱帶",
                "note": "青空文庫"
              }
            },
            {
              "text": "之は一方に於て世界観の一部であると共に、他方に於て直接に創作方法に結びついているばかりでなく、私小説の私や、主体や自我意識の姿さえも浮き出る壁なのである。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い時は知らず、老いてたるみ、皺に包まれた老婆の全身を埋めた刺青の醜怪さから、若い女の起誓をこめた、腕や、内股の名前や、花札や、桜なぞの刺青から、アルコール分の摂取とか、湯に入った時にだけ浮き出る商売女のぼかし彫や、隠彫なぞを見ても全く何の興味も覚えなかった。",
              "citation": {
                "source": "刺青",
                "author": "富田常雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "シイラは本当は金色だから、もちろん緑色に見えるんだが、ひどく腹をすかせて餌を食う時になると、側面にカジキみたいな紫色の縞が浮き出るんだ。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれも一生かなりよく食った――」　マデレーン寺院の片頬を染めた春の西日が全く落ちて道路につぶつぶの燈と共に食酒を飲んだあとの男女の群が華やかに浮出るころ、もう早目の食道楽の客がラリュウの右側の部屋に二人三人席を占めていた。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "竪一尺横一尺五寸の粗末な額縁の中にはあらゆる幼時の美しい幻が畳み込まれていて、折にふれては画面に浮出る。",
              "citation": {
                "source": "森の絵",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今わが胸に浮出る葡萄棚の思出はかの浅間しき浅草にぞありける。",
              "citation": {
                "source": "葡萄棚",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とも言へない若々しい情緒が胸一ぱいに漲りわたるのを覚え、おのづから口の端に浮出る微笑に心づいて、またもや身のまはりを見廻したが、改札口には駅夫の影も見えず、バスの駐つてゐた足元には何か落ちこぼれた物でもあると見えて近所の鶏が二三羽出て来て頻に土の上を啄んでゐる。",
              "citation": {
                "source": "来訪者",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "※114　「浮出る」の横に「浮葉の」と書く。",
              "citation": {
                "source": "藤野古白句集",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "明るい、そしてひろびろとした人生へ、再び浮きでる浮力のすべてを失つてしまひさうに見えるのだ。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
