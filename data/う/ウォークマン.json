        "examples": {
          "standard": [
            {
              "text": "学生時代、お気に入りのカセットテープをウォークマンで聴きながら登校するのが日課だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "父の部屋を整理していたら、初期型の古いウォークマンがきれいな状態で見つかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ジョギング中に音楽を楽しむために、軽量で防水機能の付いた最新のウォークマンを購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "これによって、レコードからカセットに音楽を落とし、ウォークマン型の機器で聞くことは、問題ないとされてきた。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "四谷見附橋のところで民族衣装をまとったインド人の女性から輪廻転生を解いたヒンズー教布教のためのパンフレットを買ってほしいと言い寄られたが、浩はウォークマンを聞きながらそのせいで聞こえないふりをしてやり過ごし、上智大学の｜Ｈ・Ｈの部室に向かう。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
