        "examples": {
          "standard": [
            {
              "text": "普段は無口な田中さんが宴会で裏芸の腹話術を披露し、会場が大いに沸いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「これ、裏芸なんですけどね」と照れながら、彼女はモノマネを始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "忘年会で彼の裏芸であるマジックが受けて、一気に場の雰囲気が和んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "これは表芸の方であり、裏芸の方ではワイロをせしめたカドによって小菅の方へ引越したという。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
