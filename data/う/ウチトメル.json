    "definitions": [
      {
        "index": 1,
        "gloss": "to kill (with a sword, knife, spear, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "戦場にて、敵の勇将を槍で討ち止めるという功績を挙げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "復讐を誓った武士は、ついに仇を討ち止めることに成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "幾重にも囲まれた敵軍の中を突き進み、総大将を討ち止めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "……」　兇悪な孫兵衛を討ち止めるとともに、ふと、剣山での父の死を目にうかべて、熱い涙がにじみだしてくるのを感じていたお綱は、どこかで、こういう声にささやかれた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "鳴門の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
