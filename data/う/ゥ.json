        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "バナナン大将「つかれたつかれたすっかりつかれた脚はまるっきり　二本のステッキいったいすこぅし飲み過ぎたのだし馬肉もあんまり食いすぎた。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「それでは酒を呑まずに水を呑むぅとやるか。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「赤いてながのくぅも、　天のちかくをはひまはり、　スルスル光のいとをはき、　きぃらりきぃらり巣をかける。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あぁかい手ながのくぅも、　できたむすこは二百｜疋、　めくそ、はんかけ、蚊のなみだ、　大きいところで稗のつぶ。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あぁかいてながのくぅも、　てながの赤いくも　あんまり網がまづいので、　八千二百里旅の蚊も、　くうんとうなってまはれ右。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダー、ダー、ダースコ、ダーダ、青い　仮面この　こけおどし、太刀を　浴びては　いっぷかぷ、夜風の　底の　蜘蛛をどり、胃袋ぅ　はいて　ぎったりぎたり。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　「夜風さかまき　ひのきはみだれ、月は射そゝぐ　銀の矢なみ、打ぅつも果てるも　一つのいのち、太刀の軋りの　消えぬひま。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あすこが少ぅしおれのたよりになるだけだ。",
              "citation": {
                "source": "ガドルフの百合",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「赤いてながのくぅも、　天のちかくをはいまわり、　スルスル光のいとをはき、　きぃらりきぃらり巣をかける。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あぁかいてながのくぅも、　あんまり網がまずいので、　八千二百里旅の蚊も、　くうんとうなってまわれ右。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダー、ダー、ダースコ、ダーダ、青い　仮面この　こけおどし、太刀を　浴びては　いっぷかぷ、夜風の　底の　蜘蛛おどり、胃袋ぅ　はいて　ぎったりぎたり。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "終わりの「出ぅよ」を早口に歌ってしまうと何かに追われでもしたようにみんないっせいに駆け出すのであった。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お座敷のウ真中でもウ、お机、卓子台の上エでなりとウ、ただ、こいに遣って、すぅいすぅいと擦りますウばかりイイイ。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほぅ、一八五八年アメリカのニュージャージィ州生まれ。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コントラルト歌手、ほぅ。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "スカラ座出演、ほぅ。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれも粘着性があるようで、整髪剤からライムのすぅっとした匂いがする。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下を駆け出していきますと、姉の部屋で、扉の鍵を外す音がいたしまして、扉がすぅっと開きました。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞いて下され、娘は昨晩、あのサーカスに行っておりましてのぅ――」「指輪は、これですかな？",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "』とわしが答えると、『ふぅん、そいつは不思議だ。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぅっと黄色い線をえがいています。",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "THE LITTLE MATCH-SELLER",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あのぅ、どうして何もおっしゃらないんですか？",
              "citation": {
                "source": "はだかの王さま",
                "author": "THE EMPEROR'S NEW SUIT",
                "note": "青空文庫"
              }
            },
            {
              "text": "電灯がすぅーと暗くなったかと思うと、天井につるしてあった二つの大きな金属球の間に、すごい音を発して、ぴかぴかッと電光がとんだ。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尉の乗った偵察機は、垂直旋回のまま、怪塔ロケットの尾翼をねらって、みごとに「どぅん」とぶつかりました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "駆逐艦隊は昼間も夜間も、ずっと海上の警戒をとかず、もしや怪塔ロケットが波間から顔を出した時は、大砲でどぅんと撃ってやろうとおもって、いつも待ちかまえていましたが、相手はどこにかくれているか何の音さたもありませぬ。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それならば、世人がそれをいまわしく、おそるべしとするのは、なに故であろぅか。",
              "citation": {
                "source": "死刑の前",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのう、ほぅとお思いになったでしょう？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は顔をぎぅーっと挾んだ二つの手が、急にパチパチと頬ぺたを叩く心持さえまざまざと思い浮べた。",
              "citation": {
                "source": "無題（一）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
