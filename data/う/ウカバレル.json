        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "何年も地道な研究を続けてきて、ようやくノーベル賞候補に選ばれたことで浮かばれる思いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "下積み時代を支えてくれた妻に恩返しができ、苦労した日々もこれで浮かばれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "誰にも気づかれないような細かい修正作業だが、使い勝手が良くなったと言われて浮かばれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
