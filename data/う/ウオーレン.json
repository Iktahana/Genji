        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――和辻氏は「新思潮」に「ウオーレン夫人の職業」を訳して、その時分でのシヨオ通でした。",
              "citation": {
                "source": "井上正夫におくる手紙",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "親父さんの名はウオーレンというんだ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとり息子が戦死して、ウオーレンは嘆き悲しんでね。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕から聞いたと、ウオーレンに言ってくれ」　僕はハリーのオフィスを出た。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウオーレン・コハラに会って話を聞き、短い文章にまとめておこう。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
