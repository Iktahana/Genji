      {
        "index": 1,
        "gloss": "large snake",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "森で見かけた蟒は人間の腕ほどの太さがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "蟒が樹上で獲物を狙っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この地域には大きな蟒が生息しているという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "蟒に呑まれたそうに、兀頭をさきへ振って、ひょろひょろ丘の奥へ入りました。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "……俗に四斗樽というのは蟒の頭の形容である。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――石垣から蟒が出たと思つたさうである。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅には梅氣、竹には竹氣がある、松に松氣、茶に茗氣、藥の氣は藥氣、酒の氣は酒氣、毒氣があり、蟒氣があり、霜氣があり、雪氣があり、一切種々の物に一切種々の氣が有る。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "青水泥ひどらが沼、蟠るぬめり蟒、憚らず曠野巨牛、畏る無し禍つ狼。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "青水泥ひどらが沼、蟠るぬめり蟒、憚らず曠野巨牛、畏るなし禍つ狼。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次の問題は蟒蛇である。",
              "citation": {
                "source": "麻畑の一夜",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪物は猿でもない、蟒蛇でもない、野蛮人でもない。",
              "citation": {
                "source": "麻畑の一夜",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "天子は曾に席をすすめさして、温かみのある言葉で何かとおたずねになったが、やや暫くして、曾に三｜品以下の官は、意のままに任免することをお許しになり、宰相の着ける蟒衣と玉帯に添えて名馬をくだされた。",
              "citation": {
                "source": "続黄梁",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾はそこで蟒衣を被、玉帯を着け、お辞儀をして天子の前をさがって家へ帰ったが、そこは旧の自分の住宅でなかった。",
              "citation": {
                "source": "続黄梁",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後漢の張道陵が蟒に呑まれたのをその徒が天に上ったと信じたのにちょっと似て居る。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪たれ店子の上に店賃は取れず、瘠せた蟒でも地内に飼って置くようなもんですから、もう疾くにも追出しそうなものを、変った爺で、新造が惚るようじゃ見処があるなんてね、薬鑵をさましていたそうですが、御覧なさい。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず媒妁人の七蔵をよび起して、今夜の首尾を確かめようと、彼女は更に次の間の障子をあけると、酔い潰れた七蔵は蚊帳から片足を出して蟒蛇のような大鼾をかいていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "山祝いの夜",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅には梅気、竹には竹気がある、松に松気、茶に茗気、薬の気は薬気、酒の気は酒気、毒気があり、蟒気（蟒の気）があり、霜気があり、雪気があり一切の種々の物に一切種々の気が有る。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて支那にも僧など暇多い故か、観察の精しい人もあって、後唐の可止てふ僧托鉢して老母を養い行きながら、青竜疏を誦する事｜三載、たちまち巨蟒あって房に見る。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "同院の僧居暁は博物なり、曰く蛇の眼は瞬かぬにこの蟒の眼は動くから竜だろうと、止香を焚いて蟒に向い、貧道青竜疏を念ずるに、道楽でなく全く母に旨い物を食わせたい故だ、竜神｜何卒好き檀越に一度逢わせてくださいと頼むと、数日後果して貴人より召され、夥しく供養されたという（『宋高僧伝』七）。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "また『和名抄』に蛇和名倍美、蝮和名波美とあれば蛇類の最も古い総称がミで、宣長の説にツチは尊称だそうだから、ミヅチは蛇の主の義ちょうど支那で蟒を王蛇と呼ぶ（『爾雅』）と同例だろう。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "また『和名抄』に蟒蛇、和名｜夜万加々知、『古事記』に赤加賀智とは酸漿なりとあれば、山に棲んで眼光強い蛇を山酸漿といったのであろう。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありふれた本邦の蛇の中で一番大きいからこれを支那の巨蟒に充てたものか。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通に蟒に充てるウワバミは小野蘭山これを『和名抄』の夜万加々智とす。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時は前者は人に害を加うる力ある蝮また蟒蛇等でその余平凡な蛇が後者だ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "また仏教に摩羅伽は蟒神には大腹と訳し地竜にして腹行すと羅什は言った。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "竜衆すなわち帽蛇は毎度頭を高く立て歩くに蟒神衆は長く身を引いて行くのでこれは※蛇を神とするから出たのだ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "さては妖邪の気が吸うのだと感付き、若少者数百人を募り捜索して、長数十丈なる一大｜蟒蛇を見出し殺した（『淵鑑類函』四三九）。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "インドのカーシャ｜丘地方の迷信に、蟒蛇が人家に寓れば大富を致す。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪人諸方を廻り人を殺して、耳鼻唇髪を切り取り、蟒蛇に捧げて自家に招きおらしむ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "土民これを怖れて単身藪林に入らず、蟒蛇を奉崇する家は、何ほど物を売るも更に減らず、したがって金が殖えるばかりちゅう旨い話だ（一八四四年版『ベンガル亜細亜協会雑誌』十三巻六二八頁）。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに近来の疑問というは、支那道教の法王張天師の始祖張｜道陵、漢末｜瘧を丘社に避けて鬼を使い、病を療ずる法を得、大流行となったが、後蟒蛇に呑まる。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日、一部の劇通に讚美せらるる「女定九郎」や、「鬼神お松」や、「うわばみお由」や、「切られお富」のたぐいは、みなこれ宮戸座の舞台における源之助の置土産である。",
              "citation": {
                "source": "源之助の一生",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に挙げた「女定九郎」や、「鬼神お松」や、「うわばみお由」のたぐいは、大歌舞伎の出し物でない。",
              "citation": {
                "source": "源之助の一生",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
