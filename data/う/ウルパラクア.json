          "literary": [
            {
              "text": "ウルパラクアの赤　部屋の明かりは消してある。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウルパラクア・レッドという文字が、かすかに読める。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウルパラクア・レッド」　と、僕は声に出して言ってみた。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウルパラクアというハワイ語の地名と、レッドというわずか三文字による英語の基本単語との結びつきかたは、けっして悪くない」　と、僕は言った。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
