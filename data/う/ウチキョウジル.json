          "literary": [
            {
              "text": "そんな作品に打ち興じる兄を、軽薄だとさえ思った。",
              "citation": {
                "source": "『井伏鱒二選集』後記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその横腹に書かれた牝牛の絵を指して、ものめずらしげに打ち興じるのであった。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は子供のやうに打ち興じる。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "待つ人を眼中になく打ち興じる笑声まで洩れてきたから、無礼至極、立腹して戻つてしまつた。",
              "citation": {
                "source": "二流の人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
