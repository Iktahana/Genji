        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一足クラヤミの外へでて、ヤミに向って光をてらすと、百鬼夜行、ジャングル満山百鬼のウゴメキにみちている。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍閥や右翼は敗戦後六七年で旧態依然たるウゴメキを現しはじめたが、明治の旗本は全然復活しなかった。",
              "citation": {
                "source": "安吾史譚",
                "author": "勝夢酔",
                "note": "青空文庫"
              }
            }
          ]
        }
