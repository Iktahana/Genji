        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは鯛とか鱸とか鰡とかいうような魚を三枚に卸して薄塩を当てておいて沸立っている湯へ西洋酢を落してその中で魚を湯煮ます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "別に生の鯛の身を刺身より少し厚く切って薄塩を当てて二時間ほど置いてまた上等の酢へ一時間余も漬けておきます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ずその魚へ薄塩を当てて二、三時間置きます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "逗子の父母から歳暮に相模の海の鯛を薄塩にして送って来た。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋に油を布いてこの痩果を炒り、その表面へ薄塩汁を引いて食すれば簡単に美味に食べられる。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また薄塩を振り、甘酢を用い、甘酢作りとして食うのも、替り刺身として乙なものである。",
              "citation": {
                "source": "西園寺公の食道楽",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
