          "literary": [
            {
              "text": "もうちゃんと食卓がこしらえて、アザレエやロドダンドロンを美しく組み合せた盛花の籠を真中にして、クウウェエルが二つ向き合せておいてある。",
              "citation": {
                "source": "普請中",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "燈火の海のような銀座通りを横切って、ウェエルに深く面を包んだ女をのせた、一輛の寂しい車が芝の方へ駈けて行った。",
              "citation": {
                "source": "普請中",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然はなかなか秘密がっていて、青天白日にウェエルを脱いで見せてはくれない。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            }
          ]
        }
