        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "酒はウチノアブラ、石油はソトノアブラ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチノナカガジトジトシテ、アルクト足ガタタミニネバル。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ父ッチャハ半トシモネテ、ウチノ中ニ何ンニモナクナッタトキニ死ンダノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコノウチノ人ハドレモミンナビンボウ人バカリナノデ、ビンボウナモノハミンナヨリアツマラナケレバ、カワイソウナモノダ、ト云ッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカル未知電波ノウチノアルモノハ、時ニ雑音トイウ名ノモトニワレワレニ知ラレテイル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キノフノバン、私ノウチノ地下室ニトマツタ玉ネギサンガ、行方不明ニナリマシタ。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドロノナカニ　コロガツテヰルト、ナニカ　ウチノナカデサワガシイ　オトガ　シハジメマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチノ宿六の野郎もパンスケだっていゝじゃないか、クラシが立たなくちゃアほかに仕方があるめえ、なんて、アン畜生め、いゝ年してパンスケ買いたいに違いないんだから。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクウレシクテ　ウレシクテ　タカヲチヤンノウチノ　ゴモンノハウヘ　カケテツタ　カケテツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンダッテソウナンダカラ、ウチノ子供ハ可哀ソウダヨ」「ダケドプールガ出来タ以上ハ経チャンダッテ飛ビ込ミマスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチノ庭ダッテ芝生バカリデハナイ、少シハ坂道モアルシ段々ヤ飛石モアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆ヤハ通イナノデ夕方水ダケ張ッテオイテ帰リ、瓦斯ニ火ヲ付ケルノハワレワレノウチノ誰カナノダガ、今夜ハ時分ヲ見計ラッテ郁子ガ付ケタ）ヘ行ッテ倒レタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "友田親分ハ、金五郎サント、オ京サントガ、二人デ、ドコカニ行ツタ事ヲ知ルト、カンカンニ怒ツテ、ウチノニ、コウイウノデス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
