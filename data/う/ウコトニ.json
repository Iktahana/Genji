        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スルカドウカ分ラナイガ、大工ヲ呼ンデ滑リ台ト滑車ヲ作ラセ、医療器械屋ヲ招イテ首ノ寸法ヲ測ッテ貰ウコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "依ッテ今回モ来週カラ来診ヲ乞ウコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨク考エルト、颯子ノ手前好キヲ装ッテイルニ過ギナイノダト云ウコトニ、自分デモ気ガ付クコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タビ／＼申シ上ゲル通リ、コノオ痛ミハ脳中枢カラノ原因ガ二三分、他ノ六七分ハ頸椎ノ生理的変化ニ依ル神経痛ト云ウコトニ、レントゲン検査ノ結果診断ガツイテオリマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ノ意見デ東大梶浦内科ノ梶浦博士ニ来診ヲ乞ウタラト云ウコトニナリ、本日午後博士来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デハマアソウシヨウト云ウコトニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆デ相談ノ結果、コウケチガ附イタ以上、誠ニ残念デアルケレドモ、兎ニ角コノ注射ハ一ト先ズ打チ切リニシタ方ガヨクハナイカト云ウコトニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ午後ノ列車ヲ捉エテ颯子ノ跡ヲ追ウコトニ決メ、毎日新聞支局ノ友人ニ依頼シテ無理ニ切符ヲ手ニ入レテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
