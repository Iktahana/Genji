          "literary": [
            {
              "text": "オカラヤ、ニンジンノ　シツポヤ、ウリノ　カハヤ、オゾウスヰヤ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツイテ　イツタ　テフテフ新美南吉　マチカドデ　フウセンウリノ　ヂイサンガ　フウセンヲ　ウツテ　ヰマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これが橡、あれが桂、悪ダラ、沢胡桃、アサヒ、ハナ、ウリノ木、……」　事ごとに眼を見張る私を笑いながら、初め無気味な男だと思った案内人は行く行く種々の樹木名を倦みもせずに教えて呉れた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これが橡、あれが桂、惡ダラ、澤胡桃、アサヒ、ハナ、ウリノ木……。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "カキノトコロヲ　マハツテ　フウセンウリノ　オヂイサンガキタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンウリノオヂイサン　モウ　ドコカヘイツチヤツテル。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
