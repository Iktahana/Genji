        "examples": {
          "standard": [
            {
              "text": "卯の花腐しが続き、洗濯物がなかなか乾かず困り果てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "卯の花腐しで外に出られない日は、家で静かに読書をして過ごす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "長引く卯の花腐しの影響か、庭の紫陽花がいつもより早く色づき始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "晴間見せ卯の花腐しなほつづく山荘の庭に長けけり夏蕨五月十六日　大崎会。",
              "citation": {
                "source": "六百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
