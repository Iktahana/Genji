    },
    "definitions": [
      {
        "index": 1,
        "gloss": "back (side)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ビルの後ろ側に駐車場がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "テーブルの後ろ側に扉がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "後ろ側から見るとまた違う風景が見える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "その石垣といふのは、小さな谷川に臨んで居るので、家の後ろ側の処に橋の一部分が見えて居る。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "按摩は客の後ろ側よりその脚を揉んで居る。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "この病気の蔓延した場所の両方の端にある、向かい側、後ろ側、同じ列の家々ではコレラが起きなかった。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "南側には紫宸殿の後ろ側の板戸がありました。",
              "citation": {
                "source": "アインシュタイン教授をわが国に迎えて",
                "author": "石原純",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりは立ちつくしているので、アリスは後ろに回って、えりの後ろ側を確かめようとする。",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "先刻から千人くらゐの女の脚を見てゐるが、どの脚も嬉しさうで元氣が好い、膝の折れ目から靴先があがるまでの短かい時間の、さつさつと空氣を分けてゆく恰好は人間の運動のなかでも、一等うつくしい、後ろ側のふくら脛の線と外光とのきれめに、ふくら脛にそのわづかな線のかげが映つてゐるなんて、とても言ひやうがないな。",
              "citation": {
                "source": "末野女",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「柱を見てくれ、疊から三尺ほどの高さだ、其處にも傷がある筈だが」「さう言へば後ろ側に傷らしいものがありますね」「ところで、これだけの事で、お前はどんな事があつたと思ふ」「新六か和助が夜中に忍んで來て、締めたんぢやありませんか」　八五郎は一つの假定に辿り着きました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "三つの死",
                "note": "青空文庫"
              }
            },
            {
              "text": "お臀って自分で見られないように、後ろ側についていて、人間の中でも一生自分のお臀を見ないで死ぬ人さえあるのに、おじさまったらその秘密がわからないの、どんな映画だってお臀だけは写さないわよ。",
              "citation": {
                "source": "蜜のあわれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "服の後ろ側が、ずたずたに切れていたからだ。",
              "citation": {
                "source": "処刑の話",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――なにせ、秋だ、聖壇の大蝋燭のやうに、ちらちら、感情の膜が耀ひながら微動する」と花が崩れ、水晶の時計に肖た秋がかうべの後ろ側で澄んでゐる。",
              "citation": {
                "source": "雪",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "「たしか、会下山の後ろ側には、旧い古道が一トすじ通っていたと思うが？",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "体操のとき、久助君のすぐ前なので、久助君は、かれの頭のうしろがわに、いくつ、どんな形のはげがあるかをよく知っている。",
              "citation": {
                "source": "久助君の話",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜなら、そのとき三人の眼が、もしも、うしろがわの舷にそそがれていたなら、かれらはきっとその場にとびあがったかもしれない。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この夫婦のうちのうしろがわには、小さな窓がありました。",
              "citation": {
                "source": "ラプンツェル",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台にあがってしまえば、まぶしい電灯のうしろがわになるので、黒いものでも、よく見えます。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは塔のうしろがわなので、だれも見ているものはありません。",
              "citation": {
                "source": "怪奇四十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりは、あわてて立ちあがると、手で土の山をさぐって、右がわのきれめを見つけ、そこを通って山のうしろがわにまわりました。",
              "citation": {
                "source": "仮面の恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "前の方のベンチには、黒シャツ、黒ふくめんの部下たち、そのうしろには、火星人に化けた、タコ入道みたいなやつが二十人ぐらい、そして、いちばんうしろがわのベンチには、電人Ｍの衣装をつけた部下が、やはり二十人ぐらい、ずうっとならんで、腰かけています。",
              "citation": {
                "source": "電人Ｍ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "所在なさそうに、今度は背中が当っていた後側の窓硝子に、眼を近々とすり寄せて、車外を覗いてみる。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの後側の部屋にいる男を、私は埠頭に引き出された時に、はっきり見ることが出来た。",
              "citation": {
                "source": "グロリア・スコット号",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "後側へ回ると広い空堀の中に立派な二階建の兵舎がある。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓は前側のものも後側のものも鎖して内より鑰を卸しありたり。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は風船屋の後側を通つて、神社の裏にある土俵の方へ行かうとした。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "この侵入者の後側へすべての方向から落下してくる物質は互いに衝突してその運動は大部分相い消却してしまうのであるが、しかし密度が非対称的であるために若干の運動が残留し、そのためにこの落下した物質は侵入者のまわりを楕円形の軌道に沿うて動くようになる。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅と白の派手なだんだら縞を染め出した大檣帆の裾は長い檣柱の後側から飛び出したトラベラーを滑って、恰度カーテンを拡げたように展ぜられ、船首の三角帆と風流に対して同じ角度を保たせながらロープで止められたままになっている。",
              "citation": {
                "source": "死の快走船",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "後手に縛られた両腕の表側には擦過傷があるが、腕の後側や腕の下に当る胸の横から背中の一部へかけては、衣服の綻びさえも見られない事だ。",
              "citation": {
                "source": "カンカン虫殺人事件",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "越後側に降つた時雨がどんなものであるかそんなことは考へないことにするが、唯この目前の水量の増し方は如何だ、一歩足を入れゝば押し流されさうだ。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯も後側だけは画いてある。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "後側は日本固有の造り庭で泉水や築山が拵へてある。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから前方もよく見えるし、後側もよく見えた。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
