[
  {
    "uuid": "6407d348-4151-5495-939e-92ea619a58f0",
    "entry": "後ろ側",
    "reading": {
      "primary": "うしろがわ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
