    "definitions": [
      {
        "index": 1,
        "gloss": "clearance (e.g. clearance sale)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
