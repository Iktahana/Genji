        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "季節の変わり目に、デパートの地下では旬の果物の売り切りセールが始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「在庫処分のため売り切りです。なくなり次第終了になります」と店頭に張り紙が出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ゲームのパッケージ版は売り切りで、追加課金要素が一切ないのが好評を得ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「あゝ、あゝ、まるで売り切りの牛か馬のようだ。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の気持ちでは、出来るなら、売り切りにしたくねえんでね。",
              "citation": {
                "source": "栗の花の咲くころ",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は、あの半分だけ借りて置いて、一応は伜と相談してから売り切りにしたいんですがね。",
              "citation": {
                "source": "栗の花の咲くころ",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「売り切りじゃねえですよ。",
              "citation": {
                "source": "栗の花の咲くころ",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今はこうして半分だけ借りて行っても、すぐ又はあ、伜から金が要るって言って来れば、残りの半分を借りて、売り切りになるかも知れませんで。",
              "citation": {
                "source": "栗の花の咲くころ",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "selling (accepting only a single payment)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
