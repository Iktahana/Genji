  {
    "uuid": "f20fb240-a215-5deb-b3be-818d0eda5773",
    "entry": "右丞",
    "reading": {
      "primary": "うじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "王右丞が詩に、屏風誤點惑孫郎。",
              "citation": {
                "source": "聞きたるまゝ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（十四）　（跋王右丞集）　余年十七八の時、摩詰の詩を読む最も熟す。",
              "citation": {
                "source": "放翁鑑賞",
                "author": "その七　――放翁詩話三十章――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（渭南文集、巻二十九）○王右丞、摩詰、共に王維のこと。",
              "citation": {
                "source": "放翁鑑賞",
                "author": "その七　――放翁詩話三十章――",
                "note": "青空文庫"
              }
            },
            {
              "text": "【八月】辛亥中書右丞｜孛羅鐵木兒。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
