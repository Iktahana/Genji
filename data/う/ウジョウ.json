        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の厳格な態度の奥には、困っている人を放っておけない有情が感じられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "無味乾燥な法律の世界にあっても、判決には被告への有情が込められていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "殺伐とした世の中だからこそ、他人に対するちょっとした有情が胸に染みる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
