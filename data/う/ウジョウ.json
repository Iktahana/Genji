[
  {
    "uuid": "04db5beb-8cee-5de7-92f5-ecaedda25c6f",
    "entry": "有情",
    "reading": {
      "primary": "うじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
