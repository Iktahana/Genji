        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "わが心慰めかねつ更科や姨捨山に照る月を見て月見れば千々に物こそ悲しけれ我身ひとつの秋にはあらねど中庭地白ウシテ樹ニ鴉棲ム。",
              "citation": {
                "source": "月の詩情",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カウシテ、イチニチ　クラシマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　アンナニ　マドガ　タカクテ、ドウシテ　ナカヲ　ノゾク　コトガ　デキマセウ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチデハ　トウサン　トツテモ　ヤサシイノニ　ガクカウデハ、ドウシテ　コンナニ　キツイノダラウ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カウシテ、オトモダチヲ　ジユンジユンニ　タヅネテ　イキマシタガ、ドノ　トモダチモ　オナジ　コトヲ　イフノデ　アリマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と、思う胸騒ぎを、じっと抑えて、読み下すと、アスマデニ三〇〇エンツゴウシテクレ、イノチガケニテタノム、アネ　と、いう電文だった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ガ純潔ヲ維持スル如ク男子ガ其ノ童貞ヲ完ウシテ結婚スルコトハ双方ノ道義的責務ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ、アノ新聞記事ヲ見マシテカラ、ヤット昨晩、家ニ帰ッテ見マシタラ、祖母ハ蚊帳ノ釣手ニ、妻ノ赤イ細帯ヲカケテ、首ヲククッテ死ンデオリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……二人の博士はドウシテこんなに私を中心にして騒ぎまわるのであろう……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は……」「……ドウしてですか……」「ドウシテじゃない。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ私ハ別ノ手段デ、モットモット皆サンニ、思イ知ラセマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその一つ一つが「助けてくれ助けてくれ」と五色の悲鳴をあげているのだから、平生なら抱腹絶倒の奇観なんだが、この時はドウシテ……その一人一人が絶体絶命の真剣なんだから遣り切れない。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネ……ホラ……お眼々があって、お鼻があって……お口も……ネ……ネ……ソウシテお帽子も……」「……マア……気味のわるい……。",
              "citation": {
                "source": "人の顔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きいのや小さいのや、いくつも並んで……ソウシテネ……ソウシテネ……また方々にいくつも人の顔があってよ。",
              "citation": {
                "source": "人の顔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノトキ、私ニハドウシテモ、君チャンタチハオソロシイ、ノドマデクチノサケタオニノヨウニオモワレタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　人気失墜の原因　美妙斎はドウシテ人気を失墜したろう。",
              "citation": {
                "source": "美妙斎美妙",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "二葉亭が一生自ら「文人に非ず」と称したについてはその内容の意味は種々あろうが、要するに、「文学には常に必ず多少の遊戯分子を伴うゆえに文学ではドウシテも死身になれない」と或る席上で故人自ら明言したのがその有力なる理由の一つであろう。",
              "citation": {
                "source": "二葉亭四迷",
                "author": "――遺稿を整理して――",
                "note": "青空文庫"
              }
            },
            {
              "text": "独り他人を軽侮し冷笑するのみならず、この東洋文人を一串する通弊に自ずから襯染していた自家の文学的態度をも危ぶみかつ飽足らず思うて而して「文学には必ず遊戯的分子がある、文学ではドウシテモ死身になれない」という。",
              "citation": {
                "source": "二葉亭四迷",
                "author": "――遺稿を整理して――",
                "note": "青空文庫"
              }
            },
            {
              "text": "大西郷の役廻りはドウシテモ坪内君に向けなければならぬ。",
              "citation": {
                "source": "明治の文学の開拓者",
                "author": "――坪内逍遥――",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄弟五人中津の風に合わず扨中津に帰てから私の覚えて居ることを申せば、私共の兄弟五人はドウシテも中津人と一所に混和することが出来ない、その出来ないと云うのは深い由縁も何もないが、従兄弟が沢山ある、父方の従兄弟もあれば母方の従兄弟もある。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガハバカリニ入ッタ後、私ハ床ノ中デイロイロ考エマシタガ、ドウシテモ彼女ニ会ッテ彼女ノ心ヲ飜エサネバナラヌト思イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウシテ私ヲオ父様ノ所ヘ返サナイト『アグニ』ノ神ガオ婆サンノ命ヲトルト言ツテヤリマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ私ヲオ父様ノ所ヘ返サナイト『アグニ』ノ神ガオ婆サンノ命ヲトルト言ッテヤリマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜靜カニ水寒ウシテ魚喰ハズ、滿船空シク月明ヲ載セテ歸ル――自分は斯うした片言憶えの文句を口吟んだ。",
              "citation": {
                "source": "湖畔手記",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ嬢サン、提灯ヘローソク入レマス、オ待チナサイ、ソウシテ、今夜ワタシ、アナタノ淋シイノヲ慰メルタメニ、一晩中、器量一パイウタイマス、ワタシ、知ッテル世界ノ国々ノ唄トイウ唄、ミンナ歌イマス、イチバンシマイニ日本ノ、歌イマス……夜ガ明ケテモカマイマセン」　マドロスは、すっかり興奮しきっている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫くして、「女｜賢シウシテ牛売リ損ネル……」と、二三度、口のうちでつぶやきながら、筆の進行をすすめて思案の体――「女賢シウシテ牛売リ損ネル……」　彼は、今、再三それを繰返して、「はて、この故事来歴の出典は、どこであったかしら」　思案の種はそれでした。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女賢シウシテ牛売リ損ネル」という俚諺は、日頃、耳目に熟していながら、さて、これを紙に書いて、その解釈を附する段になって、神尾がハタと当惑したのであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "母のことを思い出して書いて行くうちに、右の「女｜賢シウシテ牛売リ損ネル」につき当って、その解釈に当惑したという次第なのでありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
