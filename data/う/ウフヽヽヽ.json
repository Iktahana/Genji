          "literary": [
            {
              "text": "Ｂ　ウフヽヽヽ、それからまだ斯ういふ話があるよ。",
              "citation": {
                "source": "ハガキ運動",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カヤちゃんの入学祝いよ」「ウフヽヽヽヽ」とカヤノは胸を張った。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴村博志は、すこし割り切れぬまゝに、釣り込まれて、ウフヽヽヽと笑つた。",
              "citation": {
                "source": "記憶のいたづら",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウフヽヽヽヽ」　と、楯氏は、喉の奥で笑つた。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウフヽヽヽヽ」　楯氏の喉が、また鳴つた。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
