[
  {
    "uuid": "4830b6e2-8012-5ae4-af41-ca5d5496676a",
    "entry": "うず高い",
    "reading": {
      "primary": "うずたかい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
