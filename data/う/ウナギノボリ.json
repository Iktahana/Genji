        "examples": {
          "standard": [
            {
              "text": "株価がうなぎ登りに上昇して、投資家たちが沸き立っています。",
              "source": "幻辞"
            },
            {
              "text": "彼の人気はSNSへの投稿をきっかけにうなぎ登りに上昇した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "物価のうなぎ登りが続き、家計のやりくりが難しくなってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "常にコンピューター室にたむろしては、使用時間に対応したレンタル業者の請求額をうなぎ登りに増加させるウォズニアックは、すぐに学校側に目を付けられた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
