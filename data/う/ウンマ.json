          "standard": [
            {
              "text": "イスラム教におけるウンマは、信仰を共有する人々の共同体を意味する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ウンマという概念は、イスラム教の核となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "世界中のウンマは月のラマダンを通じて、精神的に一つになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "アリス・リイヴル――偶然にも前の被害者と同じ呼名である――という女中が、ボウンマスでチャアルス・オリヴァ・ジェイムスと呼ぶ男と知りあいになった。",
              "citation": {
                "source": "浴槽の花嫁",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃になって知ったのは、ウシンコッコ、ウンマンコッコ　薩摩チンチノコマ　　　　　　　　　駿河｜駿東郡ベコノツノツキ　　　　　　　　羽後秋田郡などです。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
