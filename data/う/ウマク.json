[
  {
    "uuid": "46173388-ddd8-542f-843b-2aa1c05c6fee",
    "entry": "上手く",
    "reading": {
      "primary": "うまく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
