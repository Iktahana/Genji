[
  {
    "uuid": "3063c414-7d76-5e48-9a3f-203245ae2c92",
    "entry": "嘘つき",
    "reading": {
      "primary": "うそつき",
      "alternatives": [
        "ウソつき"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
