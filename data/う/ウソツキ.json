        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の嘘つきは今に始まったことではなく、子供の頃からの筋金入りだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ほんの些細な嘘つきが、やがて取り返しのつかない大きな問題を引き起こした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は自分の嘘つきを隠すために、また別の嘘を重ねていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
