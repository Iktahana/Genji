        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヒラガナノ活字ガイカニ醜イカトイウコトハ初号クライノ活字ヲ見タラダレニモワカルダロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今となって、こういう行を平気で行い、出来ヌト云ウコトハナイモノダ――とホザくところはただののらくら者ではあり得ない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "可ナリ激シクテモソノタメニ寝ラレナイト云ウコトハメッタニナイノニ、昨夜ハ夜中ニ眼ガ覚メ、耐エ難イノデ佐々木ヲ起シ、ノブロンヲ注射シテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………日記ヲ書クト云ウコトハ、書クコト自身ニ興味ガアルカラ書クノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不便ト思ウノハイヽケレド、オ爺チャンヲ楽シマセルタメニ、アタシガ犠牲ニサレルノハ嫌ダワ」「犠牲ト云ウコトハナイデショウ、僕ヲ楽シマセルト同時ニ、君自身モ楽シムンジャナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ母屋デモ家族全部ヲ収容スルノニ狭過ギルト云ウコトハナイガ、予ガイロ／＼ト企ンデイル悪事ヲ実行スルノニハ少シ不便デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処ト云ウコトハ明カデナイガ、多分割下水時代ノ彼女ニ違イナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヤ、ソコガアノ方ノ偉イトコロデスヨ、麻酔ドクターマデ呼ンデ十分ノ用意ヲシテカヽッタンダカラ、誰デモヤッテシマイタクナルトコロダガ、僅カ一滴ノ血ヲ見タヾケデモ大事ヲ取ッテ中止スルト云ウコトハ、ナカ／＼出来憎イコトデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
