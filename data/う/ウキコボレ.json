        "examples": {
          "standard": [
            {
              "text": "クラスの授業が簡単すぎて退屈した彼は、浮きこぼれの典型的な例とされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "飛び抜けて成績のいい生徒が孤立する浮きこぼれの問題は、長年見過ごされてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "進度の合わないクラスに置かれた優秀な子が浮きこぼれを経験し、学校への興味を失った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
