        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "信長は浅井・朝倉の連合軍を討ち滅ぼし、近畿の覇権を確立した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "幕府軍は反乱を起こした大名を討ち滅ぼすため、大軍を差し向けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "敵の本拠地を包囲し、三日三晩の激戦の末に完全に討ち滅ぼした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "彼等の一人が（より劣勢なる）他（の都督）を討ち滅ぼすに從ひ、彼は後者の所領を併せ、その土地をすべて荒し、その住民を食ひ盡くした。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
