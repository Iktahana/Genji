    "definitions": [
      {
        "index": 1,
        "gloss": "to drive someone off with gunfire",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "守備隊は陣地に迫る敵兵を銃撃で撃ち払った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "海賊船が近づくと、砲台から砲弾を放ち撃ち払った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "兵士たちは塹壕から飛び出してきた敵を撃ち払い、陣地を保持した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "走屍を撃ち倒すには箒草の箒を用いることをかねて心得ているので、劉のいうがままに箒を持って来て、かの死骸を撃ち払うと、死骸は元のごとく倒れた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "子不語",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
