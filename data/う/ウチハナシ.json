        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "週末は近所の打ち放しでスイングの練習をするのが習慣になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "打ち放しで百球打ったが、なかなかフォームが安定しない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「打ち放しに行こう」と友人を誘い、二時間ほど練習した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
