      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君は、君自身の「かよわい」善良さを矢鱈に売込もうとしているようで、実にみっともない。",
              "citation": {
                "source": "風の便り",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、売込の妨害をされないためだけにでも、五百やそこらは放り出すべきだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "養子が横浜で売込商のようなことをやっているので、その仕送りで気楽に暮らしているらしい。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "孝平はそれをどこかで手に入れて、大野出目の作なぞといういい加減の箱をこしらえて、高い値に売込もうというたくらみと見えました。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "梶井の父は軍需品の売込みか何かに関係して、よほど儲けたという噂であったが、戦争後の事業勃興熱に浮かされて、いろいろの事業に手を出したところが、どれもこれも運が悪く、とうとう自分の地所も人手にわたして、気の毒な姿でどこへか立去ってしまいました。",
              "citation": {
                "source": "月の夜がたり",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉のお定は三五郎という山女衒――やはり判人で、主に地方の貸座敷へ娼妓を売込む周旋をするのだとか申します。",
              "citation": {
                "source": "蜘蛛の夢",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが今帰って行った水原さんで、維新後に河内屋は商売換えをしてしまいましたが、水原さんは横浜へ行って売込み商をはじめて、それがとんとん拍子にあたって、すっかり盛大になったんですが、それでも昔のことを忘れないで、わたくしのような者とも相変らず附き合っていてくれます。",
              "citation": {
                "source": "半七捕物帳",
                "author": "化け銀杏",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国へ此方の塗物を売込む会社。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "露西亜や、支那に売込んで行く様子も、この眼で見たんですからいつでも現場に御案内致しますが、しかし値段のところはちょっと見当が付きかねます。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そればかりでなく、「Ｈ・Ｓ」の製罐数の大部分は親会社である「日露会社」に売込まれて、カムチャツカに出ていた。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "磐城炭の売込を計劃したことも有ったし、南清地方へ出掛けようとして、会話の稽古までしてみたことも有った。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは長生きしたいなんて、一度もいったことはねえぞ」　ドレゴは、話のわからない船主の間を辛抱強く訪ねて廻って、くりかえし砕氷船の売込みに奔走した。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "盛文堂では、この頃売込んだので質を悪くしたと思った。",
              "citation": {
                "source": "打あけ話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は荷車に積み或は天秤で担いで一日に五里六里と歩いて中国山脈の山の奥へ奥へと売込んで来るのである。",
              "citation": {
                "source": "備後より",
                "author": "中村憲吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊五郎も固ぼつとをかくる人ならず、ただ申歳からの思ひ付で出したものなれば、箝らぬは尤とはいひながら、売込んだ愛敬を振廻し、やたらに気を利せ、洒落を云ふため、例に因りてその本性を失へり。",
              "citation": {
                "source": "両座の「山門」評",
                "author": "三木竹二",
                "note": "青空文庫"
              }
            },
            {
              "text": "之は学校の先生達の卒業生売込運動や卒業生の各種のヒロイズムでも解消しないし、「世間雑話」的な世渡り精神でも役に立たぬ。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "之によって彼等は或いは出版業者の事実上の顧問乃至店員として、或いは自分自身出版業者として、又出版計画の売込人として、出版資本の内部に潜り込むのである。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをお前が、いったいどうしようというのだ」「どうしようたって、おじさん、お屋敷へ売込むんでさあ」「お屋敷……ドコのお屋敷へ？",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そりゃ、おじさん、わかってるだろう、その薩摩守のお屋敷へさ……」「お前が……その鉄砲と、刀を、薩摩のお屋敷へ売込もうというのか――？",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「つまり、絵の偽作をする奴なんです、名家の絵を偽作して、盛んに売込んで儲ける奴があるんですな。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうした、気でも狂ったか、シルクの売込みでも、ものになったか」「どう致して、そんなんじゃあござんせん、かねて鐚が計画の芸娼院――そいつがいよいよ成立を致しましてな、さるお大尽から大枚金一万両というもの補助がつきました、金主一万両、鐚一代の大望成就！",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そればかりでなく、昔のように僅かの資本で店を持つことが難かしく、ことに最近では百貨店や公設市場の進出のために、多年売込んだ老舗でさえもついに閉店の憂目を見るという有様で、新たに店を持つのには余程の困難を覚悟せねばならない。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "前にも述べたやうに、脚本の原稿を本屋や雑誌社に売込むと云ふことは先づ絶対に無いと云つていい。",
              "citation": {
                "source": "劇場と作者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "好景気時代に二倍にした学校数によって、不景気が来た時、卒業生の売込みに困難を生じたるがゆえに、ここに卒業生を半減するにいたるのは、まさに思想才能の操短化である。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "……てめえ、俺を出し抜いて野毛山へ王様を売込んだろう」　というと、右手でバロンの喉輪を攻め、「今朝日比谷で騒いでいた安亀の一味十人が「呉竹」の離座敷にいることはちゃんと見通しなんだ。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "本県の農家を六万七千戸と押へて、君、一戸当り毎年百本の売込みに成功してみたまへ。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば芸術の売込的レディーメード性、芸術の売色的線香性、幇間性、落語的被注文性、芸術の速力化、合理化、大量生産化等々凡て諒解できる語彙である。",
              "citation": {
                "source": "「壇」の解体",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "其賣方が、僕の才の方をば推稱せずして文學が非常に熱心で其爲め財産を總て蕩盡したとか、何とか云つて賣込んだものである。",
              "citation": {
                "source": "自傳",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "暇で仕樣のない大名が、拔け荷の和蘭鐵砲を賣込まれて、ツイ欲しくなつたんだらう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "佛像の膝",
                "note": "青空文庫"
              }
            },
            {
              "text": "測らずも金森家の鐵砲賣込のことから、恩人の富崎左仲が切腹し、伜の佐太郎は三千兩を償ふ由もなく、恥を忍んで主家を退轉したと、――妹のお袖から聞いた姉のお幾は、昔の仲間を語らつて釜屋に忍び込み、お袖とよく似た顏容を利用して、金の番をしてゐる伊八を殺しました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "八千兩異変",
                "note": "青空文庫"
              }
            }
