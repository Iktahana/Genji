        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "四　天皇は後にとうとうおん年百三十でおかくれになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにかお調べの御用でもあるんでございますか」「御用番というほどのことでもねえが、あの晩、おれと一緒にいたお鉄というおんなに情夫でもあるのかえ」「情夫だかなんだか知りませんが、若い男が時々にたずねて来るようです」　六助の話によると、先頃から一人の若い男がときどきに加賀屋の近所へ来てうろうろしている。",
              "citation": {
                "source": "半七捕物帳",
                "author": "松茸",
                "note": "青空文庫"
              }
            },
            {
              "text": "家をあけた朝、襖をがたぴしと締め、瀬戸物を砕いた果は、「骨も肉もしゃぶったから、もうおん出すつもりでしょう」などと、聞くに忍びないようなことを口にして狂乱する狂態は、厭わしいものよりも恐ろしかった。",
              "citation": {
                "source": "文妖伝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし迫害が烈しいだけに、「万事にかない給うおん主」も、その頃は一層この国の宗徒に、あらたかな御加護を加えられたらしい。",
              "citation": {
                "source": "おぎん",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「万事にかない給うおん主、おん計らいに任せ奉る。",
              "citation": {
                "source": "おぎん",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもそのときにはもうおんどりは小屋のうちにはいり、なかから窓をしつかりしめてゐます。",
              "citation": {
                "source": "幸坊の猫と鶏",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ええん、うえん、うえん、うえん、うおん、うおん、うおんといふ号泣が益々高く鳴り出してゐた。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "えんえんえん、うおんうおんうおん……まるで区別がつかねえや……」　言葉の途中から深い反省と無意味とを痛感したものらしい、言ひ終ると、恐らくは深い放心に襲はれて、真つ暗な家の奥へヒョコヒョコ身体を運ぶやうに歩かせる音がしてゐる。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "中で圓朝の心に通うおんながただ一人だけあった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "尊体は昼間見てきたように、蓮座を軽く踏まえて立たせたまうおん姿そのままである。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "警笛が鳴って八分三十秒にとどいたときに私にはもうおんなの人は一人も見えていなかった。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日じゅうおんなじ灰色で。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「けんかの途中で、おびえてつばさをたれてしまうおんどりのように、度を失っているな。",
              "citation": {
                "source": "ヴェニスに死す",
                "author": "DER TOD IN VENEDIG",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……はい」「みごとにお詠みなすったこと、本当に美しくみごとなお歌ですね」「お恥ずかしゅうございます」「僅かなあいだにたいそうなご上達です、これだけお詠めになればもうおんなのたしなみには過ぎたくらいでしょう」　かな女は短冊をしずかに置き、やさしく嫁の顔を見やりながら云った。",
              "citation": {
                "source": "日本婦道記",
                "author": "梅咲きぬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "観音の山からは、ごーん、うおんうおん――と、たえまなく鐘の音がひびいてきた。",
              "citation": {
                "source": "大根の葉",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その鎖駕籠のうちに、お身をひそめたもうおん方こそ、まぎれもなき勝頼公と見た。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "てんのうの　おつかい　一休さんは　やましろのくに（いまの、きょうとふ）たまぎむら　と　いう　ところに、しゅうおんあん　と　いう　小さな　いおりを　たててもらって　すんで　いました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまがさきの　こうとくじ　と　いう　おてらの　じゅうしょくの　じゅうちゅう　と　いう　おしょうさんが　ごつちみかどてんのうの　つかいと　して、この　しょうおんあんに　きました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そういうおん身の考え方は、浄土門でもっとも忌み嫌う聖道門的考えかただ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
