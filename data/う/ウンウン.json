  {
    "uuid": "66c85dd7-9737-5f98-9011-24f068dcd6d0",
    "entry": "うんうん",
    "reading": {
      "primary": "うんうん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "感動詞"
      ],
      "ctype": null,
