    "definitions": [
      {
        "index": 1,
        "gloss": "uh-huh",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「明日も晴れるかな？」「ウンウン、きっと大丈夫だよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女の話にウンウンと頷きながら、ひたすら聞き役に徹した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「これでいいんだよね？」「ウンウン、完璧だ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "雪枝も嬉しそうに、Ｔ「其処で　人知れず親子の　対面なされたら……」　「ウンウン」と老人。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　武蔵が、Ｔ「先生の門人として　道中御供　致し度う御座る」　ウンウンと団九郎。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　武蔵が「ハイＴ「吉岡憲法先生の　吉岡流を少々ばかり」　団九郎、ウンウン、アーアー。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると割合に寂しい横丁の出口のところで、日本人のお婆さんが、長さ五尺位の菰でくるんだ大きな荷物を道ばたに立てて、それをウンウン唸りながら担ごうとしているんだけど、迚も重たくって担げそうもないのよ。",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……フ――ム……そんならお前は、その女の顔を記憶しとるじゃろう……ナ……しとるじゃろう……ウンウン……記憶しとる……それは眼の大きい、口の小さい、頬の丸い、二重｜腮の女じゃったろう。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョット見たところ肉感的な……ウンウン……その女の耳朶に小さな穴がありはせんかったか……耳輪をはめた……ウンウン……出たらめを答えると承知せんぞ……ええか……それから」　男は一寸言葉を切った。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨年の大｜虎列剌の時に死にましたので……」「ウンウン。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "桃の刺青はウンウンうなずきながら聞いていたが、そのうちに二三度鉢巻を締め直した。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……エエわからん……まっとハッキリ云え……ナニイ……あの別荘の奴等がか……ウンウン……あの赤い鳥にバカタレと云わせたんか……ウンウン……それに違いないナ」　横に立っていた小さい児も、指を啣えたまま、大きい児と一緒にうなずいた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "実はこの間、旦那様からどこか涼しい処に別荘地はないかと、お話が御座いましたので……」「ウンウン。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちにその九州日報を首になりましたので、私は書きたい材料をウンウン云うほどペン軸に内訌させたまま山の中に引込んで、そんな材料をポツポツペン軸から絞り出して行くうちに、山の中特有の孤独な、静寂な環境のせいでしょうか。",
              "citation": {
                "source": "スランプ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁は黙ってウンウンとうなずきながら聞いていたが、とうとうこの愉快な代議士君に引っぱり出されて鎌倉の円覚寺に釈宗演和尚を訪う事になった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私とツン州と二人で感心して見ております前で、約束通りにウンウン呻吟きよる大惣の脈を取って、念入りに診察しますと病人の枕元で談判を初めました。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大惣……黙って呻吟きよれ』『ウンウン。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "クタビレタ』『ウンウン……ウンウン……スマンスマン……』『モウ呻吟かんでもヨカ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ暫く飢渇いておったところですから、骨休めというので、ツン公と二人で燗もせぬ酒をグビリグビリやっております、とその横で大惣がウンウン唸り出しました。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "閉口しながらウンウン云って書いておりましたっけ」「酒は好きだったらしいですね。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロソロと近寄って、ウンウンと嗅ぎ合ってその同性同志である事がわかる……何等の利害関係のない赤の他犬である事が判明すると、憤然として鼻に皺を寄せます。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "上手なバラライカや胡弓の音を聞くたんびに耳を押えてウンウン云っていたのですが……そうして一日も早く両親の処へ帰りたい……上等のグランドピアノを思い切って弾いてみたいと、そればかり考え続けていたのですが……。",
              "citation": {
                "source": "死後の恋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……世界中の人間が一人残らず不眠症にかかって、ウンウン藻掻いている真中で、自分一人がグーグー眠れたらドンナにか愉快だろう……なんかと、そんな事ばっかりを、一心に考え詰めている矢先に、横の方から和ごやかな寝息がスヤスヤ聞えて来たりなんかしたら、最早トテモたまらなくなるんです。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "屍体でも何でも見せるから……ウンウン……」　大塚警部は一人で承知したように、形式だけ片手をあげると、クルリと私に背中を向けて、サッサと筥崎署の方へ歩いて行った。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、ウンウン呻吟く。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫にすこし客の相手をしていてくれと頼めば源四郎は「ウンウン」と返事はしても、立ちそうにもせぬ。",
              "citation": {
                "source": "告げ人",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "脣を食ひ縛つて、下腹にウンウンと力を籠めて、一生懸命に息を殺して、ナイフの尖端と、それが刺すべき表皮の一点とを眼ばたきもしないで眺めた。",
              "citation": {
                "source": "痴想",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い熱のためにウンウン言っていたんですって。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "殻の色が黄色から桃色……桃色から茶色へ……茶色から灰色へ……そうして中から聞こえる寝息と思っていた物音が、夜の更けるにつれて高まって、しまいにはウンウンという唸り声かと思われるようになりました。",
              "citation": {
                "source": "卵",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
