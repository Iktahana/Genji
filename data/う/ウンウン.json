        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は高熱でうなされ、夜通しウンウンとうなっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "重い荷物を背負い、ウンウンと唸りながら坂道を登っていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "お腹を壊したらしく、トイレの中からウンウンと苦しそうな声が聞こえる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
