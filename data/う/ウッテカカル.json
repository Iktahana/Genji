        "examples": {
          "standard": [
            {
              "text": "試合開始の合図とともに、彼は猛烈な勢いで相手に打って掛かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "臆することなく強敵に打って掛かる若手の姿に、観客から大きな拍手が送られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は竹刀を構え直し、鋭い踏み込みで果敢に打って掛かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "まっこうからそれにうってかかるか、さもなければその意味がわからないような顔をしてひとまず退却しておき、あとで、おもむろに、四方八方から、それがどういう経路でその人の心の中に入り込んだのかを、さぐり出してやらねばならない。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
