[
  {
    "uuid": "a6f0c182-f496-5c8c-8591-44a4c569765e",
    "entry": "海胆",
    "reading": {
      "primary": "うに",
      "alternatives": [
        "ウニ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
