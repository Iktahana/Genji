      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "sea urchin",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "寿司屋で新鮮な海胆の軍艦巻きを頼んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "北海道から直送された海胆は、とろけるような甘さだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "海胆が苦手だと言っていた彼も、ここのなら美味しいと食べていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "また海胆や塩辛類の含有する回生の薬物についても科学はまだ何事をも知らないであろう。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "木の芽やら海胆やら、松露やら、季節ものの匂いが食卓のまわりに立ち籠めるほど、わたくしはいよいよ感傷的になった。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "沃度に、塩にさ丹づらふ海の宝のもろもろは濡髪長き海藻や、珊瑚、海胆、苔までも、臙脂紫あかあかと、華奢のきはみの絵模様に、薄色ねびしみどり石、蝕む底ぞ被ひたる。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし何でしたら、海胆でも御着け遊ばしたら――」　と言って婆さんは勝手の方から来た。",
              "citation": {
                "source": "刺繍",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "海に向った方のテーブルの上では、水から出されたばかりの牡蠣の貝や海胆の毬が積まれていった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "渋色に塗った低めの長い食卓には、鉢から移された前菜の、生海胆、琵琶湖産の源五郎鮒の卵巣、日向産の生椎茸の油煮、熊の掌の煮付に添えたひじき、鴨のロース、仙台産の味噌で包んだ京の人蔘、など、これらが織部の小皿に並んでいる。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "穴を覗いて行くと、よく海胆が一つか二つ紺紫色の姿を見せていることがある。",
              "citation": {
                "source": "真夏の日本海",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのあたりの海では大抵の場合、栄螺はきまったように海胆と一緒に棲んでいるような気がしたが、偶然なのか、あるいは何かそういう習性があるのか、いつか動物の先生にきいて見たいと思いながらそれ切りになっている。",
              "citation": {
                "source": "真夏の日本海",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "穴を覗いて行くと、よく海胆が一つか二つ紺紫色の姿を見せてゐることがある。",
              "citation": {
                "source": "真夏の日本海",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのあたりの海では大抵の場合、栄螺はきまつたやうに海胆と一緒に棲んで居るやうた気がしたが、偶然なのか、或は何かさういふ習性があるのか、いつか動物の先生にきいて見たいと思ひながらそれ切りになつてゐる。",
              "citation": {
                "source": "真夏の日本海",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜になると、亡者が此処から出て来て、昆布や海胆などの磯のものを取り、戻って行ったとのことであった（幌別本町の板久孫吉老）。",
              "citation": {
                "source": "あの世の入口",
                "author": "――いわゆる地獄穴について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "海胆の卵に関するＥ・ルーのかの有名な実験の結果は、此の二種類の運命の概念を区別しなかった為に、誤って、却って生気論に不利な結果を示すかのように解釈されたものに過ぎなかった、とそうドリーシュは考える。",
              "citation": {
                "source": "現代唯物論講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば海胆の内皮や外皮のどの一部を取り出しても、その取り出された部分は再生生長する。",
              "citation": {
                "source": "現代唯物論講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボーリングの早いうちから砂岩は白亜紀の石灰岩の鉱脈に席を譲っており、そこからは小さな頭足類の化石や、珊瑚、海胆、スピリフェラ、時折石海綿や海棲脊椎動物の骨らしきもの――後者は真骨魚類、鮫、硬鱗魚類だろう――が大量に得られた。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "平地と傾斜した浜との境にもりあがつた砂丘には雑草や風に吹きためられた黒松がへばりつき、すつきりした漁船が曳きあげられて、舟をすべらすための枠、鳥の巣みたいな生けす、あか汲み、縄、海胆、ひとでの殻なぞころがつてゐる。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "魚類ばかりでなく、海胆、海鼠、烏賊及びある種の虫さえも食う。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "路の両側には店舗がぎっしり立ち並んでいて、その多くでは貝殻、海胆その他海浜で集めたいろいろな物でつくった土産物を売っている。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "海胆の二つでつくった簡単な独楽がある（図132）。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "で私が大事なサミセンガイを研究している間に、彼等は貝、海胆、ヒトデ等をそれぞれの区分に分ける。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "貝類の全部、海老や蟹の全部、鮫、エイ、それから事実あらゆる種類の魚、海藻、海胆、海の虫等がそれである。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "この写生図（図172）によって、実験所の内部の大体が判るであろう――枠に布を張り、その上でヒトデや海胆を乾燥もするが、このような仕事には、とかく、ガタピシャ騒ぎがつきものである。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "食料の過半をなすものは脊椎のある魚だが、而も然るべき大きさの軟体動物は、烏賊と共に市場で見られ、その他｜海胆の卵、蠕虫に似たサベラ、腕足類のサミセンガイ、海鞘属のホヤ、その他数種の海藻等もある。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて俺は人生が、すつかり自然と遊離してゐるやうに感じだす。",
              "citation": {
                "source": "夏と悲運",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、冗談ぢやない、僕は僕が輝けるやうに生きてゐた。",
              "citation": {
                "source": "酒場にて（定稿）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らく、人が、思はず云ひ過ぎをしてしまふやうに、自殺も、思はずしてしまふやうなものに相違ない。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術家としての牧野さんは、幾分線が細過ぎたやうに私は思ふ。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしともかく、それらの音楽によつて多くの人々が、好い気持にされてゐるのだから文句はないのだが、然しもと／＼気分の暈縁なぞといふオボコイものを聴いて喜んでゐる連中が取引のこととなると俄然骨ばつてくるし、而も楽々骨ばれるやうに前以て備へてゐるので、「音楽と世態」なぞと今並べてみたくなるのである。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それといふのが世態で何しろ神経生存だけになつてゐて、まづまあ金ピカ流儀を覚えて「嗤はれないやうに嗤はれないやうに」か、又一方「我等は若きプロレタリアだツ」になるほか差当つて帰趨を知らないからである。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、まあこのおしまひの手合なんぞは、云つてることに何の意味もないにしてからがチヨイト頭を捻ること言換れば位置にお構ひなしに移動の万能範囲を拡げることが、いとも優秀なことのやうに思はれることは現時の流行感冒である。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "人によつて色々異ることと思ひますが、私は詩に就いては自分に分るやうにだけは考へますが、それを人に分らせようとするや大変骨が折れます。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
