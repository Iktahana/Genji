  {
    "uuid": "ef09ec8b-0210-508f-984a-a25a26190e32",
    "entry": "ウシヤ",
    "reading": {
      "primary": "うしや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "隣の蒲団では、中学二年生の修一が亀の子のやうに首をひつこめて、こつそり煙草を吸ひながらトウシヤ刷りの怪しげな本に読み耽り、楢雄の方は見向きもしなかつた。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「メー、ウシヤマの主人が、アメリカでＴさんに逢つたんですて。",
              "citation": {
                "source": "女流作家",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニシロ　オカネガ　アリマセンノデ、キシヤヤ　ジドウシヤニ　ノル　コトハ　デキマセン。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コドモタチヤ、コノ　バシヤハネ、オマエタチガ　マダ　ウマレナカツタ　ジブン、マダ　ジドウシヤト　イフ　モノガ　ナカツタ　トキ、ムラカラ　マチノ　テイシヤバマデ　マイニチ　カヨツタ　モノダヨ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのさま恰も未だ巨人島にわたらぬガリワルの如く、また未だガリワルを見ざる「リリピユウシヤン」の如く、豕を抱いて臭きことを忘れ、古井の底に栖みて天を窺ふ。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が此の時の不愉快は、屡々泰西の戲曲を演じる松井須磨子は、何故にもつと歐米人の姿態――身ぶり、手ぶり、足ぶりを研究しないか、カチュウシヤの歌をうたひ、さすらひの歌をうたひ、更に山姫の歌をうたふ松井須磨子は、何故にほんたうに聲の出るやうに正式の聲樂の練習をつまないのか。",
              "citation": {
                "source": "貝殼追放",
                "author": "向不見の強味",
                "note": "青空文庫"
              }
            },
            {
              "text": "存在の存在たる所以は、存在の本質・存在のウシヤ＝実体・は物質にあるのではなくて形に存する、ということになる。",
              "citation": {
                "source": "現代唯物論講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ、ボンコチヤンヲコサヘテクレタバウシヤサンノ「バウシノオ父サン」ノ所へ行キマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムツシユウ・エ・ラ・アベク・マダム・ウシヤマ。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデソレデハ　ユカウトオホイソギデシタクシテ、ジドウシヤニノリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
