          "literary": [
            {
              "text": "これはいいじゃん」　と、慶一は〈ディーズ・ブーツ・アー・メイド・フォー・ウォーキン〉をひらひらさせた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロック・ウォーキング、垂直の岩壁を散歩するのでなければ、現代のアルピニストではないそうですね。",
              "citation": {
                "source": "登山は冒険なり",
                "author": "河東碧梧桐",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはウォーキングレース、登山のごとく、距離あるいは高さにおける量的比較の可能をもってのみスポーツの意味をもつ。",
              "citation": {
                "source": "スポーツの美的要素",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "打球よりもウォーキングが目的のようにセカセカと忙しそうに先を急いでいる。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブギのリズムにウォーキング・ベース、ギターのソロ、コーラス、リード・ヴォーカル。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
