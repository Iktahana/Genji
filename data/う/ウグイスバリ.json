        "examples": {
          "standard": [
            {
              "text": "お寺のうぐいす張りを歩くと音がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "うぐいす張りの床板は古くから使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "修復時にうぐいす張りの構造を見直した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "今そのうぐいす張りの細廊下がキューッとふしぎな音をたてて鳴いた、人の体重を受けて。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
