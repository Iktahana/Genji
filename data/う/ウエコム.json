        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「花壇の端っこに、パンジーの苗を丁寧に植え込んでいこう」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は土を掘り起こし、春に咲く球根を一心不乱に植え込んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "砂漠に緑を取り戻すため、ボランティアたちが木々を一本ずつ植え込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そして庭の二方には、各種の樹木を雑然と植え込む。",
              "citation": {
                "source": "夢の図",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「銀杏樹やポプラを植えこむには、ずいぶん困りました。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その策は、カンザクラの苗木をまずおよそ千本くらい（なおたくさんあれば多々ますます弁ずる）用意して、これを熱海の適当なる地へ植えこむ。",
              "citation": {
                "source": "寒桜の話",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
