        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "向ふもそれに対へて、いたはるやうな眼ざしで頷き返すのである。",
              "citation": {
                "source": "灰色の眼の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼に言外のものをいわせて頷き返す。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "――碓氷峠以来何年ぶりかであきらかに見る仇の姿――重蔵は思わずあッと出る声を押えて、千浪にうなずき返すや否、無言のままタッタと後を尾行だした。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は素なほにうなづき返す。",
              "citation": {
                "source": "恢復期",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついうっかり槇氏も頷きかえすと、「あなたはたしか山田さんではありませんでしたか」などと人ちがいのことがあるのです。",
              "citation": {
                "source": "廃墟から",
                "author": "原民喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
