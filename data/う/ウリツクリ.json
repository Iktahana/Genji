        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「瓜作りになりやしなまし」という歌を、美声ではなやかに歌っているのには少し反感が起こった。",
              "citation": {
                "source": "源氏物語",
                "author": "紅葉賀",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（涙して）しがない瓜作りの山男を……これまでに……文麻呂　まあ、いいさ、衛門。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓜生ノ衛門　手前、生れ故郷の瓜生の山里に帰って、また瓜作りでも始めようかと思います。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "手前がまだ瓜作りをやっておりました時分、ふとした浮気心から云い交した娘がございました。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手、遠くの方から、瓜生ノ衛門夫婦の唄う「瓜作りの歌」が聞えて来る。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "笹山の　山坂越えて山城の　瓜生の里に我は　瓜作る　瓜作りナヨヤ　ライシナヤ　サイシナヤ我は　瓜作る　瓜作り　瓜作り　ハレ。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び、衛門夫婦のうたう「瓜作りの唄」が続く。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「駒の渡りの瓜作り、瓜を人にとられじと、守る夜あまたになりぬれば、瓜を枕につい寝たり」という今様歌がある、瓜を枕に野天の瓜畑で寝た風流はまことに羨ましい。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――高麗のあたりの瓜作り（ヨイショッと多数の掛声）　　瓜をば取られじと　　もる夜あまたになりぬれば（ヨイショッ！",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――高麗のあたりの瓜作り、（ヨイショッと多数の掛け声）瓜をば人に取られじともる夜あまたになりぬれば（ヨイショッ！",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
