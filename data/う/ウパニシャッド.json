        "examples": {
          "standard": [
            {
              "text": "大学の比較宗教学講座でウパニシャッドの思想について学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ウパニシャッドは、ヒンドゥー教の最高の叡智を記した文献とされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "古代インドの哲学者たちは、ウパニシャッドの中に真理を求めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "これらの考は希臘においてプラトーまた印度においてウパニシャッドの根本的思想であって、善に対する最深の思想であると思う（プラトーでは善の理想が実在の根本である、また中世哲学においても「すべての実在は善なり」 omne ens est bonum という句がある）。",
              "citation": {
                "source": "善の研究",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ａ　僕もとうに「ウパニシャッドの哲学よ、さようなら」さ。",
              "citation": {
                "source": "青年と死",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "出典に関するロランの照会への、インドのカーリダース・ナーグ博士の回答によれば、『ウパニシャッド』と『バガバッド・ギータ』が多分その出典と思われる――訳者〕　　　　　　＊　森の中の全能者よ！",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが彼に食ってかかる方の男はウパニシャットを愛誦し、たとへば富士山の崇高を仰ぐやうな気持で、人類諸君を肯定的に見渡してゐるのであった。",
              "citation": {
                "source": "霧",
                "author": "原民喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
