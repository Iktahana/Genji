        "examples": {
          "standard": [
            {
              "text": "祖母の時代には、田舎の姥捨て山へ進学することが高い教育機会だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女は地元の姥捨て山で日本文学を専攻している。",
              "citation": {
