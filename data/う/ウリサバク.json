        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は各地の卸問屋を通じて、自社の醤油を全国に売りさばいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "新興の音楽レーベルがSNSを活用してアルバムを世界中に売りさばくことに成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "独自のルートで仕入れたブランド品を転売業者が国内外で売りさばいていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
