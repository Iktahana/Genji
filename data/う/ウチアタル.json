        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いまこそ、ほんとうに、自分の身を粉にして、打ち当たるところができるのだ。",
              "citation": {
                "source": "からす",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "伯耆の夜見浜なども、寛永十六年の大水を始め数度の地変を経歴し、今の浜の目十八ヶ村は多くは三百年来の新墾であるのに往々にして陶器・古刀を発掘しまた古墳に打ち当たることが多かった。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その谷になった部分が船のヘッドから胴体へ進む時、次の山の部分がヘッドに打ちあたる。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その泥草鞋があやまって、往来の人に打ちあたる場合も少なくない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その泥草鞋があやまって往来の人に打ちあたる場合は少くない。",
              "citation": {
                "source": "薬前薬後",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチーン……カチーン……と岩壁に二、三度打ちあたる音が、夜の沈黙のなかにひびいた。",
              "citation": {
                "source": "涸沢の岩小屋のある夜のこと",
                "author": "大島亮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときおり向うの庇の間から、頭の君と道綱とが小声で取交わしている話し声に雑って、笏に扇の打ちあたる音が微かに聞えてくる。",
              "citation": {
                "source": "ほととぎす",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳にきこえたのは岩に打ちあたる波の音だった。",
              "citation": {
                "source": "浅瀬に洗う女",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
