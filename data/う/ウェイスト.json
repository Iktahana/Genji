        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "工場では生産過程で生じるウェイストを減らす努力をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "食材のウェイストをなくすために、家庭での工夫が求められる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は会議で時間をウェイストしないよう、事前に資料を共有した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ロダンさんは妾の裸体をお求めになったのですが、妾はウェイスト・クロスだけはとることは出来ませんでした。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロダンさんはモデル台で、彫刻の裡に潜む自然の力に打ち負かされて偶像のように立っている妾に近づいていらっしゃると、妾のウェイスト・クロスをおとりになったのです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車の中に、この春京都に行ったとき、電車の中で会ったモーニングに、日本の布のウェイストをつけた男、赤っぽい色や緑の形つなぎの着物をきた女とのって居るのに会った。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
