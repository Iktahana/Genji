          "literary": [
            {
              "text": "地震、と欄干につかまって、目を返す、森を隔てて、煉瓦の建もの、教会らしい尖塔の雲端に、稲妻が蛇のように縦にはしる。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月　青碧澄明の天、雲端に古城あり、天守聳立てり。",
              "citation": {
                "source": "月令十二態",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "其は深い焦茶色で、雲端ばかり黄に光り輝くのであつた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲端に霾る、と桃青居士の誇張した岩が根道も、追ひ剥ぎの出るに値する位は、人通りもあつたのである。",
              "citation": {
                "source": "山のことぶれ",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳の立木の上に、天主堂の尖塔、屹然と雲端を摩せるを見る。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
