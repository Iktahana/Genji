        "examples": {
          "standard": [
            {
              "text": "この卸売業者は得意先に対して売り掛けを認めているが、支払い期限は翌月末と決まっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "小規模な個人商店では、常連客との信頼関係のうえで売り掛けが成り立っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "売り掛けが積み重なると資金繰りが苦しくなるため、担当者は早期回収に努めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "まして相手は初めから喧嘩を売り掛けて来たのである。",
              "citation": {
                "source": "番町皿屋敷",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "不意にこの喧嘩を売り掛けられて、彼らはすこしく怯んだ。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
