    "definitions": [
      {
        "index": 1,
        "gloss": "omelette-wrapped eel",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
