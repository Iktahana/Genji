        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大きな唐箕がもう据えつけられてフウフウフウと廻っていました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウフウフアハハハ……」　聞いて格子窓の外からおかしくてたまらないといったように、いとも朗らかにうち笑ったのは名人右門です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫く、靴音が遠くなってから、とても若々しいハミングが、フウフウフフン、ウフフフフンとか聴えて来ました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "温柔しく夢を見ているんだよ……ウフウフ……」　それから返り血を避けるべく、羽根布団を引き上げながら、すこしばかり身を背向けた。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハッ……ナニ……日本のスパイ船……僕が参謀将校……ウフウフ。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ウフ……ウフ……ウフウフウフウフウフ……」　それから私がドンナ事を特一号室の中でしたか、全く記憶していない。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてその間じゅう心の底から、「ウフウフウフ……アハアハアハ……」　と笑い続けていた事を、微に記憶しているようである……。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうは朔造（梅津）さんは病気で稽古を休みますと言伝がありました」　と云ったら、翁は「ウフウフ」と微苦笑して、「今の若い者は弱いけに詰まらん」　と云った。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウフン」とか「エヘン」とか「オホン」とか「ウニャムニャ」とかいう誤魔化し気分、又はその当時のモテ加減なぞを思い出して浮っかり出た「ニヤニヤ」とか「ウフウフ」とかいう気持ちが、鼻の表現の中を往来明滅するのを禁ずる事は出来ないのであります。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「氷柱ができるような夜かいな」　眼をこすりこすり幾度も見直しているうちに、帆村はウフウフ笑いだした。",
              "citation": {
                "source": "ネオン横丁殺人事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは、どうしたものか、急に笑いたくなって、クッ、クッ、ウフウフと、鉄梯子に、しがみついた儘、暫くは、動くことが出来ない程だった。",
              "citation": {
                "source": "夜泣き鉄骨",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "『何だつまらんウフウフ……』と新見は軽く笑つた。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、あいつの狙いが狂ったのか、僕が顔をそむけたためか、幸い、眼球を傷つけられないですみましたが、僕が『アッ』と声を立てて眼をおさえたものですから、目的を達したと思ったのでしょうね、しわがれ声で、さも嬉しそうに、ウフウフ笑いながら、今度はとどめを刺すように、胸をついてきたのです。",
              "citation": {
                "source": "暗黒星",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
