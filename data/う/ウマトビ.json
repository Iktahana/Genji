        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昼休みの校庭で、友達と馬跳びをして遊ぶのが毎日の日課だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "運動神経が良さそうな少年が、軽々と馬跳びの「馬」を飛び越えていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「準備はいい？馬跳びするよ！」と声をかけて、背中をしっかり支えて屈んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "十また十二歩離れた壁を跳び越え、騎手の意のままに諸方に廻り駈け、見物人の称讃を求むるようだ――熊楠いう、『千一夜譚』第四七夜に、女子九フィートの溝を跳び越ゆるを追う王子の馬跳び越え能わぬ事あり。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "私や彼女の兄弟は其処でうまとびをしたり、ボール遊びをした。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「道の悪しさに乗る駒も踏みわずらいて野路病」登って行く新吉の眼に、坂の上の露地で少年達が胴乗り遊び（馬飛びともいう）をしているのが見える。",
              "citation": {
                "source": "四つの都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "むっつり流十八番｜桂馬飛びという珍手を忘れていたはずだが、おまえさん心当たりはないかえ」「さあ、いけねえ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "左刺しの匕首",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと大きな変化は伊予の各地において、幾人かの子どもが前の子の帯を捉えて、連鎖式ともいうべき長い馬になり、それへめいめいが走って行って飛乗るもので、是は胴乗りと呼ぶ村もあって、馬飛びの運動との結合かとも思われる。",
              "citation": {
                "source": "こども風土記",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "件の馬像は、輪廓もっとも麁末ながら、表土を去って白堊を露わす故、下の谷から眺むれば、十分馬跳ぬるところと見える。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
