        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "海燕は嵐の中でも優雅に飛び回る小さな海鳥だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "沖に出ると、海燕の姿をよく見かけるようになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "海燕は外洋で生活する数少ない野鳥の一種である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "市郎は其綱の片端を自分の胴に緊と結び付けて、海燕の巣を猟る支那人のように、岩を伝って真直に降り初めた。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その――古風な風見が廻っている岬の一つ家には、痩せてひょろ高い浜草が、漆喰の割目から生え伸びているほどで、屋根は傾き塗料は剥げ、雨樋は壊れ落ちて、蛇腹や破風は、海燕の巣で一面に覆われていた。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中国でやかましい燕巣の料理、すなわち、海燕の巣なるものも、日本のところてんを水に浸したようなもので、別に味はないが、これがなくては中国料理にその魂が抜けるという。",
              "citation": {
                "source": "海にふぐ山にわらび",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "Lethe海燕と年　元朝のフレスコ風の雪のなかから、鵲のやうに雪をかついできた郵便配達夫は、わたしに「おめでたう」といつた。",
              "citation": {
                "source": "希臘十字",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして星に肖た海燕がひとつ。",
              "citation": {
                "source": "希臘十字",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "海燕はマン・レイ氏のシネポエムから、写しとつたのであるらしい。",
              "citation": {
                "source": "希臘十字",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "海燕は音楽のやうに唄ふ。",
              "citation": {
                "source": "希臘十字",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの船隊は莫大な費用をかけて、海燕やペンギンの糞を採りに、南極地方へ送り出される。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "その氷塊の上では海豹がまどろみ、海つばめはその上を飛びこえて行くのです」第十夜「わたしはひとりの老嬢を知っていました」と、月が言いました。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "波濤の音、船の動く音、そのあいだにきこえるのは海つばめの鳴き声である。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "海つばめの声がきこえたからといって、陸が近いと思うてはならぬ、海つばめはおりおりずいぶん遠くまで遠征することがあるものだ。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩間に逃げていた海つばめの再び波の上に下りて来る白い翼が夜の青暗さのなかに見えた。",
              "citation": {
                "source": "剣のうた",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "両者の間を嵐の使者のウミツバメが彼らのエネルギーを結合させつつ、燃え立たせつつ、頻々として往来した。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "このウミツバメの名はアントニオ・ペレズといい、スペイン王フィリップに狂的な憎悪を持つ男であり、一たび生死の関をあやうく越えてきた男であった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "岸近くの海の上を、カモメとウミツバメが飛びまわって、魚をとっていました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜウミツバメみたいな、弱くて繊細な鳥がつくられたんだろう、この残酷な海に。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
