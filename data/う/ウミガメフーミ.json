        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "クイーン　そちはもうウミガメフーミには会うたか？",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリス　いいえ、そもそもウミガメフーミって何？",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "クイーン　そこなグリフォン、この娘っ子にウミガメフーミを紹介せい。",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "おうい、ウミガメフーミ。",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウミガメフーミがさめざめと泣きながら出てくる。",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリフォンと　ウミガメフーミに　あわせるんだって。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから　そのとなりが　ウミガメフーミ。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "だって　ウミガメフーミの　スープには　こウシの　あたまを　つかうからね。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリフォンと　ウミガメフーミに　つぎ　あったとき、　おぎょうぎよく　きいてみたら、　きっと　また　おどってくれるよ。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハートどもの女王にして、」とウサギはひそひそ声で耳打ち、「ウミガメフーミどもをすべておじゃる。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そちはウミガメフーミに会うたか？",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とアリス、「そもそもウミガメフーミが何だかぞんじませんし。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とクイーン、「この姫君をウミガメフーミのところへあないして、いわれを聞かせてやれい。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　歩いてほどなく遠くに見えてくるウミガメフーミ、いわおの小さなでっぱりに、ひとり悲しそうにこしかけていてね、近づくにつれ聞こえてくるため息、まるでむねがはりさけたみたい。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　で、ウミガメフーミのところまでたどりつくと、大きな目をうるうるさせて見てくるわりに、ものも言わない。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とウミガメフーミは、消え入りそうな声で、「おすわりくだせえ、しまいまでどうかお静かに。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "「昔は、」とついに口を開くウミガメフーミ、ふかいため息ついて、「あっしもまっとうなウミガメでした。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そう切り出したあと長い長い間があってね、ときどきグリフォンの「ひっくるぅー」というおたけびがはさまったり、ひっきりなしウミガメフーミのさめざめという泣き声が聞こえたりするくらいで。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まだ小せえころは、」とウミガメフーミはおもむろに続きを話し出してね、たびたびまだしゃくり上げたりしながら、「海の学びやに通うたもんで。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とウミガメフーミはぷんすか、「あんたほんとににぶいむすめだ！",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてグリフォンがウミガメフーミに声をかけてね、「続けろい、こんにゃろ！",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」するとウミガメフーミはこう言葉をついでいく。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と声を上げるウミガメフーミ、「アザラシにウミガメにシャケにいっぺえよ――２歩前ん出て――」「てめえごとで相手にロブスターをだな！",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とウミガメフーミ、「２歩出て相手につらを向けてな――」「ロブスターを取りかえ、元の列にもどる――」と横入りするグリフォン。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それからほら、」と先を続けるウミガメフーミ、「投げんだよ――」「ロブスターを！",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と大声のウミガメフーミはやたらはね回る。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とウミガメフーミはとたんに声をひそめて、ふたりはそれまでずっと頭おかしいくらいにぴょんぴょんしていたのに、またもの悲しそうにすわりこんで、アリスに目をやる。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とウミガメフーミ。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ウミガメフーミからグリフォンへ、「まあロブスターなしでもできましょうて。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、もったいぶりつつ始めると、アリスのまわりをぐるぐる、たびたび近づきすぎては毎回つま先をふんづけていきつつ、ふしを取ろうと前足ふりふり、そのあいだ歌うのはウミガメフーミ、しみじみこんなふう。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
