        "examples": {
          "standard": [
            {
              "text": "今後の経営戦略が社会情勢で烏有に帰する可能性がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "戦争により文明全体が烏有に帰する危険も歴史上存在した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼の人生計画が一度に烏有に帰するところだったのだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "宿業に依って炎上し、神の意志に依って烏有に帰する。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ平衡状態から極僅かに偏倚するだけでのしかかる何トンもの石造建築全体が陥没し、我が身を烏有に帰することになったかもしれないというのに。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
