        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "九回裏の決定的な場面で、エースの投球が上ずってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "立ち上がりの制球が定まらず、ボールが総じて上ずり気味だ。",
              "citation": {
