        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "明日の遠足が楽しみで、クラス全員の気分が上ずっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "お祭り囃子が聞こえてくると、町全体がどことなく上ずる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "合格発表の掲示板の前で、受験生たちの浮き足立った空気が上ずる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "to be thrown too high",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
