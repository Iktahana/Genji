          "literary": [
            {
              "text": "愛ちやんは野原を横斷つて其後を追蒐けて行つて、丁度それが生垣の下の大きな兎穴に跳び下りるのを見ました。",
              "citation": {
                "source": "愛ちやんの夢物語",
                "author": "ALICE'S ADVENTURES IN WONDERLAND.",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう　くたくたなので　うさぎあなの　ふかふかした　やわらかい　つちの　じめんに　ねっころがると　まぶたが　すぐに　おちます。",
              "citation": {
                "source": "あなうさピーターのはなし",
                "author": "THE TALE OF PETER RABBIT",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのもりには　うさぎあなが　いたるところに　あって、　そのなかでも　いちばん　きちんとしていて　ふかふかなのが　ベンジャミンの　おばと　そのいとこたち　――　フロプシー　モプシー　カトンテル　ピーター　――　の　おうちなのです。",
              "citation": {
                "source": "ばにばにベンジャミンのはなし",
                "author": "THE TALE OF BENJAMIN BUNNY",
                "note": "青空文庫"
              }
            },
            {
              "text": "と　そのとき、　あなうさママの　こえが　うさぎあなの　なかから　きこえてきます。",
              "citation": {
                "source": "ばにばにベンジャミンのはなし",
                "author": "THE TALE OF BENJAMIN BUNNY",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
