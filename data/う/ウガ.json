  {
    "uuid": "062e4a09-0600-56fa-8c6d-32fbfe961a25",
    "entry": "ウガ",
    "reading": {
      "primary": "うが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アウガスチンの如き、バンヤンの如きはその最たるものである。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お声もさはやかに御申渡しになり、少し間を置いて、お胸に何か浮んだらしく、うつむいてくすくすとお笑ひになり、管絃ノハウガイイヤウデス　とおつしやいました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、居留民ノ生命財産ノ保護、国旗ノ尊厳トイウガ如キ言葉ニ迷ワサレテハナラヌ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "糸の切れた緋威しの鎧が聖アウガスチンの龕に寄りかゝっている古道具屋。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれが思うのには聖オウガスチンという男はあわてものさ。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "電報は「ゾ　ウサンノタメシヨウガ　ツヤスミヘンジ　ヨウ」カエラヌ」ツルキチ」鶴さんからオトラ婆さんに宛てたものだった。",
              "citation": {
                "source": "電報",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カアカア、アオウガアガアガア、と五六｜羽、水の上へ低く濡色の烏、嘴を黒く飛ぶ。",
              "citation": {
                "source": "二た面",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故と申しますまでもありません、馬琴の前後の小説、――いわゆる当時の実社会をそのまま描写することを主とした、小説ともいえぬほど低微なものでありますが、それらの小説は描写が実社会の急所にあたってること、即ちウガチということを主として居るものであります。",
              "citation": {
                "source": "馬琴の小説とその当時の実社会",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのウガチを主な目的として居るところの著作数種を瞥見しますれば、左母二郎のような人間がしばしば描かれて居るのを発見するに難くないのでありますから、左母二郎のような型の人物の当時に少なくなかった事はおのずから分明であります。",
              "citation": {
                "source": "馬琴の小説とその当時の実社会",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが自分等には歯痒ゆきところはあれど自然と人生の交渉に禅的ユニテイの味識を説き、ゴツホ、ゴウガンさてはキユビズムの名をみとめて而も文晁、宗達の存在をわすれざるところ、創作は生活であるといふに於ても氏は自分等の遥かに及ばぬ直接をもつてゐる。",
              "citation": {
                "source": "小川芋銭",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、小串まで出かける、新聞、夏帽、シヨウガ、壺を買ふ、此代金五十一銭也。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "当分、酒は飲まないつもりだつたが、何となく憂欝になるし、新シヨウガのよいのが見つかつたので、宿のおばさんに頼んで、一升とつてもらつた、ちようど隣室のお客さんもやつてこられたので、だいぶ飲んで話した、……ふと眼がさめたら、いつのまにやら、自分の寝床に寝てゐる自分だつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "△朝早くから、いろ／＼の小鳥がやつてくる、――モズ、ヒヨ、メジロ、シヂユウガラ、ミソサヾイ――スヾメも時々くればよいのに。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "イリコ五十目十五銭、ミヨウガ三十ばかり二銭、サケ三合二十四銭が今日の途中の買物だつた。",
              "citation": {
                "source": "行乞記",
                "author": "山口",
                "note": "青空文庫"
              }
            },
            {
              "text": "胡瓜はもうをはりに近い、茄子はまだ／＼盛り、トマトはボツ／＼ふとつてうれる、ハスイモ、シソ、トウガラシはいよ／＼元気だ、大根はいつもしなびてげつそりしてゐる、……しようがもおなじく。",
              "citation": {
                "source": "行乞記",
                "author": "山口",
                "note": "青空文庫"
              }
            },
            {
              "text": "バス風景――とても愉快な女中さんいやな釣人どうしシヨウガ四つで一銭とは！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヨウガの風味、シソの実の風味、それも秋の風味。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　マヘノ　ハウガ、「モウ　シバラク　マテ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ウシロノ　ハウガ　イヒマスト、マヘノ　ハウガ、「モウ　スコシ　サキノ　ガケノ　上カラ　タニ川ヘ　ホリコンデ　ヤラウ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコタチハ　トホクヘ　イキタガツテ　シヨウガ　ナイノデ、オカアサンノ　タケガ、「ソンナニ　トホクヘ　イツチヤ　イケナイヨ、ヤブノ　ソトニ　デルト　ウマノ　アシニ　フマレルカラ」ト　シカツテ　ヲリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　チヨウド　ソノ　コロ、ニシノ　ハウデ　センサウガ　オコツテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ヲトコハ　アル　イヘノ　マドシタニ　タツテ、「オナカガ　スイテ　シヨウガ　アリマセン。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、コハレナイ　ウチニ、ムカシ、コノ　バシヤガ　マイニチ　カヨツタ　カイドウスヂヲ　ミセテ　ヤツテ、ソレカラ　モヤシテ　シマツタ　ハウガ　ヨイト　オモフ」　コドモタチハ　ミナ　サンセイイタシマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イロイロナ　ゴチソウガ　デマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ポストノ　ウシロニ　タツテ　ヰタ　ガイトウガ　カラ　カラト　ワラツテ、「ポストノ　カゲナラ、ポストノ　ウシロニ　コロガツテ　ヰル　ソノ　ブカツカウナノガ　サウヨ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アレハ　コノ　ワシノ　カゲサ」ト　ガイトウガ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　ユウガタニ　ナツテ、タイヤウガ　オチテ　シマフト　ヒロツパノ　マンナカノ　マルイ　カゲハ　ナクナツテ　シマヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
