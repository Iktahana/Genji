        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夏休みの最後は、家族みんなで海遊びをして過ごした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "海遊びで日焼けした肌が、楽しい思い出の証だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "まだ肌寒いけれど、波打ち際での海遊びにはしゃぐ子供の声が響く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "子供の時からよく川遊びや海遊びはやったが、ぱちゃぱちゃ騒ぎ廻るほかにまるで泳げなかった僕は、実に閉口した。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして腹の虫が落ち着くと、海遊びを再開させ、夕暮れ時、伯父が船で迎えにくるまで遊び倒した。",
              "citation": {
                "source": "くじらようかん",
                "author": "澤西祐典",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
