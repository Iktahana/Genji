        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サムラヒハ　ビツクリシテ　アシモトヲ　ミルト、ゲタノ　ウシロニ　フデノ　ホノヤウナ　シツポガ　チヨロリト　デテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ポストノ　ウシロニ　タツテ　ヰタ　ガイトウガ　カラ　カラト　ワラツテ、「ポストノ　カゲナラ、ポストノ　ウシロニ　コロガツテ　ヰル　ソノ　ブカツカウナノガ　サウヨ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガイトウノ　カゲナラ、ガイトウノ　ウシロニ　アル　ソノ　ヒヨロヒヨロシタノガ　サウダヨ」ト　ケイキキユウハ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿閉ハ老人ニハシバ／＼起ル現象ダソウダガ、平生デモ一回ノ排尿ニ時間ガカヽリ、劇場ノ便所ナドデ人ガ大勢ウシロニ列ンデ待ッテイラレルト甚ダ困ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鞄カラ鍼ノ匣ヲ取リ出シタリ、アルコールデ消毒シタリスル細カイ作業ハ鈴木氏自身デスルケレドモ、常ニ弟子ノ一人ガ附キ添ッテウシロニ控エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
