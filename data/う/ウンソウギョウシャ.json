        "examples": {
          "standard": [
            {
              "text": "その運送業者に配送日時を確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "複数の運送業者から価格見積もりを比較した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大手の運送業者に依頼することにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "私は今日まで徳島港が駄目であると云ふことを聞かなかつた』　増田は運送業者である為めに、特別に浚渫問題に八釜敷いのである。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして荷物が沢山出て運送業者は何処も急がしかつた。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが運送業者はその畑の中をどこでも横行して行くです。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "その火をつけたのは、一四二八年の八月に近江で起った馬借（運送業者）の一揆である。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "八、連尺あきない　このついでに今一つ、江戸の古い町の名で、東京になるまでのこっていた、神田の連雀町という地名も、もとは運送業者の住んでいたところであった。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
