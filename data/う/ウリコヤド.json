        "examples": {
          "standard": [
            {
              "text": "江戸の盛り場には売子宿が軒を連ね、多くの客が訪れたと記録に残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "近世の風俗史を研究する中で、売子宿の実態を記した古文書が発見された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "売子宿が取り締まりの対象となり、多くの店が相次いで閉鎖に追い込まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "或る晩、売子宿の店主からこう訊かれた。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬に吠えられたり、女中に断わられたりしても、すぐ引っ込んでしまうんじゃ、いつまで、行商で飯は食えないぜ」励ますつもりか、売子宿の店主は、ぼくを馬鹿扱いにして云った。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――しかし、売子宿の店主から、そう云われると、何か安易な気もちもして、依頼心をそそられ、行かないのは自分の馬鹿なせいかもしれないと思った。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
