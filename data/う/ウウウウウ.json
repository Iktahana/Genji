        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ウウウウ、ウウウ、ウウウウウ、ウウウウ、ウウウ、ウウウウウ、と、正坊は「ゆうかんなる水兵」の曲をうなりだしました。",
              "citation": {
                "source": "正坊とクロ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬいを認めると、彼は藁を打ちながら、頭を動して笑い、「ウウウウウ」と挨拶した。",
              "citation": {
                "source": "杏の若葉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雄鳩は不安なき眠りの悦びを感じながら優しく、「クウウウウウ」と喉を鳴らした。",
              "citation": {
                "source": "白い翼",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "再びカサカサ身じろぎをし、雌は、「クククウウウウウウ」とゆるやかに啼いた。",
              "citation": {
                "source": "白い翼",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもウウウウウと、のどの奥で奇怪なうなりをたてています。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ウウウウウウ」　と正三君は泣きだした。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウウウウウウ」　と細くて甲高い唸り声だ。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウ、ウウウウウ、もっと……もっと……ふんづけてくれ……ふんづけて、踏み殺してくれい！",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
