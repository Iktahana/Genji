        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祭りで後ろ鉢巻きをして踊っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "後ろ鉢巻きは昔ながらの粋な装いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "後ろ鉢巻きが崩れて額に下りてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "飯にしよう」　与一が後ろ鉢巻きを取りながら、台所へ炭箱を提げて来た。",
              "citation": {
                "source": "清貧の書",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "走りまわっていたらしいうしろはちまきの男先生が、いつもに似合わずあいそのよい顔で、「やあ、おなご先生、どうです。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかめしい後鉢巻をして、立っ付け袴を穿いた男が十人ばかりずつ、舞台の上に三列に並んで、その三十人がことごとく抜き身を携げているには魂消た。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この仲間｜外れの男は袴だけはつけているが、後鉢巻は倹約して、抜身の代りに、胸へ太鼓を懸けている。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで賄征伐をやった時、どうした機勢か額に創をして、しばらくの間｜白布で頭を巻いていたが、それが、後鉢巻のようにいかにも勇ましく見えた。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり汗を拭う時間が惜しいというので、田畠の仕事を致します時には、いつも眉の上の処に、手拭で後鉢巻を致しておりましたところから来た綽名だというので御座いますから、如何にその働らき振りが猛烈であったかが、おわかりになるでしょう。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大海浜、宿院浜、熊野浜などと組々の名の書いた団扇を持つて、後鉢巻をした地車曳きの子供等が、幾十人となく裸足で道を通ります。",
              "citation": {
                "source": "私の生ひ立ち",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "爺さんはいつでも手拭を後鉢巻に結んでいるので、禿頭か白髪頭か、それも楽屋中知るものはない。",
              "citation": {
                "source": "草紅葉",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そんな騒ぎだといふのに阿父さんの姿が見へないのさ、志村（清親のこと）なんて、後ろ鉢巻で門のところに蓆を引いて頑張つてゐるといふ騒ぎなんぢやないか！",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には肩に掛けた襷の鈴を鳴らし、黄色い団扇を額のところに差して、後ろ鉢巻姿で俵天王を押して行く子供の群れが彼の行く手をさえぎった。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの三人組が真黒な筆をもつて、眉毛やら※やら眼眦やらを夫々大層な武悪面に塗りあげ、後ろ鉢巻のいでたちで、出鱈目な芝居の真最中である。",
              "citation": {
                "source": "創作生活にて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はＭ子さんの女学校時代にお下げに白い後ろ鉢巻をした上、薙刀を習ったと云うことを聞き、定めしそれは牛若丸か何かに似ていたことだろうと思いました。",
              "citation": {
                "source": "手紙",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "手拭で後ろ鉢巻をしてゐる。",
              "citation": {
                "source": "かへらじと",
                "author": "日本移動演劇連盟のために",
                "note": "青空文庫"
              }
            },
            {
              "text": "稽古着に剣道用の胴、草ずりをつけ、大刀を差し、後ろ鉢巻、もも引にすね当て草鞋ばきで、万事小具足仕立てだが、元々士ではないらしい。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伯母さんは私に烏帽子をきせたり、鎧どほしをささせたり、すつかり戦人にしたててから、自分も後ろ鉢巻をし、薙刀をかいこんで、長い廊下の両はじに陣どつて戦ごつこをする。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
