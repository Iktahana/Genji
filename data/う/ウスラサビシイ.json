          "literary": [
            {
              "text": "僕もなんだか薄ら寂しい心持になって、その灯の影をいつまでも見つめていると、うしろから不意に肩をたたく人があった。",
              "citation": {
                "source": "山椒魚",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "人氣の絶えたかしっぷち、薄ら寂しい河岸っぷち。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "このときいっしょにかえる新吉が「蝋燭が無けりゃ三ツばかりつないで」というのだが、三つつないだ短い蝋燭の灯の、おもっただけでもトボンと青黄色くうすら寂しい限りではあることよ。",
              "citation": {
                "source": "我が圓朝研究",
                "author": "「怪談牡丹燈籠」「江島屋騒動」「怪談乳房榎」「文七元結」「真景累ヶ淵」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬の雨がしとしとと降る夕暮、何処かの寺院からヴェープルの鐘が鳴り渡るころ、人気の絶えたうすら寂しい河岸ぶちを通りゆく一団の女学生がある。",
              "citation": {
                "source": "雨の日",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "その十二日は全く薄らさみしい日であった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
