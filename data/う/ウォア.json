        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ホット・ウォアからコールド・ウォアに移行したが、この両者は紙一重の差である。",
              "citation": {
                "source": "新たな世界主義",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "サムの得意は「クレージイ・ウォア」という歌だった。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でも、兵隊になれといわれてなりはしたものの、小銃をうって見るとちっともあたらないで、キャプテンに叱られたり何かするので「こんなことなら女の子に生れて来ればよかった」というような文句もあり、一節ごとに「クレージイ・ウォア」という折返しがつく。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "別の晩、やって来た時「サムよ、君はそのクレージイ・ウォア以外に何か歌を知らないのか」と聞くと「知っているさ」という訳で、新しい歌をうたった。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲はクレージイ・ウォアとどこが違うのか、僕には分らなかったが、その中に「将校は鶏の胸の肉と脚の肉を食い兵隊は翼と尻とを食わされる」という文句があり、僕は大きに笑った。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今までコールド・ウォアやホット・ウォアがあつて、相當疲れて來た。",
              "citation": {
                "source": "革命を待つ心",
                "author": "――今の實業家、昔の實業家――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホット・ウォア――武器の戰爭――が終れば、それに取つて替るものは、經濟戰爭というやつである。",
              "citation": {
                "source": "革命を待つ心",
                "author": "――今の實業家、昔の實業家――",
                "note": "青空文庫"
              }
            },
            {
              "text": "コールド・ウォアやホット・ウオアが盛んに動いていて、兩方からヤイノ、ヤイノと言われている時はよい。",
              "citation": {
                "source": "革命を待つ心",
                "author": "――今の實業家、昔の實業家――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
