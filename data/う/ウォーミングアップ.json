        "examples": {
          "standard": [
            {
              "text": "怪我を防止するためにも、スポーツを始める前のウォーミングアップは欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "コンサートの開始1時間前、歌手が控室で発声練習という名のウォーミングアップをしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "軽いジョギングでウォーミングアップしてから、本格的なトレーニングメニューに入った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "けれども……）いや、ざっと、ウォーミングアップ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "長いもののためのウォーミングアップとして。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなこと書いている、これも一種のウォーミングアップかもしれないからどうぞあしからず。",
              "citation": {
                "source": "獄中への手紙",
