        "examples": {
          "standard": [
            {
              "text": "術後しばらくは胃が弱っていて、固形食をまったく受け付けなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "二日酔いの翌朝は水以外に何も体が受け付けない状態だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "妊娠初期のつわりで、好物の魚料理さえ受け付けなくなってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "to be affected by",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
