[
  {
    "uuid": "e8daa6d1-5b55-51b2-a9a4-f80d8bcc16f0",
    "entry": "運座",
    "reading": {
      "primary": "うんざ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
