        "examples": {
          "standard": [
            {
              "text": "線路脇で行われている請負工事の影響で、電車のダイヤが少し乱れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "公共の請負工事を落札するため、各社がしのぎを削って入札に参加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "請負工事の代金が、工期の遅延によって分割で支払われることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "古社寺保存を名とする修繕の請負工事などと来ては、これ全く破壊の暴挙に類する事は改めてここに実例を挙げるまでもない。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            }
          ]
        }
