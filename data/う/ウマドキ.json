        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "真蔵は銘仙の褞袍の上へ兵古帯を巻きつけたまま日射の可い自分の書斎に寝転んで新聞を読んでいたがお午時前になると退屈になり、書斎を出て縁辺をぶらぶら歩いていると「兄様」と障子越しにお清が声をかけた。",
              "citation": {
                "source": "竹の木戸",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "我等はこゝに朝餐して、公子夫婦は午時まで休憩し、それより驢を倩ひてチベリウス帝の別墅の址を訪はんとす。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "午時を過ぎた日の光を浴びて總ての物が快く見える。",
              "citation": {
                "source": "おふさ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "成斎は朝生徒に習字を教えて、次で阿部家の館に出仕し、午時公退して酒を飲み劇を談ずることを例としていた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "此日朝涼、午時より甚暑不堪。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「廿六日、晴、風、午時｜微過雨。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "午時越前敦賀湊へ著船。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "午時近くなつて、隣町の方から『豆腐ア』といふ、低い、呑氣な、永く尾を引張る呼聲が聞えた。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "午時近くなつて、隣町の方から、『豆腐ア』といふ、低い、呑気な、永く尾を引張る呼声が聞えた。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに午時も過ぎたところで、東の方からかの稚児髷の少女が来た。",
              "citation": {
                "source": "蛇性の婬",
                "author": "雷峯怪蹟",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日の午時分、九兵衛と女房は茶の間で火鉢をなかにして、親類の女の嫁入りのことに就いて話していた。",
              "citation": {
                "source": "蠅供養",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……気まぐれな梅雨の空が午時分からからりと晴れて、白い眩しい陽の光が夕方まで通路の上に光つてゐたが八時頃からまた降り出した。",
              "citation": {
                "source": "蛾",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが何うも芝居見物にでも行くようなこしらへで、上等の箱か何かで居眠りをしながらでもお午時分には着いて仕舞はうつてんだから大層なものさ。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もうお午時分ぢやないかしら。",
              "citation": {
                "source": "村のストア派",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あつしもお午時分には行つてるから。",
              "citation": {
                "source": "パンアテナイア祭の夢",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "午時分には陽に溶けた屋根の雪が窓庇を掠めてドツツツと地上に滑り落ちた。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "永禄元年七月二十日、正午時刻のことである。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十　午時過ぎて二三時、昨夜の垢を流浄て、今夜の玉と磨くべき湯の時刻にもなッた。",
              "citation": {
                "source": "今戸心中",
                "author": "広津柳浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の日の午時ごろ、浅草警察署の手で、今戸の橋場寄りのある露路の中に、吉里が着て行ッたお熊の半天が脱ぎ捨ててあり、同じ露路の隅田河の岸には、娼妓の用いる上草履と男物の麻裏草履とが脱ぎ捨ててあッたことが知れた。",
              "citation": {
                "source": "今戸心中",
                "author": "広津柳浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "日光はガラス戸ごしに寐牀の際まで一間ほどさしこみて、午時は近づきたり。",
              "citation": {
                "source": "明治卅三年十月十五日記事",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "丈なす枯れ草の盆地の原を、陽の明るい正午時に、今は二人ながら掛け声ひとつかけず、討とう討たれまいとの死闘をつづけ、三軒の廃屋のある方へ、一人は進み一人は退いた。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが彼是お午時分、ふと顔を擡げたのを見ると、腫物のあつた下唇だけ、丁度赤いお薩のやうに脹れ上つてゐるではございませんか？",
              "citation": {
                "source": "雛",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "我等が尋ねた時は、丁度午時で島吉が帰つて来て火を焚いて居たが、其の焚火の料と云ふは、女房が渡良瀬へ膝まで浸つて、浮木を拾つて積んで置くのだと云ふ。",
              "citation": {
                "source": "政治の破産者・田中正造",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "○九日午時過ぐる頃、東京着、直ちに鍛冶橋監獄に入る。",
              "citation": {
                "source": "鉄窓の歌",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたかも午時に近くして、戦わんとしてまず午餐の令は出でたり。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "正午時分にいったん帰って、居間へ閉籠ったが、しばらくすると、またどこへか出て行きました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "安房の国の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつまで経っても話相手になる人もなし、加勢に来ようという人もなし、それでも根よくほとんど休むということを知らないで、薪をこなし、そうしてようやく、お正午時分になったと気がついて、携帯の笠の中に入れて、とある一木の下に置いた弁当を開きにかかりました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の知れないのは七兵衛で、この七日の間、夜も、昼も、仕出し弁当で鎧櫃の傍に頑張っていながら、今日という日になると、朝から出かけて、正午時分になっても、夕方になっても、とうとう夜になっても帰って来ない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "持戒の僧は午時に於てだけに食事をする。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
