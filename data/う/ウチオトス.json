        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "四度目に、ようやく一つ撃ち落とす。",
              "citation": {
                "source": "キャラコさん",
                "author": "鴎",
                "note": "青空文庫"
              }
            },
            {
              "text": "目に入ってきた宇宙船の最初の三機をすぐさま撃ち落とす。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵の飛行機を撃ち落とすためには、それよりも高く飛び上がらねばならない。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵艦を沈没させるのは自信があったが、敵機を射ち落すことは、中々うまくゆかなかった。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "むささびは夜行性で、木から木へとび移る所を射ち落すのだという。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "岸に居あわせた船頭がそれを怪物とみて、棹をとって撃ち落すと、赤児はそのまま死んでしまったが、その髪は朱のように赤く、その眼は頭の上に付いていた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "酉陽雑爼（唐）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれにしても、秋から冬にかけて、鉄砲方の面々は年々交代で羽田または洲崎の方面に出張し、鷲の飛んで来るのを待ち受けて、強薬で撃ち落すのである。",
              "citation": {
                "source": "鷲",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "雀の嘴から麦の粒を撃ち落す奴であった。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "タラノ音頭　――コルシカ島の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
