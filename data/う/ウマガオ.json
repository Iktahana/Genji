          "literary": [
            {
              "text": "宮奴が仰天した、馬顔の、痩せた、貧相な中年もので、かねて吶であった。",
              "citation": {
                "source": "茸の舞姫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "富江の外に、校長の進藤、準訓導の森川、加藤の弟の慎次、農学校を卒業したといふ馬顔の沼田、それに巡廻に来た松山といふ巡査まで上込んで、大分話が賑つてゐた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいぶ手古摺っておったようだが」「そこへ、町人体に姿をやつした拙者らが、弥次馬顔に出かけていって、斬りあいを聞きつけて役人どもが、出かけてくるところだと言いふらしたら、かかりあいになるのを恐れて、そのまま逃げちっていった。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あッ」　平次と思いきや、いつの間に入れ替ったか、それは大きな馬顔。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お局お六",
                "note": "青空文庫"
              }
            }
          ]
        }
