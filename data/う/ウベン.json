[
  {
    "uuid": "6c08a2e7-0633-5922-9598-79ec5025c706",
    "entry": "羽弁",
    "reading": {
      "primary": "うべん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
