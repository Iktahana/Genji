        "examples": {
          "standard": [
            {
              "text": "春の夜空を見上げると、長い姿をした海蛇座が南の空に横たわっているのがわかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "望遠鏡を使って海蛇座の近くにある銀河を観測しようと試みた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "海蛇座は星座の中で最も面積が広く、その全体像を一度に見るには広い視野が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "明らかにそれは海蛇座とアルゴ座(*11)の間のどこかにある一点であり、明け方に目を覚ましてからずっと自分がそこを希っていたことを知ったのだ。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "海蛇座とアルゴ座との間にある空の一点への奇妙な牽引力は弱まっていたが、もう一つのより強い力が取って代わっていた。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
