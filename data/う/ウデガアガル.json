        "examples": {
          "standard": [
            {
              "text": "毎日練習を続けたおかげで、ようやくピアノの腕が上がってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "留学先で学んだおかげで、彼女のフランス語の腕が上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "釣りの腕が上がったのか、今日は大物が次々と釣れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "さぞ腕が上がるだろう。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "果して日本の画家があの位の刺激に挑撥されて人工的に向上したとすれば、彼らは文部省の御蔭で腕が上がると同時に、同じく文部省の御蔭で頭が下がったので、一方からいうと気の毒なほど不見識な集合体だと評しなければならない。",
              "citation": {
                "source": "文芸委員は何をするか",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘘もかくしもなくその晩私は、ここで、というのとはこうしたお客の前で、ひと月ふた月勉強させてもらえたならば、どんなに自分の腕が上がるだろうとしみじみ考えさせられたことだった。",
              "citation": {
                "source": "わが寄席青春録",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そう焦ったところで、どんな名人でも、にわかに腕が上がるものじゃありません。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
