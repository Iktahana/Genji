          "literary": [
            {
              "text": "外ヶ浜通りの村の名にもタツピ、ホロヅキ、内マツペ、外マツペ、イマベツ、ウテツなどいふ所有り。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今にても、ウテツなどの辺は風俗もやや蝦夷に類して津軽の人も彼等はエゾ種といひて、いやしむるなり。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "余思ふにウテツ辺に限らず、南部、津軽辺の村民も大かたはエゾ種なるべし。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "物質はテットウテツビ合理的に動くものである。",
              "citation": {
                "source": "猿の図",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
