        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「書類を盗ませて、現に手に入れているのは、明かに、例の麹町六番町に住んでいるウイラード・シムソンなのだ」「えッ、シムソン！",
              "citation": {
                "source": "計略二重戦",
                "author": "少年密偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウイラード・シムソン、彼こそはかねて某国の軍事探偵であると睨まれていた強か者でした。",
              "citation": {
                "source": "計略二重戦",
                "author": "少年密偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫と鼠　夜は深々と更けて、麹町六番町のウイラード・シムソンの邸のあたりは、まるで山奥のように静まり返っています。",
              "citation": {
                "source": "計略二重戦",
                "author": "少年密偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡ての女の人は僕が君によく云つた様に、フランシス・ウイラードやナイチンゲールの様な人間になれるのだからね。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
