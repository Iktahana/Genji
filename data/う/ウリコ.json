      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "salesperson",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "球場の売り子がビールのジョッキを掲げながら客席の間を威勢よく歩き回っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "祭りの屋台で売り子をしているアルバイトの学生たちが元気よく声を張り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "新幹線のホームで売り子から駅弁を買い、窓際の席でゆっくり食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "売り子は多くばあさんで黒い頬冠り黒い肩掛けをしています。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "手甲、脚絆、たすきがけで、頭に白い手ぬぐいをかぶった村嬢の売り子も、このウルトラモダーンな現代女性の横行する銀座で見ると、まるで星の世界から天降った天津乙女のように美しく見られた。",
              "citation": {
                "source": "試験管",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "売り子は美しい若い女で軽快な仏語をさえずっていた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "Rrrreisekissen ! Die Decken ! と呼びあるく売り子の声が広大な停車場の穹状の屋根に響いて反射していた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときに、そこの売り子が「これはあなたにあげましょう。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、かの売り子がおまけにくれた鳳仙花だけは、実にみごとに生長して、そうして鳳仙花とは思われないほどに大きく美しく花を着けた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「コヴェント・ガーデンの売り子から二ダース卸してもらったんです。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "売り子はうなずき、我が友人を疑わしげにちらりと見た。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　驚いたことに、この質問がいきなり売り子の怒りを買ってしまった。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と売り子は頭を振り上げ、手を腰に当てて肘を張る。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と売り子がぶっきらぼうに言う。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　売り子はいやみたらしくほくそ笑んだ。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と売り子がしゃべり出す。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの売り子のブレッキンリッジは露店の戸の前に突っ立って、すくむ男に対して拳をいかめしく振り上げている。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と売り子がどなる。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」売り子が勢いよく前へ飛び出たので、訪ね来た男はそそくさと闇の中へ消えていった。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきほどあの売り子に何か訊いておいでで。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブリクストン通りのオウクショット夫人から出荷され、ブレッキンリッジという名の売り子に渡り、そこからアルファのウィンディゲイト氏へ、さらにそこからヘンリ・ベイカー氏も一員である同好会へと渡った鵞鳥を、ね。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの新聞も新しい版が出るごと一々、契約している売り子から届けられたが、それもさっと目を通すだけで部屋の隅へ投げ捨てる。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこの北条坂で、孫太郎虫の売り子の娘っ子が、首を絞められて殺されているというんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬喰町の新右衛門といや、富山の反魂丹、岩見銀山のねずみ取り、定斎屋、孫太郎虫、みんなあいつがひと手で売り子の元締めをやってるんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その横帳はなんだ」「身内の売り子の人別帳でござります。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「見せいッ」　奪い取るようにして手にしながら調べてみると、なつ、ちか、くに、はつ、うめ、なぞ十二、三人の名まえを連ねた孫太郎虫の売り子たちは、神田旅籠町の安宿八文字屋に泊まり込んでいることがわかりました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とかして東京市内に居る江戸ッ子の行衛を探る方法はないかと考えた末、納豆売りの巣窟を探しまわって売り子の話を聴いて見た。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸ッ子の住家であるかないかは、ナットーの買いぶりや、喰いぶりを見るが一番よくわかるということを予てから聴いていたが、彼等売り子の話を聞くと、成る程とうなずかせられる。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "このとき号外の刷り出されるのを待っている号外売り子の群れと、その号外の掲示を待っている群衆とが、渦巻くように社の前に押し掛けていて、とても表口から抜け出られそうもないので、わたしは印刷場の機械のあいだを潜って、ようやく裏通りへ出て、四月の俄か天気に汗をにじませながら木挽町まで息を切って駈けつけた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の利いた外国風の束髪で胸高に帯をしめ、彼女のカウンタアの前ではさぞ気位の高い売り子でありそうな娘が、急いで来たので息を弾ませ、子供らしく我知らず口を少しあけて雑踏する電車の窓を見上げるのなどを認めると、私は好意を感じ楽しかった。",
              "citation": {
                "source": "粗末な花束",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "店には綺麗な娘さんの売り子がいて、桃割れを緋もみの裂でつつんだりして帳場に坐っていた。",
              "citation": {
                "source": "四条通附近",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨年の十二月二十四日、ジングルベルが最高潮に達しケーキの売り子の声が大きく響くイブ、新宿の繁華街で五七歳の警察官が左足を失った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "また｜売り子か、衣裳屋の生模型の口でも探しますわ」「お前は相変らず美くしいだろうな」　それを訊いたときの男の声はこわばっていた。",
              "citation": {
                "source": "暗中の接吻",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
