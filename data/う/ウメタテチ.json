        "examples": {
          "standard": [
            {
              "text": "その埋め立て地には高層マンションが次々と建ち並んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "地震の際、埋め立て地では液状化が起きやすいと専門家が警告した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "幼い頃に遊んだ海は今では埋め立て地になって、面影もない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "人々が集まって来て楽しむことの出来る、海辺の広々とした公園がオアフには必要だ、という発想にもとづいて周辺の海底が浚渫され、湿地帯は埋め立て地へと変わった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあと、湾岸の埋め立て地へいき、水族館と植物園に入った。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
