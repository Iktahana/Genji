        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あそこぢや、毎晩のやうに、ウフトムスキイとウオトカを飲んだもんだ。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ウフトムスキイ公爵とかい？",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ウフトムスキイ公爵とそんなに懇意なら、どつかで会つたかもしれないね。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それみろ、ウフトムスキイの相棒で、酒飲みのユダヤ人……。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウフトムスキイ公爵まではよかつたが、あとがいけなかつた。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
