        "examples": {
          "standard": [
            {
              "text": "季節を過ぎたファッションアイテムは売れ残りやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "そのブランドの商品は売れ残ることがない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "セール期間内に売れ残った商品は、返品処理される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが、底には底があるもので、河岸あたりであゆが売れ残ると、これを冷蔵庫へストックしておく。",
              "citation": {
                "source": "インチキ鮎",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "酉の市に売れ残る熊手のお亀が、早く売れるものより出来がわるいと、定った訳はない。",
              "citation": {
                "source": "心づくし",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち前日仕込んだものを全部パンに製造しては売れ残る恐れありと見るや、その余分だけを「ラスク」（乾パンの菓子）に製するのである。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
