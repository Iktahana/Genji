  {
    "uuid": "36886bf9-be0e-5fc0-9d68-e90ff9f8f95b",
    "entry": "打って付け",
    "reading": {
      "primary": "うってつけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
