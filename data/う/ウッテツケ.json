          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日当たりの良いこの部屋は、アトリエにするにはまさに打ってつけの場所だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は高い統率力を持っており、新プロジェクトの責任者には打ってつけの人材だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "今週末のピクニックには、打ってつけの穏やかで暖かい予報が出ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "顔の生白いこの写真屋は土地の言葉でいう兄さんで、来たてからの客であり、倉持とは比べものにもならないが、銀子のためには玉稼ぎに打ってつけの若い衆で、お神や仕込みの歓心を買うために、来るたびに土産物を持ち込み、銀子の言いなり放題に、そこらの料亭を遊び歩いていた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "座中では男の中の第一年下の二十七で、少々しいのも気の弱そうに見えるのが、今夜の会には打ってつけたような野辺送りの帰りと云う。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "てんで教養のないところなども宣伝部長としては打ってつけであった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋と家賃を分け合うなら、私など打ってつけの男ではないか。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと目にかからず中の様子はひと眺めという、お殿様の御本陣にゃ打ってつけの場所です。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "なまじあッしなぞが飛び出すよりも、こういうことこそお殿様が肝馴らしには打ってつけと存じまして、実あ首長くしながら毎日々々お帰りをお待ち申していたんでごぜえますよ」「なるほど喃。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ミナガレ舟二郎か――こいつはどうも打ってつけの名前だな。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "○百の演技指導も、一つの打ってつけな配役にはかなわない。",
              "citation": {
                "source": "演技指導論草案",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸者という感じもしないのだったが、打ってつけだった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど文壇に評判のよかった「肉体の距離」というその青年の作品が、そうした葉子の感情を唆るにも、打ってつけであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の啓蒙的道徳的な効果をねらう点では、打ってつけの個処である。",
              "citation": {
                "source": "思想議会たるを知れ",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれには丁度よく美しく品位ある中村歌右衛門や、故人の沢村源之助という、伝法肌な打ってつけの役者がいた。",
              "citation": {
                "source": "田沢稲船",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か平安朝の小さな物語になら、その背景には打ってつけに見えるが、それだけに、此処もこんどの仕事には使えそうもないとあきらめ、ただ伎芸天女と共にした幸福なひとときをきょうの収穫にして。",
              "citation": {
                "source": "大和路・信濃路",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、今のところへその住職を招くのも嫌だし、自分が行って会見を求めるのも嫌だ、何か機会はないものかと考えているうちに、そうだそうだ、お絹をやることだ、あの女を子を求める子無き婦人に仕立てて……これは打ってつけの役者だわい、と神尾が思いつきました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、牛飼いというものは元来が年の入った、物に動じない連中なので、精神病の「鑑定」には打ってつけだとされていたからである。",
              "citation": {
                "source": "かもじの美術家",
                "author": "TUPEJNYJ HUDOZHNIK",
                "note": "青空文庫"
              }
            },
            {
              "text": "色の組み合わせ、形の取り組み、いずれも美術的の仕事でありまして、美的趣味を持っておられる方ならば、打ってつけの興味ある仕事であります。",
              "citation": {
                "source": "料理する心",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、これはおっちょこちょいでなくて、光悦という人が物事に真剣になれる人ですから、打ってつけの仕事になったのでしょう。",
              "citation": {
                "source": "私の作陶体験は先人をかく観る",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "普請には打ってつけだな。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この始末の悪い草、何にも利用のない害草に悪るナスビとは打ってつけた佳名であると思っている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかつも豊ちゃんなら金吾さんのお嫁さんにゃ打ってつけだと言うしよ。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ四十二三、大店の支配人にしては少し若いくらいですが、その代り同業中の切れ者で、身体の弱い主人の治兵衛には、まことに打ってつけの女房役だったのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "濡れた千両箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "而もそうした諸現象を一括すべく用いられる処の社会現象という言葉は、風俗にとっては打ってつけではないだろうか。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "この本は樺氏（『歴史哲学概論』其の他の著者である）によって、全く打ってつけの翻訳者を見出した。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代哲学辞典というようなものの編集執筆には、打ってつけのスタッフだと云わねばならぬ。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "――之が思想の欠落のエーヤポケットを充たすシェストーフ的なものの現象の根本的規定であって、このシェストーフ的なるものが、之を充たすエーテル的サブスタンス――永遠性を有った無内容――として如何に之に打ってつけであるかが見られたことと思う。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから彼等は実は日本の国際性を、国際的な重大性を、相当よく呑み込んでいながら、わざわざ知らん振りをして、ニッポンにはカッポレが打ってつけだというような態度を見せつけたのかも知れない。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "農村の前資本主義的生活に於ける娯楽の大衆的な貧弱さが精神作興に打ってつけの健全さに他ならぬとでも云いたいような通俗常識もあるのである。",
              "citation": {
                "source": "娯楽論",
                "author": "――民衆と娯楽・その積極性と社会性・――",
                "note": "青空文庫"
              }
            },
            {
              "text": "きさくで親切で、顔つきだっていちばん上品できれいだし、お友達にはうってつけな方ね。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こちらのお嬢さんは、人出入りの多いお医者さまの奥さんには、うってつけでいらっしゃると思いますので――」　そういい乍らもおふみは、何かしらお涌が惜しまれた。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、鈴子はその対象として、この際うってつけだった。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
