    "definitions": [
      {
        "index": 1,
        "gloss": "trying one's ability",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新作の料理を友人に食べてもらって、味の腕試しをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "大きな試合に出るのは、今の自分の力を試す良い腕試しになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "腕試しに、この難しいパズルに挑戦してみようと思う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "本邦にはあいにく虎がないから外国に渡った勇士でなければ虎で腕試しした者がない。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲間の者がみな腕試しやら眼試しのために」「腕試しというのはあるが、眼試しとはなんだ」「この泥棒稼業に一番大事なのは眼でございます。",
              "citation": {
                "source": "怪異暗闇祭",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の腕試しには持って来いの事件らしいね」「イヤどうも……腕試しどころでは御座いませんので……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時のことだから新刀試し腕試し、辻斬は珍しくなかったが、そのなかに一つ、右肩から左乳下へかけての袈裟がけ斜一文字の遣口だけは、業物と斬手の冴えを偲ばせて江戸中に有名になっていた。",
              "citation": {
                "source": "早耳三次捕物聞書",
                "author": "霙橋辻斬夜話",
                "note": "青空文庫"
              }
            },
            {
              "text": "案の定早大は丗五年の春、先づ第一に学習院と農科大学に腕試しの試合を申込んで物の見事に大敗して帰つた。",
              "citation": {
                "source": "野球界奇怪事　早慶紛爭囘顧録",
                "author": "吉岡信敬",
                "note": "青空文庫"
              }
            },
            {
              "text": "腕試しということもあるが、賞金を一層彼は望んでいたのである。",
              "citation": {
                "source": "日は輝けり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのトランクをここから運び出すのが、あんたの役目、第一回の腕試しよ。",
              "citation": {
                "source": "黒蜥蜴",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "言うなれば奴さんが短編小説等を腕試したんだろう」　と警部補が文書をチラ見して言った。",
              "citation": {
                "source": "ギルレイ",
                "author": "The Man Called Gilray",
                "note": "青空文庫"
              }
            },
            {
              "text": "――この場で腕試しに二人の胴なり首なり斬ってお見せ下さらぬか」「ははははそりゃいと易いこと、拙者が腕前をお見せする為ならば、縄目にかけた死骸同様な奴を斬るは本意でござらぬ。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめて船長になったあなたのうでだめしだ。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はッ」　よりそって進み出た二人へ、「そちたちには腕だめしゆるすぞ。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この寺の銀杏が化けるという伝説のあるを幸いに、彼はときどきに忍び出て、自分の腕だめしに往来の人を取って投げたのである。",
              "citation": {
                "source": "半七捕物帳",
                "author": "化け銀杏",
                "note": "青空文庫"
              }
            },
            {
              "text": "為朝は岸の上からはるかに敵の船の帆かげを見ると、あざ笑いながら、「久しぶりで腕だめしをするか。",
              "citation": {
                "source": "鎮西八郎",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "アミエルの言ったように、腕だめしに剣を揮ってみるばかりで、一度もそれを実際に使わないようなことになっては、たいへんだと思う。",
              "citation": {
                "source": "校正後に",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "腕だめしはこのときである。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "きみに腕だめしをさせてやったのさ。",
              "citation": {
                "source": "サーカスの怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――お代りをつけましょうか、お食事になさいますか」「そうだね、そう、食事にしましょう」　久しぶりで充分に腕だめしをして、彼の全身は爽快な疲れと満足に溢れていた。",
              "citation": {
                "source": "雨あがる",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斬るつもりか、それとも腕だめしか。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "てめえに、ちょうどいい腕だめしをいいつける。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへならべて、民蔵の腕だめしにさせい。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしがあいてになるから、きみたちに腕だめしがしてもらいたいのだ。",
              "citation": {
                "source": "探偵少年",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうだ、もうひとつ、腕だめしを、やってみるか。",
              "citation": {
                "source": "探偵少年",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「腕だめしって、どんなことですか？",
              "citation": {
                "source": "探偵少年",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
