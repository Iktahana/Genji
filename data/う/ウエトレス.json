          "literary": [
            {
              "text": "そこへ、美しいウエトレスに導かれて、二人の老人がはいって来る。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マツチをする女給」以下はよほど大正も末年ちかく、もはやウエトレスと云ふ言葉さへ、日本語化されて来てゐるのである。",
              "citation": {
                "source": "大正東京錦絵",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかといって、別段、ウエトレスに思召があったり、からかったりする訳ではない。",
              "citation": {
                "source": "Ｄ坂の殺人事件",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "古本屋の細君といえば、ある時、このカフェのウエトレス達が、妙な噂をしているのを聞いたことがある。",
              "citation": {
                "source": "Ｄ坂の殺人事件",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "カフェのウエトレスの噂していたあれだ。",
              "citation": {
                "source": "Ｄ坂の殺人事件",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
