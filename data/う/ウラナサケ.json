        "examples": {
          "standard": [
            {
              "text": "誰にも言えない裏情を抱えて、彼女は街を去った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼が冷たい態度を取る裏には、実は温かい裏情が隠されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "長年連れ添った夫婦の間には、言葉にできない裏情があるものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "マザロフ紳士については、裏情報を提供して、パリで逮捕して、拘留しました。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくフィリップスは競馬関係の裏情報に詳しく、知らない詐欺や仕掛けなど無いといってよい。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしおめえさんがブレナム号を欠場させる禁じ手を確実に使うならば、この裏情報を元に、我々は対抗馬に賭け、馬鹿な胴元に我々の賭けを受けてもらおうじゃないか」「もちろん、忘れちゃいないさ。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            }
          ]
        }
