        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だん／＼樣子をきいて見ると、若狹の商人が北陸の海邊から山越しに京都まで運んで來る魚荷の中には、かならず笹の葉が入れてあつて、そのために魚の味の落ちないことが判つたといふ。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼顔や魚荷過たる浜の道　　　　桃妖　眼前の景色である。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼顔の咲いている浜の道を、魚荷を運ぶ人が通る。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "この句は魚荷が通ったあとの光景らしい。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたりには魚荷の腥い香がまだ漂っていそうな気もする。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
