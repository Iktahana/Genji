        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さりながら、縁日の神仏は、賽銭の降る中ならず、かかる処にこそ、影向して、露にな濡れそ、夜風に堪えよ、と母子の上に袖笠して、遠音に観世ものの囃子の声を打聞かせたまうらんよ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "打見るところ――ではない、打聞くところです、その聞くところの音声によって判断、ではない、想像であります、その想像によると、竹林に近く一つの堂があって、その堂守として尼さんがいる、堂のわきには塚があって、石の塔が立っている、その前へ竜之助が近づいたことから、堂守がかく呼びかけたものであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "源氏の打聞きであった。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあとにて棒の三打聞える。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
