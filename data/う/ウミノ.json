          "literary": [
            {
              "text": "フジサンヤウミノミエルアイビキ！",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トイヒマシタガ、ヨシヲサンハモウウミノ中ヘトビコンデシマヒマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒカウキニ　ノッテ、ウミノ　ウヘヤヤマノ　ウヘヤモリノ　ウヘヤマチノ　ウヘヲ　トンデ、レンペイジヨウヘ　オリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレハ、ウミノソコノ、マモノダ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナニ、ソウイッテオケ、ウミノソコノ、マモノガ、イヨイヨ、ニッポンニ、ジョウリクシタト、ソウイッテオケ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はデタ、デタ、ツキガと言い直したが、えい、くそと舌打ちをして、キイロイキイロイマッキロイウミノヨウナツキガ　クララこと瀬良照子に俺はどうしてももう一度会いたいと思った。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
