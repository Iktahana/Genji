        "examples": {
          "standard": [
            {
              "text": "彼の理想と現実の間には雲泥万里の隔たりがあります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "先進国と発展途上国の生活水準は雲泥万里ほど異なっています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この二つの哲学の立場は雲泥万里ほど離れています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "出たのをよく視ますと、まるで葉茶屋の狆とは雲泥万里の相違で、同じ狆とはいいながら、似ても似つかぬような風采です。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "好き狆のモデルを得たはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥之院とは、それこそ雲泥万里。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
