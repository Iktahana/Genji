    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "切符売場前の長い列の、私は最後の方だつた。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "三越では、それからかず枝は、特売場で白足袋を一足買い、嘉七は上等の外国煙草を買って、外へ出た。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本劇場の前まで来て見ると、さすがに今日はいつもの日曜とちがって切符売場の前にはわずかに数人の人影が見えるだけであったので急に思い付いて入場した。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾が切符売場で切符を求めて、ふと妾のトランクを見た時そこには一個の方のトランクが失われていました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが小さな野菜市、小さな糶売場である。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでいざやろうという段になると、君が物置みたいな所から、切符売場のようになった小さい小舎を引張り出して来るんだ。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の治めてゆこうとする家が、大槻の夢に出て来た切符売場のように思えた。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうしたんだろう、一郎の絵――」　かの女は口に出して云いながら、部屋の中をぐるぐる尋ね廻った揚句、咄嗟に思いついて入口の横の売場へ来た。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日頃不愛想だという評判のキャフェの煙草売場の小娘が客の一人に抱えられていた。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかと思うと、紙凧の糸のようにすっとのして行って、思いがけないような遠い売場に佇む。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしも五年級から代表に狩り出されて、売場の番に立ちましたが、そのとき、葛岡は花の運送の世話に来て、わたくしの立っているのを見ますと、その前後は全くわたくしを避けていたのに係らず、ずか／＼とわたくしのところへ来て、「こんなところへ立って見世物になるんじゃない。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "豹一は怖い顔をして、切符売場へ寄って行った。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっと売れたが、この金使ってしまっては餓死か凍死だと、まず阪急の切符売場で宝塚行き九十銭の切符五枚買った。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時刻をねらって、売場の前にずらりと並んだ客に、宝塚行き一枚三円々々と触れて歩くと、すぐ売れてしまった。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "呉服売場や陳列棚の前で見るような恐ろしい険しい顔はあまりなくって、非常に人間らしい親しみのある顔が大部分を占めている。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶちまけた話ですが、万事、ちっとでも、楽屋の方で御心配を下さらないように――実は売場で切符を買ってと思いましたがね。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この前東京へ帰ろうとする時彼女はいざ切符売場へ差しかかると、少しこじれ気味になって、瞬間ちょっと庸三をてこずらせたものだった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は売場を離れて、仕方なしに線路ぞいの柵について泥溝くさい裏町をしばらく歩いた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして売場の前を通ってバルコニイへ出て、濠端の夜景を見ていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は帽子の売場の前に立つてゐた。",
              "citation": {
                "source": "復讐",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る日六階に上つて行つた、××県産品陳列会が特別に催されて、反物、陶器、貴金属類がならべられてゐた、掏らうといふ気持もなく、ぼんやりと売場の間を歩るいてゐると、其処に彼をたいへん怒らしたものがある。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日彼は売場にやつてきた、意外なことだ、前日にはなかつたのに、立像の台に三本の針金がかけられてゐて、堅く陳列台にとりつけられてゐた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌る日、彼はデパートの地階金物売場で、小さな道具を一つ盗んで、二重マントの下に隠して、六階にあがつて行つた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "試みに一人の専門に洋傘を製造してゐる職人、或は皮革製品の専門職人と、デパートのその売場専門の係員へと専門商品に就いて討論さしてみたまへ。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "七実は私も彼女が嫌ひではないもつと正確に言へば、嫌ひな部類に属する女性ではないしかし私は少しばかり時間が遅れたやうだ、切符売場にはずらりと男達の列がならぶとき列の後で私は待つてゐる根気がない、彼女を中心にして座席争ひで男達は戦はねばなるまい、憂鬱な話だ私は男達の女争ひの観戦武官に如くものはなからう。",
              "citation": {
                "source": "託児所をつくれ",
                "author": "小熊秀雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "つゆは人ごみに押されながら、反物の賣場や、男の洋服地の方へ行つてみた。",
              "citation": {
                "source": "玄關の手帖",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "つゆのつれあひは昔、男物の洋服地を賣つてゐたので、そんな賣場をみて歩くのは非常に愉しみであつた。",
              "citation": {
                "source": "玄關の手帖",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "切符賣場で、自分によく似た女が切符を賣つてゐた。",
              "citation": {
                "source": "玄關の手帖",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "切符賣場からも男が出て來た。",
              "citation": {
                "source": "梅雨紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "札賣場に大きな男がのつかつて、札をつみ上げて原の方から集つて來る人を見て居た。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
