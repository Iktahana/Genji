        "examples": {
          "standard": [
            {
              "text": "アフリカの真珠と称えられるウガンダには、豊かな自然と野生動物が残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ウガンダを訪れた際、市場で売られていた色鮮やかな布に目を奪われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は青年海外協力隊としてウガンダへ渡り、現地の農業支援に従事している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "北西岸のウガンダ王国の港につきますと、赤や黒や白の衣を美しく着飾つた群集に迎へられました。",
              "citation": {
                "source": "アフリカのスタンレー",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "スタンレーは、更に附近の探検を続け、ウガンダのムテサ王に頼んで多数の護衛兵をつけてもらひ、西方のアルバート・エドワード湖を探り、附近の山脈の模様をも調べました。",
              "citation": {
                "source": "アフリカのスタンレー",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
