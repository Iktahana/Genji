          "literary": [
            {
              "text": "その頃私達は諏訪、筑摩、伊那、佐久など信州各地の歌好きな青年男女が十五六人グループを作つて「白夜集」といふ短歌の囘覽雜誌をこしらへ歌の勉強をした。",
              "citation": {
                "source": "伊那紀行",
                "author": "今井邦子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆたかな声量と生粋のソヴェト人の歌好きのこころで「前線通信員」の活気横溢する歌をうたう、ゴルバートフ。",
              "citation": {
                "source": "ゴルバートフ「降伏なき民」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この岸本の所望は歌好きな小娘達を悦ばせた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
