        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "小栗の、耳も聞かず、口も働かず、現し心もない間の「餓鬼阿弥」の生活は、此側から見ねば訣らないと思ふ。",
              "citation": {
                "source": "餓鬼阿弥蘇生譚",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "灘の大波はてしなく、水や天なるゆらゆらは、うつし心の姿にて、底ひも知らぬ深海の潮の苦味も世といづれ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう晩をどれだけ殆ど数えることもできないほど、眠元朗は目にうつし心に浸したかわからない。",
              "citation": {
                "source": "みずうみ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
