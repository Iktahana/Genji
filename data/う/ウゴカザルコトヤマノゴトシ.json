    "definitions": [
      {
        "index": 1,
        "gloss": "in being immobile be like a mountain (from Sun Tzu)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "敵の猛攻を前にしても、将軍は動かざること山の如しと陣を構え続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "窮地に立たされても動かざること山の如しを貫く彼の態度は、部下たちを安心させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "孫子の旗印にある通り、守勢に回った際は動かざること山の如しが肝要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "されど狼狽へたりと見られんは口惜しとやうに、遽にその手を胸高に拱きて、動かざること山の如しと打控へたる様も、自らわざとらしくて、また見好げにはあらざりき。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく、「動かざること山の如し」と言われたのは、ごく短時間、しかもごく大ざっぱに観察してのことで、今日、精密な測量の結果は、明らかに大地の隆起沈降を証明いたしております。",
              "citation": {
                "source": "自力更生より自然力更生へ",
                "author": "三澤勝衛",
                "note": "青空文庫"
              }
            },
            {
              "text": "収　動かざること山の如しって言う形です。",
              "citation": {
                "source": "みごとな女",
                "author": "森本薫",
                "note": "青空文庫"
              }
            },
            {
              "text": "動かざること山の如しだ。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かなること水の如く、動かざること山の如しといおうか、漣ほどの微動もない。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
