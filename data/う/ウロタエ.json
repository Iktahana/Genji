          "literary": [
            {
              "text": "自分の名前を探すべくウロタエまわったのであった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "老刑事も無論、私のいつに無いウロタエ方に気が付いたらしい。",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイハイハイハイ……」　と云ってウロタエまわった。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら大目付様がウロタエさっしゃっても、手がかりも足がかりもない立派な人間に疑いをかけさっしゃる筈はないが……扨は松倉十内がうろたえたかな……」「ええッ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "内外ビルなんぞは、最初の一ユレで八階から地下室までブチ抜けて、数百の生霊をタタキ潰すというウロタエ方であった。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
