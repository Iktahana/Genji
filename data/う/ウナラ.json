          "literary": [
            {
              "text": "……あたし名優でしょう……オホホホホホ……………　　　★ではサヨウナラ…………みなさんおやすみなさい。",
              "citation": {
                "source": "月蝕",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロシア人のボーイたちは習い覚えた片言の日本語で、「サヨウナラ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "之以上グズグズイウナラ私今清三ヲ起シテ来マスヨサア放シテ頂戴」　トイッテ、私ヲフリ切ッテ二階ニ上ッテ行ッテ了イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッテヤルトイウナラ、余ハ世界人類ノ不幸ヲ救ウタメ、カワッテソノ暴挙ヲ思イトドマラスデアロウ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからサヨウナラさ！",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナツテシマフノデスガ、今夜ハサウナラナイ内ニ、ワザト魔法ニカカツタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナッテシマウノデスガ、今夜ハソウナラナイ内ニ、ワザト魔法ニカカッタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "サヨウナラ」　遠藤は手紙を読み終ると、懐中時計を出して見ました。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝、木根ウナラベからの手紙、ムヂリ外套に角巻の五十才ばかりの柄の値段を問合せて来た。",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月七日北見のウナラペが※レプ　イルプを送ってよこした。",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "何といふかはいらしいウナラペなんだらう。",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "日高のウナラベは、孫と姪だか二人のむすめを連れて来て二十日ばかりゐましたが、私が来る二三日前に帰ってしまったさうです。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "トンケシのウナラペに着くか何うかと思ひながら先頃はがきを出したら、昨日返事が来て一人で笑ひました。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを、若い美しい女が居たからつて、ハイ・サヨウナラはひどいわよ！",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシソウナラバソレハ誤リデ、僕ハ彼女ラヲ同等ニ愛シテイルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「頼ミマス」「小頭全体デキメタモントイウナラ、取リ次ギハスルケンド、コンナ金、アテニシトルト、アテガ外レルバイ」　この書類は、炭商組合に手交されることはされたらしい。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
