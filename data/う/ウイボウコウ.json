        "examples": {
          "standard": [
            {
              "text": "十二歳で呉服屋に初奉公に出た彼は、慣れない雑用に追われる毎日を過ごした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "初奉公の朝、母親が持たせてくれた風呂敷包みを抱え、彼は涙を堪えて屋敷の門を潜った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は初奉公先で厳しく躾けられ、商人としての基礎を徹底的に叩き込まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "二　生活への最初の出発、昔からいう初奉公の不安、それに難物の夫人、東京を離れた刹那から、新子はやはりかるい物思いに沈んだ。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "お葉は一昨年の春から初奉公で近所の水戸屋という煙草屋の女中に住み込んだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "冬の金魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "お花の隣の空床の主はお蝶と云って、今年の夏田舎から初奉公に出た、十七になる娘である。",
              "citation": {
                "source": "心中",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい角帯前垂れを着せられて、ベソを掻き掻き近藤小母さんに連れられて行った初奉公のぼくは、勿論、店の表つきを見て這入ったわけではない。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
