        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「彼なら絶対に裏切りません」と、私は自信を持って請け合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "担当医は、手術が成功して完治することを力強く請け合ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "どんなに反対されても、彼は自分の理論の正しさを請け合い続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
