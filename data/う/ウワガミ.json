        "examples": {
          "standard": [
            {
              "text": "大事な本なので、汚れないように綺麗な上紙を巻いておいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この贈り物には、真っ白で高級な上紙がかかっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "丁寧に上紙を外して、中のお手紙を読んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "黄昏銀座通にて毆打せられし上紙入を奪はれしものありと云。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "自身、秀吉は上紙をのぞき、また封を切って、「ああ、久しぶりに、御筆蹟を拝む」　と、まず披くに先だって、額に押しいただいた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "密封した書状の上紙には、木曾街道｜垂井の宿、御用飛脚屋むかでやの扱い印がベットリとおしてある。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
