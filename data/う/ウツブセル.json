        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は泥だらけの身体を地面にうつ伏せて、息を潜めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は怪我をした友人をそっとうつ伏せて、背中の傷を確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ぬいぐるみをもらった子供は、ベッドにそれをうつ伏せておままごとを始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "地は荒れて、見よ、ここに「饑饉」の足穗、うつぶせる「人」を誰が利鎌の富と世の秋に刈り入るる、噫、さもあれや、畏るるはそれならで天のおとづれ。",
              "citation": {
                "source": "有明集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
