          "literary": [
            {
              "text": "ヤマキチ　ハ、ソノ　ハナシヲ　キイテ、スグニ、ウミ　ト　イウトコロ　ヘ　ユキタクテ　タマラナク　ナリマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハソノ間苦シミニ苦シンデ居タヨウデシタガ、ソノ中、清三ガ意識ヲ復シテ動クヨウデシタカラ、思イ切ッテ、道子ノ心臓ト思ウトコロヲ一刺ニ刺シテ此ノ女ヲヤッツケテシマッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、女がこう言ってたずねました――「マドロスさん、今の唄、何という唄なの、なんだか琵琶を聞くような、悲しいところがあるわね」「コレハフラメンコイウ唄デス、次ハタランテラ唄イマショ、ナポリイウトコロデ唄イマス」とマドロスは前置きをして、また一種異様な音楽をはじめ出しました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ思ウトコロガアッテ、ソノ日ヲ特ニ今日ニ選ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハ地球トイウ惑星ノ日本トイウトコロニ生マレ、擬似体験げいむノぷろぐらまあトイウ職業ニ就ク。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレ臣ノ希ウトコロ、唯誓ッテ反国ノ逆ヲ誅シ、以テ先帝ノ遺詔ニコタエ、世々ノ大道ヲ明ラカニセンノミ。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
