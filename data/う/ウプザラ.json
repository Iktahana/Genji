          "literary": [
            {
              "text": "この説はまたウプザラにおいても盛んな論争を惹起し、それが多分スウェーデンで科学の勃興を促す動機となったようである。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳者付記　スワンテ・アウグスト・アーレニウス（Svante August Arrhenius）は一八五九年にウプザラの近くのある土地管理人の息子として生れた。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウプザラ大学で物理学を学び、後にストックホルム大学に移ってそこで溶液の電気伝導度、並びにその化学作用との関係について立ち入った研究をした。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            }
          ]
        }
