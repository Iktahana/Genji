        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「僕は何もかもぶち壊してウッチャッてしまうんだ。",
              "citation": {
                "source": "実さんの精神分析",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "上田で生れた児です……真実に親の言うことなどは聞かない……苦しい時代に出来た児はああいうものかと思いますネ……ウッチャリ放しに育った児ですからネ……子などに関ってはおられなかったんです……しかし、考えて見ると、私の家内もよくやって来ましたよ。",
              "citation": {
                "source": "岩石の間",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して連歌に「て」の字を以て結べるものゝ多いのは、これ即ちウッチャリの氣象を自ら發露したもので換言すれば自暴自棄を表示するものである、絶望を語るものである。",
              "citation": {
                "source": "足利時代を論ず",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女房子供をウッチャラカシに養ふたつて、二万ぐらゐの捨て扶持はいるだらう。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "向ふぢや死んだつもりにウッチャらかしだらう」　三人そろつて外へでゝ夕風に当ると、「オイ、オレは今すぐ基地へ帰る」　安川は焦燥にイライラしてゐた。",
              "citation": {
                "source": "決闘",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は商売をウッチャラかして、半年間この読書に没頭した。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「彼はもはや二人の敵と戦うことをやめて、突然彼等の軍門に降った、彼は日本の力士のいわゆるウッチャリの手のように一とねり体をひねったんだ。",
              "citation": {
                "source": "サレーダイン公爵の罪業",
                "author": "THE SINS OF PRINCE SARADINE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
