        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ヨットを係留するために、マリーナに新しい浮き桟橋が設置された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "増水した川でも浮き桟橋は水位に合わせて上下するため、安全に船を接岸できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "観光地の湖に設けられた浮き桟橋から、遊覧船が次々と出発していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "いずれにしても浮き桟橋の現状に当局の注意を喚起すべき一件なり。",
              "citation": {
                "source": "橙の種五粒",
                "author": "THE FIVE ORANGE PIPS",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「一銭蒸汽」　僕等はそこから引き返して川蒸汽の客になる為に横網の浮き桟橋へおりて行つた。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども屋根のある浮き桟橋は――震災は勿論この浮き桟橋も炎にして空へ立ち昇らせたのであらう。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの浮き桟橋の上に川蒸汽を待つてゐる人々は大抵大川よりも保守的である。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "両国橋をくぐつて来た川蒸汽はやつと浮き桟橋へ横着けになつた。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」一銭蒸汽　僕等はそこから引き返して川蒸汽の客になるために横網の浮き桟橋へおりて行った。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども屋根のある浮き桟橋は――震災は勿論この浮き桟橋も炎にして空へ立ち昇らせたであろう。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの浮き桟橋の上に川蒸汽を待っている人々は大抵大川よりも保守的である。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "両国橋をくぐって来た川蒸汽はやっと浮き桟橋へ横着けになった。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "高速艇の発着する浮き桟橋にも、防波堤にも、どこにも、人が見えない。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
