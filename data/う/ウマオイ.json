        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "秋の夜、馬追いの鳴き声が聞こえる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "馬追いという虫の名前は確かに珍しい。",
              "citation": {
