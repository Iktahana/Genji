    "definitions": [
      {
        "index": 1,
        "gloss": "loading a horse with passengers or baggage",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "馬追いをして、旅の荷物を馬に乗せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "旅の出発前に馬追いを済ませるのが日課だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "馬追いは腕力と技術が必要な作業である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "驢馬が頭を下げてると荷物があんまり重過ぎないかと驢馬追いにたずねましたし家の中で赤ん坊があんまり泣いていると疱瘡の呪いを早くしないといけないとお母さんに教えました。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らく徳川幕府の時代から、駒込村の一廓で、代々夏の夜をなき明したに違いない夥しい馬追いも、もうあの杉の梢をこぼれる露はすえない事になった。",
              "citation": {
                "source": "犬のはじまり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "末子と生まれたものが成人しても、馬追いか駕籠かきにきまったものとされたほどの時代である。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜になると私の床にひとしお床しく聞こえるのはこおろぎ、馬追い、鉦叩き、くさひばり、えんまこおろぎ、またその中を縫うように名も知らぬ虫の声が聞こえてくる。",
              "citation": {
                "source": "耳の日記",
                "author": "宮城道雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "圃に立っている、とうもろこしの、大きな垂れさがった葉に腰をかけて、馬追いが、知っているかぎりの唄をうたっていました。",
              "citation": {
                "source": "酒屋のワン公",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬追いはびっくりして、二｜本の長いまゆ毛を動かして、声のした空を仰ぎながら、「あのやさしい、酒屋の小僧さんが、さっきから熱心に聞いていてくれるものですから……。",
              "citation": {
                "source": "酒屋のワン公",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "八号の三八号の三は坑内の馬追い酒精中毒らしい舌は何時でもまわらなかった袢天も帽子もドロドロにし馬と一緒に暗い坑内から出てくるとまわらぬ舌を無理にまわして妻に胸のいらいらをぶちまけていた酔がまわるに従って、だんだん声が高くなるのが常だった。",
              "citation": {
                "source": "炭坑長屋物語",
                "author": "猪狩満直",
                "note": "青空文庫"
              }
            },
            {
              "text": "原の中に坐り込まねばならんようになりましたが、幸いに後の方から驢馬追いがやって来ましたので、その驢馬に乗せてもらって四里ばかりの道を経てジャンという駅に着きました。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫の声はますますしげく、ますます高く、馬追いやコオロギなど、不意に部屋の中の耳元で歌い出す。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の子の子役がやった馬追いの三吉におすぎは感心した。",
              "citation": {
                "source": "夕張の宿",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠い昔、推古朝の世には、高麗の移民が野馬追いに疲れて腰をかけたかも知れないこの野中の玉石。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔話の主人公となった梟や時鳥、東北の野山ではカッコウや馬追い鳥が、いずれも暮れかかってから啼きしきる鳥であったことは、私には些しも偶然とは思われぬ。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜になると、裏の野菜圃で、うまおいの鳴く声がきこえました。",
              "citation": {
                "source": "銀河の下の町",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑では、つゆをしたって、うまおいが、ないていました。",
              "citation": {
                "source": "風七題",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "脊高く茂ったとうもろこしの畑には、うまおいが、鳴いています。",
              "citation": {
                "source": "二百十日",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "とうもろこしの葉が、夕風に動いて、さっきから鳴いているうまおいの声が、夜のふけるにつれてだんだん冴えていました。",
              "citation": {
                "source": "二百十日",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "お螻殿を、佛さん蟲、馬追蟲を、鳴聲でスイチヨと呼ぶ。",
              "citation": {
                "source": "寸情風土記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おさわ、琴にて、馬追ひ。",
              "citation": {
                "source": "盲人独笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると恰も上手な鍼醫が銀の鍼を打つやうに耳の底に浸み透る馬追虫の聲が、庄次の這入つてゐる蚊帳に止まつて鳴きました。",
              "citation": {
                "source": "白瓜と青瓜",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "凍死馬追悼標といふのが立つてゐるのを見て、義雄は自分について來た馬子が兩足とも膝までしかないのを思ひ合はせた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるときは赤き帽の首打ち振りて馬追うさまも見ゆる。",
              "citation": {
                "source": "薤露行",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御坊は頓阿、浄弁、慶運の人々と相列んで、和歌の四天王と当世に申し囃さるるばかりか、文書くことは大うつ童、馬追う男も御坊日本一と申しておりまする。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」馬追虫の「すゐつちよ。",
              "citation": {
                "source": "茶立虫",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はギヤマン模様のように澄明な猪鼻村のパノラマを遠く脚下に横眼で見降しながら努めて呑気そうに馬追唄を歌って行った。",
              "citation": {
                "source": "ゼーロン",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへ實體に勤めたところで、彼の如く末子に生れたものは、成身しても七里役（飛脚）か、馬追、駕籠かきと極まつた身分の時代にあつて、兎にもかくにも彼は例外の仕合せを兩親の側に見出した。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくもその冥加を彼が忘れたら、生れ得たまゝの馬追か駕籠かきで生涯を終るか、それも恥づかしくなれば遠國へでも走り、非人乞食の仲間入りより外なかつたであらう。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「祈祷も成就しそうだのう」　壱岐が、こういった時、赤山靱負が「大砲打ち込もよいが、来春の、吉野牧場の馬追を好機として、久光公を鉄砲にて射取ったなら？",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして蟋蟀が鳴き、馬追が鳴き、或るものの細かな葉さきには露の玉が光っていた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ではどの虫が好きだらうと考へて来ると私には先づ馬追虫である。",
              "citation": {
                "source": "秋草と虫の音",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "やすらかに足うちのばしわが聞くや蚊帳に来て鳴く馬追虫をめづらしく蚊帳に来ていま鳴き出でし馬追虫の姿をぞおもふ家人のねむりは深し蚊帳にゐて鳴くうまおひよこゑかぎり鳴け",
              "citation": {
                "source": "秋草と虫の音",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
