        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イヤ、止メヨウト思エバ思ウホド、マス／＼気狂イノヨウニナッテシャブッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鏡ノ中ノ顔ヲ醜悪ト思エバ思ウホド、イヨ／＼颯子ト云ウ生物ガ限リモナク優秀ニ見エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ僕ヲ、気ガ狂ウホド嫉妬サセテホシイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "血壓計ガ破レテシマウホド血壓ガ高イト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、十三日に、「木村ニ対スル嫉妬ヲ利用シテ妻ヲ喜バスハ、彼女自身ノ幸福ノタメデモアルト思ッテ貰イタイ」という語、「僕ハ僕ヲ、気ガ狂ウホド嫉妬サセテホシイ」、―――「妻ハ随分キワドイ所マデ行ッテヨイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
