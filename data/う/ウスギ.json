[
  {
    "uuid": "e9d021fc-8aa7-5a24-afc9-48158382f4c0",
    "entry": "薄着",
    "reading": {
      "primary": "うすぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "being lightly dressed",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "冬に薄着をしていて、風邪をひいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼は季節に関係なく、いつも薄着をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "薄着の女性が、震えながら歩いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "静岡辺は暖かいからというので私は薄着の綿入れで写生帳とコートは手に持っていた。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」薄着になりし情の厚さ。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日とは違った嘘のような上天気で、風なんか薬にしたくもなかったが、薄着で出たから晩方は寒い。",
              "citation": {
                "source": "朱日記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「薄着のせいかね、動悸がしてるよ。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "片恋の薄着のねるのわがうれひ「曳舟」の水のほとりをゆくころを。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかしやの金と赤とがちるぞえな、かはたれの秋の光にちるぞえな、片恋の薄着のねるのわがうれひ、曳舟の水のほとりをゆくころを、やはらかな君が吐息のちるぞえな。",
              "citation": {
                "source": "雪と花火余言",
                "author": "東京景物詩改題に就て",
                "note": "青空文庫"
              }
            },
            {
              "text": "成程薄着ですらりとして、そりゃ姿は可いだろう。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊女は自分が薄着なことも、髪のこわれたのも気がつかずに、しみじみと情人の顔じゃ。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬盥を庭の隅へ出して湯を汲めば父は締糟を庭場へ入れ、荷鞍を片づけ、薄着になって馬の裾湯にかかった。",
              "citation": {
                "source": "新万葉物語",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "凍寒はナイフのように鋭く痛くわれらの薄着の肌をついた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "暑熱・寒冷・雨雪・飲酒・日光の直射・異常な食物・甚だしい飢え・飽食や浴後の薄着・皮膚の不潔等がすべて病因となることは、尽く自分の判断と他の批判と、即ち一個的および相互的の注意によって之を避けなければならない。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴム毬の弧線のような肩は骨ばった輪郭を、薄着になった着物の下からのぞかせて、潤沢な髪の毛の重みに堪えないように首筋も細々となった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このなりでは少し薄着でもあるし、それに旅行をするのには変ですわ。",
              "citation": {
                "source": "痴想",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「では、夕月ごろまでに、それなるふたごの兄弟を巧みに誘い合わせて、なるべく薄着の水じたくをご用意しながら向島の水神へお越しめされい。",
              "citation": {
                "source": "右門捕物帖",
                "author": "村正騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここんところに餓鬼めが二匹震えているんですよ」　声に、どっとひしめきたったやじうまたちを押し分けながら近づいてみると、いかさま朝あけの冷たい道にはだしとなって、はんてんのない薄着のからだをふるわせながら、寒そうに相抱き合って、おどおどしている貧しげな子どもがふたりいるのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもほのかに薄着してしんぞいとしう見ゆれども、晝が晝なか、大それた強い魔藥に他こそ知らね、赤い火のよな針のわな千々に顫えて蟲を捕る、蟲を捕る。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "――彼は、彼女の薄着の下に躍動してゐる鹿のやうに明るい四肢を想像して、自分が彫刻家でないことを後悔した。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の願は親の口から今一度、薄着して風邪をお引きでない、お腹が減いたら御飯にしようかと、詰らん、降らん、意味の無い事を聞きたいのだが……　その親達は最う此世に居ない。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄着で寒そうな姿をした童女が一人と、それと同じような恰好をした女房とが見える。",
              "citation": {
                "source": "源氏物語",
                "author": "橋姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この顔がそんなに怖いのか」「わたし、寒いのよ」「なるほど、薄着だな。",
              "citation": {
                "source": "暗中の接吻",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔しながらの薄着で、肩が凝ると言つて襯衣は決して着ないから、襦袢の白い襟の間から茶褐色に痩せた斑點のある肌が見えてゐた。",
              "citation": {
                "source": "ごりがん",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「知った家はないし、どうせ兵営の傍の木賃泊りだ」「召集されて随分｜悲惨な家もあるンでしょうね」「ああ百姓なんか収穫時だ、実際困るだろう」　海水浴場案内のビラが、いまは寒気にビラビラしていて、駅の前を行く女達の薄着の裾が帆のようにふくれ上っていた。",
              "citation": {
                "source": "清貧の書",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "川風の寒い晩で薄着をして来た僕と晶子とは身を慄はせずに居られなかつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、まだ残暑を感じる頃、家から用意した薄着の肌のひやつくのが甚しくなつた時分と見られよう。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、十一月末のこととて、午前四時半はまだ深夜で、薄着の身はぞくぞくと冷えこむ。",
              "citation": {
                "source": "ヘヤーピン一本",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際私はこの水風呂以来、厳寒に薄着をしても風をひかなくなつたので、今もつてその耐久力はつゞいてゐる。",
              "citation": {
                "source": "わが戦争に対処せる工夫の数々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "（晴天）　四月一ぱいは薄着をするな。",
              "citation": {
                "source": "百姓日記",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これでは少し薄着だし、旅をするにはをかしいわ。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの女のように、薄着でもあった。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しびっこで恐ろしく背の高いやせこけた老翁であったが、破れ手ぬぐいで頬かぶりをした下からうすぎたない白髪がはみ出していたようである。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
